a5-4232-bb80-3d6e31386f3f","name":"Stupak, Inge","name_org":"Møller, Inge Stupak","orcid":"0000-0002-9984-5024","rank":15,"rolecode":"pau"},{"affno":"2","first":"Ole Hjort","key":"caspersenolehpau","last":"Caspersen","locid":"12dde0c1-a93f-47ed-a87d-96ef0c267b98","name":"Caspersen, Ole H.","name_org":"Caspersen, Ole Hjort","orcid":"0000-0002-3832-4954","rank":16,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Ole Hjort","key":"caspersenolehjortpau","last":"Caspersen","name":"Caspersen, Ole Hjort","rank":16,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Erik","key":"rasmussenerikpau","last":"Rasmussen","name":"Rasmussen, Erik","rank":17,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Susanne Bødtker","key":"petersensusannebødtkerpau","last":"Petersen","name":"Petersen, Susanne Bødtker","rank":18,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Lene","key":"baunbæklenepau","last":"Baunbæk","name":"Baunbæk, Lene","rank":19,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Maria Gunnleivsdóttir","key":"hansenmariagunnleivsdóttirpau","last":"Hansen","name":"Hansen, Maria Gunnleivsdóttir","rank":20,"rolecode":"pau"}],"pub":{"isbn":["9788771561746"],"issn":["22450203"],"pages":"915","publisher":"Aarhus University","repno":"Scientiﬁc Report from DCE – Danish Centre for Environment and Energy","series":"Scientiﬁc Report from DCE - Danish Centre for Environment and Energy","status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-2cbe3aa7-d3e3-4e1b-b8c5-63c1210b2457","ku-ed76ecd9-205e-4ab9-bbf9-0683c003e3ba"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Denmark's National Inventory Report 2015 : Emission Inventories1990-2013 – Submitted under the United Nations Framework Convention on Climate Change and the Kyoto Protocol","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-085.71-015878","year":"2015","yearsub":"2015"}
{"abstract":"Objectives: Methicillin-resistant Staphylococcus aureus (MRSA), in particular clonal complex (CC) 398, is increasingly found in livestock. Recently, MRSA CC30 was identified in Danish pigs. We determined the susceptibility of porcine S. aureus isolates of CC398 and CC30 to disinfectants used in pig farming (benzalkonium chloride, hydrogen peroxide, formaldehyde, sodium hypochlorite, and caustic soda). Furthermore, efflux pump activity, antimicrobial resistance profiles, hemolysis properties, and the presence of toxic shock syndrome toxin-1 (TSST-1) and Panton-Valentine Leukocidin (PVL)-encoding virulence factors were investigated. Methods: Susceptibilities to biocides and antimicrobial agents of 79 porcine S. aureus isolates were determined by the microdilution method. Isolates comprised 21 methicillin-sensitive S. aureus (MSSA) and 40 MRSA isolates belonging to CC398 and 13 MSSA and 5 MRSA isolates belonging to CC30. The presence of quaternary ammonium compound (QAC) resistance efflux pumps was analyzed using an ethidium bromide accumulation assay. The presence of qac resistance genes in active efflux pump positive isolates was determined by whole-genome sequencing data. All isolates were screened for lukPV and tst genes with PCR, and hemolytic activities were determined using an agar plate assay. Results: S. aureus isolates did not show reduced susceptibility to the biocides tested. However, the QAC resistance gene, qacG, was detected in three MRSA CC30 isolates and the qacC in one MRSA CC30 isolate. CC30 isolates were generally more susceptible to non-beta-lactam antibiotics than CC398. Isolates generally had low hemolytic activity and none encoded PVL or TSST-1. Conclusion: The presence of qac genes in European porcine S. aureus isolates and in livestock-associated MRSA CC30 is for the first time described in this study. This finding is concerning as it ultimately may compromise disinfection with QACs and thereby contribute to the selection and spread of MRSA CC30.","author_count":5,"contributors":["Seier-Petersen, Maria Amalie","Nielsen, Lene Nørby","Ingmer, Hanne","Aarestrup, Frank Møller","Agersø, Yvonne"],"cuid":["S02-100.00-032653"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"biocide susceptibility of i staphylococcus aureus i cc000000000398 and cc000000000030 isolates from pigs and identification of the biocide resistance genes i qacg i and i qacc i","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1089/mdr.2014.0215","version":"Other Version"},"id":"S02-100.00-032653","identifier":[{"id":"84943273086","type":"scopus"},{"id":"26430941","type":"pmid"}],"ids":["dtu-037aebfa-4762-4c6e-bc74-5c064feb5822","ku-69d38c83-f489-4307-a182-2e4c9fd45325"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-1F7D04828570A9560FA3425AC99DAE90"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1089/mdr.2014.0215","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Food Institute"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Veterinary and Animal Sciences, Food Safety and Zoonoses"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Maria Amalie","key":"seierpetersenpau","last":"Seier-Petersen","locid":"898706f4-cdfb-4841-aa17-759cd1e83653","name":"Seier-Petersen, Maria Amalie","rank":1,"rolecode":"pau"},{"affno":"2","first":"Lene Nørby","key":"nielsenpau","last":"Nielsen","locid":"1a4f890a-d171-4c2f-ae00-dd1e024c25ab","name":"Nielsen, Lene Nørby","rank":2,"rolecode":"pau"},{"affno":"2","first":"Hanne","key":"ingmerpau","last":"Ingmer","locid":"abe2cd31-84e7-4f06-81a3-33e08bf93b8f","name":"Ingmer, Hanne","orcid":"0000-0002-8350-5631","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Frank Møller","key":"aarestruppau","last":"Aarestrup","locid":"8a1eb030-2c37-4557-bce1-7bc6d5c75aaa","name":"Aarestrup, Frank Møller","orcid":"0000-0002-7116-2723","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Yvonne","key":"agersøpau","last":"Agersø","locid":"727ec55d-b40c-4ff2-b27e-cc347dbeb7ed","name":"Agersø, Yvonne","rank":5,"rolecode":"pau"}],"pmid":["26430941"],"pub":{"doi":"10.1089/mdr.2014.0215","issn":["10766294","19318448"],"issn_org":["10766294"],"issue":"5","journal":"Microbial Drug Resistance","pages":"527-536","publisher":"Mary AnnLiebert, Inc. Publishers","status":"p","title":"Microbial Drug Resistance","volume":"21"},"review":"Peer Reviewed","scoID":["2-s2.0-84943273086"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-037aebfa-4762-4c6e-bc74-5c064feb5822","ku-69d38c83-f489-4307-a182-2e4c9fd45325"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Biocide Susceptibility of Staphylococcus aureus CC398 and CC30 Isolates from Pigs and Identification of the Biocide Resistance Genes, qacG and qacC","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-032653","year":"2015","yearsub":"2015"}
{"abstract":"I Danmark står malkekøerne for 45 % af den totale kvælstofudskillelse (N) og 56 % af den totale enteriske metanproduktion (CH4) fra dyr. Myndigheder og kvægbruget ønsker at reducere den negative miljøpåvirkning fra malkekøer, særligt med hensyn til N-udskillelse og CH4- produktion. Den største variable udgift i mælkeproduktion er foderomkostninger. Det er derfor væsentligt med en fodring, der samtidig optimerer produktion og miljøpåvirkninger. Formålet med projektet var at belyse nye fodringsstrategier til malkekøer, hvor næringsstofforsyningen til yveret er sikret samtidig med en forbedret energi- og N-effektivitet og en reduceret CH4-produktion. Fodringsstrategierne baseres på effekten af fedttildeling, øget grovfoderkvalitet samt energi- og proteinniveau. Det blev vist, at det er muligt at kombinere øget mælkeydelse og -persistens med øget N-effektivitet og reduceret CH4-produktion. Ud fra et miljø- og produktionsmæssigt synspunkt skal foderstrategien bygge på et højt energi- og proteinniveau i mobiliseringsfasen efterfulgt af nedgang i energi og supplering med 5-6 % fedt i deponeringsfasen. Grovfoder af høj kvalitet muliggør en høj grovfoderandel særligt efter mobiliseringsperioden.","author_count":7,"contributors":["Alstrup, Lene","Lund, Peter","Sehested, Jakob","Hymøller, Lone","Nielsen, Mette Olaf","Weisbjerg, Martin Riis"],"cuid":["S01-000.00-241243"],"event":{"end":"2015-04-23","place":"Foulum, dk","start":"2015-04-23","title":"Temamøde: Malkekoens ernæring","year":"2015"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"pop","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"und","rtype":["clu"],"sorti":"miljøvenlige fodringsstrategier malkekøer","src":["au"],"src-code":["DI-U-AU"],"type":"dra","type-grp":["all","pub"]},"id":"S01-000.00-241243","ids":["au-c4128fcc-31c5-4b4c-9741-8d229e156269"],"lang":"Danish","level":"Popular","mra":["Science/Technology"],"noi":["Local-1-1-46731081D48B28D8AE7D157F7252D1B2"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Animal and Veterinary Sciences, Department of Animal and Veterinary Sciences - ANIS Nutrition"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Lene","key":"alstruppau","last":"Alstrup","locid":"7b470fb3-335f-4a7b-9aa0-0b9fd32f017d","name":"Alstrup, Lene","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Peter","key":"lundpau","last":"Lund","locid":"c933cda2-363e-4cb6-b596-3df7ef3d30ed","name":"Lund, Peter","orcid":"0000-0002-9113-4500","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jakob","key":"sehestedpau","last":"Sehested","locid":"877cccec-c84c-4d5c-94a0-26731a4a157a","name":"Sehested, Jakob","orcid":"0000-0001-6977-6972","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lone","key":"hymøllerpau","last":"Hymøller","locid":"83604264-1a7d-48c9-86d9-1867667f74cc","name":"Hymøller, Lone","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Mette Olaf","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Mette Olaf","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Martin Riis","key":"weisbjergpau","last":"Weisbjerg","locid":"501c877c-de