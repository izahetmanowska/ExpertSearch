{"author_count":5,"contributors":["Adimpong, David Bichala","Nielsen, Dennis Sandris","Sørensen, Kim I.","Derkx, Patrick M.F.","Jespersen, Lene"],"cuid":["S01-000.00-428141"],"event":{"end":"2011-09-01","place":"Egmond aan Zee, nl","start":"2011-08-28","title":"LAB10","year":"2011"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-NOSI"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-PR-NOSI","DI-U-KU"]},"review":"nr","rtype":["clu"],"sorti":"phenotypic determination of antibiotic susceptibility profiles of lactic acid bacteria from indigenous african fermented food products","src":["ku"],"src-code":["DI-U-KU"],"type":"dco","type-grp":["all","pub"]},"id":"S01-000.00-428141","ids":["ku-3a3ec49e-53a5-4108-a0b1-2413d377e066"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-CD278DF2E177073B54D33FAA5D1DDDB8"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Life Sciences, Department of Food Science, Food Microbiology"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"novonesis","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-NOSI","l3nn":"Novonesis","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Novonesis","namevar":["Chr. Hansen"],"nora_code":"DI-PR-NOSI","used":1}],"person":[{"affno":"1","first":"David Bichala","key":"adimpongpau","last":"Adimpong","locid":"4db0ae2e-8bbf-4026-8e4d-cdd58029a5b0","name":"Adimpong, David Bichala","rank":1,"rolecode":"pau"},{"affno":"1","first":"Dennis Sandris","key":"nielsenpau","last":"Nielsen","locid":"08539a0e-05f4-454e-ad2a-de195363dbd1","name":"Nielsen, Dennis Sandris","orcid":"0000-0001-8121-1114","rank":2,"rolecode":"pau"},{"affno":"2","first":"Kim I.","key":"sørensenpau","last":"Sørensen","name":"Sørensen, Kim I.","rank":3,"rolecode":"pau"},{"affno":"2","first":"Patrick M.F.","key":"derkxpau","last":"Derkx","name":"Derkx, Patrick M.F.","rank":4,"rolecode":"pau"},{"affno":"1","first":"Lene","key":"jespersenpau","last":"Jespersen","locid":"a156c6e3-9562-4d35-9305-53a39c62e076","name":"Jespersen, Lene","orcid":"0000-0002-2555-5948","rank":5,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Private Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-3a3ec49e-53a5-4108-a0b1-2413d377e066"],"src":["KU University of Copenhagen"],"title":"Phenotypic determination of antibiotic susceptibility profiles of lactic acid bacteria from indigenous African fermented food products","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-428141","year":"2011","yearsub":"2011"}
{"abstract":"Optimal glycemic control is pivotal to the successful outcome of diabetic pregnancy. The goals for glycemic control include levels for preprandial and postprandial glucose and HbA1c as well as avoidance of severe hypoglycemia. These goals are best obtained with diet, exercise, and insulin treatment, often a multiple-dose insulin regimen or insulin pump. A focus on blood pressure, microalbuminuria, diabetic nephropathy, and diabetic retinopathy is needed.","author_count":3,"contributors":["Mathiesen, Elisabeth R.","Nielsen, Lene Ringholm","Damm, Peter"],"cuid":["S01-000.00-438632"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"pregnancy management of women with pregestational diabetes","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.ecl.2011.08.005","version":"Other Version"},"id":"S01-000.00-438632","identifier":[{"id":"82855179457","type":"scopus"}],"ids":["ku-4bce9522-6203-4e8b-9347-67947123db43"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-F8C72AD9FA32A5E5C784D7A706F7A14A"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.ecl.2011.08.005","version":"Other Version"}],"org":[{"affno":1,"key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Section of Orthopaedics and Internal Medicine"],"nora_code":"DI-U-KU"}],"person":[{"affno":"","first":"Elisabeth R","key":"mathiesenpau","last":"Mathiesen","locid":"3acd58f4-6d64-4a89-a406-d2f43b310500","name":"Mathiesen, Elisabeth R.","name_org":"Mathiesen, Elisabeth R","rank":1,"rolecode":"pau"},{"affno":"","first":"Lene Ringholm","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Lene Ringholm","rank":2,"rolecode":"pau"},{"affno":"","first":"Peter","key":"dammpau","last":"Damm","locid":"884d03d5-5981-4d33-80c6-adb21f836deb","name":"Damm, Peter","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.ecl.2011.08.005","issn":["08898529","15584410"],"issn_org":["08898529"],"issue":"4","journal":"Endocrinology & Metabolism Clinics of North America","pages":"727-38","status":"p","title":"Endocrinology & Metabolism Clinics of North America","volume":"40"},"review":"Peer Reviewed","scoID":["2-s2.0-82855179457"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-4bce9522-6203-4e8b-9347-67947123db43"],"src":["KU University of Copenhagen"],"title":"Pregnancy management of women with pregestational diabetes","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-438632","year":"2011","yearsub":"2011"}
{"abstract":"Injectable cell scaffolds play a dual role in tissue engineering by supporting cellular functions and delivering bioactive molecules. The present study aimed at developing biodegradable nanocomposite microparticles with sustained drug delivery properties thus potentially being suitable for autologous stem cell therapy. Semi-crystalline poly(l-lactide/dl-lactide) (PLDL70) and poly(l-lactide-co-glycolide) (PLGA85) were used to prepare nanoparticles by the double emulsion method. Uniform and spherical nanoparticles were obtained at an average size of 270–300 nm. The thrombin receptor activator peptide-6 (TRAP-6) was successfully loaded in PLDL70 and PLGA85 nanoparticles. During the 30 days' release, PLDL70 nanoparticles showed sustainable release with only 30% TRAP-6 released within the first 15 days, while almost 80% TRAP-6 was released from PLGA85 nanoparticles during the same time interval. The release mechanism was found to depend on the crystallinity and composition of the nanoparticles. Subsequently, mPEG-PLGA nanocomposite microparticles containing PLDL70 nanoparticles were produced by the ultrasonic atomization method and evaluated to successfully preserve the intrinsic particulate properties and the sustainable release profile, which was identical to that of the nanoparticles. Good cell adhesion of the human fibroblasts onto the nanocomposite microparticles was observed, indicating the desired cell biocompatibility. The presented results thus demonstrate the development of nanocomposite microparticles tailored for sustainable drug release for application as injectable cell scaffolds.","author_count":7,"contributors":["Wen, Yanhong","Gallego, Monica Ramos","Nielsen, Lene Feldskov","Jørgensen, Lene","Everland, Hanne","Møller, Eva Horn","Nielsen, Hanne Mørck"],"cuid":["S01-000.00-490816"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-COLO"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-PR-COLO","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"biodegradable nanocomposite microparticles as drug delivering injectable cell scaffolds","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-490816","identifier":[{"id":"80855130799","type":"scopus"},{"id":"21787815","type":"pmid"}],"ids":["ku-a2f051bf-6def-49d0-bc06-8e77e8cde3be"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-E6D902343DD7F24BD391AC5EB5A16522"],"org":[{"affno":"1","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"coloplast","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-COLO","l3nl":"Coloplast Group","l3nn":"Coloplast","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Coloplast","namevar":["Coloplast"],"nora_code":"DI-PR-COLO","used":1}],"person":[{"affno":"1","first":"Yanhong","key":"wenyanhongpau","last":"Wen","name":"Wen, Yanhong","rank":1,"rolecode":"pau"},{"affno":"2","first":"Monica Ramos","key":"gallegomonicaramospau","last":"Gallego","name":"Gallego, Monica Ramos","rank":2,"rolecode":"pau"},{"affno":"2","first":"Lene Feldskov","key":"nielsenlenefeldskovpau","last":"Nielsen","name":"Nielsen, Lene Feldskov","rank":3,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Lene","key":"jørgensenlenepau","last":"Jørgensen","locid":"d44a0998-9a19-40de-8d46-eb4234a9d3c4","name":"Jørgensen, Lene","rank":4,"rolecode":"pau"},{"affno":"2","first":"Hanne","key":"everlandhannepau","last":"Everland","name":"Everland, Hanne","rank":5,"rolecode":"pau"},{"affno":"1","first":"Eva Horn","key":"møllerevahornpau","last":"Møller","locid":"c03cc7bd-ce8d-4cd8-9983-01e65a60aa4c","name":"Møller, Eva Horn","rank":6,"rolecode":"pau"},{"affno":"1","first":"Hanne Mørck","key":"nielsenhannemørckpau","last":"Nielsen","locid":"7b0450b3-f634-47ec-912c-b07ecd943be8","name":"Nielsen, Hanne Mørck","orcid":"0000-0002-7285-9100","rank":7,"rolecode":"pau"}],"pmid":["21787815"],"pub":{"doi":"10.1016/j.jconrel.2011.07.013","issn":["01683659","18734995"],"issn_org":["01683659"],"issue":"1","journal":"Journal of Controlled Release","pages":"11-20","status":"p","title":"Journal of Controlled Release","volume":"156"},"review":"Peer Reviewed","scoID":["2-s2.0-80855130799"],"search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","Coloplast Group","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Private Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-a2f051bf-6def-49d0-bc06-8e77e8cde3be"],"src":["KU University of Copenhagen"],"title":"Biodegradable nanocomposite microparticles as drug delivering injectable cell scaffolds","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-490816","year":"2011","yearsub":"2011"}
{"abstract":"BACKGROUND AND PURPOSE OF STUDY: Extensive copy number variation is observed for the DEFA1A3 gene encoding alpha-defensins 1-3. The objective of this study was to determine the involvement of alpha-defensins in colonic tissue from Crohn's disease (CD) patients and the possible genetic association of DEFA1A3 with CD. METHODS: Two-hundred and forty ethnic Danish CD patients were included in the study. Reverse transcriptase PCR assays determined DEFA1A3 expression in colonic tissue from a subset of patients. Immunohistochemical analysis identified alpha-defensin peptides in colonic tissue. Copy number of DEFA1A3 and individual alleles, DEFA1 and DEFA3, were compared with those for controls, by use of combined real-time quantitative PCR and pyrosequencing, and correlated with disease location. RESULTS: Inflammatory-dependent mRNA expression of DEFA1A3 (P < 0.001), and the presence of alpha-defensin peptides, were observed in colonic tissue samples. Higher DEFA1A3 gene copy number (CD: mean copy number, 7.2 vs. controls 6.7; P < 0.001) and individual DEFA1 alleles (CD mean copy number 5.6 vs. controls 5.1; P < 0.01) were associated with CD, with strong association with colonic location (P < 0.001). CONCLUSIONS: Alpha-defensins are involved in the inflammation of CD, with local mRNA and peptide expression. In combination with the findings that a high DEFA1A3 copy number is significantly linked to CD, these results suggest that a high DEFA1A3 copy number might be important in hindering the normal inflammatory response in CD, particularly colonic CD.","author_count":13,"contributors":["Jespersgaard, Cathrine","Fode, Peder","Dybdahl, Marianne","Vind, Ida","Nielsen, Ole Haagen","Csillag, Claudio","Munkholm, Pia","Vainer, Ben","Riis, Lene","Elkjaer, Margarita","Pedersen, Natalia","Knudsen, Elisabeth","Andersen, Paal Skytt"],"cuid":["S01-000.00-491494"],"filters":{"added":"2022-04","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Alleles","Comparative Study","Crohn Disease","DNA Copy Number Variations","Denmark","Gene Dosage","Gene Expression Regulation","Genetic Predisposition to Disease","Humans","Journal Article","Peptides Cyclic","Prevalence","RNA Messenger","Real Time Polymerase Chain Reaction","Research Support Non U S Gov t","Risk Factors","alpha Defensins"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"alpha defensin defa000000000001a000000000003 gene copy number elevation in danish crohn s disease patients","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-491494","identifier":[{"id":"84856137706","type":"scopus"},{"id":"21701837","type":"pmid"}],"ids":["ku-a422ba0d-5383-41fb-9287-056b0a1aecc4"],"keyword":["Alleles","Comparative Study","Crohn Disease","DNA Copy Number Variations","Denmark","Gene Dosage","Gene Expression Regulation","Genetic Predisposition to Disease","Humans","Journal Article","Peptides, Cyclic","Prevalence","RNA, Messenger","Real-Time Polymerase Chain Reaction","Research Support, Non-U.S. Gov't","Risk Factors","alpha-Defensins"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-1312A48293DB3C61F820BF46FA4610A4"],"org":[{"affno":"1","country":"dk","key":"ssi statens serum institut","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-SSI","l3nn":"SSI Statens Serum Institut","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SSI Statens Serum Institut","namevar":["Statens Serum Institut"],"nora_code":"DI-GV-SSI","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","first":"Cathrine","key":"jespersgaardpau","last":"Jespersgaard","name":"Jespersgaard, Cathrine","rank":1,"rolecode":"pau"},{"affno":"","first":"Peder","key":"fodepau","last":"Fode","name":"Fode, Peder","rank":2,"rolecode":"pau"},{"affno":"","first":"Marianne","key":"dybdahlpau","last":"Dybdahl","name":"Dybdahl, Marianne","rank":3,"rolecode":"pau"},{"affno":"","first":"Ida","key":"vindpau","last":"Vind","locid":"b3987373-398b-4913-b0e8-d66d3e8f163c","name":"Vind, Ida","rank":4,"rolecode":"pau"},{"affno":"2","country":"dk","first":"Ole Haagen","key":"nielsenpau","last":"Nielsen","locid":"d59658c4-dde8-4749-9b5c-f4ec5910dd02","name":"Nielsen, Ole Haagen","orcid":"0000-0003-4612-8635","rank":5,"rolecode":"pau"},{"affno":"","first":"Claudio","key":"csillagpau","last":"Csillag","locid":"754d3472-c1df-48fa-b922-83694c80acec","name":"Csillag, Claudio","rank":6,"rolecode":"pau"},{"affno":"","first":"Pia","key":"munkholmpau","last":"Munkholm","locid":"5cbb13f8-f84f-426e-bb01-474074023e46","name":"Munkholm, Pia","rank":7,"rolecode":"pau"},{"affno":"","first":"Ben","key":"vainerpau","last":"Vainer","locid":"87ab1fdc-ec92-4c01-87a4-3e4dcc3b8684","name":"Vainer, Ben","rank":8,"rolecode":"pau"},{"affno":"","first":"Lene","key":"riispau","last":"Riis","name":"Riis, Lene","rank":9,"rolecode":"pau"},{"affno":"","first":"Margarita","key":"elkjaerpau","last":"Elkjaer","name":"Elkjaer, Margarita","rank":10,"rolecode":"pau"},{"affno":"","first":"Natalia","key":"pedersenpau","last":"Pedersen","name":"Pedersen, Natalia","rank":11,"rolecode":"pau"},{"affno":"","first":"Elisabeth","key":"knudsenpau","last":"Knudsen","name":"Knudsen, Elisabeth","rank":12,"rolecode":"pau"},{"affno":"3","first":"Paal Skytt","key":"andersenpau","last":"Andersen","name":"Andersen, Paal Skytt","rank":13,"rolecode":"pau"}],"pmid":["21701837"],"pub":{"doi":"10.1007/s10620-011-1794-8","issn":["01632116","15732568"],"issn_org":["01632116"],"issue":"12","journal":"Digestive Diseases and Sciences","pages":"3517-24","status":"p","title":"Digestive Diseases and Sciences","volume":"56"},"review":"Peer Reviewed","scoID":["2-s2.0-84856137706"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-a422ba0d-5383-41fb-9287-056b0a1aecc4"],"src":["KU University of Copenhagen"],"title":"Alpha-defensin DEFA1A3 gene copy number elevation in Danish Crohn's disease patients","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-491494","year":"2011","yearsub":"2011"}
{"abstract":"Abstract Aim. Atrial angiotensin II (Ang II) levels are increased in atrial fibrillation and are believed to be important in the pathogenesis of atrial arrhythmias. Ang II reduces intercellular coupling by inhibiting gap junctions (connexins) and may thereby increase the risk of reentry arrhythmia. The aim of the current study was to investigate the acute effect of Ang II on conduction velocity (CV) in atrial tissue from normal and chronically infarcted rats. Methods. Contractile force was measured and CV was determined from the conduction time between electrodes placed on the tissue preparation. Expression of AT1a and AT1b receptors was examined by real-time PCR. Results. Acute stimulation with Ang II did not affect CV in tissue from auricle or atrial free wall. A transient 6.5 ± 3.6% increase in resting tension was observed in atrial free wall preparations, indicating that receptors are present and functional in the free wall preparation. The difference between free wall and auricle was probably not caused by differences in receptor expression since equal amounts of AT1 mRNA were present. To test if myocardial infarction (MI) sensitizes the atrium to Ang II, free atrial wall from rats subjected to 4-5 weeks ventricular MI was examined. Although CV was significantly reduced by MI, no effect on CV of Ang II was seen. Conclusion. Ang II does not acutely regulate CV in tissue preparations from the free wall of the left atria or the left auricle. Although ventricular MI reduces CV, this does not sensitize the atria to Ang II.","author_count":6,"contributors":["Olsen, Kristine Boisen","Braunstein, Thomas Hartig","Sørensen, Charlotte Mehlin","Axelsen, Lene Nygaard","von Holstein-Rathlou, Niels-Henrik","Nielsen, Morten Schak"],"cuid":["S01-000.00-514293"],"filters":{"added":"2022-04","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Faculty of Health and Medical Sciences"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"angiotensin ii does not acutely regulate conduction velocity in rat atrial tissue","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-514293","identifier":[{"id":"80052949394","type":"scopus"},{"id":"21728898","type":"pmid"}],"ids":["ku-ca5bf848-da40-43df-a9c0-19715ae6fd1e"],"keyword":["Faculty of Health and Medical Sciences"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-8C7C8CEBA5527CAA92BFA8C107DD2F7F"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Biomedical Sciences, Molecular Cardiology and Membrane Proteins"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Kristine B","key":"olsenpau","last":"Olsen","locid":"cafbc17d-e506-48eb-9b0e-6a1ab02008ad","name":"Olsen, Kristine Boisen","name_org":"Olsen, Kristine B","orcid":"0000-0002-8675-8589","rank":1,"rolecode":"pau"},{"affno":"1","first":"Thomas H","key":"braunsteinpau","last":"Braunstein","locid":"bcf3512f-c187-470a-9589-e975d7685151","name":"Braunstein, Thomas Hartig","name_org":"Braunstein, Thomas H","rank":2,"rolecode":"pau"},{"affno":"1","first":"Charlotte M","key":"sørensenpau","last":"Sørensen","locid":"0ceca69d-e5cd-43dc-9995-305ac5855c4f","name":"Sørensen, Charlotte Mehlin","name_org":"Sørensen, Charlotte M","orcid":"0000-0002-9984-3125","rank":3,"rolecode":"pau"},{"affno":"1","first":"Lene Nygaard","key":"axelsenpau","last":"Axelsen","locid":"2632f623-a6d6-49e1-884c-0560715787be","name":"Axelsen, Lene Nygaard","rank":4,"rolecode":"pau"},{"aff