"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jose","key":"abdelnournocerapau","last":"Abdelnour-Nocera","name":"Abdelnour-Nocera, Jose","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Daniel G","key":"cabreropau","last":"Cabrero","name":"Cabrero, Daniel G","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Pedro","key":"campospau","last":"Campos","name":"Campos, Pedro","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Frederica","key":"gonçalvespau","last":"Gonçalves","name":"Gonçalves, Frederica","rank":4,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Torkil","key":"clemmensenpau","last":"Clemmensen","name":"Clemmensen, Torkil","rank":5,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Robin","key":"gissingpau","last":"Gissing","name":"Gissing, Robin","rank":6,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Lene","key":"nielsenpau","last":"Nielsen","locid":"1052b289-f510-4c5a-9662-2db48c12ebc2","name":"Nielsen, Lene","orcid":"0000-0003-1768-7147","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Parisa","key":"saadatipau","last":"Saadati","name":"Saadati, Parisa","rank":8,"rolecode":"pau"}],"pub":{"doi":"10.1145/3419249.3420093","eisbn":["9781450375795/20/10"],"pages":"1-3","publisher":"Association for Computing Machinery","status":"p","title":"Proceedings of the 11th Nordic Conference on Human-Computer Interaction: Shaping Experiences, Shaping Society (NordiCHI '20)."},"review":"Undetermined","scoID":["2-s2.0-85123041028"],"search":{"DAF":["All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-d990a4a8-f5f1-49f9-8d6e-e5899c637b5d"],"src":["ITU IT University of Copenhagen"],"title":"Co-Desi