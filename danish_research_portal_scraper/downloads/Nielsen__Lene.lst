science, Department of Ecoscience - Terrestrial Ecology"],"nora_code":"DI-U-AU","used":1},{"affno":"3","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Kristin Marie","key":"lassenpau","last":"Lassen","name":"Lassen, Kristin Marie","orcid":"0000-0003-3274-4875","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"M","key":"ouédraogopau","last":"Ouédraogo","name":"Ouédraogo, M","rank":2,"rolecode":"pau"},{"affno":"","first":"Moussa","key":"ouedraogopau","last":"Ouedraogo","name":"Ouedraogo, Moussa","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Yoko Luise","key":"dupontpau","last":"Dupont","locid":"2a165175-a558-448c-9b2e-8fe1150a0fac","name":"Dupont, Yoko Luise","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Erik Dahl","key":"kjærpau","last":"Kjær","name":"Kjær, Erik Dahl","orcid":"0000-0001-8624-1611","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Lene Rostgaard","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Lene Rostgaard","orcid":"0000-0002-7214-8691","rank":5,"rolecode":"pau"}],"pub":{"issn":["19207603"],"issue":"3","journal":"Journal of Pollination Ecology","pages":"22-34","publisher":"Enviroquest Ltd.","status":"p","title":"Journal of Pollination Ecology","volume":"20"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-87c021de-e16c-4ad6-a5ad-833d945aa34a","ku-484b8518-399b-4106-86bb-46f23b098407"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"HONEY BEES ENSURE THE POLLINATION OF PARKIA BIGLOBOSA IN ABSENCE OF BATS","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-095.71-022557","year":"2017","yearsub":"2017"}
{"abstract":"Background: Improved carbohydrate-active enzymes (CAZymes) are needed to fulfill the goal of producing food, feed, fuel, chemicals, and materials from biomass. Little is known about how the diverse microbial communities in anaerobic digesters (ADs) metabolize carbohydrates or which CAZymes that are present, making the ADs a unique niche to look for CAZymes that can potentiate the enzyme blends currently used in industry. Results: Enzymatic assays showed that functional CAZymes were secreted into the AD environments in four full-scale mesophilic Danish ADs fed with primary and surplus sludge from municipal wastewater treatment plants. Metagenomes from the ADs were mined for CAZymes with Homology to Peptide Patterns (HotPep). 19,335 CAZymes were identified of which 30% showed 50% or lower identity to known proteins demonstrating that ADs make up a promising pool for discovery of novel CAZymes. A function was assigned to 54% of all CAZymes identified by HotPep. Many different α-glucan-acting CAZymes were identified in the four metagenomes, and the most abundant family was glycoside hydrolase family 13, which contains α-glucan-acting CAZymes. Cellulytic and xylanolytic CAZymes were also abundant in the four metagenomes. The cellulytic enzymes were limited almost to endoglucanases and β-glucosidases, which reflect the large amount of partly degraded cellulose in the sludge. No dockerin domains were identified suggesting that the cellulytic enzymes in the ADs studied operate independently. Of xylanolytic CAZymes, especially xylanases and β-xylosidase, but also a battery of accessory enzymes, were present in the four ADs. Conclusions: Our findings suggest that the ADs are a good place to look for novel plant biomass degrading and modifying enzymes that can potentiate biological processes and provide basis for production of a range of added-value products from biorefineries.","author_count":7,"contributors":["Wilkens, Casper","Busk, Peter Kamp","Pilgaard, Bo","Zhang, Wen Jing","Nielsen, Kåre Lehmann","Nielsen, Per Halkjær","Lange, Lene"],"cuid":["S02-099.84-003936"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Lange, Lene"],"keyword":["Anaerobic digester","Bacteria","Carbohydrate active enzymes","Carbohydrate binding module","Carbohydrate esterase","Carbohydrate hydrolysis","Enzyme discovery","Glycoside hydrolase","Glycosyltransferase","Metagenomics","Peptide pattern recognition","Polysaccharide lyase","Wastewater treatment"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-AAU","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"diversity of microbial carbohydrate active enzymes in danish anaerobic digesters fed with wastewater treatment sludge","src":["aau","dtu"],"src-code":["DI-U-AAU","DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1186/s13068-017-0840-y","version":"Published Version"},"id":"S02-099.84-003936","identifier":[{"id":"PMC5480151","type":"pmcid"},{"id":"28649277","type":"pmid"},{"id":"000403788200001","type":"wos"},{"id":"85021687726","type":"scopus"}],"ids":["aau-5079bba8-fac0-453e-8a82-bfae9ab79a7f","dtu-4bd1373c-5a10-4e31-8ac7-c92fee2f1b6e"],"keyword":["Anaerobic digester","Bacteria","Carbohydrate esterase","Carbohydrate hydrolysis","Carbohydrate-active enzymes","Carbohydrate-binding module","Enzyme discovery","Glycoside hydrolase","Glycosyltransferase","Metagenomics","Peptide pattern recognition","Polysaccharide lyase","Wastewater treatment"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-DFE1D714B8AB83762124A3A8486E716F"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC5480151/pdf/13068_2017_Article_840.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1186/s13068-017-0840-y","version":"Published Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/133383873/Diversity_of_microbial.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Chemical and Biochemical Engineering","Technical University of Denmark, Department of Chemical and Biochemical Engineering, Center for BioProcess Engineering"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience, Section for Sustainable Biotechnology, Copenhagen"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Casper","key":"wilkenscasperpau","last":"Wilkens","locid":"d26028c1-6ef8-48e2-8810-cb3db9f32c14","name":"Wilkens, Casper","orcid":"0000-0001-7692-067X","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Peter Kamp","key":"buskpeterkamppau","last":"Busk","name":"Busk, Peter Kamp","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Bo","key":"pilgaardbopa