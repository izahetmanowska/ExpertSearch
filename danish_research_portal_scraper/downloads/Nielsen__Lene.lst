l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-SSI","l3nn":"SSI Statens Serum Institut","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SSI Statens Serum Institut","namevar":["Statens Serum Institut"],"nora_code":"DI-GV-SSI","used":1},{"affno":"3","country":"dk","key":"nfa national research centre for the working environment","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-WORK","l3nn":"NFA National Research Centre for the Working Environment","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"NFA National Research Centre for the Working Environment","namevar":["National Research Centre for the Working Environment"],"nora_code":"DI-GV-WORK","used":1},{"affno":"4","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["University Hospital Herlev"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Katrine","key":"uhrbrandpau","last":"Uhrbrand","locid":"6e66f1d6-875e-420a-abf6-6c21f8d143f9","name":"Uhrbrand, Katrine","orcid":"0000-0001-9118-8448","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jannik","key":"fonagerpau","last":"Fonager","name":"Fonager, Jannik","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Anne Mette","key":"madsenpau","last":"Madsen","name":"Madsen, Anne Mette","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Thea","key":"kølsenfischerpau","last":"Kølsen Fischer","name":"Kølsen Fischer, Thea","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Karl","key":"pedersenpau","last":"Pedersen","locid":"d1138736-2a78-423a-9950-0ce651434ec7","name":"Pedersen, Karl","rank":5,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Lene","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Lene","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anna Charlotte","key":"schultzpau","last":"Schultz","locid":"3a3d5130-acf6-4846-93e3-f3b891d83e60","name":"Schultz, Anna Charlotte","orcid":"0000-0003-1484-9120","rank":7,"rolecode":"pau"}],"pub":{"pages":"75-76","place":"Copenhagen","publisher":"American Society for Microbiology","status":"p","subtitle":"Programme &amp; Abstracts","title":"The Danish Microbiological Society Annual Congress 2016"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-fa28fff8-594c-4bbd-b2ba-5b80c9c3d734"],"src":["DTU Technical University of Denmark"],"title":"Association between exposure to airborne noroviruses and gastroenteritis among wastewater workers","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-379422","year":"2016","yearsub":"2016"}
{"abstract":"BACKGROUND: Antiretroviral (ART) drugs have been associated with higher triglycerides (TG), higher total cholesterol (TC) and lower high-density lipoprotein cholesterol (HDL-C) levels. Associations between lipid levels with HIV viraemia and immunosuppression in the presence of ART remain unclear. METHODS: Participants from the D:A:D study with at least one TG/TC/HDL-C measurement were included. Linear mixed effect models were used to determine the association of ART, viral load (VL), nadir and current CD4(+) T-cell count and previous AIDS diagnosis with lipids. RESULTS: Of 49,717 participants, 90%, 92% and 80% contributed at least one TG/TC/HDL-C measurement (median follow-up 6.8, 6.8 and 5.0 years, respectively). Predicted mean (95% CI) baseline levels for TG, TC and HDL-C (mmol/l), were 2.10 (2.05, 2.14), 4.94 (4.91, 4.98) and 1.08 (1.07, 1.10), respectively. Lopinavir was associated with the worst TG profile, (27.2% higher levels compared to atazanavir; 95% CI 25.2%, 29.2%), and darunavir had a similar profile as atazanavir. The nucleoside pair lamivudine/tenofovir was associated with the most favourable TG profile (-2.8%; -3.5%, -2.0%) compared with emtricitabine/tenofovir, whereas lamivudine/abacavir (+10.2%; +9.3%, +11.2%) and lamivudine/stavudine (+8.0%; +6.9%, +9.0%), were associated with the worst. Raltegravir was associated with lower TG (-5.2%; -6.4%, -3.9%), and nevirapine had a more favourable HDL-C profile (+11.3%; +10.8%, +11.7%) than efavirenz (+5.3%; 5.0%, 5.7%), compared to atazanavir. Higher VLs were associated with lower TG/TC/HDL-C, whereas higher CD4(+) T-cell counts were associated with higher TG/TC/HDL-C. CONCLUSIONS: TG, TC and HDL-C levels, which generally improved over time, are dependent on ART, viraemia and, to a lesser extent, immunosuppression.","author_count":14,"contributors":["Kamara, David A","Smith, Colette","Nielsen, Lene Ryom","Reiss, Peter","Rickenbach, Martin","Phillips, Andrew","Mocroft, Amanda","De Wit, Stephan","Law, Matthew","Monforte, Antonella d'Arminio","Dabis, Francois","Pradier, Christian","Lundgren, Jens","Sabin, Caroline"],"cuid":["S01-000.00-430887"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"longitudinal analysis of the associations between antiretroviral therapy viraemia and immunosuppression with lipid levels the d a d study","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-430887","identifier":[{"id":"27114439","type":"pmid"},{"id":"84999036977","type":"scopus"}],"ids":["ku-3ea5a351-2d80-4b0d-a132-be3f036db1b9"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-FA878BBEB523C87C124681AAA6893E7E"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Immunology and Microbiology, CHIP","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Immunology and Microbiology, Department of Immunology and Microbiology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"David A","key":"kamarapau","last":"Kamara","name":"Kamara, David A","rank":1,"rolecode":"pau"},{"affno":"","first":"Colette","key":"smithpau","last":"Smith","name":"Smith, Colette","rank":2,"rolecode":"pau"},{"affno":"1","first":"Lene","key":"ryompau","last":"Ryom","locid":"0087fd9d-3a4d-4da5-9f4d-2ba51ec7d7a8","name":"Nielsen, Lene Ryom","n