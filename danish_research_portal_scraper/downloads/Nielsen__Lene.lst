rsity of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-01b1a303-11ba-434c-a065-6009c8799cb3","sdu-860249db-c27f-402e-90eb-b72b0ea6f281"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Effect of Influenza Vaccination on Risk of Coronavirus Disease 2019 : A Prospective Cohort Study of 46 000 Healthcare Workers( )","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-094.93-039725","year":"2022","yearsub":"2022"}
{"abstract":"AIM: To illuminate using body composition measurements for malnutrition measured by Bio Impedance Analysis (BIA), as opposed to body mass index (BMI), and discuss benefits and burdens for fundamental nursing care. DESIGN: A second analysis of a prospective, descriptive cohort study, targeting fundamental nursing care elements. METHODS: This postevaluation study explored data from a prospective, descriptive cohort study, which consecutively included 92 patients admitted for neurorehabilitation care. Measures of nutritional status were BMI and FFMI. Chi-Square test and Multivariable logistic regression were used. RESULTS: Body composition measures rather than BMI contributed to target individual nutritional nursing care as this measure detected more patients at potential risk of malnutrition and indicated minor changes in the nutritional state. Transitions from being malnourished to a normal nutritional status occurred in 29% using the BMI definition while it was the case in 40% of individuals with malnutrition defined by the body composition.","author_count":5,"contributors":["Aadal, Lena","Odgaard, Lene","Feldbaek Nielsen, Jørgen","Rasmussen, Henrik Højgaard","Holst, Mette"],"cuid":["S02-095.82-010740"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"corresponding_author":["Aadal, Lena"],"keyword":["Brain injury","Malnutrition","Nursing","Nutrition","Rehabilitation","Subacute"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-HO-CDR","DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"body composition measures may help target fundamental nutritional nursing efforts in rehabilitating patients with acquired brain injury","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1002/nop2.981","version":"Published Version"},"id":"S02-095.82-010740","identifier":[{"id":"000668183500001","type":"wos"},{"id":"85108945077","type":"scopus"},{"id":"34190414","type":"pmid"},{"id":"PMC9584462","type":"pmcid"}],"ids":["aau-e0e6d676-eaca-45bf-b9c9-80b833d531ab","au-e2feb8ca-69df-4adf-9a75-8ddc28c2ff1f"],"keyword":["brain injury","malnutrition","nursing","nutrition","rehabilitation","subacute"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-F6DF05FAE4B79227333DED84B112E64E"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/505539213/Aadal_et_al_2022_Body_composition_measures_may_help_target_fundamental_nutritional_nursing_efforts_in_rehabilitating_patients_with_acquired_brain_injury.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1002/nop2.981","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Hammel Neurocenter, Universitetsklinik for Neurorehabilitering"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Regional Hospital Central and West Jutland"],"nora_code":"DI-HO-CDR","used":1},{"affno":"3","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Centre for Nutrition and Bowel Disease","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Gastroenterology and Hepatology","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Medicin og Akut","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Lena","key":"aadalpau","last":"Aadal","locid":"a3a1966b-710e-489c-a729-810645c717b5","name":"Aadal, Lena","orcid":"0000-0001-7365-3916","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Lene","key":"odgaardpau","last":"Odgaard","locid":"1b80fe7b-ba0a-45b3-aca1-48bc19a97a44","name":"Odgaard, Lene","orcid":"0000-0002-9830-3282","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jørgen","key":"feldbæknielsenpau","last":"Feldbæk Nielsen","locid":"3fb25b9f-381b-44a6-a8dd-26eacf839d37","name":"Nielsen, Jørgen Feldbæk","name_org":"Feldbæk Nielsen, Jørgen","orcid":"0000-0001-5339-171X","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Henrik Højgaard","key":"rasmussenpau","last":"Rasmussen","locid":"c242f457-53f4-4b88-82f3-d7fb297cf98c","name":"Rasmussen, Henrik Højgaard","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Mette","key":"holstpau","last":"Holst","locid":"28beee90-db56-4b02-8832-fef8820eb5f4","name":"Holst, Mette","orcid":"0000-0002-7458-9458","rank":5,"rolecode":"pau"}],"pmid":["34190414"],"pub":{"doi":"10.1002/nop2.981","issn":["20541058"],"issue":"6","journal":"Nursing Open","pages":"2793-2803","publisher":"Wiley-Blackwell Publishing Ltd","status":"p","title":"Nursing Open","volume":"9"},"review":"Peer Reviewed","scoID":["2-s2.0-85108945077"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities"],"PST":["Published"]},"sid":["aau-e0e6d676-eaca-45bf-b9c9-80b833d531ab","au-e2feb8ca-69df-4adf-9a75-8ddc28c2ff1f"],"src":["AAU Aalborg University","AU Aarhus University"],"title":"Body composition measures may help target fundamental nutritional nursing efforts in rehabilitating patients with acquired brain injury","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-095.82-010740","year":"2022","yearsub":"2022"}
{"abstract":"PURPOSE: The ENFORCE cohort is a national Danish prospective cohort of adults who received a severe acute respiratory syndrome coronavirus 2 (SARS-CoV-2) vaccine as part of the Danish National SARS-CoV-2 vaccination programme. It was designed to investigate the long-term effectiveness, safety and durability of SARS-CoV-2 vaccines used in Denmark. PARTICIPANTS: A total of 6943 adults scheduled to receive a SARS-CoV-2 vaccine in the Danish COVID-19 vaccination programme were enrolled in the study prior to their first vaccination. Participants will be followed for a total of 2 years with five predetermined follow-up visits and additional visits in relation to any booster vaccination. Serology measurements are performed after each study visit. T-cell immunity is evaluated at each study visit for a subgroup of 699 participants. Safety information is collected from participants at visits following each vaccination. Data on hospital admissions, diagnoses, deaths and SARS-CoV-2 PCR results are collected from national registries throughout the study period. The median age of participants was 64 years (IQR 53-75), 56.6% were women and 23% were individuals with an increased risk of a serious course of COVID-19. A total of 340 (4.9%) participants tested positive for SARS-CoV-2 spike IgG at baseline. FINDINGS TO DATE: Results have been published on risk factors for humoral hyporesponsiveness and non-durable response to SARS-CoV-2 vaccination, the risk of breakthrough infections at different levels of SARS-CoV-2 spike IgG by viral variant and on the antibody neutralising capacity against different SARS-CoV-2 variants following primary and booster vaccinations. FUTURE PLANS: The ENFORCE cohort will continuously generate studies investigating immunological response, effectiveness, safety and durability of the SARS-CoV-2 vaccines. TRIAL REGISTRATION NUMBER: NCT04760132.","author_count":20,"contributors":["Stærke, Nina Breinholt","Reekie, Joanne","Johansen, Isik S","Nielsen, Henrik","Benfield, Thomas","Wiese, Lothar","Søgaard, Ole S","Tolstrup, Martin","Iversen, Kasper Karmark","Tarp, Britta","Larsen, Fredrikke Dam","Larsen, Lykke","Lindvig, Susan Olaf","Holden, Inge Kristine","Iversen, Mette Brouw","Knudsen, Lene Surland","Fogh, Kamille","Jakobsen, Marie Louise","Traytel, Anna Katrin","Ostergaard, Lars","Lundgren, Jens"],"cuid":["S04-100.00-004209"],"filters":{"added":"2023-02","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"corpau":["ENFORCE Study Group"],"corresponding_author":["Stærke, Nina Breinholt"],"keyword":["Adult","Aged","Antibodies Viral","COVID 19 Vaccines adverse effects","COVID 19 epidemiology","Cohort Studies","Covid 19","Denmark epidemiology","Female","Humans","Immunoglobulin G","Immunology","Infection control","Male","Middle Aged","Prospective Studies","SARS CoV 2","Vaccination"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-SDR","DI-HO-ZEA"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-SDR","DI-HO-ZEA","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"cohort profile the danish national cohort study of effectiveness and safety of sars cov 000000000002 vaccines enforce","src":["aau","au","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1136/bmjopen-2022-069065","version":"Published Version"},"id":"S04-100.00-004209","identifier":[{"id":"PMC9809224","type":"pmcid"},{"id":"85145425009","type":"scopus"},{"id":"36585137","type":"pmid"}],"ids":["aau-56206e84-aa1a-4f0b-a17c-ecd5b6907e19","au-98d0365d-e313-4dfc-9995-672add5c3e8d","ku-971f19fa-8b22-4427-9fc4-ad4fef20172e","sdu-ec935979-0104-4985-a897-829a32be7c20"],"ke