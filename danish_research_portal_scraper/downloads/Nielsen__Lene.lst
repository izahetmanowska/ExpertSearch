All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Region Zealand","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-cf4193d6-d32c-4d58-9e16-88260b9625a4","ku-f390e5cd-96bd-43be-92eb-dc2187fd2d79","sdu-c4a5b85a-db6c-4e35-9890-19a057625b2a"],"src":["AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Consensus on technical procedures for simulation-based training in anaesthesiology : A Delphi-based general needs assessment","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-094.74-716108","year":"2019","yearsub":"2019"}
{"abstract":"Through a close reading of media reporting from 2017 to 2018 on the case of the Chinese girl Liu Yiming, who was fi rst denied then granted residency in Denmark due to public pressure, this article analyses how regulation of family reunifi cation involving children is negotiated in the Danish public imaginary in the context of strong anti-immigration sentiments. This imaginary projects the white Danish public as eager to love Yiming and as aff ectively invested in reversing the injustice done to her and her family. The article suggests, however, that the outpouring of white love, which functions as an aff ective intervention imbued with the promises of reversing Yiming’s deportation, is deeply embedded in exceptionalist notions of the ‘integrated’ migrant and that it works to restore an idealised image of a Danish nation defi ned by ‘human decency’ as a core value. Thus, the analysis raises critical questions to the politics of white love and its promise of securing social change for the ‘integrated’ migrant through collective acts of white feeling.","author_count":2,"contributors":["Smedegaard Nielsen, Asta","Myong, Lene"],"cuid":["S01-000.00-096915"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Smedegaard Nielsen, Asta"],"country":["Norway"],"glorg":["All Global Affiliations","University of Stavanger"],"keyword":["Affect","Affekt","Danmark","Denmark","Familiesammenføring","Family reunification","Hvidhed","Media","Medieanalyse","Nation","Whiteness"],"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"white danish love as affective intervention studying media representations of family reunification involving children","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.2478/njmr-2019-0038","version":"Published Version"},"id":"S01-000.00-096915","identifier":[{"id":"85091682549","type":"scopus"}],"ids":["aau-a1c2951d-0ee1-4344-b3c4-ff7bc42c202e"],"keyword":["Affect","Danmark","Denmark","Family reunification","Media","Whiteness","affekt","familiesammenføring","hvidhed","medieanalyse","nation"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-3-510A1D1684E1B56E2503402D9FECD662"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.2478/njmr-2019-0038","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/331982664/313_622_1_SM.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Social Science (SOC)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Social Sciences","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Politics and Society, GRS - Global Refugee Studies","Aalborg University, The Faculty of Social Sciences, Department of Political Science"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"no","key":"university of stavanger","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"University of Stavanger","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Asta","key":"smedegaardnielsenpau","last":"Smedegaard Nielsen","locid":"e55b5bbb-cf8c-4d84-ab57-b285b66c31ab","name":"Smedegaard Nielsen, Asta","orcid":"0000-0002-9197-1544","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lene","key":"myongpau","last":"Myong","name":"Myong, Lene","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.2478/njmr-2019-0038","issn":["1799649X"],"issue":"4","journal":"Nordic Journal of Migration Research","pages":"497-514","publisher":"De Gruyter Mouton","status":"p","title":"Nordic Journal of Migration Research","volume":"9"},"review":"Peer Reviewed","scoID":["2-s2.0-85091682549"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-a1c2951d-0ee1-4344-b3c4-ff7bc42c202e"],"src":["AAU Aalborg University"],"title":"White Danish Love as Affective Intervention : Studying Media Representations of Family Reunification Involving Children","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-096915","year":"2019","yearsub":"2019"}
{"abstract":"Objective: Age is the most important risk factor for osteoarthritis (OA). It is suggested that changes in subchondral bone and calcified cartilage may occur in early OA. Therefore, the aim was to investigate age-related changes in the femoral head composition. We hypothesise that the thickness of the subchondral bone plate decreases with age, while the thickness of the calcified cartilage increases with age as seen in early-stage OA. Methods: Femoral heads from 29 women (20–74 years) and 32 men (23–78 years), who had died suddenly and unexpectedly, were obtained at autopsy. Individuals with bone or joint diseases or macroscopic abnormal cartilage were excluded. Using design-based stereology, femoral head volume as well as thickness and volume of the calcified cartilage and subchondral bone plate were estimated and correlated to sex and age. Results: The thickness and volume of the subchondral bone plate were not correlated with age. Calcified cartilage thickness and volume correlated positively with age in women, while the femoral head volume was correlated positively with age in men. Conclusion: In human femoral heads obtained from a cross-sectional population without macroscopic OA changes, the thickness of the subchondral bone plate did not change with age, which differs from the thinning seen in early OA. Surprisingly, the age-related changes of the volume and thickness of the calcified cartilage and of the volume of the femoral head were different for women and men. This indicate that cartilage and bone metabolism is sex-specific, which may influence ageing of the hip joint.","author_count":7,"contributors":["Nielsen, Andreas Wiggers","Klose-Jensen, Rasmus","Hartlev, Louise Brøndt","Boel, Lene Warner Thorup","Thomsen, Jesper Skovhus","Keller, Kresten Krarup","Hauge, Ellen Margrethe"],"cuid":["S01-000.00-227068"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Nielsen, Andreas Wiggers"],"keyword":["Ageing","Calcified cartilage","Osteoarthritis","Sex","Subchondral bone plate"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"age related histological changes in calcified cartilage and subchondral bone in femoral heads from healthy humans","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85071968848","version":"Other Version"},"id":"S01-000.00-227068","identifier":[{"id":"31425888","type":"pmid"},{"id":"85071968848","type":"scopus"}],"ids":["au-ab618822-0f46-4507-aca8-2fb4843092e4"],"keyword":["Ageing","Calcified cartilage","Osteoarthritis","Sex","Subchondral bone plate"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-EDD836C1065809954A7200A3B2098025"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Section for Rheumatology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Andreas Wiggers","key":"nielsenpau","last":"Nielsen","locid":"dc3ce48a-c47a-46ef-beac-360aec95aacc","name":"Nielsen, Andreas Wiggers","orcid":"0000-0001-8180-6871","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rasmus","key":"klosejensenpau","last":"Klose-Jensen","locid":"23dd4b1b-5313-4ad6-8e33-00476fc5d97e","name":"Klose-Jensen, Rasmus","rank":2,"rolecode":"pau"},{"affno":"1","corresponding