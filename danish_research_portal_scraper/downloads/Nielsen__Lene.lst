iversity of Saskatchewan","used":1},{"affno":"16","country":"ca","key":"university of lethbridge","loc":["Canada","America, North","OECD"],"name":"University of Lethbridge","used":1},{"affno":"17","country":"ca","key":"university of alberta","loc":["Canada","America, North","OECD"],"name":"University of Alberta","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Tolulope T","key":"sajobipau","last":"Sajobi","name":"Sajobi, Tolulope T","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ridwan A","key":"sanusipau","last":"Sanusi","name":"Sanusi, Ridwan A","rank":2,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Nancy E","key":"mayopau","last":"Mayo","name":"Mayo, Nancy E","rank":3,"rolecode":"pau"},{"affno":"5 6","corresponding":null,"first":"Richard","key":"sawatzkypau","last":"Sawatzky","name":"Sawatzky, Richard","rank":4,"rolecode":"pau"},{"affno":"7 8 9 10","corresponding":null,"country":"dk","first":"Lene","key":"kongsgaardnielsenpau","last":"Kongsgaard Nielsen","locid":"897c29d3-45a2-4178-81b1-b0ba61db5a25","name":"Kongsgaard Nielsen, Lene","orcid":"0000-0003-2083-3870","rank":5,"rolecode":"pau"},{"affno":"11 12 13 14","corresponding":null,"first":"Veronique","key":"sebillepau","last":"Sebille","name":"Sebille, Veronique","rank":6,"rolecode":"pau"},{"affno":"15","corresponding":null,"first":"Juxin","key":"liupau","last":"Liu","name":"Liu, Juxin","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Eric","key":"bohmpau","last":"Bohm","name":"Bohm, Eric","rank":8,"rolecode":"pau"},{"affno":"16","corresponding":null,"first":"Oluwagbohunmi","key":"awosogapau","last":"Awosoga","name":"Awosoga, Oluwagbohunmi","rank":9,"rolecode":"pau"},{"affno":"17","corresponding":null,"first":"Colleen M","key":"norrispau","last":"Norris","name":"Norris, Colleen M","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Stephen B","key":"wiltonpau","last":"Wilton","name":"Wilton, Stephen B","rank":11,"role