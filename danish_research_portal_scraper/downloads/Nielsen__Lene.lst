ær, Amalie Made","rank":2,"rolecode":"pau"},{"affno":"1 3 2 4","corresponding":null,"first":"René","key":"cordtzpau","last":"Cordtz","locid":"49fa43fa-cc2f-4876-bf14-868a1e2288a5","name":"Cordtz, René","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Sofie","key":"bliddalpau","last":"Bliddal","name":"Bliddal, Sofie","rank":4,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Anders Sandermann","key":"mortensenpau","last":"Mortensen","locid":"9eabc50f-0b4c-47d5-86cd-f94ea14f31f0","name":"Mortensen, A. S.","name_org":"Mortensen, Anders Sandermann","rank":5,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Claus Henrik","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Claus Henrik","rank":6,"rolecode":"pau"},{"affno":"4 5","first":"Ulla","key":"feldtrasmussenpau","last":"Feldt-Rasmussen","locid":"b5898535-d448-4e2f-9f41-d5199873676b","name":"Feldt-Rasmussen, Ulla","rank":7,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Karen Buch","key":"lauridsenpau","last":"Lauridsen","locid":"34b19ba6-f0ce-4a8e-bc6f-75462f8b8832","name":"Lauridsen, K. B.","name_org":"Lauridsen, Karen Buch","rank":8,"rolecode":"pau"},{"affno":"3 1","corresponding":null,"country":"dk","first":"Lene","key":"dreyerpau","last":"Dreyer","locid":"b12f9d3c-1fa5-4513-8002-c9fd87d60d53","name":"Dreyer, Lene","orcid":"0000-0002-5156-2922","rank":9,"rolecode":"pau"}],"pmid":["38302173"],"pub":{"doi":"10.3899/jrheum.2023-0907","issn":["0315162X","03800903"],"issn_org":["0315162X"],"issue":"4","journal":"Journal of Rheumatology","pages":"350-359","paperid":"jrheum.2023-0907","publisher":"Journal of Rheumatology","status":"p","title":"Journal of Rheumatology","volume":"51"},"review":"Peer Reviewed","scoID":["2-s2.0-85189770804"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Other Hospitals","Universities","University of Copenhagen","danbio"],"PST":["Published"]},"sid":["aau-0de0b190-0dc6-4c4c-a6e3-ffaff6186aac","ku-3c0aa825-4ce2-480f-a4df-be46161d3fc7"],"src":["AAU Aalborg University","KU University of Copenhagen"],"title":"Polyautoimmunity in Patients With Anticyclic Citrullinated Peptide Antibody–Positive and –Negative Rheumatoid Arthritis : a Nationwide Cohort Study From Denmark","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-097.68-734828","year":"2024","yearsub":"2024"}
{"abstract":"PURPOSE: Unsupervised item-response theory (IRT) models such as polytomous IRT based on recursive partitioning (IRTrees) and mixture IRT (MixIRT) models can be used to assess differential item functioning (DIF) in patient-reported outcome measures (PROMs) when the covariates associated with DIF are unknown a priori. This study examines the consistency of results for IRTrees and MixIRT models. METHODS: Data were from 4478 individuals in the Alberta Provincial Project on Outcome Assessment in Coronary Heart Disease registry who received cardiac angiography in Alberta, Canada, and completed the Hospital Anxiety and Depression Scale (HADS) depression subscale items. The partial credit model (PCM) based on recursive partitioning (PCTree) and mixture PCM (MixPCM) were used to identify covariates associated with differential response patterns to HADS depression subscale items. Model covariates included demographic and clinical characteristics. RESULTS: The median (interquartile range) age was 64.5(15.7) years, and 3522(78.5%) patients were male. The PCTree identified 4 terminal nodes (subgroups) defined by smoking status, age, and body mass index. A 3-class PCM fits the data well. The MixPCM latent classes were defined by age, disease indication, smoking status, comorbid diabetes, congestive heart failure, and chronic obstructive pulmonary disease. CONCLUSION: PCTree and MixPCM were not consistent in detecting covariates associated with differential interpretations of PROM items. Future research will use computer simulations to assess these models' Type I error and statistical power for identifying covariates associated with DIF.","author_count":13,"contributors":["Sajobi, Tolulope T","Sanusi, Ridwan A","Mayo, Nancy E","Sawatzky, Richard","Kongsgaard Nielsen, Lene","Sebille, Veronique","Liu, Juxin","Bohm, Eric","Awosoga, Oluwagbohunmi","Norris, Colleen M","Wilton, Stephen B","James, Matthew T","Lix, Lisa M"],"cuid":["S02-100.00-724518"],"filters":{"added":"2024-02","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["America, North","Europe, EU","OECD"],"corresponding_author":["Sajobi, Tolulope T."],"country":["Canada","France"],"glorg":["All Global Affiliations","INSERM","McGill University","McGill University Health Centre","Trinity Western University","Universite de Nantes","University Hospital of Nantes","University of Alberta","University of British Columbia (UBC)","University of Calgary","University of Lethbridge","University of Manitoba","University of Saskatchewan","Université de Tours"],"keyword":["Alberta","Classification and regression trees","Coronary artery disease","Differential item functioning","Female","Hospital anxiety and depression scale","Humans","Item response theory","Male","Middle Aged","Patient Reported Outcome Measures","Patient reported outcomes","Psychometrics methods","Quality of Life psychology"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-HO-CDR","DI-HO-SDR","DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"unsupervised item response theory models for assessing sample heterogeneity in patient reported outcomes measures","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1007/s11136-023-03560-5","version":"Published Version"},"funding_acknowledgement":["This research is supported by funding from the Canadian Institutes of Health Research Operating Grant (Grant #:438908). LML is supported by a Canada Research Chair in Methods for Electronic Health Data Quality. RS is supported by a Canada Research Chair in Patient-Reported Outcomes."],"id":"S02-100.00-724518","identifier":[{"id":"PMC10894181","type":"pmcid"},{"id":"85180197042","type":"scopus"},{"id":"38127205","type":"pmid"}],"ids":["au-255224b0-f8d3-4815-9af2-883b12a1c1d0","sdu-0ae800e7-278e-45b3-a625-1010127b4934"],"keyword":["Alberta","Classification and regression trees","Coronary artery disease","Differential item functioning","Female","Hospital anxiety and depression scale","Humans","Item response theory","Male","Middle Aged","Patient Reported Outcome Measures","Patient-reported outcomes","Psychometrics/methods","Quality of Life/psychology"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-FE6E9A7629D7C9605EBBB62FC146DC29"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/257024950/s11136-023-03560-5.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1007/s11136-023-03560-5","version":"Published Version"}],"org":[{"affno":"1","country":"ca","key":"university of calgary","loc":["Canada","America, North","OECD"],"name":"University of Calgary","used":1},{"affno":"2","country":"ca","key":"university of manitoba","loc":["Canada","America, North","OECD"],"name":"University of Manitoba","used":1},{"affno":"3","country":"ca","key":"mcgill university health centre","loc":["Canada","America, North","OECD"],"name":"McGill University Health Centre","used":1},{"affno":"4","country":"ca","key":"mcgill university","loc":["Canada","America, North","OECD"],"name":"McGill University","used":1},{"affno":"5","country":"ca","key":"trinity western university","loc":["Canada","America, North","OECD"],"name":"Trinity Western University","used":1},{"affno":"6","country":"ca","key":"university of british columbia","loc":["Canada","America, North","OECD"],"name":"University of British Columbia (UBC)","used":1},{"affno":"7","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU