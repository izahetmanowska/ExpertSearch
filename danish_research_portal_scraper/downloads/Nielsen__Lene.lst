of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Obstetrics and Gynaecology"],"nora_code":"DI-U-KU","used":1},{"affno":"4","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Specialist in Fertility"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Camilla Gry","key":"temmesenpau","last":"Temmesen","locid":"a747937b-dd4b-4bf1-bdc7-3bf6856cc718","name":"Temmesen, Camilla Gry","orcid":"0000-0003-4951-9383","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Tove","key":"faberfrandsenpau","last":"Faber Frandsen","locid":"667c366e-0097-4397-9801-cbeeec3f6c69","name":"Frandsen, Tove Faber","name_org":"Faber Frandsen, Tove","orcid":"0000-0002-8983-5009","rank":2,"rolecode":"pau"},{"affno":"3","first":"Henriette","key":"svarrenielsenpau","last":"Svarre-Nielsen","locid":"8c0dbb49-ded3-4607-aca2-08fd68b6a558","name":"Nielsen, Henriette Svarre","name_org":"Svarre-Nielsen, Henriette","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Kathrine Birch","key":"petersenpau","last":"Petersen","name":"Petersen, Kathrine Birch","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jane","key":"clemensenpau","last":"Clemensen","locid":"1a64bd2f-c3d5-4006-86ac-7e0620155800","name":"Clemensen, Jane","orcid":"0000-0002-6127-1010","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Heidi Lene Myglegård","key":"andersenpau","last":"Andersen","locid":"629b4417-545d-4330-b864-cb60220df996","name":"Andersen, Heidi Lene Myglegård","orcid":"0000-0002-7116-776X","rank":6,"rolecode":"pau"}],"pmid":["36755286"],"pub":{"doi":"10.1186/s12978-022-01548-x","issn":["17424755"],"issue":"1","journal":"Reproductive Health","paperid":"30","publisher":"Springer Nature","status":"p","title":"Reproductive Health","volume":"20"},"review":"Peer Reviewed","scoID":["2-s2.0-85147723404"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","All University Colleges","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","Hospitals","Miscellaneous","Other Research","Universities","University College Absalon","University Colleges","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-f8362176-5c99-4441-9ba2-86f289a3c51b","pha-3086ce5e-3f4f-4278-9601-df6bba286da7","sdu-45df6f81-01a6-4a6d-af77-994ce9d246c6"],"src":["AB University College Absalon","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Women’s reflections on timing of motherhood : a meta-synthesis of qualitative evidence","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-093.10-047519","year":"2023","yearsub":"2023"}
{"abstract":"SARS-CoV-2 Omicron quickly spread globally, also in regions with high vaccination coverage, emphasizing the importance of exploring the immunological requirements for protection against Omicron breakthrough infection. The test-negative matched case-control study (N = 964) characterized Omicron breakthrough infections in triple-vaccinated individuals from the ENFORCE cohort. Within 60 days before a PCR test spike-specific IgG levels were significantly lower in cases compared to controls (GMR [95% CI] for BA.2: 0.83 [0.73-0.95], p = 0.006). Multivariable logistic regression showed significant associations between high antibody levels and lower odds of infection (aOR [95% CI] for BA.2 spike-specific IgG: 0.65 [0.48-0.88], p = 0.006 and BA.2 ACE2-blocking antibodies: 0.46 [0.30-0.69], p = 0.0002). A sex-stratified analysis showed more pronounced associations for females than males. High levels of vaccine-induced antibodies provide partial protection against Omicron breakthrough infections. This is important knowledge to further characterize a threshold for protection against new variants and to estimate the necessity and timing of booster vaccination.","author_count":28,"contributors":["Baerends, Eva A M","Hvidt, Astrid K","Reekie, Joanne","Søgaard, Ole S","Stærke, Nina B","Raben, Dorthe","Nielsen, Henrik","Petersen, Kristine Toft","Juhl, Maria Ruwald","Johansen, Isik S","Lindvig, Susan O","Madsen, Lone W","Wiese, Lothar","Knudsen, Lene S","Iversen, Mette B","Benfield, Thomas","Iversen, Kasper","Andersen, Sidsel D","Juhl, Anna K","Dietz, Lisa L","Andreasen, Signe R","Fischer, Thea K","Erikstrup, Christian","Valentiner-Branth, Palle","Lundgren, Jens","Østergaard, Lars","Tolstrup, Martin"],"cuid":["S04-097.11-724362"],"filters":{"added":"2023-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"corpau":["ENFORCE Study Group","on behalf of the ENFORCE Study Group"],"corresponding_author":["Hvidt, Astrid K"],"keywo