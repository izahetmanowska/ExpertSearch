:"53"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","KU University of Copenhagen"],"PST":["Published"]},"sid":["ku-0c08156b-1096-4165-ab98-0b8d201e1ab0"],"src":["KU University of Copenhagen"],"title":"Sunde træer er produktive forældre : endeligt lidt gode nyheder fra askeskoven","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-400646","year":"2021","yearsub":"2021"}
{"abstract":"BackgroundCongenital cytomegalovirus disease (cCMV) is common and can be fatal or cause severe sequelae. Circulating strains of cytomegalovirus carry a high number of variable or disrupted genes. One of these is UL146, a highly diverse gene with 14 distinct genotypes encoding a CXC-chemokine involved in viral dissemination. UL146 genotypes 5 and 6 lack the conserved ELR motif, potentially affecting strain virulence. Here, we investigate whether UL146 genotypes 5 and 6 were associated with congenital CMV infection.MethodsViral DNA was extracted and UL146 sequenced from 116 neonatal dried blood spots (DBS) stored in the Danish National Biobank since 1982 and linked to registered cCMV cases through a personal identifier. These sequences were compared to UL146 control sequences obtained from CMV DNA extracted from 83 urine samples from children with suspected bacterial urinary tract infections.ResultsThree non-ELR UL146 genotypes (5 and 6) were observed among the cases (2.6%) and two were observed among the controls (2.4%; P>0.99). Additionally, no significant association with cCMV was found for the other 12 genotypes in a post-hoc analysis, although genotype 8 showed a tendency to be more frequent among cases with 12 observations against three (P=0.10). All fourteen genotypes were found to have little intra-genotype variation. Viral load, gender, and sample age were not found to be associated with any particular UL146 genotype.ConclusionsNo particular UL146 genotype was associated with cCMV in this nationwide retrospective case-control study. Associations between CMV disease and disrupted or polymorph CMV genes among immunosuppressed people living with HIV/AIDS and transplant recipients should be investigated in future studies.","author_count":6,"contributors":["Berg, Christian","Rosenkilde, Mette M.","Benfield, Thomas","Nielsen, Lene","Sundelin, Thomas","Luttichau, Hans R."],"cuid":["S01-000.00-419000"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Chemokines","Cytomegalovirus","DBS","Diagnosis","Dried blood spots","GENES","Genotyping","Infection","Receptors","Sequelae"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"the frequency of cytomegalovirus non elr ul000000000146 genotypes in neonates with congenital cmv disease is comparable to strains in the background population","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s12879-021-06076-w","version":"Published Version"},"id":"S01-000.00-419000","identifier":[{"id":"PMC8077815","type":"pmcid"},{"id":"85105281579","type":"scopus"},{"id":"000645594200005","type":"wos"},{"id":"33902487","type":"pmid"}],"ids":["ku-2ae7d6f6-29cd-43ac-922c-d2473982eef8"],"keyword":["CHEMOKINES","Cytomegalovirus","DBS","DIAGNOSIS","DRIED BLOOD SPOTS","ELR","GENES","Genotyping","INFECTION","RECEPTORS","SEQUELAE","SEQUENCE VARIABILITY","UL146","cCMV","vCXCL1"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-D77B2864DF94140A02D8444FD5C98BF6"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s12879-021-06076-w","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/275532600/The_frequency_of_cytomegalovirus_non_ELR.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Biomedical Sciences"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Christian","key":"bergpau","last":"Berg","locid":"86f72e63-bf6f-4dd2-ae8b-7b29f88ffa96","name":"Berg, Christian","orcid":"0000-0002-0539-7081","rank":1,"rolecode":"pau"},{"affno":"1","first":"Mette M.","key":"rosenkildepau","last":"Rosenkilde","locid":"d902feb8-1594-4fa8-bcb1-9f646dc30dd3","name":"Rosenkilde, Mette M.","orcid":"0000-0001-9600-3254","rank":2,"rolecode":"pau"},{"affno":"1","first":"Thomas","key":"benfieldpau","last":"Benfield","locid":"03fdbbba-4bc0-41aa-845b-81ba0bded9ba","name":"Benfield, Thomas","orcid":"0000-0003-0698-9385","rank":3,"rolecode":"pau"},{"affno":"","first":"Lene","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Lene","rank":4,"rolecode":"pau"},{"affno":"","first":"Thomas","key":"sundelinpau","last":"Sundelin","name":"Sundelin, Thomas","rank":5,"rolecode":"pau"},{"affno":"1","first":"Hans R.","key":"luttichaupau","last":"Luttichau","name":"Luttichau, Hans R.","rank":6,"rolecode":"pau"}],"pmid":["33902487"],"pub":{"doi":"10.1186/s12879-021-06076-w","issn":["14712334"],"issue":"1","journal":"BMC Infectious Diseases","paperid":"386","status":"p","title":"BMC Infectious Diseases","volume":"21"},"review":"Peer Reviewed","scoID":["2-s2.0-85105281579"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-2ae7d6f6-29cd-43ac-922c-d2473982eef8"],"src":["KU University of Copenhagen"],"title":"The frequency of cytomegalovirus non-ELR UL146 genotypes in neonates with congenital CMV disease is comparable to strains in the background population","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-419000","year":"2021","yearsub":"2021"}
{"abstract":"Age-related macular degeneration (AMD) is a highly prevalent degenerative disease and a leading cause of vision loss worldwide. Evidence for an inflammatory component in the development of AMD exists, yet the exact mechanisms remain unclear. Bisretinoid N-retinylidene-N-retinylethanolamine (A2E) in retinal pigmental epithelial (RPE) cells, and in extracellular deposits constitutes a hallmark of AMD, but its role in the pathology of AMD is elusive. Here, we tested the hypothesis that A2E is responsible for the heightened inflammatory activity in AMD. To this end, we measured ex vivo mRNA expression of the cytokines TNF-α, IL-6, and IL-10 in whole blood samples after stimulation with A2E in a clinical sample of 27 patients with neovascular AMD and 24 patients with geographic atrophy secondary to AMD. Patients’ spouses (n = 30) were included as non-affected controls. After stimulation with A2E, no statistical differences were found in the median expression level of TNF-α, IL-6, IL-10 between the control group, and the neovascular AMD and the geographic atrophy group. Our findings do not support evidence for the hypothesis, that A2E per se contributes to heightened inflammatory activity in AMD.","author_count":9,"contributors":["Durhuus, Jon Ambæk","Rozing, Maarten Pieter","Nielsen, Marie Krogh","Rue Molbech, Christopher","Keijzers, Guido","Scheibye-Knudsen, Morten","Rasmussen, Lene Juel","Westendorp, Rudi G J","Sørensen, Torben Lykke"],"cuid":["S01-000.00-450280"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-ZEA"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-ZEA","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"ex vivo whole blood stimulation with a000000000002e does not elicit an inflammatory cytokine response in patients with age related macular degeneration","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41598-021-87337-1","version":"Published Version"},"id":"S01-000.00-450280","identifier":[{"id":"85104287419","type":"scopus"},{"id":"33859228","type":"pmid"},{"id":"PMC8050255","type":"pmcid"}],"ids":["ku-5ef91239-53cf-4449-9091-7238356ff4e1"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-BD380596B4440E099415E3BF26EABAB1"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/260592279/s41598_021_87337_1.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41598-021-87337-1","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Cellular and Molecular Medicine, Molecular Aging Program"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"region zealand","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-ZEA","l3nl":"Region Zealand","l3nn":"Region Zealand","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region Zealand","namevar":["Zealand University Hospital - Roskilde"],"nora_code":"DI-HO-ZEA","used":1}],"person":[{"affno":"1","first":"Jon Ambæk","key":"durhuuspau","last":"Durhuus","locid":"6bbbc3d8-f1f2-43ea-a048-a5cc5c18f6f9","name":"Durhuus, Jon Ambæk","rank":1,"rolecode":"pau"},{"affno":"1","first":"Maarten P.","key":"rozingpau","last":"Rozing","locid":"19c14f95-9637-4946-9cf5-a3b2743a620e","name":"Rozing, Maarten Pieter","n