-1611","rank":2,"rolecode":"pau"},{"affno":"","first":"Adja Madjiguene","key":"diallopau","last":"Diallo","name":"Diallo, Adja Madjiguene","rank":3,"rolecode":"pau"},{"affno":"","first":"Lene Rostgaard","key":"nielsenpau","last":"Nielsen","locid":"8e8b51ee-3f45-4ebe-b2fb-fa79f1256d08","name":"Nielsen, Lene Rostgaard","orcid":"0000-0002-7214-8691","rank":4,"rolecode":"pau"},{"affno":"1","first":"Vlastimil","key":"novakpau","last":"Novak","locid":"f51265aa-a147-4aa4-bcfb-9150aa94c1e6","name":"Novák, Vlastimil","name_org":"Novak, Vlastimil","orcid":"0000-0001-7890-4593","rank":5,"rolecode":"pau"},{"affno":"","first":"Diaminatou","key":"sanogopau","last":"Sanogo","name":"Sanogo, Diaminatou","rank":6,"rolecode":"pau"},{"affno":"1","first":"Kristian Holst","key":"laursenpau","last":"Laursen","locid":"553a5ba6-59fe-42de-b5ce-db2be9ea91fa","name":"Laursen, Kristian Holst","orcid":"0000-0001-7900-3324","rank":7,"rolecode":"pau"},{"affno":"","first":"Jon Kehlet","key":"hansenpau","last":"Hansen","locid":"b8c2f3eb-b79f-46cc-b346-8300943e2129","name":"Hansen, Jon Kehlet","orcid":"0000-0002-1260-3509","rank":8,"rolecode":"pau"},{"affno":"","first":"Anders","key":"ræbildpau","last":"Ræbild","locid":"599ea842-1926-48bd-b897-1bc32e9b4912","name":"Ræbild, Anders","orcid":"0000-0002-8793-5663","rank":9,"rolecode":"pau"}],"pub":{"doi":"10.1007/s00468-021-02206-8","issn":["09311890","14322285"],"issn_org":["09311890"],"journal":"Trees - Structure and Function","pages":"295-312","status":"p","title":"Trees - Structure and Function","title_org":"Trees","volume":"36"},"review":"Peer Reviewed","scoID":["2-s2.0-85114007517"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-b1df054e-bc2f-4e7b-819e-f7152ad6750b"],"src":["KU University of Copenhagen"],"title":"Leaf morphology and stable isotope ratios of carbon and nitrogen in <i>Acacia senegal</i> (L.) Wild trees vary with climate at the geographic origin and ploidy level","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-499657","year":"2022","yearsub":"2022"}
{"abstract":"Infective endocarditis (IE) is a serious infection of the inner surface of heart, resulting from minor lesions in the endocardium. The damage induces a healing reaction, which leads to recruitment of fibrin and immune cells. This sterile healing vegetation can be colonized during temporary bacteremia, inducing IE. We have previously established a novel in vitro IE model using a simulated IE vegetation (IEV) model produced from whole venous blood, on which we achieved stable bacterial colonization after 24 h. The bacteria were organized in biofilm aggregates and displayed increased tolerance toward antibiotics. In this current study, we aimed at further characterizing the time course of biofilm formation and the impact on antibiotic tolerance development. We found that a Staphylococcus aureus reference strain, as well as three clinical IE isolates formed biofilms on the IEV after 6 h. When treatment was initiated immediately after infection, the antibiotic effect was significantly higher than when treatment was started after the biofilm was allowed to mature. We could follow the biofilm development microscopically by visualizing growing bacterial aggregates on the IEV. The findings indicate that mature, antibiotic-tolerant biofilms can be formed in our model already after 6 h, accelerating the screening for optimal treatment strategies for IE.","author_count":11,"contributors":["Schwartz, Franziska A.","Nielsen, Luna","Struve Andersen, Jessica","Bock, Magnus","Christophersen, Lars","Sunnerhagen, Torgny","Lerche, Christian Johann","Bay, Lene","Bundgaard, Henning","Høiby, Niels","Moser, Claus"],"cuid":["S02-093.62-038997"],"filters":{"added":"2022-11","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","Nordic","OECD"],"corresponding_author":["Schwartz, Franziska A."],"country":["Sweden"],"glorg":["All Global Affiliations","Lund University"],"keyword":["Antibiotic tolerance","Biofilm","Histopathology","Host response","Infective endocarditis","Organoid"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U","DI-UC"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-KEN"],"U":["DI-U-ALL","DI-U-KU"],"UC":["DI-UC-ALL","DI-UC-KP"]},"level3all":["DI-HO-CAP","DI-HO-KEN","DI-U-KU","DI-UC-KP"]},"review":"pr","rtype":["clu"],"sorti":"dynamics of a staphylococcus aureus infective endocarditis simulation model","src":["kp","ku"],"src-code":["DI-U-KU","DI-UC-KP"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1111/apm.13231","version":"Published Version"},"funding_acknowledgement":["This work was supported by the Novo Nordisk Fonden (NNF17OC0025074) to MD, PhD Claus Moser and the A.P. Møller Fonden (19‐L‐0283) to MD, PhD Christian J. Lerche, the Swedish Society for Medical Research (PD20‐0031), the Tornspiran Foundation, the Foundation for the memory of Sigurd and Elsa Golje (LA2021‐0027), the Lund University foundations (RMh2021‐0001 and RMv2021‐0002), the Längmanska Foundation (BA21‐0430), the Royal Physiographic Society of Lund (42001), and the Thelma Zoégas Fund for Medical Research (TZ2021‐0008) to MD, PhD Torgny Sunnerhagen and the Rigshospitalet introduktionsstipendium (E‐22416‐07) to MSc, Franziska A. Schwartz. This work was supported by the Novo Nordisk Fonden (NNF17OC0025074) to MD, PhD Claus Moser and the A.P. Møller Fonden (19-L-0283) to MD, PhD Christian J. Lerche, the Swedish Society for Medical Research (PD20-0031), the Tornspiran Foundation, the Foundation for the memory of Sigurd and Elsa Golje (LA2021-0027), the Lund University foundations (RMh2021-0001 and RMv2021-0002), the Längmanska Foundation (BA21-0430), the Royal Physiographic Society of Lund (42001), and the Thelma Zoégas Fund for Medical Research (TZ2021-0008) to MD, PhD Torgny Sunnerhagen and the Rigshospitalet introduktionsstipendium (E-22416-07) to MSc, Franziska A. Schwartz. We thank Heidi M. Poulsen from the Panum Histolab for the sample preparations for the microscopy."],"id":"S02-093.62-038997","identifier":[{"id":"35460117","type":"pmid"},{"id":"85130719962","type":"scopus"},{"id":"PMC9545761","type":"pmcid"}],"ids":["kp-6f726677-7b55-4c9c-9b20-bb91508c7619","ku-86063f89-54b8-49ee-abd0-0a1dc0c6ead6"],"keyword":["Biofilm","antibiotic tolerance","histopathology","host response","infective endocarditis","organoid"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-98767859F9BFBA0422EBAF1E1EF7CD5F"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1111/apm.13231","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/321167986/APMIS_2022_Schwartz_Dynamics_of_a_Staphylococcus_aureus_infective_endocarditis_simulation_model.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Immunology and Microbiology, Bacteriology"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"kennedy center","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-KEN","l3nn":"Kennedy Center","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Kennedy Center","namevar":["Kennedy Center"],"nora_code":"DI-HO-KEN","used":1},{"affno":"3","key":"kp university college copenhagen","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-KP","l3nl":"KP","l3nn":"KP University College Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KP University College Copenhagen","namevar":["Københavns Professionshøjskole, Rektors område, Fakultet for sundhedsuddannelser - Dekan, Bioanalytikeruddannelsen"],"nora_code":"DI-UC-KP","used":1},{"affno":"4","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"5","country":"se","key":"lund university","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Lund University","used":1}],"person":[{"affno":"1 2","first":"Franziska A.","key":"schwartzpau","last":"Schwartz","locid":"f3c66876-3cc3-4798-95e4-adfbe8ac0e84","name":"Schwartz, Franziska A.","rank":1,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Luna","key":"nielsenpau","last":"Nielsen","locid":"87019ecc-e6dd-43bd-846a-a78f1d5d9152","name":"Nielsen, Luna","rank":2,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Jessica","key":"struveandersenpau","last":"Struve Andersen","locid":"2bd72a85-7e6c-4d24-a6ec-3f1ba9163d1a","name":"Struve Andersen, Jessica","rank":3,"rolecode":"pau"},{"affno":"4 2","first":"Magnus","key":"bockpau","last":"Bock","name":"Bock, Magnus","rank":4,"rolecode":"pau"},{"affno":"4 2","first":"Lars","key":"christophersenpau","last":"Christophersen","name":"Christophersen, Lars","rank":5,"rolecode":"pau"},{"affno":"4 5 2","first":"Torgny","key":"sunnerhagenpau","last":"Sunnerhagen","name":"Sunnerhagen, Torgny","rank":6,"rolecode":"pau"},{"affno":"4 2","first":"Christian Johann","key":"lerchepau","last":"Lerche","name":"Lerche, Christian Johann","rank":7,"rolecode":"pau"},{"affno":"1","first":"Lene","key":"baypau","last":"Bay","locid":"22f49c41-e569-43c4-8978-94bc9e411869","name":"Bay, Lene","orcid":"0000-0002-4164-5900","rank":8,"rolecode":"pau"},{"affno":"1","first":"Henning","key":"bundgaardpau","last":"Bundgaard","locid":"254c7f8d-79dd-4a5d-870f-3ed78cb56464","name":"Bundgaard, Henning","rank":9,"rolecode":"pau"},{"affno":"1","first":"Niels","key":"høibypau","last":"Høiby","locid":"9dab27ed-3b7b-4a40-b944-1c0067e62930","name":"Høiby, Niels","orcid":"0000-0002-1347-725X","rank":10,"rolecode":"pau"},{"affno":"1","first":"Claus","key":"moserpau","last":"Moser","locid":"c253e3b6-b6c2-4633-9c44-2ccfcef5d5e8","name":"Moser, Claus","orcid":"0000-0002-7664-8570","rank":11,"rolecode":"pau"}],"pmid":["35460117"],"pub":{"doi":"10.1111/apm.13231","issn":["09034641","0903465X"],"issn_org":["09034641"],"issue":"8","journal":"APMIS","pages":"515-523","publisher":"Blackwell Munksgaard","status":"p","title":"APMIS","title_org":"APMIS - Journal of Pathology, Microbiology and Immunology","volume":"130"},"review":"Peer Reviewed","scoID":["2-s2.0-85130719962"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","All University Colleges","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","Hospitals","KP","Universities","University Colleges","University of Copenhagen"],"PST":["Published"]},"sid":["kp-6f726677-7b55-4c9c-9b20-bb91508c7619","ku-86063f89-54b8-49ee-abd0-0a1dc0c6ead6"],"src":["KP University College Copenhagen","KU University of Copenhagen"],"title":"Dynamics of a Staphylococcus aureus infective endocarditis simulation model","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-093.62-038997","year":"2022","yearsub":"2022"}
{"abstract":"Cannabidiol (CBD) is increasingly used as analgesic medication although the recent International Association for the Study of Pain Presidential Task Force on cannabis and cannabinoid analgesia found a lack of trials examining CBD for pain management. This trial examines CBD as add-on analgesic therapy in patients with hand osteoarthritis or psoriatic arthritis experiencing moderate pain intensity despite therapy. Using a randomized, double-blind, placebo-controlled design, patients received synthetic CBD 20 to 30 mg or placebo daily for 12 weeks. The primary outcome was pain intensity during the past 24 hours (0-100 mm); safety outcomes were percentage of patients experiencing adverse events and a characterization of serious adverse events. Explorative outcomes included change in Pittsburgh Sleep Quality Index, Hospital Anxiety and Depression Scale, Pain Catastrophizing Scale (PCS), and Health Assessment Questionnaire Disability Index. One hundred thirty-six patients were randomized, of which 129 were included in the primary analysis. Between-group difference in pain intensity at 12 weeks was 0.23 mm (95% confidence interval -9.41 to 9.90; P = 0.96). Twenty-two percent patients receiving CBD and 21% receiving placebo experienced a reduction in pain intensity of more than 30 mm. We found neither clinically nor statistically significant effects of CBD for pain intensity in patients with hand osteoarthritis and psoriatic arthritis when compared with placebo. In addition, no statistically significant effects were found on sleep quality, depression, anxiety, or pain catastrophizing scores.","author_count":6,"contributors":["Vela, Jonathan","Dreyer, Lene","Petersen, Kristian Kjær","Arendt-Nielsen, Lars","Duch, Kirsten","Kristensen, Salome"],"cuid":["S01-000.00-102202"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Vela, Jonathan"],"keyword":["Cannabidiol","Hand Osteoarthritis","Joint pain","Medical cannabis","Psoriatic arthritis"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"cannabidiol treatment in hand osteoarthritis and psoriatic arthritis a randomized double blind placebo controlled trial","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/442939148/00006396_900000000_97909.pdf","version":"Authors Final Version"},"id":"S01-000.00-102202","identifier":[{"id":"85130634644","type":"scopus"}],"ids":["aau-b39db68f-3809-4f0c-916a-d1860be5c153"],"keyword":["Hand Osteoarthritis","Medical Cannabis","Psoriatic arthritis","cannabidiol","joint pain"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-A317F39EDEDE6585887EF6A283E9383D"],"oa_link":[{"access":"oa","license":"CC BY-NC 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/442939148/00006396_900000000_97909.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Rheumatology","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Medicin og Akut","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jonathan","key":"velapau","last":"Vela","locid":"d37a71fc-d46e-4ea6-b522-4b4f649c44d7","name":"Vela, Jonathan","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lene","key":"dreyerpau","last":"Dreyer","locid":"b12f9d3c-1fa5-4513-8002-c9fd87d60d53","name":"Dreyer, Lene","orcid":"0000-0002-5156-2922","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kristian Kjær","key":"petersenpau","last":"Petersen","locid":"03b38a92-c53c-4b31-a786-05e4893a3e14","name":"Petersen, Kristian Kjær","orcid":"0000-0003-4506-000X","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars Arendt","key":"nielsenpau","last":"Nielsen","locid":"1794f9ec-22f1-47af-96c1-88c23c3b06a2","name":"Arendt-Nielsen, Lars","name_org":"Nielsen, Lars Arendt","orcid":"0000-0003-0892-1579","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kirsten Skjærbæk","key":"duchpau","last":"Duch","locid":"952b4bf9-4968-4e9f-8f30-204e8c36d539","name":"Duch, Kirsten","name_org":"Duch, Kirsten Skjærbæk","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Salome","key":"kristensenpau","last":"Kristensen","locid":"9b80939c-06cf-4c5f-8a04-3107ac4426db","name":"Kristensen, Salome","orcid":"0000-0001-5812-5234","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1097/j.pain.0000000000002466","issn":["03043959","18726623"],"issn_org":["03043959"],"issue":"6","journal":"Pain","pages":"1206-1214","publisher":"Lippincott Williams and Wilkins","status":"p","title":"Pain","volume":"163"},"review":"Peer Reviewed","scoID":["2-s2.0-85130634644"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-b39db68f-3809-4f0c-916a-d1860be5c153"],"src":["AAU Aalborg University"],"title":"Cannabidiol treatment in hand osteoarthritis and psoriatic arthritis : a randomized, double-blind placebo-controlled trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-102202","year":"2022","yearsub":"2022"}
{"abstract":"Background: Persistent post-concussion symptoms (PCS) are associated with prolonged disability, reduced health-related quality of life and reduced workability. At present, no strong evidence for treatments for people with persistent PCS exists. Our research group developed a novel intervention, “Get going After concussIoN (GAIN)”, that incorporates multiple evidence-based strategies including prescribed exercise, cognitive behavioural therapy, and gradual return to activity advice. In a previous randomised trial, GAIN provided in a hospital setting was effective in reducing symptoms in 15–30-year-olds with PCS 2–6 months post-injury. In the current study, we describe the protocol for a trial designed to test the effectiveness of GAIN in a larger municipality setting. Additionally, we test the intervention within a broader age group and evaluate a broader range of outcomes. The primary hypothesis is that participants allocated to enhanced usual care plus GAIN report a higher reduction in PCS 3 months post-intervention compared to participants allocated to enhanced usual care only. Methods: The study is a stepped-wedge cluster-randomised trial with five clusters. The 8-week interdisciplinary GAIN program will be rolled out to clusters in 3-month intervals. Power calculation yield at least 180 participants to be enrolled. Primary outcome is mean change in PCS measured by the Rivermead Post-Concussion Symptoms Questionnaire from enrolment to 3 months after end of treatment. Secondary outcomes include participation in and satisfaction with everyday activities, labour market attachment and other behavioural measures. Self-reported outcomes are measured at baseline, by end of treatment and at 3, 6, and 18 months after end of treatment. Registry-based outcomes are measured up to 36 months after concussion. Discussion: The trial will provide important information concerning the effectiveness of the GAIN intervention in a municipality setting. Furthermore, it will provide knowledge of possible barriers and facilitators that may be relevant for future implementation of GAIN in different settings. Trial registration: The current GAIN trial is registered in ClinicalTrials.gov (study identifier: NCT04798885) on 20 October 2020.","author_count":9,"contributors":["Næss-Schmidt, Erhard Trillingsgaard","Thastum, Mille","Stabel, Henriette Holm","Odgaard, Lene","Pedersen, Asger Roer","Rask, Charlotte Ulrikka","Silverberg, Noah D.","Schröder, Andreas","Nielsen, Jørgen Feldbæk"],"cuid":["S01-000.00-148200"],"filters":{"added":"2022-09","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","OECD"],"corresponding_author":["Næss-Schmidt, Erhard Trillingsgaard"],"country":["United States"],"glorg":["All Global Affiliations","University of California at Berkeley"],"keyword":["Activities of Daily Living","Behavioural therapy","Brain concussion","Head injury","Questionnaire","Return to work","Risk Factors","SCALE","Traumatic brain injury","Validity","mTBI"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"interdisciplinary intervention gain for adults with post concussion symptoms a study protocol for a stepped wedge cluster randomised trial","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s13063-022-06572-7","version":"Published Version"},"id":"S01-000.00-148200","identifier":[{"id":"35906645","type":"pmid"},{"id":"85135140923","type":"scopus"},{"id":"PMC9338593","type":"pmcid"},{"id":"000833015400003","type":"wos"}],"ids":["au-20f67808-9b61-48e0-9b23-e8c2c0ccc834"],"keyword":["Activities of daily living","Behavioural therapy","Brain concussion","HEAD-INJURY","QUESTIONNAIRE","RISK-FACTORS","Return to work","SCALE","TRAUMATIC BRAIN-INJURY","The Rivermead Post-Concussion Questionnaire","VALIDITY","mTBI"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-77334421457BDE3A76D388250D297020"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s13063-022-06572-7","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Hammel Neurocenter, Universitetsklinik for Neurorehabilitering"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"us","key":"university of california at berkeley","loc":["United States","America, North","OECD"],"name":"University of California at Berkeley","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Erhard Trillingsgaard","key":"næssschmidtpau","last":"Næss-Schmidt","locid":"c1a1a6b6-deb0-4e07-8cc0-f7d3beeaca85","name":"Næss-Schmidt, Erhard Trillingsgaard","orcid":"0000-0002-2539-0362","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mille Moller","key":"thastumpau","last":"Thastum","locid":"c3813500-c313-4961-a854-ad2dba72d7d9","name":"Thastum, Mille","name_org":"Thastum, Mille Moller","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henriette Holm","key":"stabelpau","last":"Stabel","locid":"95dbd7bb-fcde-4b0c-9bdf-c6dc2bbf7bb4","name":"Stabel, Henriette Holm","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lene","key":"odgaardpau","last":"Odgaard","locid":"1b80fe7b-ba0a-45b3-aca1-48bc19a97a44","name":"Odgaard, Lene","orcid":"0000-0002-9830-3282","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Asger Roer","key":"pedersenpau","last":"Pedersen","locid":"a9b1b4b8-df5b-437d-a84f-fcc1778ce6eb","name":"Pedersen, Asger Roer","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Charlotte Ulrikka","key":"raskpau","last":"Rask","locid":"1e308742-df61-47da-83ce-53d8a7c774c3","name":"Rask, Charlotte Ulrikka","orcid":"0000-0002-7426-0353","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Noah D.","key":"silverbergpau","last":"Silverberg","name":"Silverberg, Noah D.","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andreas","key":"schröderpau","last":"Schröder","locid":"200c6dd9-43cd-41da-8c27-ce8adb073e24","name":"Schröder, Andreas","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jørgen Feldbæk","key":"nielsenpau","last":"Nielsen","locid":"3fb25b9f-381b-44a6-a8dd-26eacf839d37","name":"Nielsen, Jørgen Feldbæk","orcid":"0000-0001-5339-171X","rank":9,"rolecode":"pau"}],"pmid":["35906645"],"pub":{"doi":"10.1186/s13063-022-06572-7","issn":["14686708","17456215"],"issn_org":["17456215"],"issue":"1","journal":"Trials","paperid":"613","publisher":"BioMed Central Ltd.","status":"p","title":"Trials","volume":"23"},"review":"Peer Reviewed","scoID":["2-s2.0-85135140923"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-20f67808-9b61-48e0-9b23-e8c2c0ccc834"],"src":["AU Aarhus University"],"title":"Interdisciplinary intervention (GAIN) for adults with post-concussion symptoms : a study protocol for a stepped-wedge cluster randomised trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-148200","year":"2022","yearsub":"2022"}
{"abstract":"This project aims to improve self-management skills and health outcomes among Greenlandic people with T2DM and COPD as well as increase quality of life and delay the emergence of comorbidities. Background: Greenland is the biggest island in the world with only 56.000 inhabitants located in 16 towns and 50 smaller settlements. No roads combine towns and settlements, so transportation takes place by flight, helicopter or boat and is often time-consuming and highly dependent on weather conditions. Some of the challenges in the Greenlandic healthcare system in general are employee turnovers, lack of decentralised trained staff in the lifestyle outpatient clinics, as well as cultural and language barriers. Greenlandic people with type 2 diabetes mellitus (T2DM) and chronic obstructive pulmonary disease (COPD) might often need support from the healthcare system to manage their disease. Aim: 1) to investigate experiences of disease among Greenlandic people with T2DM or COPD, 2) to investigate and explore experiences from health care professionals and 3) to develop and test a culturally sensitive and sustainable patient education offer to inhabitants with T2DM and COPD in Greenland. Methods: Experiences and perspectives of Greenlandic people with T2DM or COPD and health care professionals are identified through individual, semi-structured, qualitative interviews using interpretive description (ID) as research methodology and analysis approach. The development and test of the intervention will follow recommendations from the MRC framework and include tools from intervention mapping (IM). Key components from the intervention will be tested in a real-life setting in a feasibility-study in one or two different towns in Greenland. Perspectives: The experiences of Greenlandic people with T2DM or COPD and health care professionals will prepare the ground for the development of the intervention. We expect that the feasibility study will give early indication of effectiveness. The effect of the intervention, will be evaluated by selected clinical and patient reported outcomes among a group of exposed patients and a comparable group of unexposed patients.","author_count":4,"contributors":["Nielsen, Maja Hykkelbjerg","Pedersen, Michael Lynge","Seibæk, Lene","Jensen, Annesofie Lunde"],"cuid":["S01-000.00-268041"],"event":{"end":"2022-11-24","place":"Aarhus, dk","start":"2022-11-24","title":"5th Annual Research Meeting, Institute for Clinical Medicine, Aarhus University","year":"2022"},"filters":{"added":"2023-02","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Nordic"],"country":["Greenland"],"glorg":["All Global Affiliations","Steno Diabetes Center Greenland","University of Greenland"],"level":"pop","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"und","rtype":["clu"],"sorti":"patient education in greenland development and feasibility testing of an intervention to patients with type 000000000002 diabetes and chronic obstructive pulmonary disease","src":["au"],"src-code":["DI-U-AU"],"type":"dco","type-grp":["all","pub"]},"id":"S01-000.00-268041","ids":["au-f32fffab-4899-4c61-925b-d0d4c73f106f"],"lang":"English","level":"Popular","mra":["Medical Science"],"noi":["Local-1-1-36F9512078EC83B124A974EB0CEE9D7F"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - SDCA-Steno Diabetes Center Aarhus"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"gl","key":"university of greenland","loc":["Greenland","Nordic"],"name":"University of Greenland","used":1},{"affno":"3","country":"gl","key":"steno diabetes center greenland","loc":["Greenland","Nordic"],"name":"Steno Diabetes Center Greenland","used":1}],"person":[{"affno":"1 2 3","corresponding":null,"country":"dk","first":"Maja Hykkelbjerg","key":"nielsenpau","last":"Nielsen","locid":"358f245d-ba50-4f0d-9292-c5c2b79ee16b","name":"Nielsen, Maja Hykkelbjerg","orcid":"0000-0003-1373-7661","rank":1,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Michael Lynge","key":"pedersenpau","last":"Pedersen","name":"Pedersen, Michael Lynge","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lene","key":"seibækpau","last":"Seibæk","locid":"2bf95667-24b9-444b-b3e1-a62965aac67a","name":"Seibæk, Lene","orcid":"0000-0002-2396-8669","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Annesofie Lunde","key":"jensenpau","last":"Jensen","locid":"337f63a9-307c-4851-9e53-cf0856200457","name":"Jensen, Annesofie Lunde","orcid":"0000-0003-2025-6663","rank":4,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Undetermined","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-f32fffab-4899-4c61-925b-d0d4c73f106f"],"src":["AU Aarhus University"],"title":"Patient education in Greenland: Development and feasibility testing of an intervention to patients with type 2 diabetes and chronic obstructive pulmonary disease","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-268041","year":"2022","yearsub":"2022"}
{"abstract":"Personas has evolved since Alan Cooper coined the term in 1999, moving into new domains, new ways of collecting data, and with novel ways of presenting the persona profiles. From the beginning, personas was linked to software design, expressing the need for empathy with end-users. This is still the case today, but we want to show how this is executed in different domains, not only in software, and how different forms of presentation relate to empathy. Thus, the persona course investigates the relationship between data collection, the representation of data as persona profiles, and empathy.","author_count":5,"contributors":["Nielsen, Lene","Jansen, Bernard J.","Salminen, joni","Abdelnour-Nocera, Jose","Jung, Soon-Gyo"],"cuid":["S01-000.00-381755"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Asia, Middle East","Europe, EU","Europe, Non-EU","Nordic","OECD"],"country":["Qatar","Sweden","United Kingdom"],"glorg":["All Global Affiliations","Qatar Computing Research institute","Umeå University","University of West London"],"keyword":["Empathy","Personas","Qualitative data","Quantitative data"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"personas new data new trends","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85129768426","version":"Other Version"},"id":"S01-000.00-381755","identifier":[{"id":"85129768426","type":"scopus"}],"ids":["itu-20aa13eb-0702-4665-96df-3c14c5ed6aac"],"keyword":["empathy","personas","qualitative data","quantitative data"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-1789207ABCB09D8AB6F873BFC95197F7"],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"qa","key":"qatar computing research institute","loc":["Qatar","Asia, Middle East"],"name":"Qatar Computing Research institute","used":1},{"affno":"3","country":"gb","key":"university of west london","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of West London","used":1},{"affno":"4","country":"se","key":"umeå university","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Umeå University","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Lene","key":"nielsenpau","last":"Nielsen","locid":"1052b289-f510-4c5a-9662-2db48c12ebc2","name":"Nielsen, Lene","orcid":"0000-0003-1768-7147","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Bernard J.","key":"jansenpau","last":"Jansen","name":"Jansen, Bernard J.","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"joni","key":"salminenpau","last":"Salminen","name":"Salminen, joni","rank":3,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Jose","key":"abdelnournocerapau","last":"Abdelnour-Nocera","name":"Abdelnour-Nocera, Jose","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Soon-Gyo","key":"jungpau","last":"Jung","name":"Jung, Soon-Gyo","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1145/3491101.3503772","pages":"1-3","status":"p","title":"CHI Conference on Human Factors in Computing Systems Extended Abstracts"},"review":"Peer Reviewed","scoID":["2-s2.0-85129768426"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-20aa13eb-0702-4665-96df-3c14c5ed6aac"],"src":["ITU IT University of Copenhagen"],"title":"Personas : New Data, New Trends","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381755","year":"2022","yearsub":"2022"}
{"abstract":"Patients with severe mental illness (SMI) i.e. schizophrenia, schizoaffective disorder, and bipolar disorder are at increased risk of severe outcomes if infected with coronavirus disease 2019 (COVID-19). Whether patients with SMI are at increased risk of COVID-19 is, however, sparsely investigated. This important issue must be addressed as the current pandemic could have the potential to increase the existing gap in lifetime mortality between this group of patients and the background population. The objective of this study was to determine whether a diagnosis of schizophrenia, schizoaffective disorder, or bipolar disorder is associated with an increased risk of COVID-19. A cross-sectional study was performed between January 18th and February 25th, 2021. Of 7071 eligible patients with schizophrenia, schizoaffective disorder, or bipolar disorder, 1355 patients from seven psychiatric centres in the Capital Region of Denmark were screened for severe acute respiratory syndrome coronavirus 2 (SARS-CoV-2) antibodies. A total of 1258 unvaccinated patients were included in the analysis. The mean age was 40.5 years (SD 14.6), 54.3% were female. Fifty-nine of the 1258 participants had a positive SARS-CoV-2 antibody test, corresponding to a adjusted seroprevalence of 4.96% (95% CI 3.87-6.35). No significant difference in SARS-CoV-2-risk was found between female and male participants (RR = 1.32; 95% CI 0.79-2.20; p = .290). No significant differences in seroprevalences between schizophrenia and bipolar disease were found (RR = 1.12; 95% CI 0.67-1.87; p = .667). Seroprevalence among 6088 unvaccinated blood donors from the same region and period was 12.24% (95% CI 11.41-13.11). SARS-CoV-2 seroprevalence among included patients with SMI was significantly lower than among blood donors (RR = 0.41; 95% CI 0.31-0.52; p < .001). Differences in seroprevalences remained significant when adjusting for gender and age, except for those aged 60 years or above. The study is registered at ClinicalTrails.gov (NCT04775407). https://clinicaltrials.gov/ct2/show/NCT04775407?term=NCT04775407&draw=2&rank=1.","author_count":13,"contributors":["Sass, Marie Reeberg","Juul, Tobias Søgaard","Skov, Robert","Iversen, Kasper","Harritshøj, Lene Holm","Sørensen, Erik","Ostrowski, Sisse Rye","Andersen, Ove","Ekstrøm, Claus Thorn","Ullum, Henrik","Nielsen, Jimmi","Hageman, Ida","Fink-Jensen, Anders"],"cuid":["S01-000.00-466613"],"filters":{"added":"2022-08","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Adult","Antibodies Viral blood","COVID 19 blood","Cross Sectional Studies","Female","Humans","Male","Middle Aged","SARS CoV 2 metabolism","Seroepidemiologic Studies"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-OT","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP"],"OT":["Infection Disease Preparedness"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"sars cov 000000000002 seroprevalence among patients with severe mental illness a cross sectional study","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1371/journal.pone.0264325","version":"Published Version"},"id":"S01-000.00-466613","identifier":[{"id":"35231037","type":"pmid"},{"id":"PMC8887729","type":"pmcid"},{"id":"85125591627","type":"scopus"}],"ids":["ku-7a34d252-6db0-41da-af4f-c2bea6bc75dd"],"keyword":["Adult","Antibodies, Viral/blood","COVID-19/blood","Cross-Sectional Studies","Female","Humans","Male","Mental Disorders/blood","Middle Aged","SARS-CoV-2/metabolism","Seroepidemiologic Studies"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-93BD5B70C1A3FD40D0A67B4030A578C7"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://d