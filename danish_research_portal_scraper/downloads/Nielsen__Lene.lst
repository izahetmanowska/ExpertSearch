sponding":null,"first":"Niels","key":"abildgaardpau","last":"Abildgaard","locid":"595418b9-29f8-4fd3-8663-1b32eab3451a","name":"Abildgaard, Niels","orcid":"0000-0001-6852-2014","rank":4,"rolecode":"pau"},{"affno":"4 5","corresponding":null,"first":"Jakob Nordberg","key":"nørgaardpau","last":"Nørgaard","name":"Nørgaard, Jakob Nordberg","rank":5,"rolecode":"pau"},{"affno":"4 5 6","corresponding":null,"first":"Fredrik","key":"schjesvoldpau","last":"Schjesvold","name":"Schjesvold, Fredrik","rank":6,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Region of Southern Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["au-7fa54873-1333-4300-ab83-97c3d46e7e3e","sdu-86786fb7-6c34-451c-bec2-fb7111c03eee"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"Carfilzomib-lenalidomide-dexamethasone consolidation after upfront autologous stem cell transplantation caused no significant patient-reported shortness of breath: findings from the CONPET study","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-080.65-793325","year":"2024","yearsub":"2024"}
{"abstract":"Non-communicable diseases such as chronic obstructive pulmonary disease (COPD) and type 2 diabetes mellitus (T2D) represent major challenges for health systems all over the world. In an interview study, we explored patient experiences and perspectives of being diagnosed and living with COPD or T2D in Greenland. Participants (n = 24) were selected by purposeful sampling and recruited by phone. We conducted individual semi-structured interviews at the National Hospital in Nuuk and the four regional hospitals. Interviews were audio-recorded, transcribed verbatim, and analysed using interpretive description. Three themes emerged: shock and shame on receiving the diagnosis, coping with a changed life, and varying needs for care and communication. We found that being diagnosed with COPD or T2D required a rapid change in the participants' everyday lives and lifestyle behaviours. Some self-managed their disease well and were able to transfer their knowledge and integrate it into their daily lives, while others struggled to make lifestyle changes. Additionally, living with COPD or T2D could be related to silence and shame. The findings contribute to a better understanding of living with COPD or T2D in the Arctic region and the development of future, culturally-adapted patient education initiatives.","author_count":4,"contributors":["Nielsen, Maja Hykkelbjerg","Jensen, Annesofie Lunde","Pedersen, Michael Lynge","Seibæk, Lene"],"cuid":["S02-086.27-724593"],"filters":{"added":"2024-02","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"continent":["Nordic"],"corresponding_author":["Nielsen, Maja Hykkelbjerg"],"country":["Greenland"],"glorg":["All Global Affiliations","Queen Ingrid's Hospital","Steno Diabetes Center Greenland","University of Greenland"],"keyword":["Chronic Disease","Chronic obstructive pulmonary disease","Coping Skills","Diabetes Mellitus Type 2","Greenland epidemiology","Humans","Interpretive description","Non communicable disease","Pulmonary Disease Chronic Obstructive diagnosis","Qualitative Research","Qualitative study","Type 2 diabetes"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"living with chronic obstructive pulmonary disease or type 000000000002 diabetes in greenland a qualitative interpretive description study","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1080/22423982.2023.2296706","version":"Published Version"},"id":"S02-086.27-724593","identifier":[{"id":"85180690036","type":"scopus"},{"id":"PMC10763871","type":"pmcid"},{"id":"38127836","type":"pmid"}],"ids":["au-4c532355-5105-45cb-b742-90fce9a34f52","ku-73163f09-9782-4848-b620-4a4bb26977d8"],"keyword":["Coping Skills","Diabetes Mellitus, Type 2","Greenland/epidemiology","Greenlandic cultural norms","Humans","Non-communicable disease","Pulmonary Disease, Chronic Obstructive/diagnosis","Qualitative Research","chronic disease","chronic obstructive pulmonary disease","interpretive description","qualitative study","type 2 diabetes"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-238EBDC38EB6408F4FDA32074638804A"],"oa_link":[{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/377783563/Living_with_chronic_obstructive_pulmonary_disease_or_type_2_diabetes_in_Greenland_a_qualitative_interpretive_description_study.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1080/22423982.2023.2296706","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark",