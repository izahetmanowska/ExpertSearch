mark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"North Denmark Region","namevar":["Aalborg University Hospital"],"nora_code":"DI-HO-NDR","used":1},{"affno":"4","country":"dk","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University"],"nora_code":"DI-U-AAU","used":1},{"affno":"5","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Lene","key":"kongsgaardnielsenpau","last":"Kongsgaard Nielsen","name":"Kongsgaard Nielsen, Lene","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"TW","key":"klausenpau","last":"Klausen","name":"Klausen, TW","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ida Bruun","key":"kristensenpau","last":"Kristensen","name":"Kristensen, Ida Bruun","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Niels","key":"abildgaardpau","last":"Abildgaard","locid":"595418b9-29f8-4fd3-8663-1b32eab3451a","name":"Abildgaard, Niels","orcid":"0000-0001-6852-2014","rank":4,"rolecode":"pau"},{"affno":"3 4 5","corresponding":null,"first":"Henrik","key":"gregersenpau","last":"Gregersen","name":"Gregersen, Henrik","rank":5,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","North Denmark Region","Other Research","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-69123dd6-62b7-4402-9ee1-2ff48fe8d9a0"],"src":["SDU University of Southern Denmark"],"title":"Clarithromycin added to the VCD regimen causes reduced health-related quality of life in multiple myeloma patients","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-603275","year":"2018","yearsub":"2018"}
{"abstract":"Background In multiple myeloma (MM), high-dose chemotherapy with stem-cell support (HDT) has improved disease free and overall survival in younger newly diagnosed patients without significant effect on health-related quality of life (HR-QoL). Fit relapsed MM patients are often considered for re-induction chemotherapy and salvage HDT. However, the impact of such potentially toxic treatment on HR-QoL is unknown. Therefore, the aim of this study was to evaluate HR-QoL in relapsed HDT-eligible MM patients undergoing a second HDT after re-induction with Carfilzomib-Cyclophosphamide-Dexamethasone (Car-Cy-Dex). Methods Transplant-eligible MM patients with first relapse after primary HDT were treated with four cycles of Car-Cy-Dex and salvage HDT including two doses of Car. Two months post-salvage HDT, HR-QoL was evaluated with patient-reported questionnaires (EORTC QLQ-C30, QLQ-MY20, and the Functional Assessment of Cancer Therapy/Gynecologic Oncology Group-Neurotoxicity (FACT/GOG-Ntx) subscale). The QLQ-C30 data were compared with age-matched Danish normative data and interpreted according to statistical significance (p<0.01) and clinical relevant differences (according to Cocks et al., 2011). Results Ninety-two MM patients (males=57), median age of 62 years (range 43-73) were analyzed. Median time from first HDT was 4.0 years (range 1-11). Patients´ ECOG performance status was 0 in 49 (53%), 1 in 30 (33%), 2 in 1 (1%), and missing for 12 (13%). Completion rates for the EORTC and FACT/GOG-Ntx questionnaires were 100 and 87%, respectively. Patients reported clinical significant worse HR-QoL in 9 out of 14 QLQ-C30 subscales compared with the reference material. The most affected QLQ-MY20 subscale was Future Perspectives. The FACT-GOG-Ntx sub-scale score revealed no clinically meaningful neuropathy. Conclusions In younger MM patients with first relapse after primary HDT, Car-Cy-Dex re-induction chemotherapy and salvage HDT was not associated with neurotoxicity of clinical relevance. Expected short-term effects of clinical significant relevance in several aspects of HR-QoL were reported. Whether these findings are long-lasting will be clarified in the planned long-term follow-up analysis.","author_count":3,"contributors":["Eshoj, Henrik","Kongsgaard Nielsen, Lene","Abildgaard, Niels"],"cuid":["S01-000.00-611404"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"health related quality of life in multiple myeloma patients with first relapse treated with carfilzomib based re induction and salvage high dose chemotherapy with stem cell support preliminary data from the carfi trial nmsg 000000000020 000000000013","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-611404","ids":["sdu-8568dc4f-d80f-4ef6-bbd2-32dfeb4dd6d3"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-F98A7EFE3DFD4FA379BBE711E8202F0F"],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Haematology (Odense)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Henrik","key":"rodeeshojpau","last":"Rode Eshoj","locid":"fae95446-d3b2-4cf5-a9cc-23a7ab55ed16","name":"Eshoj, Henrik","name_org":"Rode Eshoj, Henrik","orcid":"0000-0002-9148-7197","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lene","key":"kongsgaardnielsenpau","last":"Kongsgaard Nielsen","locid":"621d166f-6298-48ed-9f2d-d8d52bb40446","name":"Kongsgaard Nielsen, Lene","orcid":"0000-0003-2083-3870","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Niels","key":"abildgaardpau","last":"Abildgaard","locid":"595418b9-29f8-4fd3-8663-1b32eab3451a","name":"Abildgaard, Niels","orcid":"0000-0001-6852-2014","rank":3,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-8568dc4f-d80f-4ef6-bbd2-32dfeb4dd6d3"],"src":["SDU University of Southern Denmark"],"title":"Health-related quality of life in multiple myeloma patients with first relapse treated with Carfilzomib-based re-induction and salvage high-dose chemotherapy with stem-cell support: preliminary data from the CARFI trial (NMSG 20/13)","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-611404","year":"2018","yearsub":"2018"}
