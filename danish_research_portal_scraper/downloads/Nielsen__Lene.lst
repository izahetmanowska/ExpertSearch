 K.","key":"larsenmortenkrankerpau","last":"Larsen","locid":"c40e7114-22be-4f3d-a2d1-a5ea65fc1ec6","name":"Larsen, Morten Kranker","name_org":"Larsen, Morten K.","rank":5,"rolecode":"pau"},{"affno":"1 8","first":"Anne O.","key":"ganganneortvedpau","last":"Gang","locid":"d6439cff-57cd-406d-b6be-940a96f64f8f","name":"Gang, Anne Ortved","name_org":"Gang, Anne O.","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christoffer","key":"johansenchristofferpau","last":"Johansen","name":"Johansen, Christoffer","rank":7,"rolecode":"pau"},{"affno":"2 8","first":"Lars M.","key":"pedersenlarsmøllerpau","last":"Pedersen","locid":"e0b39d5a-e306-4f2d-af0c-0483ac71df9a","name":"Pedersen, Lars Møller","name_org":"Pedersen, Lars M.","rank":8,"rolecode":"pau"}],"pmid":["39757700"],"pub":{"doi":"10.1002/ajh.27577","issn":["03618609","10968652"],"issn_org":["03618609"],"issue":"3","journal":"American Journal of Hematology","pages":"408-416","publisher":"John Wiley & Sons Inc.","status":"p","title":"American Journal of Hematology","volume":"100"},"review":"Peer Reviewed","scoID":["2-s2.0-85214435280"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-33d22d1a-6f55-4b33-a37e-d5a0af71de0c","ku-c2c241c6-b853-4620-b959-fd876e9c40c6","sdu-47944046-9973-4fbb-a026-2bc719a13c12"],"src":["AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Limited Benefit of Routine Clinical Follow-Up for Relapse Detection in Diffuse Large B-Cell Lymphoma Patients in Complete Remission Following First-Line Treatment","type":"Journal Article","url":"https://local.forskni