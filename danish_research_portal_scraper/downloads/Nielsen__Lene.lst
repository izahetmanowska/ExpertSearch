{"author_count":4,"contributors":["Jespersen, Eva","Kongsgaard Nielsen, Lene","Larsen, Rikke Faebo","Jarlbæk, Lene"],"cuid":["S01-000.00-634384"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"pop","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"und","rtype":["clu"],"sorti":"smerter i hverdagen også når myelomatosen er stabil eller i remission","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-634384","ids":["sdu-d5882343-4b8a-4f4f-a273-76662069e9cc"],"lang":"Danish","level":"Popular","mra":["Medical Science"],"noi":["Local-1-1-D9748D41BEE52D351B224CFCE381C732"],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, Rehabilitation"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Eva","key":"jespersenpau","last":"Jespersen","locid":"04ee9afd-4860-4af1-81ec-31bbbc4c1274","name":"Jespersen, Eva","orcid":"0000-0002-8942-4816","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lene","key":"kongsgaardnielsenpau","last":"Kongsgaard Nielsen","locid":"621d166f-6298-48ed-9f2d-d8d52bb40446","name":"Kongsgaard Nielsen, Lene","orcid":"0000-0003-2083-3870","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rikke Faebo","key":"larsenpau","last":"Larsen","locid":"bf1f2354-216f-47ed-ac3a-92021a7f2e24","name":"Larsen, Rikke Faebo","orcid":"0000-0003-3444-2774","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lene","key":"jarlbækpau","last":"Jarlbæk","locid":"4a7b25fd-395e-46ed-a8e5-71ffa03e9966","name":"Jarlbæk, Lene","orcid":"0000-0001-8702-6788","rank":4,"rolecode":"pau"}],"pub":{"issn":["19027583"],"journal":"Best Practice Nordic","publisher":"BestPractice ApS","status":"p","title":"Best Practice Nordic"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-d5882343-4b8a-4f4f-a273-76662069e9cc"],"src":["SDU University of Southern Denmark"],"title":"Smerter i hverdagen : også når myelomatosen er stabil eller i remission","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-634384","year":"2021","yearsub":"2021"}
{"abstract":"I løbet af en professionsuddannelse gennemgår de studerende en subjektiv dannelsesproces, der handler om at få styr på egen rolle som kommende professionel. Denne proces indebærer, at den enkelte studerende bliver bevidst om hvilke færdigheder, kundskaber, værdier, holdninger mm., der karakteriserer ham/hende som kommende professionsudøver. I dette kapitel bidrager forskellige perspektiver på narrativ teori sammen med empiri fra et forskningsprojekt med fokus på Refleksiv Praksislæring til en forståelse af, hvordan professionsbachelorstuderendes fra henholdsvis pædagog-, lærer- og jordemoderuddannelsen på professionshøjskolen UCN gennem deres fortællinger danner professionel identitet. Analyserne viser, at identitetsdannelsen forløber i en proces, der allerede starter inden uddannelsen påbegyndes, og som fortsætter og udvikler sig successivt gennem hele uddannelsesforløbet, hvor prækære oplevelser og brud i meningssammenhænge spiller en afgørende rolle. I kapitlet argumenteres der desuden for, hvordan Refleksiv Praksislæring didaktisk kan understøtte progression i de studerendes dannelsesproces.","author_count":5,"contributors":["Munch, Per","Nielsen, Lene Stumph"],"cuid":["S01-000.00-652031"],"filters":{"added":"2023-01","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Professionsdidaktik","RPL","Refleksiv praksislæring"],"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-UC"],"level3":{"UC":["DI-UC-ALL","DI-UC-UCN"]},"level3all":["DI-UC-UCN"]},"review":"pr","rtype":["clu"],"sorti":"fortællinger og identitetsdannelse","src":["ucn"],"src-code":["DI-UC-UCN"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://aauforlag.dk/shop/boeger/1-(2).aspx","version":"Other Version"},"id":"S01-000.00-652031","ids":["ucn-b968b17a-33e1-458b-8095-ea1d5af799e3"],"keyword":["RPL","Refleksiv praksislæring","professionsdidaktik"],"lang":