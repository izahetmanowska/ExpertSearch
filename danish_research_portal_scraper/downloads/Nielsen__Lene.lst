rk","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Hospital Pharmacy Central Denmark Region"],"nora_code":"DI-HO-CDR","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Lene Juel","key":"kjeldsenpau","last":"Kjeldsen","name":"Kjeldsen, Lene Juel","rank":1,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Trine","key":"birkholmpau","last":"Birkholm","name":"Birkholm, Trine","rank":2,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Hanne","key":"fischerpau","last":"Fischer","name":"Fischer, Hanne","rank":3,"rolecode":"pau"},{"affno":"4 5","corresponding":null,"first":"Trine","key":"graabækpau","last":"Graabæk","locid":"67e97b89-6918-4950-9557-f5e3939a3c57","name":"Graabæk, Trine","orcid":"0000-0001-6848-3107","rank":4,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Trine","key":"graabaekpau","last":"Graabaek","name":"Graabaek, Trine","rank":4,"rolecode":"pau"},{"affno":"7","corresponding":null,"country":"dk","first":"Merete Kjær","key":"hansenpau","last":"Hansen","locid":"995078ec-30af-4761-89f9-bc99a1a6f922","name":"Hansen, Merete Kjær","rank":5,"rolecode":"pau"},{"affno":"8 1","corresponding":null,"first":"Karina Porsborg","key":"kibsdalpau","last":"Kibsdal","locid":"89c12003-fb35-4888-b6a7-a25ecf8ffa78","name":"Kibsdal, Karina Porsborg","rank":6,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Lene Vestergaard","key":"ravnnielsenpau","last":"Ravn-Nielsen","name":"Ravn-Nielsen, Lene Vestergaard","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Tania Holtum","key":"truelshøjpau","last":"Truelshøj","name":"Truelshøj, Tania Holtum","rank":8,"rolecode":"pau"},{"affno":"9","corresponding":null,"first":"Tania Holtum","key":"truelshojpau","last":"Truelshoj","name":"Truelshoj, Tania Holtum","rank":8,"rolecode":"pau"}],"pmid":["24899212"],"pub":{"doi":"10.1007/s11096-014-9957-2","issn":["22107703","22107711"],"issn_org":["22107703"],"issue":"4","journal":"Internat