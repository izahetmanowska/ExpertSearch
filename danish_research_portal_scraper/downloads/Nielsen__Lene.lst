org":"Mulder, Frans A A","rank":12,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Thomas","key":"tørringpau","last":"Tørring","locid":"b03df36b-0252-4e5a-aeee-7113f77cad12","name":"Tørring, Thomas","orcid":"0000-0001-5257-2121","rank":13,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Thomas B.","key":"poulsenpau","last":"Poulsen","locid":"9a15ee93-bb6a-4e1f-bb03-aac8b87ecf90","name":"Poulsen, Thomas","name_org":"Poulsen, Thomas B.","orcid":"0000-0002-0763-9996","rank":14,"rolecode":"pau"}],"pmid":["32220302"],"pub":{"doi":"10.1016/j.str.2020.03.003","issn":["09692126","18784186"],"issn_org":["09692126"],"issue":"5","journal":"Structure","publisher":"Cell Press","status":"p","title":"Structure","volume":"28"},"review":"Peer Reviewed","scoID":["2-s2.0-85083019610"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-b55a6a68-30c8-41f5-a297-10d15998bede"],"src":["AU Aarhus University"],"title":"Structure and Function of the Bacterial Protein Toxin Phenomycin","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-232771","year":"2020","yearsub":"2020"}
{"abstract":"BACKGROUND: The value of using real-time patient-reported outcome (PRO) measures in cancer communication has gained attention both in the clinic and in research. Despite this, no internationally accepted guidelines or training programs for clinicians on how to engage in patient-centred communication based on PROs exist. Lack of training may complicate implementation and systematic use of PROs in the clinic. We aimed to develop a short and feasible manual and training session in PRO-based dialogue rooted in patient-centred communication, coined PROmunication. METHODS: PROmunication was implemented in two studies using PROs in different clinical cancer settings. We interviewed clinicians twice during the development phase. First, adopting a clinical perspective, they provided ideas for content, length and structure of the training session and the manual. Second, they approved the draft of the manual with minor adjustments on how to document clinician-patient communication. The final version of the PROmunication tool was built on clinicians' input, theory on patient-centred communication, a literature review, and didactic considerations. RESULTS: The one-page manual gave clinicians a brief and clear overview of how to prepare for, undergo and document a PRO-based consultation. Illustrations and verbal phrases were offered to operationalize and facilitate patient-centred communication. The training session included elements like evidence-based knowledge about the rationale, benefits and challenges of using PROs and comprised theory, experimental training and instructions for the use of the manual in clinical practice. Ad hoc training and feedback in the clinic followed the training session. CONCLUSIONS: This paper presents the development of a short, theory-driven manual and training session intended to support and engage clinicians in PRO-based dialogue leading to patient-centred communication. Further testing of the tool is necessary and adjustments may be required if the PROmunication tool should be applied in other clinical settings were patients are seen regularly. An evaluation of the tool is planned to be performed in future studies. Training in PROmunication may further systematic and consistent use of PRO data in the consultation, leading to patient-centred consultations and increased patient involvement.","author_count":6,"contributors":["Skovlund, Pernille Christiansen","Ravn, Sissel","Seibæk, Lene","Thaysen, Henriette Vind","Lomborg, Kirsten","Nielsen, Berit Kjærside"],"cuid":["S01-000.00-235580"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Manual","Patient centred communication","Patient reported outcomes","Training"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"the development of promunication a training tool for clinicians using patient reported outcomes to promote patient centred communication in clinical cancer settings","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s41687-020-0174-6","version":"Published Version"},"id":"S01-000.00-235580","identifier":[{"id":"85079460993","type":"scopus"},{"id":"32048085","type":"pmid"},{"id":"PMC7013008","type":"pmcid"}],"ids":["au-ba1d574c-3d97-4433-a306-bd4f16c6c74b"],"keyword":["Manual","Patient-centred communication","Patient-reported outcomes","Training"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-E8C7F2228033C98A282EB4EBFB37D7A1"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s41687-020-0174-6","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Experimental Clinical Oncology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Pernille C","key":"skovlundpau","last":"Skovlund","locid":"ef6ad235-dff8-4519-8da1-455f6dde864a","name":"Skovlund, Pernille Christiansen","name_org":"Skovlund, Pernille C","orcid":"0000-0001-5310-651X","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Sissel","key":"ravnpau","last":"Ravn","locid":"28591e63-9eb6-4fa6-a369-9bf67b660910","name":"Ravn, Sissel","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lene","key":"seibaekpau","last":"Seibaek","locid":"2bf95667-24b9-444b-b3e1-a62965aac67a","name":"Seibæk, Lene","name_org":"Seibaek, Lene","orcid":"0000-0002-2396-8669","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Henriette Vind","key":"thaysenpau","last":"Thaysen","locid":"dd367b1f-6e39-4c8b-b1db-93ec7533df39","name":"Thaysen, Henriette Vind","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kirsten","key":"lomborgpau","last":"Lomborg","locid":"2f4ac59d-9194-4956-9afe-2943a9b57c15","name":"Lomborg, Kirsten","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Berit Kjærside","key":"nielsenpau","last":"Nielsen","locid":"1d2c5589-ba44-4e87-aeed-1f805c7c2f8c","name":"Nielsen, Berit Kjærside","orcid":"0000-0003-2279-2291","rank":6,"rolecode":"pau"}],"pmid":["32048085"],"pub":{"doi":"10.1186/s41687-020-0174-6","issn":["25098020"],"issue":"1","journal":"Journal of Patient-Reported Outcomes","paperid":"10","publisher":"Springer","status":"p","title":"Journal of Patient-Reported Outcomes","volume":"4"},"review":"Peer Reviewed","scoID":["2-s2.0-85079460993"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-ba1d574c-3d97-4433-a306-bd4f16c6c74b"],"src":["AU Aarhus University"],"title":"The development of PROmunication : a training-tool for clinicians using patient-reported outcomes to promote patient-centred communication in clinical cancer settings","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-235580","year":"2020","yearsub":"2020"}
{"abstract":"Purpose: To evaluate if High-volume Image-guided Injection (HVIGI)-treatment for chronic Patellar tendinopathy (PT) improve function and reduce pain at 16-months follow-up. Methods: Patients with resistant PT who failed to improve after a three-month eccentric loading program were included in the study. Maximal tendon thickness was assessed with ultrasound. All patients were injected with 10 mL of 0.5% Marcaine, 0.5 mL Triamcinolonacetonid (40 mg/mL) and 40 mL of 0.9% NaCl saline solution under real-time ultrasound-guidance and high pressure. All outcome measures were recorded at baseline and at 16 months. A standardised Heavy Slow Resistance rehabilitation protocol was prescribed after HVIGI-treatment. Clinical outcome was assessed with the Victorian Institute of Sports Assessment-Patella tendon questionnaire (VISA-P) and statistically analyses were performed. Results: The study included 28 single treatment HVIGI procedures in PT in 23 patients (19 men, 4 women) with a mean age of 30.3 (range 19–52). The mean duration of symptoms before HVIGI was 33 months. The baseline VISA-P score of 43 ± 17 (range 15–76) improved to 76 ± 16 (range 42–95) after 16 months (p < 0.01). Of the 28 HVIGI procedures 12 patients (15 PT) were not satisfied after the initial HVIGI procedure. Of these, 5 patients (5 PT) had additional HVIGI, 2 patients (2 PT) had corticoid injection and 6 patients (8 PT) needed surgery. Of the remaining 11 patients (13 PT), 9 patients had more than a 13-point improvement in the VISA-P score after 16 months. Conclusions: In this retrospective case-study, only 9 patients (32%) did benefit of a single HVIGI treatment at 16-months and a 33-point significant improvement was seen on the VISA-P score.","author_count":4,"contributors":["Nielsen, Torsten Grønbech","Miller, Lene Lindberg","Mygind-Klavsen, Bjarne","Lind, Martin"],"cuid":["S01-000.00-242912"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Eccentric training","HVIGI","Heavy slow resistance training","High volume image guided injection","Patella tendon","Patellar tendinopathy"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"high volume image guided injection in the chronic recalcitrant non insertional patellar tendinopathy a retrospective case series","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s40634-020-00299-7","version":"Published Version"},"id":"S01-000.00-242912","identifier":[{"id":"000704722000001","type":"wos"},{"id":"PMC7547937","type":"pmcid"},{"id":"33037952","type":"pmid"},{"id":"85092283885","type":"scopus"}],"ids":["au-c6f2bf93-4923-4ffa-b086-85b598eddad2"],"keyword":["Eccentric training","HVIGI","Heavy slow resistance training","High-volume image-guided injection","Patella tendon","Patellar tendinopathy"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-EAFF2B09F5D1836C76CEC27D9B6EE052"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s40634-020-00299-7","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Orthopaedic surgery"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Torsten Grønbech","key":"nielsenpau","last":"Nielsen","locid":"33da3303-c376-4195-b3d6-776795