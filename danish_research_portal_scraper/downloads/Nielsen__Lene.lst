{"author_count":18,"contributors":["Zobbe, Kristian","Christensen, Robin","Nielsen, Sabrina Mai","Stamp, Lisa","Henriksen, Marius","Overgaard, Anders Fohrby","Dreyer, Lene","Knop, Filip Krag","Singh, Jasvinder","Doherty, Michael","Richette, Pascal","Astrup, Arne","Ellegaard, Karen","Bartels, Else Marie","Boesen, Mikael","Gudbergsen, Henrik Rindel","Bliddal, Henning","Kristensen, Lars Erik"],"cuid":["S01-000.00-636297"],"event":{"end":"2020-11-21","start":"2020-11-04","title":"ACR Convergence 2020: Where Rheumatology Meets","year":"2020"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"weight loss as treatment for gout in patients with concomitant obesity a proof of concept randomized controlled trial","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://doi.org/10.1002/art.41538","version":"Other Version"},"id":"S01-000.00-636297","ids":["sdu-dc46de6e-c7fb-4c3a-ad2b-11bf3e2edf2f"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-10AD3021BA5CCA312B9DD4793FEDA292"],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Rheumatology (Odense)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Kristian","key":"zobbepau","last":"Zobbe","name":"Zobbe, Kristian","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Robin","key":"christensenpau","last":"Christensen","locid":"04bf2bf9-a6d8-4be8-93fd-82f3f2ddc9ba","name":"Christensen, Robin","orcid":"0000-0002-6600-0631","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sabrina Mai","key":"nielsenpau","last":"Nielsen","locid":"03d20c40-68db-4ce0-93e7-6c73fe727f6e","name":"Nielsen, Sabrina Mai","orcid":"0000-0003-2857-2484","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Lisa","key":"stamppau","last":"Stamp","name":"Stamp, Lisa","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Marius","key":"henriksenpau","last":"Henriksen","name":"Henriksen, Marius","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Anders Fohrby","key":"overgaardpau","last":"Overgaard","name":"Overgaard, Anders Fohrby","rank":6,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Lene","key":"dreyerpau","last":"Dreyer","name":"Dreyer, Lene","rank":7,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Filip Krag","key":"knoppau","last":"Knop","name":"Knop, Filip Krag","rank":8,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jasvinder","key":"singhpau","last":"Singh","name":"Singh, Jasvinder","rank":9,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Michael","key":"dohertypau","last":"Doherty","name":"Doherty, Michael","rank":10,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Pascal","key":"richettepau","last":"Richette","name":"Richette, Pascal","rank":11,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Arne","key":"astruppau","last":"Astrup","name":"Astrup, Arne","rank":12,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Karen","key":"ellegaardpau","last":"Ellegaard","name":"Ellegaard, Karen","rank":13,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Else Marie","key":"bartelspau","last":"Bartels","name":"Bartels, Else Marie","rank":14,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Mikael","key":"boesenpau","last":"Boesen","name":"Boesen, Mikael","rank":15,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Henrik Rindel","key":"gudbergsenpau","last":"Gudbergsen","name":"Gudbergsen, Henrik Rindel","rank":16,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Henning","key":"bliddalpau","last":"Bliddal","name":"Bliddal, Henning","rank":17,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Lars Erik","key":"kristensenpau","last":"Kristensen","name":"Kristensen, Lars Erik","rank":18,"rolecode":"pau"}],"pub":{"issn":["23265191","23265205"],"issn_org":["23265191"],"issue":"Suppl. 10","journal":"Arthritis & Rheumatology","publisher":"Wiley","status":"p","title":"Arthritis & Rheumatology","volume":"72"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-dc46de6e-c7fb-4c3a-ad2b-11bf3e2edf2f"],"src":["SDU University of Southern Denmark"],"title":"Weight Loss as Treatment for Gout in Patients with Concomitant Obesity: A Proof-of-Concept Randomized Controlled Trial","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-636297","year":"2020","yearsub":"2020"}
{"abstract":"Chlamydia trachomatis infection is the most common bacterial sexually transmitted infection globally, and nucleic acid amplification tests (NAATs) are recommended for highly sensitive and specific diagnosis. In early 2019, the Finnish new variant of Chlamydia trachomatis (FI-nvCT) was identified. The FI-nvCT has a C1515T mutation in the 23S rRNA gene, making it escaping detection in the Aptima Combo 2 (AC2; Hologic) NAAT, and the FI-nvCT has been subsequently reported in Sweden and Norway. In the present study, we investigated the presence of the FI-nvCT and other AC2 diagnostic-escape CT mutants in July-September 2019 in Denmark. The FI-nvCT was present but rare in Denmark. However, another AC2 diagnostic-escape CT mutant (with a 23S rRNA G1523A mutation) was found to be widespread across Denmark, accounting for 95% (76/80) of AC2 diagnostic-escape nvCT samples from five Danish CT-diagnostic laboratories. This nvCT-G1523A has previously only been detected in one single sample in the United Kingdom and Norway, respectively. It is vital to monitor the continued stability of the NAAT targets in local, national and international settings and monitor as well as appropriately analyse incidence, unexplained shifts in diagnostics rates, and/or annual collections of samples diagnosed as negative/equivocal using NAATs with different target(s). Furthermore, diagnostic CT NAATs with dual target sequences are crucial and fortunately, an updated Hologic AC2 assay including one additional target sequence is in advanced development.","author_count":20,"contributors":["Hadad, Ronza","Skov Jensen, Jørgen","Westh, Henrik","Grønbaek, Ida","Jessen Schwartz, Lasse","Nielsen, Lene","Müller Vang, Tobias","Nielsen, Rikke","Sandborg Weinreich, Lenette","Skov, Marianne N","Olsen, Marlene","Kjølseth Møller, Jens","Kolmos, Birte","Unemo, Magnus","Hoffmann, Steen"],"cuid":["S02-085.29-006715"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","Nordic","OECD"],"country":["Sweden"],"glorg":["All Global Affiliations","Örebro University"],"keyword":["23S rRNA","Aptima Combo 2 assay","C1515T","Chlamydia Infections diagnosis","Chlamydia trachomatis","Chlamydia trachomatis genetics","Denmark","Denmark epidemiology","FI nvCT","Female","G1523A","Gonorrhea diagnosis","Humans","Male","Neisseria gonorrhoeae genetics","Nucleic Acid Amplification Techniques methods","RNA Bacterial genetics","RNA Ribosomal 23S genetics","Sensitivity and Specificity","Sequence Analysis RNA methods","new variant"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-SDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-KU"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-HO-SDR","DI-U-AAU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"a i chlamydia trachomatis i 000000000023s rrna g000000001523a variant escaping detection in the aptima combo 000000000002 assay hologic was widespread across denmark in july september 000000002019","src":["aau","ku"],"src-code":["DI-U-AAU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://curis.ku.dk/ws/files/289971141/A_Chlamydia_trachomatis_23S_rRNA_G1523A_variant_escaping_detection_in_the_Aptima_Combo_accepted_version_.pdf","version":"Authors Final Version"},"id":"S02-085.29-006715","identifier":[{"id":"85085151002","type":"scopus"},{"id":"32202687","type":"pmid"}],"ids":["aau-8a9177ca-c0f2-4ae4-a511-608176989604","ku-14afbe1b-bf5d-44f1-9bb0-e02cd2254c68"],"keyword":["23S rRNA","Aptima Combo 2 assay","C1515T","Chlamydia Infections/diagnosis","Chlamydia trachomatis","Chlamydia trachomatis/genetics","Denmark","Denmark/epidemiology","FI-nvCT","Female","G1523A","Gonorrhea/diagnosis","Humans","Male","Neisseria gonorrhoeae/genetics","Nucleic Acid Amplification Techniques/methods","RNA, Bacterial/genetics","RNA, Ribosomal, 23S/genetics","Sensitivity and Specificity","Sequence Analysis, RNA/methods","new variant"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-3-6-166D90BEF8367728B337F578B9415878"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/337446217/A_Chlamydia_trachomatis_23S_rRNA_G1523A_variant_escaping_detection_in_the.pdf","version":"Authors Final Version"},{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://curis.ku.dk/ws/files/289971141/A_Chlamydia_trachomatis_23S_rRNA_G1523A_variant_escaping_detection_in_the_Aptima_Combo_accepted_version_.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","country":"se","key":"örebro university","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Örebro University","used":1},{"affno":"2","country":"dk","key":"ssi statens serum institut","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-SSI","l3nn":"SSI Statens Serum Institut","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SSI Statens Serum Institut","namevar":["Statens Serum Institut"],"nora_code":"DI-GV-SSI","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Clinical Microbiology","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"4","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"C