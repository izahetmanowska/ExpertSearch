brinkmannpedh","last":"Brinkmann","name":"Brinkmann, Svend","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["9788750041450"],"pages":"129-149","place":"København","publisher":"Akademisk Forlag","status":"p","subtitle":"Udfordringer og muligheder","title":"Fællesskab i skolen"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-2386bd60-0660-41fc-8aa8-c78b34794a6e"],"src":["AU Aarhus University"],"title":"Et opgør med den moderne skoles historieløshed : Fællesskaber i skolen i empirisk belysning","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-149717","year":"2011","yearsub":"2011"}
{"abstract":"Studies have shown that cancellous bone is relatively preserved in primary hyperparathyroidism (PHPT), whereas bone loss is seen in cortical bone. Familial hypocalciuric hypercalcemia (FHH) patients seem to preserve bone mineral in spite of hypercalcemia and often elevated plasma parathyroid hormone (PTH). The objective of this study was to compare total and regional forearm bone mineral density (BMD) in patients with PHPT and FHH and to examine if differences can be used to separate the two disorders. We included 63 FHH, and 121 PHPT patients in a cross-sectional study. We performed dual-energy X-ray absorptiometry scans of the forearm, hip and lumbar spine and measured a number of biochemical variables. PTH patients had significantly lower Z-scores in all parts of the forearm compared to FHH. This was also the case after adjustment for body mass index. When stratifying for age, gender and PTH, T-scores were still significantly lower in PHPT patients than in FHH patients at the total, the mid and the ultradistal forearm, but not at the proximal 1/3 forearm. In a multiple regression analysis BMD Z-score was lower in PHPT compared to FHH at the total forearm, the mid forearm and the ultradistal forearm but not the proximal forearm when adjusting for biochemical variables including PTH, 1,25(OH)(2)D and Ca(2+). These observations support that inactivating mutations in the CASR gene in bone cells in FHH may protect against forearm bone loss. Differences between the two groups in total or regional forearm BMD were inferior to the calcium/creatinine clearance ratio as a diagnostic tool to separate FHH from PHPT.","author_count":6,"contributors":["Isaksen, Troels","Nielsen, Christian Stoltz","Christensen, Signe Engkjær","Nissen, Peter H","Heickendorff, Lene","Mosekilde, Leif"],"cuid":["S01-000.00-159528"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"forearm bone mineral density in familial hypocalciuric hypercalcemia and primary hyperparathyroidism a comparative study","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s00223-011-9517-x","version":"Other Version"},"id":"S01-000.00-159528","identifier":[{"id":"21785908","type":"pmid"},{"id":"82755193721","type":"scopus"}],"ids":["au-34cbb7a2-1897-4270-aa3b-8122834baba2"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-CD9DD25245382DB8AF1039B8C5D349D9"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s00223-011-9517-x","version":"Other Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Klinisk Biokemisk Afdeling, THG"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Troels","key":"isaksenpau","last":"Isaksen","name":"Isaksen, Troels","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Christian Stoltz","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Christian Stoltz","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Signe Engkjær","key":"christensenpau","last":"Christensen","locid":"93bbc05f-b874-45ec-aca1-56c8b83c8601","name":"Christensen, Signe Engkjær","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Peter H","key":"nissenpau","last":"Nissen","locid":"ed8b934a-4322-42da-a44a-574b1eb4ddcd","name":"Nissen, Peter H","orcid":"0000-0002-8201-1306","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lene","key":"heickendorffpau","last":"Heickendorff","locid":"a43b535d-dd58-4e2a-8cf8-c6d0f0191b6e","name":"Heickendorff, Lene","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Leif","key":"mosekildepau","last":"Mosekilde","locid":"bf993e77-d838-4235-bb31-affb4cfe3f38","name":"Mosekilde, Leif","rank":6,"rolecode":"pau"}],"pmid":["21785908"],"pub":{"doi":"10.1007/s00223-011-9517-x","issn":["0171967X","14320827"],"issn_org":["0171967X"],"issue":"4","journal":"Calcified Tissue International","pages":"285-94","publisher":"Springer","status":"p","title":"Calcified Tissue International","volume":"89"},"review":"Peer Reviewed","scoID":["2-s2.0-82755193721"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-34cbb7a2-1897-4270-aa3b-8122834baba2"],"src":["AU Aarhus University"],"title":"Forearm bone mineral density in familial hypocalciuric hypercalcemia and primary hyperparathyroidism: a comparative study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-159528","year":"2011","yearsub":"2011"}
{"abstract":"The project to improve the Greenlandic greenhouse gas (GHG) inventory was undertaken due to the recommendations made by the UNFCCC review team in connection with the 2008 and 2009 submissions by the Kingdom of Denmark. The improvements made to the Greenlandic GHG emission inventory were substantial. Firstly the full CRF format was implemented significantly increasing the level of detail. For the cross-cutting elements of the reporting a tier 1 uncertainty estimation was made. The uncertainty estimation showed a total uncertainty of the GHG emission of 5.8 %. A tier 1 key category analysis was made resulting in five key categories due to level in 2008 and five further key categories due to the trend. Three categories were key for both level and trend. For the individual source sectors numerous improvements were made. This was both related to the estimation of previously missing sources and to refining the methodologies that had been previously used. The changes made to the Greenlandic GHG inventory as a result of this project resulted in recalculations of the GHG emission of 14.3 Gg of CO2 equivalents in 2007, which roughly corresponds to 2 % of the total GHG emissions","author_count":14,"contributors":["Nielsen, Ole-Kenneth","Baunbæk, Lene","Gyldenkærne, Steen","Bruun, Henrik Gundorph","Lyck, Erik","Thomsen, Marianne","Mikkelsen, Mette Hjorth","Albrektsen, Rikke","Hoffmann, Leif","Fauser, Patrik","Plejdrup, Marlene Schmidt","Winther, Morten","Nielsen, Malene","Hjelgaard, Katja Hossy"],"cuid":["S01-000.00-235309"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"level":"com","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"nr","rtype":["clu"],"sorti":"improving the greenlandic greenhouse gas inventory","src":["au"],"src-code":["D