ecode":"pau"}],"pub":{"issue":"5.26-21","journal":"Videnblade Park og Landskab","status":"p","title":"Videnblade Park og Landskab"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-ff54104d-f568-4ef0-aefb-45a1cf2c3c89"],"src":["KU University of Copenhagen"],"title":"Asketoptørre : en trussel for ask i landskabet","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-545773","year":"2011","yearsub":"2011"}
{"abstract":"Jadidi F, Nørregaard O, Baad-Hansen L, Arendt-Nielsen L, Svensson P. Assessment of sleep parameters during contingent electrical stimulation in subjects with jaw muscle activity during sleep: a polysomnographic study. Eur J Oral Sci 2011; 119: 211-218. © 2011 Eur J Oral Sci There is emerging evidence that feedback techniques based on contingent electrical stimulation (CES) have an inhibitory effect on the electromyogram (EMG) activity of jaw-closing muscles and therefore could be useful in the management of sleep bruxism. This polysomnographic (PSG) study was designed to investigate the effect of CES on PSG parameters in subjects with self-reported bruxism. Fourteen subjects underwent a full PSG investigation in the laboratory for three consecutive nights - one night of adaptation, one night without CES, and one night with CES - in a randomized order. During all sessions the EMG activity was recorded by a portable feedback device from the temporalis muscle. An electrical pulse, which was adjusted to a moderate, but non-painful, intensity, was applied to subjects during the session with CES, if jaw-muscle activity was detected. The total sleep time, the number of micro-arousals per hour of sleep, the time spent in sleep stages 3 and 4 and in rapid eye movement (REM) sleep, and the number of periodic limb movements, were not influenced by CES. The number of EMG episodes per hour of sleep during the nights with and without CES was not significantly different. The present study suggests that CES at non-painful intensities does not cause major arousal responses in any of the sleep parameters assessed in this study.","author_count":5,"contributors":["Jadidi, Faramarz","Nørregaard, Ole","Baad-Hansen, Lene","Arendt-Nielsen, Lars","Svensson, Peter"],"cuid":["S02-098.65-011521"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Afdeling for Oral Fysiologi"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"assessment of sleep parameters during contingent electrical stimulation in subjects with jaw muscle activity during sleep a polysomnographic study","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1111/j.1600-0722.2011.00822.x","version":"Other Version"},"id":"S02-098.65-011521","identifier":[{"id":"21564315","type":"pmid"},{"id":"79955970113","type":"scopus"}],"ids":["aau-f0fcc1e1-75e2-4849-a358-9ce50dff7e7b","au-d2721ab5-4c40-4123-9ba7-0a340939ad7e"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-ECA51692BA3C3272356C61485B26034F"],"oa_link":[{"access":"oa","type":"rem","url":"http://onlinelibrary.wiley.com/doi/10.1111/j.1600-0722.2011.00822.x/abstract","version":"Other Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1111/j.1600-0722.2011.00822.x","version":"Other Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus University, Faculty of Health Sciences, Department of Clinical Oral Physiology"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Afdeling for Oral Fysiologi"],"nora_code":"DI-OT","used":1},{"affno":"3","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Center for Sensory-Motor Interaction"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Faramarz","key":"jadidipau","last":"Jadidi","locid":"e1e9da15-d28e-4b6d-93e7-4032ca776c75","name":"Jadidi, Faramarz","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Ole","key":"nørregaardpau","last":"Nørregaard","locid":"755fc840-1bab-4a46-a433-3773813bf1c3","name":"Nørregaard, Ole","rank":2,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Lene","key":"baadhansenpau","last":"Baad-Hansen","locid":"6938b236-4958-4da7-bbeb-dccb0abc973c","name":"Baad-Hansen, Lene","orcid":"0000-0002-2399-7910","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Lars","key":"arendtnielsenpau","last":"Arendt-Nielsen","locid":"1794f9ec-22f1-47af-96c1-88c23c3b06a2","name":"Arendt-Nielsen, Lars","orcid":"0000-0003-0892-1579","rank":4,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Peter","key":"svenssonpau","last":"Svensson","locid":"163ec423-3f89-45a0-8cd8-81455aa6a507","name":"Svensson, Peter","rank":5,"rolecode":"pau"}],"pmid":["21564315"],"pub":{"doi":"10.1111/j.1600-0722.2011.00822.x","issn":["09098836","13977555"],"issn_org":["09098836"],"issue":"3","journal":"European Journal of Oral Sciences","pages":"211-218","publisher":"Blackwell Munksgaard","status":"p","title":"European Journal of Oral Sciences","volume":"119"},"review":"Peer Reviewed","scoID":["2-s2.0-79955970113"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["aau-f0fcc1e1-75e2-4849-a358-9ce50dff7e7b","au-d2721ab5-4c40-4123-9ba7-0a340939ad7e"],"src":["AAU Aalborg University","AU Aarhus University"],"title":"Assessment of sleep parameters during contingent electrical stimulation in subjects with jaw muscle activity during sleep : a polysomnographic study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-098.65-011521","year":"2011","yearsub":"2011"}
{"abstract":"The yeast Debaryomyces hansenii was investigated for its production of alcohol-based quorum sensing (QS) molecules including the aromatic alcohols phenylethanol, tyrosol, tryptophol and the aliphatic alcohol farnesol. Debaryomyces hansenii produced phenylethanol and tyrosol, which were primarily detected from the end of exponential phase indicating that they are potential QS molecules in D. hansenii as previously shown for other yeast species. Yields of phenylethanol and tyrosol produced by D. hansenii were, however, lower than those produced by Candida albicans and Saccharomyces cerevisiae and varied with growth conditions such as the availability of aromatic amino acids, ammonium sulphate, NaCl, pH and temperature. Tryptophol was only produced in the presence of tryptophane, whereas farnesol in general was not detectable. Especially, the type strain of D. hansenii (CBS767) had good adhesion and sliding motility abilities, which seemed to be related to a higher hydrophobicity of the cell surface of D. hansenii (CBS767) rather than the ability to form pseudomycelium. Addition of phenylethanol, tyrosol, tryptophol and farnesol was found to influence both adhesion and sliding motility of D. hansenii. © 2011 Federation of European Microbiological Societies. Published by Blackwell Publishing Ltd. All rights reserved.","author_count":5,"contributors":["Gori, Klaus","Knudsen, Peter Boldsen","Nielsen, Kristian Fog","Arneborg, Nils","Jespersen, Lene"],"cuid":["S02-099.22-036176"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Adhesion","Biofilm formation","Debaryomyces hansenii"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Center for Microbial Biotechnology"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"alcohol based quorum sensing plays a role in adhesion and sliding motility of the yeast em debaryomyces hansenii em","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1111/j.1567-1364.2011.00755.x","version":"Other Version"},"id":"S02-099.22-036176","identifier":[{"id":"80055014828","type":"scopus"},{"id":"22093748","type":"pmid"}],"ids":["dtu-9dea85c7-8af9-4f48-ba44-cb9f8b489255","ku-42dda383-d84e-4674-893e-d21b1224f2e8"],"keyword":["Adhesion","Alcohol-based quorum sensing","Biofilm formation","Debaryomyces hansenii","Sliding motility"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-448CC05A616B4CB453F2C9CC7D5A5952"],"oa_link":[{"access":"oa","type":"rem","url":"http://onlinelibrary.wiley.com/doi/10.1111/j.1567-1364.2011.00755.x/pdf","version":"Other Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1111/j.1567-1364.2011.00755.x","version":"Other Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Life Sciences, Department of Food Science, Food Microbiology"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Systems Biology","Technical University of Denmark, Department of Systems Biology, Center for Microbial Biotechnology"],"nora_code":"DI-U-DTU","used":1},{"affno":"3","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Center for Microbial Biotechnology"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","first":"Klaus","key":"goripau","last":"Gori","locid":"6ae6cff6-0e79-4678-a867-6e85d7ea2ee4","name":"Gori, Klaus","rank":1,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Peter Boldsen","key":"knudsenpau","last":"Knudsen","locid":"991df7f2-a085-49ce-a926-da127ba3b28b","name":"Knudsen, Peter Boldsen","rank":2,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Kristian Fog","key":"nielsenpau","last":"Nielsen","locid":"d2067ee9-e48c-4cf4-ac8f-ee775d8aff5a","name":"Nielsen, Kristian Fog","orcid":"0000-0002-5848-0911","rank":3,"rolecode":"pau"},{"affno":"1","first":"Nils","key":"arneborgpau","last":"Arneborg","locid":"362a10c9-2cc4-4666-9788-883e0fd6ac3e","name":"Arneborg, Nils","orcid":"0000-0002-4323-5446","rank":4,"rolecode":"pau"},{"affno":"1","first":"Lene","key":"jespersenpau","last":"Jespersen","locid":"a156c6e3-9562-4d35-9305-53a39c62e076","name":"Jespersen, Lene","orcid":"0000-0002-2555-5948","rank":5,"rolecode":"pau"}],"pmid":["22093748"],"pub":{"doi":"10.1111/j.1567-1364.2011.00755.x","issn":["15671356","15671364"],"issn_org":["15671356"],"issue":"8","journal":"FEMS Yeast Research","pages":"643-652","publisher":"Oxford University Press","status":"p","title":"FEMS Yeast Research","title_org":"F E M S Yeast Research","volume":"11"},"review":"Peer Reviewed","scoID":["2-s2.0-80055014828"],"search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-9dea85c7-8af9-4f48-ba44-cb9f8b489255","ku-42dda383-d84e-4674-893e-d21b1224f2e8"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Alcohol-based quorum sensing plays a role in adhesion and sliding motility of the yeast Debaryomyces hansenii","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.22-036176","year":"2011","yearsub":"2011"}
{"abstract":"The effect of two different antioxidants, EDTA and green tea extract (GTE), used individually or in combination, on the light-induced oxidation of reduced fat soft cheeses (0.2 and 6% fat) was investigated. In samples with 0.2% fat, lipid hydroperoxides as primary lipid oxidation products were not detected, but their interference was suggested from the formation of secondary lipid oxidation products such as hexanal and heptanal. The occurrence of these oxidation markers was inhibited by spiking with 50 ppm EDTA or 750 ppm GTE, or a combination of the two prior to irradiation. In contrast, addition of 50 ppm EDTA to samples with 6% fat was ineffective, but 750 ppm GTE (alone or in combination with EDTA) strongly reduced levels of hexanal and heptanal. Accumulation of primary lipid hydroperoxides was not affected by GTE, hence antioxidative activity was ascribed to scavenging of hexanal and heptanal precursors. These radical intermediates result from hydroperoxide disintegration, and subsequent scavenging by GTE, which acts as a radical sink, corroborates the intense signal observed by electron paramagnetic resonance (EPR) spectroscopy.","author_count":8,"contributors":["Huvaere, Kevin","Nielsen, Jacob Holm","Bakman, Mette","Hammershøj, Marianne","Skibsted, Leif","Sørensen, John","Vognsen, Lene","Dalsgaard, Trine Kastrup"],"cuid":["S02-100.00-023951"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Antioxidants","Green tea","Irradiation","Off flavors","Oxidation"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-PR","DI-U"],"level3":{"OT":["Mælke- og Ægkvalitet"],"PR":["DI-PR-ALL","DI-PR-ARLA"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-PR-ARLA","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"antioxidant properties of green tea extract protect reduced fat soft cheese against oxidation induced by light exposure","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1021/jf201139e","version":"Other Version"},"id":"S02-100.00-023951","identifier":[{"id":"21721579","type":"pmid"},{"id":"80051750835","type":"scopus"}],"ids":["au-9aec9398-e722-428a-8e5c-ac081257340c","ku-c2e60f04-efe5-46db-831f-5d843f370da3"],"keyword":["Antioxidants","green tea","irradiation","off-flavors","oxidation","soft cheese"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-4F5AE1521412B1EF8480E7630E49FC90"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1021/jf201139e","version":"Other Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Life Sciences, Department of Food Science, Food Chemistry"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"arla foods","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-ARLA","l3nl":"Arla Foods","l3nn":"Arla Foods","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Arla Foods","namevar":["Arla Foods"],"nora_code":"DI-PR-ARLA","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus University, Faculty of Agricultural Sciences, Milk and Egg Science"],"nora_code":"DI-U-AU","used":1},{"affno":"4","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous