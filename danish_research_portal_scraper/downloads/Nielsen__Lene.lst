{"author_count":5,"contributors":["Lochte, Lene","Petersen, Poul Erik","Nielsen, Kim G.","Andersen, Anette","Platts-Mills, Thomas A E"],"cuid":["S01-000.00-475213"],"event":{"end":"2018-10-06","place":"Tokyo, jp","start":"2018-10-03","title":"XXIV World Congress of Asthma","year":"2018"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"pop","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-U-KU","DI-U-SDU"]},"review":"und","rtype":["clu"],"sorti":"associations of physical activity with childhood asthma a population study base on the who health behaviour in school aged children hbsc","src":["ku"],"src-code":["DI-U-KU"],"type":"dco","type-grp":["all","pub"]},"id":"S01-000.00-475213","ids":["ku-88bc0cd6-dfc8-4500-915a-f7431828b67e"],"lang":"Danish","level":"Popular","mra":["Medical Science"],"noi":["Local-1-1-27FA59E8D2D46179A32D1B0F746953B6"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Odontology, Section 01 - Prosthetics"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["University of Southern Denmark"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","first":"Lene","key":"lochtepau","last":"Lochte","locid":"93ba9aa9-2612-4a57-9233-69ff6b2ee4c4","name":"Lochte, Lene","orcid":"0000-0003-4955-1869","rank":1,"rolecode":"pau"},{"affno":"1","first":"Poul Erik","key":"petersenpau","last":"Petersen","locid":"7d95b3ce-48e1-47fb-a08b-ec7e4b884b08","name":"Petersen, Poul Erik","rank":2,"rolecode":"pau"},{"affno":"1","first":"Kim G.","key":"nielsenpau","last":"Nielsen","locid":"eabd2b94-b01a-4243-bb5a-b6dd696edd6a","name":"Nielsen, Kim G.","rank":3,"rolecode":"pau"},{"affno":"2","first":"Anette","key":"andersenpau","last":"Andersen","name":"Andersen, Anette","rank":4,"rolecode":"pau"},{"affno":"","first":"Thomas A E","key":"plattsmillspau","last":"Platts-Mills","name":"Platts-Mills, Thomas A E","rank":5,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-88bc0cd6-dfc8-4500-915a-f7431828b67e"],"src":["KU University of Copenhagen"],"title":"Associations of physical activity with childhood asthma, a population study base on the WHO - Health Behaviour in School-aged Children (HBSC)","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-475213","year":"2018","yearsub":"2019"}
{"abstract":"Background: Hidradenitis suppurativa (HS) is a chronic inflammatory skin disease defined by recurrent nodules, tunnels and scarring involving the intertriginous skin. Patients with HS often report an array of systemic symptoms such as fatigue and malaise. The aetiology of these symptoms remains unclear. Previously, various bacteria have been associated with mature HS lesions, and bacteraemia has been reported in patients with HS using traditional culturing methods. Thus, we hypothesized that a low-grade bacteraemia contributes to the symptomatology in patients with HS. Objective: To explore the potential presence of bacteraemia in patients with HS and healthy controls. Method: A case–control study. Compositions of bacteria in the blood of 27 moderate to severe HS patients and 26 healthy controls were investigated using next-generation 16S ribosomal RNA gene sequencing (NGS) and routine anaerobic and aerobic blood culturing. None of the participants received any antibiotics (systemic or topical therapy) within 1 month prior to the study. HS patients with a recent flare were randomly selected by consecutive recruitment of eligible patients from the Department of Dermatology, Zealand University Hospital, Denmark. Healthy controls were recruited from the University of Copenhagen as well as from the healthcare staff. Results: The different bacterial compositions were investigated using NGS and traditional anaerobic and aerobic blood culturing. Our NGS analysis provided a previously unreported characterization of the bacterial composition in peripheral blood from patients with HS and healthy controls. Overall, our data demonstrated that patients with HS do not have a different bacterial composition in their peripheral blood than healthy controls. Conclusion: The study suggests that the self-reported symptoms in HS such as malaise and fatigue may not be linked to bacteraemia.","author_count":13,"contributors":["Ring, H. C.","Thorsen, J.","Saunte, Ditte Marie Lindhardt","Lilje, B.","Bay, Lene","Theut Riis, P.","Larsen, N.","O'Brien Andersen, L.","Vedel Nielsen, H.","Miller, I. M.","Bjarnsholt, Thomas","Fuursted, K.","Jemec, Gregor B E"],"cuid":["S01-000.00-487575"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-OT","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-ZEA"],"OT":["Danish Genome Institute"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-HO-ZEA","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"moderate to severe hidradenitis suppurativa patients do not have an altered bacterial composition in peripheral blood compared to healthy controls","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-487575","identifier":[{"id":"28833590","type":"pmid"},{"id":"85040670762","type":"scopus"}],"ids":["ku-9d7aae53-e106-439f-82d0-1ccd1fb59176"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-7298D1A81E13202A7D380FF17FE98A0E"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","country":"dk","key":"region zealand","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-ZEA","l3nl":"Region Zealand","l3nn":"Region Zealand","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region Zealand","namevar":["Zealand University Hospital - Køge"],"nora_code":"DI-HO-ZEA","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Dermatovenerology"],"nora_code":"DI-U-KU","used":1},{"affno":"4","country":"dk","key":"ssi statens serum institut","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-SSI","l3nn":"SSI Statens Serum Institut","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SSI Statens Serum Institut","namevar":["Statens Serum Institut"],"nora_code":"DI-GV-SSI","used":1},{"affno":"5","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Danish Genome Institute"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","first":"H. C.","key":"ringpau","last":"Ring","name":"Ring, H. C.","rank":1,"rolecode":"pau"},{"affno":"2","first":"J.","key":"thorsenpau","last":"Thorsen","name":"Thorsen, J.","rank":2,"rolecode":"pau"},{"affno":"3","first":"D. M.","key":"sauntepau","last":"Saunte","locid":"7131c49a-fd53-415c-9262-44d2c738c731","name":"Saunte, Ditte Marie Lindhardt","name_org":"Saunte, D. M.","rank":3,"rolecode":"pau"},{"affno":"4","first":"B.","key":"liljepau","last":"Lilje","name":"Lilje, B.","rank":4,"rolecode":"pau"},{"affno":"3","first":"L.","key":"baypau","last":"Bay","locid":"22f49c41-e569-43c4-8978-94bc9e411869","name":"Bay, Lene","name_org":"Bay, L.","orcid":"0000-0002-4164-5900","rank":5,"rolecode":"pau"},{"affno":"1","first":"P.","key":"theutriispau","last":"Theut Riis","name":"Theut Riis, P.","rank":6,"rolecode":"pau"},{"affno":"5","first":"N.","key":"larsenpau","last