9"],"src":["SDU University of Southern Denmark"],"title":"Aspirin for prevention of cardiovascular events: an analysis of 27,451 patients from the Western Denmark Cardiac Computed Tomography Registry","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-643006","year":"2018","yearsub":"2018"}
{"abstract":"The aim of this study was to describe how people with Chronic Inflammatory Demyelinating Polyneuropathy or Multifocal Motor Neuropathy experienced being treated with subcutaneous immunoglobulin at home. Seven people were interviewed and data were analyzed using a phenomenological-hermeneutic approach. The findings revealed the main theme as the experience of freedom and flexibility in everyday life. This was associated with acknowledging the subcutaneous treatment as a natural part of life. Going from intravenous to subcutaneous treatment initially generated skepticism and worries about being confronted with the disease on a daily basis. However, adapting to the subcutaneous treatment eventually made it possible to live a life similar to that before the diagnosis. This knowledge is important in order to understand patients’ reluctance and challenges when having subcutaneous treatment. Healthcare professionals must acknowledge and anticipate the process patients go through and offer support in dealing with the patients’ temporary feelings of being both more ill and having more responsibility for their own treatment.","author_count":5,"contributors":["Thuesen, Christine","Baand Nielsen, Lene","Frantzen, Ida","Markvardsen, Lars Kjøbsted","Haahr, Anita"],"cuid":["S01-000.00-656897"],"filters":{"added":"2023-08","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Sygdom sundhedsvidenskab og sygepleje"],"level":"pop","oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-UC"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR"],"UC":["DI-UC-ALL","DI-UC-VIA"]},"level3all":["DI-HO-CDR","DI-UC-VIA"]},"review":"und","rtype":["clu"],"sorti":"frihed og kontrol","src":["via"],"src-code":["DI-UC-VIA"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-656897","ids":["via-46ee33ca-2a51-4e50-bd67-cfc4c3b2694f"],"keyword":["Sygdom, sundhedsvidenskab og sygepleje"],"lang":"Danish","level":"Popular","noi":["Global-Local-2-2-C6E63BF15A8E13DA6DF93DEB7611D75D"],"org":[{"affno":"1","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus Univeristy Hospital"],"nora_code":"DI-HO-CDR","used":1},{"affno":"2","key":"via university college","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-VIA","l3nl":"VIA University College","l3nn":"VIA University College","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"VIA University College","namevar":["VIA, Forskning og udvikling, Forsk.center Sundhed og velfærdsteknologi, Programme in Rehabilitation","VIA, Fællesområdet, Uddannelsesudvikling","VIA, Uddannelser, Sygeplejerskeuddannelsen, Sygeplejerskeuddannelsen Aarhus N"],"nora_code":"DI-UC-VIA","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Christine","key":"thuesenpau","last":"Thuesen","name":"Thuesen, Christine","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lene","key":"baandnielsenpau","last":"Baand Nielsen","name":"Baand Nielsen, Lene","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ida","key":"frantzenpau","last":"Frantzen","name":"Frantzen, Ida","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lars Kjøbsted","key":"markvardsenpau","last":"Markvardsen","name":"Markvardsen, Lars Kjøbsted","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Anita","key":"haahrpau","last":"Haahr","locid":"c6fc2731-82cb-474a-80e9-83f01657c1bb","name":"Haahr, Anita","orcid":"0000-0002-8373-176X","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.18261/issn.1903-2285-2018-03-05","issn":["09022767","19032285"],"issn_org":["09022767"],"issue":"3","journal":"Klinisk Sygepleje","pages":"217-228","publisher":"Universitetsforlaget","status":"p","title":"Klinisk Sygepleje","volume":"32"},"review":"Undetermined