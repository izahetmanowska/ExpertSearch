"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Anders","key":"bruunanderspau","last":"Bruun","locid":"80379252-7eb7-44fc-9500-9fa698965d46","name":"Bruun, Anders","orcid":"0000-0003-1208-5155","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Marta","key":"larusdottirmartapau","last":"Larusdottir","name":"Larusdottir, Marta","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Lene","key":"nielsenlenepau","last":"Nielsen","locid":"1052b289-f510-4c5a-9662-2db48c12ebc2","name":"Nielsen, Lene","orcid":"0000-0003-1768-7147","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Peter Axel","key":"nielsenpeteraxelpau","last":"Nielsen","locid":"d5302c36-a512-42d6-8ab5-32d3f7da115e","name":"Nielsen, Peter Axel","orcid":"0000-0002-0282-7445","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"John Stouby","key":"perssonjohnstoubypau","last":"Persson","locid":"85367b9d-c52f-43cc-a521-4b8468321527","name":"Persson, John Stouby","orcid":"0000-0003-0422-1380","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1145/3240167.3240213","eisbn":["9781450364379/18/09"],"isbn":["9781450364379"],"pages":"352-363","publisher":"Association for Computing Machinery","status":"p","subtitle":"NordiCHI '18","title":"Proceedings of the 10th Nordic Conference on Human-Computer Interaction"},"review":"Peer Reviewed","scoID":["2-s2.0-85056586248"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["aau-96c515c8-728b-482b-a50b-7355adf090f0","itu-9477c028-c267-4083-838d-aafaa6ab2cb6"],"src":["AAU Aalborg University","ITU IT University of Copenhagen"],"title":"The Role of UX Professionals in Agile Development : A Case Study From Industry","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-090.22-007306","year":"2018","yearsub":"2018"}
{"abstract":"Background: Asthma in paediatric populations is one of the highest public health concerns. In this study of children and adolescents, we hypothesized that low levels of physical activity (PA) would show associations with asthma that vary by asthma outcome. The objective was to assess whether PA was associated with ever asthma and/or current asthma. Methods: Analyses were based on 4824 Danish schoolchildren aged 11-15 years old (48.7% boys) participating in the HBSC survey. The study variables were (1) physician-diagnosed asthma (ever asthma) and (2) physician-diagnosed asthma plus wheezing and/or physician or hospital consultation for wheezing (current asthma). Associations with PA by gender were analysed with multivariate logistic regression using the \"variance covariance (vce) cluster\" method. Results: The prevalence of ever asthma was 14.3% (boys) and 12.8% (girls), and that of current asthma was 6.8% (boys) and 7.0% (girls). Boys with current asthma showed important differences in low and high PA. We found inverse associations between low PA and ever asthma, odds ratio [95% confidence interval] male: .55 [.30; .99] and female: .47 [.24; .93], and current asthma, male: .27 [.12; .60] (P linear trend = .007) and female: .32 [.11; .94]. Conclusions: The lowest activity levels showed significant inverse associations with asthma, regardless of the definition. For boys, the more stringent (current asthma) of the two paediatric asthma definitions revealed a significant trend with PA, and the direction of associations shifted to positive as weekly PA increased.","author_count":5,"contributors":["Lochte, Lene","Petersen, Poul Erik","Nielsen, Kim G.","Andersen, Anette","Platts-Mills, Thomas A. E."],"cuid":["S02-100.00-043039"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","University of Virginia"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"associations of physical activity with childhood asthma a population study based on the who health behaviour in school aged children survey","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s40733-018-0042-9","version":"Published Version"},"id":"S02-100.00-043039","identifier":[{"id":"29736253","type":"pmid"},{"id":"PMC5925826","type":"pmcid"}],"ids":["ku-65e461bf-3016-40d5-9b62-df2e5d33cc4d","sdu-ef31a237-260f-4de7-b61f-25579d83699d"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-DF11DFDB07A07F387461CC331D1EAC02"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/141870448/Associations_of_physical_activity_with_childhood_asthma_a_population_study_based_on_the_WHO_health_behaviour_in_school_aged_children_survey.pdf","version":"Published Version"},{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/202769764/Associations_of_physical_activity_with_childhood_asthma_a_population_study_based_on_the_WHO_health_behaviour_in_school_aged_children_survey.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s40733-018-0042-9","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Co