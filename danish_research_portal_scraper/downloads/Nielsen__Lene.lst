e":"pau"},{"affno":"4 6","corresponding":null,"first":"Joo Hanne Poulsen","key":"revellpau","last":"Revell","locid":"96fe0fa8-84ab-4f67-8fdd-86e0355b655b","name":"Poulsen, Joo Hanne","name_org":"Revell, Joo Hanne Poulsen","orcid":"0000-0001-5194-9978","rank":7,"rolecode":"pau"},{"affno":"3","first":"Anita Buch Grann","key":"presspau","last":"Press","name":"Press, Anita Buch Grann","rank":8,"rolecode":"pau"},{"affno":"7","first":"Morten Baltzer","key":"houlindpau","last":"Houlind","locid":"c8b3768d-e73e-4235-8c47-f4fb4f7b15ae","name":"Houlind, Morten Baltzer","rank":9,"rolecode":"pau"},{"affno":"5 3","first":"Lene Juel","key":"kjeldsenpau","last":"Kjeldsen","name":"Kjeldsen, Lene Juel","rank":10,"rolecode":"pau"}],"pmid":["39161990"],"pub":{"doi":"10.1111/bcpt.14068","issn":["17427835"],"issue":"4","journal":"Basic & Clinical Pharmacology & Toxicology","pages":"491-498","status":"p","title":"Basic & Clinical Pharmacology & Toxicology","title_org":"Basic and Clinical Pharmacology and Toxicology","volume":"135"},"review":"Peer Reviewed","scoID":["2-s2.0-85201557724"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","North Denmark Region","Other Research","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-1a8fb169-77a3-4d3e-867b-1924388af4f5","sdu-3f896c78-92f8-430a-92d0-130d345832eb"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Development of a quick guide for assessment of the most frequently used renal risk medication in Danish hospitals and primary care","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-084.91-768680","year":"2024","yearsub":"2024"}
{"abstract":"Background Radiology practices have a high volume of unremarkable chest radiographs and artificial intelligence (AI) could possibly improve workflow by providing an automatic report. Purpose To estimate the proportion of unremarkable chest radiographs, where AI can correctly exclude pathology (ie, specificity) without increasing diagnostic errors. Materials and Methods In this retrospective study, consecutive chest radiographs in unique adult patients (≥18 years of age) were obtained January 1-12, 2020, at four Danish hospitals. Exclusion criteria included insufficient radiology reports or AI output error. Two thoracic radiologists, who were blinded to AI output, labeled chest radiographs as \"remarkable\" or \"unremarkable\" based on predefined unremarkable findings (reference standard). Radiology reports were classified similarly. A commercial AI tool was adapted to output a chest radiograph \"remarkableness\" probability, which was used to calculate specificity at different AI sensitivities. Chest radiographs with missed findings by AI and/or the radiology report were graded by one thoracic radiologist as critical, clinically significant, or clinically insignificant. Paired proportions were compared using the McNemar test. Results A total of 1961 patients were included (median age, 72 years [IQR, 58-81 years]; 993 female), with one chest radiograph per patient. The reference standard labeled 1231 of 1961 chest radiographs (62.8%) as remarkable and 730 of 1961 (37.2%) as unremarkable. At 99.9%, 99.0%, and 98.0% sensitivity, the AI had a specificity of 24.5% (179 of 730 radiographs [95% CI: 21, 28]), 47.1% (344 of 730 radiographs [95% CI: 43, 51]), and 52.7% (385 of 730 radiographs [95% CI: 49, 56]), respectively. With the AI fixed to have a similar sensitivity as radiology reports (87.2%), the missed findings of AI and reports had 2.2% (27 of 1231 radiographs) and 1.1% (14 of 1231 radiographs) classified as critical (P = .01), 4.1% (51 of 1231 radiographs) and 3.6% (44 of 1231 radiographs) classified as clinically significant (P = .46), and 6.5% (80 of 1231) and 8.1% (100 of 1231) classified as clinically insignificant (P = .11), respectively. At sensitivities greater than or equal to 95.4%, the AI tool exhibited less than or equal to 1.1% critical misses. Conclusion A commercial AI tool used off-label could correctly exclude pathology in 24.5%-52.7% of all unremarkable chest radiographs at greater than or equal to 98% sensitivity. The AI had equal or lower rates of critical misses than radiology reports at sensitivities greater than or equal to 95.4%. These results should be confirmed in a prospective study.","author_count":9,"contributors":["Plesner, Louis Lind","Müller, Felix C.","Brejnebøl, Mathias W.","Krag, Christian Hedeager","Laustrup, Lene C.","Rasmussen, Finn","Nielsen, Olav Wendelboe","Boesen, Mikael","Andersen, Michael B."],"cuid":["S02-099.96-803961"],"filters":{"added":"2024-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"using ai to identify unremarkable chest radiographs for automatic reporting","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85201740911","version":"Other Version"},"id":"S02-099.96-803961","identifier":[{"id":"85201740911","type":"scopus"},{"id":"39162628","type":"pmid"}],"ids":["au-271b8dc3-1ac9-410c-97d4-45ba4dfff680","ku-dd25a85e-ed59-45e4-b61c-52aed003bd16"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-E4CF23743C1A3DA503D0B032C9B3B58B"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, No speciality"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Herlev and Gentofte"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Radiology"],"nora_code":"DI-U-AU","used":1},{"affno":"4","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1}],"person":[{"affno":"1 2","first":"Louis Lind","key":"plesnerpau","last":"Plesner","locid":"7d4cc1c6-df5f-4125-9734-f299f03516b4","name":"Plesner, Louis Lind","rank":1,"rolecode":"pau"},{"affno":"2","first":"Felix C.","key":"müllerpau","last":"Müller","name":"Müller, Felix C.","rank":2,"rolecode":"pau"},{"affno":"2","first":"Mathias W.","key":"brejnebølpau","last":"Brejnebøl","name":"Brejnebøl, Mathias W.","rank":3,"rolecode":"pau"},{"affno":"2 1","first":"Christian Hedeager","key":"kragpau","last":"Krag","name":"Krag, Christian Hedeager","rank":4,"rolecode":"pau"},{"affno":"2","first":"Lene C.","key":"laustruppau","last":"Laustrup","name":"Laustrup, Lene C.","rank":5,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Finn","key":"rasmussenpau","last":"Rasmussen","locid":"1c4dadf5-d001-4c6c-9f23-347af298c53d","name":"Rasmussen, Finn","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Olav Wendelboe","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Olav Wendelboe","rank":7,"rolecode":"pau"},{"affno":"1","first":"Mikael","key":"boesenpau","last":"Boesen","locid":"b449f652-d441-4b23-836f-2d5111ef64dd","name":"Boesen, Mikael","rank":8,"rolecode":"pau"},{"affno":"2 1","first":"Michael B.","key":"andersenpau","last":"Andersen","locid":"2011438d-efaa-4cd0-a092-8e9970e0b885","name":"Andersen, Michael Brun","name_org":"Andersen, Michael B.","rank":9,"rolecode":"pau"}],"pmid":["39162628"],"pub":{"doi":"10.1148/radiol.240272","issn":["00338419","15271315"],"issn_org":["00338419"],"issue":"2","journal":"Radiology","paperid":"e240272","publisher":"Radiological Society of North America Inc.","status":"p","title":"Radiology","volume":"312"},"review":"Peer Reviewed","scoID":["2-s2.0-85201740911"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-271b8dc3-1ac9-410c-97d4-45ba4dfff680","ku-dd25a85e-ed59-45e4-b61c-52aed003bd16"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Using AI to Identify Unremarkable Chest Radiographs for Automatic Reporting","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.96-803961","year":"2024","yearsub":"2024"}
{"abstract":"Objective: To compare the effect of an illness perception conversation (IPC), relative to a research participation conversation (RPC), on 2-week changes in knee pain in patients with knee osteoarthritis. Method: This was a randomised single-blind trial. Patients were randomised to two matched conversations. An IP conversation concerning the participant's knee pain-related illness perception (IP) or an RPC concerning the participant's motivation for participating in research. Both conversations were followed by an open-label intraarticular saline injection in the most symptomatic knee. The primary outcome was change in knee pain from baseline to 2 weeks follow-up on a 100 mm visual analogue scale (VAS). Key secondary outcomes included the Knee injury and Osteoarthritis Outcome Score (KOOS) subscales: Activities of daily living (ADL) and Quality of life (QoL). Main analyses were based on the intention-to-treat population using repeated measures mixed effects linear models. Results: 103 patients were randomised to the IPC group (n = 52) and the RPC group (n = 51). VAS knee pain scores changed statistically significantly from baseline to end of treatment in both groups, −13.7 (standard error [SE]: 3.2) in the IPC group and −13.0 (SE: 3.1) in the RPC group with an adjusted between-group difference of −0.7 (95% CI: −8.3 to 6.9; P = 0.85). Likewise, no group differences were seen in KOOS ADL and KOOS QoL. Conclusion: A conversation concerning knee pain-related IP did not augment the pain-relieving effect of an open-label placebo injection when compared to a similar control conversation concerning motivations for participating in research. Trial registration: NCT05225480.","author_count":12,"contributors":["Ginnerup-Nielsen, Elisabeth","Jørgensen, Tanja Schjødt","Dew-Hattens, Camilla","Christensen, Robin","Berg, Johannes Iuel","Vase, Lene","Døssing, Anna","Nielsen, Sabrina Mai","Kristensen, Lars Erik","Bliddal, Henning","Ellegaard, Karen","Henriksen, Marius"],"cuid":["S02-100.00-768010"],"filters":{"added":"2024-09","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corresponding_author":["Ginnerup-Nielsen, Elisabeth"],"keyword":["Illness perception","Knee osteoarthritis","Open label placebo","Randomised controlled trial"],"level":"sci","mra":["med","soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-SDR","DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"the impact of an illness perception conversation on open label placebo response in knee osteoarthritis a randomised controlled trial","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.joca.2024.07.005","version":"Published Version"},"id":"S02-100.00-768010","identifier":[{"id":"39029733","type":"pmid"},{"id":"85199350982","type":"scopus"}],"ids":["au-f67ad79c-d0af-418e-8f9b-ca4913b883f0","sdu-4dd9bb77-b340-412a-9523-d96ff4341b97"],"keyword":["Illness perception","Knee osteoarthritis","Open-label placebo","Randomised controlled trial"],"lang":"English","level":"Scientific","mra":["Medical Science","Social Science"],"noi":["Global-Local-3-7-50C5505A21E204EC39F5789A1EE93C7E"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/276477678/1-s2.0-S1063458424013116-main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.joca.2024.07.005","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Bispebjerg og Frederiksberg Universitets Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Rheumatology (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"3","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Odense University Hospital"],"nora_code":"DI-HO-SDR","used":1},{"affno":"4","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus BSS, Department of Psychology and Behavioural Sciences"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Elisabeth","key":"ginnerupnielsenpau","last":"Ginnerup-Nielsen","name":"Ginnerup-Nielsen, Elisabeth","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Tanja Schjødt","key":"jørgensenpau","last":"Jørgensen","name":"Jørgensen, Tanja Schjødt","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Camilla","key":"dewhattenspau","last":"Dew-Hattens","name":"Dew-Hattens, Camilla","rank":3,"rolecode":"pau"},{"affno":"1 2 3","corresponding":null,"first":"Robin","key":"christensenpau","last":"Christensen","locid":"04bf2bf9-a6d8-4be8-93fd-82f3f2ddc9ba","name":"Christensen, Robin","orcid":"000