":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Lene","key":"kongsgaardnielsenlenepau","last":"Kongsgaard Nielsen","locid":"621d166f-6298-48ed-9f2d-d8d52bb40446","name":"Kongsgaard Nielsen, Lene","orcid":"0000-0003-2083-3870","rank":1,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Mary Ellen","key":"jardenmaryellenpau","last":"Jarden","name":"Jarden, Mary Ellen","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Henrik","key":"frederiksenhenrikpau","last":"Frederiksen","locid":"6e4bf33a-3b75-42c4-b830-43e26dcea675","name":"Frederiksen, Henrik","orcid":"0000-0001-8905-0220","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mikael","key":"frederiksenmikaelpau","last":"Frederiksen","locid":"6eb402ab-7de6-49fe-8cf4-3a00220d8dcc","name":"Frederiksen, Mikael","rank":4,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-dcb27a6a-fdc1-4abd-abfd-89640b76fd21"],"src":["SDU University of Southern Denmark"],"title":"Quality of life in newly diagnosed and relapsed Danish multiple myeloma patients","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-636420","year":"2018","yearsub":"2018"}
{"abstract":"Objective: Bone formation is a hallmark of osteoarthritis (OA). It has been speculated that bone formation may occur because of ossification at the bone-cartilage unit, that is, bone formation directly involving the calcified cartilage (CC). This study aimed to investigate the thickness of the CC and subchondral bone (SCB) in relation to the severity of the overlying articular cartilage (AC) degeneration. Design: We investigated femoral heads from 20 patients with OA and 15 healthy subjects with design-based stereology using systematic uniform random sampling of the entire joint surface. This was combined with the Osteoarthritis Research Society International (OARSI) OA cartilage histopathology assessment system, thus obtaining focal OARSI grades paired with thickness measurements of AC, CC and the SCB. Results: The patients with OA had thicker CC (mean 159; 95% CI 144 to 177 µm) compared with the healthy subjects (mean 132; 95% CI 113 to 1550 µm; p=0.036), and this difference was even higher in areas without loss of AC thickness (OARSI grade ≤3); 187 (95% CI 164 to 214) µm vs 132 (95% CI 113 to 155) µm (p=0.001). In the patients with OA, a thicker SCB was observed in areas with loss of AC thickness (OARSI grade ≥4), but not in areas without loss of AC thickness (OARSI grade ≤3). Conclusion: The study showed that thicker CC is present in early stages of OA, suggesting that bone formation by endochondral ossification is an early phenomenon of OA. Thickening of the SCB was present, but only in areas with denuded bone. Suggesting that also appositional bone growth occurs and that it may be a consequence of changed biomechanics.","author_count":10,"contributors":["Hartlev, Louise Brøndt","Klose-Jensen, Rasmus","Thomsen, Jesper Skovhus","Nyengaard, Jens Randel","Boel, Lene Warner Thorup","Laursen, Mogens Berg","Laurberg, Trine Bay","Nielsen, Andreas Wiggers","Steengaard-Pedersen, Kristian","Hauge, Ellen-Margrethe"],"cuid":["S02-081.82-010278"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Articular cartilage","Calcified cartilage","Hip","Osteoarthritis","Stereology","Subchondral bone"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"thickness of the bone cartilage unit in relation to osteoarthritis severity in the human hip joint","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.1136/rmdopen-2018-000747","version":"Published Version"},"id":"S02-081.82-010278","identifier":[{"id":"30271622","type":"pmid"},{"id":"PMC6157564","type":"pmcid"},{"id":"85057599633","type":"scopus"}],"ids":["aau-d70317d9-df06-4d88-813a-1efb18677575","au-64397199-a3ec-4941-bda7-d7c1e1eba868"],"keyword":["articular cartilage","calcified cartilage","hip","osteoarthritis","stereology","subchondral bone"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-62B93441E2DDC1B9FCE763E2586F1593"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/287919350/Thickness_of_the_bone_cartilage_unit_in.pdf","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.1136/rmdopen-2018-000747","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Section for Rheumatology"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Orthopaedic Surgery","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Hoved-Orto"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Louise Brøndt","key":"hartlevpau","last":"Hartlev","locid":"ff30b23b-e653-4cd0-902c-04cb78f756cf","name":"Hartlev, Louise Brøndt","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rasmus","key":"klosejensenpau","last":"Klose-Jensen","locid":"23dd4b1b-5313-4ad6-8e33-00476fc5d97e","name":"Klose-Jensen, Rasmus","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Skovhus","key":"thomsenpau","last":"Thomsen","locid":"924ef2ac-827c-4260-9cd7-fbe300bbafeb","name":"Thomsen, Jesper Skovhus","orcid":"0000-0001-9386-6679","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens Randel","key":"nyengaardpau","last":"Nyengaard","locid":"8288d58c-4602-4c0c-9b76-949cc83d281b","name":"Nyengaard, Jens Randel","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lene Warner Thorup","key":"boelpau","last":"Boel","locid":"cf69d33f-562c-489b-9564-9a9dc15c0a16","name":"Boel, Lene Warner Thorup","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Mogens Berg","key":"laursenpau","last":"Laursen","locid":"26102317-00ee-41ec-ae85-c7a3bde4c391","name":"Laursen, Mogens Berg","orcid":"0000-0002-