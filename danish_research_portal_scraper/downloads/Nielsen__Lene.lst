":"dk","first":"Halfdan Thorsø","key":"skjerningpau","last":"Skjerning","locid":"491d71b8-40e6-4ac7-b2de-76e0b574f967","name":"Skjerning, Halfdan Thorsø","orcid":"0000-0003-4932-0606","rank":6,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"first":"Nina Sjoerup","key":"simonsenpau","last":"Simonsen","locid":"4a451f23-69de-4df9-812b-4ac8c18067b5","name":"Simonsen, Nina Sjoerup","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Sebastian","key":"skejøpau","last":"Skejø","locid":"6b5715ac-1e27-45e1-9eeb-df39d2285748","name":"Skejø, Sebastian","orcid":"0000-0001-8878-0205","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Solvej Videbæk","key":"buenopau","last":"Bueno","locid":"099a0af6-afd7-4229-a5ee-0ae65e39a527","name":"Bueno, Solvej Videbæk","orcid":"0000-0002-8630-2442","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Knud","key":"ryompau","last":"Ryom","locid":"6294b7a6-a4e0-418b-9d18-5d000ab81d14","name":"Ryom, Knud","orcid":"0000-0001-5947-3038","rank":10,"rolecode":"pau"},{"affno":"1 4","corresponding":null,"country":"dk","first":"Per","key":"kallestruppau","last":"Kallestrup","locid":"edc492e6-b4ed-4c50-8948-986e774b6f70","name":"Kallestrup, Per","orcid":"0000-0001-6041-4510","rank":11,"rolecode":"pau"},{"affno":"1 5 3","corresponding":null,"country":"dk","first":"Jeanette","key":"christensenpau","last":"Christensen","locid":"4a0d4268-48b4-4669-94a0-9b554f559330","name":"Christensen, Jeanette Reffstrup","name_org":"Christensen, Jeanette","orcid":"0000-0002-2412-5989","rank":12,"rolecode":"pau"}],"pub":{"doi":"10.1093/eurpub/ckae114.157","issn":["11011262","1464360X"],"issn_org":["11011262"],"issue":"Suppl 2","journal":"European Journal of Public Health","paperid":"ckae114.157","publisher":"Oxford University Press","status":"p","title":"European Journal of Public Health","volume":"34"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","All University Colleges","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","Hospitals","Miscellaneous","Other Research","Undetermined","Universities","University Colleges","University of Southern Denmark","VIA University College"],"PST":["Published"]},"sid":["au-211172e1-3513-40cc-892b-be4b9860a1ab","sdu-0cff21ef-bdf2-43b1-a75f-4eb06cc8299f","via-9244b3db-19fd-4b3b-a7f7-be80f602a3ac"],"src":["AU Aarhus University","SDU University of Southern Denmark","VIA University College"],"title":"Defining Social Prescribing Within a Physical Activity Context","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-082.99-803944","year":"2024","yearsub":"2024"}
{"abstract":"Purpose The objective of the study was to conduct a quality assessment of the scientific literature underlying the Danish Health Authorities (DHA) revised recommendations on physical activity (PA), with focus on the new advice on strength training twice a week to secure optimal body functionality in the adult population aged 18-64 years. Methods The study was a scoping review. Reviews conducted by the World Health Organization (WHO), the American and Canadian Health Authorities, and evidence referenced in earlier reports from DHA were included for initial review, as DHA refer to these as base for their PA-guideline revision. Studies included in the reviews were title- and abstract screened to assess whether they investigated PA and/or strength training in a population of adults aged 18-64 years. Studies identified through this screening, were furthermore full text screened, and finally included in a quality assessment, if they investigated a strength training intervention in relation to a measure of body functionality. The quality assessment was inspired by STROBE and the Jadad Scale (for observational studies and RCTs respectively) and extended with an assessment of the study’s research goal compliance (causal or predictive) to evaluate the study’s ability to detect eventual effects of the intervention on body functionality. Results A total of 25 out of 879 studies identified in the reviews were selected for quality assessment. Great variations in quality were identified, and many studies (13 out of 25) did not achieve 2/3 of potential quality points. The studies generally support strength training as an effective intervention on body functionality. However, 15 of the 16 RCTs investigated a study population with functional limitations, e.g. populations with musculoskeletal disorders, and most studies were based on a study population in the higher end of the age spectrum 18-64 years. Conclusions The literature does not clearly support a recommendation on strength training twice weekly for the general adult population to secure optimal body functionality. The formulation of PA-guidelines should be based on evidence that 1) aims to draw causal conclusions on the effect of the recommended intervention and 2) investigates a population comparable to the target audience. Funding None","author_count":14,"contributors":["Simonsen, Nina Sjoerup","Jensen, Stine Bilde","Mogensen, Sara Tonni","Skjerning, Halfdan Thorsø","Jacobsen, Julie Sandell","Andelius, Dea Kejlberg","Jessen, Nanna Holt","Rasmussen, Lene Gissel","Skejø, Sebastian","Bueno, Solvej Videbæk","Ryom, Knud","Kallestrup, Per","Christensen, Jeanette Reffstrup","Nielsen, Rasmus Østergaard"],"cuid":["S03-090.24-804274"],"event":{"end":"2024-08-21","place":"Dublin, ie","start":"2024-08-19","title":"WHO, Health Enhancing Physical Activity Conference, 2024","year":"2024"},"filters":{"added":"2025-04","altsrc":["No Matches Found"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"keyword":["health nutrition and quality of life"],"level":"sci","mra":["hum","med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U","DI-UC"],"level3":{"OT":["Forskningsenheden for Almen Praksis i Aarhus"],"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"],"UC":["DI-UC-ALL","DI-UC-VIA"]},"level3all":["DI-U-AU","DI-U-SDU","DI-UC-VIA"]},"review":"pr","rtype":["clu"],"sorti":"can we reasonably recommend strength training twice weekly for the general adult population aged 000000000018 000000000064 years to secure optimal body functionality","src":["au","sdu","via"],"src-code":["DI-U-AU","DI-U-SDU","DI-UC-VIA"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1093/eurpub/ckae114.153","version":"Published Version"},"id":"S03-090.24-804274","ids":["au-eab34ca8-e81b-4435-8eb2-09ec066ccd54","sdu-6b9ffe1f-c7aa-4eaf-b6ad-a5442ce03e70","via-6a74a6e3-7493-4007-bec9-b97a0f38d095"],"keyword":["