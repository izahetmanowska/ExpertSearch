s","Arla Foods","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Private Research","Universities"],"PST":["Published"]},"sid":["au-7fbf1030-e659-11df-80f4-000ea68e967b"],"src":["AU Aarhus University"],"title":"Light-induced protein and lipid oxidation in low fast cheeses: Effect on degree of enzymatic hydrolysis","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-202425","year":"2012","yearsub":"2012"}
{"abstract":"People relate to other people, not to simplified types or segments. This is the concept that underpins this book. Personas, a user centered design methodology covers topics from interaction design within IT, through to issues surrounding product design, communication, and marketing. Project developers need to understand how users approach their products from the product’s infancy, and regardless of what the product might be. Developers should be able to describe the user of the product via vivid depictions, as if they – with their different attitudes, desires and habits – were already using the product. In doing so they can more clearly formulate how to turn the product's potential into reality. With contributions from professionals from Australia, Brazil, Finland, Japan, Russia, and the UK presenting real-world examples of persona method, this book will provide readers with valuable insights into this exciting research area. The inspiration to create user descriptions includes character-driven narratives, and the film Thelma & Louise is analyzed in order to understand how the development process can also be an engaging story in various professional contexts. The book has a solid foundation in research and experiences from business cases.","author_count":1,"contributors":["Nielsen, Lene"],"cuid":["S01-000.00-383972"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"keyword":["Brugervenlighed","Design research","Usability","brugercentret design"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"personas user focused design","src":["itu"],"src-code":["DI-U-ITU"],"type":"db","type-grp":["all","pub"]},"id":"S01-000.00-383972","ids":["itu-b8c009ed-b6bd-4be5-8577-c79a254679d9"],"keyword":["brugercentret design","brugervenlighed","design research","usability"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-D73079ED31E10D4A99D5533EDBAA8F22"],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","The Department, Computer Games and Interaction Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Lene","key":"nielsenpau","last":"Nielsen","locid":"1052b289-f510-4c5a-9662-2db48c12ebc2","name":"Nielsen, Lene","orcid":"0000-0003-1768-7147","rank":1,"rolecode":"pau"}],"pub":{"doi":"10.1007/978-1-4471-4084-9","isbn":["9781447140832"],"publisher":"Springer","series":"Human Computer Interaction","status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-b8c009ed-b6bd-4be5-8577-c79a254679d9"],"src":["ITU IT University of Copenhagen"],"title":"Personas : User Focused Design","type":"Book","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383972","year":"2012","yearsub":"2012"}
{"author_count":3,"contributors":["Thomsen, Iben Margrete","McKinney, Lea Vig","Nielsen, Lene Rostgaard"],"cuid":["S01-000.00-402469"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"pop","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"und","rtype":["clu"],"sorti":"er aske stilkskive udryddet i danmark","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://www.svampe.dk/publikationer/svampe/","version":"Other Version"},"id":"S01-000.00-402469","ids":["ku-0f2c9dc5-1662-4308-baf6-c2f48f683b86"],"lang":"Danish","level":"Popular","mra":["Science/Technology"],"noi":["Local-1-1-475F4DF2FA730D5117FC7115F6B6F8B7"],"oa_link":[{"access":"oa","type":"rem","url":"http://www.svampe.dk/publikationer/svampe/","version":"Other Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Life Sciences, Forest & Landscape Denmark, Applied ecology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Iben Margrete","key":"thomsenpau","last":"Thomsen","locid":"7af020b5-3cb6-48cf-9002-177bc56b36f3","name":"Thomsen, Iben Margrete","orcid":"0000-0001-7139-018X","rank":1,"rolecode":"pau"},{"affno":"1","first":"Lea Vig","key":"mckinneypau","last":"McKinney","locid":"060df27a-59d3-4457-81a2-185cca16ae68","name":"McKinney, Lea Vig","orcid":"0000-0001-6601-4614","rank":2,"rolecode":"pau"},{"affno":"1","first":"Lene Rostgaard","key":"nielsenpau","last":"Nielsen","locid":"8e8b51ee-3f45-4ebe-b2fb-fa79f1256d08","name":"Nielsen, Lene Rostgaard","orcid":"0000-0002-7214-8691","r