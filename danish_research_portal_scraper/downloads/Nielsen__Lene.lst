rolecode":"pau"},{"affno":"3 4","corresponding":null,"country":"dk","first":"Vicky Gaedt","key":"kastbjergpau","last":"Kastbjerg","locid":"30893771-6d05-44ad-bc8f-7fb706310d52","name":"Kastbjerg, Vicky Gaedt","rank":4,"rolecode":"pau"},{"affno":"1 2","first":"Henrik T.","key":"westhpau","last":"Westh","locid":"5ed71556-672c-4f57-95de-3abba6b821ea","name":"Westh, Henrik","name_org":"Westh, Henrik T.","rank":5,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"country":"dk","first":"Lone","key":"grampau","last":"Gram","locid":"9fabd1ae-e28f-4a5d-8456-7a075b4aa34e","name":"Gram, Lone","orcid":"0000-0002-1076-5723","rank":6,"rolecode":"pau"},{"affno":"1","first":"Hanne","key":"ingmerpau","last":"Ingmer","locid":"abe2cd31-84e7-4f06-81a3-33e08bf93b8f","name":"Ingmer, Hanne","orcid":"0000-0002-8350-5631","rank":7,"rolecode":"pau"}],"pmid":["23898801"],"pub":{"doi":"10.1186/1471-2180-13-177","issn":["14712180"],"issue":"177","journal":"BMC Microbiology","paperid":"177","publisher":"BioMed Central Ltd.","status":"p","title":"BMC Microbiology","volume":"13"},"review":"Peer Reviewed","scoID":["2-s2.0-84880865848"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-329ae1b0-fb25-4942-b22f-864cd26e3d75","ku-2dc98de5-dce9-4df5-9eac-049729309147"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Staphylococcus aureus but not Listeria monocytogenes adapt to triclosan and adaptation correlates with increased fabI expression and agr deficiency.","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-082.88-033707","year":"2013","yearsub":"2013"}
{"abstract":"Parkinson's Disease (PD) is a neurodegenerative movement disorder affecting millions of people worldwide. One of the key players in the development of the disease is the protein α-synuclein (aSN), which aggregates in the brain of PD patients. The aSN mutant A30P has been reported to cause early-onset familial PD and shows different aggregation behavior compared to wt aSN. Here we use a multidisciplinary approach to compare the aggregation process of wt and A30P aSN. In agreement with previous studies, we observe an initial lag phase followed by a continuous structural development of fibrils until reaching an apparent monomer-aggregate equilibrium state and a plateau in Thioflavin T (ThT) fluorescence intensity. However, at later timepoints A30P shows greater propensity than αSN wt to form dense bundled fibril networks. Combining small angle x-ray scattering, x-ray fibre diffraction and linear dichroism, we demonstrate that while the microscopic structure of the individual fibril essentially remains constant throughout the experiment, the formation of dense A30P fibril networks occur through a continuous assembly pathway while the formation of less dense wt fibril networks with fewer contact points follows a continuous path during the elongation phase and a second rearrangement phase after reaching the ThT fluorescence plateau. Our work thus highlights that structural rearrangements proceed beyond the plateau in ThT-based monitoring of the fibrillation process, and the density and morphology of the resulting fibril networks is highly dependent on the aSN form studied.","author_count":15,"contributors":["Nielsen, Søren Bang","Macchi, Francesca","Raccosta, Samuele","Langkilde, Annette Eva","Giehm, Lise","Kyrsting, Anders","Svane, Anna Sigrid P.","Manno, Mauro","Christiansen, Gunna","Nielsen, Niels Christian","Oddershede, Lene","Vestergaard, Bente","Otzen, Daniel E"],"cuid":["S02-086.05-666482"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","OECD"],"country":["Italy"],"glorg":["All Global Affiliations","National Research Council of Italy, Palermo"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-UND"]},"level3all":["DI-U-AU","DI-U-KU","DI-U-UND"]},"review":"pr","rtype":["clu"],"sorti":"wildtype and a000000000030p mutant alpha synuclein form different fibril structures","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/132047041/journal.pone.0067713.pdf","version":"Published Version"},"id":"S02-086.05-666482","identifier":[{"id":"23861789","type":"pmid"},{"id":"84879804769","type":"scopus"},{"id":"PMC3701545","type":"pmcid"}],"ids":["au-c5fb0185-92eb-4313-9b12-a73155210cb5","ku-2b6d9c5e-608d-410d-a39b-95fd86d20b79"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-36F744AD55C0A8DAC04AD70A2FEDD94F"],"oa_link":[{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/132047041/journal.pone.0067713.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1371/journal.pone.0067713","version":"Other Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","country":"dk","key":"unclear universities","l2":"DI-U","l2n":"Universities","l3":"DI-U-UND","l3nl":"Undetermined","l3nn":"Unclear Universities","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Unclear Universities","namevar":["Interdisciplinær Nanoscience Forskerskole"],"nora_code":"DI-U-UND","used":1},{"affno":"2","country":"it","key":"national research council of italy palermo","loc":["Italy","Europe, EU","OECD"],"name":"National Research Council of Italy, Palermo","used":1},