ningsportal.dk/search?modus=sin&s=LOI:S01-000.00-759400","year":"2024","yearsub":"2024"}
{"abstract":"Temanummer af Tidsskriftet Antropologi. Hvad vil det sige at bede? Hvilke ideer om virkning og virkelighed er indlejret i forskellige former for bønspraksis? Og hvordan kunne bøn fungere som en komparativ ramme for en antropologisk beskæftigelse med sociale dynamikker? Disse temaer ønsker vi at stille skarpt på i dette temanummer gennem en udforskning af konkrete typer af engagement med bøn. Behøver bøn fx altid at være religiøs? Og hvordan kan bøn fungere som en prisme til at undersøge både engagerede former for åndelig og spirituel selv-kultivering samtidig med, at bøn ofte henvender sig til konkrete eller forestillede andre, også i mindre direkte engagerede former for praksis? Hvilke ideer om selv, anden og helgener, gud eller andre religiøse magter konfigureres i den konkrete bøn? I den antropologiske litteratur har der været et stærkt fokus på magi, ritualer og på kroppen, hvilket Marcel Mauss har bidraget til ved at formulere et sæt af teoretiske rammer. Mindre kendt er det, at Mauss også arbejdede på en doktorafhandling om bøn (1909). I denne afhandling var Mauss optaget af, hvordan bøn aldrig blot er en individuel praksis, men derimod en fundamental social praksis, hvorigennem et bredere sæt af forventninger bliver artikuleret. Det er netop disse sociale forventninger, som dette temanummer afsøger. Hvilke forventninger er indlejret i og omkring bøn? Og hvad er relationen mellem bøn som en integreret del af hverdagspraksis, en selvets teknologi, og et engagement med bøn, der primært finder sted i krisesituationer, hvor andre former for menneskeligt mellemværende synes udfordrede?","author_count":4,"contributors":["Bandak, Andreas","Henkel, Heiko","Anbert, Lærke Cecilie","Schyberg, Katinka Amalie"],"cuid":["S01-000.00-396060"],"filters":{"added":"2022-04","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-ITU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-ITU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"bøn","src":["ku"],"src-code":["DI-U-KU"],"type":"db","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.7146/ta.vi84","version":"Published Version"},"id":"S01-000.00-396060","ids":["ku-0459208a-20e3-411d-8307-7db38c2e8f98"],"lang":"Danish","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-DD9AD1A6D98E0BC764D4DA6D5E3B41B3"],"oa_link":[{"access":"oa","type":"rem","url":"https://tidsskrift.dk/tidsskriftetantropologi/issue/view/9489/1591","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.7146/ta.vi84","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Humanities, Department of Cross-Cultural and Regional Studies"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University"],"nora_code":"DI-U-AU","used":1},{"affno":"3","country":"dk","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","first":"Andreas","key":"bandakped","last":"Bandak","locid":"e358540c-8467-40d4-ae35-b9b52bddfa3a","name":"Bandak, Andreas","rank":1,"role":"Editor","roleco