ffno":"16","corresponding":null,"first":"Richard","key":"burackpau","last":"Burack","name":"Burack, Richard","rank":28,"rolecode":"pau"},{"affno":"23 24","corresponding":null,"first":"Peter","key":"martinpau","last":"Martin","name":"Martin, Peter","rank":29,"rolecode":"pau"},{"affno":"25","corresponding":null,"first":"Jonathon B.","key":"cohenpau","last":"Cohen","name":"Cohen, Jonathon B.","rank":30,"rolecode":"pau"},{"affno":"26","corresponding":null,"first":"Izidore S.","key":"lossospau","last":"Lossos","name":"Lossos, Izidore S.","rank":31,"rolecode":"pau"},{"affno":"27","corresponding":null,"first":"Brad S.","key":"kahlpau","last":"Kahl","name":"Kahl, Brad S.","rank":32,"rolecode":"pau"},{"affno":"28","corresponding":null,"first":"Brian K.","key":"linkpau","last":"Link","name":"Link, Brian K.","rank":33,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Karin E.","key":"smedbypau","last":"Smedby","name":"Smedby, Karin E.","rank":34,"rolecode":"pau"},{"affno":"5 29","corresponding":null,"first":"Laurie H.","key":"sehnpau","last":"Sehn","name":"Sehn, Laurie H.","rank":35,"rolecode":"pau"},{"affno":"18 30","corresponding":null,"first":"Marek","key":"trnenypau","last":"Trneny","name":"Trneny, Marek","rank":36,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"Tarec Christoffer Christoffer","key":"elgalalypau","last":"El-Galaly","locid":"1d601b96-c71c-4a76-ac06-4d95e0a50a74","name":"El-Galaly, Tarec Christoffer","name_org":"El-Galaly, Tarec Christoffer Christoffer","orcid":"0000-0002-4406-380X","rank":37,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"James R.","key":"cerhanpau","last":"Cerhan","name":"Cerhan, James R.","rank":38,"rolecode":"pau"}],"pub":{"doi":"10.1182/blood-2022-157194","issn":["00064971","15280020"],"issn_org":["00064971"],"issue":"Suppl. 1","journal":"Blood","pages":"2292-2295","publisher":"Elsevier","status":"p","title":"Blood","volume":"140"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities"],"PST":["Published"]},"sid":["aau-fe857ae1-c69b-4d7e-bd60-a9717e4586d7"],"src":["AAU Aalborg University"],"title":"FLIPI24: An Improved International Prognostic Model Developed on Early Events in Follicular Lymphoma","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-123920","year":"2022","yearsub":"2022"}
{"abstract":"Cold and nutrient‐activated brown adipose tissue (BAT) is capable of increasing systemic energy expenditure via the uncoupled respiration and secretion of endocrine factors, thereby protecting mice against diet‐induced obesity and improving insulin response and glucose tolerance in men. Long non‐coding RNAs (lncRNAs) have recently been identified as fine‐tuning regulators of cellular function. While certain lncRNAs have been functionally characterised in adipose tissue, their overall contribution in the activation of BAT remains elusive. We identified lncRNAs correlating to interscapular brown adipose tissue (iBAT) function in a high fat diet (HFD) and cold stressed mice. We focused on Gm15551, which has an adipose tissue specific expression profile, is highly upregulated during adipogenesis, and downregulated by β‐adrenergic activation in mature adipocytes. Although we performed comprehensive transcriptional and adipocyte physiology profiling in vitro and in vivo, we could not detect an effect of gain or loss of function of Gm15551.","author_count":9,"contributors":["Engelhard, Christoph Andreas","Huang, Chien","Khani, Sajjad","Kasparek, Petr","Prochazka, Jan","Rozman, Jan","Reguera, David Pajuelo","Sedlacek, Radislav","Kornfeld, Jan Wilhelm"],"cuid":["S01-000.00-593243"],"filters":{"added":"2022-07","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East","Europe, EU","OECD"],"corresponding_author":["Kornfeld, Jan Wilhelm"],"country":["Czechia","Germany","Taiwan"],"glorg":["All Global Affiliations","Institute of Human Genetics, Helmholtz Zentrum München","Institute of Molecular Genetics","Max Planck Institute for Metabolism Research","National Taiwan University","University Hospital Cologne"],"keyword":["Brown adipose tissue","Long noncoding RNAs"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"comprehensive transcriptional profiling and mouse phenotyping reveals dispensable role for adipose tissue selective long noncoding rna gm000000015551","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/ncrna8030032","version":"Published Version"},"funding_acknowledgement":["Funding: C.H. was funded by the National Taiwan University and the grant 109‐2917‐I‐002‐029 from the Ministry of Science and Technology, Taiwan. The authors used services of the Czech Centre for Phenogenomics supported by the Czech Academy of Sciences RVO 68378050 and by the project LM2018126 Czech Centre for Phenogenomics provided by Ministry of Education, Youth and Sports of the Czech Republic. J.‐W.K. and C.A.E. were supported by the University of Southern Denmark and the Danish Diabetes Academy, which is in turn funded by the Novo Nordisk Foundation."],"id":"S01-000.00-593243","identifier":[{"id":"35645339","type":"pmid"},{"id":"PMC9149892","type":"pmcid"},{"id":"85130186806","type":"scopus"}],"ids":["sdu-45d94528-e577-49cb-bd9b-44881a047ace"],"keyword":["adipose tissue remodelling","brown adipose tissue","long noncoding RNAs"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-5243F038E5944E41740E2A9CB3A1A6B5"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/ncrna8030032","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/202877444/ncrna_08_00032_v2.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc