["9783893180813"],"issn":["23672005"],"pages":"157-168","publisher":"OpenProceedings","series":"Advances in Database Technology","status":"p","subtitle":"22nd International Conference on Extending Database Technology, Proceedings","title":"Advances in Database Technology - EDBT 2019"},"review":"Peer Reviewed","scoID":["2-s2.0-85064939071"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-01690e5d-7cf5-49fa-8f25-e7e01d11d735"],"src":["AAU Aalborg University"],"title":"Indexing Trajectories for Travel-Time Histogram Retrieval","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-050448","year":"2019","yearsub":"2019"}
{"abstract":"Given a network in which a undesirable rumor, disease, or contamination spreads, which set of network nodes should we block so as to contain that spread? Past research has proposed several methods to address this network immunization (NI) problem, which is to find a set of k nodes, such that the undesirable dissemination is minimized in expectation when they are blocked. As the problem is NP-hard, some algorithms utilize solely features of the network structure in a preemptive manner, to others that take into account the specific source of a contamination in a data-aware fashion. This paper presents an experimental study on NI algorithms and baselines under the independent cascade (IC) diffusion model. We employ a variety of synthetic and real-world networks with diverse graph density, degree distribution, and clustering coefficients, under realistically calculated influence probabilities. We conclude that data-aware approaches based on the construct of dominator trees usually perform best; however, in networks with a power-law degree distribution, preemptive approaches utilizing spectral network properties shine out by virtue of their efficiency in identifying central nodes.","author_count":8,"contributors":["Logins, Alvis","Karras, Panagiotis"],"cuid":["S01-000.00-172431"],"event":{"acronym":"EDBT","end":"2019-12-29","place":"Lisbon, pt","start":"2019-03-26","title":"22nd International Conference on Extending Database Technology","year":"2019"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"an experimental study on network immunization","src":["au"],"src-code":["DI-U-AU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://openproceedings.org/2019/conf/edbt/EDBT19_paper_391.pdf","version":"Published Version"},"id":"S01-000.00-172431","identifier":[{"id":"85064929381","type":"scopus"}],"ids":["au-4ba87ee2-5e95-4c97-87fb-89f73c093499"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-5C9BD64A254090426E60CDB3466392B6"],"oa_link":[{"access":"oa","type":"rem","url":"https://openproceedings.org/2019/conf/edbt/EDBT19_paper_391.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Computer Science"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Alvis","key":"loginspau","last":"Logins","locid":"2fbacb5b-ac00-4563-bae7-97694b8125d3","name":"Logins, Alvis","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Panagiotis","key":"karraspau","last":"Karras","locid":"2f401225-22f5-4d8a-88a2-bb67bac8dbc1","name":"Karras, Panagiotis","rank":2,"rolecode":"pau"},{"affno":"","first":"Melanie","key":"herschelpedh","last":"Herschel","name":"Herschel, Melanie","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Helena","key":"galhardaspedh","last":"Galhardas","name":"Galhardas, Helena","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Berthold","key":"reinwaldpedh","last":"Reinwald","name":"Reinwald, Berthold","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Irini","key":"fundulakipedh","last":"Fundulaki","name":"Fundulaki, Irini","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Carsten","key":"binnigpedh","last":"Binnig","name":"Binnig, Carsten","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Zoi","key":"kaoudipedh","last":"Kaoudi","name":"Kaoudi, Zoi","rank":8,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"eisbn":["9783893180813"],"pages":"726-729","publisher":"openproceedings.org","status":"p","subtitle":"22nd International Conference on Extending Database Technology, Proceedings","title":"Advances in Database Technology - EDBT 2019"},"review":"Peer Reviewed","scoID":["2-s2.0-85064929381"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-4ba87ee2-5e95-4c97-87fb-89f73c093499"],"src":["AU Aarhus University"],"title":"An Experimental Study on Network Immunization","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-172431","year":"2019","yearsub":"2019"}
{"abstract":"Vast amounts of data are being generated daily with the adoption of Internet-of-Things (IoT) solutions in an ever-increasing number of application domains. There are problems associated with all stages of the lifecycle of these data (e.g., capture, curation and preservation). Moreover, the volume, variety, dynamicity and ubiquity of IoT data present additional challenges to their usability, prompting the need for constructing scalable data-intensive IoT data management and processing platforms. This paper presents a novel approach to model and build IoT data platforms based on the characteristics of an Actor-Oriented Database (AODB). We take advantage of two complementary case studies – in structural health monitoring and beef cattle tracking and tracing – to describe novel software requirements introduced by IoT data processing. Our investigation illustrates the challenges and benefits provided by AODB to meet these requirements in terms of modeling and IoT-based systems implementation. Obtained results reveal the advantages of using AODB in IoT scenarios and lead to principles on how to effectively use an actor model to design and implement IoT data platforms.","author_count":12,"contributors":["Wang, Yiwen","Dos Reis, Julio Cesar","Borggren, Kasper Myrtue","Vaz Salles, Marcos Antonio","Medeiros, Claudia Bauzer","Zhou, Yongluan"],"cuid":["S01-000.00-478611"],"event":{"acronym":"EDBT","end":"2019-03-29","place":"Lisbon, pt","start":"2019-03-26","title":"22nd International Conference on Extending Database Technology, EDBT 2019","year":"2019"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, South"],"country":["Brazil"],"glorg":["All Global Affiliations","Universidade Estadual de Campinas"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["SenMoS"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"modeling and building iot data platforms with actor oriented databases","src":["ku"],"src-code":["DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.5441/002/edbt.2019.47","version":"Published Version"},"id":"S01-000.00-478611","identifier":[{"id":"85064947935","type":"scopus"}],"ids":["ku-8e768049-4056-42d5-94e6-4a8951773dee"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-C6E97C788430EC9DE760F4940545AFDF"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.5441/002/edbt.2019.47","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/235925410/OA_Modeling_and_Building_IoT_Data_Platforms_with.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Software, Data, People & Society"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"br","key":"universidade estadual de campinas","loc":["Brazil","America, South"],"name":"Universidade Estadual de Campinas","used":1},{"affno":"3","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["SenMoS"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","first":"Yiwen","key":"wangpau","last":"Wang","locid":"6bef9bfb-83c8-4fab-87cf-9365681f77b8","name":"Wang, Yiwen","orcid":"0000-0002-4531-2222","rank":1,"rolecode":"pau"},{"affno":"2","first":"Julio Cesar","key":"dosreispa