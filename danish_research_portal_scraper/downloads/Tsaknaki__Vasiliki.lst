ll,"first":"Vasiliki","key":"tsaknakipau","last":"Tsaknaki","locid":"805cae2a-3462-4130-88de-cc7d94aec0a5","name":"Tsaknaki, Vasiliki","orcid":"0000-0003-2235-6078","rank":7,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Pedro","key":"sanchespau","last":"Sanches","name":"Sanches, Pedro","rank":8,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Corina","key":"saspau","last":"Sas","name":"Sas, Corina","rank":9,"rolecode":"pau"}],"pub":{"doi":"10.1145/3491101.3503716","pages":"1-5","publisher":"Association for Computing Machinery","status":"p","title":"CHI EA '22: Extended Abstracts of the 2022 CHI Conference on Human Factors in Computing SystemsApril 2022. Article No.: 100"},"review":"Peer Reviewed","scoID":["2-s2.0-85129732007"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-986fbbcf-fa7a-4f57-a658-8a844601aea1"],"src":["ITU IT University of Copenhagen"],"title":"Tangible Interaction for Supporting Well-being","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-718896","year":"2022","yearsub":"2022"}
{"abstract":"We report on a soma design process, where we designed a novel shape-changing garment—the Soma Corset. The corset integrates sensing and actuation around the torso in tight interaction loops. The design process revealed how boundaries between the garment and the wearer can become blurred, leading to three flavours of cyborg relations. First, through the lens of the monster, we articulate how the wearer can adopt or reject the garment, resulting in either harmonious or disconcerting experiences of touch. Second, it can be experienced as an organic “other”-with its own agency-resulting in uncanny experiences of touch. Through mirroring the wearer’s breathing, the garment can also be experienced as a twisted version of one’s own body. We suggest that a gradual sensitisation of designers-through soma design and reflection on the emerging human-technology relations-may serve as a pathway for uncovering and articulating novel, machine-like, digital touch experiences.","author_count":7,"contributors":["KARPASHEVICH, PAVEL","Sanches, Pedro","GARRETT, RACHAEL","LUFT, YOAV","Cotton, Kelsey","Tsaknaki, Vasiliki","Höök, Kristina"],"cuid":["S01-000.00-381913"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"country":["Sweden"],"glorg":["All Global Affiliations","KTH Royal Institute of Technology","Umeå University"],"keyword":["Breathing patterns","Digital touch","Soma Design","uncanny experiences"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"touching our breathing through shape change monster organic other or twisted mirror","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1145/3490498","version":"Authors Final Version"},"id":"S01-000.00-381913","identifier":[{"id":"85124806498","type":"scopus"}],"ids":["itu-2ba486b1-0f8e-4656-ac3a-2cd659eb0edf"],"keyword":["Digital touch","breathing patterns","soma design","uncanny experiences"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-6915BB23020672184493E64D9B1D3CA4"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86588748/3490498.pdf","version":"Other Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1145/3490498","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"se","key":"kth royal institute of technology","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"KTH Royal Institute of Technology","used":1},{"affno":"2","country":"se","key":"umeå university","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Umeå University","used":1},{"affno":"3","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Human-Computer Interaction and Design, Affective Interactions & Relations Lab"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"PAVEL","key":"karpashevichpau","last":"KARPASHEVICH","name":"KARPASHEVICH, PAVEL","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Pedro","key":"sanchespau","last":"Sanches","name":"Sanches, Pedro","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"RACHAEL","key":"garrettpau","last":"GARRETT","name":"GARRETT, RACHAEL","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"YOAV","key":"luftpau","last":"LUFT","name":"LUFT, YOAV","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kelsey","key":"cottonpau","last":"Cotton","name":"Cotton, Kelsey","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Vasiliki","key":"tsaknakipau","last":"Tsaknaki","locid":"805cae2a-3462-4130-88de-cc7d94aec0a5","name":"Tsaknaki, Vasiliki","orcid":"0000-0003-2235-6078","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kristina","key":"höökpau","last":"Höök","name":"Höök, Kristina","rank":7,"rolecode":"pau"}],"pub":{"doi":"10.1145/3490498","issn":["10730516","15577325"],"issn_org":["10730516"],"issue":"3","journal":"ACM Transactions on Computer-Human Interaction","publisher":"Association for Computing Machinery","status":"p","title":"ACM Transactions on Computer-Human Interaction","title_org":"A C M Transactions on Computer - Human Interaction","volume":"29"},"review":"Peer Reviewed","scoID":["2-s2.0-85124806498"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-2ba486b1-0f8e-4656-ac3a-2cd659eb0edf"],"src":["ITU IT University of Copenhagen"],"title":"Touching our breathing through shape-change: Monster, organic other, or twisted mirror","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381913","year":"2022","yearsub":"2022"}
{"abstract":"This one-day workshop invites participants to discuss possibilities of designing with and for reproductive bodies by taking vantage points in existing discussions within HCI which are rethinking approaches to reproductive health and broadening understandings of reproductive bodies beyond the category of women's health. The workshop is grounded in these ongoing discussions, calling for intersectional approaches that account for the pluralities of bodies when designing for and with bodies. Through collective and speculative explorations, we are aspiring to find new directions within reproductive health research, to disrupt binary understandings of reproductive bodies, and to explore interpersonal/relational issues when talking about in/fertility that extend beyond the female body. The aim of the workshop is to bring together HCI researchers that are working with or are interested in bodies and bodily experiences including, but not limited to, in/fertility, menopause, menstruation, transitions, interpersonal as well as more-than-human relations, and are motivated to unpack and expand current practices, but also to imagine inclusive directions of design and research in these areas.","author_count":7,"contributors":["Reime, Lara","Woytuk, Nadia Campo","Park, Joo Young","Søndergaard, Marie Louise Juul","Yadav, Deepika","Tsaknaki, Vasiliki","Homewood, Sarah"],"cuid":["S01-000.00-443025"],"event":{"end":"2022-10-12","place":"Aarhus, dk","start":"2022-10-08","title":"12th Nordic Conference on Human-Computer Interaction: Participative Computing for Sustainable Futures, NordiCHI 2022","year":"2022"},"filters":{"added":"2022-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","Nordic","OECD"],"country":["Norway","Sweden"],"glorg":["All Global Affiliations","KTH Royal Institute of Technology","Oslo School of Architecture and Design","Stockholm University"],"keyword":["Bodies","Feminism","Infertility","Intersectionality","Reproductive health"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-KU"]},"level3all":["DI-U-ITU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"speculations on feminist reproductive health technologies","src":["ku"],"src-code":["DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1145/3547522.3547698","version":"Published Version"},"id":"S01-000.00-443025","identifier":[{"id":"85139829798","type":"scopus"}],"ids":["ku-5313ef5b-3ed7-4da6-a3d9-50eeefc67310"],"keyword":["bodies","feminism","infertility","intersectionality","reproductive health"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-3-5-496DDF12DE197C844CBBB73723843805"],"oa_link":[{"access":"oa","license":"Andet","type":"loc","url":"https://curis.ku.dk/ws/files/323554752/Speculations_on_Feminist_Reproductive_Health_Technologies.pdf","version":"Other Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1145/3547522.3547698","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"se","key":"kth royal institute of technology","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"KTH Royal Institute of Technology","used":1},{"affno":"3","country":"no","key":"oslo school of architecture and design","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"Oslo School of Architecture and Design","used":1},{"affno":"4","country":"se","key":"stockholm university","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Stockholm University","used":1},{"affno":"5","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Human-Centred Computing"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Lara","key":"reimepau","last":"Reime","name":"Reime, Lara","rank":1,"rolecode":"pau"},{"affno":"2","first":"Nadia Campo","key":"woytukpau","last":"Woytuk","name":"Woytuk, Nadia Campo","rank":2,"rolecode":"pau"},{"affno":"2","first":"Joo Young","key":"parkpau","last":"Park","name":"Park, Joo Young","rank":3,"rolecode":"pau"},{"affno":"3","first":"Marie Louise Juul","key":"søndergaardpau","last":"Søndergaard","name":"Søndergaard, Marie Louise Juul","rank":4,"rolecode":"pau"},{"affno":"4","first":"Deepika","key":"yadavpau","last":"Yadav","name":"Yadav, Deepika","rank":5,"rolecode":"pau"},{"affno":"1","first":"Vasiliki","key":"tsaknakipau","last":"Tsaknaki","name":"Tsaknaki, Vasiliki","rank":6,"rolecode":"pau"},{"affno":"5","first":"Sarah","key":"homewoodpau","last":"Homewood","locid":"e6edf1cc-cfc0-4304-8638-989154e536d8","name":"Homewood, Sarah","rank":7,"rolecode":"pau"}],"pub":{"doi":"10.1145/3547522.3547698","eisbn":["9781450394482"],"publisher":"Association for Computing Machinery, Inc.","series":"ACM International Conference Proceeding Series","status":"p","title":"Participative Computing for Sustainable Futures - Adjunct Proceedings of the 12th Nordic Conference on Human-Computer Interaction, NordiCHI 2022"},"review":"Peer Reviewed","scoID":["2-s2.0-85139829798"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-5313ef5b-3ed7-4da6-a3d9-50eeefc67310"],"src":["KU Un