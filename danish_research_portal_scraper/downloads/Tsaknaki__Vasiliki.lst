,"first":"CHARLES","key":"windlinpau","last":"WINDLIN","name":"WINDLIN, CHARLES","rank":13,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"FENG","key":"zhoupau","last":"ZHOU","name":"ZHOU, FENG","rank":14,"rolecode":"pau"}],"pub":{"doi":"10.1145/3462448","issn":["10730516","15577325"],"issn_org":["10730516"],"issue":"2","journal":"ACM Transactions on Computer-Human Interaction","publisher":"Association for Computing Machinery","status":"p","title":"ACM Transactions on Computer-Human Interaction","title_org":"A C M Transactions on Computer - Human Interaction","volume":"40"},"review":"Peer Reviewed","scoID":["2-s2.0-85122449400"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-9aa19829-cc11-45fd-b4ed-7c6102e36ca4"],"src":["ITU IT University of Copenhagen"],"title":"Unpacking Non-Dualistic Design: The Soma Design Case","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383528","year":"2021","yearsub":"2021"}
{"abstract":"This one-day workshop will bring together researchers working with biodata and design for discussing and reflecting upon how design and HCI operate with the body and its data. The main workshop objective will be to identify core challenges and opportunities in this domain. We intend to cohere the projects of the workshop participants into a set of artifacts, images, and theory to create an annotated portfolio that represents the state-of-the art in designing with biodata in HCI. The workshop will be structured around four themes relating to the use and contexts of working with biodata: 1. Making sense of biodata by taking into account a holistic perspective of body, mind and emotions, as exemplified through soma design methods in HCI, for example; 2. Feminist perspectives of biodata that take into account bodily transitions, pluralities of bodies and temporalities of bodies; 3. Non-anthropocentric perspectives of working with and making sense of biodata, to also account for microorganisms and other material agencies in our bodies; and 4. Emerging domains, contexts, and practices around the use of biodata, such as health, affective, and performance contexts. The significance of the workshop is twofold: One, we will produce a group of researchers and practitioners that are working with biodata, aiming to unpack, discuss and respond to critical issues around designing with and for it. Two, we will create an annotated portfolio that can travel on its own as documentation and vision for future biodata-based design practices.","author_count":6,"contributors":["Tsaknaki, Vasiliki","Jenkins, Tom","Boer, Laurens","Homewood, Sarah","Howell, Noura","Sanches, Pedro"],"cuid":["S01-000.00-382301"],"event":{"acronym":"NordiCHI","title":"Nordic Conference on Human-Computer Interaction"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","Europe, EU","Nordic","OECD"],"country":["Sweden","United States"],"glorg":["All Global Affiliations","KTH Royal Institute of Technology","North Carolina State University"],"keyword":["Biodata","Biosensing","Interaction design","Materials"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"challenges and opportunities for designing with biodata as material","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85482286/NordiCHI_Workshop_Submission.pdf","version":"Authors Final Version"},"id":"S01-000.00-382301","identifier":[{"id":"85095815573","type":"scopus"}],"ids":["itu-45a468bf-42d2-406a-85c7-c7921666f024"],"keyword":["biodata","biosensing","interaction design","materials"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-9F65B3BA29D24717960703EC533733EA"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85482286/NordiCHI_Workshop_Submission.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Human-Computer Interaction and Design, Affective Interactions & Relations Lab"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"us","key":"north carolina state university","loc":["United States","America, North","OECD"],"name":"North Carolina State University","used":1},{"affno":"3","country":"se","key":"kth royal institute of technology","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"KTH Royal Institute of Technology","used":1}],"person":