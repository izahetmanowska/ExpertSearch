n Design Research Group"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Claudia","key":"núñezpachecopau","last":"Núñez Pacheco","name":"Núñez Pacheco, Claudia","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Marianela","key":"ciolfifelicepau","last":"Ciolfi Felice","name":"Ciolfi Felice, Marianela","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Vasiliki","key":"tsaknakipau","last":"Tsaknaki","locid":"805cae2a-3462-4130-88de-cc7d94aec0a5","name":"Tsaknaki, Vasiliki","orcid":"0000-0003-2235-6078","rank":3,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-ad391319-8391-48b8-8b0a-2d2cd80938cf"],"src":["ITU IT University of Copenhagen"],"title":"Design and Somatic Sensibilities. Diseña, (20), Intro.","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-718904","year":"2022","yearsub":"2022"}
{"abstract":"This paper presents the soma design process of creating Body Electric: a novel interface for the capture and use of biofeedback signals and physiological changes generated in the body by breathing, during singing. This NIME design is grounded in the performer's experience of, and relationship to, their body and their voice. We show that NIME design using principles from soma design can offer creative opportunities in developing novel sensing mechanisms, which can in turn inform composition and further elicit curious engagements between performer and artefact, disrupting notions of performer-led control. As contributions, this work 1) offers an example of NIME design for situated living, feeling, performing bodies, and 2) presents the rich potential of soma design as a path for designing in this context.","author_count":4,"contributors":["Cotton, Kelsey","Sanches, Pedro","Tsaknaki, Vasiliki","Karpashjevich, Pavel"],"cuid":["S01-000.00-382020"],"event":{"acronym":"NIME","title":"New Interfaces for Musical Expression"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"country":["Portugal","Sweden"],"glorg":["All Global Affiliations","Department of Informatics - Umeå University","ITI/LARSyS, ARDITI","KTH Royal Institute of Technology"],"keyword":["Biofeedback Signals","NIME New Interfaces for Musical Expression","Performer s Experience","Physiological Changes","Soma Design"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"the body electric a nime designed through and with the somatic experience of singing","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.21428/92fbeb44.ec9f8fdd","version":"Published Version"}