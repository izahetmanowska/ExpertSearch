{"abstract":"This article proposes a critical review of the literature on procedural rhetoric, from a game design perspective. The goal of the article is to show the limits of procedural rhetorics for the design and analysis of ethics and politics in games. The article suggests that theories of play can be used to solve these theoretical flaws.","author_count":1,"contributors":["Sicart, Miguel Angel"],"cuid":["S01-000.00-381745"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"1 contributor","cluster_size":1,"keyword":["Critical theory","Ethics","Game Ontology","Game design","Politics","Procedural rhetorics"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"against procedurality","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://gamestudies.org/1103/articles/sicart_ap","version":"Other Version"},"id":"S01-000.00-381745","ids":["itu-200d5310-fb18-4a5c-9b19-6298ca8fe4d1"],"keyword":["Procedural rhetorics","critical theory","ethics","game design","game ontology","politics"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-E1519AF02AF3AE81A5364FB40C2B1BFA"],"oa_link":[{"access":"oa","type":"rem","url":"http://gamestudies.org/1103/articles/sicart_ap","version":"Other Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Miguel Angel","key":"sicartvilapau","last":"Sicart (Vila)","locid":"689427b5-8d2a-44f3-b291-6db6ba598305","name":"Sicart, Miguel Angel","name_org":"Sicart (Vila), Miguel Angel","orcid":"0000-0002-8356-5394","rank":1,"rolecode":"pau"}],"pub":{"issn":["16047982"],"issue":"3","journal":"Game Studies","publisher":"Game Studies Foundation","status":"p","title":"Game Studies","volume":"11"},"review":"Peer Reviewed","scoID":["2-s2.0-84867591588"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-200d5310-fb18-4a5c-9b19-6298ca8fe4d1"],"src":["ITU IT University of Copenhagen"],"title":"Against Procedurality","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381745","year":"2011","yearsub":"2011"}
