{"abstract":"In this paper we propose a critical reading of Sicart’s concept of political play, and we suggest an alternative framework that expands his work. We will apply Chantal Mouffe’s political theory to the core ideas in Play Matters, with the purpose of focusing and further developing the understanding of the political in the play activity.","author_count":1,"contributors":["Sicart, Miguel Angel"],"cuid":["S01-000.00-381857"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"keyword":["Chantal Mouffe","Play Matters","Political play","Political theory","Sicart"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"participatory republics play and the political","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://www.fdg2015.org/papers/fdg2015_paper_50.pdf","version":"Published Version"},"id":"S01-000.00-381857","ids":["itu-26e678d7-47da-475e-bd12-a51251046c1d"],"keyword":["Chantal Mouffe","Play Matters","Sicart","political play","political theory"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-10984C3E8F6768190616F568CB87710A"],"oa_link":[{"access":"oa","type":"rem","url":"http://www.fdg2015.org/papers/fdg2015_paper_50.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Digital Play","IT University of Copenhagen, Digital Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Miguel Angel","key":"sicartpau","last":"Sicart","locid":"689427b5-8d2a-44f3-b291-6db6ba598305","name":"Sicart, Miguel Angel","orcid":"0000-0002-8356-5394","rank":1,"rolecode":"pau"}],"pub":{"isbn":["9780991398249"],"status":"p","title":"Proceedings of the 10th International Conference on the Foundations of Digital Games (FDG 2015), June 22-25, 2015, Pacific Grove, CA, USA"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-26e678d7-47da-475e-bd12-a51251046c1d"],"src":["ITU IT University of Copenhagen"],"title":"Participatory Republics: Play and the Political","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381857","year":"2015","yearsub":"2015"}
{"author_count":3,"contributors":["Sicart, Miguel Angel"],"cuid":["S01-000.00-382458"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"playing the good life gamification and ethics","src":["itu"],"src-code":["DI-U-ITU"],"type":"dba","type-grp":["all","pub"]},"id":"S01-000.00-382458","ids":["itu-4f874aca-38e1-4d47-a17d-42ab723aa7fe"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-D55D7B414BE40A5C53E592677002138E"],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Digital Play","IT University of Copenhagen, Digital Design","The Department, Computer Games and Interaction Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Miguel Angel","key":"sicartvilapau","last":"Sicart (Vila)","locid":"689427b5-8d2a-44f3-b291-6db6ba598305","name":"Sicart, Miguel Angel","name_org":"Sicart (Vila), Miguel Angel","orcid":"0000-0002-8356-5394","rank":1,"rolecode":"pau"},{"affno":"","first":"Steffen","key":"waltzpedh","last":"Waltz","name":"Waltz, Steffen","rank":2,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Sebastian","key":"deterdingpedh","last":"Deterding","name":"Deterding, Sebastian","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["9780262028004","026202800X"],"pages":"225-244","publisher":"MIT Press","status":"p","subtitle":"Approaches, Issues, Applications","title":"The Gameful World"},"revie