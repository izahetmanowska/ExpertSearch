{"author_count":4,"contributors":["Sicart, Miguel Angel"],"cuid":["S01-000.00-381942"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"nr","rtype":["clu"],"sorti":"playing computers","src":["itu"],"src-code":["DI-U-ITU"],"type":"dba","type-grp":["all","pub"]},"id":"S01-000.00-381942","ids":["itu-2d9d4595-d205-4469-93b6-ebafe1a39152"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-206D5B5AC89B4B11F86F4647CAAFF3EF"],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Play, Culture, and AI, Games Research Group"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Miguel Angel","key":"sicartpau","last":"Sicart","locid":"689427b5-8d2a-44f3-b291-6db6ba598305","name":"Sicart, Miguel Angel","orcid":"0000-0002-8356-5394","rank":1,"rolecode":"pau"},{"affno":"","first":"Beat","key":"suterpedh","last":"Suter","name":"Suter, Beat","rank":2,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Mela","key":"kocherpedh","last":"Kocher","name":"Kocher, Mela","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Rene","key":"bauerpedh","last":"Bauer","name":"Bauer, Rene","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["9783839443040"],"pages":"47-65","publisher":"Transcript Verlag","status":"p","subtitle":"A Letter to the Reader","title":"Game Mechanics"},"review":"No Review","