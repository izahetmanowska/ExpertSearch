sh Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-b57588db-0a01-4b00-aa7e-bc30fb8e9e66"],"src":["ITU IT University of Copenhagen"],"title":"Mechanics","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383911","year":"2016","yearsub":"2016"}
{"abstract":"This piece provides an explanation to the early success of Pokémon GO. It proposes an argument about how this game exemplifies a computational culture of play. By drawing on philosophy of technology (Floridi, 2013) and game design research (Montola, Stenros, & Waern, 2009), this article argues that the success of Pokémon GO is the result of the development of a play experience and a computational interface for a reality that is already augmented. These interfaces open new possibilities for digital play in public, but they also raise concerns regarding corporate appropriation of public spaces.","author_count":1,"contributors":["Sicart, Miguel Angel"],"cuid":["S01-000.00-382035"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"1 contributor","cluster_size":1,"keyword":["Augmented reality","Game design","Pervasive games","Philosophy of technology","Play theory"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"reality has always been augmented play and the promises of pokémon go","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82437858/MMC_Reality_has_always_been_augmented_Play_and_the_promises_of_Pok_mon_GO.pdf","version":"Authors Final Version"},"id":"S01-000.00-382035","identifier":[{"id":"85011591314","type":"scopus"}],"ids":["itu-345f7487-4820-4bea-a296-b66972310928"],"keyword":["augmented reality","game design","pervasive games","philosophy of technology","play theory"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-85B06C6E891D0783630993047D4DFAD1"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82437858/MMC_Reality_has_always_been_augmented_Play_and_the_promises_of_Pok_mon_GO.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Digital Play","IT University of Copenhagen, Digital Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Miguel Angel","key":"sicartpau","last":"Sicart","locid":"689427b5-8d2a-44f3-b291-6db6ba598305","name":"Sicart, Miguel Angel","orcid":"0000-0002-8356-5394","rank":1,"rolecode":"pau"}],"pub":{"doi":"10.1177/2050157916677863","issn":["20501579","20501587"],"issn_org":["20501579"],"issue":"1","journal":"Mobile Media & Communication","pages":"30-33","publisher":"Sage Publishing","status":"p","title":"Mobile Media & Communication","volume":"5"},"review":"Peer Reviewed","scoID":["2-s2.0-85011591314"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-345f7487-4820-4bea-a296-b66972310928"],"src":["ITU IT University of Copenhagen"],"title":"Reality has always been augmented: Play and the promises of Pokémon GO","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382035","year":"2016","yearsub":"2016"}
