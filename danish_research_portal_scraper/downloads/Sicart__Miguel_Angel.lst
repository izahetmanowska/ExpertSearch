","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-96d715a6-d697-4072-a6e4-5d8321e679dd"],"src":["ITU IT University of Copenhagen"],"title":"Who are the Robots?","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383484","year":"2018","yearsub":"2018"}
{"abstract":"Automation is everywhere. We fear the robots, but it is in fact a more insidious kind of automation, driven by algorithms and presented in a playful way, that is slowly corroding the social fabric. This “soft automation”, the use of algorithms to eliminate semi-skilled white-collar jobs, is transforming services into self-services, and killing the middle class as a result of it.","author_count":2,"contributors":["Sicart, Miguel Angel","Pichlmair, Martin"],"cuid":["S01-000.00-384706"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Algorithms","Middle Class Erosion","Self services","Semi skilled Jobs","Soft Automation"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"playing ourselves into feudalism the politics and ethics of ludic automation","src":["itu"],"src-code":["DI-U-ITU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"doi","url":"https://doi.org/10.14236/ewic/EVAC18.5","version":"Published Version"},"id":"S01-000.00-384706","ids":["itu-e90bb928-8aa3-412c-a48e-c5042cedd205"],"keyword":["Algorithms","Middle Class Erosion","Self-services","Semi-skilled Jobs","Soft Automation"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-3C1E938E98FC5A4775359448A1FEF9C9"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"https://www.scienceopen.com/document_file/285d709f-198a-4b6f-8645-120720a808f8/ScienceOpen/001_Sicart.pdf","version":"Published Version"},{"access":"oa","license":"Ikke-specificeret","type":"doi","url":"https://doi.org/10.14236/ewic/EVAC18.5","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Miguel Angel","key":"sicartpau","last":"Sicart","locid":"689427b5-8d2a-44f3-b291-6db6ba598305","name":"Sicart, Miguel Angel","orcid":"0000-0002-8356-5394","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Martin","key":"pichlmairpau","last":"Pichlmair","locid":"ddcdfda8-c5ea-4e67-b0ea-21ba86966197","name":"Pichlmair, Martin","orcid":"0000-0001-8828-9723","rank":2,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-e90bb928-8aa3-412c-a48e-c5042cedd205"],"src":["ITU IT University of Copenhagen"],"title":"PLAYING OURSELVES INTO FEUDALISM: THE POLITICS AND ETHICS OF LUDIC AUTOMATION","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384706","year":"2018","yearsub":"2018"}
{"abstract":"This article is an inquiry on the role of play in shaping the cultures of the Information Age. By applying concepts from Postphenomenology and the Philosophy of Information, this paper argues that play and computation share a capacity to shape human experience. I will apply the concept of re-ontologization to describe the effect that computation has had in shaping the world. I will apply the concept of relational strategies to argue that play is a way of interfacing with the computational world. This paper argues that play is a particularly relevant form of shaping the human experience of the re-ontologized infosphere because play, like computation, can create worlds. The goal of this article is to propose a research program that situates play as a relevant perspective to analyze the culture of the Information Age.","author_count":1,"contributors":["Sicart, Miguel Angel"],"cuid":["S01-000.00-381646"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"1 contributor","cluster_size":1,"keyword":["Design","Gamification","Information Technologies","Interaction design","Philosophy of information","Play","Postphenomenology"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"play in the information age","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83472699/PN_01_Playing_Systems_Final.pdf","version":"Authors Final Version"},"id":"S01-000.00-381646","identifier":[{"id":"85070774861","type":"scopus"}],"ids":["itu-193fdfcf-a7ab-4a1a-ae78-f2a6012ddb39"],"keyword":["Design","Gamification","Information Technologies","Interaction design","Philosophy of Information","Play","Postphenomenology"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-4EC