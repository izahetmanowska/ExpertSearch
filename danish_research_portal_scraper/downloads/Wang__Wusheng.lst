"Wang","key":"wushengpau","last":"Wusheng","name":"Wusheng, Wang","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Irina","key":"shklovskipau","last":"Shklovski","name":"Shklovski, Irina","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1145/2399016.2399139","isbn":["9781450314824"],"pages":"771-772","publisher":"Association for Computing Machinery","status":"p","title":"Proceedings of the 7th Nordic Conference on Human-Computer Interaction: Making Sense Through Design"},"review":"Peer Reviewed","scoID":["2-s2.0-84871568282"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-0062acae-e3a3-4eb6-b158-73b19c8c1160"],"src":["ITU IT University of Copenhagen"],"title":"TalkingBadge demo","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381252","year":"2012","yearsub":"2012"}
{"abstract":"This paper presents three experiments to explore the feasibility of location-based voice messaging. We first compared three methods for collecting synthetic speech messages located in a room, namely PIN code entry, barcode scanning and automatic detection with a Bluetooth antenna. In addition to being very reliable, Bluetooth detection was significantly faster than PIN code entry and barcode scanning. We then examined detection times and errors in an open five floor building with antennas located densely. This confirmed that Bluetooth is fast enough to catch people walking through a zone and specific enough to distinguish between zones located just 20 meters apart. Finally, we played digitized voice messages to 11 participants walking into a zone. They received most of the messages well, but a majority of their comments were negative, expressing concerns for the potential infringement of privacy. We conclude that location specific audio messaging works from a technical perspective, but requires careful consideration of social comfort.","author_count":5,"contributors":["Hansen, John Paulin","Glenstrup, Arne John","Wusheng, Wang","Weiping, Li","Zhonghai, Wu"],"cuid":["S01-000.00-382951"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Bluetooth accessibility badges disability location based services privacy tagging text to speech tracking ubiquitous computing voice interfaces"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"collecting location based voice messages on a talkingbadge","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1145/2399016.2399050","version":"Other Version"},"id":"S01-000.00-382951","identifier":[{"id":"84871559004","type":"scopus"}],"ids":["itu-719f61b3-ac90-48a4-a128-fe9e0144b6e2"],"keyword":["Bluetooth, accessibility, badges, disability, location-based services, privacy, tagging, text-to-speech, tracking, ubiquitous computing, voice interfaces"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-1439F3A3C8F4065094E6C558BA87AA28"],"oa_link":[{"access":"oa","type":"rem","url":"http://doi.acm.org/10.1145/2399016.2399050","version":"Other Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1145/2399016.2399050","version":"Other Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["The Department, Software & Systems"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"John Paulin","key":"hansenpau","last":"Hansen","name":"Hansen, John Paulin","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Arne John","key":"glenstruppau","last":"Glenstrup","name":"Glenstrup, Arne John","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Wang","key":"wushengpau","last":"Wusheng","name":"Wusheng, Wang","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Li","key":"weipingpau","last":"Weiping","name":"Weiping, Li","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Wu","key":"zhonghaipau","last":"Zhonghai","name":"Zhonghai, Wu","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1145/2399016.2399050","isbn":["9781450314824"],"pages":"219-227","publisher":"Association for Computing Machinery","status":"p","title":"Proceedings of the 7th Nordic Conference on Human-Computer Interaction: Making Sense Through Design"},"review":"Peer Reviewed","scoID":["2-s2.0-84871559004"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-719f61b3-ac90-48a4-a128-fe9e0144b6e2"],"src":["ITU IT University of Copenhagen"],"title":"Collecting location-based voice messages on a TalkingBadge","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382951","year":"2012","yearsub":"2012"}
