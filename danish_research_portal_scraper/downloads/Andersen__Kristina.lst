3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Kristina Kock","key":"hansenkristinakockpau","last":"Hansen","locid":"26513898-de04-4d15-a45f-663331882ccd","name":"Hansen, Kristina Kock","orcid":"0000-0001-9564-958X","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hanne Irene","key":"jensenhanneirenepau","last":"Jensen","locid":"b2e610b2-6aa9-42c9-aa71-a232f122e5a4","name":"Jensen, Hanne Irene","orcid":"0000-0001-9323-4284","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Torben Steensgaard","key":"andersentorbensteensgaardpau","last":"Andersen","name":"Andersen, Torben Steensgaard","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Christian Fynbo","key":"andersenchristianfynbopau","last":"Andersen","name":"Andersen, Christian Fynbo","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.jcrc.2017.09.066","issn":["08839441","15578615"],"issn_org":["08839441"],"journal":"Journal of Critical Care","pages":"391-392","publisher":"WB  Saunders","publisher_org":"W.B. Saunders","status":"p","title":"Journal of Critical Care","volume":"42"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-be05fd18-432c-472e-8e54-fdcc04322e58"],"src":["SDU University of Southern Denmark"],"title":"A comparison between noninvasive neurally adjusted ventilatory assist and noninvasive pressure support : a cohort study","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-627693","year":"2017","yearsub":"2017"}
{"abstract":"This paper presents a comprehensive description and the considerations regarding the design of a new laboratory test setup for testing cyclic axially loaded piles in sand. The test setup aims at analysing the effect of axial one-way cyclic loading on pile capacity and accumulated displacements. Another aim was to test a large diameter pile segment with dimensions resembling full-scale piles to model the interface properties between pile and sand correctly. The pile segment was an open-ended steel pipe pile with a diameter of 0.5 m and a length of 1 m. The sand conditions resembled the dense sand conditions found several places in the North Sea. To simulate various vertical effective stress states, an elastic rubber membrane was placed on the soil surface and connected to a vacuum system, thus, increasing the effective stresses in the sand. A custom-made CPT devise was used to confirm equal soil conditions for all tests. For verifications purposes six static tension tests conducted at three different vertical effective stress levels of 0, 35 and 70 kPa. The load-displacement curves showed that the test setup provides repeatable test results. A preliminary comparison between the unit shaft friction determined from the API RP 2GEO standard and from the test results indicated over consolidation of the sand. Two initial one-way cyclic loading tests provided results of effects on pile capacity and accumulated displacements in agreement with other researchers’ test results.","author_count":3,"contributors":["Thomassen, Kristina","Ibsen, Lars Bo","Andersen, Lars Vabbersgaard"],"cuid":["S01-000.00-070568"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Cyclic Axially Loaded Piles","Laboratory testing","Loaded Piles","Sand"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"laboratory test setup for cyclic axially loaded piles in sand","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://www.ejge.com/2017/Ppr2017.0089ma.pdf","version":"Published Version"},"id":"S01-000.00-070568","ids":["aau-46cbe5e3-0672-46a1-be8c-bf8ca695d102"],"keyword":["Cyclic Axially Loaded Piles","Laboratory testing","Loaded Piles","Sand"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-98FC4B745E12532163E5074174600CCD"],"oa_link":[{"access":"oa","type":"rem","url":"http://www.ejge.com/2017/Ppr2017.0089ma.pdf","version":"Published Version"}],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, Department of Civil Engineering","Aalborg University, The Faculty of Engineering and Science, Department of Civil Engineering, Division for Structures, Materials and Geotechnics (CIVIL)","Aalborg University, The Faculty of Engineering and Science, Department of the Built Environment, Geotechnical Engineering and Offshore Foundations Research Group"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Kristina","key":"thomassenpau","last":"Thomassen","locid":"bb25541c-bdb3-484d-bca5-cb940de369db","name":"Thomassen, Kristina","orcid":"0000-0001-8982-5532","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars Bo","key":"ibsenpau","last":"Ibsen","locid":"23b734a4-b2f7-44cd-ba17-e812ddc3640c","name":"Ibsen, Lars Bo","orcid":"0000-0002-1304-6660","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars Vabbersgaard","key":"andersenpau","last":"Andersen","locid":"570293f5-d48d-46dc-b8d2-b2cc1925cab7","name":"Andersen, Lars Vabbersgaard","orcid":"0000-0003-0543-2892","rank":3,"rolecode":"pau"}],"pub":{"issn":["10893032"],"issue":"3","journal":"Electronic Journal of Geotechnical Engineering","pages":"1089-1106","publisher":"Oklahoma State University","status":"p","title":"Electronic Journal of Geotechnical Engineering","volume":"22"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-46cbe5e3-0672-46a1-be8c-bf8ca695d102"],"src":["AAU Aalborg University"],"title":"Laboratory Test Setup for Cyclic Axially Loaded Piles in Sand","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-070568","year":"2017","yearsub":"2017"}
{"abstract":"The derivation of functional cardiomyocytes (CMs) from human embryonic stem cells (hESC) represents a unique way of studying human cardiogenesis, including the development of CM subtypes. In this study, we investigated the development and organization of CMs derived from hESCs (hESC-CMs) and examined how the expression of CM subtypes correspond to human in vivo cardiogenesis. Beating clusters were used to determine cardiac differentiation, which was evaluated by the expression of cardiac genes GATA4 and TNNT2 and subcellular localization of GATA4 and NKX2.5. Sharp electrode recordings to determine action potentials (AP) further revealed spatial organization of intra-clustal CM subtypes (i.e complex clusters). Nodal-, atrial- and ventricular-like APs morphologies were detected within distinct regions of complex clusters. The ability of different CM subtypes to self-organize was documented by immunohistochemical analyses and a differential spatial expression of β-III tubulin, Myosin light chain 2v (MLC-2V) and α-smooth muscle actin (α-SMA). Further, all hESC-CM subtypes formed expressed primary cilia, which are known to coordinate cellular signalling pathways during cardiomyogenesis and heart development. Finally, the β-III tubulin specific localised expression is suggested to represent a new marker for nodal CMs. This study expands our understanding of CM specialization and intra-clustal CM subtype organization, improving the foundation for studying regulatory pathways for spatial and temporal CM differentiation during human cardiogenesis.","author_count":10,"contributors":["Vestergaard, Maj Linea","Grubb, Søren","Rasmussen, Karen Koefoed","Anderson-Jenkins, Zoe Lauren","Grunnet-Lauridsen, Kristina","Calloe, Kirstine","Clausen, Christian","Christensen, Søren Tvorup","Møllgård, Kjeld","Andersen, Claus Yding"],"cuid":["S01-000.00-436606"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GTS","DI-HO","DI-U"],"level3":{"GTS":["DI-GTS-ALL","DI-GTS-BION"],"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-GTS-BION","DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"human embryonic stem cell derived cardiomyocytes self arrange with areas of different subtypes during differentiation","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-436606","identifier":[{"id":"28795648","type":"pmid"},{"id":"85032437978","type":"scopus"}],"ids":["ku-484bb305-426f-46bb-9393-fe4b4a30fe11"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-DA6E2284F928B41A9305B3A388AEDEF7"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Veterinary and Animal Sciences, Pathobiological Sciences"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"dk","key":"bioneer","l2":"DI-GTS","l2n":"GTS Institutes","l3":"DI-GTS-BION","l3nn":"Bioneer","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Bioneer","namevar":["Bioneer"],"nora_code":"DI-GTS-BION","used":1}],"person":[{"affno":"1","first":"Maj Linea","key":"vestergaardpau","last":"Vestergaard","