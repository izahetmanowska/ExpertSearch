Resources Institute Finland","used":1},{"affno":"7","country":"fi","key":"natural resources institute finland","loc":["Finland","Europe, EU","Nordic","OECD"],"name":"Natural Resources Institute Finland (Luke)","used":1},{"affno":"8","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Globe Institute, Section for Hologenomics"],"nora_code":"DI-U-KU","used":1},{"affno":"9","country":"se","key":"university of gothenburg","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"University of Gothenburg","used":1},{"affno":"10","country":"de","key":"federal environmental agency germany","loc":["Germany","Europe, EU","OECD"],"name":"Federal Environmental Agency, Germany","used":1},{"affno":"11","country":"de","key":"german environment agency","loc":["Germany","Europe, EU","OECD"],"name":"German Environment Agency","used":1},{"affno":"12","country":"my","key":"universiti malaysia terengganu","loc":["Malaysia","Asia, South"],"name":"Universiti Malaysia Terengganu","used":1}],"person":[{"affno":"1 2","corresponding":null,"country":"dk","first":"Christian","key":"sonnepau","last":"Sonne","locid":"d9d824ac-a413-4a2a-bfbf-aff2aa7d406a","name":"Sonne, Christian","orcid":"0000-0001-5723-5263","rank":1,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Ursula","key":"siebertpau","last":"Siebert","name":"Siebert, Ursula","rank":2,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Katharina","key":"gonnsenpau","last":"Gonnsen","name":"Gonnsen, Katharina","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jean Pierre","key":"desforgespau","last":"Desforges","locid":"32d88e95-bca3-427e-bf38-501f248d561e","name":"Desforges, Jean-Pierre","name_org":"Desforges, Jean Pierre","rank":4,"rolecode