pau","last":"Spence","name":"Spence, John David","rank":9,"rolecode":"pau"},{"affno":"8","first":"J. David","key":"spencejdavidpau","last":"Spence","name":"Spence, J. David","rank":9,"rolecode":"pau"},{"affno":"9","corresponding":null,"first":"John F","key":"rhodesjohnfpau","last":"Rhodes","name":"Rhodes, John F","rank":10,"rolecode":"pau"},{"affno":"10 11","corresponding":null,"first":"Scott E","key":"kasnerscottepau","last":"Kasner","name":"Kasner, Scott E","rank":11,"rolecode":"pau"},{"affno":"4 3","first":"Lars","key":"søndergaardlarspau","last":"Sondergaard","locid":"6a064e1f-1f3e-480c-a5a2-53086732b169","name":"Søndergaard, Lars","name_org":"Sondergaard, Lars","rank":12,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens Erik","key":"nielsenkudskjenserikpau","last":"Nielsen-Kudsk","locid":"8629b763-e23e-41d9-ac4f-61579d19565e","name":"Nielsen-Kudsk, Jens Erik","rank":13,"rolecode":"pau"}],"pmid":["34773685"],"pub":{"doi":"10.1002/ccd.30019","issn":["15221946","1522726X"],"issn_org":["15221946"],"issue":"5","journal":"Catheterization and Cardiovascular Interventions","pages":"1551-1557","publisher":"John Wiley & Sons Inc.","status":"p","title":"Catheterization and Cardiovascular Interventions","volume":"99"},"review":"Peer Reviewed","scoID":["2-s2.0-85119250068"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-5f126f8f-5019-4ffc-a612-a7c408191ea4","ku-90a58319-1c0b-4aaf-9243-f4a4b95425bf"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Atrial fibrillation after closure of patent foramen ovale in the REDUCE clinical study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-019573","year":"2022","yearsub":"2022"}
{"abstract":"Ultra-low dose computed tomography (ULD-CT) assessed by non-radiologists in a medical Emergency Department (ED) has not been examined in previous studies. To (i) investigate intragroup agreement among attending physicians caring for ED patients (i.e., radiologists, senior- and junior clinicians) and medical students for the detection of acute lung conditions on ULD-CT and supine chest X-ray (sCXR), and (ii) evaluate the accuracy of interpretation compared to the reference standard. In this prospective study, non-traumatic patients presenting to the ED, who received an sCXR were included. Between February and July 2019, 91 patients who underwent 93 consecutive examinations were enrolled. Subsequently, a ULD-CT and non-contrast CT were performed. The ULD-CT and sCXR were assessed by 3 radiologists, 3 senior clinicians, 3 junior clinicians, and 3 medical students for pneumonia, pneumothorax, pleural effusion, and pulmonary edema. The non-contrast CT, assessed by a chest radiologist, was used as the reference standard. The results of the assessments were compared within each group (intragroup agreement) and with the reference standard (accuracy) using kappa statistics. Accuracy and intragroup agreement improved for pneumothorax on ULD-CT compared with the sCXR for all groups. Accuracy and intragroup agreement improved for pneumonia on ULD-CT when assessed by radiologists and for pleural effusion when assessed by medical students. In patients with acute lung conditions ULD-CT offers improvement in the detection of pneumonia by radiologists and the detection of pneumothorax by radiologists as well as non-radiologists compared to sCXR. Therefore, ULD-CT may be considered as an alternative first-line imaging modality to sCXR for non-traumatic patients who present to EDs.","author_count":15,"contributors":["Kristjansdottir, Björg","Tækker, Maria","Andersen, Michael B","Bentsen, Lasse Paludan","Berntsen, Mikkel H","Dahlin, Jan","Fransen, Maja L","Gosvig, Kristina","Greisen, Pernille Wied","Laursen, Christian B","Mussmann, Bo Redder","Posth, Stefan","Rasmussen, Claus-Henrik","Sjölander, Hannes","Graumann, Ole"],"cuid":["S02-100.00-666975"],"filters":{"added":"2022-11","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Kristjansdottir, Björg"],"country":["Norway"],"glorg":["All Global Affiliations","Oslo Metropolitan University"],"keyword":["Accuracy","Chest X ray","Emergency department","Humans","Pleural Effusion diagnostic imaging","Pneumonia","Pneumothorax diagnostic imaging","Prospective Studies","Radiation Dosage","Tomography X Ray Computed methods","Ultra low dose CT","low dose CT"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-SDR","DI-HO-ZEA"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-SDR","DI-HO-ZEA","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"ultra low dose computed tomography of the chest in an emergency setting a prospective agreement study","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1097/MD.0000000000029553","version":"Published Version"},"id":"S02-100.00-666975","identifier":[{"id":"85135730634","type":"scopus"},{"id":"35945776","type":"pmid"},{"id":"PMC9351905","type":"pmcid"}],"ids":["ku-d9cacec9-8186-4d45-806d-79e359d9c4cb","sdu-9ab08da4-33c2-4ec7-a3a3-8843ac088dad"],"keyword":["Emergency Department","Humans","Pleural Effusion/diagnostic imaging","Pneumonia","Pneumothorax/diagnostic imaging","Prospective Studies","Radiation Dosage","Tomography, X-Ray Computed/methods","accuracy","chest X-ray","low-dose CT","ultra-low dose CT"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Glob