{"author_count":7,"contributors":["Lysdahlgaard, Simon","Blauenfeldt, Rolf A.","Andersen, Grethe","Mikkelsen, Irene K.","Hougaard, Kristina Dupont","Gude, Martin Faurholdt","Dalby, Rikke Beese"],"cuid":["S01-000.00-812515"],"event":{"end":"2025-02-07","place":"Los Angeles , us","start":"2025-02-04","title":"International Stroke Conference","year":"2025"},"filters":{"added":"2025-06","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Lysdahlgaard, Simon"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR"],"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-HO-CDR","DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"abstract wmp000000000009 the effect of remote ischemic conditioning on acute infarct growth in patients with acute ischemic stroke subgroup analysis from the resist trial","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-812515","ids":["sdu-8a658d1a-fe02-450d-89f0-bf740bbd6c04"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-2-D0AB0A54B920C9A9C4516291A8D3D545"],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Regional Health Research","SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS - Esbjerg and Grindsted Hospital, Research Unit of Radiology and nuclear medicine (Esbjerg)"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1},{"affno":"3","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Simon","key":"lysdahlgaardpau","last":"Lysdahlgaard","locid":"f964080f-5d8e-4ded-b1c7-1316a813216b","name":"Lysdahlgaard, Simon","orcid":"0000-0003-4868-6753","rank":1,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Rolf A.","key":"blauenfeldtpau","last":"Blauenfeldt","name":"Blauenfeldt, Rolf A.","rank":2,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Grethe","key":"andersenpau","last":"Andersen","name":"Andersen, Grethe","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Irene K.","key":"mikkelsenpau","last":"Mikkelsen","name":"Mikkelsen, Irene K.","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Kristina Dupont","key":"hougaardpau","last":"Hougaard","name":"Hougaard, Kristina Dupont","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Martin Faurholdt","key":"gudepau","last":"Gude","name":"Gude, Martin Faurholdt","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rikke Beese","key":"dalbypau","last":"Dalby","locid":"0155a65c-b4bf-44e2-b55e-2fc54e6298f9","name":"Dalby, Rikke Beese","orcid":"0000-0002-3385-1480","rank":7,"rolecode":"pau"}],"pub":{"doi":"10.1161/str.56.suppl_1.wmp9","issn":["00392499","15244628"],"issn_org":["00392499"],"issue":"Suppl. 1","journal":"Stroke","publisher":"Wolters Kluwer Health","status":"p","title":"Stroke","volume":"56"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospi