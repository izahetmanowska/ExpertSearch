me":"Becker, Ulrik","orcid":"0000-0002-1678-7771","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kjeld","key":"andersenkjeldpau","last":"Andersen","locid":"09e33edd-1368-42e0-9bb7-14e6ae030adf","name":"Andersen, Kjeld","orcid":"0000-0003-0456-5634","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Regina","key":"christiansenreginapau","last":"Christiansen","locid":"a79eb630-2537-49b0-9dbe-9a7fdcc90c77","name":"Christiansen, Regina","orcid":"0000-0001-8029-8289","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Angelina Isabella","key":"mellentinangelinaisabellapau","last":"Mellentin","locid":"354a18df-b9f8-4eb2-b0f3-b815c1a6dfe0","name":"Mellentin, Angelina Isabella","orcid":"0000-0002-6515-2852","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Nicolai","key":"mistarznicolaipau","last":"Mistarz","name":"Mistarz, Nicolai","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Bent","key":"nielsenbentpau","last":"Nielsen","locid":"adc563a7-67eb-4f54-82b6-40cacc21d300","name":"Nielsen, Bent","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Camilla Dahl","key":"olsencamilladahlhaislundpau","last":"Olsen","locid":"249898db-7819-42b4-b953-5871e8803f39","name":"Olsen, Camilla Dahl Haislund","name_org":"Olsen, Camilla Dahl","orcid":"0000-0002-8309-9266","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lotte","key":"skøtlottepau","last":"Skøt","locid":"4902df5a-0988-4535-9480-434af6b26352","name":"Skøt, Lotte","orcid":"0000-0003-1762-8876","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kristina Hasselbalch","key":"volkekristinahasselbalchpau","last":"Volke","locid":"45741abf-4d8d-4917-95cc-3c96232e303f","name":"Volke, Kristina Hasselbalch","orcid":"0009-0001-9100-6306","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anette Søgaard","key":"nielsenanettesøgaardpau","last":"Nielsen","locid":"63429b82-37e7-4fc5-84dd-f73ef3f5658a","name":"Nielsen, Anette Søgaard","orcid":"0000-0002-8569-4165","rank":10,"rolecode":"pau"}],"pub":{"isbn":["9788799062706"],"pages":"259","publisher":"Enheden for Klinisk Alkoholforskning","publisher_org":"Enheden for klinisk alkoholforskning","status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-6606d9f2-6f69-4d4e-8349-c699ce37cf67"],"src":["SDU University of Southern Denmark"],"title":"Litteraturgennemgang af evidens vedførende alkoholbehandling","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-697125","year":"2023","yearsub":"2023"}
{"abstract":"Follicular lymphoma (FL) is an indolent lymphoma with a generally favorable prognosis. However, histological transformation (HT) to a more aggressive disease leads to markedly inferior outcomes. This study aims to identify biological differences predictive of HT at the time of initial FL diagnosis. We show differential protein expression between diagnostic lymphoma samples from patients with subsequent HT (subsequently-transforming FL [st-FL]; n = 20) and patients without HT (nontransforming FL [nt-FL]; n = 34) by label-free quantification nano liquid chromatography-tandem mass spectrometry analysis. Protein profiles identified patients with high risk of HT. This was accompanied by disturbances in cellular pathways influencing apoptosis, the cytoskeleton, cell cycle, and immune processes. Comparisons between diagnostic st-FL samples and paired transformed FL (n = 20) samples demonstrated differential protein profiles and disrupted cellular pathways, indicating striking biological differences from the time of diagnosis up to HT. Immunohistochemical analysis of apoptotic proteins, CASP3, MCL1, BAX, BCL-xL, and BCL-rambo, confirmed higher expression levels in st-FL than in nt-FL samples (P < .001, P = .015, P = .003, P = .025, and P = .057, respectively). Moreover, all 5 markers were associated with shorter transformation-free survival (TFS; P < .001, P = .002, P < .001, P = .069, and P = .010, respectively). Notably, combining the expression of these proteins in a risk score revealed increasingly inferior TFS with an increasing number of positive markers. In conclusion, proteomics identified altered protein expression profiles (particularly apoptotic proteins) at the time of FL diagnosis, which predicted later transformation.","author_count":12,"contributors":["Enemark, Marie Beck","Wolter, Katharina","Campbell, Amanda Jessica","Andersen, Maja Irene Dam","Sørensen, Emma Frasez","Hybel, Trine Engelbrecht","Madsen, Charlotte","Lauridsen, Kristina Lystlund","Plesner, Trine Lindhardt","Hamilton-Dutoit, Stephen Jacques","Honoré, Bent","Ludvigsen, Maja"],"cuid":["S02-099.07-735309"],"filters":{"added":"2023-11","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"keyword":["Apoptosis","Humans","Lymphoma Follicular diagnosis","Neoplasm Recurrence Local","Prognosis","Proteomics"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"proteomics identifies apoptotic markers as predictors of histological transformation in patients with follicular lymphoma","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1182/bloodadvances.2023011299","version":"Published Version"},"id":"S02-099.07-735309","identifier":[{"id":"37824846","type":"pmid"},{"id":"85180937827","type":"scopus"},{"id":"PMC10758743","type":"pmcid"}],"ids":["au-c0e2a142-9ccb-4c89-9110-c563e10cb996","ku-6858195d-4f65-499c-ae5b-cbc4a1ef14c1"],"keyword":["Apoptosis","Humans","Lymphoma, Follicular/diagnosis","Neoplasm Recurrence, Local","Prognosis","Proteomics"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-EA22791DAD216A999A0E37EE17EB9524"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/389830980/Proteomics_identifies.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1182/bloodadvances.2023011299","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"]