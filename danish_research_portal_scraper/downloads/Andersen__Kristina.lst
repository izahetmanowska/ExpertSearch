{"abstract":"Remote ischemic preconditioning is neuroprotective in models of acute cerebral ischemia. We tested the effect of prehospital rPerC as an adjunct to treatment with intravenous alteplase in patients with acute ischemic stroke.","author_count":21,"contributors":["Hougaard, Kristina Dupont","Hjort, Niels","Zeidler, Dora","Sørensen, Leif Hougaard","Nørgaard, Anne","Hansen, Troels Martin","Weitzel, Paul von","Simonsen, Claus Ziegler","Damgaard, Dorte","Gottrup, Hanne","Svendsen, Kristina Bacher","Rasmussen, Peter Vestergaard","Ribe, Lars Riisgaard","Mikkelsen, Irene Klærke","Nagenthiraja, Kartheeban","Cho, Tae-Hee","Redington, Andrew N","Bøtker, Hans Erik","Østergaard, Leif","Mouridsen, Kim","Andersen, Grethe"],"cuid":["S01-000.00-183854"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"remote ischemic perconditioning as an adjunct therapy to thrombolysis in patients with acute ischemic stroke a randomized trial","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1161/STROKEAHA.113.001346","version":"Other Version"},"id":"S01-000.00-183854","identifier":[{"id":"24203849","type":"pmid"},{"id":"84893657726","type":"scopus"}],"ids":["au-5f88e8f7-65b8-4d8e-869d-9f182308b3f8"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-C63D39075D3B4B9D979A140DC1C1C5A8"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1161/STROKEAHA.113.001346","version":"Other Version"}],"oai":{"class":"Blocked","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus Uni