"John J V","key":"mcmurraypau","last":"McMurray","name":"McMurray, John J V","rank":12,"rolecode":"pau"},{"affno":"","first":"Stefano","key":"delpratopau","last":"Del Prato","name":"Del Prato, Stefano","rank":13,"rolecode":"pau"},{"affno":"","first":"Rury","key":"holmanpau","last":"Holman","name":"Holman, Rury","rank":14,"rolecode":"pau"},{"affno":"","first":"David","key":"demetspau","last":"DeMets","name":"DeMets, David","rank":15,"rolecode":"pau"},{"affno":"","first":"Matthew","key":"riddlepau","last":"Riddle","name":"Riddle, Matthew","rank":16,"rolecode":"pau"},{"affno":"","first":"Søren","key":"galatiuspau","last":"Galatius","name":"Galatius, Søren","rank":17,"rolecode":"pau"},{"affno":"","first":"Ulla","key":"andersenpau","last":"Andersen","name":"Andersen, Ulla","rank":18,"rolecode":"pau"},{"affno":"","first":"Jens","key":"brønnumschoupau","last":"Brønnum-Schou","name":"Brønnum-Schou, Jens","rank":19,"rolecode":"pau"},{"affno":"1","first":"Jens Dahlgaard","key":"hovepau","last":"Hove","locid":"4ecfb416-ea53-418e-a6c3-ace7647318ea","name":"Hove, Jens Dahlgaard","orcid":"0000-0002-5600-5623","rank":20,"rolecode":"pau"},{"affno":"1","first":"Jan Skov","key":"jensenpau","last":"Jensen","locid":"e29024e8-87d0-4edb-a304-f0b6393488a4","name":"Jensen, Jan Skov","rank":21,"rolecode":"pau"},{"affno":"","first":"Lars","key":"koberpau","last":"Kober","name":"Kober, Lars","rank":22,"rolecode":"pau"},{"affno":"","first":"Ole Peter","key":"kristiansenpau","last":"Kristiansen","name":"Kristiansen, Ole Peter","rank":23,"rolecode":"pau"},{"affno":"","first":"Per","key":"lundpau","last":"Lund","name":"Lund, Per","rank":24,"rolecode":"pau"},{"affno":"","first":"Thomas","key":"melchiorpau","last":"Melchior","name":"Melchior, Thomas","rank":25,"rolecode":"pau"},{"affno":"","first":"Ole","key":"nyvadpau","last":"Nyvad","name":"Nyvad, Ole","rank":26,"rolecode":"pau"},{"affno":"1","first":"Morten","key":"schoupau","last":"Schou","locid":"48fa6ec9-1941-4566-b931-14b0cc8cbae3","name":"S