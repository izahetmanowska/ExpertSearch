,"last":"Thorsteinsson","name":"Thorsteinsson, Kristina","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Carsten Schade","key":"larsencarstenschadepau","last":"Larsen","locid":"2435cb82-03bd-498b-909d-1ef0e99443fe","name":"Larsen, Carsten Schade","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Gitte","key":"pedersengittepau","last":"Pedersen","locid":"03b23acd-948c-47f7-80f8-38dc1d456f53","name":"Pedersen, Gitte","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Court","key":"pedersencourtpau","last":"Pedersen","locid":"7f2e0dec-1687-4283-ac30-53e73c124437","name":"Pedersen, Court","rank":7,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"C","key":"pedersencpau","last":"Pedersen","name":"Pedersen, C","rank":7,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Niels","key":"obelnielspau","last":"Obel","name":"Obel, Niels","orcid":"0000-0002-5031-0045","rank":8,"rolecode":"pau"}],"pmid":["21306418"],"pub":{"doi":"10.1111/j.1365-2125.2011.03935.x","issn":["02643774","03065251"],"issn_org":["03065251"],"issue":"1","journal":"British Journal of Clinical Pharmacology","pages":"116-24","publisher":"Wiley-Blackwell Publishing Ltd","status":"p","title":"British Journal of Clinical Pharmacology","volume":"72"},"review":"Peer Reviewed","scoID":["2-s2.0-79958755052"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-4482c065-498f-4f28-bdb8-b5ed678f5e6b","ku-2fa53a38-47cf-49c6-a889-a23ac867b443","sdu-bd1bdcf9-3798-47bb-9870-fc639ffb4b46"],"src":["AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Adherence to national guidelines for initiation of antiretroviral regimens in HIV patients: a Danish nationwide study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-094.83-017644","year":"2011","yearsub":"2011"}
{"abstract":"In this study, we evaluated the repeatability of pupil responses to colored light stimuli in healthy subjects using a prototype chromatic pupillometer. One eye of 10 healthy subjects was tested twice in the same day using monochromatic light exposure at two selected wavelengths (660 and 470¿nm, intensity 300¿cd/m(2)) presented continuously for 20¿s. Pupil responses were recorded in real-time before, during, and after light exposure. Maximal contraction amplitude and sustained contraction amplitude were calculated. In addition, we quantified the summed pupil response during continuous light stimulation as the total area between a reference line representing baseline pupil size and the line representing actual pupil size over 20¿s (area under the curve). There was no significant difference in the repeated measure compared to the first test for any of the pupil response parameters. In conclusion, we have developed a novel prototype of color pupillometer which demonstrates good repeatability in evoking and recording the pupillary response to a bright blue and red light stimulus.","author_count":5,"contributors":["Herbst, Kristina","Sander, Birgit","Milea, Dan","Lund-Andersen, Henrik","Kawasaki, Aki"],"cuid":["S01-000.00-477633"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"test retest repeatability of the pupil light response to blue and red light stimuli in normal human eyes using a novel pupillometer","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.3389/fneur.2011.00010","version":"Other Version"},"id":"S01-000.00-477633","identifier":[{"id":"84864595669","type":"scopus"}],"ids":["ku-8ccc17d4-5318-470e-830f-b9f7a1326b28"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-24845310335BFCA6F3D3ACB4735D3F7B"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.3389/fneur.2011.00010","version":"Other Version"}],"org":[{"affno":1,"key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Section of Neurology, Psychiatry and Sensory Sciences"],"nora_code":"DI-U-KU"}],"person":[{"affno":"","first":"Kristina","key":"herbstpau","last":"Herbst","name":"Herbst, Kristina","rank":1,"rolecode":"pau"},{"affno":"","first":"Birgit","key":"sanderpau","last":"Sander","locid":"62cb74c8-aa3c-4d9e-9cbb-03250f760560","name":"Sander, Birgit","rank":2,"rolecode":"pau"},{"affno":"","first":"Dan","key":"mileapau","last":"Milea","locid":"688d62a6-7977-4e32-92dd-95c4cbbdc02a","name":"Milea, Dan","rank":3,"rolecode":"pau"},{"affno":"","first":"Henrik","key":"lundandersenpau","last":"Lund-Andersen","name":"Lund-Andersen, Henrik","rank":4,"rolecode":"pau"},{"affno":"","first":"Aki","key":"kawasakipau","last":"Kawasaki","name":"Kawasaki, Aki","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.3389/fneur.2011.00010","issn":["16642295"],"journal":"Frontiers in Neurology","pages":"10","status":"p","title":"Frontiers in Neurology","volume":"2"},"review":"Peer Reviewed","scoID":["2-s2.0-84864595669"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-8ccc17d4-5318-470e-830f-b9f7a1326b28"],"src":["KU University of Copenhagen"],"title":"Test-retest repeatability of the pupil light response to blue and red light stimuli in normal human eyes using a novel pupillometer","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-477633","year":"2011","yearsub":"2011"}
