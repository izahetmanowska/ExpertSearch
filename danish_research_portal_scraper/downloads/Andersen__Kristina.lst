org":"Berg, Lise C.","orcid":"0000-0002-8752-2885","rank":5,"rolecode":"pau"},{"affno":"1","first":"Rosalind E.","key":"jenkinspau","last":"Jenkins","name":"Jenkins, Rosalind E.","rank":6,"rolecode":"pau"},{"affno":"2","first":"Casper","key":"lindegaardpau","last":"Lindegaard","locid":"c35f8c45-feb5-4dc3-adf1-5bc7512465d6","name":"Lindegaard, Casper","orcid":"0000-0001-5880-3234","rank":7,"rolecode":"pau"},{"affno":"3","first":"Kristina","key":"uvebrantpau","last":"Uvebrant","name":"Uvebrant, Kristina","rank":8,"rolecode":"pau"},{"affno":"3","first":"Evy","key":"lundgrenåkerlundpau","last":"Lundgren-Åkerlund","name":"Lundgren-Åkerlund, Evy","rank":9,"rolecode":"pau"},{"affno":"1","first":"Agnieszka","key":"turlopau","last":"Turlo","name":"Turlo, Agnieszka","rank":10,"rolecode":"pau"},{"affno":"4","first":"Victoria","key":"jamespau","last":"James","name":"James, Victoria","rank":11,"rolecode":"pau"},{"affno":"2","first":"Stine","key":"jacobsenpau","last":"Jacobsen","locid":"f3957428-a0cc-46ad-a05c-b85ca7d03e9e","name":"Jacobsen, Stine","orcid":"0000-0002-2380-4576","rank":12,"rolecode":"pau"},{"affno":"1","first":"Mandy J.","key":"pefferspau","last":"Peffers","name":"Peffers, Mandy J.","rank":13,"rolecode":"pau"}],"pmid":["36504839"],"pub":{"doi":"10.3389/fvets.2022.1057667","issn":["22971769"],"journal":"Frontiers in Veterinary Science","paperid":"1057667","status":"p","title":"Frontiers in Veterinary Science","volume":"9"},"review":"Peer Reviewed","scoID":["2-s2.0-85143404489"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-610a10cb-4ba3-414c-8780-9532ce4584c7"],"src":["KU University of Copenhagen"],"title":"Temporal extracellular vesicle protein changes following intraarticular treatment with integrin α10β1-selected mesenchymal stem cells in equine osteoarthritis","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-451505","year":"2022","yearsub":"2022"}
{"abstract":"Background: Research on hyperhidrosis comorbidities has documented the co-occurrence of diseases but has not provided information about temporal disease associations. Objective: To investigate the temporal disease trajectories of individuals with hospital-diagnosed hyperhidrosis. Methods: This is a hospital-based nationwide cohort study including all patients with a hospital contact in Denmark between 1994 and 2018. International Classification of Diseases version-10 diagnoses assigned to inpatients, outpatients and emergency department patients were collected from the Danish National Patient Register. The main outcome was the temporal disease associations occurring in individuals with hyperhidrosis, which was assessed by identifying morbidities significantly associated with hyperhidrosis and then examining whether there was a significant order of these diagnoses using binomial tests. Results: Overall, 7 191 519 patients were included. Of these, 8758 (0.12%) patients had localized hyperhidrosis (5674 female sex [64.8%]; median age at first diagnosis 26.9 [interquartile range 21.3–36.1]) and 1102 (0.015%) generalized hyperhidrosis (606 female sex [59.9%]; median age at first diagnosis 40.9 [interquartile range 26.4–60.7]). The disease trajectories comprised pain complaints, stress, epilepsy, respiratory and psychiatric diseases. The most diagnosed morbidities for localized hyperhidrosis were abdominal pain (relative risk [RR] = 121.75; 95% Confidence Interval [CI] 121.14–122.35; P < 0.001), soft tissue disorders (RR = 151.19; 95% CI 149.58–152.80; P < 0.001) and dorsalgia (RR = 160.15; 95% CI 158.92–161.38; P < 0.001). The most diagnosed morbidities for generalized hyperhidrosis were dorsalgia (RR = 306.59; 95% CI 302.17–311.02; P < 0.001), angina pectoris (RR = 411.69; 95% CI 402.23–421.16; P < 0.001) and depression (RR = 207.92; 95% CI 202.21–213.62; P < 0.001). All these morbidities were diagnosed before hyperhidrosis. Conclusions: This paper ascertains which hospital-diagnosed morbidities precede hospital-diagnosed hyperhidrosis. As hyperhidrosis mainly is treated in the primary health care sector, the trajectories suggests that these morbidities may lead to a worse disease course of hyperhidrosis that necessitates treatment in hospitals. Treating these morbidities may improve the disease course of hyperhidrosis.","author_count":8,"contributors":["Henning, Mattias A.S.","Reguant, Roc","Jørgensen, Isabella Friis","Andersen, Rune Kjærsgaard","Ibler, Kristina S.","Pedersen, Ole Birger","Jemec, Gregor B E","Brunak, Søren"],"cuid":["S01-000.00-478568"],"filters":{"added":"2023-02","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"the temporal association of hyperhidrosis and its comorbidities a nationwide hospital based cohort study","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1111/jdv.18351","version":"Published Version"},"id":"S01-000.00-478568","identifier":[{"id":"35735049","type":"pmid"},{"id":"85133655850","type":"scopus"},{"id":"PMC9796903","type":"pmcid"}],"ids":["ku-8e60b12d-2c8d-4cdd-8d4a-d54071e7db4a"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-4B891AA9958B6ADF83E4B7BABA219852"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/329420488/Acad_Dermatol_Venereol_2022_Henning_The_temporal_association_of_hyperhidrosis_and_its_comorbidities_a_nationwide.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1111/jdv.18351","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"M. A.S.","key":"henningpau","last":"Henning","locid":"98da568f-c6ff-4481-bac4-5c7f715147cd","name":"Henning, Mattias A.S.","name_org":"Henning, M. A.S.","rank":1,"rolecode":"pau"},{"affno":"1","first":"R.","key":"reguantpau","last":"Reguant","locid":"2af37d99-8268-4aab-b344-00a2bcc392b7","name":"Reguant, Roc","name_org":"Reguant, R.","orcid":"0000-0002-0350-3899","rank":2,"rolecode":"pau"},{"affno":"1","first":"I. F.","key":"jørgensenpau","last":"Jørgensen","locid":"60383676-7269-4b6e-aa2e-4d6a8a999449","name":"Jørgensen, Isabella Friis","name_org":"Jørgensen, I. F.","orcid":"0000-0001-5694-4332","rank":3,"rolecode":"pau"},{"affno":"1","first":"R. K.","key":"andersenpau","last":"Andersen","locid":"b9ecd15a-cf83-41cc-8898-9fd38d6b4490","name":"Andersen, Rune Kjærsgaard","name_org":"Andersen, R. K.","rank":4,"rolecode":"pau"},{"affno":"1","first":"K. S.","key":"iblerpau","last":"Ibler","locid":"41e31ebc-54d0-4de5-bcae-b732012878de","name":"Ibler, Kristina S.","name_org":"Ibler, K. S.","rank":5,"rolecode":"pau"},{"affno":"1","first":"O. B.","key":"pedersenpau","last":"Pedersen","locid":"0d43956a-6e43-42d7-8b29-4505d03ea5c8","name":"Pedersen, Ole Birger","name_org":"Pedersen, O. B.","orcid":"0000-0003-2312-5976","rank":6,"rolecode":"pau"},{"affno":"1","first":"G.B.E.","key":"jemecpau","last":"Jemec","locid":"b963b007-18b6-4432-897f-28b6a08275be","name":"Jemec, Gregor B E","name_org":"Jemec, G.B.E.","orcid":"0000-0002-0712-2540","rank":7,"rolecode":"pau"},{"affno":"1","first":"S.","key":"brunakpau","last":"Brunak","locid":"9398f2a1-bef5-4491-9b57-083e6758eac2","name":"Brunak, Søren","name_org":"Brunak, S.","orcid":"0000-0003-0316-5866","rank":8,"rolecode":"pau"}],"pmid":["35735049"],"pub":{"doi":"10.1111/jdv.18351","issn":["09269959","14683083"],"issn_org":["09269959"],"issue":"12","journal":"Journal of the European Academy of Dermatology and Venereology","pages":"2504-2511","status":"p","title":"Journal of the European Academy of Dermatology and Venereology","volume":"36"},"review":"Peer Reviewed","scoID":["2-s2.0-85133655850"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-8e60b12d-2c8d-4cdd-8d4a-d54071e7db4a"],"src":["KU University of Copenhagen"],"title":"The temporal association of hyperhidrosis and its comorbidities – a nationwide hospital-based cohort study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-478568","year":"2022","yearsub":"2022"}
{"abstract":"In June, 2022, 25 scientists from eight countries met at the International Agency for Research on Cancer (IARC) in Lyon, France, to finalise their evaluation of the carcinogenicity of occupational exposure as a firefighter. This assessment will be published in Volume 132 of the IARC Monographs.1 Occupational exposure as a firefighter was classified as “carcinogenic to humans” (Group 1) based on “sufficient” evidence for cancer in humans. The Working Group concluded that there was “sufficient” evidence in humans for mesothelioma and bladder cancer. There was “limited” evidence in humans for colon, prostate, and testicular cancers, and for melanoma and non-Hodgkin lymphoma. There was also “strong” mechanistic evidence that occupational exposure as a firefighter shows the following key characteristics of carcinogens in exposed humans: “is genotoxic”, “induces epigenetic alterations”, “induces oxidative stress”, “induces chronic inflammation”, and “modulates receptor-mediated effects”. Evidence regarding cancer in experimental animal models was “inadequate” because no studies were available. The Group 1 evaluation for occupational exposure as a firefighter should be presumed to apply to all firefighters (including volunteers) and to both men and women.","author_count":41,"contributors":["Demers, Paul A","DeMarini, David M","Fent, Kenneth W","Glass, Deborah C","Hansen, Johnni","Adetona, Olorunfemi","Andersen, Maria Helena Guerra","Freeman, Laura E Beane","Caban-Martinez, Alberto J","Daniels, Robert D","Driscoll, Timothy R","Goodrich, Jaclyn M","Graber, Judith M","Kirkham, Tracy L","Kjaerheim, Kristina","Kriebel, David","Long, Alexandra S","Main, Luana C","Oliveira, Marta","Peters, Susan","Teras, Lauren R","Watkins, Emily R","Burgess, Jefferey L","Stec, Anna A","White, Paul A","DeBono, Nathan L","Benbrahim-Tallaa, Lamia","de Conti, Aline","El Ghissassi, Fatiha","Grosse, Yann","Stayner, Leslie T","Suonio, Eero","Viegas, Susana","Wedekind, Roland","Boucheron, Pauline","Hosseini, Bayan","Kim, Joanne","Zahed, Hana","Mattock, Heidi","Madia, Federica","Schubauer-Berigan, Mary K"],"cuid":["S01-000.00-781733"],"filters":{"added":"2025-01","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Kemisk arbejdsmiljø","Kræft","Partikler"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-OT"],"level3":{"GV":["DI-GV-ALL","DI-GV-WORK"],"OT":["International Agency for Research on Cancer, Lyon, France."]},"level3all":["DI-GV-WORK"]},"review":"pr","rtype":["clu"],"sorti":"carcinogenicity of occupational exposure as a firefighter","src":["nfa"],"src-code":["DI-GV-WORK"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85135374109","version":"Other Version"},"id":"S01-000.00-781733","identifier":[{"id":"85135374109","type":"scopus"}],"ids":["nfa-c6c32c0d-bd83-4407-9eb1-4101084508ee"],"keyword":["Kemisk arbejdsmiljø","Kræft","Partikler"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-83711DA0C409EE65C06826CEAA0584F4"],"org":[{"affno":"1","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["International Agency for Research on Cancer, Lyon, France."],"nora_code":"DI-OT","used":1},{"affno":"2","key":"nfa national research centre for the working environment","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-WORK","l3nn":"NFA National Research Centre for the Working Environment","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"NFA National Research Centre for the Working Environment","namevar":["The National Research Centre for the Working Environment","The National Research Centre for the Working Environment, Directors, Chemical Working Environment, Toxicology, Nanosafety, a