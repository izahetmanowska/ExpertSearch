{"author_count":14,"contributors":["Sejbæk, CS","Kristensen, Petter","Schlünssen, V","Larsen, AD","Juhl, Mette","Andersen, Anne-Marie Nybo","Ramlau-Hansen, Cecilia Høst","Begtrup, Luise Moelenberg","Niclasen, Janni","Bay, H","Pedersen, Jacob","Mattsson, Kristina","Bonde, Jens Peter","Hougaard, Karin Sørig"],"cuid":["S01-000.00-781288"],"filters":{"added":"2025-01","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-WORK"],"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-GV-WORK","DI-HO-CAP","DI-U-AU"]},"review":"nr","rtype":["clu"],"sorti":"med mor på på job udgør samtidig psykisk og muskuloskeletal belastning en risiko for graviditet og barnets udvikling afslutningsrapport til arbejdsmiljøforskningsfonden","src":["nfa"],"src-code":["DI-GV-WORK"],"type":"dr","type-grp":["all","pub"]},"id":"S01-000.00-781288","ids":["nfa-99365319-7efc-4a52-86f8-74f82d75503e"],"lang":"Danish","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-04D79087E54A6C1C3E3780DB03BBB7A7"],"org":[{"affno":"1","key":"nfa national research centre for the working environment","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-WORK","l3nn":"NFA National Research Centre for the Working Environment","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"NFA National Research Centre for the Working Environment","namevar":["The National Research Centre for the Working Environment","The National Research Centre for the Working Environment, Directors, Chemical Working Environment, Toxicology, Nanosafety, and Microbiology"],"nora_code":"DI-GV-WORK","used":1},{"affno":"2","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Department of Public Health, Aarhus University, Aarhus, Denmark."],"nora_code":"DI-U-AU","used":1},{"affno":"3","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Department of Occupational and Environmental Medicine, Bispebjerg Hospital, Copenhagen, Denmark."],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","corresponding":null,"first":"CS","key":"sejbækpau","last":"Sejbæk","name":"Sejbæk, CS","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Petter","key":"kristensenpau","last":"Kristensen","name":"Kristensen, Petter","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"V","key":"schlünssenpau","last":"Schlünssen","name":"Schlünssen, V","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"AD","key":"larsenpau","last":"Larsen","locid":"fa03cd1b-31e4-483a-8ee1-09f917379e33","name":"Larsen, AD","orcid":"0000-0002-3587-2998","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Mette","key":"juhlpau","last":"Juhl","name":"Juhl, Mette","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Anne-Marie Nybo","key":"andersenpau","last":"Andersen","name":"Andersen, Anne-Marie Nybo","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Cecilia Høst","key":"ramlauhansenpau","last":"Ramlau-Hansen","name":"Ramlau-Hansen, Cecilia Høst","rank":7,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Luise Moelenberg","key":"begtruppau","last":"Begtrup","name":"Begtrup, Luise Moelenberg","rank":8,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Janni","key":"niclasenpau","last":"Niclasen","name":"Niclasen, Janni","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"H","key":"baypau","last":"Bay","name":"Bay, H","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"J","key":"pedersenpau","last":"Pedersen","locid":"956d0a9d-0803-4463-9101-ab76c601c2ac","name":"Pedersen, Jacob","name_org":"Pedersen, J","orcid":"0000-0003-4429-3485","rank":11,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Kristina","key":"mattssonpau","last":"Mattsson","name":"Mattsson, Kristina","rank":12,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jens Peter","key":"bondepau","last":"Bonde","name":"Bonde, Jens Peter","rank":13,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"KS","key":"hougaardpau","last":"Hougaard","locid":"9c2bf172-8f6e-4e8a-91cc-faa0ba95a5d3","name":"Hougaard, Karin Sørig","name_org":"Hougaard, KS","orcid":"0000-0002-3386-0512","rank":14,"rolecode":"pau"}],"pub":{"publisher":"Det Nationale Forskningscenter for Arbejdsmiljø","status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Governmental Institutions","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Universities"],"PST":["Published"]},"sid":["nfa-99365319-7efc-4a52-86f8-74f82d75503e"],"src":["NFA National Research Centre for the Working Environment"],"title":"Med mor på på job. Udgør samtidig psykisk og muskuloskeletal belastning en risiko for graviditet og barnets udvikling? Afslutningsrapport til Arbejdsmiljøforskningsfonden","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-781288","year":"2020","yearsub":"2020"}
{"abstract":"BACKGROUND: Asynchrony is a common problem in patients treated with noninvasive ventilation (NIV). Neurally adjusted ventilatory assist (NAVA) has shown to improve patient-ventilator interaction. However, it is unknown whether NIV-NAVA improves outcomes compared to noninvasive pressure support (NIV-PS). METHODS: This observational cohort study included patients 18 years or older receiving noninvasive ventilation using an oro-nasal face mask for more than 2 hours in a Danish ICU. The study included a NIV-NAVA cohort (year 2013-2015) and two comparison cohorts: 1) a historical NIV-PS cohort (year 2011-2012) before the implementation of NIV-NAVA at the ICU in 2013, and 2) a concurrent NIV-PS cohort (year 2013-2015). Outcomes of NIV-NAVA (intubation rate, duration of NIV and 90-day mortality) were assessed and compared using multivariable linear andlogistic regression adjusted for relevant confounders. RESULTS: The study included 427 patients (91 in the NIV-NAVA, 134 in the historic NIV-PS and 202 in the concurrent NIV-PS cohort). Patients treated with NIV-NAVA did not have improved outcome after adjustment for measured confounders. Actually, there were statistically imprecise higher odds for intubation in NIV-NAVA patients compared with both the historical [OR 1.48, CI (0.74-2.97)] and the concurrent NIV-PS cohort [OR 1.67, CI (0.87-3.19)]. NIV-NAVA might also have a longer length of NIV [63%, CI (19-125%)] and [139%, CI (80-213%)], and might have a higher 90-day mortality [OR 1.24, CI (0.69-2.25)] and [OR 1.39, CI (0.81-2.39)]. Residual confounding cannot be excluded. CONCLUSION: This present study found no improved clinical outcomes in patients treated with NIV-NAVA compared to NIV-PS.","author_count":4,"contributors":["Hansen, Kristina K","Jensen, Hanne I","Andersen, Torben S","Christiansen, Christian Fynbo"],"cuid":["S02-099.74-026073"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-HO-CDR","DI-HO-SDR","DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"intubation rate duration of noninvasive ventilation and mortality after noninvasive neurally adjusted ventilatory assist niv nava","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/155628837/ntubation_rate_duration_of_noninvasive_ventilation_and.pdf","version":"Authors Final Version"},"id":"S02-099.74-026073","identifier":[{"id":"85074750439","type":"scopus"},{"id":"31651041","type":"pmid"},{"id":"000494266400001","type":"wos"}],"ids":["au-b823a74e-86dd-4828-9943-173c42561250","sdu-fbae7def-cb97-40ab-80bd-22c7365d975f"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-487A56F9EF7896F2538D3BC3B026FF31"],"oa_link":[{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/155628837/ntubation_rate_duration_of_noninvasive_ventilation_and.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS - Lillebælt Hospital, Research Unit of Anaesthesiology (Vejle)"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"R