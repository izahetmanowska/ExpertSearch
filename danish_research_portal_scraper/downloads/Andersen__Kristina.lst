ssue":"1","journal":"Scientific Reports","paperid":"29962","publisher":"Nature Publishing Group","status":"p","title":"Scientific Reports","volume":"14"},"review":"Peer Reviewed","scoID":["2-s2.0-85211131287"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-5955f495-0218-4539-ad76-06779a95dab8","ku-59802a40-7048-4004-9b1a-22e19ce44cd4"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Differential tumor protein expression at follicular lymphoma diagnosis reveals dysregulation of key molecular pathways associated with histological transformation","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-098.95-804054","year":"2024","yearsub":"2024"}
{"abstract":"Research Summary: We contribute to theorizing global human resource strategy by analyzing the mobility of workers laid off due to the failure of a MNC employer. The job opportunities of laid-off workers are affected by their industry legitimacy. Focusing on scarce specialized workers, we propose that prospective MNC employers share an interest in retaining such workers' legitimacy. However, in the light of organizational failure, they may suffer from cross-border legitimacy loss conditioned by their former employer's MNC structure—specifically, their former organizational units or geographical locations. We present an illustrative case study of traders laid off by a spectacular bankruptcy in the global bunker industry. This inspires a discussion of how MNC top management can manipulate worker legitimacy following an organizational failure. Managerial Summary: Strategic hiring of globally mobile scarce specialized workers is central to global human resource strategy. We analyze what drives the legitimacy and mobility of such workers after being laid off by a bankruptcy of their former employer. We demonstrate that laid off workers experience comparatively high legitimacy loss when they were previously assigned to an MNC organizational unit or geographical location where other workers were suspected of being responsible for failure. This weakens their bargaining position vis-a-vis a prospective employer. We present an illustrative case study of traders laid off by a spectacular bankruptcy in the global bunker oil industry.","author_count":3,"contributors":["Andersen, Kristina","Lorenzen, Mark","Nowinska, Agnieszka"],"cuid":["S03-097.73-751521"],"filters":{"added":"2023-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":3,"corresponding_author":["Lorenzen, Mark"],"keyword":["Geographical location","Labor mobility","Legitimacy","MNC","Organizational failure"],"level":"sci","mra":["sci","soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-CBS","DI-U-DTU"]},"level3all":["DI-U-AAU","DI-U-CBS","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"scarce resources or damaged goods on the legitimacy of laid off workers following mnc failure","src":["aau","cbs","dtu"],"src-code":["DI-U-AAU","DI-U-CBS","DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1002/gsj.1497","version":"Published Version"},"id":"S03-097.73-751521","identifier":[{"id":"85174846568","type":"scopus"}],"ids":["aau-20aca457-20c6-40ab-8bcd-c8bcb9e7e7d6","cbs-cfb43564-762f-41c1-a348-a0d5bc03376b","dtu-13398329-ec50-4518-8d88-22924700117c"],"keyword":["MNC","geographical location","labor mobility","legitimacy","organizational failure"],"lang":"English","level":"Scientific","mra":["Science/Technology","Social Science"],"noi":["Global-Local-2-6-80A96A2553761E84340E740E9DFC9CC6"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/371444075/Global_Strategy_Journal_-_2023_-_Andersen_-_Scarce_resources_or_damaged_goods_On_the_legitimacy_of_laid_off_workers.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://research-api.cbs.dk/ws/files/98472065/kristina_vaarst_andersen_et_al_scarce_resources_or_damaged_goods_publishersversion.pdf","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/772660498/Global_Strategy_Journal_-_2023_-_Andersen_-_Scarce_resources_or_damaged_goods_On_the_legitimacy_of_laid_off_workers.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1002/gsj.1497","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l