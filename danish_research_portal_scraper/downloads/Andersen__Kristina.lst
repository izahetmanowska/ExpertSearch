rank":7,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Amy","key":"bartlettpau","last":"Bartlett","name":"Bartlett, Amy","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jane","key":"boldpau","last":"Bold","name":"Bold, Jane","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"John","key":"hutchisonpau","last":"Hutchison","name":"Hutchison, John","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jorge","key":"quirozpau","last":"Quiroz","name":"Quiroz, Jorge","rank":11,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Hatice","key":"tankisipau","last":"Tankisi","locid":"2b3f7bfd-71e0-4e1e-9a63-62cf6d26d1ea","name":"Tankisi, Hatice","rank":12,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Thomas Holm","key":"pedersenpau","last":"Pedersen","locid":"b8f7c218-f8c6-4542-84dd-4c133d336edd","name":"Pedersen, Thomas Holm","orcid":"0000-0002-1060-4989","rank":13,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Henning","key":"andersenpau","last":"Andersen","locid":"0ab9285b-0a62-4adf-a5d9-974e68d3b511","name":"Andersen, Henning","rank":14,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"William David","key":"arnoldpau","last":"Arnold","name":"Arnold, William David","rank":15,"rolecode":"pau"}],"pmid":["39670429"],"pub":{"doi":"10.1002/acn3.52252","issn":["23289503"],"issue":"2","journal":"Annals of Clinical and Translational Neurology","pages":"320-331","publisher":"John Wiley & Sons Inc.","status":"p","title":"Annals of Clinical and Translational Neurology","volume":"12"},"review":"Peer Reviewed","scoID":["2-s2.0-85213697524"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Other Companies","Private Research","Universities","nmd pharma a/s"],"PST":["Published"]},"sid":["au-7d59bae6-a496-47d2-923a-e5545bbd431b"],"src":["AU Aarhus University"],"title":"Neuromuscular transmission deficits in patients with CMT and ClC-1 inhibition in CMT animal models","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-796486","year":"2025","yearsub":"2025"}
{"abstract":"Point-of-care ultrasound (PoCUS) has found its way into primary care in some, but not all, European countries. A prerequisite for achieving Europe-wide comparable diagnostic reliability of PoCUS performed by primary care physicians is high-quality training that is limited to relevant, frequently encountered PoCUS applications that are easy to learn and master. A European Federation of Societies for Ultrasound in Medicine (EFSUMB) task force performed a brainstorming exercise to identify all possible ultrasound examinations that could be performed in primary care. A 3-stage Delphi process was launched. The Delphi panelists were 95 primary care physicians from 28 European countries with more than 2 years of experience using and teaching ultrasound. Solely focusing on the complexity of performing PoCUS, the panelists reduced the brainstorming list in a stepwise manner to a basic core curriculum intended for primary care frontline physicians including 40 diagnostic PoCUS examinations within 13 different anatomical areas and no ultrasound-guided procedures. A 75% cut-off was used for agreement. Despite the great heterogeneity of the Delphi panel representing different views and contexts from across Europe, kappa statistics showed substantial or moderate agreement across Delphi rounds 2 and 3 for 85% of the 40 diagnostic PoCUS applications. The results of this study offer guidance for EFSUMB to establish training recommendations for a basic core curriculum that can be adapted to the needs of different regions of Europe and thus create a basis for PoCUS to become a reliable diagnostic tool in primary care across Europe, based on common quality standards.","author_count":12,"contributors":["Andersen, Camilla Vaskjær Aakjær","Løkkegaard, Thomas","Nayahangan, Leizl Joy","Edwards, Hazel","Iacob, Mihai Sorin","Lebedevaite, Kristina","Kosiak, Mateusz","Gheorghe, Elena Codruta","Salim, Adib","Rüttermann, Viktor","Ewertsen, Caroline","Jenssen, Christian"],"cuid":["S01-000.00-823370"],"filters":{"added":"2025-10","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","OECD"],"country":["Germany","Italy","Lithuania","Poland","Romania","United Kingdom"],"glorg":["All Global Affiliations","British Medical Ultrasound Society","Craiova University of Medicine and Pharmacy","Medical Practice","Medical University Brandenburg","Papa Giovanni XXIII Hospital","Sonographic Educational Platform","Victor Babes University of Medicine and Pharmacy"],"keyword":["Curriculum","Family medicine","General practice","Point of care ultrasound","Primary healthcare"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-HO-CAP","DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"a core curriculum of point of care ultrasound examinations for frontline physicians in primary care results from a european delphi study","src":["aau"],"src-code":["DI-U-AAU"],"type":"djr","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.1055/a-2590-5242","version":"Published Version"},"id":"S01-000.00-823370","identifier":[{"id":"105008242076","type":"scopus"}],"ids":["aau-3b5fbb3e-de18-4e46-aa8c-0e1d2c312365"],"keyword":["Curriculum","Family Medicine","General Practice","Point-of-care Ultrasound","Primary Healthcare"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-E716C1120FD34EEDA234AB041A87F2F3"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.1055/a-2590-5242","version":"Published Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine, Center for General Practice at Aalborg University"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Rigshospitalet, Copenhagen University Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","country":"gb","key":"british medical ultrasound society","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"British Medical Ultrasound Society","used":1},{"affno":"4","country":"ro","key":"victor babes university of medicine and pharmacy","loc":["Romania","Europe, EU"],"name":"Victor Babes University of Medicine and Pharmacy","used":1},{"affno":"5","country":"lt","key":"medical practice","loc":["Lithuania","Europe, EU","OECD"],"name":"Medical Practice","used":1},{"affno":"6","country":"pl","key":"sonographic educational platform","loc":["Poland","Europe, EU","OECD"],"name":"Sonographic Educational Platform","used":1},{"affno":"7","country":"ro","key":"craiova university of medicine and pharmacy","loc":["Romania","Europe, EU"],"name":"Craiova University of Medicine and Pharmacy","used":1},{"affno":"8","country":"it","key":"papa giovanni xxiii hospital","loc":["Italy","Europe, EU","OECD"],"name":"Papa Giovanni XXIII Hospital","used":1},{"affno":"9","country":"de","key":"medical university brandenburg","loc":["Germany","Europe, EU","OECD"],"name":"Medical University Brandenburg","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Camilla Aakjr","key":"andersenpau","last":"Andersen","locid":"7fe4e7b3-746c-4755-b532-839957f0125b","name":"Andersen, Camilla Vaskjær Aakjær","name_org":"Andersen, Camilla Aakjr","orcid":"0000-0002-5933-748X","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Thomas","key":"løkkegaardpau","last":"Løkkegaard","locid":"2d7336df-b8a7-414b-a920-9d61eca85009","name":"Løkkegaard, Thomas","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Leizl Joy","key":"nayahanganpau","last":"Nayahangan","name":"Nayahangan, Leizl Joy","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Hazel","key":"edwardspau","last":"Edwards","name":"Edwards, Hazel","rank":4,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Mihai Sorin","key":"iacobpau","last":"Iacob","name":"Iacob, Mihai Sorin","rank":5,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Kristina","key":"lebedevaitepau","last":"Lebedevaite","name":"Lebedevaite, Kristina","rank":6,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Mateusz","key":"kosiakpau","last":"Kosiak","name":"Kosiak, Mateusz","rank":7,"rolecode":"pau"},{"affno":"7","corresponding":null,"first":"Elena Codruta","key":"gheorghepau","last":"Gheorghe","name":"Gheorghe, Elena Codruta","rank":8,"rolecode":"pau"},{"affno":"8","corresponding":null,"first":"Adib","key":"salimpau","last":"Salim","name":"Salim, Adib","rank":9,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Viktor","key":"rüttermannpau","last":"Rüttermann","name":"Rüttermann, Viktor","rank":10,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Caroline","key":"ewertsenpau","last":"Ewertsen","name":"Ewertsen, Caroline","rank":11,"rolecode":"pau"},{"affno":"9","corresponding":null,"first":"Christian","key":"jenssenpau","last":"Jenssen","name":"Jenssen, Christian","rank":12,"rolecode":"pau"}],"pub":{"doi":"10.1055/a-2590-5242","issn":["01724614","14388782"],"issn_org":["01724614"],"journal":"Ultraschall in der Medizin","publisher":"Georg Thieme Verlag","status":"e","title":"Ultraschall in der Medizin"},"review":"Peer Reviewed","scoID":["2-s2.0-105008242076"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities"],"PST":["E-Published (ahead of print)"]},"sid":["aau-3b5fbb3e-de18-4e46-aa8c-0e1d2c312365"],"src":["AAU Aalborg University"],"title":"A core curriculum of point-of-care ultrasound examinations for frontline physicians in primary care : Results from a European Delphi study","type":"Journal Review","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-823370","year":"2025","yearsub":"2025"}
{"abstract":"BACKGROUND/OBJECTIVES: Higher body mass index (BMI) is strongly associated with cardiovascular metabolic diseases, however, BMI changes across the lifespan may be complex and non-linear. Furthermore, heterogeneous BMI trajectories may exhibit different cardiometabolic traits. We aimed to identify BMI trajectories over up to 50 years and examine their associations with cardiometabolic biomarkers. SUBJECTS/METHODS: In total, 30,581 participants from the Danish Diet, Cancer and Health - Next Generations cohort were included in the study. Participants recalled their weight history for each decade through questionnaires. Weight and height were measured, and blood samples were collected during a clinic visit. Cardiometabolic biomarkers (Hemoglobin A1c, total cholesterol, triglycerides, high-density lipoprotein, low-density lipoprotein, C-reactive Protein, and creatinine) were determined. Latent class growth models were applied to model BMI trajectories from age 20 until the current age. The optimal number of groups was selected according to Bayesian Information Criteria, the integrated completed likelihood, and the mean posterior probability of each group. Linear and logistic regression models were used to examine the association between distinct BMI trajectories and cardiovascular biomarkers, with adjustment for age, sex, and smoking status. RESULTS: Four distinct BMI trajectories were identified: \"Stable low BMI\" group (32%, n = 9753), \"Gradual BMI increase\" (45%, n = 13,780), \"Early high BMI\" group (3%, n = 771), and \"Steeper BMI increase\" group (21%, n = 6277). Compared to the \"Stable low BMI\" group, all other trajectory groups showed significant associations with adverse cardiometabolic biomarkers. For instance, the \"Steeper BMI increase\" group was associated with elevated triglycerides (β = 0.36 mmol/L, 95% CI: 0.34, 0.38), followed by the \"Early high BMI\" group (β = 0.30 mmol/L, 95% CI: 0.26, 0.34) and the \"Gradual BMI increase\" group (β = 0.12 mmol/L, 95% CI: 0.11, 0.13). CONCLUSION: Both those with constant high BMI and steeply increased BMI trajectories from age 20 had more unfavorable cardiometabolic profiles compared to those maintaining lower BMI throughout adulthood.","author_count":9,"contributors":["Zhang, Jie","Andersen, Christina","Olsen, Anja","Halkjær, Jytte","Petersen, Kristina Elin","Schaarup, Jonas Frey Rosborg","Antoniussen, Christian S","Witte, Daniel R","Dahm, Christina C"],"cuid":["S01-000.00-826068"],"filters":{"added":"2025-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-NP","DI-U"],"level3":{"NP":["DI-NP-ALL","DI-NP-CAN"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-NP-CAN","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"life long body mass index trajectories and cardiometabolic biomarkers the danish diet cancer and health next generations cohort","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-826068","identifier":[{"id":"40847072","type":"pmid"}],"ids":["au-aabe8a70-a9ae-47c2-aa40-d59dc369a673"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-2-ED3F347E47B5224B7FAFB35F28843AA5"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University","Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - SDCA-Steno Diabetes Center Aarhus","Aarhus University, Technical Sciences, Department of Agroecology, Department of Agroecology - Soil Fertility"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"dcrc danish cancer society research center","l2":"DI-NP","l2n":"Non-Profit Organisations","l3":"DI-NP-CAN","l3nn":"DCRC Danish Cancer Society Research Center","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DCRC Danish Cancer Society Research Center","namevar":["Danish Cancer Society"],"nora_code":"DI-NP-CAN","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jie","key":"zhangpau","last":"Zhang","locid":"7bcc36dc-2bbc-445c-88fc-6f925cf6db06","name":"Zhang, Jie","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christina","key":"andersenpau","last":"Andersen","locid":"ff1601f0-a561-4612-85e6-82e6cad7cdfc","name":"Andersen, Christina","rank":2,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Anja","key":"olsenpau","last":"Olsen","locid":"b6599ea6-5ae6-45eb-8540-12be04efbf60","name":"Olsen, Anja","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jytte","key":"halkjærpau","last":"Halkjær","name":"Halkjær, Jytte","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Kristina Elin","key":"petersenpau","last":"Petersen","name":"Petersen, Kristina Elin","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jonas Frey Rosborg","key":"schaaruppau","last":"Schaarup","locid":"cb703df4-10c0-41fe-95c7-273fa5f1e360","name":"Schaarup, Jonas Frey Rosborg","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Christian S","key":"antoniussenpau","last":"Antoniussen","locid":"4c3ebbcd-c14a-4329-8cfe-4727eb66e527","name":"Antoniussen, Christian S","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Daniel R","key":"wittepau","last":"Witte","locid":"22db1993-176e-491b-833f-69a3d2d02b47","name":"Witte, Daniel R","orcid":"0000-0002-0769-2922","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Christina C","key":"dahmpau","last":"Dahm","locid":"99090c31-2a55-406a-a3a0-fe4e9c7ab98b","name":"Dahm, Christina C","orcid":"0000-0003-0481-2893","rank":9,"rolecode":"pau"}],"pmid":["40847072"],"pub":{"doi":"10.1038/s41366-025-01882-7","issn":["03070565","14765497"],"issn_org":["03070565"],"journal":"International Journal of Obesity","publisher":"Springer Nature","status":"e","title":"International Journal of Obesity","title_org":"International journal of obesity (2005)"},"review":"Peer Reviewed","scoID":["2-s2.0-105013761845"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Non-Profit Organisations","All Universities","DI-ALL","DI-NP","DI-NP-ALL","DI-U","DI-U-ALL","Non-Profit Organisations","Universities"],"PST":["E-Published (ahead of print)"]},"sid":["au-aabe8a70-a9ae-47c2-aa40-d59dc369a673"],"src":["AU Aarhus University"],"title":"Life-long body mass index trajectories and cardiometabolic biomarkers-the Danish diet, cancer, and health-next generations cohort","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-826068","year":"2025","yearsub":"2025"}
{"abstract":"The biology of tumor spread to bone is poorly understood, not least in classic Hodgkin lymphoma (cHL). We used gene expression profiling and immunohistochemistry to characterize the nodal tumor microenvironment of cHL cases with and without skeletal involvement at diagnosis. Gene expression profiling of 66 pretreatment lymphoma samples revealed that lymph nodes from patients with skeletal cHL (s-cHL) exhibited a higher abundance of cells expressing macrophage markers, particularly M2-like markers, than nodal-only cHL (n-cHL). These markers included CD163, MRC1 (CD206), MARCO, and SIGLEC1. Additionally, there was a notable downregulation of genes encoding B-cell-associated markers such as MS4A1 (CD20), CD19, PAX5, and CD79A/B. We further evaluated the protein expression of macrophage markers (CD68, CD163, and CD206) and the B-cell marker CD20 in 193 pretreatment lymphoma samples using immunohistochemistry. Our analysis revealed significantly higher expression levels of all three macrophage markers in s-cHL samples compared to n-cHL samples (p < 0.001). Conversely, the expression level of CD20 was significantly lower in s-cHL compared with n-cHL (p < 0.001). All three macrophage markers correlated positively with Ann Arbor stage, indicating their potential involvement in the dissemination of cHL in general. Our findings suggest a potential role for tumor-associated macrophages in the dissemination of cHL to bone.","author_count":11,"contributors":["Andersen, Maja Dam","Wolter, Katharina","Enemark, Marie Hairing","Pedersen, Mette Abildgaard","Gormsen, Lars Christian","Lauridsen, Kristina Lystlund","Starklint, Jørn","Hamilton-Dutoit, Stephen Jacques","D'Amore, Francesco Annibale","Ludvigsen, Maja","Kamper, Peter"],"cuid":["S01-000.00-826657"],"filters":{"added":"2025-10","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"corresponding_author":["Andersen, Maja Dam"],"keyword":["Bone","CD163","CD206","CD68","Gene expression","Microenvironment","classic Hodgkin lymphoma cHL"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"tumor associated macrophages potential role in skeletal involvement in classic hodgkin lymphoma","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1002/2056-4538.70038","version":"Published Version"},"id":"S01-000.00-826657","identifier":[{"id":"PMC12288371","type":"pmcid"},{"id":"40704910","type":"pmid"},{"id":"105012317553","type":"scopus"}],"ids":["au-e4f02e01-42cb-44de-bbb8-3e7035bbbc47"],"keyword":["CD163","CD206","CD68","bone","classic Hodgkin lymphoma (cHL)","gene expression","microenvironment"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-E3D1B62F37C1E8AF8BB3791C79C5EC20"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1002/2056-4538.70038","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Haematology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Maja Dam","key":"andersenpau","last":"Andersen","locid":"23ba761f-55f2-41a8-80be-5b028946efbd","name":"Andersen, Maja Dam","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Katharina","key":"wolterpau","last":"Wolter","locid":"acdee6f6-f5d7-4066-ac97-1c0579b13b96","name":"Wolter, Katharina","orcid":"0009-0000-2454-1133","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Marie Hairing","key":"enemarkpau","last":"Enemark","name":"Enemark, Marie Hairing","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mette Abildgaard","key":"pedersenpau","last":"Pedersen","locid":"0e013b4b-82ac-4496-bc2f-32007103699e","name":"Pedersen, Mette Abildgaard","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars Christian","key":"gormsenpau","last":"Gormsen","locid":"a360c42f-861a-40d6-9d23-64b560b33190","name":"Gormsen, Lars Christian","orcid":"0000-0002-0144-1305","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kristina Lystlund","key":"lauridsenpau","last":"Lauridsen","locid":"8f422b25-045f-4f98-be11-9ce47094c03b","name":"Lauridsen, Kristina Lystlund","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jørn","key":"starklintpau","last":"Starklint","locid":"b406ef9b-2f7f-436b-8871-7800fa64da5e","name":"Starklint, Jørn","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Stephen Jacques","key":"hamiltondutoitpau","last":"Hamilton-Dutoit","locid":"9b291bda-53d8-40c3-a0f6-564aefbe8300","name":"Hamilton-Dutoit, Stephen Jacques","orcid":"0000-0003-2158-3885","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Francesco","key":"damorepau","last":"d'Amore","locid":"6058829c-2b14-40ba-8a01-44b2a132fceb","name":"D'Amore, Francesco Annibale","name_org":"d'Amore, Francesco","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Maja","key":"ludvigsenpau","last":"Ludvigsen","locid":"7819594e-a380-4bec-a5d1-1724d5b18f1c","name":"Ludvigsen, Maja","orcid":"0000-0001-5089-3271","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Peter","key":"kamperpau","last":"Kamper","locid":"6bace349-b488-4958-b6aa-d0463054cd3c","name":"Kamper, Peter","rank":11,"rolecode":"pau"}],"pmid":["40704910"],"pub":{"doi":"10.1002/2056-4538.70038","issn":["20564538"],"issue":"4","journal":"Journal of Pathology: Clinical Research","paperid":"e70038","publisher":"Wiley-Blackwell Publishing Ltd","status":"p","title":"Journal of Pathology: Clinical Research","volume":"11"},"review":"Peer Reviewed","scoID":["2-s2.0-105012317553"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-e4f02e01-42cb-44de-bbb8-3e7035bbbc47"],"src":["AU Aarhus University"],"title":"Tumor-associated macrophages : potential role in skeletal involvement in classic Hodgkin lymphoma","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-826657","year":"2025","yearsub":"2025"}
{"abstract":"IMPORTANCE: Current evidence of the association between prenatal exposure to glucocorticoids and long-term mental disorders is scarce and has limitations. OBJECTIVE: To investigate the association between prenatal exposure to systemic glucocorticoids and mental disorders in offspring at the age of 15 years, comparing exposed vs unexposed offspring born to mothers with the same underlying disease (risk of preterm delivery and autoimmune or inflammatory disorders). DESIGN, SETTING, AND PARTICIPANTS: This nationwide population-based cohort study used data from registries in Denmark with follow-up until December 31, 2018. Participants included all Danish infants born alive from 1996 to 2016. Analyses were performed from January to December 2023. EXPOSURES: Prenatal exposure to systemic glucocorticoids. MAIN OUTCOMES AND MEASURES: Fifteen-year crude and adjusted risks, risk differences, and risk ratios (RR) for mental disorders using Kaplan-Meier estimator comparing exposed vs unexposed offspring born to mothers with the same underlying disease. RESULTS: A total of 1 061 548 infants (52% male) were included in the final study cohort, including 31 518 born to mothers at risk of preterm delivery and 288 747 born to mothers with autoimmune or inflammatory disorders. Among offspring born to mothers at risk of preterm delivery, the adjusted risks for exposed vs unexposed were 6.6% vs 4.3% (RR, 1.5 [95% CI, 1.2-1.9]) for autism spectrum disorders; 1.6% vs 1.3% (RR, 1.3 [95% CI, 0.8-1.8]) for intellectual disabilities; 5.8% vs 4.3% (RR, 1.3 [95% CI, 1.0-1.7]) for attention-deficit hyperactivity disorder (ADHD); and 7.2% vs 4.6% (RR, 1.5 [95% CI, 1.1-2.0]) for mood, anxiety, and stress-related disorders. Among offspring born to mothers with autoimmune or inflammatory disorders, the adjusted risks for exposed vs unexposed were 4.8% vs 3.8% (RR, 1.3 [95% CI, 1.1-1.5]) for autism spectrum disorders; 1.1% vs 0.8% (RR 1.4, [95% CI, 0.9-2.0]) for intellectual disabilities; 5.5% vs 4.4% (RR, 1.3 [95% CI, 1.0-1.5]) for ADHD; and 6.6% vs 4.6% (RR, 1.4 [95% CI, 1.2-1.8]) for mood, anxiety, and stress-related disorders. Findings were confirmed through an active comparator and sibling design. However, confounding by disease severity could not be ruled out. CONCLUSIONS AND RELEVANCE: In this cohort study, prenatal exposure to glucocorticoids was associated with higher risk of some mental disorders. These data support continued caution in the use of glucocorticoids in pregnant people.","author_count":10,"contributors":["Laugesen, Kristina","Skajaa, Nils","Petersen, Irene","Skovsager Andersen, Marianne","Feldt-Rasmussen, Ulla","Kejlberg Al-Mashhadi, Sofie","Stewart, Paul","Jørgensen, Jens Otto Lunde","Sørensen, Henrik Toft"],"cuid":["S03-099.44-793220"],"filters":{"added":"2025-02","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":3,"continent":["Europe, Non-EU","OECD"],"corresponding_author":["Laugesen, Kristina"],"country":["United Kingdom"],"glorg":["All Global Affiliations","University College London","University of Leeds"],"keyword":["Adolescent","Adult","Autoimmune Diseases epidemiology","Cohort Studies","Denmark epidemiology","Female","Glucocorticoids adverse effects","Humans","Infant Newborn","Male","Mental Disorders epidemiology","Pregnancy","Premature Birth epidemiology","Prenatal Exposure Delayed Effects epidemiology","Registries"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"mental disorders among offspring prenatally exposed to systemic glucocorticoids","src":["au","ku","sdu"],"src-code":["DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1001/jamanetworkopen.2024.53245","version":"Published Version"},"id":"S03-099.44-793220","identifier":[{"id":"39752154","type":"pmid"},{"id":"PMC11699534","type":"pmcid"},{"id":"85214482512","type":"scopus"}],"ids":["au-3f8c885b-eeb4-46bf-be1c-2af431ff9a4f","ku-46c8bd43-4760-46a1-abc6-f323ebcba6dd","sdu-37d54af6-35f9-4032-9763-a24f3d3f2ec7"],"keyword":["Adolescent","Adult","Autoimmune Diseases/epidemiology","Cohort Studies","Denmark/epidemiology","Female","Glucocorticoids/adverse effects","Humans","Infant, Newborn","Male","Mental Disorders/epidemiology","Pregnancy","Premature Birth/epidemiology","Prenatal Exposure Delayed Effects/epidemiology","Registries"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-30308BA885E3C620BC058A84BAF3D887"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/282076527/laugesen_2025_oi_241484_1734643272.38515.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/419205249/laugesen_2025_oi_241484_1734643272.38515.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1001/jamanetworkopen.2024.53245","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Clinical Epidemiology","Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of clinical biochemistry"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1},{"affno":"3","country":"gb","key":"university college london","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University College London","used":1},{"affno":"4","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Endocrinology (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"5","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Internal Medicine: Endocrinology"],"nora_code":"DI-U-KU","used":1},{"affno":"6","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"7","country":"gb","key":"university of leeds","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Leeds","used":1}],"person":[{"affno":"1 2","corresponding":null,"country":"dk","first":"Kristina","key":