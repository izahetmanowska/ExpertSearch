id":["39931998"],"pub":{"doi":"10.1093/jpids/piae125","issn":["20487207"],"issn_org":["20487193"],"issue":"2","journal":"Journal of the Pediatric Infectious Diseases Society","paperid":"piae125","publisher":"Oxford University Press","status":"p","title":"Journal of the Pediatric Infectious Diseases Society","volume":"14"},"review":"Peer Reviewed","scoID":["2-s2.0-85217757614"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Governmental Institutions","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","North Denmark Region","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-3be1241d-f1fe-405b-9b5b-b203b122bc3f","au-f16349fc-b2b2-49bd-9220-c38d856cb426","ku-e8a3d2f8-b2a2-4a9a-a72f-ccf593cd6b85","sdu-574d5585-5db3-46ab-9d0b-df2548ab07f5"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Neurological Disorders and Use of Healthcare Services After Enteroviral Meningitis in Childhood: A Nationwide, Population-Based Cohort Study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-095.00-792838","year":"2025","yearsub":"2025"}
{"abstract":"Classic Hodgkin lymphoma (CHL) is a highly curable disease, even in advanced stages. Controversy remains over whether bone involvement negatively affects overall and progression-free survival in patients treated with intensive chemotherapy regimens. Whether cases that present with bone lesions harbor specific tumor microenvironmental features is unknown. We investigated protein expression in diagnostic lymph node biopsies from CHL patients with and without skeletal involvement at diagnosis to identify potential markers of skeletal disease. Protein expression patterns in diagnostic formalin-fixed paraffin-embedded lymphoma lymph node samples from CHL patients were analyzed by nano-liquid chromatography-tandem mass spectrometry. Patients were grouped according to skeletal involvement, which was defined as the presence of one or more FDG-avid lesions on a diagnostic FDG-PET/CT scan. Protein profiles identified patients with skeletal disease at diagnosis and showed disrupted cellular pathways, including immune system processes, cell adhesion, and cell growth/survival. Immunohistochemical evaluation also demonstrated differential expressions of angiotensin-converting enzyme (ACE), intercellular adhesion molecule 3 (ICAM3), integrin alpha-X (ITGAX), and calreticulin (CALR). In conclusion, proteomics identified altered protein expression profiles in lymph nodes among CHL cases presenting with disease disseminated to the skeletal system, which implies altered disease pathogenesis for these patients.","author_count":12,"contributors":["Andersen, Maja Irene Dam","Wolter, Katharina","Enemark, Marie Beck","Pedersen, Mette Abildgaard","Gormsen, Lars Christian","Lauridsen, Kristina Lystlund","Starklint, Jørn","Hamilton-Dutoit, Stephen Jacques","D'Amore, Francesco Annibale","Ludvigsen, Maja","Honoré, Bent","Kamper, Peter"],"cuid":["S01-000.00-796473"],"filters":{"added":"2025-04","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"corresponding_author":["Andersen, Maja Irene Dam","Honoré, Bent"],"keyword":["Adult","Aged","Biomarkers Tumor metabolism","Bone","Bone Neoplasms diagnosis","Female","Hodgkin Disease diagnosis","Humans","Lymph Nodes pathology","Male","Middle Aged","Positron Emission Tomography Computed Tomography","Prognosis","Proteome","Proteomics","Proteomics methods","classic Hodgkin lymphoma cHL","nLC MS MS"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"proteomic profiling of lymph nodes differentiates classic hodgkin lymphoma with and without skeletal involvement","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1111/ejh.14326","version":"Published Version"},"id":"S01-000.00-796473","identifier":[{"id":"39394762","type":"pmid"},{"id":"PMC11613579","type":"pmcid"},{"id":"85206086991","type":"scopus"}],"ids":["au-7b7dcf89-f4c5-48bc-a0c2-2b2cba276800"],"keyword":["Adult","Aged","Biomarkers, Tumor/metabolism","Bone Neoplasms/diagnosis","Female","Hodgkin Disease/diagnosis","Humans","Lymph Nodes/pathology","Male","Middle Aged","Positron Emission Tomography Computed Tomography","Prognosis","Proteome","Proteomics/methods","bone","classic Hodgkin lymphoma (CHL)","nLC-MS/MS","proteomics"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-BA434FF7A1BFB8331195689316CBB6C7"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1111/ejh.14326","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://pure.au.dk/ws/files/434179323/European_J_of_Haematology_-_2024_-_Andersen_-_Proteomic_Profiling_of_Lymph_Nodes_Differentiates_Classic_Hodgkin_Lymphoma.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"au a