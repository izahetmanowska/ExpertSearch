l3nl":"Region Zealand","l3nn":"Region Zealand","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region Zealand","namevar":["Zealand University hospital"],"nora_code":"DI-HO-ZEA","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Maja","key":"halgrenolsenmajapau","last":"Halgren Olsen","name":"Halgren Olsen, Maja","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Thomas","key":"maltesenthomaspau","last":"Maltesen","name":"Maltesen, Thomas","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Pernille","key":"lassenpernillepau","last":"Lassen","name":"Lassen, Pernille","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Trille Kristina","key":"kjaertrillekristinapau","last":"Kjaer","name":"Kjaer, Trille Kristina","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jørgen","key":"johansenjørgenpau","last":"Johansen","name":"Johansen, Jørgen","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hanne","key":"primdahlhannepau","last":"Primdahl","name":"Primdahl, Hanne","rank":6,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Elo","key":"andersenelopau","last":"Andersen","name":"Andersen, Elo","rank":7,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Claus Andrup","key":"kristensenclausandruppau","last":"Kristensen","name":"Kristensen, Claus Andrup","rank":8,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Maria","key":"andersenmariapau","last":"Andersen","locid":"6da3e480-13a0-4b96-9c64-d739bd7ba6fe","name":"Andersen, Maria","rank":9,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Mohammed","key":"farhadimohammedpau","last":"Farhadi","name":"Farhadi, Mohammed","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jens","key":"overgaardjenspau","last":"Overgaard","name":"Overgaard, Jens","rank":11,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Susanne Oksbjerg","key":"daltonsusanneok