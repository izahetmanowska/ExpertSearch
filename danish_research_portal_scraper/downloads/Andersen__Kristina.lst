-HO-CAP","DI-U-KU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"clinical progression disease severity and mortality among adults hospitalized with covid 000000000019 caused by the omicron and delta sars cov 000000000002 variants a population based matched cohort study","src":["ku","ruc"],"src-code":["DI-U-KU","DI-U-RUC"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1371/journal.pone.0282806","version":"Published Version"},"id":"S02-086.58-742420","identifier":[{"id":"PMC10138229","type":"pmcid"},{"id":"37104488","type":"pmid"},{"id":"85158948700","type":"scopus"}],"ids":["ku-f15c5a11-3719-4dc4-9e54-6e1892aab635","ruc-a8ced22d-908a-46c8-adff-f814792d3054"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-4-FCD31B13C89B559BFBD6ABDEA9FD949C"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/359238893/journal.pone.0282806_1_.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1371/journal.pone.0282806","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/97415831/journal.pone.0282806.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of Science and Environment"],"nora_code":"DI-U-RUC","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital – North Zeala