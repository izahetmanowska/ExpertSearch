Publications Ltd","status":"p","title":"International Journal of Stroke","volume":"8"},"review":"Peer Reviewed","scoID":["2-s2.0-84872780688"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-95faeb8f-f792-48b9-bd22-3c54bd7fa78b"],"src":["AU Aarhus University"],"title":"Remote ischemic perconditioning in thrombolysed stroke patients : Randomized study of activating endogenous neuroprotection - design and MRI measurements","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-214797","year":"2013","yearsub":"2013"}
