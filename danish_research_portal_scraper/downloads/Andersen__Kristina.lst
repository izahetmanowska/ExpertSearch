istina Anne","name_org":"Vinter, Christina A","orcid":"0000-0001-5084-6053","rank":5,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"first":"Lise Lotte T","key":"andersenpau","last":"Andersen","locid":"d279b6e3-7642-448b-ba80-e0dedae472e7","name":"Andersen, Lise Lotte Torvin","name_org":"Andersen, Lise Lotte T","orcid":"0000-0003-2997-2228","rank":6,"rolecode":"pau"},{"affno":"6 7","first":"Kristina","key":"renaultpau","last":"Renault","locid":"9c92ad6e-d7c6-4443-8342-4364914f6ada","name":"Renault, Kristina M.","name_org":"Renault, Kristina","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Dorte M","key":"jensenpau","last":"Jensen","locid":"a221b393-70f9-4f53-902e-63d1a13f8f60","name":"Jensen, Dorte Møller","name_org":"Jensen, Dorte M","orcid":"0000-0002-3298-9824","rank":8,"rolecode":"pau"}],"pmid":["35332397"],"pub":{"doi":"10.1007/s11695-022-06021-z","issn":["09608923","17080428"],"issn_org":["09608923"],"issue":"6","journal":"Obesity Surgery","pages":"2047-2055","publisher":"Springer","status":"p","title":"Obesity Surgery","volume":"32"},"review":"Peer Reviewed","scoID":["2-s2.0-85127616921"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Other Hospitals","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark","danish diabetes academy"],"PST":["Published"]},"sid":["au-804a8b16-6431-4133-bc6b-ccbfa9ab6629","ku-71dd7d84-5d41-429c-ae74-0947083a5d57","sdu-115ca9c4-2cec-464b-a00d-f512d96d093c"],"src":["AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Hypoglycemia in Pregnancies Following Gastric Bypass—a Systematic Review and Meta-analysis","type":"Journal Review","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-095.63-022026","year":"2022","yearsub":"2022"}
{"abstract":"Technological advances have made it possible to offer home-based chemotherapy to patients without health care professionals being present. Prior studies on effects of home-based treatment lack inclusion of patients with hematologic malignancies. We present data from a multicenter single-arm feasibility and safety study of home-based intensive chemotherapy in patients with newly diagnosed acute myeloid leukemia and their quality of life and psychological wellbeing. This national study included patients from six sites in Denmark who received intensive chemotherapy on programmed CADD Solis infusion pumps through a central venous catheter and were also managed as outpatients during treatment-induced pancytopenia. Data are presented from 104 patients, receiving 272 treatments with 1.096 (mean 4.57, SD 3.0) home infusion days out of 1.644 treatment days (67 %). Sixty-two of 168 (36.9 %) reinduction and consolidation treatment cycles ensuing pancytopenia phases were solely handled in the outpatient clinic. Patients reported high satisfaction with home-based treatment, which had a positive influence on their ability to be involved in their treatment and be socially and physically active. No unexpected events occurred during the intervention. Overall, patients improved in all quality of life outcomes over time. Home-based intensive chemotherapy treatment was feasible and safe in this population. ClinicalTrials.gov identifier: NCT04904211.","author_count":27,"contributors":["Nørskov, Kristina Holmegaard","Fridthjof, Katrine","Kampmann, Peter","Dünweber, Anne","Andersen, Christen Lykkegaard","Renaberg, Toni","Schöllkopf, Claudia","Ahmad, Syed Azhar","Schou, Katrine","Jensen, Cecilie Fremming","Møller, Peter","Lundholm, Birgitte Wolf","Marcher, Claus","Jepsen, Lene","Ørntoft, Anne Katrine","Ommen, Hans Beier","Andersen, Lotte","Behrentzs, Anni","Hasselgren, Connie Fruergaard","Severinsen, Marianne Tang","Grand, Mia Klinten","Jarden, Mary","Møller, Tom","Kjeldsen, Lars"],"cuid":["S04-100.00-000401"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"corresponding_author":["Nørskov, Kristina Holmegaard"],"keyword":["Acute myeloid leukemia","Feasibility","Home based","Intensive chemotherapy","Outpatient","Safety"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-PR","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA"],"OT":["Unspecified organisation"],"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA","DI-PR-OTH","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"a national danish proof of concept on feasibility and safety of home based intensive chemotherapy in patients with acute myeloid leukemia","src":["aau","au","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85119927292","version":"Other Version"},"id":"S04-100.00-000401","identifier":[{"id":"34839055","type":"pmid"},{"id":"85119927292","type":"scopus"}],"ids":["aau-07b726a9-eb3e-4b8e-b390-ac3ad5e5e58a","au-7cf2aa30-bd72-4fda-9086-555000a2e42a","ku-faf34ca0-4e5a-4825-b3e3-06a538079063","sdu-140197b3-1f85-45fb-8e17-8c0331c79f57"],"keyword":["Acute myeloid leukemia","Feasibility","Home-based","Intensive chemotherapy","Outpatient","Safety"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-7-B81420A5D143A27AEE78B1632603E070"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Ca