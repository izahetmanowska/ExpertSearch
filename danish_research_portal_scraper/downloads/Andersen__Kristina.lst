of Southern Denmark (SDU)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Frans Ørsted","key":"andersenpau","last":"Andersen","locid":"c6f5831e-9598-4a44-b703-d72c66f03b46","name":"Andersen, Frans Ørsted","orcid":"0000-0002-6593-5291","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Kristina","key":"aaltonenpau","last":"Aaltonen","name":"Aaltonen, Kristina","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Thea","key":"traunpau","last":"Traun","name":"Traun, Thea","rank":3,"rolecode":"pau"}],"pub":{"issn":["09066225"],"issue":"99","journal":"Kognition & Paedagogik","pages":"2-8","paperid":"1","publisher":"Dansk Psykologisk Forlag","status":"p","title":"Kognition & Paedagogik","title_org":"Kognition & Pædagogik","volume":"26"},"review":"Undetermined","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["au-a58b2557-44e0-4bc3-904d-67e0aeb7760f"],"src":["AU Aarhus University"],"title":"Introduktion til Kognition og pædagogik nr. 99","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-223684","year":"2016","yearsub":"2016"}
{"abstract":"This paper provides laboratory test results of static axially loaded piles in sand. With a newly developed test setup, the pile-soil interface friction was investigated by using an open-ended steel pile segment with a diameter of 0.5 m. Use of a pile length of 1 m enabled the pile-soil interface friction to be analyzed at a given soil horizon while increasing the vertical effective stress in the sand. Test results obtained by this approach can be analyzed as single t-z curves and compared to predictions of unit shaft friction from current design methods for offshore foundations. The test results showed best agreement with the traditional design method given in the American Petroleum Institute (API) design code. When t-z curves obtained from the test results were compared to t-z curve formulations found in the literature, the Zhang formulation gave good predictions of the initial and post-peak parts of the t-z curves found in the test results.","author_count":3,"contributors":["Thomassen, Kristina","Andersen, Lars Vabbersgaard","Ibsen, Lars Bo"],"cuid":["S01-000.00-083457"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Axially loaded","Pile segments","Sand","Static tension","Tests"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"nr","rtype":["clu"],"sorti":"static tension tests on axially loaded pile segments in sand","src":["aau"],"src-code":["DI-U-AAU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/237194124/Static_Tension_Tests_on_Axially_Loaded_Pile_Segments_in_Sand.pdf","version":"Published Version"},"id":"S01-000.00-083457","ids":["aau-72e349fd-f55f-46e2-9969-b71a66390d94"],"keyword":["Axially loaded","Pile segments","Sand","Static tension","Tests"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-066093C27FF22004EBE04191D2CAD8CB"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/237194124/Static_Tension_Tests_on_Axially_Loaded_Pile_Segments_in_Sand.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (ENG)","Aalborg University, The Faculty of Engineering and Science, Department of Civil Engineering","Aalborg University, The Faculty of Engineering and Science, Department of Civil Engineering, Division for Structures, Materials and Geotechnics (CIVIL)","Aalborg University, The Faculty of Engineering and Science, Department of the Built Environment, Geotechnical Engineering and Offshore Foundations Research Group"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Kristina","key":"thomassenpau","last":"Thomassen","locid":"bb25541c-bdb3-484d-bca5-cb940de369db","name":"Thomassen, Kristina","orcid":"0000-0001-8982-5532","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars Vabbersgaard","key":"andersenpau","last":"Andersen","locid":"570293f5-d48d-46dc-b8d2-b2cc1925cab7","name":"Andersen, Lars Vabbersgaard","orcid":"0000-0003-0543-2892","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars Bo","key":"ibsenpau","last":"Ibsen","locid":"23b734a4-b2f7-44cd-ba17-e812ddc3640c","name":"Ibsen, Lars Bo","orcid":"0000-0002-1304-6660","rank":3,"rolecode":"pau"}],"pub":{"issn":["1901726X"],"issue":"206","pages":"26","place":"Aalborg","publisher":"Department of Civil Engineering, Aalborg University","repno":"DCE Technical reports, No. 206","series":"DCE Technical reports","status":"p"},"review":"No Review","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-72e349fd-f55f-46e2-9969-b71a66390d94"],"src":["AAU Aalborg University"],"title":"Static Tension Tests on Axially Loaded Pile Segments in Sand","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-083457","year":"2016","yearsub":"2016"}
