{"author_count":7,"contributors":["Andersen, Vibeke Friis","Berhanu, Tesfaye A.","Nilsson, Elna Johanna Kristina","Jørgensen, Solvejg","Nielsen, Ole John","Wallington, Timothy J.","Johnson, Matthew Stanley"],"cuid":["S01-000.00-731486"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","Ford Motor Company"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"atmospheric chemistry of two biodiesel model compounds methyl propionate and ethyl acetate","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-731486","identifier":[{"id":"000293758500016","type":"wos"},{"id":"80051706750","type":"scopus"}],"ids":["ku-72b967ef-e367-48ad-8f9c-fc247f739407"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-FB775F06CA780564F10B9CFF8626B9D5"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Chemistry"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"us","key":"ford motor company","loc":["United States","America, North","OECD"],"name":"Ford Motor Company","used":1}],"person":[{"affno":"1","first":"Vibeke Friis","key":"andersenpau","last":"Andersen","locid":"c6f3cd02-adbf-4fa7-9740-bc38adbd2b6c","name":"Andersen, Vibeke Friis","rank":1,"rolecode":"pau"},{"affno":"1","first":"Tesfaye A.","key":"berhanupau","last":"Berhanu","name":"Berhanu, Tesfaye A.","rank":2,"rolecode":"pau"},{"affno":"1","first":"Elna J