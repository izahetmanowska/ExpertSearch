g","rank":45,"rolecode":"pau"},{"affno":"1","first":"Andres J.","key":"lopezcontreraspau","last":"Lopez-Contreras","locid":"3dc2bb2b-47f7-4901-8d42-7c768ae5f1a3","name":"Lopez-Contreras, Andres J.","rank":46,"rolecode":"pau"},{"affno":"1","first":"Jeremy A.","key":"danielpau","last":"Daniel","locid":"7595fcdb-57bb-4bb9-873a-382e97f9b9e1","name":"Daniel, Jeremy A","name_org":"Daniel, Jeremy A.","rank":47,"rolecode":"pau"},{"affno":"1","first":"Eva R.","key":"hoffmannpau","last":"Hoffmann","locid":"463cbfab-40b4-48fc-afd5-d95c1506f24f","name":"Hoffmann, Eva R.","orcid":"0000-0002-2588-0652","rank":48,"rolecode":"pau"}],"pmid":["34349265"],"pub":{"doi":"10.1038/s41586-021-03779-7","issn":["00280836","14764687"],"issn_org":["00280836"],"journal":"Nature","pages":"393-397","status":"p","title":"Nature","volume":"596"},"review":"Peer Reviewed","scoID":["2-s2.0-85112666642"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-0737e780-1e74-4767-88a8-c51f2df115d1"],"src":["KU University of Copenhagen"],"title":"Genetic insights into biological mechanisms governing human ovarian ageing","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-397805","year":"2021","yearsub":"2021"}
{"abstract":"In this article we present findings from an investigation into the influence of partnering success factors on multi-partner projects’ abilities to meet time schedule, budget, and technical specifications. Our findings are based on the analysis of nation-wide surveys within the engineering consultancy industry in Denmark and Norway, and the research includes empirical data from 124 engineering consultancies. A main conclusion is that in order to meet all three criteria in the project performance measure, i.e. time schedule, budget, and technical specifications, mutual project objectives and commitment are important. To fulfil the two criteria time schedule and technical specifications, trust and collaborative problem-solving are important. To meet the criterion technical specifications, communication is the important partnering success factor. We also find that to positively influence project performance in a project comprising partners from independent firms, the project manager must aim to ensure the presence of the five identified partnering success factors throughout the project.","author_count":6,"contributors":["Nevstad, Kristina","Madsen, Tage Koed","Eskerod, Pernille","Aarseth, Wenche Kristin","Karlsen, Anniken Susanne T.","Andersen, Bjørn"],"cuid":["S01-000.00-580691"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Nevstad, Kristina"],"country":["Austria","Norway"],"glorg":["All Global Affiliations","Norwegian University of Science and Technology","Webster University Vienna"],"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"linking partnering success factors to project performance findings from two nation wide surveys","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.plas.2021.100009","version":"Published Version"},"id":"S01-000.00-580691","identifier":[{"id":"85121846467","type":"scopus"}],"ids":["sdu-1a22fdb6-c16c-4987-91d0-9d887ddd446e"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-4-288C0A0FA69479150D027814476796FA"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.plas.2021.100009","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/184398005/1_s2.0_S266672152100003X_main.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Social Science (SOC)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"no","key":"norwegian university of science and technology","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"Norwegian University of Science and Technology","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Business and Social Sciences, Department of Business & Management (DBM)","SDU, The Faculty of Business and Social Sciences, Department of Business & Management (DBM), International Leadership & Management"],"nora_code":"DI-U-SDU","used":1},{"affno":"3","country":"at","key":"webster university vienna","loc":["Austria","Europe, EU","OECD"],"name":"Webster University Vienna","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Kristina","key":"nevstadpau","last":"Nevstad","name":"Nevstad, Kristina","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Tage Koed","key":"madsenpau","last":"Madsen","locid":"a9e04f87-078a-4064-97ec-5337ddb911df","name":"Madsen, Tage Koed","orcid":"0000-0002-0093-5100","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Pernille","key":"eskerodpau","last":"Eskerod","name":"Eskerod, Pernille","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Wenche Kristin","key":"aarsethpau","last":"Aarseth","name":"Aarseth, Wenche Kristin","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anniken Susanne T.","key":"karlsenpau","last":"Karlsen","name":"Karlsen, Anniken Susanne T.","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Bjørn","key":"andersenpau","last":"Andersen","name":"Andersen, Bjørn","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.plas.2021.100009","issn":["26667215"],"journal":"Project Leadership and Society","pages":"100009","publisher":"Elsevier","status":"p","title":"Project Leadership and Society","volume":"2"},"review":"Peer Reviewed","scoID":["2-s2.0-85121846467"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-1a22fdb6-c16c-4987-91d0-9d887ddd446e"],"src":["SDU University of Southern Denmark"],"title":"Linking partnering success factors to project performance - Findings from two nation-wide surveys","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-580691","year":"2021","yearsub":"2021"}
{"abstract":"Recurrent herpesvirus infections can manifest in different forms of disease, including cold sores, genital herpes, and encephalitis. There is an incomplete understanding of the genetic and immunological factors conferring susceptibility to recurrent herpes simplex virus 2 (HSV2) infection in the central nervous system (CNS). Here, we describe two adult patients with recurrent HSV2 lymphocytic Mollaret's meningitis that each carry a rare monoallelic variant in the autophagy proteins ATG4A or LC3B2. HSV2-activated autophagy was abrogated in patient primary fibroblasts, which also exhibited significantly increased viral replication and enhanced cell death. HSV2 antigen was captured in autophagosomes of infected cells, and genetic inhibition of autophagy by disruption of autophagy genes, including ATG4A and LC3B2, led to enhanced viral replication and cell death in primary fibroblasts and a neuroblastoma cell line. Activation of autophagy by HSV2 was sensitive to ultraviolet (UV) irradiation of the virus and inhibited in the presence of acyclovir, but HSV2-induced autophagy was independent of the DNA-activated STING pathway. Reconstitution of wild-type ATG4A and LC3B2 expression using lentiviral gene delivery or electroporation of in vitro transcribed mRNA into patient cells restored virus-induced autophagy and the ability to control HSV2 replication. This study describes a previously unknown link between defective autophagy and an inborn error of immunity that can lead to increased susceptibility to HSV2 infection, suggesting an important role for autophagy in antiviral immunity in the CNS.","author_count":27,"contributors":["Hait, Alon Schneider","Olagnier, David","Sancho-Shimizu, Vanessa","Skipper, Kristian Alsbjerg","Helleberg, Marie","Larsen, Simon M.","Bodda, Chiranjeevi","Moldovan, Liviu-Ionut","Ren, Fanghui","Brinck Andersen, Nanna Sophie","Thomsen, Michelle M","Freytag, Mette Ratzer","Darmalinggam, Sathya","Parkes, Isobel","Kadekar, Darshana D","Rahbek, Stine Hess","van der Horst, Demi","Kristensen, Lasse Sommer","Eriksson, Kristina","Kjems, Jørgen","Mostowy, Serge","Christiansen, Mette","Mikkelsen, Jacob Giehm","Brandt, Christian Thomas","Paludan, Søren R","Mogensen, Trine H"],"cuid":["S02-083.92-020107"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","Europe, Non-EU","Nordic","OECD"],"country":["Finland","Sweden","United Kingdom"],"glorg":["All Global Affiliations","London School of Hygiene and Tropical Medicine","University of Eastern Finland","University of Gothenburg"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"defects in lc000000000003b000000000002 and atg000000000004a underlie hsv000000000002 meningitis and reveal a critical role for autophagy in antiviral defense in humans","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-ND","type":"loc","url":"https://curis.ku.dk/ws/files/320910923/Defects_in_LC3B2_and_ATG4A_underlie_HSV2_meningitis_and_reveal_a_critical_role_for_autophagy_in_antiviral_defense_in_humans.pdf","version":"Authors Final Version"},"id":"S02-083.92-020107","identifier":[{"id":"PMC7611067","type":"pmcid"},{"id":"33310865","type":"pmid"},{"id":"85098235878","type":"scopus"}],"ids":["au-660e28c6-e88f-4155-8813-69748e66d63d","ku-bb34ed6c-6db3-46a7-a890-27bddc4aa7e1"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-F4F53B5A06E104604E5A5621732550A0"],"oa_link":[{"access":"oa","license":"CC BY-ND","type":"loc","url":"https://curis.ku.dk/ws/files/320910923/Defects_in_LC3B2_and_ATG4A_underlie_HSV2_meningitis_and_reveal_a_critical_role_for_autophagy_