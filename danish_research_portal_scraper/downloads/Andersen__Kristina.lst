niversities"],"PST":["Published"]},"sid":["au-6ef8a031-0aeb-4ea3-b5af-c8b39ec014c6","au-d1a68a9f-d2bd-4ea3-941c-55e1146063b1"],"src":["AU Aarhus University"],"title":"Use of selective serotonin reuptake inhibitors and lifestyle among women of childbearing age : a Danish cross-sectional survey","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-082.20-020787","year":"2013","yearsub":"2013"}
{"abstract":"The pathophysiology of cerebral ischemia is traditionally understood in relation to reductions in cerebral blood flow (CBF). However, a recent reanalysis of the flow-diffusion equation shows that increased capillary transit time heterogeneity (CTTH) can reduce the oxygen extraction efficacy in brain tissue for a given CBF. Changes in capillary morphology are typical of conditions predisposing to stroke and of experimental ischemia. Changes in capillary flow patterns have been observed by direct microscopy in animal models of ischemia and by indirect methods in humans stroke, but their metabolic significance remain unclear. We modeled the effects of progressive increases in CTTH on the way in which brain tissue can secure sufficient oxygen to meet its metabolic needs. Our analysis predicts that as CTTH increases, CBF responses to functional activation and to vasodilators must be suppressed to maintain sufficient tissue oxygenation. Reductions in CBF, increases in CTTH, and combinations thereof can seemingly trigger a critical lack of oxygen in brain tissue, and the restoration of capillary perfusion patterns therefore appears to be crucial for the restoration of the tissue oxygenation after ischemic episodes. In this review, we discuss the possible implications of these findings for the prevention, diagnosis, and treatment of acute stroke.","author_count":30,"contributors":["Østergaard, Leif","Jespersen, Sune Nørhøj","Mouridsen, Kim","Mikkelsen, Irene Klærke","Jonsdottír, Kristjana Ýr","Tietze, Anna","Blicher, Jakob Udby","Aamand, Rasmus","Hjort, Niels","Iversen, Nina Kerting","Cai, Changsi","Hougaard, Kristina Dupont","Simonsen, Claus Z.","Von Weitzel-Mudersbach, Paul","Modrau, Boris","Nagenthiraja, Kartheeban","Riisgaard Ribe, Lars","Hansen, Mikkel Bo","Bekke, Susanne Lise","Dahlman, Martin Gervais","Puig, Josep","Pedraza, Salvador","Serena, Joaquín","Cho, Tae Hee","Siemonsen, Susanne","Thomalla, Götz","Fiehler, Jens","Nighoghossian, Norbert","Andersen, Grethe"],"cuid":["S02-091.26-001709"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","OECD"],"corresponding_author":["Østergaard, Leif"],"country":["Germany","Spain"],"glorg":["All Global Affiliations","University Hospital Dr Josep Trueta","University Medical Center Hamburg-Eppendorf","University of Girona","University of Hamburg"],"keyword":["Acute ischemic stroke","Penumbra","Reperfusion Injury"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Department of Neuroradiology"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"the role of the cerebral capillaries in acute ischemic stroke the extended penumbra model","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1038/jcbfm.2013.18","version":"Other Version"},"id":"S02-091.26-001709","identifier":[{"id":"000318394400002","type":"wos"},{"id":"84877576712","type":"scopus"},{"id":"PMC3652700","type":"pmcid"},{"id":"23443173","type":"pmid"}],"ids":["aau-21d6636a-5892-43a5-9b12-eb9a67da8b63","au-7f3cf29a-0b6d-420c-8c85-d09803ed80cd"],"keyword":["acute ischemic stroke","capillary transit time heterogeneity (CTTH)","cerebrovascular reserve capacity (CVRC)","penumbra","reperfusion injury","stroke risk factors"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-4525FB40EE7B50A86AFCD3034CE58CD9"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1038/jcbfm.2013.18","version":"Other Version"},{"access":"oa","type":"rem","url":"http://www.scopus.com/inward/record.url?scp=84877576712&partnerID=8YFLogxK","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2013","yearSub":"2013"},"org":[{