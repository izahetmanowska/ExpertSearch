{"author_count":4,"contributors":["Thomassen, Kristina","Sundstrup, Emil","Skovlund, Sebastian Venge","Andersen, Lars Louis"],"cuid":["S01-000.00-781238"],"filters":{"added":"2025-01","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"pop","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV"],"level3":{"GV":["DI-GV-ALL","DI-GV-WORK"]},"level3all":["DI-GV-WORK"]},"review":"und","rtype":["clu"],"sorti":"seniorer signalerer stor fleksibilitet går fremtidens ledige fra kontor til kantine","src":["nfa"],"src-code":["DI-GV-WORK"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-781238","ids":["nfa-94b51b3a-6490-4e4c-91ab-db058d6fa590"],"lang":"Danish","level":"Popular","mra":["Medical Science"],"noi":["Local-1-1-1A4440C7A52BCEC03FCE05C2F7521671"],"org":[{"affno":"1","key":"nfa national research centre for the working environment","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-WORK","l3nn":"NFA National Research Centre for the Working Environment","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"NFA National Research Centre for the Working Environment","namevar":["The National Research Centre for the Working Environment","The National Research Centre for the Working Environment, Directors, Musculoskeletal Disorders and Physical Workload"],"nora_code":"DI-GV-WORK","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Kristina","key":"thomassenpau","last":"Thomassen","name":"Thomassen, Kristina","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"E","key":"sundstruppau","last":"Sundstrup","locid":"688eab9a-3ad9-48b8-aad2-397c0a8ee105","name":"Sundstrup, Emil","name_org":"Sundstrup, E","orcid":"0000-0001-7408-222X","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sebastian Venge","key":"skovlundpau","last":"Skovlund","locid":"7ed308b6-7f4e-45d9-b04e-9d690a0cbfa2","name":"Skovlund, Sebastian Venge","orcid":"0000-0002-9820-2895","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"LL","key":"andersenpau","last":"Andersen","locid":"7918e862-7513-454a-874b-3fdb31af5e48","name":"Andersen, Lars Louis","name_org":"Andersen, LL","orcid":"0000-0003-2777-8085","rank":4,"rolecode":"pau"}],"pub":{"issn":["2597209X"],"issue":"1","journal":"SeniorArbejdsliv Policy Brief","status":"p","title":"SeniorArbejdsliv Policy Brief","volume":"1"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Governmental Institutions","DI-ALL","DI-GV","DI-GV-ALL","Governmental Institutions"],"PST":["Published"]},"sid":["nfa-94b51b3a-6490-4e4c-91ab-db058d6fa590"],"src":["NFA National Research Centre for the Working Environment"],"title":"Seniorer signalerer stor fleksibilitet. Går fremtidens ledige fra kontor til kantine?","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-781238","year":"2021","yearsub":"2021"}
{"abstract":"Background: This study investigates the role of physical work demands and psychosocial work factors for early retirement among older workers. Methods: Data from three Danish surveys on work environment and health among employed older workers (age 55–59) were merged with a national register containing information on labour market participation. Robust Poisson regression modelled the risk ratios (RR) and 95% confidence intervals (CI) for the association between physical and psychosocial work factors and early retirement, that is, not working after the age of 64. Results: Of the 2800 workers, 53% retired early. High physical work demands (RR 1.33, 95%CI 1.19–1.48), poor overall psychosocial working conditions (RR 1.43, 95%CI 1.26–1.61), and access to early retirement benefits (RR 1.79, 95%CI 1.53–2.10) predicted early retirement. Subgroup analyses revealed that poor overall psychosocial working conditions were a stronger predictor for early retirement among workers with seated jobs than those with physically active jobs. Conclusions: High physical work demands and poor psychosocial working conditions are factors that can push older workers out of the labour market prematurely. Poor psychosocial working conditions seem to be a particu-larly strong push factor among workers with seated work.","author_count":6,"contributors":["Sundstrup, Emil","Thorsen, Sannie V.","Rugulies, Reiner","Larsen, Mona","Thomassen, Kristina","Andersen, Lars L."],"cuid":["S03-099.90-769236"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":3,"keyword":["Arbejdsvilkår","Health","Older worker","Physical work demand","Physical workload","Psychosocial","Retirement","Statutory retirement age","Tilbagetrækning","Working environment"],"level":"sci","mra":["med","soc"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-VIVE","DI-GV-WORK"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-GV-VIVE","DI-GV-WORK","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"importance of the working environment for early retirement prospective cohort study with register follow up","src":["ku","nfa","vive"],"src-code":["DI-GV-VIVE","DI-GV-WORK","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.3390/ijerph18189817","version":"Published Version"},"id":"S03-099.90-769236","identifier":[{"id":"34574740","type":"pmid"},{"id":"PMC8472036","type":"pmcid"},{"id":"000699624200001","type":"wos"},{"id":"85115078176","type":"scopus"}],"ids":["ku-caf3d1e5-c139-498b-8436-6d9e65691d12","nfa-3925b6c9-78a4-4a62-baa9-8e58edc3413c","vive-174077d9-0b01-4ec9-a1c3-a5f734d767e1"],"keyword":["Arbejdsvilkår","Retirement","Tilbagetrækning","Working environment","health","older worker","physical work demand","physical workload","psychosocial","statutory retirement age"],"lang":"English","level":"Scientific","mra":["Medical Science","Social Science"],"noi":["Global-Local-2-6-59FC9BC586C5C5DF5725C468761F8348"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.3390/ijerph18189817","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/281096569/Importance_of_the_Working_Environment_for_Early_Retirement.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Social Science (SOC)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"nfa national research centre for the working environment","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-WORK","l3nn":"NFA National Research Centre for the Working Environment","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"NFA National Research Centre for the Working Environment","namevar":["The National Research Centre for the Working Environment","The National Research Centre for the Working Environment, Directors, Musculoskeletal Disorders and Physic