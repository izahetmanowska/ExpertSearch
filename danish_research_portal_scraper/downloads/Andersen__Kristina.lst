"1","first":"Mille E.","key":"ottosenpau","last":"Ottosen","name":"Ottosen, Mille E.","rank":4,"rolecode":"pau"},{"affno":"1","first":"Birgitte Olai","key":"milhøjpau","last":"Milhøj","locid":"fc2e56b3-1cdc-43b0-a906-e6572cd00f63","name":"Milhøj, Birgitte Olai","orcid":"0000-0001-5875-0187","rank":5,"rolecode":"pau"},{"affno":"1","first":"Stephan","key":"pasauerpau","last":"P. A. Sauer","locid":"6808e513-38c1-44b7-ab24-6385977c6c9f","name":"Sauer, Stephan P. A.","name_org":"P. A. Sauer, Stephan","orcid":"0000-0003-4812-0522","rank":6,"rolecode":"pau"},{"affno":"1","first":"Michael","key":"pittelkowpau","last":"Pittelkow","locid":"06c9cf58-d88e-45f7-99e5-55a77e030d6d","name":"Pittelkow, Michael","orcid":"0000-0002-3371-9500","rank":7,"rolecode":"pau"}],"pmid":["30721069"],"pub":{"doi":"10.1021/acs.joc.8b02797","issn":["00223263","15206904"],"issn_org":["00223263"],"issue":"5","journal":"Journal of Organic Chemistry","pages":"2577-2584","status":"p","title":"Journal of Organic Chemistry","title_org":"The Journal of Organic Chemistry","volume":"84"},"review":"Peer Reviewed","scoID":["2-s2.0-85062367116"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-1a035d84-cf3f-4d89-838c-5cc0cade9c7c"],"src":["KU University of Copenhagen"],"title":"Entropy/enthalpy compensation in anion binding : Biotin[6]uril and biotin-L-sulfoxide[6]uril reveal strong solvent dependency","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-408975","year":"2019","yearsub":"2019"}
{"abstract":"This paper identifies determinants of start-ups’ responses to the regulatory constraints they face when introducing innovations in nascent and highly controlled markets. Based on 49 interviews with start-ups, potential customer firms and other industry actors related to the commercial drone industry, we examine how the constraints imposed by regulation on the nascent market for drone applications affect start-ups’ efforts to commercialize their innovations. We find that to successfully influence regulation, start-ups need to bridge current and potential future market stages: Start-ups innovating at the technology frontier are more likely to engage in the regulatory process and more likely to possess the required regulatory resources and pursue market applications sufficiently legitimate to successfully negotiate with regulatory actors.","author_count":4,"contributors":["Andersen, Kristina Vaarst","Frederiksen, Marianne Harbo","Knudsen, Mette Præst","Krabbe, Anders Dahl"],"cuid":["S01-000.00-627118"],"event":{"acronym":"CINet Conference","end":"2019-09-10","place":"Odense, dk","start":"2019-09-08","title":"20th International CINet Conference","year":"2019"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["soc"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"strategic responses of start ups to regulatory constraints in the nascent drone market","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dcp","type-grp":["all","pub"]},"id":"S01-000.00-627118","ids":["sdu-bc12fd56-38a8-4a0c-b5d6-18ff794ce46b"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-4C7FDC9278370933C39222313B567D2F"],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Business and Social Sciences, Department of Business & Management (DBM)","SDU, The Faculty of Business and Social Sciences, Department of Business & Management (DBM), Centre for Integrative Innovation Management"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Kristina Vaarst","key":"andersenpau","last":"Andersen","locid":"46d2bbb6-cde6-45b4-b04d-dcbcbad97c83","name":"Andersen, Kristina Vaarst","orcid":"0000-0002-0181-6832","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Marianne Harbo","key":"frederiksenpau","last":"Frederiksen","locid":"cfe310fc-a616-44d6-b340-91ceda7e4029","name":"Frederiksen, Marianne Harbo","orcid":"0000-0002-1518-7416","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mette Præst","key":"knudsenpau","last":"Knudsen","locid":"efc4aa3e-11bb-4546-b241-8ce6dd970891","name":"Knudsen, Mette Præst","orcid":"0000-0002-2055-5308","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders Dahl","key":"krabbepau","last":"Krabbe","locid":"325db1d4-dbad-4283-8772-7a610427e7da","name":"Krabbe, Anders Dahl","rank":4,"rolecode":"pau"}],"pub":{"isbn":["9789077360224"],"publisher":"Continuous Innovation Network","status":"p","subtitle":"Innovating in an era of continuous disruption","title":"Proceedings of the 20th International CINet Conference"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-bc12fd56-38a8-4a0c-b5d6-18ff794ce46b"],"src":["SDU University of Southern Denmark"],"title":"Strategic Responses of Start-ups to Regulatory Constraints in the Nascent Drone Market","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-627118","year":"2019","yearsub":"2019"}
{"abstract":"The paper explores labor-market mechanisms of intra-professional status change following fast organizational failure. Extant research focuses on status change over extended periods of time. We complement that research by undertaking a mixed-method case study of the fast organizational decline and bankruptcy of a former market leader in the global bunker-oil industry. We use unique qualitative and quantitative data to examine the global careers of this firm’s displaced employees. On the one hand, we find that they suffered no general loss of status. On the other hand, we find that the displaced employees most prone to status loss were those who worked organizationally and geographically proximate to the locus of the organization’s failure. We theorize that status change in our case is driven by a mechanism of blaming—the perceived culpability of those displaced employees with comparatively strong association with the organizational failure. We compare this new theoretical notion of blame with the extant notion of stigma, and suggest that while both compensate for imperfect information, stigma entails weaker association with failure. As such, it taints with a “broad brush” compared to blame’s “pointed brush.”","author_count":3,"contributors":["Vaarst Andersen, Kristina","Lorenzen, Mark","Nowinska, Agnieszka"],"cuid":["S01-000.00-700456"],"event":{"end":"2019-06-21","place":"Frederiksberg, dk","start":"2019-06-19","title":"DRUID19 Conference","year":"2019"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS","DI-U-SDU"]},"level3all":["DI-U-CBS","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"the broad versus the pointed brush status change stigma and blame following fast organizational failure","src":["cbs"],"src-code":["DI-U-CBS"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"https://conference.druid.dk/acc_papers/aeqe7v2krq454x2p6sq4rva148k5oc.pdf","version":"Published Version"},"id":"S01-000.00-700456","ids":["cbs-6acf029b-e660-428d-9287-c2ba4766fa12"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-3DB5D6740369CE160CFD285B6AAF40CB"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"https://conference.druid.dk/acc_papers/aeqe7v2krq454x2p6sq4rva148k5oc.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["University of Southern Denmark"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of Strategy and Innovation"],"nora_code":"DI-U-CBS","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Kristina","key":"vaarstandersenpau","last":"Vaarst Andersen","name":"Vaarst Andersen, Kristina","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Mark","key":"lorenzenpau","last":"Lorenzen","locid":"197bb07e-e2b9-4b82-805b-c89e9b79eb1b","name":"Lorenzen, Mark","orcid":"0000-0001-8913-1143","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Agnieszka","key":"nowinskapau","last":"Nowinska","locid":"f4b34d91-51f7-4f16-b712-94402ecda4bf","name":"Nowinska, Agnieszka","orcid":"0000-0003-1914-5544","rank":3,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["cbs-6acf029b-e660-428d-9287-c2ba4766fa12"],"src":["CBS Copenhagen Business School"],"title":"The Broad versus the Pointed Brush : Status Change, Stigma, and Blame Following Fast Organizational Failure","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-700456","year":"2019","yearsub":"2019"}
{"abstract":"Formålet med denne del-undersøgelse er at opnå en mere dybdegående indsigt i unge knallertkøreres holdninger, vaner, mobilitetsbehov og risikoforståelse. Undersøgelsen tager udgangspunkt i unges mobilitetsbehov og –vaner, og baserer sig på fire kvalitative fokusgruppeinterview fordelt på fire forskellige byer. Gennem fokusgruppeinterviewene afdækkes de unges transportvaner, holdninger og risikoadfærd med henblik på at vurdere de mulige mobilitets- og sikkerhedsrelaterede konsekvenser en evt. aldersændring for kørekort til stor knallert og lille motorcykel ville kunne medføre.","author_count":3,"contributors":["Møller, Mette","Bonde, Nanna Skou","Krogh Andersen, Sandra Kristina"],"cuid":["S01-000.00-330002"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"kvalitativ undersøgelse af unge knallertkøreres holdning til knallertkørsel med fokus på mobilitet og sikkerhed delnotat vi","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/164663279/Del_VI_Unges_holdning_til_knallertk_rsel.pdf","version":"Published Version"},"id":"S01-000.00-330002","ids":["dtu-55937cf8-d6f5-4ff0-947a-48696c051c78"],"lang":"Danish","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-8C2513D29C66ECCFEED76BDDF2BFF25D"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/164663279/Del_VI_Unges_holdning_til_knallertk_rsel.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Management Engineering","Technical University of Denmark, Department of Management Engineering, Technology and Innovation Management","Technical University of Denmark, Department of Management Engineering, Transport DTU"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Mette","key":"møllerpau","last":"Møller","locid":"bc2c2ce5-846a-48d8-8f1c-98639e8c7604","name":"Møller, Mette","orcid":"0000-0002-0012-8691","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Nanna Skou","key":"bondepau","last":"Bonde","locid":"f3163949-cb40-41ce-ae66-9c54a00af84b","name":"Bonde, Nanna Skou","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sandra Kristina","key":"kroghandersenpau","last":"Krogh Andersen","locid":"b35dc181-b805-4bfd-8753-398a7f4021f4","name":"Krogh Andersen, Sandra Kristina","rank":3,"rolecode":"pau"}],"pub":{"pages":"31","place":"Lyngby, Denmark","publisher":"Technical University of Denmark","status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-55937cf8-d6f5-4ff0-947a-48696c051c78"],"src":["DTU Technical University of Denmark"],"title":"Kvalitativ undersøgelse af unge knallertkøreres holdning til knallertkørsel med fokus på mobilitet og sikkerhed: Delnotat VI","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-330002","year":"2018","yearsub":"2018"}
{"abstract":"I Australien har man undersøgt, om psykologiske og fysiske faktorer kan bruges til at identificere, hvem der vender tilbage til arbejdsmarkedet efter at have være involveret i et trafikuheld. Analysen viser især, at ”høj fysisk funktionsnedsættelse” og ”lav forventning om at vende tilbage til arbejdet” har betydning for, om man efterfølgende vender tilbage til arbejdet.","author_count":1,"contributors":["Krogh Andersen, Sandra Kristina"],"cuid":["S01-000.00-343665"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"corresponding_author":["Krogh Andersen, Sandra Kristina"],"level":"pop","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"und","rtype":["clu"],"sorti":"hvem kommer i arbejde igen efter en trafikulykke","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://www.trafiksikkerhedsforskning.dtu.dk/Arkiv/Nr-42/Hvem-kommer-i-arbejde-igen-efter-en-trafikulykke","version":"Published Version"},"id":"S01-000.00-343665","ids":["dtu-82f33fba-9041-4041-a3ee-180e02dcd729"],"lang":"English","level":"Popular","mra":["Science/Technology"],"noi":["Local-1-1-955892B237D33C9F304E6BAAA483285A"],"oa_link":[{"access":"oa","type":"rem","url":"http://www.trafiksikkerhedsforskning.dtu.dk/Arkiv/Nr-42/Hvem-kommer-i-arbejde-igen-efter-en-trafikulykke","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Management Engineering","Technical University of Denmark, Department of Management Engineering, Technology and Innovation Management"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Sandra Kristina","key":"kroghandersenpau","last":"Krogh Andersen","locid":"b35dc181-b805-4bfd-8753-398a7f4021f4","name":"Krogh Andersen, Sandra Kristina","rank":1,"rolecode":"pau"}],"pub":{"journal":"Nyhedsbrevet Trafiksikkerhedsforskning","publisher":"DTU Transport","status":"p","title":"Nyhedsbrevet Trafiksikkerhedsforskning","title_org":"Nyhedsbrevet trafiksikkerhedsforskning","volume":"42"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-82f33fba-9041-4041-a3ee-180e02dcd729"],"src":["DTU Technical University of Denmark"],"title":"Hvem kommer i arbejde igen efter en trafikulykke?","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-343665","year":"2018","yearsub":"2018"}
{"abstract":"OBJECTIVE: Bile acids (BAs) facilitate fat absorption and may play a role in glucose and metabolism regulation, stimulating the secretion of gut hormones. The relative importance and mechanisms involved in BA-stimulated secretion of appetite and metabolism regulating hormones from the gut and pancreas is not well described and was the purpose of this study. METHODS: The effects of bile acids on the secretion of gut and pancreatic hormones was studied in rats and compared to the most well described nutritional secretagogue: glucose. The molecular mechanisms that underlie the secretion was studied by isolated perfused rat and mouse small intestine and pancreas preparations and supported by immunohistochemistry, expression analysis, and pharmacological studies. RESULTS: Bile acids robustly stimulate secretion of not only the incretin hormones, glucose-dependent insulinotropic peptide (GIP), and glucagon-like peptide-1 (GLP-1), but also glucagon and insulin in vivo, to levels comparable to those resulting from glucose stimulation. The mechanisms of GLP-1, neurotensin, and peptide YY (PYY) secretion was secondary to intestinal absorption and depended on activation of basolateral membrane Takeda G-protein receptor 5 (TGR5) receptors on the L-cells in the following order of potency: Lithocholic acid (LCA) >Deoxycholicacid (DCA)>Chenodeoxycholicacid (CDCA)> Cholic acid (CA). Thus BAs did not stimulate secretion of GLP-1 and PYY from perfused small intestine in TGR5 KO mice but stimulated robust responses in wild type littermates. TGR5 is not expressed on α-cells or β-cells, and BAs had no direct effects on glucagon or insulin secretion from the perfused pancreas. CONCLUSION: BAs should be considered not only as fat emulsifiers but also as important regulators of appetite- and metabolism-regulating hormones by activation of basolateral intestinal TGR5.","author_count":14,"contributors":["Kuhre, Rune Ehrenreich","Wewer Albrechtsen, Nicolai J","Larsen, Olav","Jepsen, Sara L","Balk-Møller, Emilie","Andersen, Daniel B.","Deacon, Carolyn F.","Schoonjans, Kristina","Reimann, Frank","Gribble, Fiona M.","Albrechtsen, Reidar","Hartmann, Bolette","Rosenkilde, Mette M.","Holst, Jens Juul"],"cuid":["S01-000.00-510128"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Bile acids","GLP 1","Insulin","Neurotensin","PYY","TGR5"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"bile acids are important direct and indirect regulators of the secretion of appetite and metabolism regulating hormones from the gut and pancreas","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.molmet.2018.03.007","version":"Published Version"},"id":"S01-000.00-510128","identifier":[{"id":"85045244666","type":"scopus"},{"id":"PMC6001409","type":"pmcid"},{"id":"29656109","type":"pmid"}],"ids":["ku-c3776646-bf4e-4caa-b8e2-487a952caba4"],"keyword":["Bile-acids","GLP-1","Insulin","Neurotensin","PYY","TGR5"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-C5EBC0627D3DA0C2686BC77250230FCA"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/209546434/1_s2.0_S2212877818301194_main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.molmet.2018.03.007","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","N