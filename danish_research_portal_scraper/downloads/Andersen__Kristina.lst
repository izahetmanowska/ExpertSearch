no":"2","corresponding":null,"first":"Poul","key":"nissenpau","last":"Nissen","locid":"f7a1f833-0117-497e-b031-37354c4a1fb2","name":"Nissen, Poul","orcid":"0000-0003-0948-6628","rank":6,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Jesper Vuust","key":"møllerpau","last":"Møller","locid":"0ac57406-a24e-4df2-9a65-3949950f5ec1","name":"Møller, Jesper Vuust","rank":7,"rolecode":"pau"},{"affno":"","first":"Jesper Vuust","key":"mollerpau","last":"Moller","name":"Moller, Jesper Vuust","rank":7,"rolecode":"pau"}],"pmid":["21047776"],"pub":{"doi":"10.1074/jbc.m110.176784","issn":["00219258","10678816"],"issn_org":["00219258"],"issue":"2","journal":"Journal of Biological Chemistry","pages":"1609-1617","status":"p","title":"Journal of Biological Chemistry","volume":"286"},"review":"Peer Reviewed","scoID":["2-s2.0-78651394444"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-edd6c690-5a64-4534-bf3f-3c12c2e5b731","ku-24575fbf-5070-42d5-aa6d-3c952b640a6f","ku-e03bf008-fd63-4052-9a30-bb0c02f90daf"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Characterization of a Listeria monocytogenes Ca2+ Pump A SERCA-TYPE ATPase WITH ONLY ONE Ca2+-BINDING SITE","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-091.65-029908","year":"2011","yearsub":"2011"}
{"abstract":"The study addresses how recent reforms of the Sickness Benefit Act in Denmark are put into practice. A single case study embedded with five subunits of analysis based on \"real life\" cases has been conducted in a Danish municipality. Five \"sick-listed\" citizens and their respective municipal case manager and general practitioner (GP) were interviewed. Two key persons within the municipality were interviewed as background informants. The GPs and case managers ability to co-operate was hampered by lack of time, frequent staff turnover, lack of financial resources, and low accessibility. The motivation for co-operation was low due to low status of social medical issues, lack of feedback and lack of trust. The co-operation was characterized by sequential task integration. The stakeholders encountered difficulties when reciprocal task integration was needed. The decision making was affected by legal constraints and conflicting paradigms of key stakeholders. Rather than forcing co-operation, policymakers should increase the stakeholders' abilities and improve the conditions that create the low level of trust and hamper the willingness to co-operate.","author_count":4,"contributors":["Johansen, Kristina","Andersen, John Sahl","Mikkelsen, Sigurd","Lynge, Elsebeth"],"cuid":["S01-000.00-441936"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"decision making and co operation between stakeholders within the process of sick leave a case study in a danish municipality","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.3109/13561820.2010.483367","version":"Other Version"},"id":"S01-000.00-441936","identifier":[{"id":"78650031480","type":"scopus"},{"id":"20795840","type":"pmid"}],"ids":["ku-51395ff9-fc4c-46a4-99bf-985847c77185"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-2-991E626FD25F7FC53D2158EA540B4E96"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.3109/13561820.2010.483367","version":"Other Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Public Health, Center of Epidemiology and Screening"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Kristina","key":"johansenpau","last":"Johansen","locid":"5d0145b4-bf78-48f9-a390-b9286056c091","name":"Johansen, Kristina","rank":1,"rolecode":"pau"},{"affno":"1","first":"John Sahl","key":"andersenpau","last":"Andersen","locid":"45c9f771-6d3b-4f3c-aa4e-64bab16dc2fe","name":"Andersen, John Sahl","orcid":"0000-0001-7235-4359","rank":2,"rolecode":"pau"},{"affno":"","first":"Sigurd","key":"mikkelsenpau","last":"Mikkelsen","name":"Mikkelsen, Sigurd","rank":3,"rolecode":"pau"},{"affno":"1","first":"Elsebeth","key":"lyngepau","last":"Lynge","locid":"cba2839a-fffd-4b0e-8dad-dd5ba145924c","name":"Lynge, Elsebeth","orcid":"0000-0003-4785-5236","rank":4,"rolecode":"pau"}],"pmid":["20795840"],"pub":{"doi":"10.3109/13561820.2010.483367","issn":["13561820","14699567"],"issn_org":["13561820"],"issue":"1","journal":"Journal of Interprofessional Care","pages":"59-65","status":"p","title":"Journal of Interprofessional Care","volume":"25"},"review":"Peer Reviewed","scoID":["2-s2.0-78650031480"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-51395ff9-fc4c-46a4-99bf-985847c77185"],"src":["KU University of Copenhagen"],"title":"Decision making and co-operation between stakeholders within the process of sick leave. A case study in a Danish municipality","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-441936","year":"2011","yearsub":"2011"}
{"abstract":"What this paper adds What is already known about this subject •  National guidelines for start of highly active antiretroviral treatment (HAART) in HIV infected patients are available in many Western World countries however the impact of the guidelines on clinical practice is poorly documented What this study adds •  Adherence to the starting criteria for HAART and the choice of treatment regimen in the guidelines exceeded 90% •  Intravenous drug users were more likely to start HAART at a later time after fulfilling the starting criteria and starting an alternative regimen •  More than a third of the patients initiated HAART as a part of a clinical trial from 1998 to 2000 ABSTRACT: Aims: To determine the adherence to the national guidelines for start of highly active antiretroviral treatment (HAART) in HIV infected patients Methods: We used a Danish nationwide cohort of HIV infected HIV patients to calculate the fraction of patients who in the period 1997-2006 started HAART according to the guidelines from The Danish Society of Infectious Diseases. We used Kaplan-Meier tables to estimate time from fulfilling the criteria for start of HAART to initiation of the treatment. Cox regression and logistic regression was used to identify risk factors for delayed initiation of treatment and chance of being included in clinical trials. Results: The study included 3,223 patients, 74% of whom initiated HAART in the study period. 94% fulfilled the criteria for start of HAART, with minor differences over calendar periods. 94% initiated a recommended regimen or were included in a clinical trial. Intravenous drug use predicted initiation of a non-recommended regimen and delay in start of HAART, while non-Caucasians were less likely to be included in clinical trials. Conclusion: In a Western World setting, the adherence to national guidelines for start of HAART can be high. We suggest that simplicity of the guidelines, centralization of treatment and involvement of local clinicians in development of guidelines are of major importance for high adherence to treatment guidelines.","author_count":14,"contributors":["Petersen, TS","Andersen, SE","Gerstoft, Jan","Thorsteinsson, K","Larsen, Carsten Schade","Pedersen, Gitte","Pedersen, C","Obel, Niels"],"cuid":["S03-094.83-017644"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"adherence to national guidelines for initiation of antiretroviral regimens in hiv patients a danish nationwide study","src":["au","ku","sdu"],"src-code":["DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1111/j.1365-2125.2011.03935.x","version":"Other Version"},"id":"S03-094.83-017644","identifier":[{"id":"21306418","type":"pmid"},{"id":"79958755052","type":"scopus"},{"id":"PMC3141193","type":"pmcid"}],"ids":["au-4482c065-498f-4f28-bdb8-b5ed678f5e6b","ku-2fa53a38-47cf-49c6-a889-a23ac867b443","sdu-bd1bdcf9-3798-47bb-9870-fc639ffb4b46"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-A97BFC70AC83965601C1D6E163BFC5CB"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1111/j.1365-2125.2011.03935.x","version":"Other Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus University, Faculty of Health Sciences, The Department of Infectious Diseases"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"sdu university of southern denmark","l