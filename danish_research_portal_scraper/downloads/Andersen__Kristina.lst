{"affno":"4","corresponding":null,"first":"Elo","key":"andersenelopau","last":"Andersen","name":"Andersen, Elo","rank":7,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Claus Andrup","key":"kristensenclausandruppau","last":"Kristensen","name":"Kristensen, Claus Andrup","rank":8,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Maria","key":"andersenmariapau","last":"Andersen","name":"Andersen, Maria","rank":9,"rolecode":"pau"},{"affno":"7","corresponding":null,"first":"Mohammad","key":"farhadimohammadpau","last":"Farhadi","name":"Farhadi, Mohammad","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jens","key":"overgaardjenspau","last":"Overgaard","name":"Overgaard, Jens","rank":11,"rolecode":"pau"},{"affno":"2 7","corresponding":null,"first":"Susanne Oksbjerg","key":"daltonsusanneoksbjergpau","last":"Dalton","name":"Dalton, Susanne Oksbjerg","rank":12,"rolecode":"pau"}],"pmid":["37672036"],"pub":{"doi":"10.1080/0284186x.2023.2254478","issn":["0284186X","11001704"],"issn_org":["0284186X"],"issue":"11","journal":"Acta Oncologica","pages":"1394-1402","publisher":"Medical Journals Sweden AB","status":"p","title":"Acta Oncologica","volume":"62"},"review":"Peer Reviewed","scoID":["2-s2.0-85169934797"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Non-Profit Organisations","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-NP","DI-NP-ALL","DI-U","DI-U-ALL","Hospitals","Non-Profit Organisations","North Denmark Region","Region Zealand","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-4a53bafb-a8c5-4e34-96d0-9f8a572813bb"],"src":["SDU University of Southern Denmark"],"title":"Socioeconomic position and the pre-diagnostic interval among patients diagnosed with head and neck squamous cell carcinoma - a population-based study from DAHANCA","type":"Conference Paper","url":"https://local.forskningsportal.dk