anagement"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Kristina","key":"vaarstandersenpau","last":"Vaarst Andersen","locid":"e64ee7c1-08fa-4113-947a-18da853e6a39","name":"Andersen, Kristina Vaarst","name_org":"Vaarst Andersen, Kristina","orcid":"0000-0002-0181-6832","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Kristina Vaarst","key":"andersenpau","last":"Andersen","locid":"46d2bbb6-cde6-45b4-b04d-dcbcbad97c83","name":"Andersen, Kristina Vaarst","orcid":"0000-0002-0181-6832","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mark","key":"lorenzenpau","last":"Lorenzen","locid":"197bb07e-e2b9-4b82-805b-c89e9b79eb1b","name":"Lorenzen, Mark","orcid":"0000-0001-8913-1143","rank":2,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["cbs-d392de53-3a21-4531-89d9-8e9b07c6e715","sdu-7c64dc9f-556e-4784-b8f1-279ca924b8be"],"src":["CBS Copenhagen Business School","SDU University of Southern Denmark"],"title":"Diversity vs Dharma : How Social Capital Increases and Impedes Project Performance in Bollywood","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-032087","year":"2014","yearsub":"2014"}
{"abstract":"In this paper we investigate the micro-mechanisms governing structural evolution and performance of scientific collaboration. Scientific discovery tends not to be lead by so called lone ?stars?, or big egos, but instead by collaboration among groups of researchers, from a multitude of institutions and locations, having a diverse knowledge set and capable of tackling more and more complex problems. This prose the question if Big Egos continues to dominate in this rising paradigm of big science. Using a dataset consisting of full bibliometric coverage from a Large Scale Research Facility, we utilize a stochastic actor oriented model (SAOM) to analyze both network endogeneous mechanisms and individual agency driving the collaboration network and further if being a Big Ego in Big Science translates to increasing performance. Our findings suggest that the selection of collaborators is not based on preferentialattachment, but more of an assortativity effect creating not merely a rich-gets-richer effect but an elitist network with high entry barriers. In this acclaimed democratic and collaborative environment of Big Science, the elite closes in on itself. We propose this tendency to be even more explicit in other knowledge producing environments with more visible boundaries and higher thresholds for collaboration.","author_count":4,"contributors":["Jeppesen, Jacob","Andersen, Kristina Vaarst","Lauto, Giancarlo","Valentin, Finn"],"cuid":["S01-000.00-298431"],"event":{"end":"2014-06-18","place":"Frederiksberg, dk","start":"2014-06-16","title":"The DRUID Society Conference 2014","year":"2014"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Italy"],"glorg":["All Global Affiliations","Università degli Studi di Udine"],"level":"sci","mra":["soc"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS"]},"level3all":["DI-U-CBS"]},"review":"pr","rtype":["clu"],"sorti":"big egos in big science unlocking peer and status effects in the evolution of collaborative networks","src":["cbs"],"src-code":["DI-U-CBS"],"type":"dcp","type-grp":["all","pub"]},"id":"S01-000.00-298431","ids":["cbs-f17d58c8-f751-4365-8c37-efe4fe172a85"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-38A031DC3D1F03283218DEDBD6C4B223"],"org":[{"affno":"1","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of Strategy and Innovation, Department of Innovation and Organizational Economics"],"nora_code":"DI-U-CBS","used":1},{"affno":"2","country":"it","key":"università degli studi di udine","loc":["Italy","Europe, EU","OECD"],"name":"Università degli Studi di Udine","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jacob","key":"jeppesenpau","last":"Jeppesen","locid":"8b2b644b-5bed-4d26-ad6f-2d87be498450","name":"Jeppesen, Jacob","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kristina","key":"vaarstandersenpau","last":"Vaarst Andersen","locid":"e64ee7c1-08fa-4113-947a-18da853e6a39","name":"Andersen, Kristina Vaarst","name_org":"Vaarst Andersen, Kristina","orcid":"0000-0002-0181-6832","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Giancarlo","key":"lautopau","last":"Lauto","name":"Lauto, Giancarlo","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Finn","key":"valentinpau","last":"Valentin","locid":"19879850-6f74-4088-bee8-41395b790893","name":"Valentin, Finn","orcid":"0000-0001-7645-8390","rank":4,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["cbs-f17d58c8-f751-4365-8c37-efe4fe172a85"],"src":["CBS Copenhagen Business School"],"title":"Big Egos in Big Science : Unlocking Peer and Status Effects in the Evolution of Collaborative Networks","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-298431","year":"2014","yearsub":"2014"}
