228","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kristina Martha","key":"renaultkristinampau","last":"Renault","locid":"71450333-81f3-4739-a961-71ee3f220084","name":"Renault, Kristina M","name_org":"Renault, Kristina Martha","orcid":"0000-0002-6387-9652","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"René Klinkby","key":"støvingrenéklinkbypau","last":"Støving","locid":"4aab81f6-352f-4c74-82a2-23589beb9fd5","name":"Støving, René Klinkby","orcid":"0000-0002-4255-5544","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Dorte Møller","key":"jensendortemøllerpau","last":"Jensen","locid":"a221b393-70f9-4f53-902e-63d1a13f8f60","name":"Jensen, Dorte Møller","orcid":"0000-0002-3298-9824","rank":5,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-5882c5ea-d14c-43c3-84ea-fab389f2b579"],"src":["SDU University of Southern Denmark"],"title":"Women with previous gastric bypass do not fulfill the recommendations for gestational weight gain","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-598565","year":"2015","yearsub":"2015"}
{"abstract":"Remote ischaemic conditioning (RIC) triggers endogenous protective pathways in distant organs such as the kidney, heart and brain, and represents an exciting new paradigm in neuroprotection. RIC involves repetitive inflation and deflation of a blood pressure cuff on the limb, and is safe and feasible. The exact mechanism of signal transmission from the periphery to the brain is not known, but both humoral factors and an intact nervous system seem to have critical roles. Early-phase clinical trials have already been conducted to test RIC in the prehospital setting in acute ischaemic stroke, and in subarachnoid haemorrhage for the prevention of delayed cerebral ischaemia. Furthermore, two small randomized clinical trials in patients with symptomatic intracranial atherosclerosis have shown that RIC can reduce recurrence of stroke and have neuroprotective activity. RIC represents a highly practical and translatable therapy for acute, subacute, and chronic neurological diseases with an ischaemic or inflammatory basis. In this Review, we consider the principles and mechanisms of RIC, evidence from preclinical models and clinical trials that RIC is beneficial in neurological disease, and how the procedure might be used in the future in disorders such as vascular cognitive impairment and traumatic brain injury.","author_count":7,"contributors":["Hess, David C","Blauenfeldt, Rolf Ankerlund","Andersen, Grethe","Hougaard, Kristina Dupont","Hoda, Md Nasrul","Ding, Yuchuan","Ji, Xunming"],"cuid":["S01-000.00-137906"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","Augusta University","Wayne State University"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"remote ischaemic conditioning a new paradigm of self protection in the brain","src":["au"],"src-code":["DI-U-AU"],"type":"djr","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84949313895","version":"Other Version"},"id":"S01-000.00-137906","identifier":[{"id":"26585977","type":"pmid"},{"id":"84949313895","type":"scopus"}],"ids":["au-0eeb6a5f-33b4-48aa-9754-48fa0d1d4b83"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-24FE70B3BD66668E9F85BD96E8D48863"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","country":"us","key":"augusta university","loc":["United States","America, North","OECD"],"name":"Augusta University","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Department of Neurology"],"nora_code":"DI-U-AU","used":1},{"affno":"3","country":"us","key":"wayne state university","loc":["United States","America, North","OECD"],"name":"Wayne State University","used":1},{"affno":"4","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"first":"David C","key":"hesspau","last":"Hess","name":"Hess, David C","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Rolf Ankerlund","key":"blauenfeldtpau","last":"Blauenfeldt","locid":"2cc4cfa1-de55-413c-b008-6b5d1c275888","name":"Blauenfeldt, Rolf Ankerlund","orcid":"0000-0002-4846-9516","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Grethe","key":"andersenpau","last":"Andersen","locid":"97e157c9-4cb4-4690-a971-06e4699b50fe","name":"Andersen, Grethe","orcid":"0000-0001-6807-2500","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Kristina D","key":"hougaardpau","last":"Hougaard","locid":"1ab97559-86f2-4e28-be39-2b4ac80b4b34","name":"Hougaard, Kristina Dupont","name_org":"Hougaard, Kristina D","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Md Nasrul","key":"hodapau","last":"Hoda","name":"Hoda, Md Nasrul","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Yuchuan","key":"dingpau","last":"Ding","name":"Ding, Yuchuan","rank":6,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Xunming","key":"jipau","last":"Ji","name":"Ji, Xunming","rank":7,"rolecode":"pau"}],"pmid":["26585977"],"pub":{"doi":"10.1038/nrneurol.2015.223","issn":["17594758","17594766"],"issn_org":["17594758"],"issue":"12","journal":"Nature Reviews Neurology","pages":"698-710","publisher":"Nature Research","status":"p","title":"Nature Reviews Neurology","title_org":"Nature Reviews. Neurology","volume":"11"},"review":"Peer Reviewed","scoID":["2-s2.0-84949313895"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-0eeb6a5f-33b4-48aa-9754-48fa0d1d4b83"],"src":["AU Aarhus University"],"title":"Remote ischaemic conditioning-a new paradigm of self-protection in the brain","type":"Journal Review","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-137906","year":"2015","yearsub":"2015"}
{"abstract":"PURPOSE: To test whether the melanopsin-containing, intrinsically photosensitive retinal ganglion cells (ipRGCs), as evaluated by examination of the pupillary light reflex (PLR), are preserved in genetically confirmed autosomal dominant optic atrophy (ADOA). METHOD: Twenty-nine patients with either the c.983A > G (n = 14) or the c.2708_ 2711delTTAG mutation (n = 15) were examined with monochromatic pupillometry, using isoluminant (300 cd/m(2)), red (660 nm) or blue (470 nm) light, optical coherence tomography, automated visual field analysis, and with determination of best corrected visual acuity (BCVA). Since we examined two different mutations, initially we compared all outcome variables between the two, and finding no statistically significant difference, pooled them. RESULTS: Despite a poor BCVA (56 letters, ETDRS) in the ADOA patients, their post-illuminatory pupil responses did not differ significantly from those of healthy controls (blue, p = 0.45, red, p = 0.49, t-test), and no statistically significant effect was noted of peripapillary retinal nerve fiber layer thickness, ganglion cell-inner plexiform layer thickness, or age. CONCLUSION: The PLR to blue light of high luminance (300 cd/m(2)) was preserved in both c.983A > G and c.2708_2711delTTAG ADOA despite severe visual loss and optic nerve atrophy. The study confirms, in a large sample of two genetically homogenous groups, that the ipRGCs are spared in ADOA.","author_count":7,"contributors":["Nissen, Claus","Rönnbäck, Cecilia","Sander, Birgit","Herbst, Kristina","Milea, Dan","Larsen, Michael","Lund-Andersen, Henrik"],"cuid":["S01-000.00-490787"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"nr","rtype":["clu"],"sorti":"dissociation of pupillary post illumination responses from visual function in confirmed i opa000000000001 i c 000000000983a gt g and c 000000002708 000000002711delttag autosomal dominant optic atrophy","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/fneur.2015.00005","version":"Published Version"},"id":"S01-000.00-490787","identifier":[{"id":"PMC4316714","type":"pmcid"},{"id":"25699009","type":"pmid"},{"id":"84926324407","type":"scopus"}],"ids":["ku-a2e25493-6a44-4acb-ba04-b4a0db1a1879"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-93C4388D21471B5BD102090781E36B07"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/fneur.2015.00005","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Claus","key":"nissenpau","last":"Nissen","name":"Nissen, Claus","rank":1,"rolecode":"pau"},{"affno":"","first":"Cecilia","key":"rönnbäckpau","last":"Rönnbäck","name":"Rönnbäck, Cecilia","rank":2,"rolecode":"pau"},{"affno":"1","first":"Birgit","key":"sanderpau","last":"Sander","locid":"62cb74c8-aa3c-4d9e-9cbb-03250f760560","name":"Sander, Birgit","rank":3,"rolecode":"pau"},{"affno":"","first":"Kristina","key":"herbstpau","last":"Herbst","locid":"73afb881-f7b9-437a-8a3c-78f801a599f8","name":"Herbst, Kristina","rank":4,"rolecode":"pau"},{"affno":"","first":"Dan","key":"mileapau","last":"Milea","name":"Milea, Dan","rank":5,"rolecode":"pau"},{"affno":"1","first":"Michael","key":"larsenpau","last":"Larsen","locid":"1d460214-c0db-4a15-a3a5-360c73746ed4","name":"Larsen, Michael","rank":6,"rolecode":"pau"},{"affno":"1","first":"Henrik","key":"lundandersenpau","last":"Lund-Andersen","locid":"5277856f-b771-4658-bb2f-b292ec78ee6f","name":"Lund-Andersen, Henrik","rank":7,"rolecode":"pau"}],"pmid":["25699009"],"pub":{"doi":"10.3389/fneur.2015.00005","issn":["16642295"],"journal":"Frontiers in Neurology","pages":"1-5","paperid":"2015.00005","status":"p","title":"Frontiers in Neurology","volume":"6"},"review":"No Review","scoID":["2-s2.0-84926324407"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-a2e25493-6a44-4acb-ba04-b4a0db1a1879"],"src":["KU University of Copenhagen"],"title":"Dissociation of Pupillary Post-Illumination Responses from Visual Function in Confirmed <i>OPA1</i> c.983A &gt; G and c.2708_2711delTTAG Autosomal Dominant Optic Atrophy","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-490787","year":"2015","yearsub":"2015"}
{"abstract":"This study explores the perceived meaning of dependency on care as experienced by intensive care patients. Research from non-intensive settings shows that dependency is often experienced negatively, but literature on the subject experienced by patients in the ICU is sparse. The study is based on in-depth qualitative semi-structured interviews of lived experience with three former patients admitted to an intensive care unit at a Danish university hospital. The in-depth interviews have been characterized as narratives. The main inspiration for the analysis method is Ricoeur's phenomenological hermeneutical interpretation theory. The study has found that dependency is experienced as difficult, and the relationship with the nurses seems to be ambivalent. The good relationship is experienced to make dependency easier, whereas negative experiences make it harder to cope with dependency. The participants deal with dependency by accepting negative experiences in gratitude for having recovered from critical illness. The findings might be influenced by studies being conducted in a western country setting where independence is valued. They can be used as means of reflection on nursing practice and matters such as communication and patient participation.","author_count":3,"contributors":["Lykkegaard Andersen, Kristina","Delmar, Charlotte"],"cuid":["S02-085.28-008008"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"continent":["Europe, Non-EU","Nordic","OECD"],"country":["Norway"],"glorg":["All Global Affiliations","University College Diakonova, Oslo","VID Specialized University"],"keyword":["Ambivalence","Dependency","Gratitude","Intensive care","Relationship","violation"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"between violation and competent care lived experiences of dependency on care in the icu","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://www.ijqhw.net/index.php/qhw/article/view/26603","version":"Published Version"},"id":"S02-085.28-008008","identifier":[{"id":"WOS:000350891400001","type":"wos"},{"id":"84924546344","type":"scopus"},{"id":"25765881","type":"pmid"}],"ids":["aau-a59caa88-515e-43a3-8573-cb70b0471ab6","au-f62aa712-672f-4030-ab6d-9770abd19f24"],"keyword":["ambivalence","dependency","gratitude","intensive care","relationship","violation"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-CCBE4F032E3C9D308E90DC5F4A383EA5"],"oa_link":[{"access":"oa","type":"rem","url":"http://www.ijqhw.net/index.php/qhw/article/view/26603","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Anæstesi og Intensiv [Klinik Akut]","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Anæstesi"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Public Health, Department of Public Health - Department of Science in Nursing"],"nora_code":"DI-U-AU","used":