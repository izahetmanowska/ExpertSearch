3250f760560","name":"Sander, Birgit","rank":2,"rolecode":"pau"},{"affno":"1","first":"Henrik","key":"lundandersenpau","last":"Lund-Andersen","locid":"5277856f-b771-4658-bb2f-b292ec78ee6f","name":"Lund-Andersen, Henrik","rank":3,"rolecode":"pau"},{"affno":"1","first":"Marianne","key":"wegenerpau","last":"Wegener","locid":"177dfb30-99f0-4351-90c1-9e9b86949617","name":"Wegener, Marianne","rank":4,"rolecode":"pau"},{"affno":"1","first":"Jens","key":"hannibalpau","last":"Hannibal","locid":"b2810b1e-a8c8-41cb-bb4f-669ad1ff6b65","name":"Hannibal, Jens","rank":5,"rolecode":"pau"},{"affno":"1","first":"Dan","key":"mileapau","last":"Milea","locid":"688d62a6-7977-4e32-92dd-95c4cbbdc02a","name":"Milea, Dan","rank":6,"rolecode":"pau"}],"pmid":["23717301"],"pub":{"doi":"10.3389/fneur.2013.00052","issn":["16642295"],"journal":"Frontiers in Neurology","pages":"1-7","paperid":"52","status":"p","title":"Frontiers in Neurology","volume":"4"},"review":"Peer Reviewed","scoID":["2-s2.0-84878777274"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-6771f218-2286-4368-9e0b-ebcf51a53418"],"src":["KU University of Copenhagen"],"title":"Unilateral anterior ischemic optic neuropathy : hromatic pupillometry in affected, fellow non-affected and healthy control eyes","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-455195","year":"2013","yearsub":"2013"}
{"abstract":"Embeddedness has been touted as a framework for knowledge exchange and innovation, and thus as an important precondition for high-level performance. Embeddedness of economic action in social relations improves access to resources, but over-embeddedness impedes performance. However, until now the association between embeddedness and performance in different markets has been neglected. This paper challenges the predominant view of embeddedness and over-embeddedness as absolute and mutually exclusive conditions. Through regression analyses of novel data from a project-based industry, the paper tests the association between embeddedness and economic performance in different markets, finding a positive association in the domestic market, but a negative association in foreign markets. This divergence in performance is caused in part by selection bias in the access to foreign markets, and in part by accumulation of localized knowledge.","author_count":1,"contributors":["Andersen, Kristina Vaarst"],"cuid":["S01-000.00-276589"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"1 contributor","cluster_size":1,"keyword":["Embeddedness","Knowledge transfer","Opportunity allocation"],"level":"sci","mra":["soc"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS"]},"level3all":["DI-U-CBS"]},"review":"pr","rtype":["clu"],"sorti":"the problem of embeddedness revisited collaboration and market types","src":["cbs"],"src-code":["DI-U-CBS"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-276589","identifier":[{"id":"84870356728","type":"scopus"}],"ids":["cbs-0d184caf-ccba-4d04-8607-0c8b29769d36"],"keyword":["Embeddedness","Knowledge transfer","Opportunity allocation"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-4-22A955D472577102C688000A68693130"],"org":[{"affno":"1","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of Strategy and Innovation, Department of Innovation and Organizational Economics"],"nora_code":"DI-U-CBS","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Kristina","key":"vaarstandersenpau","last":"Vaarst Andersen","locid":"e64ee7c1-08fa-4113-947a-18da853e6a39","name":"Andersen, Kristina Vaarst","name_org":"Vaarst Andersen, Kristina","orcid":"0000-0002-0181-6832","rank":1,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.respol.2012.05.005","issn":["00487333"],"issue":"1","journal":"Research Policy","pages":"139-148","publisher":"Elsevier","status":"p","title":"Research Policy","volume":"42"},"review":"Peer Reviewed","scoID":["2-s2.0-84870356728"],"search":{"DAF":["All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["cbs-0d184caf-ccba-4d04-8607-0c8b29769d36"],"src":["CBS Copenhagen Business School"],"title":"The Problem of Embeddedness Revisited : Collaboration and Market Types","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-276589","year":"2013","yearsub":"2012"}
{"abstract":"Op gennem nullerne var det en udbredt antagelse at sygefraværet i Danmark var højt og stigende, og store reformer af sygedagpengeloven blev iværksat på den baggrund. Artiklen undersøger, om denne antagelse holder stik, og om flere mennesker virkelig var fraværende fra deres job på grund af sygdom op gennem nullerne end tilfældet var ti og tyve år tidligere. Desuden sættes der fokus på, hvordan sygedagpengelovens intentioner om et tættere tværsektorielt samarbejde mellem centrale aktører i sundhedssektoren og socialsektoren er blevet implementeret i praksis. Artiklen konkluderer, at det danske sygefravær har været stor set konstant gennem de sidste mange år, samt at det tværsektorielle samarbejde er hæmmet af et mangefacetteret sæt af barrierer omfattende såvel psykologiske faktorer som lav motivation og strukturelle faktorer som statslige styringsmekanismer.","author_count":4,"contributors":["Johansen, Kristina","Mikkelsen, Sigurd","Andersen, John Sahl","Lynge, Elsebeth"],"cuid":["S01-000.00-485974"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"sygefravær lovgivning udvikling og tværsektorielt samarbejde","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-485974","ids":["ku-9acaa596-49d3-4d03-9914-2e48d1c84a0e"],"lang":"Danish","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-2-1DA580CBBB93EA21DFCF8924D80F241A"],"oai":{"class":"Blocked","mra":["Medicine (MED)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Region Hovedstaden"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Public Health, Section of General Practice"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Kristina","key":"johansenpau","last":"Johansen","name":"Johansen, Kristina","rank":1,"rolecode":"pau"},{"affno":"","first":"Sigurd","key":"mikkelsenpau","last":"Mikkelsen","name":"Mikkelsen, Sigurd","rank":2,"rolecode":"pau"},{"affno":"2","first":"John Sahl","key":"andersenpau","last":"Andersen","locid":"45c9f771-6d3b-4f3c-aa4e-64bab16dc2fe","name":"Andersen, John Sahl","orcid":"0000-0001-7235-4359","rank":3,"rolecode":"pau"},{"affno":"2","first":"Elsebeth","key":"lyngepau","last":"Lynge","locid":"cba2839a-fffd-4b0e-8dad-dd5ba145924c","name":"Lynge, Elsebeth","orcid":"0000-0003-4785-5236","rank":4,"rolecode":"pau"}],"pub":{"issn":["13991442"],"issue":"2","journal":"Tidsskrift for Arbejdsliv","status":"p","title":"Tidsskrift for Arbejdsliv","volume":"15"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-9acaa596-49d3-4d03-9914-2e48d1c84a0e"],"src":["KU University of Copenhagen"],"title":"Sygefravær-lovgivning, udvikling og tværsektorielt samarbejde","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-485974","year":"2013","yearsub":"2013"}
