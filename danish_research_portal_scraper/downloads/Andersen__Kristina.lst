"floridapedh","last":"Florida","name":"Florida, Richard","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Bjørn T.","key":"asheimpedh","last":"Asheim","name":"Asheim, Bjørn T.","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Meric","key":"gertlerpedh","last":"Gertler","name":"Gertler, Meric","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"eisbn":["9780203094945"],"isbn":["9780415633611","9780415633604"],"pages":"103-116","place":"Abingdon","publisher":"Routledge","series":"Regions and Cities","status":"p","title":"The Creative Class Goes Global"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["cbs-e3801aaf-980c-464e-a142-11f842c81f23"],"src":["CBS Copenhagen Business School"],"title":"Different Creative Cities : Exploring Danish Data to Adapt the Creative Class Argument to Small Welfare Economies","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-297019","year":"2014","yearsub":"2013"}
{"abstract":"Background: Outcomes of colic treatment are of great interest to clinicians, horse owners and insurers. One commonly used criterion of success is the overall short-term survival rate. This is used as to compare treatments and to measure quality of veterinary care, but may be biased by demographic or social factors such as attitudes towards animal suffering and euthanasia. The aims of this study were to 1) describe and analyse characteristics in horses with signs of colic referred to the University Hospital for Large Animals (UHLA), University of Copenhagen, Denmark over a 10-year period and 2) to compare these rates with those published in other comparable studies. Results: The overall survival rate for colic horses over the 10-year study period was 68% (confidence intervals (CI): 66 – 71%; 1087/1588). In the medical group, 1093 horses, short-term survival was 87% (CI: 85 – 89%). Thirty one % of referred horses were given diagnoses requiring surgical intervention (CI: 29 – 33%). In this group 32% of the horses were euthanized before surgery (CI: 28 – 36%; 159/495). Of the surgical cases 27% (CI: 23-31%) were euthanized or died during surgery. Of the horses that recovered from surgery 25% died or were euthanized (CI: 19 – 32%; 48/189), while 75% survived to discharge (CI: 68 – 81%). Conclusions: The short term survival rates of Danish horses with colic were similar or lower to those reported from other countries. Apart from variability of veterinary care, attitudes towards euthanasia vary among the countries, which may bias the outcomes. This study indicates that qualitative interview studies on owners ’ attitudes towards animal suffering and euthanasia need to be conducted. Our opinion is that survival rates are not valid as sole indicators of quality of care in colic treatment due to selection bias. If the survival rates are to be compared between hospitals, techniques or surgeons, prospective studies including mutually agreed-on disease severity scores and a predefined set of reasons for euthanasia are needed.","author_count":6,"contributors":["Christophersen, Mogens Teken","Dupont, Nana Hee","Berg-Sørensen, Kristina S.","Konnerup, Christel","Pihl, Tina Holberg","Andersen, Pia H."],"cuid":["S01-000.00-538787"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"country":["Sweden"],"glorg":["All Global Affiliations","Swedish University of Agricultural Sciences"],"keyword":["Euthanasia","Faculty of Health and Medical Sciences","Quality of care","Surgery","Survival"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"short term survival and mortality rates in a retrospective study of colic in 000000001588 danish horses","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1186/1751-0147-56-20","version":"Other Version"},"id":"S01-000.00-538787","identifier":[{"id":"PMC3998380","type":"pmcid"},{"id":"84903754720","type":"scopus"},{"id":"24712831","type":"pmid"}],"ids":["ku-f385682b-90e9-4062-81a6-e60bc02c4502"],"keyword":["Disease Severity Score","Equine colic","Euthanasia","Faculty of Health and Medical Sciences","Surgery","Survival","quality of care"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-6D91B5B2A2EE540A8EAA5F226422B044"],"oa_link":[{"access":"oa","type":"rem","url":"http://www.actavetscand.com/content/pdf/1751-0147-56-20.pdf","version":"Other Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1186/1751-0147-56-20","version":"Other Version"}],"oai":{"class":"Blocked","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Veterinary Clinical Sciences, Section for Medicine and Surgery"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"se","key":"swedish university of agricultural sciences","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Swedish University of Agricultural Sciences","used":1}],"person":[{"affno":"1","first":"Mogens Teken","key":"christophersenpau","last":"Christophersen","locid":"a76c4644-550c-4f50-8d54-941e6d02cc7e","name":"Christophersen, Mogens Teken","orcid":"0000-0001-9090-7922","rank":1,"rolecode":"pau"},{"affno":"1","first":"Nana Hee","key":"dupontpau","last":"Dupont","locid":"2dbb21e5-265a-4d7c-ac54-ad0a4af795ff","name":"Dupont, Nana Hee","orcid":"0009-0007-8349-6046","rank":2,"rolecode":"pau"},{"affno":"1","first":"Kristina S.","key":"bergsørensenpau","last":"Berg-Sørensen","name":"Berg-Sørensen, Kristina S.","rank":3,"rolecode":"pau"},{"affno":"1","first":"Christel","key":"konneruppau","last":"Konnerup","name":"Konnerup, Christel","rank":4,"rolecode":"pau"},{"affno":"1","first":"Tina Holberg","key":"pihlpau","last":"Pihl","locid":"6bdf9d84-6ba5-4375-b590-2933b02d576d","name":"Pihl, Tina Holberg","orcid":"0000-0002-7714-0445","rank":5,"rolecode":"pau"},{"affno":"2","first":"Pia H.","key":"andersenpau","last":"Andersen","name":"Andersen, Pia H.","rank":6,"rolecode":"pau"}],"pmid":["24712831"],"pub":{"doi":"10.1186/1751-0147-56-20","issn":["0044605X","17510147"],"issn_org":["0044605X"],"journal":"Acta Veterinaria Scandinavica","paperid":"20","status":"p","title":"Acta Veterinaria Scandinavica","title_org":"Acta veterinaria Scandinavia","volume":"56"},"review":"Peer Reviewed","scoID":["2-s2.0-84903754720"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-f385682b-90e9-4062-81a6-e60bc02c4502"],"src":["KU University of Copenhagen"],"title":"Short-term survival and mortality rates in a retrospective study of colic in 1588 Danish horses","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-538787","year":"2014","yearsub":"2014"}
{"abstract":"The North Sea provides a useful model for considering forage fish (FF) within ecosystem-based management as it has a complex assemblage of FF species. This paper is designed to encourage further debate and dialogue between stakeholders about management objectives. Changing the management of fisheries on FF will have economic consequences for all fleets in the North Sea. The predators that are vulnerable to the depletion of FF are Sandwich terns, great skua and common guillemots, and to a lesser extent, marine mammals. Comparative evaluations of management strategies are required to consider whether maintaining the reserves of prey biomass or a more integral approach of monitoring mortality rates across the trophic system is more robust under the ecosystem approach. In terms of trophic energy transfer, stability, and resilience of the ecosystem, FF should be considered as both a sized-based pool of biomass and as species components of the system by managers and modellers. Policy developers should not consider the knowledge base robust enough to embark on major projects of ecosystem engineering. Management plans appear able to maintain sustainable exploitation in the short term. Changes in the productivity of FF populations are inevitable so management should remain responsive and adaptive","author_count":17,"contributors":["Dickey-Collas, Mark","Engelhard, Georg H.","Rindorf, Anna","Raab, Kristina","Smout, Sophie","Aarts, Geert","van Deurs, Mikael","Brunel, Thomas","Hoff, Ayoe","Lauerburg, Rebecca A.M.","Garthe, Stefan","Andersen, Ken Haste","Scott, F.","Kooten, Tobias van","Beare, D.","Peck, Myron A."],"cuid":["S02-092.50-038062"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["Asia, South","Europe, EU","Europe, Non-EU","OECD"],"country":["Germany","Malaysia","Netherlands","United Kingdom"],"glorg":["All Global Affiliations","Cefas Weymouth Laboratory","Cefas, Lowestoft","IMARES, IJmuiden","Kiel University","The World Fish Center, Penang","University of Hamburg","University of St Andrews","Wageningen University & Research","WorldFish"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["ICES, Copenhagen"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"ecosystem based management objectives for the north sea riding the forage fish rollercoaster","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1093/icesjms/fst075","version":"Other Version"},"id":"S02-092.50-038062","identifier":[{"id":"84890452864","type":"scopus"}],"ids":["dtu-f66d83da-29dc-4bb4-a8e8-0d2d5069c0bf","ku-56dc288a-d924-42b2-b7d7-c517e5607c41"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-5525AC14EC722D031397BE4CBCC204CB"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1093/icesjms/fst075","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2014","yearSub":"2013"},"org":[{"affno":"1","country":"nl","key":"wageningen university research","loc":["Netherlands","Europe, EU","OECD"],"name":"Wageningen University & Research","used":1},{"affno":"2","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["ICES, Copenhagen"],"nora_code":"DI-OT","used":1},{"affno":"3","country":"gb","key":"cefas weymouth laboratory","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Cefas Weymouth Laboratory","used":1},{"affno":"4","country":"gb","key":"cefas lowestoft","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Cefas, Lowestoft","used":1},{"affno":"5","ke