{"author_count":14,"contributors":["Palmgren, Michael","Edenbrandt, Anna Kristina","Vedel, Suzanne Elizabeth","Andersen, Martin Marchman","Landes, Xavier","Østerberg, Jeppe Thulin","Falhof, Janus","Olsen, Lene Irene","Christensen, Søren Brøgger","Sandøe, Peter","Gamborg, Christian","Kappel, Klemens","Thorsen, Bo Jellesmark","Pagh, Peter"],"cuid":["S01-000.00-544071"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"are we ready for back to nature crop breeding","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.tplants.2014.11.003","version":"Other Version"},"id":"S01-000.00-544071","identifier":[{"id":"84924079021","type":"scopus"}],"ids":["ku-fc572bae-75a4-4421-8d05-c8040bbc4bd8"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-A566A1EF483F32D51B8D499DEF8012D6"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.tplants.2014.11.003","version":"Other Version"}],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Plant and Environmental Sciences, Section for Transport Biology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Michael Broberg","key":"palmgrenpau","last":"Palmgren","locid":"28d7c382-c542-4a79-83e5-b479c3fe763e","name":"Palmgren, Michael","name_org"