":"","corresponding":null,"first":"Preben F.","key":"bjørnsenpau","last":"Bjørnsen","name":"Bjørnsen, Preben F.","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Kristina","key":"beckleypau","last":"Beckley","name":"Beckley, Kristina","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jesper","key":"mougaardpau","last":"Mougaard","name":"Mougaard, Jesper","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Vicki","key":"nørtoftpau","last":"Nørtoft","name":"Nørtoft, Vicki","rank":6,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All University Colleges","DI-ALL","DI-UC","DI-UC-ALL","University Colleges","VIA University College"],"PST":["Published"]},"sid":["via-db42f9fa-2a21-48a3-abc8-e9e31362de81"],"src":["VIA University College"],"title":"Se, min lærer danser. Om bulderbasser, nørder, prinsesser og hjemmelavede kajakker - en undersøgelse af kønskonstruktioner i naturfagene på mellemtrinnet","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-661073","year":"2013","yearsub":"2013"}
{"abstract":"This study examines the meaning of dependency on care as experienced by intensive care patients. Literature on the subject is sparse, but research from nonintensive settings shows that dependency is often experienced negatively. The study is based on in-depth qualitative semistructured interviews with three former patients characterized as narratives. The analysis is inspired by a phenomenological hermeneutical method. The study has found that dependency is experienced as difficult and that the experience seems to be attached to the relationship to oneself. Patients feel powerless and experience shame, their understanding of self is threatened, and they fight for independence in the course after intensive care. The findings might be influenced by the study being conducted in a Western country setting, where independence is valued. They can be used as means of reflection on nursing practice and matters such as communication and patient participation.","author_count":3,"contributors":["Lykkegaard Andersen, Kristina","Delmar, Charlotte"],"cuid":["S02-093.94-005291"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-NDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-HO-NDR","DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"a threat to the understanding of oneself intensive care patients experiences of dependency","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.3402/qhw.v8i0.20934","version":"Other Version"},"id":"S02-093.94-005291","identifier":[{"id":"23809023","type":"pmid"},{"id":"84880300447","type":"scopus"},{"id":"WOS:000321187100001","type":"wos"},{"id":"PMC3697396","type":"pmcid"}],"ids":["aau-6ceca8ea-0afe-4ec0-ac5d-29d64a093127","au-dcec3f9e-dcf5-41c2-bcc9-4c07c0d22138"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-3CE62497D758CEB78DA1F5CDB540DEE5"],"oa_link":[{"access":"oa","type":"rem","url":"http://www.ncbi.nlm.nih.gov/pmc/articles/PMC3697396/","version":"Other Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.3402/qhw.v8i0.20934","version":"Other Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Anæstesi og Intensiv [Klinik Akut]","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Anæstesi"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"dk","key":"north denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-NDR","l3nl":"North Denmark Region","l3nn":"North Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"North Denmark Region","namevar":["Aalborg University Hospital"],"nora_code":"DI-HO-NDR","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Public Health, Department of Public Health - Department of Science in Nursing"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Kristina","key":"lykkegaardandersenpau","last":"Lykkegaard Andersen","locid":"e0dc3452-893d-4c31-890f-a0103948d384","name":"Lykkegaard Andersen, Kristina","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Kristina","key":"lykkegaardpau","last":"Lykkegaard","name":"Lykkegaard, Kristina","rank":1,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"country":"dk","first":"Charlotte","key":"delmarpau","last":"Delmar","locid":"71412a14-4fae-4014-8abe-362cfa49270c","name":"Delmar, Charlotte","orcid":"0000-0001-9455-4511","rank":2,"rolecode":"pau"}],"pmid":["23809023"],"pub":{"doi":"10.3402/qhw.v8i0.20934","issn":["17482623","17482631"],"issn_org":["17482623"],"issue":"8","journal":"International Journal of Qualitative Studies on Health and Well-Being","paperid":"20934","publisher":"Taylor and Francis Ltd.","status":"p","title":"International Journal of Qualitative Studies on Health and Well-Being","volume":"28"},"review":"Peer Reviewed","scoID":["2-s2.0-84880300447"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Universities"],"PST":["Published"]},"sid":["aau-6ceca8ea-0afe-4ec0-ac5d-29d64a093127","au-dcec3f9e-dcf5-41c2-bcc9-4c07c0d22138"],"src":["AAU Aalborg University","AU Aarhus University"],"title":"A threat to the understanding of oneself : Intensive care patients' experiences of dependency","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-093.94-005291","year":"2013","yearsub":"2013"}
{"abstract":"Colorectal cancer (CRC) is one of the leading causes of cancer deaths in Western countries. A significant number of CRC patients undergoing curatively intended surgery subsequently develop recurrence and die from the disease. MicroRNAs (miRNAs) are aberrantly expressed in cancers and appear to have both diagnostic and prognostic significance. In this study, we identified novel miRNAs associated with recurrence of CRC, and their possible mechanism of action. TaqMan® Human MicroRNA Array Set v2.0 was used to profile the expression of 667 miRNAs in 14 normal colon mucosas and 46 microsatellite stable CRC tumors. Four miRNAs (miR-362-3p, miR-570, miR-148 a* and miR-944) were expressed at a higher level in tumors from patients with no recurrence (p<0.015), compared with tumors from patients with recurrence. A significant association with increased disease free survival was confirmed for miR-362-3p in a second independent cohort of 43 CRC patients, using single TaqMan® microRNA assays. In vitro functional analysis showed that over-expression of miR-362-3p in colon cancer cell lines reduced cell viability, and proliferation mainly due to cell cycle arrest. E2F1, USF2 and PTPN1 were identified as potential miR-362-3p targets by mRNA profiling of HCT116 cells over-expressing miR-362-3p. Subsequently, these genes were confirmed as direct targets by Luciferase reporter assays and their knockdown in vitro phenocopied the effects of miR-362-3p over-expression. We conclude that miR-362-3p may be a novel prognostic marker in CRC, and hypothesize that the positive effects of augmented miR-362-3p expression may in part be mediated through the targets E2F1, USF2 and PTPN1.","author_count":19,"contributors":["Christensen, Lise Lotte","Tobiasen, Heidi","Holm, Anja","Schepeler, Troels","Ostenfeld, Marie Stampe","Thorsen, Kasper","Rasmussen, Mads Heilskov","Birkenkamp-Demtröder, Karin","Sieber, Oliver M","Gibbs, Peter","Lubinski, Jan","Lamy, Philippe","Laurberg, Søren","Øster, Bodil","Hansen, Kristian Qvist","Hagemann-Madsen, Rikke","Byskov, Kristina","Ørntoft, Torben Falck","Andersen, Claus Lindbjerg"],"cuid":["S01-000.00-179516"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Poland"],"glorg":["All Global Affiliations","Pomeranian Medical University in Szczecin"],"keyword":["Colorectal cancer","Recurrence","Target identification"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR"],"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-HO-CDR","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"mirna 000000000362 000000000003p induces cell cycle arrest through targeting of e000000000002f000000000001 usf000000000002 and ptpn000000000001 and is associated with recurrence of colorectal cancer","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1002/ijc.28010","version":"Other Version"},"id":"S01-000.00-179516","identifier":[{"id":"23280316","type":"pmid"},{"id":"84876673829","type":"scopus"}],"ids":["au-58066420-e424-4106-8103-5c0d4aaa59df"],"keyword":["colorectal cancer","miR-362-3p","miRNA expression profiling","recurrence","target identification"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-B784DFBCFE78A88DD7DC14CA08F6094F"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1002/ijc.28010","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Molecular Medicine (MOMA)"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1},{"affno":"3","country":"pl","key":"pomeranian medical university in szczecin","loc":["Poland","Europe, EU","OECD"],"name":"Pomeranian Medical University in Szczecin","used":1},{"affno":"4","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital (AUH)"],"nora_code":"DI-HO-CDR","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Lise Lotte","key":"christensenpau","last":"Christensen","locid":"47852ca5-8304-4dfe-9ef7-4d40fc61ab32","name":"Christensen, Lise Lotte","orcid":"0000-0001-5622-3068","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Heidi","key":"tobiasenpau","last":"Tobiasen","locid":"7b4de8fa-dae7-4797-89e4-bbf533d42644","name":"Tobiasen, Heidi","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anja","key":"holmpau","last":"Holm","locid":"31ee8296-f171-4a15-bcf2-09ff028d1723","name":"Holm, Anja","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Troels","key":"schepelerpau","last":"Schepeler","locid":"46fba6bb-0af8-431d-8e29-39d61b604d7b","name":"Schepeler, Troels","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Marie Stampe","key":"ostenfeldpau","last":"Ostenfeld","locid":"0a888956-66b0-482a-a9ee-5bc6ed78ebcd","name":"Ostenfeld, Marie Stampe","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"