608-5604","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kristina Vaarst","key":"andersenpau","last":"Andersen","locid":"a1d488b0-5bf1-4eee-bdd5-cfe37a89528a","name":"Andersen, Kristina Vaarst","orcid":"0000-0002-0181-6832","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mehdi","key":"savaghebipau","last":"Savaghebi","locid":"7ebeb655-301a-474f-864b-63251327d474","name":"Savaghebi, Mehdi","orcid":"0000-0001-6188-0265","rank":3,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","sdg":["7. Affordable and Clean Energy","9. Industry, Innovation, and Infrastructure","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-dba0297e-e9ac-4a61-b017-978d78ea1dbb"],"src":["DTU Technical University of Denmark"],"title":"Accelerating the Diffusion of Industrial Microgrids: The Role and Potential of Industrial Cluster Organizations as Intermediaries","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-818103","year":"2025","yearsub":"2025"}
{"abstract":"Objective: Integrin α10β1-selected mesenchymal stem cells (integrin α10-MSCs) have previously shown potential in treating cartilage damage and osteoarthritis (OA) in vitro and in animal models in vivo. The aim of this study was to further investigate disease-modifying effects of integrin α10-MSCs. Design: OA was surgically induced in 17 horses. Eighteen days after surgery, horses received 2 × 107 integrin α10-MSCs intra-articularly or were left untreated. Lameness and response to carpal flexion was assessed weekly along with synovial fluid (SF) analysis. On day 52 after treatment, horses were euthanized, and carpi were evaluated by computed tomography (CT), MRI, histology, and for macroscopic pathology and integrin α10-MSCs were traced in the joint tissues. Results: Lameness and response to carpal flexion significantly improved over time following integrin α10-MSC treatment. Treated horses had milder macroscopic cartilage pathology and lower cartilage histology scores than the untreated group. Prostaglandin E2 and interleukin-10 increased in the SF after integrin α10-MSC injection. Integrin α10-MSCs were found in SF from treated horses up to day 17 after treatment, and in the articular cartilage and subchondral bone from 5 of 8 treated horses after euthanasia at 52 days after treatment. The integrin α10-MSC injection did not cause joint flare. Conclusion: This study demonstrates that intra-articular (IA) injection of integrin α10-MSCs appears to be safe, alleviate pathological changes in the joint, and improve joint function in an equine post-traumatic osteoarthritis (PTOA) model. The results suggest that integrin α10-MSCs hold promise as a disease-modifying osteoarthritis drug (DMOAD).","author_count":9,"contributors":["Andersen, Camilla","Jacobsen, Stine","Uvebrant, Kristina","Griffin, John F.","Vonk, Lucienne Angela","Walters, Marie","Berg, Lise Charlotte","Lundgren-Åkerlund, Evy","Lindegaard, Casper"],"cuid":["S01-000.00-820524"],"filters":{"added":"2025-08","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","Europe, EU","Nordic","OECD"],"country":["Sweden","United States"],"glorg":["All Global Affiliations","Texas A&M University","Xintela AB"],"keyword":["Articular cartilage","Immunomodulation","Mesenchymal stem cells","Pain"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"integrin α000000000010β000000000001 selected mesenchymal stem cells reduce pain and cartilage degradation and increase immunomodulation in an equine osteoarthritis model","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1177/19476035231209402","version":"Published Version"},"id":"S01-000.00-820524","identifier":[{"id":"85177586854","type":"scopus"},{"id":"PMC12086101","type":"pmcid"},{"id":"37990503","type":"pmid"}],"ids":["ku-fd502324-fd12-46e1-8cd0-572756e897cf"],"keyword":["articular cartilage","immunomodulation","mesenchymal stem cells","osteoarthritis disease modification","pain"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-77299C89C592580B4C7BA4AEEDBF371C"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1177/19476035231209402","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://curis.ku.dk/ws/files/456422926/integrin-a10b1-selected-mesenchymal-stem-cells-reduce-pain-and-cartilage-degradation-and-increase.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Cop