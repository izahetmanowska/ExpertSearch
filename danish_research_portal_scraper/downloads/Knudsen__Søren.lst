":"efda4431-8540-464f-8a4d-6cb5fa622474","name":"Guldbrandsen, Karen","orcid":"0000-0001-6634-0823","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Søren","key":"lundepau","last":"Lunde","name":"Lunde, Søren","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Inge Søkilde","key":"pedersenpau","last":"Pedersen","locid":"a3b6feb6-0d43-4dd7-870c-e6e493108acd","name":"Pedersen, Inge Søkilde","orcid":"0000-0002-9902-8040","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Henrik Bygum","key":"kraruppau","last":"Krarup","locid":"72b4ebce-12cf-4f92-bb97-c9a588b06d57","name":"Krarup, Henrik","name_org":"Krarup, Henrik Bygum","orcid":"0000-0001-5294-2428","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Aage","key":"knudsenpau","last":"Knudsen","locid":"8d560374-b41c-4ba0-bf36-8d7b0e023e97","name":"Knudsen, Aage","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ulrik Schiøler","key":"kesmodelpau","last":"Kesmodel","locid":"874905db-9134-43c7-83be-94f4fc6d8b62","name":"Kesmodel, Ulrik Schiøler","orcid":"0000-0003-3868-106X","rank":6,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-7338cff3-799d-4d0f-9ee9-363f4c2ac122"],"src":["AAU Aalborg University"],"title":"NMR spectroscopy and Ovarian Cancer - Exploring an emerging method for early diagnosis and prognosis of ovarian cancer","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-794667","year":"2024","yearsub":"2024"}
{"abstract":"Digital transformations within educational systems are recurrently justified by their promise to enhance learning activities and outcomes. We examine this claim in a study of pupils’ perception and experiences with computer-based adaptive tests in higher classes in Danish public primary schools. The study relies on survey and interview data and addresses whether pupils perceive their participation in computer-based adaptive tests as contributing to their learning and the degree to which the perception of teachers’ attitude to the test influences their learning. A majority perceives their learning as low or non-existing. However, the perception of a more positive teacher attitude is related to more substantial learning. Theoretically, we attribute this relationship to the effect of self-fulfilling prophecies in the classroom. Learning also differs for subgroups related to gender and ability level. The findings contribute to discussions about educational policy, management, and the digital transformation of educational systems.","author_count":3,"contributors":["Lindholst, Andrej Christian","Eriksen, Tobias Bøgeskov","Knudsen, Søren Valgreen"],"cuid":["S01-000.00-097438"],"filters":{"added":"2023-05","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Lindholst, Andrej Christian"],"keyword":["Digital technologies","Learning outcomes","Performance test","Primary education","national tests"],"level":"sci","mra":["soc"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Aalborg Municipality"],"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"danish school pupils perception of their learning outcomes from participating in computer based adaptive tests a pressure for just clicking something","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.ssh.aau.dk/kan-centralt-udrullede-digitale-malevaerktojer-bruges-i-folkeskolen-n84536","version":"Other Version"},"id":"S01-000.00-097438","identifier":[{"id":"85162944957","type":"scopus"}],"ids":["aau-a37ec8e3-3ae5-4a8c-bb7f-1ac433b2f2c8"],"keyword":["Digital technologies","Pygmalion-effect","learning outcomes","national tests","performance test","primary education"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-4-CE10E5D11F408BFDA461A34F8CB07AA1"],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Social Sciences and Humanities","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Politics and Society","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Politics and Society, Public Administration & Digitalization"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Aalborg Municipality"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Christian","key":"lindholstpau","last":"Lindholst","locid":"c5126b02-afdf-4131-91e2-90c30307d87b","name":"Lindholst, Andrej Christian","name_org":"Lindholst, Christian","orcid":"0000-0001-8301-6187","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Tobias Bøgeskov","key":"eriksenpau","last":"Eriksen","name":"Eriksen, Tobias Bøgeskov","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren Valgreen","key":"knudsenpau","last":"Knudsen","locid":"d59094b5-44a6-4398-9acf-f3f530e0504b","name":"Knudsen, Søren Valgreen","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1080/00313831.2023.2228823","issn":["00313831","14701170"],"issn_org":["00313831"],"issue":"6","journal":"Scandinavian Journal of Educational Research","pages":"1186-1202","publisher":"Routledge","status":"p","title":"Scandinavian Journal of Educational Research","volume":"68"},"review":"Peer Reviewed","scoID":["2-s2.0-85162944957"],"sdg":["4. Quality Education","All UN SDG Classification"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["aau-a37ec8e3-3ae5-4a8c-bb7f-1ac433b2f2c8"],"src":["AAU Aalborg University"],"title":"Danish school pupils’ perception of their learning outcomes from participating in computer-based adaptive tests : A pressure for just clicking something?","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-097438","year":"2024","yearsub":"2024"}
{"abstract":"This paper is a call to action for research and discussion on data visualization education. As visualization evolves and spreads through our professional and personal lives, we need to understand how to support and empower a broad and diverse community of learners in visualization. Data Visualization is a diverse and dynamic discipline that combines knowledge from different fields, is tailored to suit diverse audiences and contexts, and frequently incorporates tacit knowledge. This complex nature leads to a series of interrelated challenges for data visualization education. Driven by a lack of consolidated knowledge, overview, and orientation for visualization education, the 21 authors of this paper - educators and researchers in data visualization - identify and describe 19 challenges informed by our collective practical experience. We organize these challenges around seven themes People, Goals & Assessment, Environment, Motivation, Methods, Materials, and Change. Across these themes, we formulate 43 research questions to address these challenges. As part of our call to action, we then conclude with 5 cross-cutting opportunities and respective action items: embrace DIVERSITY+INCLUSION, build COMMUNITIES, conduct RESEARCH, act AGILE, and relish RESPONSIBILITY. We aim to inspire researchers, educators and learners to drive visualization education forward and discuss why, how, who and where we educate, as we learn to use visualization to address challenges across many scales and many domains in a rapidly changing world: viseducationchallenges.github.io.","author_count":21,"contributors":["Bach, Benjamin","Keck, Mandy","Rajabiyazdi, Fateme","Losev, Tatiana","Meirelles, Isabel","Dykes, Jason","Laramee, Robert S.","Alkadi, Mashael","Stoiber, Christina","Huron, Samuel","Perin, Charles","Morais, Luiz","Aigner, Wolfgang","Kosminsky, Doris","Boucher, Magdalena","Knudsen, Søren","Manataki, Areti","Aerts, Jan","Hinrichs, Uta","Roberts, Jonathan C.","Carpendale, Sh