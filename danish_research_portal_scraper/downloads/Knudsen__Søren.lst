irst":"Zitta Barrella","key":"harboezittabarrellapau","last":"Harboe","locid":"2b596a33-5659-4236-b5ea-c0991866af44","name":"Harboe, Zitta Barrella","orcid":"0000-0001-5552-0095","rank":17,"rolecode":"pau"},{"affno":"1","first":"Michael","key":"perchmichaelpau","last":"Perch","locid":"e0a136a6-8b36-4735-9db2-8847ce581fc6","name":"Perch, Michael","rank":18,"rolecode":"pau"},{"affno":"1","first":"Søren Schwartz","key":"sørensensørenschwartzpau","last":"Sørensen","locid":"115ed8b6-8f6c-468a-9217-994613816c8e","name":"Sørensen, Søren Schwartz","rank":19,"rolecode":"pau"},{"affno":"1","first":"Allan","key":"rasmussenallanpau","last":"Rasmussen","locid":"5f442b2b-52d8-4795-a132-165b9f2d68b1","name":"Rasmussen, Allan","rank":20,"rolecode":"pau"},{"affno":"1","first":"Henning","key":"bundgaardhenningpau","last":"Bundgaard","locid":"254c7f8d-79dd-4a5d-870f-3ed78cb56464","name":"Bundgaard, Henning","rank":21,"rolecode":"pau"},{"affno":"1","first":"Peter","key":"garredpeterpau","last":"Garred","locid":"854d72a7-c955-43b5-b455-b7ea1f9bcb1e","name":"Garred, Peter","rank":22,"rolecode":"pau"},{"affno":"1","first":"Kasper","key":"iversenkasperpau","last":"Iversen","locid":"558df261-ca9f-440a-8bee-7d38813c253f","name":"Iversen, Kasper","rank":23,"rolecode":"pau"},{"affno":"1","first":"Susanne Dam","key":"nielsensusannedampau","last":"Nielsen","locid":"2baa36fa-2709-482a-9595-52c5b9537801","name":"Nielsen, Susanne Dam","rank":24,"rolecode":"pau"}],"pmid":["35281023"],"pub":{"doi":"10.3389/fimmu.2022.832501","issn":["16643224"],"journal":"Frontiers in Immunology","paperid":"832501","status":"p","title":"Frontiers in Immunology","volume":"13"},"review":"Peer Reviewed","scoID":["2-s2.0-85126411967"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-459ed3d5-8175-41f1-a980-aaa4e14915e7"],"src":["KU University of Copenhagen"],"title":"Decline in Antibody Concentration 6 Months After Two Doses of SARS-CoV-2 BNT162b2 Vaccine in Solid Organ Transplant Recipients and Healthy Controls","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-434992","year":"2022","yearsub":"2022"}
{"abstract":"Objectives: Bloodstream infections (BSI) are prevalent after solid organ transplantation (SOT). In this study, we aimed to investigate the incidence and risk factors for BSI in the first 5 years post-transplantation. Methods: The study included 1322 SOT (kidney, liver, lung and heart) recipients transplanted from 2010 to 2017 with a total of 5616 years of follow-up. Clinical characteristics and microbiology were obtained from the Centre of Excellence for Personalized Medicine of Infectious Complications in Immune Deficiency (PERSIMUNE) data repository with nationwide follow-up. Incidence was investigated in the different SOT groups. Risk factors associated with BSI were assed in the combined group in time-updated multivariable Cox regressions. Results: The cumulative incidence of first BSI in the first 5 years post-transplantation differed in the SOT groups with a lower incidence in heart transplant recipients than in the other SOT groups (heart: 4.4%, CI 0.0–9.7%, vs. kidney: 24.6%, CI 20.9–28.2%, liver: 24.7%, CI 19.4–29.9%, and lung: 19.6%, CI 14.5–24.8%, p <0.001). Age above 55 years (HR 1.71, CI 1.2–2.4, p=0.002) and higher Charlson comorbidity index score (HR per unit increase: 1.25, CI 1.1–1.4, p<0.001) at transplantation, current cytomegalovirus (CMV) infection (HR 4.5, CI 2.6–7.9, p<0.001) and current leucopenia (HR 13.3, CI 3.7–47.9, p<0.001) were all associated with an increased risk of BSI. Conclusion: In SOT recipients, the incidence of BSI differed with the type of transplanted organ. Risk of BSI was higher in older recipients and in recipients with comorbidity, current CMV infection or leucopenia. Thus, increased attention towards BSI in recipients with these characteristics is warranted.","author_count":11,"contributors":["Møller, Dina Leth","Sørensen, Søren Schwartz","Perch, Michael","Gustafsson, Finn","Rezahosseini, Omid","Knudsen, Andreas D.","Scheike, Thomas","Knudsen, Jenny Dahl","Lundgren, Jens","Rasmussen, Allan","Nielsen, Susanne Dam"],"cuid":["S01-000.00-464207"],"filters":{"added":"2022-04","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Bacteraemia","Incidence","Risk Factors","Transplantation"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"bacterial and fungal bloodstream infections in solid organ transplant recipients results from a danish cohort with nationwide follow up","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-464207","identifier":[{"id":"34325067","type":"pmid"},{"id":"85113281696","type":"scopus"}],"ids":["ku-764c18f5-e542-4908-9f31-368ce70534eb"],"keyword":["Bacteraemia","Fungaemia","Incidence","Risk factors","Transplantation"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-2814B9FD27D01A287C1977010A9E7CEC"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","first":"Dina Leth","key":"møllerdinalethpau","last":"Møller","locid":"8d5cc577-14db-4efa-9db9-72b979611644","name":"Møller, Dina Leth","rank":1,"rolecode":"pau"},{"affno":"1","first":"Søren Schwartz","key":"sørensensørenschwartzpau","last":"Sørensen","locid":"115ed8b6-8f6c-468a-9217-994613816c8e","name":"Sørensen, Søren Schwartz","rank":2,"rolecode":"pau"},{"affno":"1","first":"Michael","key":"perchmichaelpau","last":"Perch","locid":"e0a136a6-8b36-4735-9db2-8847ce581fc6","name":"Perch, Michael","rank":3,"rolecode":"pau"},{"affno":"1","first":"Finn","key":"gustafssonfinnpau","last":"Gustafsson","locid":"6716eef1-891b-4209-a823-e96e765b9433","name":"Gustafsson, Finn","rank":4,"rolecode":"pau"},{"affno":"1","first":"Omid","key":"rezahosseiniomidpau","last":"Rezahosseini","locid":"25f086c7-0215-450d-a148-0fd4745377ea","name":"Rezahosseini, Omid","orcid":"0000-0003-2198-1904","rank":5,"rolecode":"pau"},{"affno":"1","first":"Andreas Dehlbæk","key":"knudsenandreasdpau","last":"Knudsen","locid":"fbeb64c3-4995-4397-8457-b4c20c93dc7a","name":"Knudsen, Andreas D.","name_org":"Knudsen, Andreas Dehlbæk","rank":6,"rolecode":"pau"},{"affno":"1","first":"Thomas","key":"scheikethomaspau","last":"Scheike","locid":"53de2123-e34e-44a3-945f-265fce28de25","name":"Scheike, Thomas","orcid":"0000-0002-2148-4740","rank":7,"rolecode":"pau"},{"affno":"1","first":"Jenny Dahl","key":"knudsenjennydahlpau","last":"Knudsen","locid":"ace82a97-ed40-44ae-9619-37b98fdaf285","name":"Knudsen, Jenny Dahl","rank":8,"rolecode":"pau"},{"affno":"1","first":"Jens","key":"lundgrenjenspau","last":"Lundgren","locid":"af310f7a-c49b-4381-bcb4-cf56e3fd80d8","name":"Lundgren, Jens","orcid":"0000-0001-8901-7850","rank":9,"rolecode":"pau"},{"affno":"2","first":"Allan","key":"rasmussenallanpau","last":"Rasmussen","name":"Rasmussen, Allan","rank":10,"rolecode":"pau"},{"affno":"1","first":"Susanne Dam","key":"nielsensusannedampau","last":"Nielsen","locid":"2baa36fa-2709-482a-9595-52c5b9537801","name":"Nielsen, Susanne Dam","rank":11,"rolecode":"pau"}],"pmid":["34325067"],"pub":{"doi":"10.1016/j.cmi.2021.07.021","issn":["1198743X","14690691"],"issn_org":["1198743X"],"issue":"3","journal":"Clinical Microbiology and Infection","pages":"391-397","status":"p","title":"Clinical Microbiology and Infection","volume":"28"},"review":"Peer Reviewed","scoID":["2-s2.0-85113281696"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-764c18f5-e542-4908-9f31-368ce70534eb"],"src":["KU University of Copenhagen"],"title":"Bacterial and fungal bloodstream infections in solid organ transplant recipients : results from a Danish cohort with nationwide follow-up","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-464207","year":"2022","yearsub":"2022"}
{"abstract":"Coronavirus disease 2019 (COVID-19) caused by SARS-CoV-2 has been associated with a high risk of adverse outcomes in solid organ transplant (SOT) recipients in the pre-vaccination era. In this retrospective cohort study, we examined the incidence and severity of COVID-19 in kidney and liver transplant recipients in Denmark in the post-vaccination era, from December 27, 2020, to December 27, 2021. We included 1428 SOT recipients with 143 cases of first-positive SARS-CoV-2 PCR test. The cumulative incidence of first-positive SARS-CoV-2 PCR test 1 year after initiation of vaccination was 10.4% (95% CI: 8.8–12.0), and the incidence was higher in kidney than in liver transplant recipients (11.6% [95% CI: 9.4–13.8] vs. 7.4% [95% CI: 5.1–9.8], p =.009). After the first-positive SARS-CoV-2 PCR test, the hospitalization rate was 31.5% (95% CI: 23.9–39.1), and 30-day all-cause mortality was 3.7% (95% CI: 0.5–6.8). Hospitalization was lower in vaccinated than in unvaccinated SOT recipients (26.4% [95% CI: 18.1–34.6] vs. 48.5% [95% CI: 31.4–65.5], p =.011), as was mortality (1.8% [95% CI: 0.0–4.3] vs. 9.1% [95% CI: 0.0–18.9], p =.047). In conclusion, SOT recipients remain at high risk of adverse outcomes after SARS-CoV-2 infections, with a lower risk observed in vaccinated than in unvaccinated SOT recipients.","author_count":12,"contributors":["Hamm, Sebastian Rask","Rezahosseini, Omid","Møller, Dina Leth","Loft, Josefine Amalie","Poulsen, Johan Runge","Knudsen, Jenny Dahl","Pedersen, Martin Schou","Schønning, Kristian","Harboe, Zitta Barrella","Rasmussen, Allan","Sørensen, Søren Schwartz","Nielsen, Susanne Dam"],"cuid":["S01-000.00-542192"],"filters":{"added":"2023-02","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Infectious disease","Solid organ transplantation","Vaccine","clinical research practice","infection and infectious agents viral SARS CoV 2 COVID 19","patient survival"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"incidence and severity of sars cov 000000000002 infections in liver and kidney transplant recipients in the post vaccination era real life data from denmark","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1111/ajt.17141","version":"Published Version"},"id":"S01-000.00-542192","identifier":[{"id":"85134774932","type":"scopus"},{"id":"PMC9349423","type":"pmcid"},{"id":"35801693","type":"pmid"}],"ids":["ku-f9456c35-1009-4e6f-b647-89483093ed04"],"keyword":["clinical research/practice","infection and infectious agents – viral: SARS-CoV-2/COVID-19","infectious disease","patient survival","solid organ transplantation","vaccine"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-0294E8E6084CB94C2F56D388A53D8B75"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://curis.ku.dk/ws/files/326728770/American_J_Transplantation_2022_Hamm_Incidence_and_severity_of_SARS_CoV_2_infections_in_liver_and_kidney_transplant.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1111/ajt.17141","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Clinical Microbiology","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Sebastian Rask","key":"hammpau","last":"Hamm","name":"Hamm, Sebastian Rask","rank":1,"rolecode":"pau"},{"affno":"1","first":"Omid","key":"rezahosseinipau","last":"Rezahosseini","name":"Rezahosseini, Omid","rank":2,"rolecode":"pau"},{"affno":"1","first":"Dina Leth","key":"møllerpau","last":"Møller","name":"Møller, Dina Leth","rank":3,"rolecode":"pau"},{"affno":"1","first":"Josefine Amalie","key":"loftpau","last":"Loft","name":"Loft, Josefine Amalie","rank":4,"rolecode":"pau"},{"affno":"1","first":"Johan Runge","key":"poulsenpau","last":"Poulsen","name":"Poulsen, Johan Runge","rank":5,"rolecode":"pau"},{"affno":"1","first":"Jenny Dahl","key":"knudsenpau","last":"Knudsen","name":"Knudsen, Jenny Dahl","rank":6,"rolecode":"pau"},{"affno":"1","first":"Martin Schou","key":"pedersenpau","last":"Pedersen","name":"Pedersen, Martin Schou","rank":7,"rolecode":"pau"},{"affno":"2","first":"Kristian","key":"schønningpau","last":"Schønning","locid":"17301a86-39e7-44c0-bdf3-12e0c55b9b18","name":"Schønning, Kristian","rank":8,"rolecode":"pau"},{"affno":"2","first":"Zitta Barrella","key":"harboepau","last":"Harboe","locid":"2b596a33-5659-4236-b5ea-c0991866af44","name":"Harboe, Zitta Barrella","orcid":"0000-0001-5552-0095","rank":9,"rolecode":"pau"},{"affno":"1","first":"Allan","key":"rasmussenpau","last":"Rasmussen","name":"Rasmussen, Allan","rank":10,"rolecode":"pau"},{"affno":"2","first":"Søren Schwartz","key":"sørensenpau","last":"Sørensen","locid":"115ed8b6-8f6c-468a-9217-994613816c8e","name":"Sørensen, Søren Schwartz","rank":11,"rolecode":"pau"},{"affno":"2","first":"Susanne Dam","key":"nielsenpau","last":"Nielsen","locid":"2baa36fa-2709-482a-9595-52c5b9537801","name":"Nielsen, Susanne Dam","rank":12,"rolecode":"pau"}],"pmid":["35801693"],"pub":{"doi":"10.1111/ajt.17141","issn":["16006135","16006143"],"issn_org":["16006135"],"issue":"11","journal":"American Journal of Transplantation","pages":"2637-2650","status":"p","title":"American Journal of Transplantation","volume":"22"},"review":"Peer Reviewed","scoID":["2-s2.0-85134774932"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-f9456c35-1009-4e6f-b647-89483093ed04"],"src":["KU University of Copenhagen"],"title":"Incidence and severity of SARS-CoV-2 infections in liver and kidney transplant recipients in the post-vaccination era : Real-life data from Denmark","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-542192","year":"2022","yearsub":"2022"}
{"abstract":"BackgroundHormonal contraceptive (HC) use has been associated with an increased risk of developing a depressive episode. This might be related to HC's effect on the serotonergic brain system as suggested by recent cross-sectional data from our group, which show that healthy oral contraceptive (OC) users relative to non-users have lower cerebral serotonin 4 receptor (5-HT4R) levels. Here, we determine if cerebral 5-HT4R binding differs between HC non-users, OC users, and hormonal intrauterine device (HIUD) users among women with an untreated depressive episode. Also, we test if antidepressant drug treatment response and its association with pre-treatment 5-HT4R binding depends on HC status. Methods[C-11]-SB207145 Positron Emission Tomography imaging data from the NeuroPharm-NP1 Study (NCT02869035) were available from 59 depressed premenopausal women, of which 26 used OCs and 10 used HIUDs. The participants were treated with escitalopram. Treatment response was measured as the relative change in the Hamilton Depression Rating Scale 6 items (r Delta HAMD(6)) from baseline to week eight. Latent variable models were used to evaluate the association between global 5-HT4R binding and OC and HIUD use as well as r Delta HAMD(6). ResultsWe found no evidence of a difference in global 5-HT4R binding between depressed HC users and non-users (p >= 0.51). A significant crossover interaction (p=0.02) was observed between non-users and OC users in the association between baseline global 5-HT4R binding and week eight r Delta HAMD(6); OC users had 3-4% lower binding compared to non-users for every 10% percent less improvement in HAMD(6). Within the groups, we observed a trend towards a positive association in non-users (p(adj)=0.10) and a negative association in OC users (p(adj)=0.07). We found no strong evidence of a difference in treatment response between the groups (p=0.13). ConclusionsWe found no difference in 5-HT4R binding between HC users vs. non-users in depressed women, however, it seemed that 5-HT4R settings differed qualitatively in their relation to antidepressant drug treatment response between OC users and non-users. From this we speculate that depressed OC users constitutes a special serotonin subtype of depression, which might have implications for antidepressant drug treatment response.","author_count":9,"contributors":["Larsen, Søren V.","Ozenne, Brice","Kohler-Forsberg, Kristin","Poulsen, Asbjorn Seenithamby","Dam, Vibeke Hoyrup","Svarer, Claus","Knudsen, Gitte Moos","Jørgensen, Martin Balslev","Frokjaer, Vibe G."],"cuid":["S01-000.00-545022"],"filters":{"added":"2022-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["11C SB207145","Association","Estrogen","Fluoxetine","Hormonal contraception","Human brain","Major depressive disorder","Oral contraception","Serotonin","Serotonin 4 receptor","Sex steroid hormones","Therapy"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"the impact of hormonal contraceptive use on serotonergic neurotransmission and antidepressant treatment response results from the neuropharm 000000000001 study","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/fendo.2022.799675","version":"Published Version"},"id":"S01-000.00-545022","identifier":[{"id":"85127562929","type":"scopus"},{"id":"000778399400001","type":"wos"},{"id":"35360055","type":"pmid"},{"id":"PMC8962375","type":"pmcid"}],"ids":["ku-fe063cb7-ef30-452f-8882-3357fd7d836c"],"keyword":["5-HT4 RECEPTOR-BINDING","ASSOCIATION","ESTROGEN","FLUOXETINE","HUMAN BRAIN","THERAPY","[11C]SB207145","hormonal contraception","hormonal intrauterine device","major depressive disorder","oral contraception","serotonin","serotonin 4 receptor","sex steroid hormones"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-07A5A35E9CC981C7E418BBA4EA8BAE66"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/fendo.2022.799675","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/305107859/The.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Mental Health Services Glostrup"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","first":"Soren Vinther","key":"larsenpau","last":"Larsen","locid":"15f7f99a-0254-46d1-a47d-c8d6628f04b1","name":"Larsen, Søren V.","name_org":"Larsen, Soren Vinther","rank":1,"rolecode":"pau"},{"affno":"1","first":"Brice","key":"ozennepau","last":"Ozenne","locid":"52e17fb0-a702-4384-bb59-a3a09619877c","name":"Ozenne, Brice","rank":2,"rolecode":"pau"},{"affno":"2","first":"Kristin","key":"kohlerforsbergpau","last":"Kohler-Forsberg","name":"Kohler-Forsberg, Kristin","rank":3,"rolecode":"pau"},{"affno":"2","first":"Asbjorn Seenithamby","key":"poulsenpau","last":"Poulsen","name":"Poulsen, Asbjorn Seenithamby","rank":4,"rolecode":"pau"},{"affno":"2","first":"Vibeke Hoyrup","key":"dampau","last":"Dam","name":"Dam, Vibeke Hoyrup","rank":5,"rolecode":"pau"},{"affno":"2","first":"Claus","key":"svarerpau","last":"Svarer","name":"Svarer, Claus","rank":6,"rolecode":"pau"},{"affno":"1","first":"Gitte Moos","key":"knudsenpau","last":"Knudsen","locid":"f02aee9e-69cf-491a-9765-ff062f734db8","name":"Knudsen, Gitte Moos","orcid":"0000-0003-1508-6866","rank":7,"rolecode":"pau"},{"affno":"1","first":"Martin Balslev","key":"jorgensenpau","last":"Jorgensen","locid":"dfc70acd-d15d-44f9-891e-6a7646d1727d","name":"Jørgensen, Martin Balslev","name_org":"Jorgensen, Martin Balslev","rank":8,"rolecode":"pau"},{"affno":"1","first":"Vibe Gedso","key":"frokjaerpau","last":"Frokjaer","locid":"ab1287b2-e920-4656-b4bc-1b7d3dffd2dc","name":"Frokjaer, Vibe G.","name_org":"Frokjaer, Vibe Gedso","rank":9,"rolecode":"pau"}],"pmid":["35360055"],"pub":{"doi":"10.3389/fendo.2022.799675","issn":["16642392"],"journal":"Frontiers in Endocrinology","paperid":"799675","status":"p","title":"Frontiers in Endocrinology","volume":"13"},"review":"Peer Reviewed","scoID":["2-s2.0-85127562929"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-fe063cb7-ef30-452f-8882-3357fd7d836c"],"src":["KU University of Copenhagen"],"title":"The Impact of Hormonal Contraceptive Use on Serotonergic Neurotransmission and Antidepressant Treatment Response : Results From the NeuroPharm 1 Study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-545022","year":"2022","yearsub":"2022"}
{"abstract":"In this case report we describe a life-threatening episode of delirium in a 51-year-old man. The condition was triggered by an abrupt withdrawal of benzodiazepines. The patient had been taking multiple sedatives for several years but a large proportion of the drugs were not available in Denmark. His general practitioner substituted and prescribed oxazepam and zolpidem for ten days. Afterwards the patient did not have access to benzodiazepines and developed a severe benzodiazepine withdrawal delirium. He was treated with diazepam and olanzapine with gradual dose reduction.","author_count":3,"contributors":["Mäkinen, Vivi-Nelli","Hansen, Kenneth Brandt","Knudsen, Søren Tang"],"cuid":["S01-000.00-745431"],"filters":{"added":"2024-08","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Benzodiazepines adverse effects","Delirium chemically induced","Humans","Male","Middle Aged","Substance Withdrawal Syndrome drug therapy"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"livstruende delirium udløst efter pludseligt ophør af langvarig behandling med benzodiazepiner","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85132079715","version":"Other Version"},"id":"S01-000.00-745431","identifier":[{"id":"85132079715","type":"scopus"},{"id":"35703059","type":"pmid"}],"ids":["au-d26a05f1-cd6f-4ecb-8760-ce74f0446b86"],"keyword":["Alcohol Withdrawal Delirium/drug therapy","Benzodiazepines/adverse effects","Delirium/chemically induced","Diazepam/adverse effects","Humans","Male","Middle Aged","Oxazepam/therapeutic use","Substance Withdrawal Syndrome/drug therapy"],"lang":"Danish","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-2-696BB22B2397E955BD8F338CC08B2AD2"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Psychosis Research Unit"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Vivi-Nelli","key":"mäkinenpau","last":"Mäkinen","name":"Mäkinen, Vivi-Nelli","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kenneth Brandt","key":"hansenpau","last":"Hansen","locid":"e11eae5b-22b0-4e2d-af46-cb0af1e0aa8e","name":"Hansen, Kenneth Brandt","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren Tang","key":"knudsenpau","last":"Knudsen","locid":"f4fb113c-f8d2-4bb3-9a9d-0bc2ef14590d","name":"Knudsen, Søren Tang","rank":3,"rolecode":"pau"}],"pmid":["35703059"],"pub":{"issn":["00415782","13994174"],"issn_org":["00415782"],"issue":"23","journal":"Ugeskrift for Læger","publisher":"Almindelige Danske Lægeforening","status":"p","title":"Ugeskrift for Læger","volume":"184"},"review":"Peer Reviewed","scoID":["2-s2.0-85160396418"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-d26a05f1-cd6f-4ecb-8760-ce74f0446b86"],"src":["AU Aarhus University"],"title":"Livstruende delirium udløst efter pludseligt ophør af langvarig behandling med benzodiazepiner","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-745431","year":"2022","yearsub":"2022"}
{"abstract":"Objectives: The aim of this study was to investigate cardiac involvement detected by ECG in patients with idiopathic inflammatory myopathies (IIMs) and to evaluate possible associations between the autoantibody profile and ECG changes in these patients. Methods: In a Scandinavian cross-sectional study, patients were included from two Danish centres and one Swedish centre. Resting 12-lead ECG was investigated in 261 patients with IIM compared with 102 patients with systemic sclerosis (SSc) and 48 healthy controls (HCs). ECG changes were correlated to clinical manifestations and myositis-specific and myositis-Associated autoantibodies (MSAs and MAAs, respectively). Results: Patients with IIM had a longer mean corrected QT (QTc) duration and more frequently presented with prolonged QTc (≥450 ms; P = 0.038) compared with HCs. A longer QTc duration was recorded in SSc compared with IIM [433 ms (s.d. 23) vs 426 (24); P = 0.011], yet there was no significant difference in the fraction with prolonged QTc (SSc: 22%, IIM: 16%; P = 0.19). In multivariable regression analyses, anti-Mi2 (P = 0.01, P = 0.035) and anti-Pl-7 (P = 0.045, P = 0.014) were associated with QTc duration and prolonged QTc in IIM. Elevated CRP was associated with prolonged QTc (P = 0.041). Conclusion: The presence of QTc abnormalities was as common in patients with IIM as in patients with SSc, including prolonged QTc seen in almost one-fifth of the patients. Anti-Mi2, anti-Pl-7 and elevated CRP may serve as biomarkers for cardiac disease in IIM, but needs to be confirmed in a larger prospective study.","author_count":16,"contributors":["Korsholm, Sine Søndergaard","Andersson, Daniel C","Bonde Knudsen, John","Dastmalchi, Maryam","Diederichsen, Axel Cosmus Pyndt","Gerke, Oke","Witting, Nanna","Jacobsen, Søren","Pecini, Redi","Friis, Tina","Krogager, Markus E","Lundberg, Ingrid E","Diederichsen, Louise C. Pyndt Raun"],"cuid":["S02-091.63-666906"],"filters":{"added":"2022-11","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["Asia, Middle East","Europe, EU","Nordic","OECD"],"corresponding_author":["Korsholm, Sine Søndergaard"],"country":["Netherlands","Sweden","Turkey"],"glorg":["All Global Affiliations","Canisius-Wilhelmina Hospital","Karadeniz Technical University","Karolinska Institute","Karolinska Institute and SciLifeLab","Karolinska Institutet","Karolinska University Hospital"],"keyword":["Autoantibodies","Biomarkers","Cross Sectional Studies","Electrocardiogram","Electrocardiography","Heart","Humans","Idiopathic inflammatory myopathy","Myositis","Prospective Studies","cardiac involvement"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-HO-SDR","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"myositis specific autoantibodies and qtc changes by ecg in idiopathic inflammatory myopathies","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/197561025/Korsholm_2022_Myositis_Specific_Autoantibodies_and_QTc_Changes.pdf","version":"Authors Final Version"},"id":"S02-091.63-666906","identifier":[{"id":"35048961","type":"pmid"},{"id":"85147514901","type":"scopus"}],"ids":["ku-8b7c3247-b6f0-45dd-b89b-71bed50aa0fe","sdu-a8afb781-1bc7-4668-b895-29c64cae4c2b"],"keyword":["Autoantibodies","Biomarkers","Cross-Sectional Studies","Electrocardiography","Humans","Myositis","Prospective Studies","cardiac involvement","electrocardiogram","heart","idiopathic inflammatory myopathy"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-65697EFED09EAA80D7B37BD849389B47"],"oa_link":[{"access":"oa","type":"loc","url"