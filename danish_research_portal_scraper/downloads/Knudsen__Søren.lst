{"author_count":5,"contributors":["Schioldan, Anne Grethe","Gregersen, Søren","Hald, Stine","Knudsen, Knud Erik Bach","Hermansen, Kjeld"],"cuid":["S01-000.00-156162"],"event":{"end":"2015-06-09","place":"Boston, us","start":"2015-06-05","title":"American Diabetes Association","year":"2015"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"dietary fibers in the prevention of type 000000000002 diabetes a randomized crossover study","src":["au"],"src-code":["DI-U-AU"],"type":"dco","type-grp":["all","pub"]},"id":"S01-000.00-156162","ids":["au-2eefa6c8-f804-49fa-9dd8-bcdbeed604f3"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-10EE3EE3BC984B48684382F06987FA4B"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Department of Endocrinology and Metabolism C"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Anne Grethe","key":"schioldanpau","last":"Schioldan","locid":"a710b241-48f9-4926-adb7-f3dbcfeb6a9f","name":"Schioldan, Anne Grethe","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Søren","key":"gregersenpau","last":"Gregersen","locid":"59b0d84c-a135-49bf-afba-7783f90976c2","name":"Gregersen, Søren","orcid":"0000-0002-1953-8631","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Stine","key":"haldpau","last":"Hald","locid":"ed81f2ac-05a5-4d72-b195-9e6afc4b7800","name":"Hald, Stine","rank":3,"rolecode":"p