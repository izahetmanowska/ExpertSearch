rsity, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Forskning, Uddannelse og Innovation","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Unit of Clinical Biostatistics"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Luise","key":"borchpau","last":"Borch","locid":"597937e0-c71d-483a-8b91-8300e9fc4a5f","name":"Borch, Luise","orcid":"0000-0003-1054-0601","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Mette","key":"holmpau","last":"Holm","locid":"78e86e2a-813e-4f86-9a37-75a7cc79173f","name":"Holm, Mette","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Maria","key":"knudsenpau","last":"Knudsen","locid":"8cba432a-205d-4ba4-ab48-0152b0490b70","name":"Knudsen, Maria","rank":3,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Svend","key":"ellermanneriksenpau","last":"Ellermann-Eriksen","locid":"245f9273-0449-479f-9590-53733c1b0642","name":"Ellermann-Eriksen, Svend","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Soeren","key":"hagstroempau","last":"Hagstroem","locid":"fe472f53-6bcd-4587-8287-df1539f689c3","name":"Hagstrøm, Søren","name_org":"Hagstroem, Soeren","rank":5,"rolecode":"pau"}],"pmid":["35000003"],"pub":{"doi":"10.1007/s00431-021-04345-z","issn":["03406199","09439676"],"issn_org":["03406199"],"issue":"4","journal":"European Journal of Pediatrics","pages":"1597-1607","publisher":"Springer Science and Business Media Deutschland GmbH","status":"p","title":"European Journal of Pediatrics","volume":"181"},"review":"Peer Reviewed","scoID":["2-s2.0-85122683927"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities"],"PST":["Published"]},"sid":["aau-3ca992a0-1077-49f1-85ca-537adf5fc830","au-af46ac1c-2fec-47a1-acd7-7a94d0086bce"],"src":["AAU Aalborg University","AU Aarhus University"],"title":"Long COVID symptoms and duration in SARS-CoV-2 positive children - a nationwide cohort study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-002979","year":"2022","yearsub":"2022"}
{"abstract":"Background The increasing global migration has made migrants' health a pertinent topic. This article aimed to examine whether migrants were less likely than Danish-born residents to receive guideline recommended care when hospitalized for major depressive disorder (MDD) and potential differences in clinical outcomes, including all-cause mortality, suicidal behavior, and readmissions during 1-year follow-up after first-time admission. Methods A national cohort study was performed, including all adult MDD inpatients at mental care units in the period 2011-2017. Migrants and two migrant subgroups (non-Western and Western) were compared with Danish-born patients. Quality of care was examined using multivariable Poisson and linear regression models. Clinical outcomes were examined using Cox proportional hazards regression analysis. Results Migrant-status was associated with a non-significantly lower chance of receiving high-quality care (relative risk [RR] = 0.93, confidence interval [CI] 0.86:1.01) and lower readmission rates for depression (hazard rate ratio [HR] = 0.93, CI 0.86:1.01), and significantly higher all-cause mortality (HR = 1.55, CI 1.19:2.01) and lower all-cause readmission rate (HR = 0.88, CI 0.83:0.94). No clear association was found regarding suicidal behavior. While associations were comparable for migrant subgroups regarding readmission, the associations with low quality of care and of all-cause mortality appeared strongest among Western migrants. Conclusions Among inpatients with MDD in a universal tax-financed healthcare system, being a migrant was associated with a potential lower quality of in-hospital care and worse clinical outcomes. These results warrant further investigation to clarify the underlying explanation for these inequalities and to develop and test interventions to ensure better quality of care and clinical outcomes for migrant patients.","author_count":6,"contributors":["Knudsen, Søren Valgreen","Valentin, Jan Brink","Norredam, Marie","Videbech, Poul","Mainz, Jan","Johnsen, Søren Paaske"],"cuid":["S02-100.00-003452"],"filters":{"added":"2023-02","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Asia, Middle East","OECD"],"corresponding_author":["Knudsen, Søren Valgreen"],"country":["Israel"],"glorg":["All Global Affiliations","University of Haifa"],"keyword":["Inequality","Mental health","Migrants health","Mortality","Quality of care","Suicide"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Psychiat Reg North Jutland"],"U":["DI-U-AAU","DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-AAU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"differences in quality of care mortality suicidal behavior and readmissions among migrants and danish born inpatients with major depressive disorder","src":["aau","ku"],"src-code":["DI-U-AAU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1192/j.eurpsy.2022.2329","version":"Published Version"},"id":"S02-100.00-003452","identifier":[{"id":"000882910600001","type":"wos"},{"id":"85141232662","type":"scopus"},{"id":"36268603","type":"pmid"},{"id":"PMC9677448","type":"pmcid"}],"ids":["aau-4679326a-baad-40bb-b806-8b8f1230b7b3","ku-566da41d-5653-4b99-a8cf-59aa3f7f0bb1"],"keyword":["MENTAL-HEALTH","Migrants health","inequality","mortality","quality of care","suicide"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-268372F809336E59CCB53ECCFBF9C4FA"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1192/j.eurpsy.2022.2329","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/326342930/Fulltext.pdf","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/500785569/Knudsen_et_al._2022_._Differences_in_quality_of_care_mortality_suicidal_behavior_and_readmissions_among_migrants_and_Danish_born_inpatients_with_major_depressive_disorder.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Psychiatry","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine, Danish Center for Clinical Health Services Research"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Psychiat Reg North Jutland"],"nora_code":"DI-OT","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Public Health, Section of Health Services Research"],"nora_code":"DI-U-KU","used":1},{"affno":"4","country":"il","key":"university of haifa","loc":["Israel","Asia, Middle East","OECD"],"name":"University of Haifa","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Søren Valgreen","key":"knudsenpau","last":"Knudsen","locid":"d59094b5-44a6-4398-9acf-f3f530e0504b","name":"Knudsen, Søren Valgreen","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jan Brink","key":"valentinpau","last":"Valentin","locid":"4fbcfaf7-a4af-46c9-b3b4-f113b45baf05","name":"Valentin, Jan Brink","orcid":"0000-0002-8205-7179","rank":2,"rolecode":"pau"},{"affno":"3","first":"Marie","key":"norredampau","last":"Norredam","locid":"b2ded723-225a-455c-ae7b-9be191ab1b53","name":"Norredam, Marie","rank":3,"rolecode":"pau"},{"affno":"3","first":"Poul","key":"videbechpau","last":"Videbech","locid":"30ef0c08-97c7-48b1-b034-d9fb316f6bd8","name":"Videbech, Poul","rank":4,"rolecode":"pau"},{"affno":"1 4","corresponding":null,"country":"dk","first":"Jan","key":"mainzpau","last":"Mainz","locid":"fadbea42-81be-48a2-afb2-c868f9dfa4f5","name":"Mainz, Jan","orcid":"0000-0003-0242-9233","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren Paaske","key":"johnsenpau","last":"Johnsen","locid":"c3e8b374-a343-484a-a10d-e6550efbb8dc","name":"Johnsen, Søren Paaske","orcid":"0000-0002-2787-0271","rank":6,"rolecode":"pau"}],"pmid":["36268603"],"pub":{"doi":"10.1192/j.eurpsy.2022.2329","issn":["09249338","17783585"],"issn_org":["09249338"],"issue":"1","journal":"European Psychiatry","paperid":"e69","publisher":"Cambridge University Press","status":"p","title":"European Psychiatry","volume":"65"},"review":"Peer Reviewed","scoID":["2-s2.0-85141232662"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["aau-4679326a-baad-40bb-b806-8b8f1230b7b3","ku-566da41d-5653-4b99-a8cf-59aa3f7f0bb1"],"src":["AAU Aalborg University","KU University of Copenhagen"],"title":"Differences in quality of care, mortality, suicidal behavior, and readmissions among migrants and Danish-born inpatients with major depressive disorder","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-003452","year":"2022","yearsub":"2022"}
{"abstract":"OBJECTIVE: to develop a user-friendly prediction tool of 1-year mortality for patients with hip fracture, in order to guide clinicians and patients on appropriate targeted preventive measures. DESIGN: population-based cohort study from 2011 to 2017 using nationwide data from the Danish Hip Fracture Registry. SUBJECTS: a total of 28,791 patients age 65 and above undergoing surgery for a first-time hip fracture. METHODS: patient-related prognostic factors at the time of admission were assessed as potential predictors: Nursing home residency, comorbidity (Charlson Comorbidity Index [CCI] Score), frailty (Hospital Frailty Risk Score), basic mobility (Cumulated Ambulation Score), atrial fibrillation, fracture type, body mass index (BMI), age and sex. Association with 1-year mortality examined by determining the cumulative incidence, applying univariable logistic regression and assessing discrimination (area under the receiver operating characteristics curve [AUROC]). The final model (logistic regression) was utilised on a development cohort (70% of patients). Discrimination and calibration were assessed on the validation cohort (remaining 30% of patients). RESULTS: all predictors showed an association with 1-year mortality, but discrimination was moderate. The final model included nursing home residency, CCI Score, Cumulated Ambulation Score, BMI and age. It had an acceptable discrimination (AUROC 0.74) and calibration, and predicted 1-year mortality risk spanning from 5 to 91% depending on the combination of predictors in the individual patient. CONCLUSIONS: using information obtainable at the time of admission, 1-year mortality among patients with hip fracture can be predicted. We present a user-friendly chart for daily clinical practice and provide new insight regarding the interplay between prognostic factors.","author_count":6,"contributors":["Hjelholt, Thomas J.","Johnsen, Søren Paaske","Brynningsen, Peter K.","Knudsen, Jakob S.","Prieto-Alhambra, Daniel","Pedersen, Alma B."],"cuid":["S02-100.00-009221"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, Non-EU","OECD"],"corresponding_author":["Hjelholt, Thomas J.","Hjelholt, Thomas Johannesson"],"country":["United Kingdom"],"glorg":["All Global Affiliations","University of Oxford"],"keyword":["Aged","Cohort Studies","Comorbidity","Hip Fractures diagnosis","Hip fracture","Humans","Mobility","Mortality","Older people","Prediction","Retrospective Studies","Risk Factors"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-HO-CDR","DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"development and validation of a model for predicting mortality in patients with hip fracture","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85123815658&partnerID=8YFLogxK","version":"Other Version"},"id":"S02-100.00-009221","identifier":[{"id":"85123815658","type":"scopus"},{"id":"34923589","type":"pmid"}],"ids":["aau-bf309acd-98d2-4469-9995-c77ee557a900","au-17bd55b9-2231-4d30-b814-e9b11d9084c9"],"keyword":["Aged","Cohort Studies","Hip Fractures/diagnosis","Humans","Retrospective Studies","Risk Factors","comorbidity","hip fracture","mobility","mortality","older people","prediction"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-24EB4F41875BC2E3A9CA94ECA67708B3"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"A