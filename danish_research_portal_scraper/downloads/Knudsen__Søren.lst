phanie R M","key":"zimsenstephaniermpau","last":"Zimsen","name":"Zimsen, Stephanie R M","rank":937,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Michael","key":"brauermichaelpau","last":"Brauer","name":"Brauer, Michael","rank":938,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Ashkan","key":"afshinashkanpau","last":"Afshin","name":"Afshin, Ashkan","rank":939,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Stephen S","key":"limstephenspau","last":"Lim","name":"Lim, Stephen S","rank":940,"rolecode":"pau"}],"pmid":["33069327"],"pub":{"doi":"10.1016/s0140-6736(20)30752-2","issn":["00995355","01406736"],"issn_org":["01406736"],"issue":"10258","journal":"The Lancet","pages":"1223-1249","publisher":"Elsevier","status":"p","title":"The Lancet","volume":"396"},"review":"Peer Reviewed","scoID":["2-s2.0-85092451099"],"sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["dtu-f7876c68-1db9-4b8b-88a6-215533f7a4c6","sdu-52ff4de5-5d88-4b5c-9f0e-7535453f2c59"],"src":["DTU Technical University of Denmark","SDU University of Southern Denmark"],"title":"Global burden of 87 risk factors in 204 countries and territories, 1990–2019: a systematic analysis for the Global Burden of Disease Study 2019","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.95-038086","year":"2020","yearsub":2021}
{"abstract":"These hypotheses were tested: (1) Freely chosen frequency in unilateral index finger tapping is correlated between the two index fingers, and (2) A 3-min bout of unilateral index finger tapping followed by 10 min rest results in an increase of the freely chosen tapping frequency performed by the contralateral index finger in a second bout. Thirty-two adults participated. Freely chosen tapping frequencies from first bouts were 167.2 ± 79.0 and 161.5 ± 69.4 taps/min for the dominant and non-dominant hand, respectively (p=.434). These variables correlated (R=.86, p<.001). When bout one and two were performed with the dominant and non-dominant hand, respectively, the frequency increased by 8.1%±17.2% in bout two (p=.011). In opposite order, the frequency increased by 14.1%±17.5% (p<.001), which was not different from the ∼8% (p=.157).","author_count":6,"contributors":["Hansen, Ernst Albin","Sørensen, Søren Bak","Knudsen, Lasse","Seiferheld, Bo Eitel","Stevenson, Andrew James Thomas","Emanuelsen, Anders"],"cuid":["S01-000.00-072192"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Cross limb transfer","Interlimb transfer","Motor control"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"contralateral transfer of the phenomenon of repeated bout rate enhancement in unilateral index finger tapping","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/442693843/Transfer_JMB_R2_clean_vbn.pdf","version":"Authors Final Version"},"id":"S01-000.00-072192","identifier":[{"id":"85063584360","type":"scopus"}],"ids":["aau-4c5b2bd3-af82-4030-a720-5ac23e367576"],"keyword":["Cross-limb transfer","interlimb transfer","motor control"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-EF49F48AD7C7DB5AAFD9FB21E90233EC"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/442693843/Transfer_JMB_R2_clean_vbn.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Sport Sciences - Performance and Technology"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Ernst Albin","key":"hansenpau","last":"Hansen","locid":"b43b2264-f483-4c4a-a204-2973c10780c4","name":"Hansen, Ernst Albin","orcid":"0000-0003-2690-6807","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren","key":"bakpau","last":"Bak","locid":"6b19a8a2-8c16-49af-881e-135014827723","name":"Sørensen, Søren Bak","name_org":"Bak, Søren","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lasse","key":"knudsenpau","last":"Knudsen","locid":"659ebc91-3567-4996-a21e-4468b7110586","name":"Knudsen, Lasse","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Bo","key":"seiferheldpau","last":"Seiferheld","locid":"16abdc66-c16f-4656-9a3b-29ef941fce9c","name":"Seiferheld, Bo Eitel","name_org":"Seiferheld, Bo","orcid":"0000-0001-7235-5597","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Andrew James Thomas","key":"stevensonpau","last":"Stevenson","locid":"3b7506b2-1