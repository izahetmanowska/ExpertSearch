g":null,"country":"dk","first":"Søren Valgreen","key":"knudsenpau","last":"Knudsen","locid":"d59094b5-44a6-4398-9acf-f3f530e0504b","name":"Knudsen, Søren Valgreen","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jan","key":"mainzpau","last":"Mainz","locid":"fadbea42-81be-48a2-afb2-c868f9dfa4f5","name":"Mainz, Jan","orcid":"0000-0003-0242-9233","rank":4,"rolecode":"pau"}],"pub":{"eisbn":["9788797401101"],"pages":"16-17","publisher":"Dansk Selskab for Kvalitet i Sundhedssektoren","status":"p","subtitle":"Begreber, metoder og værktøjer til kvalitetsudvikling på tværs af sundhedsvæsenet","title":"Kvalitetsguiden"},"review":"Undetermined","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-16c57235-3911-434a-8a47-c666a9611c7e"],"src":["AAU Aalborg University"],"title":"Indikator","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-056739","year":"2022","yearsub":"2022"}
{"abstract":"Direct-methanol fuel cell (DMFC) systems are comparatively simple, sometimes just requiring a fuel cartridge and a fuel cell stack with appropriate control devices. The key challenge in these systems is the accurate determination and control of the flow rates and the appropriate mixture of methanol and water, and fundamental understanding can be gained by computational fluid dynamics. In this work, a three-dimensional, steady-state, two-phase, multi-component and non-isothermal DMFC model is presented. The model is based on the Eulerian approach, and it can account for gas and liquid transport in porous media subject to mixed wettability, i.e., the simultaneous presence of hydrophilic and hydrophobic pores. Other phenomena considered are variations in surface tension due to water–methanol mixing and the capillary pressure at the gas diffusion layer–channel interface. Another important aspect of DMFC modeling is the transport of methanol and water across the membrane. In this model, non-equilibrium sorption–desorption, diffusion and electro-osmotic drag of both species are included. The DMFC model is validated against experimental measurements, and it is used to study the interaction between volume porosity of the anode gas diffusion layer and the capillary pressure boundary condition at the anode, and how it affects performance and limiting current density.","author_count":3,"contributors":["Olesen, Anders Christian","Kær, Søren Knudsen","Berning, Torsten"],"cuid":["S01-000.00-071794"],"filters":{"added":"2022-11","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Computational fluid dynamics CFD","Direct methanol fuel cells DMFC","Fuel cells","Multi phase flow","Porous media"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"a multi fluid model for water and methanol transport in a direct methanol fuel cell","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.3390/en15196869","version":"Published Version"},"id":"S01-000.00-071794","identifier":[{"id":"85139965755","type":"scopus"}],"ids":["aau-4b194413-7538-4e24-9d32-00bfe3bc315c"],"keyword":["anode gas diffusion layer","computational fluid dynamics (CFD)","direct-methanol fuel cells (DMFC)","fuel cell heat and mass transfer","fuel cells","limiting current density","multi-phase flow","porous media","reactant cross-over","water-methanol mixture"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-7D42C6EC667B31AD26BA2FBA929751A9"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.3390/en15196869","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/489312734/energies_15_06869.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, AAU Energy"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Anders Christian","key":"olesenpau","last":"Olesen","locid":"a6c83a7f-2f25-4b66-b42d-9ef435ffeecf","name":"Olesen, Anders Christian","orcid":"0000-0002-8344-914X","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren Knudsen","key":"kærpau","last":"Kær","locid":"898d6584-ec2e-430a-b78d-e3e0d670dcdd","name":"Kær, Søren Knudsen","orcid":"0000-0003-2151-8055","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Torsten","key":"berningpau","last":"Berning","locid":"eecf017d-14b4-4110-9df5-a10a6c7e9bd9","name":"Berning, Torsten","orcid":"0000-0003-3324-0927","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.3390/en15196869","issn":["19961073"],"issue":"19","journal":"Energies","paperid":"6869","publisher":"MDPI AG","publisher_org":"M D P I AG","status":"p","title":"Energies","volume":"15"},"review":"Peer Reviewed","scoID":["2-s2.0-85139965755"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-4b194413-7538-4e24-9d32-00bfe3bc315c"],"src":["AAU Aalborg University"],"title":"A Multi-Fluid Model for Water and Methanol Transport in a Direct Methanol Fuel Cell","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-071794","year":"2022","yearsub":"2022"}
{"abstract":"Background: To support the primary care sector in delivering high-quality type 2 diabetes (T2D), literature reviews emphasize the need for implementing models of collaboration that in a simple and effective way facilitate clinical dialogue between general practitioners (GPs) and endocrinologists. The overall aim of the project is to evaluate if virtual specialist conferences between GPs and endocrinologists about patients living with T2D is clinically effective and improves diabetes competences and organization in general practice in comparison to usual practice. Methods: A prospective, pragmatic, and superiority RCT with two parallel arms of general practices in the Municipality of Aarhus, Denmark. All general practices are invited (n = 100). The intervention runs for 12 months and consists of four virtual conferences between endocrinologists and an individual general practice. Before the first conference, an introductory webinar teaches GPs about how to use an IT-platform to identify and manage T2D patients. The main analysis (month 12) concerns the difference between the intervention and control arm. It is expected that the virtual conferences at the patient level will improve adherence to international recommendations on diabetes medication for T2D patients and improve the risk profile with a reduction in glycated haemoglobin, blood pressure, and cholesterol. The study design allows for identifying a significant difference between the intervention (n = 15) and control group (n = 15) regarding the three primary clinical outcomes with a power of 0.8870–0.9941. At the general practice level, it is expected that general practitioners and practice staff in the intervention group will improve self-reported diabetes competence and organization. The control arm will get the intervention when the primary intervention ends (months 12–24), and the intervention arm transitions to a maintenance phase. Discussion: The potential of virtual conferences is yet to be fully tapped because of methodological limitations. Studies have also not yet systematically evaluated virtual conferences in the context of chronic care using a high-quality research design. Given the nature of this real-life intervention, general practitioners and endocrinologists cannot be blinded to their allocation to either the intervention or comparison arm. Trial registration: ClinicalTrials.gov, United States National Institutes of Health trial ID: NCT05268081. Registered on 4 March 2022.","author_count":5,"contributors":["Prætorius, Thim","Lundberg, Anne Sofie Baymler","Søndergaard, Esben","Knudsen, Søren Tang","Sandbæk, Annelli"],"cuid":["S01-000.00-138739"],"filters":{"added":"2023-02","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Prætorius, Thim"],"keyword":["Randomized trial","Type 2 diabetes"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"the effect of virtual specialist conferences between endocrinologists and general practitioners about type 000000000002 diabetes study protocol for a pragmatic randomized superiority trial","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s13063-022-06961-y","version":"Published Version"},"id":"S01-000.00-138739","identifier":[{"id":"85145076322","type":"scopus"},{"id":"PMC9795951","type":"pmcid"},{"id":"36578024","type":"pmid"}],"ids":["au-1057752c-28af-47ba-b560-bd4a64725a45"],"keyword":["General Practitioners: General practice","Randomized trial","Type 2 diabetes","Virtual conferences"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-DEA1B746ED095268A705667E127737F4"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s13063-022-06961-y","version":"Published Version"},{"access":"oa","type":"rem","url":"https://trialsjournal.biomedcentral.com/articles/10.1186/s13063-022-06961-y","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - SDCA-Steno Diabetes Center Aarhus"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Thim","key":"prætoriuspau","last":"Prætorius","locid":"85f0646f-a6c4-4e79-b20d-85762179080a","name":"Prætorius, Thim","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anne Sofie Baymler","key":"lundbergpau","last":"Lundberg","locid":"36b31958-0887-4725-ad35-074783b0d48b","name":"Lundberg, Anne Sofie Baymler","orcid":"0000-0002-5800-8094","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Esben","key":"søndergaardpau","last":"Søndergaard","locid":"35f76081-43f3-42ce-94b2-e60a44e59d5a","name":"Søndergaard, Esben","orcid":"0000-0001-8041-6994","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren Tang","key":"knudsenpau","last":"Knudsen","locid":"f4fb113c-f8d2-4bb3-9a9d-0bc2ef14590d","name":"Knudsen, Søren Tang","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Annelli","key":"sandbækpau","last":"Sandbæk","locid":"a611d9cf-b4fb-4a39-bdc8-d2d2b0f9b68a","name":"Sandbæk, Annelli","orcid":"0000-0003-1647-2646","rank":5,"rolecode":"pau"}],"pmid":["36578024"],"pub":{"doi":"10.1186/s13063-022-06961-y","issn":["14686708","17456215"],"issn_org":["17456215"],"issue":"1","journal":"Trials","paperid":"1059","publisher":"BioMed Central Ltd.","status":"p","title":"Trials","volume":"23"},"review":"Peer Reviewed","scoID":["2-s2.0-85145076322"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-1057752c-28af-47ba-b560-bd4a64725a45"],"src":["AU Aarhus University"],"title":"The effect of virtual specialist conferences between endocrinologists and general practitioners about type 2 diabetes : study protocol for a pragmatic randomized superiority trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-138739","year":"2022","yearsub":"2022"}
