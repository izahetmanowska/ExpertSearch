corresponding":null,"first":"Søren Helweg","key":"dampau","last":"Dam","name":"Dam, Søren Helweg","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Rasmus Ulslev Wegener","key":"friispau","last":"Friis","name":"Friis, Rasmus Ulslev Wegener","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Aleksander Moldt","key":"haackpau","last":"Haack","name":"Haack, Aleksander Moldt","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jan Kuhlmann","key":"andersenpau","last":"Andersen","name":"Andersen, Jan Kuhlmann","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Andreas Hougaard","key":"laustsenpau","last":"Laustsen","locid":"0e4bb465-c620-461f-9970-29bad328cf8a","name":"Laustsen, Andreas H.","name_org":"Laustsen, Andreas Hougaard","orcid":"0000-0001-6918-5574","rank":6,"rolecode":"pau"}],"pmid":["32635017"],"pub":{"doi":"10.1016/j.toxicon.2019.12.062","issn":["00410101","01905368"],"issn_org":["00410101"],"journal":"Toxicon","publisher":"Elsevier","status":"p","title":"Toxicon","volume":"177"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-5cb72511-f17b-4389-b6da-de847bd1e9b5"],"src":["DTU Technical University of Denmark"],"title":"Discovery and evaluation of monoclonal antibodies for stratification of venoms from brazilian Bothrops, Crotalus, and Lachesis species","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-332143","year":"2019","yearsub":"2020"}
{"abstract":"Three dimensional polarimetric neutron tomography is an emerging method for non-destructive investigation of magnetic field strength and direction distribution in three dimensions. It utilises the Larmor precession of the neutron spin in the presence of an external magnetic field and has so far been restricted to the measurement of magnetic fields weak enough to keep the neutron precession below the phase-wrapping limit at 180º. Through the use of polychromatic time-of-flight information in combination with an iterative forward model reconstruction algorithm we have gone beyond this limit, thereby vastly broadening the potential of the technique. We present the reconstructed magnetic field of a measured current carrying solenoid as a proof-of-principle for this novel method, as well as successfully applying the method to a simulated data set of a sample consisting of multiple magnetic domains.","author_count":7,"contributors":["Sales, Morten","Shinohara, Takenao","Sørensen, Michael Korning","Bergbäck Knudsen, Erik","Tremsin, Anton","Strobl, Markus","Schmidt, Søren"],"cuid":["S01-000.00-379879"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","Asia, East","Europe, Non-EU","OECD"],"corresponding_author":["Sales, Morten"],"country":["Japan","Switzerland","United States"],"glorg":["All Global Affiliations","Japan Atomic Energy Agency","Paul Scherrer Institute","University of California at Berkeley"],"keyword":["Magnetic fields","Neutron imaging","Neutron tomography"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"three dimensional polarimetric neutron tomography beyond the phase wrapping limit","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85063944123","version":"Other Version"},"id":"S01-000.00-379879","identifier":[{"id":"85063944123","type":"scopus"}],"ids":["dtu-fbaac574-5b37-4c5e-96ab-78af70c4300f"],"keyword":["magnetic fields","neutron imaging","neutron polarimetry","neutron tomography"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-2F5DFA80DF844199A50E4FA71C8310C3"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Physics","Technical University of Denmark, Department of Physics, Neutrons and X-rays for Materials Physics"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"jp","key":"japan atomic energy agency","loc":["Japan","Asia, East","OECD"],"name":"Japan Atomic Energy Agency","used":1},{"affno":"3","country":"us","key":"university of california at berkeley","loc":["United States","America, North","OECD"],"name":"University of California at Berkeley","used":1},{"affno":"4","country":"ch","key":"paul scherrer institute","loc":["Switzerland","Europe, Non-EU","OECD"],"name":"Paul Scherrer Institute","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Morten","key":"salespau","last":"Sales","locid":"d1a1be2d-554c-4343-9e37-0706c71c364e","name":"Sales, Morten","orcid":"0000-0001-5434-3728","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Takenao","key":"shinoharapau","last":"Shinohara","name":"Shinohara, Takenao","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Michael Korning","key":"sørensenpau","last":"Sørensen","locid":"de7ab019-58bd-44c1-9d94-a7c5a