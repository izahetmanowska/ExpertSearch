]},"sid":["aau-55b12c7f-727e-4e31-9af7-0cf119a97157"],"src":["AAU Aalborg University"],"title":"Fremdriftsreformen virker – desværre","type":"Journal Comment","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-074920","year":"2016","yearsub":"2016"}
{"abstract":"BACKGROUND The pathophysiological perturbations underlying the unfavorable cardiovascular prognosis in women with type 2 diabetes (T2DM) remain elusive. Low subendocardial viability ratio (SEVR), an index of myocardial oxygen supply and demand, has been associated with intermediate cardiovascular risk markers and cardiovascular mortality in various populations. However, whether SEVR is associated with sex and cardiovascular risk markers in patients with T2DM remains to be clarified. METHODS We examined 86 T2DM patients (mean age 59±10 years, 47% women, median diabetes duration 1.9 (range 0.2-5.0) years) and 86 sex- and age-matched control subjects in a cross-sectional study. SEVR was noninvasively assessed by tonometry and markers of cardiovascular risk by carotid-femoral pulse wave velocity (PWV), homeostasis model assessment of insulin resistance (HOMA2-IR), C-reactive protein, urinary albumin/creatinine ratio, and heart rate variability. RESULTS Women with diabetes had significantly lower SEVR compared to both men with diabetes (161% ± 26% vs. 178% ± 32%, P < 0.01), women without diabetes (185% ± 24%, P < 0.001), and men without diabetes (188% ± 28%, P < 0.001). The differences remained significant after adjustment for age, systolic blood pressure, heart rate, diabetes, and smoking. SEVR was associated with PWV, HOMA2-IR, C-reactive protein, and reduced heart rate variability in patients and control subjects, but the associations became nonsignificant after adjustment for heart rate. CONCLUSIONS SEVR is reduced in women with short duration of T2DM and associated with cardiovascular risk markers. The latter association seems to be at least partly mediated via heart rate. We hypothesize that reduced SEVR may contribute to the unfavorable cardiovascular prognosis in women with diabetes.","author_count":9,"contributors":["Laugesen, Esben","Høyem, Pernille","Fleischer, Jesper","Kumarathas, Indumathi","Knudsen, Søren Tang","Hansen, Klavs Würgler","Christiansen, Jens Sandahl","Hansen, Troels Krarup","Poulsen, Per Løgstrup"],"cuid":["S01-000.00-156791"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Arterial stiffness","Blood Pressure","Heart rate variability","Hypertension","Low grade inflammation","Sex","Type 2 diabetes mellitus"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"reduced subendocardial viability ratio is associated with unfavorable cardiovascular risk profile in women with short duration of type 000000000002 diabetes","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84991054891","version":"Other Version"},"id":"S01-000.00-156791","identifier":[{"id":"27405963","type":"pmid"},{"id":"84991054891","type":"scopus"}],"ids":["au-3012944d-fd23-4f16-b3ec-3ea8acb4e378"],"keyword":["HOMA index","arterial stiffness","blood pressure","heart rate variability","hypertension","low-grade inflammation","sex","subendocardial viability ratio","type 2 diabetes mellitus"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-6376A3F88DA9E37C0C93F973D4703499"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Endocrinology and Internal Medicine"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Esben","key":"laugesenesbenpau","last":"Laugesen","locid":"e06ca9b7-d51f-40f2-b042-696ca2b18492","name":"Laugesen, Esben","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Pernille","key":"høyempernillepau","last":"Høyem","locid":"cbd0d45d-3fcf-4208-93ca-d5f580739f1a","name":"Høyem, Pernille","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper","key":"fleischerjesperpau","last":"Fleischer","locid":"d05675bb-341e-4913-90d7-0277ad912141","name":"Fleischer, Jesper","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Indumathi","key":"kumarathasindumathipau","last":"Kumarathas","name":"Kumarathas, Indumathi","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren T","key":"knudsensørentangpau","last":"Knudsen","locid":"f4fb113c-f8d2-4bb3-9a9d-0bc2ef14590d","name":"Knudsen, Søren Tang","name_org":"Knudsen, Søren T","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Klavs W","key":"hansenklavswürglerpau","last":"Hansen","locid":"a2dc4053-a6dd-47ea-bfeb-e689b3b6fc94","name":"Hansen, Klavs Würgler","name_org":"Hansen, Klavs W","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jens Sandahl","key":"christiansenjenssandahlpau","last":"Christiansen","locid":"3af3a403-0f32-4202-aaec-135d99299f52","name":"Christiansen, Jens Sandahl","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Troels Krarup","key":"hansentroelskraruppau","last":"Hansen","locid":"4af39f3a-9bb3-4f30-8fee-29a550538de8","name":"Hansen, Troels Krarup","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Per L","key":"poulsenperløgstruppau","last":"Poulsen","locid":"a965cecb-44f9-4913-a8e1-7bc669e8ffd9","name":"Poulsen, Per Løgstrup","name_org":"Poulsen, Per L","rank":9,"rolecode":"pau"}],"pmid":["27405963"],"pub":{"doi":"10.1093/ajh/hpw066","issn":["08957061","11395990"],"issn_org":["08957061"],"issue":"10","journal":"American Journal of Hypertension","pages":"1165-72","publisher":"Oxford University Press","status":"p","title":"American Journal of Hypertension","volume":"29"},"review":"Peer Reviewed","scoID":["2-s2.0-84991054891"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-3012944d-fd23-4f16-b3ec-3ea8acb4e378"],"src":["AU Aarhus University"],"title":"Reduced Subendocardial Viability Ratio Is Associated With Unfavorable Cardiovascular Risk Profile in Women With Short Duration of Type 2 Diabetes","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-156791","year":"2016","yearsub":"2016"}
{"abstract":"The power of two choices is a classic paradigm for load balancing when assigning m balls to n bins. When placing a ball, we pick two bins according to two hash functions ho and h1, and place the ball in the least loaded bin. Assuming fully random hash functions, when m = O(n), Azar et al. [STOC'94] proved that the maximum load is lglgn + 0(1) with high probability. No such bound was known with a hash function implementable in constant time. In this paper, we investigate the power of two choices when the hash functions ho and h1 are implemented with simple tabulation, which is a very efficient hash function evaluated in constant time. Following their analysis of Cuckoo hashing [J.ACM'12], PǍtraşcu and Thorup claimed that the expected maximum load with simple tabulation is O(lglgn). This did not include any high probability guarantee, so the load balancing was not yet to be trusted. Here, we show that with simple tabulation, the maximum load is O(lglgn) with high probability, giving the first constant time hash function with this guarantee. We also give a concrete example where, unlike with fully random hashing, the maximum load is not bounded by lglgn + 0(l), or even (1 + o(l)) lglgn with high probability. Finally, we show that the expected maximum load is lglgn + 0(1), just like with fully random hashing.","author_count":4,"contributors":["Dahlgaard, Søren","Knudsen, Mathias Baek Tejs","Rotenberg, Eva","Thorup, Mikkel"],"cuid":["S01-000.00-306659"],"event":{"acronym":"SODA","end":"2016-01-12","place":"Arlington, us","start":"2016-01-10","title":"27th Annual ACM-SIAM Symposium on Discrete Algorithms","year":"2016"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"the power of two choices with simple tabulation","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84963612588","version":"Other Version"},"id":"S01-000.00-306659","identifier":[{"id":"84963612588","type":"scopus"}],"ids":["dtu-06e11a87-4a31-474e-ba76-d8b20ba87d38"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-3-4-205B34BFF57A7B1D21D24BBF35381CDE"],"org":[{"affno":"1","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Applied Mathematics and Computer Science","Technical University of Denmark, Department of Applied Mathematics and Computer Science, Algorithms and Logic"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Søren","key":"dahlgaardpau","last":"Dahlgaard","name":"Dahlgaard, Søren","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mathias Baek Tejs","key":"knudsenpau","last":"Knudsen","name":"Knudsen, Mathias Baek Tejs","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Eva","key":"rotenbergpau","last":"Rotenberg","locid":"1a970eb9-57c6-4f5f-a453-117cbc7705ba","name":"Rotenberg, Eva","orcid":"0000-0001-5853-7909","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mikkel","key":"thoruppau","last":"Thorup","name":"Thorup, Mikkel","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1137/1.9781611974331.ch111","eisbn":["9781510819672"],"pages":"1631-1642","publisher":"Association for Computing Machinery","status":"p","title":"27th Annual ACM-SIAM Symposium on Discrete Algorithms, SODA 2016","volume":"3"},"review":"Peer Reviewed","scoID":["2-s2.0-84963612588"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-06e11a87-4a31-474e-ba76-d8b20ba87d38"],"src":["DTU Technical University of Denmark"],"title":"The power of two choices with simple tabulation","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-306659","year":"2016","yearsub":"2017"}
