ast":"Zhang","name":"Zhang, Zilong","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"William A.","key":"ghalipau","last":"Ghali","name":"Ghali, William A.","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jeffrey","key":"bakalpau","last":"Bakal","name":"Bakal, Jeffrey","rank":8,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Bastien","key":"boussatpau","last":"Boussat","name":"Boussat, Bastien","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ward","key":"flemonspau","last":"Flemons","name":"Flemons, Ward","rank":10,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Alan","key":"forsterpau","last":"Forster","name":"Forster, Alan","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Danielle A.","key":"southernpau","last":"Southern","name":"Southern, Danielle A.","rank":12,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Søren","key":"knudsenpau","last":"Knudsen","locid":"2575c800-642d-4984-9c56-41601cf07a26","name":"Knudsen, Søren","orcid":"0000-0002-8306-1102","rank":13,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Brittany","key":"popowichpau","last":"Popowich","name":"Popowich, Brittany","rank":14,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Yuan","key":"xupau","last":"Xu","name":"Xu, Yuan","rank":15,"rolecode":"pau"}],"pub":{"doi":"10.1371/journal.pone.0275250","issn":["19326203"],"issue":"10","journal":"PLOS ONE","pages":"1-10","publisher":"Public Library of Science","status":"p","title":"PLOS ONE","volume":"17"},"review":"Peer Reviewed","scoID":["2-s2.0-85139323038"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-a790a6cb-bf47-4d32-a775-4141c09ee074"],"src":["ITU IT University of Copenhagen"],"title":"Developing EMR-based algorithms to Identify hospital adverse events for health system performance evaluation and improvement: Study protocol","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383710","year":"2022","yearsub":"2022"}
{"abstract":"Sustainable agriculture in the future will depend on crops that are tolerant to biotic and abiotic stresses, require minimal input of water and nutrients, and can be cultivated with a minimal carbon footprint. Wild plants that fulfil these requirements abound in nature but are typically low yielding. Thus, replacing current high-yielding crops with less productive but resilient species will require the intractable trade-off of increasing land area under cultivation to produce the same yield. Cultivating more land reduces natural resources, reduces biodiversity, and increases our carbon footprint. Sustainable intensification can be achieved by increasing yield in underutilized or wild plant species that are already resilient but achieving this goal by conventional breeding programs may be a long-term prospect. De novo domestication of orphan or crop wild relatives using mutagenesis is an alternative and fast approach to achieve resilient crops with high yield. With new precise molecular techniques it should be possible to reach economically sustainable yields in a much shorter period of time than ever before in the history of agriculture.","author_count":14,"contributors":["Luo, Guangbin","Najafi, Javad","Correia, Pedro M P","Trinh, Mai Duy Luu","Chapman, Elizabeth A","Østerberg, Jeppe Thulin","Thomsen, Hanne Cecilie","Pedas, Pai Rosager","Larson, Steve","Gao, Caixia","Poland, Jesse","Knudsen, Søren","DeHaan, Lee","Palmgren, Michael"],"cuid":["S01-000.00-418259"],"filters":{"added":"2023-02","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Asia, East","Asia, Middle East","OECD"],"country":["China","Saudi Arabia","United States"],"glorg":["All Global Affiliations","Chinese Academy of Sciences","Kansas University","King Abdullah University of Science and Technology","Utah State University"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-NP","DI-U"],"level3":{"NP":["DI-NP-ALL","DI-NP-CARL"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-NP-CARL","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"accelerated domestication of new crops yield is key","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1093/pcp/pcac065","version":"Published Version"},"id":"S01-000.00-418259","identifier":[{"id":"35583202","type":"pmid"},{"id":"000817308700001","type":"wos"},{"id":"85138609251","type":"scopus"},{"id":"PMC9680862","type":"pmcid"}],"ids":["ku-299a638d-099e-47f3-ae81-c556556cbd0e"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-C7B368BDEB881FDE44AEBC3CA95DFBB4"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1093/pcp/pcac065","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://curis.ku.dk/ws/files/332109738/pcac065.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Plant and Environmental Sciences, Section for Transport Biology"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"carlsberg foundation","l2":"DI-NP","l2n":"Non-Profit Organisations","l3":"DI-NP-CARL","l3nn":"Carlsberg Foundation","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Carlsberg Foundation","namevar":["Carlsberg Laboratory"],"nora_code":"DI-NP-CARL","used":1},{"affno":"3","country":"us","key":"utah state university","loc":["United States","America, North","OECD"],"name":"Utah State 