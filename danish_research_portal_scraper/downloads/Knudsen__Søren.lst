-KU","used":1}],"person":[{"affno":"1","first":"Mette","key":"termansenmettepau","last":"Termansen","name":"Termansen, Mette","rank":1,"rolecode":"pau"},{"affno":"2","first":"Morten","key":"gyllingmortenpau","last":"Gylling","locid":"27d0d73f-eca6-4385-bc2d-6eb3a1ae8fcd","name":"Gylling, Morten","orcid":"0000-0002-2792-5527","rank":2,"rolecode":"pau"},{"affno":"1","first":"Uffe","key":"jørgensenuffepau","last":"Jørgensen","name":"Jørgensen, Uffe","rank":3,"rolecode":"pau"},{"affno":"1","first":"John Erik","key":"hermansenjohnerikpau","last":"Hermansen","name":"Hermansen, John Erik","rank":4,"rolecode":"pau"},{"affno":"1","first":"Line Block","key":"hansenlineblockpau","last":"Hansen","name":"Hansen, Line Block","rank":5,"rolecode":"pau"},{"affno":"1","first":"Marie Trydeman","key":"knudsenmarietrydemanpau","last":"Knudsen","name":"Knudsen, Marie Trydeman","rank":6,"rolecode":"pau"},{"affno":"1","first":"Anders Peter S.","key":"adamsenanderspeterspau","last":"Adamsen","name":"Adamsen, Anders Peter S.","rank":7,"rolecode":"pau"},{"affno":"1","first":"Morten","key":"ambyejensenmortenpau","last":"Ambye-Jensen","name":"Ambye-Jensen, Morten","rank":8,"rolecode":"pau"},{"affno":"2","first":"Mikkel Vestby","key":"jensenmikkelvestbypau","last":"Jensen","locid":"f489bdb6-f064-46e2-a11c-92e83c154e88","name":"Jensen, Mikkel Vestby","orcid":"0000-0003-4872-1491","rank":9,"rolecode":"pau"},{"affno":"1","first":"Søren Krogh","key":"jensensørenkroghpau","last":"Jensen","name":"Jensen, Søren Krogh","rank":10,"rolecode":"pau"},{"affno":"1","first":"Hans Estrup","key":"andersenhansestruppau","last":"Andersen","name":"Andersen, Hans Estrup","rank":11,"rolecode":"pau"},{"affno":"1","first":"Steen","key":"gyldenkærnesteenpau","last":"Gyldenkærne","name":"Gyldenkærne, Steen","rank":12,"rolecode":"pau"}],"pub":{"isbn":["9878793398122"],"issn":["22451684"],"issue":"073","pages":"40","publisher":"DCA - Nationalt Center for Fødevarer og Jordbrug","series":"DCA report","status":"p"},"review":"