ndsen, Mogens","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren T","key":"knudsenpau","last":"Knudsen","locid":"f4fb113c-f8d2-4bb3-9a9d-0bc2ef14590d","name":"Knudsen, Søren Tang","name_org":"Knudsen, Søren T","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Klavs W","key":"hansenpau","last":"Hansen","name":"Hansen, Klavs W","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Per L","key":"poulsenpau","last":"Poulsen","locid":"a965cecb-44f9-4913-a8e1-7bc669e8ffd9","name":"Poulsen, Per Løgstrup","name_org":"Poulsen, Per L","rank":5,"rolecode":"pau"}],"pmid":["21989382"],"pub":{"doi":"10.1097/hjh.0b013e32834b6c04","issn":["02636352","09521178"],"issn_org":["02636352"],"issue":"11","journal":"Journal of Hypertension","pages":"2278-9","publisher":"Lippincott Williams and Wilkins","status":"p","title":"Journal of Hypertension","volume":"29"},"review":"Peer Reviewed","scoID":["2-s2.0-80054110280"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-1e1923d2-59a5-4358-84ce-c2f5bd5bd521"],"src":["AU Aarhus University"],"title":"Ambulatory arterial stiffness index : a composite index reflecting arterial stiffness, blood pressure variability and patients' diurnal cycle","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-146579","year":"2011","yearsub":"2011"}
{"abstract":"Patients with type 2 diabetes mellitus are at increased risk of cardiovascular disease (CVD). We examined the predictive ability of 24-hour ambulatory pulse pressure (24-h PP), ambulatory arterial stiffness index (AASI) and diurnal blood pressure (BP) parameters for fatal and non-fatal CVD in patients with type 2 diabetes mellitus. A total of 108 patients with type 2 diabetes mellitus (mean duration 6.6 years) were followed for 9.5 (0.5-14.5) years. At baseline, all patients underwent ambulatory BP monitoring. During follow-up, 45 patients had cardiovascular (CV) events (35 non-fatal and 10 fatal). In bivariate analysis, events during follow-up were predicted by 24-h PP (P","author_count":6,"contributors":["Laugesen, Esben","Rossen, Niklas B","Poulsen, Per Løgstrup","Hansen, K W","Ebbehøj, Eva","Knudsen, Søren Tang"],"cuid":["S01-000.00-150975"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"pulse pressure and systolic night day ratio interact in prediction of macrovascular disease in patients with type 000000000002 diabetes mellitus","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1038/jhh.2011.9","version":"Other Version"},"id":"S01-000.00-150975","identifier":[{"id":"84857040105","type":"scopus"},{"id":"21390057","type":"pmid"}],"ids":["au-25ac95a3-8dd2-442c-866c-bd2f6311de93"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-3D6A541A913FB23F8A83EC72F63B3A01"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1038/jhh.2011.9","version":"Other Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus University, Faculty of Health Sciences, Medical Research Laboratory"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"E","key":"laugesenpau","last":"Laugesen","locid":"e06ca9b7-d51f-40f2-b042-696ca2b18492","name":"Laugesen, Esben","name_org":"Laugesen, E","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"N B","key":"rossenpau","last":"Rossen","locid":"fde04f7b-b73f-42bb-8fed-7ced5a87b6fc","name":"Rossen, Niklas B","name_org":"Rossen, N B","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"P L","key":"poulsenpau","last":"Poulsen","locid":"a965cecb-44f9-4913-a8e1-7bc669e8ffd9","name":"Poulsen, Per Løgstrup","name_org":"Poulsen, P L","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"K W","key":"hansenpau","last":"Hansen","locid":"53c98d3a-daaa-4d1c-89ab-40977d1a56dd","name":"Hansen, K W","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"E","key":"ebbehøjpau","last":"Ebbehøj","locid":"771ecd1e-220d-410b-8c3e-b83b391fa1f3","name":"Ebbehøj, Eva","name_org":"Ebbehøj, E","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"S T","key":"knudsenpau","last":"Knudsen","locid":"f4fb113c-f8d2-4bb3-9a9d-0bc2ef14590d","name":"Knudsen, Søren Tang","name_org":"Knudsen, S T","rank":6,"rolecode":"pau"}],"pmid":["21390057"],"pub":{"doi":"10.1038/jhh.2011.9","issn":["09509240"],"journal":"Journal of Human Hypertension","publisher":"Springer Nature","status":"p","title":"Journal of Human Hypertension"},"review":"Peer Reviewed","scoID":["2-s2.0-84857040105"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-25ac95a3-8dd2-442c-866c-bd2f6311de93"],"src"