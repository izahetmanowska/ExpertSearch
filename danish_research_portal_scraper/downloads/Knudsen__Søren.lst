d-e3e0d670dcdd","name":"Kær, Søren Knudsen","orcid":"0000-0003-2151-8055","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1109/itec-ap.2014.6940762","isbn":["9781479942404"],"pages":"1-6","place":"Beijing","publisher":"IEEE Press","status":"p","title":"Proceedings of the 2014 IEEE Conference and Expo Transportation Electrification Asia-Pacific (ITEC Asia-Pacific)"},"review":"Peer Reviewed","scoID":["2-s2.0-84916226023"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-7f89dcc5-dd62-4b6b-b634-1b1756e996bf"],"src":["AAU Aalborg University"],"title":"Investigation on the Self-discharge of the LiFePO4/C nanophosphate battery chemistry at different conditions","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-087163","year":"2014","yearsub":"2014"}
{"abstract":"As fuel cells are increasingly commercialized for various applications, harmonized and industry-relevant test procedures are necessary to benchmark tests and to ensure comparability of stack performance results from different parties. This paper reports the results of parametric sensitivity tests performed based on test procedures proposed by a European project, Stack-Test. The sensitivity of a Nafion-based low temperature PEMFC stack’s performance to parametric changes was the main objective of the tests. Four crucial parameters for fuel cell operation were chosen; relative humidity, temperature, pressure, and stoichiometry at varying current density. Furthermore, procedures for polarization curve recording were also tested both in ascending and descending current directions.","author_count":3,"contributors":["Araya, Samuel Simon","Andreasen, Søren Juhl","Kær, Søren Knudsen"],"cuid":["S01-000.00-088163"],"event":{"end":"2014-07-02","place":"Boston, Massachusetts, us","start":"2014-06-29","title":"ASME 2014 8th International Conference on Energy Sustainability &amp; 12th Fuel Cell Science, Engineering and Technology Conference","year":"2014"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"parametric sensitivity tests european pem fuel cell stack test procedures","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1115/FuelCell2014-6378","version":"Other Version"},"id":"S01-000.00-088163","identifier":[{"id":"84912076334","type":"scopus"}],"ids":["aau-82f8c8bb-ea20-4595-9e0a-3dbc9f74e0c3"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-268BB72A46BD86574A6BE5151F70420D"],"oa_link":[{"access":"oa","type":"rem","url":"http://proceedings.asmedigitalcollection.asme.org/proceeding.aspx?articleid=1920873","version":"Other Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1115/FuelCell2014-6378","version":"Other Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (ENG)","Aalborg University, The Faculty of Engineering and Science, AAU Energy","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Fluid Mechanics and Combustion","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Hydrogen and Electro-fuels"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Samuel Simon","key":"arayapau","last":"Araya","locid":"31cc4ce7-c9ae-4406-95d1-b95d4269205f","name":"Araya, Samuel Simon","orcid":"0000-0001-9294-0793","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren Juhl","key":"andreasenpau","last":"Andreasen","locid":"02115d16-a485-4ac6-b914-7460ef6c4e83","name":"Andreasen, Søren Juhl","orcid":"0000-0002-0767-5874","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren Knudsen","key":"kærpau","last":"Kær","locid":"898d6584-ec2e-430a-b78d-e3e0d670dcdd","name":"Kær, Søren Knudsen","orcid":"0000-0003-2151-8055","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1115/fuelcell2014-6378","eisbn":["9780791845882"],"place":"Boston, USA","publisher":"The American Society of Mechanical Engineers (ASME)","status":"p","subtitle":"ES/FuelCell 2014","title":"ASME 2014 12th International Conference on Fuel Cell Science, Engineering and Technology collocated with the ASME 2014 8th International Conference on Energy Sustainability"},"review":"Peer Reviewed","scoID":["2-s2.0-84912076334"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-82f8c8bb-ea20-4595-9e0a-3dbc9f74e0c3"],"src":["AAU Aalborg University"],"title":"Parametric Sensitivity Tests- European PEM Fuel Cell Stack Test Procedures","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-088163","year":"2014","yearsub":"2014"}
{"abstract":"This paper analyzes the effects of methanol and water vapor on the performance of a high temperature proton exchange membrane fuel cell (HT-PEMFC) at varying temperatures, ranging from 140 °C to 180 °C. For the study, a H3PO4 – doped polybenzimidazole (PBI) – based membrane electrode assembly (MEA) of 45 cm2 active surface area from BASF was employed. The study showed overall negligible effects of methanol-water vapor mixture slips on performance, even at relatively low simulated steam methanol reforming conversion of 90%, which corresponds to 3% methanol vapor by volume in the anode gas feed. Temperature on the other hand has significant impact on the performance of an HT-PEMFC. To assess the effects of methanol-water vapor mixture alone, CO2 and CO are not considered in these tests. The analysis is based on polarization curves and impedance spectra registered for all the test points. After the performance tests, endurance test was performed for 100 h at 90% methanol conversion and an overall degradation rate of −55 μV/h was recorded.","author_count":5,"contributors":["Araya, Samuel Simon","Grigoras, Ionela","Zhou, Fan","Andreasen, Søren Juhl","Kær, Søren Knudsen"],"cuid":["S01-000.00-100495"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Fuel cell","High temperature PEM","Impedance spectroscopy","Methanol"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"performance and endurance of a high temperature pem fuel cell operated on methanol reformate","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/205441130/Artcle_SSA_methanol_PEM.pdf","version":"Pre-print"},"id":"S01-000.00-100495","identifier":[{"id":"84908181038","type":"scopus"},{"id":"WOS:000345804600019","type":"wos"}],"ids":["aau-ade9ffbe-517b-41f7-8dee-70030b93a595"],"keyword":["Fuel cell","High temperature PEM","Impedance spectroscopy","Methanol"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-57E684CF8B7379D1664CA2F101064897"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/205441130/Artcle_SSA_methanol_PEM.pdf","version":"Pre-print"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (ENG)","Aalborg University, The Faculty of Engineering and Science, AAU Energy","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Fluid Mechanics and Combustion","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Hydrogen and Electro-fuels"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Samuel Simon","key":"arayapau","last":"Araya","locid":"31cc4ce7-c9ae-4406-95d1-b95d4269205f","name":"Araya, Samuel Simon","orcid":"0000-0001-9294-0793","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ionela","key":"grigoraspau","last":"Grigoras","locid":"1eeff737-15ec-4ee3-a58d-e273ca970287","name":"Grigoras, Ionela","orcid":"0000-0002-1846-6568","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Fan","key":"zhoupau","last":"Zhou","locid":"874642c9-fe83-4b87-9b5e-9b8088c39e6a","name":"Zhou, Fan","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren Juhl","key":"andreasenpau","last":"Andreasen","locid":"02115d16-a485-4ac6-b914-7460ef6c4e83","name":"And