lmpau","last":"Holm","locid":"4b713f1e-9aa5-4065-9c2e-9de76ee44fd4","name":"Holm, Christian K","rank":38,"rolecode":"pau"}],"pmid":["33009401"],"pub":{"doi":"10.1038/s41467-020-18764-3","issn":["20411723"],"issue":"1","journal":"Nature Communications","paperid":"4938","publisher":"Nature Research","status":"p","title":"Nature Communications","volume":"11"},"review":"Peer Reviewed","scoID":["2-s2.0-85091870221"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Private Research","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Companies","Other Research","Private Research","Universities","University of Copenhagen","omiics aps","omiics aps (biz)"],"PST":["Published"]},"sid":["au-3186bbcd-508f-49c4-981d-bb873ec17e05","ku-9a53c098-7cbd-46d8-83e2-e25b717d7ff2"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"SARS-CoV2-mediated suppression of NRF2-signaling reveals potent antiviral and anti-inflammatory activity of 4-octyl-itaconate and dimethyl fumarate","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.00-016215","year":"2020","yearsub":"2020"}
{"abstract":"Accumulating evidence has implicated an involvement of the gut-brain axis in autism spectrum disorder (ASD) and attention-deficit hyperactivity disorder (ADHD), however with highly diverse results. This systematic review aims to describe and evaluate studies investigating the gut microbiota composition in individuals with ASD or ADHD and to evaluate if variations in gut microbiota are associated with these disorders.Twenty-four articles were identified in a systematic literature search of PubMed and Embase up to July 22, 2019. They consisted of 20 studies investigating ASD and four studies investigating ADHD. For ASD, several studies agreed on an overall difference in β-diversity, although no consistent bacterial variation between all studies was reported. For ADHD, the results were more diverse, with no clear differences observed.Several common characteristics in gut microbiota function were identified for ASD compared to controls. In contrast, highly heterogeneous results were reported for ADHD, and thus the association between gut microbiota composition and ADHD remains unclear. For both disorders, methodological differences hampered the comparison of studies.","author_count":7,"contributors":["Bundgaard-Nielsen, Caspar","Knudsen, Julie Kristine","Leutscher, Peter Derek Christian","Lauritsen, Marlene Briciet","Nyegaard, Mette","Hagstrøm, Søren","Sørensen, Suzette"],"cuid":["S02-100.00-003046"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Attention deficit hyperactivity disorder","Autism spectrum disorder","Gut brain axis","Microbiome","Microbiota","Neurodevelopmental disorders","Systematic review"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"gut microbiota profiles of autism spectrum disorder and attention deficit hyperactivity disorder a systematic literature review","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"djr","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND 4.0","type":"doi","url":"https://doi.org/10.1080/19490976.2020.1748258","version":"Published Version"},"id":"S02-100.00-003046","identifier":[{"id":"32329656","type":"pmid"},{"id":"85085055376","type":"scopus"},{"id":"PMC7524304","type":"pmcid"},{"id":"000532249200001","type":"wos"}],"ids":["aau-3e117049-b4c4-4a84-9354-a491fc59cdec","au-cb43aa18-f617-40c6-877f-242c0d9b7eaa"],"keyword":["Autism Spectrum Disorder","attention-deficit hyperactivity disorder","gut-Brain axis","microbiome","microbiota","neurodevelopmental disorders","systematic Review"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-45E7B9DF51494E5E4EEE0056F53E516D"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/392207882/Bundgaard_Nielsen_et_al._2020_Gut_microbiota_profiles_of_autism_spectrum_disorder_and_attention_deficit_hyperactivity_disorder_A_systematic_literature_review.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND 4.0","type":"doi","url":"https://doi.org/10.1080/19490976.2020.1748258","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine, Center for Clinical Research","Aalborg University, The Faculty of Medicine, North Denmark Regional Hospital"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Biomedicine, Department of Biomedicine - Forskning og uddannelse, Skou-bygningen"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Caspar","key":"bundgaardnielsenpau","last":"Bundgaard-Nielsen","locid":"621f32eb-b0ed-4146-bed9-a4b793ee401d","name":"Bundgaard-Nielsen, Caspar","orcid":"0000-0002-2700-2378","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Julie","key":"knudsenpau","last":"Knudsen","locid":"b053499a-79c3-4a1f-8e1e-df2ac4b5e2bf","name":"Knudsen, Julie Kristine","name_org":"Knudsen, Julie","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Peter D C","key":"leutscherpau","last":"Leutscher","locid":"56e8c48e-c3f9-4a4d-8b9b-0719c74da258","name":"Leutscher, Peter Derek Christian","name_org":"Leutscher, Peter D C","orcid":"0000-0003-1168-4041","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Marlene B","key":"lauritsenpau","last":"Lauritsen","locid":"056282ec-92a4-4b4c-8957-ba197067e261","name":"Lauritsen, Marlene Briciet","name_org":"Lauritsen, Marlene B","orcid":"0000-0001-7284-9255","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Mette","key":"nyegaardpau","last":"Nyegaard","locid":"a34df7ff-0fb5-44b0-8255-6dc2c9b962f3","name":"Nyegaard, Mette","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren","key":"hagstrømpau","last":"Hagstrøm","locid":"fe472f53-6bcd-4587-8287-df1539f689c3","name":"Hagstrøm, Søren","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Suzette","key":"sørensenpau","last":"Sørensen","locid":"c96d8309-747c-403d-a858-2efad1aea498","name":"Sørensen, Suzette","orcid":"0000-0002-4201-1168","rank":7,"rolecode":"pau"}],"pmid":["32329656"],"pub":{"doi":"10.1080/19490976.2020.1748258","issn":["19490976","19490984"],"issn_org":["19490976"],"issue":"5","journal":"Gut Microbes","pages":"1172-1187","publisher":"Landes Bioscience","status":"p","title":"Gut Microbes","volume":"11"},"review":"Peer Reviewed","scoID":["2-s2.0-85085055376"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-3e117049-b4c4-4a84-9354-a491fc59cdec","au-cb43aa18-f617-40c6-877f-242c0d9b7eaa"],"src":["AAU Aalborg University","AU Aarhus University"],"title":"Gut microbiota profiles of autism spectrum disorder and attention deficit/hyperactivity disorder : A systematic literature review","type":"Journal Review","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-003046","year":"2020","yearsub":"2020"}
{"abstract":"BACKGROUND: Fulvestrant is a selective oestrogen receptor (ER) degrader used as monotherapy and combination therapy for ER positive HER2 negative advanced breast cancer (ABC) in postmenopausal women. The drug response predictor (DRP), is a mathematical algorithm based on the expression of multiple genes in the tumour. The fulvestrant DRP algorithm has previously shown effect in BC. In this study, we investigated the DRP's potential in predicting fulvestrant benefit. METHOD: Among 695 patients with ABC prospectively included in a Danish Breast Cancer Cooperative Group (DBCG) cohort we retrospectively included 226 patients who received fulvestrant as monotherapy. The DRP result was based on mRNA extracted from tumour biopsies and analysed using Affymetrix array. Primary endpoint was time to progression (TTP). RESULTS: For patients who received fulvestrant in line one to four and were previously unexposed to adjuvant endocrine therapy, we identified a hazard ratio (HR) of 0.44 (90% confidence interval (90% CI) upper limit of 1.08, one sided p = 0.066) for a predicted positive vs negative outcome. A weaker association was seen when including patients exposed to adjuvant endocrine treatment or received fulvestrant in fifth or later lines. Exploratory analyses showed that the DRP was efficient when using recent biopsies for DRP estimate and among recently treated patients. CONCLUSION: The DRP showed a potential in predicting fulvestrant treatment but was not significant in the overall analysis. Use of older biopsies, long-term endocrine treatment and multiple therapies between biopsy used for analysis and fulvestrant treatment, probably affect the predictive accuracy.","author_count":20,"contributors":["Christensen, Troels Dreier","Buhl, Anna Sofie Kappel","Christensen, Ib Jarle","Buhl, Ida Kappel","Balslev, Eva","Knoop, Ann S","Danø, Hella","Glavicic, Vesna","Luczak, Adam Andrzej","Langkjer, Sven Tyge","Linnet, Søren","Jakobsen, Erik Hugger","Bogovic, Jurij","Ejlertsen, Bent","Rasmussen, Annie","Hansen, Anker","Knudsen, Steen","Jensen, Peter Buhl","Nielsen, Dorte"],"cuid":["S04-100.00-010049"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"corresponding_author":["Christensen, Troels Dreier"],"keyword":["Advanced breast cancer","American Society","Biomarker","Biomarkers","Combination","Double blind","Fulvestrant","Messenger RNA","Postmenopausal women","TRIAL","Therapy"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA"],"OT":["Oncology Venture, Hoersholm, Denmark."],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"prediction of fulvestrant efficacy in patients with advanced breast cancer retrospective prospective evaluation of the predictive potential of a multigene expression assay","src":["aau","au","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85074584004","version":"Other Version"},"id":"S04-100.00-010049","identifier":[{"id":"85074584004","type":"scopus"},{"id":"000492546000001","type":"wos"},{"id":"31654283","type":"pmid"}],"ids":["aau-d1d4ebd4-bbbe-47d8-b6d6-f31553425b7b","au-52a8296b-169b-4000-89da-23c00aea5b26","ku-a3dc48af-0b5a-446a-bdb9-cc0098d180b5","sdu-b4c14942-fd49-455a-a22e-75c50a51f909"],"keyword":["500 MG","AMERICAN SOCIETY","Advanced breast cancer","BIOMARKERS","Biomarker","COMBINATION","DOUBLE-BLIND","Fulvestrant","Messenger RNA","POSTMENOPAUSAL WOMEN","THERAPY","TRIAL"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-