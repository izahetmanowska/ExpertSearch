"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-7b3c71bc-7276-498e-b462-d3e22639b770"],"src":["AU Aarhus University"],"title":"A Rare Case of Embryonal Carcinoma in a Patient with Turner Syndrome without Y Chromosomal Material but Mutations in KIT, AKT1, and ZNF358 Demonstrated Using Exome Sequencing","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-199833","year":"2018","yearsub":"2018"}
{"abstract":"Focus on evidence-based policymaking is greater than ever, and public spending on evaluations is rising. A primary merit of these expenditures is that politicians actually use new knowledge instrumentally - to influence and inform decision making. Nevertheless, we know surprisingly little about whether and how research-based knowledge is utilised. This paper presents a new way of documenting Degrees of Knowledge Utilisation: The DoKU-scale. The scale is tested empirically in a five-year meta-evaluation covering 54 evaluations and 334 legal sources. Through robust method triangulation, the DoKU-scale enables comparison of knowledge utilisation across large numbers of knowledge sources and over time.","author_count":1,"contributors":["Bøllingtoft Knudsen, Søren"],"cuid":["S01-000.00-201847"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"1 contributor","cluster_size":1,"corresponding_author":["Bøllingtoft Knudsen, Søren"],"keyword":["Evidence based policy making","Measurement instrument","meta evaluation"],"level":"sci","mra":["soc"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"developing and testing a new measurement instrument for documenting instrumental knowledge utilisation the degrees of knowledge utilization doku scale","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85042423684","version":"Other Version"},"id":"S01-000.00-201847","identifier":[{"id":"85042423684","type":"scopus"},{"id":"000427722000004","type":"wos"}],"ids":["au-7ebfdcd9-f5d3-4534-90ee-30e8cbf47f1a"],"keyword":["Instrumental knowledge utilisation","evidence-based policy making","measurement instrument","meta-evaluation"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-4-DBA760D69F07ADC02743DAC371810DF7"],"oai":{"class":"Unused","mra":["Social Science (SOC)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus BSS, Department of Political Science"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Soren Bollingtoft","key":"knudsenpau","last":"Knudsen","locid":"2439dd14-a6dd-434d-89bd-8970f3126ced","name":"Bøllingtoft Knudsen, Søren","name_org":"Knudsen, Soren Bollingtoft","rank":1,"rolecode":"pau"}],"pub":{"doi":"10.1332/174426417x14875895698130","issn":["17442648","17442656"],"issn_org":["17442648"],"issue":"1","journal":"Evidence and Policy","pages":"63-80","publisher":"Policy Press","status":"p","title":"Evidence and Policy","volume":"14"},"review":"Peer Reviewed","scoID":["2-s2.0-85042423684"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-7ebfdcd9-f5d3-4534-90ee-30e8cbf47f1a"],"src":["AU Aarhus University"],"title":"Developing and testing a new measurement instrument for documenting instrumental knowledge utilisation: the Degrees of Knowledge Utilization (DoKU) scale","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-201847","year":"2018","yearsub":"2018"}
{"author_count":5,"contributors":["Knudsen, Julie Kristine","Bundgaard-Nielsen, Caspar","Hagstrøm, Søren","Sørensen, Suzette","Leutscher, Peter"],"cuid":["S01-000.00-232169"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Knudsen, Julie Kristine"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"geneksden humane tarmmikrobiota","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85054911847","version":"Other Version"},"id":"S01-000.00-232169","identifier":[{"id":"85054911847","type":"scopus"}],"ids":["au-b4404973-90af-4a9d-81d8-02fa65d66bb4"],"lang":"Danish","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-2-751F4C083A0160DEB56FF4C66535919B"],"oai":{"class":"Blocked","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Translational Neuropsychiatry Unit"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University (AAU)"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Julie Kristine","key":"knudsenpau","last":"Knudsen","locid":"7e1d54b4-832c-4ac4-bfcf-6e9933fc6b4e","name":"Knudsen, Julie Kristine","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Caspar","key":"bundgaardnielsenpau","last":"Bundgaard-Nielsen","name":"Bundgaard-Nielsen, Caspar","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Søren","key":"hagstrømpau","last":"Hagstrøm","name":"Hagstrøm, Søren","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Suzette","key":"sørensenpau","last":"Sørensen","name":"Sørensen, Suzette","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Peter","key":"leutscherpau","last":"Leutscher","name":"Leutscher, Peter","rank":5,"rolecode":"pau"}],"pub":{"issn":["00415782","13994174"],"issn_org":["00415782"],"issue":"6","journal":"Ugeskrift for Læger","pages":"509-513","publisher":"Almindelige Danske Lægeforening","status":"p","title":"Ugeskrift for Læger","volume":"180"},"review":"Peer Reviewed","scoID":["2-s2.0-85054911847"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-b4404973-90af-4a9d-81d8-02fa65d66bb4"],"src":["AU Aarhus University"],"title":"geneksDen humane tarmmikrobiota","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-232169","year":"2018","yearsub":"2018"}
{"abstract":"Aims: To evaluate the clinical effectiveness of switching to insulin degludec (IDeg) in insulin-treated patients with either type 1 diabetes (T1DM) or type 2 diabetes (T2DM) under conditions of routine clinical care. Materials and Methods: This was a multicentre, retrospective, chart review study. In all patients, basal insulin was switched to IDeg at least 6 months before the start of data collection. Baseline was defined as the most recent recording during the 3-month period before first prescription of IDeg. Values are presented as mean [95%CI]. Results: T1DM (n = 1717): HbA1c decreased by −2.2 [−2.6; −2.0] mmol/mol (−0.20 [−0.24; −0.17]%) at 6 months vs baseline (P <.001). Rate ratio of overall (0.79 [0.69; 0.89]), non-severe nocturnal (0.54 [0.42; 0.69]) and severe (0.15 [0.09; 0.24]) hypoglycaemia was significantly lower in the 6-month post-switch period vs the pre-switch period (P <.001 for all). Total daily insulin dose decreased by −4.88 [−5.52; −4.24] U (−11%) at 6 months vs baseline (P <.001). T2DM (n = 833): HbA1c decreased by −5.6 [−6.3; −4.7] mmol/mol (−0.51 [−0.58; −0.43] %) at 6 months vs baseline (P <.001). Rate ratio of overall (0.39 [0.27; 0.58], P <.001), non-severe nocturnal (0.10 [0.06; 0.16], P <.001) and severe (0.075 [0.01; 0.43], P =.004) hypoglycaemia was significantly lower in the 6-month post-switch period vs the pre-switch period. Total daily insulin dose decreased by −2.48 [−4.24; −0.71] U (−3%) at 6 months vs baseline (P =.006). Clinical outcomes for T1DM and T2DM at 12 months were consistent with results at 6 months. Conclusions: This study demonstrates that switching patients to IDeg from other basal insulins improves glycaemic control and significantly reduces the risk of hypoglycaemia in routine clinical practice.","author_count":8,"contributors":["Siegmund, Thorsten","Tentolouris, Nikolaos","Knudsen, Søren Tang","Lapolla, Annunziata","Prager, Rudolf","Phan, Tra-Mi","Wolden, Michael L","Schultes, Bernd"],"cuid":["S01-000.00-239067"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","OECD"],"corpau":["EU-TREAT study group"],"country":["Austria","Germany","Greece","Italy","Switzerland"],"glorg":["All Global Affiliations","Isar Kliniken","Kantonsspital St. Gallen, St. Gallen, Switzerland.","Klinik Hietzing","University of Athens","University of Padova"],"keyword":["Journal Article"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-NOVO"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-PR-NOVO","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"a european multicentre retrospective non interventional study eu treat of the effectiveness of insulin degludec after switching basal insulin in a population with type 000000000001 or type 000000000002 diabetes","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://onlinelibrary.wiley.com/doi/epdf/10.1111/dom.13149","version":"Published Version"},"id":"S01-000.00-239067","identifier":[{"id":"PMC5836866","type":"pmcid"},{"id":"29106039","type":"pmid"},{"id":"85034766656","type":"scopus"}],"ids":["au-c04d8ea6-0463-47ae-b3f5-c5089697c00b"],"keyword":["Journal Article"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-88BD5EC223E1B93524D1A992482BF625"],"oa_link":[{"access":"oa","type":"rem","url":"https://onlinelibrary.wiley.com/doi/epdf/10.1111/dom.13149","version":"Published Version"},{"access":"oa","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC5836866/","version":"Other Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","country":"de","key":"isar kliniken","loc":["Germany","Europe, EU","OECD"],"name":"Isar Kliniken","used":1},{"affno":"2","country":"gr"