 Non-EU","OECD"],"name":"University of Oxford","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Thomas Johannesson","key":"hjelholtpau","last":"Hjelholt","locid":"e22aa9dd-c881-4afe-a9cb-55a9f34bc851","name":"Hjelholt, Thomas Johannesson","orcid":"0000-0003-0112-5801","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Søren Paaske","key":"johnsenpau","last":"Johnsen","name":"Johnsen, Søren Paaske","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Peter Krogh","key":"brynningsenpau","last":"Brynningsen","locid":"a3a18e78-2821-4c06-a1b0-89af79a8e8a0","name":"Brynningsen, Peter Krogh","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jakob Schöllhammer","key":"knudsenpau","last":"Knudsen","locid":"a6558780-c573-49a5-8f1e-f8aa9db17bb5","name":"Knudsen, Jakob Schöllhammer","orcid":"0000-0002-3772-4497","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Daniel","key":"prietoalhambrapau","last":"Prieto-Alhambra","name":"Prieto-Alhambra, Daniel","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Alma Becic","key":"pedersenpau","last":"Pedersen","locid":"797cacd6-5e68-4aac-a0fa-db74425f732b","name":"Pedersen, Alma Becic","orcid":"0000-0002-3288-9401","rank":6,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-1017f165-5ace-4e86-8d33-df35373c8fe4"],"src":["AU Aarhus University"],"title":"Development and validation of a prediction model for mortality in patients with hip fracture: Population-based cohort study","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-138589","year":"2021","yearsub":"2021"}
{"abstract":"This chapter explores current ambivalences towards using competition between students as a means to intensify learning. The analysis builds on a case study from a Danish school where games are used to motivate second graders to maximize their learning. The current learning paradigm views the intensity of competition as desirable for motivational purposes. At the same time, the downsides of competition are seemingly avoided because there is no scarcity of prizes and therefore no losers. It becomes an open question whether game-playing is in fact competition or not. Individual students must therefore decide themselves whether competing is the most effective way of sustaining their learning. The analysis concludes that current ambivalences towards competition do not primarily stem from a care for cooperation and community but from a care for the individual’s maximized learning. Theoretically, the chapter introduces the notion of side-glance to understand competition as a form of observation.","author_count":5,"contributors":["Christensen, Søren","Knudsen, Hanne"],"cuid":["S01-000.00-191044"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Desire","Gamification","Observation"],"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"the organization of competition and non competition in schools","src":["au"],"src-code":["DI-U-AU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.au.dk/ws/files/291546041/The_organization_of_non_competition_ahead_of_publication.pdf","version":"Other Version"},"id":"S01-000.00-191044","identifier":[{"id":"85128570430","type":"scopus"}],"ids":["au-6c3725b8-eb25-4ec4-b074-01624ff42ca6"],"keyword":["Desire","Educational competition","Gamification","Observation","Side-glance","Third party"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Global-Local-2-3-9541B1D6B5181CF7BA301C87980A4194"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.au.dk/ws/files/291546041/The_organization_of_non_competition_ahead_of_publication.pdf","version":"Other Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Arts, Danish School of Education, Danish School of Education - Education Studies, Emdrup"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Søren","key":"christensenpau","last":"Christensen","locid":"c6bf7b94-cdf4-4abe-8e80-5526aacfd66c","name":"Christensen, Søren","orcid":"0000-0002-1335-0806","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Hanne","key":"knudsenpau","last":"Knudsen","locid":"64613f11-d8e3-46a7-9eae-4a4a50cf9fdc","name":"Knudsen, Hanne","orcid":"0000-0003-3879-0629","rank":2,"rolecode":"pau"},{"affno":"","first":"Nils","key":"brunssonpedh","last":"Brunsson","name":"Brunsson, Nils","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Stefan","key":"jonssonpedh","last":"Jonsson","name":"Jonsson, Stefan","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Raimund","key":"hassepedh","last":"Hasse","name":"Hasse, Raimund","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"eisbn":["9780192898012"],"isbn":["9780192898012"],"pages":"162-175","place":"Oxford","publisher":"Oxford University Press","status":"p","subtitle":"What it is and why it happens","title":"Competition"},"review":"Peer Reviewed","scoID":["2-s2.0-85128570430"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-AL