ocal.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-732949","year":"2013","yearsub":"2013"}
{"abstract":"Groundwater in front of warm-based glaciers is likely to become a more integrated part of the future proglacial hydrological system at high latitudes due to global warming. Here, we present the first monitoring results of shallow groundwater chemistry and geochemical fingerprinting of glacier meltwater in front of a warm-based glacier in Southeast Greenland (Mittivakkat Gletscher, 65 degrees 41 N, 37 degrees 48 W). The groundwater temperature, electrical conductivity and pressure head were monitored from August 2009 to August 2011, and water samples were collected in 2009 and analyzed for major ions and water isotopes (D, 18O). The 2yrs of monitoring revealed that major outbursts of glacier water during the ablation season flushed the proglacial aquifer and determined the groundwater quality for the next 2-8 weeks until stable chemical conditions were reached again. Water isotope composition shows that isotopic fractionation occurs in both groundwater and glacier meltwater, but fractionation due to evaporation from near-surface soil moisture prior to infiltration has the most significant effect. This study shows that groundwater in Low Arctic Greenland is likely to possess a combined geochemical and isotopic composition, which is distinguishable from other water sources in the proglacial environment. However, the shallow groundwater composition at a given time is highly dependent on major outbursts of glacier water in the previous months.","author_count":7,"contributors":["Kristiansen, Søren Munch","Yde, Jacob Clement","Barcena, Teresa Gomez","Jakobsen, Bjarne Holm","Olsen, Jesper","Knudsen, N. Tvis"],"cuid":["S02-095.92-026111"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, Non-EU","Nordic","OECD"],"country":["Norway"],"glorg":["All Global Affiliations","University College","Western Norway University of Applied Sciences"],"keyword":["Greenland","Groundwater","Grundvand","Grønland","Vand","geokemi","surface water interactions"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-UND"]},"level3all":["DI-U-AU","DI-U-KU","DI-U-UND"]},"review":"pr","rtype":["clu"],"sorti":"geochemistry of groundwater in front of a warm based glacier in southeast greenland","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1111/geoa.12003","version":"Other Version"},"id":"S02-095.92-026111","identifier":[{"id":"84878643705","type":"scopus"}],"ids":["au-b8c72f00-c0d6-11df-8cb9-000ea68e967b","ku-6fbede08-0132-4cbc-ad90-47f9f9db6191"],"keyword":["Greenland","Grønland","Vand","geokemi","glacial weathering","glacier meltwater","groundwater","grundvand","isotope hydrology","surface water interactions"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-C0D8E36815232BF9117C185805C2C8F3"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1111/geoa.12003","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Geoscience"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"unclear universities","l2":"DI-U","l2n":"Universities","l3":"DI-U-UND","l3nl":"Undetermined","l3nn":"Unclear Universities","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Unclear Universities","namevar":["Institut for Geoscience"],"nora_code":"DI-U-UND","used":1},{"affno":"3","country":"no","key":"western norway university of applied sciences","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"Western Norway University of Applied Sciences","used":1},{"affno":"4","country":"no","key":"university college","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"University College","used":1},{"affno":"5","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Geosciences and Natural Resource Management, Geology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1 2","corresponding":null,"country":"dk","first":"Søren Munch","key":"kristiansenpau","last":"Kristiansen","locid":"96d56247-9432-4030-9387-cdb020665136","name":"Kristiansen, Søren Munch","orcid":"0000-0003-3128-4061","rank":1,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Jacob Clement","key":"ydepau","last":"Yde","name":"Yde, Jacob Clement","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Teresa Gomez","key":"barcenapau","last":"Barcena","name":"Barcena, Teresa Gomez","rank":3,"rolecode":"pau"},{"affno":"","first":"Teresa G","key":"bárcenapau","last":"Bárcena","locid":"056521fe-793d-40c1-a882-78fd656a29ee","name":"Bárcena, Teresa G","rank":3,"rolecode":"pau"},{"affno":"5","first":"Bjarne Holm","key":"jakobsenpau","last":"Jakobsen","locid":"c23c014e-4640-47d3-a968-152c1aa1bef0","name":"Jakobsen, Bjarne Holm","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper","key":"olsenpau","last":"Olsen","locid":"2e527ce1-e5f9-44c3-8896-acd476b303ea","name":"Olsen, Jesper","orcid":"0000-0002-4445-5520","rank":5,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"N. Tvis","key":"knudsenpau","last":"Knudsen","locid":"9a2f0627-7856-4ac4-b42d-f3357daa9557","name":"Knudsen, N. Tvis","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1111/geoa.12003","issn":["04353676","14680459"],"issn_org":["04353676"],"issue":"2","journal":"Geografiska Annaler: Series A, Physical Geography","pages":"97-108","publisher":"Taylor and Francis Ltd.","status":"p","title":"Geografiska Annaler: Series A, Physical Geography","volume":"95"},"review":"Peer Reviewed","scoID":["2-s2.0-84878643705"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Undetermined","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-b8c72f00-c0d6-11df-8cb9-000ea68e967b","ku-6fbede08-0132-4cbc-ad90-47f9f9db6191"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Geochemistry of groundwater in front of a warm-based glacier in Southeast Greenland","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-095.92-026111","year":"2013","yearsub":"2013"}
{"abstract":"The paper investigates the potential of using lumped stationary battery energy storage systems (BESS) in the public low-voltage distribution grid in order to defer upgrades needed in case of large penetration of electric vehicle (EV), electrified heat pump (HP) in presence of photovoltaic (PV) panel on the view of techno economic optimal sizing taking the consideration of season-based diurnal dynamics. The BESS is primarily dimensioned for the peak shaving operation targeted for the counterbalance of overloading of transformer; BESS also participates in arbitrage (buy low, sell high) application. The paper assesses the effects of a PV-BESS combination and the control of such a system with the help of a newly devised season specific BESS control protocol that ensures the availability of energy for peak-shaving purpose (namely peak period in winter) and it participates in arbitrage. The objective of this paper is to develop and detail the method of optimum sizing energy storage for grid connected distribution systems using newly devised BESS control protocol and investigate its sensitivity to factors which are known to influence energy system performance and hence storage requirements. The results provide insight into the dimensioning and the required specification and configuration of BESS.","author_count":4,"contributors":["Khan, Mohammad Rezwan","Mulder, Grietus","Van Mierlo, Joeri","Kær, Søren Knudsen"],"cuid":["S01-000.00-070803"],"event":{"end":"2013-10-04","place":"Villepinte, fr","start":"2013-09-30","title":"28th European Photovoltaic Solar Energy Conference and Exhibition","year":"2013"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Belgium","Netherlands"],"glorg":["All Global Affiliations","Vlaamse Instelling voor Technologisch Onderzoek","Vrije Universiteit Amsterdam"],"keyword":["Batteries","Economic analysis","Grid control","Grid integration","Grid management","PV system"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"the integration and control of multifunctional stationary pv battery systems in smart distribution grid","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/195498933/5EO.3.4_EUPVSEC_Full.pdf","version":"Pre-print"},"id":"S01-000.00-070803","ids":["aau-4797da61-eda4-4912-a81e-b49f34c8e51a"],"keyword":["Batteries","Battery storage and Control","Economic Analysis","Grid Control","Grid Integration","Grid Management","Large Grid-connected PV systems","PV System"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-78A170037B04994A355AF823156C86A5"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.4229/28thEUPVSEC2013-5EO.3.4","version":"Other Version"},{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/195498933/5EO.3.4_EUPVSEC_Full.pdf","version":"Pre-print"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (ENG)","Aalborg University, The Faculty of Engineering and Science, AAU Energy"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"be","key":"vlaamse instelling voor technologisch onderzoek","loc":["Belgium","Europe, EU","OECD"],"name":"Vlaamse Instelling voor Technologisch Onderzoek","used":1},{"affno":"3","country":"nl","key":"vrije universiteit amsterdam","loc":["Netherlands","Europe, EU","OECD"],"name":"Vrije Universiteit Amsterdam","used":1}],"person":[{"affno":"1","corresponding":null,"countr