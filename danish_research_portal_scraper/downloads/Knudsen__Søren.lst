N University College of Northern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"UCN University College of Northern Denmark","namevar":["University College of Nothern Denmark"],"nora_code":"DI-UC-UCN","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Peter Hougaard","key":"madsenpau","last":"Madsen","locid":"d02f0012-c41d-4501-9d6a-a86c75b5e8df","name":"Madsen, Peter Hougaard","orcid":"0000-0002-1894-8452","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Peter","key":"jespersenpau","last":"Jespersen","name":"Jespersen, Peter","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Morten","key":"korfpau","last":"Korf","name":"Korf, Morten","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Kate Thais","key":"akselsenpau","last":"Akselsen","name":"Akselsen, Kate Thais","rank":4,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Jannie Lynggaard","key":"prætoriuspau","last":"Prætorius","name":"Prætorius, Jannie Lynggaard","rank":5,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Stinus Lundum Storm","key":"mikkelsenpau","last":"Mikkelsen","name":"Mikkelsen, Stinus Lundum Storm","rank":6,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Rikke Osbahr","key":"ebsenpau","last":"Ebsen","name":"Ebsen, Rikke Osbahr","rank":7,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Ole","key":"gammelgaardpau","last":"Gammelgaard","name":"Gammelgaard, Ole","rank":8,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Søren Bøjgård Schleicher","key":"andersenpau","last":"Andersen","name":"Andersen, Søren Bøjgård Schleicher","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Brian Han","key":"knudsenpau","last":"Knudsen","locid":"673cf9c1-bf87-4087-97e7-f485d89d89e1","name":"Knudsen, Brian Han","rank":10,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Søren","key":"pjengaardpau","last":"Pjengaard","name":"Pjengaard, Søre