seases","paperid":"1100","status":"p","title":"BMC Infectious Diseases","volume":"25"},"review":"Peer Reviewed","scoID":["2-s2.0-105015084651"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-65897844-ca7c-4e84-bcc7-fe78e2e8be17"],"src":["KU University of Copenhagen"],"title":"No changes in weight, body composition or metabolic parameters after the switch to dolutegravir and lamivudine compared to continued treatment with dolutegravir, abacavir and lamivudine for virologically suppressed HIV infection (The AVERTAS trial)","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-829035","year":"2025","yearsub":"2025"}
{"abstract":"This review presents a systemic model examining the root causes and impacts of clinician burnout on healthcare staff, patient care (quality and safety), organizations, and society, with examples from Denmark. The model highlights the need to address complex interrelations within systems rather than viewing burnout as an isolated issue. Systematic improvements are crucial and must be pursued with the same rigour as clinical agendas. Further research based on this model is needed to explore the links between burnout, care quality, and its broader consequences.","author_count":5,"contributors":["Knudsen, Søren Valgreen","Mainz, Jeppe","Hansen, Mille Mejlby","Johnsen, Søren Paaske","Mainz, Jan"],"cuid":["S02-089.80-822363"],"filters":{"added":"2025-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"corresponding_author":["Knudsen, Søren Valgreen"],"keyword":["Burnout Professional etiology","Denmark","Health Personnel psychology","Humans","Physicians psychology","Quality of Health Care"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-NDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-NDR","DI-U-AAU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"udbrændthed blandt klinikere","src":["aau","sdu"],"src-code":["DI-U-AAU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.61409/V12240862","version":"Published Version"},"id":"S02-089.80-822363","identifier":[{"id":"105009657041","type":"scopus"},{"id":"40539297","type":"pmid"}],"ids":["aau-7c002c7e-4845-4687-a452-b19b3752152e","sdu-28cd7c95-d5fe-496f-9015-4f5c2225b8ff"],"keyword":["Burnout, Professional/etiology","Denmark","Health Personnel/psychology","Humans","Physicians/psychology","Quality of Health Care"],"lang":"Danish","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-AA1C43C13A033B8F9CCC93076D7EB052"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.61409/V12240862","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/295085179/V12240862_WEB.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/788575678/Knudsen_et_al_2025_Udbr_ndthed_blandt_klinikere.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Social Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Psychiatry","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine, Danish Center for Health Services Research"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"dk","key":"north denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-NDR","l3nl":"North Denmark Region","l3nn":"North Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"North Denmark Region","namevar":["Aalborg University Hospital"],"nora_code":"DI-HO-NDR","used":1},{"affno":"3","country":"dk","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["University of Southern Denmark"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Søren Valgreen","key":"knudsensørenvalgreenpau","last":"Knudsen","locid":"d59094b5-44a6-4398-9acf-f3f530e0504b","name":"Knudsen, Søren Valgreen","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jeppe","key":"mainzjeppepau","last":"Mainz","locid":"f008df0f-398a-4f4d-82cf-90b1e93800cc","name":"Mainz, Jeppe","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mille Mejlby","key":"hansenmillemejlbypau","last":"Hansen","locid":"d3a167a2-1382-401a-a958-038041bf1f2b","name":"Hansen, Mille Mejlby","rank":3,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Søren Paaske","key":"johnsensørenpaaskepau","last":"Johnsen","locid":"c3e8b374-a343-484a-a10d-e6550efbb8dc","name":"Johnsen, Søren Paaske","orcid":"0000-0002-2787-0271","rank":4,"rolecode":"pau"},{"affno":"1 3 2","corresponding":null,"country":"dk","first":"Jan","key":"mainzjanpau","last":"Mainz","locid":"fadbea42-81be-48a2-afb2-c868f9dfa4f5","name":"Mainz, Jan","orcid":"0000-0003-0242-9233","rank":5,"rolecode":"pau"}],"pmid":["40539297"],"pub":{"doi":"10.61409/v12240862","issn":["00415782","13994174"],"issn_org":["00415782"],"issue":"24","journal":"Ugeskrift for Læger","paperid":"V12240862","publisher":"Almindelige Danske Laegeforening","status":"p","title":"Ugeskrift for Læger","title_org":"Ugeskrift for Laeger","volume":"187"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-7c002c7e-4845-4687-a452-b19b3752152e","sdu-28cd7c95-d5fe-496f-9015-4f5c2225b8ff"],"src":["AAU Aalborg University","SDU University of Southern Denmark"],"title":"Udbrændthed blandt klinikere","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-089.80-822363","year":"2025","yearsub":"2025"}
{"abstract":"Aims: To evaluate how Danish General Practitioners (GPs) apply Type 2 diabetes guideline recommendations for risk stratification and management across patient subgroups defined by existing chronic kidney disease (CKD), heart failure (HF), cardiovascular disease (CVD), or elevated risk of incident CVD. Methods: 131 GPs responded to a questionnaire on guideline usage and reviewed randomised patient electronic medical records (EMRs), noting demographics, treatment, comorbidities, and presence of six prespecified CVD risk factors. Patients without comorbidities but with ≥ 3 risk factors were deemed at Higher CVD Risk. When missing data prevented allocation to risk groups, CVD risk was Undefined. Results: Of 1964 EMRs meeting inclusion criteria, 641 (33 %) had ≥ 1 cardiorenal comorbidity. Of 1307 without comorbidities, 513 (26 %) were at Higher CVD Risk; risk was Undefined for 668 (34 %). Organ-protective antihyperglycaemic agents were used in 1114/1964 (57 %), and more frequently (61–68 %) across comorbidity subgroups, while CVD risk group status did not correlate with guideline-directed organ-protective treatment. Finally, whereas GPs allocated 379 (19 %) patients to CKD, 596 (30 %) EMRs included laboratory data suggesting presence of CKD. Conclusions: Organ-protective treatment patterns suggest that GPs distinguish patients by comorbidity status but find guideline-defined CVD risk challenging to apply. Additionally, CKD may be underdiagnosed in T2D patients.","author_count":5,"contributors":["Charles, Morten","Schousboe, Karoline","Thybo, Tanja","Hall-Andersen, Esben Krogh","Knudsen, Søren Tang"],"cuid":["S02-100.00-813867"],"filters":{"added":"2025-06","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"corresponding_author":["Charles, Morten","Charles, Morten H."],"keyword":["Albuminuria","Cardiovascular disease","Chronic kidney disease","Electronic medical records","General practice","Heart failure","Primary care","Type 2 diabetes"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-OTH"],"OT":["Danish Diabetes Association"],"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-HO-OTH","DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"evaluating risk stratification according to type 000000000002 diabetes guidelines in primary care insights from the danish diagram project","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.pcd.2025.05.002","version":"Published Version"},"id":"S02-100.00-813867","identifier":[{"id":"105004641414","type":"scopus"},{"id":"40335370","type":"pmid"}],"ids":["au-fed04a27-0681-44f6-954c-04e82a91a613","sdu-7a1bce96-77d6-4139-8069-d8725335be47"],"keyword":["Albuminuria","Cardiovascular disease","Chronic kidney disease","Electronic medical records","General practice","Heart failure","Primary care","Type 2 diabetes"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-7731B15CC1C3E17763E106A6CE383AF5"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/291922603/1-s2.0-S1751991825001007-main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.pcd.2025.05.002","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Public Health, Department of Public Health - Forskningsenheden for Almen Praksis","Aarhus University, Health, Department of Public Health, Department of Public Health - Institute of General Medical Practice"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of SDCO - Steno Diabetes Center Odense"],"nora_code":"DI-U-SDU","used":1},{"affno":"3","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Danish Diabetes Association"],"nora_code":"DI-OT","used":1},{"affno":"4","country":"dk","key":"other hospitals","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-OTH","l3nl":"Other Hospitals","l3nn":"Other Hospitals","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Hospitals","namevar":["Private practice - Denmark (medical)"],"nora_code":"DI-HO-OTH","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Morten H.","key":"charlespau","last":"Charles","locid":"f5113347-eb47-447a-85b6-5ed82248882e","name":"Charles, Morten","name_org":"Charles, Morten H.","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Karoline","key":"schousboepau","last":"Schousboe","locid":"9a9c0096-78e4-47b4-9e6c-38d5f31dbf15","name":"Schousboe, Karoline","orcid":"0000-0003-3824-7482","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Tanja","key":"thybopau","last":"Thybo","name":"Thybo, Tanja","rank":3,"rolecode":"pau"},{"affno":"4 3","corresponding":null,"first":"Esben Krogh","key":"hallandersenpau","last":"Hall-Andersen","name":"Hall-Andersen, Esben Krogh","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren Tang","key":"knudsenpau","last":"Knudsen","locid":"f4fb113c-f8d2-4bb3-9a9d-0bc2ef14590d","name":"Knudsen, Søren Tang","rank":5,"rolecode":"pau"}],"pmid":["40335370"],"pub":{"doi":"10.1016/j.pcd.2025.05.002","issn":["17519918","18780210"],"issn_org":["17519918"],"issue":"4","journal":"Primary Care Diabetes","pages":"368-374","publisher":"Elsevier Ltd","status":"p","title":"Primary Care Diabetes","title_org":"Primary care diabetes","volume":"19"},"review":"Peer Reviewed","scoID":["2-s2.0-105004641414"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Hospitals","Other Research","Region of Southern Denmark","Universities","University of Southern Denmark","private practice - denmark (medical)"],"PST":["Published"]},"sid":["au-fed04a27-0681-44f6-954c-04e82a91a613","sdu-7a1bce96-77d6-4139-8069-d8725335be47"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"Evaluating risk stratification according to Type 2 diabetes guidelines in primary care – Insights from the Danish DIAGRAM project","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-813867","year":"2025","yearsub":"2025"}
{"abstract":"Rural areas across Europe are transforming as a response to the interaction of different societal and market drivers. In this chapter, we investigate how agricultural production and landscape dynamics evolved in an area in Denmark with limited agricultural potential over the course of three decades. The drivers of change are a combination of the restructuring of the agricultural sector, nature conservation, recreational interests, and market forces. The transition of the agricultural sector itself in terms of increased polarization in farm and field size, however, continues to play a central role in defining development opportunities for rural areas. In conclusion, the case study highlights the complexities of rural development, where local outcomes are influenced by drivers operating at different spatial levels and from different domains (market forces, physical planning, demographic shifts).","author_count":4,"contributors":["Kristensen, Søren Bech Pilgaard","Busck, Anne Gravsholt","Knudsen, Michael Helt"],"cuid":["S01-000.00-819991"],"filters":{"added":"2025-08","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"rural idyll or forgotten backwaters what and who determines the transition of rural areas in denmark a case study from central jutland denmark","src":["ku"],"src-code":["DI-U-KU"],"type":"dba","type-grp":["all","pub"]},"id":"S01-000.00-819991","identifier":[{"id":"105005917525","type":"scopus"}],"ids":["ku-b9386779-21e7-4485-830b-3bf8f450e7a6"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-8B1E36132306ADFAC7D8015307703497"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Geosciences and Natural Resource Management, Geography, People and Processes"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Søren Bech Pilgaard","key":"kristensenpau","last":"Kristensen","locid":"ebd2560d-8822-4a8a-aec4-db7b2938d542","name":"Kristensen, Søren Bech Pilgaard","orcid":"0000-0002-4335-7662","rank":1,"rolecode":"pau"},{"affno":"1","first":"Anne Gravsholt","key":"busckpau","last":"Busck","locid":"8d98c4be-b3bc-40f1-bff5-df78cb7a9a90","name":"Busck, Anne Gravsholt","orcid":"0000-0002-7328-795X","rank":2,"rolecode":"pau"},{"affno":"1","first":"Michael Helt","key":"knudsenpau","last":"Knudsen","locid":"ebd0409e-13de-4edd-b8fc-a303ff999434","name":"Knudsen, Michael Helt","rank":3,"rolecode":"pau"},{"affno":"","first":"Jerzy","key":"bańskipedh","last":"Bański","name":"Bański, Jerzy","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.4324/9781032672779-23","eisbn":["9781040379196","9781032672779"],"isbn":["9781032672755"],"pages":"297-317","publisher":"Taylor and Francis/Routledge","status":"p","subtitle":"Structural Transformations, Environment Challenges, Planning and Policy","title":"Agricultural Land Use"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-b9386779-21e7-4485-830b-3bf8f450e7a6"],"src":["KU University of Copenhagen"],"title":"Rural idyll or forgotten backwaters : What and who determines the transition of rural areas in Denmark? A case study from Central Jutland, Denmark","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-819991","year":"2025","yearsub":"2025"}
{"abstract":"BACKGROUND: The COVID-19 pandemic significantly affected global healthcare systems, revealing their resilience to crises. Despite this, national-level research on its impact across key healthcare domains-such as acute and chronic disease management, cancer screening and care, mental health, and palliative care-is scarce. This study examines the pandemic's impact on contacts, quality of care, and social disparity in these healthcare domains to guide better preparedness for future health emergencies. METHODS: The study utilized data from the Danish National Clinical Quality Registries, covering January 2015 to June 2022, to create a nationwide cohort for comparing healthcare metrics across the pandemic's phases and the prepandemic period. Healthcare contacts were assessed through descriptive analyses, while the quality of care and social disparities were analysed using multivariable regression models, providing estimated prevalence ratios and 95% confidence intervals. RESULTS: The first wave of the COVID-19 pandemic in Denmark led to community and healthcare lockdowns, which were associated with fewer hospital contacts and reduced participation in national cancer screening programs. However, a gradual recovery towards prepandemic levels was found, with the exceptions of chronic obstructive pulmonary disease contacts and colorectal cancer incidence. Overall, the quality of care across various healthcare domains in Denmark remained largely unchanged or improved slightly during the pandemic. However, social disparities in contacts were increased across all examined healthcare domains, with patients who were immigrants, living alone, had limited educational level or low income experiencing reduced contact compared to the prepandemic period. CONCLUSIONS: Overall, the Danish healthcare system appeared to be resilient and largely unaffected throughout the pandemic, and the quality of care in several healthcare domains remained high. Nevertheless, the increasing social disparities in healthcare contacts during the pandemic demands attention. In preparing for future health crises, it is important to address and mitigate potential social inequalities, focusing on achieving equity in healthcare.","author_count":13,"contributors":["Knudsen, Søren Valgreen","Jensen, Henry","Mainz, Jan","Baandrup, Lone","Gögenur, Ismail","Jensen, Jens Winther","Johnsen, Søren Paaske","Lassen, Jens Flensted","Løkke, Anders","Mackenhauer, Julie","Mortensen, Laust Hvas","Møller, Henrik","Olesen, Tina Bech"],"cuid":["S03-099.97-803860"],"filters":{"added":"2025-04","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"continent":["Asia, Middle East","OECD"],"corresponding_author":["Knudsen, Søren Valgreen"],"country":["Israel"],"glorg":["All Global Affiliations","University of Haifa"],"keyword":["Adolescent","Adult","Aged","COVID 19 epidemiology","Denmark epidemiology","Female","Healthcare Disparities","Humans","Male","Middle Aged","Pandemics","Quality of Health Care","Registries","SARS CoV 2","Socioeconomic Factors"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA"],"OT":["Resources & Innovation"],"U":["DI-U-AAU","DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA","DI-U-AAU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"indirect effects of the covid 000000000019 pandemic on healthcare contacts quality of care and social disparities across essential healthcare domains","src":["aau","ku","sdu"],"src-code":["DI-U-AAU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85218460046","version":"Other Version"},"funding_acknowledgement":["The original articles as well as the COVID-19 project were funded by the Danish regions and partly by the Danish Cancer Society Scientific Committee (grant number R321-A17417)."],"id":"S03-099.97-803860","identifier":[{"id":"85218460046","type":"scopus"},{"id":"39936327","type":"pmid"}],"ids":["aau-e749f0a7-35ff-40a2-afd1-7dc6a095c844","ku-6413e115-6efd-44b5-9c7a-ec0fac52694b","sdu-a6f8faf7-3cbd-45e3-9c9a-f432d58de899"],"keyword":["Adolescent","Adult","Aged","COVID-19/epidemiology","Denmark/epidemiology","Female","Healthcare Disparities","Humans","Male","Middle Aged","Pandemics","Quality of Health Care","Registries","SARS-CoV-2","Socioeconomic Factors"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-6C0BD94FB65627655FA7E03F016A541E"],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Psychiatry","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine, Danish Center for Health Services Research"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Resources & Innovation"],"nora_code":"DI-OT","used":1},{"affno":"3","country":"dk","key":"north denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-NDR","l3nl":"North Denmark Region","l3nn":"North Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"North Denmark Region","namevar":["Aalborg University Hospital"],"nora_code":"DI-HO-NDR","used":1},{"affno":"4","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Public Health, DaCHE - Danish Centre for Health Economics"],"nora_code":"DI-U-SDU","used":1},{"affno":"5","country":"il","key":"university of haifa","loc":["Israel","Asia, Middle East","OECD"],"name":"University of Haifa","used":1},{"affno":"6","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Psychiatry"],"nora_code":"DI-U-KU","used":1},{"affno":"7","country":"dk","key":"region zealand","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-ZEA","l3nl":"Region Zealand","l3nn":"Region Zealand","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region Zealand","namevar":["Zealand University Hospital - Roskilde"],"nora_code":"DI-HO-ZEA","used":1},{"affno":"8","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Odense University Hospital"],"nora_code":"DI-HO-SDR","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Søren Valgreen","key":"knudsensørenvalgreenpau","last":"Knudsen","locid":"d59094b5-44a6-4398-9acf-f3f530e0504b","name":"Knudsen, Søren Valgreen","rank":1,"rolecode":"pau"},{"affno":"2","first":"Henry","key":"jensenhenrypau