senpau","last":"Nielsen","locid":"0ed9b9ec-6759-42b2-82fb-0b5286c2069c","name":"Nielsen, Martin Meedom","orcid":"0000-0002-8135-434X","rank":13,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Henning Friis","key":"poulsenpau","last":"Poulsen","locid":"10780c9d-37e2-47e2-b20b-0278a0457356","name":"Poulsen, Henning Friis","orcid":"0000-0001-7876-4113","rank":14,"rolecode":"pau"},{"affno":"1 5","corresponding":null,"country":"dk","first":"Søren","key":"schmidtpau","last":"Schmidt","locid":"a18f4d8f-3013-4c86-b79b-7141a752c70d","name":"Schmidt, Søren","orcid":"0000-0002-8694-2044","rank":15,"rolecode":"pau"},{"affno":"3","first":"Kim","key":"lefmannpau","last":"Lefmann","locid":"b7da4979-871d-4937-a274-d8126545849a","name":"Lefmann, Kim","orcid":"0000-0003-4282-756X","rank":16,"rolecode":"pau"}],"pub":{"doi":"10.1107/s0021889813007991","issn":["00218898","16005767"],"issn_org":["00218898"],"issue":"3","journal":"Journal of Applied Crystallography","pages":"679-696","publisher":"Wiley-Blackwell","status":"p","title":"Journal of Applied Crystallography","volume":"46"},"review":"Peer Reviewed","scoID":["2-s2.0-84877846889"],"search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Private Research","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Miscellaneous","Novo Nordisk","Other Research","Private Research","Technical University of Denmark","Undetermined","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-b40f3085-a1e0-4822-8f9b-814f07b562dd","ku-21853856-3ddc-4d94-8e47-e9e03a77d2a4","ku-69a08e65-36ba-4ff5-afae-b9a066726423"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"McXtrace : A Monte Carlo software package for simulating X-ray optics, beamlines and experiments","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-097.47-036675","year":"2013","yearsub":"2013"}
{"abstract":"A 1 kWe micro combined heat and power (CHP) system based on high temperature proton exchange membrane fuel cell (PEMFC) technology is modeled and optimized by formulation and application of a process integration methodology. The system can provide heat and electricity for a singlefamily household. It consists of a fuel cell stack, a fuel processing subsystem, heat exchangers, and balance-of-plant components. The optimization methodology involves system optimization attempting to maximize the net electrical efficiency, and then by use of a mixed integer nonlinear programming (MINLP) problem formulation, the heat exchange network (HEN) annual cost is minimized. The results show the high potential of the proposed model since high efficiencies are accomplished. The net electrical efficiency and total system efficiency, based on lower heating value (LHV), are 35.2% and 91.1%, respectively. The minimized total annual cost of the HEN is $8,147 year–1.","author_count":3,"contributors":["Arsalis, Alexandros","Nielsen, Mads Pagh","Kær, Søren Knudsen"],"cuid":["S01-000.00-073298"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"optimization of a high temperature pemfc micro chp system by formulation and application of a process integration methodology","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1002/fuce.201200102","version":"Other Version"},"id":"S01-000.00-073298","identifier":[{"id":"84875974047","type":"scopus"},{"id":"WOS:000317304300018","type":"wos"}],"ids":["aau-5035a48a-5d68-4400-ab03-9a6f27006232"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-6C9749A7683E34C23563B5A35776D3C0"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1002/fuce.201200102","version":"Other Version"}],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (ENG)","Aalborg University, The Faculty of Engineering and Science, AAU Energy","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Fluid Mechanics and Combustion"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Alexandros","key":"arsalispau","last":"Arsalis","locid":"78eb1abb-bd28-461a-8c05-68a79cd90e77","name":"Arsalis, Alexandros","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mads Pagh","key":"nielsenpau","last":"Nielsen","locid":"4167f94b-c30d-4966-8da7-b9f5a33bb6d0","name":"Nielsen, Mads Pagh","orcid":"0000-0002-9396-8525","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren Knudsen","key":"kærpau","last":"Kær","locid":"898d6584-ec2e-430a-b78d-e3e0d670dcdd","name":"Kær, Søren Knudsen","orcid":"0000-0003-2151-8055","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1002/fuce.201200102","issn":["16156846","16156854"],"issn_org":["16156846"],"issue":"2","journal":"Fuel Cells","pages":"238-248","publisher":"Wiley","status":"p","title":"Fuel Cells","volume":"13"},"review":"Peer Reviewed","scoID":["2-s2.0-84875974047"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-5035a48a-5d68-4400-ab03-9a6f27006232"],"src":["AAU Aalborg University"],"title":"Optimization of a High Temperature PEMFC micro-CHP System by Formulation and Application of a Process Integration Methodology","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-073298","year":"2013","yearsub":"2013"}
{"author_count":2,"contributors":["Bidoggia, Benoit","Kær, Søren Knudsen"],"cuid":["S01-000.00-079453"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"estimation of membrane hydration status for standby proton exchange membrane fuel cell systems by complex impedance measurement constant temperature stack characterization","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.ijhydene.2013.01.025","version":"Other Version"},"id":"S01-000.00-079453","identifier":[{"id":"84875221893","type":"scopus"},{"id":"WOS:000316714200026","type":"wos"}],"ids":["aau-653aaf30-f579-43f3-aa73-6b87b7080c03"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-9805344FCDF907F9B0233BA417D919E0"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.ijhydene.2013.01.025","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (ENG)","Aalborg University, The Faculty of Engineering and Science, AAU Energy","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Power Electronic Systems"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Benoit","key":"bidoggiapau","last":"Bidoggia","locid":"132f2659-f4a2-4324-8b4e-88cec8230dea","name":"Bidoggia, Benoit","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren Knudsen","key":"kærpau","last":"Kær","locid":"898d6584-ec2e-430a-b78d-e3e0d670dcdd","name":"Kær, Søren Knudsen","orcid":"0000-0003-2151-8055","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.ijhydene.2013.01.025","issn":["03603199","18793487"],"issn_org":["03603199"],"journal":"International Journal of Hydrogen Energy","pages":"4054-4066","publisher":"Elsevier","status":"p","title":"International Journal of Hydrogen Energy","volume":"38"},"review":"Peer Reviewed","scoID":["2-s2.0-84875221893"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-653aaf30-f579-43f3-aa73-6b87b7080c03"],"src":["AAU Aalborg University"],"title":"Estimation of membrane hydration status for standby proton exchange membrane fuel cell systems by complex impedance measurement: Constant temperature stack characterization","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-079453","year":"2013","yearsub":"2013"}
{"abstract":"The present work describes the ongoing development of high temperature PEM fuel cell systems fuelled by steam reformed methanol. Various fuel cell system solutions exist, they mainly differ depending on the desired fuel used. High temperature PEM (HTPEM) fuel cells offer the possibility of using liquid fuels such as methanol, due to the increased robustness of operating at higher temperatures (160-180oC). Using liquid fuels such as methanol removes the high volume demands of compressed hydrogen storages, simplifies refueling, and enables the use of existing fuel distribution systems. The liquid methanol is converted to a hydrogen rich gas with CO2 trace amounts of CO, the increased operating temperatures allow the fuel cell to tolerate much higher CO concentrations than Nafion-based membranes. The increased tolerance to CO also enables the use of reformer systems with less hydrogen cleaning steps and requirements for hydrogen purity, reducing the complexity of the reformer systems. Using hydrogen containing CO, affects the steady-state as well as dynamic electrical performance of the fuel cell, but stable operation is still possible with concentrations up to 3%. The typical polymer used in HTPEM fuel cells is polybenzimidazole (PBI), doped with phosphoric acid for proton conduction. The work will present a few different methanol reformer concepts, some experimental results of details related to reformer gas quality, control of burner temperature and the aspects of implementing advanced modeling based control approaches using the commercial Serenergy H3-350 methanol reformer system as an example.","author_count":4,"contributors":["Andreasen, Søren Juhl","Sahlin, Simon Lennart","Justesen, Kristian Kjær","Kær, Søren Knudsen"],"cuid":["S01-000.00-108769"],"event":{"end":"2013-04-18","place":"Karlsruhe, de","start":"2013-04-16","title":"5th International Conference FDFC2013","year":"2013"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Control","Fuel cell","Fuel cell system","Methanol reforming"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"design and control of high temperature pem fuel cell systems using methanol reformers with air or liquid heat integration","src":["aau"],"src-code":["DI-U-AAU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/77237162/abstract_sja.doc","version":"Authors Final Version"},"id":"S01-000.00-108769","ids":["aau-ca5af391-9766-4e01-822d-4d443d30f0d7"],"keyword":["control","fuel cell","fuel cell system","methanol reforming"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-09A888AA822F6B214BFEFAA127363852"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/77237162/abstract_sja.doc","version":"Authors Final Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (ENG)","Aalborg University, The Faculty of Engineering and Science, AAU Energy","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Thermal Energy Systems"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Søren Juhl","key":"andreasenpau","last":"Andreasen","locid":"02115d16-a485-4ac6-b914-7460ef6c4e83","name":"Andreasen, Søren Juhl","orcid":"0000-0002-0767-5874","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Simon Lennart","key":"sahlinpau","last":"Sahlin","locid":"10be1b68-a59d-4397-ae45-e356bf4c5844","name":"Sahlin,