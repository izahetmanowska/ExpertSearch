adóttir, Sigrid Salling","name_org":"Árnadóttir, Sigrid S","rank":1,"rolecode":"pau"},{"affno":"2","first":"Sigrid S","key":"árnadóttirsigridspau","last":"Árnadóttir","name":"Árnadóttir, Sigrid S","rank":1,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Maria","key":"jeppesenmariapau","last":"Jeppesen","name":"Jeppesen, Maria","rank":2,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Philippe","key":"lamyphilippepau","last":"Lamy","locid":"2742ae6f-bcfc-4ca4-87a0-e902214655d0","name":"Lamy, Philippe","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper B","key":"bramsenjesperbertrampau","last":"Bramsen","locid":"bcaa0339-abb7-415d-9fd3-bff68766370e","name":"Bramsen, Jesper Bertram","name_org":"Bramsen, Jesper B","rank":4,"rolecode":"pau"},{"affno":"2","first":"Jesper B","key":"bramsenjesperbpau","last":"Bramsen","name":"Bramsen, Jesper B","rank":4,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Iver","key":"nordentoftiverpau","last":"Nordentoft","locid":"b34d9510-69d8-4d68-b79c-19720bb7055f","name":"Nordentoft, Iver","orcid":"0000-0003-4856-4086","rank":5,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Michael","key":"knudsenmichaelpau","last":"Knudsen","locid":"0e7c7bb2-f35f-4a40-8376-b7049bdfcddd","name":"Knudsen, Michael","rank":6,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Søren","key":"vangsørenpau","last":"Vang","locid":"f748548c-e964-40ad-9ddf-256cea6c9e2f","name":"Vang, Søren","orcid":"0000-0002-1899-4205","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mogens R","key":"madsenmogensrørbækpau","last":"Madsen","locid":"5591f71f-23fb-4bb3-b656-8718aa84819b","name":"Madsen, Mogens Rørbæk","name_org":"Madsen, Mogens R","rank":8,"rolecode":"pau"},{"affno":"2","first":"Mogens R","key":"madsenmogensrpau","last":"Madsen","name":"Madsen, Mogens R","rank":8,"rolecode":"pau"},{"affno":"4","first":"Ole","key":"thastrupolepau","last":"Thastrup","locid":"b6b10dc9-705f-4c80-9953-70d28708ca15","name":"Thastrup, Ole","rank":9,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Jacob","key":"thastrupjacobpau","last":"Thastrup","name":"Thastrup, Jacob","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Claus","key":"andersenclauslindbjergpau","last":"L Andersen","locid":"f97421ce-9c23-4c51-9fcd-be0843ed0c0f","name":"Andersen, Claus Lindbjerg","name_org":"L Andersen, Claus","orcid":"0000-0002-7406-2103","rank":11,"rolecode":"pau"},{"affno":"2","first":"Claus","key":"landersenclauspau","last":"L Andersen","name":"L Andersen, Claus","rank":11,"rolecode":"pau"}],"pmid":["29130628"],"pub":{"doi":"10.1002/1878-0261.12156","issn":["15747891","18780261"],"issn_org":["15747891"],"issue":"1","journal":"Molecular Oncology","pages":"132-147","publisher":"John Wiley and Sons Ltd","status":"p","title":"Molecular Oncology","volume":"12"},"review":"Peer Reviewed","scoID":["2-s2.0-85035220327"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-374ec05d-6923-4515-9321-96992e32d39e","ku-3ac6ff63-5c9b-4c4c-9716-5bbcf6e72d41"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Characterization of genetic intratumor heterogeneity in colorectal cancer and matching patient-derived spheroid cultures","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-016690","year":"2018","yearsub":"2018"}
{"abstract":"To understand better the thermal behaviour of lithium-ion batteries under different working conditions, various experiments were applied to a 13 Ah Altairnano lithium titanate oxide battery cell by means of isothermal battery calorimeter. Several parameters were measured such as the battery surface temperature, voltage, current, power, heat flux, maximum temperature and power area. In addition, the efficiency was calculated. Isothermal battery calorimeter was selected as the most appropriate method for heat loss measurements. Temperatures on the surface of the battery were measured by employing four contact thermocouples (type K). In order to determine the heat loss of the battery, constant current charge and discharge pulses at sixteen different C-rates were applied to the battery. It was seen that the charge and discharge C-rates has a considerable influence on the thermal behaviours of lithium-ion batteries. In this research paper, the C-rate was linked to the peak temperature, efficiency and heat loss and it was concluded that they are linear dependent on the C-rate. In addition, the outcomes of this investigation can be used for battery thermal modelling and design of thermal management systems.","author_count":3,"contributors":["Madani, Seyed Saeed","Schaltz, Erik","Kær, Søren Knudsen"],"cuid":["S01-000.00-077073"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Battery efficiency","Heat loss","Lithium ion batteries"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"heat loss measurement of lithium titanate oxide batteries under fast charging conditions by employing isothermal calorimeter","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.3390/batteries4040059","version":"Published Version"},"id":"S01-000.00-077073","identifier":[{"id":"85061977286","type":"scopus"},{"id":"000455148900012","type":"wos"}],"ids":["aau-5d00c1ff-a111-4513-88b0-9700fae4f2a3"],"keyword":["Battery efficiency","heat loss","lithium-ion batteries"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-C25073DF8264D452DA307622CE74D46C"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.3390/batteries4040059","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/295222321/batteries_04_00059.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, AAU Energy","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Fluid Mechanics and Combustion"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Seyed Saeed","key":"madanipau","last":"Madani","locid":"2b964c98-f205-4a96-8e1c-e2433090f82a","name":"Madani, Seyed Saeed","orcid":"0000-0003-1636-3554","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Erik","key":"schaltzpau","last":"Schaltz","locid":"6e39b31c-c3fa-470a-b47b-e69ee21195c1","name":"Schaltz, Erik","orcid":"0000-0002-8540-0040","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren Knudsen","key":"kærpau","last":"Kær","locid":"898d6584-ec2e-430a-b78d-e3e0d670dcdd","name":"Kær, Søren Knudsen","orcid":"0000-0003-2151-8055","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.3390/batteries4040059","issn":["23130105"],"issue":"4","journal":"Batteries","pages":"1-15","paperid":"59","publisher":"Multidisciplinary Digital Publishing Institute","status":"p","title":"Batteries","volume":"4"},"review":"Peer Reviewed","scoID":["2-s2.0-85061977286"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-5d00c1ff-a111-4513-88b0-9700fae4f2a3"],"src":["AAU Aalborg University"],"title":"Heat Loss Measurement of Lithium Titanate Oxide Batteries under Fast Charging Conditions by Employing Isothermal Calorimeter","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-077073","year":"2018","yearsub":"2018"}
{"abstract":"Lithium-ion batteries have many advantages in compare to other conventional batteries. Because of that, they have many applications in different sectors such as portable electronic devices, electric vehicles and other fields. To assure that the operation and performance of lithium-ion batteries are reliable, safe and economic, the approximation of state of charge, cycle life and other parameters for lithium-ion batteries are necessary. Equivalent circuit models are an important tool in the field of research in lithium-ion batteries. Several researcher have suggested a variety of equivalent circuit models. Some of these models are simple whereas some others are complicated. This paper presents a review of different equivalent circuit models and parameters identification methods in lithium-ion batteries for energy storage applications. These models include the internal resistance model, one time constant model, two time constants model, Thévenin model, PNGV (partnership for a new generation of vehicles) model, DP (dual polarization) model, improved PNGV model, tree seeds algorithm, electrochemical impedance spectroscopy method, and Randles’ model.","author_count":3,"contributors":["Madani, Seyed Saeed","Schaltz, Erik","Kær, Søren Knudsen"],"cuid":["S01-000.00-085321"],"event":{"end":"2018-08-29","place":"Brno, cz","start":"2018-08-26","title":"19th International Conference on Advanced Batteries, Accumulators and Fuel Cells","year":"2018"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"a review of different electric equivalent circuit models and parameter identification methods of lithium ion batteries","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"id":"S01-000.00-085321","identifier":[{"id":"85061053870","type":"scopus"}],"ids":["aau-7974f1c3-3f42-4359-9251-752c44071c6e"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-E1DB74D33B145723B081F3AA77E51275"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, AAU Energy","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Fluid Mechanics and Combustion"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Seyed Saeed","key":"madanipau","last":"Madani","locid":"2b964c98-f205-4a96-8e1c-e2433090f82a","name":"Madani, Seyed Saeed","orcid":"0000-0003-1636-3554","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Erik","key":"schaltzpau","last":"Schaltz","locid":"6e39b31c-c3fa-470a-b47b-e69ee21195c1","name":"Schaltz, Erik","orcid":"0000-0002-8540-0040","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren Knudsen","key":"kærpau","last":"Kær","locid":"898d6584-ec2e-430a-b78d-e3e0d670dcdd","name":"Kær, Søren Knudsen","orcid":"0000-0003-2151-8055","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1149/08701.0023ecst","issn":["19385862"],"issn_org":["19386737"],"issue":"1","journal":"ECS Transactions","pages":"23-37","publisher":"Institute of Physics","status":"p","title":"ECS Transactions","volume":"87"},"review":"Peer Reviewed","scoID":["2-s2.0-85061053870"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-7974f1c