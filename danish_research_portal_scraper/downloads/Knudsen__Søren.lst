y":"antoftpau","last":"Antoft","locid":"b98f5ac6-538f-48f3-9ac0-9e903f2a7443","name":"Antoft, Rasmus","orcid":"0000-0002-4836-5733","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Claus Dalsgaard","key":"hansenpau","last":"Hansen","locid":"7e99d6e6-cb77-4881-8462-f48845b49be8","name":"Hansen, Claus D.","name_org":"Hansen, Claus Dalsgaard","orcid":"0000-0002-4047-2251","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anja","key":"jørgensenpau","last":"Jørgensen","locid":"1075f62b-258c-43d9-90c0-5c57bdd67f42","name":"Jørgensen, Anja","orcid":"0000-0003-3864-2458","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren","key":"kristiansenpau","last":"Kristiansen","locid":"c57ab19f-6ab2-43bf-bbc3-31514f5f1b10","name":"Kristiansen, Søren","orcid":"0000-0001-7211-8882","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anders","key":"petersenpau","last":"Petersen","locid":"c13a49aa-2eb3-445b-b388-0f6c1292047a","name":"Petersen, Anders","orcid":"0000-0002-0931-5688","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lisbeth B.","key":"knudsenpau","last":"Knudsen","locid":"471d19ce-8d21-411c-81cf-1ccd80109156","name":"Knudsen, Lisbeth B.","orcid":"0000-0001-8975-2003","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Sune Qvotrup","key":"jensenpau","last":"Jensen","locid":"4303b43d-3d13-4d1b-9627-8ab36ab05046","name":"Jensen, Sune Qvotrup","orcid":"0000-0001-7619-6650","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Trond Beldo","key":"klausenpau","last":"Klausen","locid":"68c7e366-d242-4632-9edb-80b0443171b9","name":"Klausen, Trond Beldo","orcid":"0000-0003-3260-5090","rank":9,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Rune Valentin","key":"gregersenpau","last":"Gregersen","name":"Gregersen, Rune Valentin","rank"