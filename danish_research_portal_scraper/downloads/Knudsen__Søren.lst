sponding":null,"first":"Rikke Osbahr","key":"ebsenrikkeosbahrpau","last":"Ebsen","name":"Ebsen, Rikke Osbahr","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Morten Korf","key":"madsenmortenkorfpau","last":"Madsen","locid":"804fa678-1278-40b3-b9d7-731206370eac","name":"Madsen, Morten Korf","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ole","key":"gammelgaardolepau","last":"Gammelgaard","name":"Gammelgaard, Ole","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Stinus Lundum Storm","key":"mikkelsenstinuslundumstormpau","last":"Mikkelsen","name":"Mikkelsen, Stinus Lundum Storm","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Peter","key":"jespersenpeterpau","last":"Jespersen","locid":"1234c0e0-1e02-464f-918d-5ae95dad0d31","name":"Jespersen, Peter","rank":5,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Brian","key":"knudsenbrianpau","last":"Knudsen","name":"Knudsen, Brian","rank":6,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Søren","key":"pjengaardsørenpau","last":"Pjengaard","name":"Pjengaard, Søren","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren","key":"bøjgaardschleicherandersensørenpau","last":"Bøjgaard Schleicher Andersen","name":"Bøjgaard Schleicher Andersen, Søren","rank":8,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Käte Thaisen","key":"akselsenkätethaisenpau","last":"Akselsen","name":"Akselsen, Käte Thaisen","rank":9,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Peter Hougaard","key":"madsenpeterhougaardpau","last":"Madsen","name":"Madsen, Peter Hougaard","rank":10,"rolecode":"pau"}],"pub":{"publisher":"Monitormedier","status":"p"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All University Colleges","DI-ALL","DI-UC","DI-UC-ALL","KP","UC SYD, University College South Denmark","UCL University College","University College Absalon","University College of Northern Denmark","University Colleges","VIA University College"],"PST":["Published"]},"sid":["kp-81fe5206-35bd-46d4-83a2-0bf6dc7384fe"],"src":["KP University College Copenhagen"],"title":"Debat: Grænsesætning og dømmekraft har for længe haft trange kår på læreruddannelsen","type":"Other-Unknown","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-389287","year":"2022","yearsub":"2022"}
{"abstract":"Background: Previous studies have indicated inferior responses to severe acute respiratory syndrome coronavirus-2 (SARS-CoV-2) vaccination in solid organ transplant (SOT) recipients. We examined the development of anti-receptor-binding domain (RBD) immunoglobulin G (IgG) after two doses of BNT162b2b in SOT recipients 6 months after vaccination and compared to that of immunocompetent controls. Methods: We measured anti-RBD IgG after two doses of BNT162b2 in 200 SOT recipients and 200 matched healthy controls up to 6 months after first vaccination. Anti-RBD IgG concentration and neutralizing capacity of antibodies were measured at first and second doses of BNT162b2 and 2 and 6 months after the first dose. T-cell responses were measured 6 months after the first dose. Results: In SOT recipients, geometric mean concentration (GMC) of anti-RBD IgG increased from first to second dose (1.14 AU/ml, 95% CI 1.08-1.24 to 11.97 AU/ml, 95% CI 7.73-18.77) and from second dose to 2 months (249.29 AU/ml, 95% CI 153.70-385.19). Six months after the first vaccine, anti-RBD IgG declined (55.85 AU/ml, 95% CI 36.95-83.33). At all time points, anti-RBD IgG was lower in SOT recipients than that in controls. Fewer SOT recipients than controls had a cellular response (13.1% vs. 59.4%, p < 0.001). Risk factors associated with humoral non-response included age [relative risk (RR) 1.23 per 10-year increase, 95% CI 1.11-1.35, p < 0.001], being within 1 year from transplantation (RR 1.55, 95% CI 1.30-1.85, p < 0.001), treatment with mycophenolate (RR 1.54, 95% CI 1.09-2.18, p = 0.015), treatment with corticosteroids (RR 1.45, 95% CI 1.10-1.90, p = 0.009), kidney transplantation (RR 1.70, 95% CI 1.25-2.30, p = 0.001), lung transplantation (RR 1.63, 95% CI 1.16-2.29, p = 0.005), and de novo non-skin cancer comorbidity (RR 1.52, 95% CI, 1.26-1.82, p < 0.001). Conclusion: Immune responses to BNT162b2 are inferior in SOT recipients compared to healthy controls, and studies aiming to determine the clinical impact of inferior vaccine responses are warranted.","author_count":24,"contributors":["Hamm, Sebastian Rask","Møller, Dina Leth","Pérez-Alós, Laura","Hansen, Cecilie Bo","Pries-Heje, Mia","Heftdal, Line Dam","Hasselbalch, Rasmus Bo","Fogh, Kamille","Madsen, Johannes Roth","Armenteros, Jose Juan Almagro","Knudsen, Andreas D.","Poulsen, Johan Runge","Frikke-Schmidt, Ruth","Hilsted, Linda Maria","Sørensen, Erik","Ostrowski, Sisse Rye","Harboe, Zitta Barrella","Perch, Michael","Sørensen, Søren Schwartz","Rasmussen, Allan","Bundgaard, Henning","Garred, Peter","Iversen, Kasper","Nielsen, Susanne Dam"],"cuid":["S01-000.00-434992"],"filters":{"added":"2022-06","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["BNT162b2","Covid 19","Immunogenicity","SARS CoV 2","Solid organ transplant recipient","Vaccination","Vaccine"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"decline in antibody concentration 000000000006 months after two doses of sars cov 000000000002 bnt000000000162b000000000002 vaccine in solid organ transplant recipients and healthy controls","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/fimmu.2022.832501","version":"Published Version"},"id":"S01-000.00-434992","identifier":[{"id":"85126411967","type":"scopus"},{"id":"PMC8905653","type":"pmcid"},{"id":"35281023","type":"pmid"},{"id":"000770562400001","type":"wos"}],"ids":["ku-459ed3d5-8175-41f1-a980-aaa4e14915e7"],"keyword":["BNT162b2","COVID-19","SARS-CoV-2","immunogenicity","solid organ transplant recipient","vaccination","vaccine"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-F9096005A6E04BB2E04F71018358ECE9"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/301485763/fimmu_13_832501.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/fimmu.2022.832501","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","first":"Sebastian Rask","key":"hammsebastianraskpau","last":"Hamm","locid":"fda23bba-aa98-4ad7-979d-f28d0045abde","name":"Hamm, Sebastian Rask","rank":1,"rolecode":"pau"},{"affno":"1","first":"Dina Leth","key":"møllerdinalethpau","last":"Møller","locid":"8d5cc577-14db-4efa-9db9-72b979611644","name":"Møller, Dina Leth","rank":2,"rolecode":"pau"},{"affno":"1","first":"Laura","key":"pérezalóslaurapau","last":"Pérez-Alós","locid":"d2298b3a-c2a2-4ee7-9acf-81c70030dc5a","name":"Pérez-Alós, Laura","rank":3,"rolecode":"pau"},{"affno":"1","first":"Cecilie Bo","key":"hansenceciliebopau","last":"Hansen","locid":"47a06331-2df1-4a5f-81b3-e582da0e70e6","name":"Hansen, Cecilie Bo","rank":4,"rolecode":"pau"},{"affno":"1","first":"Mia Marie","key":"prieshejemiapau","last":"Pries-Heje","locid":"f