ode":"pau"},{"affno":"1","corresponding":null,"first":"Sarah Søs","key":"poulsenpau","last":"Poulsen","name":"Poulsen, Sarah Søs","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"K.","key":"klingpau","last":"Kling","name":"Kling, K.","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren Thor","key":"larsenpau","last":"Larsen","locid":"32005edc-74a7-4ff2-a0ab-44b3d17409d6","name":"Larsen, Søren Thor","orcid":"0000-0003-1142-7045","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Asger Wisti","key":"nørgaardpau","last":"Nørgaard","locid":"7e0fd755-dac4-4bcc-a7d9-5ecc0f506de4","name":"Nørgaard, Asger Wisti","orcid":"0000-0002-7599-6151","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kristina Bram","key":"knudsenpau","last":"Knudsen","name":"Knudsen, Kristina Bram","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ismo Kalevi","key":"koponenpau","last":"Koponen","name":"Koponen, Ismo Kalevi","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Per Axel","key":"clausenpau","last":"Clausen","locid":"2b513990-76fd-4cc9-b1ce-0820afdd0a6d","name":"Clausen, Per Axel","orcid":"0000-0003-0217-6563","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Keld Alstrup","key":"jensenpau","last":"Jensen","locid":"5b93ba18-9ef8-4419-8d4f-5b7c9634ba2f","name":"Jensen, Keld Alstrup","orcid":"0000-0002-2764-3634","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Erik Håkan Richard","key":"wallinpau","last":"Wallin","locid":"5acb38c3-e32b-433d-a6aa-b1a3a8d2adbf","name":"Wallin, Erik Håkan Richard","orcid":"0000-0001-7716-0166","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ulla Birgitte","key":"vogelpau","last":"Vogel","locid":"157e7e7e-7506-4f84-8087-ccc586d5d13c","name":"Vogel, Ulla Birgitte","orcid":"0000-0001-6807-1524","rank":12,"rolecode":"pau"}],"pub":{"issn":["00116335"],"issue":"3","journal":"Dansk K