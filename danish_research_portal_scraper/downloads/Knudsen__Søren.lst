rsity","All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Other Companies","Private Research","Universities","University of Copenhagen","omiics aps"],"PST":["Published"]},"sid":["au-b50bf3d5-75e5-4746-9685-8e3e57d278fc"],"src":["AU Aarhus University"],"title":"Author Correction : SARS-CoV2-mediated suppression of NRF2-signaling reveals potent antiviral and anti-inflammatory activity of 4-octyl-itaconate and dimethyl fumarate","type":"Journal Comment","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-232623","year":"2020","yearsub":"2020"}
{"abstract":"Background: Defining the optimal dosage of the immunosuppressive or duration of anti-infective agents is a challenge in solid organ transplant (SOT) recipients. We aimed to systematically review the literature regarding the use of T cell mediated immune functional assays (IFAs) for adjustment of the immunosuppressive or anti-infective agents in SOT recipients. Methods: We systematically searched PubMed, Scopus, EMBASE, Web of Science (WOS), Cochrane Central Register of Controlled Trials (CENTRAL), and ClinicalTrials.gov to find human interventional studies or study protocols that used either in-house or commercially available IFAs for adjustment of the immunosuppressive or anti-infective agents in SOT recipients. Results: We included six clinical trials and six study protocols. Four out of the six clinical trials used interferon-γ release assays for cytomegalovirus (IGRA-CMV), and five out of the six registered study protocols planned to use IGRA-CMV for adjustment of anti-CMV antiviral (Valganciclovir) prophylaxis or preemptive therapy in SOT recipients. Primary or secondary anti-CMV prophylaxes were discontinued in SOT recipients who had positive IGRA-CMV results without an increase in the rate of CMV infection or reactivation. Among other IFAs, one clinical trial used interferon-γ release assays for tuberculosis (IGRA-TB), and one study used ImmuKnow for adjustment of the duration and dosage of isoniazid and tacrolimus, respectively. Conclusion: Our systematic review supports a promising role for the IGRA-CMVs for adjustment of the duration of anti-CMV antiviral prophylaxis in SOT recipients. There are limited data to support the use of IFAs other than IGRA-CMVs for adjustment of immunosuppressive or anti-infective agents. Further multicenter randomized clinical trials using IFAs other than IGRA-CMVs may help in personalized immunosuppressive or prophylactic anti-infective therapy in SOT recipients.","author_count":9,"contributors":["Rezahosseini, Omid","Møller, Dina Leth","Knudsen, Andreas Dehlbæk","Sørensen, Søren Schwartz","Perch, Michael","Gustafsson, Finn","Rasmussen, Allan","Ostrowski, Sisse Rye","Nielsen, Susanne Dam"],"cuid":["S01-000.00-508424"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Immune system","Transplantation","immune functional assay"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"use of t cell mediated immune functional assays for adjustment of immunosuppressive or anti infective agents in solid organ transplant recipients a systematic review","src":["ku"],"src-code":["DI-U-KU"],"type":"djr","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/fimmu.2020.567715","version":"Published Version"},"id":"S01-000.00-508424","identifier":[{"id":"PMC7593245","type":"pmcid"},{"id":"85094659572","type":"scopus"},{"id":"33178194","type":"pmid"}],"ids":["ku-c0b3008e-536e-43ac-8c01-476c3b909cd2"],"keyword":["anti-infective agent","immune functional assay","immune system","immunosuppressive agent","transplantation"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-32A978D47A3A22A4A5F7BE2A5A202AF0"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/251578258/fimmu_11_567715.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/fimmu.2020.567715","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","first":"Omid","key":"rezahosseinipau","last":"Rezahosseini","locid":"25f086c7-0215-450d-a148-0fd4745377ea","name":"Rezahosseini, Omid","orcid":"0000-0003-2198-1904","rank":1,"rolecode":"pau"},{"affno":"1","first":"Dina Leth","key":"møllerpau","last":"Møller","locid":"8d5cc577-14db-4efa-9db9-72b979611644","name":"Møller, Dina Leth","rank":2,"rolecode":"pau"},{"affno":"2","first":"Andreas Dehlbæk","key":"knudsenpau","last":"Knudsen","name":"Knudsen, Andreas Dehlbæk","rank":3,"rolecode":"pau"},{"affno":"1","first":"Søren Schwartz","key":"sørensenpau","last":"Sørensen","locid":"115ed8b6-8f6c-468a-9217-994613816c8e","name":"Sørensen, Søren Schwartz","rank":4,"rolecode":"pau"},{"affno":"1","first":"Michael","key":"perchpau","last":"Perch","locid":"e0a136a6-8b36-4735-9db2-8847ce581fc6","name":"Perch, Michael","rank":5,"rolecode":"pau"},{"affno":"1","first":"Finn","key":"gustafssonpau","last":"Gustafsson","locid":"6716eef1-891b-4209-a823-e96e765b9433","name":"Gustafsson, Finn","rank":6,"rolecode":"pau"},{"affno":"2","first":"Allan","key":"rasmussenpau","last":"Rasmussen","name":"Rasmussen, Allan","rank":7,"rolecode":"pau"},{"affno":"1","first":"Sisse Rye","key":"ostrowskipau","last":"Ostrowski","locid":"ba497828-2322-4b15-bfae-1e8a8c3895e7","name":"Ostrowski, Sisse Rye","orcid":"0000-0001-5288-3851","rank":8,"rolecode":"pau"},{"affno":"1","first":"Susanne Dam","key":"nielsenpau","last":"Nielsen","locid":"2baa36fa-2709-482a-9595-52c5b9537801","name":"Nielsen, Susanne Dam","rank":9,"rolecode":"pau"}],"pmid":["33178194"],"pub":{"doi":"10.3389/fimmu.2020.567715","issn":["16643224"],"journal":"Frontiers in Immunology","paperid":"567715","status":"p","title":"Frontiers in Immunology","volume":"11"},"review":"Peer Reviewed","scoID":["2-s2.0-85094659572"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-c0b3008e-536e-43ac-8c01-476c3b909cd2"],"src":["KU University of Copenhagen"],"title":"Use of T Cell Mediated Immune Functional Assays for Adjustment of Immunosuppressive or Anti-infective Agents in Solid Organ Transplant Recipients : A Systematic Review","type":"Journal Review","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-508424","year":"2020","yearsub":"2020"}
{"abstract":"Complex data visualization design projects often entail collaboration between people with different visualization-related skills. For example, many teams include both designers who create new visualization designs and developers who implement the resulting visualization software. We identify gaps between data characterization tools, visualization design tools, and development platforms that pose challenges for designer-developer teams working to create new data visualizations. While it is common for commercial interaction design tools to support collaboration between designers and developers, creating data visualizations poses several unique challenges that are not supported by current tools. In particular, visualization designers must characterize and build an understanding of the underlying data, then specify layouts, data encodings, and other data-driven parameters that will be robust across many different data values. In larger teams, designers must also clearly communicate these mappings and their dependencies to developers, clients, and other collaborators. We report observations and reflections from five large multidisciplinary visualization design projects and highlight six data-specific visualization challenges for design specification and handoff. These challenges include adapting to changing data, anticipating edge cases in data, understanding technical challenges, articulating data-dependent interactions, communicating data mappings, and preserving the integrity of data mappings across iterations. Based on these observations, we identify opportunities for future tools for prototyping, testing, and communicating data-driven designs, which might contribute to more successful and collaborative data visualization design.","author_count":7,"contributors":["Walny, Jagoda","Frisson, Christian","West, Mieka","Kosminsky, Doris","Knudsen, Søren","Carpendale, Sheelagh","Willett, Wesley"],"cuid":["S01-000.00-521116"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["Canada"],"glorg":["All Global Affiliations","University of Calgary"],"keyword":["Data mapping","Design process","Information visualization"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"data changes everything challenges and opportunities in data visualization design handoff","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/287764549/DataChanges_InfoVis2019_Preprint.pdf","version":"Authors Final Version"},"id":"S01-000.00-521116","identifier":[{"id":"31478857","type":"pmid"},{"id":"85075637644","type":"scopus"}],"ids":["ku-d5b64bd3-d8c8-4d80-9f63-e657805364f7"],"keyword":["Information visualization","data mapping","design handoff","design process"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-8EA48ED0F1C8EB022F8FD755F4235AAB"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/287764549/DataChanges_InfoVis2019_Preprint.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","country":"ca","key":"university of calgary","loc":["Canada","America, North","OECD"],"name":"University of Calgary","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Human-Centred Computing"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Jagoda","key":"walnypau","last":"Walny","name":"Walny, Jagoda","rank":1,"rolecode":"pau"},{"affno":"1","first":"Christian","key":"frissonpau","last":"Frisson","name":"Frisson, Christian","rank":2,"rolecode":"pau"},{"affno":"1","first":"Mieka","key":"westpau","last":"West","name":"West, Mieka","rank":3,"rolecode":"pau"},{"affno":"1","first":"Doris","key":"kosminskypau","last":"Kosminsky","name":"Kosminsky, Doris","rank":4,"rolecode":"pau"},{"affno":"2","first":"Soren","key":"knudsenpau","last":"Knudsen","locid":"60aa66e8-eac5-4487-94e1-f1379643b27d","name":"Knudsen, Søren","name_org":"Knudsen, Soren","orcid":"0000-0002-8306-1102","rank":5,"rolecode":"pau"},{"affno":"1","first":"Sheelagh","key":"carpendalepau","last":"Carpendale","name":"Carpendale, Sheelagh","rank":6,"rolecode":"pau"},{"affno":"1","first":"Wesley","key":"willettpau","last":"Willett","name":"Willett, Wesley","rank":7,"rolecode":"pau"}],"pmid":["31478857"],"pub":{"doi":"10.1109/tvcg.2019.2934538","issn":["10772626","19410506"],"issn_org":["10772626"],"issue":"1","journal":"IEEE Transactions on Visualization and Computer Graphics","pages":"12-22","status":"p","title":"IEEE Transactions on Visualization and Computer Graphics","volume":"26"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-d5b64bd3-d8c8-4d80-9f63-e657805364f7"],"src":["KU University of Copenhagen"],"title":"Data Changes Everything : Challenges and Opportunities in Data Visualization Design Handoff","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-521116","year":"2020","yearsub":"2020"}
{"abstract":"Providing high quality care requires that patient care pathways are organized according to the needs of the patient. The organization of high-quality integrated patient care requires methods to assess 'appropriateness' of the care pathways to identify challenges in delivering the right procedure, for the right person at the right time and setting and with the most appropriate use of resources. There is a need for methods to assess appropriateness that can easily be implemented in daily clinical practice. The Patient Inventory method is such a method. Patient Inventory is a special type of audit that provides a 'snapshot' of the patient population in an entire hospital, a ward or another clinical unit. It maps the bed occupancy situation, as well as coordination, continuity and communication associated with the individual patient pathway. The aim is to identify inappropriate or wasteful events and to facilitate reflections on the underlying causes. These reflections are used to identify focus areas for quality improvement efforts. The method answers the question: 'Is it the right patient in the right place at the right time, and is the correct pathway for the patient organized with the most appropriate use of resources?' The aim of this method paper is to describe the background, definitions and methodologies for Patient Inventory, to offer a practical guidance for application of the method and to describe the current experiences with the method.","author_count":5,"contributors":["Knudsen, Søren Valgreen","Hermansen, Sabina Bay","Holmskov, Jens","Johnsen, Søren Paaske","Mainz, Jan"],"cuid":["S02-094.55-011493"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"continent":["Asia, Middle East","OECD"],"country":["Israel"],"glorg":["All Global Affiliations","University of Haifa"],"keyword":["Audit","External quality assessment","Quality Improvement","Quality management"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-NDR"],"OT":["Psychiatry in Region North Jutland"],"U":["DI-U-AAU","DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-NDR","DI-U-AAU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"patient inventory a quality improvement method","src":["aau","sdu"],"src-code":["DI-U-AAU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85086747447","version":"Other Version"},"id":"S02-094.55-011493","identifier":[{"id":"32412058","type":"pmid"},{"id":"85086747447","type":"scopus"}],"ids":["aau-f069d9c7-cdf9-4f1a-9fc6-af5070dde89d","sdu-69c81e3a-145c-475f-88b3-678d82a07bb9"],"keyword":["audit","external quality assessment","quality improvement","quality management"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-852993AF2001E925A5E0413EE7CF2E29"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Psychiatry","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine, Danish Center for Clinical Health Services Research"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"dk","key":"north denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-NDR","l3nl":"North Denmark Region","l3nn":"North Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"North Denmark Region","namevar":["Aalborg University Hospital"],"nora_code":"DI-HO-NDR","used":1},{"affno":"3","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Psychiatry in Region North Jutland"],"nora_code":"DI-OT","used":1},{"affno":"4","country":"dk","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["University of Southern Denmark"],"nora_code":"DI-U-SDU","used":1},{"affno":"5","country":"il","key":"university of haifa","loc":["Israel","Asia, Middle East","OECD"],"name":"University of Haifa","used":1}],"person":[{"affno":"1 2 3","corresponding":null,"first":"Søren Valgreen","key":"knudsenpau","last":"Knudsen","locid":"d59094b5-44a6-4398-9acf-f3f530e0504b","name":"Knudsen, Søren Valgreen","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Sabina Bay","key":"hermansenpau","last":"Hermansen","locid":"a8a68b97-1129-4be5-9e7a-5ce7eee7585b","name":"Hermansen, Sabina Bay","rank":2,"rolecode":"pau"},{"affno":"1 4 3","corresponding":null,"first":"Jens","key":"holmskovpau","last":"Holmskov","locid":"e5818293-317d-42c4-aef1-2a12a22f2259","name":"Holmskov, Jens","rank":3,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Søren Paaske","key":"johnsenpau","last":"Johnsen","locid":"c3e8b374-a343-484a-a10d-e6550efbb8dc","name":"Johnsen, Søren Paaske","orcid":"0000-0002-2787-0271","rank":4,"rolecode":"pau"},{"affno":"1 4 5 2 3","corresponding":null,"country":"dk","first":"Jan","key":"mainzpau","last":"Mainz","locid":"fadbea42-81be-48a2-afb2-c868f9dfa4f5","name":"Mainz, Jan","orcid":"0000-0003-0242-9233","rank":5,"rolecode":"p