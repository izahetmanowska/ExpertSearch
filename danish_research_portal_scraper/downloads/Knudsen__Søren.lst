{"author_count":10,"contributors":["Birkenkamp-Demtröder, Karin","Christensen, Emil","Nordentoft, Iver","Knudsen, Michael","Taber, Ann","Høyer, Søren","Lamy, Philippe","Agerbæk, Mads","Jensen, Jørgen Bjerggaard","Dyrskjøt, Lars"],"cuid":["S01-000.00-154817"],"event":{"end":"2017-11-14","place":"Aarhus, dk","start":"2017-11-14","title":"1st Annual Research Meeting at the Department of Clinical Medicine","year":"2017"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"nr","rtype":["clu"],"sorti":"liquid biopsies for monitoring treatment response and metastatic relapse in bladder cancer patients","src":["au"],"src-code":["DI-U-AU"],"type":"dco","type-grp":["all","pub"]},"id":"S01-000.00-154817","ids":["au-2c8b4c6c-ad9d-4e14-aa9d-671520a84f1b"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-D1B4D0842721AA1355498FB52F49C60C"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Molecular Medicine (MOMA)"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Karin","key":"birkenkampdemtröderpau","last":"Birkenkamp-Demtröder","locid":"77abb58a-ad4f-4f04-a992-b61a599a15e7","name":"Birkenkamp-Demtröder, Karin","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Emil","key":"christensenpau","last":"Christensen","locid":"0df8a105-196b-44d1-bf5c-acca05f38b4a","name":"Christensen, Emil","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"d