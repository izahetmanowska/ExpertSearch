","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["Dupont ApS (Nutrition & Health) - Denmark"],"nora_code":"DI-PR-OTH","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Helle Nygaard","key":"lærkepau","last":"Lærke","locid":"408fb476-f1b2-4eb6-8436-edc3cc039743","name":"Lærke, Helle Nygaard","orcid":"0000-0002-0303-0745","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Susan","key":"arentpau","last":"Arent","name":"Arent, Susan","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Knud Erik Bach","key":"knudsenpau","last":"Knudsen","locid":"3918454e-241b-4712-ab7f-aa9d26a508f7","name":"Knudsen, Knud Erik Bach","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Søren","key":"dalsgaardpau","last":"Dalsgaard","name":"Dalsgaard, Søren","rank":4,"rolecode":"pau"}],"pub":{"issn":["00218812","15253163"],"issn_org":["00218812"],"issue":"Supplement 2","journal":"Journal of Animal Science","pages":"65","paperid":"148","publisher":"Oxford University Press","status":"p","title":"Journal of Animal Science","volume":"92"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Other Companies","Private Research","Universities","dupont aps (nutrition & health) - denmark"],"PST":["Published"]},"sid":["au-83605ffb-6ddd-419f-b109-d2faf7aa21bf"],"src":["AU Aarhus University"],"title":"Commercial xylanase-products appear to be more efficient towards degradation of arabinoxylan in wheat than in rye","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-204325","year":"2014","yearsub":"2014"}
{"abstract":"Formalin-fixed, paraffin-embedded (FFPE) tissues are an invaluable resource for clinical research. However, nucleic acids extracted from FFPE tissues are fragmented and chemically modified making them challenging to use in molecular studies. We analysed 23 fresh-frozen (FF), 35 FFPE and 38 paired FF/FFPE specimens, representing six different human tissue types (bladder, prostate and colon carcinoma; liver and colon normal tissue; reactive tonsil) in order to examine the potential use of FFPE samples in next-generation sequencing (NGS) based retrospective and prospective clinical studies. Two methods for DNA and three methods for RNA extraction from FFPE tissues were compared and were found to affect nucleic acid quantity and quality. DNA and RNA from selected FFPE and paired FF/FFPE specimens were used for exome and transcriptome analysis. Preparations of DNA Exome-Seq libraries was more challenging (29.5% success) than that of RNA-Seq libraries, presumably because of modifications to FFPE tissue-derived DNA. Libraries could still be prepared from RNA isolated from two-decade old FFPE tissues. Data were analysed using the CLC Bio Genomics Workbench and revealed systematic differences between FF and FFPE tissue-derived nucleic acid libraries. In spite of this, pairwise analysis of DNA Exome-Seq data showed concordance for 70-80% of variants in FF and FFPE samples stored for fewer than three years. RNA-Seq data showed high correlation of expression profiles in FF/FFPE pairs (Pearson Correlations of 0.90 +/- 0.05), irrespective of storage time (up to 244 months) and tissue type. A common set of 1,494 genes was identified with expression profiles that were significantly different between paired FF and FFPE samples irrespective of tissue type. Our results are promising and suggest that NGS can be used to study FFPE specimens in both prospective and retrospective archive-based studies in which FF specimens are not available.","author_count":16,"contributors":["Hedegaard, Jakob","Thorsen, Kasper","Lund, Mette Katrine","Hein, Anne-Mette K","Hamilton-Dutoit, Stephen Jacques","Vang, Søren","Nordentoft, Iver","Birkenkamp-Demtröder, Karin","Kruhøffer, Mogens","Hager, Henrik","Knudsen, Bjarne","Andersen, Claus Lindbjerg","Sørensen, Karina Dalsgaard","Pedersen, Jakob Skou","Ørntoft, Torben Falck","Dyrskjøt, Lars"],"cuid":["S01-000.00-204967"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR"],"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-HO-CDR","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"next generation sequencing of rna and dna isolated from paired fresh frozen and formalin fixed paraffin embedded samples of human cancer and normal tissue","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1371/journal.pone.0098187","version":"Other Version"},"id":"S01-000.00-204967","identifier":[{"id":"84902313616","type":"scopus"},{"id":"24878701","type":"pmid"},{"id":"PMC4039489","type":"pmcid"}],"ids":["au-847e41f4-0fc7-4cf8-8679-e2bf86c88e51"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-B74CE58FBD69A90F66C9AB219ECBB035"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1371/journal.pone.0098187","version":"Other Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Molecular Medicine (MOMA)"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1},{"affno":"3","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital (AUH)"],"nora_code":"DI-HO-CDR","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jakob","key":"hedegaardpau","last":"Hedegaard","locid":"79b2837f-79b6-4078-8859-ca4faf4e309f","name":"Hedegaard, Jakob","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kasper","key":"thorsenpau","last":"Thorsen","locid":"29064c1d-0833-4ccc-ab18-23e578e80fc9","name":"Thorsen, Kasper","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Mette Katrine","key":"lundpau","last":"Lund","name":"Lund, Mette Katrine","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Anne-Mette K","key":"heinpau","last":"Hein","name":"Hein, Anne-Mette K","rank":4,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"country":"dk","first":"Stephen Jacques","key":"hamiltondutoitpau","last":"Hamilton-Dutoit","locid":"9b291bda-53d8-40c3-a0f6-564aefbe8300","name":"Hamilton-Dutoit, Stephen Jacques","orcid":"0000-0003-2158-3885","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren","key":"vangpau","last":"Vang","locid":"f748548c-e964-40ad-9ddf-256cea6c9e2f","name":"Vang, Søren","orcid":"0000-0002-1899-4205","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Iver","key":"nordentoftpau","last":"Nordentoft","locid":"b34d9510-69d8-4d68-b79c-