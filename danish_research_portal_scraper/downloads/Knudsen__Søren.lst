rk"],"PST":["Published"]},"sid":["aau-d1d4ebd4-bbbe-47d8-b6d6-f31553425b7b","au-52a8296b-169b-4000-89da-23c00aea5b26","ku-a3dc48af-0b5a-446a-bdb9-cc0098d180b5","sdu-b4c14942-fd49-455a-a22e-75c50a51f909"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Prediction of fulvestrant efficacy in patients with advanced breast cancer : retrospective-prospective evaluation of the predictive potential of a multigene expression assay","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-100.00-010049","year":"2020","yearsub":"2020"}
{"abstract":"This paper investigates the effects of impurities contamination on the performance of a proton exchange membrane (PEM) water electrolyzer. The impacts of Fe3+, Cu2+ and Al3+ ions on the performance of single PEM water electrolysis cells are investigated by introducing Fe2(SO4)3, CuSO4, Al2(SO4)3 solution into deionized water to prepare 5 parts per million (ppm, molar ratio) contaminated feed solution. The prepared solution was then fed to the PEM water electrolysis system to carry out the contamination test. The results show that the single cell performance experienced a dramatic decrease initially but then recovered to some degree during the Fe3+ ions contamination. For Cu2+ ions contamination, the cell ohmic resistance decreased while the charge and mass transfer resistance showed an increasing trend throughout the test period. Moreover, the Al3+ ions can cause a sudden cell failure when introduced into the cell.","author_count":4,"contributors":["Li, Na","Araya, Samuel Simon","Cui, Xiaoti","Kær, Søren Knudsen"],"cuid":["S01-000.00-102405"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Degradation","Impedance spectroscopy","PEM water electrolysis"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"the effects of cationic impurities on the performance of proton exchange membrane water electrolyzer","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/448879844/paper_C.pdf","version":"Authors Final Version"},"id":"S01-000.00-102405","identifier":[{"id":"85088651704","type":"scopus"}],"ids":["aau-b440543d-db09-4e78-9351-75f5c87b8471"],"keyword":["Degradation","Impedance spectroscopy","Impurity contamination","PEM water Electrolysis"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-CD26F3FF2CC3415991E72D957739B2C3"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/448879844/paper_C.pdf","version":"Authors Final Version"}],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, AAU Energy","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Hydrogen and Electro-fuels","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Thermal Energy Systems","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Thermofluids"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Na","key":"lipau","last":"Li","locid":"a89f75fa-7daa-406c-b5ea-5307f875cdf0","name":"Li, Na","orcid":"0000-0002-1267-6185","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Samuel","key":"simonarayapau","last":"Simon Araya","locid":"31cc4ce7-c9ae-4406-95d1-b95d4269205f","name":"Araya, Samuel Simon","name_org":"Simon Araya, Samuel","orcid":"0000-0001-9294-0793","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Xiaoti","key":"cuipau","last":"Cui","locid":"569f8898-f768-496f-8fc3-c93d917ef238","name":"Cui, Xiaoti","orcid":"0000-0001-6514-0280","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren Knudsen","key":"kærpau","last":"Kær","locid":"898d6584-ec2e-430a-b78d-e3e0d670dcdd","name":"Kær, Søren