"rank":10,"rolecode":"pau"},{"affno":"2 3","first":"Morten","key":"dahlpau","last":"Dahl","locid":"f5409642-33da-4a45-8f34-725572c574fb","name":"Dahl, Morten","orcid":"0000-0002-6686-312X","rank":11,"rolecode":"pau"},{"affno":"4 5","corresponding":null,"first":"Martin","key":"overgaardpau","last":"Overgaard","locid":"0aefaa4b-0a41-4d31-8988-a4c60c5be7f6","name":"Overgaard, Martin","orcid":"0000-0003-2277-590X","rank":12,"rolecode":"pau"},{"affno":"6","first":"Aditi","key":"banerjeepau","last":"Banerjee","name":"Banerjee, Aditi","rank":13,"rolecode":"pau"},{"affno":"7","first":"Søren Andreas","key":"ladefogedpau","last":"Ladefoged","name":"Ladefoged, Søren Andreas","rank":14,"rolecode":"pau"},{"affno":"1","first":"Henning","key":"bundgaardpau","last":"Bundgaard","name":"Bundgaard, Henning","rank":15,"rolecode":"pau"},{"affno":"8 9","first":"Allan S.","key":"jaffepau","last":"Jaffe","name":"Jaffe, Allan S.","rank":16,"rolecode":"pau"},{"affno":"1 2","first":"Kasper Karmark","key":"iversenpau","last":"Iversen","locid":"558df261-ca9f-440a-8bee-7d38813c253f","name":"Iversen, Kasper","name_org":"Iversen, Kasper Karmark","rank":17,"rolecode":"pau"},{"affno":"6","first":"Ola","key":"hammarstenpau","last":"Hammarsten","name":"Hammarsten, Ola","rank":18,"rolecode":"pau"}],"pmid":["40492538"],"pub":{"doi":"10.1093/clinchem/hvaf068","issn":["00099147","15308561"],"issn_org":["00099147"],"issue":"8","journal":"Clinical Chemistry","pages":"884-895","publisher":"Oxford University Press","status":"p","title":"Clinical Chemistry","volume":"71"},"review":"Peer Reviewed","scoID":["2-s2.0-105012448553"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-c43496bb-73f7-4c02-9d21-4bb5255acd46","sdu-a3463c7a-53c8-45d7-91dc-22957c259e6d"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Influence of Macrotroponin on the 99th Percentile Threshold in 2 High-Sensitivity Cardiac Troponin Assays","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.94-823036","year":"2025","yearsub":"2025"}
{"abstract":"Objectives: To describe the clinical characteristics, comorbidity, and medical treatment in a primary care population with chronic kidney disease (CKD). Additionally, to investigate how primary care physicians (PCPs) diagnose, manage and treat impaired kidney function, including uptake of cardio-renoprotective renin–angiotensin–aldosterone system inhibitors (RAASis) and sodium glucose co-transporter 2 inhibitors (SGLT2is). Design: An observational study of CKD prevalence, treatment patterns and comorbidities in primary care based on patient record data combined with a questionnaire on diagnosis, management and treatment of impaired kidney function in a real-world, primary care setting. Setting: In all 128 primary care clinics in Denmark of 211 randomly invited and a quetionnaire completed by 125/128 participating PCPs. Methods: A computerized selection identified 12 random individuals with CKD per clinic with ≥ 2 measurements of eGFR < 60 mL/min/1.73 m2 or UACR > 30 mg/g within two years (N = 1 497). Pre-specified data collected from individual electronic health records included demographics, clinical variables, comorbidities, and relevant prescribed medications. Results: Of the CKD study population (N = 1 497), 80% had hypertension, 32% diabetes (DM), 13% heart failure (HF), 59% no DM/HF. ACEis/ARBs were prescribed to 65%, statins to 56%, SGTL2is to 14%, and MRAs to 8% of all individuals. Treatment patterns differed between individuals with varying comorbidities, e.g., ACEis/ARBs usage was higher in DM (76%) or HF (74%) vs. no DM/HF (58%), as was statin usage (76% in DM vs. 45% in no DM/HF). SGTL2i usage in no DM/HF was low. Most PCPs identified CKD using eGFR < 60 mL/min/1.73 m2 (62%) or UACR > 30 mg/g (58%) and 62% reported initiating treatment to retard kidney function decline. Conclusions: Despite good PCP awareness and wish to use relevant guidelines, a gap exists in implementation of cardio-renoprotective treatment, especially in individuals without DM/HF. This offers an opportunity for clear recommendations to PCPs to optimize early cardio-renal protection in individuals with CKD.","author_count":5,"contributors":["Lindhardt, Morten","Knudsen, Søren Tang","Saxild, Thomas","Charles, Morten","Borg, Rikke"],"cuid":["S01-000.00-799605"],"filters":{"added":"2025-04","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Chronic kidney disease","Nephrology","Observational Study","Primary care","Questionnaire","Real world data","Treatment"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR","DI-HO-OTH","DI-HO-ZEA"],"OT":["Grøndalslægerne"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-HO-CDR","DI-HO-OTH","DI-HO-ZEA","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"treating chronic kidney disease in danish primary care results from the observational atlas study","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s12875-025-02721-4","version":"Published Version"},"id":"S01-000.00-799605","identifier":[{"id":"PMC11786539","type":"pmcid"},{"id":"85217640105","type":"scopus"},{"id":"39893377","type":"pmid"}],"ids":["ku-5f8e0229-33b6-4584-8461-699bc675e03c"],"keyword":["Cardio-renal protection","Chronic kidney disease","Nephrology","Observational study","Primary care","Questionnaire","Real-world data","Treatment"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-1EAE0C783FA620C1C9E50252CF78C006"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/428847079/s12875_025_02721_4.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s12875-025-02721-4","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Internal Medicine: Nephrology"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"other hospitals","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-OTH","l3nl":"Other Hospitals","l3nn":"Other Hospitals","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Hospitals","namevar":["Copenhagen University Hospital - Holbæk"],"nora_code":"DI-HO-OTH","used":1},{"affno":"3","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1},{"affno":"4","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University"],"nora_code":"DI-U-AU","used":1},{"affno":"5","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Grøndalslægerne"],"nora_code":"DI-OT","used":1},{"affno":"6","country":"dk","key":"region zealand","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-ZEA","l3nl":"Region Zealand","l3nn":"Region Zealand","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region Zealand","namevar":["Zealand University Hospital - Roskilde"],"nora_code":"DI-HO-ZEA","used":1}],"person":[{"affno":"1 2","first":"Morten","key":"lindhardtpau","last":"Lindhardt","locid":"f0464691-bc2e-4695-a4de-894275461b5e","name":"Lindhardt, Morten","rank":1,"rolecode":"pau"},{"affno":"2","first":"Søren Tang","key":"knudsenpau","last":"Knudsen","name":"Knudsen, Søren Tang","rank":2,"rolecode":"pau"},{"affno":"3 4","first":"Thomas","key":"saxildpau","last":"Saxild","name":"Saxild, Thomas","rank":3,"rolecode":"pau"},{"affno":"5","first":"Morten","key":"charlespau","last":"Charles","name":"Charles, Morten","rank":4,"rolecode":"pau"},{"affno":"1 4 6","first":"Rikke","key":"borgpau","last":"Borg","locid":"19f3b871-b1fc-4653-aee0-be709d2a16c9","name":"Borg, Rikke","orcid":"0000-0002-2283-3578","rank":5,"rolecode":"pau"}],"pmid":["39893377"],"pub":{"doi":"10.1186/s12875-025-02721-4","issn":["27314553"],"issue":"1","journal":"BMC Primary Care","paperid":"23","status":"p","title":"BMC Primary Care","volume":"26"},"review":"Peer Reviewed","scoID":["2-s2.0-85217640105"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Hospitals","Other Research","Region Zealand","Universities","University of Copenhagen","copenhagen university hospital - holbæk"],"PST":["Published"]},"sid":["ku-5f8e0229-33b6-4584-8461-699bc675e03c"],"src":["KU University of Copenhagen"],"title":"Treating chronic kidney disease in Danish primary care : results from the observational ATLAS study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-799605","year":"2025","yearsub":"2025"}
{"abstract":"Background and Aims: Panenteric capsule endoscopy (PCE) is a minimally invasive modality that may replace ileocolonoscopy (IC) in selected patients with Crohn’s disease (CD). This study aimed to evaluate the dynamics of repeated assessment with PCE in patients receiving medical treatment for ileocolonic CD. Methods: This prospective, blinded, multicenter study included patients with endoscopically active CD. Patients were scheduled for IC, PCE, fecal calprotectin, and C-reactive protein before and 12 weeks after treatment with corticosteroids or biological therapy. The endoscopic disease activity was assessed with the Simple Endoscopic Score for Crohn’s Disease (SES-CD). Results: Thirty-one patients entered the study, and PCE visualized 148 (95.5%) and 128 (82.6%) ileocolonic bowel segments before and after medical treatment, respectively. The median SES-CD decreased from 14 (interquartile range [IQR] 8-17) to 5 (IQR 0-14) (p < 0.001) and 14 (IQR 10-17) to 6 (IQR 3-12) (p < 0.001) with IC and PCE, respectively. The repeated measures correlation between PCE and IC was very strong (r = 0.77, p < 0.001), strong compared to fecal calprotectin (r = 0.42, p = 0.003), and moderate compared to C-reactive protein (r = 0.36, p = 0.005). The mean scores for ulcer size, ulcerated surface, and affected surface were comparable between PCE and IC both before and after treatment. PCE had a sensitivity and specificity of 80.6% (95% confidence interval [95% CI] 62.5-92.5) and 93.8% (95% CI 79.2-99.2), respectively, for ulcer healing compared to IC. Conclusions: PCE is responsive in patients treated for CD and may serve as a minimally invasive alternative to IC in selected patients.","author_count":6,"contributors":["Brodersen, Jacob Broder","Kjeldsen, Jens","Agerbæk Juel, Mie","Knudsen, Torben","Rafaelsen, Søren Rafael","Jensen, Michael Dam"],"cuid":["S01-000.00-802129"],"filters":{"added":"2025-04","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Jensen, Michael Dam"],"keyword":["Adult","C Reactive Protein","C Reactive Protein analysis","Capsule Endoscopy","Capsule Endoscopy methods","Colonoscopy methods","Crohn Disease drug therapy","Crohn s disease","Endoscopy","Feces chemistry","Female","Humans","Leukocyte L1 Antigen Complex analysis","Male","Middle Aged","Prospective Studies","Severity of Illness Index","Single Blind Method","Young Adult"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"changes in endoscopic activity and classification of lesions with panenteric capsule endoscopy in patients treated for crohn s disease a prospective blinded comparison with ileocolonoscopy faecal calprotectin and c reactive protein","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85216382459","version":"Other Version"},"id":"S01-000.00-802129","identifier":[{"id":"39126260","type":"pmid"},{"id":"85216382459","type":"scopus"}],"ids":["sdu-54759c67-52c2-4508-927a-9c68369c3044"],"keyword":["Adult","C-Reactive Protein/analysis","C-reactive protein","Capsule Endoscopy/methods","Colonoscopy/methods","Crohn Disease/drug therapy","Crohn’s disease","Feces/chemistry","Female","Humans","Ileum/diagnostic imaging","Leukocyte L1 Antigen Complex/analysis","Male","Middle Aged","Prospective Studies","Severity of Illness Index","Single-Blind Method","Young Adult","capsule endoscopy","endoscopy","leukocyte L1 antigen complex (calprotectin)"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-5E51696E095E47F703B6D210FEF61D63"],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Regional Health Research","SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS - Esbjerg and Grindsted Hospital"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jacob Broder","key":"brodersenpau","last":"Brodersen","locid":"6848c9c8-cad2-4000-9a02-d73415b277cd","name":"Brodersen, Jacob Broder","orcid":"0000-0003-2530-7554","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jens","key":"kjeldsenpau","last":"Kjeldsen","locid":"4893b496-ebc1-4498-92aa-836500b4cb45","name":"Kjeldsen, Jens","orcid":"0000-0001-8148-6572","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mie","key":"agerbækjuelpau","last":"Agerbæk Juel","locid":"e100aceb-82b9-479a-9365-f89a179d0d75","name":"Agerbæk Juel, Mie","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Torben","key":"knudsenpau","last":"Knudsen","locid":"afa15e36-ab82-4894-89c0-b8802310b50b","name":"Knudsen, Torben","orcid":"0000-0003-0726-0115","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren","key":"rafaelsenpau","last":"Rafaelsen","locid":"89253a87-a28b-4cb9-aa20-ded9a9d49536","name":"Rafaelsen, Søren Rafael","name_org":"Rafaelsen, Søren","orcid":"0000-0001-5182-5545","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Michael Dam","key":"jensenpau","last":"Jensen","locid":"a6ef46da-3165-4804-9599-4a6cd9f1bbaa","name":"Jensen, Michael Dam","orcid":"0009-0004-8432-1764","rank":6,"rolecode":"pau"}],"pmid":["39126260"],"pub":{"doi":"10.1093/ecco-jcc/jjae124","issn":["18739946","18739954"],"issn_org":["18764479"],"issue":"1","journal":"Journal of Crohn's and Colitis","paperid":"jjae124","publisher":"Oxford University Press","status":"p","title":"Journal of Crohn's and Colitis","volume":"19"},"review":"Peer Reviewed","scoID":["2-s2.0-85216382459"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-54759c67-52c2-4508-927a-9c68369c3044"],"src":["SDU University of Southern Denmark"],"title":"Changes in endoscopic activity and classification of lesions with panenteric capsule endoscopy in patients treated for Crohn’s disease : a prospective blinded comparison with ileocolonoscopy, faecal calprotectin and C-reactive protein","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-802129","year":"2025","yearsub":"2025"}
{"abstract":"Although promising, the clinical impact of video conferencing between primary and secondary care specialists lacks trial evidence. We conducted a two-arm RCT (clinicaltrials.gov: NCT05268081) to evaluate whether four video conferences over 12 months between endocrinologists and general practitioners improved medication for people with type 2 diabetes (T2D). Twenty-seven of 100 general practices in Aarhus, Denmark were matched and randomized. Primary outcomes: the proportion of people with T2D and 1) ischemic heart disease treated with glucagon-like peptide 1 receptor agonist (GLP1-RA) and/or sodium glucose cotransporter 2 inhibitor (SGLT2I), 2) micro/macro-albuminuria treated with angiotensin-converting-enzyme-inhibitor (ACE) or angiotensin-2-receptorantagonist (AT2), 3) low-density lipoprotein >2.5 mmol/L treated with statins. Results showed a 17.6% difference [95% CI 4.6%; 30.7%] in GLP1-RA/SGLT2I prescriptions and minimal differences for ACE/AT2 (−1.1% [95% CI −2.8%; 0.6%]) and statins (0.0% [95% CI −3.5%; 3.6%]), attributed to a ceiling effect. Video conferencing can help bridge treatment gaps, particularly for recently updated guidelines.","author_count":9,"contributors":["Prætorius, Thim","Lundberg, Anne Sofie Baymler","Fredslund, Eskild Klausen","Rossen, Niklas B","Gregersen, Søren","Prior, Anders","Søndergaard, Esben","Knudsen, Søren Tang","Sandbæk, Annelli"],"cuid":["S01-000.00-807474"],"filters":{"added":"2025-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-STENO"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-HO-STENO","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"effect of video conferencing between primary and secondary care specialists on type 000000000002 diabetes medication","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"doi","url":"https://doi.org/10.1038/s41746-025-01570-w","version":"Published Version"},"id":"S01-000.00-807474","identifier":[{"id":"105001163533","type":"scopus"},{"id":"40148532","type":"pmid"},{"id":"PMC11950227","type":"pmcid"}],"ids":["au-c7430095-4b5d-4bac-853a-cdafc2e715f9"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-530D853A6F2B2B5F22BB1139C7C1A516"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"doi","url":"https://doi.org/10.1038/s41746-025-01570-w","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - SDCA-Steno Diabetes Center Aarhus"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"steno diabetes centers","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-STENO","l3nn":"Steno Diabetes Centers","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Steno Diabetes Centers","namevar":["Steno Diabetes Center Aarhus, Forskningsudvalget"],"nora_code":"DI-HO-STENO","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Thim","key":"prætoriuspau","last":"Prætorius","locid":"85f0646f-a6c4-4e79-b20d-85762179080a","name":"Prætorius, Thim","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anne Sofie Baymler","key":"lundbergpau","last":"Lundberg","locid":"36b31958-0887-4725-ad35-074783b0d48b","name":"Lundberg, Anne Sofie Baymler","orcid":"0000-0002-5800-8094","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Eskild Klausen","key":"fredslundpau","last":"Fredslund","name":"Fredslund, Eskild Klausen","rank":3,"rolecode":"pau"},{"affno":"1","correspondi