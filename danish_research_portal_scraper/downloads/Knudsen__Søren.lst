},{"affno":"1","corresponding":null,"country":"dk","first":"Daniel Loan","key":"stroepau","last":"Stroe","locid":"5811b49e-3576-45ee-847b-ca093b034b5d","name":"Stroe, Daniel-Ioan","name_org":"Stroe, Daniel Loan","orcid":"0000-0002-2938-8921","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mohammad Rezwan","key":"khanpau","last":"Khan","locid":"93d828d4-c1bf-44a2-bf94-b1fd3dcc29cf","name":"Khan, Mohammad Rezwan","orcid":"0000-0002-1532-0598","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren Knudsen","key":"kærpau","last":"Kær","locid":"898d6584-ec2e-430a-b78d-e3e0d670dcdd","name":"Kær, Søren Knudsen","orcid":"0000-0003-2151-8055","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Remus","key":"teodorescupau","last":"Teodorescu","locid":"fd2ad1e5-313f-45d9-a445-53a24f644768","name":"Teodorescu, Remus","orcid":"0000-0002-2617-7168","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1149/07001.0305ecst","issn":["19385862"],"issn_org":["19386737"],"issue":"1","journal":"ECS Transactions","pages":"305-310","publisher":"Institute of Physics","status":"p","title":"ECS Transactions","volume":"70"},"review":"Peer Reviewed","scoID":["2-s2.0-84956998960"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-32a1678c-a577-48eb-8aa8-3fb5dc91cf43"],"src":["AAU Aalborg University"],"title":"Investigation of Multidimensional Electrothermal Impedance Spectroscopy Measurement on Lithium Ion Battery Cell","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-064714","year":"2015","yearsub":"2015"}
{"abstract":"This paper studies the impedance characteristics of a fresh 13 Ah high-power lithium titanate oxide (LTO) battery cell and analyses its dependence on the temperature and state-of-charge. The impedance of the battery cell was measured by means of the electrochemical impedance spectroscopy (EIS) technique for the entire state-of-charge (SOC) interval and considering five temperatures between 5oC and 45oC. By analyzing the measured impedance spectra of the LTO-based battery cell, it was found out that the cell’s impedance is extremely dependent on the operating conditions. By further processing the measurements data by means of curve fitting, it was found that the parameters of the equivalent electrical circuit (and the corresponding electro-chemical processes) are following different dependencies on the SOC, which in most of the cases are only slightly changing with the measurement temperature.","author_count":6,"contributors":["Stroe, Ana-Irina","Stroe, Daniel-Ioan","Swierczynski, Maciej Jozef","Stanciu, Tiberiu","Teodorescu, Remus","Kær, Søren Knudsen"],"cuid":["S01-000.00-083400"],"event":{"end":"2015-09-03","place":"Brno, cz","start":"2015-08-30","title":"International Conference Advanced Batteries, Accumulators and Fuel Cells","year":"2015"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"the ac impedance characteristic of high power li000000000004ti000000000005o000000000012 based battery cells","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"id":"S01-000.00-083400","identifier":[{"id":"84956988876","type":"scopus"}],"ids":["aau-72b3fe26-0839-445c-a48a-54ee3a6de859"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-33277C7EA4531F63BA79AB0221777650"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (ENG)","Aalborg University, The Faculty of Engineering and Science, AAU Energy","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Power Electronic Systems"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Ana-Irina","key":"stroeanairinapau","last":"Stroe","locid":"e6ff6bac-362f-4fd1-b46c-d5f62d1e2c1a","name":"Stroe, Ana-Irina","orcid":"0000-0002-6205-8254","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Daniel Loan","key":"stroedanielioanpau","last":"Stroe","locid":"5811b49e-3576-45ee-847b-ca093b034b5d","name":"Stroe, Daniel-Ioan","name_org":"Stroe, Daniel Loan","orcid":"0000-0002-2938-8921","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Maciej Jozef","key":"swierczynskimaciejjozefpau","last":"Swierczynski","locid":"767958b2-8061-4038-82d6-7a0068c26efe","name":"Swierczynski, Maciej Jozef","orcid":"0000-0003-3837-9696","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Tiberiu","key":"stanciutiberiupau","last":"Stanciu","locid":"f16625ba-f630-4152-b06a-7bfbb0561d5e","name":"Stanciu, Tiberiu","orcid":"0000-0003-2447-5257","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Remus","key":"teodorescuremuspau","last":"Teodorescu","locid":"fd2ad1e5-313f-45d9-a445-53a24f644768","name":"Teodorescu, Remus","orcid":"0000-0002-2617-7168","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren Knudsen","key":"kærsørenknudsenpau","last":"Kær","locid":"898d6584-ec2e-430a-b78d-e3e0d670dcdd","name":"Kær, Søren Knudsen","orcid":"0000-0003-2151-8055","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1149/07001.0291ecst","issn":["19385862"],"issn_org":["19386737"],"issue":"1","journal":"ECS Transactions","pages":"291-300","publisher":"Institute of Physics","status":"p","title":"ECS Transactions","volume":"70"},"review":"Peer Reviewed","scoID":["2-s2.0-84956988876"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-72b3fe26-0839-445c-a48a-54ee3a6de859"],"src":["AAU Aalborg University"],"title":"The AC Impedance Characteristic of High Power Li4Ti5O12-based Battery Cells","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-083400","year":"2015","yearsub":"2015"}
{"abstract":"This paper reports an accelerated degradation test of a high temperature PEM fuel cell under repeated H2 starvation condition. The H2 stoichiometry is cycled between 3.0 and 0.8 every 2 min during the test. The experimental results show that the polarity of the fuel cell is reversed under H2 starvation condition, and the cell performance indicated by cell voltage at H2 stoichiometry of 3.0 declines from 0.59 V to 0.41 V in 19 cycles. Since CO2 is detected in anode exhaust under H2 starvation condition, carbon corrosion is believed to be the reason for the degradation in this test. After the test, there is only a slight decrease in open circuit voltage of the fuel cell which implies the membrane is not affected by the test. The electrochemical impedance spectrum measurement shows that the H2 starvation can cause significant increase in the ohmic resistance and charge transfer resistance. By looking at the scanning electron microscopy image of the cross-section of the degraded MEA and comparing it with that of a pristine MEA, great loss in platinum in the anode catalyst layer and carbon corrosion between the anode catalyst layer and the gas diffusion layer are observed, which contribute to the increase in the charge transfer resistance and ohmic resistance, respectively. X-ray diffraction analysis indicates that there is an increase in the size of the platinum particle size on both anode and cathode.","author_count":4,"contributors":["Zhou, Fan","Andreasen, Søren Juhl","Kær, Søren Knudsen","Yu, Donghong"],"cuid":["S01-000.00-095204"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"analysis of accelerated degradation of a ht pem fuel cell caused by cell reversal in fuel starvation condition","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-095204","identifier":[{"id":"WOS:000349738300039","type":"wos"},{"id":"84921855843","type":"scopus"}],"ids":["aau-9ba78b1a-daf2-4d0c-85a7-02895fb20a22"],"keyword":["H2 starvation, HT-PEM fuel, cell Cell reversal, Degradation"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-A26C9C4A69A851244D78A13CAD0FEC2A"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (ENG)","Aalborg University, The Faculty of Engineering and Science, AAU Energy","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Fluid Mechanics and Combustion","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Hydrogen and Electro-fuels"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Fan","key":"zhoupau","last":"Zhou","locid":"874642c9-fe83-4b87-9b5e-9b8088c39e6a","name":"Zhou, Fan","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren Juhl","key":"andreasenpau","last":"Andreasen","locid":"02115d16-a485-4ac6-b914-7460ef6c4e83","name":"Andreasen, Søren Juhl","orcid":"0000-0002-0767-5874","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren Knudsen","key":"kærpau","last":"Kær","locid":"898d6584-ec2e-430a-b78d-e3e0d670dcdd","name":"Kær, Søren Knudsen","orcid":"0000-0003-2151-8055","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Donghong","key":"yupau","last":"Yu","locid":"9bf68567-02d0-41e9-a849-c0c03bbdfb9d","name":"Yu, Donghong","orcid":"0