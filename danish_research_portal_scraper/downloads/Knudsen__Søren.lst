forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-393202","year":"2022","yearsub":"2022"}
{"abstract":"The ongoing green energy transition is increasing the need for dynamic and efficient Power-to-X (PtX) systems to convert surplus wind and solar power to high-value products. The solid oxide electrolysis cell (SOEC) technology offers the highest energy conversion efficiency. However, high degradation and thermal variations that cause thermomechanical stress hinders up-scaling of the SOEC technology. Here we present a novel operation method that alleviates temperature variations and minimize degradation caused by impurities and nickel migration. By rapidly switching between electrolysis mode and brief periods in fuel cell mode, a flat thermal profile is obtained. Our results thus establish a new, simple way to achieve increased SOEC stack and module size and extended lifetime. The new operation method enables dynamic operation of large SOEC modules for renewable energy powered PtX systems which could drastically decrease costs associated with production of high-value green fuels and chemicals from wind and solar power.","author_count":11,"contributors":["Skafte, Theis Løye","Rizvandi, Omid Babaie","Smitshuysen, Anne Lyck","Frandsen, Henrik Lund","Thorvald Høgh, Jens Valdemar","Hauch, Anne","Kær, Søren Knudsen","Araya, Samuel Simon","Graves, Christopher","Mogensen, Mogens Bjerg","Jensen, Søren Højgaard"],"cuid":["S02-100.00-002032"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["America, North","OECD"],"corresponding_author":["Skafte, Theis Løye"],"country":["United States"],"glorg":["All Global Affiliations","Noon Energy Inc."],"keyword":["Dynamic operation","Electrolysis","Power to X","Reversible","Solid oxide cells","Thermoneutral"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-AAU","DI-U-ALL","DI-U-DTU"]},"level3all":["DI-PR-OTH","DI-U-AAU","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"electrothermally balanced operation of solid oxide electrolysis cells","src":["aau","dtu"],"src-code":["DI-U-AAU","DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.jpowsour.2022.231040","version":"Published Version"},"funding_acknowledgement":["We gratefully acknowledge financial support from Independent Research Fund Denmark (case 9035-00014B ), DTU Risø Reaktor (case RFS-17-0012 ), Innovation Network Smart Energy (case “Dynamisk Elektrolyse”), and Innovation Fund Denmark (case 8062-01638B)."],"id":"S02-100.00-002032","identifier":[{"id":"85123352025","type":"scopus"}],"ids":["aau-288ad6de-4c72-4d9e-8586-8f9e5e13696e","dtu-d0fbc924-3dfa-4152-bfb7-805d43682b7c"],"keyword":["Dynamic operation","Electrolysis","Power-to-X","Reversible","Solid oxide cells","Thermoneutral"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-A935B007657078DB914DDF041AD50F14"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/482460489/1_s2.0_S0378775322000647_main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/268314410/1_s2.0_S0378775322000647_main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.jpowsour.2022.231040","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Energy C