olecode":"pau"},{"affno":"1","corresponding":null,"first":"Martin Grønbech","key":"jørgensenpau","last":"Jørgensen","locid":"c9214484-1539-4357-a2ed-9a9ec30b6dca","name":"Jørgensen, Martin Grønbech","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jens Lykkegaard","key":"olesenpau","last":"Olesen","locid":"d2601d22-08b4-4950-b3df-24634065a89d","name":"Olesen, Jens Lykkegaard","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sten","key":"rasmussenpau","last":"Rasmussen","locid":"5d5b4320-b956-4cab-b611-40314843825b","name":"Rasmussen, Sten","rank":6,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-36bc1400-aa2c-446b-b371-ec8e52ff3eaf"],"src":["AU Aarhus University"],"title":"Pulsed electromagnetic field therapy may reduce quadriceps muscle soreness in maraton runners – a randomized controlled pilot study","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-160615","year":"2011","yearsub":"2011"}
{"abstract":"The Angiotensin II type 1 receptor (AT(1)R) is known to signal through heterotrimeric G proteins, and Galphaq protein-independent signalling has only recently gained appreciation for profound impact on a diverse range of biological functions. beta-Arrestins, among other central mediators of Galphaq protein-independent signalling from the AT(1)R interact with transcriptional regulators and promote phosphorylation of nuclear proteins. However, the relative contribution of Galphaq protein-independent signalling in AT(1)R mediated transcriptional regulation remains elusive. We here present a comprehensive comparative analysis of Galphaq protein-dependent and-independent regulation of AT(1)R mediated gene expression. We found Angiotensin II to regulate 212 genes, whereas Galphaq-independent signalling obtained with the biased agonist, SII Angiotensin II only regulated few genes. Interestingly, SII Angiotensin II, like Ang II vastly potentiated beta-2-adrenergic receptor-stimulated gene expression. These novel findings indicate that the Galphaq protein-independent signalling mainly modifies the transcriptional response governed by other signalling pathways, while direct induction of gene expression by the AT(1)R is dependent on classical Galphaq protein activation.","author_count":10,"contributors":["Christensen, Gitte L","Knudsen, Steen","Schneider, Mikael","Aplin, Mark","Gammeltoft, Steen","Sheikh, Søren P","Hansen, Jakob L","Schneider, Mikael"],"cuid":["S03-096.22-041581"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":3,"keyword":["Angiotensin II","GTP Binding Protein alpha Subunits Gq G11","Gene Expression Regulation","HEK293 Cells","Humans","Journal Article","Polymerase Chain Reaction","Receptor Angiotensin Type 1","Receptors Adrenergic beta 2","Reproducibility of Results","Research Support Non U S Gov t","Response Elements","Signal Transduction","Time Factors","Transcription Factors","Transcription Genetic"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U","DI-UC"],"level3":{"OT":["Kardiovaskulær og Renal Forskning"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"],"UC":["DI-UC-ALL","DI-UC-UCL"]},"level3all":["DI-U-KU","DI-U-SDU","DI-UC-UCL"]},"review":"pr","rtype":["clu"],"sorti":"at 000000000001 receptor gαq protein independent signalling transcriptionally activates only a few genes directly but robustly potentiates gene regulation from the β000000000002 adrenergic receptor","src":["ku","sdu","ucl"],"src-code":["DI-U-KU","DI-U-SDU","DI-UC-UCL"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Andet","type":"doi","url":"https://doi.org/10.1016/j.mce.2010.08.004","version":"Published Version"},"id":"S03-096.22-041581","identifier":[{"id":"20708651","type":"pmid"},{"id":"78149413790","type":"scopus"}],"ids":["ku-3a419fea-7cb6-4b7b-9ea1-181ef254516c","sdu-de9254a0-ac2a-11df-b62d-000ea68e967b","ucl-2f5e71e7-3ccc-497c-a16d-d462c450c9ac"],"keyword":["Angiotensin II","GTP-Binding Protein alpha Subunits, Gq-G11","Gene Expression Regulation","HEK293 Cells","Humans","Journal Article","Polymerase Chain Reaction","Receptor, Angiotensin, Type 1","Receptors, Adrenergic, beta-2","Reproducibility of Results","Research Support, Non-U.S. Gov't","Response Elements","Signal Transduction","Time Factors","Transcription Factors","Transcription, Genetic"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-07F00E34762BDD375A9234929381D524"],"oa_link":[{"access":"oa","type":"rem","url":"https://hal.archives-ouvertes.fr/hal-00639770/document","version":"Other Version"},{"access":"oa","license":"Andet","type":"doi","url":"https://doi.org/10.1016/j.mce.2010.08.004","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU Universi