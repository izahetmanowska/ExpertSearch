{"author_count":6,"contributors":["Hansen, Ernst Albin","Sørensen, Søren Bak","Knudsen, Lasse","Seiferheld, Bo Eitel","Stevenson, Andrew James Thomas","Emanuelsen, Anders"],"cuid":["S01-000.00-053236"],"event":{"end":"2019-04-27","place":"Toyama, jp","start":"2019-04-24","title":"29th NCM Annual Meeting","year":"2019"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"contralateral transfer of repeated bout rate enhancement in rhythmic movement","src":["aau"],"src-code":["DI-U-AAU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-053236","ids":["aau-0b02e270-032d-45dc-958e-94bd36292a8a"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-66B50F7059223D166D74BC6107F8F4EE"],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Sport Sciences (SSPT)"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Ernst Albin","key":"hansenpau","last":"Hansen","locid":"b43b2264-f483-4c4a-a204-2973c10780c4","name":"Hansen, Ernst Albin","orcid":"0000-0003-2690-6807","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren Bak","key":"sørensenpau","last":"Sørensen","locid":"6b19a8a2-8c16-49af-881e-135014827723","name":"Sørensen, Søren Bak","rank":2,"rolecode":"pau"},{"affno":"1","correspo