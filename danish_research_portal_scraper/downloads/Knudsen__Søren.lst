no":"1","corresponding":null,"first":"Søren Valgreen","key":"knudsenpau","last":"Knudsen","locid":"d59094b5-44a6-4398-9acf-f3f530e0504b","name":"Knudsen, Søren Valgreen","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Grethe Olivia","key":"nielssonpau","last":"Nielsson","name":"Nielsson, Grethe Olivia","rank":2,"rolecode":"pau"}],"pub":{"issn":["00415782","13994174"],"issn_org":["00415782"],"issue":"8","journal":"Ugeskrift for Læger","pages":"816-817","publisher":"Almindelige Danske Laegeforening","status":"p","title":"Ugeskrift for Læger","title_org":"Ugeskrift for Laeger","volume":"183"},"review":"Undetermined","search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities"],"PST":["Published"]},"sid":["aau-8f0edac6-bf51-44af-a367-4de56de6389d"],"src":["AAU Aalborg University"],"title":"Opbakning til en politisk løsning på sygeplejerskernes lønefterslæb","type":"Journal Comment","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-091620","year":"2021","yearsub":"2021"}
{"abstract":"AIMS/HYPOTHESIS: We aimed to assess whether current antidepressant therapy or a history of hospital-diagnosed depression affects diabetes treatment initiation, adherence, and HbA1c and LDL-cholesterol target achievement. METHODS: In this register-based study, we included all individuals from Central and Northern Denmark with newly diagnosed type 2 diabetes, defined as a first-ever HbA1c measurement of ≥48 mmol/mol (6.5%), between 2000 and 2016. Individuals either diagnosed with depression at a psychiatric hospital in the 2 years prior to their diabetes diagnosis or currently receiving treatment with an antidepressant were compared with individuals with type 2 diabetes, but without depression treatment or previous history of depression. Outcome measures included initiation of glucose-lowering drugs and lipid-modifying agents, adherence to these medications (medication possession ratio >80%), and HbA1c (<53 mmol/mol [7%]) and LDL-cholesterol (<2.6 mmol/l) target achievement. The assessment of association between depression or antidepressant treatment and these outcomes was conducted using regression analyses with adjustment for potential confounders. RESULTS: We included a total of 87,650 individuals with first-ever HbA1c-diagnosed type 2 diabetes, of whom 0.9% (n = 784) had hospital-diagnosed depression and 11.4% (n = 9963) currently received antidepressant treatment. Compared with those without depression treatment, treatment with an antidepressant was associated with increased likelihood of glucose-lowering drug initiation (HR 1.39 [95% CI 1.34, 1.44]) and adherence (OR 1.27 [95% CI 1.18, 1.36]), lipid-modifying agent initiation (HR 1.17 [95% CI 1.11, 1.23]) and adherence (OR 1.25 [95% CI 1.09, 1.43]), and achievement of LDL (OR 1.08 [95% CI 1.03, 1.14]) but not HbA1c target (OR 0.99 [95% CI 0.93, 1.06]). The findings were similar for individuals who had hospital-diagnosed depression. CONCLUSIONS/INTERPRETATION: In individuals with newly diagnosed type 2 diabetes, antidepressant treatment and depression were associated with improved diabetes treatment quality. Graphical abstract.","author_count":5,"contributors":["Rohde, Christopher","Knudsen, Jakob Schöllhammer","Schmitz, Norbert","Østergaard, Søren Dinesen","Thomsen, Reimar Wernich"],"cuid":["S01-000.00-249880"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","OECD"],"corresponding_author":["Rohde, Christopher"],"country":["Canada"],"glorg":["All Global Affiliations","McGill University"],"keyword":["MELLITUS","Medication Adherence","Mortality","Nonadherence","Patterns","Self Care","Symptoms","Treatment goals"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"the impact of hospital diagnosed depression or use of antidepressants on treatment initiation adherence and hba sub 000000000001c sub ldl target achievement in newly diagnosed type 000000000002 diabetes","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85092639721","version":"Other Version"},"id":"S01-000.00-249880","identifier":[{"id":"000579564500001","type":"wos"},{"id":"33073329","type":"pmid"},{"id":"85092639721","type":"scopus"}],"ids":["au-d316cbc3-ae06-4dc1-9e09-09ff6b1bdee2"],"keyword":["MEDICATION ADHERENCE","MELLITUS","MORTALITY","NONADHERENCE","PATTERNS","PROSPECTIVE ASSOCIATIONS","SELF-CARE","SYMPTOMS","TREATMENT GOALS"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-6F0D8413FEFE3F0230F442CEA0E8FFF8"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Affective Disorders"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"ca","key":"mcgill university","loc":["Canada","America, North","OECD"],"name":"McGill University","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Christopher","key":"rohdepau","last":"Rohde","name":"Rohde, Christopher","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jakob S","key":"knudsenpau","last":"Knudsen","locid":"a6558780-c573-49a5-8f1e-f8aa9db17bb5","name":"Knudsen, Jakob Schöllhammer","name_org":"Knudsen, Jakob S","orcid":"0000-0002-3772-4497","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Norbert","key":"schmitzpau","last":"Schmitz","name":"Schmitz, Norbert","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren Dinesen","key":"østergaardpau","last":"Østergaard","locid":"96ff5c6c-20cf-4531-aaee-d10e4efd6292","name":"Østergaard, Søren Dinesen","orcid":"0000-0002-8032-6208","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Reimar W","key":"thomsenpau","last":"Thomsen","locid":"36e7af2c-e02f-48d4-b124-0f1bd95b1748","name":"Thomsen, Reimar Wernich","name_org":"Thomsen, Reimar W","orcid":"0000-0001-9135-3474","rank":5,"rolecode":"pau"}],"pmid":["33073329"],"pub":{"doi":"10.1007/s00125-020-05303-4","issn":["0012186X","14320428"],"issn_org":["0012186X"],"issue":"2","journal":"Diabetologia","pages":"361-374","publisher":"Springer Science and Business Media Deutschland GmbH","status":"p","title":"Diabetologia","volume":"64"},"review":"Peer Reviewed","scoID":["2-s2.0-85092639721"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-d316cbc3-ae06-4dc1-9e09-09ff6b1bdee2"],"src":["AU Aarhus University"],"title":"The impact of hospital-diagnosed depression or use of antidepressants on treatment initiation, adherence and HbA<sub>1c</sub>/LDL target achievement in newly diagnosed type 2 diabetes","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-249880","year":"2021","yearsub":"2021"}
{"abstract":"While several electroencephalogram (EEG)-based biomarkers have been proposed as diagnostic or predictive tools in major depressive disorder (MDD), there is a clear lack of replication studies in this field. Markers that link clinical features such as disturbed wakefulness regulation in MDD with neurophysiological patterns are particularly promising candidates for e.g., EEG-informed choices of antidepressive treatment. We investigate if we in an independent MDD sample can replicate abnormal findings of EEG-vigilance regulation during rest and as a predictor for antidepressive treatment response. EEG-resting state was recorded in 91 patients and 35 healthy controls from the NeuroPharm trial. EEG-vigilance was assessed using the Vigilance Algorithm Leipzig (VIGALL). We compared the vigilance regulation during rest between patients and healthy controls and between remitters/responders and non-remitters/non-responders after eight weeks of SSRI/SNRI treatment using two different sets of response criteria (NeuroPharm and iSPOT-D). We replicated previous findings showing hyperstable EEG-wakefulness regulation in patients in comparison to healthy subjects. Responders defined by the iSPOT-D criteria showed a higher propensity toward low vigilance stages in comparison to patients with no response at pretreatment, however, this did not apply when using the NeuroPharm criteria. EEG-wakefulness regulation patterns normalized toward patterns of healthy controls after 8 weeks of treatment. This replication study supports the diagnostic value of EEG-vigilance regulation and its usefulness as a biomarker for the choice of treatment in MDD.","author_count":12,"contributors":["Ip, Cheng Teng","Ganz, Melanie","Dam, Vibeke H.","Ozenne, Brice","Rüesch, Annia","Köhler-Forsberg, Kristin","Jørgensen, Martin Balslev","Frokjaer, Vibe G.","Søgaard, Birgitte","Christensen, Søren R.","Knudsen, Gitte Moos","Olbrich, Sebastian"],"cuid":["S01-000.00-422015"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["Switzerland"],"glorg":["All Global Affiliations","University of Zurich"],"keyword":["Biomarker","EEG","MDD","SSRI"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"neuropharm study eeg wakefulness regulation as a biomarker in mdd","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.jpsychires.2021.06.021","version":"Published Version"},"id":"S01-000.00-422015","identifier":[{"id":"34175743","type":"pmid"},{"id":"85108414197","type":"scopus"}],"ids":["ku-2fe8cc31-db3c-47a9-9fcd-fc0f15bdbb86"],"keyword":["Antidepressant treatment effect","Biomarker","EEG","MDD","SSRI","VIGALL"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-0A505E569C2300BD5D2CD61D97791E1D"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.jpsychires.2021.06.021","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/273137185/NeuroPharm_study.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"ch","key":"university of zurich","loc":["Switzerland",