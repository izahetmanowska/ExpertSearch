faelsenpau","last":"Rafaelsen","locid":"89253a87-a28b-4cb9-aa20-ded9a9d49536","name":"Rafaelsen, Søren Rafael","name_org":"Rafaelsen, Søren","orcid":"0000-0001-5182-5545","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jens","key":"kjeldsenpau","last":"Kjeldsen","locid":"4893b496-ebc1-4498-92aa-836500b4cb45","name":"Kjeldsen, Jens","orcid":"0000-0001-8148-6572","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mie","key":"agerbækjuelpau","last":"Agerbæk Juel","locid":"e100aceb-82b9-479a-9365-f89a179d0d75","name":"Agerbæk Juel, Mie","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Torben","key":"knudsenpau","last":"Knudsen","locid":"afa15e36-ab82-4894-89c0-b8802310b50b","name":"Knudsen, Torben","orcid":"0000-0003-0726-0115","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Michael Dam","key":"jensenpau","last":"Jensen","locid":"a6ef46da-3165-4804-9599-4a6cd9f1bbaa","name":"Jensen, Michael Dam","orcid":"0009-0004-8432-1764","rank":6,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-1e84224a-0f06-4d33-8a9d-ec2b22a66322"],"src":["SDU University of Southern Denmark"],"title":"DIAGNOSTIC ACCURACY OF MAGNETIC RESONANCE IMAGING ENTEROCOLONOGRAPHY, INTESTINAL ULTRASOUND AND PAN-ENTERIC CAPSULE ENDOSCOPY FOR ASSESSING TREATMENT RESPONSE IN KNOWN CROHN’S DISEASE","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-750220","year":"2024","yearsub":"2024"}
{"abstract":"During processing and storage of both conventional and lactose-hydrolyzed UHT milk (LHM), aggregation of milk proteins occurs. Protein aggregation can inter alia occur via nonreducible covalent cross-links derived from either Maillard or dehydroalanine (DHA) pathways. To study this further in relation to processing method and lactase enzyme purity, LHM was produced using 3 different lactase preparations, with lactase enzymes added in a dairy setting either before (prehydrolysis) or after (posthydrolysis) UHT treatment. The prepared LHM types were subsequently stored at either 25°C or 35°C for up to one year. Mass spectrometry was used to absolutely quantify the level of furosine, N-ε-(carboxymethyl)lysine, N-ε-(carboxyethyl)lysine, lanthionine, and lysinoalanine in these products using a newly developed method on triple quadrupole for these processing-induced markers. The results showed higher levels of Maillard-related processing markers in prehydrolyzed LHM compared with posthydrolyzed LHM and conventional UHT milk, which, on the other hand, contained higher concentrations of DHA-derived cross-links. Proteomics of collected particles from asymmetrical flow field-flow fractionation in combination with gel electrophoresis indicated the presence of intramicellar cross-links during storage, especially for larger particles involving αS1- and αS2-caseins.","author_count":7,"contributors":["Knudsen, Lotte Juul","Rauh, Valentin","Pedersen, Jannik Nedergaard","Dekker, Peter","Otzen, Daniel E","Larsen, Lotte Bach","Nielsen, Søren D.H."],"cuid":["S01-000.00-758723"],"filters":{"added":"2024-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"corresponding_author":["Knudsen, Lotte Juul"],"country":["France"],"glorg":["All Global Affiliations","DSM Food Specialties"],"keyword":["Aggregation","Dehydroalanine pathway","Field flow fractionation","Maillard reaction","Multiple reaction monitoring"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-ARLA"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-PR-ARLA","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"insight into protein crosslinking and casein polymerization in pre and posthydrolyzed lactose free ultra high temperature milk during long term storage","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3168/jds.2024-25103","version":"Published Version"},"id":"S01-000.00-758723","identifier":[{"id":"85210141325","type":"scopus"},{"id":"39265836","type":"pmid"}],"ids":["au-fd079b16-bb47-47bb-acde-bff694b6a950"],"keyword":["Maillard reaction","aggregation","dehydroalanine pathway","field-flow fractionation","multiple reaction monitoring"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-76364784FCAEB8D79DDD7081FF162F18"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3168/jds.2024-25103","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, CiFOOD","Aarhus University, Technical Sciences, Department of Food Science, Department of Food Science - Food Chemistry"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"arla foods","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-ARLA","l3nl":"Arla Foods","l3nn":"Arla Foods","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Arla Foods","namevar":["Arla Foods"],"nora_code":"DI-PR-ARLA","used":1},{"affno":"3","country":"fr","key":"dsm food specialties","loc":["France","Europe, EU","OECD"],"name":"DSM Food Specialties","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Lotte J.","key":"knudsenpau","last":"Knudsen","locid":"7ee04b01-4825-401c-93b0-64ffaa7e3452","name":"Knudsen, Lotte Juul","name_org":"Knudsen, Lotte J.","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Valentin","key":"rauhpau","last":"Rauh","name":"Rauh, Valentin","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jannik N.","key":"pedersenpau","last":"Pedersen","locid":"9afe60ea-968a-49aa-81d4-859eb80d7b15","name":"Pedersen, Jannik Nedergaard","name_org":"Pedersen, Jannik N.","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Peter","key":"dekkerpau","last":"Dekker","name":"Dekker, Peter","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Daniel E.","key":"otzenpau","last":"Otzen","locid":"0ec06c22-1f74-4dd2-a894-af30b6565766","name":"Otzen, Daniel E","name_org":"Otzen, Daniel E.","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lotte B.","key":"larsenpau","last":"Larsen","locid":"204d7240-6828-4ee0-8ef5-77a4a2ac92d4","name":"Larsen, Lotte Bach","name_org":"Larsen, Lotte B.","orcid":"0000-0001-9674-0107","rank":6,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Søren D.H.","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Søren D.H.","rank":7,"rolecode":"pau"}],"pmid":["39265836"],"pub":{"doi":"10.3168/jds.2024-25103","issn":["00220302","15253198"],"issn_org":["00220302"],"issue":"12","journal":"Journal of Dairy Science","pages":"10497-10511","publisher":"Elsevier Inc.","status":"p","title":"Journal of Dairy Science","volume":"107"},"review":"Peer Reviewed","scoID":["2-s2.0-85210141325"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Private Research","All Universities","Arla Foods","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Private Research","Universities"],"PST":["Published"]},"sid":["au-fd079b16-bb47-47bb-acde-bff694b6a950"],"src":["AU Aarhus University"],"title":"Insight into protein crosslinking and casein polymerization in pre- and posthydrolyzed lactose-free ultra-high-temperature milk during long-term storage","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-758723","year":"2024","yearsub":"2024"}
{"abstract":"During construction work (2017–2019), an increase in Aspergillus flavusinfections was noted among pediatric patients, the majority of whom were receivingamphotericin B prophylaxis. Microsatellite genotyping was used to characterize theoutbreak. A total of 153 A. flavus isolates of clinical and environmental origin wereincluded. Clinical isolates included 140 from 119 patients. Eight patients were outbreak-related patients, whereas 111 were outbreak-unrelated patients from Danish hospitals(1994–2023). We further included four control strains. Nine A. flavus isolates were fromsubsequent air sampling in the outbreak ward (2022–2023). Typing followed Rudramurthy et al.(S. M. Rudramurthy, H. A. de Valk, A. Chakrabarti, J. Meis, and C. H. W. Klaassen, PLoS One 6:e16086, 2011, https://doi.org/10.1371/journal.pone.0016086). Minimumspanning tree (MST) and discriminant analysis of principal components (DAPC) wereused for cluster analysis. DAPC analysis placed all 153 isolates in five clusters. Microsatellite marker pattern was clearly distinct for one cluster compared to the others.The same cluster was observed in an MST. This cluster included all outbreak isolates,air-sample isolates, and additional patient isolates from the outbreak hospital, previouslyundisclosed as outbreak related. The highest air prevalence of A. flavus was found intwo technical risers of the outbreak ward, which were then sealed. Follow-up air sampleswere negative for A. flavus. Microsatellite typing defined the outbreak as nosocomialand facilitated the identification of an in-hospital source. Six months of follow-upair sampling was without A. flavus. Outbreak-related/non-related isolates were easilydistinguished with DAPC and MST, as the outbreak clone’s distinct marker pattern wasdelineated in both statistical analyses. Thus, it could be a variant of A. flavus, with a nicheability to thrive in the outbreak-hospital environment.","author_count":12,"contributors":["Gewecke, A","Hare, R Krøger","Salgård, C","Kyndi, L","Høg, M","Petersen, G","Nahimana, D","Abou-Chakra, N","Knudsen, J D","Rosendahl, Søren","Vissing, N H","Arendrup, Maiken Cavling"],"cuid":["S01-000.00-760410"],"filters":{"added":"2024-10","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"a single source nosocomial outbreak of i aspergillus flavus i uncovered by genotyping","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1128/spectrum.00273-24","version":"Published Version"},"id":"S01-000.00-760410","identifier":[{"id":"38888358","type":"pmid"},{"id":"PMC11302659","type":"pmcid"},{"id":"85201029839","type":"scopus"}],"ids":["ku-d3ec9058-4160-4c86-a2a0-75612ff8d43b"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-363D746813FF8BABD0539B204A6EF584"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/402485220/vergidis_et_al_2024_a_single_source_nosocomial_outbreak_of_aspergillus_flavus_uncovered_by_genotyping.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1128/spectrum.00273-24","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"ssi statens serum institut","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-SSI","l3nn":"SSI Statens Serum Institut","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SSI Statens Serum Institut","namevar":["Statens Serum Institut"],"nora_code":"DI-GV-SSI","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2