{"author_count":12,"contributors":["Carlsen, Anting Liu","Schetter, Aaron J","Nielsen, Christoffer","Lood, Christian","Knudsen, Steen","Voss, Anne","Harris, Curtis C","Hellmark, Thomas","Segelmark, Mårten","Jacobsen, Søren","Bengtsson, Anders","Heegaard, Niels Henrik Helweg"],"cuid":["S01-000.00-732949"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"circulating microrna expression profiles associated with systemic lupus erythematosus","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1002/art.37890","version":"Other Version"},"id":"S01-000.00-732949","identifier":[{"id":"84876554579","type":"scopus"}],"ids":["ku-fd6e6865-9e09-4355-a4f8-58ec3425a43a"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-3-5-711DDDF5CBC2A8DFD206CFD45052D8F0"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1002/art.37890","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Section of Orthopaedics and Internal Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Anting Liu","key":"carlsenpau","last":"Carlsen","name":"Carlsen, Anting Liu","rank":1,"rolecode":"pau"},{"affno":"","first":"Aaron J","key":"schetterpau","last":"Schetter","name":"Sch