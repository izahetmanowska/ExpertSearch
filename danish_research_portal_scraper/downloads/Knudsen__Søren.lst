{"abstract":"Kapitlet undersøger, med udgangspunkt i empiri fra læreruddannelsen, hvordan man kan forstå leg og øvelse som forskellige aktivitetsformer.","author_count":4,"contributors":["Hørning Hansen, Søren"],"cuid":["S01-000.00-215896"],"filters":{"added":"2022-11","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Leg og læring"],"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"øvelse forøger vores evne til at lege","src":["au"],"src-code":["DI-U-AU"],"type":"dba","type-grp":["all","pub"]},"id":"S01-000.00-215896","ids":["au-97fdec38-e979-4eb0-90b7-c3c3af3284cb"],"keyword":["Leg og læring"],"lang":"Danish","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-847756DBFF9322BFA78F62F69F1FFDE2"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Arts, Danish School of Education, Danish School of Education - Department of Education Studies"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Søren","key":"hørninghansenpau","last":"Hørning Hansen","locid":"b372f258-aa5a-4511-9367-08fccd0fc597","name":"Hørning Hansen, Søren","rank":1,"rolecode":"pau"},{"affno":"","first":"Hanne","key":"knudsenpedh","last":"Knudsen","name":"Knudsen, Hanne","rank":2,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Jens Erik","key":"kristensenpedh","last":"Kristensen","name":"Kristensen, Jens Erik","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Johan Bundgaard","key":"nielsenpedh","last":"Nielsen","name":"Nielsen, Johan Bundgaard","rank":4,"role":"Editor of Host Publica