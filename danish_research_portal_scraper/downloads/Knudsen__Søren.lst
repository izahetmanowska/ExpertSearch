ndeknudsenpau","last":"Bonde Knudsen","locid":"6f433995-900f-4178-897d-417c671ef417","name":"Bonde Knudsen, John","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mie","key":"kiszkanielsenpau","last":"Kiszka Nielsen","locid":"0416d460-fc74-4b3e-ab08-71d090d34289","name":"Nielsen, Mie Kiszka","name_org":"Kiszka Nielsen, Mie","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Peter","key":"junkerpau","last":"Junker","locid":"90794ab5-2456-4977-b5d3-23220ba38fb6","name":"Junker, Peter","orcid":"0000-0002-2684-9964","rank":4,"rolecode":"pau"}],"pmid":["22389798"],"pub":{"doi":"10.5402/2011/608942","issn":["23567872"],"issue":"608942","journal":"International Scholarly Research Notices","publisher":"Hindawi Publishing Corporation","status":"p","title":"International Scholarly Research Notices","volume":"2011"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-5ea547d7-ce65-4f50-9514-9e6dccf199d2"],"src":["SDU University of Southern Denmark"],"title":"Wegener's Granulomatosis Presenting with Pachymeningitis: Clinical and Imaging Remission by Rituximab","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-600272","year":"2011","yearsub":"2011"}
{"abstract":"This paper presents a spatially resolved transient fuel cell model applied to the simulation of high temperature PEM fuel cell impedance spectra. The model is developed using a 2D finite volume method approach. The model is resolved along the channel and across the membrane. The model considers diffusion of cathode gas species in gas diffusion layers and catalyst layer, transport of protons in the membrane and the catalyst layers, and double layer capacitive effects in the catalyst layers. The model has been fitted simultaneously to a polarisation curve and to an impedance spectrum recorded in the laboratory. A simultaneous fit to both curves is not achieved. In order to investigate the effects of the fitting parameters on the simulation results, a parameter variation study is carried out. It is concluded that some of the fitting parameters assume values which are not realistic. In order to remedy this, phenomena neglected in this version of the model must be incorporated in future versions.","author_count":3,"contributors":["Vang, Jakob Rabjerg","Andreasen, Søren Juhl","Kær, Søren Knudsen"],"cuid":["S01-000.00-078210"],"event":{"end":"2011-08-10","place":"Washington, DC, us","start":"2011-08-07","title":"ASME 2011 9th Fuel Cell Science, Engineering and Technology Conference","year":"2011"},"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"a transient fuel cell model to simulate htpem fuel cell impedance spectra","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"id":"S01-000.00-078210","identifier":[{"id":"84881655213","type":"scopus"}],"ids":["aau-611d5948-2c88-4fbd-aa77-81ae03fa8d7f"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-B374894F7F41F8207C51894D58E82D45"],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (ENG)","Aalborg University, The Faculty of Engineering and Science, AAU Energy","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Thermal Energy Systems"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jakob Rabjerg","key":"vangpau","last":"Vang","locid":"863c6a36-4e04-431b-a5b0-9e141fd73553","name":"Vang, Jakob Rabjerg","orcid":"0000-0002-4497-3205","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren Juhl","key":"andreasenpau","last":"Andreasen","locid":"02115d16-a485-4ac6-b914-7460ef6c4e83","name":"Andreasen, Søren Juhl","orcid":"0000-0002-0767-5874","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren Knudsen","key":"kærpau","last":"Kær","locid":"898d6584-ec2e-430a-b78d-e3e0d670dcdd","name":"Kær, Søren Knudsen","orcid":"0000-0003-2151-8055","rank":3,"rolecode":"pau"}],"pub":{"isbn":["9780791854693"],"pages":"817-830","publisher":"The American Society of Mechanical Engineers (ASME)","status":"p","title":"Proceedings of ASME 2011 5th International Conference on Energy Sustainability &amp; 9th Fuel Cell Science, Engineering and Technology Conference"},"review":"Peer Reviewed","scoID":["2-s2.0-84881655213"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-611d5948-2c88-4fbd-aa77-81ae03fa8d7f"],"src":["AAU Aalborg University"],"title":"A transient fuel cell model to simulate HTPEM fuel cell impedance spectra","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-078210","year":"2011","yearsub":"2011"}
{"abstract":"This paper presents numerical study of one of Sydney swirl flames. Good agreements gained between numerical results and the experimental data. Reynolds-averaged Navier-Stokes (RANS) and large eddy simulation (LES) methods show different flow patterns in isothermal and reacting case. The influence of heat release is considered by comparing cold flow structure with same boundary conditions and reaction flow structure using RANS results. The research built the framework for the following reacting flow studies using LES.","author_count":3,"contributors":["Yang, Yang","Kær, Søren Knudsen","Yin, Chungen"],"cuid":["S01-000.00-080005"],"event":{"end":"2011-07-01","place":"Cardiff, gb","start":"2011-06-28","title":"2011 European Combustion Meeting (ECM)","year":"2011"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Large eddy simulation","Swirl burner"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"nr","rtype":["clu"],"sorti":"numerical study of one swirling flame","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/58640294/numerical_study_of_one_swirling_flame.pdf","version":"Authors Final Version"},"id":"S01-000.00-080005","ids":["aau-67272156-85e3-4524-9812-b410d5f990ff"],"keyword":["Large Eddy Simulation","Swirl Burner"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-74EAFD48A927175EF09D10136FCB049E"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/58640294/numerical_study_of_one_swirling_flame.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University