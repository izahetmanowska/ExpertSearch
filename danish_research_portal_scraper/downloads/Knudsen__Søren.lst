:"dk","first":"Søren","key":"kristiansenpau","last":"Kristiansen","locid":"c57ab19f-6ab2-43bf-bbc3-31514f5f1b10","name":"Kristiansen, Søren","orcid":"0000-0001-7211-8882","rank":3,"rolecode":"pau"},{"affno":"","first":"Michael Hviid","key":"jacobsenpedh","last":"Jacobsen","name":"Jacobsen, Michael Hviid","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Rasmus","key":"antoftpedh","last":"Antoft","name":"Antoft, Rasmus","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Rune Valentin","key":"gregersenpedh","last":"Gregersen","name":"Gregersen, Rune Valentin","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Claus D.","key":"hansenpedh","last":"Hansen","name":"Hansen, Claus D.","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Anja","key":"jørgensenpedh","last":"Jørgensen","name":"Jørgensen, Anja","rank":8,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Trond Beldo","key":"klausenpedh","last":"Klausen","name":"Klausen, Trond Beldo","rank":9,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Lisbeth B.","key":"knudsenpedh","last":"Knudsen","name":"Knudsen, Lisbeth B.","rank":10,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Søren","key":"kristiansenpedh","last":"Kristiansen","name":"Kristiansen, Søren","rank":11,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Anders","key":"petersenpedh","last":"Petersen","name":"Petersen, Anders","rank":12,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Sune Qvotrup","key":"jensenpedh","last":"Jensen","name":"Jensen, Sune Qvotrup","rank":13,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["9788761637765"],"pages":"162-177","place":"Århus","publisher":"Systime Academic","status":"p","title":"SociologiNU"},"review":"No Review","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-9c2ee318-23cb-4812-ad40-e9a4b609951d"],"src":["AAU Aalborg University"],"title":"Kultur og hverdagsliv","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-095344","year":"2015","yearsub":"2015"}
{"abstract":"Li-ion batteries are known to undergo complex ageing processes, where the operating conditions have a profound and non-linear effect on both calendar life and cycle life. This is especially a challenge for the automotive industry, where the requirements on product lifetime and reliability are demanding. The aim of the present work is to quantify the ageing in terms of capacity fade and impedance growth as a function of operating conditions typical to high-power automotive applications; high charge and discharge rate, elevated temperatures and wide state-of-charge windows. The cycle life of 34 power-optimised LiFePO4/graphite cells was quantified by testing with charge and discharge rates between 1 and 4C-rate, temperatures between +23<sup>o</sup> C and +53<sup>o</sup> C, and a depth-of-discharge of either 100% or 60%. Although all cells show similar ageing pattern in general, the cycle life and the impedance growth is remarkably different for the tested cases. In addition, it is concluded that high charging rates, high temperatures or intensive cycling do not always lead to a shorter cycle life. One specifically interesting finding is that the combination of 1C-rate discharge in combination with 3.75C-rate charging was found to degrade the tested cells more rapidly than a symmetric cycle with 3.75C-rate in both directions.","author_count":4,"contributors":["Groot, Jens","Swierczynski, Maciej Jozef","Stroe, Ana-Irina","Kær, Søren Knudsen"],"cuid":["S01-000.00-106105"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"country":["Sweden"],"glorg":["All Global Affiliations","Chalmers University of Technology"],"keyword":["Battery ageing","Cycle life","Fast charging","Impedance spectroscopy","Lithium ion battery","State of health"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"on the complex ageing characteristics of high power lifepo000000000004 graphite battery cells cycled with high charge and discharge currents","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-106105","identifier":[{"id":"84927556820","type":"scopus"},{"id":"WOS:000355027400056","type":"wos"}],"ids":["aau-c13c71f6-9db4-4f6e-b3f9-9e337c1b8186"],"keyword":["Battery ageing","Cycle life","Fast charging","Impedance spectroscopy","Lithium-ion battery","State-of-health"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-381E0123DDDA18647B9814C8A2D933E6"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","country":"se","key":"chalmers university of technology","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Chalmers University of Technology","used":1},{"affno":"2","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (ENG)","Aalborg University, The Faculty of Engineering and Science, AAU Energy","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Power Electronic Systems"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jens","key":"grootpau","last":"Groot","name":"Groot, Jens","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Maciej Jozef","key":"swierczynskipau","last":"Swierczynski","locid":"767958b2-8061-4038-82d6-7a0068c26efe","name":"Swierczynski, Maciej Jozef","orcid":"0000-0003-3837-9696","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Ana-Irina","key":"stroepau","last":"Stroe","locid":"e6ff6bac-362f-4fd1-b46c-d5f62d1e2c1a","name":"Stroe, Ana-Irina","orcid":"0000-0002-6205-8254","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Søren Knudsen","key":"kærpau","last":"Kær","locid":"898d6584-ec2e-430a-b78d-e3e0d670dcdd","name":"Kær, Søren Knudsen","orcid":"0000-0003-2151-8055","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.jpowsour.2015.04.001","issn":["03787753","18732755"],"issn_org":["03787753"],"journal":"Journal of Power Sources","pages":"475-487","publisher":"Elsevier","status":"p","title":"Journal of Power Sources","volume":"286"},"review":"Peer Reviewed","scoID":["2-s2.0-84927556820"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-c13c71f6-9db4-4f6e-b3f9-9e337c1b8186"],"src":["AAU Aalborg University"],"title":"On the complex ageing characteristics of high-power LiFePO4/graphite battery cells cycled with high charge and discharge currents","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-106105","year":"2015","yearsub":"2015"}
{"author_count":7,"contributors":["Croix, Sarah","Knudsen, Maria","Pedersen, Anne","Pentz, Peter","Sindbæk, Søren Michael","Sørensen, Anne Christina"],"cuid":["S01-000.00-165757"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"pop","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-OT","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-KUM"],"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-GV-KUM","DI-U-AU"]},"review":"und","rtype":["clu"],"sorti":"tales","src":["au"],"src-code":["DI-U-AU"],"type":"dba","type-grp":["all","pub"]},"id":"S01-000.00-165757","ids":["au-3fef0e08-b08a-4b74-8cdc-10f767eb6d6b"],"lang":"English","level":"Popular","mra":["Humanities"],"noi":["Local-1-1-0C298F290F74F043F12D06CD0334F69B"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Arts, School of Culture and Society, School of Culture and Society - Medieval and Renaissance Archaeology, subject"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1},{"affno":"3","country":"dk","key":"kum ministry of culture archives museums and royal library denmark","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-KUM","l3nn":"KUM Ministry of Culture - Archives, Museums, and Royal Library Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KUM Ministry of Culture - Archives, Museums, and Royal Library Denmark","namevar":["Nationalmuseet"],"nora_code":"DI-GV-KUM","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Sarah","key":"croixpau","last":"Croix","locid":"85a83b94-b0c4-4abb-9161-cff867a1fa7a","name":"Croix, Sarah","orcid":"0000-0002-3956-6728","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Maria","key":"knudsenpau","last":"Knudsen","name":"Knudsen, Maria","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Anne","key":"pedersenpau","last":"Pedersen","name":"Pedersen, Anne","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Peter","key":"pentzpau","last":"Pentz","name":"Pentz, Peter","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren Michael","key":"sindbækpau","last":"Sindbæk","locid":"65a936de-6831-47a4-9ce2-86f59dbfb019","name":"Sindbæk, Søren Michael","orcid":"0000-0002-1254-1256","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Anne Christina","key":"sørensenpau","last":"Sørensen","name":"Sørensen, Anne Christina","rank":6,"rolecode":"pau"},{"affno":"","first":"Søren Michael","key":"sindbækpedh","last":"Sindbæk","name":"Sindbæk, Søren Michael","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"pages":"31-93","place":"Ribe","publisher":"Liljebjerget","status":"p","subtitle":"The Viking Age of Denmark","title":"Dragons of the Northern Seas"},"review":"Undetermined","search":{"DAF":["Aarhus University","All Danish Affiliations","All Governmental Institutions","All Miscellaneous","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Governmental Institutions","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-3fef0e08-b08a-4b74-8cdc-10f767eb6d6b"],"src":["AU Aarhus University"],"title":"Tales","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-165757","year":"2015","yearsub":"2015"}
{"abstract":"In the field of energy storage devices the pursuit for cheap, high energy density, reliable secondary batteries is at the top of the agenda. The Li−O2 battery is one of the possible technologies that, in theory, should be able to close the gap, which exists between the present state-of-the-art Liion technologies and the demand placed on batteries by technologies such as electrical vehicles. Here we present a redox probing study of the charge transfer across the main deposition product lithium peroxide, Li2O2, in the Li−O2 battery using outer-sphere redox shuttles. The change in heterogeneous electron transfer exchange rate as a function of the potential and the Li2O2 layer thickness (∼depth-of-discharge) was determined using electrochemical impedance spectroscopy. The attenuation of the electron transfer exchange rate with film thickness is dependent on the probing potential, providing evidence that hole transport is the dominant process for charge transfer through Li2O2 and showing that the origin of the sudden death observed upon discharge is due to charge transport limitations.","author_count":5,"contributors":["Knudsen, Kristian Bastholm","Luntz, Alan C.","Jensen, Søren Højgaard","Vegge, Tejs","Hjelm, Johan"],"cuid":["S01-000.00-376638"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","Stanford University"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"redox probing study of the potential dependence of charge transport through li sub 000000000002 sub o sub 000000000002 sub","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/118856541/Redox_Probing_Study.pdf","version":"Published Version"},"id":"S01-000.00-376638","identifier":[{"id":"84952904619","type":"scopus"}],"ids":["dtu-f0c749f3-4927-487b-87ed-4324fb63dc30"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-5D192C40597BC9CD1F0F620BCF16972B"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/118856541/Redox_Probing_Study.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Energy Conversion and Storage","Technical University of Denmark, Department of Energy Conversion and Storage, Atomic Scale Materials Modelling"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"us","key":"stanford university","loc":["United States","America, North","OECD"],"name":"Stanford University","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Kristian Bastholm","key":"knudsenpau","last":"Knudsen","locid":"dfdc27fb-b2dc-496b-966d-5a763d268b3a","name":"Knudsen, Kristian Bastholm","orcid":"0000-0003-1217-8730","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Alan C.","key":"luntzpau","last":"Luntz","name":"Luntz, Alan C.","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren Højgaard","key":"jensenpau","last":"Jensen","locid":"acfa4bf6-66d5-43b8-80e3-8c2a85cc5b8e","name":"Jensen, Søren Højgaard","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Tejs","key":"veggepau","last":"Vegge","locid":"9167b552-7d47-43ed-b2cf-9cea2ebd5499","name":"Vegge, Tejs","orcid":"0000-0002-1484-0284","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Johan","key":"hjelmpau","last":"Hjelm","locid":"1f33d9cb-8387-4672-bfa5-091ef2fc1329","name":"Hjelm, Johan","orcid":"0000-0003-0072-5784","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1021/acs.jpcc.5b08757","issn":["19327447","19327455"],"issn_org":["19327447"],"issue":"51","journal":"Journal of Physical Chemistry C","pages":"28292-28299","publisher":"American Chemical Society","status":"p","title":"Journal of Physical Chemistry C","title_org":"The Journal of Physical Chemistry Part C","volume":"119"},"review":"Peer Reviewed","scoID":["2-s2.0-84952904619"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-f0c749f3-4927-487b-87ed-4324fb63dc30"],"src":["DTU Technical University of Denmark"],"title":"Redox Probing Study of the Potential Dependence of Charge Transport Through Li<sub>2</sub>O<sub>2</sub>","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-376638","year":"2015","yearsub":"2015"}
{"abstract":"Dette projekt undersøger hvorvidt brugen af laminar indblæsning (laminar air flow, LAF) på operationsstuer nedsætter infektionsrisikoen i forhold til konventionel ventilation (turbulent air flow, TAF), og hvilke muligheder der foreligger for energioptimering med udgangspunkt i driftsforholdene på Gentofte Hospital. Under mock-up operationer med en patient-dukke undersøgte vi betydningen af ventilationssystemet på operationsstu-en. Således blev der i løbet af 11 forsøgsdage gennemført i alt 2x 16 simulerede hoftealloplastik operationer på stuer med hhv. LAF og TAF ventilation. Halvdelen af forsøgene er endvidere foretaget med reduceret (50 %) friskluftskifte således at hvert set-up er foretaget med 8 gentagelser. Hvert af de 32 forsøg blev udført med samme opsætning af rengøring, udstyrsplacering, forsøgspersoner og bevægemønstre. Der blev under forsøgene foretaget måling af kimtal, partikler og sporgas, samt driftsmåling af energiforbrug. På LAF stuen var alle målinger under anbefalede værdier uafhængig af om det blev kørt med 100 % eller 50 % frisk-luftmængde og uden øgning af CFU tal ved 50 % reduktion. På TAF stuer var der ved et væsentlig antal (4/16) operati-oner kritisk høje kimtal over anbefalet niveau. Dette er vigtigt, da omkostninger til om-operationer, som følge af infekti-on under og efter hofte- og knæoperationer, beløber sig ifølge Sundhedsstyrelsen til 34-57 mio. kr. om året. Angående elforbruget til LAF stuerne var det muligt at reducere elforbruget med 41 % uden forøgelse af kim tallet, der-udover skal det tilføjes at elforbrugs niveauet ved 50 % friskluftmængde på LAF stuen var under det elforbrug, der blev anvendt ved 100 % friskluftmængde på TAF stuerne. Dog skal det pointeres at alle forsøgende blev udført i november, december og januar måned. Varme- og kølebehovet var yderst minimalt. I et afgangsprojekt fra DTU Byg, blev luftstrømmene på operationsstuerne undersøgt ved sporgas-måling . Analyserne viste en kontamineringsrisiko i de kritiske områder på TAF stuen, som var 48 % højere end på LAF.","author_count":11,"contributors":["Overgaard, Anders","Overgaard, Søren","Frich, Lars Henrik","Ravn, Christen","Olsen, Martin","Knudsen, Niels Bastholm","Nielsen, Johnny","Toftum, Jørn","Clausen, Geo","Nielsen, Linn","Rosenbeck, Katrine"],"cuid":["S01-000.00-380438"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-PR","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-SDR"],"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-HO-SDR","DI-PR-OTH","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"opvent projektrapport 000000002015 resultater af op vent projektet","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/119700190/OP_vent_rapport_051015_FINAL.pdf","version":"Published Version"},"id":"S01-000.00-380438","ids":["dtu-fd8e2788-9cc6-47b4-99d0-d933c675af79"],"lang":"Danish","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-76E71D2AE1B28744B1298773279D7448"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/119700190/OP_vent_rapport_051015_FINAL.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Odense University Hospital"],"nora_code":"DI-HO-SDR","used":1},{"affno":"2","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","nameva