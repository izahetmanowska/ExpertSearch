:"1 2 3","corresponding":null,"country":"dk","first":"Hans Erik","key":"bøtkerhanserikpau","last":"Bøtker","locid":"09b03c00-11a8-4f72-800f-181f26155750","name":"Bøtker, Hans Erik","orcid":"0000-0001-6358-8962","rank":14,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Per L","key":"poulsenperløgstruppau","last":"Poulsen","locid":"a965cecb-44f9-4913-a8e1-7bc669e8ffd9","name":"Poulsen, Per Løgstrup","name_org":"Poulsen, Per L","rank":15,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Per L","key":"poulsenperlpau","last":"Poulsen","name":"Poulsen, Per L","rank":15,"rolecode":"pau"}],"pmid":["33201052"],"pub":{"doi":"10.1097/hjh.0000000000002694","issn":["02636352","09521178"],"issn_org":["09521178"],"issue":"4","journal":"Journal of Hypertension","pages":"607-613","publisher":"Lippincott Williams and Wilkins Ltd.","status":"p","title":"Journal of Hypertension","volume":"39"},"review":"Peer Reviewed","scoID":["2-s2.0-85102536415"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Region of Southern Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-617b6b86-3513-482d-84ce-31ddac729944","au-93e91dee-e6e7-4d97-bca0-e54d4a02a814","sdu-cc6609d0-9eb2-4648-a6d9-75ab6d1517d8"],"src":["AAU Aalborg University","AU Aarhus University","SDU University of Southern Denmark"],"title":"Invasive aortic pulse pressure is not superior to cuff pulse pressure in cardiovascular risk prediction","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-093.17-665827","year":"2021","yearsub":"2021"}
{"abstract":"The aim of this article is to present a complete and detailed gasification/smoldering model for a single biomass pellet. The four main objectives were: to write a modified one-dimensional numerical model using C++, to validate the results using experimental data from the literature, to present an overview of the one-dimensional model results, and to investigate the effects of main parameters used in the model. This model includes all the necessary partial differential equations describing continuity, species, energy and pressure. All the equations are highly coupled and are solved using a finite volume, central difference scheme. A time-marching procedure is based on a fully implicit scheme. Validations with air smoldering combustion are presented and the results show good agreement with the experimental data. The detailed results from this model show, for example, the temperature profile, the gas species distribution, the carbon content and the reaction rate. A discussion about the important parameters and their effects on this model is also presented. The parametric study shows that the devolatilization rate can prolong or shorten the duration of devolatilization stage but it cannot affect the highest temperature that the combustion can reach. As for the boundary condition for the temperature distribution, the radiation from the heating wall is a dominant factor to the temperature distribution within the pellet, whist the convection from the ambient flow has a negligible impact. A two-step and four-step hydrocarbon combustion scheme is implemented in this one-dimensional CFD model. The results show that, both schemes can predict the temperature quite well compared to the experimental data, with an error of up to 5% in the temperature simulation.","author_count":4,"contributors":["Li, Xiyan","Kær, Søren Knudsen","Condra, Thomas Joseph","Yin, Chungen"],"cuid":["S01-000.00-119571"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Biomass gasification","Combustion","Computational fluid dynamics CFD","Porous media","Single particle"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"a detailed computational fluid dynamics model on biomass pellet smoldering combustion and its parametric study","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85095812084&partnerID=8YFLogxK","version":"Other Version"},"id":"S01-000.00-119571","identifier":[{"id":"85095812084","type":"scopus"}],"ids":["aau-ef25d5a6-f180-4823-b1b1-dc80f39ad225"],"keyword":["Biomass gasification","Combustion","Computational fluid dynamics (CFD)","Finite volume method (FVM)","Porous media","Single particle"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-0D48EBD51BD5144761A0765BCCE886C9"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, AAU Energy","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Thermal Engineering"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Xiyan","key":"lipau","last":"Li","locid":"014a9e44-0747-4c9c-a944-54e8b42244e3","name":"Li, Xiyan","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren Knudsen","key":"kærpau","last":"Kær","locid":"898d6584-ec2e-430a-b78d-e3e0d670dcdd","name":"Kær, Søren Knudsen","orcid":"0000-0003-2151-8055","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Thomas","key":"condrapau","last":"Condra","locid":"efc8fe4a-c33b-4fb6-b2e7-2e7141f4592c","name":"Condra, Thomas Joseph","name_org":"Condra, Thomas","orcid":"0000-0002-1140-6415","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Chungen","key":"yinpau","last":"Yin","locid":"a24ca845-2626-44cc-b726-b6c5ec9ddd24","name":"Yin, Chungen","orcid":"0000-0002-9885-7744","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.ces.2020.116247","issn":["00092509","18734405"],"issn_org":["00092509"],"journal":"Chemical Engineering Science","paperid":"116247","publisher":"Elsevier","status":"p","title":"Chemical Engineering Science","volume":"231"},"review":"Peer Reviewed","scoID":["2-s2.0-85095812084"],"sdg":["7. Affordable and Clean Energy","All UN SDG Classification"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-ef25d5a6-f180-4823-b1b1-dc80f39ad225"],"src":["AAU Aalborg University"],"title":"A detailed computational fluid dynamics model on biomass pellet smoldering combustion and its parametric study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-119571","year":"2021","yearsub":"2021"}
{"abstract":"Snakebite envenoming is predominantly an occupational disease of the rural tropics, causing death or permanent disability to hundreds of thousands of victims annually. The diagnosis of snakebite envenoming is commonly based on a combination of patient history and a syndromic approach. However, the availability of auxiliary diagnostic tests at the disposal of the clinicians vary from country to country, and the level of experience within snakebite diagnosis and intervention may be quite different for clinicians from different hospitals. As such, achieving timely diagnosis, and thus treatment, is a challenge faced by treating personnel around the globe. For years, much effort has gone into developing novel diagnostics to support diagnosis of snakebite victims, especially in rural areas of the tropics. Gaining access to affordable and rapid diagnostics could potentially facilitate more favorable patient outcomes due to early and appropriate treatment. This review aims to highlight regional differences in epidemiology and clinical snakebite management on a global scale, including an overview of the past and ongoing research efforts within snakebite diagnostics. Finally, the review is rounded off with a discussion on design considerations and potential benefits of novel snakebite diagnostics.","author_count":9,"contributors":["Knudsen, Cecilie","Jürgensen, Jonas A.","Føns, Sofie","M. Haack, Aleksander","U. W. Friis, Rasmus","Dam, Søren Helweg","P. Bush, Sean","White, Julian","Laustsen, Andreas H."],"cuid":["S01-000.00-334936"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","OECD","Oceania"],"corresponding_author":["Knudsen, Cecilie","Laustsen, Andreas H."],"country":["Australia","United States"],"glorg":["All Global Affiliations","Women's and Children's Hospital Adelaide","Yale School of Medicine"],"keyword":["Clinical toxicology","Diagnosis","Diagnostics","Envenoming"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"snakebite envenoming diagnosis and diagnostics","src":["dtu"],"src-code":["DI-U-DTU"],"type":"djr","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/fimmu.2021.661457","version":"Published Version"},"id":"S01-000.00-334936","identifier":[{"id":"33995385","type":"pmid"},{"id":"85105988543","type":"scopus"},{"id":"PMC8113877","type":"pmcid"}],"ids":["dtu-65c3915d-2074-4485-9f4d-f9b8ce3afa34"],"keyword":["Clinical toxicology","Diagnosis","Diagnostics","Envenoming","Ophidism","Snakebite management","Syndromic approach"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-F5A1F86BC7BA3F634433663DBE6D9DDE"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/245346976/fimmu_12_661457.pdf","version":"Published Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/245514364/Snakebite_envenoming_diagnosis_and_diagnostics_v14_Clean.pdf","version":"Authors Final Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/fimmu.2021.661457","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Biotechnology and Biomedicine","Technical University of Denmark, Department of Biotechnology and Biomedicine, Section for Protein Science and Biotherapeuti