ferheld","locid":"16abdc66-c16f-4656-9a3b-29ef941fce9c","name":"Seiferheld, Bo Eitel","name_org":"Seiferheld, Bo","orcid":"0000-0001-7235-5597","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren Bak","key":"sørensenpau","last":"Sørensen","locid":"6b19a8a2-8c16-49af-881e-135014827723","name":"Sørensen, Søren Bak","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lasse","key":"knudsenpau","last":"Knudsen","locid":"659ebc91-3567-4996-a21e-4468b7110586","name":"Knudsen, Lasse","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ernst Albin","key":"hansenpau","last":"Hansen","locid":"b43b2264-f483-4c4a-a204-2973c10780c4","name":"Hansen, Ernst Albin","orcid":"0000-0003-2690-6807","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Andrew James Thomas","key":"stevensonpau","last":"Stevenson","locid":"3b7506b2-1747-45dc-8b77-c25e1ddeebc5","name":"Stevenson, Andrew James Thomas","orcid":"0000-0003-1045-4738","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders","key":"emanuelsenpau","last":"Emanuelsen","locid":"35246e72-e55c-4f25-a9f5-e12b7ec6f8eb","name":"Emanuelsen, Anders","rank":6,"rolecode":"pau"}],"pub":{"pages":"29","publisher":"Danish Society of Biomechanics","status":"p","title":"Program &amp; Abstracts, 10th Annual Meeting of the Danish Society of Biomechanics, 5 October 2018, Brøndby, Denmark"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-0472b5a5-94f2-4071-b29b-36827e208f87"],"src":["AAU Aalborg University"],"title":"Freely chosen finger tapping frequency is increased between limbs during repeated bout rate enhancement","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-051327","year":"2018","yearsub":"2018"}
{"abstract":"In high temperature polymer electrolyte fuel cells, phosphoric acid migration induces flooding of the anode gas diffusion layer at high current densities. The present study focuses on determining the influence of phosphoric acid flooding of the anode GDL on hydrogen mass transport limitations. Two methods for quantifying the performance losses at high current densities, related to acid migration, are discussed: anodic limiting current density measurements and electrochemical impedance spectroscopy. It is demonstrated that the limiting current measurements, the common method for determining transport resistances, is unable to detect the changes induced by acid migration, due to the transient time required when switching to the required low hydrogen concentrations, while EIS is able to capture the changes induced by acid migration because it is faster and less invasive. For diluted hydrogen, an increase of the transport resistance is measured, however the effect on the cell performance is negligible. The time constants for anode GDL flooding and de-flooding are determined based on the EIS data and found to be 8.1 ± 0.1 min for flooding and about 5.8 ± 0.9 min for de-flooding under the applied conditions.","author_count":5,"contributors":["Halter, J","Thomas, Sobi","Kær, Søren Knudsen","Schmidt, T.J.","Büchi, F.N."],"cuid":["S01-000.00-075440"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["Switzerland"],"glorg":["All Global Affiliations","Paul Scherrer Institute","Swiss Federal Institute of Technology Zurich"],"keyword":["EIS"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"the influence of phosphoric acid migration on the performance of high temperature polymer electrolyte fuel cells","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-075440","identifier":[{"id":"85050499647","type":"scopus"}],"ids":["aau-577da8f6-6935-4f44-8557-d1062930732f"],"keyword":["EIS","HT-PEFC","Limiting current","Mass transport resistance","Phosphoric acid migration","büchi,corresponding author,dr,eis,felix n,ht-pefc,limiting current,mass transport resistance,paul scherrer institut,phd,phosphoric acid migration,s institution"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-B7548672EE87E76494AEAA53487DBF2E"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","country":"ch","key":"paul scherrer institute","loc":["Switzerland","Europe, Non-EU","OECD"],"name":"Paul Scherrer Institute","used":1},{"affno":"2","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, AAU Energy","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Fluid Mechanics and Combustion","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Thermal Energy Systems"],"nora_code":"DI-U-AAU","used":1},{"affno":"3","country":"ch","key":"swiss federal institute of technology zurich","loc":["Switzerland","Europe, Non-EU","OECD"],"name":"Swiss Federal Institute of Technology Zurich","used":1}],"person":[{"affno":"1","corresponding":null,"first":"J","key":"halterpau","last":"Halter","name":"Halter, J","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"S","key":"thomaspau","last":"Thomas","locid":"33bb2f77-e034-426b-ac72-d921d4354655","name":"Thomas, Sobi","name_org":"Thomas, S","orcid":"0000-0002-2759-3753","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"S.K.","key":"kærpau","last":"Kær","locid":"898d6584-ec2e-430a-b78d-e3e0d670dcdd","name":"Kær, Søren Knudsen","name_org":"Kær, S.K.","orcid":"0000-0003-2151-8055","rank":3,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"first":"T.J.","key":"schmidtpau","last":"Schmidt","name":"Schmidt, T.J.","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"F.N.","key":"büchipau","last":"Büchi","name":"Büchi, F.N.","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.jpowsour.2018.07.090","issn":["03787753","18732755"],"issn_org":["03787753"],"journal":"Journal of Power Sources","pages":"151-156","publisher":"Elsevier","status":"p","title":"Journal of Power Sources","volume":"399"},"review":"Peer Reviewed","scoID":["2-s2.0-85050499647"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-577da8f6-6935-4f44-8557-d1062930732f"],"src":["AAU Aalborg University"],"title":"The Influence of Phosphoric Acid Migration on the Performance of High Temperature Polymer Electrolyte Fuel Cells","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-075440","year":"2018","yearsub":"2018"}
