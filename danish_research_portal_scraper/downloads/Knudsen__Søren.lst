esponding":null,"country":"dk","first":"Søren Valgreen","key":"knudsenpau","last":"Knudsen","locid":"d59094b5-44a6-4398-9acf-f3f530e0504b","name":"Knudsen, Søren Valgreen","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jan","key":"mainzpau","last":"Mainz","locid":"fadbea42-81be-48a2-afb2-c868f9dfa4f5","name":"Mainz, Jan","orcid":"0000-0003-0242-9233","rank":4,"rolecode":"pau"}],"pub":{"eisbn":["9788797401101"],"pages":"22-23","publisher":"Dansk Selskab for Kvalitet i Sundhedssektoren","status":"p","subtitle":"Begreber, metoder og værktøjer til kvalitetsudvikling på tværs af sundhedsvæsenet","title":"Kvalitetsguiden"},"review":"Undetermined","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-10d0fd01-f48e-4483-a6a5-6daad4583d29"],"src":["AAU Aalborg University"],"title":"Kvalitetsstandard","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-054962","year":"2022","yearsub":"2022"}
{"abstract":"A precise interpretation of lithium-ion battery (LIB) heat generation is indispensable to the advancement and accomplishment of thermal management systems for different applications of LIB, including electric vehicles. The internal resistance of a lithium titanate oxide (LTO)-based LIB was determined at different state of charge (SOC) levels and current rates to understand the relationship between internal resistance and heat generation. Random and different pulse discharge current step durations were applied to consider the effect of different SOC interval levels on heat generation. The total generated heat was measured for different discharge rates and operating temperatures in a Netzsch IBC 284 calorimeter. It was seen that a 6.7% SOC decrease at high SOC levels corresponds to 0.377 Wh, 0.728 Wh, and 1.002 Wh heat generation for 26A, 52A, and 78A step discharge, both at 20 °C and 30 °C. However, a 1.85% SOC decrease at medium SOC levels corresponds already to 0.57 Wh, 0.76 Wh, and 0.62 Wh heat generation. It can be inferred that the impact of SOC level on heat generation for this cell is more prominent at a lower than at a higher SOC.","author_count":4,"contributors":["Madani, Seyed Saeed","Schaltz, Erik","Kær, Søren Knudsen","Ziebert, Carlos"],"cuid":["S01-000.00-071686"],"event":{"end":"2022-08-24","place":"Brno, cz","start":"2022-08-21","title":"23rd International Conference on Advanced Batteries, Accumulators and Fuel Cells, ABAF 2022","year":"2022"},"filters":{"added":"2023-02","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"corresponding_author":["Madani, Seyed Saeed"],"country":["Germany"],"glorg":["All Global Affiliations","Karlsruhe Institute of Technology"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"a comprehensive heat generation study of lithium titanate oxide based lithium ion batteries","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1088/1742-6596/2382/1/012004","version":"Published Version"},"id":"S01-000.00-071686","identifier":[{"id":"85144062721","type":"scopus"}],"ids":["aau-4aab7e5b-943f-4fa2-a398-026d28f43117"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-62C113C0F031DB107F218C539F6BB627"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1088/1742-6596/2382/1/012004","version":"Published Version"},{"access":"oa","license":"CC BY 3.0","type":"loc","url":"https://vbn.aau.dk/ws/files/515385732/Madani_2022_J._Phys._Conf._Ser._2382_012004.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, AAU Energy"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"de","key":"karlsruhe institute of technology","loc":["Germany","Europe, EU","OECD"],"name":"Karlsruhe Institute of Technology","used":1}],"person":[{"affno":"1 2","corresponding":null,"country":"dk","first":"Seyed Saeed","key":"madanipau","last":"Madani","locid":"2b964c98-f205-4a96-8e1c-e2433090f82a","name":"Madani, Seyed Saeed","orcid":"0000-0003-1636-3554","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Erik","key":"schaltzpau","last":"Schaltz","locid":"6e39b31c-c3fa-470a-b47b-e69ee21195c1","name":"Schaltz, Erik","orcid":"0000-0002-8540-0040","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren Knudsen","key":"kærpau","last":"Kær","locid":"898d6584-ec2e-430a-b78d-e3e0d670dcdd","name":"Kær, Søren Knudsen","orcid":"0000-0003-2151-8055","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Carlos","key":"ziebertpau","last":"Ziebert","name":"Ziebert, Carlos","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1088/1742-6596/2382/1/012004","issn":["17426596"],"issn_org":["17426588"],"issue":"1","journal":"Journal of Physics: Conference Series","paperid":"012004","publisher":"IOP Publishing","status":"p","title":"Journal of Physics: Conference Series","volume":"2382"},"review":"Peer Reviewed","scoID":["2-s2.0-85144062721"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-4aab7e5b-943f-4fa2-a398-026d28f43117"],"src":["AAU Aalborg University"],"title":"A comprehensive heat generation study of lithium titanate oxide-based lithium-ion batteries","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-071686","year":"2022","yearsub":"2022"}
{"abstract":"Purpose: To develop algorithms to identify number of lines of anti-neoplastic therapy per patient based on the Danish National Patient Registry (DNPR) and identify which algorithm has the highest percentage agreement with a reference standard of documentation in medical records. Patients and Methods: We included 179 patients diagnosed between January 1, 2012, and December 31, 2016, with stage II, III, or IV urothelial cell carcinoma or stage III or IV epithelial ovarian cancer, gastric adenocarcinoma, renal cell carcinoma, or non-small cell lung cancer (NSCLC). We developed two algorithms for number of lines of anti-neoplastic therapy based on dates and treatment codes (eg, \"treatment with cisplatin\" or \"cytostatic treatment\") in the DNPR. First, to denote a change in line of therapy the \"Time-based algorithm\" used the number of days between consecutive administrations. Second, the \"Drug-based algorithm\" used information on drug names if available or the number of days between consecutive administrations if no drug names were specified. We calculated the percentage agreement between the algorithms setting the number of allowed days between consecutive administrations from 28 to 50 and the reference standard - information on anti-neoplastic therapy drugs abstracted from medical records and subsequently coded according to lines of anti-neoplastic therapy. Results: For the \"Time-based algorithm\", the highest percentage agreement with the reference standard was found when using <45 days between consecutive administrations (67.6%; 95% CI: 60.1-73.8%). However, the percentage agreement was higher for the \"Drug-based algorithm\" using <45 days between consecutive administrations for registrations where the drug name was unspecified (90.5%; 95% CI: 85.0-93.7%). Conclusion: The algorithm for number of lines of anti-neoplastic therapy that had the highest percentage agreement with the reference standard (medical records) incorporated both registration of specific drug names and <45 days between consecutive administrations if the drug name was unspecified in routinely recorded data from DNPR.","author_count":13,"contributors":["Sørup, Signe","Darvalics, Bianka","Knudsen, Jakob Schöllhammer","Rasmussen, Anne Staub","Hjorth, Cathrine Fonnesbech","Vestergaard, Søren Viborg","Khalil, Azza Ahmed","Russo, Leo","Oksen, Dina","Boutmy, Emmanuelle","Verpillat, Patrice","Rørth, Mikael","Cronin-Fenton, Deirdre"],"cuid":["S01-000.00-234186"],"filters":{"added":"2022-04","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Europe, EU","OECD"],"country":["Germany","United States"],"glorg":["All Global Affiliations","Merck KGaA","Pfizer Inc"],"keyword":["Denmark","Positive predictive value"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"identifying valid algorithms for number of lines of anti neoplastic therapy in the danish national patient registry among patients with advanced ovarian gastric renal cell urothelial and non small cell lung cancer attending a danish university hospital","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.2147/CLEP.S342238","version":"Published Version"},"id":"S01-000.00-234186","identifier":[{"id":"85125073174","type":"scopus"},{"id":"35177936","type":"pmid"},{"id":"PMC8846560","type":"pmcid"}],"ids":["au-b7bb3b2a-d1cf-4d06-8d9d-116a6c1c6334"],"keyword":["Denmark","Duration of chemotherapy","Medical oncologic treatments","Medical records review","positive predictive value"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-5791B57E0B837DAE0872A85C34990587"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.2147/CLEP.S342238","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Clinical Epidemiology"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"us","key":"pfizer inc","loc":["United States","America, North","OECD"],"name":"Pfizer Inc","used":1},{"affno":"3","country":"de","key":"merck kgaa","loc":["Germany","Europe, EU","OECD"],"name":"Merck KGaA","used":1},{"affno":"4","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Signe","key":"søruppau","last":"Sørup","locid":"68ef486b-5b10-4211-ae83-661af79e367a","name":"Sørup, Signe","orcid":"0000-0003-1942-683X","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Bianka","key":"darvalicspau","last":"Darvalics","locid":"add1939e-ca22-4035-af0f-ad88240332ea","name":"Darvalics, Bianka","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jakob Schöllhammer","key":"knudsenpau","last":"Knudsen","locid":"a6558780-c573-49a5-8f1e-f8aa9db17bb5","name":"Knudsen, Jakob Schöllhammer","orcid":"0000-0002-3772-4497","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anne Staub","key":"rasmussenpau","last":"Rasmussen","locid":"da63e6b3-5ecd-4c95-9bae-3b1727f4aea6","name":"Rasmus