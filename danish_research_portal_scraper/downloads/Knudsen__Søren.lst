k","first":"Lene H","key":"iversenpau","last":"Iversen","locid":"4d8ada79-98c2-49eb-ac2f-472b41434eff","name":"Iversen, Lene Hjerrild","name_org":"Iversen, Lene H","orcid":"0000-0002-2336-2923","rank":34,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kåre","key":"gotschalcksunesenpau","last":"Gotschalck Sunesen","locid":"985d1890-0823-439b-937e-1ec61a97615a","name":"Gotschalck, Kåre Andersson","name_org":"Gotschalck Sunesen, Kåre","orcid":"0000-0001-5119-2231","rank":35,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Cheng-Ho Jimmy","key":"linpau","last":"Lin","name":"Lin, Cheng-Ho Jimmy","rank":36,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Bernhard G","key":"zimmermannpau","last":"Zimmermann","name":"Zimmermann, Bernhard G","rank":37,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Claus","key":"lindbjergandersenpau","last":"Lindbjerg Andersen","locid":"f97421ce-9c23-4c51-9fcd-be0843ed0c0f","name":"Andersen, Claus Lindbjerg","name_org":"Lindbjerg Andersen, Claus","orcid":"0000-0002-7406-2103","rank":38,"rolecode":"pau"}],"pmid":["31070691"],"pub":{"doi":"10.1001/jamaoncol.2019.0528","issn":["23742437","23742445"],"issn_org":["23742437"],"issue":"8","journal":"JAMA Oncology","pages":"1124-1131","publisher":"American Medical Association","status":"p","title":"JAMA Oncology","volume":"5"},"review":"Peer Reviewed","scoID":["2-s2.0-85065571391"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-61388ffa-fcf7-4e48-962b-06f335d2c982"],"src":["AU Aarhus University"],"title":"Analysis of Plasma Cell-Free DNA by Ultradeep Sequencing in Patients With Stages I to III Colorectal Cancer","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-184836","year":"2019","yearsub":"2019"}
{"abstract":"A cancer of unknown primary (CUP) is a metastatic cancer for which standard diagnostic tests fail to locate the primary cancer. As standard treatments are based on the cancer type, such cases are hard to treat and have very poor prognosis. Using molecular data from the metastatic cancer to predict the primary site can make treatment choice easier and enable targeted therapy. In this article, we first examine the ability to predict cancer type using different types of omics data. Methylation data lead to slightly better prediction than gene expression and both these are superior to classification using somatic mutations. After using 3 data types independently, we notice some differences between the classes that tend to be misclassified, suggesting that integrating the data might improve accuracy. In light of the different levels of information provided by different omics types and to be able to handle missing data, we perform multi-omics classification by hierarchically combining the classifiers. The proposed hierarchical method first classifies based on the most informative type of omics data and then uses the other types of omics data to classify samples that did not get a high confidence classification in the first step. The resulting hierarchical classifier has higher accuracy than any of the single omics classifiers and thus proves that the combination of different data types is beneficial. Our results show that using multi-omics data can improve the classification of cancer types. We confirm this by testing our method on metastatic cancers from the MET500 dataset.","author_count":4,"contributors":["Bavafaye Haghighi, Elham","Knudsen, Michael","Laursen, Britt Elmedal","Besenbacher, Søren"],"cuid":["S01-000.00-251693"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Cancer of unknown primary","Gene expression","Hierarchical classification","Methylation","Multi omics data","Targeted therapy"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"hierarchical classification of cancers of unknown primary using multi omics data","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1177/1176935119872163","version":"Published Version"},"id":"S01-000.00-251693","identifier":[{"id":"31516310","type":"pmid"},{"id":"85071904499","type":"scopus"},{"id":"PMC6719477","type":"pmcid"}],"ids":["au-d63e6e23-6ebf-47c6-b555-bf13d1f8957b"],"keyword":["Cancer of unknown primary","gene expression","hierarchical classification","methylation","multi-omics data","somatic variation","targeted therapy"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-168A15F6FBD38DD43F95076710268531"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1177/1176935119872163","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Molecular Medicine (MOMA)"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Elham","key":"bavafayehaghighipau","last":"Bavafaye Haghighi","locid":"6429865a-b1d1-41f4-811e-b9e9a65a357b","name":"Bavafaye Haghighi, Elham","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Michael","key":"knudsenpau","last":"Knudsen","locid":"0e7c7bb2-f35f-4a40-8376-b7049bdfcddd","name":"Knudsen, Michael","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Britt Elmedal","key":"laursenpau","last":"Laursen","locid":"2148c875-86ab-432a-8b2c-1dbd33b665e6","name":"Laursen, Britt Elmedal","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren","key":"besenbacherpau","last":"Besenbacher","locid":"ce64758a-054a-40ca-897b-543899af8c0f","name":"Besenbacher, Søren","rank":4,"rolecode":"pau"}],"pmid":["31516310"],"pub":{"doi":"10.1177/1176935119872163","issn":["11769351"],"journal":"Cancer Informatics","status":"p","title":"Cancer Informatics","volume":"18"},"review":"Peer Reviewed","scoID":["2-s2.0-85071904499"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-d63e6e23-6ebf-47c6-b555-bf13d1f8957b"],"src":["AU Aarhus University"],"title":"Hierarchical classification of cancers of unknown primary using multi-omics data","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-251693","year":"2019","yearsub":"2019"}
{"abstract":"Artiklen undersøger om virtual reality kan stilladsere og udvikle flersprogede elevers sproglige kompetencer med udgangspunkt i erfaringerne fra et projekt i en modtageklasse. Artiklen peger på, at lærerens viden om sprogbaseret undervisning og stilladsering af elevernes sproglige udvikling er afgørende. Lærerens kompetencer i at synliggøre sproglige mønstre og italesætte sproglige valg for eleverne i forskellige tekstsituationer er utrolig vigtig for elevernes mulighed for at udvikle deres viden om sprog og færdigheder i at bruge det i forskellige kontekster. Men lærerens viden om og tilgang til forskellige teknologiers didaktiske potentiale er lige så afgørende for elevernes muligheder for at udvikle sprog og bruge det aktivt i forskellige kommunikative situationer, når teknologier inddrages i undervisningen.","author_count":2,"contributors":["Bech, Mette","Knudsen, Søren Bøgh"],"cuid":["S01-000.00-553560"],"filters":{"added":"2023-07","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Skoler fag og institutioner","sproglig udvikling"],"level":"sci","oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-UC"],"level3":{"UC":["DI-UC-AB","DI-UC-ALL"]},"level3all":["DI-UC-AB"]},"review":"pr","rtype":["clu"],"sorti":"virtual reality som katalysator for sproglig udvikling","src":["pha"],"src-code":["DI-UC-AB"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-553560","ids":["pha-32611d3b-db7c-41fb-898f-25f98c14bcb8"],"keyword":["Skoler, fag og institutioner","sproglig udvikling","virtual reakity"],"lang":"Danish","level":"Scientific","noi":["Global-Local-2-2-05880DC9B3FC9924C930DF3A24D95898"],"org":[{"affno":"1","key":"university college absalon","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-AB","l3nl":"University College Absalon","l3nn":"University College Absalon","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"University College Absalon","namevar":["Professionshøjskolen Absalon, Direktionen - Slagelse, Pædagogik og Ledelsesområdet, Center for Skole og Læring - Vordingborg"],"nora_code":"DI-UC-AB","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Mette","key":"bechpau","last":"Bech","locid":"7a005f66-c1b7-43ff-ba2d-2dbb58121165","name":"Bech, Mette","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren Bøgh","key":"knudsenpau","last":"Knudsen","locid":"9db853d4-3f32-4055-9ca5-065fa96c5ed1","name":"Knudsen, Søren Bøgh","rank":2,"rolecode":"pau"}],"pub":{"issn":["09099328","13998617"],"issn_org":["09099328"],"issue":"68","journal":"Sprogforum","pages":"77-86","publisher":"Aarhus Universitetsforlag","status":"p","title":"Sprogforum"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All University Colleges","DI-ALL","DI-UC","DI-UC-ALL","University College Absalon","University Colleges"],"PST":["Published"]},"sid":["pha-32611d3b-db7c-41fb-898f-25f98c14bcb8"],"src":["AB University College Absalon"],"title":"Virtual reality som katalysator for sproglig udvikling","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-553560","year":"2019","yearsub":"2019"}
{"author_count":12,"contributors":["Nielsen, Jens Steen","Christensen, Diana Hedevang","Knudsen, Søren Tang","Gylfadottir, Sandra Sif","Beck-Neilsen, Henning","Sørensen, Henrik Toft","Andersen, Henning","Callaghan, Brian Christopher","Feldman, Eva","Finnerup, Nanna Brix","Jensen, Troels Staehelin","Thomsen, Reimar W."],"cuid":["S01-000.00-641259"],"event":{"end":"2019-11-22","place":"Barcelona, es","start":"2019-09-16","title":"55th EASD","year":"2019"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR","DI-HO-NDR"],"OT":["Dansk Smerteforskningscenter"],"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-HO-CDR","DI-HO-NDR","DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"obesity and metabolic risk factors associated with non painful and painful diabetic polyneuropathy a nationwide prevalence study of 000000000005 000000000249 patients in the danish dd000000000002 cohort","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://www.easd.org/virtualmeeting/home.html#!resources/obesity-and-metabolic-risk-factors-associated-with-non-painful-and-painful-diabetic-polyneuropathy-a-nationwide-prevalence-study-of-5-249-patients-in-the-danish-dd2-cohort","version":"Authors Final Version"},"id":"S01-000.00-641259","ids":["sdu-ed7d0f31-30f0-4658-aed3-5a8e36f9a481"],"lang":"Danish","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-8CCC0131209CAFCCA55ADBDEDA64302C"],"oa_link":[{"access":"oa","type":"rem","url":"https://www.easd.org/virtualmeeting/home.html#!resources/obesity-and-metabolic-risk-factors-associated-with-non-painful-and-painful-diabetic-polyneuropathy-a-nationwide-prevalence-study-of-5-249-patients-in-the-danish-dd2-cohort","version":"Authors