nmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1},{"affno":"3","country":"dk","key":"danish technological institute","l2":"DI-GTS","l2n":"GTS Institutes","l3":"DI-GTS-DTCI","l3nn":"Danish Technological Institute","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Danish Technological Institute","namevar":["Danish Technological Institute"],"nora_code":"DI-GTS-DTCI","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Fatemeh","key":"hashemipau","last":"Hashemi","locid":"cb730ccb-034e-407a-830b-d1c6081faa30","name":"Hashemi, Fatemeh","orcid":"0000-0002-4756-9339","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lisbeth","key":"mogensenpau","last":"Mogensen","locid":"b408a8b2-3faa-4a28-b707-37f5641e7386","name":"Mogensen, Lisbeth","orcid":"0000-0001-5924-9749","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Aidan Mark","key":"smithpau","last":"Smith","locid":"f58f70c4-55bb-466f-b0d2-2b1994a73174","name":"Smith, Aidan Mark","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Sven","key":"eriklanngpau","last":"Erik Lanng","name":"Erik Lanng, Sven","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Svend","key":"hoffpau","last":"Hoff","name":"Hoff, Svend","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Anders","key":"bachpau","last":"Bach","name":"Bach, Anders","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Søren","key":"ugiltlarsenpau","last":"Ugilt Larsen","name":"Ugilt Larsen, Søren","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Marie Trydeman","key":"knudsenpau","last":"Knudsen","locid":"f409fce7-7fa9-494a-a089-7965887b5bd9","name":"Knudsen, Marie Trydeman","orcid":"0000-0001-7905-0382","rank":8,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"