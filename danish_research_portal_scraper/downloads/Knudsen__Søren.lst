nk":15,"rolecode":"pau"},{"affno":"1 2","first":"Martin B.","key":"jorgensenpau","last":"Jorgensen","locid":"dfc70acd-d15d-44f9-891e-6a7646d1727d","name":"Jørgensen, Martin Balslev","name_org":"Jorgensen, Martin B.","rank":16,"rolecode":"pau"},{"affno":"1 2","first":"Vibe G.","key":"frokjaerpau","last":"Frokjaer","locid":"ab1287b2-e920-4656-b4bc-1b7d3dffd2dc","name":"Frokjaer, Vibe G.","rank":17,"rolecode":"pau"},{"affno":"1 2","first":"Gitte M.","key":"knudsenpau","last":"Knudsen","locid":"f02aee9e-69cf-491a-9765-ff062f734db8","name":"Knudsen, Gitte Moos","name_org":"Knudsen, Gitte M.","orcid":"0000-0003-1508-6866","rank":18,"rolecode":"pau"}],"pmid":["36753296"],"pub":{"doi":"10.1001/jamapsychiatry.2022.4539","issn":["15383636","2168622X"],"issn_org":["2168622X"],"issue":"4","journal":"JAMA Psychiatry","pages":"296-304","status":"p","title":"JAMA Psychiatry","volume":"80"},"review":"Peer Reviewed","scoID":["2-s2.0-85149229599"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Private Research","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Hospitals","Lundbeck Pharma","Private Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-fcc4f9a0-7223-44ce-8882-fa718b40c9a5"],"src":["KU University of Copenhagen"],"title":"Serotonin 4 Receptor Brain Binding in Major Depressive Disorder and Association With Memory Dysfunction","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-544302","year":"2023","yearsub":"2023"}
{"abstract":"BACKGROUND: Nocturnal enuresis (NE) is a common disease with multiple pathogenic mechanisms. This study aimed to compare levels of metabolites and proteins between wet and dry nights in urine samples from children with monosymptomatic NE (MNE). METHODS: Ten boys with MNE and nocturnal polyuria (age: 7.6 ± 1.3 years) collected their total nighttime urine production during a wet and a dry night. Untargeted metabolomics and proteomics were performed on the urine samples by liquid chromatography coupled with high-mass accuracy tandem mass spectrometry (LC-MS/MS). RESULTS: On wet nights, we found reduced urine osmolality (P = 0.025) and increased excretion of urinary potassium and sodium by a factor of, respectively, 2.1 (P = 0.038) and 1.9 (P = 0.19) compared with dry nights. LC-MS identified 59 metabolites and 84 proteins with significantly different levels between wet and dry nights (fold change (FC) < 0.67 or > 1.5, P < 0.05). Some compounds were validated by different methodologies. During wet nights, levels of compounds related to oxidative stress and blood pressure, including adrenalin, were increased. We found reduced levels of aquaporin-2 on wet nights. The FCs in the 59 metabolites were positively correlated to the FCs in the same metabolites identified in urine samples obtained during the evening preceding wet and dry nights. CONCLUSIONS: Oxidative stress, which in the literature has been associated with nocturia and disturbances in sleep, might be increased during wet nights in children with MNE. We further found evidence of increased sympathetic activity. The mechanisms related to having wet nights in children with MNE seem complex, and both free water and solute handling appear to be important. A higher resolution version of the Graphical abstract is available as Supplementary information.","author_count":8,"contributors":["Jørgensen, Cecilie Siggaard","Kamperis, Konstantinos","Knudsen, Jane Hagelskjær","Kjeldsen, Margrethe","Christensen, Jane Hvarregaard","Borch, Luise","Rittig, Søren","Palmfeldt, Johan"],"cuid":["S01-000.00-674767"],"filters":{"added":"2023-07","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Child","Chromatography Liquid","Deamino Arginine Vasopressin","Humans","Male","Metabolome","Metabolomics","Nocturia","Nocturnal enuresis","Oxidative stress","Polyuria","Proteome metabolism","Proteomics","Tandem Mass Spectrometry"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"differences in the urinary metabolome and proteome between wet and dry nights in children with monosymptomatic nocturnal enuresis and nocturnal polyuria","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1007/s00467-023-05963-5","version":"Published Version"},"id":"S01-000.00-674767","identifier":[{"id":"PMC10465629","type":"pmcid"},{"id":"37140712","type":"pmid"},{"id":"85158052411","type":"scopus"}],"ids":["au-3494717a-6e4f-4a69-9896-ee60504d2542"],"keyword":["Child","Chromatography, Liquid","Deamino Arginine Vasopressin","Humans","Male","Metabolome","Metabolomics","Nocturia","Nocturnal enuresis","Oxidative stress","Polyuria","Proteome/metabolism","Proteomics","Tandem Mass Spectrometry"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-E913C6CBE132D937EC7948719A425604"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.au.dk/ws/files/384325528/Differences_In_The_Urinary_Metabolome_And_Proteome_Between_Wet_And_Dry_Nights_In_Children_With_Monosymptomatic_Nocturnal_Enuresis_And_Nocturnal_Polyuria.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1007/s00467-023-05963-5","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Paediatrics"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Cecilie Siggaard","key":"jørgensenpau","last":"Jørgensen","locid":"568e6cf5-94e8-46e7-a38d-821ea33b89bc","name":"Jørgensen, Cecilie Siggaard","orcid":"0000-0003-3630-2329","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Konstantinos","key":"kamperispau","last":"Kamperis","locid":"22788758-9ba6-499e-8ca0-b05f8aa3b2fb","name":"Kamperis, Konstantinos","orcid":"0000-0003-0104-4884","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jane Hagelskjær","key":"knudsenpau","last":"Knudsen","locid":"9c4e4eab-edaa-4f3e-970c-8d69d465c130","name":"Knudsen, Jane Hagelskjær","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Margrethe","key":"kjeldsenpau","last":"Kjeldsen","locid":"9c449e72-8751-4be8-bdbe-e80b779b132e","name":"Kjeldsen, Margrethe","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jane Hvarregaard","key":"christensenpau","last":"Christensen","locid":"08b833cc-a08b-4b53-b737-7611b7394975","name":"Christensen, Jane Hvarregaard","orcid":"0000-0002-0009-2991","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Luise","key":"borchpau","last":"Borch","locid":"597937e0-c71d-483a-8b91-8300e9fc4a5f","name":"Borch, Luise","orcid":"0000-0003-1054-0601","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren","key":"rittigpau","last":"Rittig","locid":"04c8afe2-7baf-4f75-a08b-d2ee25d66d09","name":"Rittig, Søren","orcid":"0000-0001-7038-1652","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Johan","key":"palmfeldtpau","last":"Palmfeldt","locid":"2a5fd2de-dd21-4a09-bdac-24adf04a89b1","name":"Palmfeldt, Johan","rank":8,"rolecode":"pau"}],"pmid":["37140712"],"pub":{"doi":"10.1007/s00467-023-05963-5","issn":["0931041X","1432198X"],"issn_org":["0931041X"],"issue":"10","journal":"Pediatric Nephrology","pages":"3347-3358","publisher":"Springer Science and Business Media Deutschland GmbH","status":"p","title":"Pediatric Nephrology","title_org":"Pediatric nephrology (Berlin, Germany)","volume":"38"},"review":"Peer Reviewed","scoID":["2-s2.0-85158052411"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-3494717a-6e4f-4a69-9896-ee60504d2542"],"src":["AU Aarhus University"],"title":"Differences in the urinary metabolome and proteome between wet and dry nights in children with monosymptomatic nocturnal enuresis and nocturnal polyuria","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-674767","year":"2023","yearsub":"2023"}
{"abstract":"Fully Autonomous vehicles (AV) are estimated to reach consumers widely in the near future. The manufacturers will have to be completely sure that AVs can outperform human drivers, which first of all requires a solid model of the world surrounding the car. Emerging trends for perception models in the automobile industry seems to be towards combining the data from LiDAR and camera in Multi-Sensor Fusion (MSF). Making the perception model reliable in the event of unforeseen real world circumstances is tricky enough, but the real challenge comes from the security issue that arises when ill-intentioned people try to attack sensors. In this article, we take a deep dive into the possible attacks and countermeasures for LiDAR and camera. We discuss it in the context of MSF, and provide a simple framework for further analysis, which we conclude will be needed in order to conceptualize a truly safe AV.","author_count":3,"contributors":["Jakobsen, Søren Bønning","Knudsen, Kenneth Sylvest","Andersen, Birger"],"cuid":["S01-000.00-677026"],"event":{"end":"2023-04-23","place":"Prague, cz","start":"2023-04-21","title":"8th International Conference on Internet of Things, Big Data and Security","year":"2023"},"filters":{"added":"2023-08","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Attacks","Autonomous vehicles","Camera","Countermeasures","LiDAR","Multi sensor fusion","Security","Sensors"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"analysis of sensor attacks against autonomous vehicles","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/283489801/Analysis_of_Sensor_Attacks_against_Autonomous_Vehicles.pdf","version":"Authors Final Version"},"id":"S01-000.00-677026","identifier":[{"id":"85160709886","type":"scopus"}],"ids":["dtu-b0d31553-3926-4588-a84f-c681223370cc"],"keyword":["Attacks","Autonomous vehicles","Camera","Countermeasures","LiDAR","Multi-sensor fusion","Security","Sensors"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-99B9D0FD4BC919801674FEFE86A09CED"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/283489801/Analysis_of_Sensor_Attacks_against_Autonomous_Vehicles.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Engineering Technology and Didactics"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Søren Bønning","key":"jakobsenpau","last":"Jakobsen","locid":"29b8ec47-a881-4d1f-8e0c-38d9597e781b","name":"Jakobsen, Søren Bønning","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kenneth Sylvest","key":"knudsenpau","last":"Knudsen","locid":"396d275e-fb83-4821-b57a-0750ffec6c05","name":"Knudsen, Kenneth Sylvest","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Birger","key":"andersenpau","last":"Andersen","locid":"43ee688c-2b46-4199-8ddf-5124abd9c702","name":"Andersen, Birger","orcid":"0000-0003-1402-0355","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.5220/0011841800003482","eisbn":["9789897586439"],"pages":"131-139","publisher":"SCITEPRESS Digital Library","status":"p","title":"Proceedings of the 8th International Conference on Internet of Things, Big Data and Security - IoTBDS","volume":"1"},"review":"Peer Reviewed","scoID":["2-s2.0-85160709886"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-b0d31553-3926-4588-a84f-c681223370cc"],"src":["DTU Technical University of Denmark"],"title":"Analysis of Sensor Attacks against Autonomous Vehicles","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-677026","year":"2023","yearsub":"2023"}
