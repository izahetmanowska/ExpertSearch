-4a73-8391-8aeab856ec6a","name":"Rotbart, Noy Galil","orcid":"0000-0003-1882-0755","rank":3,"rolecode":"pau"},{"affno":"","first":"Hee-Kap","key":"ahnpedh","last":"Ahn","name":"Ahn, Hee-Kap","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Chan-Su","key":"shinpedh","last":"Shin","name":"Shin, Chan-Su","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-319-13075-0_12","eisbn":["9783319130750"],"isbn":["9783319130743"],"issn":["03029743"],"pages":"141-153","publisher":"Springer","series":"Lecture notes in computer science","status":"p","subtitle":"25th International Symposium, ISAAC 2014, Jeonju, Korea, December 15-17, 2014, Proceedings","title":"Algorithms and Computation"},"review":"Peer Reviewed","scoID":["2-s2.0-84921633939"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-619ab8d1-e4d2-45ab-beb1-6b783cc32e44"],"src":["KU University of Copenhagen"],"title":"Dynamic and multi-functional labeling schemes","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-451842","year":"2014","yearsub":"2014"}
{"abstract":"Aims: To investigate the presence of surfactant protein (SP) A, B, C and D in nasal airways and to determine whether the proteins exert their main functions in nasal secretions or in the deeper layers of the nasal mucosa. Methods: Volunteers were recruited from the Department of ENT Head and Neck Surgery, Odense University Hospital, Denmark. The study included 39 subjects. Nasal mucosal biopsies were analyzed by immunohistochemistry, and bronchoalveolar and nasal lavages, nasal brush biopsies and nasal mucus were analyzed for SP-A, -B, -C and -D by SDS-PAGE and Western blotting. The presence of SP-A and SP-D in the first three samplings were also analyzed by enzyme-linked immunosorbent assay. Results: In nasal mucosal biopsies, SP-A, -B, -C and -D were all demonstrated in the serous acini of the submucosal glands and in the surface epithelium. SP-D was detected in nasal brush biopsies, whereas the other SPs were absent. Moreover, SP-A, -B, -C and -D were absent in nasal lavage and mucus. Conclusion: SP-A, -B, -C and -D exert their protective effect in the ductal epithelium of the submucosal glands rather than in nasal secretions and mucus. Further studies are required to clarify the functions of these proteins in nasal secretory pathways for understanding upper airway diseases. © 2014 S. Karger AG, Basel.","author_count":5,"contributors":["Gaunsbaek, Maria Quisgaard","Kjeldsen, Anette Drøhse","Svane-Knudsen, Viggo","Henriksen, Maiken Lumby","Hansen, Søren"],"cuid":["S01-000.00-629551"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Biopsy","Blotting Western","Bronchoalveolar Lavage","Enzyme Linked Immunosorbent Assay","Humans","Immunoenzyme Techniques","Mucus chemistry","Nasal Mucosa metabolism","Nasal lavage","Pulmonary Surfactant Associated Protein D metabolism","Surfactant protein A","Surfactant protein D","Therapeutic Irrigation"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"surfactant proteins a b c and d in the human nasal airway associated with mucosal glands and ciliated epithelium but absent in fluid phase secretions and mucus","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1159/000369143","version":"Other Version"},"id":"S01-000.00-629551","identifier":[{"id":"84917706951","type":"scopus"},{"id":"25500788","type":"pmid"}],"ids":["sdu-c4a6a192-9030-4e2e-87a0-e7471d743164"],"keyword":["Biopsy","Blotting, Western","Bronchoalveolar Lavage","Enzyme-Linked Immunosorbent Assay","Humans","Immunoenzyme Techniques","Mucus/chemistry","Nasal Mucosa/metabolism","Nasal lavage","Pulmonary Surfactant-Associated Protein A/metabolism","Pulmonary Surfactant-Associated Protein B/metabolism","Pulmonary Surfactant-Associated Protein C/metabolism","Pulmonary Surfactant-Associated Protein D/metabolism","Sinonasal mucosa","Surfactant protein A","Surfactant protein B","Surfactant protein C","Surfactant protein D","Therapeutic Irrigation"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-EBFF0A574B4A334070D769BCFF6D681D"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1159/000369143","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Oto Rhino Laryngology (Odense)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Maria Q","key":"gaunsbaekpau","last":"Gaunsbaek","locid":"216f0914-83d4-49a6-8d4d-1d83cd8a6e1a","name":"Gaunsbaek, Maria Quisgaard","name_org":"Gaunsbaek, Maria Q","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anette D","key":"kjeldsenpau","last":"Kjeldsen","locid":"fdb5ea24-9f31-48f2-b6c8-89a3ccd1fd26","name":"Kjeldsen, Anette Drøhse","name_org":"Kjeldsen, Anette D","orcid":"0000-0003-0593-6302","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Viggo","key":"svaneknudsenpau","last":"Svane-Knudsen","locid":"7e7a18e2-ad13-4bd7-bf79-642a44ba6c10","name":"Svane-Knudsen, Viggo","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Maiken L","key":"henriksenpau","last":"Henriksen","locid":"4ce57204-12cd-403d-9bf0-37bb0663459f","name":"Henriksen, Maiken Lumby","name_org":"Henriksen, Maiken L","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Soren","key":"hansenpau","last":"Hansen","locid":"3c3adf6c-a89b-4b81-b64a-db4a1562ea1a","name":"Hansen, Søren","name_org":"Hansen, Soren","orcid":"0000-0002-8186-4630","rank":5,"rolecode":"pau"}],"pmid":["25500788"],"pub":{"doi":"10.1159/000369143","issn":["03011569","14230275"],"issn_org":["03011569"],"issue":"5","journal":"Journal for Oto-Rhino-Laryngology, Head and Neck Surgery","pages":"288-301","publisher":"S. Karger AG","status":"p","title":"Journal for Oto-Rhino-Laryngology, Head and Neck Surgery","title_org":"O R L","volume":"76"},"review":"Peer Reviewed","scoID":["2-s2.0-84917706951"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-c4a6a192-9030-4e2e-87a0-e7471d743164"],"src":["SDU University of Southern Denmark"],"title":"Surfactant Proteins A, B, C and D in the Human Nasal Airway : Associated with Mucosal Glands and Ciliated Epithelium but Absent in Fluid-Phase Secretions and Mucus","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-629551","year":"2014","yearsub":"2014"}
{"abstract":"BACKGROUND/OBJECTIVES: Several studies emphasise that arabinoxylan and β-glucan have more beneficial effects on glucose metabolism than low-dietary fibre (DF) meals. Less attention has been paid to the effects of concentrated DF compared with whole grain. We compared the effects of DF and whole grain on glucose, hormone responses and appetite in subjects with the metabolic syndrome (MetS). SUBJECTS/METHODS: Fifteen subjects with MetS participated in this acute, randomised, cross-over intervention study. The test breads provided 50 g of digestible carbohydrate: wheat bread with concentrated arabinoxylan (AX) or β-glucan (BG), rye bread with kernels (RK) and wheat bread (WB) as control. Blood samples were drawn for 270 min to determine glucose, insulin, glucagon-like peptide-1, glucose-dependent insulinotropic peptide (GIP) and ghrelin. Appetite score was addressed every 30 min. Ad libitum energy intake (EI) was measured 270 min after test meals. RESULTS: Compared with WB, BG and RK induced lower initial glycaemic responses (P<0.001), whereas AX only reduced the glucose peak value (P<0.001). RK reduced insulin (P<0.001) and GIP responses (P<0.001) compared with the other breads. BG lowered insulin responses more than AX (P<0.001). AX, BG and RK increased satiety feeling (P<0.001) more than WB, but did not differ significantly in terms of subsequent EI (P=0.089). CONCLUSION: BG and RK had beneficial impact on the glucose response, whereas AX had only effect on the postprandial glucose peak. The impact of the AX bread was influenced by higher protein content. Whether the metabolic effects of the breads are still present to mixed meals remains to be tested.","author_count":6,"contributors":["Hartvigsen, M L","Gregersen, Søren","Lærke, Helle Nygaard","Holst, J J","Knudsen, Knud Erik Bach","Hermansen, Kjeld"],"cuid":["S02-092.28-029748"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-HO-CDR","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"effects of concentrated arabinoxylan and β glucan compared with refined wheat and whole grain rye on glucose and appetite in subjects with the metabolic syndrome a randomized study","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1038/ejcn.2013.236","version":"Other Version"},"id":"S02-092.28-029748","identifier":[{"id":"24253758","type":"pmid"},{"id":"84891862369","type":"scopus"}],"ids":["au-eb9240ea-d0ed-414c-8722-294f92c957ba","ku-e69e6c8b-a1c9-4bcf-91ec-74c07ebdb905"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-825251560FB19DCD679C8659D2E40E4C"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1038/ejcn.2013.236","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Department of Endocrinology and Metabolism C"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Novo Nordisk Foundation Center for Basic Metabolic Research, NNF Center for Basic Metabolic Research"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"M L","key":"hartvigsenpau","last":"Hartvigsen","locid":"690fa83a-6d42-48ce-82f7-65558069a2f0","name":"Hartvigsen, M L","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"S","key":"gregersenpau","last":"Gregersen","locid":"59b0d84c-a135-49bf-afba-7783f90976c2","name":"Gregersen, Søren","name_org":"Gregersen, S","orcid":"0000-0002-1953-8631","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"H N","key":"lærkepau","last":"Lærke","locid":"408fb476-f1b2-4eb6-8436-edc3cc039743","name":"Lærke, Helle Nygaard","name_org":"Lærke, H N","orcid":"0000-0002-0303-0745","rank":3,"rolecode":"pau"},{"affno":"3","first":"Jens Juul","key":"holstpau","last":"Holst","locid":"864b6401-9024-4773-9bdb-f4d4ca57dcad","name":"Holst, Jens Juul","orcid":"0000-0001-6853-3805","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Knud Erik Bach","key":"knudsenpau","last":"Knudsen","locid":"3918454e-241b-4712-ab7f-aa9d26a508f7","name":"Knudsen, Knud Erik Bach","rank":5,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"K","key":"hermansenpau","last":"Hermansen","locid":"a62f80e1-f33f-47bd-a5e5-87d59477619f","name":"Hermansen, Kjeld","name_org":"Hermansen, K","rank":6,"rolecode":"pau"}],"pmid":["24253758"],"pub":{"doi":"10.1038/ejcn.2013.236","issn":["09543007","14765640"],"issn_org":["09543007"],"issue":"1","journal":"European Journal of Clinical Nutrition","pages":"84-90","publisher":"Springer Nature","status":"p","title":"European Journal of Clinical Nutrition","volume":"68"},"review":"Peer Reviewed","scoID":["2-s2.0-84891862369"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-eb9240ea-d0ed-414c-8722-294f92c957ba","ku-e69e6c8b-a1c9-4bcf-91ec-74c07ebdb905"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Effects of concentrated arabinoxylan and β-glucan compared with refined wheat and whole grain rye on glucose and appetite in subjects with the metabolic syndrome : a randomized study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-092.28-029748","year":"2014","yearsub":"2014"}
{"abstract":"As fuel cells are increasingly commercialized for various applications, harmonized and industry-relevant test procedures are necessary to benchmark tests and to ensure comparability of stack performance results from different parties. This paper reports the results of parametric sensitivity tests performed based on test procedures proposed by a European project, Stack-Test. The sensitivity of a Nafion-based low temperature PEMFC stack’s performance to parametric changes was the main objective of the tests. Four crucial parameters for fuel cell operation were chosen; relative humidity, temperature, pressure, and stoichiometry at varying current density. Furthermore, procedures for polarization curve recording were also tested both in ascending and descending current directions.","author_count":3,"contributors":["Araya, Samuel Simon","Andreasen, Søren Juhl","Kær, Søren Knudsen"],"cuid":["S01-000.00-090908"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"parametric sensitivity tests european polymer electrolyte membrane fuel cell stack test procedures","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://fuelcellscience.asmedigitalcollection.asme.org/article.aspx?articleid=1921627#Introduction","version":"Other Version"},"id":"S01-000.00-090908","identifier":[{"id":"WOS:000345462800007","type":"wos"},{"id":"84994012346","type":"scopus"}],"ids":["aau-8ca52fb8-a173-4d05-8198-a12548d629b3"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-5010255C2F36235D48DF087876738651"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (ENG)","Aalborg University, The Faculty of Engineering and Science, AAU Energy","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Fluid Mechanics and Combustion","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Hydrogen and Electro-fuels"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Samuel Simon","key":"arayapau","last":"Araya","locid":"31cc4ce7-c9ae-4406-95d1-b95d4269205f","name":"Araya, Samuel Simon","orcid":"0000-0001-9294-0793","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren Juhl","key":"andreasenpau","last":"Andreasen","locid":"02115d16-a485-4ac6-b914-7460ef6c4e83","name":"Andreasen, Søren Juhl","orcid":"0000-0002-0767-5874","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren Knudsen","key":"kærpau","last":"Kær","locid":"898d6584-ec2e-430a-b78d-e3e0d670dcdd","name":"Kær, Søren Knudsen","orcid":"0000-0003-2151-8055","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1115/1.4028949","issn":["1550624X","15516989"],"issn_org":["1550624X"],"issue":"6","journal":"Journal of Fuel Cell Science and Technology","paperid":"FC-14-1067","publisher":"The American Society of Mechanical Engineers (ASME)","status":"p","title":"Journal of Fuel Cell Science and Technology","volume":"11"},"review":"Peer Reviewed","scoID":["2-s2.0-84994012346"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-8ca52fb8-a173-4d05-8198-a12548d629b3"],"src":["AAU Aalborg University"],"title":"Parametric Sensitivity Tests—European Polymer Electrolyte Membrane Fuel Cell Stack Test Procedures","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-090908","year":"2014","yearsub":"2014"}
{"abstract":"Reaching for higher wind resources floating wind turbines are being investigated. Wave induced loads significantly increase for floating wind turbines, and applying conventional onshore control strategies to floating wind turbines has been shown to impose negative damped oscillations in fore-aft due to the low natural frequency of the floating structure. We suggest a control loop extension of the onshore controller which stabilizes the system and reduces the wave disturbance. The result is improved performance in power fluctuations, blade pitch activity, and platform oscillations","author_count":3,"contributors":["Christiansen, Søren","Knudsen, Torben","Bak, Thomas"],"cuid":["S01-000.00-097543"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"extended onshore control of a floating wind turbine with wave disturbance reduction","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1088/1742-6596/555/1/012018","version":"Published Version"},"id":"S01-000.00-097543","identifier":[{"id":"84919499180","type":"scopus"},{"id":"WOS:000347871200018","type":"wos"}],"ids":["aau-a3d6b847-32a4-4693-b370-033aeb0175e6"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-4A6F56AA54389BA7F4F02CF41352FF47"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1088/1742-6596/555/1/012018","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (TECH)","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems, Automation & Control"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"S.","key":"christiansenpau","last":"Christiansen","locid":"31e1968a-95d9-469a-bc94-0ce41a58b13b","name":"Christiansen, Søren","name_org":"Christiansen, S.","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"T.","key":"knudsenpau","last":"Knudsen","locid":"2320ea13-8eb2-4116-9386-b562514277b8","name":"Knudsen, Torben","name_org":"Knudsen, T.","orcid":"0000-0002-5478-8513","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Thomas","key":"bakpau","last":"Bak","locid":"474a52b5-2182-461f-8b5c-4ef451576fe4","name":"Bak, Thomas","orcid":"0000-0002-8282-5932","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1088/1742-6596/555/1/012018","issn":["17426596"],"issn_org":["17426588"],"issue":"1","journal":"Journal of Physics: Conference Series","pages":"1-10","paperid":"012018","publisher":"IOP Publishing","status":"p","title":"Journal of Physics: Conference Series","title_org":"Journal of Physics: Conference Series (Online)","volume":"555"},"review":"Peer Reviewed","scoID":["2-s2.0-84919499180"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-a3d6b847-32a4-4693-b370-033aeb0175e6"],"src":["AAU Aalborg University"],"title":"Extended onshore control of a floating wind turbine with wave disturbance reduction","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-097543","year":"2014","yearsub":"2014"}
{"abstract":"Degradation tests of two phosphoric acid (PA) doped PBI membrane based HT-PEM fuel cells were reported in this paper to investigate the effects of start/stop and the presence of methanol in the fuel to the performance degradation. Continuous tests with H2 and simulated reformate which was composed of H2, water steam and methanol as the fuel were performed on both single cells. 12-h-startup/12-h-shutdown dynamic tests were performed on the first single cell with pure dry H2 as the fuel and on the second single cell with simulated reformate as the fuel. Along with the tests electrochemical techniques such as polarization curves and electrochemical impedance spectroscopy (EIS) were employed to study the degradation mechanisms of the fuel cells. Both single cells showed an increase in the performance in the H2 continuous tests, because of a decrease in the ORR kinetic resistance probably due to the redistribution of PA between the membrane and electrodes. EIS measurement of first fuel cell during the start/stop test showed that the mass transfer resistance and ohmic resistance increased which can be attributed to the corrosion of carbon support in the catalyst layer and degradation of the PBI membrane. During the continuous test with simulated reformate as the fuel the ORR kinetic resistance and mass transfer resistance of both single cells increased. The performance of the second single cell experienced a slight decrease during the start/stop test with simulated reformate as the fuel.","author_count":5,"contributors":["Zhou, Fan","Araya, Samuel Simon","Grigoras, Ionela","Andreasen, Søren Juhl","Kær, Søren Knudsen"],"cuid":["S01-000.00-097757"],"event":{"end":"2014-07-02","place":"Boston, Massachusetts, us","start":"2014-06-29","title":"ASME 2014 8th International Conference on Energy Sustainability &amp; 12th Fuel Cell Science, Engineering and Technology Conference","year":"2014"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"performance degradation tests of phosphoric acid doped pbi membrane based high temperature pem fuel cells","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1115/FuelCell2014-6358","version":"Other Version"},"id":"S01-000.00-097757","identifier":[{"id":"84912098512","type":"scopus"}],"ids":["aau-a481c5d7-1517-4fb0-9d92-0d8cecfa0e0b"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-8090807FF2EF1B5E55A36D9D0A61B74A"],"oa_link":[{"access":"oa","type":"rem","url":"http://proceedings.asmedigitalcollection.asme.org/proceeding.aspx?articleid=1920871","version":"Other Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1115/FuelCell2014-6358","version":"Other Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (ENG)","Aalborg University, The Faculty of Engineering and Science, AAU Energy","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Fluid Mechanics and Combustion","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Hydrogen and Electro-fuels"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Fan","key":"zhoupau","last":"Zhou","locid":"874642c9-fe83-4b87-9b5e-9b8088c39e6a","name":"Zhou, Fan","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Samuel Simon","key":"arayapau","last":"Araya","locid":"31cc4ce7-c9ae-4406-95d1-b95d4269205f","name":"Araya, Samuel Simon","orcid":"0000-0001-9294-0793","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ionela","key":"grigoraspau","last":"Grigoras","locid":"1eeff737-15ec-4ee3-a58d-e273ca970287","name":"Grigoras, Ionela","orcid":"0000-0002-1846-6568","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren Juhl","key":"andreasenpau","last":"Andreasen","locid":"02115d16-a485-4ac6-b914-7460ef6c4e83","name":"Andreasen, Søren Juhl","orcid":"0000-0002-0767-5874","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren Knudsen","key":"kærpau","last":"Kær","locid":"898d6584-ec2e-430a-b78d-e3e0d670dcdd","name":"Kær, Søren Knudsen","orcid":"0000-0003-2151-8055","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1115/fuelcell2014-6358","eisbn":["9780791845882"],"place":"Boston, USA","publisher":"The American Society of Mechanical Engineers (ASME)","status":"p","subtitle":"ES/FuelCell 2014","title":"Proceedings of the ASME 2014 8th International Conference on Energy Sustainability &amp; ASME 2014 12th Fuel Cell Science, Engineering and Technology Conference"},"review":"Peer Reviewed","scoID":["2-s2.0-84912098512"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-a481c5d7-1517-4fb0-9d92-0d8cecfa0e0b"],"src":["AAU Aalborg University"],"title":"Performance Degradation Tests of Phosphoric Acid Doped PBI Membrane Based High Temperature PEM Fuel Cells","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-097757","year":"2014","yearsub":"2014"}
{"abstract":"One of the common phenomenona for most of the battery cell chemistries is hysteresis. Since an open circuit voltage (OCV) path is not identical for the charge and discharge of the battery cell at different states of charge (SoC) level, the battery cells show the hysteresis effect. Usually, the OCV i.e. voltage with zero current after previous charge is higher than the OCV after discharge at the same SoC level. It embodies the hysteresis of the battery cell. The OCV is principally subjected to previous operating condition and cannot be taken as self-regulating from the operating history. Therefore, an accurate knowledge of the hysteresis of OCV is vital for various applications and battery models. This is because currently Battery Management Systems (BMS) use the well-defined OCV-SoC representative curve for SoC estimation and power prediction. Particularly lithium-ion batteries with iron-phosphate cathode material show a complex OCV behaviour including a hysteresis that is dependent on the previous operation i.e. the previous state-- charging or discharging. Different cell chemistries exhibit diverse level of the drawbacks because of hysteresis. Those are more prone to catastrophes due to failures to estimate the correct SoC or energy content of the battery consequently limiting operation life of the battery pack. Therefore, novel and more cutting-edge hysteresis management strategies are required to be able to prevent securely the energy storage system from ever facing these critical circumstances. In case of the exchanging between the charging and discharging curves (due to exposure of charge and discharge pulse) makes the SoC estimation problematic since switching from the OCV leads to sudden changes in the output of SoC that physically is not rational for a battery cell. In this chapter, the characteristics of OCV in function of relaxation times (up to 24 hours) for different Li-ion chemistries, temperatures and C-rates (Charge discharge rates) are presented. Moreover, a novel hysteresis compensation structure is introduced based on Kalman filter and statistical error function. These combinations are able to meet the high requirements of estimating accurate SoC using open circuit voltage. In addition, the issues of safety and reliability are going to be increased for the integration of the newly established compensation scheme for the hysteresis phenomenon. A hysteresis compensation framework is deliberated in the sections of this chapter.","author_count":6,"contributors":["Khan, Mohammad Rezwan","Barreras, Jorge Varela","Stroe, Ana-Irina","Swierczynski, Maciej Jozef","Andreasen, Søren Juhl","Kær, Søren Knudsen"],"cuid":["S01-000.00-100079"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Battery management system","Hysteresis","Lithium ion battery","Open circuit voltage","State of charge"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"behavior patterns origin of problems and solutions regarding hysteresis phenomena in complex battery systems","src":["aau"],"src-code":["DI-U-AAU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/206421235/Chap_Book_MRK_2014.pdf","version":"Pre-print"},"id":"S01-000.00-100079","identifier":[{"id":"84952902153","type":"scopus"}],"ids":["aau-ac5f8d86-63da-4fd8-bc6a-9fef0128c8d4"],"keyword":["Battery management system","Hysteresis","Lithium Ion battery","Open circuit voltage","State of charge"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-820870681D4454990A5004C9F6570105"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/206421235/Chap_Book_MRK_2014.pdf","version":"Pre-print"},{"access":"oa","type":"rem","url":"https://www.novapublishers.com/catalog/product_info.php?products_id=50388&osCsid=c51451701b2d73ab5dd766a1975a6025","version":"Other Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (ENG)","Aalborg University, The Faculty of Engineering and Science, AAU Energy","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Fluid Mechanics and Combustion"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Mohammad Rezwan","key":"khanpau","last":"Khan","locid":"93d828d4-c1bf-44a2-bf94-b1fd3dcc29cf","name":"Khan, Mohammad Rezwan","orcid":"0000-0002-1532-0598","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jorge Varela","key":"barreraspau","last":"Barreras","locid":"ecf5efeb-a5d5-4080-be87-0287eaaeb8b8","name":"Barreras, Jorge Varela","orcid":"0000-0003-2791-1368","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ana-Irina","key":"stanpau","last":"Stan","locid":"e6ff6bac-362f-4fd1-b46c-d5f62d1e2c1a","name":"Stroe, Ana-Irina","name_org":"Stan, Ana-Irina","orcid":"0000-0002-6205-8254","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Maciej Jozef","key":"swierczynskipau","last":"Swierczynski","locid":"767958b2-8061-4038-82d6-7a0068c26efe","name":"Swierczynski, Maciej Jozef","orcid":"0000-0003-3837-9696","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren Juhl","key":"andreasenpau","last":"Andreasen","locid":"02115d16-a485-4ac6-b914-7460ef6c4e83","name":"Andreasen, Søren Juhl","orcid":"0000-0002-0767-5874","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren Knudsen","key":"kærpau","last":"Kær","locid":"898d6584-ec2e-430a-b78d-e3e0d670dcdd","name":"Kær, Søren Knudsen","orcid":"0000-0003-2151-8055","rank":6,"rolecode":"pau"}],"pub":{"eisbn":["9781633213364"],"isbn":["9781633213364"],"pages":"215-226","publisher":"Nova Science Publishers","status":"p","title":"Hysteresis: Types, Applications and Behavior Patterns in Complex Systems"},"review":"Peer Reviewed","scoID":["2-s2.0-84952902153"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-ac5f8d86-63da-4fd8-bc6a-9fef0128c8d4"],"src":["AAU Aalborg University"],"title":"Behavior Patterns, Origin of Problems and Solutions Regarding Hysteresis Phenomena in Complex Battery Systems","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-100079","year":"2014","yearsub":"2014"}
