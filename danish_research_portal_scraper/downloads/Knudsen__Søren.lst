olecode":"pau"},{"affno":"1","corresponding":null,"first":"Martin Grønbech","key":"jørgensenpau","last":"Jørgensen","locid":"c9214484-1539-4357-a2ed-9a9ec30b6dca","name":"Jørgensen, Martin Grønbech","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jens Lykkegaard","key":"olesenpau","last":"Olesen","locid":"d2601d22-08b4-4950-b3df-24634065a89d","name":"Olesen, Jens Lykkegaard","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sten","key":"rasmussenpau","last":"Rasmussen","locid":"5d5b4320-b956-4cab-b611-40314843825b","name":"Rasmussen, Sten","rank":6,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-b92618dc-d605-4135-a53f-83000688fa15"],"src":["AU Aarhus University"],"title":"Pulsed electromagnetic field therapy may reduce quadriceps muscle soreness in maraton runners – a randomized controlled pilot study","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-234998","year":"2011","yearsub":"2011"}
{"abstract":"High-resolution scanning tunneling microscope (STM) images of moiré-structured FeO films on Pt(111) were obtained in a number of different tip-dependent imaging modes. For the first time, the STM images are distinguished and interpreted unambiguously with the help of distinct oxygen-vacancy dislocation loops in the FeO moiré structure. The experimental STM results are compared with the results of electronic structure calculations within the DFT+U scheme for a realistic (sqrt(91)xsqrt(91)R5.2 moiré unit cell supported on Pt(111) as well as with the results from previous studies. We find that one type of STM imaging mode, showing both Fe and O atoms, agrees well with simulated STM images, indicating that the simple Tersoff-Hamann theory is partially valid for this imaging mode. In addition, we identify other distinct, element-specific imaging modes which reveal a strong dependence on the specific tip apex state and likely result from specific tip-sample chemical interactions. From the present STM results we show that several of the previously published conclusions for the FeO system have to be revisited.","author_count":10,"contributors":["Merte, Lindsay Richard","Grabow, Lars C.","Peng, Guowen","Knudsen, Jan","Zeuthen, Helene","Kudernatsch, Wilhelmine","Porsgaard, Søren","Lægsgaard, Erik","Mavrikakis, Manos","Besenbacher, Flemming"],"cuid":["S01-000.00-252056"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","University of Houston","University of Wisconsin-Madison"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"tip dependent scanning tunneling microscopy imaging of ultrathin feo films on pt 000000000111","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/79952659310","version":"Other Version"},"id":"S01-000.00-252056","identifier":[{"id":"79952659310","type":"scopus"}],"ids":["au-d6e89a25-11ae-4cbe-8f65-40ec19b11d59"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-0BA587726F30E4AB4353DA7061A27343"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus University, Faculty of Science, iNano-School"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"us","key":"university of houston","loc":["United States","America, North","OECD"],"name":"University of Houston","used":1},{"affno":"3","country":"us","key":"university of wisconsin madison","loc":["United States","America, North","OECD"],"name":"University of Wisconsin-Madison","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Lindsay Richard","key":"mertepau","last":"Merte","locid":"e64f8b59-427e-459b-abdf-a3d992131a78","name":"Merte, Lindsay Richard","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lars C.","key":"grabowpau","last":"Grabow","name":"Grabow, Lars C.","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Guowen","key":"pengpau","last":"Peng","name":"Peng, Guowen","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jan","key":"knudsenpau","last":"Knudsen","locid":"b2acb2da-6ed5-489a-a4f0-0b8ead5c1159","name":"Knudsen, Jan","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Helene","key":"zeuthenpau","last":"Zeuthen","locid":"0e005a9c-9bb9-49a5-aa35-b9433897e947","name":"Zeuthen, Helene","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Wilhelmine","key":"kudernatschpau","last":"Kudernatsch","locid":"922aa182-4e65-4e20-9dfd-a569ad84d0ec","name":"Kudernatsch, Wilhelmine","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren","key":"porsgaardpau","last":"Porsgaard","locid":"dbd22f50-75ad-43c3-897b-abc7727d473b","name":"Porsgaard, Søren","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Erik","key":"lægsgaardpau","last":"Lægsgaard","locid":"8c682c03-9f69-4594-81b0-bba9275e1ea5","name":"Lægsgaard, Erik","rank":8,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Manos","key":"mavrikakispau","last":"Mavrikakis","name":"Mavrikakis, Manos","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Flemming","key":"besenbacherpau","last":"Besenbacher","locid":"0aa89800-dd75-4f15-a575-c419dda7a69f","name":"Besenbacher, Flemming","rank":10,"rolecode":"pau"}],"pub":{"issn":["19327447","19327455"],"issn_org":["19327447"],"issue":"5","journal":"Journal of Physical Chemistry C","pages":"2089-2099","publisher":"American Chemical Society","status":"p","title":"Journal of Physical Chemistry C","title_org":"Journal of Physical Chemistry Part C: Nanomaterials and Interfaces","volume":"115"},"review":"Peer Reviewed","scoID":["2-s2.0-79952659310"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-d6e89a25-11ae-4cbe-8f65-40ec19b11d59"],"src":["AU Aarhus University"],"title":"Tip-Dependent Scanning Tunneling Microscopy Imaging of Ultrathin FeO Films on Pt(111)","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-252056","year":"2011","yearsub":"2011"}
{"abstract":"At Eurocrypt 2001, Biryukov and Shamir investigated the security of AES-like ciphers where the substitutions and affine transformations are all key-dependent and successfully cryptanalysed two and a half rounds. This paper considers PRESENT-like ciphers in a similar manner. We focus on the settings where the S-boxes are key dependent, and repeated for every round. We break one particular variant which was proposed in 2009 with practical complexity in a chosen plaintext/chosen ciphertext scenario. Extrapolating these results suggests that up to 28 rounds of such ciphers can be broken. Furthermore, we outline how our attack strategy can be applied to an extreme case where the S-boxes are chosen uniformly at random for each round and where the bit permutation is secret as well. © 2011 Springer-Verlag.","author_count":4,"contributors":["Borghoff, Julia","Knudsen, Lars Ramkilde","Leander, Gregor","Thomsen, Søren Steffen"],"cuid":["S01-000.00-356425"],"event":{"end":"2011-02-16","place":"Lyngby, dk","start":"2011-02-14","title":"18th International Workshop on Fast Software Encryption","year":"2011"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Block cipher","Differential cryptanalysis","Present","Symmetric key"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"cryptanalysis of present like ciphers with secret s boxes","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/978-3-642-21702-9_16","version":"Other Version"},"id":"S01-000.00-356425","identifier":[{"id":"79959941294","type":"scopus"}],"ids":["dtu-ad9929f2-e117-43dd-9cdb-90471474df72"],"keyword":["Block cipher","Differential cryptanalysis","PRESENT","Symmetric key"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-2C201F0FB95B28050E77FA6BB60BB3A8"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1007/978-3-642-21702-9_16","version":"Other Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Mathematics","Technical University of Denmark, Department of Mathematics, Discrete mathematics"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Julia","key":"borghoffpau","last":"Borghoff","locid":"772dc1bf-1844-4ebd-b07b-e485af0ab664","name":"Borghoff, Julia","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lars Ramkilde","key":"knudsenpau","last":"Knudsen","locid":"a62b8acd-d07f-4943-a467-85af0eb5efe0","name":"Knudsen, Lars Ramkilde","orcid":"0000-0003-3057-9327","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Gregor","key":"leanderpau","last":"Leander","locid":"58e8e12d-6da0-4170-84d9-6222e33754ce","name":"Leander, Gregor","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren Steffen","key":"thomsenpau","last":"Thomsen","locid":"ed778e42-b61c-47fc-a597-2bfa1eafedb4","name":"Thomsen, Søren Steffen","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1007/978-3-642-21702-9_16","issn":["03029743","16113349"],"issn_org":["03029743"],"journal":"Lecture Notes in Computer Science","pages":"270-289","publisher":"Springer Science and Business Media Deutschland GmbH","status":"p","title":"Lecture Notes in Computer Science","volume":"6733"},"review":"Peer Reviewed","scoID":["2-s2.0-79959941294"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-ad9929f2-e117-43dd-9cdb-90471474df72"],"src":["DTU Technical University of Denmark"],"title":"Cryptanalysis of PRESENT-like ciphers with secret S-boxes","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-356425","year":"2011","yearsub":"2011"}
{"abstract":"In many ETF partner countries new and more student-activating pedagogical methods are required to achieve better student performance. Approaches to develop key competences are high on reform agendas in transition countries, in particular with a focus on how to develop learning-to-learn capacities of students. This Handbook, which builds on experiences and materials from a 2-year school-based teacher development project organised by ETF and the National VET Centre in Montenegro, gives an overview of how this may be done. The purpose of the booklet is to capture and take forward new teaching and learning methodologies and to produce guidelines for organisation of such competence development of teachers. The ambition is to inspire and enable policymakers and practitioners to organise a school-based approach to continuing professional development of teachers in VET schools (and teachers in other upper–secondary education). The philosophy of the Handbook is that teacher competence development becomes both more efficient and much cheaper if closely related to the actual job requirements of teachers, organised at school level and for teams of teachers with strong support from school leadership. As macro-reforms in education often fail, it is based on a principle of ‘the small steps’, which will require active support from external consultancy through for instance national VET Centres or Pedagogical Institutes. The aim of the publication is therefore to set the cornerstones for such school-based initiatives as an integral part of modern teacher education programmes. The publication is an attempt to translate more academic reflections into action by being practice-oriented. However, not in the form of a classical tool kit or how-to-do guidelines which would wrongly give the impression that it is possible to develop guidelines and toolkits that merely have to be properly used to have the expected outcomes. The Handbook is therefore presenting approaches, methods and tools that will enable facilitation of policy learning, but it is not a traditional manual from which the truth can be quoted. In many ETF partner countries new and more student-activating pedagogical methods are required to achieve better student performance. Approaches to develop key competences are high on reform agendas in transition countries, in particular with a focus on how to develop learning-to-learn capacities of students. This Handbook, which builds on experiences and materials from a 2-year school-based teacher development project organised by ETF and the National VET Centre in Montenegro, gives an overview of how this may be done. The purpose of the booklet is to capture and take forward new teaching and learning methodologies and to produce guidelines for organisation of such competence development of teachers. The ambition is to inspire and enable policymakers and practitioners to organise a school-based approach to continuing professional development of teachers in VET schools (and teachers in other upper–secondary education). The philosophy of the Handbook is that teacher competence development becomes both more efficient and much cheaper if closely related to the actual job requirements of teachers, organised at school level and for teams of teachers with strong support from school leadership. As macro-reforms in education often fail, it is based on a principle of ‘the small steps’, which will require active support from external consultancy through for instance national VET Centres or Pedagogical Institutes. The aim of the publication is therefore to set the cornerstones for such school-based initiatives as an integral part of modern teacher education programmes. The publication is an attempt to translate more academic reflections into action by being practice-oriented. However, not in the form of a classical tool kit or how-to-do guidelines which would wrongly give the impression that it is possible to develop guidelines and toolkits that merely have to be properly used to have the expected outcomes. The Handbook is therefore presenting approaches, methods and tools that will enable facilitation of policy learning, but it is not a traditional manual from which the truth can be quoted.","author_count":4,"contributors":["Knudsen, Hans Jørgen","Hadzibegovic-Bubanja, Elvira","Nielsen, Søren P.","Petkova, Jeny"],"cuid":["S01-000.00-390443"],"filters":{"added":"2023-02","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Italy"],"glorg":["All Global Affiliations","European Training Foundation"],"level":"sci","oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-UC"],"level3":{"UC":["DI-UC-ALL","DI-UC-KP"]},"level3all":["DI-UC-KP"]},"review":"nr","rtype":["clu"],"sorti":"school based in service teacher training handbook for policymakers and practitioners","src":["kp"],"src-code":["DI-UC-KP"],"type":"dr","type-grp":["all","pub"]},"id":"S01-000.00-390443","ids":["kp-a5fb67ea-4d11-4c2a-b53c-0435b1892819"],"lang":"English","level":"Scientific","noi":["Local-1-1-923228D122B323CDE2E905A194240463"],"org":[{"affno":"1","key":"kp university college copenhagen","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-KP","l3nl":"KP","l3nn":"KP University College Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KP University College Copenhagen","namevar":["Københavns Professionshøjskole, Nationalt center for Erhvervspædagogik, Nationalt center for Erhvervspædagogik"],"nora_code":"DI-UC-KP","used":1},{"affno":"2","country":"it","key":"european training foundation","loc":["Italy","Europe, EU","OECD"],"name":"European Training Foundation","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Hans Jørgen","key":"knudsenpau","last":"Knudsen","locid":"6116f784-e9c8-41a9-9709-d7d4237784a8","name":"Knudsen, Hans Jørgen","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Elvira","key":"hadzibegovicbubanjapau","last":"Hadzibegovic-Bubanja","name":"Hadzibegovic-Bubanja, Elvira","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Søren P.","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Søren P.","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jeny","key":"petkovapau","last":"Petkova","name":"Petkova, Jeny","rank":4,"rolecode":"pau"}],"pub":{"publisher":"European Training Foundation","status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All University Colleges","DI-ALL","DI-UC","DI-UC-ALL","KP","University Colleges"],"PST":["Published"]},"sid":["kp-a5fb67ea-4d11-4c2a-b53c-0435b1892819"],"src":["KP University College Copenhagen"],"title":"School-based In-service Teacher training : Handbook for Policymakers and Practitioners","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-390443","year":"2011","yearsub":"2012"}
{"author_count":3,"contributors":["Yang, Yang","Kær, Søren Knudsen","Yin, Chungen"],"cuid":["S01-000.00-102250"],"event":{"end":"2011-07-01","place":"Cardiff, gb","start":"2011-06-28","title":"2011 European Combustion Meeting (ECM)","year":"2011"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Large eddy simulation","Swirl burner"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"nr","rtype":["clu"],"sorti":"large eddy simulation of one diffusion swirling flame","src":["aau"],"src-code":["DI-U-AAU"],"type":"dco","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/58640105/yya.pdf","version":"Authors Final Version"},"id":"S01-000.00-102250","ids":["aau-b3cbf2e5-c615-4a7b-b68b-25ead3a0329a"],"keyword":["Large Eddy Simulation","Swirl burner"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-64401608D63FD59ACFB4A1DF1489971C"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/58640105/yya.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (ENG)","Aalborg University, The Faculty of Engineering and Science, AAU Energy","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Fluid Mechanics and Combustion"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Yang","key":"yangpau","last":"Yang","locid":"c4d85e83-0cad-45da-a4d9-7577cd33f0c6","name":"Yang, Yang","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren Knudsen","key":"kærpau","last":"Kær","locid":"898d6584-ec2e-430a-b78d-e3e0d670dcdd","name":"Kær, Søren Knudsen","orcid":"0000-0003-2151-8055","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Chungen","key":"yinpau","last":"Yin","locid":"a24ca845-2626-44cc-b726-b6c5ec9ddd24","name":"Yin, Chungen","orcid":"0000-0002-9885-7744","rank":3,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-b3cbf2e5-c615-4a7b-b68b-25ead3a0329a"],"src":["AAU Aalborg University"],"title":"Large eddy simulation of one diffusion swirling flame","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-102250","year":"2011","yearsub":"2011"}
{"abstract":"A previously published computational multi-phase model of a polymer-electrolyte membrane fuel cell cathode has been extended in order to account for the anode side and the electrolyte membrane. The model has been applied to study the water balance of a fuel cell during operation under various humidification conditions. It was found that the specific surface area of the electrolyte in the catalyst layers close to the membrane is of critical importance for the overall water balance. Applying a high specific electrolyte surface area close to the membrane (a water-uptake layer) can prevent drying out of the anode and flooding at the cathode while the average membrane water content is only weakly affected. The results also indicate that in contrast to common presumption membrane dehydration may occur at either anode or cathode side, entirely depending on the direction of the net water transport because the predominant transport mechanism is diffusion. Consequently, operating conditions with a high net water transport from anode to cathode should be avoided as it is important to keep the cathode catalyst layer well humidified in order to prevent high protonic losses. Addition of the micro-porous layer did not affect the overall water balance or membrane water content in our study.","author_count":3,"contributors":["Berning, Torsten","Odgaard, M.","Kær, Søren Knudsen"],"cuid":["S01-000.00-107721"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["CFD modeling","PEM fuel cells","Water balance","Water uptake layer"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-PR-OTH","DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"water balance simulations of a polymer electrolyte membrane fuel cell using a two fluid model","src":["aau"],"src-code"