5919","rank":10,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Uffe M","key":"døhnpau","last":"Døhn","name":"Døhn, Uffe M","rank":11,"rolecode":"pau"},{"affno":"2 4","first":"Lene","key":"terslevpau","last":"Terslev","locid":"d10590c5-f19a-4682-ab40-30cb3dc6ffca","name":"Terslev, Lene","rank":12,"rolecode":"pau"}],"pmid":["37553551"],"pub":{"doi":"10.1007/s10067-023-06696-4","issn":["07703198","14349949"],"issn_org":["07703198"],"issue":"12","journal":"Clinical Rheumatology","pages":"3275-3281","publisher":"Springer Science+Business Media","status":"p","title":"Clinical Rheumatology","volume":"42"},"review":"Peer Reviewed","scoID":["2-s2.0-85167364038"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-14b0f52a-9f7a-4abf-8934-6d79e7767e93","sdu-6c0f6e3f-8629-402c-9a06-2103bfa9b5d4"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"The impact of an ultrasound atlas for scoring salivary glands in primary Sjögren's syndrome : a pilot study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-716341","year":"2023","yearsub":"2023"}
{"abstract":"Mennesker med psykiske lidelser lever kortere tid end den øvrige befolkning [1, 2]. Selvom en del af denne overdødelighed (ca. 40%) skyldes selvmord, kan størstedelen af overdødeligheden tilskrives fysiske sygdomme (ca. 60%) [2, 3]. Det er påvist, at mennesker med alvorlige psykiske lidelser både har en forøget risiko for at udvikle fysiske sygdomme [4, 5], for at modtage behandling af dårligere kvalitet for den fysiske sygdom [5, 6] samt har en højere risiko for at dø af fysiske sygdomme [1, 5]. Ifølge Sundhedsstyrelsen er antallet af patienter med psykiske lidelser, der behandles på somatisk sygehus, steget med 30% over de seneste 10 år [2]. Årsagen er formentlig en kompleks kombination af en stigende forekomst af psykisk lidelse i befolkningen [2], den demografiske udvikling samt et anderledes kontaktmønster til sundhedsvæsenet blandt mennesker med psykisk lidelse [6, 7]. I september 2022 indgik regeringen sammen med de fleste af Folketingets partier en aftale om en 10-årsplan for psykiatrien. En af aftalens målsætninger var, at mennesker med psykiske lidelser skal leve længere [2].","author_count":9,"contributors":["Mackenhauer, Julie","Prior, Anders","Hjorthøj, Carsten","von Hauen Hansen, Maria","Knudsen, Søren Valgreen","Johnsen, Søren Paaske","Mainz, Jan","Nordentoft, Merete"],"cuid":["S03-088.60-697734"],"filters":{"added":"2023-11","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":3,"continent":["Asia, Middle East","OECD"],"corresponding_author":["Mackenhauer, Julie"],"country":["Israel"],"glorg":["All Global Affiliations","University of Haifa"],"keyword":["Humans","Mental Disorders complications","Morbidity","Psychotic Disorders"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-NDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-NDR","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"multisyge patienter med samtidig psykisk og fysisk sygdom","src":["aau","au","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/562654414/Mackenhauer_et_al._2023_._Multi-morbid_patients_with_co-existing_mental_and_physical_illness.pdf","version":"Published Version"},"id":"S03-088.60-697734","identifier":[{"id":"37897384","type":"pmid"},{"id":"85175271817","type":"scopus"},{"id":"85180749886","type":"scopus"}],"ids":["aau-78bec45a-3005-4d3e-a55c-8fe63a41df3e","au-1c93ddcb-d94d-4f33-b569-e2ea77a3d36b","sdu-8bebef80-5642-4287-a2be-11a9b901f3d2"],"keyword":["Humans","Mental Disorders/complications","Morbidity","Psychotic Disorders"],"lang":"Danish","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-3-6-8FB560C50F33EAC243FE36E19F09EB5D"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/265744498/V05230284_WEB.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/562654414/Mackenhauer_et_al._2023_._Multi-morbid_patients_with_co-existing_mental_and_physical_illness.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://pure.au.dk/ws/files/417808740/Multisyge_patienter_med_samtidig_psykisk_og_fysisk_sygdom.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND 4.0","type":"rem","url":"https://ugeskriftet.dk/videnskab/multisyge-patienter-med-samtidig-psykisk-og-fysisk-sygdom","version":"Published Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":