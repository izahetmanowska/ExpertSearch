s School, Department of Management, Politics and Philosophy"],"nora_code":"DI-U-CBS","used":1},{"affno":"3","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Benny","key":"olsenpau","last":"Olsen","name":"Olsen, Benny","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ole","key":"jacobsenpau","last":"Jacobsen","name":"Jacobsen, Ole","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Anders","key":"lacourpau","last":"la Cour","locid":"b66bb826-dc27-4e3f-8146-aaa7347f9fab","name":"la Cour, Anders","orcid":"0000-0003-2830-1887","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christine Jøker","key":"lohmannpau","last":"Lohmann","name":"Lohmann, Christine Jøker","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Claus","key":"steinleinpau","last":"Steinlein","name":"Steinlein, Claus","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jens","key":"evaldpau","last":"Evald","name":"Evald, Jens","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jens Sejer","key":"andersenpau","last":"Andersen","name":"Andersen, Jens Sejer","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Louise","key":"høstpau","last":"Høst","name":"Høst, Louise","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren","key":"knudsenpau","last":"Knudsen","name":"Knudsen, Søren","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren","key":"lüdekingpau","last":"Lüdeking","name":"Lüdeking, Søren","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Thomas","key":"bachpau","last":"Bach","name":"Bach, Thomas","ran