{"abstract":"Pædagogik bliver forhåbentligt snart et fag i læreruddannelsen igen. Men i al skole og uddannelse er pædagogik langt mere end et fag i en uddannelse, skriver den pædagogiske tænketank.","author_count":11,"contributors":["Madsen, Peter Hougaard","Jespersen, Peter","Korf, Morten","Akselsen, Kate Thais","Prætorius, Jannie Lynggaard","Mikkelsen, Stinus Lundum Storm","Ebsen, Rikke Osbahr","Gammelgaard, Ole","Andersen, Søren Bøjgård Schleicher","Knudsen, Brian Han","Pjengaard, Søren"],"cuid":["S01-000.00-656147"],"filters":{"added":"2023-08","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Det pædagogiske fagområde","Folkeskole","Læreruddannelsen","Pædagogik"],"level":"pop","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-UC"],"level3":{"UC":["DI-UC-AB","DI-UC-ALL","DI-UC-KP","DI-UC-UCL","DI-UC-UCN","DI-UC-UCS","DI-UC-VIA"]},"level3all":["DI-UC-AB","DI-UC-KP","DI-UC-UCL","DI-UC-UCN","DI-UC-UCS","DI-UC-VIA"]},"review":"und","rtype":["clu"],"sorti":"tænketank pædagogik er er det sprog der gør lærere til lærere","src":["via"],"src-code":["DI-UC-VIA"],"type":"doo","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://skolemonitor.dk/debat/art8774302/P%C3%A6dagogik-er-det-sprog-der-g%C3%B8r-l%C3%A6rere-til-l%C3%A6rere","version":"Other Version"},"id":"S01-000.00-656147","ids":["via-2d22d2d5-d3f6-4e97-a748-43dd9562303b"],"keyword":["Det pædagogiske fagområde","folkeskole","læreruddannelsen","pædagogik"],"lang":"Danish","level":"Popular","mra":["Humanities"],"noi":["Local-1-1-109C62CDB4295F3BB50F900C0F9EFFF0"],"oa_link":[{"access":"oa","type":"rem","url":"https://skolemonitor.dk/debat/art8774302/P%C3%A6dagogik-er-det-sprog-der-g%C3%B8r-l%C3%A6rere-til-l%C3%A6rere","version":"Other Version"}],"org":[{"affno":"1","key":"via university college","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-VIA","l3nl":"VIA University College","l3nn":"VIA University Col