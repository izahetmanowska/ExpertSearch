eman","orcid":"0000-0001-7905-0382","rank":4,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"country":"dk","first":"Jannick H.","key":"schmidtpau","last":"Schmidt","locid":"0368390a-0cb4-40b5-80f2-4b6867470968","name":"Schmidt, Jannick Højrup","name_org":"Schmidt, Jannick H.","orcid":"0000-0003-3086-7118","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Tommy","key":"dalgaardpau","last":"Dalgaard","locid":"e5f021d9-b8f8-4bda-86b2-c07af50e2c24","name":"Dalgaard, Tommy","orcid":"0000-0001-8020-0034","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.biombioe.2014.06.005","issn":["09619534","18732909"],"issn_org":["09619534"],"journal":"Biomass & Bioenergy","pages":"115-134","publisher":"Elsevier Ltd","status":"p","title":"Biomass & Bioenergy","volume":"68"},"review":"Peer Reviewed","scoID":["2-s2.0-84903949888"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["aau-d8048b60-a092-4dc2-a61d-48c5ff388c13","au-d68e40cb-0252-4a68-99fa-b607498bca14"],"src":["AAU Aalborg University","AU Aarhus University"],"title":"Life Cycle Assessment of district heat production in a straw fired CHP plant","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-010317","year":"2014","yearsub":"2014"}
{"abstract":"In previous work, a thermoelectric (TE) exhaust heat recovery subsystem for a high temperature polymer electrolyte membrane (HT-PEM) fuel cell stack was developed and modeled. Numerical simulations were conducted and have identified an optimized subsystem configuration and 4 types of compact heat exchangers with superior performance for further analysis. In this work, the on-design performances of the 4 heat exchangers are more thoroughly assessed on their corresponding optimized subsystem configurations. Afterward, their off-design performances are compared on the whole working range of the fuel cell stack. All through this study, different electrical connection styles of all the thermoelectric generator (TEG) modules in the subsystem and their influences are also discussed. In the end, the subsystem configuration is further optimized and a higher subsystem power output is achieved. All TEG modules are now connected into branches. The procedures of designing and optimizing this TE exhaust heat recovery subsystem are drawn out. The contribution of TE exhaust heat recovery to the HT-PEM fuel cell power system is preliminarily concluded. Its feasibility is also discussed.","author_count":4,"contributors":["Gao, Xin","Andreasen, Søren Juhl","Kær, Søren Knudsen","Rosendahl, Lasse"],"cuid":["S01-000.00-052042"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Fuel cell","Heat exchanger","Heat recovery","Optimization"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"optimization of a thermoelectric generator subsystem for high temperature pem fuel cell exhaust heat recovery","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-052042","identifier":[{"id":"WOS:000334899000035","type":"wos"},{"id":"84897392026","type":"scopus"}],"ids":["aau-06f7f8d7-c643-4166-bac1-c710c161d730"],"keyword":["Electrical connection","Fuel cell","Heat exchanger","Heat recovery","Optimization","TEG subsystem"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-B67F24317B7E75EE55B08A11C6B46D9F"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (ENG)","Aalborg University, The Faculty of Engineering and Science, AAU Energy","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Thermal Energy Systems"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Xin","key":"gaopau","last":"Gao","locid":"0c7cc98f-3f75-4d7a-baac-8833cfc63ab5","name":"Gao, Xin","orcid":"0000-0001-6011-0859","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren Juhl","key":"andreasenpau","last":"Andreasen","locid":"02115d16-a485-4ac6-b914-7460ef6c4e83","name":"Andreasen, Søren Juhl","orcid":"0000-0002-0767-5874","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren Knudsen","key":"kærpau","last":"Kær","locid":"898d6584-ec2e-430a-b78d-e3e0d670dcdd","name":"Kær, Søren Knudsen","orcid":"0000-0003-2151-8055","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lasse","key":"rosendahlpau","last":"Rosendahl","name":"Rosendahl, Lasse","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.ijhydene.2014.01.193","issn":["03603199","18793487"],"issn_org":["03603199"],"issue":"12","journal":"International Journal of Hydrogen Energy","pages":"6637-6645","publisher":"Elsevier","status":"p","title":"International Journal of Hydrogen Energy","volume":"39"},"review":"Peer Reviewed","scoID":["2-s2.0-84897392026"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-06f7f8d7-c643-4166-bac1-c710c161d730"],"src":["AAU Aalborg University"],"title":"Optimization of a thermoelectric generator subsystem for high temperature PEM fuel cell exhaust heat recovery","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-052042","year":"2014","yearsub":"2014"}
{"abstract":"Temperature changes in PEM fuel cell stacks are considerably higher during load variations and have a negative impact as they generate thermal stresses and stack degradation. Cell hydration is also of vital importance in fuel cells and it is strongly dependent on operating temperature. A combination of high temperature and reduced humidity increases the degradation rate. Stack thermal management and control are, thus, crucial issues in PEM fuel cell systems especially in automotive applications such as forklifts. In this paper we present a control–oriented dynamic model of a liquid–cooled PEM fuel cell system for studying temperature variations over fast load changes. A temperature dependent cell polarization and hydration model integrated with the compressor, humidifier and cooling system are simulated in dynamic condition. A feedback PID control was implemented for stack cooling. The stack energy balance was reduced to a first order differential equation using a lumped approach. The first-order Linear Time-Invariant system was used to obtain the transfer function which was determined based on experimental data at different stack loads. The developed model approach can assist designers in choosing the required coolant mass flow rate and radiator size to minimize the stack temperature gradients.","author_count":4,"contributors":["Liso, Vincenzo","Nielsen, Mads Pagh","Kær, Søren Knudsen","Mortensen, Henrik H."],"cuid":["S01-000.00-053490"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["H2Logic"],"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"thermal modeling and temperature control of a pem fuel cell system for forklift applications","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-053490","identifier":[{"id":"84900410315","type":"scopus"},{"id":"WOS:000337258700024","type":"wos"}],"ids":["aau-0bcfd968-7df2-4018-b691-ebad5989088a"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-7DEBCB880C12CBBEECF3B140CA542A41"],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (ENG)","Aalborg University, The Faculty of Engineering and Science, AAU Energy","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Heating and Cooling","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Thermal Energy Systems"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["H2Logic"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Vincenzo","key":"lisopau","last":"Liso","locid":"c3a177b3-f874-40d3-984a-f1587412ec79","name":"Liso, Vincenzo","orcid":"0000-0002-7597-3849","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mads Pagh","key":"nielsenpau","last":"Nielsen","locid":"4167f94b-c30d-4966-8da7-b9f5a33bb6d0","name":"Nielsen, Mads Pagh","orcid":"0000-0002-9396-8525","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren Knudsen","key":"kærpau","last":"Kær","locid":"898d6584-ec2e-430a-b78d-e3e0d670dcdd","name":"Kær, Søren Knudsen","orcid":"0000-0003-2151-8055","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Henrik H.","key":"mortensenpau","last":"Mortensen","name":"Mortensen, Henrik H.","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.ijhydene.2014.03.175","issn":["03603199","18793487"],"issn_org":["03603199"],"issue":"16","journal":"International Journal of Hydrogen Energy","pages":"8410-8420","publisher":"Elsevier","status":"p","title":"International Journal of Hydrogen Energy","volume":"39"},"review":"Peer Reviewed","scoID":["2-s2.0-84900410315"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["aau-0bcfd968-7df2-4018-b691-ebad5989088a"],"src":["AAU Aalborg University"],"title":"Thermal modeling and temperature control of a PEM fuel cell system for forklift applications","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-053490","year":"2014","yearsub":"2014"}
{"abstract":"The paper investigates the feasibility of employing a battery thermal management system (BTMS) in different applications based on a techno economic analysis considering the battery lifetime and application profile, i.e. current requirement. The preliminary objective is to set the decision criteria of employing a BTMS and if the outcome of the decision is positive, to determine the type of the employed BTMS. However, employing a BTMS needs to meet a number of application requirements and different BTMS associates a different amount of capital cost to ensure the battery performance over its lifetime. Hence, the objective of this paper is to develop and detail the method of the feasibility for commissioning BTMS called “The decision tool frame-work” (DTF) and to investigate its sensitivity to major factors (e.g. lifetime and application requirement) which are well-known to influence the battery pack thermal performance, battery pack performance and ultimately the performance as well as utility of the desired application. This DTF is designed to provide a common frame-work of a BTMS manufacturer and designer to evaluate the options of different BTMS applicable for different applications and operating conditions. The results provide insight into the feasibility and the required specifi-cation and configuration of a BTMS.","author_count":3,"contributors":["Khan, Mohammad Rezwan","Nielsen, Mads Pagh","Kær, Søren Knudsen"],"cuid":["S01-000.00-082194"],"event":{"end":"2014-10-22","place":"Aalborg, dk","start":"2014-10-21","title":"55th International Conference on Simulation and Modelling (SIMS 2014)","year":"2014"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Batteries","Battery storage","Battery thermal management","Cash flow","Economical analysis","Lifetime"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"feasibility study and techno economic optimization model for battery thermal management system","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://www.ep.liu.se/ecp/108/002/ecp14108002.pdf","version":"Published Version"},"id":"S01-000.00-082194","ids":["aau-6e82ef55-b586-4055-865a-019360c7cc00"],"keyword":["Batteries","Battery Storage","Battery Thermal Management","Cash Flow","Economical Analysis","Feasibility Procurement","Lifetime","Techno Economic Model and Analysis"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-59EF5FCA235D905BD2D9DE301E201191"],"oa_link":[{"access":"oa","type":"rem","url":"http://www.ep.liu.se/ecp/108/002/ecp14108002.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.13140/2.1.4909.2166","version":"Other Version"},{"access":"oa","type":"rem","url":"http://www.ep.liu.se/ecp_home/index.en.aspx?issue=108","version":"Published Version"}],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (ENG)","Aalborg University, The Faculty of Engineering and Science, AAU Energy","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Fluid Mechanics and Combustion"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Mohammad Rezwan","key":"khanpau","last":"Khan","locid":"93d828d4-c1bf-44a2-bf94-b1fd3dcc29cf","name":"Khan, Mohammad Rezwan","orcid":"0000-0002-1532-0598","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mads Pagh","key":"nielsenpau","last":"Nielsen","locid":"4167f94b-c30d-4966-8da7-b9f5a33bb6d0","name":"Nielsen, Mads Pagh","orcid":"0000-0002-9396-8525","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren Knudsen","key":"kærpau","last":"Kær","locid":"898d6584-ec2e-430a-b78d-e3e0d670dcdd","name":"Kær, Søren Knudsen","orcid":"0000-0003-2151-8055","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.13140/2.1.4909.2166","edition":"002","eisbn":["9789175193762"],"issn":["16503686"],"pages":"16-27","publisher":"Linköping University Electronic Press","series":"Linköping Electronic Conference Proceedings","status":"p","title":"Proceedings of the 55th International Conference on Simulation and Modelling (SIMS 2014)","volume":"108"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-6e82ef55-b586-4055-865a-019360c7cc00"],"src":["AAU Aalborg University"],"title":"Feasibility Study and Techno-Economic Optimization Model for Battery Thermal Management System","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-082194","year":"2014","yearsub":"2014"}
{"abstract":"Temperature excursions and non-uniformity of the temperature inside the battery systems are the main concern and drawback for any attempt to scale-up battery cells to the larger sizes as required for high power applications. The applications may include electric generating stations, substations, vehicles, telecommunications installations, large industrial and commercial installations, large uninterruptible power supply (UPS) installations and renewable energy plant installations etc. The capacity of the battery pack increases as the operating temperature is raised for a battery pack however this come with the very high expense of accelerated capacity fade i.e. ageing. Subsequently the lifetime of the battery system is reduced. Moreover poor performance (limited capacity availability) is observed at low operating temperature. In addition, excessive or uneven temperature rise in a system or pack reduces its cycle life signiﬁcantly.","author_count":3,"contributors":["Khan, Mohammad Rezwan","Andreasen, Søren Juhl","Kær, Søren Knudsen"],"cuid":["S01-000.00-100324"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Battery","Battery Thermal Management System","Battery management system","Electrical vehicle","Li ion battery"],"level":"pop","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"und","rtype":["clu"],"sorti":"novel battery thermal management system for greater lifetime ratifying current quality and safety standard","src":["aau"],"src-code":["DI-U-AAU"],"type":"dna","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/201861581/Battery_Connections.pdf","version":"Authors Final Version"},"id":"S01-000.00-100324","ids":["aau-ad41314f-0500-40c7-895d-79c4e8999aec"],"keyword":["Battery","Battery Thermal Management System","Electrical vehicle","Li Ion Battery","battery management system"],"lang":"English","level":"Popular","mra":["Science/Technology"],"noi":["Local-1-1-F270A097D09F661D3D13A2E833CF72F7"],"oa_link":[{"access":"oa","type":"rem","url":"http://www.batteryconnections.net/summer2014issue/index.html","version":"Other Version"},{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/201861581/Battery_Connections.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (ENG)","Aalborg University, The Faculty of Engineering and Science, AAU Energy","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Fluid Mechanics and Combustion"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Mohammad Rezwan","key":"khanpau","last":"Khan","locid":"93d828d4-c1bf-44a2-bf94-b1fd3dcc29cf","name":"Khan, Mohammad Rezwan","orcid":"0000-0002-1532-0598","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren Juhl","key":"andreasenpau","last":"Andreasen","locid":"02115d16-a485-4ac6-b914-7460ef6c4e83","name":"Andreasen, Søren Juhl","orcid":"0000-0002-0767-5874","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren Knudsen","key":"kærpau","last":"Kær","locid":"898d6584-ec2e-430a-b78d-e3e0d670dcdd","name":"Kær, Søren Knudsen","orcid":"0000-0003-2151-8055","rank":3,"rolecode":"pau"}],"pub":{"newspaper":"Battery Connections","pages":"6-10","publisher":"DON CLEARY PUBLISHING","status":"p","title":"Battery Connections"},"review":"Undetermined","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-ad41314f-0500-40c7-895d-79c4e8999aec"],"src":["AAU Aalborg University"],"title":"Novel Battery Thermal Management System for Greater Lifetime Ratifying Current Quality and Safety Standard","type":"Newspaper Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-100324","year":"2014","yearsub":"2014"}
{"abstract":"In this work a macroscopic, steady-state, three-dimensional, computational fluid dynamics model of the anode of a high-pressure polymer electrolyte membrane electrolysis cell (PEMEC) is presented. The developed model is used for studying the effect of employing an interdigitated, planar-circular cell design on the distribution of water in the anode. In the electrolysis of water using PEMEC the anode is fed by demineralized water. Throughout the anode, oxygen is produced and a two-phase flow develops. Interdigitated channels assist in avoiding that gaseous oxygen obstructs the transport of liquid water towards the catalytic layer of the electrode. As opposed to the more common serpentine and parallel channels, interdigitated channels force liquid water through the porous gas diffusion layer (GDL) of the electrode. This improves the supply of water, however it increases pressure losses. While interdigitated channels have been examined for planar-square cells in detail, less is known for planar-circular cells. To examine the extent of flow maldistribution, a base case is defined and a parameter variation is conducted relative to it. In the study, the following parameters are examined: water stoichiometry, temperature, GDL permeability and thickness. In conclusion, it is found that the interdigitated flow field results in an uneven distribution across the cell and that the extent depends strongly on the permeability and weaker on the remaining parameters.","author_count":2,"contributors":["Olesen, Anders Christian","Kær, Søren Knudsen"],"cuid":["S01-000.00-118160"],"event":{"end":"2014-10-22","place":"Aalborg, dk","start":"2014-10-21","title":"55th International Conference on Simulation and Modelling (SIMS 2014)","year":"2014"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Electrolysis","Flow maldistribution","Modeling","PEMEC"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"flow maldistribution in the anode of a polymer electrolyte membrane electrolysis cell employing interdigitated channels","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://www.ep.liu.se/ecp_article/index.en.aspx?issue=108;article=023","version":"Published Version"},"id":"S01-000.00-118160","ids":["aau-ea6028ce-211e-48d2-815d-b89e4f4aac49"],"keyword":["Electrolysis","Flow maldistribution","Modeling","PEMEC"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-A57EAF1F6AB9CA1CE4021AD92FCFD440"],"oa_link":[{"access":"oa","type":"rem","url":"http://www.ep.liu.se/ecp_home/index.en.aspx?issue=108","version":"Published Version"},{"access":"oa","type":"rem","url":"http://www.ep.liu.se/ecp_article/index.en.aspx?issue=108;article=023","version":"Published Version"}],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (ENG)","Aalborg University, The Faculty of Engineering and Science, AAU Energy","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Fluid Mechanics and Combustion"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Anders Christian","key":"olesenpau","last":"Olesen","locid":"a6c83a7f-2f25-4b66-b42d-9ef435ffeecf","name":"Olesen, Anders Christian","orcid":"0000-0002-8344-914X","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren Knudsen","key":"kærpau","last