il","key":"university of haifa","loc":["Israel","Asia, Middle East","OECD"],"name":"University of Haifa","used":1}],"person":[{"affno":"1 2 3","corresponding":null,"country":"dk","first":"Jan","key":"mainzpau","last":"Mainz","locid":"fadbea42-81be-48a2-afb2-c868f9dfa4f5","name":"Mainz, Jan","orcid":"0000-0003-0242-9233","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren Paaske","key":"johnsenpau","last":"Johnsen","locid":"c3e8b374-a343-484a-a10d-e6550efbb8dc","name":"Johnsen, Søren Paaske","orcid":"0000-0002-2787-0271","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren Valgreen","key":"knudsenpau","last":"Knudsen","locid":"d59094b5-44a6-4398-9acf-f3f530e0504b","name":"Knudsen, Søren Valgreen","rank":3,"rolecode":"pau"},{"affno":"","first":"Jan","key":"mainzpedh","last":"Mainz","name":"Mainz, Jan","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Søren Paaske","key":"johnsenpedh","last":"Johnsen","name":"Johnsen, Søren Paaske","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"edition":"1","eisbn":["9788702384185"],"isbn":["9788762817814"],"pages":"109-127","publisher":"Munksgaard Forlag","status":"p","title":"Kvalitet og patientsikkerhed"},"review":"Undetermined","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-d13b556a-4a9b-470c-8a5a-c3970fb8ec2b"],"src":["AAU Aalborg University"],"title":"Begreber og terminologi","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-687123","year":"2023","yearsub":"2023"}
{"abstract":"BACKGROUND AND AIMS: Intestinal ultrasound (IUS) performed by experts is a valuable tool for the diagnostic work-up and monitoring of Crohn's disease (CD). However, concern about insufficient training and perceived high inter-observer variability limit the adoption of IUS in CD. We examined the diagnostic accuracy of trainee-performed IUS in patients with suspected CD. METHOD: Patients recruited to a prospective trial investigating the diagnostic accuracy of magnetic resonance enterocolonography (MREC) in patients with clinically suspected CD underwent IUS performed by trainees. The primary end-point was IUS per-patient sensitivity and specificity for ileocolonic CD determined by ileocolonoscopy. RESULTS: 129 patients with clinically suspected CD and a complete IC and IUS were included in the analysis. IUS detected signs of CD in 49 cases (small bowel 31, colon 15, small bowel, and colon 3). The sensitivity and specificity for detection of ileocolonic CD by trainee performed IUS improved during the first to the second half of the study period from 57.1% (CI 34.0-78.2) to 73.1% (CI 52.2-88.4) and 76.5% (CI 58.8-89.3) to 89.7% (CI 72.6-97.8). The overall sensitivity and specificity of diagnosing CD with IUS were 65.4% (CI 50.9-78.0) and 80.5% (CI 69.9-88.7). There was no difference in diagnostic performance between IUS and MREC for the detection of CD. CONCLUSION: Trainees improved during the study, and IUS performance in disease detection corresponded to expert-evaluated MREC. Registered at ClinicalTrials.gov (NCT03134586).","author_count":6,"contributors":["Brodersen, Jacob Broder","Jensen, Michael Dam","Agerbæk Juel, Mie","Kjeldsen, Jens","Knudsen, Torben","Rafaelsen, Søren Rafael"],"cuid":["S01-000.00-713845"],"filters":{"added":"2024-02","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Brodersen, Jacob Broder"],"keyword":["Colon diagnostic imaging","Crohn Disease diagnostic imaging","Crohn s disease","Diagnostic imaging","Humans","Intestinal ultrasound","Intestine Small pathology","Magnetic Resonance Imaging","Magnetic Resonance Imaging methods","Prospective Studies","Sensitivity and Specificity"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"intestinal ultrasound in patients with suspected crohn s disease results of a prospective evaluation by trainees","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/243590004/ANDI_UL_SJG_revised_1_til_Pure.pdf","version":"Authors Final Version"},"id":"S01-000.00-713845","identifier":[{"id":"85165255140","type":"scopus"},{"id":"37459054","type":"pmid"}],"ids":["sdu-39a5a518-b29b-4c87-acd8-77ac849ac9da"],"keyword":["Colon/diagnostic imaging","Crohn Disease/diagnostic imaging","Crohn’s disease","Humans","Intestine, Small/pathology","Magnetic Resonance Imaging/methods","Prospective Studies","Sensitivity and Specificity","diagnostic imaging","intestinal ultrasound","magnetic resonance imaging"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-502306F435DF873634F0BF06034010A5"],"oa_link":[{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/243590004/ANDI_UL_SJG_revised_1_til_Pure.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Regional Health Research","SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS - Esbjerg and Grindsted Hospital, Research Unit of Medical gastroenterology-hepatology (Esbjerg)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jacob Broder","key":"brodersenpau","last":"Brodersen","locid":"6848c9c8-cad2-4000-9a02-d73415b277cd","name":"Brodersen, Jacob Broder","orcid":"0000-0003-2530-7554","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Michael Dam","key":"jensenpau","last":"Jensen","locid":"a6ef46da-3165-4804-9599-4a6cd9f1bbaa","name":"Jensen, Michael Dam","orcid":"0009-0004-8432-1764","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mie Agerbæk","key":"juelpau","last":"Juel","locid":"e100aceb-82b9-479a-9365-f89a179d0d75","name":"Agerbæk Juel, Mie","name_org":"Juel, Mie Agerbæk","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jens","key":"kjeldsenpau","last":"Kjeldsen","locid":"4893b496-ebc1-4498-92aa-836500b4cb45","name":"Kjeldsen, Jens","orcid":"0000-0001-8148-6572","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Torben","key":"knudsenpau","last":"Knudsen","locid":"afa15e36-ab82-4894-89c0-b8802310b50b","name":"Knudsen, Torben","orcid":"0000-0003-0726-0115","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren Rafael","key":"rafaelsenpau","last":"Rafaelsen","locid":"89253a87-a28b-4cb9-aa20-ded9a9d49536","name":"Rafaelsen, Søren Rafael","orcid":"0000-0001-5182-5545","rank":6,"rolecode":"pau"}],"pmid":["37459054"],"pub":{"doi":"10.1080/00365521.2023.2234538","issn":["00365521","15027708"],"issn_org":["00365521"],"issue":"12","journal":"Scandinavian Journal of Gastroenterology","pages":"1405-1411","publisher":"Taylor & Francis","status":"p","title":"Scandinavian Journal of Gastroenterology","volume":"58"},"review":"Peer Reviewed","scoID":["2-s2.0-85165255140"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-39a5a518-b29b-4c87-acd8-77ac849ac9da"],"src":["SDU University of Southern Denmark"],"title":"Intestinal ultrasound in patients with suspected Crohn's disease : results of a prospective evaluation by trainees","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-713845","year":"2023","yearsub":"2023"}
{"abstract":"The objective of this pilot study was to assess the impact of a salivary gland ultrasound (SGUS) atlas for scoring parenchymal changes in Sjögren's syndrome by assessing the reliability of the scoring system (0-3), without and with the use of the SGUS atlas. Ten participants with varying experience in SGUS contributed to the reliability exercise. Thirty SGUS images of the submandibular and parotid gland with abnormalities ranging from 0 to 3 were scored using the written definitions of the OMERACT SGUS scoring system and using the SGUS atlas based on the OMERACT scoring system. For intra-reader reliability, two rounds were performed without and with the atlas-in the 2nd round the 30 images were rearranged in random order by a physician not included in the scoring. Inter-reader reliability was also determined in both rounds. Without using the atlas, the SGUS OMERACT scoring system showed fair inter-reader reliability in round 1 (mean kappa 0.36; range 0.06-0.69) and moderate intra-reader reliability (mean kappa 0.55; range 0.28-0.81). With the atlas, inter-reader reliability improved in round 1 to moderate (mean kappa 0.52; range 0.31-0.77) and intra-reader reliability to good (mean kappa 0.69; range 0.46-0.86). Higher intra-reader reliability was noted in participants with previous SGUS experience. The SGUS atlas increased both intra- and inter-reader reliability for scoring gland pathology in participants with varying SGUS experience suggesting a possible future role in clinical practice and trials. Key Points • Ultrasonography can detect parenchymal changes in salivary glands in patients with Sjögren's disease. • An ultrasound atlas may improve reliability of scoring parenchymal changes in salivary glands.","author_count":12,"contributors":["Schmidt, Nanna Surlemont","Fana, Viktoria","Danielsen, Mads Ammitzbøll","Lindegaard, Hanne Merete","Voss, Anne","Horn, Hans Christian","Bonde Knudsen, John","Byg, Keld-Erik","Birger Morillon, Melanie","Just, Søren Andreas","Døhn, Uffe M","Terslev, Lene"],"cuid":["S02-100.00-716341"],"filters":{"added":"2024-02","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corresponding_author":["Schmidt, Nanna Surlemont"],"keyword":["Humans","Omeract","Pilot Projects","Reproducibility of Results","Salivary glands","Sjögren s syndrome","Ultrasonography","Ultrasonography methods"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-SDR","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"the impact of an ultrasound atlas for scoring salivary glands in primary sjögren s syndrome a pilot study","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1007/s10067-023-06696-4","version":"Published Version"},"id":"S02-100.00-716341","identifier":[{"id":"PMC10640467","type":"pmcid"},{"id":"37553551","type":"pmid"},{"id":"85167364038","type":"scopus"}],"ids":["ku-14b0f52a-9f7a-4abf-8934-6d79e7767e93","sdu-6c0f6e3f-8629-402c-9a06-2103bfa9b5d4"],"keyword":["Humans","OMERACT","Pilot Projects","Reproducibility of results","Salivary Glands/diagnostic imaging","Salivary glands","Sjogren's Syndrome/diagnostic imaging","Sjögren’s syndrome","Ultrasonography","Ultrasonography/methods"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-A0A37C7A0C76449D62612DA59BF6057B"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/374553640/s10067_023_06696_4.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/246132364/s10067_023_06696_4.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","t