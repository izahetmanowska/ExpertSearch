t":"Vollset","name":"Vollset, Stein Emil","rank":44,"rolecode":"pau"},{"affno":"","first":"Theo","key":"vostheopau","last":"Vos","name":"Vos, Theo","rank":45,"rolecode":"pau"},{"affno":"","first":"Simon","key":"øverlandsimonpau","last":"Øverland","name":"Øverland, Simon","rank":46,"rolecode":"pau"}],"pmid":["31759894"],"pub":{"doi":"10.1016/s2468-2667(19)30224-5","issn":["24682667"],"issue":"12","journal":"The Lancet Public Health","publisher":"Elsevier Ltd","status":"p","title":"The Lancet Public Health","title_org":"The Lancet. Public health","volume":"4"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-16451844-9e81-4dca-b2b3-57caba7c88df","ku-db53192b-e2e9-42cd-8ee4-8ded0b707674","sdu-ffc399b9-2359-4120-a450-62afab12b78b"],"src":["AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Life expectancy and disease burden in the Nordic countries : results from the Global Burden of Diseases, Injuries, and Risk Factors Study 2017","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-099.97-014202","year":"2019","yearsub":"2019"}
{"abstract":"A precise lithium-ion battery model is required to specify their appropriateness for different applications and to study their dynamic behavior. In addition, it is important to design an efficient battery system for power applications. In this investigation, a second-order equivalent electrical circuit battery model, which is the most conventional method of characterizing the behavior of a lithium-ion battery, was developed. The current pulse procedure was employed for parameterization of the model. The construction of the model was described in detail, and a battery model for a 13 Ah lithium titanate oxide battery cell was demonstrated. Comprehensive characterization experiments were accomplished for an extensive range of operating situations. The outcomes were employed to parameterize the suggested dynamic model of the lithium titanate oxide battery cell. The simulation outcomes were compared to the laboratory measurements. In addition, the proposed lithium-ion battery model was validated. The recommended model was assessed, and the proposed model was able to anticipate precisely the current and voltage performance.","author_count":3,"contributors":["Madani, Seyed Saeed","Schaltz, Erik","Kær, Søren Knudsen"],"cuid":["S01-000.00-067151"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Equivalent circuit model","Experiment","Lithium ion battery","Modelling"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"an electrical equivalent circuit model of a lithium titanate oxide battery","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.3390/batteries5010031","version":"Published Version"},"id":"S01-000.00-067151","identifier":[{"id":"000464119800001","type":"wos"},{"id":"85067576534","type":"scopus"}],"ids":["aau-3b01cab7-fad5-46ff-b620-6c239cb0139d"],"keyword":["Equivalent circuit model","Experiment","Lithium-ion battery","Modelling"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-6F8A2CDA6C517E56B6CD498B9EC33DEA"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.3390/batteries5010031","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/308298627/batteries_05_00031.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, AAU Energy","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Thermal Engineering"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Seyed Saeed","key":"madanipau","last":"Madani","locid":"2b964c98-f205-4a96-8e1c-e2433090f82a","name":"Madani, Seyed Saeed","orcid":"0000-0003-1636-3554","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Erik","key":"schaltzpau","last":"Schaltz","locid":"6e39b31c-c3fa-470a-b47b-e69ee21195c1","name":"Schaltz, Erik","orcid":"0000-0002-8540-0040","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren Knudsen","key":"kærpau","last":"Kær","locid":"898d6584-ec2e-430a-b78d-e3e0d670dcdd","name":"Kær, Søren Knudsen","orcid":"0000-0003-2151-8055","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.3390/batteries5010031","issn":["23130105"],"issue":"1","journal":"Batteries","pages":"1-14","paperid":"31","publisher":"Multidisciplinary Digital Publishing Institute","status":"p","title":"Batteries","volume":"5"},"review":"Peer Reviewed","scoID":["2-s2.0-85067576534"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-3b01cab7-fad5-46ff-b620-6c239cb0139d"],"src":["AAU Aalborg University"],"title":"An Electrical Equivalent Circuit Model of a Lithium Titanate Oxide Battery","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-067151","year":"2019","yearsub":"2019"}
{"abstract":"The metal-organic frameworks (MOFs) have gained considerable attention owing to their unique structures with tunable three-dimensional porous frameworks and numerous applications. The large surface area and great porosity make MOFs a promising electrode material for lithium-ion batteries. In this work, the focus is placed on an unexplored key issue, i.e., the impact of lithiation/delithiation on the structure of MOFs as anode materials. To do so, Al-MOF (chemical formula: Al(OH)[O2C–C6H4–CO2]) particles are synthesized, and then uniformly covered by graphene to form the Al-MOF/graphene composite. It is found that the lithiation/delithiation induces a pronounced structural change in the Al-MOF particles, which manifests as an order-disorder transition. This transition leads to the more open channels, thereby benefiting the diffusion and storage of Li+ ions. Compared with pure Al-MOF, the Al-MOF/graphene composite exhibits significantly enhanced electrochemical performances. Its capacity increases continuously from 60 to 400 mAh g−1 at the current density of 100 mA g−1. This work indicates that both the lithiation/delithiation induced order-disorder transition in MOFs and the optimized wrapping of MOF by graphene are crucial for enhancing the capacity and the cycling stability of anode materials.","author_count":6,"contributors":["Gao, Chengwei","Wang, Peixing","Wang, Zhaoyang","Kær, Søren Knudsen","Zhang, Yanfei","Yue, Yuanzheng"],"cuid":["S01-000.00-088885"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East"],"corresponding_author":["Yue, Yuanzheng"],"country":["China"],"glorg":["All Global Affiliations","Qilu University of Technology","Wuhan University of Technology"],"keyword":["Anodes","Graphene","Lithium ion batteries","Metal organic frameworks","Order disorder transition"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"the disordering enhanced performances of the al mof graphene composite anodes for lithium ion batteries","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85070794846&partnerID=8YFLogxK","version":"Other Version"},"id":"S01-000.00-088885","identifier":[{"id":"85070794846","type":"scopus"}],"ids":["aau-855de67c-31c0-455c-944f-a538571fc504"],"keyword":["Anodes","Graphene","Lithium ion batteries","Metal-organic frameworks","Order-disorder transition"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-3DCFC07B0C6DC548A2EF7E617C5C7850"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience, Disordered Materials","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience, Section of Chemistry"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"cn","key":"qilu university of technology","loc":["China","Asia, East"],"name":"Qilu University of Technology","used":1},{"affno":"3","country":"cn","key":"wuhan university of technology","loc":["China","Asia, East"],"name":"Wuhan University of Technology","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Chengwei","key":"gaochengweipau","last":"Gao","locid":"901c925a-036f-4f5e-98f2-26f6c905f793","name":"Gao, Chengwei","orcid":"0000-0001-7105-2121","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Peixing","key":"wangpeixingpau","last":"Wang","name":"Wang, Peixing","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Zhaoyang","key":"wangzhaoyangpau","last":"Wang","name":"Wang, Zhaoyang","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren Knudsen","key":"kærsørenknudsenpau","last":"Kær","locid":"898d6584-ec2e-430a-b78d-e3e0d670dcdd","name":"Kær, Søren Knudsen","orcid":"0000-0003-2151-8055","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Yanfei","key":"zhangyanfeipau","last":"Zhang","name":"Zhang, Yanfei","rank":5,"rolecode":"pau"},{"affno":"2 1","corresponding":null,"country":"dk","first":"Yuanzheng","key":"yueyuanzhengpau","last":"Yue","locid":"613ef41c-8216-4aa7-b1c9-b24d1fccfdbc","name":"Yue, Yuanzheng","orcid":"0000-0002-6048-5236","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.nanoen.2019.104032","issn":["22112855","22113282"],"issn_org":["22112855"],"journal":"Nano Energy","paperid":"104032","publisher":"Elsevier","status":"p","title":"Nano Energy","volume":"65"},"review":"Peer Reviewed","scoID":["2-s2.0-85070794846"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-855de67c-31c0-455c-944f-a538571fc504"],"src":["AAU Aalborg University"],"title":"The disordering-enhanced performances of the Al-MOF/graphene composite anodes for lithium ion batteries","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-088885","year":"2019","yearsub":"2019"}
{"abstract":"Lithium-ion batteries are indispensable parts in electric vehicles, owing to their high energy density, discharge and charge efficiency. Therefore, it is essential to investigate their charging and discharging behavior at different current rates. The purpose of this investigation was to determine and analyses the discharge and charge behavior of a lithium-ion battery at different conditions. In addition, the relationship between cycle number, current and capacity during discharging and charging were analyzed. It was concluded that the extracted charge declined nonlinearly with the amount of the discharging current.","author_count":3,"contributors":["Madani, Seyed Saeed","Schaltz, Erik","Kær, Søren Knudsen"],"cuid":["S01-000.00-107224"],"event":{"end":"2019-08-28","place":"Brno, cz","start":"2019-08-25","title":"20th International Conference on Advanced Batteries, Accumulators and Fuel Cells, ABAF 2019","year":"2019"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"analyzing discharging and charging performance of a lithium ion battery","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85081086317&partnerID=8YFLogxK","version":"Other Version"},"id":"S01-000.00-107224","identifier":[{"id":"85081086317","type":"scopus"}],"ids":["aau-c5147b36-e56f-436b-be28-4e1ce3a5a86f"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-26D860A50B6F6EC6DB3533E69E52ABA5"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, AAU Energy","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Thermofluids"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Seyed Saeed","key":"madanipau","last":"Madani","locid":"2b964c98-f205-4a96-8e1c-e2433090f82a","name":"Madani, Seyed Saeed","orcid":"0000-0003-1636-3554","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Erik","key":"schaltzpau","last":"Schaltz","locid":"6e39b31c-c3fa-470a-b47b-e69ee21195c1","name":"Schaltz, Erik","orcid":"0000-0002-8540-0040","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren Knudsen","key":"kærpau","last":"Kær","locid":"898d6584-ec2e-430a-b78d-e3e0d670dcdd","name":"Kær, Søren Knudsen","orcid":"0000-0003-2151-8055","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1149/09501.0037ecst","issn":["19385862"],"issn_org":["19386737"],"issue":"1","journal":"ECS Transactions","pages":"37-45","publisher":"Institute of Physics","status":"p","title":"ECS Transactions","volume":"95"},"review":"Peer Reviewed","scoID":["2-s2.0-85081086317"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-c5147b36-e56f-436b-be28-4e1ce3a5a86f"],"src":["AAU Aalborg University"],"title":"Analyzing Discharging and Charging Performance of a Lithium-Ion Battery","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-107224","year":"2019","yearsub":"2019"}
{"abstract":"BACKGROUND AND AIMS: Attenuated retinal vasoreactivity in patients with type 2 diabetes preceding diabetic retinopathy development has been proposed to reflect local endothelial dysfunction. Whether retinal vessel reactivity is associated with peripheral endothelial dysfunction and large artery stiffness in patients with type 2 diabetes remains to be elucidated. METHODS: Twenty patients with type 2 diabetes without retinopathy and 20 sex- and age matched controls (diabetes duration: 9.9 years (range 6.0;12.4), 40% male, age: 66.5 ± 7.3 (diabetes) and 65.2 ± 7.6 years (controls)) were included. Endothelial function was assessed using EndoPAT. Arterial stiffness was assessed by carotid-femoral pulse wave velocity using the SphygmoCor. Retinal blood supply regulation was examined by retinal arteriolar diameter change during 1) isometric exercise (hand-weight lifting), 2) exposure to flickering lights, and 3) a combined stimulus of 1) + 2) using the Dynamic Vessel Analyzer. RESULTS: No significant differences were observed in retinal vessel reactivity in T2DM patients compared to controls. Endothelial function was associated with mean arteriolar diameter change during only the combination intervention, (Beta = 0.033 [0.0013;0.064], p = 0.042) in the overall population of patients and controls. When groups were analyzed separately, the associations was statistically significant only in controls. However, formal test for interaction was not statistically significant, p = 0.40. No association was observed between pulse wave velocity and retinal arteriolar %-diameter change in patients or controls. CONCLUSION: Peripheral endothelial function was associated with retinal arteriolar diameter change in the combined sample. The association seemed to be driven primarily by the controls. Our findings indicate that peripheral endothelial function is reflective of endothelial function in the retina mainly in subjects without T2DM, whereas an association in T2DM without retinopathy was not observed. Further studies are needed in T2DM patients with more advanced retinopathy.","author_count":8,"contributors":["Baier, Jonathan Mathias","Funck, Kristian Løkke","Petersen, Line","Vernstrøm, Liv","Knudsen, Søren Tang","Bek, Toke","Poulsen, Per Løgstrup","Laugesen, Esben"],"cuid":["S01-000.00-148107"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Arterial stiffness","Diabetic retinopathy","Endothelial dysfunction","Type 2 diabetes"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"retinal vessel reactivity is not attenuated in patients with type 000000000002 diabetes compared with matched controls and is associated with peripheral endothelial function in controls","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85068065877","version":"Other Version"},"id":"S01-000.00-148107","identifier":[{"id":"31270030","type":"pmid"},{"id":"85068065877","type":"scopus"}],"ids":["au-20cc4aab-689e-49d4-bcec-44b96cadf90c"],"keyword":["Arterial stiffness","Diabetic retinopathy","Dynamic vessel analysis","Endothelial dysfunction","Type 2 diabetes"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-65A13E08083FC0810121F25DFF3B27B6"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Endocrinology and Internal Medicine"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jonathan Mathias","key":"baierpau","last":"Baier","locid":"ccadc0ec-1e5b-460d-94fc-384fa6ddcd01","name":"Baier, Jonathan Mathias","orcid":"0000-0001-8695-8882","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kristian Løkke","key":"funckpau","last":"Funck","locid":"805d1abf-4bb5-4d90-a7ce-e169162ed033","name":"Funck, Kristian Løkke","orcid":"0000-0003-0213-5550","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Line","key":"petersenpau","last":"Petersen","locid":"acb1084c-d77c-4f15-a106-e12d03f13ab2","name":"Petersen, Line","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Liv","key":"vernstrømpau","last":"Vernstrøm","locid":"d1be9514-db60-4e2c-8a30-2887e92e605c","name":"Vernstrøm, Liv","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren T","key":"knudsenpau","last":"Knudsen","locid":"f4fb113c-f8d2-4bb3-9a9d-0bc2ef14590d","name":"Knudsen, Søren Tang","name_org":"Knudsen, Søren T","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Toke","key":"bekpau","last":"Bek","locid":"ffc6d181-f10a-40f1-9446-0a5680b91ab8","name":"Bek, Toke","orcid":"0000-0002-0409-2534","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Per Løgstrup","key":"poulsenpau","last":"Poulsen","locid":"a965cecb-44f9-4913-a8e1-7bc669e8ffd9","name":"Poulsen, Per Løgstrup","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Esben","key":"laugesenpau","last":"Laugesen","locid":"e06ca9b7-d51f-40f2-b042-696ca2b18492","name":"Laugesen, Esben","rank":8,"rolecode":"pau"}],"pmid":["31270030"],"pub":{"doi":"10.1016/j.jdiacomp.2019.05.024","issn":["10568727","1873460X"],"issn_org":["10568727"],"issue":"9","journal":"Journal of Diabetes and its Complications","pages":"641-647","publisher":"Elsevier Inc.","status":"p","title":"Journal of Diabetes and its Complications","volume":"33"},"review":"Peer Reviewed","scoID":["2-s2.0-85068065877"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-20cc4aab-689e-49d4-bcec-44b96cadf90c"],"src":["AU Aarhus University"],"title":"Retinal vessel reactivity is not attenuated in patients with type 2 diabetes compared with matched controls and is associated with peripheral endothelial function in controls","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-148107","year":"2019","yearsub":"2019"}
{"abstract":"Abdominal obesity is associated with elevated postprandial triglycerides (TG), an independent risk factor for cardiovascular diseases. Previous studies show that whey protein (WP) and dietary fiber may separately reduce postprandial TG. However, few studies have investigated the long-term effects of WP and dietary fiber on postprandial TG. We aimed to investigate the separate and combined long-term effects of WP and dietary fiber from wheat bran on postprandial TG and markers of lipid metabolism in subjects with abdominal obesity. We conducted a 12-week, double-blind, randomized, controlled, parallel intervention study. In a 2 × 2 factorial design, 73 adults were randomized to receive 60 g/day of either WP hydrolysate or maltodextrin (MD) combined with high-fiber wheat bran products (HiFi; 30 g dietary fiber/day) or low-fiber refined wheat products (LoFi; 10 g dietary fiber/day). A high-fat meal test was conducted before and after the intervention. Sixty-five subjects were included in the final analyses. There were no differences between intervention groups in postprandial TG assessed as incremental area under the curve (iAUC). WP-LoFi had reduced postprandial TG assessed as total area under the curve (tAUC) and reduced fasting TG compared with all other groups, and reduced fasting apolipoprotein B-48 compared with MD-LoFi. There were no changes in lipoprotein lipase activity. Total cholesterol and apolipoprotein B-100 were reduced after WP intake compared with MD. Total cholesterol was increased after HiFi intake compared with LoFi. In conclusion, intake of WP in combination with low-fiber cereal products for 12 weeks had beneficial effects on postprandial TG tAUC and fasting TG, but not on postprandial TG iAUC in subjects with abdominal obesity. Combining WP with high-fiber wheat bran products did not improve lipid profile.","author_count":8,"contributors":["Rakvaag, Elin","Fuglsang-Nielsen, Rasmus","Knudsen, Knud Erik Bach","Landberg, Rikard","Hjelholt, Astrid Johannesson","Søndergaard, Esben","Hermansen, Kjeld","Gregersen, Søren"],"cuid":["S01-000.00-205320"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"country":["Sweden"],"glorg":["All Global Affiliations","Chalmers University of Technology"],"keyword":["Abdominal obesity","Dietary fiber","Postprandial lipemia","Triglycerides","Whey protein"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"whey protein combined with low dietary fiber improves lipid profile in subjects with abdominal obesity a randomized controlled trial","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85071757498","version":"Other Version"},"id":"S01-000.00-205320","identifier":[{"id":"31487806","type":"pmid"},{"id":"000487964600289","type":"wos"},{"id":"PMC6770182","type":"pmcid"},{"id":"85071757498","type":"scopus"}],"ids":["au-851dc0af-ba78-4a83-9588-5915fd230ca0"],"keyword":["Abdominal obesity","Dietary fiber","Postprandial lipemia","Triglycerides","Whey protein"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-0F59E0BB8D4D213789049DA0759DFE58"],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Endocrinology and Internal Medicine"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"se","key":"chalmers university of technology","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Chalmers University of Technology","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Elin","key":"rakvaagpau","last":"Rakvaag","locid":"6f4c6a78-4299-4bb1-9452-9c5c80b9d147","name":"Rakvaag, Elin","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rasmus","key":"fuglsangnielsenpau","last":"Fuglsang-Nielsen","locid":"844e8eb0-930e-4cc2-847b-f76353b13f7c","name":"Fuglsang-Nielsen, Rasmus","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Knud Erik","key":"bachknudsenpau","last":"Bach Knudsen","locid":"3918454e-241b-4712-ab7f-aa9d26a508f7","name":"Knudsen, Knud Erik Bach","name_org":"Bach Knudsen, Knud Erik","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Rikard","key":"landbergpau","last":"Landberg","name":"Landberg, Rikard","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Astrid","key":"johannessonhjelholtpau","last":"Johannesson Hjelholt","locid":"7c969e96-fa50-4878-a9fe-bea51d76ec75","name":"Hjelholt, Astrid Johannesson","name_org":"Johannesson Hjelholt, Astrid","orcid":"0000-0002-3114-4176","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Esben","key":"søndergaardpau","last":"Søndergaard","locid":"35f76081-43f3-42ce-94b2-e60a44e59d5a","name":"Søndergaard, Esben","orcid":"0000-0001-8041-6994","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kjeld","key":"hermansenpau","last":"Hermansen","locid":"a62f80e1-f33f-47bd-a5e5-87d59477619f","name":"Hermansen, Kjeld","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren","key":"gregersenpau","last":"Gregersen","locid":"59b0d84c-a135-49bf-afba-7783f90976c2","name":"Gregersen, Søren","orcid":"0000-0002-1953-8631","rank":8,"rolecode":"pau"}],"pmid":["31487806"],"pub":{"doi":"10.3390/nu11092091","issn":["20726643"],"issue":"9","journal":"Nutrients","paperid":"2091","publisher":"MDPI AG","publisher_org":"M D P I AG","status":"p","title":"Nutrients","volume":"11"},"review":"Peer Reviewed","scoID":["2-s2.0-85071757498"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-851dc0af-ba78-4a83-9588-5915fd230ca0"],"src":["AU Aarhus University"],"title":"Whey Protein Combined with Low Dietary Fiber Improves Lipid Profile in Subjects with Abdominal Obesity : A Randomized, Controlled Trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-205320","year":"2019","yearsub":"2019"}
{"abstract":"Aims: To investigate whether the benefits of switching to insulin degludec observed in the European retrospective chart review study EU-TREAT were dependent on the previous basal insulin used. Methods: People with Type 1 or Type 2 diabetes were switched to insulin degludec from other basal insulins ≥6 months before data collection. Participants were stratified into three groups based on their previous basal insulin: insulin glargine 100 units/ml (Type 1: n=888; Type 2: n=259); insulin detemir (Type 1: n=726; Type 2: n=415); and neutral protamine Hagedorn (Type 1: n=53; Type 2: n=95). Their glycaemic control and hypoglycaemia incidence at 6 and 12 months post-switch vs pre-switch was then evaluated. Results: Significant HbA1c reductions were achieved in all previous basal insulin groups for participants with Type 1 diabetes [insulin glargine 100 units/ml: −2.08 mmol/mol (−0.19%); insulin detemir: −2.40 mmol/mol (−0.22%)] and those with Type 2 diabetes [insulin glargine 100 units/ml: −5.90 mmol/mol (–0.54%); insulin detemir: −6.01 mmol/mol (−0.55%); neutral protamine Hagedorn: −2.73 mmol/mol (−0.25%)] at 6 months, except for the relatively small neutral protamine Hagedorn group in those with Type 1 diabetes [−1.75 mmol/mol (−0.16%)], where statistical significance was not reached. At 6 months in the Type 1 diabetes group, switching to insulin degludec from insulin glargine 100 units/ml resulted in significantly lower hypoglycaemia rates across all hypoglycaemia categories; for the insulin detemir group, this significance was also observed for severe and nocturnal non-severe hypoglycaemia, while the low number of people in the neutral protamine Hagedorn group resulted in nonsignificant reductions in hypoglycaemia rates. At 6 months in the people with Type 2 diabetes, switching to insulin degludec resulted in significantly lower rates of hypoglycaemia across all categories for all groups. Similar outcomes were observed at 12 months. Conclusions: Switching to insulin degludec from other basal insulins can improve glycaemic control and/or reduce hypoglycaemia risk in people with diabetes (although there was a nonsignificant reduction in HbA1c and hypoglycaemia rates for the neutral protamine Hagedorn group in Type 1 diabetes) under routine care.","author_count":7,"contributors":["Knudsen, Søren Tang","Lapolla, A.","Schultes, B.","Tentolouris, N.","Catarig, A. M.","Wolden, M. L.","Siegmund, T."],"cuid":["S01-000.00-247823"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"corresponding_author":["Knudsen, Søren Tang"],"country":["Germany","Greece","Italy"],"glorg":["All Global Affiliations","Isar Kliniken","University of Athens","University of Padova"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-PR","DI-U"],"level3":{"OT":["Unspecified organisation"],"PR":["DI-PR-ALL","DI-PR-NOVO"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-PR-NOVO","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"clinical benefits of switching to insulin degludec irrespective of previous basal insulin therapy in people with type 000000000001 or type 000000000002 diabetes evidence from a european multicentre retrospective non interventional study eu treat","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1111/dme.13976","version":"Published Version"},"id":"S01-000.00-247823","identifier":[{"id":"31001865","type":"pmid"},{"id":"PMC6618263","type":"pmcid"},{"id":"85065305680","type":"scopus"}],"ids":["au-cf5fe454-7c65-4b57-9036-e9cce8d724b1"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-A90218B945847424765F1FB6FAA3A56A"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1111/dme.13976","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://pure.au.dk/ws/files/198450187/dme.13976.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - SDCA-Steno Diabetes Center Aarhus"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"it","key":"university of padova","loc":["Italy","Europe, EU","OECD"],"name":"University of Padova","used":1},{"affno":"3","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1},{"affno":"4","country":"gr","key":"university of athens","loc":["Greece","Europe, EU","OECD"],"name":"University of Athens","used":1},{"affno":"5","country":"dk","key":"novo nordisk","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-NOVO","l3nl":"Novo Nordisk","l3nn":"Novo Nordisk","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Novo Nordisk","namevar":["Novo Nordisk A/S"],"nora_code":"DI-PR-NOVO","used":1},{"affno":"6","country":"de","key":"isar kliniken","loc":["Germany","Europe, EU","OECD"],"name":"Isar Kliniken","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"S. T.","key":"knudsenpau","last":"Knudsen","locid":"f4fb113c-f8d2-4bb3-9a9d-0bc2ef14590d","name":"Knudsen, Søren Tang","name_org":"Knudsen, S. T.","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"A.","key":"lapollapau","last":"Lapolla","name":"Lapolla, A.","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"B.","key":"schultespau","last":"Schultes","name":"Schultes, B.","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"N.","key":"tentolourispau","last":"Tentolouris","name":"Tentolouris, N.","rank":4,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"A. M.","key":"catarigpau","last":"Catarig","name":"Catarig, A. M.","rank":5,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"M. L.","key":"woldenpau","last":"Wolden","name":"Wolden, M. L.","rank":6,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"T.","key":"siegmundpau","last":"Siegmund","name":"Siegmund, T.","rank":7,"rolecode":"pau"}],"pmid":["31001865"],"pub":{"doi":"10.1111/dme.13976","issn":["07423071","14645491"],"issn_org":["07423071"],"issue":"7","journal":"Diabetic Medicine","pages":"868-877","publisher":"Wiley-Blackwell Publishing Ltd","publisher_org":"Wiley-Blackwell Publishing Ltd.","status":"p","title":"Diabetic Medicine","volume":"36"},"review":"Peer Reviewed","scoID":["2-s2.0-85065305680"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Private Research","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Miscellaneous","Novo Nordisk","Other Research","Private Research","Universities"],"PST":["Published"]},"sid":["au-cf5fe454-7c65-4b57-9036-e9cce8d724b1"],"src":["AU Aarhus University"],"title":"Clinical benefits of switching to insulin degludec irrespective of previous basal insulin therapy in people with Type 1 or Type 2 diabetes : evidence from a European, multicentre, retrospective, non-interventional study (EU-TREAT)","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-247823","year":"2019","yearsub":"2019"}
{"abstract":"BACKGROUND: Cimbi-36 can be 11C-labeled to form an agonist radioligand used for positron emission tomography (PET) imaging of the 5-HT2A receptor in the brain. In its non-labeled form (25B-NBOMe), it is used as a recreational drug that can lead to severe adverse effects, in some cases, with fatal outcome. We investigated human biodistribution and radiation dosimetry of the radioligand with two different radiolabeling positions. Seven healthy volunteers underwent dynamic 120-min whole-body PET scans (injection of 581 ± 16 MBq, n = 5 for 11C-Cimbi-36; 593 ± 14 MBq, n = 2 for 11C-Cimbi-36_5). Time-integrated activity coefficients (TIACs) from time-activity curves (TACs) of selected organs were used as input into the OLINDA/EXM software to obtain dosimetry information for both 11C-labeling positions of Cimbi-36. RESULTS: The effective dose was only slightly higher for 11C-Cimbi-36 (5.5 μSv/MBq) than for 11C-Cimbi-36_5 (5.3 μSv/MBq). Standard uptake value (SUV) curves showed higher uptake of 11C-Cimbi-36 in the pancreas, small intestines, liver, kidney, gallbladder, and urinary bladder compared with 11C-Cimbi-36_5, reflecting differences in radiometabolism for the two radioligands. Variability in uptake in excretory organs for 11C-Cimbi-36 points to inter-individual differences with regard to metabolic rate and route. Surprisingly, moderate uptake was found in brown adipose tissue (BAT) in four subjects, possibly representing specific 5-HT2A/2C receptor binding. CONCLUSION: The low effective dose of 5.5 μSv/MBq allows for the injection of up to 1.8 GBq for healthy volunteers per study (equivalent to 3 scans if injecting 600 MBq) and still stay below the international guidelines of 10 mSv, making 11C-Cimbi-36 eligible for studies involving a series of PET scans in a single subject. The biodistribution of Cimbi-36 (and its metabolites) may also help to shed light on the toxic effects of 25B-NBOMe when used in pharmacological doses in recreational settings.","author_count":7,"contributors":["Johansen, Annette","Holm, Søren","Dall, Bente","Keller, Sune","Kristensen, Jesper Langgaard","Knudsen, Gitte Moos","Hansen, Hanne D"],"cuid":["S01-000.00-510923"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"human biodistribution and radiation dosimetry of the 000000000005 ht000000000002a receptor agonist cimbi 000000000036 labeled with carbon 000000000011 in two positions","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s13550-019-0527-4","version":"Published Version"},"id":"S01-000.00-510923","identifier":[{"id":"31367837","type":"pmid"},{"id":"85069928712","type":"scopus"},{"id":"PMC6669221","type":"pmcid"}],"ids":["ku-c4df12c8-2e3c-4a4c-8c10-af140215cd49"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-821AC6215BE7CF65FC089D3DC1DCAF05"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s13550-019-0527-4","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/226114481/s13550_019_0527_4","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Radiology"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"","first":"Annette","key":"johansenpau","last":"Johansen","name":"Johansen, Annette","rank":1,"rolecode":"pau"},{"affno":"1","first":"Søren","key":"holmpau","last":"Holm","locid":"f6989f1e-f730-4207-9ef1-9a6c380a4aa2","name":"Holm, Søren","rank":2,"rolecode":"pau"},{"affno":"2","first":"Bente","key":"dallpau","last":"Dall","name":"Dall, Bente","rank":3,"rolecode":"pau"},{"affno":"","first":"Sune","key":"kellerpau","last":"Keller","name":"Keller, Sune","rank":4,"rolecode":"pau"},{"affno":"1","first":"Jesper L","key":"kristensenpau","last":"Kristensen","locid":"33965c96-9f54-48ed-9a82-ed0c062174f8","name":"Kristensen, Jesper Langgaard","name_org":"Kristensen, Jesper L","orcid":"0000-0002-5613-1267","rank":5,"rolecode":"pau"},{"affno":"1","first":"Gitte M","key":"knudsenpau","last":"Knudsen","locid":"f02aee9e-69cf-491a-9765-ff062f734db8","name":"Knudsen, Gitte Moos","name_org":"Knudsen, Gitte M","orcid":"0000-0003-1508-6866","rank":6,"rolecode":"pau"},{"affno":"","first":"Hanne D","key":"hansenpau","last":"Hansen","name":"Hansen, Hanne D","rank":7,"rolecode":"pau"}],"pmid":["31367837"],"pub":{"doi":"10.1186/s13550-019-0527-4","issn":["2191219X"],"journal":"EJNMMI Research","pages":"1-10","paperid":"71","status":"p","title":"EJNMMI Research","volume":"9"},"review":"Peer Reviewed","scoID":["2-s2.0-85069928712"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO