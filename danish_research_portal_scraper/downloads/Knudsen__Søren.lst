"},"review":"Undetermined","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-d26d24f0-14f6-44f0-9648-6d55f6129f3f"],"src":["AAU Aalborg University"],"title":"Smart Energy Aalborg : Energivision for Aalborg Kommune 2050","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-111141","year":"2020","yearsub":"2020"}
{"abstract":"We explore design opportunities for varying visual complexity of information visualizations based on distance. Through considering visual congruency and proxemics interaction, we describe a design space that considers potential transitions between visualizations in relation to distance. Our design space is based on exploring prototyping and design possibilities. It describes three properties (boundedness, connectedness, and cardinality) and five design patterns (subdivision, particalization, peculiarization, multiplication, and nesting) that might be considered in design. We describe our design ideas and prototypes, as well as reflect on their usefulness. Finally, we discuss limitations and implications of our work.","author_count":3,"contributors":["Chulpongsatorn, Neil","Yu, Jackie","Knudsen, Søren"],"cuid":["S01-000.00-456887"],"event":{"end":"2020-05-29","place":"Norrköping, se","start":"2020-05-25","title":"Eurovis 2020","year":"2020"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"exploring design opportunities for visually congruent proxemics in information visualization a design space","src":["ku"],"src-code":["DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Andet","type":"doi","url":"https://doi.org/10.2312/evs.20201051","version":"Published Version"},"id":"S01-000.00-456887","ids":["ku-6a3e34ca-9e9e-4a39-96fe-4ef0a9a3e760"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-9EE5661B34CA8344B8EB7BDD587C4B96"],"oa_link":[{"access":"oa","license":"Andet","type":"doi","url":"https://doi.org/10.2312/evs.20201051","version":"Published Version"},{"access":"oa","license":"Andet","type":"loc","url":"https://