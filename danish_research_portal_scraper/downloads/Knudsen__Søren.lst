Arnspang, Eva C.","orcid":"0000-0002-3095-4070","rank":7,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Søren","key":"gregersensørenpau","last":"Gregersen","locid":"59b0d84c-a135-49bf-afba-7783f90976c2","name":"Gregersen, Søren","orcid":"0000-0002-1953-8631","rank":8,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Henrik Byrial","key":"jakobsenhenrikbyrialpau","last":"Jakobsen","name":"Jakobsen, Henrik Byrial","rank":9,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Ulla Breth","key":"knudsenullabrethpau","last":"Knudsen","locid":"819b29d7-2cff-463c-821a-c79663795b76","name":"Knudsen, Ulla Breth","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jens","key":"fedderjenspau","last":"Fedder","locid":"51b716fd-ee92-46ef-8d70-04bf8995c772","name":"Fedder, Jens","orcid":"0000-0001-5383-5501","rank":11,"rolecode":"pau"}],"pmid":["36615174"],"pub":{"doi":"10.3390/jcm12010373","issn":["20770383"],"issue":"1","journal":"Journal of Clinical Medicine","paperid":"373","publisher":"MDPI AG","status":"p","title":"Journal of Clinical Medicine","volume":"12"},"review":"Peer Reviewed","scoID":["2-s2.0-85145896958"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Region of Southern Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["au-828e43d7-23d6-443f-9650-7d8d9ebfb574","sdu-8e2c507c-c692-4fb2-a5eb-70c6dc1775c2"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"Effects of Chokeberries (Aronia spp.) on Cytoprotective and Cardiometabolic Markers and Semen Quality in 109 Mildly Hypercholesterolemic Danish Men : A Prospective, Double-Blinded, Randomized, Crossover Trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-704200","year":"2023","yearsub":"2023"}
{"abstract":"I Danmark dør mennesker med svære psykiske lidelser i gennemsnit 7-10 år tidligere end den øvrige befolkning. Selvom en del af denne overdødelighed skyldes selvmord, kan størstedelen, op imod 60 procent, tilskrives somatiske sygdomme. Den store overdødelighed tydeliggør behovet for øget forebyggelse, tidlig diagnosticering og kvalitet i den somatiske behandling af patienter med psykisk lidelse. Dette er den første af to rapporter, som Behandlingsrådet publicerer vedrørende ulighed i sundhed i 2023 og 2024 under temaet ”Ulighed i den somatiske behandling af patienter med psykiske lidelser”. Rapporterne fokuserer på det danske sundhedsvæsen. Formålet med Behandlingsrådets analyse (2022) er at belyse eventuelle uligheder i somatisk behandling og sygdomsudfald hos patienter med psykisk lidelse sammenlignet med patienter uden psykisk lidelse. Endvidere undersøges betydningen af uddannelse og geografisk bopæl i forhold til eventuelle uligheder mellem patienter med og uden psykisk lidelse","author_count":29,"contributors":["Grønbæk, Morten Klöcker","Andersen, Pernille Tanggaard","Vestergaard, Mogens","Fleming, Emma","Hageman, Ida","Larsen, Finn Breinholt","Caspersen, Lene","Larsen, Beth Bülow","Ulrichsen, Susanne Stockmal","Borup, Kit","Andersen, Lisbeth Lauge","Nielsen, René Ernst","Nordentoft, Merete","Tipsmark, Line Stjernholm","Andersen, Lærke Mai Bonde","Christensen, Pernille Skovgaard","Jeppesen, Josefine Klakk","Johnsen, Søren Paaske","Knudsen, Søren Valgreen","Valentin, Jan Brink"],"cuid":["S03-081.32-792812"],"filters":{"added":"2023-03","altsrc":["No Matches Found"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"corpau":["Dansk Center for Klinisk Sundhedstjenesteforskning (DACS), Aalborg Universitet","Fagudvalget for ulighed i somatisk behandling af patienter med psykiske lidelser","Projektgruppen i Behandlingsrådets sekretariat"],"level":"sci","mra":["hum","med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U","DI-UC"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-ZEA"],"OT":["Bedre Psykiatri"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"],"UC":["DI-UC-ALL","DI-UC-UCL"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-ZEA","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU","DI-UC-UCL"]},"review":"pr","rtype":["clu"],"sorti":"behandlingsrådets rapport vedrørende ulighed i somatisk behandling af patienter med psykiske lidelser","src":["aau","sdu","ucl"],"src-code":["DI-U-AAU","DI-U-SDU","DI-UC-UCL"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://behandlingsraadet-dk.b-cdn.net/media/c0wagvp4/behandlingsr%C3%A5dets-rapport-vedr-ulighed-i-somatisk-behandling-af-patienter-med-psykiske-lidelser-2022-v-1-2.pdf","version":"Published Version"},"id":"S03-081.32-792812","ids":["aau-2c1c2630-91c1-4065-8f2f-667b323e3db8","sdu-e4cfb78e-2fd6-4313-b65b-3f07b2785d5f","ucl-9f55b2c6-ec48-4f2d-9821-7f8c7d673877"],"lang":"Danish","level":"Scientific","mra":["Humanities","Medical Science"],"noi":["Local-1-3-C6D1215EF37E7072510C922984DAE64D"],"oa_link":[{"access":"oa","type":"rem","url":"https://behandlingsraadet-dk.b-cdn.net/media/c0wagvp4/behandlingsr%C3%A5dets-rapport-vedr-ulighed-i-somatisk-behandling-af-patienter-med-psykiske-lidelser-2022-v-1-2.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Public Health, Health Promotion"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU",