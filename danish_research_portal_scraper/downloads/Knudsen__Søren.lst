ecode":"pau"},{"affno":"2","first":"Tina Bech","key":"olesentinabechpau","last":"Olesen","name":"Olesen, Tina Bech","rank":13,"rolecode":"pau"}],"pmid":["39936327"],"pub":{"doi":"10.1093/intqhc/mzaf013","issn":["13534505","14643677"],"issn_org":["13534505"],"issue":"1","journal":"International Journal for Quality in Health Care","paperid":"mzaf013","publisher":"Oxford University Press","status":"p","title":"International Journal for Quality in Health Care","volume":"37"},"review":"Peer Reviewed","scoID":["2-s2.0-85218460046"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","North Denmark Region","Other Research","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-e749f0a7-35ff-40a2-afd1-7dc6a095c844","ku-6413e115-6efd-44b5-9c7a-ec0fac52694b","sdu-a6f8faf7-3cbd-45e3-9c9a-f432d58de899"],"src":["AAU Aalborg University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Indirect effects of the COVID-19 pandemic on healthcare contacts, quality of care, and social disparities across essential healthcare domains","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-099.97-803860","year":"2025","yearsub":"2025"}
{"abstract":"Lactose-hydrolysed UHT milk (LHM) has a limited shelf life, especially due to early browning and off-flavour development. This study aimed to directly compare the development in colour, volatile and bitter peptide formation in pre- (lactase addition prior to UHT treatment) and post-hydrolysed (lactase addition after UHT treatment) milk using three different lactases and stored at 25 or 35 °C for up to one year. Pre-hydrolysed milk exhibited more pronounced browning than post-hydrolysed milk. Furthermore, level of Maillard related compounds like acetic acid and furfural were higher in pre-hydrolysed milk compared to post-hydrolysed milk, whereas post-hydrolysed milk was higher in Strecker aldehyde related volatile organic compounds (VOCs). After storage, level of bitter peptides was higher in post-hydrolysed milk using more impure lactases. Generally, lower VOC concentrations and bitter peptides were observed for LHM produced by more pure lactases suggesting higher purity lactases can aid in the development of ambient long-life LHM.","author_count":8,"contributors":["Knudsen, Lotte Juul","Lokerse, Ilse","Pedrotti, Michele","Nielsen, Søren Dollerup","Dekker, Peter","Rauh, Valentin","Fogliano, Vincenzo","Larsen, Lotte Bach"],"cuid":["S01-000.00-752637"],"filters":{"added":"2024-09","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"corresponding_author":["Knudsen, Lotte Juul"],"country":["France","Netherlands"],"glorg":["All Global Affiliations","DSM Food Specialties","Wageningen University & Research"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-ARLA"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-PR-ARLA","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"differences in development of volatiles and bitter peptides between pre and post hydrolysed lactose free uht milk during storage","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.idairyj.2024.106029","version":"Published Version"},"id":"S01-000.00-752637","identifier":[{"id":"85198002269","type":"scopus"}],"ids":["au-16416381-160f-4b86-bf5c-80f6351f07d9"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-CCA7E1B5811AC3BBF23A1DAF36AB26D6"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.au.dk/ws/files/419932548/1-s2.0-S0958694624001493-main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.idairyj.2024.106029","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, CiFOOD","Aarhus University, Technical Sciences, Department of Food Science, Department of Food Science - Food Chemistry"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"nl","key":"wageningen university research","loc":["Netherlands","Europe, EU","OECD"],"name":"Wageningen University & Research","used":1},{"affno":"3","country":"fr","key":"dsm food specialties","loc":["France","Europe, EU","OECD"],"name":"DSM Food Specialties","used":1},{"affno":"4","country":"dk","key":"arla foods","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-ARLA","l3nl":"Arla Foods","l3nn":"Arla Foods","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Arla Foods","namevar":["Arla Foods"],"nora_code":"DI-PR-ARLA","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Lotte J.","key":"knudsenpau","last":"Knudsen","locid":"7ee04b01-4825-401c-93b0-64ffaa7e3452","name":"Knudsen, Lotte Juul","name_org":"Knudsen, Lotte J.","rank":1,"rolecode":"pau"},{"