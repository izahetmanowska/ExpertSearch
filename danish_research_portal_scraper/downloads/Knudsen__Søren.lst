ne"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Søren Valgreen","key":"knudsenpau","last":"Knudsen","locid":"d59094b5-44a6-4398-9acf-f3f530e0504b","name":"Knudsen, Søren Valgreen","rank":1,"rolecode":"pau"}],"pub":{"doi":"10.54337/aau466213218","issn":["22461302"],"pages":"165","publisher":"Aalborg Universitetsforlag","series":"Aalborg Universitet. Det Sundhedsvidenskabelige Fakultet. Ph.D.-Serien","status":"p"},"review":"Undetermined","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-d35a4186-a51f-433b-9fa0-036c9fe76262"],"src":["AAU Aalborg University"],"title":"Inequalities in quality of care and clinical outcomes among Danish inpatients with major depressive disorder","type":"Other-Internet Publication","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-111417","year":"2021","yearsub":"2021"}
{"abstract":"BACKGROUND: To ensure high quality standards in chronic care of type 2 diabetes, it is paramount to ensure regular measurement of clinical risk factors. For prevention of diabetic kidney disease, testing for albuminuria and kidney function is vital. The majority of individuals with type 2 diabetes in Denmark are treated in general practice, and given the recent development of kidney-protective treatments, a renewed focus on renal risk factors is important. OBJECTIVE: To assess the frequency of albuminuria and kidney function testing in general practice in Denmark and describe developments over the last decade. The proportion of patients with the recommended annual measurements of albuminuria and kidney function was the primary variable. METHODS: We used data from subjects with type 2 diabetes in three cross-sectional general practice studies from 2009 to 2017. RESULTS: Data from 5592 individuals were available. Almost all subjects (96-99%) in the studies had annual measurement of kidney function performed. During the combined observation period there was a clear increase in the proportion of subjects that had albuminuria measured, from 57.2% to 68.0% to 82.8%. CONCLUSION: The regular assessment of renal risk factors in individuals with type 2 diabetes attending primary care in Denmark has seemingly improved over the last decade. This provides the required base for renal risk assessment and appropriate therapy selection.","author_count":4,"contributors":["Persson, Frederik","Charles, Morten","Povlsen, Johan Vestergaard","Knudsen, Søren Tang"],"cuid":["S01-000.00-248184"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Persson, Frederik"],"keyword":["Albuminuria","Cardiovascular disease","Diabetic kidney disease","EVENTS","Kidney disease","Microalbuminuria","Mortality","Multifactorial intervention","Prevalence","Primary care","Risk","Type 2 diabetes"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-STENO"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-HO-STENO","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"improving frequency of urinary albumin testing in type 000000000002 diabetes in primary care an analysis of cross sectional studies in denmark","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.pcd.2021.07.003","version":"Published Version"},"id":"S01-000.00-248184","identifier":[{"id":"85110259763","type":"scopus"},{"id":"000744235900013","type":"wos"},{"id":"34284949","type":"pmid"}],"ids":["au-d002a552-30b0-4f9b-8858-c3ed08c3238e"],"keyword":["Albuminuria","CARDIOVASCULAR-DISEASE","Diabetic kidney disease","EVENTS","KIDNEY-DISEASE","MICROALBUMINURIA","MORTALITY","MULTIFACTORIAL INTERVENTION","PREVALENCE","Primary care","RISK","Type 2 diabetes"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-D659C13334112E116235F6B660E4A2BA"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.au.dk/ws/files/275030637/1_s2.0_S1751991821001200_main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.pcd.2021.07.003","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"dk","key":"steno diabetes centers","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-STENO","l3nn":"Steno Diabetes Centers","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Steno Diabetes Centers","namevar":["Steno Diabetes Centre Copenhagen"],"nora_code":"DI-HO-STENO","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Medicine and Nephrology","Aarhus University, Health, Department of Public Health, Department of Public Health - Forskningsenheden for Almen Praksis"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Frederik","key":"perssonpau","last":"Persson","name":"Persson, Frederik","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Morten","key":"charlespau","last":"Charles","locid":"f5113347-eb47-447a-85b6-5ed82248882e","name":"Charles, Morten","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Johan Vestergaard","key":"povlsenpau","last":"Povlsen","locid":"ad24404a-de4c-4db3-b68f-93f7e1b4dfe6","name":"Povlsen, Johan Vestergaard","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Søren Tang","key":"knudsenpau","last":"Knudsen","locid":"f4fb113c-f8d2-4bb3-9a9d-0bc2ef14590d","name":"Knudsen, Søren Tang","rank":4,"rolecode":"pau"}],"pmid":["34284949"],"pub":{"doi":"10.1016/j.pcd.2021.07.003","issn":["17519918","18780210"],"issn_org":["17519918"],"issue":"6","journal":"Primary Care Diabetes","pages":"1007-1011","publisher":"Elsevier Ltd","status":"p","title":"Primary Care Diabetes","volume":"15"},"review":"Peer Reviewed","scoID":["2-s2.0-85110259763"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities"],"PST":["Published"]},"sid":["au-d002a552-30b0-4f9b-8858-c3ed08c3238e"],"src":["AU Aarhus University"],"title":"Improving frequency of urinary albumin testing in type 2 diabetes in primary care : An analysis of cross-sectional studies in Denmark","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-248184","year":"2021","yearsub":"2021"}
{"abstract":"This investigation's primary purpose was to illustrate the cooling mechanism within a lithium titanate oxide lithium-ion battery pack through the experimental measurement of heat generation inside lithium titanate oxide batteries. Dielectric water/glycol (50/50), air and dielectric mineral oil were selected for the lithium titanate oxide battery pack's cooling purpose. Different flow configurations were considered to study their thermal effects. Within the lithium-ion battery cells in the lithium titanate oxide battery pack, a time-dependent amount of heat generation, which operated as a volumetric heat source, was employed. It was assumed that the lithium-ion batteries within the battery pack had identical initial temperature conditions in all of the simulations. The lithium-ion battery pack was simulated by ANSYS to determine the temperature gradient of the cooling system and lithium-ion batteries. Simulation outcomes demonstrated that the lithium-ion battery pack's temperature distributions could be remarkably influenced by the flow arrangement and fluid coolant type.","author_count":3,"contributors":["Madani, Seyed Saeed","Schaltz, Erik","Kær, Søren Knudsen"],"cuid":["S01-000.00-097663"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"applying different configurations for the thermal management of a lithium titanate oxide battery pack","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.3390/electrochem2010005","version":"Published Version"},"id":"S01-000.00-097663","identifier":[{"id":"85103889818","type":"scopus"}],"ids":["aau-a42e8d97-9237-4947-ae1d-bac86dd1eb96"],"keyword":["Lithium titanate oxide lithium-ion battery","battery pack thermal management"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-EE2A7C98A9677407F9D92355AAD493BB"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/401050240/K.pdf","version":"Pre-print"},{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/402414067/electrochem_02_00005_v2.pdf","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.3390/electrochem2010005","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, AAU Energy","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Thermal Engineering"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Seyed Saeed","key":"madanipau","last":"Madani","locid":"2b964c98-f205-4a96-8e1c-e2433090f82a","name":"Madani, Seyed Saeed","orcid":"0000-0003-1636-3554","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Erik","key":"schaltzpau","last":"Schaltz","locid":"6e39b31c-c3fa-470a-b47b-e69ee21195c1","name":"Schaltz, Erik","orcid":"0000-0002-8540-0040","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren Knudsen","key":"kærpau","last":"Kær","locid":"898d6584-ec2e-430a-b78d-e3e0d670dcdd","name":"Kær, Søren Knudsen","orcid":"0000-0003-2151-8055","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.3390/electrochem2010005","issn":["26733293"],"issue":"1","journal":"Electrochem","pages":"50-63","paperid":"2010005","publisher":"MDPI","status":"p","title":"Electrochem","volume":"2"},"review":"Peer Reviewed","scoID":["2-s2.0-85103889818"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-a42e8d97-9237-4947-ae1d-bac86dd1eb96"],"src":["AAU Aalborg University"],"title":"Applying different configurations for the thermal management of a lithium titanate oxide battery pack","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-097663","year":"2021","yearsub":"2021"}
{"abstract":"In this paper, novel accelerated stress protocols have been proposed based on polarization and electrochemical impedance spectroscopy characterization conducted on three single cell assemblies: one for reference at constant load of 1 A cm −2 and two dynamic loads consisting of a high load cycling between 1.2 A cm −2 and 2 A cm −2 and a low load cycling between 0 A cm −2 (open circuit voltage) and 0.5 A cm −2. Results showed that the degradation rate is 29.8 µV h−1 for constant load test, 51.4 µV h−1 for low load cycling test and -55.8 µV h−1 for high load cycling test. Compared to the constant load operation, low load cycling operation could accelerate the cell performance decrease mainly due to cathode catalyst degradation. The high load cycling could lead to increased cell performance by reducing the ohmic resistance but degrades the anode catalyst significantly, which could compromise the cell's long-term stability. Besides, it is believed that this dynamic condition could accelerate the cell aging by accelerating the membrane thinning.","author_count":3,"contributors":["Li, Na","Araya, Samuel Simon","Kær, Søren Knudsen"],"cuid":["S01-000.00-120248"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Li, Na"],"keyword":["Accelerated stress test","Hydrogen","Load cycling","PEM water electrolyser"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"investigating low and high load cycling tests as accelerated stress tests for proton exchange membrane water electrolysis","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/448879865/paper_D.pdf","version":"Authors Final Version"},"funding_acknowledgement":["This work was supported by the Innovation Fund Denmark through the e-STORE project (Grant No. 4106-00025B ). Na Li appreciates the financial support from China Scholarship Council."],"id":"S01-000.00-120248","identifier":[{"id":"85100098609","type":"scopus"}],"ids":["aau-f17d5100-9671-4716-83d8-fb30d7768700"],"keyword":["Accelerated stress test","Hydrogen","Load cycling","PEM water electrolyser"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-8D0D78B2C11C00F72D71E2FB234C41C3"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/448879865/paper_D.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University","Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, AAU Energy","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Fuel Cell Systems","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Hydrogen and Electro-fuels","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Thermal Engineering"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Na","key":"lipau","last":"Li","locid":"a89f75fa-7daa-406c-b5ea-5307f875cdf0","name":"Li, Na","orcid":"0000-0002-1267-6185","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Samuel Simon","key":"arayapau","last":"Araya","locid":"31cc4ce7-c9ae-4406-95d1-b95d4269205f","name":"Araya, Samuel Simon","orcid":"0000-0001-9294-0793","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren Knudsen","key":"kærpau","last":"Kær","locid":"898d6584-ec2e-430a-b78d-e3e0d670dcdd","name":"Kær, Søren Knudsen","orcid":"0000-0003-2151-8055","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.electacta.2021.137748","issn":["00134686","18733859"],"issn_org":["00134686"],"journal":"Electrochimica Acta","paperid":"137748","publisher":"Elsevier","status":"p","title":"Electrochimica Acta","volume":"370"},"review":"Peer Reviewed","scoID":["2-s2.0-85100098609"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-f17d5100-9671-4716-83d8-fb30d7768700"],"src":["AAU Aalborg University"],"title":"Investigating low and high load cycling tests as accelerated stress tests for proton exchange membrane water electrolysis","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-120248","year":"2021","yearsub":"2021"}
{"abstract":"Lithium-ion batteries are being implemented in different large-scale applications, including aerospace and electric vehicles. For these utilizations, it is essential to improve battery cells with a great life cycle because a battery substitute is costly. For their implementation in real applications, lithium-ion battery cells undergo extension during the course of discharging and charging. To avoid disconnection among battery pack ingredients and deformity during cycling, compacting force is exerted to battery packs in electric vehicles. This research used a mechanical design feature that can address these issues. This investigation exhibits a comprehensive description of the experimental setup that can be used for battery testing under pressure to consider lithium-ion batteries’ safety, which could be employed in electrified transportation. Besides, this investigation strives to demon-strate how exterior force affects a lithium-ion battery cell’s performance and behavior corresponding to static exterior force by monitoring the applied pressure at the dissimilar state of charge. Electrochemical impedance spectroscopy was used as the primary technique for this research. It was concluded that the profiles of the achieved spectrums from the experiments seem entirely dissimilar in comparison with the cases without external pressure. By employing electrochemical impedance spectroscopy, it was noticed that the pure ohmic resistance, which is related to ion transport resistance of the separator, could substantially result in the corresponding resistance increase.","author_count":3,"contributors":["Madani, Seyed Saeed","Schaltz, Erik","Kær, Søren Knudsen"],"cuid":["S01-000.00-120411"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Madani, Seyed Saeed"],"keyword":["Electrochemical impedance spectroscopy","Lithium ion battery cell"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"characterization of the compressive load on a lithium ion battery for electric vehicle application","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.3390/machines9040071","version":"Published Version"},"id":"S01-000.00-120411","identifier":[{"id":"85103972922","type":"scopus"}],"ids":["aau-f1fcbc09-b522-481a-953c-739858dd5dab"],"keyword":["Electrochemical impedance spectroscopy","External compressive loads","Lithium-ion battery cell"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-2CC17694C0175647F50217A5851E7AD0"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/444704864/machines_09_00071_v2.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.3390/machines9040071","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, AAU Energy","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Thermal Engineering"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Seyed Saeed","key":"madanipau","last":"Madani","locid":"2b964c98-f205-4a96-8e1c-e2433090f82a","name":"Madani, Seyed Saeed","orcid":"0000-0003-1636-3554","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Erik","key":"schaltzpau","last":"Schaltz","locid":"6e39b31c-c3fa-470a-b47b-e69ee21195c1","name":"Schaltz, Erik","orcid":"0000-0002-8540-0040","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren Knudsen","key":"kærpau","last":"Kær","locid":"898d6584-ec2e-430a-b78d-e3e0d670dcdd","name":"Kær, Søren Knudsen","orcid":"0000-0003-2151-8055","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.3390/machines9040071","issn":["20751702"],"issue":"4","journal":"Machines","paperid":"71","publisher":"Multidisciplinary Digital Publishing Institute","status":"p","title":"Machines","volume":"9"},"review":"Peer Reviewed","scoID":["2-s2.0-85103972922"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-f1fcbc09-b522-481a-953c-739858dd5dab"],"src":["AAU Aalborg University"],"title":"Characterization of the compressive load on a lithium-ion battery for electric vehicle application","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-120411","year":"2021","yearsub":"2021"}
{"abstract":"The Danish government launched a new National Quality Programme (NQP) in healthcare in 2015. It has changed the focus from old public management in terms of accreditation, regulation, rules and standards to new public governance focusing on delivering high quality healthcare and outcomes of value for the patients, health professionals and the Danish healthcare system. The NQP aims to strengthen the focus on continuous quality improvement and the launch of the programme was accompanied by a decision to phase out accreditation of public hospitals. The NQP includes 1) eight specific national quality goals, 2) a national educational programme for quality management, and 3) establishment of quality improvement collaboratives. Since the establishment of the NQP the indicator results have improved in several important clinical areas. However, causal conclusions related to the effect of the NQP cannot yet be made. This perspective on quality paper aims to give a short introduction to the NQP and documented outcomes.","author_count":7,"contributors":["Uggerby, Christian","Kristensen, Solvejg","Mackenhauer, Julie","Knudsen, Søren Valgreen","Bartels, Paul","Johnsen, Søren Paaske","Mainz, Jan"],"cuid":["S02-094.12-001110"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Asia, Middle East","OECD"],"corresponding_author":["Uggerby, Christian"],"country":["Israel"],"glorg":["All Global Affiliations","University of Haifa"],"keyword":["Healthcare system","Measurement of quality","Quality Improvement"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-NDR"],"OT":["Regionernes Kliniske Kvalitetsudviklingsprogram (RKKP)"],"U":["DI-U-AAU","DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-NDR","DI-U-AAU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"from accreditation to quality improvement the danish national quality programme","src":["aau","sdu"],"src-code":["DI-U-AAU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85105835551&partnerID=8YFLogxK","version":"Other Version"},"id":"S02-094.12-001110","identifier":[{"id":"33861335","type":"pmid"},{"id":"85105835551","type":"scopus"}],"ids":["aau-15a0a9c5-8d2c-4b87-99b1-932f2670c684","sdu-e6e761b1-fa1f-400e-9b77-2814158ce005"],"keyword":["healthcare system","measurement of quality","quality improvement"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-FA19F2251EE11FEC0AD6621C6F86E9B1"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Psychiatry"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"dk","key":"north denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-NDR","l3nl":"North Denmark Region","l3nn":"North Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"North Denmark Region","namevar":["Psykiatrien i Region Nordjylland"],"nora_code":"DI-HO-NDR","used":1},{"affno":"3","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Regionernes Kliniske Kvalitetsudviklingsprogram (RKKP)"],"nora_code":"DI-OT","used":1},{"affno":"4","country":"dk","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["University of Southern Denmark"],"nora_code":"DI-U-SDU","used":1},{"affno":"5","country":"il","key":"university of haifa","loc":["Israel","Asia, Middle East","OECD"],"name":"University of Haifa","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Christian","key":"uggerbypau","last":"Uggerby","locid":"c0b5eaf2-90e3-4b17-8577-6aaaccade905","name":"Uggerby, Christian","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Solvejg","key":"kristensenpau","last":"Kristensen","locid":"3b3df3f7-8f5b-4973-a4c5-9634f87a6473","name":"Kristensen, Solvejg","rank":2,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Julie","key":"mackenhauerpau","last":"Mackenhauer","locid":"a2416ac8-315b-4cb0-91a6-a962890a59c6","name":"Mackenhauer, Julie","orcid":"0000-0001-7155-4105","rank":3,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Søren Valgreen","key":"knudsenpau","last":"Knudsen","locid":"d59094b5-44a6-4398-9acf-f3f530e0504b","name":"Knudsen, Søren Valgreen","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Paul","key":"bartelspau","last":"Bartels","name":"Bartels, Paul","rank":5,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Søren Paaske","key":"johnsenpau","last":"Johnsen","locid":"c3e8b374-a343-484a-a10d-e6550efbb8dc","name":"Johnsen, Søren Paaske","orcid":"0000-0002-2787-0271","rank":6,"rolecode":"pau"},{"affno":"1 4 5 2","corresponding":null,"country":"dk","first":"Jan","key":"mainzpau","last":"Mainz","locid":"fadbea42-81be-48a2-afb2-c868f9dfa4f5","name":"Mainz, Jan","orcid":"0000-0003-0242-9233","rank":7,"rolecode":"pau"}],"pmid":["33861335"],"pub":{"doi":"10.1093/intqhc/mzab071","issn":["13534505","14643677"],"issn_org":["13534505"],"issue":"2","journal":"International Journal for Quality in Health Care","paperid":"mzab071","publisher":"Oxford University Press","status":"p","title":"International Journal for Quality in Health Care","volume":"33"},"review":"Peer Reviewed","scoID":["2-s2.0-85105835551"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","North Denmark Region","Other Research","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-15a0a9c5-8d2c-4b87-99b1-932f2670c684","sdu-e6e761b1-fa1f-400e-9b77-2814158ce005"],"src":["AAU Aalborg University","SDU University of Southern Denmark"],"title":"From accreditation to quality improvement-The Danish National Quality Programme","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-094.12-001110","year":"2021","yearsub":"2021"}
{"abstract":"Aims: To observe and report population demography, comorbidities, risk factor levels and risk factor treatment in a sample of individuals treated for type 2 diabetes in primary care in Norway, Sweden and Denmark. Methods: Retrospective observational cohort using extraction of data from electronic medical records linked with national health care registries. Results: Sixty primary care clinics participated with annual cross-sectional data (2003 to 2015). In 2015 the sample consisted of 31,632 individuals. Mean age (64.5–66.8 years) and proportion of women (43–45%) were similar. The prevalence of cardiovascular disease in 2015 was 40.7%, 41.6% and 38.0% for Norway, Sweden and Denmark, respectively and 84% to 89% of patients were receiving a pharmacological anti-diabetic treatment. More Danish patients reached targets for HbA1c and LDL cholesterol, while more patients in Sweden and Denmark met the blood pressure target of <130/80 mmHg as compared to Norway. Conclusions: In three comparable public primary health care systems we found a high prevalence of cardiovascular disease and differences in risk factor treatment and attainment of risk factor goals. With recent guideline changes there is potential for further prevention of diabetes complications in primary care in the future.","author_count":11,"contributors":["Knudsen, Søren Tang","Bodegård, Johan","Birkeland, Kåre I.","Furuseth, Kristian","Thuresson, Marcus","Lindh, Anders","Nilsson, Peter M.","Alvarsson, Michael","Jørgensen, Marit Eika","Søndergaard, Jens","Persson, Frederik"],"cuid":["S02-100.00-024214"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Persson, Frederik"],"country":["Norway","Sweden","United Kingdom"],"glorg":["All Global Affiliations","AstraZeneca","AstraZeneca UK","Karolinska Institute","Karolinska Institutet","Lund University","Oslo University Hospital","Solli Klinikk","Statisticon AB","University of Oslo","Åkersberga"],"keyword":["Aged","Blood Pressure","Cholesterol","Cross Sectional Studies","Diabetes Mellitus Type 2 diagnosis","Disease","Female","Glycated Hemoglobin A analysis","HBA 1C","HbA","Humans","Male","Middle Aged","Nationwide","Prevalence","Primary Health Care","Primary care","Retrospective Studies","Risk Factors","Treatment","Type 2 diabetes"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR","DI-HO-STENO"],"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-HO-CDR","DI-HO-STENO","DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"risk factor management of type 000000000002 diabetic patients in primary care in the scandinavian countries between 000000002003 and 000000002015","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.pcd.2020.09.006","version":"Published Version"},"funding_acknowledgement":["STK reports having received research grants from AstraZeneca and lecture fees from Boehringer Ingelheim, MSD, Novo Nordisk, and Sanofi and having served as a consultant for Boehringer Ingelheim, MSD, Mundipharma, Novo Nordisk, and Sanofi. JB holds a full-time position at AstraZeneca as an epidemiologist. KIB has received grants to his institution from AstraZeneca for this study and for lectures and consulting from Novo Nordisk, Sanofi, Lilly, Boehringer Ingelheim and Merck Sharp & Dohme. MT is employed by an independent statistical consultant company, Statisticon AB, Uppsala, Sweden, of which AstraZeneca Nordic-Baltic is a client. MEJ holds shares in Novo Nordisk and has received grants and lecture fees from Astra Zeneca. FP reports having received research grants from AstraZeneca and Novartis and lecture fees from Novartis, Eli Lilly, MSD, Sanofi, AstraZeneca and Boehringer Ingelheim and having served as a consultant for Astra Zeneca, Amgen, Novo Nordisk, Boehringer Ingelheim and MSD. The rest of the authors reports no conflicts of interest."],"id":"S02-100.00-024214","identifier":[{"id":"85092164643","type":"scopus"},{"id":"000631703500011","type":"wos"},{"id":"33032936","type":"pmid"}],"ids":["au-9e16cfc9-fc14-4cce-9200-fdfa97dc6426","sdu-3b0f4b9a-812a-4775-aa59-cce08fc221e9"],"keyword":["Aged","Blood pressure","Cholesterol","Cross-Sectional Studies","DISEASE","Diabetes Mellitus, Type 2/diagnosis","Female","Glycated Hemoglobin A/analysis","HbA","HbA(1c)","Humans","Male","Middle Aged","NATIONWIDE","PREVALENCE","Primary Health Care","Primary care","Retrospective Studies","Risk Factors","Treatment","Type 2 diabetes"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-65615136E398706831164848A8A5B75D"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/181454919/Knudsen_2020_Risk_factor_management_of_type_dia.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://pure.au.dk/ws/files/274245811/1_s2.0_S1751991820302837_main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.pcd.2020.09.006","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - SDCA-Steno Diabetes Center Aarhus"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"