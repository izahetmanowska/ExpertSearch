003-2172-705X","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren Paaske","key":"johnsenpau","last":"Johnsen","locid":"c3e8b374-a343-484a-a10d-e6550efbb8dc","name":"Johnsen, Søren Paaske","orcid":"0000-0002-2787-0271","rank":12,"rolecode":"pau"},{"affno":"","first":"Nanna","key":"kurebiegelpedh","last":"Kure-Biegel","name":"Kure-Biegel, Nanna","rank":13,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Hanne","key":"agerbakpedh","last":"Agerbak","name":"Agerbak, Hanne","rank":14,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Mickael","key":"bechpedh","last":"Bech","name":"Bech, Mickael","rank":15,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Jan","key":"mainzpedh","last":"Mainz","name":"Mainz, Jan","rank":16,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Inge","key":"kristensenpedh","last":"Kristensen","name":"Kristensen, Inge","rank":17,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"eisbn":["9788799483037"],"isbn":["9788799483020"],"pages":"88-99","publisher":"Dansk Selskab for Patientsikkerhed med støtte fra Dansk Selskab for Kvalitet i Sundhedsvæsenet (DSKS)","status":"p","subtitle":"Håb er ikke en strategi","title":"Kvalitet og patientsikkerhed under covid-19","volume":"1"},"review":"Undetermined","search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Universities"],"PST":["Published"]},"sid":["aau-93d8528e-01c4-43ec-ac16-5970f8b79e83"],"src":["AAU Aalborg University"],"title":"Forudsigelse af covid-19-belastningen på sundhedssystemet i regioner og kommuner","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-092919","year":"2021","yearsub":"2021"}
{"abstract":"I dette notat gengiver vi delresultater fra en spørgeskemaundersøgelse gennemført i foråret 2019 blandt 8. og 9. klasses folkeskoleelever i Aalborg Kommune med fokus på folkeskoleelevernes selvvurderede faglige udbytte fra de nationale test. ’Fagligt udbytte’ er i undersøgelsen defineret gennem et spørgsmål om, i hvilken grad den enkelte folkeskoleelev vurderer de nationale test er med til at styrke/udvikle eget faglige niveau. I forlængelse heraf undersøger vi sammenhænge mellem det faglige udbytte fra de nationale test og centrale variable i form af lærernes tilgang til de nationale test, det fagligt niveau hos eleverne og køn. Lidt mere end to ud af tre elever vurderer, at de ’slet ikke’ (44,3%) eller ’i mindre grad’ (24,7%) oplever, at de nationale test er med til at styrke/udvikle deres faglige niveau. Omvendt er det omkring en ud af fire elever, der vurderer at de enten ’i nogen grad’ (18,8%) eller ’i høj grad’ (5,2%) eller ’i meget høj grad’ (1,5%) oplever at de nationale test er med til at styrke/udvikle deres faglige niveau. En mindre gruppe (5,6%) vurderer, at de ikke ved om deres faglige niveau styrkes/udvikles. Analysen indikerer endvidere at de nationale test og en mere positiv til gang hos lærerne overvejende gavner de fagligt stærke elever og dermed kan være med til at udbygge og forstærke allerede eksisterende faglige forskelle mellem fagligt svage og stærke folkeskoleelever.","author_count":3,"contributors":["Eriksen, Tobias Bøgeskov","Lindholst, Andrej Christian","Knudsen, Søren Valgreen"],"cuid":["S01-000.00-122116"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Aalborg Kommune","Folkeskoleelever","Læring","Nationale test"],"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Aalborg Municipality"],"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"nr","rtype":["clu"],"sorti":"arbejdsnotat folkeskoleelevers selvvurderede faglige udbytte fra de nationale test resultater fra en spørgeskemaundersøgelse","src":["aau"],"src-code":["DI-U-AAU"],"type":"dw","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/439278214/Arbejdsnotat_2021_Nationale_test_og_elevers_faglige_udbytte_V1_1.pdf","version":"Published Version"},"id":"S01-000.00-122116","ids":["aau-f81a2ff5-bea1-4c4b-ab98-2a07fbdf0ca6"],"keyword":["Aalborg Kommune","Folkeskoleelever","Læring","Nationale test"],"lang":"Danish","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-ABA6CAF93F3F0A34A266663216806F20"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/439278214/Arbejdsnotat_2021_Nationale_test_og_elevers_faglige_udbytte_V1_1.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Aalborg Municipality"],"nora_code":"DI-OT","used":1},{"affno":"2","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Social Sciences","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Politics and Society","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Politics and Society, COMA (DPS)"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Tobias Bøgeskov","key":"eriksenpau","last":"Eriksen","name":"Eriksen, Tobias Bøgeskov","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Andrej Christian","key":"lindholstpau","last":"Lindholst","locid":"c5126b02-afdf-4131-91e2-90c30307d87b","name":"Lindholst, Andrej Christian","orcid":"0000-0001-8301-6187","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Søren Valgreen","key":"knudsenpau","last":"Knudsen","locid":"d59094b5-44a6-4398-9acf-f3f530e0504b","name":"Knudsen, Søren Valgreen","rank":3,"rolecode":"pau"}],"pub":{"publisher":"Institut for Politik og Samfund, Aalborg Universitet","status":"p"},"review":"No Review","sdg":["4. Quality Education","All UN SDG Classification"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["aau-f81a2ff5-bea1-4c4b-ab98-2a07fbdf0ca6"],"src":["AAU Aalborg University"],"title":"Arbejdsnotat: Folkeskoleelevers selvvurderede faglige udbytte fra de nationale test : Resultater fra en spørgeskemaundersøgelse","type":"Working Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-122116","year":"2021","yearsub":"2021"}
{"abstract":"Aims: As part of the SURE programme, SURE Denmark/Sweden aimed to study the real-world use of once-weekly (OW) semaglutide in adults with type 2 diabetes (T2D) in Denmark/Sweden. Methods: SURE Denmark/Sweden was an ∼30-week, prospective, multicentre, open-label, observational study, enrolling adults with T2D and ≥1 documented HbA1c value ≤12 weeks before initiating semaglutide at their physician's discretion. Primary (change in HbA1c) and secondary (including change in body weight, glycaemic and weight-loss target achievement) endpoints were assessed between baseline and end of study (EOS). Results: Of the 331 patients initiating semaglutide, 282 (85%) completed the study on treatment. For the latter, estimated mean changes [95% confidence interval] in HbA1c and body weight between baseline and EOS were –1.2 [–1.3; –1.1]%-points (–13 [–14; –12] mmol/mol) and –5.4 [–6.0; –4.7] kg (both p < 0.0001), respectively, with similar results in Denmark and Sweden. At EOS, 67.5% of patients achieved HbA1c <7%; 49.4% achieved a weight reduction of ≥5%. Reported adverse events were consistent with the known safety profile of semaglutide. Conclusions: In routine clinical practice in Denmark/Sweden, use of OW semaglutide was associated with glycaemic and weight-loss benefits in a wide range of adults with T2D, supporting real-world use. ClinicalTrials.gov Identifier: NCT03648281.","author_count":8,"contributors":["Rajamand Ekberg, Neda","Bodholdt, Ulrik","Catarig, Andrei Mircea","Catrina, Sergiu Bogdan","Grau, Katrine","Holmberg, Cecilia Nagorny","Klanger, Boris","Knudsen, Søren Tang"],"cuid":["S01-000.00-248172"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"corresponding_author":["Rajamand Ekberg, Neda"],"country":["Sweden"],"glorg":["All Global Affiliations","Karolinska Institutet"],"keyword":["ADD ON","Adult","Body Weight","Denmark","Diabetes Mellitus Type 2 diagnosis","Efficacy","Glucagon Like Peptides therapeutic use","Glucagon like peptide 1 receptor agonist","Glycated Hemoglobin A analysis","HBA 1C","HbA","Humans","Hypoglycemic Agents therapeutic use","MELLITUS","Metformin","Open label","PHASE 3A","Prospective Studies","Real world evidence","Safety","Semaglutide","Sweden","Treatment Outcome","Type 2 diabetes"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-PR","DI-U"],"level3":{"OT":["Unspecified organisation"],"PR":["DI-PR-ALL","DI-PR-NOVO"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-PR-NOVO","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"real world use of once weekly semaglutide in patients with type 000000000002 diabetes results from the sure denmark sweden multicentre prospective observational study","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.pcd.2021.06.008","version":"Published Version"},"id":"S01-000.00-248172","identifier":[{"id":"000697686000020","type":"wos"},{"id":"34183269","type":"pmid"},{"id":"85108863022","type":"scopus"}],"ids":["au-cffaad6f-ca2e-4382-beb1-58fadb56ffe2"],"keyword":["56-WEEK","ADD-ON","Adult","Body weight","Denmark","Diabetes Mellitus, Type 2/diagnosis","EFFICACY","Glucagon-Like Peptides/therapeutic use","Glucagon-like peptide-1 receptor agonist","Glycated Hemoglobin A/analysis","HbA","HbA(1c)","Humans","Hypoglycemic Agents/therapeutic use","MELLITUS","METFORMIN","OPEN-LABEL","PHASE 3A","Prospective Studies","Real-world evidence","SAFETY","SURE study","Semaglutide","Sweden","Treatment Outcome","Type 2 diabetes"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-0B1681C58F1D513D8054D8968C3F913E"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.pcd.2021.06.008","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.au.dk/ws/files/274251141/1_s2.0_S1751991821001121_main.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"se","key":"karolinska institutet","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Karolinska Institutet","used":1},{"affno":"2","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1},{"affno":"3","country":"dk","key":"novo nordisk","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-NOVO","l3nl":"Novo Nordisk","l3nn":"Novo Nordisk","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Novo Nordisk","namevar":["Novo Nordisk A/S"],"nora_code":"DI-PR-NOVO","used":1},{"affno":"4","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - SDCA-Steno Diabetes Center Aarhus"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Neda","key":"rajamandekbergpau","last":"Rajamand Ekberg","name":"Rajamand Ekberg, Neda","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ulrik","key":"bodholdtpau","last":"Bodholdt","name":"Bodholdt, Ulrik","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Andrei Mircea","key":"catarigpau","last":"Catarig","name":"Catarig, Andrei Mircea","rank":3,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Sergiu Bogdan","key":"catrinapau","last":"Catrina","name":"Catrina, Sergiu Bogdan","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Katrine","key":"graupau","last":"Grau","name":"Grau, Katrine","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Cecilia Nagorny","key":"holmbergpau","last":"Holmberg","name":"Holmberg, Cecilia Nagorny","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Boris","key":"klangerpau","last":"Klanger","name":"Klanger, Boris","rank":7,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"Søren Tang","key":"knudsenpau","last":"Knudsen","locid":"f4fb113c-f8d2-4bb3-9a9d-0bc2ef14590d","name":"Knudsen, Søren Tang","rank":8,"rolecode":"pau"}],"pmid":["34183269"],"pub":{"doi":"10.1016/j.pcd.2021.06.008","issn":["17519918","18780210"],"issn_org":["17519918"],"issue":"5","journal":"Primary Care Diabetes","pages":"871-878","publisher":"Elsevier Ltd","status":"p","title":"Primary Care Diabetes","volume":"15"},"review":"Peer Reviewed","scoID":["2-s2.0-85108863022"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Private Research","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Miscellaneous","Novo Nordisk","Other Research","Private Research","Universities"],"PST":["Published"]},"sid":["au-cffaad6f-ca2e-4382-beb1-58fadb56ffe2"],"src":["AU Aarhus University"],"title":"Real-world use of once-weekly semaglutide in patients with type 2 diabetes : Results from the SURE Denmark/Sweden multicentre, prospective, observational study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-248172","year":"2021","yearsub":"2021"}
{"abstract":"Background: Streptococcus pneumoniae (S. pneumoniae) and Hemophilus influenzae (H. influen-zae) are among the main vaccine-preventable bacterial infections in immunocompromised individuals including solid organ transplant (SOT) recipients. There is a lack of information about incidence and outcomes of these infections in SOT recipients. Methods: We determined the incidence of S. pneumoniae and H. influenzae, the related hospitalization, and 30-and 180-days mortality in a large cohort of 1182 adult SOT recipients. We calculated 95% confidence intervals (CI) of incidence rate (IR) using Byar’s approximation to the Poisson distribution. Results: The overall IR of S. pneumoniae and H. influenzae were 1086 (95% CI, 796–1448) and 1293 (95% CI, 974–1687) per 100,000 person-years of follow-up (PYFU), respectively. The IR of invasive infections were 76 (95% CI, 21–202) and 25 (95% CI, 2.3–118) per 100,000 PYFU, respectively. Hospital admission was required in >50%, 30-days mortality was 0, and 180-days mortality was 8.8% and 4.5% after S. pneumoniae and H. influenzae infections, respectively. Conclusions: The IR of invasive S. pneumoniae and H. influenzae infections in SOT recipients were much higher than reports from the general population in Denmark. Furthermore, a large proportion of infected SOT recipients were hospitalized. These findings highlight the need for further studies to assess uptake and immunogenicity of vaccines against S. pneumoniae and H. influenzae in SOT recipients.","author_count":11,"contributors":["Rezahosseini, Omid","Møller, Dina Leth","Sørensen, Søren Schwartz","Perch, Michael","Gustafsson, Finn","Gelpi, Marco","Knudsen, Jenny Dahl","Helleberg, Marie","Rasmussen, Allan","Nielsen, Susanne Dam","Harboe, Zitta Barrella"],"cuid":["S01-000.00-408462"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Hospitalization","Incidence","Mortality","Organ transplant","Streptococcus pneumoniae"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"an observational prospective cohort study of incidence and outcome of streptococcus pneumoniae and hemophilus influenzae infections in adult solid organ transplant recipients","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/microorganisms9071371","version":"Published Version"},"id":"S01-000.00-408462","identifier":[{"id":"34202542","type":"pmid"},{"id":"85108440165","type":"scopus"},{"id":"PMC8304095","type":"pmcid"}],"ids":["ku-191ad6c3-38c9-4e97-aedc-7f39d3eb06d1"],"keyword":["Hemophilus influenzae","Hospitalization","Incidence","Invasive pneumococcal diseases","Mortality","Organ transplant","Streptococcus pneumoniae"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-B97461121F4CAB32F3B692F96F19945D"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/microorganisms9071371","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/273067950/microorganisms_09_01371.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Omid","key":"rezahosseinipau","last":"Rezahosseini","locid":"25f086c7-0215-450d-a148-0fd4745377ea","name":"Rezahosseini, Omid","orcid":"0000-0003-2198-1904","rank":1,"rolecode":"pau"},{"affno":"1","first":"Dina Leth","key":"møllerpau","last":"Møller","locid":"8d5cc577-14db-4efa-9db9-72b979611644","name":"Møller, Dina Leth","rank":2,"rolecode":"pau"},{"affno":"1","first":"Søren Schwartz","key":"sørensenpau","last":"Sørensen","locid":"115ed8b6-8f6c-468a-9217-994613816c8e","name":"Sørensen, Søren Schwartz","rank":3,"rolecode":"pau"},{"affno":"1","first":"Michael","key":"perchpau","last":"Perch","locid":"e0a136a6-8b36-4735-9db2-8847ce581fc6","name":"Perch, Michael","rank":4,"rolecode":"pau"},{"affno":"1","first":"Finn","key":"gustafssonpau","last":"Gustafsson","locid":"6716eef1-891b-4209-a823-e96e765b9433","name":"Gustafsson, Finn","rank":5,"rolecode":"pau"},{"affno":"1","first":"Marco","key":"gelpipau","last":"Gelpi","name":"Gelpi, Marco","rank":6,"rolecode":"pau"},{"affno":"1","first":"Jenny","key":"knudsenpau","last":"Knudsen","locid":"ace82a97-ed40-44ae-9619-37b98fdaf285","name":"Knudsen, Jenny Dahl","name_org":"Knudsen, Jenny","rank":7,"rolecode":"pau"},{"affno":"","first":"Marie","key":"hellebergpau","last":"Helleberg","name":"Helleberg, Marie","rank":8,"rolecode":"pau"},{"affno":"","first":"Allan","key":"rasmussenpau","last":"Rasmussen","name":"Rasmussen, Allan","rank":9,"rolecode":"pau"},{"affno":"","first":"Susanne Dam","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Susanne Dam","rank":10,"rolecode":"pau"},{"affno":"","first":"Zitta Barrella","key":"harboepau","last":"Harboe","name":"Harboe, Zitta Barrella","rank":11,"rolecode":"pau"}],"pmid":["34202542"],"pub":{"doi":"10.3390/microorganisms9071371","issn":["20762607"],"issue":"7","journal":"Microorganisms","paperid":"1371","status":"p","title":"Microorganisms","volume":"9"},"review":"Peer Reviewed","scoID":["2-s2.0-85108440165"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-191ad6c3-38c9-4e97-aedc-7f39d3eb06d1"],"src":["KU University of Copenhagen"],"title":"An observational prospective cohort study of incidence and outcome of streptococcus pneumoniae and hemophilus influenzae infections in adult solid organ transplant recipients","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-408462","year":"2021","yearsub":"2021"}
{"abstract":"Importance: Otorhinolaryngology is considered one of the medical specialties with a high risk for exposure to corona disease 2019 (COVID-19). Uncontrolled transmission in a hospital department poses a risk to both healthcare workers (HCWs) and patients. Objective: To monitor SARS-CoV-2 incidence, transmission, and antibody development among HCWs to identify high risk procedures, pathways, and work areas within the department. Methods: Prospective cohort study of HCWs using repetitive oro- and nasopharygeal swab samples, antibody tests, and self-reported symptoms questionnaires at a tertiary referral center in Copenhagen, Denmark. Results: 347/361 (96%) HCWs participated. Seven (1.9%) were positive on swab tests and none had symptoms. Fifteen (4.2%) developed antibodies. Only one case of potential transmission between HCWs was identified. Infection rates were low and no procedures or areas within the department were identified as exposing HCWs to a higher risk. Conclusions and relevance: Adherence to the surveillance program was high. The low incidence among HCW during the first wave of the COVID-19 pandemic may reflect local transmission and infection control precautions, as well as a low infectious burden in the Danish society.","author_count":10,"contributors":["Rasmussen, Kasper Møller Boje","Andersen, Peter Anders","Channir, Hani Ibrahim","Aanaes, Kasper","Knudsen, Jenny Dahl","Kirkeby, Nikolai Søren","Klokker, Mads","von Buchwald, Christian","Cayé-Thomasen, Per","Jensen, Ramon Gordon"],"cuid":["S01-000.00-497770"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Coronavirus","Covid 19","Healthcare worker","Otorhinolaryngology","Protective measures","SARS CoV 2"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"covid 000000000019 infection rate among tertiary referral center otorhinolaryngology healthcare workers","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"https://www.ncbi.nlm.nih.gov/pmc/about/copyright/","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC7862982/pdf/405_2021_Article_6615.pdf","version":"Published Version"},"id":"S01-000.00-497770","identifier":[{"id":"85100548233","type":"scopus"},{"id":"33544196","type":"pmid"},{"id":"PMC7862982","type":"pmcid"}],"ids":["ku-aeaece34-35f9-483d-8daa-dc5a5a4e852f"],"keyword":["COVID-19","Coronavirus","Healthcare worker","Otorhinolaryngology","Protective measures","SARS-CoV-2"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-D8A7D57C42C60BB3DC941D235D311FF5"],"oa_link":[{"access":"oa","license":"https://www.ncbi.nlm.nih.gov/pmc/about/copyright/","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC7862982/pdf/405_2021_Article_6615.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Kasper Møller Boje","key":"rasmussenpau","last":"Rasmussen","name":"Rasmussen, Kasper Møller Boje","rank":1,"rolecode":"pau"},{"affno":"","first":"Peter Anders","key":"andersenpau","last":"Andersen","name":"Andersen, Peter Anders","rank":2,"rolecode":"pau"},{"affno":"","first":"Hani Ibrahim","key":"channirpau","last":"Channir","name":"Channir, Hani Ibrahim","rank":3,"rolecode":"pau"},{"affno":"1","first":"Kasper","key":"aanæspau","last":"Aanæs","locid":"8bf39677-0bde-4163-ae14-19cf5b84d4bf","name":"Aanaes, Kasper","name_org":"Aanæs, Kasper","rank":4,"rolecode":"pau"},{"affno":"1","first":"Jenny Dahl","key":"knudsenpau","last":"Knudsen","locid":"ace82a97-ed40-44ae-9619-37b98fdaf285","name":"Knudsen, Jenny Dahl","rank":5,"rolecode":"pau"},{"affno":"","first":"Nikolai Søren","key":"kirkebypau","last":"Kirkeby","name":"Kirkeby, Nikolai Søren","rank":6,"rolecode":"pau"},{"affno":"1","first":"Mads","key":"klokkerpau","last":"Klokker","locid":"be74f452-48e9-4e56-8de1-f0ed083b9c77","name":"Klokker, Mads","rank":7,"rolecode":"pau"},{"affno":"1","first":"Christian","key":"vonbuchwaldpau","last":"von Buchwald","locid":"fc76b0d1-1263-48f7-a4d0-685e60bbc1b6","name":"von Buchwald, Christian","orcid":"0000-0001-6753-8129","rank":8,"rolecode":"pau"},{"affno":"1","first":"Per","key":"cayéthomasenpau","last":"Cayé-Thomasen","locid":"51411e35-b4a9-4e04-b2ef-538ebf70b337","name":"Cayé-Thomasen, Per","rank":9,"rolecode":"pau"},{"affno":"1","first":"Ramon Gordon","key":"jensenpau","last":"Jensen","locid":"bbbd5d78-5cb2-4f8a-9cf2-e19601100ef9","name":"Jensen, Ramon Gordon","rank":10,"rolecode":"pau"}],"pmid":["33544196"],"pub":{"doi":"10.1007/s00405-021-06615-w","issn":["09374477","09428992"],"issn_org":["09374477"],"issue":"8","journal":"European Archives of Oto-Rhino-Laryngology","pages":"3091-3098","status":"p","title":"European Archives of Oto-Rhino-Laryngology","volume":"278"},"review":"Peer Reviewed","scoID":["2-s2.0-85100548233"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-aeaece34-35f9-483d-8daa-dc5a5a4e852f"],"src":["KU University of Copenhagen"],"title":"COVID-19 infection rate among tertiary referral center otorhinolaryngology healthcare workers","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-497770","year":"2021","yearsub":"2021"}
{"abstract":"Background: Preventing surgical site infections and prosthetic joint infections is crucial for patient safety after total joint arthroplasty. Microbial air contamination has been suggested as a risk factor. Therefore, the ventilation system that will reduce air contamination most effectively in operating theatres (OTs) has been discussed. Aim: To determine whether laminar airflow (LAF) ventilation is superior to turbulent airflow (TAF) ventilation by looking at the colony forming units (cfu) count during live total hip and knee arthroplasties. Furthermore, to explore whether the number of OT personnel, door and cabinet lock openings and technical parameters of the ventilation systems have an impact on the number of cfu. Methods: Active air sampling and passive sedimented bacterial load were performed in 17 OTs, equipped with either LAF or TAF ventilation, during 51 live surgeries while observations were noted. Findings: LAF OTs reduced cfu counts compared with TAF OTs during live surgery (P<0.001). All LAF OTs provided ultraclean air whereas TAF had nine procedures exceeding the threshold of 10 cfu/m3. Door and cabinet lock openings and number of personnel did not influence the cfu count, while it decreased with increasing volume and total air change per hour (P<0.05). Conclusion: All LAF OTs had cfu counts within recommendations and provided lower cfu counts compared with TAF OTs. The number of OT personnel and total openings did not have an influence on cfu counts. Increased volume of the OT and total air change per hour showed a decrease in active cfu counts.","author_count":9,"contributors":["Knudsen, R. J.","Knudsen, S. M.N.","Nymark, T.","Anstensrud, T.","Jensen, E. T.","La Mia Malekzadeh, M. J.","Overgaard, Søren"],"cuid":["S02-099.85-047195"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Knudsen, S. M.N."],"keyword":["Air quality","Colony forming units","Laminar airflow","Microbial air contamination","Operating theatre","Turbulent airflow"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-PR","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-SDR"],"PR":["DI-PR-ALL","DI-PR-NIRA"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-HO-SDR","DI-PR-NIRA","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"laminar airflow decreases microbial air contamination compared with turbulent ventilated operating theatres during live total joint arthroplasty a nationwide survey","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.jhin.2021.04.019","version":"Published Version"},"funding_acknowledgement":["This study was funded by ELFORSK, part of the Danish Energy Agency ."],"id":"S02-099.85-047195","identifier":[{"id":"33932555","type":"pmid"},{"id":"85106391058","type":"scopus"}],"ids":["ku-edd22926-361b-459e-8924-eabb1a15aea6","sdu-682f14c8-060d-4e29-aab9-24fd02fc0c90"],"keyword":["Air quality","Colony forming units","Laminar airflow","Microbial air contamination","Operating theatre","Turbulent airflow"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-D04285BC0A9A84FA188EDF2243702E1B"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/331490748/1_s2.0_S0195670121001705_main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.jhin.2021.04.019","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/199845316/1_s2.0_S0195670121001705_main.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021