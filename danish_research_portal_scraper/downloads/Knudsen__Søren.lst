e"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Søren Valgreen","key":"knudsenpau","last":"Knudsen","locid":"d59094b5-44a6-4398-9acf-f3f530e0504b","name":"Knudsen, Søren Valgreen","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"René Børge Korsgaard","key":"brundpau","last":"Brund","locid":"b2374431-6b1e-4efe-9345-01733ef94596","name":"Brund, René Børge Korsgaard","orcid":"0000-0002-7246-4811","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Signe Gitte","key":"hansenpau","last":"Hansen","locid":"57addda8-4f72-4b3e-b625-6455e9b65bdb","name":"Hansen, Signe Gitte","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Signe","key":"heuckendorffpau","last":"Heuckendorff","locid":"75999b0a-df86-4d41-8117-c07534083755","name":"Heuckendorff, Signe","orcid":"0000-0002-4074-064X","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kirsten","key":"fonagerpau","last":"Fonager","locid":"3afdf3d3-bf7d-451e-ac62-2d7a846eb9e8","name":"Fonager, Kirsten","orcid":"0000-0001-9641-992X","rank":5,"rolecode":"pau"}],"pub":{"pages":"18","publisher":"Aalborg Universitetshospital","status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-425dc070-2a97-4fbe-b1c9-e2b55f037e34"],"src":["AAU Aalborg University"],"title":"Mønstre i rehabiliteringsteamenes anbefalinger af indsatser indenfor social- og sundhedsforvaltningerne : En undersøgelse af rehabiliteringsteamsmøder i Region Nordjylland i perioden 01.09.2024 til 31.12.2024","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-804906","year":"2025","yearsub":"2025"}
{"abstract":"Sex hormones may contribute to the pathophysiology of Major Depressive Disorder (MDD) through effects on the serotonergic brain system. Estradiol is associated with serotonergic neurobiology in rodent models and humans across sexes. In healthy men, we have previously observed a negative association between testosterone and serotonin 4 receptor (5-HT4R) levels, a receptor implicated in depression and a promising novel antidepressant target. Here, we investigate the associations between sex hormone levels and 5-HT4R binding in unmedicated men with MDD compared to healthy men. We used a latent variable model to evaluate the association between estradiol and testosterone, and cerebral 5-HT4R binding based on [11C]SB207145 Positron Emission Tomography (PET) data from 25 males with MDD from the Neuropharm trial and 52 healthy males (aged 18–49), which included 38 healthy males from our previous study. As previously shown in the complete group of men and women with MDD from the Neuropharm trial, we here confirm that a lower cerebral 5-HT4R level is also observed in the male MDD population alone compared to healthy men (β = −0.07, p = 0.012). In addition to the previously shown negative association between global 5-HT4R levels and testosterone (β = −0.007, p = 0.006) in healthy men, we also observe a positive association with estradiol (β = 1.74, p = 0.001). However, we do not observe this in men with MDD (testosterone: β = 0.0001, p = 0.97; estradiol: β = 0.64, p=0.36). There was a trend towards a group difference in the association between testosterone and global 5-HT4R (β = 0.008, p = 0.082). In summary, we found evidence for a coupling between 5-HT4R and sex hormone levels in healthy men. This neuroendocrine connection appeared unclear in unmedicated men with depression, possibly due to a different and weaker coupling.","author_count":8,"contributors":["Aarestrup, Malene Ravn","Jensen, Kristian H.Reveles","Larsen, Søren V.","Ozenne, Brice","Köhler-Forsberg, Kristin","Knudsen, Gitte Moos","Jørgensen, Martin Balslev","Frokjaer, Vibe G."],"cuid":["S01-000.00-809470"],"filters":{"added":"2025-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["5 HT receptor","Estrogen","Major depressive disorder MDD","Positron emission tomography PET","Sex hormones","Testosterone"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"sex hormones and serotonin 000000000004 receptor brain binding in men with and without major depressive disorder","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.nsa.2025.105517","version":"Published Version"},"id":"S01-000.00-809470","identifier":[{"id":"86000584429","type":"scopus"}],"ids":["ku-34d91ea1-06f8-4c55-9fe7-181cfbe9bbc4"],"keyword":["5-HT receptor","Estrogen","Major depressive Disorder (MDD)","Positron emission tomography (PET)","Sex Hormones","Testosterone"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-02E863786CE894BCEF331023C866EE93"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.nsa.2025.105517","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/437538431/1-s2.0-S2772408525001097-main.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet","Psychiatric Centre Copenhagen"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Biomedical Sciences, Teaching"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Malene Ravn","key":"aarestruppau","last":"Aarestrup","name":"Aarestrup, Malene Ravn","rank":1,"rolecode":"pau"},{"affno":"1 2","first":"Kristian H.","key":"revelesjensenpau","last":"Reveles Jensen","locid":"f211bd71-e4a8-442e-8fb3-6fed293b9782","name":"Jensen, Kristian H.Reveles","name_org":"Reveles Jensen, Kristian H.","orcid":"0000-0001-6117-4379","rank":2,"rolecode":"pau"},{"affno":"1 2","first":"Søren Vinther","key":"larsenpau","last":"Larsen","locid":"15f7f99a-0254-46d1-a47d-c8d6628f04b1","name":"Larsen, Søren V.","name_org":"Larsen, Søren Vinther","rank":3,"rolecode":"pau"},{"affno":"1 2","first":"Brice","key":"ozennepau","last":"Ozenne","locid":"52e17fb0-a702-4384-bb59-a3a09619877c","name":"Ozenne, Brice","rank":4,"rolecode":"pau"},{"affno":"1","first":"Kristin","key":"köhlerforsbergpau","last":"Köhler-Forsberg","name":"Köhler-Forsberg, Kristin","rank":5,"rolecode":"pau"},{"affno":"1 2","first":"Gitte Moos","key":"knudsenpau","last":"Knudsen","locid":"f02aee9e-69cf-491a-9765-ff062f734db8","name":"Knudsen, Gitte Moos","orcid":"0000-0003-1508-6866","rank":6,"rolecode":"pau"},{"affno":"1 2","first":"Martin Balslev","key":"jørgensenpau","last":"Jørgensen","locid":"dfc70acd-d15d-44f9-891e-6a7646d1727d","name":"Jørgensen, Martin Balslev","rank":7,"rolecode":"pau"},{"affno":"1 2","first":"Vibe G.","key":"frokjaerpau","last":"Frokjaer","locid":"ab1287b2-e920-4656-b4bc-1b7d3dffd2dc","name":"Frokjaer, Vibe G.","rank":8,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.nsa.2025.105517","issn":["27724085"],"journal":"Neuros