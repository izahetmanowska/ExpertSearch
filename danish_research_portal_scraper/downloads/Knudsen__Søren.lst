{"abstract":"I dette kapitel afdækkes nogle af dannelsespotentialerne i sprogfagene. Med udgangspunkt i en generel model for dannelse og med individualisering og globalisering som centrale tidstypiske tendenser bliver der givet perspektiver for og eksempler på hvordan dannelse kan integreres i undervisning i sprogfagene.","author_count":25,"contributors":["Balle, Søren Hattesen","Olsen, Merete","Pedersen, Michael Svendsen"],"cuid":["S01-000.00-565906"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Dannelse","Sprog"],"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U","DI-UC"],"level3":{"U":["DI-U-ALL","DI-U-RUC"],"UC":["DI-UC-AB","DI-UC-ALL"]},"level3all":["DI-U-RUC","DI-UC-AB"]},"review":"nr","rtype":["clu"],"sorti":"dannelse i og gennem sprogfagene","src":["ruc"],"src-code":["DI-U-RUC"],"type":"dba","type-grp":["all","pub"]},"id":"S01-000.00-565906","ids":["ruc-92cea9af-789a-456d-93cb-1e76596d7f10"],"keyword":["dannelse","sprog"],"lang":"Danish","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-4F54EE196578A06848AA43B303DDCDF0"],"org":[{"affno":"1","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, The Department of Culture and Identity"],"nora_code":"DI-U-RUC","used":1},{"affno":"2","country":"dk","key":"university college absalon","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-AB","l3nl":"University College Absalon","l3nn":"University College Absalon","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"University College Absalon","namevar":["University College Absalon"],"nora_code":"DI-UC-AB","used":1}],"person":[{"affno":"1","country":"dk","first":"Søren Hattesen","key":"ballepau","last":"Balle","locid":"