iversity of haifa","loc":["Israel","Asia, Middle East","OECD"],"name":"University of Haifa","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jeppe","key":"mainzjeppepau","last":"Mainz","locid":"f008df0f-398a-4f4d-82cf-90b1e93800cc","name":"Mainz, Jeppe","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren Valgreen","key":"knudsensørenvalgreenpau","last":"Knudsen","locid":"d59094b5-44a6-4398-9acf-f3f530e0504b","name":"Knudsen, Søren Valgreen","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren Paaske","key":"johnsensørenpaaskepau","last":"Johnsen","locid":"c3e8b374-a343-484a-a10d-e6550efbb8dc","name":"Johnsen, Søren Paaske","orcid":"0000-0002-2787-0271","rank":3,"rolecode":"pau"},{"affno":"1 2 3","corresponding":null,"country":"dk","first":"Jan","key":"mainzjanpau","last":"Mainz","locid":"fadbea42-81be-48a2-afb2-c868f9dfa4f5","name":"Mainz, Jan","orcid":"0000-0003-0242-9233","rank":4,"rolecode":"pau"},{"affno":"","first":"Jan","key":"mainzjanpedh","last":"Mainz","name":"Mainz, Jan","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Søren Paaske","key":"johnsensørenpaaskepedh","last":"Johnsen","name":"Johnsen, Søren Paaske","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"edition":"1","eisbn":["9788702384185"],"isbn":["9788762817814"],"pages":"41-59","publisher":"Munksgaard Forlag","status":"p","title":"Kvalitet og patientsikkerhed"},"review":"Undetermined","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-f46590e2-53dc-4ed3-b1ba-1b3cd9505ba9"],"src":["AAU Aalborg University"],"title":"Det evidensbaserede sundhedsvæsen","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-682089","year":"2023","yearsub":"2023"}
{"abstract":"Influenza is a common respiratory tract infection in solid organ transplant (SOT) recipients. We aimed to investigate the incidence, risk factors, and complications of influenza in a large cohort of kidney and liver transplant recipients over 10 consecutive seasons. We conducted a retrospective study, including 378 liver and 683 kidney transplant recipients who were transplanted from January 1, 2010, to October 1, 2019. The data on influenza were retrieved from MiBa, which is a nationwide database that contains all of the microbiology results in Denmark. Clinical data were retrieved from patient records. Incidence rates and cumulative incidences were calculated, and risk factors were investigated using time-updated Cox proportional hazards models. The cumulative incidence of influenza in the first 5 years posttransplantation was 6.3% (95% CI: 4.7 to 7.9%). Of the 84 influenza positive recipients, 63.1% had influenza A, 65.5% were treated with oseltamivir, 65.5% were hospitalized, and 16.7% developed pneumonia. There were no significant differences in outcomes when comparing patients with influenza A and B. We found no significant effect of same-season influenza vaccination, sex, age, or comorbidities on the risk of acquiring influenza. The incidence of influenza in kidney and liver recipients is high, and 65.5% of infected transplant recipients required hospitalization. We were not able to confirm a reduction in influenza incidence or in the risk of complications associated with vaccination.","author_count":8,"contributors":["Arentoft, Nicoline Stender","Møller, Dina Leth","Knudsen, Andreas Delhbæk","Abdulovski, Ranya","Kirkby, Nikolai","Sørensen, Søren Schwartz","Rasmussen, Allan","Nielsen, Susanne Dam"],"cuid":["S01-000.00-690289"],"filters":{"added":"2023-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Influenza","Kidney Transplantation","Liver Transplantation","Risk Factors","Transplantation","Vaccines"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"influenza in liver and kidney transplant recipients incidence and outcomes","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1128/spectrum.03226-22","version":"Published Version"},"id":"S01-000.00-690289","identifier":[{"id":"85158048613","type":"scopus"},{"id":"PMC10101112","type":"pmcid"},{"id":"36976014","type":"pmid"}],"ids":["ku-bb3a4b68-e65c-469b-b963-6d070ac089b7"],"keyword":["influenza","kidney transplantation","liver transplantation","medical outcomes","risk factors","transplantation","vaccines"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-AD1AF1D3E2467795AF8F91CE00923209"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1128/spectrum.03226-22","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/366495192/spectrum.03226_22.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Internal Medicine: Nephrology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Nicoline Stender","key":"arentoftpau","last":"Arentoft","name":"Arentoft, Nicoline Stender","rank":1,"rolecode":"pau"},{"affno":"1","first":"Dina Leth","key":"møllerpau","last":"Møller","name":"Møller, Dina Leth","rank":2,"rolecode":"pau"},{"affno":"1","first":"Andreas Delhbæk","key":"knudsenpau","last":"Knudsen","name":"Knudsen, Andreas Delhbæk","rank":3,"rolecode":"pau"},{"affno":"1","first":"Ranya","key":"abdulovskipau","last":"Abdulovski","name":"Abdulovski, Ranya","rank":4,"rolecode":"pau"},{"affno":"1","first":"Nikolai","key":"kirkbypau","last":"Kirkby","name":"Kirkby, Nikolai","rank":5,"rolecode":"pau"},{"affno":"2","first":"Søren Schwartz","key":"sørensenpau","last":"Sørensen","locid":"115ed8b6-8f6c-468a-9217-994613816c8e","name":"Sørensen, Søren Schwartz","rank":6,"rolecode":"pau"},{"affno":"1","first":"Allan","key":"rasmussenpau","last":"Rasmussen","name":"Rasmussen, Allan","rank":7,"rolecode":"pau"},{"affno":"2","first":"Susanne Dam","key":"nielsenpau","last":"Nielsen","locid":"2baa36fa-2709-482a-9595-52c5b9537801","name":"Nielsen, Susanne Dam","rank":8,"rolecode":"pau"}],"pmid":["36976014"],"pub":{"doi":"10.1128/spectrum.03226-22","issn":["21650497"],"issue":"2","journal":"Microbiology Spectrum","paperid":"e03226-22","status":"p","title":"Microbiology Spectrum","volume":"11"},"review":"Peer Reviewed","scoID":["2-s2.0-85158048613"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-bb3a4b68-e65c-469b-b963-6d070ac089b7"],"src":["KU University of Copenhagen"],"title":"Influenza in Liver and Kidney Transplant Recipients : Incidence and Outcomes","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-690289","year":"2023","yearsub":"2023"}
{"abstract":"Introduction With longer life expectancy in people living with HIV (PLWH) on antiretroviral therapy, cardiovascular disease (CVD) has become a common cause of mortality among them. Abacavir has been associated with an increased risk of myocardial infarction, but the mechanism is unknown. Additionally, abacavir may be obesogenic which could mediate an additional risk factor of CVD. We aim to investigate if discontinuation of abacavir will have a favourable impact on body weight and cardiac parameters in PLWH. Methods and analysis Randomised, controlled, superiority trial of virologically suppressed PLWH on dolutegravir, abacavir and lamivudine (DTG/ABC/3TC) for ≥6 months. In total, 70 PLWH will be randomised 1:2 to either continue DTG/ABC/3TC or to switch to dolutegravir and lamivudine (DTG/3TC) providing the power of 80% at alpha 5% to detect a mean difference in weight change of 2 kg ( \") given an SD of 2.7 kg. Follow-up will be 48 weeks. Data will be collected at baseline and week 48. Primary outcome will be change in mean body weight from baseline to week 24 and 48 evaluated in a linear mixed model. Secondary outcomes will be changes in cardiac, inflammatory and metabolic parameters, fat distribution, coagulation, endothelial, platelet function, quality of life and virological control from baseline to week 48. Measurements include CT of thorax and abdomen, external carotid artery ultrasound, liver elastography and dual energy X-ray absorptiometry and blood analysis. Plasma HIV RNA will be measured at baseline, week 4, 24 and 48. Forty participants (20 from each arm) will be included in a substudy involving cardiac MRI at baseline and week 48. Twenty non-HIV-infected controls will be included with a single scan to compare with baseline scan data. Ethics and dissemination Result from this study will lead to a better understanding of the association between antiretroviral therapy and the impact on weight and risk of CVD. Findings will be useful for both clinicians and PLWH in the guidance of a more individualised HIV treatment. Results from the main study and the substudies will be submitted for publication in a peer-reviewed journal(s). The AVERTAS study is approved by the Ethics Committee of the Capital Region, Denmark (H-20011433), Danish Medicines Agency (EudraCT no. 2019-004999-19) and Regional Data Protection Centre (P-2020-207). Trial registration number Pre-results registration at ClinicalTrials.gov Identifier: NCT04904406, registered 27 May 2021. Protocol version: Protocol version 9.0, 4 April 2023, approved 10-05-2023 by Ethics Committee of the Capital Region, Denmark (H-20011433). Danish Medicines Agency (EudraCT no. 2019-004999-19). Regional Data Protection Centre (P-2020-207) ClinicalTrials.gov.","author_count":7,"contributors":["Pedersen, Karen Brorup Heje","Knudsen, Andreas","Møller, Søren","Siebner, Hartwig Roman","Hove, Jens Dahlgaard","Gerstoft, Jan","Benfield, Thomas"],"cuid":["S01-000.00-722081"],"filters":{"added":"2023-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["HIV aids","Infectious diseases","Obesity","Virology"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"changes in weight body composition and metabolic parameters after switch to dolutegravir lamivudine compared with continued treatment with dolutegravir abacavir lamivudine for virologically suppressed hiv infection the avertas trial a randomised open label superiority trial in copenhagen denmark","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1136/bmjopen-2023-075673","version":"Published Version"},"id":"S01-000.00-722081","identifier":[{"id":"37604629","type":"pmid"},{"id":"85168528011","type":"scopus"},{"id":"PMC10445393","type":"pmcid"}],"ids":["ku-db7ab150-9d92-4922-8e33-0277d4202ffa"],"keyword":["HIV & AIDS","infectious diseases","obesity","other metabolic, e.g. iron, porphyria","virology"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-9287B8A23A004B6179E71C26549E3785"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1136/bmjopen-2023-075673","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://curis.ku.dk/ws/files/374839015/e075673.full.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Amager and Hvidovre"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Clinical Physiology and Nuclear Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Karen Brorup Heje","key":"pedersenpau","last":"Pedersen","name":"Pedersen, Karen Brorup Heje","rank":1,"rolecode":"pau"},{"affno":"1","first":"Andreas","key":"knudsenpau","last":"Knudsen","name":"Knudsen, Andreas","rank":2,"rolecode":"pau"},{"affno":"2","first":"Søren","key":"møllerpau","last":"Møller","locid":"a4bee617-45cc-4a85-a58a-817fb06a5525","name":"Møller, Søren","rank":3,"rolecode":"pau"},{"affno":"2","first":"Hartwig Roman","key":"siebnerpau","last":"Siebner","locid":"d9ed8669-a16b-429a-86ed-353ef481bb72","name":"Siebner, Hartwig Roman","rank":4,"rolecode":"pau"},{"affno":"2","first":"Jens Dahlgaard","key":"hovepau","last":"Hove","locid":"4ecfb416-ea53-418e-a6c3-ace7647318ea","name":"Hove, Jens Dahlgaard","orcid":"0000-0002-5600-5623","rank":5,"rolecode":"pau"},{"affno":"2","first":"Jan","key":"gerstoftpau","last":"Gerstoft","locid":"c7e948db-fe0f-4a67-9b86-7ccc43ae64f5","name":"Gerstoft, Jan","rank":6,"rolecode":"pau"},{"affno":"2","first":"Thomas","key":"benfieldpau","last":"Benfield","locid":"03fdbbba-4bc0-41aa-845b-81ba0bded9ba","name":"Benfield, Thomas","orcid":"0000-0003-0698-9385","rank":7,"rolecode":"pau"}],"pmid":["37604629"],"pub":{"doi":"10.1136/bmjopen-2023-075673","issn":["20446055"],"issue":"8","journal":"BMJ Open","paperid":"e075673","status":"p","title":"BMJ Open","volume":"13"},"review":"Peer Reviewed","scoID":["2-s2.0-85168528011"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-db7ab150-9d92-4922-8e33-0277d4202ffa"],"src":["KU University of Copenhagen"],"title":"Changes in weight, body composition and metabolic parameters after switch to dolutegravir/lamivudine compared with continued treatment with dolutegravir/abacavir/lamivudine for virologically suppressed HIV infection (The AVERTAS trial) : a randomised, open-label, superiority trial in Copenhagen, Denmark","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-722081","year":"2023","yearsub":"2023"}
{"abstract":"Until recently, intronic lariats were regarded as short-lasting splicing byproducts with no apparent function; however, increasing evidence of stable derivatives suggests regulatory roles. Yet little is known about their characteristics, functions, distribution, and expression in healthy and tumor tissue. Here, we profiled and characterized circular stable intronic sequence RNAs (sisRNAs) using total RNA-Seq data from bladder cancer (BC; n = 457, UROMOL cohort), healthy tissue (n = 46), and fractionated cell lines (n = 5). We found that the recently-discovered full-length intronic circles and the stable lariats formed distinct subclasses, with a surprisingly high intronic circle fraction in BC (∼45%) compared to healthy tissues (0-20%). The stable lariats and their host introns were characterized by small transcript sizes, highly conserved BP regions, enriched BP motifs, and localization in multiple cell fractions. Additionally, circular sisRNAs showed tissue-specific expression patterns. We found nine circular sisRNAs as differentially expressed across early-stage BC patients with different prognoses, and sisHNRNPK expression correlated with progression-free survival. In conclusion, we identify distinguishing biological features of circular sisRNAs and point to specific candidates (incl. sisHNRNPK, sisWDR13 and sisMBNL1) that were highly expressed, had evolutionary conserved sequences, or had clinical correlations, which may facilitate future studies and further insights into their functional roles.","author_count":7,"contributors":["Rasmussen, Asta Mannstaedt","Okholm, Trine Line H.","Knudsen, Michael","Vang, Søren","Dyrskjøt, Lars","Hansen, Thomas Birkballe","Pedersen, Jakob Skou"],"cuid":["S01-000.00-694207"],"filters":{"added":"2023-11","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","OECD"],"corresponding_author":["Pedersen, Jakob Skou"],"country":["United States"],"glorg":["All Global Affiliations","University of California at San Francisco"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"circular stable intronic rnas possess distinct biological features and are deregulated in bladder cancer","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1093/narcan/zcad041","version":"Published Version"},"id":"S01-000.00-694207","identifier":[{"id":"PMC10405568","type":"pmcid"},{"id":"85168566093","type":"scopus"},{"id":"37554968","type":"pmid"}],"ids":["au-c02689d2-8d8f-45a5-9b27-eb74aaaf89ae"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-8A2CCB48457892A3709D04AA40E107A0"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1093/narcan/zcad041","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Molecular Medicine (MOMA)","Aarhus University, Natural Sciences, Department of Molecular Biology and Genetics, Department of Molecular Biology and Genetics - Bioinformatics Research Centre (BiRC)"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"us","key":"university of california at san francisco","loc":["United States","America, North","OECD"],"name":"University of California at San Francisco","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Asta M.","key":"rasmussenpau","last":"Rasmussen","locid":"728c1be0-0bc0-43b1-bf61-4de3dd0dfd59","name":"Rasmussen, Asta Mannstaedt","name_org":"Rasmussen, Asta M.","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Trine Line H.","key":"okholmpau","last":"Okholm","name":"Okholm, Trine Line H.","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Michael","key":"knudsenpau","last":"Knudsen","locid":"0e7c7bb2-f35f-4a40-8376-b7049bdfcddd","name":"Knudsen, Michael","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren","key":"vangpau","last":"Vang","locid":"f748548c-e964-40ad-9ddf-256cea6c9e2f","name":"Vang, Søren","orcid":"0000-0002-1899-4205","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars","key":"dyrskjøtpau","last":"Dyrskjøt","locid":"bfef7eee-908e-466d-92fc-b43e18c6c8aa","name":"Dyrskjøt, Lars","orcid":"0000-0001-7061-9851","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Thomas B.","key":"hansenpau","last":"Hansen","locid":"e00bd2ad-0f79-4307-9f42-00ae2e99e2ca","name":"Hansen, Thomas Birkballe","name_org":"Hansen, Thomas B.","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jakob S.","key":"pedersenpau","last":"Pedersen","locid":"9c14e87f-2dc3-4c08-a074-146337aff8a0","name":"Pedersen, Jakob Skou","name_org":"Pedersen, Jakob S.","orcid":"0000-0002-7236-4001","rank":7,"rolecode":"pau"}],"pmid":["37554968"],"pub":{"doi":"10.1093/narcan/zcad041","issn":["26328674"],"issue":"3","journal":"NAR Cancer","paperid":"zcad041","publisher":"Oxford University Press","status":"p","title":"NAR Cancer","title_org":"NAR cancer","volume":"5"},"review":"Peer Reviewed","scoID":["2-s2.0-85168566093"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-c02689d2-8d8f-45a5-9b27-eb74aaaf89ae"],"src":["AU Aarhus University"],"title":"Circular stable intronic RNAs possess distinct biological features and are deregulated in bladder cancer","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-694207","year":"2023","yearsub":"2023"}
{"abstract":"BACKGROUND: A prominent finding in Major Depressive Disorder (MDD) is distorted stress hormone dynamics, which is regulated by serotonergic brain signaling. An interesting feature of the cerebral serotonin system is the serotonin 4 receptor (5-HT4R), which is lower in depressed relative to healthy individuals, and also has been highlighted as a promising novel antidepressant target. Here, we test the novel hypothesis that brain 5-HT4R availability in untreated patients with MDD is correlated with cortisol dynamics, indexed by the cortisol awakening response (CAR). Further, we evaluate if CAR changes with antidepressant treatment including selective serotonin reuptake inhibitor, and if pretreatment CAR can predict treatment outcome. METHODS: Sixty-six patients (76% women) with a moderate to severe depressive episode underwent positron emission tomography (PET) imaging with [ 11C]SB207145 for quantification of brain 5-HT4R binding using BPND as outcome. Serial home sampling of saliva in the first hour from awakening was performed to assess CAR before and after 8 weeks of antidepressant treatment. Treatment outcome was measured by change in Hamilton Depression Rating Scale 6 items. RESULTS: In the unmedicated depressed state, prefrontal and anterior cingulate cortices 5-HT4R binding was positively associated with CAR. CAR remained unaltered after 8 weeks of antidepressant treatment, and pretreatment CAR did not significantly predict treatment outcome. CONCLUSIONS: Our findings highlight a link between serotonergic disturbances in MDD and cortisol dynamics which likely is involved in disease- and treatment mechanisms. Further, our data support 5-HT4R agonism as a promising precision target in patients with MDD and disturbed stress hormone dynamics.","author_count":11,"contributors":["Vulpius, Gunild M","Köhler-Forsberg, Kristin","Ozenne, Brice","Larsen, Søren V.","Nasser, Arafat","Svarer, Claus","Gillings, Nic","Keller, Sune H","Jørgensen, Martin Balslev","Knudsen, Gitte Moos","Frokjaer, Vibe G."],"cuid":["S01-000.00-696398"],"filters":{"added":"2023-11","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"stress hormone dynamics are coupled to brain serotonin 000000000004 receptor availability in unmedicated patients with major depressive disorder a neuropharm study","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1093/ijnp/pyad041","version":"Published Version"},"id":"S01-000.00-696398","identifier":[{"id":"37542733","type":"pmid"},{"id":"85172712660","type":"scopus"},{"id":"PMC10519814","type":"pmcid"}],"ids":["ku-cd19ed3a-7acb-4a95-a022-fe1e543cb3fe"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-BB49E4129096A0A559FD510AC15A9EC0"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1093/ijnp/pyad041","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/366737152/pyad041.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU Universit