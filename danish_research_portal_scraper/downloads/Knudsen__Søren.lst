, EU","Nordic","OECD"],"name":"Karolinska Institute","used":1},{"affno":"3","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"4","country":"dk","key":"ssi statens serum institut","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-SSI","l3nn":"SSI Statens Serum Institut","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SSI Statens Serum Institut","namevar":["Statens Serum Institut"],"nora_code":"DI-GV-SSI","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Sine Sondergaard","key":"korsholmsinesøndergaardpau","last":"Korsholm","locid":"6ecfc25a-63fc-49b6-bfd2-54163cbb45d1","name":"Korsholm, Sine Søndergaard","name_org":"Korsholm, Sine Sondergaard","orcid":"0000-0003-3947-9111","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Maryam","key":"dastmalchimaryampau","last":"Dastmalchi","name":"Dastmalchi, Maryam","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"John Bonde","key":"bondeknudsenjohnpau","last":"Knudsen","locid":"6f433995-900f-4178-897d-417c671ef417","name":"Bonde Knudsen, John","name_org":"Knudsen, John Bonde","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Axel Cosmus","key":"diederichsenaxelcosmuspyndtpau","last":"Diederichsen","locid":"d84be6bc-52bf-4710-9f66-0209cfab4f54","name":"Diederichsen, Axel Cosmus Pyndt","name_org":"Diederichsen, Axel Cosmus","orcid":"0000-0002-1285-4826","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ingrid E.","key":"lundbergingridepau","last":"Lundberg","name":"Lundberg, Ingrid E.","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Daniel C.","key":"anderssondanielcpau","last":"Andersson","name":"Andersson, Daniel C.","rank":6,"rol