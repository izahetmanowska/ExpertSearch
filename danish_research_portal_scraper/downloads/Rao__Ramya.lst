{"author_count":4,"contributors":["Sapio, Silvia","Rao, Ramya","Dipalma, Jason","Wang, Qian Janice"],"cuid":["S01-000.00-825216"],"event":{"end":"2025-08-21","place":"Philadelphia, us","start":"2025-08-17","title":"Pangborn 2025: 16th Pangborn Sensory Science Symposium","year":"2025"},"filters":{"added":"2025-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Italy"],"glorg":["All Global Affiliations","University of Naples Federico II"],"level":"sci","mra":["soc"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"shedding light on healthy eating the effect of lighting brightness on shopping behaviour in a virtual reality supermarket","src":["au"],"src-code":["DI-U-AU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-825216","ids":["au-5a10e651-8a02-4b12-a891-b17a069697e0"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-2665F91C5F5162103469CA1F6E9038FF"],"org":[{"affno":"1","country":"it","key":"university of naples federico ii","loc":["Italy","Europe, EU","OECD"],"name":"University of Naples Federico II","used":1},{"affno":"2","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus BSS, Department of Management"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Silvia","key":"sapiopau","last":"Sapio","name":"Sapio, Silvia","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ramya","key":"raopau","last":"Rao","name":"Rao, Ramya","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Jason","key":"dipalmapau","last":"Dipalma","locid":"34855226-d32b-4f01-bbb4-8bacded3add4","name":"Dipalma, Jason","orcid":"0009-0003-8700-0416","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Qian Janice","key":"wangpau","last":"Wang","name":"Wang, Qian Janice","rank":4,"rolecode":"pau"}],"pub":{"status":"s"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Submitted"]},"sid":["au-5a10e651-8a02-4b12-a891-b17a069697e0"],"src":["AU Aarhus University"],"title":"Shedding light on healthy eating: the effect of lighting brightness on shopping behaviour in a virtual reality supermarket","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-825216","year":"2025","yearsub":"2025"}
{"abstract":"Facilitating sustainable dietary transitions is crucial for addressing the climate crisis, yet changing individual eating behaviours – particularly in meat-centric food cultures – remains challenging. This study examines different psychological factors underlying plant-based eating, with a focus on meat-centric meal perception - the tendency to view meat as the essential component of a proper meal. Data were collected via an online questionnaire from 592 meat-eating adults aged 20 to 70 (evenly recruited across five age groups) in Australia (N = 325) and Denmark (N = 267), two of the world's highest meat-consuming countries. Participants completed validated measures of familiarity with plant-based meals, food neophobia, cognitive reflection, and meat-centric meal perception. A more meat-centric meal perception was correlated with consuming fewer plant-based meals in Australia r(323) = - 0.36, p < 0.001 and Denmark r(265) = - 0.42, p < 0.001. Mediation analyses showed that higher familiarity with plant-based meals was associated with a less meat-centric meal perception, which in turn was related to higher plant-based eating among Australians (indirect effect = 0.34, 95 % CI [0.183, 0.534]) and Danes (indirect effect = 0.45, 95 % CI [0.267, 0.673]). Food neophobia was associated with lower plant-based eating in both countries, with an additional negative indirect effect via meat-centric meal perception in Denmark. Cognitive reflection showed no significant association with either meal perception or plant-based eating. These findings highlight meat-centric meal perception as a key psychological barrier to plant-based eating and underscore the importance of familiarity and food neophobia in shaping meal perceptions, offering valuable insights for promoting sustainable dietary change.","author_count":3,"contributors":["Rao, Ramya","Liem, Djin Gie","Wang, Qian Janice"],"cuid":["S01-000.00-830009"],"filters":{"added":"2025-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["OECD","Oceania"],"country":["Australia"],"glorg":["All Global Affiliations","Deakin University"],"keyword":["Cognitive reflection","Familiarity","Food neophobia"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"understanding the barriers to plant based dietary change the role of meat centric meal perception among adults in australia and denmark","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.appet.2025.108240","version":"Published Version"},"id":"S01-000.00-830009","identifier":[{"id":"40714202","type":"pmid"},{"id":"105011945505","type":"scopus"}],"ids":["ku-d9da2585-1976-45e4-bac8-a5da1cdfb4f5"],"keyword":["Cognitive reflection","Familiarity","Food neophobia","Meal perception","Meat-centric","Plant-based eating"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-5AF1AF457216E1FE23A2111CF2295B7A"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/458882020/1-s2.0-S0195666325003939-main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.appet.2025.108240","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Food Science, Design and Consumer Behavior"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"au","key":"deakin university","loc":["Australia","Oceania","OECD"],"name":"Deakin University","used":1}],"person":[{"affno":"1","first":"Ramya","key":"raopau","last":"Rao","locid":"0595f9f0-cc5a-406a-906f-7323fc9dc700","name":"Rao, Ramya","rank":1,"rolecode":"pau"},{"affno":"2","first":"Djin Gie","key":"liempau","last":"Liem","name":"Liem, Djin Gie","rank":2,"rolecode":"pau"},{"affno":"1","first":"Qian Janice","key":"wangpau","last":"Wang","locid":"705145e9-eed1-4cdd-a2f4-ddc56bde0878","name":"Wang, Qian Janice","orcid":"0000-0001-7054-2137","rank":3,"rolecode":"pau"}],"pmid":["40714202"],"pub":{"doi":"10.1016/j.appet.2025.108240","issn":["01956663","10958304"],"issn_org":["01956663"],"journal":"Appetite","paperid":"108240","status":"p","title":"Appetite","volume":"215"},"review":"Peer Reviewed","scoID":["2-s2.0-105011945505"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-d9da2585-1976-45e4-bac8-a5da1cdfb4f5"],"src":["KU University of Copenhagen"],"title":"Understanding the barriers to plant-based dietary change : The role of meat-centric meal perception among adults in Australia and Denmark","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-830009","year":"2025","yearsub":"2025"}
{"abstract":"Due to the significant impact of Western diets on the environment, interventions are being trialled in supermarkets, restaurants, and other settings to encourage sustainable food consumption (SFC). The Behaviour Change Technique Taxonomy (BCTTv1) lists and categorises Behaviour Change Techniques (BCTs), which facilitates the development and understanding of behaviour change interventions. However, its applicability to pro-environmental behaviour change has not been extensively explored. This systematic review uses the BCTTv1 to identify the BCTs that have been previously used to encourage SFC behaviours. Studies were retrieved from Scopus, PSYCInfo, GreenFILE, and the Web of Science Core Collection. Twenty-six interventions across 19 articles were reviewed, enabling the identification of 13 BCTs which were coded using the BCTTv1 and categorised according to their target behaviour and effect size. The most frequently applied BCTs were 12.1 ‘restructuring the physical environment’, which was used in the most effective interventions; 6.2 ‘social comparison’, which was used in interventions with smaller and more unpredictable effects; 5.3 ‘information about social and environmental consequences’; 5.2 ‘salience of consequences’; and 7.1 ‘prompts/cues’. Despite challenges in assessing the BCTs' effectiveness due to multicomponent interventions and varying effects across different contexts, this review offers recommendations on changing SFC behaviour as well as the applicability of the BCTTv1 for SFC interventions.","author_count":5,"contributors":["Tirion, Anna S.C.","D'Lima, Danielle","Terlet, Julia","Rao, Ramya","Gutman, Leslie M."],"cuid":["S01-000.00-820481"],"filters":{"added":"2025-08","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","OECD"],"country":["Belgium","United Kingdom"],"glorg":["All Global Affiliations","Behaven SRL","University College London"],"keyword":["Behaviour change","Consumption","Environmental","Food","Sustainability"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"identifying behaviour change techniques for sustainable food consumption a systematic review using the bcttv000000000001","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.appet.2025.108057","version":"Published Version"},"id":"S01-000.00-820481","identifier":[{"id":"40383155","type":"pmid"},{"id":"105007152120","type":"scopus"}],"ids":["ku-f75bcd3d-20c0-496e-b4bd-d13e5c5b4492"],"keyword":["BCTs","Behaviour change","Consumption","Environmental","Food","Sustainability"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-BD96415A689462703769593FEE3D09F4"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/454154749/1-s2.0-S0195666325002107-main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.appet.2025.108057","version":"Published Version"}],"org":[{"affno":"1","country":"gb","key":"university college london","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University College London","used":1},{"affno":"2","country":"be","key":"behaven srl","loc":["Belgium","Europe, EU","OECD"],"name":"Behaven SRL","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Food Science, Design and Consumer Behavior"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Anna S.C.","key":"tirionpau","last":"Tirion","name":"Tirion, Anna S.C.","rank":1,"rolecode":"pau"},{"affno":"1","first":"Danielle","key":"dlimapau","last":"D'Lima","name":"D'Lima, Danielle","rank":2,"rolecode":"pau"},{"affno":"2","first":"Julia","key":"terletpau","last":"Terlet","name":"Terlet, Julia","rank":3,"rolecode":"pau"},{"affno":"2 3","first":"Ramya","key":"raopau","last":"Rao","locid":"0595f9f0-cc5a-406a-906f-7323fc9dc700","name":"Rao, Ramya","rank":4,"rolecode":"pau"},{"affno":"1","first":"Leslie M.","key":"gutmanpau","last":"Gutman","name":"Gutman, Leslie M.","rank":5,"rolecode":"pau"}],"pmid":["40383155"],"pub":{"doi":"10.1016/j.appet.2025.108057","issn":["01956663","10958304"],"issn_org":["01956663"],"journal":"Appetite","paperid":"108057","status":"p","title":"Appetite","volume":"214"},"review":"Peer Reviewed","scoID":["2-s2.0-105007152120"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-f75bcd3d-20c0-496e-b4bd-d13e5c5b4492"],"src":["KU University of Copenhagen"],"title":"Identifying behaviour change techniques for sustainable food consumption : A systematic review using the BCTTv1","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-820481","year":"2025","yearsub":"2025"}
{"abstract":"Alzheimers disease (AD) is the main cause of dementia and it is defined by cognitive decline coupled to extracellular deposit of amyloid-beta protein and intracellular hyperphosphorylation of tau protein. Historically, efforts to target such hallmarks have failed in numerous clinical trials. In addition to these hallmark-targeted approaches, several clinical trials focus on other AD pathological processes, such as inflammation, mitochondrial dysfunction, and oxidative stress. Mitochondria and mitochondrial-related mechanisms have become an attractive target for disease-modifying strategies, as mitochondrial dysfunction prior to clinical onset has been widely described in AD patients and AD animal models. Mitochondrial function relies on both the nuclear and mitochondrial genome. Findings from omics technologies have shed light on AD pathophysiology at different levels (e.g., epigenome, transcriptome and proteome). Most of these studies have focused on the nuclear-encoded components. The first part of this review provides an updated overview of the mechanisms that regulate mitochondrial gene expression and function. The second part of this review focuses on evidence of mitochondrial dysfunction in AD. We have focused on published findings and datasets that study AD. We analyzed published data and provide examples for mitochondrial-related pathways. These pathways are strikingly dysregulated in AD neurons and glia in sex-, cell- and disease stage-specific manners. Analysis of mitochondrial omics data highlights the involvement of mitochondria in AD, providing a rationale for further disease modeling and drug targeting.","author_count":6,"contributors":["Marmolejo-Garza, Alejandro","Medeiros-Furquim, Tiago","Rao, Ramya","Eggen, Bart J.L.","Boddeke, Erik W.G.M.","Dolga, Amalia M."],"cuid":["S01-000.00-520074"],"filters":{"added":"2022-09","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Netherlands"],"glorg":["All Global Affiliations","University of Groningen"],"keyword":["Mitochondria","Neurodegeneration","Omics","RNA seq"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"transcriptomic and epigenomic landscapes of alzheimer s disease evidence mitochondrial related pathways","src":["ku"],"src-code":["DI-U-KU"],"type":"djr","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.bbamcr.2022.119326","version":"Published Version"},"id":"S01-000.00-520074","identifier":[{"id":"35839870","type":"pmid"},{"id":"85134419024","type":"scopus"}],"ids":["ku-d4021ddc-6573-4be7-b3ec-8d54560c2fbc"],"keyword":["ATAC-seq","Mitochondria","Neurodegeneration","Omics","RNA-seq"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-5614B3F847C4590CDA7BD4037220E1BF"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/316678009/1_s2.0_S0167488922001185_main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.bbamcr.2022.119326","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"nl","key":"university of groningen","loc":["Netherlands","Europe, EU","OECD"],"name":"University of Groningen","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Cellular and Molecular Medicine, Molecular Aging Program"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Alejandro","key":"marmolejogarzapau","last":"Marmolejo-Garza","name":"Marmolejo-Garza, Alejandro","rank":1,"rolecode":"pau"},{"affno":"1","first":"Tiago","key":"medeirosfurquimpau","last":"Medeiros-Furquim","name":"Medeiros-Furquim, Tiago","rank":2,"rolecode":"pau"},{"affno":"1","first":"Ramya","key":"raopau","last":"Rao","name":"Rao, Ramya","rank":3,"rolecode":"pau"},{"affno":"1","first":"Bart J.L.","key":"eggenpau","last":"Eggen","name":"Eggen, Bart J.L.","rank":4,"rolecode":"pau"},{"affno":"2","first":"Erik","key":"boddekepau","last":"Boddeke","locid":"32dbf30d-d72c-4a4d-bee2-e82ba6857c46","name":"Boddeke, Erik W.G.M.","name_org":"Boddeke, Erik","rank":5,"rolecode":"pau"},{"affno":"1","first":"Amalia M.","key":"dolgapau","last":"Dolga","name":"Dolga, Amalia M.","rank":6,"rolecode":"pau"}],"pmid":["35839870"],"pub":{"doi":"10.1016/j.bbamcr.2022.119326","issn":["01674889","18792596"],"issn_org":["01674889"],"issue":"10","journal":"Biochimica et Biophysica Acta - Molecular Cell Research","paperid":"119326","status":"p","title":"Biochimica et Biophysica Acta - Molecular Cell Research","volume":"1869"},"review":"Peer Reviewed","scoID":["2-s2.0-85134419024"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-d4021ddc-6573-4be7-b3ec-8d54560c2fbc"],"src":["KU University of Copenhagen"],"title":"Transcriptomic and epigenomic landscapes of Alzheimer's disease evidence mitochondrial-related pathways","type":"Journal Review","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-520074","year":"2022","yearsub":"2022"}
