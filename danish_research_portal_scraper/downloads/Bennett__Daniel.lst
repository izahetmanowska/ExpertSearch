{"author_count":30,"contributors":["Moller-Bisgaard, Signe","Horslev-Petersen, Kim","Ejbjerg, Bo Jannik","Glinatsi, Daniel","Hetland, Merete Lund","Ornbjerg, Lykke","Moller, Jakob M.","Boesen, Mikael","Christensen, Robin","Stengaard-Pedersen, Kristian","Madsen, Ole Rintek","Jensen, Bente","Villadsen, Jan Alexander","Hauge, Ellen Margrethe","Bennett, Philip","Hendricks, Oliver","Asmussen, Karsten","Kowalski, Marcin Ryszard","Lindegaard, Hanne","Nielsen, Sabrina Mai","Bliddal, Henning","Krogh, Niels Steen","Ellingsen, Torkell","Nielsen, Agnete Hedemann","Balding, Lone","Jurik, Anne Grethe","Thomsen, Henrik S.","Ostergaard, Mikkel"],"cuid":["S02-088.24-022027"],"event":{"end":"2018-10-24","place":"Chigago, us","start":"2018-10-19","title":"2018 ACR/ARHP Annual Meeting","year":"2018"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-SDR","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"an mri guided treat to target strategy in rheumatoid arthritis patients in clinical remission improved mri inflammation but not damage progression results from the imagine ra randomized controlled trial","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://acrabstracts.org/abstract/an-mri-guided-treat-to-target-strategy-in-rheumatoid-arthritis-patients-in-clinical-remission-improved-mri-inflammation-but-not-damage-progression-results-from-the-imagine-ra-randomized-controlled-t/","version":"Other Version"},"id":"S02-088.24-022027","identifier":[{"id":"000447268901400","type":"wos"}],"ids":["au-8054cfed-d424-4436-a7f8-281b1aa85bb