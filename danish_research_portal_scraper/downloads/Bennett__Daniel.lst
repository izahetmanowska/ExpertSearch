"}],"pub":{"issn":["00034967","14682060"],"issn_org":["00034967"],"issue":"Suppl 2","journal":"Annals of the Rheumatic Diseases","pages":"58-59","paperid":"OP0018","publisher":"Elsevier BV","status":"p","title":"Annals of the Rheumatic Diseases","volume":"77"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Private Research","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Other Companies","Private Research","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark","zitelab aps"],"PST":["Published"]},"sid":["au-39d4ff9b-48b0-42e4-9fe5-7507e1c02ce3","sdu-b47d129a-b2e5-474c-b93e-e3d8f91041d8"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"The Value of Adding MRI to a Clinical Treat-to-Target Strategy in Rheumatoid Arthritis Patients in Clinical Remission : Clinical and Radiographic Outcomes from the Imagine-RA Randomized Controlled Trial","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-080.83-016891","year":"2018","yearsub":"2018"}
{"abstract":"Glycosaminoglycans (GAGs) are essential polysaccharides in normal physiology and disease. However, understanding of the contribution of specific GAG structures to specific biological functions is limited, largely because of the great structural heterogeneity among GAGs themselves, as well as technical limitations in the structural characterization and chemical synthesis of GAGs. Here we describe a cell-based method to produce and display distinct GAGs with a broad repertoire of modifications, a library we refer to as the GAGOme. By using precise gene editing, we engineered a large panel of Chinese hamster ovary cells with knockout or knock-in of the genes encoding most of the enzymes involved in GAG biosynthesis, to generate a library of isogenic cell lines that differentially display distinct GAG features. We show that this library can be used for cell-based binding assays, recombinant expression of proteoglycans with distinct GAG structures, and production of distinct GAG chains on metabolic primers that may be used for the assembly of GAG glycan microarrays.","author_count":17,"contributors":["Chen, Yen-Hsi","Narimatsu, Yoshiki","Clausen, Thomas Mandel","Gomes, Catarina","Karlsson, Richard","Steentoft, Catharina","Spliid, Charlotte Bredo","Gustavsson, Tobias","Salanti, Ali","Persson, Andrea","Malmström, Anders","Willén, Daniel","Ellervik, Ulf","Bennett, Eric P","Mao, Yang","Clausen, Henrik","Yang, Zhang"],"cuid":["S01-000.00-409103"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"the gagome a cell based library of displayed glycosaminoglycans","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-409103","identifier":[{"id":"85052313120","type":"scopus"},{"id":"30104636","type":"pmid"}],"ids":["ku-1a40647c-e39c-440f-ad98-062eed962229"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-7B2B35F9DEC31F5CEE6174E53BE3A816"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Cellular and Molecular Medicine, Glycomics Program"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Yen-Hsi","key":"chenyenhsipau","last":"Chen","locid":"9e2a8260-45b3-413b-a6df-20b3e801f574","name":"Chen, Yen-Hsi","rank":1,"rolecode":"pau"},{"affno":"1","first":"Yoshiki","key":"narimatsuyoshikipau","last":"Narimatsu","locid":"d9d8a2cb-0c61-43eb-9b4c-4b4248e71f06","name":"Narimatsu, Yoshiki","orcid":"0000-0003-1428-5695","rank":2,"rolecode":"pau"},{"affno":"1","first":"Thomas Mandel","key":"clausenthomasmandelpau","last":"Clausen","locid":"77bbcc8c-ae35-4949-9300-84a316051b38","name":"Clausen, Thomas Mandel","orcid":"0000-0001-7543-9622","rank":3,"rolecode":"pau"},{"affno":"1","first":"Catarina","key":"gomescatarinapau","last":"Gomes","locid":"57e828dc-5d53-4347-94cd-62750f91e418","name":"Gomes, Catarina","rank":4,"rolecode":"pau"},{"affno":"1","first":"Richard","key":"karlssonrichardpau","last":"Karlsson","locid":"73c741c2-d3be-4072-812b-17ac35bc9c3e","name":"Karlsson, Richard","rank":5,"rolecode":"pau"},{"affno":"1","first":"Catharina","key":"steentoftcatharinapau","last":"Steentoft","locid":"fe08786e-78da-45d0-be29-9ba36e26c039","name":"Steentoft, Catharina","rank":6,"rolecode":"pau"},{"affno":"1","first":"Charlotte Bredo","key":"spliidcharlottebredopau","last":"Spliid","locid":"411cf23d-f5a9-4fbf-9d42-8