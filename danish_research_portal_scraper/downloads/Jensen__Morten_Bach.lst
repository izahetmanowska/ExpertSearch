I-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["College360"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Morten","key":"christensenpau","last":"Christensen","locid":"cd6c820c-5e45-4594-9be9-2b3518077508","name":"Christensen, Morten","orcid":"0000-0003-4080-8357","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Cathrine","key":"terkelsenpau","last":"Terkelsen","locid":"9b03519d-628d-4c28-bcb1-0154561cc164","name":"Terkelsen, Cathrine","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Anne Torpegaard","key":"festersenpau","last":"Festersen","locid":"f83238b4-57d8-4f8b-9a4b-5fb4f6f790fc","name":"Festersen, Anne Torpegaard","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Kathrine Pilgaard","key":"ottosenpau","last":"Ottosen","name":"Ottosen, Kathrine Pilgaard","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Frederik Bach","key":"jensenpau","last":"Jensen","name":"Jensen, Frederik Bach","rank":5,"rolecode":"pau"}],"pub":{"publisher":"Smag for Livet","status":"p"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Miscellaneous","All University Colleges","DI-ALL","DI-OT","DI-OT-ALL","DI-UC","DI-UC-ALL","Miscellaneous","Other Research","UCL University College","University Colleges"],"PST":["Published"]},"sid":["ucl-6e34acc8-2e7d-4ae7-b44e-49cb105ddefd"],"src":["UCL University College"],"title":"Få styr på isen","type":"Other-Unknown","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-648033","year":"2021","yearsub":"2021"}
{"abstract":"Objective: To study the effects of supervised training in adults with subacromial pain syndrome. Data Sources: Embase, MEDLINE, Cochrane Library, Cumulative Index to Nursing and Allied Health, and Physiotherapy Evidence Database were searched from inception to March 2020. Study Selection: Independent reviewers selected randomized controlled trials comparing supervised training with (1) no training or (2) self-training in adults with subacromial pain syndrome lasting for at least 1 month. Critical outcomes were shoulder pain, function, and patient-perceived effect. Important outcomes included other potential benefits and adverse events at 3-month follow-up. Data Extraction: Two independent reviewers extracted data for the meta-analysis. Risk of bias was assessed using the Cochrane Risk of Bias tool 1, and certainty of evidence was evaluated using the Grades of Recommendation Assessment, Development, and Evaluation (GRADE). Data Synthesis: Ten studies (n=597, 43% female) were included. Supervised training resulted in larger improvements than no training on pain (at rest: n=286; mean difference [MD], 1.68; 95% confidence interval [CI], 0.31-3.06 on 0-10 scale; during movement: n=353; MD, 1.84; 95% CI,0.91-2.76), function (n=396; standardized MD, 0.30; 95% CI, 0.07-0.52), and patient-perceived effect (n=118; risk ratio, 1.43; 95% CI, 0.87-2.34). Supervised training had potential benefits regarding quality of life, return to work, dropout, and training adherence, albeit more patients reported mild, transient pain after training. Supervised training and self-training showed equal improvements on pain (n=44) and function (n=76), with no data describing patient-perceived effect. Certainty of evidence was low for critical outcomes and low-moderate for other outcomes. Conclusions: Supervised training might be superior to no training and equally effective as self-training on critical and important outcomes. Based on low-moderate certainty of evidence, these findings support a weak recommendation for supervised training in adults with subacromial pain syndrome.","author_count":10,"contributors":["Liaghat, Behnam","Ussing, Anja","Petersen, Birgitte Holm","Andersen, Henning Keinke","Barfod, Kristoffer Weisskirchner","Jensen, Martin Bach","Hoegh, Morten","Tarp, Simon","Juul-Kristensen, Birgit","Brorson, Stig"],"cuid":["S03-097.56-009535"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":3,"corresponding_author":["Liaghat, Behnam"],"keyword":["Exercise Therapy","Meta analysis","Rehabilitation","Shoulder Joint","Shoulder impingement syndrome","Shoulder pain"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-ZEA"],"OT":["Danish Health Authority"],"U":["DI-U-AAU","DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-ZEA","DI-U-AAU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"supervised training compared with no training or self training in patients with subacromial pain syndrome a systematic review and meta analysis","src":["aau","ku","sdu"],"src-code":["DI-U-AAU","DI-U-KU","DI-U-SDU"],"type":"djr","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.apmr.2021.03.027","version":"Published Version"},"funding_acknowledgement":["Supported by the Danish Health Authority. The Parker Institute, Bispebjerg and Frederiksberg Hospital, is supported by a core grant from the Oak Foundation (OCAY-18-774_OFIL)."],"id":"S03-097.56-009535","identifier":[{"id":"85108560647","type":"scopus"},{"id":"33930326","type":"pmid"}],"ids":["aau-c695c47e-9807-4a1b-a31a-4c7bdd604f68","ku-9cf348aa-09a0-4520-b9df-a0352ace6cb8","sdu-5e29cb60-71ae-4f40-a01e-31440a1d0b6f"],"keyword":["Exercise therapy","Meta-analysis","Rehabilitation","Shoulder impingement syndrome","Shoulder joint",