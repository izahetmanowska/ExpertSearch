 A.","key":"poulinpau","last":"Poulin","name":"Poulin, Patricia A.","rank":13,"rolecode":"pau"},{"affno":"14 15","corresponding":null,"first":"Gitte","key":"handbergpau","last":"Handberg","locid":"34fd6956-be73-41c2-b230-02961b03c9ec","name":"Handberg, Gitte","rank":14,"rolecode":"pau"},{"affno":"16","corresponding":null,"first":"Connie","key":"zieglerpau","last":"Ziegler","name":"Ziegler, Connie","rank":15,"rolecode":"pau"},{"affno":"16","corresponding":null,"first":"Lars B.","key":"møllerpau","last":"Møller","name":"Møller, Lars B.","rank":16,"rolecode":"pau"},{"affno":"17 16","corresponding":null,"first":"Judi","key":"olsenpau","last":"Olsen","name":"Olsen, Judi","rank":17,"rolecode":"pau"},{"affno":"16","corresponding":null,"first":"Lotte","key":"heisepau","last":"Heise","name":"Heise, Lotte","rank":18,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Michael S.","key":"rathleffpau","last":"Rathleff","locid":"90c1260f-4cd4-497f-88ca-a98f412bbe7b","name":"Rathleff, Michael Skovdal","name_org":"Rathleff, Michael S.","orcid":"0000-0003-1173-0335","rank":19,"rolecode":"pau"}],"pmid":["35918804"],"pub":{"doi":"10.1515/sjpain-2022-0019","issn":["18778860","18778879"],"issn_org":["18778860"],"issue":"2","journal":"Scandinavian Journal of Pain","pages":"402-415","publisher":"De Gruyter Mouton","status":"p","title":"Scandinavian Journal of Pain","volume":"23"},"review":"Peer Reviewed","scoID":["2-s2.0-85135454424"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Private Research","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","North Denmark Region","Other Companies","Other Hospitals","Other Research","Private Research","Region of Southern Denmark","Universities","University of Southern Denmark","fibromyalgi- & smerteforeningen","nordic institute of health economics a/s"],"PST":["Published"]},"sid":["aau-9afb4c1c-1e01-422a-bdf8-145bb78ef55a","sdu-fae6442f-ada9-4f5a-8df6-a595929caa12"],"src":["AAU Aalborg University","SDU University of Southern Denmark"],"title":"Participatory research : a Priority Setting Partnership for chronic musculoskeletal pain in Denmark","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.95-665900","year":"2023","yearsub":"2023"}
{"abstract":"A trend of distance underestimations in Virtual Reality (VR) is well documented, but the reason still remains unclear. Therefore, this paper investigates the effect of differently sized Virtual Environments (VEs) on egocentric distance perception in VR as a potential influence. Verbal assessment, blind walking, and our own proposed method: walk and assess, were compared in an experiment, and blind walking was found to be the most accurate. A virtual replica of a real-life location was created as a transitional environment, while small (15m2), medium (35m2) and large (95m2) rooms were created to investigate the effect of VE size on spatial perception in VR. To establish the differences in estimations between the real world and VR when using blind walking, a study was conducted with the virtual replica and its real life counterpart at distances between 1 and 10 meters. Following this, the three distinct room sizes were used in an experiment to investigate the effect of the size of rooms on spatial perception in VR. The findings showed consistent underestimates of distances, and a trend for underestimation to grow as the distance grows was observed. Similarly, underestimates grew with the size of the environment.","author_count":5,"contributors":["Bach, Morten Trier","Jensen, Poul Anker","Lucaci, Andrei-Iuliu","Pupczyk, Damian Grzegorz","Madsen, Claus Brøndgaard"],"cuid":["S01-000.00-104363"],"event":{"end":"2022-10-29","place":"Valetta, mt","start":"2022-10-27","title":"International Conference on Computer-Human Interaction Research and Applications","year":"2022"},"filters":{"added":"2022-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Virtual Reality VR"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"effect of environment size on spatial perception in virtual reality","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND 4.0","type":"doi","url":"https://doi.org/10.5220/0011376400003323","version":"Published Version"},"id":"S01-000.00-104363","identifier":[{"id":"85146199378","type":"scopus"}],"ids":["aau-bb2574fb-c43c-42ca-921d-5d19bb5f6542"],"keyword":["Virtual Reality (VR)"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-7DB8E2FACD1B70D31A1DF1BA93E3A3A0"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/495530460/CHIRA_2022_7_CR.pdf","version":"Authors Final Version"},{"access":"oa","license":"CC BY-NC-ND 4.0","type":"doi","url":"https://doi.org/10.5220/0011376400003323","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Technical Faculty of IT and Design","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology, Computer Graphics Group"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Morten Trier","key":"bachpau","last":"Bach","locid":"d7493114-cf8d-4ba0-8588-8738bc43e305","name":"Bach, Morten Trier","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Poul Anker","key":"jensenpau","last":"Jensen","locid":"7cac5170-1ef1-499d-b209-d40656b51d89","name":"Jensen, Poul Anker","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andrei-Iuliu","key":"lucacipau","last":"Lucaci","locid":"76888373-45b4-4260-8725-f0fa327809d0","name":"Lucaci, Andrei-Iuliu","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Damian Grzegorz","key":"pupczykpau","last":"Pupczyk","locid":"436be910-0a79-42ba-a1ad-bdd414a50ad8","name":"Pupczyk, Damian Grzegorz","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Claus Brøndgaard","key":"madsenpau","last":"Madsen","locid":"478b566d-fdb4-4151-9582-e23a39d966ca","name":"Madsen, Claus Brøndgaard","orcid":"0000-0003-0762-3713","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.5220/0011376400003323","eisbn":["9789897586095"],"issn":["21843244"],"pages":"97-104","publisher":"SciTePress","series":"International Conference on Computer-Human Interaction Research and Applications","status":"p","title":"Proceedings of Conference on Computer-Human Interaction and Applications, CHIRA 2022"},"review":"Peer Reviewed","scoID":["2-s2.0-85146199378"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-bb2574fb-c43c-42ca-921d-5d19bb5f6542"],"src":["AAU Aalborg University"],"title":"Effect of Environment Size on Spatial Perception in Virtual Reality","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-104363","year":"2022","yearsub":"2022"}
{"abstract":"BACKGROUND: Knowledge of school attendance problems (SAPs) is needed to inform treatments targeting SAPs and protecting youths from negative outcomes associated with SAPs. OBJECTIVES: This study examined the school absence, absence categories (i.e., absence due to illness, excused, non-excused), sociodemographic characteristics, and mental health problems among youths seeking psychological treatment for SAPs. METHODS: The study used a cross-sectional design. Sociodemographic and clinical characteristics of 152 help-seeking youths with SAPs (i.e., >10% absenteeism) and their parents were examined. The data were derived from the baseline assessment conducted before treatment start. RESULTS: Older youths, youths with mental health problems, and youths whose parents had mental health problems exhibited higher levels of absence. Lower levels of non-excused absence were found among youths with highly educated fathers, and youths living with both parents. Many youths had clinical levels of anxiety, depression, or 'emotional and behavioral difficulties'. CONCLUSION: The study highlights the need for early intervention, addressing a broad range of mental health problems. CLINICAL TRIAL REGISTRATION: ClinicalTrials.gov: NCT03459677.","author_count":7,"contributors":["Johnsen, Daniel Bach","Lomholt, Johanne Jeppesen","Heyne, David","Jeppesen, Pia","Jensen, Morten Berg","Silverman, Wendy K","Thastum, Mikael"],"cuid":["S02-086.84-020357"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["America, North","Europe, EU","OECD"],"corresponding_author":["Johnsen, Daniel Bach","Thastum, Mikael"],"country":["Netherlands","United States"],"glorg":["All Global Affiliations","Leiden University","Yale University"],"keyword":["Absenteeism","Adolescents","Anxiety","Children","Difficulties","Disorders","Questionnaire","Refusal","Symptoms","truancy"],"level":"sci","mra":["med","soc"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"sociodemographic and clinical characteristics of youths and parents seeking psychological treatment for school attendance problems","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1371/journal.pone.0261449","version":"Published Version"},"id":"S02-086.84-020357","identifier":[{"id":"PMC8791456","type":"pmcid"},{"id":"85123541683","type":"scopus"},{"id":"35081106","type":"pmid"},{"id":"000829607600014","type":"wos"}],"ids":["au-69c48c70-2437-4363-b0d6-58c3c99108d7","ku-3fb78c14-0502-4bc2-8c9b-cb39416bf588"],"keyword":["ABSENTEEISM","ADOLESCENTS","ANXIETY","CHILDREN","DIFFICULTIES","DISORDERS","QUESTIONNAIRE","REFUSAL","SYMPTOMS","TRUANCY"],"lang":"English","level":"Scientific","mra":["Medical Science","Social Science"],"noi":["Global-Local-2-5-AAFFC1BBD5FC64AFD19FB1C204475182"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/315997312/journal.pone.0261449.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1371/journal.pone.0261449","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus BSS, Department of Psychology and Behavioural Sciences"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"nl","key":"leiden university","loc":["Netherlands","Europe, EU","OECD"],"name":"Leiden University","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Child and Adolescent Psychiatry","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"4","country":"us","key":"yale university","loc":["United States","America, North","OECD"],"name":"Yale University","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Daniel B","key":"johnsenpau","last":"Johnsen","locid":"a481c564-15eb-46a5-82f1-4e98fc39037c","name":"Johnsen, Daniel Bach","name_org":"Johnsen, Daniel B","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Johanne J","key":"lomholtpau","last":"Lomholt","locid":"5b1a7291-0314-4038-97a9-4eb4d1041783","name":"Lomholt, Johanne Jeppesen","name_org":"Lomholt, Johanne J","orcid":"0000-0002-7270-1186","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"David","key":"heynepau","last":"Heyne","name":"Heyne, David","rank":3,"rolecode":"pau"},{"affno":"3","first":"Pia","key":"jeppesenpau","last":"Jeppesen","locid":"2a1a09ff-cac8-4162-ab6f-ff07e9d1656f","name":"Jeppesen, Pia","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Morten B","key":"jensenpau","last":"Jensen","locid":"40ea6794-4b17-47ce-8946-b4e759de75bf","name":"Jensen, Morten Berg","name_org":"Jensen, Morten B","orcid":"0000-0002-9455-0104","rank":5,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Wendy K","key":"silvermanpau","last":"Silverman","name":"Silverman, Wendy K","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mikael","key":"thastumpau","last":"Thastum","locid":"2e787a8f-8a4d-4939-b8ad-46e4683039fd","name":"Thastum, Mikael","orcid":"0000-0001-8582-5682","rank":7,"rolecode":"pau"}],"pmid":["35081106"],"pub":{"doi":"10.1371/journal.pone.0261449","issn":["19326203"],"issue":"1","journal":"PLOS ONE","paperid":"e0261449","publisher":"Public Library of Science","status":"p","title":"PLOS ONE","volume":"17"},"review":"Peer Reviewed","scoID":["2-s2.0-85123541683"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-69c48c70-2437-4363-b0d6-58c3c99108d7","ku-3fb78c14-0502-4bc2-8c9b-cb39416bf588"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Sociodemographic and clinical characteristics of youths and parents seeking psychological treatment for school attendance problems","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-086.84-020357","year":"2022","yearsub":"2022"}
{"abstract":"In this paper, we investigate the influence of texture fidelity on spatial perception in a standalone virtual reality application. To investigate this, we implemented a detailed virtual representation of an actual physical environment, namely a small one-bedroom apartment. The virtual apartment representation was tested in two different visual styles: high fidelity realistic textures, and a ”paper model” texture. Some test subjects experienced the virtual models using the actual physical apartment as transitional environment, other subjects experienced the model at an unrelated physical location. The environments were evaluated with 20 participants aged 20 to 61 and results indicated a systematic overestimation of distances in virtual reality for all conditions. The results showed that a higher texture fidelity had a positive influence on precision but no significant influence on accuracy. It was also showed that transitional environments negatively influenced precision, but had no significant influence on accuracy. Self assessments of presence from the experiment supported previous claims about a correlation between the level of detail in an environment and presence, but not a correlation between presence and distance perception.","author_count":4,"contributors":["Lucaci, Andrei-Iuliu","Jakobsen, Morten Bach","Jensen, Poul Anker","Madsen, Claus Brøndgaard"],"cuid":["S01-000.00-052227"],"event":{"end":"2022-02-09","start":"2022-02-06","title":"17th Joint Conference on Computer Vision, Imaging and Computer Graphics Theory and Applications - GRAPP","year":"2022"},"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Computer Graphics","Virtual reality"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"influence of texture fidelity on spatial perception in virtual reality","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND 4.0","type":"doi","url":"https://doi.org/10.5220/0010890100003124","version":"Published Version"},"id":"S01-000.00-052227","identifier":[{"id":"85146201268","type":"scopus"}],"ids":["aau-078b9035-0528-4d95-892e-4b7e37612b81"],"keyword":["Computer Graphics","Virtual Reality"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-E8177D741EEA6BC41F038D4BE33DE57B"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND 4.0","type":"doi","url":"https://doi.org/10.5220/0010890100003124","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/461956831/GRAPP_2022_Influence_of_Texture_Fidelity_on_Spatial_Perception_in_Virtual_Reality_CAMERA_READY_VERSION.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Technical Faculty of IT and Design","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Andrei-Iuliu","key":"lucacipau","last":"Lucaci","locid":"76888373-45b4-4260-8725-f0fa327809d0","name":"Lucaci, Andrei-Iuliu","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Morten Bach","key":"jakobsenpau","last":"Jakobsen","locid":"fb7f41b8-d34f-4c60-896d-52c4a13bdb98","name":"Jakobsen, Morten Bach","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Poul Anker","key":"jensenpau","last":"Jensen","locid":"7cac5170-1ef1-499d-b209-d40656b51d89","name":"Jensen, Poul Anker","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Claus Brøndgaard","key":"madsenpau","last":"Madsen","locid":"478b566d-fdb4-4151-9582-e23a39d966ca","name":"Madsen, Claus Brøndgaard","orcid":"0000-0003-0762-3713","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.5220/0010890100003124","eisbn":["9789897585555"],"isbn":["9789897585555"],"pages":"244-251","publisher":"SciTePress","status":"p","title":"Proceedings of the 17th International Joint Conference on Computer Vision, Imaging and Computer Graphics Theory and Applications - GRAPP"},"review":"Peer Reviewed","scoID":["2-s2.0-85146201268"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-078b9035-0528-4d95-892e-4b7e37612b81"],"src":["AAU Aalborg University"],"title":"Influence of Texture Fidelity on Spatial Perception in Virtual Reality","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-052227","year":"2022","yearsub":"2022"}
{"abstract":"Background Patient and stakeholder engagements in research have increasingly gained attention in healthcare and healthcare-related research. A common and rigorous approach to establish research priorities based on input from people and stakeholders is the James Lind Alliance Priority Setting Partnership (JLA-PSP). The aim of this study was to establish research priorities for chronic musculoskeletal (MSK) pain by engaging with humans living with chronic MSK pain, relatives to humans living with chronic MSK pain, healthcare professionals (HCP), and researchers working with chronic MSK pain. Methods This JLA-PSP included a nation-wide survey in Denmark, an interim prioritisation, and an online consensus building workshop. The information gained from this was the basis for developing the final list of specific research priorities within chronic MSK pain. Results In the initial survey, 1010 respondents (91% people living with chronic MSK pain/relatives, 9% HCPs/researchers) submitted 3121 potential questions. These were summarised into 19 main themes and 36 sub-themes. In the interim prioritisation exercise, 51% people living with pain/relatives and 49% HCPs/researchers reduced the list to 33 research questions prior to the final priority setting workshop. 23 participants attended the online workshop (12 people/relatives, 10 HCPs, and 1 researcher) who reached consensus for the most important research priorities after two rounds of discussion of each question. Conclusion This study identified several specific research questions generated by people living with chronic MSK pain, relatives, HCPs, and researchers. The stakeholders proposed prioritization of the healthcare system’s ability to support patients, focus on developing coherent pathways between sectors and education for both patients and HCP. These research questions can form the basis for future studies, funders, and be used to align research with end-users’ priorities","author_count":19,"contributors":["Lyng, Kristian Damgaard","Larsen, Jesper Bie","Birnie, K","Stinson, J","Hoegh, Morten","Olesen, Anne Estrup","Arendt-Nielsen, Lars","Ehlers, Lars Holger","Fonager, Kirsten","Jensen, Martin Bach","Würtzen, H","Palsson, Thorvaldur Skuli","Poulin, P","Handberg, G","Ziegler, C","Møller, LB","Olsen, J","Heise, L","Rathleff, Michael Skovdal"],"cuid":["S01-000.00-105530"],"filters":{"added":"2022-06","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["Canada"],"glorg":["All Global Affiliations","Hospital for Sick Children","McGill University","Ottawa Hospital","University of Calgary","University of Toronto"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-OTH","DI-HO-SDR"],"OT":["Gigtforeningen"],"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-HO-CAP","DI-HO-OTH","DI-HO-SDR","DI-U-AAU"]},"review":"und","rtype":["clu"],"sorti":"participatory research a priority setting partnership for chronic musculoskeletal pain in denmark","src":["aau"],"src-code":["DI-U-AAU"],"type":"dpr","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND 4.0","type":"doi","url":"https://doi.org/10.1101/2021.12.17.21267948","version":"Pre-print"},"id":"S01-000.00-105530","ids":["aau-bf62b7e0-40e0-4ed0-ace5-64f14c7ae135"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-3E48F0516DA02D84DCD3B38002B10612"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND 4.0","type":"doi","url":"https://doi.org/10.1101/2021.12.17.21267948","version":"Pre-print"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine, Center for General Practice at Aalborg University","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Musculoskeletal Health and Implementation"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"ca","key":"university of calgary","loc":["Canada","America, North","OECD"],"name":"University of Calgary","used":1},{"affno":"3","country":"ca","key":"university of toronto","loc":["Canada","America, North","OECD"],"name":"University of Toronto","used":1},{"affno":"4","country":"ca","key":"hospital for sick children","loc":["Canada","America, North","OECD"],"name":"Hospital for Sick Children","used":1},{"affno":"5","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Rigshospitalet, Copenhagen University Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"6","country":"ca","key":"mcgill university","loc":["Canada","America, North","OECD"],"name":"McGill University","used":1},{"affno":"7","country":"ca","key":"ottawa hospital","loc":["Canada","America, North","OECD"],"name":"Ottawa Hospital","used":1},{"affno":"8","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Odense University Hospital"],"nora_code":"DI-HO-SDR","used":1},{"affno":"9","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc