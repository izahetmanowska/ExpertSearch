],"nora_code":"DI-HO-CAP","used":1},{"affno":"4","country":"dk","key":"region zealand","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-ZEA","l3nl":"Region Zealand","l3nn":"Region Zealand","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region Zealand","namevar":["Zealand University Hospital - Køge"],"nora_code":"DI-HO-ZEA","used":1},{"affno":"5","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Orthopaedic Surgery"],"nora_code":"DI-U-KU","used":1},{"affno":"6","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine, Center for General Practice at Aalborg University"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Behnam","key":"liaghatpau","last":"Liaghat","locid":"02a3f8a6-b47d-4c88-9c31-6ffb568e3937","name":"Liaghat, Behnam","orcid":"0000-0002-3050-0028","rank":1,"rolecode":"pau"},{"affno":"2 3 4","corresponding":null,"first":"Anja","key":"ussingpau","last":"Ussing","name":"Ussing, Anja","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Birgitte Holm","key":"petersenpau","last":"Petersen","name":"Petersen, Birgitte Holm","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Henning Keinke","key":"andersenpau","last":"Andersen","name":"Andersen, Henning Keinke","rank":4,"rolecode":"pau"},{"affno":"5 3","first":"Kristoffer Weisskirchner","key":"barfodpau","last":"Barfod","locid":"70681805-e002-4b26-8452-9a2454fdfaae","name":"Barfod, Kristoffer Weisskirchner","rank":5,"rolecode":"pau"},{"affno":"6","corresponding":null,"country":"dk","first":"Martin Bach","key":"jensenpau","last":"Jensen","locid":"929fc31a-f5b6-45b8-b3ed-29bd2c4b4bf7","name":"Jensen, Martin Bach","orcid":"0000-0003-2162-7390","rank":6,"rolecode":"pau"},{"affno":"6","corresponding":null,"country":"dk","first":"Morten","key":"hoeghpau","last":"Hoegh","locid":"a00ca33f-b3be-4c30-a740-6f28f3ac7b26","name":"Hoegh, Morten","orcid":"0000-0002-9724-767X","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Simon","key":"tarppau","last":"Tarp","name":"Tarp, Simon","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Birgit","key":"juulkristensenpau","last":"Juul-Kristensen","locid":"887ddfe7-cfa6-4b72-a17d-ecf86987c5c0","name":"Juul-Kristensen, Birgit","orcid":"0000-0002-4973-8415","rank":9,"rolecode":"pau"},{"affno":"5","first":"Stig","key":"brorsonpau","last":"Brorson","locid":"deaeec1d-fb1b-4f07-b2ec-7b71ca973516","name":"Brorson, Stig","orcid":"0000-0001-5337-758X","rank":10,"rolecode":"pau"}],"pmid":["33930326"],"pub":{"doi":"10.1016/j.apmr.2021.03.027","issn":["00039993","1532821X"],"issn_org":["00039993"],"issue":"12","journal":"Archives of Physical Medicine and Rehabilitation","publisher":"WB  Saunders","publisher_org":"W.B. Saunders","status":"p","title":"Archives of Physical Medicine and Rehabilitation","volume":"102"},"review":"Peer Reviewed","scoID":["2-s2.0-85108560647"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Region Zealand","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-c695c47e-9807-4a1b-a31a-4c7bdd604f68","ku-9cf348aa-09a0-4520-b9df-a0352ace6cb8","sdu-5e29cb60-71ae-4f40-a01e-31440a1d0b6f"],"src":["AAU Aalborg University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Supervised Training Compared With No Training or Self-training in Patients With Subacromial Pain Syndrome : A Systematic Review and Meta-analysis","type":"Journal Review","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-097.56-009535","year":"2021","yearsub":"2021"}
{"abstract":"New lineages of SARS-CoV-2 are of potential concern due to higher transmissibility, risk of severe outcomes, and/or escape from neutralizing antibodies. Lineage B.1.1.7 (the Alpha variant) became dominant in early 2021, but the association between transmissibility and risk factors, such as age of primary case and viral load remains poorly understood. Here, we used comprehensive administrative data from Denmark, comprising the full population (January 11 to February 7, 2021), to estimate household transmissibility. This study included 5,241 households with primary cases; 808 were infected with lineage B.1.1.7 and 4,433 with other lineages. Here, we report an attack rate of 38% in households with a primary case infected with B.1.1.7 and 27% in households with other lineages. Primary cases infected with B.1.1.7 had an increased transmissibility of 1.5-1.7 times that of primary cases infected with other lineages. The increased transmissibility of B.1.1.7 was multiplicative across age and viral load.","author_count":61,"contributors":["Lyngse, Frederik Plesner","Mølbak, Kåre","Skov, Robert Leo","Christiansen, Lasse Engbo","Mortensen, Laust Hvas","Albertsen, Mads","Møller, Camilla Holten","Krause, Tyra Grove","Rasmussen, Morten","Michaelsen, Thomas Yssing","Voldstedlund, Marianne","Fonager, Jannik","Steenhard, Nina","Kirkeby, Carsten Thure","Albertsen, Mads","Brandt, Jakob","Knutsson, Simon","Sørensen, Emil Aarre","Nymann, Thomas","Petersen, Celine","Chiche-Lapierre, Clarisse","Hansen, Frederik Teilfeldt","Collados, Emilio Fuster","Berg, Amalie","Bielidt, Susanne R.","Mølvang Dall, Sebastian","Dvarionaite, Erika","Hove Hansen, Susan","Jørgensen, Vibeke Rudkjøbing","Nicolajsen, Trine B.","Saei, Wagma","Østergaard, Stine Karstenskov","Michaelsen, Thomas Yssing","Le, Vang","Sereika, Mantas","Kirkegaard, Rasmus Hansen","Andersen, Kasper Skytte","Andersen, Martin Hjorth","Hansen, Karsten Kryger","Boye, Mads","Bach, Mads Peter","Dissing, Peter","Drastrup-Fjordbak, Anton","Collin, Michael","Büttner, Finn","Andersen, Susanne","Otte, Lea Sass","Bøgsted, Martin","Brøndum, Rasmus Froberg","Hose, Katja","Sagi, Tomer","Pakanec, Miroslav","Krarup, Henrik","Fuglsang-Damgaard, David","Mølvadgaard, Mette"],"cuid":["S04-089.27-008834"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"51-200 contributors","class":"merged","cluster_size":4,"corpau":["Danish Covid-19 Genome Consortium"],"corresponding_author":["Lyngse, Frederik Plesner"],"keyword":["Adolescent","Adult","Age Factors","Aged","Aged 80 and over","COVID 19 epidemiology","Child","Child Preschool","Denmark epidemiology","Female","Humans","Infant","Infant Newborn","Male","Middle Aged","SARS CoV 2","Viral Load","Young Adult"],"level":"sci","mra":["med","sci","soc"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-OT","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"OT":["Danmarks Statistik"],"U":["DI-U-AAU","DI-U-ALL","DI-U-DTU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-GV-SSI","DI-U-AAU","DI-U-DTU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"increased transmissibility of sars cov 000000000002 lineage b 000000000001 000000000001 000000000007 by age and viral load","src":["aau","dtu","ku","sdu"],"src-code":["DI-U-AAU","DI-U-DTU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41467-021-27202-x","version":"Published Version"},"id":"S04-089.27-008834","identifier":[{"id":"000729942300018","type":"wos"},{"id":"PMC8669007","type":"pmcid"},{"id":"85122774462","type":"scopus"},{"id":"34903718","type":"pmid"}],"ids":["aau-b7136dad-880b-4abe-a5bf-0b43cb824e11","dtu-b5be2aa7-5d47-4bb0-a882-b767365c8b1b","ku-a7e11899-065a-4578-8b1d-d3e4c487a37b","sdu-479104bc-ec55-4c2b-9976-8b9a0573c227"],"keyword":["Adolescent","Adult","Age Factors","Aged","Aged, 80 and over","COVID-19/epidemiology","Child","Child, Preschool","Denmark/ep