rcid":"0000-0002-2648-5750","rank":7,"rolecode":"pau"}],"pmid":["39225788"],"pub":{"doi":"10.1080/02813432.2024.2396873","issn":["02813432","15027724"],"issn_org":["02813432"],"issue":"1","journal":"Scandinavian Journal of Primary Health Care","pages":"75-84","publisher":"Informa Healthcare","status":"p","title":"Scandinavian Journal of Primary Health Care","volume":"43"},"review":"Peer Reviewed","scoID":["2-s2.0-85203000086"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-a33c3344-daf2-4e6f-a705-688e078c19e9"],"src":["AAU Aalborg University"],"title":"Exploring general practice staff perspectives on a teaching concept based on instruction videos for diabetic retinopathy screening - an interview study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-757108","year":"2025","yearsub":"2025"}
{"abstract":"Archaeobotanical and stable isotope analysis on plant remains from 39 sites spanning the Bronze, Iron, and Viking Ages in Denmark has been undertaken in order to investigate the development and resilience of agricultural practices, particularly through the 1250-year-long Iron Age (500 BC – AD 750). During this time, an increase in the spectrum of food resources can be seen in the archaeobotanical material. At the same time, soil enrichment of fields of barley, which increased markedly during the Bronze-Iron Age transition, remains consistent until the Viking Age. A more broad-spectrum diet appears to tie in with agricultural extensification comprising increased scales of land use and fallowing alongside possibly less intense tillage of fields. These practices appear to have made agriculture resilient to climatic fluctuations during our study period, with the possible exception of a shift following volcanic eruptions in AD 536/540.","author_count":24,"contributors":["Hald, Mette Marie","Styring, Amy","Mortensen, Morten Fischer","Maltas, Tom","Vidas, Doris","Henriksen, Peter Steen","Pihl, Anders","Jensen, Peter Mose","Christensen, Lotte Bach","Hansen, Jesper","Dollar, Scott","Egeberg, Torben","Lundø, Michael Borre","Haue, Niels","Hertz, Eivind","Iversen, Rasmus Birch","Jørgensen, Thomas","Kristensen, Inge Kjær","Klassen, Lutz","Møller, Niels Algreen","Pedersen, Vibeke J.","Ravn, Mads","Vestergaard, Katrine","Dengsø Jessen, Mads"],"cuid":["S01-000.00-760608"],"filters":{"added":"2024-10","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"corresponding_author":["Hald, Mette Marie","Styring, Amy"],"country":["United Kingdom"],"glorg":["All Global Affiliations","Keble College, University of Oxford","School of Archaeology, University of Oxford, Oxford, UK"],"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-OT","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-KUM"],"OT":["Holstebro Museum"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-GV-KUM","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"farming during turbulent times agriculture food crops and manuring practices in bronze age to viking age denmark","src":["kum"],"src-code":["DI-GV-KUM"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85202556459","version":"Other Version"},"id":"S01-000.00-760608","identifier":[{"id":"85202556459","type":"scopus"}],"ids":["kum-b407cea8-cee2-479e-9c0f-49d5640d6932"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Global-Local-2-4-0FB00D571607B59FFC28D569D3CDC4DF"],"org":[{"affno":"1","key":"kum ministry of culture archives museums and royal library denmark","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-KUM","l3nn":"KUM Ministry of Culture - Archives, Museums, and Royal Library Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KUM Ministry of Culture - Archives, Museums, and Royal Library Denmark","namevar":["Ministry of Culture Denmark, The National Museum of Denmark, Environmental Archaeology and Materials Science"],"nora_code":"DI-GV-KUM","used":1},{"affno":"2","country":"gb","key":"school of archaeology university of oxford oxford uk","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"School of Archaeology, University of Oxford, Oxford, UK","used":1},{"affno":"3","country":"gb","key":"keble college university of oxford","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Keble College, University of Oxford","used":1},{"affno":"4","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University"],"nora_code":"DI-U-AU","used":1},{"affno":"5","country":"dk","key":"miscellaneous","l2":"DI-OT","