e7b","name":"Rathleff, Michael Skovdal","name_org":"Rathleff, MS","orcid":"0000-0003-1173-0335","rank":19,"rolecode":"pau"}],"pub":{"doi":"10.1101/2021.12.17.21267948","pages":"17","publisher":"medRxiv","status":"p"},"review":"Undetermined","search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Hospitals","Other Research","Region of Southern Denmark","Universities","fibromyalgi- & smerteforeningen"],"PST":["Published"]},"sid":["aau-bf62b7e0-40e0-4ed0-ace5-64f14c7ae135"],"src":["AAU Aalborg University"],"title":"Participatory Research : A Priority Setting Partnership for Chronic Musculoskeletal Pain in Denmark","type":"Preprint","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-105530","year":"2021","yearsub":"2021"}
{"abstract":"Versatile DNA assembly standards and compatible, well-characterized part libraries are essential tools for creating effective designs in synthetic biology. However, to date, vector standards for Gram-positive hosts have limited flexibility. As a result, users often revert to PCR-based methods for building the desired genetic constructs. These methods are inherently prone to introducing mutations, which is problematic considering vector backbone parts are often left unsequenced in cloning workflows. To circumvent this, we present the ProUSER2.0 toolbox: A standardized vector platform for building both integrative and replicative shuttle vectors forBacillus subtilis. The ProUSER2.0 vectors consist of a ProUSER cassette for easy and efficient insertion of cargo sequences and six exchangeable modules. Furthermore, the standard is semicompatible with several previously developed standards, allowing the user to utilize the parts developed for these. To provide parts for the toolbox, seven novel integration sites and six promoters were thoroughly characterized in B. subtilis. Finally, the capacity of the ProUSER2.0 system was demonstrated through the construction of signal peptide libraries for two industrially relevant proteins. Altogether, the ProUSER2.0 toolbox is a powerful and flexible framework for use in B. subtilis.","author_count":7,"contributors":["Falkenberg, Kristoffer Bach","Mol, Viviënne","Sainz de la Maza Larrea, Arrate","Pogrebnyakov, Ivan","Nørholm, Morten","Nielsen, Alex Toftgaard","Ingemann Jensen, Sheila"],"cuid":["S01-000.00-359692"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Ingemann Jensen, Sheila"],"keyword":["Bacillus subtilis","Gram positive","Protein expression","Standardization","Synthetic biology"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"the prouser000000000002 000000000000 toolbox genetic parts and highly customizable plasmids for synthetic biology in bacillus subtilis","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1021/acssynbio.1c00130","version":"Published Version"},"id":"S01-000.00-359692","identifier":[{"id":"34793671","type":"pmid"},{"id":"85119989725","type":"scopus"}],"ids":["dtu-b8687c06-d63b-4015-865e-e5cb812d5793"],"keyword":["Bacillus subtilis","Gram-positive","Protein expression","Standardization","Synthetic biology"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-A6BE52DF395A8407B46CC302557E68E1"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1021/acssynbio.1c00130","version":"Published Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/265980258/acssynbio.1c00130.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Novo Nordisk Foundation Center for Biosustainability","Technical University of Denmark, Novo Nordisk Foundation Center for Biosustainability, Research Groups, Microbial Evolution and Synthetic Biology"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Kristoffer Bach","key":"falkenbergpau","last":"Falkenberg","locid":"5598d68a-a7d1-45a0-9829-84d2e3cc0a0b","name":"Falkenberg, Kristoffer Bach","orcid":"0000-0002-1155-2455","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Viviënne","key":"molpau","last":"Mol","locid":"a964d003-98c4-41e5-b264-a626663c2abc","name":"Mol, Viviënne","orcid":"0000-0002-4401-686X","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Arrate Sainz","key":"delamazalarreapau","last":"De La Maza Larrea","locid":"1d4cb0b5-81d5-4016-8165-a03f8aa11c11","name":"Sainz de la Maza Larrea, Arrate","name_org":"De La Maza Larrea, Arrate Sainz","orcid":"0000-0002-0365-681X","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ivan","key":"pogrebnyakovpau","last":"Pogrebnyakov","locid":"21f851e6-1aba-4590-8119-a639512cb504","name":"Pogrebnyakov, Ivan","orcid":"0000-0001-9354-2324","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Morten H.H.","key":"nørholmpau","last":"Nørholm","locid":"d81af4b6-d849-476b-b712-acc87a5b0106","name":"Nørholm, Morten","name_org":"Nørholm, Morten H.H.","orcid":"0000-0002-7871-5191","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Alex Toftgaard","key":"nielsenpau","last":"Nielsen","locid":"546704be-c3d2-4a22-8d7f-5f569e6a1e73","name":"Nielsen, Alex Toftgaard","orcid":"0000-0001-6616-0187","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Sheila Ingemann","key":"jensenpau","last":"Jensen","locid":"c04f7c3a-7da8-48c2-854f-7a353811596e","name":"Ingemann Jensen, Sheila","name_org":"Jensen, Sheila Ingemann","orcid":"0000-0001-8277-5907","rank":7,"rolecode":"pau"}],"pmid":["34793671"],"pub":{"doi":"10.1021/acssynbio.1c00130","issn":["21615063"],"issue":"12","journal":"ACS Synthetic Biology","pages":"3278-3289","publisher":"American Chemical Society","status":"p","title":"ACS Synthetic Biology","volume":"10"},"review":"Peer Reviewed","scoID":["2-s2.0-85119989725"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-b8687c06-d63b-4015-865e-e5cb812d5793"],"src":["DTU Technical University of Denmark"],"title":"The ProUSER2.0 Toolbox: Genetic Parts and Highly Customizable Plasmids for Synthetic Biology in Bacillus subtilis","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-359692","year":"2021","yearsub":"2021"}
{"abstract":"Sundhedsstyrelsen udgiver en opdateret vidensbaseret national klinisk retningslinje om behandling af patienter med subakromielt smertesyndrom af mere end en måneds varighed. Skuldersmerter er det tredje mest almindelige muskel-skelet-problem og en hyppig årsag til henvendelser til almen praksis. Retningslinjen præsenterer fire anbefalinger for udvalgte kliniske problemstillinger i det samlede behandlingsforløb inden for følgende områder: Træningsindsatser Behandling med glukokortikoid injektion Pladsskabende operation under skulderhøjen (subakromiel dekompression) ved smerter i mindre end 6 måneder Subakromiel dekompression ved symptomer i mere end 6 måneder og manglende effekt af et superviseret træningsforløb Med publicering af denne retningslinje udgår en tidligere retningslinje om skuldersmerter fra 2013. Den nye retningslinje ser udelukkende på behandling af skuldersmerter, hvor den tidligere retningslinje, også indeholdt nedslagspunkter om diagnostik, behandling og rehabilitering Ligeledes udgår Sundhedsstyrelsens faglige visitationsretningslinjer fra 2011 vedrørende udvalgte skulderproblemer, impingementsyndrom/rotator cuff-syndrom og traumatisk rotator cuff-ruptur, da disse retningslinjer ikke understøtter den nye kliniske retningslinje.","author_count":11,"contributors":["Delfi, Akram Dakhil","Sørensen, Anne Kathrine Belling","Pedersen, Carsten Boe","Olesen, Jens Lykkegaard","Barfod, Kristoffer W.","Jensen, Martin Bach","Høgh, Morten","Jensen, Steen Lund","Svendsen, Susanne Wulff","Thillemann, Theis","Liaghat, Behnam"],"cuid":["S01-000.00-605421"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"level":"com","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-PR","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-OTH"],"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-OTH","DI-PR-OTH","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"nkr behandling af patienter med subakromielt smertesyndrom i skulderen","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://www.sst.dk/da/udgivelser/2013/nkr-udvalgte-skulderlidelser","version":"Published Version"},"id":"S01-000.00-605421","ids":["sdu-70a23c58-29af-409e-bf3a-b14b1439a412"],"lang":"Danish","level":"Commissioned","mra":["Medical Science"],"noi":["Local-1-1-FBC9D7E254FDB6DBD62B36629678ABCD"],"oa_link":[{"access":"oa","type":"rem","url":"https://www.sst.dk/da/udgivelser/2013/nkr-udvalgte-skulderlidelser","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Herlev og Gentofte Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1},{"affno":"3","country":"dk","key":"other hospitals","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-OTH","l3nl":"Other Hospitals","l3nn":"Other Hospitals","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Hospitals","namevar":["Dansk Selskab for Almen Medicin"],"nora_code":"DI-HO-OTH","used":1},{"affno":"4","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["FysioDanmark Aarhus ApS"],"nora_code":"DI-PR-OTH","used":1},{