k":24,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.jasrep.2024.104736","issn":["2352409X"],"issue":"October","journal":"Journal of Archaeological Science: Reports","paperid":"104736","publisher":"Elsevier BV","publisher_org":"Elsevier B.V.","status":"p","title":"Journal of Archaeological Science: Reports","volume":"58"},"review":"Peer Reviewed","scoID":["2-s2.0-85202556459"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Governmental Institutions","All Miscellaneous","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Governmental Institutions","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["kum-b407cea8-cee2-479e-9c0f-49d5640d6932"],"src":["KUM Ministry of Culture - Archives, Museums, and Royal Library Denmark"],"title":"Farming during turbulent times : Agriculture, food crops, and manuring practices in Bronze Age to Viking Age Denmark","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-760608","year":"2024","yearsub":"2024"}
{"abstract":"Evidence and gap maps (EGMs) can be used to identify gaps within specific research areas and help guide future research agendas and directions. Currently, there are no EGMs within the broad domain of chronic musculoskeletal (MSK) pain in adults. The aim of this study was to create a contemporary EGM of interventions and outcomes used for research investigating chronic MSK pain. This EGM was based on systematic reviews of interventions published in scientific journals within the past 20 years. Embase, PubMed, the Cochrane Library, and PsycINFO were used to retrieve studies for inclusion. The quality of the included reviews was assessed using AMSTAR-II. Interventions were categorised as either physical, psychological, pharmacological, education/advice, interdisciplinary, or others. Outcomes were categorised using the Initiative on Methods, Measurement, and Pain Assessment in Clinical Trials (IMMPACT) recommendations. Of 4299 systematic reviews, 457 were included. Of these, 50% were rated critically low quality, 25% low quality, 10% moderate quality, and 15% rated high quality. Physical interventions (eg, exercise therapy) and education were the most common interventions reported in 80% and 20% of the studies, respectively. Pain (97%) and physical functioning (87%) were the most reported outcomes in the systematic reviews. Few systematic reviews used interdisciplinary interventions (3%) and economic-related outcomes (2%). This contemporary EGM revealed a low proportion of high-quality evidence within chronic MSK pain. This EGM clearly outlines the lack of high-quality research and the need for increased focus on interventions encompassing the entire biopsychosocial perspective.","author_count":23,"contributors":["Lyng, Kristian Damgaard","Djurtoft, Chris","Bruun, Malene Kjær","Christensen, Mads Norre","Kildahl Lauritsen, Rikke Emilie","Larsen, Jesper Bie","Birnie, Kathryn A","Stinson, Jennifer","Hoegh, Morten","Palsson, Thorvaldur Skuli","Olesen, Anne Estrup","Arendt-Nielsen, Lars","Ehlers, Lars H","Fonager, Kirsten","Jensen, Martin Bach","Würtzen, Hanne","Poulin, Patricia A","Handberg, Gitte","Ziegler, Connie","Moeller, Lars B","Olsen, Judi","Heise, Lotte","Rathleff, Michael Skovdal"],"cuid":["S02-099.50-672349"],"filters":{"added":"2023-02","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["America, North","OECD"],"corresponding_author":["Lyng, Kristian D"],"country":["Canada"],"glorg":["All Global Affiliations","Hospital for Sick Children","Ottawa Hospital","The Hospital for Sick Children","University of Calgary","University of Ottawa","University of Toronto"],"keyword":["ADULTS","Adult","Chronic Pain therapy","Chronic pain","Evidence and gap map","Evidence map","Exercise Therapy methods","Humans","Musculoskeletal Pain diagnosis","Musculoskeletal pain","Pain Measurement","Review Literature as Topic"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-PR","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-NDR","DI-HO-OTH","DI-HO-SDR"],"OT":["Gigtforeningen"],"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-AAU","DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-NDR","DI-HO-OTH","DI-HO-SDR","DI-PR-OTH","DI-U-AAU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"what is known and what is still unknown within chronic musculoskeletal pain a systematic evidence and gap map","src":["aau","sdu"],"src-code":["DI-U-AAU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/514408553/00006396_900000000_97590.pdf","version":"Authors Final Version"},"id":"S02-099.50-672349","identifier":[{"id":"36602421","type":"pmid"},{"id":"85163474371","type":"scopus"}],"ids":["aau-6f090aa8-cf30-4e97-97e9-d5a6abd7b021","sdu-006cb5ac-d40d-406a-b73c-80c71e4bc18c"],"keyword":["Adult","Adults","Chronic Pain/therapy","Chro