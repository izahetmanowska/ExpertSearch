ank":9,"rolecode":"pau"}],"pmid":["25356780"],"pub":{"doi":"10.1021/jf504104q","issn":["00218561","15205118"],"issn_org":["00218561"],"issue":"46","journal":"Journal of Agricultural and Food Chemistry","pages":"11270-11278","publisher":"American Chemical Society","status":"p","title":"Journal of Agricultural and Food Chemistry","volume":"62"},"review":"Peer Reviewed","scoID":["2-s2.0-84913532884"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Private Research","All Universities","Arla Foods","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Private Research","Universities"],"PST":["Published"]},"sid":["au-5295dacb-0b9d-483d-bb74-eb928e6ff4b1"],"src":["AU Aarhus University"],"title":"Chemical and proteolysis-derived hanges during long-term storage of lactose-hydrolyzed ultrahigh-temperature (UHT) milk","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-176449","year":"2014","yearsub":"2014"}
{"abstract":"Jerusalem artichoke tubers (Helianthus tuberosus L.) undergo enzymatic browning when peeled or cut, and turn grey after boiling, due to after-cooking darkening reactions between iron and phenolic acids. In an attempt to reveal the components responsible for these discolouration reactions, sensory evaluation and instrumental colour measurements were related to contents of total phenolics, phenolic acids, organic acids and iron in three varieties of raw and boiled Jerusalem artichoke tubers harvested in the autumn and the spring. No differences were found between varieties in sensory evaluated enzymatic browning, but Rema and Draga had higher scores than Mari in after-cooking darkening. Jerusalem artichoke tubers had higher contents of total phenolics, phenolic acids and citric acid in the autumn and low contents in the spring, while it was the opposite for malic acid. None of the chemical parameters investigated could explain the discolouration of the Jerusalem artichoke tubers.","author_count":5,"contributors":["Bach, Vibe","Jensen, Sidsel","Clausen, Morten Rahr","Bertram, Hanne Christine S.","Edelenbos, Merete"],"cuid":["S01-000.00-153806"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Helianthus tuberosus","Iron","Organic acids","Phenolic compounds"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"enzymatic browning and after cooking darkening of jerusalem artichoke tubers em helianthus tuberosus em l","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.foodchem.2013.04.028","version":"Other Version"},"id":"S01-000.00-153806","identifier":[{"id":"84878416246","type":"scopus"},{"id":"23790937","type":"pmid"}],"ids":["au-2ac4da20-82b5-4604-8508-be444fb88bec"],"keyword":["Helianthus tuberosus","Phenolic compounds","after-cooking darkening","discolouration","enzymatic browning","iron","organic acids"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-D86807F100A929E3C6588B98C842B146"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.foodchem.2013.04.028","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Food Science"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Vibe","key":"bachpau","last":"Bach","locid":"a9dc7d22-0daf-45d5-92cb-1de1c0705ae8","name":"Bach, Vibe","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sidsel","key":"bennedbækjensenpau","last":"Bennedbæk-Jensen","locid":"4efa5bb5-7bc4-441e-809a-70cbb1a01b92","name":"Jensen, Sidsel","name_org":"Bennedbæk-Jensen, Sidsel","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Morten Rahr","key":"clausenpau","last":"Clausen","locid":"18396755-daca-4cef-946e-a911a99addc0","name":"Clausen, Morten Rahr","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Hanne Christine S.","key":"bertrampau","last":"Bertram","locid":"9ad2a927-38d2-4267-9382-a851bf3c7e06","name":"Bertram, Hanne Christine S.","orcid":"0000-0002-1882-5321","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Merete","key":"edelenbospau","last":"Edelenbos","locid":"89bc334c-15cd-410f-a5c3-c790fe491fd8","name":"Edelenbos, Merete","rank":5,"rolecode":"pau"}],"pmid":["23790937"],"pub":{"doi":"10.1016/j.foodchem.2013.04.028","issn":["03088146","18737072"],"issn_org":["03088146"],"issue":"2","journal":"Food Chemistry","pages":"1445-1450","publisher":"Elsevier","status":"p","title":"Food Chemistry","volume":"141"},"review":"Peer Reviewed","scoID":["2-s2.0-84878416246"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-2ac4da20-82b5-4604-8508-be444fb88bec"],"src":["AU Aarhus University"],"title":"Enzymatic browning and after-cooking darkening of Jerusalem artichoke tubers (<em>Helianthus tuberosus</em> L.)","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-153806","year":"2013","yearsub":"2013"}
