{"abstract":"Uredelighed. Uden for Danmarks grænser anses rene sjuskefejl ikke for at være lig med uredelighed eller strafbare. Det gør de i udkastet fra Forskningsministeriet til en dansk kodeks for videnskabelig integritet. En sådan kodeks er skadelig","author_count":14,"contributors":["Dyre, J. C.","Borregaard, Niels","Dahl-Jensen, Dorthe","Gregersen, Frans","Hjorth, Jens","Nissen, Poul","Nosch, Marie-Louise","Porsdam, Helle","Ravnkilde, Jens","Sørensen, Thorkild I.A.","Tamm, Ditlev","Willerslev, Eske","Wengel, Jesper","Zahavi, Dan"],"cuid":["S01-000.00-564750"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"level":"pop","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-KU","DI-U-RUC","DI-U-SDU"]},"level3all":["DI-U-AAU","DI-U-KU","DI-U-RUC","DI-U-SDU"]},"review":"und","rtype":["clu"],"sorti":"i strid med sund fornuft","src":["ruc"],"src-code":["DI-U-RUC"],"type":"dna","type-grp":["all","pub"]},"id":"S01-000.00-564750","ids":["ruc-8268ef71-4bc9-430a-8d9a-86c2e8b7e3d0"],"lang":"Danish","level":"Popular","mra":["Science/Technology"],"noi":["Local-1-1-CD401A7F8C50316CD32431ABB7962F4A"],"org":[{"affno":"1","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of Science and Environment, Glass and Time","Roskilde University, Department of Science and Environment, Mathematics and Physics (IMFUFA)","Roskilde University, The Department of Science, Systems and Models"],"nora_code":"DI-U-RUC","used":1},{"affno":"2","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"dk","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University"],"nora_code":"DI-U-AAU","used":1},{"affno":"4","country":"dk","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["University of Southern Denmark"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","country":"dk","first":"J. C.","key":"dyrepau","last":"Dyre","locid":"06e6938e-66af-4c30-ab7f-379ab9003a1d","name":"Dyre, J. C.","orcid":"0000-0002-0770-5690","rank":1,"rolecode":"pau"},{"affno":"2","first":"Niels","key":"borregaardpau","last":"Borregaard","name":"Borregaard, Niels","rank":2,"rolecode":"pau"},{"affno":"2","first":"Dorthe","key":"dahljensenpau","last":"Dahl-Jensen","name":"Dahl-Jensen, Dorthe","rank":3,"rolecode":"pau"},{"affno":"2","first":"Frans","key":"gregersenpau","last":"Gregersen","name":"Gregersen, Frans","rank":4,"rolecode":"pau"},{"affno":"2","first":"Jens","key":"hjorthpau","last":"Hjorth","name":"Hjorth, Jens","rank":5,"rolecode":"pau"},{"affno":"3","first":"Poul","key":"nissenpau","last":"Nissen","name":"Nissen, Poul","rank":6,"rolecode":"pau"},{"affno":"2","first":"Marie-Louise","key":"noschpau","last":"Nosch","name":"Nosch, Marie-Louise","rank":7,"rolecode":"pau"},{"affno":"2","first":"Helle","key":"porsdampau","last":"Porsdam","name":"Porsdam, Helle","rank":8,"rolecode":"pau"},{"affno":"","first":"Jens","key":"ravnkildepau","last":"Ravnkilde","name":"Ravnkilde, Jens","rank":9,"rolecode":"pau"},{"affno":"2","firs