t":"Louise Hauge","key":"matzenpau","last":"Matzen","locid":"6d2056e0-6343-4b7e-94d0-f3c63475edd4","name":"Matzen, Louise Hauge","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars","key":"schropppau","last":"Schropp","locid":"3ae0d2fd-2662-499f-8d5e-5246156d138f","name":"Schropp, Lars","orcid":"0000-0003-4897-1554","rank":3,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Thomas","key":"sangildpau","last":"Sangild","locid":"238617be-efcb-4532-9834-4da7f0103d5a","name":"Sørensen, Thomas Sangild","name_org":"Sangild, Thomas","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ann","key":"wenzelpau","last":"Wenzel","locid":"314cf777-b5eb-4d7c-a49e-cf3a36431859","name":"Wenzel, Ann","rank":5,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-60221377-89be-4e2d-855e-35f89d2122c6"],"src":["AU Aarhus University"],"title":"Correcting Motion Artefacts in CBCT and Impact on Image Quality","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-184219","year":"2017","yearsub":"2017"}
{"abstract":"PURPOSE: To compare three magnetic resonance imaging (MRI) protocols containing diffusion-weighted imaging with background suppression (DWIBS) and one traditional protocol for detecting extrahepatic colorectal cancer metastases. MATERIALS AND METHODS: Thirty patients with extrahepatic colorectal cancer metastases were scanned in three stations from the skull base to the upper thighs using a 1.5T MRI system with six different MRI sequences; transverse and coronal T2 -weighted (T2 W) turbo spin-echo (TSE), coronal short tau inversion recovery (STIR), 3D T1 W TSE, DWIBS, and a contrast-enhanced T1 W 3D gradient echo (GRE) sequence. The six sequences were used to build four hypothetical MRI interpretive sets which were read by two readers in consensus, blinded to prior imaging. Lesions were categorized into 13 anatomic regions. Fluorodeoxyglucose / positron emission tomography / computed tomography (FDG-PET/CT) read with full access to prior imaging and clinical records was used as the reference standard. Sensitivity, specificity, and false discovery rate (FDR) were calculated as appropriate and receiver operating characteristic (ROC) curves were constructed. RESULTS: In all, 177 malignant lesions were detected by FDG-PET/CT and distributed in 92 out of 390 scanned anatomic regions. The sensitivity was statistically higher in two out of three sets incorporating DWIBS on a per-lesion basis (66.7%, 63.3%, and 66.7% vs. 57.6%) (P = 0.01, P = 0.11, and P = 0.01, respectively) and in all sets incorporating DWIBS on a per-region basis (75.0%, 75.0%, and 77.2 vs. 66.3%) (P = 0.04, P = 0.04, and P = 0.01, respectively). There was no difference in specificity, FDR, or AUCROC . There was no difference between sets containing DWIBS irrespective of the use of a contrast-enhanced sequence. CONCLUSION: MRI sets containing DWIBS had superior sensitivity. This sensitivity was retained when omitting a contrast-enhanced sequence. LEVEL OF EVIDENCE: 1 Technical Efficacy: Stage 2 J. Magn. Reson. Imaging 2017;46:1619-1630.","author_count":8,"contributors":["Sivesgaard, Kim","Jöhnk, Maria Louise","Larsen, Lars P","Sørensen, Michael","Kramer, Stine","Løgager, Vibeke Berg","Hansen, Flemming","Pedersen, Erik Morre"],"cuid":["S01-000.00-201774"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Journal Article"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"comparison of four mri protocols for detection of extrahepatic colorectal cancer metastases","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85015433888","version":"Other Version"},"id":"S01-000.00-201774","identifier":[{"id":"85015433888","type":"scopus"},{"id":"28301099","type":"pmid"}],"ids":["au-7e9cb1b5-72c7-4c42-bcf3-5bc294e8f5fa"],"keyword":["Journal Article"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-27C2CCF8E6B79DB5ABF2440124EAA210"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Radiology"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Kim","key":"sivesgaardpau","last":"Sivesgaard","locid":"7336b7f0-b751-4b97-a49e-ebe7963020d3","name":"Sivesgaard, Kim","orcid":"0000-0001-6336-9890","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Maria Louise","key":"jöhnkpau","last":"Jöhnk","name":"Jöhnk, Maria Louise","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lars P","key":"larsenpau","last":"Larsen","locid":"814320d4-becd-4a70-9f63-97d3285e8f08","name":"Larsen, Lars P","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Michael","key":"sørensenpau","last":"Sørensen","locid":"3ba20be7-fb44-42d1-8ef1-8f321af09552","name":"Sørensen, Michael","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Stine","key":"kramerpau","last":"Kramer","locid":"d21fa2ef-6507-4537-bcc5-b026b792e49f","name":"Kramer, Stine","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Vibeke Berg","key":"løgagerpau","last":"Løgager","name":"Løgager, Vibeke Berg","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Flemming","key":"hansenpau","last":"Hansen","locid":"62ae5195-4134-4540-9d9b-ee4f13f47299","name":"Hansen, Flemming","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Erik Morre","key":"pedersenpau","last":"Pedersen","locid":"397a353e-5325-4d03-b334-b0841f4e8daf","name":"Pedersen, Erik Morre","orcid":"0000-0001-6798-3644","rank":8,"rolecode":"pau"}],"pmid":["28301099"],"pub":{"doi":"10.1002/jmri.25704","issn":["10531807","15222586"],"issn_org":["10531807"],"issue":"6","journal":"Journal of Magnetic Resonance Imaging","pages":"1619-1630","publisher":"John Wiley & Sons Inc.","status":"p","title":"Journal of Magnetic Resonance Imaging","volume":"46"},"review":"Peer Reviewed","scoID":["2-s2.0-85015433888"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-7e9cb1b5-72c7-4c42-bcf3-5bc294e8f5fa"],"src":["AU Aarhus University"],"title":"Comparison of four MRI protocols for detection of extrahepatic colorectal cancer metastases","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-201774","year":"2017","yearsub":"2017"}
{"author_count":13,"contributors":["Strandberg, Beate","Damgaard, Christian","Hasler, Berit","Bruus, Marianne","Axelsen, Jørgen Aagaard","Sørensen, Peter Borgen","Pedersen, Anders Branth","Fauser, Patrik","Hansen, Søren","Christensen, Jesper Heile","Kudsk, Per","Martinsen, Louise","Munk, Lisa"],"cuid":["S01-000.00-213410"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"udvikling og afprøvning af koncept for beslutningsstøttesystem for bekæmpelse af skadevoldere i landbruget","src":["au"],"src-code":["DI-U-AU"],"type":"dr","type-grp":["all","pub"]},"id":"S01-000.00-213410","ids":["au-9393a651-4028-4202-a020-7fa46ae57c5c"],"lang":"Danish","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-6D6AF96C199A9181AA0A26D8222E3F71"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Ecoscience, Department of Ecoscience - Soil Fauna Ecology and Ecotoxicology"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Beate","key":"strandbergpau","last":"Strandberg","locid":"3248f223-fd84-4bdf-a4d3-e823b6b35144","name":"Strandberg, Beate","orcid":"0000-0