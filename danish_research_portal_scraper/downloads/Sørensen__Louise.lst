au-e228435f-9959-493d-b913-08a2fff719d6","ku-7c0d6071-50b2-4736-bf53-0e065852a53f","sdu-b1c91ac4-1d3d-459e-a2c0-5b9e069d682d"],"src":["AAU Aalborg University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Targeted AntiBiotics for Chronic pulmonary diseases (TARGET ABC) : can targeted antibiotic therapy improve the prognosis of Pseudomonas aeruginosa-infected patients with chronic pulmonary obstructive disease, non-cystic fibrosis bronchiectasis, and asthma? A multicenter, randomized, controlled, open-label trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-099.97-010803","year":"2022","yearsub":"2022"}
{"abstract":"BACKGROUND: The watch and wait (W&W) strategy is proposed for patients with locally advanced rectal cancer (LARC) achieving clinical complete response (cCR) after neoadjuvant radiotherapy. cCR is only in partial concordance with pathological complete response (pCR) due to persisting viable tumour cells. The aim was to investigate circulating-free-deoxyribonucleic-acid (cfDNA) as a biomarker for prediction of pCR. MATERIALS AND METHODS: Patients treated with neoadjuvant radiotherapy for LARC, were included in a prospective biomarker study in Aarhus, Denmark from 2017 to 2020. Plasma cfDNA levels were analysed by a direct fluorescent assay (DFA). Surgical specimens were reviewed by pathologists to categorize response to cytotoxic therapy. RESULTS: In total, 76 patients were included with plasma available at baseline (n = 70), mid therapy (n = 50), and end of therapy (n = 54). Higher cfDNA levels were observed in LARC patients compared with healthy subjects (p < 0.01). By ROC analysis (AUC: 0.87 (95% CI, 0.81-0.92)) the optimal cut-off was 0.71 ng/µL for differentiation between healthy subjects and LARC patients. Thirteen patients obtained pCR with a median cfDNA level of 0.57 ng/µL at end of therapy. Patients with cfDNA levels at end of therapy below the cut-off (p < 0.02) and 'cfDNA responders' with descending levels greater than the 75th percentile during therapy had a significantly higher chance of pCR (p < 0.01). CONCLUSION: This hypothesis generating study indicates that low cfDNA levels at end of treatment or ´cfDNA responderś might be associated with pCR. Quantification of cfDNA by the rapid and feasible DFA analysis could potentially facilitate personalized follow-up as a complementary tool to identify candidates for a W&W strategy.","author_count":5,"contributors":["Truelsen, Christina Glismand","Kronborg, Camilla","Sørensen, Brita Singers","Callesen, Louise Bach","Spindler, Karen-Lise Garm"],"cuid":["S01-000.00-172665"],"filters":{"added":"2022-08","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Truelsen, Christina Glismand"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"circulating cell free dna as predictor of pathological complete response in locally advanced rectal cancer patients undergoing preoperative chemoradiotherapy","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.ctro.2022.06.002","version":"Published Version"},"id":"S01-000.00-172665","identifier":[{"id":"85131964113","type":"scopus"},{"id":"PMC9207192","type":"pmcid"},{"id":"35733829","type":"pmid"}],"ids":["au-4c10afae-f3d6-4723-a7e9-a7b678ef2a32"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-950A366DE5205B86DDC851B912BA523F"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.ctro.2022.06.002","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - DCPT - Danish Center for Particle Therapy","Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Experimental Clinical Oncology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Christina Glismand","key":"truelsenpau","last":"Truelsen","locid":"3a202e8d-7414-4950-9e30-39b708fbad6e","name":"Truelsen, Christina Glismand","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Camilla Skovhus","key":"kronborgpau","last":"Kronborg","locid":"9a9a4aa2-9e29-4c11-9210-34be3def937a","name":"Kronborg, Camilla","name_org":"Kronborg, Camilla Skovhus","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Brita Singers","key":"sørensenpau","last":"Sørensen","locid":"e57c5a80-b420-4fba-9090-c5254f617b5d","name":"Sørensen, Brita Singers","orcid":"0000-0002-3955-4735","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Louise Bach","key":"callesenpau","last":"Callesen","locid":"0134dc30-b0d0-4d0a-9710-938c2ff1b563","name":"Callesen, Louise Bach","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Karen Lise Garm","key":"spindlerpau","last":"Spindler","locid":"44550b92-1db9-45d9-97ed-e0dfc3d89e50","name":"Spindler, Karen-Lise Garm","name_org":"Spindler, Karen Lise Garm","rank":5,"rolecode":"pau"}],"pmid":["35733829"],"pub":{"doi":"10.1016/j.ctro.2022.06.002","issn":["24056308"],"journal":"Clinical and Translational Radiation Oncology","pages":"9-15","publisher":"Elsevier Ireland Ltd","status":"p","title":"Clinical and Translational Radiation Oncology","volume":"36"},"review":"Peer Reviewed","scoID":["2-s2.0-85131964113"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-4c10afae-f3d6-4723-a7e9-a7b678ef2a32"],"src":["AU Aarhus University"],"title":"Circulating cell-free DNA as predictor of pathological complete response in locally advanced rectal cancer patients undergoing preoperative chemoradiotherapy","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-172665","year":"2022","yearsub":"2022"}
{"abstract":"Gaining the skills to participate in a digitized society have become increasingly important. With the need to understand how digital technology can both influence and aid our everyday life, a broader audience needs to be included and obtain the necessary skills. In the KnitxCode project, we explored how a craftsmanship-driven approach might be useful in teaching a group of young women (about) computational thinking skills. Existing construction kits relating to computational thinking often tend to favor people, who are already interested in either robotics, programming or electronics.","author_count":4,"contributors":["Sørensen, Marie-Louise Stisen K","Fog, Bjarke Vognstrup","Musaeus, Line Have","Petersen, Marianne Graves"],"cuid":["S01-000.00-215015"],"event":{"end":"2022-10-30","place":"Eindhoven, nl","start":"2022-10-22","title":"Dutch Design Week","year":"2022"},"filters":{"added":"2022-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["CCTD","Computational thinking","craftsmanship driven"],"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"knit x code exploring a craftsmanship driven approach to computational thinking","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"https://www.4tu.nl/du/columns/Knit%20x%20Code/","version":"Published Version"},"id":"S01-000.00-215015","ids":["au-966d32e8-c7b2-4b42-ae1f-166fcf4f25f4"],"keyword":["#CCTD","Computational Thinking","craftsmanship-driven"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-C347022F77CD1DCA1B14BD1D21868A16"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"https://www.4tu.nl/du/columns/Knit%20x%20Code/","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Arts, School of Communication and Culture, School of Communication and Culture - Center for Computational Thinking & Design"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Marie-Louise Stisen K","key":"sørensenpau","last":"Sørensen","locid":"82f99f7d-c66a-4a81-bc6c-72792eee3017","name":"Sørensen, Marie-Louise Stisen K","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Bjarke Vognstrup","key":"fogpau","last":"Fog","locid":"f364aced-7950-4fd4-908e-de043633d1fd","name":"Fog, Bjarke Vognstrup","orcid":"0000-0001-7155-3735","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Line Have","key":"musaeuspau","last":"Musaeus","locid":"cb00689c-3254-4d35-bc92-d0696cba7146","name":"Musaeus, Line Have","orcid":"0000-0002-2915-2767","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Marianne Graves","key":"petersenpau","last":"Petersen","locid":"da3161f7-ece7-471a-af07-f05e91059d3a","name":"Petersen, Marianne Graves","rank":4,"rolecode":"pau"}],"pub":{"journal":"Design United","publisher":"TU Delft Open","status":"p","title":"Design United"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-966d32e8-c7b2-4b42-ae1f-166fcf4f25f4"],"src":["AU Aarhus University"],"title":"Knit x Code - Exploring a Craftsmanship-driven Approach to Computational Thinking","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-215015","year":"2022","yearsub":"2022"}
{"abstract":"Serology-based diagnosis remains one of the major tools for diagnosis and surveillance of infectious diseases. However, for many neglected diseases no or only few commercial assays are available and often with prices prohibiting large scale testing in low and middle-income countries (LMICs). We developed an adaptable enzyme-linked immunoassay (ELISA) using hepatitis C virus (HCV) as a proof-of-concept application. By combining the maltose-binding-protein with a multiepitope HCV protein, we were able to obtain a high concentration of protein suitable for downstream applications. Following optimization, the assay was verified using previously tested human samples from Canada, Denmark and Gabon in parallel with the use of a commercial protein. Sensitivity and specificity were calculated to 98 % and 97 % respectively, after accounting for non-specific binding and assay optimization. This study provides a thorough description of the development, and validation of a multiepitope ELISA-based diagnostic assay against HCV, which could be implemented at low cost. The described methodology can be readily adapted to develop novel ELISA-based diagnostic assays for other infectious pathogens with well-described immunogenic epitopes. This method could improve the diagnosis of neglected diseases for which affordable diagnostic assays are lacking.","author_count":10,"contributors":["Pedersen, Jannie","Moukandja, Irène Pegha","Ndidi, Stella","Sørensen, Anna Louise","Koumakpayi, Ismaël Hervé","Lekana-Douki, Jean Bernard","Vachon, Marie Louise","Weis, Nina","Kobinger, Gary","Fausther-Bovendo, Hugues"],"cuid":["S01-000.00-460704"],"filters":{"added":"2022-11","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Africa","America, North","OECD"],"country":["Canada","Gabon","United States"],"glorg":["All Global Affiliations","Centre Hospitalier de Libreville","Centre Interdisciplinaire de Recherches Médicales de Franceville","Laval University","University of Texas Medical Branch at Galveston"],"keyword":["ELISA","hepatitis C virus"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"an adaptable platform for in house hepatitis c serology","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.jviromet.2022.114586","version":"Published Version"},"id":"S01-000.00-460704","identifier":[{"id":"35850366","type":"pmid"},{"id":"85135135890","type":"scopus"}],"ids":["ku-7099285e-7639-48fd-8681-46a3a6bdef0c"],"keyword":["ELISA","Hepatitis C virus","Maltose binding protein","Non-specific binding"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-5392E2139D9B42A4F7E7ADE3E469BC07"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/320652288/1_s2.0_S0166093422001331_main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.jviromet.2022.114586","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"ca","key":"laval university","loc":["Canada","America, North","OECD"],"name":"Laval University","used":1},{"affno":"2","country":"ga","key":"centre hospitalier de libreville","loc":["Gabon","Africa"],"name":"Centre Hospitalier de Libreville","used":1},{"affno":"3","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Amager and Hvidovre"],"nora_code":"DI-HO-CAP","used":1},{"affno":"4","country":"ga","key":"centre interdisciplinaire de recherches médicales de franceville","loc":["Gabon","Africa"],"name":"Centre Interdisciplinaire de Recherches Médicales de Franceville","used":1},{"affno":"5","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Internal medicine: infection medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"6","country":"us","key":"university of texas medical branch at galveston","loc":["United States","America, North","OECD"],"name":"University of Texas Medical Branch at Galveston","used":1}],"person":[{"affno":"1","first":"Jannie","key":"pedersenpau","last":"Pedersen","name":"Pedersen, Jannie","rank":1,"rolecode":"pau"},{"affno":"2","first":"Irène Pegha","key":"moukandjapau","last":"Moukandja","name":"Moukandja, Irène Pegha","rank":2,"rolecode":"pau"},{"affno":"2","first":"Stella","key":"ndidipau","last":"Ndidi","name":"Ndidi, Stella","rank":3,"rolecode":"pau"},{"affno":"3","first":"Anna Louise","key":"sørensenpau","last":"Sørensen","name":"Sørensen, Anna Louise","rank":4,"rolecode":"pau"},{"affno":"2","first":"Ismaël Hervé","key":"koumakpayipau","last":"Koumakpayi","name":"Koumakpayi, Ismaël Hervé","rank":5,"rolecode":"pau"},{"affno":"4","first":"Jean Bernard","key":"lekanadoukipau","last":"Lekana-Douki","name":"Lekana-Douki, Jean Bernard","rank":6,"rolecode":"pau"},{"affno":"1","first":"Marie Louise","key":"vachonpau","last":"Vachon","name":"Vachon, Marie Louise","rank":7,"rolecode":"pau"},{"affno":"5","first":"Nina","key":"weispau","last":"Weis","locid":"3a88aaad-c729-432b-b725-999664af7a45","name":"Weis, Nina","rank":8,"rolecode":"pau"},{"affno":"6","first":"Gary","key":"kobingerpau","last":"Kobinger","name":"Kobinger, Gary","rank":9,"rolecode":"pau"},{"affno":"1","first":"Hugues","key":"faustherbovendopau","last":"Fausther-Bovendo","name":"Fausther-Bovendo, Hugues","rank":10,"rolecode":"pau"}],"pmid":["35850366"],"pub":{"doi":"10.1016/j.jviromet.2022.114586","issn":["01660934","18790984"],"issn_org":["01660934"],"journal":"Journal of Virological Methods","paperid":"114586","status":"p","title":"Journal of Virological Methods","volume":"308"},"review":"Peer Reviewed","scoID":["2-s2.0-85135135890"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-7099285e-7639-48fd-8681-46a3a6bdef0c"],"src":["KU University of Copenhagen"],"title":"An adaptable platform for in-house hepatitis C serology","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-460704","year":"2022","yearsub":"2022"}
{"abstract":"Point-of-care (POC) quantification of antibody responses against SARS-CoV-2 spike protein can enable decentralized monitoring of immune responses after infection or vaccination. We evaluated a novel POC microfluidic cartridge-based device (ViroTrack Sero COVID-19 Total Ab) for quantitative detection of total antibodies against SARS-CoV-2 spike trimeric spike protein compared to standard laboratory chemiluminescence (CLIA)-based tests. Antibody responses of 101 individuals were measured on capillary blood, venous whole blood, plasma, and diluted plasma samples directly on the POC. Results were available within 7 min. As the reference, plasma samples were analyzed on DiaSorin LIAISON XL CLIA analyzer using LIAISON SARS-CoV-2 IgM, LIAISON SARS-CoV-2 S1/S2 IgG, and LIAISON SARS-CoV-2 TrimericS IgG assays. The Spearman rank’s correlation coefficient between ViroTrack Sero COVID-19 Total Ab and LIAISON SARS-CoV-2 S1/S2 IgG and LIAISON SARS-CoV-2 TrimericS IgG assays was found to be 0.83 and 0.89, respectively. ViroTrack Sero COVID-19 Total Ab showed high correlation between the different matrixes. Agreement for determination of samples of .230 binding antibody units (BAU)/ mL on POC and CLIA methods is estimated to be around 90%. ViroTrack Sero Covid Total Ab is a rapid and simple-to-use POC test with high sensitivity and correlation of numerical results expressed in BAU/mL compared to those of a commercial CLIA assay.","author_count":9,"contributors":["Moeller, Maria E.","Engsig, Frederik N.","Bade, Melanie","Fock, Jeppe","Pah, Pearlyn","Soerensen, Anna Louise","Bang, Didi","Donolato, Marco","Benfield, Thomas"],"cuid":["S01-000.00-518979"],"filters":{"added":"2022-07","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Point of care","SARS CoV 2","Vaccination","rapid IgG IgM IgA combined test"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-PR","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-PR-OTH","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"rapid quantitative point of care diagnostic test for post covid 000000000019 vaccination antibody monitoring","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1128/spectrum.00396-22","version":"Published Version"},"id":"S01-000.00-518979","identifier":[{"id":"PMC9045215","type":"pmcid"},{"id":"35357223","type":"pmid"},{"id":"85129594948","type":"scopus"}],"ids":["ku-d219042f-b928-4672-9e53-729b852554cc"],"keyword":["S protein trimer","SARS-CoV-2","immunomagnetic agglutination assay","point-of-care","rapid IgG-IgM-IgA combined test","vaccination"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-5BFB58764495B44D8F150CA655E6AA28"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1128/spectrum.00396-22","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/307758070/spectrum.00396_22.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Amager and Hvidovre"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["Blusense Diagnostics"],"nora_code":"DI-PR-OTH","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Internal medicine: infection medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Maria E.","key":"moellerpau","last":"Moeller","name":"Moeller, Maria E.","rank":1,"rolecode":"pau"},{"affno":"1","first":"Frederik N.","key":"engsigpau","last":"Engsig","name":"Engsig, Frederik N.","rank":2,"rolecode":"pau"},{"affno":"2","first":"Melanie","key":"badepau","last":"Bade","name":"Bade, Melanie","rank":3,"rolecode":"pau"},{"affno":"2","first":"Jeppe","key":"fockpau","last":"Fock","name":"Fock, Jeppe","rank":4,"rolecode":"pau"},{"affno":"2","first":"Pearlyn","key":"pahpau","last":"Pah","name":"Pah, Pearlyn","rank":5,"rolecode":"pau"},{"affno":"1","first":"Anna Louise","key":"soerensenpau","last":"Soerensen","name":"Soerensen, Anna Louise","rank":6,"rolecode":"pau"},{"affno":"1","first":"Didi","key":"bangpau","last":"Bang","name":"Bang, Didi","rank":7,"rolecode":"pau"},{"affno":"2","first":"Marco","key":"donolatopau","last":"Donolato","name":"Donolato, Marco","rank":8,"rolecode":"pau"},{"affno":"3","first":"Thomas","key":"benfieldpau","last":"Benfield","locid":"03fdbbba-4bc0-41aa-845b-81ba0bded9ba","name":"Benfield, Thomas","orcid":"0000-0003-0698-9385","rank":9,"rolecode":"pau"}],"pmid":["35357223"],"pub":{"doi":"10.1128/spectrum.00396-22","issn":["21650497"],"issue":"2","journal":"Microbiology Spectrum","paperid":"00396","status":"p","title":"Microbiology Spectrum","volume":"10"},"review":"Peer Reviewed","scoID":["2-s2.0-85129594948"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Private Research","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Hospitals","Other Companies","Private Research","Universities","University of Copenhagen","blusense diagnostics"],"PST":["Published"]},"sid":["ku-d219042f-b928-4672-9e53-729b852554cc"],"src":["KU University of Copenhagen"],"title":"Rapid Quantitative Point-Of-Care Diagnostic Test for Post COVID-19 Vaccination Antibody Monitoring","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-518979","year":"2022","yearsub":"2022"}
{"abstract":"Individuals at Clinical High Risk for Psychosis (CHR-P) demonstrate heterogeneity in clinical profiles and outcome features. However, the extent of neuroanatomical heterogeneity in the CHR-P state is largely undetermined. We aimed to quantify the neuroanatomical heterogeneity in structural magnetic resonance imaging measures of cortical surface area (SA), cortical thickness (CT), subcortical volume (SV), and intracranial volume (ICV) in CHR-P individuals compared with healthy controls (HC), and in relation to subsequent transition to a first episode of psychosis. The ENIGMA CHR-P consortium applied a harmonised analysis to neuroimaging data across 29 international sites, including 1579 CHR-P individuals and 1243 HC, offering the largest pooled CHR-P neuroimaging dataset to date. Regional heterogeneity was indexed with the Variability Ratio (VR) and Coefficient of Variation (CV) ratio applied at the group level. Personalised estimates of heterogeneity of SA, CT and SV brain profiles were indexed with the novel Person-Based Similarity Index (PBSI), with two complementary applications. First, to assess the extent of within-diagnosis similarity or divergence of neuroanatomical profiles between individuals. Second, using a normative modelling approach, to assess the ‘normativeness’ of neuroanatomical profiles in individuals at CHR-P. CHR-P individuals demonstrated no greater regional heterogeneity after applying FDR corrections. However, PBSI scores indicated significantly greater neuroanatomical divergence in global SA, CT and SV profiles in CHR-P individuals compared with HC. Normative PBSI analysis identified 11 CHR-P individuals (0.70%) with marked deviation (>1.5 SD) in SA, 118 (7.47%) in CT and 161 (10.20%) in SV. Psychosis transition was not significantly associated with any measure of heterogeneity. Overall, our examination of neuroanatomical heterogeneity within the CHR-P state indicated greater divergence in neuroanatomical profiles at an individual level, irrespective of psychosis conversion. Further large-scale investigations are required of those who demonstrate marked deviation.","author_count":50,"contributors":["Baldwin, Helen","Radua, Joaquim","Antoniades, Mathilde","Haas, Shalaila S.","Frangou, Sophia","Agartz, Ingrid","Allen, Paul","Andreassen, Ole A.","Atkinson, Kimberley","Bachman, Peter","Baeza, Inmaculada","Bartholomeusz, Cali F.","Chee, Michael W.L.","Colibazzi, Tiziano","Cooper, Rebecca E.","Corcoran, Cheryl M.","Cropley, Vanessa L.","Ebdrup, Bjørn H.","Fortea, Adriana","Glenthøj, Louise Birkedal","Hamilton, Holly K.","Haut, Kristen M.","Hayes, Rebecca A.","He, Ying","Heekeren, Karsten","Kaess, Michael","Kasai, Kiyoto","Katagiri, Naoyuki","Kim, Minah","Kindler, Jochen","Klaunig, Mallory J.","Koike, Shinsuke","Koppel, Alex","Kristensen, Tina D.","Bin Kwak, Yoo","Kwon, Jun Soo","Lawrie, Stephen M.","Lebedeva, Irina","Lee, Jimmy","Lin, Ashleigh","Loewy, Rachel L.","Mathalon, Daniel H.","Michel, Chantal","Mizrahi, Romina","Nordholm, Dorte","Pantelis, Christos","Glenthøj, Birte","Nordentoft, Merete","Sørensen, Mikkel E.","Wenneberg, Christina"],"cuid":["S01-000.00-527426"],"filters":{"added":"2022-11","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Asia, East","Asia, South","Europe, EU","Europe, Non-EU","Nordic","OECD","Oceania"],"corpau":["the ENIGMA Clinical High Risk for Psychosis Working Group"],"country":["Australia","Canada","China","Germany","Japan","Norway","Russia","Singapore","South Korea","Spain","Sweden","Switzerland","United Kingdom","United States"],"glorg":["All Global Affiliations","Central South University","Columbia University","Department of Veterans Affairs","Diakonhjemmet Hospital","Douglas Hospital Research Center","Heidelberg University ","Icahn School of Medicine at Mount Sinai","Karolinska Institutet","King's College London","LVR-Hospital Cologne","McGill University","Nanyang Technological University","National Uni