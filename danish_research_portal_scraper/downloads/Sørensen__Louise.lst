{"author_count":3,"contributors":["Andersen, Natalia Havelund","Sørensen, Louise Sandberg","Simonsen, Sebastian Bjerregaard"],"cuid":["S01-000.00-364367"],"event":{"end":"2021-04-30","place":"Virtual","start":"2021-04-19","title":"European Geosciences Union General Assembly 2021","year":"2021"},"filters":{"added":"2022-03","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"validation of swath processed cryosat 000000000002 sarin data with different validation datasets at four different locations","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/265983788/EGU21_11985_print.pdf","version":"Published Version"},"id":"S01-000.00-364367","ids":["dtu-c8355529-ad6a-441a-838d-f95f9d8c452f"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-F4838F737EFDD94BC0D7A57992768686"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/265983788/EGU21_11985_print.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Space Institute","Technical University of Denmark, National Space Institute, Geodesy and Earth Observation"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Natalia","key":"havelundpau","last":"Havelund","locid":"c5e34a6f-c973-41a5-8f78-b0ed469d5210","name":"Andersen, Natalia Havelund","name_org":"Have