ine - Fysiologi, Viborg"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","first":"Louise","key":"bundgaardpau","last":"Bundgaard","locid":"fac2f738-731c-4ca5-9369-45d6f4486fe2","name":"Bundgaard, Louise","orcid":"0000-0002-0396-883X","rank":1,"rolecode":"pau"},{"affno":"1","first":"Stine","key":"jacobsenpau","last":"Jacobsen","locid":"f3957428-a0cc-46ad-a05c-b85ca7d03e9e","name":"Jacobsen, Stine","orcid":"0000-0002-2380-4576","rank":2,"rolecode":"pau"},{"affno":"","first":"Mette Aamand","key":"sørensenpau","last":"Sørensen","locid":"c3ce4ae2-7fda-40ef-8fa7-ff09dc2da244","name":"Sørensen, Mette Aamand","rank":3,"rolecode":"pau"},{"affno":"","first":"Robert J.","key":"beynonpau","last":"Beynon","name":"Beynon, Robert J.","rank":4,"rolecode":"pau"},{"affno":"","first":"Victoria M.","key":"harmanpau","last":"Harman","name":"Harman, Victoria M.","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lars J.","key":"petersenpau","last":"Petersen","locid":"78c60193-a5b1-40ad-bf56-ba42c1061b30","name":"Petersen, Lars Jelstrup","name_org":"Petersen, Lars J.","rank":6,"rolecode":"pau"},{"affno":"","first":"Eric W.","key":"deutschpau","last":"Deutsch","name":"Deutsch, Eric W.","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Emøke","key":"bendixenpau","last":"Bendixen","locid":"48748d97-85fd-424f-a51e-284e2a4dc849","name":"Bendixen, Emøke","rank":8,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-c29d90c6-ac6f-4484-b88f-91de8993e0dc","ku-6990ddb4-91c3-4816-a430-1dd68964040b"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Quantification of acute phase proteins in interstitial fluid from equine body and limb wounds by the use of mass spectrometry","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-089.29-724839","year":"2014","yearsub":"2014"}
{"abstract":"BACKGROUND: Most children are transiently colonized with Streptococcus pneumoniae, but very few develop invasive pneumococcal disease (IPD). Host genetic variation of innate immunity may predispose to IPD. We investigated the effect of genetic variation in the mannose-binding lectin gene, MBL2, on susceptibility and disease severity of IPD in previously healthy children aged <5 years. METHODS: IPD cases were identified through national registries. DNA was obtained from the Danish Neonatal Screening Biobank. Pneumococcal serotypes were determined by Quellung reaction. The associations between MBL2 diplotypes and IPD susceptibility, serotypes, and outcome were investigated using logistic regression analysis. RESULTS: We included 372 cases with meningitis, 907 with bacteremia, and 1263 age- and sex-matched controls; 2372 individuals were successfully genotyped and assigned MBL2 diplotypes. The median age in our combined case series was 13 months. Children with defective diplotypes were not at higher risk for meningitis than children with other diplotypes (odds ratio [OR], 0.85; 95% confidence interval [CI], .56-1.28). Similar results were found for bacteremia (OR, 0.89; 95% CI, .68-1.15) as well as for all cases (OR, 0.87; 95% CI, .70-1.09). There was no association with susceptibility to recurrent IPD (n = 12) for children with defective diplotypes compared with cases with a single episode (OR, 0.53; 95% CI, .07-4.13) and with all controls (OR, 0.46; 95% CI, .06-3.56). There was no association between diplotypes and mortality or between diplotypes and pneumococcal serotypes. CONCLUSIONS: Defective MBL2 polymorphisms did not predict increased IPD susceptibility in children born in Northern Europe.","author_count":9,"contributors":["Lundbo, Lene Fogt","Harboe, Zitta Barrella","Clausen, Louise Nygaard","Hollegaard, Mads Vilhelm","Sørensen, Henrik Toft","Hougaard, David Michael","Konradsen, Helle Bossen","Nørgaard, Mette","Benfield, Thomas"],"cuid":["S02-094.00-022849"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Child Preschool","Denmark","Disease Susceptibility","Female","Genetic Predisposition to Disease","Humans","Infant","Infant Newborn","Male","Mannose Binding Lectin","Pneumococcal Infections","Polymorphism Genetic","Serogroup","Streptococcus pneumoniae"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-GV-SSI","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"mannose binding lectin gene i mbl000000000002 i polymorphisms are not associated with susceptibility to invasive pneumococcal disease in children","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1093/cid/ciu276","version":"Other Version"},"id":"S02-094.00-022849","identifier":[{"id":"84904963533","type":"scopus"},{"id":"24771334","type":"pmid"}],"ids":["au-8ba9a37a-d852-4bea-91d6-d7f526477ed8","ku-db026610-9df6-4c9c-911d-1c2b3513d30e"],"keyword":["Child, Preschool","Denmark","Disease Susceptibility","Female","Genetic Predisposition to Disease","Humans","Infant","Infant, Newborn","Male","Mannose-Binding Lectin","Pneumococcal Infections","Polymorphism, Genetic","Serogroup","Streptococcus pneumoniae"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-6D0623D349158A802F13BCE7A17D9E86"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1093/cid/ciu276","version":"Other Version"}],"oai":{"class":"Blocked","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"ssi statens serum institut","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-SSI","l3nn":"SSI Statens Serum Institut","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SSI Statens Serum Institut","namevar":["Statens Serum Institut"],"nora_code":"DI-GV-SSI","used":1},{"affno":"3","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University (AU)","Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Clinical Epidemiology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","first":"Lene Fogt","key":"lundbopau","last":"Lundbo","locid":"68502507-00d3-4e13-ace6-6dd9e90d5e78","name":"Lundbo, Lene Fogt","rank":1,"rolecode":"pau"},{"affno":"","first":"Zitta Barrella","key":"harboepau","last":"Harboe","name":"Harboe, Zitta Barrella","rank":2,"rolecode":"pau"},{"affno":"","first":"Louise Nygaard","key":"clausenpau","last":"Clausen","name":"Clausen, Louise Nygaard","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Mads Vilhelm","key":"hollegaardpau","last":"Hollegaard","name":"Hollegaard, Mads Vilhelm","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Henrik Toft","key":"sørensenpau","last":"Sørensen","locid":"4d49d93a-4913-4223-ba59-272e717a845d","name":"Sørensen, Henrik Toft","orcid":"0000-0003-4299-7040","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"David Michael","key":"hougaardpau","last":"Hougaard","name":"Hougaard, David Michael","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Helle Bossen","key":"konradsenpau","last":"Konradsen","name":"Konradsen, Helle Bossen","rank":7,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Mette","key":"nørgaardpau","last":"Nørgaard","locid":"3cb2ae19-c1b9-4dad-9928-adbd1c51b4b7","name":"Nørgaard, Mette","orcid":"0000-0001-6110-5891","rank":8,"rolecode":"pau"},{"affno":"1","first":"Thomas","key":"benfieldpau","last":"Benfield","locid":"03fdbbba-4bc0-41aa-845b-81ba0bded9ba","name":"Benfield, Thomas","orcid":"0000-0003-0698-9385","rank":9,"rolecode":"pau"}],"pmid":["24771334"],"pub":{"doi":"10.1093/cid/ciu276","issn":["10584838","15376591"],"issn_org":["10584838"],"issue":"4","journal":"Clinical Infectious Diseases","status":"p","title":"Clinical Infectious Diseases","title_org":"Clinical infectious diseases : an official publication of the Infectious Diseases Society of America","volume":"59"},"review":"Peer Reviewed","scoID":["2-s2.0-84904963533"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Governmental Institutions","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-U","DI-U-ALL","Governmental Institutions","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-8ba9a37a-d852-4bea-91d6-d7f526477ed8","ku-db026610-9df6-4c9c-911d-1c2b3513d30e"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Mannose-binding lectin gene, MBL2, polymorphisms are not associated with susceptibility to invasive pneumococcal disease in children","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-094.00-022849","year":"2014","yearsub":"2014"}
{"abstract":"Green rust is a naturally occurring layered mixed-valent ferrous-ferric hydroxide, which can react with a range of redox-active compounds. Sulfate-bearing green rust is generally thought to have interlayers composed of sulfate and water. Here, we provide evidence that the interlayers also contain monovalent cations, using X-ray photoelectron spectroscopy and synchrotron X-ray scattering. For material synthesized with Na+, K+, Rb+, or Cs+, interlayer thickness derived from basal plane spacings correlates with the radius of the monovalent cation. In addition, sequential washing of the materials with water showed that Na+ and K+ were structurally fixed in the interlayer, whereas Rb+ and Cs+ could be removed, resulting in a decrease in the basal layer spacing. The incorporation of cations in the interlayer opens up new possibilities for the use of sulfate green rust for exchange reactions with both anions and cations: e.g., radioactive Cs.","author_count":10,"contributors":["Christiansen, B. C.","Dideriksen, K.","Katz, A.","Nedel, S.","Bovet, N.","Sørensen, H. O.","Frandsen, Cathrine","Gundlach, Carsten","Andersson, M. P.","Stipp, S. L. S."],"cuid":["S02-100.00-036481"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Experimental surface - and nanomaterials physics"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"incorporation of monovalent cations in sulfate green rust","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1021/ic500495a","version":"Other Version"},"id":"S02-100.00-036481","identifier":[{"id":"84906860957","type":"scopus"},{"id":"25144528","type":"pmid"}],"ids":["dtu-ab826621-b1f4-4268-adce-640f30fcd95f","ku-39fb35cd-0e2f-4161-8afa-59d09527655b"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-1B3FFB8A7DC12686F557EEBB7D151556"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1021/ic500495a","version":"Other Version"}],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Chemistry"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Physics","Technical University of Denmark, Department of Physics, Surface Physics and Catalysis"],"nora_code":"DI-U-DTU","used":1},{"affno":"3","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Experimental surface - and nanomaterials physics"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","first":"Bo C.","key":"christiansenpau","last":"Christiansen","locid":"04c4774d-eb7d-4c24-8a96-96e12df83869","name":"Christiansen, Bo C.","rank":1,"rolecode":"pau"},{"affno":"1","first":"Knud","key":"dideriksenpau","last":"Dideriksen","locid":"aa140dee-2384-4ada-ae1a-4eed8f065f54","name":"Dideriksen, Knud","orcid":"0000-0003-3067-4834","rank":2,"rolecode":"pau"},{"affno":"1","first":"Aurelian","key":"katzpau","last":"Katz","name":"Katz, Aurelian","rank":3,"rolecode":"pau"},{"affno":"1","first":"Sorin","key":"nedelpau","last":"Nedel","locid":"b181b20a-e9db-42b6-92ef-20edc2845fcc","name":"Nedel, Sorin","rank":4,"rolecode":"pau"},{"affno":"1","first":"Nicolas Emile","key":"bovetpau","last":"Bovet","locid":"a001edf5-b545-4614-b905-727171248f80","name":"Bovet, Nicolas Emile","rank":5,"rolecode":"pau"},{"affno":"1","first":"Henning Osholm","key":"sørensenpau","last":"Sørensen","locid":"e1bf7bae-7f0e-445e-99ea-12eb242407fb","name":"Sørensen, Henning Osholm","orcid":"0000-0002-7004-547X","rank":6,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"country":"dk","first":"Cathrine","key":"frandsenpau","last":"Frandsen","locid":"e2abec6d-ca8d-4391-b9da-53d1399942fc","name":"Frandsen, Cathrine","orcid":"0000-0001-5006-924X","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Carsten","key":"gundlachpau","last":"Gundlach","locid":"65d0727c-226e-4de2-8573-92fc7b62cce6","name":"Gundlach, Carsten","orcid":"0000-0002-2895-1882","rank":8,"rolecode":"pau"},{"affno":"1","first":"Martin Peter","key":"anderssonpau","last":"Andersson","locid":"3611616f-5e3e-4c33-bebe-b21baacf4f14","name":"Andersson, Martin Peter","orcid":"0000-0002-4921-1461","rank":9,"rolecode":"pau"},{"affno":"1","first":"Susan Louise Svane","key":"stipppau","last":"Stipp","locid":"b907e7ef-d26a-4093-836b-9b7c9238d956","name":"Stipp, Susan Louise Svane","rank":10,"rolecode":"pau"}],"pmid":["25144528"],"pub":{"doi":"10.1021/ic500495a","issn":["00201669","1520510X"],"issn_org":["00201669"],"issue":"17","journal":"Inorganic Chemistry","pages":"8887-8894","publisher":"American Chemical Society","status":"p","title":"Inorganic Chemistry","volume":"53"},"review":"Peer Reviewed","scoID":["2-s2.0-84906860957"],"search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-ab826621-b1f4-4268-adce-640f30fcd95f","ku-39fb35cd-0e2f-4161-8afa-59d09527655b"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Incorporation of Monovalent Cations in Sulfate Green Rust","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-036481","year":"2014","yearsub":"2014"}
{"abstract":"BACKGROUND: Microfibrillar-associated protein 4 (MFAP4) is a matricellular glycoprotein that co-localises with elastic fibres and is highly expressed in the lungs. The aim of this study was to test the hypothesis that plasma MFAP4 (pMFAP4) reflects clinical outcomes in chronic obstructive pulmonary disease (COPD). METHODS: pMFAP4 was measured by an AlphaLISA immunoassay in stable COPD (n = 69) at baseline and at follow-up until 24 months after inclusion and in acute exacerbations of COPD (AECOPD) (n = 14) at baseline and until 6 months after inclusion. RESULTS: The majority of patients (89%) were in GOLD II and III. Multiple linear regressions showed positive associations between pMFAP4 and the Global initiative for Obstructive Lung Disease (GOLD) grade (p = 0.01), modified Medical Research Council score (p < 0.0001) and BODE index (p = 0.04). Negative associations were found with 6-min walking distance (p = 0.04) and bronchodilator-induced reversibility (p = 0.02). The pMFAP4 levels varied less than 25% between the baseline and a 3 month follow-up in 83% of the patients. The pMFAP4 levels appeared unaffected in the acute phase of severe AECOPD but rose to an increased stable level within one month after hospitalization. CONCLUSION: Increased pMFAP4 was associated to the severity in COPD and has the potential to serve as a stable disease biomarker. This observation warrants confirmation in a larger longitudinal COPD population.","author_count":14,"contributors":["Johansson, Sofie Lock","Roberts, Nassim Bazeghi","Schlosser, Anders","Andersen, Claus B","Carlsen, Jørn","Wulf-Johansson, Helle","Sækmose, Susanne Gjørup","Titlestad, Ingrid L","Tornoe, Ida","Miller, Bruce","Tal-Singer, Ruth","Holmskov, Uffe","Vestbo, Jørgen","Sorensen, Grith Lykke"],"cuid":["S02-100.00-041168"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"keyword":["Biomarkers","COPD","Chronic obstructive pulmonary disease","Medical","Microfibrillar associated protein 4","Modified","Research"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"microfibrillar associated protein 000000000004 a potential biomarker of chronic obstructive pulmonary disease","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.rmed.2014.06.003","version":"Other Version"},"id":"S02-100.00-041168","identifier":[{"id":"84913613835","type":"scopus"},{"id":"25022422","type":"pmid"}],"ids":["ku-2d3b616b-633d-41a3-8187-5ea056932c84","sdu-f12f2ade-8160-422f-af25-5eb4c7be0ef0"],"keyword":["Acute exacerbation of","BODE index","Biomarkers","COPD","Chronic obstructive pulmonary disease","Council score","Medical","Microfibrillar-associated protein 4","Modified","Research"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-1C3BA29ED14684BDB29260CEC21AF1EB"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.rmed.2014.06.003","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Molecular Medicine, Cardiovascular and Renal Research Unit"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Sofie Lock","key":"johanssonpau","last":"Johansson","locid":"71fb7f1b-e46c-4333-8a12-3fb7ad0772c9","name":"Johansson, Sofie Lock","orcid":"0000-0003-0597-9468","rank":1,"rolecode":"pau"},{"affno":"","first":"Nassim Bazeghi","key":"robertspau","last":"Roberts","name":"Roberts, Nassim Bazeghi","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders","key":"schlosserpau","last":"Schlosser","locid":"9658ed75-0e49-4680-a1e9-909c39b74fa2","name":"Schlosser, Anders","orcid":"0000-0001-8693-2148","rank":3,"rolecode":"pau"},{"affno":"2","first":"Claus B","key":"andersenpau","last":"Andersen","locid":"65a8d28d-49ee-4642-8303-b99cf4ec0635","name":"Andersen, Claus B","rank":4,"rolecode":"pau"},{"affno":"2","first":"Jørn","key":"carlsenpau","last":"Carlsen","locid":"d1394cd1-fa74-45ea-a5f4-7730f6c6de0c","name":"Carlsen, Jørn","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Helle","key":"wulfjohanssonpau","last":"Wulf-Johansson","locid":"3e85a00a-2456-44f4-8671-e8e9fe81296d","name":"Johansson, Helle Wulf","name_org":"Wulf-Johansson, Helle","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Susanne Gjørup","key":"sækmosepau","last":"Sækmose","locid":"7f4080ec-6f71-4bd4-a365-a4221297e449","name":"Sækmose, Susanne Gjørup","orcid":"0000-0002-1346-0052","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ingrid L","key":"titlestadpau","last":"Titlestad","locid":"67905117-c8b6-4567-b11a-11abb0621cc2","name":"Titlestad, Ingrid Louise","name_org":"Titlestad, Ingrid L","orcid":"0000-0001-6418-0088","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ida","key":"tornoepau","last":"Tornoe","locid":"a044b0a2-9920-498b-b3d2-4c97301888be","name":"Tornøe, Ida","name_org":"Tornoe, Ida","rank":9,"rolecode":"pau"},{"affno":"","first":"Bruce","key":"millerpau","last":"Miller","name":"Miller, Bruce","rank":10,"rolecode":"pau"},{"affno":"","first":"Ruth","key":"talsingerpau","last":"Tal-Singer","name":"Tal-Singer, Ruth","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Uffe","key":"holmskovpau","last":"Holmskov","locid":"c1ce73b6-d49f-466e-9730-fc83076f65cd","name":"Holmskov, Uffe","orcid":"0000-0002-2391-9445","rank":12,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jørgen","key":"vestbopau","last":"Vestbo","locid":"4e11f0e8-ccbc-4908-8dcc-14b5289701ff","name":"Vestbo, Jørgen","orcid":"0000-0001-6355-6362","rank":13,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Grith Lykke","key":"sorensenpau","last":"Sorensen","locid":"950cb689-da86-4abe-835b-a1312ddf5cec","name":"Sorensen, Grith Lykke","orcid":"0000-0002-5273-1097","rank":14,"rolecode":"pau"}],"pmid":["25022422"],"pub":{"doi":"10.1016/j.rmed.2014.06.003","issn":["09546111","15323064"],"issn_org":["09546111"],"issue":"9","journal":"Respiratory Medicine","pages":"1336-1344","publisher":"Elsevier","status":"p","title":"Respiratory Medicine","volume":"108"},"review":"Peer Reviewed","scoID":["2-s2.0-84913613835"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-2d3b616b-633d-41a3-8187-5ea056932c84","sdu-f12f2ade-8160-422f-af25-5eb4c7be0ef0"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Microfibrillar-associated protein 4 : A potential biomarker of chronic obstructive pulmonary disease","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-041168","year":"2014","yearsub":"2014"}
{"abstract":"Objectives: Median urinary iodine concentration (UIC) is the recommended method to evaluate iodine status in pregnancy, but several factors may challenge the interpretation of the results. We evaluated UIC in pregnant women according to (1) sampling in the hospital versus at home, (2) time of the most recent iodine supplement intake prior to sampling, and (3) members of their household. Study Design: Danish crosssectional study in the year 2012. Pregnant women (n = 158), their male partners (n = 157) and children (n = 51) provided a questionnaire with detailed information on iodine supplement intake and a spot urine sample obtained in the hospital and/or at home for measurement of UIC and urinary creatinine concentration. Results: In the pregnant women providing a urine sample both in the hospital and at home (n = 66), individual UIC (p = 0.002) and urinary creatinine concentration (p = 0.042), but not estimated 24-hour urinary iodine excretion (p = 0.79), were higher when sampling was at home. Median UIC was dependent on the time of the most recent iodine supplement intake prior to sampling [same day (n = 79): 150 μg/l (95% CI 131-181 μg/l), the day before (n = 51): 105 μg/l (78-131 μg/l), several days ago/non-user (n = 28): 70 μg/l (56-94 μg/l), p < 0.001]. The pattern was similar in the male partners. Apart from a more frequent iodine supplement intake in pregnancy (87.3% vs. partners 15.9%), no systematic differences were observed in urinary measurements between the pregnant women and their partners. Conclusions: Time of spot urine sampling and time span from iodine supplement intake to spot urine sampling should be considered when evaluating urinary iodine status in pregnancy.","author_count":5,"contributors":["Andersen, Stine Linding","Sørensen, Louise Kolding","Motavaf, Anne Krejbjerg","Møller, Margrethe","Laurberg, Peter"],"cuid":["S01-000.00-070406"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Andersen, Stine Linding"],"keyword":["Household","Pregnancy","Urinary iodine concentration"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"challenges in the evaluation of urinary iodine status in pregnancy the importance of iodine supplement intake and time of sampling","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-070406","ids":["aau-4648d49d-3f9a-4c25-806d-b66cf583aea0"],"keyword":["24-hour urinary iodine excretion","Household","Iodine supplement","Pregnancy","Urinary creatinine concentration","Urinary iodine concentration"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-5FEBC1A461D3ECA1D8A704511E8A262A"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Hormon- og Stofskiftesygdomme (Endokrinologi) [Klinik Medicin]","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Medicin"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Stine Linding","key":"andersenpau","last":"Andersen","locid":"a08245c4-86df-48d4-b485-d0fee481d01e","name":"Andersen, Stine Linding","orcid":"0000-0001-6336-1936","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Louise Kolding","key":"sørensenpau","last":"Sørensen","locid":"2b4fc7ee-a12d-41b0-b0b0-9f70a0bb33f8","name":"Sørensen, Louise Kolding","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anne Krejbjerg","key":"motavafpau","last":"Motavaf","locid":"658d399a-756d-4eb9-aef8-831b9039bc03","name":"Motavaf, Anne Krejbjerg","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Margrethe","key":"møllerpau","last":"Møller","locid":"7a88b046-f179-4fcd-971f-d9e404c90679","name":"Møller, Margrethe","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Peter","key":"laurbergpau","last":"Laurberg","locid":"c4ea92ce-c22d-4543-97c3-e7a2b9a99a53","name":"Laurberg, Peter","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1159/000365145","issn":["22350640","22350802"],"issn_org":["22350640"],"issue":"3","journal":"European Thyroid Journal","pages":"179-188","publisher":"BioScientifica Ltd.","status":"p","title":"European Thyroid Journal","volume":"3"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-4648d49d-3f9a-4c25-806d-b66cf583aea0"],"src":["AAU Aalborg University"],"title":"Challenges in the evaluation of urinary iodine status in pregnancy : The importance of iodine supplement intake and time of sampling","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-070406","year":"2014","yearsub":"2014"}
{"abstract":"PURPOSE: Pharmacovigilance studies of cancer treatment frequently monitor infections. Predictive values of algorithms identifying disease depend on prevalence of the disease in the population under study. We therefore estimated the positive predictive value (PPV) of primary inpatient diagnosis of infection among cancer patients in the Danish National Registry of Patients (DNRP). METHODS: The algorithm to identify infections in the DNPR was based on International Classification of Diseases, 10th revision (ICD-10) codes. A physician blinded to the type of sampled infection reviewed the medical charts and assessed the presence and type of infection. Using the physician global assessment as gold standard, we computed PPVs with and without requiring agreement on infection type. RESULTS: We retrieved 266 of 272 medical charts (98%). Presence of infection was confirmed in 261 patients, resulting in an overall PPV of 98% (95% confidence interval, 96%-99%). When requiring agreement on infection type, overall PPV was 77%. For skin infections, pneumonia, and sepsis, PPVs were 79%, 93% and 84%, respectively. For these infections, we additionally calculated PPVs using evidence-based criteria as the gold standard. PPV was similar for pneumonia, but lower for skin infections and sepsis. CONCLUSIONS: The Danish National Registry of Patients is suitable for monitoring infections requiring hospitalization among cancer patients.","author_count":7,"contributors":["Holland-Bill, Louise","Xu, Hairong","Sørensen, Henrik Toft","Acquavella, John","Sværke, Claus","Gammelager, Henrik","Ehrenstein, Vera"],"cuid":["S01-000.00-274341"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","Amgen Incorporated"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"positive predictive value of primary inpatient discharge diagnoses of infection among cancer patients in the danish national registry of patients","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.annepidem.2014.05.011","version":"Other Version"},"id":"S01-000.00-274341","identifier":[{"id":"84905017726","type":"scopus"},{"id":"25084702","type":"pmid"}],"ids":["au-fe31314f-dd4b-4380-9c12-a24d68f614a6"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-F441CC3C4D4CAE3D179DCCFA32996AB0"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.annepidem.2014.05.011","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University (AU)"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"us","key":"amgen incorporated","loc":["United States","America, North","OECD"],"name":"Amgen Incorporated","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Louise","key":"hollandbillpau","last":"Holland-Bill","name":"Holland-Bill, Louise","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Hairong","key":"xupau","last":"Xu","name":"Xu, Hairong","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik Toft","key":"sørensenpau","last":"Sørensen","locid":"4d49d93a-4913-4223-ba59-272e717a845d","name":"Sørensen, Henrik Toft","orcid":"0000-0003-4299-7040","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"John","key":"acquavellapau","last":"Acquavella","name":"Acquavella, John","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Claus","key":"sværkepau","last":"Sværke","name":"Sværke, Claus","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik","key":"gammelagerpau","last":"Gammelager","locid":"74961412-13a3-425c-84af-56bad91e1b5e","name":"Gammelager, Henrik","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Vera","key":"ehrensteinpau","last":"Ehrenstein","locid":"dba7d235-8119-40e4-99bc-6aeeec3c3f6b","name":"Ehrenstein, Vera","orcid":"0000-0002-3415-3254","rank":7,"rolecode":"pau"}],"pmid":["25084702"],"pub":{"doi":"10.1016/j.annepidem.2014.05.011","issn":["10472797","18732585"],"issn_org":["10472797"],"issue":"8","journal":"Annals of Epidemiology","publisher":"Elsevier Inc.","status":"p","title":"Annals of Epidemiology","volume":"24"},"review":"Peer Reviewed","scoID":["2-s2.0-84905017726"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-fe31314f-dd4b-4380-9c12-a24d68f614a6"],"src":["AU Aarhus University"],"title":"Positive predictive value of primary inpatient discharge diagnoses of infection among cancer patients in the Danish National Registry of Patients","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-274341","year":"2014","yearsub":"2014"}
