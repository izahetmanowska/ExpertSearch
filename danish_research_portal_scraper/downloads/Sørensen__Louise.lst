CD"],"name":"KP University College Copenhagen","namevar":["Københavns Professionshøjskole, Rektors område, Fakultet for pædagogiske og samfundsfaglige uddannelser-Dekan, Socialrådgiveruddannelsen 4","Socialt Arbejde - Institut for Socialrådgiveruddannelse, Udsathed blandt børn, unge og familier"],"nora_code":"DI-UC-KP","used":1},{"affno":"2","country":"se","key":"lund university","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Lund University","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Siddhartha","key":"baviskarpau","last":"Baviskar","locid":"9aff2276-c2a4-46ed-bb0e-b0040e2d05bf","name":"Baviskar, Siddhartha","orcid":"0000-0002-5957-1612","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sofie","key":"denckerlarsenpau","last":"Dencker-Larsen","locid":"7a1ba53f-5136-4906-bc85-111c3f4b84b7","name":"Dencker-Larsen, Sofie","orcid":"0000-0001-9023-3403","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Pernille","key":"bischoffpau","last":"Bischoff","locid":"793e872e-afc6-45cc-82ac-b6d75400ccb8","name":"Bischoff, Pernille","rank":3,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Per Martin","key":"bergströmpau","last":"Bergström","locid":"006cfb9a-fbea-4341-8055-a784d9bd5c52","name":"Bergström, Per Martin","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sofie","key":"danneskioldsamsøepau","last":"Danneskiold-Samsøe","locid":"9a3389bd-ee22-43c9-be85-129a0d20852a","name":"Danneskiold-Samsøe, Sofie","orcid":"0000-0002-8670-1670","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anne","key":"bøllingfrederiksenpau","last":"Bølling Frederiksen","locid":"dbfe811c-f3da-4908-ab90-c5f5232ee54f","name":"Bølling Frederiksen, Anne","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Charlotte Bredahl","key":"jacobsenpau","last":"Jacobsen","locid":"40d26cc5-117b-41d6-bb2b-3944e60bae72","name":"Jacobsen, Charlotte Bredahl","orcid":"0000-0003-4184-3752","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anna Louise Krarup","key":"jensenpau","last":"Jensen","locid":"6a1445b4-2d6f-410a-a3bc-89c5e0463ce2","name":"Jensen, Anna Louise Krarup","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Cecilie","key":"koustruppau","last":"Koustrup","locid":"28435802-16ae-4f9c-9be4-c95dcef6143d","name":"Koustrup, Cecilie","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Nina","key":"madsensjoepau","last":"Madsen Sjoe","locid":"61cdbb6b-a7d2-412a-9aad-d6fa452f5b58","name":"Sjö, Nina Madsen","name_org":"Madsen Sjoe, Nina","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kresta Munkholt","key":"sørensenpau","last":"Sørensen","locid":"3fd2cbba-682a-4eef-800a-675a01008003","name":"Sørensen, Kresta Munkholt","rank":11,"rolecode":"pau"}],"pub":{"edition":"1","eisbn":["9788793894815"],"isbn":["9788793894815"],"pages":"33","place":"Frederiksberg","publisher":"Københavns Professionshøjskole","status":"p"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All University Colleges","DI-ALL","DI-UC","DI-UC-ALL","KP","University Colleges"],"PST":["Published"]},"sid":["kp-1aede2b0-1434-4cb4-8c8e-9dd1058d4dcf"],"src":["KP University College Copenhagen"],"title":"Håndbog til Børne- og ungerådgiver, Familieplejekonsulent &amp; Datakoordinator","type":"Book","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-789602","year":"2024","yearsub":"2024"}
{"abstract":"Today, Germanic languages, including German, English, Frisian, Dutch and the Nordic languages, are widely spoken in northwest Europe. However, key aspects of the assumed arrival and diversification of this linguistic group remain contentious1–3. By adding 712 new ancient human genomes we find an archaeologically elusive population entering Sweden from the Baltic region by around 4000 BP. This population became widespread throughout Scandinavia by 3500 BP, matching the contemporaneous distribution of Palaeo-Germanic, the Bronze Age predecessor of Proto-Germanic4–6. These Baltic immigrants thus offer a new potential vector for the first Germanic speakers to arrive in Scandinavia, some 800 years later than traditionally assumed7–12. Following the disintegration of Proto-Germanic13–16, we find by 1650 BP a southward push from Southern Scandinavia into presumed Celtic-speaking areas, including Germany, Poland and the Netherlands. During the Migration Period (1575–1375 BP), we see this ancestry representing West Germanic Anglo-Saxons in Britain, and Langobards in southern Europe. We find a related large-scale northward migration into Denmark and South Sweden corresponding with historically attested Danes and the expansion of Old Norse. These movements have direct implications for multiple linguistic hypotheses. Our findings show the power of combining genomics with historical linguistics and archaeology in creating a unified, integrated model for the emergence, spread and diversification of a linguistic group.","author_count":116,"contributors":["McColl, Hugh","Kroonen, Guus","Moreno-Mayar, J. Víctor","Valeur Seersholm, Frederik","Scorrano, Gabriele","Pinotti, Thomaz","Vimala, Tharsika","Sindbæk, Søren M.","Ethelberg, Per","Fyfe, Ralph","Gaillard, Marie-José","Ellegård Larsen, Hanne Marie","Mortensen, Morten Fischer","Demeter, Fabrice","Jørkov, Marie Louise S.","Bergerbrant, Sophie","Damgaard, Peter de Barros","Allentoft, Morten E.","Vinner, Lasse","Gaunitz, 