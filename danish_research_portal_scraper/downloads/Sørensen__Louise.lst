},{"affno":"1","corresponding":null,"country":"dk","first":"Kjeld","key":"nielsenpau","last":"Nielsen","locid":"ffae8343-8516-499e-89a3-2f0d6179a5fc","name":"Nielsen, Kjeld","orcid":"0000-0002-3720-167X","rank":5,"rolecode":"pau"},{"affno":"","first":"Ilkyeong","key":"moonpedh","last":"Moon","name":"Moon, Ilkyeong","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Jinwoo","key":"parkpedh","last":"Park","name":"Park, Jinwoo","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Gyu M.","key":"leepedh","last":"Lee","name":"Lee, Gyu M.","rank":8,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Dimitris","key":"kiritsispedh","last":"Kiritsis","name":"Kiritsis, Dimitris","rank":9,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Gregor","key":"voncieminskipedh","last":"von Cieminski","name":"von Cieminski, Gregor","rank":10,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-319-99704-9_40","eisbn":["9783319997049"],"isbn":["9783319997032"],"issn":["18684238"],"pages":"328-335","publisher":"Springer","series":"IFIP Advances in Information and Communication Technology","status":"p","subtitle":"IFIP WG 5.7 International Conference, APMS 2018, Seoul, Korea, August 26-30, 2018, Proceedings, Part I","title":"Advances in Production Management Systems. Production Management for Data-Driven, Intelligent, Collaborative, and Sustainable Manufacturing - IFIP WG 5.7 International Conference, APMS 2018, Proceedings","volume":"535"},"review":"Peer Reviewed","scoID":["2-s2.0-85053228631"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-d61141eb-a55a-444a-83e0-6359c781eb0c"],"src":["AAU Aalborg University"],"title":"Product-Process Modelling as an Enabler of Manufacturing Changeability","type":"Conference Paper","url":"https://lo