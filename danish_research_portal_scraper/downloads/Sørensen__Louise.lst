ark","namevar":["Technical University of Denmark, National Food Institute","Technical University of Denmark, National Food Institute, Research Group for Risk Benefit"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Niels","key":"egelundnielspau","last":"Egelund","locid":"7c27426d-9075-4736-99c9-16420efe2e2b","name":"Egelund, Niels","rank":1,"rolecode":"pau"},{"affno":"2","first":"Louise Bergmann","key":"sørensenlouisebergmannpau","last":"Sørensen","locid":"b86d9af7-ea09-4925-a863-eadc0c0e26ee","name":"Sørensen, Louise Bergmann","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Camilla Brørup","key":"dyssegaardcamillabrøruppau","last":"Dyssegaard","locid":"983bdd51-d0b6-41e2-9208-7177490ee4fe","name":"Dyssegaard, Camilla Brørup","rank":2,"rolecode":"pau"},{"affno":"2","first":"Camilla Trab","key":"damsgaardcamillatrabpau","last":"Damsgaard","locid":"5ea9cc09-17f1-46a3-9e4e-fa5490abd815","name":"Damsgaard, Camilla Trab","orcid":"0000-0002-5013-0562","rank":2,"rolecode":"pau"},{"affno":"2","first":"Stine-Mathilde","key":"dalskovstinemathildepau","last":"Dalskov","locid":"56222bcb-fb52-4111-8cfa-0264a3fef7e5","name":"Dalskov, Stine-Mathilde","rank":3,"rolecode":"pau"},{"affno":"2","first":"Rikke Agnete","key":"petersenrikkeagnetepau","last":"Petersen","locid":"7ec167a6-8982-42dc-87de-53c245802653","name":"Petersen, Rikke Agnete","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Ken","key":"starkkenpau","last":"Stark","name":"Stark, Ken","rank":7,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Ken D","key":"starkkendpau","last":"Stark","name":"Stark, Ken D","rank":7,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"Rikke","key":"andersenrikkepau","last":"Andersen","locid":"4906b97e-828c-48ec-9440-08178d4d8c5a","name":"Andersen, Rikke","orcid":"0000-0002-5091-6995","rank":8,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"Inge","key":"tetensingepau","last":"Tetens","locid":"471bd31c-6fe2-423c-a500-8ffab1993a2e","name":"Tetens, Inge","rank":9,"rolecode":"pau"},{"affno":"2","first":"Arne","key":"astruparnepau","last":"Astrup","locid":"5d943631-c9fc-4b63-8aaa-263ba4248735","name":"Astrup, Arne","orcid":"0000-0001-8968-8996","rank":10,"rolecode":"pau"},{"affno":"2","first":"Kim F.","key":"michaelsenkimfpau","last":"Michaelsen","locid":"c29a2565-4c7e-4a5b-ab39-899baedae963","name":"Michaelsen, Kim F.","orcid":"0000-0003-0449-0839","rank":11,"rolecode":"pau"},{"affno":"2","first":"Lotte","key":"lauritzenlottepau","last":"Lauritzen","locid":"4263561d-003a-4d4c-9f05-06a8f88155e8","name":"Lauritzen, Lotte","orcid":"0000-0001-7184-5949","rank":12,"rolecode":"pau"}],"pmid":["26359192"],"pub":{"doi":"10.1017/s0007114515003323","issn":["00071145","14752662"],"issn_org":["00071145"],"issue":"10","journal":"British Journal of Nutrition","pages":"1623-1637","publisher":"Cambridge University Press","status":"p","title":"British Journal of Nutrition","volume":"114"},"review":"Peer Reviewed","scoID":["2-s2.0-84945465566"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-43c94ebc-397c-48ab-99a7-e19eee3e1c1c","dtu-316b605d-e798-49ee-a068-2820515c4c00","ku-08259325-f4ab-451d-8819-29be151fa30a"],"src":["AU Aarhus University","DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Diet-induced changes in iron and n-3 fatty acid status and associations with cognitive performance in 8-11-year-old Danish children: secondary analyses of the Optimal Well-Being, Development and Health for Danish Children through a Healthy New Nordic Diet School Meal Study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-096.35-017598","year":"2015","yearsub":"2015"}
{"abstract":"Children's vitamin D intake and status can be optimised to meet recommendations. We investigated if nutritionally balanced school meals with weekly fish servings affected serum 25-hydroxyvitamin D (25(OH)D) and markers related to bone in 8- to 11-year-old Danish children. We conducted an explorative secondary outcome analysis on data from 784 children from the OPUS School Meal Study, a cluster-randomised cross-over trial where children received school meals for 3 months and habitual lunch for 3 months. At baseline, and at the end of each dietary period, 25(OH)D, parathyroid hormone (PTH), osteocalcin (OC), insulin-like growth factor-1 (IGF-1), bone mineral content (BMC), bone area (BA), bone mineral density (BMD), dietary intake and physical activity were assessed. School meals increased vitamin D intake by 0·9 (95 % CI 0·7, 1·1) μg/d. No consistent effects were found on 25(OH)D, BMC, BA, BMD, IGF-1 or OC. However, season-modified effects were observed with 25(OH)D, i.e. children completing the school meal period in January/February had higher 25(OH)D status (5·5 (95 % CI 1·8, 9·2) nmol/l; P = 0·004) than children completing the control period in these months. A similar tendency was indicated in November/December (4·1 (95 % CI -0·12, 8·3) nmol/l; P = 0·057). However, the effect was opposite in March/April (-4·0 (95 % CI -7·0, -0·9) nmol/l; P = 0·010), and no difference was found in May/June (P = 0·214). Unexpectedly, the school meals slightly increased PTH (0·18 (95 % CI 0·07, 0·29) pmol/l) compared with habitual lunch. Small increases in dietary vitamin D might hold potential to mitigate the winter nadir in Danish children's 25(OH)D status while higher increases appear necessary to affect status throughout the year. More trials on effects of vitamin D intake from natural foods are needed.","author_count":12,"contributors":["Petersen, Rikke A","Damsgaard, Camilla T","Dalskov, Stine-Mathilde","Sørensen, Louise B","Hjorth, Mads Fiil","Andersen, Rikke","Tetens, Inge","Krarup, Henrik","Ritz, Christian","Astrup, Arne","Michaelsen, Kim F","Mølgaard, Christian"],"cuid":["S03-100.00-005982"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"keyword":["Børn","Children","Ernæring","Faculty of Science","Nutrition","School meals","Skolemad","Vitamin D"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-NDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-HO-NDR","DI-U-AAU","DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"effects of school meals with weekly fish servings on vitamin d status in danish children secondary outcomes from the opus optimal well being development and health for danish children through a healthy new nordic diet school meal study","src":["aau","dtu","ku"],"src-code":["DI-U-AAU","DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1017/jns.2015.15","version":"Published Version"},"id":"S03-100.00-005982","identifier":[{"id":"WOS:000362528400001","type":"wos"},{"id":"84994560210","type":"scopus"},{"id":"26495118","type":"pmid"},{"id":"PMC4611087","type":"pmcid"}],"ids":["aau-7b37b364-abc1-4293-9f9f-1ed1ed6a0a0d","dtu-07873fae-2269-4f9d-93f0-1b7fe19086f3","ku-4c7c7829-11d4-40a8-9996-5bcd62ee90c6"],"keyword":["Børn","Children","Ernæring","Faculty of Science","Nutrition","School meals","Skolemad","Vitamin D"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-3-7-DBF2BB3152770BF8014C6714B62D8DD1"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1017/jns.2015.15","version":"Published Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/117799753/S2048679015000154a.pdf","version":"Published Ve