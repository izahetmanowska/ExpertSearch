{"author_count":4,"contributors":["Yang, Y.","Bruns, Stefan","Stipp, Susan Louise Svane","Sørensen, Henning Osholm"],"cuid":["S01-000.00-491455"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"dissolved co sub 000000000002 sub increases breakthrough porosity in natural porous materials","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-491455","identifier":[{"id":"85025579572","type":"scopus"},{"id":"28622466","type":"pmid"}],"ids":["ku-a412386e-f871-487b-b408-996c16d0235b"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-F085AD1B17F3E52FD54737F0C55655E7"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Chemistry, Department of Chemistry"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Yi","key":"yangpau","last":"Yang","locid":"a5fa2e48-832b-42b5-acf6-ec8b4754c477","name":"Yang, Y.","name_org":"Yang, Yi","rank":1,"rolecode":"pau"},{"affno":"1","first":"Stefan","key":"brunspau","last":"Bruns","locid":"9da9f30d-3a37-404e-9bf2-69c4db15ebe3","name":"Bruns, Stefan","orcid":"0000-0003-1945-0549","rank":2,"rolecode":"pau"},{"affno":"1","first":"Susan Louise Svane","key":"stipppau","last":"Stipp","locid":"b907e7ef-d26a-4093-836b-9b7c9238d956","name":"Stipp, Susan Louise Svane","rank":3,"rolecode":"pau"},{"affno":"1","first":"Henning Osholm","key":"sørensenpau","last":"Sørensen","locid":"e1bf7bae-7f0e-445e-99ea-12eb242407fb","name":"Sørensen, Henning Osholm","orcid":"0000-0002-7004-547X","rank":4,"rolecode":"pau"}],"pmid":["28622466"],"pub":{"doi":"10.1021/acs.est.7b02157","issn":["0013936X","15205851"],"issn_org":["0013936X"],"issue":"14","journal":"Environmental Science & Technology","pages":"7982-7991","status":"p","title":"Environmental Science & Technology","volume":"51"},"review":"Peer Reviewed","scoID":["2-s2.0-85025579572"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-a412386e-f871-487b-b408-996c16d0235b"],"src":["KU University of Copenhagen"],"title":"Dissolved CO<sub>2 </sub>Increases Breakthrough Porosity in Natural Porous Materials","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-491455","year":"2017","yearsub":"2017"}
{"abstract":"With a high sensitivity and specificity, non-invasive prenatal testing (NIPT) is an incomparable screening test for fetal aneuploidy. However, the method is rather newly introduced, and experiences with discordant results are few. We did a systematic review of literature reporting details of false positive and false negative NIPT results. Discordant sex chromosome results were not included. We identified 22 studies reporting case details. In total, 206 discordant cases were included, of which 88% were false positive and 12% false negative. Details on maternal age, gestational age, platform/company, Z-score, fetal fraction, results and explanation were specified. The main reasons for discordant results were confined placental mosaicism, maternal copy number variation, vanished twin, maternal cancer and true fetal mosaicism. A very high percentage of cases (67%) were reported with no obvious biological or technical explanation for the discordant result. The included cases represent only a minor part of the true number of false positive or false negative NIPT cases identified in fetal medicine clinics around the world. To ensure knowledge exchange and transparency of NIPT between laboratories, we suggest a systematic recording of discordant NIPT results, as well as a quality assurance by external quality control and accreditation. © 2017 John Wiley & Sons, Ltd.","author_count":4,"contributors":["Hartwig, Tanja Schlaikjaer","Ambye, Louise","Sørensen, Steen","Jørgensen, Finn Stener"],"cuid":["S01-000.00-541899"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Journal Article","Review"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"discordant non invasive prenatal testing nipt a systematic review","src":["ku"],"src-code":["DI-U-KU"],"type":"djr","type-grp":["all","pub"]},"id":"S01-000.00-541899","identifier":[{"id":"85020062601","type":"scopus"},{"id":"28382695","type":"pmid"}],"ids":["ku-f8b1b8cd-567d-4a44-a94a-ce7cbe798648"],"keyword":["Journal Article","Review"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-945978A107AD617775AEBC454CDBA729"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Obstetrics and Gynaecology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Tanja Schlaikjaer","key":"hartwigpau","last":"Hartwig","name":"Hartwig, Tanja Schlaikjaer","rank":1,"rolecode":"pau"},{"affno":"","first":"Louise","key":"ambyepau","last":"Ambye","name":"Ambye, Louise","rank":2,"rolecode":"pau"},{"affno":"","first":"Steen","key":"sørensenpau","last":"Sørensen","name":"Sørensen, Steen","rank":3,"rolecode":"pau"},{"affno":"1","first":"Finn Stener","key":"jørgensenpau","last":"Jørgensen","locid":"af103a51-0399-4d0c-8377-db0260a8c6c8","name":"Jørgensen, Finn Stener","rank":4,"rolecode":"pau"}],"pmid":["28382695"],"pub":{"doi":"10.1002/pd.5049","issn":["01973851","10970223"],"issn_org":["01973851"],"issue":"6","journal":"Prenatal Diagnosis","pages":"527-539","status":"p","title":"Prenatal Diagnosis","volume":"37"},"review":"Peer Reviewed","scoID":["2-s2.0-85020062601"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-f8b1b8cd-567d-4a44-a94a-ce7cbe798648"],"src":["KU University of Copenhagen"],"title":"Discordant non-invasive prenatal testing (NIPT) : a systematic review","type":"Journal Review","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-541899","year":"2017","yearsub":"2017"}
{"abstract":"BACKGROUND & AIMS: Hypovitaminosis D, defined as serum 25-hydroxyvitamin D (s-25(OH)D) <50 nmol/L, is frequent in pregnant women and neonates worldwide and has been associated with both low birth weight (BW) and placental weight (PW) as well as reduced placental development. We aimed to assess the prevalence and the risk factors of cord vitamin D deficiency (s-25(OH)D <25 nmol/L) and insufficiency (s-25(OH)D 25-50 nmol/L) and to evaluate the association between cord s-25(OH)D levels and neonatal outcomes (BW, PW and PW/BW ratio). METHODS: Women enrolled in Odense Child Cohort, a Danish observational prospective population-based cohort, who gave birth to singletons and donated a blood sample for s-25(OH)D measurements were included (n = 2082). RESULTS: The prevalence of cord vitamin D deficiency was 16.7% and 41.0% for insufficiency. White skin, winter season at birth, maternal supplementation dose of <15 μg/day, non-western ethnicity and high body mass index (BMI) were identified as independent risk factors of both vitamin D deficiency and insufficiency. Adherence to the recommended vitamin D supplementation dose (10 μg/day) was reported by 87% (primipara 91% vs. multipara 81%, p < 0.0001). An U-shaped relationship between cord s-25(OH)D and BW was visualized by spline regression (p = 0.003). After adjustment, cord s-25(OH)D was positively associated with BW (β = 1.522, p = 0.026), PW (β = 0.927, p < 0.001) and PW/BW ratio (β = 0.018, p < 0.001), largely driven by positive associations for cord s-25(OH)D >60 nmol/L. CONCLUSION: Cord hypovitaminosis D was present in 57.7%. Multipara was identified as a novel risk factor of non-adherence to vitamin D supplementation recommendations; and a maternal supplementation dose <15 μg/day as a novel, independent risk factor of cord hypovitaminosis D. Higher BW, PW, and PW/BW ratio were associated to higher cord s-25(OH)D levels with a suggested cut-off at 60 nmol/L. More studies are encouraged to elucidate the impact of cord s-25(OH)D levels on offspring health and to establish optimal cut-offs for these outcomes.","author_count":10,"contributors":["Lykkedegn, Sine","Beck-Nielsen, Signe Sparre","Sorensen, Grith Lykke","Andersen, Louise Bjørkholt","Fruekilde, Palle Bach Nielsen","Nielsen, Jan","Kyhl, Henriette Boye","Jørgensen, Jan Stener","Husby, Steffen","Christesen, Henrik Thybo"],"cuid":["S01-000.00-582797"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Birth Weight","Supplementation","Vitamin D"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"vitamin d supplementation cord 000000000025 hydroxyvitamin d and birth weight findings from the odense child cohort","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85006089922","version":"Other Version"},"id":"S01-000.00-582797","identifier":[{"id":"85006089922","type":"scopus"},{"id":"27817876","type":"pmid"}],"ids":["sdu-219b272e-3b97-4ccd-b965-1eb16e994dc6"],"keyword":["Birth weight","Supplementation","Vitamin D"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-8ABBF81501B081D275459CDDC66E7709"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Paediatrics (Odense)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Sine","key":"lykkedegnpau","last":"Lykkedegn","locid":"8ad1ec10-ae62-4571-90be-4680d1f12a80","name":"Lykkedegn, Sine","orcid":"0000-0003-3018-937X","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Signe Sparre","key":"becknielsenpau","last":"Beck-Nielsen","locid":"b61b575d-79a2-43c3-af29-21bc2e7e51d9","name":"Beck-Nielsen, Signe Sparre","orcid":"0000-0002-7561-9217","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Grith Lykke","key":"sorensenpau","last":"Sorensen","locid":"950cb689-da86-4abe-835b-a1312ddf5cec","name":"Sorensen, Grith Lykke","orcid":"0000-0002-5273-1097","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Louise Bjoerkholt","key":"andersenpau","last":"Andersen","locid":"26e73134-b29b-450a-b9fd-b71c20be9185","name":"Andersen, Louise Bjørkholt","name_org":"Andersen, Louise Bjoerkholt","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Palle Bach Nielsen","key":"fruekildepau","last":"Fruekilde","locid":"c048c127-868a-48aa-8aa7-e29d5618ad6c","name":"Fruekilde, Palle Bach Nielsen","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jan","key":"nielsenpau","last":"Nielsen","locid":"014149d9-906e-4c74-ac91-2ffd5cd77a49","name":"Nielsen, Jan","orcid":"0000-0002-7634-6812","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Henriette Boye","key":"kyhlpau","last":"Kyhl","locid":"d2a9e83c-c23b-4f6c-97b9-5a0426ff4ce5","name":"Kyhl, Henriette Boye","orcid":"0000-0002-6290-2478","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jan Stener","key":"joergensenpau","last":"Joergensen","locid":"4e1adaff-d975-48d8-95b5-73bc6d115a5e","name":"Jørgensen, Jan Stener","name_org":"Joergensen, Jan Stener","orcid":"0000-0001-5222-2535","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Steffen","key":"husbypau","last":"Husby","locid":"9c15aa95-415c-4404-9b10-25a5bb864432","name":"Husby, Steffen","orcid":"0000-0002-6286-2496","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Henrik Boye Thybo","key":"christesenpau","last":"Christesen","locid":"c8317e72-7a09-4c80-81e9-b69855b68e8f","name":"Christesen, Henrik Thybo","name_org":"Christesen, Henrik Boye Thybo","orcid":"0000-0001-5330-6853","rank":10,"rolecode":"pau"}],"pmid":["27817876"],"pub":{"doi":"10.1016/j.clnu.2016.10.008","issn":["02615614","15321983"],"issn_org":["02615614"],"issue":"6","journal":"Clinical Nutrition","pages":"1621-1627","publisher":"Churchill Livingstone","status":"p","title":"Clinical Nutrition","volume":"36"},"review":"Peer Reviewed","scoID":["2-s2.0-85006089922"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-219b272e-3b97-4ccd-b965-1eb16e994dc6"],"src":["SDU University of Southern Denmark"],"title":"Vitamin D supplementation, cord 25-hydroxyvitamin D and birth weight : Findings from the Odense Child Cohort","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-582797","year":"2017","yearsub":"2017"}
{"abstract":"Introduction: The aim was to investigate the parental decisions about prenatal screening and diagnosis among infants with trisomy 21 (T21) in a national cohort with high uptake of combined first-trimester screening (cFTS). Material and Methods: This was a nationwide population-based study including infants born in 2009-2012. Information from the cFTS, fetal karyotype results and pregnancy outcome was obtained from the Danish Fetal Medicine Database on all women with a cFTS risk assessment. Cut-off for referral for invasive testing was ≥1:300. Karyotype results from pregnancies with no cFTS were obtained from the Danish Cytogenetic Central Registry. Results: The uptake rate of cFTS was 91.6%, and 82.8% (8,032/9,704) of the screen-positive women opted for invasive testing. Overall, 82.2% (454/552) chose to terminate an affected pregnancy. In the 4-year period, 102 of 232,962 singletons were born alive with T21. The cFTS risk was true-positive, false-negative or not obtained in 21.6, 48.0 and 30.4%, respectively, of these pregnancies. Discussion: In this large national cohort, 4.4 per 10,000 live-born infants had T21. Of 102 infants with T21 from 2009 to 2012, 52.0% were born after the women had not opted for cFTS or were true-positive but declined invasive testing or termination, and 48.0% were born after a false-negative risk assessment.","author_count":22,"contributors":["Miltoft, Caroline Borregaard","Wulff, Camilla B","Kjærgaard, Susanne","Ekelund, Charlotte K.","Tabor, Ann","Zingenberg, Helle","Jørgensen, Finn Stener","Shalmi, Anne-Cathrine","Thagaard, Ida Näslund","Skibsted, Lillian","Hessellund, Anette","Sperling, Lene Søndergaard","Mogensen, Helle","Ibsen, Mette","Brendstrup, Lene","Petersen, Olav Bjørn","Jensen, Hanne Søndergaard","Vase, Laura","Østergård, Marianne Louise Vang","Kamper, Christina H.","Sørensen, Anne","Størup, Birgitte"],"cuid":["S02-089.53-029629"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corpau":["Danish Fetal Medicine Study Group","the Danish Fetal Medicine Study Group"],"keyword":["Chromosomal abnormalities","Diagnosis","Down syndrome","First trimester","Journal Article","Pregnancy Outcome","Pregnancy termination","Prenatal Diagnosis","Prenatal screening","Screening","Trisomy 21"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"parental decisions about prenatal screening and diagnosis among infants with trisomy 000000000021 in a national cohort with high uptake of combined first trimester screening","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84980315442","version":"Other Version"},"id":"S02-089.53-029629","identifier":[{"id":"27455074","type":"pmid"},{"id":"84980315442","type":"scopus"}],"ids":["au-e9f8ed91-a94d-43ef-b124-523e28b46d6d","ku-badc1a99-b6fd-4578-a849-f8ee8661c15c"],"keyword":["Chromosomal abnormalities","Diagnosis","Down syndrome","First trimester","Journal Article","Pregnancy outcome","Pregnancy termination","Prenatal diagnosis","Prenatal screening","Screening","Trisomy 21"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-D0FD15EC55955F527C3BD247C85337BB"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_