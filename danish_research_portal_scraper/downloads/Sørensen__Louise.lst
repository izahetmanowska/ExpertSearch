":21,"rolecode":"pau"},{"affno":"9","corresponding":null,"first":"Luca","key":"maestripau","last":"Maestri","name":"Maestri, Luca","rank":22,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"H.","key":"skouruppau","last":"Skourup","locid":"f5fe613f-20e5-4a69-9eff-f03779801182","name":"Skourup, Henriette","name_org":"Skourup, H.","orcid":"0000-0002-4468-8033","rank":23,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"R.","key":"forsbergpau","last":"Forsberg","locid":"be93c88f-cc39-43d8-bf6f-ff4787c55c23","name":"Forsberg, René","name_org":"Forsberg, R.","orcid":"0000-0002-7288-9545","rank":24,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Loretta","key":"mizzipau","last":"Mizzi","name":"Mizzi, Loretta","rank":25,"rolecode":"pau"}],"pub":{"doi":"10.5194/tc-14-1889-2020","issn":["19940416","19940424"],"issn_org":["19940416"],"issue":"6","journal":"Cryosphere","pages":"1889-1907","publisher":"Copernicus GmbH","status":"p","title":"Cryosphere","title_org":"The Cryosphere","volume":"14"},"review":"Peer Reviewed","scoID":["2-s2.0-85088212250"],"sdg":["14. Life Below Water","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-645ef94a-450c-450f-9123-bd4cdd6ef3fa"],"src":["DTU Technical University of Denmark"],"title":"CryoSat Ice Baseline-D validation and evolutions","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-334492","year":"2020","yearsub":"2020"}
{"abstract":"The aim of this mixed-method longitudinal study was to explore the role the Danish Organic Cuisine Label plays in maintaining organic food production in public catering. Baseline, end-point and 1-year-follow-up were compared among 622 kitchens participating in organic conversion projects. Numbers of certified kitchens increased from baseline to end-point (p < 0.001). This level was maintained at follow-up. Further, certified kitchens were found to increase their use of organic food at 1-year follow-up (p = 0.012) whereas non-certified kitchens did not. The study identified motives and barriers behind acquiring the label. In conclusion, the Organic Cuisine Label contributed to maintaining organic food productions.","author_count":4,"contributors":["Sørensen, Nina Nørgaard","Sørensen, Marie-Louise Kirchhoff","Trolle, Ellen","Lassen, Anne Dahl"],"cuid":["S01-000.00-356332"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Lassen, Anne Dahl"],"keyword":["Organic food conversion","Public procurement"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"organic food in public catering how the danish organic cuisine label may maintain organic food production in the longer term","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/188691537/wcsc.pdf","version":"Authors Final Version"},"id":"S01-000.00-356332","identifier":[{"id":"85088284418","type":"scopus"}],"ids":["dtu-ad4db793-f7c2-4eea-b31c-88e194e25f66"],"keyword":["Organic Cuisine Label","Organic food conversion","Public procurement"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-5F1ACE2F3BC761AFCC04EB3862DB1F2B"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/188691537/wcsc.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Food Institute"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Nina Nørgaard","key":"sørensenninanørgaardpau","last":"Sørensen","locid":"eeda310a-d3e5-4965-b590-24d46f9f6550","name":"Sørensen, Nina Nørgaard","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Marie-Louise Kirchhoff","key":"sørensenmarielouisekirchhoffpau","last":"Sørensen","name":"Sørensen, Marie-Louise Kirchhoff","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ellen","key":"trolleellenpau","last":"Trolle","locid":"608d6f7f-db78-45d2-b5b2-fb9c1379a0be","name":"Trolle, Ellen","orcid":"0000-0001-9482-1931","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anne Dahl","key":"lassenannedahlpau","last":"Lassen","locid":"93070bb0-5767-4f77-9c43-3b3f9deb0c82","name":"Lassen, Anne Dahl","orcid":"0000-0002-3262-3611","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1080/15428052.2019.1582122","issn":["15428044","15428052"],"issn_org":["15428052"],"issue":"4","journal":"Journal of Culinary Science & Technology","pages":"255-269","publisher":"Taylor & Francis Inc.","status":"p","title":"Journal of Culinary Science & Technology","volume":"18"},"review":"Peer Reviewed","scoID":["2-s2.0-85088284418"],"sdg":["2. Zero Hunger","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-ad4db793-f7c2-4eea-b31c-88e194e25f66"],"src":["DTU Technical University of Denmark"],"title":"Organic Food in Public Catering: How the Danish Organic Cuisine Label May Maintain Organic Food Production in the Longer Term","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-356332","year":"2020","yearsub":"2020"}
{"abstract":"Classically, neurexins are thought to mediate synaptic connections through trans interactions with a number of different postsynaptic partners. Neurexins are cleaved by metalloproteases in an activity-dependent manner, releasing the soluble extracellular domain. Here, we report that in both immature (before synaptogenesis) and mature (after synaptogenesis) hippocampal neurons, the soluble neurexin-1β ectodomain triggers acute Ca2+-influx at the dendritic/postsynaptic side. In both cases, neuroligin-1 expression was required. In immature neurons, calcium influx required N-type calcium channels and stimulated dendritic outgrowth and neuronal survival. In mature glutamatergic neurons the neurexin-1β ectodomain stimulated calcium influx through NMDA-receptors, which increased presynaptic release probability. In contrast, prolonged exposure to the ectodomain led to inhibition of synaptic transmission. This secondary inhibition was activity- and neuroligin-1 dependent and caused by a reduction in the readily-releasable pool of vesicles. A synthetic peptide modeled after the neurexin-1β:neuroligin-1 interaction site reproduced the cellular effects of the neurexin-1β ectodomain. Collectively, our findings demonstrate that the soluble neurexin ectodomain stimulates growth of neurons and exerts acute and chronic effects on trans-synaptic signaling involved in setting synaptic strength.","author_count":13,"contributors":["Wierda, Keimpe D B","Toft-Bertelsen, Trine L.","Gøtzsche, Casper René","Pedersen, Ellis","Korshunova, Irina","Nielsen, Janne","Bang, Marie Louise","Kønig, Andreas Bay","Owczarek, Sylwia","Gjørlund, Michelle D","Schupp, Melanie","Bock, Elisabeth","Sørensen, Jakob Balslev"],"cuid":["S01-000.00-523960"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"the soluble neurexin 000000000001β ectodomain causes calcium influx and augments dendritic outgrowth and synaptic transmission","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41598-020-75047-z","version":"Published Version"},"id":"S01-000.00-523960","identifier":[{"id":"85093502525","type":"scopus"},{"id":"33093500","type":"pmid"},{"id":"PMC7582164","type":"pmcid"}],"ids":["ku-da8a9cb1-c710-4c4a-9321-574eaeb859d3"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-DBA04D7F48970C16BB9A2E2B578098BF"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41598-020-75047-z","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/251258079/The_soluble_neurexin_1_ectodomain_causes_calcium_influx_and_augments_dendritic_outgrowth_and_synaptic_transmission.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Neuroscience, Neuropharm and Genetics"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Keimpe D B","key":"wierdapau","last":"Wierda","locid":"22a74559-00fe-448c-aba9-4dec9736192f","name":"Wierda, Keimpe D B","rank":1,"rolecode":"pau"},{"affno":"1","first":"Trine L","key":"toftbertelsenpau","last":"Toft-Bertelsen","locid":"21214d2f-c04b-481e-81d6-dcc51234c0db","name":"Toft-Bertelsen, Trine L.","name_org":"Toft-Bertelsen, Trine L","rank":2,"rolecode":"pau"},{"affno":"1","first":"Casper R","key":"gøtzschepau","last":"Gøtzsche","locid":"18519a0b-93d7-49f8-9e78-25200031ce89","name":"Gøtzsche, Casper René","name_org":"Gøtzsche, Casper R","rank":3,"rolecode":"pau"},{"affno":"1","first":"Ellis","key":"pedersenpau","last":"Pedersen","locid":"9a0a654c-0d82-4ad3-8682-0bf925010fb0","name":"Pedersen, Ellis","rank":4,"rolecode":"pau"},{"affno":"1","first":"Irina","key":"korshunovapau","last":"Korshunova","locid":"0fa59ac4-5f83-4ddf-9e4d-95d23a45cf34","name":"Korshunova, Irina","orcid":"0000-0003-1921-6170","rank":5,"rolecode":"pau"},{"affno":"1","first":"Janne","key":"nielsenpau","last":"Nielsen","locid":"4e80c802-ca59-4c3a-8621-8e1557cf122a","name":"Nielsen, Janne","rank":6,"rolecode":"pau"},{"affno":"","first":"Marie Louise","key":"bangpau","last":"Bang","name":"Bang, Marie Louise","rank":7,"rolecode":"pau"},{"affno":"1","first":"Andreas B","key":"kønigpau","last":"Kønig","locid":"1c3300f3-6d26-4b91-98d4-929bc82ab8f6","name":"Kønig, Andreas Bay","name_org":"Kønig, Andreas B","rank":8,"rolecode":"pau"},{"affno":"1","first":"Sylwia","key":"owczarekpau","last":"Owczarek","locid":"c2140fd4-a416-42d4-823c-a295ca399479","name":"Owczarek, Sylwia","rank":9,"rolecode":"pau"},{"affno":"1","first":"Michelle D","key":"gjørlundpau","last":"Gjørlund","locid":"c14de171-38a0-4051-9fb0-534bbb2d6e3d","name":"Gjørlund, Michelle D","rank":10,"rolecode":"pau"},{"affno":"1","first":"Melanie","key":"schupppau","last":"Schupp","locid":"6ef088ad-9794-43f9-8e05-43f558b84b96","name":"Schupp, Melanie","rank":11,"rolecode":"pau"},{"affno":"1","first":"Elisabeth","key":"bockpau","last":"Bock","locid":"cf857aa5-80e0-45c0-8a8b-6a682bc89bc1","name":"Bock, Elisabeth","rank":12,"rolecode":"pau"},{"affno":"1","first":"Jakob B","key":"sørensenpau","last":"Sørensen","locid":"1d2f8524-56a2-46e7-a1c3-5f2076cd7857","name":"Sørensen, Jakob Balslev","name_org":"Sørensen, Jakob B","orcid":"0000-0001-5465-3769","rank":13,"rolecode":"pau"}],"pmid":["33093500"],"pub":{"doi":"10.1038/s41598-020-75047-z","issn":["20452322"],"issue":"1","journal":"Scientific Reports","paperid":"18041","status":"p","title":"Scientific Reports","volume":"10"},"review":"Peer Reviewed","scoID":["2-s2.0-85093502525"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-da8a9cb1-c710-4c4a-9321-574eaeb859d3"],"src":["KU University of Copenhagen"],"title":"The soluble neurexin-1β ectodomain causes calcium influx and augments dendritic outgrowth and synaptic transmission","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-523960","year":"2020","yearsub":"2020"}
{"abstract":"Wound healing is a complex biological process that is impaired under diabetes conditions. Chronic non-healing wounds in diabetes are some of the most expensive healthcare expenditures worldwide. Early diagnosis and efficacious treatment strategies are needed. microRNAs (miRNAs), a class of 18-25 nucleotide long RNAs, are important regulatory molecules involved in gene expression regulation and in the repression of translation, controlling protein expression in health and disease. Recently, miRNAs have emerged as critical players in impaired wound healing and could be targets for potential therapies for non-healing wounds. Here, we review and discuss the mechanistic background of miRNA actions in chronic wounds that can shed the light on their utilization as specific wound healing biomarkers.","author_count":5,"contributors":["Petkovic, Marija","Sørensen, Anja Elaine","Leal, Ermelindo","Carvalho, Eugenia","Dalgaard, Louise Torp"],"cuid":["S01-000.00-562320"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","Europe, EU","OECD"],"country":["Portugal","United States"],"glorg":["All Global Affiliations","University of Arkansas for Medical Sciences","University of Coimbra"],"keyword":["Chronic wounds","Diabetic wound healing","Inflammation","Proliferation","Remodeling","tissue regeneration"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-RUC"]},"level3all":["DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"mechanistic actions of micrornas in diabetic wound healing","src":["ruc"],"src-code":["DI-U-RUC"],"type":"djr","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/cells9102228","version":"Published Version"},"id":"S01-000.00-562320","identifier":[{"id":"85092634543","type":"scopus"}],"ids":["ruc-5f4469e5-4f1d-43d6-8d0f-51ee31b00091"],"keyword":["chronic wounds","diabetic wound healing","inflammation","proliferation","remodeling","tissue and circulating microRNAs","tissue regeneration"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-43C9E139D3179D13F8EBB96679C812F9"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/74810126/cells_09_02228_v3.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/cells9102228","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of Science and Environment","Roskilde University, Department of Science and Environment, Molecular and Medical Biology"],"nora_code":"DI-U-RUC","used":1},{"affno":"2","country":"pt","key":"university of coimbra","loc":["Portugal","Europe, EU","OECD"],"name":"University of Coimbra","used":1},{"affno":"3","country":"us","key":"university of arkansas for medical sciences","loc":["United States","America, North","OECD"],"name":"University of Arkansas for Medical Sciences","used":1}],"person":[{"affno":"1 2","country":"dk","first":"Marija","key":"petkovicpau","last":"Petkovic","locid":"e5e5ad4a-fa18-4b93-8c94-56d73526fbe4","name":"Petkovic, Marija","rank":1,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Anja Elaine","key":"sørensenpau","last":"Sørensen","locid":"7e5d1e2c-5d4b-4436-bb66-acdca4058c08","name":"Sørensen, Anja Elaine","orcid":"0000-0001-7557-5376","rank":2,"rolecode":"pau"},{"affno":"2","first":"Ermelindo","key":"lealpau","last":"Leal","name":"Leal, Ermelindo","rank":3,"rolecode":"pau"},{"affno":"2 3","first":"Eugenia","key":"carvalhopau","last":"Carvalho","name":"Carvalho, Eugenia","rank":4,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Louise Torp","key":"dalgaardpau","last":"Dalgaard","locid":"a219fdaf-f994-4a7a-beb8-1f353846ed5a","name":"Dalgaard, Louise Torp","orcid":"0000-0002-3598-2775","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.3390/cells9102228","issn":["20734409"],"issue":"10","journal":"Cells","pages":"1-32","paperid":"2228","status":"p","title":"Cells","volume":"9"},"review":"Peer Reviewed","scoID":["2-s2.0-85092634543"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Roskilde University","Universities"],"PST":["Published"]},"sid":["ruc-5f4469e5-4f1d-43d6-8d0f-51ee31b00091"],"src":["RUC Roskilde University"],"title":"Mechanistic Actions of microRNAs in Diabetic Wound Healing","type":"Journal Review","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-562320","year":"2020","yearsub":"2020"}
{"abstract":"BACKGROUND: Comparable global data on health and nutrition of school-aged children and adolescents are scarce. We aimed to estimate age trajectories and time trends in mean height and mean body-mass index (BMI), which measures weight gain beyond what is expected from height gain, for school-aged children and adolescents. METHODS: For this pooled analysis, we used a database of cardiometabolic risk factors collated by the Non-Communicable Disease Risk Factor Collaboration. We applied a Bayesian hierarchical model to estimate trends from 1985 to 2019 in mean height and mean BMI in 1-year age groups for ages 5-19 years. The model allowed for non-linear changes over time in mean height and mean BMI and for non-linear changes with age of children and adolescents, including periods of rapid growth during adolescence. FINDINGS: We pooled data from 2181 population-based studies, with measurements of height and weight in 65 million participants in 200 countries and territories. In 2019, we estimated a difference of 20 cm or higher in mean height of 19-year-old adolescents between countries with the tallest populations (the Netherlands, Montenegro, Estonia, and Bosnia and Herzegovina for boys; and the Netherlands, Montenegro, Denmark, and Iceland for girls) and those with the shortest populations (Timor-Leste, Laos, Solomon Islands, and Papua New Guinea for boys; and Guatemala, Bangladesh, Nepal, and Timor-Leste for girls). In the same year, the difference between the highest mean BMI (in Pacific island countries, Kuwait, Bahrain, The Bahamas, Chile, the USA, and New Zealand for both boys and girls and in South Africa for girls) and lowest mean BMI (in India, Bangladesh, Timor-Leste, Ethiopia, and Chad for boys and girls; and in Japan and Romania for girls) was approximately 9-10 kg/m2. In some countries, children aged 5 years started with healthier height or BMI than the global median and, in some cases, as healthy as the best performing countries, but they became progressively less healthy compared with their comparators as they grew older by not growing as tall (eg, boys in Austria and Barbados, and girls in Belgium and Puerto Rico) or gaining too much weight for their height (eg, girls and boys in Kuwait, Bahrain, Fiji, Jamaica, and Mexico; and girls in South Africa and New Zealand). In other countries, growing children overtook the height of their comparators (eg, Latvia, Czech Republic, Morocco, and Iran) or curbed their weight gain (eg, Italy, France, and Croatia) in late childhood and adolescence. When changes in both height and BMI were considered, girls in South Korea, Vietnam, Saudi Arabia, Turkey, and some central Asian countries (eg, Armenia and Azerbaijan), and boys in central and western Europe (eg, Portugal, Denmark, Poland, and Montenegro) had the healthiest changes in anthropometric status over the past 3·5 decades because, compared with children and adolescents in other countries, they had a much larger gain in height than they did in BMI. The unhealthiest changes-gaining too little height, too much weight for their height compared with children in other countries, or both-occurred in many countries in sub-Saharan Africa, New Zealand, and the USA for boys and girls; in Malaysia and some Pacific island nations for boys; and in Mexico for girls. INTERPRETATION: The height and BMI trajectories over age and time of school-aged children and adolescents are highly variable across countries, which indicates heterogeneous nutritional quality and lifelong health advantages and risks. FUNDING: Wellcome Trust, AstraZeneca Young Health Programme, EU.","author_count":71,"contributors":["Rodriguez-Martinez, Andrea","Zhou, Bin","Sophiea, Marisa K.","Bentham, James","Paciorek, Christopher J.","Iurilli, Maria LC","Carrillo-Larco, Rodrigo M.","Bennett, James E.","Di Cesare, Mariachiara","Taddei, Cristina","Bixby, Honor","Stevens, Gretchen A.","Riley, Leanne M.","Cowan, Melanie J.","Savin, Stefan","Danaei, Goodarz","Chirita-Emandi, Adela","Kengne, Andre P.","Khang, Young Ho","Laxmaiah, Avula","Malekzadeh, Reza","Miranda, J. Jaime","Moon, Jin Soo","Popovic, Stevo R.","Sørensen, Thorkild I A","Andersen, Lars Bo","Jørgensen, Maja Bæksgaard","Bjerregaard, Peter","Bugge, Anna","Christensen, Kaare","Ekelund, Ulf","Eliasen, Marie","Eriksen, Louise","Fattahi, Mohammad Reza","Grøntved, Anders","Kaducu, Felix O.","Klakk, Heidi","Kolle, Elin","Kristensen, Peter Lund","Møller, Niels Christian","Osler, Merete","Rasmussen, Mette","Schramm, Stine","Sodemann, Morten","Tarp, Jakob","Thuesen, Betina H.","Tolstrup, Janne Schurmann","Wang, Qian","Wedderkopp, Niels"],"cuid":["S06-099.98-793348"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"51-200 contributors","class":"merged","cluster_size":"5+","continent":["Africa","Asia, East","Asia, Middle East","Europe, Non-EU","Nordic","OECD"],"corpau":["NCD Risk Factor Collaboration (NCD-RisC)"],"country":["China","Iran","Norway","Uganda"],"glorg":["All Global Affiliations","Gulu University","Norwegian School of Sport Sciences","Shiraz University of Medical Sciences","Western Norway University of Applied Sciences","Xinjiang Medical University"],"keyword":["Adolescent","Adolescent Development physiology","BMI","Bayes Theorem","Body Height","Body Mass Index","Børn","Child","Child Development physiology","Child Preschool","Female","Health Status Indicators","Humans","Internationality","Male","Meta Analysis as Topic","Population health","Trend","Vægt","Worldwide","Young Adult","disease health science and nursing"],"level":"sci","mra":["hum","med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U","DI-UC"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"],"UC":["DI-UC-ALL","DI-UC-KP","DI-UC-UCL","DI-UC-UCS"]},"level3all":["DI-HO-CAP","DI-U-AU","DI-U-KU","DI-U-SDU","DI-UC-KP","DI-UC-UCL","DI-UC-UCS"]},"review":"pr","rtype":["clu"],"sorti":"height and bod