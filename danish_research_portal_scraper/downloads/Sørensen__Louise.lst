-4061","rank":7,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"S. Abbas","key":"khanpau","last":"Khan","locid":"a1da0a4e-dc92-4c96-9365-0877275c16c6","name":"Khan, Shfaqat Abbas","name_org":"Khan, S. Abbas","orcid":"0000-0002-2689-8563","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anne M.","key":"solgaardpau","last":"Solgaard","name":"Solgaard, Anne M.","rank":9,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"René","key":"forsbergpau","last":"Forsberg","locid":"be93c88f-cc39-43d8-bf6f-ff4787c55c23","name":"Forsberg, René","orcid":"0000-0002-7288-9545","rank":10,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Henriette","key":"skouruppau","last":"Skourup","locid":"f5fe613f-20e5-4a69-9eff-f03779801182","name":"Skourup, Henriette","orcid":"0000-0002-4468-8033","rank":11,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Lars","key":"stensengpau","last":"Stenseng","locid":"c0f908ca-1192-4239-b399-ad14c4d9bc6d","name":"Stenseng, Lars","orcid":"0000-0003-4690-4200","rank":12,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Steen S.","key":"kristensenpau","last":"Kristensen","locid":"1a4e60b3-ced0-43c4-84f2-f09772bfc51c","name":"Kristensen, Steen Savstrup","name_org":"Kristensen, Steen S.","orcid":"0000-0001-5928-1802","rank":13,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Sine M.","key":"hvidegaardpau","last":"Hvidegaard","locid":"92b07d8f-692c-4ebb-bc40-f44224f3f143","name":"Hvidegaard, Sine Munk","name_org":"Hvidegaard, Sine M.","orcid":"0000-0001-8159-6499","rank":14,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Michele","key":"citteriopau","last":"Citterio","name":"Citterio, Michele","rank":15,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Nanna","key":"karlssonpau","last":"Karlsson","name":"Karlsson, Nanna","rank":16,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Xavier","key":"fettweispau","last":"Fettweis","name":"Fettweis, Xavier","rank":17,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andreas P.","key":"ahlstrømpau","last":"Ahlstrøm","name":"Ahlstrøm, Andreas P.","rank":18,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Signe B.","key":"andersenpau","last":"Andersen","name":"Andersen, Signe B.","rank":19,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Dirk","key":"vanaspau","last":"Van As","name":"Van As, Dirk","rank":20,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Robert","key":"faustopau","last":"Fausto","name":"Fausto, Robert","rank":21,"rolecode":"pau"}],"pub":{"doi":"10.34194/geusb-201943-02-01","issn":["16048156","19044666"],"issn_org":["16048156"],"journal":"Geological Survey of Denmark and Greenland (GEUS) Bulletin","paperid":"e2019430201","status":"p","title":"Geological Survey of Denmark and Greenland (GEUS) Bulletin","title_org":"Geological Survey of Denmark and Greenland Bulletin","volume":"43"},"review":"Peer Reviewed","scoID":["2-s2.0-85071306593"],"sdg":["13. Climate Action","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-U","DI-U-ALL","Governmental Institutions","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-0bad55d7-5103-4f11-9206-14153c7983b6","ku-81f5dba2-6bb9-481e-bb4d-61d53d9d8de3"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Greenland ice sheet mass balance assessed by PROMICE (1995–2015)","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-032853","year":"2019","yearsub":"2019"}
{"abstract":"Aim: We sought to describe the contemporary annual incidence of cardiogenic shock (CS) following acute myocardial infarction (AMICS), the proportion of patients developing CS following ST-elevation myocardial infarction (STEMI), and other temporal changes in AMICS in Denmark between 2010 and 2017. Methods and results: Medical records of patients suspected of having AMICS during 2010–2017 were reviewed to identify consecutive patients with AMICS in a cohort corresponding to two-thirds of the Danish population. Due to changes in recruitment area over the study period, population-based incidence could only be calculated from 2012 to 2017. A total of 1716 patients with AMICS were identified and an increase in the annual incidence was observed, from a nadir 65.3 per million person-years in 2013 to 80.0 per million person-years in 2017 (P-value for trend < 0.001). This trend corresponded to an increase in patients with non-STEMI and a decrease in patients developing CS after STEMI (10.0–6.6%, P-value for trend < 0.001) Also, mean arterial blood pressure at the time of AMICS was lower (63 ± 11 mmHg to 61 ± 13 mmHg, P-value for trend = 0.001) and the frequency of patients with left ventricular ejection fraction ≤ 30% increased (61.8%–71.4%, P-value for trend = 0.004). The annual 30-day mortality during the study period remained unchanged at about 50%. Conclusion: The incidence rate of AMICS increased in the Danish population between 2012 and 2017. Fewer patients with STEMI developed CS, and haemodynamic severity of CS increased during the study period; however, survival rates remained unchanged.","author_count":12,"contributors":["Helgestad, Ole K.l.","Josiassen, Jakob","Hassager, Christian","Jensen, Lisette O.","Holmvang, Lene","Sørensen, Anne","Frydland, Martin","Lassen, Annmarie T.","Udesen, Nanna L.j.","Schmidt, Henrik","Ravn, Hanne Berg","Møller, Jacob E."],"cuid":["S02-100.00-045776"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corresponding_author":["Helgestad, Ole Kristian Lerche"],"keyword":["Cardiogenic shock","Epidemiology","Mechanical circulatory support","Myocardial Infarction","Percutaneous Coronary Intervention"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-SDR","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"temporal trends in incidence and patient characteristics in cardiogenic shock following acute myocardial infarction from 000000002010 to 000000002017 a danish cohort study","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/250881256/Temporal_trends_in_incidence_and_patient_characteristics_in_cardiogenic_shock_following_acute_myocardial_infarction_from_2010_to_2017_a_Danish_cohort_study_accepted_version_.pdf","version":"Authors Final Version"},"id":"S02-100.00-045776","identifier":[{"id":"85069705846","type":"scopus"},{"id":"31339222","type":"pmid"}],"ids":["ku-bd0a5d96-950b-4f27-9466-c0dc4b37bd26","sdu-7e701fcc-1b42-4e40-8f4b-1da24e93276c"],"keyword":["Cardiogenic shock","Epidemiology","Mechanical circulatory support","Myocardial infarction","Percutaneous coronary intervention"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-33C71617F7710F456130DD8D565D4039"],"oa_link":[{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/250881256/Temporal_trends_in_incidence_and_patient_characteristics_in_cardiogenic_shock_following_acute_myocardial_infarction_from_2010_to_2017_a_Danish_cohort_study_accepted_version_.pdf","version":"Authors Final Version"},{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/170826601/ejhf.1566.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research Unit OPEN (Odense)","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Cardiology (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Internal medicine: Cardiology"],"nora_code":"DI-U-KU","used":1},{"affno":"4","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Odense University Hospital"],"nora_code":"DI-HO-SDR","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Ole K L","key":"helgestadpau","last":"Helgestad","locid":"ab9f3165-500c-482b-9c2f-1879b3abedb3","name":"Helgestad, Ole Kristian Lerche","name_org":"Helgestad, Ole K L","orcid":"0000-0003-3847-8758","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jakob","key":"josiassenpau","last":"Josiassen","name":"Josiassen, Jakob","rank":2,"rolecode":"pau"},{"affno":"3","first":"Christian","key":"hassagerpau","last":"Hassager","locid":"49196e5d-0f61-44b2-a6b9-cd6c5f8f3bc2","name":"Hassager, Christian","orcid":"0000-0002-1199-0981","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lisette O","key":"jensenpau","last":"Jensen","locid":"b78c452e-5a69-41fe-ba49-0096c84d1d4d","name":"Jensen, Lisette Okkels","name_org":"Jensen, Lisette O","orcid":"0000-0002-4838-2429","rank":4,"rolecode":"pau"},{"affno":"3","first":"Lene","key":"holmvangpau","last":"Holmvang","locid":"54b8ef01-f8ed-4c49-a126-2109e2fd351f","name":"Holmvang, Lene","rank":5,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Anne","key":"sørensenpau","last":"Sørensen","name":"Sørensen, Anne","rank":6,"rolecode":"pau"},{"affno":"","first":"Martin","key":"frydlandpau","last":"Frydland","name":"Frydland, Martin","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Annmarie T","key":"lassenpau","last":"Lassen","locid":"80e651b5-e70f-43e0-baf8-e88335ac10b8","name":"Lassen, Annmarie Touborg","name_org":"Lassen, Annmarie T","orcid":"0000-0003-4942-6152","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Nanna L J","key":"udesenpau","last":"Udesen","locid":"f71f56f5-4f36-4de5-a7ae-e5e51f101a83","name":"Udesen, Nanna Louise Junker","name_org":"Udesen, Nanna L J","orcid":"0000-0003-1542-3260","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik","key":"schmidtpau","last":"Schmidt","locid":"9789920f-4b31-4f28-8211-97afced9d61e","name":"Schmidt, Henrik","rank":10,"rolecode":"pau"},{"affno":"3","first":"Hanne B.","key":"ravnpau","last":"Ravn","locid":"3049e7b7-0f18-413b-88ab-a3d77ebc079b","name":"Ravn, Hanne Berg","name_org":"Ravn, Hanne B.","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jacob E","key":"møllerpau","last":"Møller","locid":"5e4d3cb6-b0a0-4541-aea1-30e73f7c10b8","name":"Møller, Jacob Eifer","name_org":"Møller, Jacob E","orcid":"0000-0003-2873-5845","rank":12,"rolecode":"pau"}],"pmid":["31339222"],"pub":{"doi":"10.1002/ejhf.1566","issn":["13889842","18790844"],"issn_org":["13889842"],"issue":"11","journal":"European Journal of Heart Failure","pages":"1370-1378","publisher":"Wiley","status":"p","title":"European Journal of Heart Failure","volume":"21"},"review":"Peer Reviewed","scoID":["2-s2.0-85069705846"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-bd0a5d96-950b-4f27-9466-c0dc4b37bd26","sdu-7e701fcc-1b42-4e40-8f4b-1da24e93276c"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Temporal trends in incidence and patient characteristics in cardiogenic shock following acute myocardial infarction from 2010 to 2017 : a Danish cohort study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-045776","year":"2019","yearsub":"2019"}
{"abstract":"RATIONALE: The hormone glucagon-like peptide-1 (GLP-1) decreases blood glucose and appetite. Greater physical activity (PA) is associated with lower incidence of type 2 diabetes. While acute exercise may increase glucose-induced response of GLP-1, it is unknown how habitual PA affects GLP-1 secretion. We hypothesised that habitual PA associates with greater glucose-induced GLP-1 responses in overweight individuals. METHODS: Cross-sectional analysis of habitual PA levels and GLP-1 concentrations in 1326 individuals (mean (SD) age 66 (7) years, BMI 27.1 (4.5) kg/m2) from the ADDITION-PRO cohort. Fasting and oral glucose-stimulated GLP-1 responseswere measured using validated radioimmunoassay. PA was measured using 7-days combined accelerometry and heart rate monitoring. From this, energy expenditure (PAEE;kJ/kg/day) and fractions of time spent in activity intensities (hours/day) were calculated. Cardiorespiratory fitness (CRF;ml O2/kg/min) was calculated using step tests. Age-, BMI- and insulin sensitivity-adjusted associations between PA and GLP-1, stratified by sex, were evaluated by linear regression analysis. RESULTS: In 703 men, fasting GLP-1 concentrations were 20% lower (95%CI: -33;-3%, P=0.02) for every hour of moderate-intensity PA performed. Higher CRF and PAEE were associated with 1-2% lower fasting GLP-1 (P=0.01). For every hour moderate-intensity PA, the glucose-stimulated GLP-1 response was 16% greater at peak 30 min (1;33%, PrAUC0-30=0.04) and 20% greater at full response (3;40%, PrAUC0-120=0.02). No associations were found in women who performed PA 22 min/day versus 32 min/day for men. CONCLUSION: Moderate-intensity PA is associated with lower fasting and greater glucose-induced GLP-1 responses in overweight men, possibly contributing to improved glucose and appetite regulation with increased habitual PA.","author_count":13,"contributors":["Janus, Charlotte","Vistisen, Dorte","Amadid, Hanan","Witte, Daniel R","Lauritzen, Torsten","Brage, Søren","Bjerregaard, Anne-Louise","Hansen, Torben","Holst, Jens Juul","Jørgensen, Marit Eika","Pedersen, Oluf","Færch, Kristine","Torekov, Signe"],"cuid":["S03-095.96-013360"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"continent":["Europe, Non-EU","OECD"],"corresponding_author":["Torekov, Signe S."],"country":["United Kingdom"],"glorg":["All Global Affiliations","University of Cambridge"],"keyword":["Exercise","GLP 1","Glucagon Like Peptide 1","Habitual physical activity","Overweight","Prediabetes"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-STENO"],"OT":["Steno Diabetes Centre, Gentofte, Denmark."],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-STENO","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"habitual physical activity is associated with lower fasting and greater glucose induced glp 000000000001 response in men","src":["au","ku","sdu"],"src-code":["DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1530/EC-19-0408","version":"Published Version"},"funding_acknowledgement":["C J was supported by a research grant from the Danish Diabetes Academy (DDA) funded by the Novo Nordisk Foundation (NNF) during this work. Furthermore, this work was supported by the Tripartite Immunometabolism Consortium (TrIC) Novo Nordisk Foundation; Grant number NNF15CC0018486. K F was supported by the Novo Nordisk Foundation during this work. S B was supported by the UK Medical Research Council (MC_UU_12015/3) and the NIHR Biomedical Research Centre Cambridge (IS-BRC-1215-20014). For the remaining authors none were declared."],"id":"S03-095.96-013360","identifier":[{"id":"PMC6933827","type":"pmcid"},{"id":"31804964","type":"pmid"},{"id":"000