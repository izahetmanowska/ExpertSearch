gion","l3nn":"North Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"North Denmark Region","namevar":["Aalborg University Hospital"],"nora_code":"DI-HO-NDR","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Anita Rath","key":"sørensenpau","last":"Sørensen","name":"Sørensen, Anita Rath","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Elisabeth","key":"bendstruppau","last":"Bendstrup","name":"Bendstrup, Elisabeth","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders","key":"løkkepau","last":"Løkke","name":"Løkke, Anders","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ingrid Louise","key":"titlestadpau","last":"Titlestad","locid":"67905117-c8b6-4567-b11a-11abb0621cc2","name":"Titlestad, Ingrid Louise","orcid":"0000-0001-6418-0088","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jens Ulrik Stæhr","key":"jensenpau","last":"Jensen","name":"Jensen, Jens Ulrik Stæhr","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Laura Hohwu","key":"thomsenpau","last":"Thomsen","name":"Thomsen, Laura Hohwu","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Nassim Bazeghi","key":"robertspau","last":"Roberts","name":"Roberts, Nassim Bazeghi","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Pia Holland","key":"gjøruppau","last":"Gjørup","name":"Gjørup, Pia Holland","rank":8,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Saher Burhan","key":"shakerpau","last":"Shaker","name":"Shaker, Saher Burhan","rank":9,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Svend","key":"gundestruppau","last":"Gundestrup","name":"Gundestrup, Svend","rank":10,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jon Torgny Rostrup","key":"wilckepau","last":"Wilcke","name":"Wilcke, Jon Torgny Rostrup","rank":11,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Ulla Moller","key":"weinr