{"author_count":8,"contributors":["Jahn, Kasper","Tørring, Thomas","Voigt, Niels Vinther","Sørensen, Rasmus Schøler","Kodal, Anne Louise Bank","Andersen, Ebbe Sloth","Gothelf, Kurt Vesterager","Kjems, Jørgen"],"cuid":["S01-000.00-140620"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"functional patterning of dna origami by parallel enzymatic modification","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1021/bc2000098","version":"Other Version"},"id":"S01-000.00-140620","identifier":[{"id":"79955000182","type":"scopus"},{"id":"21413714","type":"pmid"}],"ids":["au-137d82c4-c537-420c-b71d-d44f7ea0c05d"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-A32B1B954CD9F2192571BB492BE4B899"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1021/bc2000098","version":"Other Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus University, Faculty of Science, Department of Molecular Biology","Aarhus University, Aarhus University, Faculty of Science, iNano-School"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Kasper","key":"jahnpau","last":"Jahn","locid":"9fe09973-55fb-4659-b402-f6f51d2ca013","name":"Jahn, Kasper","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Thomas","key":"tørringpau","last":"Tørring","locid":"b03df36b-0252-4e5a-aeee-7113f77cad12","name":"Tørring, T