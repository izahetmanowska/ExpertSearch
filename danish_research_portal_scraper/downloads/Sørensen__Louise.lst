rolecode":"pau"},{"affno":"1","first":"Sören","key":"dobberschützpau","last":"Dobberschütz","locid":"66001890-e369-420b-a67d-3e360d39fa46","name":"Dobberschütz, Sören","rank":3,"rolecode":"pau"},{"affno":"1","first":"Robert Krarup","key":"feidenhanslpau","last":"Feidenhans'l","locid":"0a3fb80e-6206-4f37-8e19-12d109fdab12","name":"Feidenhans'l, Robert Krarup","orcid":"0000-0002-7963-3649","rank":4,"rolecode":"pau"},{"affno":"1","first":"Susan Louise Svane","key":"stipppau","last":"Stipp","locid":"b907e7ef-d26a-4093-836b-9b7c9238d956","name":"Stipp, Susan Louise Svane","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1063/1.4897441","issn":["00036951","10773118"],"issn_org":["00036951"],"journal":"Applied Physics Letters","paperid":"143107","status":"p","title":"Applied Physics Letters","volume":"105"},"review":"Peer Reviewed","scoID":["2-s2.0-84907882587"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-1d521873-83c3-4b94-9b83-37d238135e87"],"src":["KU University of Copenhagen"],"title":"Adaptive center determination for effective suppression of ring artifacts in tomography images","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-410882","year":"2014","yearsub":"2014"}
{"abstract":"The use of dietary fibers as fat-replacers in sausages gives less energy-dense and thereby healthier foods. Also, dietary fibers have been shown to induce satiety. The objectives of this study were to investigate if appetite sensations and energy intake was affected by (1) addition of dietary fibers to sausages, (2) type of dietary fibers and (3) the food matrix of the dietary fibers. In this randomized cross-over study 25 young men were served four test meals; wheat bran sausages, rye bran sausages, rye bran bread and wheat flour sausages. The test meals were served as breakfast after an overnight fast. Appetite sensations were evaluated by visual analogue scales (VAS) assessed every 30 min for 240 min followed by an ad libitum lunch meal where energy intake was calculated. Both rye bran and wheat bran sausages increased satiety (P < 0.01) and fullness (P < 0.02) and decreased hunger (P < 0.001) and prospective consumption (P < 0.001) compared to wheat flour sausages. Furthermore, rye bran sausages increased satiety (P < 0.05) and fullness (P < 0.02) and decreased prospective consumption (P < 0.01) compared to rye bran bread. No differences in subsequent energy intake were observed. In conclusion, wheat and rye bran added to sausages decreased appetite sensations and thereby has a potential added health benefit beyond the role as fat-replacer. The satisfying effect of dietary fibers appears to be more pronounced when added to sausages than when added to bread, stressing the importance of food matrix and food processing.","author_count":6,"contributors":["Vuholm, Stine","Arildsen Jakobsen, Louise Margrethe","Sørensen, Karina Vejrum","Kehlet, Ursula Nana","Raben, Anne","Kristensen, Mette Bredal"],"cuid":["S01-000.00-512839"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Adult","Appetite","Bread","Breakfast","Cereals","Cross Over Studies","Dietary Fats","Dietary fiber","Eating","Energy Intake","Humans","Hunger","Male","Meat Products","Prospective Studies","Satiety Response","Secale cereale","Triticum","Young Adult"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GTS","DI-U"],"level3":{"GTS":["DI-GTS-ALL","DI-GTS-DTCI"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-GTS-DTCI","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"appetite and food intake after consumption of sausages with 000000000010 fat and added wheat or rye bran","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.appet.2013.09.028","version":"Other Version"},"id":"S01-000.00-512839","identifier":[{"id":"24511620","type":"pmid"},{"id":"84890876883","type":"scopus"}],"ids":["ku-c80057bb-2115-4bec-aa31-2b108715bb6a"],"keyword":["Adult","Appetite","Bread","Breakfast","Cereals","Cross-Over Studies","Dietary Fats","Dietary Fiber","Eating","Energy Intake","Fat Substitutes","Humans","Hunger","Male","Meat Products","Prospective Studies","Satiety Response","Secale cereale","Triticum","Young Adult"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-62BB88C66B32D6BEF12DEA21501E928D"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.appet.2013.09.028","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Nutrition, Exercise and Sports, Nutrition and Health"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"danish technological institute","l2":"DI-GTS","l2n":"GTS Institute