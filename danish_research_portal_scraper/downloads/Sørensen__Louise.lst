{"author_count":7,"contributors":["Hakim, S. S.","Olsson, M. H. M.","Sørensen, H. O.","Bovet, N.","Bohr, Jakob","Feidenhans’l, R.","Stipp, S. L. S."],"cuid":["S02-087.44-036295"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"publisher correction interactions of the calcite 000000000010 000000000004 surface with organic compounds structure and behaviour at mineral organic interfaces interactions of the calcite 000000000010 000000000004 surface with organic compounds structure and behaviour at mineral organic interfaces vol 000000000007 000000002017","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"djc","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41598-018-28935-4","version":"Published Version"},"id":"S02-087.44-036295","identifier":[{"id":"85049880436","type":"scopus"},{"id":"29993006","type":"pmid"},{"id":"PMC6041304","type":"pmcid"}],"ids":["dtu-a30811a0-9fdb-4197-b8cb-053e17881ee7","ku-41a5d6ec-d2f0-4787-9d0f-51f71617e8c4"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-872800BA3885DF0D6B7CD92D78823A65"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/152182078/s41598_018_28935_4.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41598-018-28935-4","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/222547819/s41598_018_28935_4.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Chemistry"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Micro- and Nanotechnology","Technical University of Denmark, Department of Micro- and Nanotechnology, Theoretical Biophysics"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","first":"S. S.","key":"hakimpau","last":"Hakim","locid":"60c6860c-4c94-4b91-95ff-45e802cdc01a","name":"Hakim, Sepideh Sadat","name_org":"Hakim, S. S.","orcid":"0000-0001-6486-4551","rank":1,"rolecode":"pau"},{"affno":"1","first":"M. H. M.","key":"olssonpau","last":"Olsson","locid":"d33d21bf-d396-4cd4-af26-1e75ad022ef8","name":"Olsson, Mats Henrik Mikael","name_org":"Olsson, M. H. M.","rank":2,"rolecode":"pau"},{"affno":"1","first":"H. O.","key":"sørensenpau","last":"Sørensen","locid":"e1bf7bae-7f0e-445e-99ea-12eb242407fb","name":"Sørensen, Henning Osholm","name_org":"Sørensen, H. O.","orcid":"0000-0002-7004-547X","rank":3,"rolecode":"pau"},{"affno":"1","first":"N.","key":"bovetpau","last":"Bovet","locid":"a001edf5-b545-4614-b905-727171248f80","name":"Bovet, Nicolas Emile","name_org":"Bovet, N.","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Jakob","key":"bohrpau","last":"Bohr","locid":"d468e94c-7bd7-4c9d-9ea3-b029bfefcdd7","name":"Bohr, Jakob","rank":5,"rolecode":"pau"},{"affno":"","first":"R.","key":"feidenhanslpau","last":"Feidenhans’l","name":"Feidenhans’l, R.","rank":6,"rolecode":"pau"},{"affno":"1","first":"S. L. S.","key":"stipppau","last":"Stipp","locid"