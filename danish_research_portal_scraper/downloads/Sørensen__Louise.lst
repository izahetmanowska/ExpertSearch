{"author_count":3,"contributors":["Berntsen, Dorthe","Staugaard, Søren Risløv","Sørensen, Louise Maria"],"cuid":["S01-000.00-270802"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"why am i remembering this now predicting the occurrence of involuntary spontaneous episodic memories","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.au.dk/ws/files/71770153/Berntsen_Staugaard_og_Sorensen_2013_.pdf","version":"Authors Final Version"},"id":"S01-000.00-270802","identifier":[{"id":"84879244170","type":"scopus"},{"id":"22746701","type":"pmid"}],"ids":["au-f7feda88-7e12-4aed-bdef-518812d4f0a1"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-4-D15F89C024B51F76ADCFE670778B6BB2"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.au.dk/ws/files/71770153/Berntsen_Staugaard_og_Sorensen_2013_.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Social Science (SOC)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus BSS, Department of Psychology and Behavioural Sciences","Aarhus University, Aarhus BSS, Department of Psychology and Behavioural Sciences, Department of Psychology and Behavioural Sciences - CON AMORE"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Dorthe","key":"berntsenpau","last":"Berntsen","locid":"2a5c3e80-973a-4b35-883d-a7de4143885c","name":"Berntsen, Dorthe","orcid":"0000-0001-5941-314X","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren Risløv","key":"staugaardpau","last":"Staugaard","locid":"1175708f-e446-4ec3-a81b-63e7f0d2e848","name":"Staugaard, Søren Risløv","orcid":"0000-0001-9133-2366","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Louise Maria","key":"sørensenpau","last":"Sørensen","locid":"5b1f6801-7a99-46cc-8ff8-4929138d5580","name":"Sørensen, Louise Maria","rank":3,"rolecode":"pau"}],"pmid":["22746701"],"pub":{"doi":"10.1037/a0029128","issn":["00963445","19392222"],"issn_org":["00963445"],"issue":"2","journal":"Journal of Experimental Psychology: General","pages":"426-444","publisher":"American Psychological Association","status":"p","title":"Journal of Experimental Psychology: General","volume":"142"},"review":"Peer Reviewed","scoID":["2-s2.0-84879244170"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-f7feda88-7e12-4aed-bdef-518812d4f0a1"],"src":["AU Aarhus University"],"title":"Why am I remembering this now? Predicting the occurrence of involuntary (spontaneous) episodic memories","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-270802","year":"2013","yearsub":"2013"}
{"abstract":"In order to ensure long-term climate data records for the Greenland Ice Sheet (GIS), ESA have launched the Climate Change Initiative (CCI). This work presents the preliminary steps towards the Ice Sheet CCI's surface elevation change (SEC) derivation using radar altimeter data. In order to find the most optimal method, a Round Robin exercise was conducted in which the scientific community was asked to provide their best SEC estimate over the Jakobshavn Isbr drainage basin. The participants used both repeat-track (RT), overlapping footprints, and the cross-over (XO) methods, and both ICESat laser and Envisat radar altimeter data were used. Based on this and feedback sheets describing their methods we found that a combination of the RT and XO techniques yielded the best results. In the following, the obtained results will be presented and discussed.","author_count":7,"contributors":["Fredenslund Levinsen, Joanna","Khvorostovky, Kirill","Meister, Rakia","Sørensen, Louise Sandberg","Ticconi, Francesca","Forsberg, René","Shepherd, Andrew"],"cuid":["S01-000.00-319999"],"event":{"end":"2013-09-13","place":"Edinburgh, gb","start":"2013-09-09","title":"ESA Living Planet Symposium — 2013","year":"2013"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"surface elevation changes of the greenland ice sheet results from esa s ice sheet cci","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-319999","ids":["dtu-33c6c65d-93d2-4e35-b4b8-8b075a478120"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-5AE18554D070D6C106B04801F0F3BBA2"],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Space Institute","Technical University of Denmark, National Space Institute, Geodynamics"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Joanna","key":"fredenslundlevinsenpau","last":"Fredenslund Levinsen","locid":"55f307d3-198e-4dd1-9f7f-2305c650f50d","name":"Fredenslund Levinsen, Joanna","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Kirill","key":"khvorostovkypau","last":"Khvorostovky","name":"Khvorostovky, Kirill","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rakia","key":"meisterpau","last":"Meister","locid":"4f1baadc-6017-47d8-a7b6-38877d9cdc20","name":"Meister, Rakia","orcid":"0000-0001-8519-5502","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Louise Sandberg","key":"sørensenpau","last":"Sørensen","locid":"1c6cb90f-da30-48a2-872f-a94b8100749b","name":"Sørensen, Louise Sandberg","orcid":"0000-0002-3771-4061","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Francesca","key":"ticconipau","last":"Ticconi","name":"Ticconi, Francesca","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"René","key":"forsbergpau","last":"Forsberg","locid":"be93c88f-cc39-43d8-bf6f-ff4787c55c23","name":"Forsberg, René","orcid":"0000-0002-7288-9545","rank":6,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Andrew","key":"shepherdpau","last":"Shepherd","name":"Shepherd, Andrew","rank":7,"rolecode":"pau"}],"pub":{"publisher":"European Space Agency","status":"p","title":"Proceedings of ESA Living Planet Symposium"},"review":"Peer Reviewed","sdg":["13. Climate Action","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-33c6c65d-93d2-4e35-b4b8-8b075a478120"],"src":["DTU Technical University of Denmark"],"title":"Surface elevation changes of the greenland ice sheet - results from ESA'S ice sheet CCI","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-319999","year":"2013","yearsub":"2014"}
{"abstract":"We calculate the future sea-level rise contribution from the surface mass balance of all of Greenland's glaciers and ice caps (GICs, ~90 000 km2) using a simplified energy balance model which is driven by three future climate scenarios from the regional climate models HIRHAM5, RACMO2 and MAR. Glacier extent and surface elevation are modified during the mass balance model runs according to a glacier retreat parameterization. Mass balance and glacier surface change are both calculated on a 250 m resolution digital elevation model yielding a high level of detail and ensuring that important feedback mechanisms are considered. The mass loss of all GICs by 2098 is calculated to be 2016 ± 129 Gt (HIRHAM5 forcing), 2584 ± 109 Gt (RACMO2) and 3907 ± 108 Gt (MAR). This corresponds to a total contribution to sea-level rise of 5.8 ± 0.4, 7.4 ± 0.3 and 11.2 ± 0.3 mm, respectively. Sensitivity experiments suggest that mass loss could be higher by 20–30% if a strong lowering of the surface albedo were to take place in the future. It is shown that the sea-level rise contribution from the north-easterly regions of Greenland is reduced by increasing precipitation while mass loss in the southern half of Greenland is dominated by steadily decreasing summer mass balances. In addition we observe glaciers in the north-eastern part of Greenland changing their characteristics towards greater activity and mass turnover.","author_count":9,"contributors":["Machguth, H.","Rastner, P.","Bolch, T.","Mölg, N.","Sørensen, Louise Sandberg","Aðalgeirsdottir, G.","van Angelen, J. H.","van den Broeke, M. R.","Fettweis, X."],"cuid":["S01-000.00-323467"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","OECD"],"country":["Belgium","Netherlands","Switzerland"],"glorg":["All Global Affiliations","Institute for Marine and Atmospheric Research","University of Liege","University of Zurich"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-DMI","DI-GV-GEUS"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-GV-DMI","DI-GV-GEUS","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"the future sea level rise contribution of greenland s glaciers and ice caps","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/53982261/Machguth2013.pdf","version":"Published Version"},"id":"S01-000.00-323467","identifier":[{"id":"84880867279","type":"scopus"}],"ids":["dtu-3f77cad2-7783-4a49-ae9b-1a39a259ba00"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-A186960625B21D9F69407382C5B2EB32"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/53982261/Machguth2013.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1088/1748-9326/8/2/025005","version":"Other Version"},{"access":"oa","type":"rem","url":"http://iopscience.iop.org/1748-9326/8/2/025005/","version":"Other Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","country":"dk","key":"geus geological survey of denmark and greenland","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-GEUS","l3nn":"GEUS Geological Survey of Denmark and Greenland","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"GEUS Geological Survey of Denmark and Greenland","namevar":["Geological Survey of Denmark and Greenland"],"nora_code":"DI-GV-GEUS","used":1},{"affno":"2","country":"ch","key":"university of zurich","loc":["Switzerland","Europe, Non-EU","OECD"],"name":"University of Zurich","used":1},{"affno":"3","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Space Institute","Technical University of Denmark, National Space Institute, Geodynamics"],"nora_code":"DI-U-DTU","used":1},{"affno":"4","country":"dk","key":"dmi danish meteorological institute","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-DMI","l3nn":"DMI Danish Meteorological Institute","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DMI Danish Meteorological Institute","namevar":["Danish Meteorological Institute"],"nora_code":"DI-GV-DMI","used":1},{"affno":"5","country":"nl","key":"institute for marine and atmospheric research","loc":["Netherlands","Europe, EU","OECD"],"name":"Institute for Marine and Atmospheric Research","used":1},{"affno":"6","country":"be","key":"university of liege","loc":["Belgium","Europe, EU","OECD"],"name":"University of Liege","used":1}],"person":[{"affno":"1","corresponding":null,"first":"H.","key":"machguthpau","last":"Machguth","name":"Machguth, H.","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"P.","key":"rastnerpau","last":"Rastner","name":"Rastner, P.","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"T.","key":"bolchpau","last":"Bolch","name":"Bolch, T.","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"N.","key":"mölgpau","last":"Mölg","name":"Mölg, N.","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Louise Sandberg","key":"sørensenpau","last":"Sørensen","locid":"1c6cb90f-da30-48a2-872f-a94b8100749b","name":"Sørensen, Louise Sandberg","orcid":"0000-0002-3771-4061","rank":5,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"G.","key":"aðalgeirsdottirpau","last":"Aðalgeirsdottir","name":"Aðalgeirsdottir, G.","rank":6,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"J. H.","key":"vanangelenpau","last":"van Angelen","name":"van Angelen, J. H.","rank":7,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"M. R.","key":"vandenbroekepau","last":"van den Broeke","name":"van den Broeke, M. R.","rank":8,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"X.","key":"fettweispau","last":"Fettweis","name":"Fettweis, X.","rank":9,"rolecode":"pau"}],"pub":{"doi":"10.1088/1748-9326/8/2/025005","issn":["17489326"],"issue":"8","journal":"Environmental Research Letters","pages":"025005","publisher":"IOP Publishing","status":"p","title":"Environmental Research Letters"},"review":"Peer Reviewed","scoID":["2-s2.0-84880867279"],"sdg":["13. Climate Action","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-U","DI-U-ALL","Governmental Institutions","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-3f77cad2-7783-4a49-ae9b-1a39a259ba00"],"src":["DTU Technical University of Denmark"],"title":"The future sea-level rise contribution of Greenland’s glaciers and ice caps","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-323467","year":"2013","yearsub":"2013"}
{"abstract":"During the last decade, the GRACE mission has provided valuable data for determining the mass changes of the Greenland and Antarctic ice sheets. Yet, discrepancies still exist in the published mass balance results, and comprehensive analyses on the sources of errors and discrepancies are lacking. Here, we present monthly mass changes together with trends derived from GRACE data at basin scale for both the Greenland and Antarctic ice sheets, and we assess the variability and errors for each of the possible sources of discrepancies, and we do this in an unprecedented systematic way, taking into account mass inference methods, data sets and background models. We find a very good agreement between the monthly mass change results derived from two independent methods, which represents a cross validation. For the monthly solutions, we find that most of the scatter is caused by the use of the two different data sets rather than the two different methods applied. Besides the well-known GIA trend uncertainty, we find that the geocenter motion and the recent de-aliasing corrections significantly impact the trends, with contributions of +13.2 Gt yr−1 and −20 Gt yr−1, respectively, for Antarctica, which is more affected by these than Greenland. We show differences between the use of release RL04 and the new RL05 and confirm a lower noise content in the new release. The overall scatter of the solutions well exceeds the uncertainties propagated from the data errors and the leakage (as done in the past); hence we calculate new sound total errors for the monthly solutions and the trends. We find that the scatter in the monthly solutions caused by applying different estimates of geocenter motion time series (degree-1 corrections) is significant – contributing with up to 40% of the total error.","author_count":3,"contributors":["Barletta, Valentina Roberta","Sørensen, Louise Sandberg","Forsberg, René"],"cuid":["S01-000.00-323678"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"scatter of mass changes estimates at basin scale for greenland and antarctica","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/58773804/Barletta_TC.pdf","version":"Published Version"},"id":"S01-000.00-323678","identifier":[{"id":"84884665126","type":"scopus"}],"ids":["dtu-4034a241-a81e-4bb0-b2fb-9b37c16c747d"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-4126829B2C782D20C6F72B4BE7AD7F62"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/58773804/Barletta_TC.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.5194/tc-7-1411-2013","version":"Other Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Space Institute","Technical University of Denmark, National Space Institute, Geodynamics"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Valentina Roberta","key":"barlettapau","last":"Barletta","locid":"9662b7b8-5901-45b2-bba3-dd8e3879f864","name":"Barletta, Valentina Roberta","orcid":"0000-0003-4427-0830","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Louise Sandberg","key":"sørensenpau","last":"Sørensen","locid":"1c6cb90f-da30-48a2-872f-a94b8100749b","name":"Sørensen, Louise Sandberg","orcid":"0000-0002-3771-4061","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"René","key":"forsbergpau","last":"Forsberg","locid":"be93c88f-cc39-43d8-bf6f-ff4787c55c23","name":"Forsberg, René","orcid":"0000-0002-7288-9545","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.5194/tc-7-1411-2013","issn":["19940416","19940424"],"issn_org":["19940416"],"journal":"Cryosphere","pages":"1411-1432","publisher":"Copernicus GmbH","status":"p","title":"Cryosphere","volume":"7"},"review":"Peer Reviewed","scoID":["2-s2.0-84884665126"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-4034a241-a81e-4bb0-b2fb-9b37c16c747d"],"src":["DTU Technical University of Denmark"],"title":"Scatter of mass changes estimates at basin scale for Greenland and Antarctica","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-323678","year":"2013","yearsub":"2013"}
{"abstract":"We present a full-length a1b2c2 GABA receptor model optimized for agonists and benzodiazepine (BZD) allosteric modulators. We propose binding hypotheses for the agonists GABA, muscimol and THIP and for the allosteric modulator diazepam (DZP). The receptor model is primarily based on the glutamate-gated chloride channel (GluCl) from C. elegans and includes additional structural information from the prokaryotic ligand-gated ion channel ELIC in a few regions. Available mutational data of the binding sites are well explained by the model and the proposed ligand binding poses. We suggest a GABA binding mode similar to the binding mode of glutamate in the GluCl X-ray structure. Key interactions are predicted with residues a1R66, b2T202, a1T129, b2E155, b2Y205 and the backbone of b2S156. Muscimol is predicted to bind similarly, however, with minor differences rationalized with quantum mechanical energy calculations. Muscimol key interactions are predicted to be a1R66, b2T202, a1T129, b2E155, b2Y205 and b2F200. Furthermore, we argue that a water molecule could mediate further interactions between muscimol and the backbone of b2S156 and b2Y157. DZP is predicted to bind with interactions comparable to those of the agonists in the orthosteric site. The carbonyl group of DZP is predicted to interact with two threonines a1T206 and c2T142, similar to the acidic moiety of GABA. The chlorine atom of DZP is placed near the important a1H101 and the N-methyl group near a1Y159, a1T206, and a1Y209. We present a binding mode of DZP in which the pending phenyl moiety of DZP is buried in the binding pocket and thus shielded from solvent exposure. Our full length GABAA receptor is made available as Model S1.","author_count":5,"contributors":["Kongsbak, Kristine Grønning","Bergmann, Rikke","Sørensen, Pernille Louise","Sander, Tommy","Balle, Thomas"],"cuid":["S01-000.00-341933"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["OECD","Oceania"],"country":["Australia"],"glorg":["All Global Affiliations","University of Sydney"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-NP","DI-U"],"level3":{"NP":["DI-NP-ALL","DI-NP-NOVO"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-NP-NOVO","DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"a unified model of the gaba a receptor comprising agonist and benzodiazepine binding sites","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/51876657/prod11358259034339.Bergmann_et_al_2013.pdf","version":"Published Version"},"id":"S01-000.00-341933","identifier":[{"id":"84872033261","type":"scopus"},{"id":"23308109","type":"pmid"},{"id":"PMC3538749","type":"pmcid"}],"ids":["dtu-7d27f178-5eb3-4183-bf4e-c89b0c4d4257"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-3-5-03E935795C7790031AE37B1C5603E171"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/51876657/prod11358259034339.Bergmann_et_al_2013.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1371/journal.pone.0052323","version":"Other Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Systems Biology","Technical University of Denmark, Department of Systems Biology, Center for Biological Sequence Analysis","Technical University of Denmark, National Food Institute","Technical University of Denmark, National Food Institute, Division of Toxicology and Risk Assessment"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"dk","key":"novo nordisk foundation","l2":"DI-NP","l2n":"Non-Profit Organisations","l3":"DI-NP-NOVO","l3nn":"Novo Nordisk Foundation","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Novo Nordisk Foundation","namevar":["Novo Nordisk Foundation"],"nora_code":"DI-NP-NOVO","used":1},{"affno":"4","country":"au","key":"university of sydney","loc":["Australia","Oceania","OECD"],"name":"University of Sydney","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Kristine Grønning","key":"kongsbakpau","last":"Kongsbak","locid":"e85f4514-4b13-4629-a1b8-7bdc419a5f96","name":"Kongsbak, Kristine Grønning","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Rikke","key":"bergmannpau","last":"Bergmann","name":"Bergmann, Rikke","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Pernille Louise","key":"sørensenpau","last":"Sørensen","name":"Sørensen, Pernille Louise","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Tommy","key":"sanderpau","last":"Sander","name":"Sander, Tommy","rank":4,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Thomas","key":"ballepau","last":"Balle","name":"Balle, Thomas","rank":5,"rolecode":"pau"}],"pmid":["23308109"],"pub":{"doi":"10.1371/journal.pone.0052323","issn":["19326203"],"issue":"1","journal":"PLOS ONE","publisher":"Public Library of Science","status":"p","title":"PLOS ONE","title_org":"P L o S One","volume":"8"},"review":"Peer Reviewed","scoID":["2-s2.0-84872033261"],"search":{"DAF":["All Danish Affiliations","All Non-Profit Organisations","All Universities","DI-ALL","DI-NP","DI-NP-ALL","DI-U","DI-U-ALL","Non-Profit Organisations","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-7d27f178-5eb3-4183-bf4e-c89b0c4d4257"],"src":["DTU Technical University of Denmark"],"title":"A Unified Model of the GABA(A) Receptor Comprising Agonist and Benzodiazepine Binding Sites","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-341933","year":"2013","yearsub":"2013"}
{"abstract":"After the successful launch of CryoSat-2 in April 2010, the first direct validation campaign of the satellite was carried out in the April-May 2011. Part of this was repeated in Spring 2012. DTU Space has been involved in ESA’s CryoSat Validation Experiment (CryoVEx) with airborne activities since 2003. To validate the performance of the CryoSat-2 radar altimeter (SIRAL), the aircraft is equipped with an airborne version of the SIRAL altimeter (ASIRAS) together with a laser scanner. Of particular interest is to study the penetration depth of SIRAL into both land- and sea ice. This can be done by comparing the radar and laser measurements, as the laser reflects on the surface, and by overflights of radar reflectors. The campaigns focused on five main validation sites: Devon ice cap (Canada), Austfonna ice cap (Svalbard), the EGIG line crossing the Greenland Ice Sheet, as well as the sea ice north of Alert and sea ice around Svalbard in the Fram Strait. Selected tracks were planned to match CryoSat-2 passes and a few of them were flown in formation flight with the AlfredWegener Institute (AWI) Polar- 5 carrying an EM induction sounder. The paper presents an overview of the 2011-12 airborne campaigns together with first results of the CryoSat-2 underflights.","author_count":10,"contributors":["Skourup, Henriette","Hvidegaard, Sine Munk","Forsberg, René","Einarsson, Indriði","Olesen, Arne Vestergaard","Sørensen, Louise Sandberg","Stenseng, Lars","Hendricks, Stefan","Helm, Veit","Davidson, Malcolm"],"cuid":["S01-000.00-360956"],"event":{"end":"2012-09-29","place":"Venice-Lido, it","start":"2012-09-24","title":"20 years of Progress in Radar Altimetry","year":"2012"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["France","Germany"],"glorg":["Alfred Wegener Institute - Helmholtz Centre for Polar and Marine Research","All Global Affiliations","European Space Agency - ESA"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"cryovex 000000002011 000000000012 airborne campaigns for cryosat validation","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"id":"S01-000.00-360956","ids":["dtu-bca20972-0b08-4c85-9195-ffc0327981f7"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-FD5CD6BEC4E0D7C3D02E7CA2501938E1"],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Space Institute","Technical University of Denmark, National Space Institute, Geodynamics"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"de","key":"alfred wegener institute helmholtz centre for polar and marine research","loc":["Germany","Europe, EU","OECD"],"name":"Alfred Wegener Institute - Helmholtz Centre for Polar and Marine Research","used":1},{"affno":"3","country":"fr","key":"european space agency esa","loc":["France","Europe, EU","OECD"],"name":"European Space Agency - ESA","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Henriette","key":"skouruppau","last":"Skourup","locid":"f5fe613f-20e5-4a69-9eff-f03779801182","name":"Skourup, Henriette","orcid":"0000-0002-4468-8033","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sine Munk","key":"hvidegaardpau","last":"Hvidegaard","locid":"92b07d8f-692c-4ebb-bc40-f44224f3f143","name":"Hvidegaard, Sine Munk","orcid":"0000-0001-8159-6499","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"René","key":"forsbergpau","last":"Forsberg","locid"