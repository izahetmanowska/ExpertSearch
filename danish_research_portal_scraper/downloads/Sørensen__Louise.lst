3b310500","name":"Mathiesen, Elisabeth R.","name_org":"Mathiesen, Elisabeth Reinhardt","rank":11,"rolecode":"pau"},{"affno":"8","first":"Sjurdur Frodi","key":"olsenpau","last":"Olsen","name":"Olsen, Sjurdur Frodi","rank":12,"rolecode":"pau"},{"affno":"4 9 4 10","first":"Richard","key":"safferypau","last":"Saffery","name":"Saffery, Richard","rank":13,"rolecode":"pau"},{"affno":"1","first":"Romain","key":"barrèspau","last":"Barrès","locid":"19b8079b-9b9e-4067-adb0-a66ab70f184f","name":"Barrès, Romain","orcid":"0000-0002-0158-519X","rank":14,"rolecode":"pau"},{"affno":"2 1","first":"Peter","key":"dammpau","last":"Damm","locid":"884d03d5-5981-4d33-80c6-adb21f836deb","name":"Damm, Peter","rank":15,"rolecode":"pau"},{"affno":"11 12 6","first":"Allan Arthur","key":"vaagpau","last":"Vaag","name":"Vaag, Allan Arthur","rank":16,"rolecode":"pau"},{"affno":"3","country":"dk","first":"Louise Torp","key":"dalgaardpau","last":"Dalgaard","locid":"a219fdaf-f994-4a7a-beb8-1f353846ed5a","name":"Dalgaard, Louise Torp","orcid":"0000-0002-3598-2775","rank":17,"rolecode":"pau"}],"pmid":["38715048"],"pub":{"doi":"10.1186/s13148-024-01673-3","issn":["18687075","18687083"],"issn_org":["18687075"],"issue":"1","journal":"Clinical Epigenetics","paperid":"61","status":"p","title":"Clinical Epigenetics","volume":"16"},"review":"Peer Reviewed","scoID":["2-s2.0-85192240327"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Hospitals","All Miscellaneous","All Private Research","All Universities","Capital Region of Denmark","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Miscellaneous","Novo Nordisk","Other Research","Private Research","Roskilde University","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-98c14b4a-a4c0-4f3f-91a8-c08d6529effa","ruc-10606493-d74b-4a68-a780-e33fe5700ce2"],"src":["KU University of Copenhagen","RUC Roskilde University"],"title":"Epigenetics of the non-coding RNA nc886 across blood, adipose tissue and skeletal muscle in offspring exposed to diabetes in pregnancy","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-742366","year":"2024","yearsub":"2024"}
{"abstract":"Positive leadership behaviours at work are associated with worker well-being and performance. However there is less knowledge about whether exposure to low levels of positive leadership behaviours increase workers’ risk of clinical mental disorders. We investigated whether low levels of positive leadership behaviours are prospectively associated with risk of treatment for depressive and anxiety disorders. In a cohort study, we linked survey data from 59,743 respondents from the Work Environment and Health in Denmark survey with national health register data. Leadership behaviours were measured with an eight-item scale. Treatment was defined as redeemed prescription for antidepressants or anxiolytics or hospital treatment for depression or anxiety. Using Cox proportional hazard regression, adjusting for demographic variables, job type and sector, adverse life events and childhood adversities, we estimated the association between leadership behaviours at baseline and risk of treatment during follow-up. We identified 999 cases of depression and anxiety treatment during follow-up. Compared to high levels of leadership behaviours, exposure to medium low and low levels were associated with an increased risk of treatment after adjustment for covariates. The results suggest that low levels of positive leadership behaviours are associated with an increased risk of treatment for depressive or anxiety disorders.","author_count":5,"contributors":["Sorensen, Kathrine","Dalsager, Louise","Conway, Paul Maurice","Li, Jian","Rugulies, Reiner"],"cuid":["S02-100.00-768664"],"filters":{"added":"2024-08","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","University of California at Los Angeles"],"keyword":["Anti Anxiety Agents","Antidepressive Agents","Epidemiologic Research Design","Leadership behavior","Occupational health","Working conditions"],"level":"sci","mra":["med","soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-WORK"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-GV-WORK","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"leadership at work and risk of treatment for depressive and anxiety disorders in denmark a nationwide prospective study with register based follow up","src":["ku","nfa"],"src-code":["DI-GV-WORK","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.psychres.2024.115870","version":"Published Version"},"id":"S02-100.00-768664","identifier":[{"id":"85191867692","type":"scopus"},{"id":"38696969","type":"pmid"}],"ids":["ku-147a1a9f-77cd-4981-b803-185358645e0a","nfa-257fc74d-e168-49f6-a92f-ad29a4d3c2e6"],"keyword":["Anti-anxiety agents","Antidepressive agents","Epidemiologic research design","Leadership behavior","Occupational health","Registries/statistics and numerical data","Working conditions"],"lang":"English","level":"Scientific","mra":["Medical Science","Social Science"],"noi":["Global-Local-2-5-D53DB800654BE44BFC1B837BBD2C3F06"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.psychres.2024.115870","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/393997493/1_s2.0_S0165178124001550_main.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Social Sciences, Department of Psychology, Department of Psychology"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"nfa national research centre for the working environment","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-WORK","l3nn":"NFA National Research Centre for the Working Environment","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"NFA National Research Centre for the Working Environment","namevar":["National Research Centre for the Work Environment"],"nora_code":"DI-GV-WORK","used":1},{"affno":"3","country":"us","key":"university of california at los angeles","loc":["United States","America, North","OECD"],"name":"University of California at Los Angeles","used":1}],"person":[{"affno":"1 2","first":"Kathrine","key":"sørensenpau","last":"Sørensen","locid":"5d564efe-de1b-4502-8597-9391dee2a8f4","name":"Sorensen, Kathrine","name_org":"Sørensen, Kathrine","orcid":"0000-0002-7534-6888","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Louise","key":"dalsagerpau","last":"Dalsager","locid":"09c67a97-b524-4868-a287-957d4f04e6d6","name":"Dalsager, Louise","orcid":"0000-0002-6931-9525","rank":2,"rolecode":"pau"},{"affno":"1","first":"Paul Maurice","key":"conwaypau","last":"Conway","locid":"bf2f5718-fe5f-419b-9ef3-85018acf63e9","name":"Conway, Paul Maurice","orcid":"0000-0002-9236-9731","rank":3,"rolecode":"pau"},{"affno":"3","first":"Jian","key":"lipau","last":"Li","name":"Li, Jian","rank":4,"rolecode":"pau"},{"affno":"2 1","first":"Reiner","key":"ruguliespau","last":"Rugulies","locid":"88830f3c-e0d6-48c4-8b5e-0f6a8078df69","name":"Rugulies, Reiner","orcid":"0000-0002-7752-131X","rank":5,"rolecode":"pau"}],"pmid":["38696969"],"pub":{"doi":"10.1016/j.psychres.2024.115870","issn":["01651781","18727123"],"issn_org":["01651781"],"journal":"Psychiatry Research","paperid":"115870","publisher":"Elsevier Ireland Ltd","status":"p","title":"Psychiatry Research","volume":"337"},"review":"Peer Reviewed","scoID":["2-s2.0-85191867692"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-U","DI-U-ALL","Governmental Institutions","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-147a1a9f-77cd-4981-b803-185358645e0a","nfa-257fc74d-e168-49f6-a92f-ad29a4d3c2e6"],"src":["KU University of Copenhagen","NFA National Research Centre for the Working Environment"],"title":"Leadership at work and risk of treatment for depressive and anxiety disorders in Denmark : A nationwide prospective study with register-based follow up","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-768664","year":"2024","yearsub":"2024"}
{"abstract":"Western Eurasia witnessed several large-scale human migrations during the Holocene1,2,3,4,5. Here, to investigate the cross-continental effects of these migrations, we shotgun-sequenced 317 genomes—mainly from the Mesolithic and Neolithic periods—from across northern and western Eurasia. These were imputed alongside published data to obtain diploid genotypes from more than 1,600 ancient humans. Our analyses revealed a ‘great divide’ genomic boundary extending from the Black Sea to the Baltic. Mesolithic hunter-gatherers were highly genetically differentiated east and west of this zone, and the effect of the neolithization was equally disparate. Large-scale ancestry shifts occurred in the west as farming was introduced, including near-total replacement of hunter-gatherers in many areas, whereas no substantial ancestry shifts happened east of the zone during the same period. Similarly, relatedness decreased in the west from the Neolithic transition onwards, whereas, east of the Urals, relatedness remained high until around 4,000 bp, consistent with the persistence of localized groups of hunter-gatherers. The boundary dissolved when Yamnaya-related ancestry spread across western Eurasia around 5,000 bp, resulting in a second major turnover that reached most parts of Europe within a 1,000-year span. The genetic origin and fate of the Yamnaya have remained elusive, but we show that hunter-gatherers from the Middle Don region contributed ancestry to them. Yamnaya groups later admixed with individuals associated with the Globular Amphora culture before expanding into Europe. Similar turnovers occurred in western Siberia, where we report new genomic data from a ‘Neolithic steppe’ cline spanning the Siberian forest steppe to Lake Baikal. These prehistoric migrations had profound and lasting effects on the genetic diversity of Eurasian population","author_count":174,"contributors":["Allentoft, Morten E.","Sikora, Martin","Refoyo-Martínez, Alba","Irving-Pease, Eva