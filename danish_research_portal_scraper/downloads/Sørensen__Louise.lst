3 14","corresponding":null,"first":"Sisse R.","key":"ostrowskisisserpau","last":"Ostrowski","name":"Ostrowski, Sisse R.","rank":487,"rolecode":"pau"},{"affno":"1 2 22","corresponding":null,"first":"William J.","key":"astlewilliamjpau","last":"Astle","name":"Astle, William J.","rank":488,"rolecode":"pau"},{"affno":"23","corresponding":null,"first":"Martin L.","key":"olssonmartinlpau","last":"Olsson","name":"Olsson, Martin L.","rank":489,"rolecode":"pau"},{"affno":"23","corresponding":null,"first":"Jill R.","key":"storryjillrpau","last":"Storry","name":"Storry, Jill R.","rank":490,"rolecode":"pau"},{"affno":"4 14","corresponding":null,"first":"Ole B.","key":"pedersenolebpau","last":"Pedersen","name":"Pedersen, Ole B.","rank":491,"rolecode":"pau"},{"affno":"1 6 24","corresponding":null,"first":"Willem H.","key":"ouwehandwillemhpau","last":"Ouwehand","name":"Ouwehand, Willem H.","rank":492,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Krishna","key":"chatterjeekrishnapau","last":"Chatterjee","name":"Chatterjee, Krishna","rank":493,"rolecode":"pau"},{"affno":"25","corresponding":null,"first":"Dragana","key":"vuckovicdraganapau","last":"Vuckovic","name":"Vuckovic, Dragana","rank":494,"rolecode":"pau"},{"affno":"1 2 10","corresponding":null,"first":"Mattia","key":"frontinimattiapau","last":"Frontini","name":"Frontini, Mattia","rank":495,"rolecode":"pau"}],"pmid":["38906141"],"pub":{"doi":"10.1016/j.medj.2024.05.015","issn":["26666340","26666359"],"issn_org":["26666359"],"issue":"9","journal":"Med","publisher":"Cell Press","status":"p","title":"Med","volume":"5"},"review":"Peer Reviewed","scoID":["2-s2.0-85198207889"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Governmental Institutions","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Region Zealand","Roskilde University","Universities","University of Copenhagen"],