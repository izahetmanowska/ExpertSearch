 University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Respiratory Diseases","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Anæstesi, Børn, Kredsløb og Kvinder"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Anita Rath","key":"sørensenpau","last":"Sørensen","name":"Sørensen, Anita Rath","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Elisabeth","key":"bendstruppau","last":"Bendstrup","name":"Bendstrup, Elisabeth","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Anders","key":"løkkepau","last":"Løkke","name":"Løkke, Anders","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ingrid Louise","key":"titlestadpau","last":"Titlestad","name":"Titlestad, Ingrid Louise","rank":4,"rolecode":"pau"},{"affno":"3","first":"Jens Ulrik","key":"jensenpau","last":"Jensen","locid":"d9593acd-d6ae-4a83-a7c8-64bc2ea541ac","name":"Jensen, Jens Ulrik Stæhr","name_org":"Jensen, Jens Ulrik","orcid":"0000-0003-4036-0521","rank":5,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Laura","key":"thomsenpau","last":"Thomsen","name":"Thomsen, Laura","rank":6,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Nassim","key":"robertspau","last":"Roberts","name":"Roberts, Nassim","rank":7,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Pia","key":"gjøruppau","last":"Gjørup","name":"Gjørup, Pia","rank":8,"rolecode":"pau"},{"affno":"3","first":"Saher","key":"shakerpau","last":"Shaker","locid":"50547732-6055-4d4d-9081-d835db2cb373","name":"Shaker, Saher Burhan","name_org":"Shaker, Saher","rank":9,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Svend","key":"gundestruppau","last":"Gundestrup","name":"Gundestrup, Svend","rank":10,"rolecode":"pau"},{"affno":"3","first":"Torgny","key":"wilckepau","last":"Wilcke","locid":"f87b3098-290b-4592-a7ba-bf1a9c28af7e","name":"Wilcke, Jon Torgny","name_org":"Wilcke, Torgny","rank":11,"rolecode":"pau"},{"affno":"5","corresponding":null,"country":"dk","first":"Ulla Møller","key":"weinreichpau","last":"Weinreich","locid":"dd46b672-1843-46f2-8fdd-a338cf5c6621","name":"Weinreich, Ulla Møller","orcid":"0000-0003-1975-3654","rank":12,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Kristoffer","key":"marsaapau","last":"Marsaa","name":"Marsaa, Kristoffer","rank":13,"rolecode":"pau"}],"pmid":["30274574"],"pub":{"issn":["00415782","13994174"],"issn_org":["00415782"],"journal":"Ugeskrift for Læger","paperid":"V04180270","publisher":"Almindelige Danske Laegeforening","status":"p","title":"Ugeskrift for Læger","title_org":"Ugeskrift for Laeger","volume":"180"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["aau-7799001f-4544-4347-800f-f8f99fc283ef","ku-9cbc85ce-3d6c-4786-969f-c99e8b6e792b"],"src":["AAU Aalborg University","KU University of Copenhagen"],"title":"Behandlingsniveau og behandlingsstop ved benign lungesygdom : Treatment limitations or discontinuation in patients with benign pulmonary diseases","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-084.57-741425","year":"2018","yearsub":"2018"}
{"abstract":"BACKGROUND: The content of marine n-3 polyunsaturated fatty acids (PUFAs) in adipose tissue is considered a long-term biomarker for the body's endogenous exposure to seafood. OBJECTIVES: This study sought to examine associations between the content of marine n-3 PUFAs in adipose tissue and the risk of incident peripheral arterial disease (PAD). METHODS: In this case-cohort study based on data from the Danish Diet, Cancer and Health cohort, adipose tissue biopsies were taken from the buttocks of all participants at baseline. After a median follow-up of 13.5 years, 870 validated cases of PAD were identified and included together with a randomly drawn subcohort of 3,204 participants using weighted Cox regression. Adipose tissue samples were analyzed by gas chromatography. RESULTS: In multivariable analyses using the lowest quintile as the reference and adjusting for established risk factors for PAD, we found a statistically significant lower rate of PAD in the highest quintile of eicosapentaenoic acid (EPA) (hazard ratio [HR]: 0.55; 95% confidence interval [CI]: 0.41 to 0.74) and a nonsignificant lower rate for docosahexaenoic acid (HR: 0.79; 95% CI: 0.59 to 1.06). We observed a lower rate of PAD, when comparing the highest quintile of the combined EPA and docosahexaenoic acid with the reference (HR: 0.71; 95% CI: 0.53 to 0.96). In contrast, docosapentaenoic acid had an HR of 1.31 (95% CI: 0.97 to 1.77) in the highest quintile. CONCLUSIONS: A high content of marine n-3 PUFAs in adipose tissue, in particular EPA, was associated with a lower risk of incident PAD.","author_count":6,"contributors":["Lasota, Anne N","Grønholdt, Marie-Louise","Bork, Christian Sørensen","Lundbye-Christensen, Søren","Overvad, Kim","Schmidt, Erik Berg"],"cuid":["S02-100.00-010061"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["ADULTS","Adipose tissue","Biomarkers","Blood","Case cohort study","Docosahexaenoic acid","Eicosapentaenoic acid","Exposure","Health","MEN","Omega 3 fatty acids","Women","marine n 3 polyunsaturated fatty acids"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"marine n 000000000003 fatty acids and the risk of peripheral arterial disease","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85053472777&partnerID=8YFLogxK","version":"Other Version"},"id":"S02-100.00-010061","identifier":[{"id":"85053472777","type":"scopus"},{"id":"000445524000003","type":"wos"},{"id":"30261957","type":"pmid"}],"ids":["aau-d20b0d61-98c7-464c-adbd-670fe8b07a52","au-7984fd53-624a-4927-a8e8-4ac08a515905"],"keyword":["ADULTS","BIOMARKERS","BLOOD","EXPOSURE","HEALTH","MEN","OMEGA-3-FATTY-ACIDS","WOMEN","adipose tissue","case-cohort study","docosahexaenoic acid","eicosapentaenoic acid","marine n-3 polyunsaturated fatty acids"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-1516F9A75BE8DC09AA172E059497A7D0"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Vascular Surgery","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Anæstesi, Børn, Kredsløb og Kvinder","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Anne N","key":"lasotapau","last":"Lasota","locid":"bc00a0f0-eaac-44f2-bd2d-148ad7da49a5","name":"Lasota, Anne N","orcid":"0000-0001-6489-3213","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Marie-Louise M","key":"grønholdtpau","last":"Grønholdt","locid":"a1169867-75a1-47b4-aa1c-aea1b408226d","name":"Grønholdt, Marie-Louise","name_org":"Grønholdt, Marie-Louise M","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Christian S","key":"borkpau","last":"Bork","locid":"9a5f5510-7213-4e16-88c2-74a3af7aa2d9","name":"Bork, Christian Sørensen","name_org":"Bork, Christian S","orcid":"0000-0001-5233-2902","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren","key":"lundbyechristensenpau","last":"Lundbye-Christensen","locid":"d2639b0b-0785-456c-8c8d-57e9e79e0569","name":"Lundbye-Christensen, Søren","orcid":"0000-0002-9420-2783","rank":4,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Kim","key":"overvadpau","last":"Overvad","locid":"7ca4bfca-d3a3-484e-8ee5-d7cb6ad7314b","name":"Overvad, Kim","orcid":"0000-0001-6429-7921","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Erik B","key":"schmidtpau","last":"Schmidt","locid":"3eff6ccc-90b4-48ee-b121-8df4865f0342","name":"Schmidt, Erik Berg","name_org":"Schmidt, Erik B","orcid":"0000-0002-0623-5666","rank":6,"rolecode":"pau"}],"pmid":["30261957"],"pub":{"doi":"10.1016/j.jacc.2018.07.045","issn":["07351097","15583597"],"issn_org":["07351097"],"issue":"14","journal":"Journal of the American College of Cardiology","pages":"1576-1584","publisher":"Elsevier Inc.","status":"p","title":"Journal of the American College of Cardiology","volume":"72"},"review":"Peer Reviewed","scoID":["2-s2.0-85053472777"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-d20b0d61-98c7-464c-adbd-670fe8b07a52","au-7984fd53-624a-4927-a8e8-4ac08a515905"],"src":["AAU Aalborg University","AU Aarhus University"],"title":"Marine n-3 Fatty Acids and the Risk of Peripheral Arterial Disease","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-010061","year":"2018","yearsub":"2018"}
{"abstract":"Correct classification of death causes is an important component of transplant trials.We aimed to develop and validate a system to classify causes of death in hematopoietic stem cell (HSCT) and solid organ (SOT) transplant recipients.Case record forms (CRF) of fatal cases were completed, including investigator-designated cause of death. Deaths occurring in 2010 to 2013 were used for derivation; and were validated by deaths occurring in 2013 to 2015. Underlying cause of death (referred to as recorded underlying cause) was determined through a central adjudication process involving 2 external reviewers, and subsequently compared with the Danish National Death Cause Registry.Three hundred eighty-eight recipients died 2010 to 2015 (196 [51%] SOT and 192 [49%] HSCT). The main recorded underlying causes of death among SOT and HSCT were classified as cancer (20%, 48%), graft rejection/failure/graft-versus-host-disease (35%, 28%), and infections (20%, 11%). Kappa between the investigator-designated and the recorded underlying cause of death was 0.74 (95% CI 0.69-0.80) in derivation and comparable in the validation cohort. Death causes were concordant with the Danish National Death Cause Registry in 37.2% (95% CI 31.5-42.9) and 38.4% (95% CI 28.8-48.0) in the derivation and validation cohorts, respectively.We developed and validated a method to systematically and reliably classify the underlying cause of death among transplant recipients. There was a high degree of discordance between this classification and that in the Danish National Death Cause Registry.","author_count":26,"contributors":["Wareham, Neval Ete","Da Cunha-Bang, Caspar","Borges, Álvaro H.","Ekenberg, Christina","Gerstoft, Jan","Gustafsson, Finn","Hansen, Ditte","Heilmann, Carsten","Helleberg, Marie","Hillingsø, Jens","Krohn, Paul Suno","Lodding, Isabelle Paula","Lund, Thomas Kromann","Lundgren, Louise","Mocroft, Amanda","Perch, Michael","Petersen, Søren Lykke","Petruskevicius, Irma","Rasmussen, Allan","Rossing, Kasper","Rostved, Andreas A.","Sengeløv, Henrik","Sørensen, Vibeke Rømming","Sørensen, Søren Schwartz","Lundgren, Jens D."],"cuid":["S02-100.00-030339"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","Europe, Non-EU","OECD","Oceania"],"country":["Australia","Netherlands","United Kingdom"],"glorg":["All Global Affiliations","Erasmus University Rotterdam","Royal Prince Alfred Hospital","University College London"],"keyword":["Adult","Aged","Cancer","Cause of Death","Denmark","Female","Humans","Infection","Male","Methodology","Middle Aged","Registries","Transplant Recipients statistics numerical data"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"classification of death causes after transplantation class evaluation of methodology and initial results","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1097/MD.0000000000011564","version":"Published Version"},"id":"S02-100.00-030339","identifier":[{"id":"30024557","type":"pmid"},{"id":"85050694154","type":"scopus"},{"id":"PMC6086480","type":"pmcid"}],"ids":["au-f4e16a37-29f9-44d8-8fc2-a7e6dae18f37","ku-a555228f-e452-497b-9336-6332e377589b"],"keyword":["Adult","Aged","Cancer","Cause of Death","Denmark","Female","Humans","Infection","Male","Methodology","Middle Aged","Registries","Transplant Recipients/statistics & numerical data","Transplantation death causes classification","Transplantation/mortality"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-A6CE570F34BAD137D