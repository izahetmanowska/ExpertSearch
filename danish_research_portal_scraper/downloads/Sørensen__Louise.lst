eous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Louise Ejgod","key":"hansenpau","last":"Hansen","locid":"a2ffe90e-58e0-4efe-974c-5e84e0ac697d","name":"Hansen, Louise Ejgod","orcid":"0000-0002-3476-4717","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Tine","key":"eibyepau","last":"Eibye","name":"Eibye, Tine","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Louise Ejgod","key":"hansenped","last":"Hansen","locid":"a2ffe90e-58e0-4efe-974c-5e84e0ac697d","name":"Hansen, Louise Ejgod","orcid":"0000-0002-3476-4717","rank":3,"role":"Editor","rolecode":"ped"},{"affno":"2","corresponding":null,"first":"Pernille","key":"welentsørensenpau","last":"Welent Sørensen","name":"Welent Sørensen, Pernille","rank":4,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Undetermined","search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-344884da-8618-4c3d-93f9-49d4d9b21415"],"src":["AU Aarhus University"],"title":"Teateroplevelser : at skabe samtalerum med børn og unge","type":"Other-Unknown","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-159224","year":"2011","yearsub":"2011"}
{"abstract":"Using stochastic simulation, the effect of using sexed semen to cow dams (CD) in a dairy cattle breeding scheme, with or without use of multiple ovulation and embryo transfer (MOET) to bull dams (BD), on annual genetic gain at the population level was examined. Three levels of sexed semen were combined with three levels of MOET: no sexed semen, sexed semen to the best CD and sexed semen to all heifers, combined with no MOET, MOET on all BD and MOET randomly on 20% of the BD. In total, nine scenarios were compared. The simulated population was monitored for 30 years and included 450 herds with 100 cows each. Each year 50 young bulls (YB), 10 active sires and 215 BD were selected on best linear unbiased prediction estimated breeding values by truncation selection across the simulated population, and the YB were tested within the population. Use of sexed semen alone gave a positive increase in the annual genetic gain of 2.1% when used on the best CD and 2.7% when used on all heifers, but only the latter was statistically significant. The increased annual genetic gain was caused by a larger contribution from the CD to the BD. Use of sexed semen together with MOET on BD increased the annual genetic gain by 1.8–2.5% compared with schemes without sexed semen and MOET on all BD. Performing MOET on all BD enables selection of offspring with high Mendelian deviations, which increase the annual genetic gain. Use of sexed semen decreased the genetic lag between the sires and the CD by 12–14% when used on the best CD and by 6% when used to all heifers. The decrease in the genetic lag is caused by the increased selection intensity of the cow dams","author_count":5,"contributors":["Kargo, Morten","Andersen, Jakob Voergaard","Pedersen, Louise Dybdahl","Berg, Peer","Sørensen, Anders Christian"],"cuid":["S01-000.00-238602"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Dairy cattle","Sexed semen","Stochastic simulation"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"genetic gain in dairy cattle populations is increased using sexed semen in commercial herds","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1111/j.1439-0388.2011.00924.x","version":"Other Version"},"id":"S01-000.00-238602","identifier":[{"id":"79960333800","type":"scopus"},{"id":"21749473","type":"pmid"}],"ids":["au-bf84c069-290f-44da-8883-bb9f9df25e67"],"keyword":["Cow dam selection","dairy cattle","multiple ovulation and embryo transfer","sexed semen","stochastic simulation"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-7B4182DFB9DD632024E5201574272BC3"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1111/j.1439-0388.2011.00924.x","version":"Other Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus University, Faculty of Agricultural Sciences, Quantitative Genetics and Bioinformatics","Aarhus University, Technical Sciences, Center for Quantitative Genetics and Genomics"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Morten Kargo","key":"kargomortenpau","last":"Sørensen","locid":"a3522626-c405-4303-9d68-3e5f12599c31","name":"Kargo, Morten","name_org":"Sørensen, Morten Kargo","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jakob Voergaard","key":"andersenjakobvoergaardpau","last":"Andersen","locid":"154ca5a5-08b0-4c2b-9f2b-e3a3aee4d7b7","name":"Andersen, Jakob Voergaard","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Louise Dybdahl","key":"pedersenlouisedybdahlpau","last":"Pedersen","locid":"7db30fdf-b447-49bb-85b5-f47736335e01","name":"Pedersen, Louise Dybdahl","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Peer","key":"bergpeerpau","last":"Berg","locid":"142a296b-6be9-4984-8bbb-c6ac4789f017","name":"Berg, Peer","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders Christian","key":"sørensenanderschristianpau","last":"Sørensen","locid":"8afa1bfd-aee7-4e28-bcfd-25ddabffb8db","name":"Sørensen, Anders Christian","rank":5,"rolecode":"pau"}],"pmid":["21749473"],"pub":{"doi":"10.1111/j.1439-0388.2011.00924.x","issn":["09312668","14390388"],"issn_org":["09312668"],"issue":"4","journal":"Journal of Animal Breeding and Genetics","pages":"267-275","publisher":"Wiley-Blackwell Publishing Ltd","status":"p","title":"Journal of Animal Breeding and Genetics","volume":"128"},"review":"Peer Reviewed","scoID":["2-s2.0-79960333800"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-bf84c069-290f-44da-8883-bb9f9df25e67"],"src":["AU Aarhus University"],"title":"Genetic gain in dairy cattle populations is increased using sexed semen in commercial herds","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-238602","year":"2011","yearsub":"2011"}
{"abstract":"We examine SAR L1b data from the commissioning phase, currently available for the calibration and validation teams. We use CryoSat-2 data to detect leads in the sea-ice in an area north of Svalbard. Furthermore, we classify the sea-ice from computed freeboard values, and evaluate the coherence between the SAR backscatter and the CryoSat-2 data. The surface elevation is extracted from an 80% threshold retracker and a five parameter - retracker, and this is given with respect to the DTU10 Mean Sea Surface model (MSS). The results are compared with an Envisat ASAR image, and we show that there is a strong correspondence between the freeboard heights and the leads visible in the ASAR image.","author_count":6,"contributors":["Kildegaard Rose, Stine","Stenseng, Lars","Skourup, Henriette","Toudal Pedersen, Leif","Forsberg, René","Sørensen, Louise Sandberg"],"cuid":["S01-000.00-354841"],"event":{"end":"2011-02-03","place":"Francati (Rome), it","start":"2011-02-01","title":"CryoSat Validation Workshop 2011","year":"2011"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-DMI"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-GV-DMI","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"initial results of cryosat 000000000002 data from the arctic","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://www.cryosat2011.org/","version":"Other Version"},"id":"S01-000.00-354841","ids":["dtu-a865527d-6538-4c9f-a9bf-4b1db21ff2dc"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-3AB41612A4D0831F852509171F9231B6"],"oa_link":[{"access":"oa","type":"rem","url":"http://www.cryosat2011.org/","version":"Other Version"}],"org":[{"affno":"1","key":"dtu technical univ