au"},{"affno":"1","corresponding":null,"first":"Tanja","key":"chræmmertanjamortensenpau","last":"Chræmmer","locid":"870ac26a-695b-4c8f-ac1c-7bb48d678789","name":"Chræmmer, Tanja Mortensen","name_org":"Chræmmer, Tanja","orcid":"0000-0002-3797-1834","rank":35,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Teresa Schou","key":"nielsenteresaschoupau","last":"Nielsen","locid":"e3a4174f-7bdc-477c-89e1-3946bd0aebfe","name":"Nielsen, Teresa Schou","rank":36,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ulla Hauge","key":"thostrupullahaugepau","last":"Thostrup","locid":"7283b5c7-6c85-419c-a7ad-c33192368f78","name":"Thostrup, Ulla Hauge","rank":37,"rolecode":"pau"}],"pub":{"pages":"88","place":"UCN","status":"p"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All University Colleges","DI-ALL","DI-UC","DI-UC-ALL","University College of Northern Denmark","University Colleges"],"PST":["Published"]},"sid":["ucn-6917b95a-0304-4bdd-ae52-aabc35dccfd9"],"src":["UCN University College of Northern Denmark"],"title":"Co-bog : Uddannelsernes egne eksempler på hvordan co-creation-aktiviteter indgår i praksis","type":"Book","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-651156","year":"2019","yearsub":"2019"}
{"abstract":"Background: The new generation thinner-strut silicon carbide (SiC) coated cobalt chromium (CoCr) bare-metal stents (BMS) are designed to accelerate rapid endothelialisation and reduce thrombogenicity when implanted in coronary arteries. However, smaller studies suggest higher rates of symptomatic restenosis in patients receiving the newer generation BMS. We investigated the efficacy of a newer generation ultrathin strut silicon-carbide coated cobalt-chromium (CoCr) BMS (SCC-BMS) as compared to an older thin-strut uncoated CoCr BMS (UC-BMS) in patients presenting with coronary artery disease requiring stenting of large vessels (≥3.0 mm). Methods: All patients randomized to SCC- (n = 761) or UC-BMS (n = 765) in the two BASKET-PROVE trials were included. Design, patients, interventions and follow-up were similar between trials except differing regimens of dual antiplatelet therapy. The primary endpoint was clinically driven target-vessel revascularization within 24 months. Safety endpoints of cardiac death, non-fatal myocardial infarction (MI), and definite/probable stent thrombosis (ST) were also assessed. We used inverse probability weighted proportional hazards Cox regressions adjusting for known confounders. Results: Demographics, clinical presentation, and risk factors were comparable between the groups, but patients receiving SCC-BMS underwent less complex procedures. The risk for clinically driven TVR was increased om the SCC-BMS group compared to the UC-BMS group (cumulative incidence, 10.6% vs. 8.4%; adjusted relative hazard [HR], 1.49 [95% CI, 1.05-2.10]). No differences in safety endpoints were detected, cardiac death (1.6% vs. 2.8%; HR, 0.62 [CI, 0.30-1.27]), non-fatal MI (3.2% vs. 2.5%; HR, 1.56 [CI, 0.83-2.91]), and definite/probable ST (0.8% vs. 1.1%; HR, 1.17 [CI, 0.39-3.50]). Differences in strut thickness between the two stents did not explain the association between stent type and clinically driven TVR. Conclusions: In patients requiring stenting of large coronary arteries, use of the newer generation SCC-BMS was associated with a higher risk of clinically driven repeat revascularization compared to the UC-BMS with no signs of an offsetting safety benefit.","author_count":8,"contributors":["Hansen, Kim Wadt","Jeger, Raban","Sørensen, Rikke","Kaiser, Christoph","Pfisterer, Matthias","Biering-Sørensen, Tor","Bjerking, Louise Hougesen","Galatius, Søren"],"cuid":["S01-000.00-759612"],"filters":{"added":"2024-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["Switzerland"],"glorg":["All Global Affiliations","University of Basel"],"keyword":["Bare metal stents","Coronary artery disease","Treatment Outcome"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"do ultrathin strut bare metal stents with passive coating improve efficacy in large coronary arteries insights from the randomized multicenter basket prove trials","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s12872-019-1199-8","version":"Published Version"},"id":"S01-000.00-759612","identifier":[{"id":"85073451776","type":"scopus"},{"id":"31619181","type":"pmid"}],"ids":["ku-148eb05c-b388-4ed8-b8f7-c4158a0a1197"],"keyword":["Bare-metal stents","Coronary artery disease","Treatment outcome"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-A3EF57D40DE1D459574829F686553FCB"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s12872-019-1199-8","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/402824909/Do_ultrathin.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Bispebjerg and Frederiksberg"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","country":"ch","key":"university of basel","loc":["Switzerland","Europe, Non-EU","OECD"],"name":"University of Basel","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Kim Wadt","key":"hansenpau","last":"Hansen","name":"Hansen, Kim Wadt","rank":1,"rolecode":"pau"},{"affno":"2","first":"Raban","key":"jegerpau","last":"Jeger","name":"Jeger, Raban","rank":2,"rolecode":"pau"},{"affno":"1","first":"Rikke","key":"sørensenpau","last":"Sørensen","name":"Sørensen, Rikke","rank":3,"rolecode":"pau"},{"affno":"2","first":"Christoph","key":"kaiserpau","last":"Kaiser","name":"Kaiser, Christoph","rank":4,"rolecode":"pau"},{"affno":"2","first":"Matthias","key":"pfistererpau","last":"Pfisterer","name":"Pfisterer, Matthias","rank":5,"rolecode":"pau"},{"affno":"1","first":"Tor","key":"bieringsørensenpau","last":"Biering-Sørensen","name":"Biering-Sørensen, Tor","rank":6,"rolecode":"pau"},{"affno":"1 3","first":"Louise Hougesen","key":"bjerkingpau","last":"Bjerking","locid":"7f21bcb3-5733-48e1-8e25-eefca60f9ecf","name":"Bjerking, Louise Hougesen","rank":7,"rolecode":"pau"},{"affno":"1","first":"Søren","key":"galatiuspau","last":"Galatius","name":"Galatius, Søren","rank":8,"rolecode":"pau"}],"pmid":["31619181"],"pub":{"doi":"10.1186/s12872-019-1199-8","issn":["14712261"],"issue":"1","journal":"BMC Cardiovascular Disorders","paperid":"226","status":"p","title":"BMC Cardiovascular Disorders","volume":"19"},"review":"Peer Reviewed","scoID":["2-s2.0-85073451776"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-148eb05c-b388-4ed8-b8f7-c4158a0a1197"],"src":["KU University of Copenhagen"],"title":"Do ultrathin strut bare-metal stents with passive coating improve efficacy in large coronary arteries? Insights from the randomized, multicenter BASKET-PROVE trials","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-759612","year":"2019","yearsub":"2019"}
{"abstract":"Polycystic ovary syndrome (PCOS) remains one of the most common endocrine disorder in premenopausal women with an unfavorable metabolic risk profile. Here, we investigate whether biochemical hyperandrogenism, represented by elevated serum free testosterone, resulted in an aberrant circulating microRNA (miRNAs) expression profile and whether miRNAs can identify those PCOS women with metabolic syndrome (MetS). Accordingly, we measured serum levels of miRNAs as well as biochemical markers related to MetS in a case-control study of 42 PCOS patients and 20 Controls. Patients were diagnosed based on the Rotterdam consensus criteria and stratified based on serum free testosterone levels (≥0.034 nmol/l) into either a normoandrogenic (n = 23) or hyperandrogenic (n = 19) PCOS group. Overall, hyperandrogenic PCOS women were more insulin resistant compared to normoandrogenic PCOS women and had a higher prevalence of MetS. A total of 750 different miRNAs were analyzed using TaqMan Low-Density Arrays. Altered levels of seven miRNAs (miR-485-3p, -1290, -21-3p, -139-3p, -361-5p, -572, and -143-3p) were observed in PCOS patients when compared with healthy Controls. Stratification of PCOS women revealed that 20 miRNAs were differentially expressed between the three groups. Elevated serum free testosterone levels, adjusted for age and BMI, were significantly associated with five miRNAs (miR-1290, -20a-5p, -139-3p, -433-3p, and -361-5p). Using binary logistic regression and receiver operating characteristic curves (ROC), a combination panel of three miRNAs (miR-361-5p, -1225-3p, and -34-3p) could correctly identify all of the MetS cases within the PCOS group. This study is the first to report comprehensive miRNA profiling in different subgroups of PCOS women with respect to MetS and suggests that circulating miRNAs might be useful as diagnostic biomarkers of MetS for a different subset of PCOS.","author_count":14,"contributors":["Sørensen, Anja E.","Udesen, Pernille B.","Maciag, Grzegorz","Geiger, Julian","Saliani, Negar","Januszewski, Andrzej S.","Jiang, Guozhi","Ma, Ronald C.","Hardikar, Anandwardhan A.","Wissing, Marie Louise M.","Englund, A. L.M.","Dalgaard, Louise T."],"cuid":["S02-096.86-043810"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["Asia, East","OECD","Oceania"],"country":["Australia","Hong Kong"],"glorg":["All Global Affiliations","The Chinese University of Hong Kong","University of Sydney"],"keyword":["Hyperandrogenism","Metabolic syndrome","Polycystic Ovary Syndrome","TaqMan low density arrays","microRNA","serum free testosterone"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-SDR","DI-HO-ZEA"],"U":["DI-U-ALL","DI-U-KU","DI-U-RUC"]},"level3all":["DI-HO-SDR","DI-HO-ZEA","DI-U-KU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"hyperandrogenism and metabolic syndrome are associated with changes in serum derived micrornas in women with polycystic ovary syndrome","src":["ku","ruc"],"src-code":["DI-U-KU","DI-U-RUC"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/fmed.2019.00242","version":"Published Version"},"id":"S02-096.86-043810","identifier":[{"id":"85075382271","type":"scopus"},{"id":"31737638","type":"pmid"},{"id":"PMC6839444","type":"pmcid"}],"ids":["ku-7e207ca5-ed3b-46ec-b2a1-196b5531ad5f","ruc-09610f06-11c9-4020-8263-30fa03f5fdc6"],"keyword":["TaqMan low density arrays","hyperandrogenism","metabolic syndrome","microRNA","polycystic ovary syndrome","serum free testosterone"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-4C56A2FD7FD996CF61C1CBD8DC280CFA"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/66484246/fmed_06_0