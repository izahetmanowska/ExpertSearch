21,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mads","key":"rasmussenmadspau","last":"Rasmussen","locid":"10307123-564d-4db1-872d-d0a91168ce4e","name":"Rasmussen, Mads","orcid":"0000-0002-0416-6767","rank":22,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Winnie","key":"bechmanneriksenwinniepau","last":"Bechmann Eriksen","name":"Bechmann Eriksen, Winnie","rank":23,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Birgitte","key":"barrutiabirgittepau","last":"Barrutia","name":"Barrutia, Birgitte","rank":24,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Mette","key":"kromannmettepau","last":"Kromann","name":"Kromann, Mette","rank":25,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Ida","key":"baandrupidapau","last":"Baandrup","name":"Baandrup, Ida","rank":26,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jette","key":"bjørnjettepau","last":"Bjørn","name":"Bjørn, Jette","rank":27,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Rie","key":"stjernholmriepau","last":"Stjernholm","name":"Stjernholm, Rie","rank":28,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Charlotte","key":"braemermadsencharlottepau","last":"Braemer-Madsen","name":"Braemer-Madsen, Charlotte","rank":29,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Signe Mygdal","key":"jørgensensignemygdalpau","last":"Jørgensen","name":"Jørgensen, Signe Mygdal","rank":30,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens Christian Hedemann","key":"sørensenjenschristianhedemannpau","last":"Sørensen","locid":"f442e934-3b4d-4fc2-91dc-93621be94d60","name":"Sørensen, Jens Christian Hedemann","orcid":"0000-0001-5139-7405","rank":31,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Andreas","key":"gludandreasnørgaardpau","last":"Glud","locid":"7c293aba-b85e-4919-ac45-c7fe82208804","name":"Glud, Andreas Nørgaard","name_org":"Glud, Andreas","orcid":"0000-0003-3339-6120","rank":32,"rolecode":"pau"}],"pmid":["39968962"],"pub":{"doi":"10.1002/mdc3.70012","issn":["23301619"],"issue":"7","journal":"Movement Disorders Clinical Practice","pages":"922-927","publisher":"John Wiley and Sons Ltd","status":"p","title":"Movement Disorders Clinical Practice","volume":"12"},"review":"Peer Reviewed","scoID":["2-s2.0-85219730605"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities"],"PST":["Published"]},"sid":["au-19a903ea-c367-4c6e-9176-d59a0891bc86"],"src":["AU Aarhus University"],"title":"Magnetic Resonance–Guided Focused Ultrasound Treatment for Essential Tremor : A Single-Center Experience","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-795698","year":"2025","yearsub":"2025"}
{"abstract":"The WOUND-Q is a patient-reported outcome measure for individuals with any type of chronic wound. This study aimed to identify patient and wound factors associated with the four WOUND-Q health-related quality of life (HRQL) scales: Life impact, Psychological, Sleep, and Social. Adults with a chronic wound were recruited internationally through clinical settings between August 2018 and May 2020, and through an online platform (i.e. Prolific) in September 2022. Multivariable linear regression analyses were conducted to identify factors significantly associated with the WOUND-Q scales. The assessments obtained were 1273, 1275, 706, and 1256 for the Life Impact, Psychological, Sleep, and Social scales, respectively. The mean age of participants was 55 (SD = 18) years; most (66%) had a single wound, and most (56%) wounds had lasted more than 6 months. The most common causes were trauma, surgery, and diabetic foot ulcer. Wound characteristics associated with worse scores on at least one of the scales were drainage, vacuum treatment, aetiologies (i.e. diabetic foot ulcer, trauma, other, multiple), duration (i.e. 10–11 months), having four or more wounds, smell, and sleep interference, while wound location different from the face or neck was associated with better scores (p < 0.05). Patient factors associated with worse scores included having diabetes or a comorbidity, whereas increasing age or male gender were associated with better scores (p < 0.05). Sleep disturbances had the largest negative influence on HRQL scores. This study identified factors affecting HRQL in individuals with chronic wounds. Understanding these associations can inform better management and treatment strategies to improve HRQL for these patients.","author_count":7,"contributors":["Simonsen, Nina Vestergaard","Möller, Sören","Rae, Charlene","Klassen, Anne F.","Poulsen, Lotte","Pusic, Andrea Louise","Sørensen, Jens Ahm"],"cuid":["S01-000.00-802977"],"filters":{"added":"2025-04","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","OECD"],"corresponding_author":["Simonsen, Nina Vestergaard"],"country":["Canada","United States"],"glorg":["All Global Affiliations","Brigham and Women's Hospital","McMaster University"],"keyword":["Chronic wounds","PROM","Patient reported outcomes","Predictors","Quality of Life","Regression"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"patient and wound factors associated with wound q scales measuring health related quality of life an international cross sectional study","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1111/wrr.13245","version":"Published Version"},"id":"S01-000.00-802977","identifier":[{"id":"39764580","type":"pmid"},{"id":"85214408578","type":"scopus"},{"id":"PMC11704996","type":"pmcid"}],"ids":["sdu-d9a8ecf6-d806-4aca-956b-0ece9fc70daa"],"keyword":["PROM","chronic wounds","patient-reported outcomes","predictors","quality of life","regression"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-D5C717F36B8A83B03F275FDAFABF479A"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1111/wrr.13245","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/282062290/Wound_Repair_Regeneration_-_2025_-_Simonsen_-_Patient_and_wound_factors_associated_with_WOUND_Q_scales_measuring.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Plastic Surgery (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"ca","key":"mcmaster university","loc":["Canada","America, North","OECD"],"name":"McMaster University","used":1},{"affno":"3","country":"us","key":"brigham and women s hospital","loc":["United States","America, North","OECD"],"name":"Brigham and Women's Hospital","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Nina Vestergaard","key":"simonsenpau","last":"Simonsen","locid":"34723cbe-bd5e-42c2-b8ae-5753c67099d1","name":"Simonsen, Nina Vestergaard","orcid":"0000-0001-6006-9753","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sören","key":"möllerpau","last":"Möller","locid":"905018dc-c6c4-4a79-b50d-d0c08618e77a","name":"Möller, Sören","orcid":"0000-0003-0858-4269","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Charlene","key":"raepau","last":"Rae","name":"Rae, Charlene","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Anne F.","key":"klassenpau","last":"Klassen","name":"Klassen, Anne F.","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lotte","key":"poulsenpau","last":"Poulsen","locid":"50183c95-07ae-4fc6-9434-83888b3b60a3","name":"Poulsen, Lotte","orcid":"0000-0003-4205-806X","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Andrea Louise","key":"pusicpau","last":"Pusic","name":"Pusic, Andrea Louise","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jens Ahm","key":"sørensenpau","last":"Sørensen","locid":"267cd59a-3918-47db-8d23-54015d770b6c","name":"Sørensen, Jens Ahm","orcid":"0000-0003-4903-0094","rank":7,"rolecode":"pau"}],"pmid":["39764580"],"pub":{"doi":"10.1111/wrr.13245","issn":["10671927","1524475X"],"issn_org":["10671927"],"issue":"1","journal":"Wound Repair and Regeneration","paperid":"e13245","publisher":"Wiley","status":"p","title":"Wound Repair and Regeneration","title_org":"Wound repair and regeneration","volume":"33"},"review":"Peer Reviewed","scoID":["2-s2.0-85214408578"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-d9a8ecf6-d806-4aca-956b-0ece9fc70daa"],"src":["SDU University of Southern Denmark"],"title":"Patient and wound factors associated with WOUND-Q scales measuring health-related quality of life : An international cross-sectional study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-802977","year":"2025","yearsub":"2025"}
{"abstract":"Global supply chains account for 80% of international trade but pose significant human rights and environmental risks. The EU Corporate Sustainability Due Diligence Directive and similar regulations impose new compliance requirements, challenging companies to integrate sustainability, due diligence, and supplier relationship management. This paper reviews the challenges of com-plying with these regulations, including supply chain dilemmas related to regulations, complexity, and transparency. It explores how risk-based and collaborative approaches and leveraging technologies can promote effective sustainability due diligence in global supply chains. This study contributes to understanding how large firms can navigate evolving supply chain regulations to ensure com-pliant, sustainable practices by addressing challenges and mitigating strategies.","author_count":5,"contributors":["Sørensen, Lasse Snogdal","Klampe, Magnus Sommer","Andersen, Rasmus","Andersen, Ann-Louise","Wæhrens, Brian Vejrum"],"cuid":["S01-000.00-814519"],"event":{"end":"2025-09-12","place":"Siegen, de","start":"2025-09-09","title":"CARV/MCPC 2025 - 10 th Changeable, Agile, Reconfigurable<br/>and Virtual Production Conference co-located with the 12th World Mass Customization and Personalization Conference","year":"2025"},"filters":{"added":"2025-08","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["CSDDD","Due diligence","Literature review","Supply chain management","Sustainability"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"a review of challenges and strategies towards integrating sustainability and due diligence in the buyer supplier relationship","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/785420731/Sorensen_et_al._2025_Supply_chain_due_diligence_-_V7.pdf","version":"Authors Final Version"},"id":"S01-000.00-814519","ids":["aau-67616fdd-f184-4949-b53b-b618ecc642a9"],"keyword":["CSDDD","Due diligence","Literature review","Supply Chain Management","Sustainability"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-3C09660041D5F8B8EE4106A54D984D47"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/785420731/Sorensen_et_al._2025_Supply_chain_due_diligence_-_V7.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","country":"dk","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Lasse Snogdal","key":"sørensenlassesnogdalpau","last":"Sørensen","name":"Sørensen, Lasse Snogdal","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Magnus Sommer","key":"klampemagnussommerpau","last":"Klampe","name":"Klampe, Magnus Sommer","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rasmus","key":"andersenrasmuspau","last":"Andersen","locid":"f58ca152-a726-42a3-8424-415c4fdf5c0a","name":"Andersen, Rasmus","orcid":"0000-0001-6788-8217","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ann-Louise","key":"andersenannlouisepau","last":"Andersen","locid":"73d5c9b6-ff83-41c1-b16e-43f380f384d9","name":"Andersen, Ann-Louise","orcid":"0000-0002-7923-6301","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Brian Vejrum","key":"wæhrensbrianvejrumpau","last":"Wæhrens","locid":"b4ed4be4-3e26-4121-904a-bacd1ef30da1","name":"Wæhrens, Brian Vejrum","orcid":"0000-0001-6140-5587","rank":5,"rolecode":"pau"}],"pub":{"pages":"1","publisher":"Springer","status":"i","title":"Springer Lecture Notes in Mechanical Engineering"},"review":"Peer Reviewed","sdg":["12. Responsible Consumption and Production","8. Decent Work and Economic Growth","9. Industry, Innovation, and Infrastructure","All UN SDG Classification"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["In Press"]},"sid":["aau-67616fdd-f184-4949-b53b-b618ecc642a9"],"src":["AAU Aalborg University"],"title":"A review of challenges and strategies towards integrating sustainability and due diligence in the buyer-supplier relationship","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-814519","year":"2025","yearsub":"2025"}
{"abstract":"Background: Omalizumab is an effective treatment for chronic spontaneous urticaria (CSU), but strategies and predictors for guiding long-term management and discontinuation remain limited. Objectives: To examine real-world treatment patterns, including dosing modifications and discontinuation, and identify potential predictive factors for these outcomes. Methods: This was a retrospective, observational, real-life study of adult patients with CSU treated with omalizumab at a Urticaria Center of Reference and Excellence (UCARE) in Copenhagen, Denmark, between May 20, 2015, and April 4, 2024. The Kaplan-Meier estimator was used to visualize time to discontinuation and dose escalation/reduction (using standard label dosing as reference), and Cox-regressions with hazard ratios (HR) were used to investigate potential predictive variables. Results: Of 430 patients initiated on omalizumab, 139 (32.4%) escalated treatment, 161 (37.5%) reduced treatment, and 90 (21.0%) discontinued treatment directly from the standard dose. The median survival time for dose escalation was 2 years (95% CI: 1.17–3.55), and the strongest predictor was a positive basophil histamine release assay (BHRA) (HR: 2.79, 95% CI: 1.69–4.61). Fast treatment response (HR: 0.50, 95% CI: 0.33–0.75) and higher baseline UCT scores (HR: 0.89, 95% CI: 0.82–0.97) decreased the risk of dose escalation. The median survival time to dose reduction was 1.2 years (95% CI: 0.98–1.49) and was more likely in males (HR: 1.68, 95% CI: 1.13–2.50) and patients with fast treatment response (HR: 1.66, 95% CI: 1.12–2.48). Median survival time to discontinuation (all reasons) of omalizumab was 3 years (95% CI: 2.35–3.64). Conclusions: A considerable proportion of patients with CSU require modifications to the recommended omalizumab dosing regimen. A positive BHRA was the strongest predictor for dose escalation, while male sex and fast treatment response were the strongest predictors for dose reduction. Our study highlights the need for individualized strategies in managing CSU.","author_count":10,"contributors":["Zhang, Ditte Georgina","Nielsen, Mia Louise","Sørensen, Jennifer Astrup","Naassan, Somaia","Vestergaard, Christian","Kocatürk, Emek","Ali, Zarqa","Thyssen, Jacob P.","Egeberg, Alexander","Thomsen, Simon Francis"],"cuid":["S01-000.00-816494"],"filters":{"added":"2025-08","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, Middle East","Europe, EU","OECD"],"corresponding_author":["Zhang, Ditte Georgina"],"country":["Germany","Turkey"],"glorg":["All Global Affiliations","Bahcesehir University","Charité-Universitätsmedizin Berlin","Fraunhofer Institute for Translational Medicine and Pharmacology ITMP"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"omalizumab dosing patterns and drug survival in adult patients with chronic spontaneous urticaria","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/105005231510","version":"Other Version"},"id":"S01-000.00-816494","identifier":[{"id":"40357715","type":"pmid"},{"id":"105005231510","type":"scopus"}],"ids":["au-b76eddd1-e34a-4f59-b702-4bbd925298a0"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-AA676D8BE811B065CA620FFED75AC0B0"],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Bispebjerg og Frederiksberg Universitets Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Department of Dermatology and Venereology"],"nora_code":"DI-U-AU","used":1},{"affno":"3","country":"de","key":"charité universitätsmedizin berlin","loc":["Germany","Europe, EU","OECD"],"name":"Charité-Universitätsmedizin Berlin","used":1},{"affno":"4","country":"de","key":"fraunhofer institute for translational medicine and pharmacology itmp","loc":["Germany","Europe, EU","OECD"],"name":"Fraunhofer Institute for Translational Medicine and Pharmacology ITMP","used":1},{"affno":"5","country":"tr","key":"bahcesehir university","loc":["Turkey","Asia, Middle East","OECD"],"name":"Bahcesehir University","used":1},{"affno":"6","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Ditte Georgina","key":"zhangpau","last":"Zhang","name":"Zhang, Ditte Georgina","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mia Louise","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Mia Louise","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jennifer Astrup","key":"sørensenpau","last":"Sørensen","name":"Sørensen, Jennifer Astrup","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Somaia","key":"naassanpau","last":"Naassan","name":"Naassan, Somaia","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Christian","key":"vestergaardpau","last":"Vestergaard","locid":"1e1f8aeb-17cb-488a-8a3d-2d377ffa668e","name":"Vestergaard, Christian","orcid":"0000-0001-6485-3158","rank":5,"rolecode":"pau"},{"affno":"3 4 5","corresponding":null,"first":"Emek","key":"kocatürkpau","last":"Kocatürk","name":"Kocatürk, Emek","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Zarqa","key":"alipau","last":"Ali","name":"Ali, Zarqa","rank":7,"rolecode":"pau"},{"affno":"1 6","corresponding":null,"first":"Jacob P.","key":"thyssenpau","last":"Thyssen","name":"Thyssen, Jacob P.","rank":8,"rolecode":"pau"},{"affno":"1 6","corresponding":null,"first":"Alexander","key":"egebergpau","last":"Egeberg","name":"Egeberg, Alexander","rank":9,"rolecode":"pau"},{"affno":"1 6","corresponding":null,"first":"Simon Francis","key":"thomsenpau","last":"Thomsen","name":"Thomsen, Simon Francis","rank":10,"rolecode":"pau"}],"pmid":["40357715"],"pub":{"doi":"10.1111/jdv.20737","issn":["09269959","14683083"],"issn_org":["09269959"],"journal":"Journal of the European Academy of Dermatology and Venereology","publisher":"John Wiley & Sons Inc.","status":"e","title":"Journal of the European Academy of Dermatology and Venereology"},"review":"Peer Reviewed","scoID":["2-s2.0-105005231510"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["E-Published (ahead of print)"]},"sid":["au-b76eddd1-e34a-4f59-b702-4bbd925298a0"],"src":["AU Aarhus University"],"title":"Omalizumab dosing patterns and drug survival in adult patients with chronic spontaneous urticaria","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-816494","year":"2025","yearsub":"2025"}
{"abstract":"Objectives: Non-cystic fibrosis bronchiectasis (BE) is a chronic airway disease with increasing prevalence, reduced quality of life, and increased mortality. Inhaled corticosteroids (ICS) are used in BE despite limited evidence of effect on lung function parameters. ICS may increase the risk of Staphylococcus aureus (S. aureus) infections in patients with BE, but this is unexplored. We examined the association between ICS use prior to BE diagnosis at different doses and the risk of S. aureus isolation in patients with BE. Methods: We conducted a national register-based cohort study including Danish patients with a BE diagnosis code between 2001 and 2018 with a 1-year follow-up time from the date of diagnosis. ICS exposure was categorized based on accumulated prescriptions redeemed 365 days before BE diagnosis and divided into none, low, moderate, or high use based on clinically relevant doses. A cause-specific Cox proportional hazards regression model was used to estimate the risk of S. aureus isolation. A sensitivity analysis, an inverse probability of treatment weighted model (IPTW), was performed. Results: A total of 5093 patients were included in this study. S. aureus was isolated in 156 patients (3.1%). High-dose ICS was associated with an increased risk of S. aureus isolation, HR 3.81 (95% CI 2.51; 5.79). No association for low or moderate use was found, low-dose HR 1.22 (95% CI 0.77; 1.93), and moderate-dose HR 1.24 (95% CI 0.72; 2.16). IPTW analysis yielded similar results. Conclusions: High-dose ICS use in patients with BE was associated with an increased risk of S. aureus isolation. ICS should be used cautiously in patients with BE.","author_count":13,"contributors":["Filipsen, Andrea Arlund","Frost, Karen Hougaard","Eklöf, Josefin","Tønnesen, Louise Lindhardt","Vognsen, Anna Kubel","Boel, Jonas Bredtoft","Pinholt, Mette","Andersen, Christian Østergaard","Dessau, Ram Benny Christian","Biering-Sørensen, Tor","Johansson, Sofie Lock","Jensen, Jens Ulrik Stæhr","Sivapalan, Pradeesh"],"cuid":["S01-000.00-828242"],"filters":{"added":"2025-10","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Bronchiectasis","Cohort study","Cox regression","IPTW","Infection","Inhaled corticosteroids","Non cystic fibrosis bronchiectasis","S aureus","Staphylococcus aureus"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-OT","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-ZEA"],"OT":["Steno Diabetes Centre, Gentofte, Denmark."],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-HO-ZEA","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"inhaled corticosteroids and risk of staphylococcus aureus isolation in bronchiectasis a register based cohort study","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/jcm14155207","version":"Published Version"},"id":"S01-000.00-828242","identifier":[{"id":"PMC12347263","type":"pmcid"},{"id":"105013574589","type":"scopus"},{"id":"40806828","type":"pmid"}],"ids":["ku-010b4bdd-6216-4dfd-bc0d-50959db7fa0c"],"keyword":["ICS use","IPTW","S. aureus","Staphylococcus aureus","bronchiectasis","cohort study","cox regression","infection","inhaled corticosteroids","non-cystic fibrosis bronchiectasis"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-F6C600C2C6BAC32E28B1C421DA63EF9F"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/jcm14155207","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/463574070/Inhaled_Corticosteroids.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CA