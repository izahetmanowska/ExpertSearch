f21bcb3-5733-48e1-8e25-eefca60f9ecf","name":"Bjerking, Louise Hougesen","rank":1,"rolecode":"pau"},{"affno":"","first":"Kim Wadt","key":"hansenpau","last":"Hansen","name":"Hansen, Kim Wadt","rank":2,"rolecode":"pau"},{"affno":"1","first":"Tor","key":"bieringsørensenpau","last":"Biering-Sørensen","locid":"2a25298f-30d3-4b37-b20b-646684a29fd8","name":"Biering-Sørensen, Tor","rank":3,"rolecode":"pau"},{"affno":"2","first":"Jens","key":"brønnumschoupau","last":"Brønnum-Schou","name":"Brønnum-Schou, Jens","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Henrik","key":"engblompau","last":"Engblom","name":"Engblom, Henrik","rank":5,"rolecode":"pau"},{"affno":"4 3","first":"David","key":"erlingepau","last":"Erlinge","name":"Erlinge, David","rank":6,"rolecode":"pau"},{"affno":"","first":"Sune Ammentorp","key":"haahrpedersenpau","last":"Haahr-Pedersen","name":"Haahr-Pedersen, Sune Ammentorp","rank":7,"rolecode":"pau"},{"affno":"1","first":"Merete","key":"heitmannpau","last":"Heitmann","locid":"21d1def5-7b46-4f84-89e9-e9e39bd20c11","name":"Heitmann, Merete","rank":8,"rolecode":"pau"},{"affno":"1","first":"Jens Dahlgaard","key":"hovepau","last":"Hove","locid":"4ecfb416-ea53-418e-a6c3-ace7647318ea","name":"Hove, Jens Dahlgaard","orcid":"0000-0002-5600-5623","rank":9,"rolecode":"pau"},{"affno":"2","first":"Magnus Thorsten","key":"jensenpau","last":"Jensen","name":"Jensen, Magnus Thorsten","rank":10,"rolecode":"pau"},{"affno":"5","corresponding":null,"country":"dk","first":"Marie","key":"krusepau","last":"Kruse","locid":"fac93a9f-2030-4c3a-9775-5e2a319e883d","name":"Kruse, Marie","orcid":"0000-0001-7159-8781","rank":11,"rolecode":"pau"},{"affno":"1","first":"Sune","key":"räderpau","last":"Räder","locid":"6bd2fa06-9229-47fa-8f2f-6a5b0bf6e074","name":"Räder, Sune","rank":12,"rolecode":"pau"},{"affno":"6","first":"Søren","key":"strangepau","last":"Strange","name":"Strange, Søren","rank":13,"rolecode":"pau"},{"affno":"","first":"Søren","key":"galatiuspau","last":"Galatius","name":"Galatius, Søren","rank":14,"rolecode":"pau"},{"affno":"1","first":"Eva Irene Bossano","key":"prescottpau","last":"Prescott","locid":"f6d11fc8-7565-487b-943a-3c67db7e9e75","name":"Prescott, Eva","name_org":"Prescott, Eva Irene Bossano","rank":15,"rolecode":"pau"}],"pmid":["34426466"],"pub":{"doi":"10.1136/bmjopen-2021-049380","issn":["20446055"],"issue":"8","journal":"BMJ Open","paperid":"e049380","publisher":"BMJ Publishing Group","status":"p","title":"BMJ Open","volume":"11"},"review":"Peer Reviewed","scoID":["2-s2.0-85113508763"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-11288d20-d07c-49fa-80b6-c6b1983a9b17","sdu-8fed8ca9-8b01-41b4-aff6-42c279faea77"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Cost-effectiveness of adding a non-invasive acoustic rule-out test in the evaluation of patients with symptoms suggestive of coronary artery disease : Rationale and design of the prospective, randomised, controlled, parallel-group multicenter FILTER-SCAD trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-095.79-040265","year":"2021","yearsub":"2021"}
{"abstract":"BACKGROUND: In patients with active Crohn's disease (CD), treatment of intra-abdominal abscess usually comprises antibiotics and radiologically guided percutaneous drainage (PD) preceding surgery. The aim of this study was to investigate the risk of postoperative complications and identify the optimal time interval for surgical intervention after PD. METHODS: A multicentre, international, retrospective cohort study was carried out. Details of patients with diagnosis of CD who underwent ultrasonography- or CT-guided PD were retrieved from hospital records using international classification of disease (ICD-10) diagnosis code for CD combined with procedure code for PD. Clinical variables were retrieved and the following outcomes were measured: 30-day postoperative overall complications, intra-abdominal septic complications, unplanned intraoperative adverse events, surgical-site infections, sepsis and pathological postoperative ileus, in addition to abscess recurrence. Patients were categorized into three groups according to the length of the interval from PD to surgery (1-14 days, 15-30 days and more than 30 days) for comparison of outcomes. RESULTS: The cohort comprised 335 CD patients with PD followed by surgery. Median age was 33 (i.q.r. 24-44) years, 152 (45.4 per cent) were females, and median disease duration was 9 (i.q.r. 3.6-15) years. Overall, the 30-day postoperative complications rate was 32.2 per cent and the mortality rate was 1.5 per cent. After adjustment for co-variables, older age (odds ratio 1.03 (95 per cent c.i. 1.01 to 1.06), P < 0.012), residual abscess after PD (odds ratio 0.374 (95 per cent c.i. 0.19 to 0.74), P < 0.014), smoking (odds ratio 1.89 (95 per cent c.i. 1.01 to 3.53), P = 0.049) and low serum albumin concentration (odds ratio 0.921 (95 per cent c.i. 0.89 to 0.96), P < 0.001) were associated with higher rates of postoperative complications. A short waiting interval, less than 2 weeks after PD, was associated with a high incidence of abscess recurrence (odds ratio 0.59 (95 per cent c.i. 0.36 to 0.96), P = 0.042). CONCLUSION: Smoking, low serum albumin concentration and older age were significantly associated with postoperative complications. An interval of at least 2 weeks after successful PD correlated with reduced risk of abscess recurrence.","author_count":34,"contributors":["El-Hussuna, Alaa","Merrild Karer, Mette Louise","Nyggard Uldall Nielsen, Natasja","Mujukian, A.","Fleshner, P. R.","Iesalnieks, I.","Horesh, N.","Kopylov, U.","Jacoby, H.","Al-Qaisi, Haider Mahmoud","Colombo, F.","Sampietro, G. M.","Marino, M. V.","Ellebæk, M.","Steenholdt, C.","Sørensen, Nina","Celentano, V.","Ladwa, N.","Warusavitarne, J.","Pellino, G.","Zeb, A.","Di Candido, F.","Hurtado-Pardo, L.","Frasson, M.","Kunovsky, L.","Yalcinkaya, A.","Tatar, O. C.","Alonso, S.","Pera, M.","Granero, A. G.","Rodríguez, C. A.","Minaya, A.","Spinelli, A.","Qvist, N."],"cuid":["S02-100.00-009019"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["America, North","Asia, Middle East","Europe, EU","Europe, Non-EU","OECD"],"corpau":["OpenSourceResearch collaboration"],"corresponding_author":["El-Hussuna, A.","El-Hussuna, Alaa"],"country":["Czechia","Germany","Israel","Italy","Spain","Turkey","United Kingdom","United States"],"glorg":["All Global Affiliations","Cedars-Sinai Comprehensive Cancer Center","Cedars-Sinai Medical Center","Department of Radiation Oncology, University and Polytechnic Hospital La Fe, Valencia, Spain.","Department of Trauma Surgery","Francisco de Vitoria University","Gazi University","Gazi University, Faculty of Medicine","Hospital Universitari Vall d'Hebron, Barcelona, Spain.","Hospital Universitario La Fe","Hospital Universitario Son Espases","Hospital del Mar","Humanitas University","Klinikum Bogenhausen","Kocaeli University","Kocaeli University School of Medicine","London North West University Healthcare NHS T