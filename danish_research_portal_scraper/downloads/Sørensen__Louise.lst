responding":null,"first":"Andrea L.","key":"pusicpau","last":"Pusic","name":"Pusic, Andrea L.","rank":12,"rolecode":"pau"}],"pmid":["34224044"],"pub":{"doi":"10.1245/s10434-021-09887-y","issn":["10689265","15344681"],"issn_org":["10689265"],"issue":"9","journal":"Annals of Surgical Oncology","pages":"5166-5182","publisher":"Springer Science+Business Media","status":"p","title":"Annals of Surgical Oncology","volume":"28"},"review":"Peer Reviewed","scoID":["2-s2.0-85103858628"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-5da28e50-9be9-4ee5-a2e6-295b1baff6df"],"src":["SDU University of Southern Denmark"],"title":"Development and Psychometric Validation of a Patient-Reported Outcome Measure for Arm Lymphedema : The LYMPH-Q Upper Extremity Module","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-600001","year":"2021","yearsub":"2021"}
{"abstract":"A new easy-to-use online bioinformatic tool analyzing whole genome sequences of healthcare associated bacteria was used by a local infection control unit to retrospectively map genetic relationship of isolates of E. faecium carrying resistance genes to vancomycin in a hospital. Three clusters of isolates were detected over a period of 5 years, suggesting transmission between patients. Individual relatedness between isolates within each cluster was established by SNP analyses provided by the system. Genetic antimicrobial resistance mechanisms to antibiotics other than vancomycin were identified. The results suggest that the system is suited for hospital surveillance of E. faecium carrying resistance genes to vancomycin in settings with access to next Generation Sequencing without bioinformatic expertise for interpretation of the genome sequences.","author_count":9,"contributors":["Marbjerg, Lis Høy","Stougaard, Caroline Louise","Sørensen, Sophie Amalie Grønhøj","Thomsen, Amalie Vørs","Wang, Lis","Andersen, Lise","Andersen, Thomas Emil","Kallipolitis, Birgitte H.","Kemp, Michael"],"cuid":["S01-000.00-620773"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Kemp, Michael"],"keyword":["Bioinformatics","Genomic epidemiology","Infection control","Surveillance","Vancomycin Resistant Enterococci","Whole genome sequencing"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"a new tool for analyses of whole genome sequences reveals dissemination of specific strains of vancomycin resistant enterococcus faecium in a hospital","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/fmed.2021.733676","version":"Published Version"},"funding_acknowledgement":["Statens Serum Institut, Copenhagen, Denmark is thanked for sharing genome sequence data."],"id":"S01-000.00-620773","identifier":[{"id":"PMC8578741","type":"pmcid"},{"id":"34778297","type":"pmid"},{"id":"85118776683","type":"scopus"}],"ids":["sdu-a6247039-97f8-4313-9d1e-abc9f7ff9c70"],"keyword":["bioinformatics","genomic epidemiology","infection control","surveillance","vancomycin resistant enterococci","whole genome sequencing"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-115D9D89280E0D76E46E328529B21F52"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/fmed.2021.733676","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/194419617/fmed_08_733676.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Clinical Microbiology (Odense)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Lis","key":"marbjerglishøypau","last":"Marbjerg","locid":"4dc317e6-0aac-4887-90d6-c89a1cf5c035","name":"Marbjerg, Lis Høy","name_org":"Marbjerg, Lis","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Caroline Louise","key":"stougaardcarolinelouisepau","last":"Stougaard","locid":"721a4bdf-7fdb-4804-a5e6-36544e30912b","name":"Stougaard, Caroline Louise","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sophie Amalie Grønhøj","key":"sørensensophieamaliegrønhøjpau","last