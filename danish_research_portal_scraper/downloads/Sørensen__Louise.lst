69e-d9e0797a8aa0","name":"Madsen, Kenneth Lindegaard","orcid":"0000-0001-9274-6691","rank":23,"rolecode":"pau"}],"pmid":["39287978"],"pub":{"doi":"10.1172/jci.insight.170976","issn":["23793708"],"issue":"20","journal":"JCI Insight","paperid":"e170976","status":"p","title":"JCI Insight","title_org":"JCI insight","volume":"9"},"review":"Peer Reviewed","scoID":["2-s2.0-85207254369"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-284e6788-c3a6-498f-8ba3-7199c3bc8a41"],"src":["KU University of Copenhagen"],"title":"Peripherally restricted PICK1 inhibitor mPD5 ameliorates pain behaviors in murine inflammatory and neuropathic pain models","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-777224","year":"2024","yearsub":"2024"}
{"abstract":"Introduction: Bleeding disorder of unknown cause (BDUC) is a challenging diagnosis that predominantly affects women. Previous investigations into connective tissue disorders (CTD) and vitamin C have not been conducted. Aim: To examine the association between hypermobility-related disorders, vitamin C status and BDUC. Methods: Patients were selected following laboratory and genetic screening that yielded negative results for known hemostasis disorders. Sixty patients with BDUC and an ISTH BAT score ≥ 10 underwent clinically examination for skin hyperextensibility and for hypermobility assessed by Beighton score. Vitamin C was analyzed by high-performance liquid chromatography. Genetic screening for causal variants in 42 CTD genes was performed. Results: The majority of patients were female (56/60). Median ISTH BAT score was 13 (range 10–23). Beighton score was positive in 29/60 patients compared to 1/20 healthy controls (HC) (p <.001). Hyperextensive skin was observed in (18/60) patients, and none (0/20) of the HC (p =.0041). Ten patients met the clinical diagnostic criteria for hypermobile Ehlers–Danlos syndrome (hEDS), and one patient was diagnosed with Noonan syndrome. Genetic screening excluded various subtypes of EDS with known genetic backgrounds. Average vitamin C level was adequate, but lower than in HC (55.9 vs. 70.4 μmol/L; p =.001). Suboptimal, or low vitamin C were identified in 19/60 compared to 1/20 HC (p =.018). Conclusion: Our study demonstrates that BDUC is frequently associated with hypermobility disorders and low vitamin C status. Our results could pave the way for a randomized study of vitamin C supplementation in patients with BDUC.","author_count":8,"contributors":["Leinøe, Eva","Fridriksdottir, Halla","Rasmussen, Andreas Ørslev","Funding, Eva","Sørensen, Anne Louise Tølbøll","Kampmann, Peter","Lykkesfeldt, Jens","Rossing, Maria"],"cuid":["S01-000.00-789898"],"filters":{"added":"2025-02","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Ascorbic acid","Bleeding","Connective Tissue","Whole genome sequencing","Women"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"low vitamin c status and hypermobility related disorders in patients with bleeding disorder of unknown cause","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1111/hae.15099","version":"Published Version"},"id":"S01-000.00-789898","identifier":[{"id":"39311717","type":"pmid"},{"id":"PMC11659505","type":"pmcid"},{"id":"85204615091","type":"scopus"}],"ids":["ku-0f7f15eb-86a3-403c-a995-99f512fb1374"],"keyword":["ascorbic acid","bleeding","connective tissue","whole genome sequencing","women"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-0F25837BC7DFD4CEA86BBF6796A2EC2D"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://curis.ku.dk/ws/files/420612066/Haemophilia_2024_Lein_e_Low_vitamin_C_status_and_hypermobility_related_disorders_in_patients_with_bleeding_disorder.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1111/hae.15099","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Internal Medicine: Haematology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Eva","key":"leinøepau","last":"Leinøe","name":"Leinøe, Eva","rank":1,"rolecode":"pau"},{"affno":"1","first":"Halla","key":"fridriksdottirpau","last":"Fridriksdottir","name":"Fridriksdottir, Halla","rank":2,"rolecode":"pau"},{"affno":"1","first":"Andreas Ørslev","key":"rasmussenpau","last":"Rasmussen","name":"Rasmussen, Andreas Ørslev","rank":3,"rolecode":"pau"},{"affno":"1 2","first":"Eva","key":"fundingpau","last":"Funding","locid":"c3e0064d-5599-4105-aab2-8a58bb4065a6","name":"Funding, Eva","rank":4,"rolecode":"pau"},{"affno":"1","first":"Anne Louise Tølbøll","key":"sørensenpau","last":"Sørensen","name":"Sørensen, Anne Louise Tølbøll","rank":5,"rolecode":"pau"},{"affno":"1","first":"Peter","key":"kampmannpau","last":"Kampmann","name":"Kampmann, Peter","rank":6,"rolecode":"pau"},{"affno":"2","first":"Jens","key":"lykkesfeldtpau","last":"Lykkesfeldt","locid":"6e71ebed-c114-42ab-9ae9-6333f14bf8ad","name":"Lykkesfeldt, Jens","orcid":"0000-0002-6514-8407","rank":7,"rolecode":"pau"},{"affno":"1 2","first":"Maria","key":"rossingpau","last":"Rossing","locid":"21caea2d-4f85-4f9b-bb36-a8ec34cac4a8","name":"Rossing, Maria","rank":8,"rolecode":"pau"}],"pmid":["39311717"],"pub":{"doi":"10.1111/hae.15099","issn":["13518216","13550691"],"issn_org":["13518216"],"issue":"6","journal":"Haemophilia","pages":"1366-1372","status":"p","title":"Haemophilia","volume":"30"},"review":"Peer Reviewed","scoID":["2-s2.0-85204615091"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-0f7f15eb-86a3-403c-a995-99f512fb1374"],"src":["KU University of Copenhagen"],"title":"Low vitamin C status and hypermobility-related disorders in patients with bleeding disorder of unknown cause","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-789898","year":"2024","yearsub":"2024"}
{"abstract":"BACKGROUND: The deep inferior epigastric perforator (DIEP) flap is the gold standard for autologous breast reconstruction. The procedure and peri-operative period are associated with the risk of severe post-operative complications, like venous thromboembolic events (VTE) and lung embolism. Whether the intra-abdominal pressure (IAP) increases after the closure of the abdominal defect, thereby potentially affecting the venous backflow and the risk of VTE, is currently not known. AIM: The primary aim is to test if the closure of the abdominal donor site increases the IAP in women undergoing secondary DIEP flap breast reconstruction. MATERIALS AND METHOD: By using a Unometer, we measured the intravesical pressure as a surrogate marker for the IAP, at baseline, immediately after, and 24 h after abdominal skin closure, for 13 patients. RESULTS: The mean IAP increased from 6.1 mmHg (95% CI 4.6-7.7) at baseline to 9.0 mmHg (95% CI 8.0-10.0) immediately after skin closure [mean diff. 2.9 (95% CI 1.0-4.8) (p = 0.007)] and further up to 11.7 mmHg (95% CI 9.0-14.5) 24 h after closure [mean diff. 5.3 (95% CI 1.4-9.1) (p = 0.012)]. We found that IAP varies among the patients, regardless of the tightness of abdominal closure or rectus plication (n = 3). Immediately after closure, none of the isolated patients showed abnormal levels of IAP (>12 mmHg), while eight out of 12 isolated patients (67%) showed IAP levels above the normal range after 24 h. One patient developed a non-fatal lung embolism. CONCLUSION: The mean IAP increases significantly over the post-operative period after DIEP flap reconstruction, although abnormal IAP values are only seen 24 h after the closure of the skin.","author_count":6,"contributors":["Warming, Nikolaj","Toft, Gete","Birk-Sørensen, Lene","Bønnelykke-Behrndtz, Louise"],"cuid":["S02-089.29-766751"],"filters":{"added":"2024-02","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Autologous breast reconstruction","DIEP reconstruction","Intra abdominal pressure","Thromboembolic events"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR","DI-HO-NDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-HO-CDR","DI-HO-NDR","DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"intra abdominal pressure increases peri operatively in patients undergoing deep inferior epigastric perforator flap reconstruction a prospective study linking high intra abdominal pressure to non fatal lung embolism within one patient","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.bjps.2023.10.126","version":"Published Version"},"id":"S02-089.29-766751","identifier":[{"id":"85177893525","type":"scopus"},{"id":"37995521","type":"pmid"}],"ids":["aau-696baf6c-b39f-4484-99ba-f9b607a5396e","au-4a74d75b-852e-422a-aa52-c5e44c306e66"],"keyword":["Autologous breast reconstruction","DIEP reconstruction","Intra-abdominal pressure","Thromboembolic events"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-1A861ADF74FCFF1EEC1FB174ACD9954E"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.bjps.2023.10.126","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/610373134/Warming_et_al._2024_._Intra-abdominal_pressure_increases_peri-operatively_in_patients_undergoing_deep_inferior_epigastric_perfo.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Plastic Surgery"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"dk","key":"north denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-NDR","l3nl":"North Denmark Region","l3nn":"North Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"North Denmark Region","namevar":["Aalborg University Hospital"],"nora_code":"DI-HO-NDR","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Plastic and Breast surgery"],"nora_code":"DI-U-AU","used":1},{"affno":"4","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Nikolaj","key":"warmingpau","last":"Warming","locid":"ad7d870c-204f-4f5e-9fae-fa3b2f4cb374","name":"Warming, Nikolaj","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Gete","key":"toftpau","last":"Toft","locid":"03563ebc-1e72-43cd-bd99-9c7196f943fd","name":"Toft, Gete","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Gete Ester Toft","key":"eschenpau","last":"Eschen","locid":"1b62a84e-d382-442a-acc2-5b52d2ce2953","name":"Eschen, Gete Ester Toft","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lene","key":"birksørensenpau","last":"Birk-Sørensen","locid":"edf1de58-587f-4a7f-9396-cb9da9b49ef0","name":"Birk-Sørensen, Lene","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lene","key":"birksøensenpau","last":"Birk-Søensen","name":"Birk-Søensen, Lene","rank":3,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Marie Louise","key":"bønnelykkebehrndtzpau","last":"Bønnelykke-Behrndtz","name":"Bønnelykke-Behrndtz, Marie Louise","rank":4,"rolecode":"pau"}],"pmid":["37995521"],"pub":{"doi":"10.1016/j.bjps.2023.10.126","issn":["17486815","18780539"],"issn_org":["17486815"],"journal":"Journal of Plastic, Reconstructive & Aesthetic Surgery","pages":"235-242","publisher":"Churchill Livingstone","status":"p","title":"Journal of Plastic, Reconstructive & Aesthetic Surgery","title_org":"Journal of Plastic, Reconstructive & Aesthetic Surgery (Print Edition)","volume":"88"},"review":"Peer Reviewed","scoID":["2-s2.0-85177893525"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Universities"],"PST":["Published"]},"sid":["aau-696baf6c-b39f-4484-99ba-f9b607a5396e","au-4a74d75b-852e-422a-aa52-c5e44c306e66"],"src":["AAU Aalborg University","AU Aarhus University"],"title":"Intra-abdominal pressure increases peri-operatively in patients undergoing deep inferior epigastric perforator flap reconstruction: A prospective study linking high intra-abdominal pressure to non-fatal lung embolism within one patient","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-089.29-766751","year":"2024","yearsub":"2024"}
{"abstract":"Background: Antipsychotic polypharmacy remains a clinical reality, despite an increased risk of adverse events and little evidence of additional efficacy compared with antipsychotic monotherapy. In this systematic review and meta-analysis, we aimed to provide a comprehensive assessment of antipsychotic polypharmacy prevalence, trends, and correlates across mental disorders. Methods: We searched MEDLINE and Embase from Jan 1, 2009 to April 30, 2024, for any original study (observational and interventional) reporting antipsychotic polypharmacy prevalence in populations with mental disorders or use of antipsychotics, regardless of age or diagnosis. Relevant studies before May 1, 2009, were identified from two previous systematic reviews of antipsychotic polypharmacy prevalence. Pooled antipsychotic polypharmacy prevalence was estimated using random-effects meta-analysis. Using subgroup and mixed-effects meta-regression analyses, we sought to identify relevant correlates of antipsychotic polypharmacy. People with lived experience were not involved in the project. This review is registered with PROSPERO (CRD42022329953). Findings: We analysed 517 studies with 599 individual timepoints reporting on 4 459 149 individuals (mean age 39·5 years [range 6·4–86·3]; data on sex and ethnicity were infrequently reported). Most studies included patients with schizophrenia spectrum disorders (SSDs; k=270, 52%). Overall, 24·8% (95% CI 22·9–26·7) of the populations received antipsychotic polypharmacy, ranging from 33·2% (30·6–36·0) in people with SSDs to 5·2% (4·0–6·8) in people with dementia. Antipsychotic polypharmacy prevalence varied by region from 15·4% (95% CI 12·9–18·2) in North America to 38·6% (27·7–50·6) in Africa. Overall antipsychotic polypharmacy prevalence increased significantly from 1970 to 2023 (β=0·019, 95% CI 0·009–0·029; p=0·0002) and was higher in adults than in children and adolescents (27·4%, 95% CI 25·2–29·8 vs 7·0%, 4·7–10·3; p<0·0001) and among inpatients than among outpatients (31·4%, 27·9–35·2 vs 19·9%, 16·8–23·3; p<0·0001). Compared with antipsychotic monotherapy, antipsychotic polypharmacy was associated with an increased risk of relapse (relative risk [RR] 1·42, 95% CI 1·04–1·93; p=0·028), psychiatric hospitalisation (1·24, 1·12–1·38; p<0·0001), worse global functioning (standardised mean difference [SMD] –0·31, 95% CI –0·44 to –0·19; p<0·0001), and more adverse events, including extrapyramidal symptoms (RR 1·63, 95% CI 1·13–2·36; p=0·0098), dystonia (5·91, 1·20–29·17; p=0·029), anticholinergic use (1·91, 1·55–2·35; p<0·0001), higher side-effect scores (SMD 0·33, 95% CI 0·24–0·42; p<0·0001), longer corrected QT interval (0·24, 0·23–0·26; p<0·0001), and greater all-cause mortality risk (RR 1·19, 95% CI 1·00–1·41; p=0·047). Interpretation: The prevalence of antipsychotic polypharmacy has increased globally over the past 50 years and is particularly high in patients with SSDs. Prescription of antipsychotic polypharmacy is associated with greater illness severity and poorer outcomes than is antipsychotic monopharmacy but does not resolve these issues. Furthermore, antipsychotic polypharmacy is associated with higher side-effect burden, including all-cause mortality. Funding: None.","author_count":18,"contributors":["Højlund, Mikkel","Köhler-Forsberg, Ole","Gregersen, Anton T.","Rohde, Christopher","Mellentin, Angelina I.","Anhøj, Simon J.","Kemp, Adam F.","Fuglsang, Nina B.","Wiuff, Anne Christine","Nissen, Louise","Sørensen, Marc A.","Madsen, Nanna M.","Wagner, Christina B.","Agharazi, Armaghan","Søndergaard, Cecilie","Sandmark, Marie","Reinhart, Jana","Correll, Christoph U."],"cuid":["S02-096.08-767774"],"filters":{"added":"2025-01","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["America, North","Europe, EU","OECD"],"corresponding_author":["Højlund, Mikkel"],"country":["Germany","United States"],"glorg":["All Global Affiliations","Charité - University Medicine Berlin","Charité-Universitätsmedizin Berlin","German Center for Mental Health (DZPG)","Hofstra University","North Shore-Long Island Jewish Health System","The Feinstein Institute for Medical Research","Zucker Hillside Hospital"],"keyword":["Antipsychotic Agents therapeutic use","Humans","Mental Disorders drug therapy","Polypharmacy","Prevalence"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-SDR"],"OT":["Psykiatrisk Hospital for Børn og Unge, Esbjerg"],"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-SDR","DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"prevalence correlates tolerability related outcomes and efficacy related outcomes of antipsychotic polypharmacy a systematic review and meta analysis","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/281833467/hojlund_app_prevalence_aom.pdf","version":"Authors Final Version"},"id":"S02-096.08-767774","identifier":[{"id":"85209236767","type":"scopus"},{"id":"39547246","type":"pmid"}],"ids":["au-af5d3c4e-c379-4665-b734-565543ff8932","sdu-8e9ad8ec-fc71-4a9b-b667-84bf69884dcf"],"keyword":["Antipsychotic Agents/therapeutic use","Humans","Mental Disorders/drug therapy","Polypharmacy","Prevalence"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-85868ECF91E7117240F7303DB5B46801"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/281833467/hojlund_app_prevalence_aom.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":[