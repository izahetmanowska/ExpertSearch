","key":"petersørensenpau","last":"Peter Sørensen","locid":"bcab9ca7-425e-47e6-a4b9-154e6a126cde","name":"Sørensen, Hans Peter","name_org":"Peter Sørensen, Hans","rank":3,"rolecode":"pau"},{"affno":"4 5","corresponding":null,"first":"Gholamreza","key":"hassanzadehghassabehpau","last":"Hassanzadeh-Ghassabeh","name":"Hassanzadeh-Ghassabeh, Gholamreza","rank":4,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Mingdong","key":"huangpau","last":"Huang","name":"Huang, Mingdong","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jan K.","key":"jensenpau","last":"Jensen","locid":"50b6e2ae-af89-4715-91b6-49237fee720a","name":"Jensen, Jan Kristian","name_org":"Jensen, Jan K.","rank":6,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Serge","key":"muyldermanspau","last":"Muyldermans","name":"Muyldermans, Serge","rank":7,"rolecode":"pau"},{"affno":"7","corresponding":null,"first":"Paul J.","key":"declerckpau","last":"Declerck","name":"Declerck, Paul J.","rank":8,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Elizabeth A","key":"komivespau","last":"Komives","name":"Komives, Elizabeth A","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Peter A.","key":"andreasenpau","last":"Andreasen","locid":"fa59daee-38c4-418f-a93f-b48229438570","name":"Andreasen, Peter A","name_org":"Andreasen, Peter A.","rank":10,"rolecode":"pau"}],"pmid":["28611361"],"pub":{"doi":"10.1038/s41598-017-03457-7","issn":["20452322"],"issue":"1","journal":"Scientific Reports","paperid":"3385","publisher":"Nature Publishing Group","status":"p","title":"Scientific Reports","volume":"7"},"review":"Peer Reviewed","scoID":["2-s2.0-85020878045"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-2297243e-b5e7-4381-b200-63fac6520327"],"src":["AU Aarhus University"],"title":"Discovery of a novel conformational equilibrium in urokinase-type plasminogen activator","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-149170","year":"2017","yearsub":"2017"}
{"abstract":"OBJECTIVES: To assess the accuracy of detecting robot-simulated head movements using video observation (VO) and 3-dimensional head tracking (HT) in a cone beam computed tomography examination setup. STUDY DESIGN: A mannequin head was mounted on a robot that was programmed to simulate patient head movements. Six types of movement (tremor, nodding, lateral rotation, lifting, swallowing, and anteroposterior translation), 3 distances (0.25, 1, and 5 mm), and 2 speeds (1 and 5 mm/s) were tested in triplicate (108 examinations). An additional 18 videos and HT of no-motion served as controls for a total of 126 examinations. Three blinded observers viewed video recordings of the examinations, scoring whether the head moved and the movement type. HT provided quantitative measures of movement distance. Accuracy, sensitivity, and specificity for movement detection by VO and HT were calculated, related to true type, distance, and speed of movement. Differences between the true and the measured movement distances were assessed for HT. RESULTS: VO movement detection presented accuracy of 0.86, sensitivity of 0.85, and specificity of 0.94. Anteroposterior translation (33.3%) and 0.25 mm movements (41.7%) were often not detected by VO. HT correctly detected all cases (accuracy = 1). HT presented small differences between the true and the measured movement distances (average 20-54 μm). CONCLUSIONS: VO missed 41.7% of the 0.25 mm movements. HT correctly detected all movements and quantified movements with an average error <55 μm.","author_count":6,"contributors":["Spin-Neto, Rubens","Matzen, Louise Hauge","Schropp, Lars","Sørensen, Thomas S","Gotfredsen, Erik","Wenzel, Ann"],"cuid":["S01-000.00-158630"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Journal Article"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"accuracy of video observation and a three dimensional head tracking system for detecting and quantifying robot simulated head movements in cone beam computed tomography","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85017363836","version":"Other Version"},"id":"S01-000.00-158630","identifier":[{"id":"85017363836","type":"scopus"},{"id":"28412232","type":"pmid"}],"ids":["au-333ba4e1-80a2-4108-a658-1e8a859b27cd"],"keyword":["Journal Article"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-1A4A2C5A435D097F51A150E4FCA3A339"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Dentistry and Oral Health, Department of Dentistry and Oral Health - Section for Oral Radiology and Endodontics"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Rubens","key":"spinnetopau","last":"Spin-Neto","locid":"242a9551-55e4-4564-afdd-f51a3ad8947b","name":"Spin-Neto, Rubens","orcid":"0000-0002-9562-0610","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Louise H","key":"matzenpau","last":"Matzen","locid":"6d2056e0-6343-4b7e-94d0-f3c63475edd4","name":"Matzen, Lo