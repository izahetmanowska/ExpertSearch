{"author_count":5,"contributors":["Sørensen, Jette","Egmose, Britt","Petersen, Jens Jakob Herrche"],"cuid":["S01-000.00-723844"],"filters":{"added":"2024-03","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Børn og unge","Sygdom sundhedsvidenskab og sygepleje"],"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-UC"],"level3":{"HO":["DI-HO-ALL","DI-HO-SDR"],"UC":["DI-UC-ALL","DI-UC-UCL"]},"level3all":["DI-HO-SDR","DI-UC-UCL"]},"review":"pr","rtype":["clu"],"sorti":"sygepleje til de unge","src":["ucl"],"src-code":["DI-UC-UCL"],"type":"dba","type-grp":["all","pub"]},"id":"S01-000.00-723844","ids":["ucl-96b59123-4def-4630-93cb-6f3d995b480b"],"keyword":["Børn og unge","Sygdom, sundhedsvidenskab og sygepleje"],"lang":"Danish","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-9A530420B7AAB794276929126F490D2C"],"org":[{"affno":"1","key":"ucl university college","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-UCL","l3nl":"UCL University College","l3nn":"UCL University College","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"UCL University College","namevar":["UCL Erhvervsakademi og Professionshøjskole, Direktion, Sundhed, Anvendt Sundhedsforskning","UCL Erhvervsakademi og Professionshøjskole, Direktion, Sundhed, Sygeplejerskeuddannelsen i Odense"],"nora_code":"DI-UC-UCL","used":1},{"affno":"2","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Odense University Hospital"],"nora_code":"DI-HO-SDR","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jette","key":"sørensenpau","last":"Sørensen","locid":"767fb88e-93ae-49ff-8e08-77b06b1a9160","name":"Sørensen, Jette","orcid":"0000-0002-1231-8580","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Britt","key":"egmosepau","last":"Egmose","name":"Egmose, Britt","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jens Jakob Herrche","key":"petersenpau","last":"Petersen","name":"Petersen, Jens Jakob Herrche","rank":3,"rolecode":"pau"},{"affno":"","first":"Christina Louise","key":"lindhardtpedh","last":"Lindhardt","name":"Lindhardt, Christina Louise","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Mie Augustsen","key":"holgersenpedh","last":"Holgersen","name":"Holgersen, Mie Augustsen","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["9788702411393"],"publisher":"Munksgaard","status":"p","title":"Sygepleje til børn og unge"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Hospitals","All University Colleges","DI-ALL","DI-HO","DI-HO-ALL","DI-UC","DI-UC-ALL","Hospitals","Region of Southern Denmark","UCL University College","University Colleges"],"PST":["Published"]},"sid":["ucl-96b59123-4def-4630-93cb-6f3d995b480b"],"src":["UCL University College"],"title":"Sygepleje til de unge","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-723844","year":"2024","yearsub":"2024"}
{"abstract":"BACKGROUND: Human breast milk (HBM) is a contributing factor in modulating the infant's gut microbiota, as it contains bacteria that are directly transferred to the infant during breastfeeding. It has been shown that children of women diagnosed with gestational diabetes mellitus (GDM) have a different gut microbiota compared to children of women without GDM. Our hypothesis is therefore that women with GDM have a different HBM microbiota, which may influence the metabolic function and capacity of the child later in life. The aim of this study was to investigate whether women with GDM have a different breast milk microbiota 1-3 weeks postpartum compared to women without GDM. METHODS: In this case-control study, a total of 45 women were included: 18 women with GDM and 27 women without GDM. A milk sample was collected from each participant 1 to 3 weeks postpartum and the bacterial composition was examined by 16 S rRNA gene sequencing targeting the V4 region. RESULTS: High relative abundances of Streptococcus and Staphylococcus were present in samples from both women with and without GDM. No difference could be seen in either alpha diversity, beta diversity, or specific taxa between groups. CONCLUSION: Our results did not support the existence of a GDM-associated breast milk microbiota at 1-3 weeks postpartum. Further research is needed to fully understand the development of the gut microbiota of infants born to mothers with GDM.","author_count":11,"contributors":["Rold, Louise Søndergaard","Guldbæk, Johan Mikkel","Lindegaard, Caroline Steenberg","Kirk, Stine","Nygaard, Line Damkjær","Bundgaard-Nielsen, Caspar","Holm-Jacobsen, Julie Niemann","Leutscher, Peter Derek Christian","Viuff, Anne-Cathrine Finnemann","Hagstrøm, Søren","Sørensen, Suzette"],"cuid":["S01-000.00-742970"],"filters":{"added":"2024-08","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"corresponding_author":["Sørensen, Suzette"],"keyword":["Adult","Breast Feeding","Breast milk","Case Control Studies","Colonization","Diabetes Gestational microbiology","Female","Gastrointestinal Microbiome","Gestational diabetes mellitus","Humans","Infant","Microbiota","Pediatrics","Postpartum Period","Pregnancy","RNA Ribosomal 16S analysis","Staphylococcus isolation purification","Streptococcus isolation purification"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"a comparison of the breast milk microbiota from women diagnosed with gestational diabetes mellitus and women without gestational diabetes mellitus","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.1186/s12884-024-06604-x","version":"Published Version"},"funding_acknowledgement":["This study is funded by the Steno Diabetes Centre North Denmark. The center is neither involved in study design, sample collection, analysis and interpretation of data, nor in preparation of the manuscript. We would like to thank the women participating in the study for their contribution to the project. Furthermore, we would like to thank the Department of Pediatrics and Adolescents and Department of Gynaecology and Obstetrics from Aalborg University Hospital, and the Department of Gynaecology and Obstetrics from North Denmark Hospital, who contributed with participant recruitment and sample collection."],"id":"S01-000.00-742970","identifier":[{"id":"PMC11157733","type":"pmcid"},{"id":"38849751","type":"pmid"},{"id":"85195533461","type":"scopus"}],"ids":["aau-82543879-3ae3-4286-94f2-099a43e7216d"],"keyword":["Adult","Breast Feeding","Breast milk","Case-Control Studies","Colonization","Diabetes, Gestational/microbiology","Female","Gastrointestinal Microbiome","Gestational diabetes mellitus","Humans","Infant","Microbiota","Milk, Human/microbiology","Pediatrics","Postpartum Period","Pregnancy","RNA, Ribosomal, 16S/analysis","Staphylococcus/isolation & purification","Streptococcus/isolation & purification"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-DA625B21D27E574FF2BA60CFF8B2F69C"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.1186/s12884-024-06604-x","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/721539237/Rold_et_al._2024_._A_comparison_of_the_breast_milk_microbiota_from_women_diagnosed_with_gestational_diabetes_mellitus_and_women_without_gestational_diabetes_mellitus.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Steno Diabetes Center North Denmark","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine, Center for Clinical Research","Aalborg University, The Faculty of Medicine, North Denmark Regional Hospital"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Louise Søndergaard","key":"roldpau","last":"Rold","locid":"b6827a2f-8258-4df3-8a91-becaf4c50d7d","name":"Rold, Louise Søndergaard","orcid":"0000-0002-3638-8655","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Johan Mikkel","key":"guldbækpau","last":"Guldbæk","locid":"363c354c-f3f1-4bed-910c-153fa5b5c49e","name":"Guldbæk, Johan Mikkel","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Caroline Steenberg","key":"lindegaardpau","last":"Lindegaard","loc