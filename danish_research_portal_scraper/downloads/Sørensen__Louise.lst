n of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-33121f00-f810-4bc9-82e1-fa3af187d1cc","sdu-8f230db0-d15e-4af7-8e4f-b53119ced4d8"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Papillon-Lefèvre syndrome patient reveals species-dependent requirements for neutrophil defenses","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-093.09-041339","year":"2014","yearsub":"2014"}
{"abstract":"Improving the nutritional profile of sausages through the addition of dietary fiber might affect appetite, sensory characteristics, and liking differently depending on the fiber source. This study investigates the sensory characteristics and consumer acceptance of sausages with 10% (w/w) fat and added rye or wheat bran. Sensory descriptive attributes (odor, appearance, texture, and flavor) of rye bran sausage (RBS) and wheat bran sausage (WBS) were evaluated by a trained sensory panel (n = 9). A sausage with wheat flour (WFS) and two commercial 20% (20%S) and 10% (10%S) (w/w) fat sausages were also included. Liking was investigated in consumer tests with two Danish target groups (49 children aged between six and nine and 24 parents). RBS and WBS were similar with regard to their sensory descriptive attributes, but the structure of these sausages was coarser and the color was more brown than the other sausages. RBS was similar to the commercial 10%S with regard to several sensory attributes and liking, whereas WBS was the least juicy, had a higher intensity of cereal odor and flavor, and the lowest liking.","author_count":8,"contributors":["Jakobsen, Louise Margrethe Arildsen","Vuholm, Stine","Aaslyng, Margit Dall","Kristensen, Mette Bredal","Sørensen, Karina Vejrum","Raben, Anne","Kehlet, Ursula Nana"],"cuid":["S02-098.33-045710"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Bran","Consumer liking","Dietary fiber","Sausage","Sensory characteristics"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GTS","DI-U"],"level3":{"GTS":["DI-GTS-ALL","DI-GTS-DTCI"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-GTS-DTCI","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"sensory characteristics and consumer liking of sausages with 000000000010 fat and added rye or wheat bran","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/161412728/Jakobsen_et_al_2014_Food_Science_Nutrition.pdf","version":"Published Version"},"id":"S02-098.33-045710","identifier":[{"id":"PMC4237483","type":"pmcid"},{"id":"84982889860","type":"scopus"},{"id":"25473511","type":"pmid"}],"ids":["ku-bb3703a2-be74-481f-9106-a313ce1b9d62","sdu-cb01eeed-5cb9-4b05-b865-45282318dd4e"],"keyword":["Bran","consumer liking","dietary fiber","sausage","sensory characteristics"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-A58C7E6F8030A1DB5FCEAB5A4B99375F"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/161412728/Jakobsen_et_al_2014_Food_Science_Nutrition.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1002/fsn3.126","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"danish technological institute","l2":"DI-GTS","l2n":"GTS Institutes","l3":"DI-GTS-DTCI","l3nn":"Danish Technological Institute","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Danish Technological Institute","namevar":["Danish Meat Research Institute"],"nora_code":"DI-GTS-DTCI","used":1},{"affno":"3","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Endocrinology (Odense)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","first":"Louise Margrethe Arildsen","key":"jakobsenpau","last":"Jakobsen","name":"Jakobsen, Louise Margrethe Arildsen","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Louise Margrethe","key":"arildsenjakobsenpau","last":"Arildsen Jakobsen","name":"Arildsen Jakobsen, Louise Margrethe","rank":1,"rolecode":"pau"},{"affno":"1","first":"Stine","key":"vuholmpau","last":"Vuholm","locid":"28767d1b-8dd0-43be-bc1d-f283ff15d138","name":"Vuholm, Stine","orcid":"0000-0002-7074-5564","rank":2,"rolecode":"pau"},{"affno":"2","first":"Margit Dall","key":"aaslyngpau","last":"Aaslyng","name":"Aaslyng, Margit Dall","rank":3,"rolecode":"pau"},{"affno":"1","first":"Mette Bredal","key":"kristensenpau","last":"Kristensen","locid":"8d60efd3-e529-4066-a47a-0e7a1114aca7","name":"Kristensen, Mette Bredal","orcid":"0000-0002-0065-8174","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Karina Vejrum","key":"sørensenpau","last":"Sørensen","locid":"30d23fe3-e116-49c1-b52c-ca7a5482f3c8","name":"Sørensen, Karina Vejrum","rank":5,"rolecode":"pau"},{"affno":"1","first":"Anne","key":"rabenpau","last":"Raben","locid":"fdac50bf-ccda-4ed1-b344-0b16301c45e8","name":"Raben, Anne","orcid":"0000-0001-5229-4491","rank":6,"rolecode":"pau"},{"affno":"2 1","first":"Ursula Nana","key":"kehletpau","last":"Kehlet","locid":"4b375db8-27cc-4801-95a1-049a201aeb65","name":"Kehlet, Ursula Nana","orcid":"0000-0002-1124-9800","rank":7,"rolecode":"pau"}],"pmid":["25473511"],"pub":{"doi":"10.1002/fsn3.126","issn":["20487177"],"issue":"5","journal":"Food Science & Nutrition","pages":"534-546","publisher":"Wiley","status":"p","title":"Food Science & Nutrition","volume":"2"},"review":"Peer Reviewed","scoID":["2-s2.0-84982889860"],"search":{"DAF":["All Danish Affiliations","All GTS Institutes","All Universities","DI-ALL","DI-GTS","DI-GTS-ALL","DI-U","DI-U-ALL","GTS Institutes","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-bb3703a2-be74-481f-9106-a313ce1b9d62","sdu-cb01eeed-5cb9-4b05-b865-45282318dd4e"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Sensory characteristics and consumer liking of sausages with 10% fat and added rye or wheat bran","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-098.33-045710","year":"2014","yearsub":"2014"}
{"abstract":"OBJECTIVE: To examine the validity of the International Classification of Diseases, 10th revision (ICD-10) codes for hyponatraemia in the nationwide population-based Danish National Registry of Patients (DNRP) among inpatients of all ages. DESIGN: Population-based validation study. SETTING: All somatic hospitals in the North and Central Denmark Regions from 2006 through 2011. PARTICIPANTS: Patients of all ages admitted to hospital (n=819 701 individual patients) during the study period. The patient could be included in the study more than once, and our study did not restrict to patients with serum sodium measurements (total of n=2 186 642 hospitalisations). MAIN OUTCOME MEASURE: We validated ICD-10 discharge diagnoses of hyponatraemia recorded in the DNRP, using serum sodium measurements obtained from the laboratory information systems (LABKA) research database as the gold standard. One sodium value <135 mmol/L measured at any time during hospitalisation confirmed the diagnosis. We estimated sensitivity, specificity, positive predictive value (PPV) and negative predictive value (NPV) for ICD-10 codes for hyponatraemia overall and for cut-off points for increasing hyponatraemia severity. RESULT: An ICD-10 code for hyponatraemia was recorded in the DNRP in 5850 of the 2 186 642 hospitalisations identified. According to laboratory measurements, however, hyponatraemia was present in 306 418 (14%) hospitalisations. Sensitivity of hyponatraemia diagnoses was 1.8% (95% CI 1.7% to 1.8%). For sodium values <115 mmol/L, sensitivity was 34.3% (95% CI 32.6% to 35.9%). The overall PPV was 92.5% (95% CI 91.8% to 93.1%) and decreased with increasing hyponatraemia severity. Specificity and NPV were high for all cut-off points (≥99.8% and ≥86.2%, respectively). Patients with hyponatraemia without a corresponding ICD-10 discharge diagnosis were younger and had higher Charlson Comorbidity Index scores than patients with hyponatraemia with a hyponatraemia code in the DNRP. CONCLUSIONS: ICD-10 codes for hyponatraemia in the DNRP have high specificity but very low sensitivity. Laboratory test results, not discharge diagnoses, should be used to ascertain hyponatraemia.","author_count":6,"contributors":["Holland-Bill, Louise","Christiansen, Christian Fynbo","Ulrichsen, Sinna Pilgaard","Ring, Troels","Jørgensen, Jens Otto Lunde","Sørensen, Henrik Toft"],"cuid":["S02-100.00-005868"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-UND"]},"level3all":["DI-U-AAU","DI-U-AU","DI-U-UND"]},"review":"pr","rtype":["clu"],"sorti":"validity of the international classification of diseases 000000000010th revision discharge diagnosis codes for hyponatraemia in the danish national registry of patients","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1136/bmjopen-2014-004956","version":"Published Version"},"id":"S02-100.00-005868","identifier":[{"id":"24760354","type":"pmid"},{"id":"WOS:000335830500032","type":"wos"},{"id":"84899558717","type":"scopus"},{"id":"PMC4010845","type":"pmcid"}],"ids":["aau-78dc3cff-d073-4633-a80f-70791155eb9c","au-436cf407-4f0a-430b-b1db-921ff0c4cf0f"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-4-7-11FF6F7E4B75102F62220F79BF07FE94"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1136/bmjopen-2014-004956","version":"Other Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Clinical Skills Laboratory","Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Clinical Epidemiology"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"unclear universities","l2":"DI-U","l2n":"Universities","l3":"DI-U-UND","l3nl":"Undetermined","l3nn":"Unclear Universities","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Unclear Universities","namevar":["Institut for Klinisk Medicin - Klinisk Epidemiologi, SKS"],"nora_code":"DI-U-UND","used":1},{"affno":"3","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Medicin","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Nyremedicin (Nefrologi) [Klinik Medicin]"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Louise","key":"hollandbillpau","last":"Holland-Bill","locid":"578d785d-8e78-4933-9ba4-3db0ec2b4c29","name":"Holland-Bill, Louise","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Christian Fynbo","key":"christiansenpau","last":"Christiansen","locid":"b1104ec4-1322-428f-af8f-7771361930bb","name":"Christiansen, Christian Fynbo","orcid":"0000-0002-0727-953X","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Sinna Pilgaard","key":"ulrichsenpau","last":"Ulrichsen","name":"Ulrichsen, Sinna Pilgaard","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Troels","key":"ringpau","last":"Ring","locid":"6efec618-81ab-4b8d-a0b0-21545f7c9336","name":"Ring, Troels","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens Otto Lunde","key":"jørgensenpau","last":"Jørgensen","locid":"303ebe86-6861-4b19-b4d7-6bda0526b27e","name":"Jørgensen, Jens Otto Lunde","orcid":"0000-0001-7408-1526","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik Toft","key":"sørensenpau","last":"Sørensen","locid":"4d49d93a-4913-4223-ba59-272e717a845d","name":"Sørensen, Henrik Toft","orcid":"0000-0003-4299-7040","rank":6,"rolecode":"pau"}],"pmid":["24760354"],"pub":{"doi":"10.1136/bmjopen-2014-004956","issn":["20446055"],"issue":"4","journal":"BMJ Open","paperid":"e004956","publisher":"BMJ Publishing Group","status":"p","title":"BMJ Open","volume":"4"},"review":"Peer Reviewed","scoID":["2-s2.0-84899558717"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Undetermined","Universities"],"PST":["Published"]},"sid":["aau-78dc3cff-d073-4633-a80f-70791155eb9c","au-436cf407-4f0a-430b-b1db-921ff0c4cf0f"],"src":["AAU Aalborg University","AU Aarhus University"],"title":"Validity of the International Classification of Diseases, 10th revision discharge diagnosis codes for hyponatraemia in the Danish National Registry of Patients","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-005868","year":"2014","yearsub":"2014"}
{"abstract":"The objective of the study was to assess global expression of proteins in equine saliva using liquid chromatography tandem mass spectrometry (LC-MS/MS). Saliva was obtained from seven horses with and six horses without evidence of systemic inflammatory disease. Tryptic peptides from saliva were analysed by LC-MS/MS. Of 195 unique proteins identified, 57 were detected only in saliva samples from horses with systemic inflammation (in two to six of the seven horses). Among the differentially expressed proteins were several acute phase proteins (APPs) such as serum amyloid A, fibrinogen, haptoglobin, and alpha1-acid glycoprotein. The study is the first to describe detection of inflammatory proteins in horse saliva. The proteins detected were similar to those described in saliva from cattle, small ruminants and pigs. Detection of APPs in horses with systemic inflammation suggests that saliva may be used for non-invasive disease monitoring in horses as in humans, pigs and dogs","author_count":6,"contributors":["Jacobsen, Stine","Top Adler, Ditte Marie","Bundgaard, Louise","Sørensen, Mette Aamand","Andersen, Pia Haubro","Bendixen, Emøke"],"cuid":["S02-100.00-029653"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Jacobsen, Stine"],"keyword":["Equine","Inflammation","Mass spectrometry","Proteomics","Saliva"],"level":"sci","mra":["hum","med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"the use of liquid chromatography tandem mass spectrometry to detect proteins in saliva from horses with and without systemic inflammation","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.tvjl.2014.08.032","version":"Other Version"},"id":"S02-100.00-029653","identifier":[{"id":"25296850","type":"pmid"},{"id":"84919329549","type":"scopus"}],"ids":["au-ea4bc365-ba93-4ff8-ab4a-ebd1710f5710","ku-66c6d62e-c67c-48bf-8fc3-84661e880519"],"keyword":["Equine","Inflammation","Mass spectrometry","Proteomics","Saliva"],"lang":"English","level":"Scientific","mra":["Humanities","Medical Science"],"noi":["Global-Local-2-5-1DCFD17F4B17B7D9390B13DA856F1FBC"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.tvjl.2014.08.032","version":"Other Version"},{"access":"oa","type":"rem","url":"http://www.scopus.com/inward/record.url?scp=84919329549&partnerID=8YFLogxK","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Veterinary Clinical Sciences, Section for Medicine and Surgery"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Molecular Biology and Genetics, Department of Molecular Biology and Genetics - Protein science"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","first":"Stine","key":"jacobsenpau","last":"Jacobsen","locid":"f3957428-a0cc-46ad-a05c-b85ca7d03e9e","name":"Jacobsen, Stine","orcid":"0000-0002-2380-4576","rank":1,"rolecode":"pau"},{"affno":"1","first":"Ditte Marie Top","key":"adlerpau","last":"Adler","locid":"cde54b4e-5493-43e8-b7ec-cdc82459f61e","name":"Adler, Ditte Marie Top","orcid"