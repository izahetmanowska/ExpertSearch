euroscience Methods","volume":"378"},"review":"Peer Reviewed","scoID":["2-s2.0-85133610121"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-9681ca13-e3c5-42f5-8ce5-59890b9efec4","ku-6c668d2d-a6b3-494a-b32d-6840788f302e"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"An fMRI-compatible system for targeted electrical stimulation","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-023628","year":"2022","yearsub":"2022"}
{"abstract":"Background: Haloperidol is frequently used to treat delirium in patients in the intensive care unit (ICU), but evidence of its effect is limited. Methods: In this multicenter, blinded, placebo-controlled trial, we randomly assigned adult patients with delirium who had been admitted to the ICU for an acute condition to receive intravenous haloperidol (2.5 mg 3 times daily plus 2.5 mg as needed up to a total maximum daily dose of 20 mg) or placebo. Haloperidol or placebo was administered in the ICU for as long as delirium continued and as needed for recurrences. The primary outcome was the number of days alive and out of the hospital at 90 days after randomization. Results: A total of 1000 patients underwent randomization; 510 were assigned to the haloperidol group and 490 to the placebo group. Among these patients, 987 (98.7%) were included in the final analyses (501 in the haloperidol group and 486 in the placebo group). Primary outcome data were available for 963 patients (97.6%). At 90 days, the mean number of days alive and out of the hospital was 35.8 (95% confidence interval [CI], 32.9 to 38.6) in the haloperidol group and 32.9 (95% CI, 29.9 to 35.8) in the placebo group, with an adjusted mean difference of 2.9 days (95% CI, -1.2 to 7.0) (P = 0.22). Mortality at 90 days was 36.3% in the haloperidol group and 43.3% in the placebo group (adjusted absolute difference, -6.9 percentage points [95% CI, -13.0 to -0.6]). Serious adverse reactions occurred in 11 patients in the haloperidol group and in 9 patients in the placebo group. Conclusions: Among patients in the ICU with delirium, treatment with haloperidol did not lead to a significantly greater number of days alive and out of the hospital at 90 days than placebo. (Funded by Innovation Fund Denmark and others; AID-ICU ClinicalTrials.gov number, NCT03392376; EudraCT number, 2017-003829-15.).","author_count":63,"contributors":["Andersen-Ranberg, N.C.","Poulsen, L.M.","Perner, A.","Wetterslev, J.","Estrup, S.","Hästbacka, J.","Morgan, M.","Citerio, G.","Caballero, J.","Lange, T.","Kjær, M.-B.N.","Ebdrup, B.H.","Engstrøm, J.","Olsen, M.H.","Collet, M. Oxenbøll","Mortensen, C.B.","Weber, Sven-Olaf","Andreasen, A.S.","Bestle, M.H.","Uslu, B.","Pedersen, H. Scharling","Gramstrup Nielsen, L.","Toft Boesen, H.C.","Jensen, J.V.","Nebrich, L.","Cour, K. La","Laigaard, J.","Haurum, C.","Olesen, M.W.","Overgaard-Steensen, C.","Westergaard, B.","Brand, B.A.","Vesterlund, G. Kingo","Kyhnauv, P. Thornberg","Mikkelsen, V.S.","Hyttel-Sørensen, S.","de Haas, Inge","Aagaard, Søren Rosborg","Overholt Nielsen, Line","Broberg Eriksen, Anne Sofie","Rasmussen, Bodil Steen","Brix, H.","Hildebrandt, T.","Schønemann-Lund, M.","Fjeldsøe-Nielsen, H.","Kuivalainen, A.-M.","Mathiesen, O.","Vestergaard, Stine Rom","Bunzel, Anne-Marie Gellert","Siegumfeldt, Rine Moulvad"],"cuid":["S04-097.24-011684"],"filters":{"added":"2022-12","altsrc":["Global Data"],"author_count":"51-200 contributors","class":"merged","cluster_size":4,"continent":["Europe, EU","Europe, Non-EU","Nordic","OECD"],"corpau":["AID-ICU Trial Group"],"corresponding_author":["Andersen-Ranberg, N.C.","Andersen-Ranberg, Nina C."],"country":["Finland","Italy","Spain","United Kingdom"],"glorg":["All Global Affiliations","Cardiff University","Helsinki University Hospital","Hospital Arnau de Vilanova","University Hospital Arnau de Vilanova","University Hospital Wales","University Hospital of Wales","University of Milan - Bicocca","University of Milano Bicocca"],"keyword":["Clinical Medicine","Clinical Medicine General","Confusion Delirium","Critical care","Hospital Based Clinical Medicine","Intensive care unit","Mortality","Neurology Neurosurgery","Psychiatry","Psychiatry General","Pulmonary Critical Care","Pulmonary Critical Care General","Validation"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-SDR","DI-HO-ZEA"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-SDR","DI-HO-ZEA","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"haloperidol for the treatment of delirium in icu patients","src":["aau","au","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/221722194/Haloperidol_for_the_Treatment_of_Delirium_in_ICU_Patients.pdf","version":"Published Version"},"id":"S04-097.24-011684","identifier":[{"id":"85145022604","type":"scopus"},{"id":"000876726000001","type":"wos"},{"id":"36286254","type":"pmid"}],"ids":["aau-f46327bb-be64-48d2-b8a4-a27761e73718","au-58af8cca-2f4e-4f2f-a266-e2d36acffcec","ku-1475d89e-1675-40fb-88fa-5776182481ed","sdu-8ab1b9aa-8c40-4e58-9d96-ba07ea6f844e"],"keyword":["Clinical Medicine","Clinical Medicine General","Confusion/Delirium","Critical Care","Hospital-Based Clinical Medicine","INTENSIVE-CARE-UNIT","MORTALITY","Neurology/Neurosurgery","Psychiatry","Psychiatry General","Pulmonary/Critical Care","Pulmonary/Critical Care General","VALIDATION"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-7-542759F2AF4CE00DB42CD739C892F8E1"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://curis.ku.dk/ws/files/331361006/Haloperidol_for_the_Treatment.pdf","version":"Published Version"},{"access":"oa","type":"loc","url":"https://pure.au.dk/ws/files/346480265/Haloperidol_for_the_Treatment_of_Delirium_in_ICU_Patients.pdf","version":"Published Version"},{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/221722194/Haloperidol_for_the_Treatment_of_Delirium_in_ICU_Patients.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Univer