{"abstract":"The aim of this study was to compare quality-adjusted life expectancy (QALE) for patients with rheumatoid arthritis generated from three generic health-related quality-of-life instruments.","author_count":4,"contributors":["Sørensen, Jan","Linde, Louise","Østergaard, Mikkel","Hetland, Merete Lund"],"cuid":["S02-098.81-044279"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-OTH"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-OTH","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"quality adjusted life expectancies in patients with rheumatoid arthritis comparison of index scores from eq 000000000005d 000000000015d and sf 000000000006d","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.jval.2011.09.010","version":"Other Version"},"id":"S02-098.81-044279","identifier":[{"id":"84858634670","type":"scopus"},{"id":"22433765","type":"pmid"}],"ids":["ku-8d4bebdf-5165-413a-b153-0992dde4e2ac","sdu-6a5743f3-60af-4f90-a14c-7f8d434833a6"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-CF836B90C0A998DC55116EFAE60441F4"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.jval.2011.09.010","version":"Other Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Public Health, Centre for Applied Health Services Research"],"nora_co