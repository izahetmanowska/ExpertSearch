mettepau","last":"Thunø","name":"Thunø, Mette","rank":13,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ole","key":"wæverolepau","last":"Wæver","name":"Wæver, Ole","rank":14,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Governmental Institutions","All Miscellaneous","All Universities","Copenhagen Business School","DI-ALL","DI-GV","DI-GV-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Governmental Institutions","Miscellaneous","Other Research","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["cbs-1c4d7110-f284-474e-a0ba-33ce5d45d371","sdu-d9fdc950-5f51-4147-ac32-ccc523200f53"],"src":["CBS Copenhagen Business School","SDU University of Southern Denmark"],"title":"CMS Notat: Forværringen af det kinesisk-amerikanske forhold : en strategisk udfordring for Danmark","type":"Memorandum/Exposition","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-090.83-031207","year":"2020","yearsub":"2020"}
{"abstract":"Changeable manufacturing and platform-based co-development of products and manufacturing systems are becoming increasingly relevant for industrial manufacturing in order to respond to volatile markets, increased product variety and shorter product life cycles. However, in order to conduct platform-based co-development, it is necessary to manage the relations between the product domain and the manufacturing domain. This paper proposes an approach and meta-model for developing company-specific ontologies, which can be used for modelling the portfolio of components, processes and equipment and their interrelations as a basis for co-evolution. Developing such a model has implications for developing and utilising changeable manufacturing, which is also analysed in this paper.","author_count":5,"contributors":["Brunø, Thomas Ditlev","Andersen, Ann-Louise","Sorensen, Daniel G. H.","Nielsen, Kjeld","Bejlegaard, Mads"],"cuid":["S01-000.00-068001"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Brunø, Thomas Ditlev"],"keyword":["Changeable manufacturing","Co development","Integrated modelling","Modelling","Process ontology","Reconfigurable manufacturing"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"integrated product process modelling for platform based co development","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85073965135&partnerID=8YFLogxK","version":"Other Version"},"id":"S01-000.00-068001","identifier":[{"id":"85073965135","type":"scopus"}],"ids":["aau-3de6f14d-a1fb-4060-8b1c-6c450f88f1cc"],"keyword":["changeable manufacturing","co-development","integrated modelling","manufacturing ontology","modelling","process ontology","reconfigurable manufacturing"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-68ED577839870F8F1173B2ED1BF3CBD8"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, Department of Materials and Production","Aalborg University, The Faculty of Engineering and Science, Department of Materials and Production, Production","Aalborg University, The Faculty of Engineering and Science, Department of Materials and Production, Sustainable Manufacturing Systems research group"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Thomas Ditlev","key":"brunoepau","last":"Brunoe","locid":"b75a6b6d-0181-4141-b951-6f7f70bae83f","name":"Brunø, Thomas Ditlev","name_org":"Brunoe, Thomas Ditlev","orcid":"0000-0002-9847-6562","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ann Louise","key":"andersenpau","last":"Andersen","locid":"73d5c9b6-ff83-41c1-b16e-43f380f384d9","name":"Andersen, Ann-Louise","name_org":"Andersen, Ann Louise","orcid":"0000-0002-7923-6301","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Daniel G.H.","key":"sorensenpau","last":"Sorensen","locid":"7c8e8d62-a3ee-4398-8d8a-c4c514667546","name":"Sorensen, Daniel G. H.","name_org":"Sorensen, Daniel G.H.","orcid":"0000-0001-9395-2411","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kjeld","key":"nielsenpau","last":"Nielsen","locid":"751dd7bc-910a-485d-bb72-90f82f361a21","name":"Nielsen, Kjeld","orcid":"0000-0003-3095-4801","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mads","key":"bejlegaardpau","last":"Bejlegaard","locid":"b398f49a-637e-4972-8c1a-869b17d48eaf","name":"Bejlegaard, Mads","orcid":"0000-0002-8916-3601","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1080/00207543.2019.1671628","issn":["00207543","1366588X"],"issn_org":["00207543"],"issue":"20","journal":"International Journal of Production Research","pages":"6185-6201","publisher":"Taylor & Francis","status":"p","title":"International Journal of Production Research","volume":"58"},"review":"Peer Reviewed","scoID":["2-s2.0-85073965135"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-3de6f14d-a1fb-4060-8b1c-6c450f88f1cc"],"src":["AAU Aalborg University"],"title":"Integrated product-process modelling for platform-based co-development","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-068001","year":"2020","yearsub":"2020"}
{"abstract":"Background: New sensitive techniques have revealed a thriving bacterial community in the human urinary tract, challenging the perception that urine in healthy humans is sterile. While the functional role of this urinary microbiota is unknown, dysbiosis has been linked to urgency urinary incontinence and risk of urinary tract infections. When comparing studies, it is crucial to account for possible confounders introduced due to methodological differences. Here we investigated whether collection and storage conditions had any impact on the urinary microbial composition. Results: For comparison of different storage conditions, midstream urine was collected from five healthy adult female donors and analyzed by 16S rRNA gene sequencing. Samples stored at −80 and −20°C, but not 4°C, were found to be comparable to freshly handled voided urine. Using the same methods, the daily or day-to-day variation in urinary microbiota was investigated in 19 healthy donors, including four women, five men, five girls, and five boys. Apart from two male adult donors, none of the tested conditions gave rise to significant differences in alpha and beta diversities between individuals. Conclusion: The composition of voided urinary microbiota was found to be effectively maintained by freezing, but not storage at 4°C. In addition, we did not observe any intrapersonal daily or day-to-day variations in microbiota composition in women, girls or boys. Together our study supports present methodologies that can be used in future studies investigating the urinary microbiota.","author_count":9,"contributors":["Bundgaard-Nielsen, Caspar","Ammitzbøll, Nadia","Isse, Yusuf Abdi","Muqtar, Abdisalam","Jensen, Ann-Maria","Leutscher, Peter Derek Christian","Arenholt, Louise Thomsen Schmidt","Hagstrøm, Søren","Sørensen, Suzette"],"cuid":["S01-000.00-101399"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Sørensen, Suzette"],"keyword":["Bacteria","DNA extraction","Microbiome","Microbiota","Specimen Handling","Urine"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"voided urinary microbiota is stable over time but impacted by post void storage","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.3389/fcimb.2020.00435","version":"Published Version"},"funding_acknowledgement":["This manuscript has been released as a pre-print, at BioRxiv (Bundgaard-Nielsen et al., 2019). Funding. This study was funded by the North Denmark Regional Hospital. The hospital was involved neither in study design, sample collection, analysis and interpretation of data, nor in preparation of the manuscript."],"id":"S01-000.00-101399","identifier":[{"id":"85090785353","type":"scopus"},{"id":"32984068","type":"pmid"}],"ids":["aau-b0fa41d3-bb88-4f53-8738-d0b61eb65d01"],"keyword":["DNA extraction","bacteria","microbiome","microbiota","specimen handling","urine","urine storage"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-DD2D93220FA33C5F8E37564C561C7998"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.3389/fcimb.2020.00435","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/361094717/Bundgaard_Nielsen_et_al_2020_Voided_Urinary_Microbiota_Is_Stable_Over_Time_but_Impacted_by_Post_Void_Storage.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine, Center for Clinical Research","Aalborg University, The Faculty of Medicine, North Denmark Regional Hospital"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Caspar","key":"bundgaardnielsenpau","last":"Bundgaard-Nielsen","locid":"621f32eb-b0ed-4146-bed9-a4b793ee401d","name":"Bundgaard-Nielsen, Caspar","orcid":"0000-0002-2700-2378","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Nadia","key":"ammitzbøllpau","last":"Ammitzbøll","locid":"998438bb-addc-4afc-b906-dcd21786cba2","name":"Ammitzbøll, Nadia","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Yusuf Abdi","key":"issepau","last":"Isse","locid":"aa17652a-5af0-4cdd-a704-d5550f08db1e","name":"Isse, Yusuf Abdi","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Abdisalam","key":"muqtarpau","last":"Muqtar","locid":"1a6b7bf6-76dd-4eeb-a9dc-1f5dfed60551","name":"Muqtar, Abdisalam","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ann Maria","key":"jensenpau","last":"Jensen","locid":"b63dffe4-c4a2-410a-a9d9-5f75f27f0e0e","name":"Jensen, Ann-Maria","name_org":"Jensen, Ann Maria","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Peter D.C.","key":"leutscherpau","last":"Leutscher","locid":"56e8c48e-c3f9-4a4d-8b9b-0719c74da258","name":"Leutscher, Peter Derek Christian","name_org":"Leutscher, Peter D.C.","orcid":"0000-0003-1168-4041","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Louise Thomsen Schmidt","key":"arenholtpau","last":"Arenholt","locid":"9fe53819-b8b7-4220-8f9f-125eb33881e8","name":"Arenholt, Louise Thomsen Schmidt","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren","key":"hagstrømpau","last":"Hagstrøm","locid":"fe472f53-6bcd-4587-8287-df1539f689c3","name":"Hagstrøm, Søren","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Suzette","key":"sørensenpau","last":"Sørensen","locid":"c96d8309-747c-403d-a858-2efad1aea498","name":"Sørensen, Suzette","orcid":"0000-0002-4201-1168","rank":9,"rolecode":"pau"}],"pmid":["32984068"],"pub":{"doi":"10.3389/fcimb.2020.00435","issn":["22352988"],"journal":"Frontiers in Cellular and Infection Microbiology","paperid":"435","publisher":"Frontiers Media SA","status":"p","title":"Frontiers in Cellular and Infection Microbiology","volume":"10"},"review":"Peer Reviewed","scoID":["2-s2.0-85090785353"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-b0fa41d3-bb88-4f53-8738-d0b61eb65d01"],"src":["AAU Aalborg University"],"title":"Voided Urinary Microbiota Is Stable Over Time but Impacted by Post Void Storage","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-101399","year":"2020","yearsub":"2020"}
{"abstract":"Bladder dysfunction may occur in acute stroke patients and as a consequence the risk of urinary retention, incontinence and urinary tract infections increases. The literature is sparse regarding occurrence of bladder dysfunction in acute stroke and if catheterization should be performed to prevent bladder overdistension in acute stroke thrombolysis. The aim of this study was to investigate the safety of implementing a new selective and “watchful waiting strategy” for intermittent catheterization during acute stroke thrombolysis. From November 2018 to June 2019, we conducted a prospective cohort study before and after implementing (in March 2019) a selective and watchful waiting strategy for intermittent catheterization. Data were collected on nurse-administered registration forms for ischemic stroke patients treated with thrombolysis. In both periods urogenital complications were registered. We found no significant differences between period 1 (before) and 2 (after) in the occurrence of urinary tract infections and/or macroscopic urogenital bleeding episodes. However, for developing blood in the 24hour urine analysis we found a significant reduction in period 2 compared to period 1, 8 (23%) vs 3 (7%) respectively. Applying a selective and watchful waiting strategy towards urinary catheterization in acute ischemic stroke patients treated with intravenous thrombolysis did not increase the risk of urogenital complications, and the discomfort associated with catheterization was limited to fewer patients.","author_count":6,"contributors":["Eiskjær Sørensen, Kristina","Blauenfeldt, Rolf Ankerlund","Kjøbsted Markvardsen, Anne","Thorsted, Louise Mose","Lehd, Bitten Nørret","Andersen, Grethe"],"cuid":["S01-000.00-137397"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Stroke","Thrombolysis","Urinary Catheterization"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"urinary catheterisation in acute stroke patients treated with intravenous thrombolysis","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-137397","ids":["au-0e0f509e-73d5-4dce-aa02-b0d1d4123b14"],"keyword":["Stroke","Urinary Catheterization","thrombolysis"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-2-D8240CE685A65BA9B2EBE5E3228D85B5"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Department of Neurology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Kristina","key":"eiskjærsørensenpau","last":"Eiskjær Sørensen","locid":"c707b014-a03a-421a-85f1-c9060987aa8b","name":"Eiskjær Sørensen, Kristina","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rolf","key":"blauenfeldtpau","last":"Blauenfeldt","locid":"2cc4cfa1-de55-413c-b008-6b5d1c275888","name":"Blauenfeldt, Rolf Ankerlund","name_org":"Blauenfeldt, Rolf","orcid":"0000-0002-4846-9516","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anne","key":"kjøbstedmarkvardsenpau","last":"Kjøbsted Markvardsen","locid":"bea441a6-1d4f-4847-9464-80e9a44af2b4","name":"Kjøbsted Markvardsen, Anne","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Louise Mose","key":"thorstedpau","last":"Thorsted","locid":"2ab70822-56b8-4b78-82e0-5d2ed1584a9e","name":"Thorsted, Louise Mose","rank":4,"rolecode":"pau"},{"affno":"1","corresp