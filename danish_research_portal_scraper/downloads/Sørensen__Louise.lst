{"author_count":7,"contributors":["Andersen, Ann-Louise","Brunø, Thomas Ditlev","Christensen, Bjørn","Bejlegaard, Mads","Sorensen, Daniel G. H.","Nielsen, Kjeld"],"cuid":["S01-000.00-071681"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"tailored reconfigurability a comparative study of eight industrial cases with reconfigurability as a key to manufacturing competitiveness","src":["aau"],"src-code":["DI-U-AAU"],"type":"dba","type-grp":["all","pub"]},"id":"S01-000.00-071681","identifier":[{"id":"85090174333","type":"scopus"}],"ids":["aau-4aa7cf6c-0601-481b-8fbb-63a44eff1737"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-F30523333F07D57E34E7ACF5690D8E82"],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, Department of Materials and Production","Aalborg University, The Faculty of Engineering and Science, Department of Materials and Production, Production","Aalborg University, The Faculty of Engineering and Science, Department of Materials and Production, Sustainable Manufacturing Systems research group"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Ann-Louise","key":"andersenpau","last":"Andersen","locid":"73d5c9b6-ff83-41c1-b16e-43f380f384d9","name":"Andersen, Ann-Louise","orcid":"0000-0002-7923-6301","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","