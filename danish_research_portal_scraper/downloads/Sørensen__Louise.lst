{"author_count":5,"contributors":["Williams, Charlotte Amdi","Moustsen, Vivi","Sørensen, G.","Oxholm, Louise C.","Hansen, Christian Fink"],"cuid":["S01-000.00-404178"],"event":{"end":"2014-08-29","place":"Copenhagen, dk","start":"2014-08-25","title":"The 65th Annual Meeting of the European Federation of Animal Science","year":"2014"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["The National Committee for Pig Production, Denmark"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"saliva cortisol levels of nurse sows and ordinary sows through lactation","src":["ku"],"src-code":["DI-U-KU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://www.eaap.org/Previous_Annual_Meetings/2014Copenhagen/Copenhagen_2014_Abstracts.pdf","version":"Published Version"},"id":"S01-000.00-404178","ids":["ku-121cba00-a114-454f-b281-acba8ffe7a92"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-00AF7F5E68DF8D154BFA0974EAD116E8"],"oa_link":[{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/122667056/SSUNDMFP6414082913201.pdf","version":"Pre-print"},{"access":"oa","type":"rem","url":"http://www.eaap.org/Previous_Annual_Meetings/2014Copenhagen/Copenhagen_2014_Abstracts.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Veterinary Clinical Sciences, Section for Animal Welfare and Disease Control","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Veterinary and Animal Sciences, Section for Production and Health"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["The National Committee for Pig Production, Denmark"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","first":"Charlotte Amdi","key":"williamspau","last":"Williams","locid":"8057561d-85f5-4717-ba1e-18a709a9f121","name":"Williams, Charlotte Amdi","rank":1,"rolecode":"pau"},{"affno":"2","first":"Vivi","key":"moustsenpau","last":"Moustsen","name":"Moustsen, Vivi","rank":2,"rolecode":"pau"},{"affno":"2","first":"G.","key":"sørensenpau","last":"Sørensen","name":"Sørensen, G.","rank":3,"rolecode":"pau"},{"affno":"","first":"Louise C.","key":"oxholmpau","last":"Oxholm","name":"Oxholm, Louise C.","rank":4,"rolecode":"pau"},{"affno":"1","first":"Christian Fink","key":"hansenpau","last":"Hansen","locid":"ef8ae189-429f-4359-9423-4608b7504810","name":"Hansen, Christian Fink","rank":5,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-121cba00-a114-454f-b281-acba8ffe7a92"],"src":["KU University of Copenhagen"],"title":"Saliva cortisol levels of nurse sows and ordinary sows through lactation","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-404178","year":"2014","yearsub":"2014"}
{"abstract":"One of the clearly stated intentions of the Intergovernmental Platform on Biodiversity and Ecosystem Services (IPBES) is to bring both \"western scientific\" and \"indigenous and local\" knowledge systems within synthetic global, regional, and thematic assessments. A major challenge will be how to use, and quality-assure, information derived from different knowledge systems. We test how indigenous and local knowledge on natural resources in Miskito and Mayangna communities in Nicaragua, validated through focus groups with community members, compares with information collected on line transects by trained scientists. Both provide comparable data on natural resource abundance, but focus groups are eight times cheaper. Such approaches could increase the amount and geographical scope of information available for assessments at all levels, while simultaneously empowering indigenous and local communities who generally have limited engagement in such processes.","author_count":12,"contributors":["Danielsen, Finn","Jensen, Per Moestrup","Burgess, Neil David","Coronado, Indiana","Holt, Sune","Poulsen, Michael K.","Rueda, Ricardo M.","Skielboe, Thomas","Enghoff, Martin","Hemmingsen, Louise H.","Sørensen, Marten","Pirhofer-Walzl, Karin"],"cuid":["S01-000.00-527908"],"filters":{"added":"2022-09","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, Central"],"country":["Nicaragua"],"glorg":["All Global Affiliations","National Autonomous University of Nicaragua"],"keyword":["Community based natural resource management","Cross cultural management","Intergovernmental Platform on Biodiversity and Ecosystem Services","Knowledge integration"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Nordisk Fond for Miljø og Udvikling"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"testing focus groups as a tool for connecting indigenous and local knowledge on abundance of natural resources with science based land management systems","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1111/conl.12100","version":"Published Version"},"id":"S01-000.00-527908","identifier":[{"id":"84899408297","type":"scopus"},{"id":"000341649200005","type":"wos"}],"ids":["ku-e10c5316-962b-43fc-8362-2f463144b670"],"keyword":["Community-based natural resource management","Cross-cultural management","Indigenous and local knowledge systems","Intergovernmental Platform on Biodiversity and Ecosystem Services","Knowledge integration","Multiple evidence base"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-8A30FBD7CCEF25AD2780F872A23B2B1C"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1111/conl.12100","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/315541316/Conservation_Letters_2014_Danielsen_Testing_Focus_Groups_as_a_Tool_for_Connecting_Indigenous_and_Local_Knowledge_on.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Nordisk Fond for Miljø og Udvikling"],"nora_code":"DI-OT","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Plant and Environmental Sciences, Section for Organismal Biology"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"ni","key":"national autonomous university of nicaragua","loc":["Nicaragua","America, Central"],"name":"National Autonomous University of Nicaragua","used":1}],"person":[{"affno":"1","first":"Finn","key":"danielsenpau","last":"Danielsen","name":"Danielsen, Finn","rank":1,"rolecode":"pau"},{"affno":"2","first":"Per M.","key":"jensenpau","last":"Jensen","locid":"109722d0-87a3-4044-857a-c1cec95d608f","name":"Jensen, Per Moestrup","name_org":"Jensen, Per M.","orcid":"0000-0001-8792-7711","rank":2,"rolecode":"pau"},{"affno":"2","first":"Neil D.","key":"burgesspau","last":"Burgess","locid":"a3ed6228-ead8-44da-8a6c-a23cd048f9cf","name":"Burgess, Neil David","name_org":"Burgess, Neil D.","rank":3,"rolecode":"pau"},{"affno":"3","first":"Indiana","key":"coronadopau","last":"Coronado","name":"Coronado, Indiana","rank":4,"rolecode":"pau"},{"affno":"3","first":"Sune","key":"holtpau","last":"Holt","name":"Holt, Sune","rank":5,"rolecode":"pau"},{"affno":"1","first":"Michael K.","key":"poulsenpau","last":"Poulsen","name":"Poulsen, Michael K.","rank":6,"rolecode":"pau"},{"affno":"3","first":"Ricardo M.","key":"ruedapau","last":"Rueda","name":"Rueda, Ricardo M.","rank":7,"rolecode":"pau"},{"affno":"1","first":"Thomas","key":"skielboepau","last":"Skielboe","name":"Skielboe, Thomas","rank":8,"rolecode":"pau"},{"affno":"1","first":"Martin","key":"enghoffpau","last":"Enghoff","name":"Enghoff, Martin","rank":9,"rolecode":"pau"},{"affno":"1","first":"Louise H.","key":"hemmingsenpau","last":"Hemmingsen","name":"Hemmingsen, Louise H.","rank":10,"rolecode":"pau"},{"affno":"2","first":"Marten","key":"sørensenpau","last":"Sørensen","locid":"af82fbdf-6238-4072-9f46-8b805af24a4e","name":"Sørensen, Marten","orcid":"0000-0001-6921-5366","rank":11,"rolecode":"pau"},{"affno":"1","first":"Karin","key":"pirhoferwalzlpau","last":"Pirhofer-Walzl","name":"Pirhofer-Walzl, Karin","rank":12,"rolecode":"pau"}],"pub":{"doi":"10.1111/conl.12100","issn":["1755263X"],"issue":"4","journal":"Conservation Letters","pages":"380-389","status":"p","title":"Conservation Letters","volume":"7"},"review":"Peer Reviewed","scoID":["2-s2.0-84899408297"],"search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-e10c5316-962b-43fc-8362-2f463144b670"],"src":["KU University of Copenhagen"],"title":"Testing Focus Groups as a Tool for Connecting Indigenous and Local Knowledge on Abundance of Natural resources with Science-Based Land Management Systems","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-527908","year":"2014","yearsub":"2014"}
{"abstract":"Objectives To assess systematically the role of maternal vitamin D levels in fetal bone growth. Methods PubMed, EMBASE and Cochrane databases were searched using the search words [Vitamin D] in combination with [fetal, fetus, intrauterine, or prenatal AND growth, development, bone, femur, or humerus]; [crown-rump length]; or [ultrasonography, prenatal]. Criteria for inclusion in this systematic review were data on maternal serum 25-hydroxyvitamin D (25(OH)D) during pregnancy and measurement of fetal growth by ultrasound. Results We identified 750 publications initially, from which five observational studies were selected for inclusion in the final review. The parameters studied were humerus length (HL) and femur length (FL) and their Z-scores, femoral volume, femoral distal metaphyseal cross-sectional area (CSA), femoral proximal metaphyseal diameter (PMD), femoral mid-shaft diameter and crown-rump length. In one study, 25(OH)D was associated directly with FL; in another study 25(OH)D only correlated with FL and HL Z-scores when calcium intake was insufficient. Two studies found no association between 25(OH)D and FL, but detected a direct association with femoral PMD, and an inverse relation with femoral distal metaphyseal CSA, respectively. Conclusions Observational studies investigating the role of maternal vitamin D levels in fetal bone growth are sparse. Their evidence suggests that low maternal 25(OH)D levels may affect fetal bone growth under certain circumstances, especially in cases of simultaneous low calcium intake. Further studies are necessary.","author_count":4,"contributors":["Galthen-Sørensen, Mathias","Andersen, Louise Bjørkholt","Sperling, Lene","Christesen, Henrik Thybo"],"cuid":["S01-000.00-590369"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Biomarkers blood","Bone Development physiology","Crown Rump Length","Female","Femur diagnostic imaging","Fetal Development physiology","Fetal growth","Humans","Humerus diagnostic imaging","Intrauterine growth restriction","Pregnancy","Ultrasonography Prenatal","Ultrasound","Vitamin D","Vitamin D analogs derivatives"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-SDR","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"maternal 000000000025 hydroxyvitamin d level and fetal growth assessed by ultrasound a systematic review","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1002/uog.13431","version":"Other Version"},"id":"S01-000.00-590369","identifier":[{"id":"84914156408","type":"scopus"},{"id":"24891235","type":"pmid"}],"ids":["sdu-3bdb8f91-1834-448c-b972-82ce096ccc93"],"keyword":["Biomarkers/blood","Bone Development/physiology","Crown-Rump Length","Female","Femur/diagnostic imaging","Fetal Development/physiology","Fetal bone formation","Fetal growth","Humans","Humerus/diagnostic imaging","Intrauterine growth restriction","Pregnancy","Ultrasonography, Prenatal","Ultrasound","Vitamin D","Vitamin D/analogs & derivatives"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-1CB9596E9CF110A43A6AE3FF19452A8E"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1002/uog.13431","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Odense University Hospital"],"nora_code":"DI-HO-SDR","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Paediatrics (Odense)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Mathias","key":"galthensørensenpau","last":"Galthen-Sørensen","name":"Galthen-Sørensen, Mathias","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Louise Bjørkholt","key":"andersenpau","last":"Andersen","locid":"26e73134-b29b-450a-b9fd-b71c20be9185","name":"Andersen, Louise Bjørkholt","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lene","key":"sperlingpau","last":"Sperling","locid":"d93276e2-5dab-4099-a4d6-36b2952473ba","name":"Sperling, Lene","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Henrik T","key":"christesenpau","last":"Christesen","locid":"c8317e72-7a09-4c80-81e9-b69855b68e8f","name":"Christesen, Henrik Thybo","name_org":"Christesen, Henrik T","orcid":"0000-0001-5330-6853","rank":4,"rolecode":"pau"}],"pmid":["24891235"],"pub":{"doi":"10.1002/uog.13431","issn":["09607692","14690705"],"issn_org":["09607692"],"issue":"6","journal":"Ultrasound in Obstetrics & Gynecology","pages":"633-640","publisher":"Wiley","status":"p","title":"Ultrasound in Obstetrics & Gynecology","title_org":"Ultrasound in obstetrics & gynecology : the official journal of the International Society of Ultrasound in Obstetrics and Gynecology","volume":"44"},"review":"Peer Reviewed","scoID":["2-s2.0-84914156408"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-3bdb8f91-1834-448c-b972-82ce096ccc93"],"src":["SDU University of Southern Denmark"],"title":"Maternal 25-Hydroxyvitamin D Level and Fetal Growth assessed by Ultrasound : A systematic Review","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-590369","year":"2014","yearsub":"2014"}
{"abstract":"Objectives. To investigate travel time, and travel cost related to contacts with health care providers for patients with rheumatoid arthritis (RA) during a three-month period. Methods. Patient-reported travel time and travel cost were obtained from 2847 patients with RA. Eleven outpatient clinics across Denmark recruited patients to the study. Data collected included frequency, travel time and travel costs for contacts at rheumatology outpatient clinics, other outpatient clinics, general practitioners, privately practicing medical specialists, inpatient hospitals and accident and emergency departments. Results. Over a 3-month period, patients with RA had on average 4.4 (sd 5.7) contacts with health care providers, of which 2.8 (sd 4.0) contacts were with rheumatology outpatient clinics. Private car and public travel were the most frequent modes of travel. The average patient spent 63 minutes and 13 on travelling per contact, corresponding to a total of 4.6 hours and 56 during the 3-month period. There was great variation in patient travel time and costs, but no statistically significant associations were found with clinical and sociodemographic characteristics. Conclusion. The results show that patients with RA spend private time and costs on travelling when they seek treatment. These findings are particularly important when analyzing social costs associated with RA.","author_count":3,"contributors":["Sørensen, Jan","Linde, Louise","Hetland, Merete Lund"],"cuid":["S01-000.00-627649"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"contact frequency travel time and travel costs for patients with rheumatoid arthritis","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1155/2014/285951","version":"Other Version"},"id":"S01-000.00-627649","identifier":[{"id":"84896281464","type":"scopus"},{"id":"PMC3947701","type":"pmcid"},{"id":"24693288","type":"pmid"}],"ids":["sdu-bdd6119c-1efd-4a66-999d-9bf3bb1e9422"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-6A85A7E73F90DB4E5409C33D9C1152B2"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1155/2014/285951","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Business and Social Sciences, Department of Economics, COHERE","SDU, The Faculty of Health Sciences, Department of Public Health, Centre for Applied Health Services Research"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jan","key":"sørensenpau","last":"Sørensen","locid":"239cd9bd-c49f-497e-9e4c-5fc8275d360b","name":"Sørensen, Jan","orcid":"0000-0003-0857-9267","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Louise","key":"lindepau","last":"Linde","name":"Linde, Louise","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Merete Lund","key":"hetlandpau","last":"Hetland","name":"Hetland, Merete Lund","rank":3,"rolecode":"pau"}],"pmid":["24693288"],"pub":{"doi":"10.1155/2014/285951","issn":["16879260","16879279"],"issn_org":["16879260"],"journal":"International Journal of Rheumatology","paperid":"285951","publisher":"Wiley","status":"p","title":"International Journal of Rheumatology","volume":"2014"},"review":"Peer Reviewed","scoID":["2-s2.0-84896281464"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-bdd6119c-1efd-4a66-999d-9bf3bb1e9422"],"src":["SDU University of Southern Denmark"],"title":"Contact frequency, travel time, and travel costs for patients with rheumatoid arthritis","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-627649","year":"2014","yearsub":"2014"}
