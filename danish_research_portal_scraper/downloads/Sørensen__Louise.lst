-0fee79e488b9","name":"Laursen, Christian B","name_org":"Laursen, Christian B.","orcid":"0000-0001-6382-9906","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Daniel Kiehn Wange","key":"wittrockpau","last":"Wittrock","locid":"814a1c3f-d86f-459a-93c4-1cb18d4dc813","name":"Wittrock, Daniel","name_org":"Wittrock, Daniel Kiehn Wange","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Giti","key":"nadimpau","last":"Nadim","locid":"3999e047-8c43-4732-a2e6-1a8d4dc40adb","name":"Nadim, Giti","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Gitte","key":"jørgensenpau","last":"Jørgensen","name":"Jørgensen, Gitte","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Lars Bak","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Lars Bak","rank":6,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Michael","key":"sørensenpau","last":"Sørensen","name":"Sørensen, Michael","rank":7,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Caroline L","key":"heeremapau","last":"Heerema","name":"Heerema, Caroline L","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ingrid Louise","key":"titlestadpau","last":"Titlestad","locid":"67905117-c8b6-4567-b11a-11abb0621cc2","name":"Titlestad, Ingrid Louise","orcid":"0000-0001-6418-0088","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Annmarie Touborg","key":"lassenpau","last":"Lassen","locid":"80e651b5-e70f-43e0-baf8-e88335ac10b8","name":"Lassen, Annmarie Touborg","orcid":"0000-0003-4942-6152","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren","key":"mikkelsenpau","last":"Mikkelsen","locid":"7df86a29-c6dc-4919-a9f9-6f5c23591e1d","name":"Mikkelsen, Søren","orcid":"0000-0002-5187-7027","rank":11,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-a86c5efa-426a-4f54-8769-533aeac8d5bf"],"src":["SDU University of Southern Denmark"],"title":"Patients’ perspectives on point-of-care diagnostics and treatment by emergency medical technicians in acute COPD exacerbations - a Qualitative study","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-621434","year":"2020","yearsub":"2020"}
{"abstract":"Spinal cord injury (SCI) is a devastating condition consisting of an instant primary mechanical injury followed by a secondary injury that progresses for weeks to months. The cytokine tumor necrosis factor (TNF) plays an important role in the pathophysiology of SCI. We investigated the effect of myeloid TNF ablation (peripheral myeloid cells (macrophages and neutrophils) and microglia) versus central myeloid TNF ablation (microglia) in a SCI contusion model. We show that TNF ablation in macrophages and neutrophils leads to reduced lesion volume and improved functional outcome after SCI. In contrast, TNF ablation in microglia only or TNF deficiency in all cells had no effect. TNF levels tended to be decreased 3 h post-SCI in mice with peripheral myeloid TNF ablation and was significantly decreased 3 days after SCI. Leukocyte and microglia populations and all other cytokines (IL-1β, IL-2, IL-4, IL-5, IL-6, IL-10, IL-12, and IFNγ) and chemokines (CCL2, CCL5, and CXCL1) investigated, in addition to TNFR1 and TNFR2, were comparable between genotypes. Analysis of post-SCI signaling cascades demonstrated that the MAPK kinase SAPK/JNK decreased and neuronal Bcl-XL levels increased post-SCI in mice with ablation of TNF in peripheral myeloid cells. These findings demonstrate that peripheral myeloid cell-derived TNF is pathogenic in SCI.","author_count":14,"contributors":["Ellman, Ditte Gry","Lund, Minna Christiansen","Nissen, Maiken","Nielsen, Pernille Vinther","Sørensen, Charlotte","Lester, Emilie Boye","Pedersen, Estrid Thougaard","Jørgensen, Louise Helskov","Nedospasov, Sergei","Andersen, Ditte Caroline","Stubbe, Jane","Brambilla, Roberta","Degn, Matilda","Lambertsen, Kate Lykke"],"cuid":["S01-000.00-627549"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Europe, Non-EU","OECD"],"corresponding_author":["Lambertsen, Kate Lykke"],"country":["Russia","United States"],"glorg":["All Global Affiliations","Moscow State University","University of Miami"],"keyword":["Functional outcome","Myeloid Cells","Spinal cord injury","Tumor necrosis factor"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"conditional ablation of myeloid tnf improves functional outcome and decreases lesion size after spinal cord injury in mice","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/cells9112407","version":"Published Version"},"id":"S01-000.00-627549","identifier":[{"id":"85095739894","type":"scopus"},{"id":"PMC7692197","type":"pmcid"},{"id":"33153044","type":"pmid"}],"ids":["sdu-bd8018e1-835a-4c77-aff4-de86b80805ea"],"keyword":["functional outcome","myeloid cells","spinal cord injury","tumor necrosis factor"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-FD92FA0C70FEF82D3D0A96D13F61BD7F"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/174294973/Ellman_Lund_et_al._2020.pdf","version":"Other Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/cells9112407","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Molecular Medicine, Neurobiology Research Unit"],"nora_code":"DI-U-SDU","used":1},{"affno"