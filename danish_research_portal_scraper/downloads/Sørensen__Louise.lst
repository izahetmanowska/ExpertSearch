ecode":"pau"}],"pub":{"isbn":["9789290922544"],"publisher":"European Space Agency","status":"p","subtitle":"CD","title":"Proceedings of Cryosat Validation Workshop 2011"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-U","DI-U-ALL","Governmental Institutions","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-a865527d-6538-4c9f-a9bf-4b1db21ff2dc"],"src":["DTU Technical University of Denmark"],"title":"Initial results of CryoSat-2 data from the Arctic","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-354841","year":"2011","yearsub":"2011"}
{"abstract":"The project has aimed to characterize mesoscale meteorological phenomenon for the North Sea and the Inner Danish waters, and additionally aimed on improving the predictability and quality of the power production from offshore windfarms. The meso-scale meteorology has been characterized with respect to the physical processes, climatology, spectral characteristics and correlation properties based on measurements from wind farms, satellite data (SAR) and mesoscale numerical modeling (WRF). The abilities of the WRF model to characterize and predict relevant mesoscale phenomenon has been proven. Additionally application of statistical forecasting, using a Markov switching approach that can be related to the meteorological conditions, to analyze and short term predict the power production from an offshore wind farms have been documented. Two PhD studies have been conducted in connection with the project. The project has been a cooperative project between Risø DTU, IMM DTU, DONG Energy, Vattenfall and VESTAS. It is registered as Energinet.dk, project no. 2007-1-7141.","author_count":8,"contributors":["Larsen, Søren Ejling","Larsén, Xiaoli Guo","Vincent, Claire Louise","Sørensen, Poul Ejnar","Pinson, Pierre","Trombe, Pierre-Julien","Madsen, Henrik","Cutululis, Nicolaos Antonio"],"cuid":["S01-000.00-360423"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"nr","rtype":["clu"],"sorti":"meso scale wind variability final report","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/6305535/ris-r-1794.pdf","version":"Published Version"},"id":"S01-000.00-360423","ids":["dtu-bacc4f01-72cc-4cdb-a9fe-acc34def8ec0"],"keyword":["Risø-R-1794","Risø-R-1794(EN)"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-4A0C2D1F6974158A6E162DCB79D7273B"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/6305535/ris-r-1794.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Risø National Laboratory for Sustainable Energy","Technical University of Denmark, Risø National Laboratory for Sustainable Energy, Wind Energy Division","Technical University of Denmark, Risø National Laboratory for Sustainable Energy, Wind Energy Division, Meteorology"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Søren Ejling","key":"larsenpau","last":"Larsen","locid":"6fc30efb-9800-4fe7-ba37-bee5bf5243f3","name":"Larsen, Søren Ejling","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Xiaoli Guo","key":"larsénpau","last":"Larsén","locid":"b4f442ea-5cb6-4979-b106-e210895b35d8","name":"Larsén, Xiaoli Guo","orcid":"0000-0001-8696-0720","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Claire Louise","key":"vincentpau","last":"Vincent","locid":"1b742aa9-0506-494a-8134-1c43196b8dcc","name":"Vincent, Claire Louise","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Poul Ejnar","key":"sørensenpau","last":"Sørensen","locid":"9c5c0469-f358-4636-b4ec-06fd7611b939","name":"Sørensen, Poul Ejnar","orcid":"0000-0001-5612-6284","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Pierre","key":"pinsonpau","last":"Pinson","locid":"810ade2b-efce-4959-aab4-9247bc8456b7","name":"Pinson, Pierre","orcid":"0000-0002-1480-0282","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Pierre-Julien","key":"trombepau","last":"Trombe","locid":"893967b4-c6ce-4c9b-bc1d-235272eef340","name":"Trombe, Pierre-Julien","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Henrik","key":"madsenpau","last":"Madsen","locid":"458e950b-adfd-4f2d-8d0d-ef39dee24bea","name":"Madsen, Henrik","orcid":"0000-0003-0690-3713","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Nicolaos Antonio","key":"cutululispau","last":"Cutululis","locid":"8ea3718e-0f10-41a6-906a-ebcc7a8df24b","name":"Cutululis, Nicolaos Antonio","orcid":"0000-0003-2438-1429","rank":8,"rolecode":"pau"}],"pub":{"isbn":["9788755039377"],"issn":["01062840"],"issue":"1794(EN)","pages":"114","place":"Roskilde","publisher":"Danmarks Tekniske Universitet, Risø Nationallaboratoriet for Bæredygtig Energi","repno":"Denmark. Forskningscenter Risoe. Risoe-R, 1794(EN)","series":"Denmark. Forskningscenter Risoe. Risoe-R","status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-bacc4f01-72cc-4cdb-a9fe-acc34def8ec0"],"src":["DTU Technical University of Denmark"],"title":"Meso- scale Wind Variability. Final Report","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-360423","year":"2011","yearsub":"2011"}
{"abstract":"A comprehensive understanding of firn processes is of outmost importance, when estimating present and future changes of the Greenland Ice Sheet. Especially, when remote sensing altimetry is used to assess the state of ice sheets and their contribution to global sea level rise, firn compaction models have been shown to be a key component. Now, remote sensing data can also be used to validate the firn models. Radar penetrating the upper part of the firn column in the interior part of Greenland shows a clear layering. The observed layers from the radar data can be used as an in-situ validation of firn models over large length scales. Here, a simple empirical firn model that is forced with the output of high-resolution (5km) regional climate model (HIRHAM5) is explored. The model is capable of describing a layered structure of the firn column and has previously been used to estimate changes of firn compaction to correct ICESat measurements and assessing the present mass loss of the Greenland ice sheet. Validation of the model against the radar data gives good results and confidence in using the model to answer important questions. Questions such as; how large is the firn compaction correction relative to the changes in the elevation of the surface observed with remote sensing altimetry? What model time resolution is necessary to resolved the observed layering? What model refinements are necessary to give better estimates of the surface mass balance of the Greenland ice sheet from remote sensing altimetry?","author_count":5,"contributors":["Simonsen, S. B.","Stenseng, Lars","Sørensen, Louise Sandberg","Adalgeirsdottir, G.","Hvidberg, C. S."],"cuid":["S01-000.00-379739"],"event":{"end":"2011-12-09","place":"San Francisco, CA, us","start":"2011-12-05","title":"2011 AGU Fall Meeting","year":"2011"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-DMI"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-GV-DMI","DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"validating firn compaction model with remote sensing data","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/87943707/FM11-C32A-08.pdf","version":"Published Version"},"id":"S01-000.00-379739","ids":["dtu-fb275958-d82e-41db-840a-ca9d82d40e8c"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-2569F631B224ED04A01843202731A5BF"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/87943707/FM11-C32A-08.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Space Institute","Technical University of Denmark, National Space Institute, Geodesy"],"nora_code":"DI-U-DTU","used":1},{"affno":"3","country":"dk","key":"dmi danish meteorological institute","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-DMI","l3nn":"DMI Danish Meteorological Institute","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DMI Danish Meteorological Institute","namevar":["Danish Meteorological Institute"],"nora_code":"DI-GV-DMI","used":1}],"person":[{"affno":"1","corresponding":null,"first":"S. B.","key":"simonsenpau","last":"Simonsen","name":"Simonsen, S. B.","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Lars","key":"stensengpau","last":"Stenseng","locid":"c0f908ca-1192-4239-b399-ad14c4d9bc6d","name":"Stenseng, Lars","orcid":"0000-0003-4690-4200","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Louise Sandberg","key":"sørensenpau","last":"Sørensen","locid":"1c6cb90f-da30-48a2-872f-a94b8100749b","name":"Sørensen, Louise Sandberg","orcid":"0000-0002-3771-4061","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"G.","key":"adalgeirsdottirpau","last":"Adalgeirsdottir","name":"Adalgeirsdottir, G.","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"C. S.","key":"hvidbergpau","last":"Hvidberg","name":"Hvidberg, C. S.","rank":5,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","sdg":["13. Climate Action","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-U","DI-U-ALL","Governmental Institutions","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-fb275958-d82e-41db-840a-ca9d82d40e8c"],"src":["DTU Technical University of Denmark"],"title":"Validating firn compaction model with remote sensing data","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-379739","year":"2011","yearsub":"2011"}
