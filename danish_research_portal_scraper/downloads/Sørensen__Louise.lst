":"Borregaard, Britt","orcid":"0000-0003-2702-0231","rank":7,"rolecode":"pau"},{"affno":"2 4","corresponding":null,"first":"Henrik","key":"schmidtpau","last":"Schmidt","locid":"9789920f-4b31-4f28-8211-97afced9d61e","name":"Schmidt, Henrik","rank":8,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jens Flensted","key":"lassenpau","last":"Lassen","locid":"2af194b2-635f-4b62-84c2-26bd7dc3263b","name":"Lassen, Jens Flensted","orcid":"0000-0001-7972-9192","rank":9,"rolecode":"pau"},{"affno":"1 2 3","first":"Jacob Eifer","key":"møllerpau","last":"Møller","locid":"64f4cb89-c3c2-42b2-9547-209a806e4fd3","name":"Møller, Jacob Eifer","orcid":"0000-0003-2873-5845","rank":10,"rolecode":"pau"},{"affno":"1 3","first":"Christian","key":"hassagerpau","last":"Hassager","locid":"49196e5d-0f61-44b2-a6b9-cd6c5f8f3bc2","name":"Hassager, Christian","orcid":"0000-0002-1199-0981","rank":11,"rolecode":"pau"},{"affno":"3 5 1","first":"Helle","key":"søholmpau","last":"Søholm","name":"Søholm, Helle","rank":12,"rolecode":"pau"},{"affno":"1 3","first":"Jesper","key":"kjærgaardpau","last":"Kjærgaard","locid":"10ffadd9-ed9c-4251-954a-a2c12ce83aca","name":"Kjaergaard, Jesper","name_org":"Kjærgaard, Jesper","rank":13,"rolecode":"pau"}],"pmid":["38401709"],"pub":{"doi":"10.1016/j.resuscitation.2024.110151","issn":["03009572","18731570"],"issn_org":["03009572"],"journal":"Resuscitation","paperid":"110151","publisher":"Elsevier","status":"p","title":"Resuscitation","volume":"197"},"review":"Peer Reviewed","scoID":["2-s2.0-85186623820"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-71a5af23-a0d6-47d9-b3fa-d422758c2642","sdu-a8d9276a-4e51-48fb-a82e-eadb04776bd8"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Health-related quality of life and cognitive function after out-of-hospital cardiac arrest; a comparison of prehospital return-of-spontaneous circulation and refractory arrest managed with extracorporeal cardiopulmonary resuscitation","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-725196","year":"2024","yearsub":"2024"}
{"abstract":"INTRODUCTION: The human gut microbiota is associated with gestational diabetes mellitus (GDM), which imposes a risk of developing long-term health problems for mother and child. Most studies on GDM and microbiota have been cross-sectional, which makes it difficult to make any conclusions on causality. Furthermore, it is important to assess if a dysbiotic microbiota is passed from the mother to the child, and then being at risk of developing metabolic health problems later in life. The DANish Maternal and Offspring Microbiome study aims to identify gut microbiota-related factors involved in metabolic dysfunction in women with GDM and their offspring. Importantly, the study design allows for early detection of biological changes associated with later development of metabolic disease. This could provide us with unique tools to support early diagnosis or implement preventative measures. METHODS AND ANALYSIS: Pregnant women are included in the study after the 11-14 weeks' prenatal ultrasound scan and followed throughout pregnancy with enrolment of the offspring at birth. 202 women and 112 children have been included from North Denmark Regional Hospital and Aalborg University Hospital in Denmark. Mother and child are followed until the children reach the age of 5 years. From the mother, we collect faeces, urine, blood, saliva, vaginal fluid and breast milk samples, in addition to faeces and a blood sample from the child. Microbiota composition in biological samples will be analysed using 16S rRNA gene sequencing and compared with demographic and clinical data from medical charts, registers and questionnaires. Sample and data collection will continue until July 2028. ETHICS AND DISSEMINATION: The study protocol has been approved by the North Denmark Region Committee on Health Research Ethics (N20190007). Written informed consent is obtained from all participants prior to study participation. Study results will be published in international peer-reviewed journals and presented at international conferences. The results will also be presented to the funders of the study and study participants.","author_count":7,"contributors":["Rold, Louise Søndergaard","Jensen, Ann-Maria","Arenholt, Louise Thomsen Schmidt","Leutscher, Peter Derek Christian","Ovesen, Per Glud","Hagstrøm, Søren","Sørensen, Suzette"],"cuid":["S02-100.00-761573"],"filters":{"added":"2024-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Sørensen, Suzette"],"keyword":["Adult","Biomarkers blood","Child Preschool","Cohort Studies","Denmark","Diabetes Gestational microbiology","Diabetes in pregnancy","Female","Gastrointestinal Microbiome","Humans","Infant Newborn","Male","Microbiology","Obstetrics","Paediatrics","Pregnancy","Research Design"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR","DI-HO-NDR","DI-HO-STENO"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-HO-CDR","DI-HO-NDR","DI-HO-STENO","DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"identifying microbiome based changes and biomarkers prior to disease development in mother and child with a focus on gestational diabetes mellitus protocol for the danish maternal and offspring microbiome danmom cohort study","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1136/bmjopen-2023-083358","version":"Published Version"},"funding_acknowledgement":["This study was supported by the Steno Diabetes Center North Denmark (no grant number), Niels Jensen\\u2019s Foundation (no grant number) and Marie Pedersen og Jensine Heiberg\\u2019s Foundation (no grant number). The centre is neither involved in study design, sample collection, analysis and interpretation of data nor in preparation of the manuscript."],"id":"S02-100.00-761573","identifier":[{"id":"PMC11381651","type":"pmcid"},{"id":"85203614734","type":"scopus"},{"id":"39242166","type":"pmid"}],"ids":["aau-3a4c3268-f8ac-4f54-878e-80eac59c7d41","au-00081711-0092-42db-94fa-eb119bb2a9c2"],"keyword":["Adult","Biomarkers/blood","Child, Preschool","Cohort Studies","Denmark","Diabetes in pregnancy","Diabetes, Gestational/microbiology","Female","Gastrointestinal Microbiome","Humans","Infant, Newborn","MICROBIOLOGY","Male","OBSTETRICS","PAEDIATRICS","Pregnancy","Research Design"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-8E9F6FBF4FDD647D70CFCC683172C200"],"oa_link":[{"access":"oa","license":"CC BY-NC 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/744251836/Rold_et_al._2024_._Identifying_microbiome-based_changes_and_biomarkers_prior_to_disease_development_in_mother_and_child_with_a_focus_on_gestational_diabetes_mellitus_protocol_for_the_DANish_Maternal_and_Offspring_Microbio.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1136/bmjopen-2023-083358","version":"Published Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine, Center for Clinical Research","Aalborg University, The Faculty of Medicine, North Denmark Regional Hospital"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"dk","key":"north denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-NDR","l3nl":"North Denmark Region","l3nn":"North Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"North Denmark Region","namevar":["North Denmark Regional Hospital"],"nora_code":"DI-HO-NDR","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Obstetrics and Gynaecology","Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - SDCA-Steno Diabetes Center Aarhus"],"nora_code":"DI-U-AU","used":1},{"affno":"4","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1},{"affno":"5","country":"dk","key":"steno diabetes centers","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-STENO","l3nn":"Steno Diabetes Centers","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Steno Diabetes Centers","namevar":["Steno Diabetes Centers"],"nora_code":"DI-HO-STENO","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Louise Søndergaard","key":"roldpau","last":"Rold","locid":"b6827a2f-8258-4df3-8a91-becaf4c50d7d","name":"Rold, Louise Søndergaard","orcid":"0000-0002-3638-8655","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Ann-Maria","key":"jensenpau","last":"Jensen","locid":"b63dffe4-c4a2-410a-a9d9-5f75f27f0e0e","name":"Jensen, Ann-Maria","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Louise","key":"arenholtpau","last":"Arenholt","locid":"9fe53819-b8b7-4220-8f9f-125eb33881e8","name":"Arenholt, Louise Thomsen Schmidt","name_org":"Arenholt, Louise","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Peter Derek Christian","key":"leutscherpau","last":"Leutscher","locid":"56e8c48e-c3f9-4a4d-8b9b-0719c74da258","name":"Leutscher, Peter Derek Christian","orcid":"0000-0003-1168-4041","rank":4,"rolecode":"pau"},{"affno":"3 4 5","corresponding":null,"country":"dk","first":"Per Glud","key":"ovesenpau","last":"Ovesen","locid":"1e85fcd2-8ddf-4f92-8507-fe080989d8f0","name":"Ovesen, Per Glud","orcid":"0000-0003-0838-0805","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren","key":"hagstrømpau","last":"Hagstrøm","locid":"fe472f53-6bcd-4587-8287-df1539f689c3","name":"Hagstrøm, Søren","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Suzette","key":"sørensenpau","last":"Sørensen","locid":"c96d8309-747c-403d-a858-2efad1aea498","name":"Sørensen, Suzette","orcid":"0000-0002-4201-1168","rank":7,"rolecode":"pau"}],"pmid":["39242166"],"pub":{"doi":"10.1136/bmjopen-2023-083358","issn":["20446055"],"issue":"9","journal":"BMJ Open","paperid":"e083358","publisher":"BMJ Publishing Group","status":"p","title":"BMJ Open","volume":"14"},"review":"Peer Reviewed","scoID":["2-s2.0-85203614734"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Universities"],"PST":["Published"]},"sid":["aau-3a4c3268-f8ac-4f54-878e-80eac59c7d41","au-00081711-0092-42db-94fa-eb119bb2a9c2"],"src":["AAU Aalborg University","AU Aarhus University"],"title":"Identifying microbiome-based changes and biomarkers prior to disease development in mother and child, with a focus on gestational diabetes mellitus: protocol for the DANish Maternal and Offspring Microbiome (DANMOM) cohort study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-761573","year":"2024","yearsub":"2024"}
{"abstract":"In 2020, 778 embroiderers co-created a textile artwork at the Danish museum Trapholt. Textile artist Iben Høj developed the artistic design, and citizens contributed 713 embroideries, which Høj assembled in a huge mobile, exhibited at Trapholt 2020–21. The project, Stitches Beyond Borders, was part of a celebration of the cession of North Schleswig from Germany to Denmark in 1920. However, the project addressed not only the centenary but also invited the participants to reflect on other borders and boundaries. This combination—of a national celebration and an open theme of borders and boundaries—attracted our interest. For how would Stitches Beyond Borders combine a contested topic like borders with a national celebration? How would diverse and potentially antagonistic understandings of borders interact in the participatory process and product? Based on an analysis of diverse and rich empirical material, we relate these questions to the controversial socio-political bordering practices in Denmark and theories of borders, participation, and craft. We analyze a borderscape of competing meanings and conclude that although Stitches Beyond Borders was a highly successful participatory, artistic craft project, it only partly fulfilled its unique potential to address contemporary bordering practices and create alternative imaginaries, subjectivities and agencies.","author_count":2,"contributors":["Eriksson, Birgit","Sørensen, Tina Louise Hove"],"cuid":["S01-000.00-197767"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Eriksson, Birgit"],"keyword":["Borderlands","Borders","Boundaries","Culture","Identity","Nationalism"],"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"when borders matter crafting borders in a participatory artistic project at trapholt museum","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85189617322","version":"Other Version"},"id":"S01-000.00-197767","identifier":[{"id":"85189617322","type":"scopus"}],"ids":["au-77a47b3f-f48b-4cc5-ac49-a7b8f5507e93"],"keyword":["Borderlands","borders","boundaries","culture","identity","nationalism"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Global-Local-2-4-BCD4D2200309F709156D184C22EE5258"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Arts, School of Communication and Culture, School of Communication and Culture - Aesthetics and Culture"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Birgit","key":"erikssonpau","last":"Eriksson","locid":"eb18bab8-bb58-40f8-8388-9e2f2e1f75a1","name":"Eriksson, Birgit","orcid":"0000-0002-7759-7592","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Tina Louise Hove","key":"sørensenpau","last":"Sørensen","locid":"2560cc73-3cc9-4077-85b7-55dc78426422","name":"Sørensen, Tina Louise Hove","orcid":"0009-0000-0392-0767","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1080/08865655.2022.2101138","issn":["08865655","21591229"],"issn_org":["08865655"],"issue":"2","journal":"Journal of Borderlands Studies","pages":"227-246","publisher":"Taylor and Francis Ltd.","status":"p","title":"Journal of Borderlands Studies","volume":"39"},"review":"Peer Reviewed","scoID":["2-s2.0-85189617322"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-77a47b3f-f48b-4cc5-ac49-a7b8f5507e93"],"src":["AU Aarhus University"],"title":"When Borders Matter : Crafting Borders in a Participatory Artistic Project at Trapholt Museum","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-197767","year":"2024","yearsub":"2024"}
