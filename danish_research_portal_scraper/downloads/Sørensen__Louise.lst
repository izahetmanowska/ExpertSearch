{"author_count":5,"contributors":["Ulrich-Lynge, Sofie Louise","Dalgaard, Tina Sørensen","Norup, Liselotte Rothmann","Olsen, John E","Juul-Madsen, Helle Risdahl"],"cuid":["S01-000.00-152893"],"event":{"end":"2014-07-19","place":"Guelph, ON, ca","start":"2014-07-16","title":"XIII Avian Immunolog Research Group Meeting","year":"2014"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"nr","rtype":["clu"],"sorti":"leukocyte counts and bacterial colonization during a salmonella infantis infection in chickens selectively bred for high or low concentration of mannose binding lectin","src":["au"],"src-code":["DI-U-AU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-152893","ids":["au-291980ae-a860-448e-bb1b-5433e43c9852"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-BC38D1451F907FE5A97C82653AA6139D"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Animal and Veterinary Sciences, Department of Animal and Veterinary Sciences - ANIS Health"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Sofie Louise","key":"ulrichlyngepau","last":"Ulrich-Lynge","locid":"9934f350-7a13-499b-8bcb-5877dc7558d9","name":"Ulrich-Lynge, Sofie Louise","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Tina Sørensen","key":"dalgaardpau","last":"Dalgaard","locid":"78918005-837a-4b5c-b5f9-3f71d33f8047","name":"Dalgaard, Tina Sørensen","orcid":"0000-0002-3424-6047","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Liselotte Rothmann","key":"noruppau","last":"Norup","locid":"0bb0f5f6-3402-45f9-83f7-488dbdcbdf1f","name":"Norup, Liselotte Rothmann","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"John E","key":"olsenpau","last":"Olsen","name":"Olsen, John E","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Helle Risdahl","key":"juulmadsenpau","last":"Juul-Madsen","locid":"3829e4a9-b29d-474f-9d37-c83a72fc564c","name":"Juul-Madsen, Helle Risdahl","rank":5,"rolecode":"pau"}],"pub":{"pages":"100-100","publisher":"University of Guelph, Ontario","status":"p","title":"XIII Avian Immunology Research and Group Meeting - Scientific Programme and Abstracts"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-291980ae-a860-448e-bb1b-5433e43c9852"],"src":["AU Aarhus University"],"title":"Leukocyte counts and bacterial colonization during a salmonella infantis infection in chickens selectively bred for high or low concentration of mannose-binding lectin","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-152893","year":"2014","yearsub":"2014"}
{"abstract":"Silver nanoparticles have increased cytotoxic properties compared to larger particles. Reflecting these properties, engineered silver nanoparticles are now added to an increasing number of consumer products often labelled as anti-bacterial. These particles are presently considered the fastest growing nanotechnology application. Accordingly, silver nanoparticles are now postulated to be released into the sewerage systems and wider environment in increasing quantities. Here they could potentially interfere with aquatic life and this ongoing project aims to localize possible particles taken up by the freshwater algae P subcapitata.","author_count":5,"contributors":["Jensen, Louise Helene Søgaard","Sørensen, Sara Nørgaard","Hartmann, Nanna B.","Baun, Anders","Fleck, R.A."],"cuid":["S01-000.00-364448"],"event":{"end":"2014-06-13","place":"Linköping, se","start":"2014-06-11","title":"Scandem 2014","year":"2014"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","King's College London"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"towards localization of engineered silver nanoparticles in i pseudokirchneriella subcapitata i","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dco","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/101715790/Poster_Louise_S_gaard_Jensen.pdf","version":"Other Version"},"id":"S01-000.00-364448","ids":["dtu-c8829dbf-1b5a-4436-958e-eb493172c0b6"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-BC259EAA68A7508A97ADC59C5FAE0591"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/101715790/Poster_Louise_S_gaard_Jensen.pdf","version":"Other Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Center for Electron Nanoscopy"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"gb","key":"king s college london","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"King's College London","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Louise Helene Søgaard","key":"jensenpau","last":"Jensen","locid":"889f7058-0e0d-47ed-9be7-70832ca080f6","name":"Jensen, Louise Helene Søgaard","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Sara Nørgaard","key":"sørensenpau","last":"Sørensen","locid":"1c9842d3-875f-49e3-84a0-d9895fa754fd","name":"Sørensen, Sara Nørgaard","orcid":"0000-0003-3673-9483","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Nanna Isabella Bloch","key":"hartmannpau","last":"Hartmann","locid":"8dccdf12-c16c-4cd8-a41f-a58c6a0b6dfc","name":"Hartmann, Nanna B.","name_org":"Hartmann, Nanna Isabella Bloch","orcid":"0000-0002-0442-245X","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders","key":"baunpau","last":"Baun","locid":"f3cdf4a9-bfc7-4e0e-bf46-df0da8134f0d","name":"Baun, Anders","orcid":"0000-0003-1396-408X","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"R.A.","key":"fleckpau","last":"Fleck","name":"Fleck, R.A.","rank":5,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","sdg":["6. Clean Water and Sanitation","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-c8829dbf-1b5a-4436-958e-eb493172c0b6"],"src":["DTU Technical University of Denmark"],"title":"Towards localization of engineered silver nanoparticles in <i>Pseudokirchneriella subcapitata</i>","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-364448","year":"2014","yearsub":"2014"}
{"abstract":"It is widely assumed that nutrition can affect school performance in children, yet evidence remains limited and inconclusive. In high-income countries the role of dietary quality, iron and n-3 long chain polyunsaturated fatty acids (n-3 LCPUFA) are nutritional issues that may be of relevance to cognitive functions. Few studies have investigated the effect of school meals on cognition and academic performance in high-income countries. Most previous school meal studies investigated the effects of healthier options in school cafeteria and did not consider effects on dietary intake or biomarkers of iron and n-3 LCPUFA-status. Furthermore, methodological issues in earlier studies question the validity of the results. The OPUS School Meal Study was a cluster-randomized controlled cross-over trial implemented in third and fourth grade at nine Danish schools. The three-month intervention consisted of a healthy school meal program based on the New Nordic Diet, which was compared with the usual packed lunch from home (control). At baseline and at the end of each study period, several measurements were performed including weight, height and blood sampling as well as a 7-day assessment of both physical activity and dietary intake. Moreover, we assessed student performance in d2-test of attention and Danish standard tests in reading and mathematics. Hemoglobin concentration, serum ferritin concentration and whole blood fatty acid composition were employed as biomarkers of iron and n-3 LCPUFA-status. The overall purpose of this PhD thesis was to investigate the effect of serving healthy school meals on attention and academic performance in 8-11-year-old children. Moreover, the role of n-3 LCPUFA-status and iron status was explored, as well as whether the effect of the intervention differed depending on household education level, sex and baseline reading skills of the child.","author_count":1,"contributors":["Sørensen, Louise Bergmann"],"cuid":["S01-000.00-466910"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"und","rtype":["clu"],"sorti":"the influence of diet on children s cognition and performance in school investigating the effects of healthy school meals in 000000000008 000000000011 year old danish children","src":["ku"],"src-code":["DI-U-KU"],"type":"do","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://soeg.kb.dk/permalink/45KBDK_KGL/fbp0ps/alma99122153424005763","version":"Other Version"},"id":"S01-000.00-466910","ids":["ku-7ab4f6f7-8990-412d-9ec1-655d96e78777"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-F5AE6E2BE2AF136F95AF4EDF90EE3075"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Nutrition, Exercise and Sports, Lifecourse Nutrition & Health"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Louise Bergmann","key":"sørensenpau","last":"Sørensen","locid":"b86d9af7-ea09-4925-a863-eadc0c0e26ee","name":"Sørensen, Louise Bergmann","rank":1,"rolecode":"pau"}],"pub":{"pages":"140","place":"Copenhagen","publisher":"Department of Nutrition, Exercise and Sports, Faculty of Science, University of Copenhagen","status":"p"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-7ab4f6f7-8990-412d-9ec1-655d96e78777"],"src":["KU University of Copenhagen"],"title":"The Influence of Diet on Children’s Cognition and Performance in School : Investigating the Effects of Healthy School Meals in 8-11-year-old Danish Children","type":"Other","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-466910","year":"2014","yearsub":"2014"}
{"abstract":"Polycystic ovary syndrome (PCOS) is the most common, though heterogeneous, endocrine aberration in women of reproductive age, with high prevalence and socioeconomic costs. The syndrome is characterized by polycystic ovaries, chronic anovulation and hyperandrogenism, as well as being associated with infertility, insulin resistance, chronic low-grade inflammation and an increased life time risk of type 2 diabetes. MicroRNAs (miRNAs) are small, non-coding RNAs that are able to regulate gene expression at the post-transcriptional level. Altered miRNA levels have been associated with diabetes, insulin resistance, inflammation and various cancers. Studies have shown that circulating miRNAs are present in whole blood, serum, plasma and the follicular fluid of PCOS patients and that they might serve as potential biomarkers and a new approach for the diagnosis of PCOS. In this review, recent work on miRNAs with respect to PCOS will be summarized. Our understanding of miRNAs, particularly in relation to PCOS, is currently at a very early stage, and additional studies will yield important insight into the molecular mechanisms behind this complex and heterogenic syndrome","author_count":5,"contributors":["Sørensen, Anja Elaine","Wissing, Marie Louise Muff","Salö, Sofia","Englund, Anne Lis Mikkelsen","Dalgaard, Louise Torp"],"cuid":["S01-000.00-559471"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Insulin Resistance","microRNA","poly cystic ovary syndrome"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-ZEA"],"U":["DI-U-ALL","DI-U-RUC"]},"level3all":["DI-HO-ZEA","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"micrornas related to polycystic ovary syndrome pcos","src":["ruc"],"src-code":["DI-U-RUC"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/genes5030684","version":"Published Version"},"id":"S01-000.00-559471","identifier":[{"id":"84922170030","type":"scopus"}],"ids":["ruc-3430b35e-9054-45de-b64a-ff61001897a5"],"keyword":["insulin resistance","microRNA","poly-cystic ovary syndrome"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-8C7C83195D81BB7BFA84FBD174A1987B"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/genes5030684","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/53888895/genes_05_00684.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, The Department of Science, Systems and Models"],"nora_code":"DI-U-RUC","used":1},{"affno":"2","country":"dk","key":"region zealand","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-ZEA","l3nl":"Region Zealand","l3nn":"Region Zealand","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region Zealand","namevar":["Holbæk Hospital"],"nora_code":"DI-HO-ZEA","used":1}],"person":[{"affno":"1","country":"dk","first":"Anja Elaine","key":"sørensenpau","last":"Sørensen","locid":"7e5d1e2c-5d4b-4436-bb66-acdca4058c08","name":"Sørensen, Anja Elaine","orcid":"0000-0001-7557-5376","rank":1,"rolecode":"pau"},{"affno":"2","first":"Marie Louise Muff","key":"wissingpau","last":"Wissing","name":"Wissing, Marie Louise Muff","rank":2,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Sofia","key":"salöpau","last":"Salö","locid":"c1b2d43b-df05-4cd7-8d50-4b72781cdcb9","name":"Salö, Sofia","rank":3,"rolecode":"pau"},{"affno":"2","first":"Anne Lis Mikkelsen","key":"englundpau","last":"Englund","name":"Englund, Anne Lis Mikkelsen","rank":4,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Louise Torp","key":"dalgaardpau","last":"Dalgaard","locid":"a219fdaf-f994-4a7a-beb8-1f353846ed5a","name":"Dalgaard, Louise Torp","orcid":"0000-0002-3598-2775","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.3390/genes5030684","issn":["20734425"],"issue":"3","journal":"Genes","pages":"684-708","paperid":"doi: 10.3390/genes5030684","status":"p","title":"Genes","volume":"5"},"review":"Peer Reviewed","scoID":["2-s2.0-84922170030"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region Zealand","Roskilde University","Universities"],"PST":["Published"]},"sid":["ruc-3430b35e-9054-45de-b64a-ff61001897a5"],"src":["RUC Roskilde University"],"title":"MicroRNAs Related to Polycystic Ovary Syndrome (PCOS)","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-559471","year":"2014","yearsub":"2014"}
{"abstract":"An increasing number of children are exhibiting features of the metabolic syndrome (MetS) including abdominal fatness, hypertension, adverse lipid profile and insulin resistance. Healthy eating practices during school hours may improve the cardiometabolic profile, but there is a lack of evidence. In the present study, the effect of provision of school meals rich in fish, vegetables and fibre on a MetS score (primary outcome) and on individual cardiometabolic markers and body composition (secondary outcomes) was investigated in 834 Danish school children. The study was carried out as a cluster-randomised, controlled, non-blinded, cross-over trial at nine schools. Children aged 8-11 years received freshly prepared school lunch and snacks or usual packed lunch from home (control) each for 3 months. Dietary intake, physical activity, cardiometabolic markers and body composition were measured at baseline and after each dietary period. The school meals did not affect the MetS score (P= 1·00). However, it was found that mean arterial pressure was reduced by 0·4 (95 % CI 0·0, 0·8) mmHg (P= 0·04), fasting total cholesterol concentrations by 0·05 (95 % CI 0·02, 0·08) mmol/l (P= 0·001), HDL-cholesterol concentrations by 0·02 (95 % CI 0·00, 0·03) mmol/l, TAG concentrations by 0·02 (95 % CI 0·00, 0·04) mmol/l (both P<0·05), and homeostasis model of assessment-insulin resistance by 0·10 (95 % CI 0·04, 0·16) points (P= 0·001) compared with the control diet in the intention-to-treat analyses. Waist circumference increased 0·5 (95 % CI 0·3, 0·7) cm (P<0·001), but BMI z-score remained unaffected. Complete-case analyses and analyses adjusted for household educational level, pubertal status and physical activity confirmed the results. In conclusion, the school meals did not affect the MetS score in 8-11-year-olds, as small improvements in blood pressure, TAG concentrations and insulin resistance were counterbalanced by slight undesired effects on waist circumference and HDL-cholesterol concentrations.","author_count":15,"contributors":["Damsgaard, Camilla Trab","Dalskov, Stine-Mathilde","Laursen, Rikke Pilmann","Ritz, Christian","Hjorth, Mads Fiil","Lauritzen, Lotte","Sørensen, Louise Bergmann","Petersen, Rikke Agnete","Andersen, Malene Rohr","Stender, Steen","Andersen, Rikke","Tetens, Inge","Mølgaard, Christian","Astrup, Arne","Michaelsen, Kim F."],"cuid":["S02-099.95-037917"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"provision of healthy school meals does not affect the metabolic syndrome score in 000000000008 000000000011 year old children but reduces cardiometabolic risk markers despite increasing waist circumference","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1017/s0007114514003043","version":"Other Version"},"id":"S02-099.95-037917","identifier":[{"id":"25323030","type":"pmid"},{"id":"84924932802","type":"scopus"}],"ids":["dtu-ef61238f-35f4-48f7-b12d-43a40dbaef4c","ku-702d8ff4-0856-4e45-acda-7c40d41619ba"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-59C7F3CCED122D6E3988D813428FE9F7"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1017/S0007114514003043","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Nutrition, Exercise and Sports, Lifecourse Nutrition & Health"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital Herlev and Gentofte"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Food Institute","Technical University of Denmark, National Food Institute, Division of Nutrition"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","first":"Camilla Trab","key":"damsgaardcamillatrabpau","last":"Damsgaard","locid":"5ea9cc09-17f1-46a3-9e4e-fa5490abd815","name":"Damsgaard, Camilla Trab","orcid":"0000-0002-5013-0562","rank":1,"rolecode":"pau"},{"affno":"1","first":"Stine-Mathilde","key":"dalskovstinemathildepau","last":"Dalskov","locid":"56222bcb-fb52-4111-8cfa-0264a3fef7e5","name":"Dalskov, Stine-Mathilde","rank":2,"rolecode":"pau"},{"affno":"1","first":"Rikke Pilmann","key":"laursenrikkepilmannpau","last":"Laursen","locid":"f9c8cd54-5246-4d44-bbd5-b060967c7cc6","name":"Laursen, Rikke Pilmann","orcid":"0000-0002-3386-7706","rank":3,"rolecode":"pau"},{"affno":"1","first":"Christian","key":"ritzchristianpau","last":"Ritz","locid":"c881424f-d529-443e-b60e-bc2edb674ede","name":"Ritz, Christian","orcid":"0000-0002-5095-0624","rank":4,"rolecode":"pau"},{"affno":"1","first":"Mads Fiil","key":"hjorthmadsfiilpau","last":"Hjorth","locid":"00918fa0-7b1e-4128-919e-a0af949