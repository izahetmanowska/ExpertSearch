eview":"Peer Reviewed","scoID":["2-s2.0-85173823809"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-8bd2ffbd-8461-4917-8435-a4688c47bfc1","au-0c4ddeab-d870-4f9c-9de9-0fd8a6a50d90","sdu-08006969-c299-4ddb-896c-73f2d01dabaa"],"src":["AAU Aalborg University","AU Aarhus University","SDU University of Southern Denmark"],"title":"Use of Fermented Red Clover Isoflavones in the Treatment of Overactive Bladder in Postmenopausal Women: A Randomized, Double-Blinded, Placebo-Controlled Trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-098.29-715713","year":"2023","yearsub":"2023"}
{"abstract":"Objective: Iodine fortification programmes are implemented in many countries and often associated with an increase in population iodine intake. However, the initial attempt may not be sufficient and in Denmark the level of iodine added to salt was increased in 2019. Sparse evidence is available on the impact of such modification in iodine fortification. The aim of this study was to evaluate iodine status in Danish pregnant women in 2021 after this increase in iodine fortification and compare to iodine status in 2012.  Design: Cross-sectional study.  Patients: Pregnant women in the North Denmark Region referred for routine obstetric ultrasound in 2021.  Measurements: Participants filled out a questionnaire and delivered a spot urine. Median urinary iodine concentration (UIC) was calculated and assessed according to the recommended range in pregnancy (150–249 µg/L).  Results: Altogether 147 pregnant women were included and 88% used iodine-containing supplements. Median UIC was overall 77 µg/L [95% confidence interval (CI): 61–96 µg/L], which was lower than in 2012 (101 µg/L [95% CI: 89–111 µg/L]) (p < 0.001). Considering sources of iodine intake in pregnancy, lower daily intake of dairy products (p = 0.008) and bread (p < 0.001) and a lower content of iodine in the supplement used (p < 0.001) was seen in 2021 compared to 2012.  Conclusion: Despite an increase in iodine fortification and frequent use of iodine-containing supplements, iodine status in pregnant women in the North Denmark Region was insufficient. Results call for continued monitoring and attention to ensure adequate iodine status during pregnancy in Denmark.","author_count":6,"contributors":["Knøsgaard, Louise","Andersen, Stig","Hansen, Annebirthe Bo","Sørensen, Anne","Vestergaard, Peter","Andersen, Stine Linding"],"cuid":["S01-000.00-089318"],"filters":{"added":"2022-08","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Knøsgaard, Louise"],"keyword":["Iodine","Iodine fortification","Iodine status","Pregnancy","Urinary iodine concentration"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"iodine status in danish pregnant women after an increase in iodine fortification","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND 4.0","type":"doi","url":"https://doi.org/10.1111/cen.14797","version":"Published Version"},"id":"S01-000.00-089318","identifier":[{"id":"85133718487","type":"scopus"}],"ids":["aau-86d84a7f-25b1-4638-b7ec-9248c65f0edf"],"keyword":["iodine","iodine fortification","iodine status","pregnancy","urinary iodine concentration"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-F84DAFAD83672489F434FD43FDF78CF4"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND 4.0","type":"doi","url":"https://doi.org/10.1111/cen.14797","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/518934995/Kn_sgaard_et_al_2023_Iodine_status_in_Danish_pregnant_women_after_an_increase_in_iodine_fortification.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Clinical Biochemistry","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Louise","key":"knøsgaardlouisepau","last":"Knøsgaard","locid":"fb74125e-d162-4206-be27-f3dcb2175798","name":"Knøsgaard, Louise","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Stig","key":"andersenstigpau","last":"Andersen","locid":"61af62ab-d105-4f02-bbea-e6d8146a3e66","name":"Andersen, Stig","orcid":"0000-0003-3632-5213","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Annebirthe Bo","key":"hansenannebirthebopau","last":"Hansen","locid":"2b7d3806-f81a-4e8a-a532-f16a9c18966b","name":"Hansen, Annebirthe Bo","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anne","key":"sørensenannepau","last":"Sørensen","locid":"8e740d71-50a8-473f-9ef7-937a0fe4adbb","name":"Sørensen, Anne","orcid":"0000-0003-2191-4138","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Peter","key":"vestergaardpeterpau","last":"Vestergaard","locid":"ad223cc8-3f85-4cdf-9da5-5ec44f6a1714","name":"Vestergaard, Peter","orcid":"0000-0002-9046-2967","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Stine Linding","key":"andersenstinelindingpau","last":"Andersen","locid":"a08245c4-86df-48d4-b485-d0fee481d01e","name":"Andersen, Stine Linding","orcid":"0000-0001-6336-1936","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1111/cen.14797","issn":["03000664","13652265"],"issn_org":["03000664"],"issue":"3","journal":"Clinical Endocrinology","pages":"407-414","publisher":"Wiley-Blackwell","status":"p","title":"Clinical Endocrinology","volume":"98"},"review":"Peer Reviewed","scoID":["2-s2.0-85133718487"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-86d84a7f-25b1-4638-b7ec-9248c65f0edf"],"src":["AAU Aalborg University"],"title":"Iodine status in Danish pregnant women after an increase in iodine fortification","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-089318","year":"2023","yearsub":"2023"}
{"abstract":"An association has been suggested between altered gut microbiota, and attention deficit hyperactivity disorder (ADHD), and autism spectrum disorder (ASD), respectively. Thus, we analyzed the gut microbiota composition in children and adolescents with or without these disorders and evaluated the systemic effects of these bacteria. We recruited study participants diagnosed with ADHD, ASD, and comorbid ADHD/ASD, while the control groups consisted both of siblings and non-related children. The gut microbiota was analyzed by 16S rRNA gene sequencing of the V4 region, while the concentration of lipopolysaccharide-binding protein (LBP), cytokines, and other signaling molecules were measured in plasma. Importantly the gut microbiota compositions of cases with ADHD and ASD were highly similar for both alpha- and beta-diversity while differing from that of non-related controls. Furthermore, a subset of ADHD and ASD cases had an increased LBP concentration compared to non-affected children, which was positively correlated with interleukin (IL)-8, 12, and 13. These observations indicate disruption of the intestinal barrier and immune dysregulation among the subset of children with ADHD or ASD.","author_count":11,"contributors":["Bundgaard-Nielsen, Caspar","Lauritsen, Marlene Briciet","Knudsen, Julie Kristine","Rold, Louise Søndergaard","Larsen, Margit Hørup","Hindersson, Peter","Villadsen, Annemarie Brusen","Leutscher, Peter Derek Christian","Hagstrøm, Søren","Nyegaard, Mette","Sørensen, Suzette"],"cuid":["S01-000.00-673624"],"filters":{"added":"2023-07","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"corresponding_author":["Sørensen, Suzette"],"keyword":["Adolescent","Attention Deficit Disorder with Hyperactivity","Attention deficit hyperactivity disorder","Autism spectrum disorder","Child","Gastrointestinal Microbiome genetics","Gut brain axis","Humans","Inflammation","Microbiome","Microbiota","Neurodevelopmental disorders","RNA Ribosomal 16S genetics"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-HO-CAP","DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"children and adolescents with attention deficit hyperactivity disorder and autism spectrum disorder share distinct microbiota compositions","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC 4.0","type":"doi","url":"https://doi.org/10.1080/19490976.2023.2211923","version":"Published Version"},"id":"S01-000.00-673624","identifier":[{"id":"37199526","type":"pmid"},{"id":"PMC10197996","type":"pmcid"},{"id":"85159760599","type":"scopus"}],"ids":["aau-4ed271c3-71b1-4c44-a4d6-987eecc8bfb3"],"keyword":["Adolescent","Attention Deficit Disorder with Hyperactivity","Autism Spectrum Disorder","Child","Gastrointestinal Microbiome/genetics","Humans","Microbiota","RNA, Ribosomal, 16S/genetics","attention deficit hyperactivity disorder","gut-brain axis","inflammation","microbiome","neurodevelopmental disorders"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-EC191ED24F95125243D587AA10C9438C"],"oa_link":[{"access":"oa","license":"CC BY-NC 4.0","type":"doi","url":"https://doi.org/10.1080/19490976.2023.2211923","version":"Published Version"},{"access":"oa","license":"CC BY-NC 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/529859269/Bundgaard_Nielsen_et_al._2023_._Children_and_adolescents_with_attention_deficit_hyperactivity_disorder_and_autism_spectrum_disorder_share_distinct_microbiota_compositions.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine, Center for Clinical Research","Aalborg University, The Faculty of Medicine, North Denmark Regional Hospital"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Caspar","key":"bundgaardnielsenpau","last":"Bundgaard-Nielsen","locid":"621f32eb-b0ed-4146-bed9-a4b793ee401d","name":"Bundgaard-Nielsen, Caspar","orcid":"0000-0002-2700-2378","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Marlene Briciet","key":"lauritsenpau","last":"Lauritsen","locid":"056282ec-92a4-4b4c-8957-ba197067e261","name":"Lauritsen, Marlene Briciet","orcid":"0000-0001-7284-9255","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Julie Kristine","key":"knudsenpau","last":"Knudsen","locid":"b053499a-79c3-4a1f-8e1e-df2ac4b5e2bf","name":"Knudsen, Julie Kristine","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Louise Søndergaard","key":"roldpau","last":"Rold","locid":"b6827a2f-8258-4df3-8a91-becaf4c50d7d","name":"Rold, Louise Søndergaard","orcid":"0000-0002-3638-8655","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Margit Hørup","key":"larsenpau","last":"Larsen","name":"Larsen, Margit Hørup","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Peter","key":"hinderssonpau","last":"Hindersson","locid":"408ac604-b6f1-4e5f-96e5-ecac3f6f43d6","name":"Hindersson, Peter","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Annemarie Brusen","key":"villadsenpau","last":"Villadsen","locid":"71f9e538-f8b1-48d5-a0e3-3bb05794c38c","name":"Villadsen, Annemarie Brusen","orcid":"0000-0002-4064-2900","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Peter D. C.","key":"leutscherpau","last":"Leutscher","locid":"56e8c48e-c3f9-4a4d-8b9b-0719c74da258","name":"Leutscher, Peter Derek Christian","name_org":"Leutscher, Peter D. C.","orcid":"0000-0003-1168-4041","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren","key":"hagstrømpau","last":"Hagstrøm","locid":"fe472f53-6bcd-4587-8287-df1539f689c3","name":"Hagstrøm, Søren","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mette","key":"nyegaardpau","last":"Nyegaard","locid":"c048a688-cd64-40ca-a277-53f16360f7a1","name":"Nyegaard, Mette","orcid":"0000-0003-4973-8543","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Suzette","key":"sørensenpau","last":"Sørensen","locid":"c96d8309-747c-403d-a858-2efad1aea498","name":"Sørensen, Suzette","orcid":"0000-0002-4201-1168","rank":11,"rolecode":"pau"}],"pmid":["37199526"],"pub":{"doi":"10.1080/19490976.2023.2211923","issn":["19490976","19490984"],"issn_org":["19490976"],"issue":"1","journal":"Gut Microbes","paperid":"2211923","publisher":"Landes Bioscience","status":"p","title":"Gut Microbes","volume":"15"},"review":"Peer Reviewed","scoID":["2-s2.0-85159760599"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities"],"PST":["Published"]},"sid":["aau-4ed271c3-71b1-4c44-a4d6-987eecc8bfb3"],"src":["AAU Aalborg University"],"title":"Children and adolescents with attention deficit hyperactivity disorder and autism spectrum disorder share distinct microbiota compositions","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-673624","year":"2023","yearsub":"2023"}
{"abstract":"Inklusion er blevet diskuteret og udforsket som både et normativt, ideologisk projekt og som en praksis, en vision, der forbindes til konkurrencestatslige mål om højt læringsudbytte for alle. Det har for læreres praksis betydet, at lærings- og inklusionsagendaen ikke indgår i samme faglige selvforståelse – på bekostning af inklusionen. Inklusionsforskningen har samtidig været delt i en sociologisk og en didaktisk retning, som har betydet, at lærere ikke bliver støttet i at forbinde det, der foregår i klasserummet, med normaliseringsmagt og eksklusionsmekanismer, som på subtile måder indgår i praksis. Og det har betydet, at forskningen ikke har understøttet forbindelser mellem inklusion og undervisning for lærere. Også specialpædagogisk viden og almenpædagogisk viden er blevet diskuteret som to adskilte faglige felter, og dette har igen ikke understøttet lærere i at udvikle en inkluderende, specialpædagogisk praksis. Dette kapitel beskriver, diskuterer og problematiserer inklusionsforskningen. Kapitlet argumenterer for, at forskningen må støtte en praksis, der arbejder med at håndtere og imødekomme forskelle hos børn, men uden at de stigmatiseres.","author_count":3,"contributors":["Hedegaard-Sørensen, Lotte"],"cuid":["S01-000.00-675722"],"filters":{"added":"2023-07","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"inklusionen er ikke død den lugter bare mærkeligt","src":["au"],"src-code":["DI-U-AU"],"type":"dba","type-grp":["all","pub"]},"id":"S01-000.00-675722","ids":["au-cc8da34f-8f59-40a7-bc75-ee58d3e37882"],"lang":"Danish","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-6CB80C612E0AF88BFD298F263B145399"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Arts, Danish School of Education, Danish School of Education - Educational Sociology, Emdrup"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Lotte","key":"hedegaardsørensenpau","last":"Hedegaard-Sørensen","locid":"341bc091-d00e-4a6c-b517-88d3dfa0d351","name":"Hedegaard-Sørensen, Lotte","orcid":"0000-0002-3501-5793","rank":1,"rolecode":"pau"},{"affno":"","first":"Holm","key":"clauspedh","last":"Claus","name":"Claus, Holm","rank":2,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Louise","key":"bøttcherpedh","last":"Bøttcher","name":"Bøttcher, Louise","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["9878793890510"],"pages":"39-54","place":"S.l.","publisher":"U Press","status":"p","subtitle":"institutionen og den pædagogiske strategi","title":"Efter inklusionen"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-cc8da34f-8f59-40a7-bc75-ee58d3e37882"],"src":["AU Aarhus University"],"title":"Inklusionen er ikke død : den lugter bare mærkeligt","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-675722","year":"2023","yearsub":"2023"}
