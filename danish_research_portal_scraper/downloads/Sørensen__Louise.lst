ar":"2018","yearsub":"2018"}
{"abstract":"Anoxic mineralization of organic matter releases dissolved inorganic carbon and produces reduced mineralization products. The reoxidation of these reduced compounds is essential for biogeochemical cycling in sediments and is mainly performed by chemoautotrophic microbes, which synthesize new organic carbon by dark CO2 fixation. At present however, the biogeochemical importance of chemoautotrophy in high-latitude sediments is largely unknown. Here, we determine the seasonal variation in sedimentary chemoautotrophic production in Kobbefjord (SW Greenland). Intact sediment cores from the fjord were incubated, and dark CO2 fixation was quantified by combining bacterial phospholipid-derived fatty acid analysis with 13C stable isotope probing (PLFA-SIP). Our results reveal a distinct seasonal cycle in chemoautotrophic activity, which increases after the spring bloom and shows lowest activity in the late winter when the fjord is covered by sea ice. The depth distribution of chemoautotrophic activity also varied seasonally, likely due to seasonal variation in the bioturbation activity of sediment infauna. Although chemoautotrophy rates (0.4 ± 0.2 mmol C m−2 d−1) were in the low range for coastal sediments, they are comparable to those from intertidal sandflats and brackish tropical lagoons, and scale with the sulfide production through sulfate reduction in the fjord. Chemoautotrophic production in these fjord sediments thus appears to be mainly driven by sulfide oxidation and can re-fix 4% of the CO2 produced by mineralization.","author_count":6,"contributors":["Vasquez-Cardenas, Diana","Meire, Lorenz","Sørensen, Heidi Louise","Glud, Ronnie N.","Meysman, Filip J.R.","Boschker, Henricus T.S."],"cuid":["S01-000.00-587692"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"corresponding_author":["Vasquez-Cardenas, Diana"],"country":["Belgium","Greenland","Netherlands"],"glorg":["All Global Affiliations","Delft University of Technology","Greenland Climate Research Centre","University of Antwerp","Utrecht University"],"keyword":["Chemolithoautotrophy","Dark carbon fixation","Fatty acids","Stable isotope labeling"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"bacterial chemoautotrophic reoxidation in sub arctic sediments a seasonal study in kobbefjord greenland","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/143466561/Vasquez_cardenas_et_al_2018_accepted_final_version.pdf","version":"Authors Final Version"},"id":"S01-000.00-587692","identifier":[{"id":"85051385577","type":"scopus"}],"ids":["sdu-32889a7a-5af9-4c01-9f99-aba132f590a5"],"keyword":["Chemolithoautotrophy","Dark carbon fixation","Fatty acids","PLFA-SIP","Stable isotope labeling"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-11B4C46936B24622F582DCCBB987FC21"],"oa_link":[{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/143466561/Vasquez_cardenas_et_al_2018_accepted_final_version.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","country":"nl","key":"delft university of technology","loc":["Netherlands","Europe, EU","OECD"],"name":"Delft University of Technology","used":1},{"affno":"2","country":"nl","key":"utrecht university","loc":["Netherlands","Europe, EU","OECD"],"name":"Utrecht University","used":1},{"affno":"3","country":"gl","key":"greenland climate research centre","loc":["Greenland","Nordic"],"name":"Greenland Climate Research Centre","used":1},{"affno":"4","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Science, Department of Biology","SDU, Faculty of Science, Department of Biology, Nordcee"],"nora_code":"DI-U-SDU","used":1},{"affno":"5","country":"be","key":"university of antwerp","loc":["Belgium","Europe, EU","OECD"],"name":"University of Antwerp","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Diana","key":"vasquezcardenaspau","last":"Vasquez-Cardenas","name":"Vasquez-Cardenas, Diana","rank":1,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Lorenz","key":"meirepau","last":"Meire","name":"Meire, Lorenz","rank":2,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Heidi L.","key":"sørensenpau","last":"Sørensen","locid":"7a5442bb-7ee3-464b-9b90-eee87aee3b39","name":"Sørensen, Heidi Louise","name_org":"Sørensen, Heidi L.","rank":3,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Ronnie N.","key":"gludpau","last":"Glud","locid":"aa184a3b-a696-4a69-a7de-66a3eea542cf","name":"Glud, Ronnie N.","orcid":"0000-0002-7069-893X","rank":4,"rolecode":"pau"},{"affno":"1 5","corresponding":null,"first":"Filip J.R.","key":"meysmanpau","last":"Meysman","name":"Meysman, Filip J.R.","rank":5,"rolecode":"pau"},{"affno":"1 5","corresponding":null,"first":"Henricus T.S.","key":"boschkerpau","last":"Boschker","name":"Boschker, Henricus T.S.","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.3354/meps12669","issn":["01718630","16161599"],"issn_org":["01718630"],"journal":"Marine Ecology Progress Series","pages":"33-39","publisher":"Inter-Research","status":"p","title":"Marine Ecology Progress Series","volume":"601"},"review":"Peer Reviewed","scoID":["2-s2.0-85051385577"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-32889a7a-5af9-4c01-9f99-aba132f590a5"],"src":["SDU University of Southern Denmark"],"title":"Bacterial chemoautotrophic reoxidation in sub-Arctic sediments : A seasonal study in Kobbefjord, Greenland","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-587692","year":"2018","yearsub":"2018"}
{"abstract":"Artikel der begrunder hvorfor emner vedrørende køn og seksualitet er relevante i skolefaget historie. Artiklen præsenterer ligeledes det problemorienterede læremiddel, Kildebanken, en online kildeportal, som er produceret af HistorieLab. Opfattelser og spørgsmål, der knytter sig til køn og seksualitet, er væsentlige for hver enkelt af os og for samfundet som sådan. Denne artikel giver eksempler på, hvordan forståelser af og holdninger til dette emne er påvirket af de samfundsmæssige og kulturelle forandringer, der er sket i tidens løb. Den begrunder også, hvorfor aspekter og problemstillinger om køn og seksualitet er et relevant emne i historieundervisningen. Til sidst præsenteres det problemorienterede kildebaserede forløb ”Kærlighed, køn og seksualitet”, der er tilgængelig i HistorieLabs kildebank.","author_count":2,"contributors":["Sørensen, Christina Louise","Poulsen, Jens Aage"],"cuid":["S01-000.00-646891"],"filters":{"added":"2023-01","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Læring pædagogik og undervisning","historiefaget problemorienteret læremiddel digitalt læremiddel kilder kildekritik historiske problemstillinger seksualitet køn"],"level":"sci","oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-UC"],"level3":{"UC":["DI-UC-ALL","DI-UC-UCL"]},"level3all":["DI-UC-UCL"]},"review":"pr","rtype":["clu"],"sorti":"køn og seksualitet som emne i historie","src":["ucl"],"src-code":["DI-UC-UCL"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://historielab.dk/koen-seksualitet-emne-historie/","version":"Published Version"},"id":"S01-000.00-646891","ids":["ucl-1d1bdd09-6d4c-4368-ba2c-baf708c13624"],"keyword":["Læring, pædagogik og undervisning","historiefaget, problemorienteret, læremiddel, digitalt læremiddel, kilder, kildekritik, historiske problemstillinger, seksualitet, køn"],"lang":"Danish","level":"Scientific","noi":["Local-1-1-D56EE5EE6FBF2F47F16943B73A128D37"],"oa_link":[{"access":"oa","type":"rem","url":"https://historielab.dk/koen-seksualitet-emne-historie/","version":"Published Version"}],"org":[{"affno":"1","key":"ucl university college","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-UCL","l3nl":"UCL University College","l3nn":"UCL University College","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"UCL University College","namevar":["UCL Erhvervsakademi og Professionshøjskole, Rektor, Rektor, Videncenter for Historie og Kulturformidling"],"nora_code":"DI-UC-UCL","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Christina Louise","key":"sørensenpau","last":"Sørensen","locid":"c4715900-2e37-4a8f-9c8b-77690089c2c4","name":"Sørensen, Christina Louise","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jens Aage","key":"poulsenpau","last":"Poulsen","locid":"2fe2921a-cbaa-4e8f-b6f0-fdf98dda45ae","name":"Poulsen, Jens Aage","orcid":"0000-0001-9617-4336","rank":2,"rolecode":"pau"}],"pub":{"issn":["24464309"],"journal":"RADAR - Historiedidaktisk Tidsskrift","publisher":"Nationalt Videnscenter for Historie- og Kulturformidling","status":"p","title":"RADAR - Historiedidaktisk Tidsskrift","title_org":"RADAR – Historiedidaktisk Tidsskrift"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All University Colleges","DI-ALL","DI-UC","DI-UC-ALL","UCL University College","University Colleges"],"PST":["Published"]},"sid":["ucl-1d1bdd09-6d4c-4368-ba2c-baf708c13624"],"src":["UCL University College"],"title":"Køn og seksualitet som emne i historie?","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-646891","year":"2018","yearsub":"2018"}
{"abstract":"Den digitale kildebank består af en række emner der har fokus på danmarkshistorien. Kildebankemnet \"Kærlighed, køn og seksualitet\" er et fleksibelt læremiddel, der er rettet mod 7.-9. klassetrin. Dets historiske fokus hvordan synet på køn og seksualitet har ændret sig over tid. Kildebankemnet er inddelt i 4 temaer, og hver tema stiller mellem 8-12 kilder til rådighed. Til læremidlet er også udviklet lærervejledninger, opgaver og en triggerfilm til at komme igang med problemorienteret undervisning.","author_count":3,"contributors":["Sørensen, Christina Louise","Peters, Rikke","Poulsen, Jens Aage"],"cuid":["S01-000.00-647846"],"filters":{"added":"2023-01","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Læring pædagogik og undervisning","historiefaget problemorienteret læremiddel digitalt læremiddel kilder kildekritik historiske problemstillinger seksualitet køn"],"level":"pop","oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-UC"],"level3":{"UC":["DI-UC-ALL","DI-UC-UCL"]},"level3all":["DI-UC-UCL"]},"review":"und","rtype":["clu"],"sorti":"kildebankemne kærlighed køn og seksualitet","src":["ucl"],"src-code":["DI-UC-UCL"],"type":"doo","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://historielab.dk/til-undervisningen/kildebank/koen-og-seksualitet/","version":"Published Version"},"id":"S01-000.00-647846","ids":["ucl-6104afe7-968c-4d32-8eb0-9c8249757f85"],"keyword":["Læring, pædagogik og undervisning","historiefaget, problemorienteret, læremiddel, digitalt læremiddel, kilder, kildekritik, historiske problemstillinger, seksualitet, køn"],"lang":"Danish","level":"Popular","noi":["Local-1-1-36E54CBBA2A3F512425235EF7A514A7C"],"oa_link":[{"access":"oa","type":"rem","url":"http://historielab.dk/til-undervisningen/kildebank/koen-og-seksualitet/","version":"Published Version"}],"org":[{"affno":"1","key":"ucl university college","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-UCL","l3nl":"UCL University College","l3nn":"UCL University College","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"UCL University College","namevar":["UCL Erhvervsakademi og Professionshøjskole, Rektor, Rektor, Videncenter for Historie og Kulturformidling"],"nora_code":"DI-UC-UCL","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Christina Louise","key":"sørensenpau","last":"Sørensen","locid":"c4715900-2e37-4a8f-9c8b-77690089c2c4","name":"Sørensen, Christina Louise","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rikke Louise Alberg","key":"peterspau","last":"Peters","locid":"c08a1671-9716-48a1-a1b9-2f07a47a57e9","name":"Peters, Rikke","name_org":"Peters, Rikke Louise Alberg","orcid":"0000-0003-0120-370X","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jens Aage","key":"poulsenpau","last":"Poulsen","locid":"2fe2921a-cbaa-4e8f-b6f0-fdf98dda45ae","name":"Poulsen, Jens Aage","orcid":"0000-0001-9617-4336","rank":3,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All University Colleges","DI-ALL","DI-UC","DI-UC-ALL","UCL University College","University Colleges"],"PST":["Published"]},"sid":["ucl-6104afe7-968c-4d32-8eb0-9c8249757f85"],"src":["UCL University College"],"title":"Kildebankemne: Kærlighed, køn og seksualitet","type":"Other-Unknown","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-647846","year":"2018","yearsub":"2018"}
