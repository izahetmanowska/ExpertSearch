{"author_count":6,"contributors":["Holland-Bill, Louise","F. Christiansen, Christian","Ulrichsen, Sinna Pilgaard","Ring, Troels","Jørgensen, Jens O L","Sørensen, Henrik T"],"cuid":["S01-000.00-075820"],"event":{"end":"2014-11-21","place":"Odense, dk","start":"2014-11-20","title":"6th Danish Emergency Medicine Conference","year":"2014"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"hyponatremia as a prognostic factor for 000000000030 day and 000000000001 year mortality in patients acutely admitted to departments of internal medicine","src":["aau"],"src-code":["DI-U-AAU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1186/1757-7241-23-S1-A18","version":"Published Version"},"id":"S01-000.00-075820","ids":["aau-58dd3b46-65e2-4e33-9df1-8e09a5b6164f"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-69D32CDFD7F1F84E09E2EBFCE6BAAA17"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1186/1757-7241-23-S1-A18","version":"Published Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Medicin","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Nyremedicin (Nefrologi) [Klinik Medicin]"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"","corresponding":null,"first