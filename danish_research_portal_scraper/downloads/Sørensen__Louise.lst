{"abstract":"Sundhedsstyrelsen udgiver en ny evidensbaseret retningslinje for udredning og behandling af patienter med diabetiske fodsår.","author_count":13,"contributors":["Rasmussen, Anne","Høgh, Annette","Birk Sørensen, Hanne","Calum, Henrik","Kolding Kristensen, Jette","Frøkjær, Johnny","Kirketerp-Møller, Klaus","Brinth, Louise Schouborg","Lander Svendsen, Ole","Bondorph, Pia","Gylfadottir, Sandra Sif","Aagaard, Thomas Vedste","Morsing, Trine Schier"],"cuid":["S01-000.00-208171"],"filters":{"added":"2022-03","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"level":"com","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"nkr udredning og behandling af patienter med diabetisk fodsår","src":["au"],"src-code":["DI-U-AU"],"type":"dr","type-grp":["all","pub"]},"id":"S01-000.00-208171","ids":["au-8a2f13f9-7665-45b4-b50e-8a92ed881010"],"lang":"Danish","level":"Commissioned","mra":["Medical Science"],"noi":["Local-1-1-97005347BD93F9847B97845D177E7937"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Karkirurgi, Viborg"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Anne","key":"rasmussenpau","last":"Rasmussen","name":"Rasmussen, Anne","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Annette","key":"høghpau","last":"Høgh","locid":"78c4f7b4-e4f6-454b-8984-f1cdc83e4a82","name":"Høgh, Annette","orcid":"0000-0001-7525-9007","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Hanne","key":"birksørensenpau","last":"Birk Sørensen","name":"Birk Sørensen, Hanne","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Henrik","key":"calumpau","last":"Calum","name":"Calum, Henrik","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jette","key":"koldingkristensenpau","last":"Kolding Kristensen","name":"Kolding Kristensen, Jette","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Johnny","key":"frøkjærpau","last":"Frøkjær","name":"Frøkjær, Johnny","rank":6,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Klaus","key":"kirketerpmøllerpau","last":"Kirketerp-Møller","name":"Kirketerp-Møller, Klaus","rank":7,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Louise Schouborg","key":"brinthpau","last":"Brinth","name":"Brinth, Louise Schouborg","rank":8,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Ole","key":"landersvendsenpau","last":"Lander Svendsen","name":"Lander Svendsen, Ole","rank":9,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Pia","key":"bondorphpau","last":"Bondorph","name":"Bondorph, Pia","rank":10,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Sandra Sif","key":"gylfadottirpau","last":"Gylfadottir","name":"Gylfadottir, Sandra Sif","rank":11,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Thomas Vedste","key":"aagaardpau","last":"Aagaard","name":"Aagaard, Thomas Vedste","rank":12,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Trine Schier","key":"morsingpau","last":"Morsing","name":"Morsing, Trine Schier","rank":13,"rolecode":"pau"}],"pub":{"pages":"92","place":"www.sst.dk","status":"p","volume":"1"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-8a2f13f9-7665-45b4-b50e-8a92ed881010"],"src":["AU Aarhus University"],"title":"NKR: Udredning og behandling af patienter med diabetisk fodsår","type":"Report","url":"https://l