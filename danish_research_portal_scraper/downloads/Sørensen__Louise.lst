University, The Faculty of Medicine, Aalborg University Hospital, Department of Clinical Biochemistry","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Molecular Diagnostics","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Diagnostik"],"nora_code":"DI-U-AAU","used":1},{"affno":"5","country":"dk","key":"north denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-NDR","l3nl":"North Denmark Region","l3nn":"North Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"North Denmark Region","namevar":["Aalborg University Hospital"],"nora_code":"DI-HO-NDR","used":1}],"person":[{"affno":"1 2","first":"Rikke Agnete","key":"petersenpau","last":"Petersen","locid":"7ec167a6-8982-42dc-87de-53c245802653","name":"Petersen, Rikke Agnete","rank":1,"rolecode":"pau"},{"affno":"1","first":"Lesli Hingstrup","key":"larsenpau","last":"Larsen","locid":"cf1fc793-3fd4-4dca-ab8e-ee3ed914ec04","name":"Larsen, Lesli Hingstrup","orcid":"0000-0001-8827-7992","rank":2,"rolecode":"pau"},{"affno":"1","first":"Camilla Trab","key":"damsgaardpau","last":"Damsgaard","locid":"5ea9cc09-17f1-46a3-9e4e-fa5490abd815","name":"Damsgaard, Camilla Trab","orcid":"0000-0002-5013-0562","rank":3,"rolecode":"pau"},{"affno":"1","first":"Louise Bergmann","key":"sørensenpau","last":"Sørensen","locid":"b86d9af7-ea09-4925-a863-eadc0c0e26ee","name":"Sørensen, Louise Bergmann","rank":4,"rolecode":"pau"},{"affno":"1","first":"Mads Fiil","key":"hjorthpau","last":"Hjorth","locid":"00918fa0-7b1e-4128-919e-a0af9497026b","name":"Hjorth, Mads Fiil","orcid":"0000-0001-9440-2737","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Rikke","key":"andersenpau","last":"Andersen","locid":"4906b97e-828c-48ec-9440-08178d4d8c5a","name":"Andersen, Rikke","orcid":"0000-0002-5091-6995","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Inge","key":"tetenspau","last":"Tetens","locid":"471bd31c-6fe2-423c-a500-8ffab1993a2e","name":"Tetens, Inge","rank":7,"rolecode":"pau"},{"affno":"4 5","corresponding":null,"first":"Henrik","key":"kraruppau","last":"Krarup","locid":"72b4ebce-12cf-4f92-bb97-c9a588b06d57","name":"Krarup, Henrik","orcid":"0000-0001-5294-2428","rank":8,"rolecode":"pau"},{"affno":"1","first":"Christian","key":"ritzpau","last":"Ritz","locid":"c881424f-d529-443e-b60e-bc2edb674ede","name":"Ritz, Christian","orcid":"0000-0002-5095-0624","rank":9,"rolecode":"pau"},{"affno":"1","first":"Arne","key":"astruppau","last":"Astrup","locid":"5d943631-c9fc-4b63-8aaa-263ba4248735","name":"Astrup, Arne","orcid":"0000-0001-8968-8996","rank":10,"rolecode":"pau"},{"affno":"1","first":"Kim F.","key":"michaelsenpau","last":"Michaelsen","locid":"c29a2565-4c7e-4a5b-ab39-899baedae963","name":"Michaelsen, Kim F.","orcid":"0000-0003-0449-0839","rank":11,"rolecode":"pau"},{"affno":"1","first":"Christian","key":"mølgaardpau","last":"Mølgaard","locid":"240d0bd3-4221-4d27-bfdb-8fd6887cdb30","name":"Mølgaard, Christian","orcid":"0000-0002-5311-9457","rank":12,"rolecode":"pau"}],"pmid":["28382877"],"pub":{"doi":"10.1017/s0007114517000538","issn":["00071145","14752662"],"issn_org":["00071145"],"issue":"6","journal":"British Journal of Nutrition","pages":"829-838","publisher":"Cambridge University Press","status":"p","title":"British Journal of Nutrition","volume":"117"},"review":"Peer Reviewed","scoID":["2-s2.0-85017126035"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","All University Colleges","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","Hospitals","North Denmark Region","Technical University of Denmark","UCL University College","Universities","University Colleges","University of Copenhagen"],"PST":["Published"]},"sid":["aau-e39f6d57-2dd8-49dc-a177-62dd128e0d26","dtu-a831eab0-9f0b-42b8-90c2-62c99dee50d9","ku-d7dd52e1-a4f6-4805-b203-7583d470cdb5"],"src":["AAU Aalborg University","DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Common genetic variants are associated with lower serum 25-hydroxyvitamin D concentrations across the year among children at northern latitudes","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-097.54-010876","year":"2017","yearsub":"2017"}
{"abstract":"Background Underweight, overweight, and obesity in childhood and adolescence are associated with adverse health consequences throughout the life-course. Our aim was to estimate worldwide trends in mean body-mass index (BMI) and a comprehensive set of BMI categories that cover underweight to obesity in children and adolescents, and to compare trends with those of adults. Methods We pooled 2416 population-based studies with measurements of height and weight on 128·9 million participants aged 5 years and older, including 31·5 million aged 5–19 years. We used a Bayesian hierarchical model to estimate trends from 1975 to 2016 in 200 countries for mean BMI and for prevalence of BMI in the following categories for children and adolescents aged 5–19 years: more than 2 SD below the median of the WHO growth reference for children and adolescents (referred to as moderate and severe underweight hereafter), 2 SD to more than 1 SD below the median (mild underweight), 1 SD below the median to 1 SD above the median (healthy weight), more than 1 SD to 2 SD above the median (overweight but not obese), and more than 2 SD above the median (obesity). Findings Regional change in age-standardised mean BMI in girls from 1975 to 2016 ranged from virtually no change (−0·01 kg/m 2 per decade; 95% credible interval −0·42 to 0·39, posterior probability [PP] of the observed decrease being a true decrease=0·5098) in eastern Europe to an increase of 1·00 kg/m 2 per decade (0·69–1·35, PP>0·9999) in central Latin America and an increase of 0·95 kg/m 2 per decade (0·64–1·25, PP>0·9999) in Polynesia and Micronesia. The range for boys was from a non-significant increase of 0·09 kg/m 2 per decade (−0·33 to 0·49, PP=0·6926) in eastern Europe to an increase of 0·77 kg/m 2 per decade (0·50–1·06, PP>0·9999) in Polynesia and Micronesia. Trends in mean BMI have recently flattened in northwestern Europe and the high-income English-speaking and Asia-Pacific regions for both sexes, southwestern Europe for boys, and central and Andean Latin America for girls. By contrast, the rise in BMI has accelerated in east and south Asia for both sexes, and southeast Asia for boys. Global age-standardised prevalence of obesity increased from 0·7% (0·4–1·2) in 1975 to 5·6% (4·8–6·5) in 2016 in girls, and from 0·9% (0·5–1·3) in 1975 to 7·8% (6·7–9·1) in 2016 in boys; the prevalence of moderate and severe underweight decreased from 9·2% (6·0–12·9) in 1975 to 8·4% (6·8–10·1) in 2016 in girls and from 14·8% (10·4–19·5) in 1975 to 12·4% (10·3–14·5) in 2016 in boys. Prevalence of moderate and severe underweight was highest in India, at 22·7% (16·7–29·6) among girls and 30·7% (23·5–38·0) among boys. Prevalence of obesity was more than 30% in girls in Nauru, the Cook Islands, and Palau; and boys in the Cook Islands, Nauru, Palau, Niue, and American Samoa in 2016. Prevalence of obesity was about 20% or more in several countries in Polynesia and Micronesia, the Middle East and north Africa, the Caribbean, and the USA. In 2016, 75 (44–117) million girls and 117 (70–178) million boys worldwide were moderately or severely underweight. In the same year, 50 (24–89) million girls and 74 (39–125) million boys worldwide were obese. Interpretation The rising trends in children's and adolescents' BMI have plateaued in many high-income countries, albeit at high levels, but have accelerated in parts of Asia, with trends no longer correlated with those of adults. Funding Wellcome Trust, AstraZeneca Young Health Programme.","author_count":25,"contributors":["Bentham, James","Di Cesare, Mariachiara","Bilano, Ver","Jørgensen, Torben","Linneberg, Allan","Michaelsen, Kim F.","Molbo, Drude","Mortensen, Erik Lykke","Osler, Merete","Sørensen, Thorkild I A","Zhussupov, Baurzhan","Zimmermann, Esther","Cisneros, Julio Zuñiga","Damsgaard, Camilla Trab","Ängquist, Lars"],"cuid":["S03-100.00-023226"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"corpau":["NCD Risk Factor Collaboration (NCD-RisC)","NCD Risk Factor Collaboration (NCD-RisC) (Kim Overvad; forfatter)"],"keyword":["Journal Article"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"worldwide trends in body mass index underweight overweight and obesity from 000000001975 to 000000002016 a pooled analysis of 000000002416 population based measurement studies in 000000000128 000000000009 million children adolescents and adults","src":["au","ku","sdu"],"src-code":["DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/S0140-6736(17)32129-3","version":"Published Version"},"id":"S03-100.00-023226","identifier":[{"id":"85030864437","type":"scopus"},{"id":"PMC5735219","type":"pmcid"},{"id":"29029897","type":"pmid"}],"ids":["au-90c61a6f-929d-417a-9a10-f909d6c49e5f","ku-07468ba7-e7d4-4164-b96d-dedfc12693b4","sdu-51c8dd97-c910-415c-86ea-63b0ccd8512c"],"keyword":["Journal Article"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-06A720846E01452E61FCD7856842F86F"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/187075171/NCD_RisC_Lancet_2017_Vol_390_2627_2642.htm","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/129892814/Worldwide_trends_in_body_mass_index_underweight_overweight_and_obesity_from_1975_to_2016.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/S0140-6736(17)32129-3","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"sdu u