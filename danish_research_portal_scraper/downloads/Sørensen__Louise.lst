opean Synchrotron Research Facilit","used":1},{"affno":"3","country":"dk","key":"a p moller maersk","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-MAE","l3nl":"A.P. Møller – Mærsk","l3nn":"A.P. Moller - Maersk","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"A.P. Moller - Maersk","namevar":["Mærsk Oil and Gas A/S"],"nora_code":"DI-PR-MAE","used":1}],"person":[{"affno":"1","first":"Dirk","key":"müterpau","last":"Müter","locid":"76c859c0-2a33-42c0-9933-0cab85960fbc","name":"Müter, Dirk","rank":1,"rolecode":"pau"},{"affno":"1","first":"Henning Osholm","key":"sørensenpau","last":"Sørensen","locid":"e1bf7bae-7f0e-445e-99ea-12eb242407fb","name":"Sørensen, Henning Osholm","orcid":"0000-0002-7004-547X","rank":2,"rolecode":"pau"},{"affno":"1","first":"Diwaker","key":"jhapau","last":"Jha","locid":"513482a1-a9e0-4bcf-b9b0-4eb3a92da3b5","name":"Jha, Diwaker","rank":3,"rolecode":"pau"},{"affno":"1","first":"Ralph Patrick","key":"hartipau","last":"Harti","locid":"e4649eda-0a7d-48f2-b139-eef67d91677d","name":"Harti, Ralph Patrick","rank":4,"rolecode":"pau"},{"affno":"1","first":"Kim Nicole","key":"dalbypau","last":"Dalby","locid":"d4a52fb2-4967-4539-933a-cf2d04a0acb4","name":"Dalby, Kim Nicole","rank":5,"rolecode":"pau"},{"affno":"2","first":"H.","key":"suhonenpau","last":"Suhonen","name":"Suhonen, H.","rank":6,"rolecode":"pau"},{"affno":"1","first":"Robert Krarup","key":"feidenhanslpau","last":"Feidenhans'l","locid":"0a3fb80e-6206-4f37-8e19-12d109fdab12","name":"Feidenhans'l, Robert Krarup","orcid":"0000-0002-7963-3649","rank":7,"rolecode":"pau"},{"affno":"3","first":"F.","key":"engstrømpau","last":"Engstrøm","name":"Engstrøm, F.","rank":8,"rolecode":"pau"},{"affno":"1","first":"Susan Louise Svane","key":"stipppau","last":"Stipp","locid":"b907e7ef-d26a-4093-836b-9b7c9238d956","name":"Stipp, Susan Louise Svane","rank":9,"rolecode":"pau"}],"pub":{"doi":"10.1063/1.4891965","issn":["00036951","10773118"],"issn_org":["00036951"],"journal":"Applied Physics Letters","paperid":