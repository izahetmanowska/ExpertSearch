":"12"},"review":"Peer Reviewed","scoID":["2-s2.0-84858634670"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Other Hospitals","Universities","University of Copenhagen","University of Southern Denmark","the danbio registry"],"PST":["Published"]},"sid":["ku-8d4bebdf-5165-413a-b153-0992dde4e2ac","sdu-6a5743f3-60af-4f90-a14c-7f8d434833a6"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Quality-Adjusted Life Expectancies in Patients with Rheumatoid Arthritis-Comparison of Index Scores from EQ-5D, 15D, and SF-6D","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-098.81-044279","year":"2012","yearsub":"2012"}
{"author_count":2,"contributors":["Hellwing, Anne Louise Frydendahl","Sørensen, Martin Tang"],"cuid":["S01-000.00-155337"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"pop","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"und","rtype":["clu"],"sorti":"effekt af fedt på metanudskillelsen hos kvier","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-155337","ids":["au-2d7aa36e-13d8-4bbf-985e-0e4c7f491932"],"lang":"Danish","level":"Popular","mra":["Science/Technology"],"noi":["Local-1-1-E9F9F84C13821AEAB0A138BC8815699B"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Animal and Veterinary Sciences, Department of Animal and Veterinary Sciences - ANIS Nutrition"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Anne Louise Frydendahl","key":"hellwingpau","last":"Hellwing","locid":"ad65c0e8-8a1c-4f17-bb65-80aec2189e32","name":"Hellwing, Anne Louise Frydendahl","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Martin Tang","key":"sørensenpau","last":"Sørensen","locid":"fefc1862-587c-4b1f-9e20-694246b18221","name":"Sørensen, Martin Tang","orcid":"0000-0002-0523-4282","rank":2,"rolecode":"pau"}],"pub":{"issn":["1603600X"],"issue":"3","journal":"Ny KvægForskning","pages":"4-5","publisher":"Kvægbrugets Forsøgscenter","status":"p","title":"Ny KvægForskning","volume":"10"},"review":"Undetermined","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-2d7aa36e-13d8-4bbf-985e-0e4c7f491932"],"src":["AU Aarhus University"],"title":"Effekt af fedt på metanudskillelsen hos kvier","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-155337","year":"2012","yearsub":"2012"}
{"abstract":"The aim of this study was to test whether the use of X-semen in a dairy cattle population using genomic selection (GS) and multiple ovulation and embryo transfer (MOET) increases the selection intensity on cow dams and thereby the genetic gain in the entire population. Also, the dynamics of using different types of sexed semen (X, Y or conventional) in the nucleus were investigated. The stochastic simulation study partly supported the hypothesis as the genetic gain in the entire population was elevated when X-semen was used in the production population as GS exploited the higher selection intensity among heifers with great accuracy. However, when MOET was applied, the effect was considerably diminished as was the exchange of females between the nucleus and the production population, thus causing modest genetic profit from using X-sorted semen in the production population. In addition, the effect of using sexed semen on the genetic gain was very small compared with the effect of MOET and highly dependent on whether cow dams or bull dams were inseminated with sexed semen and on what type of semen that was used for the bull dams. The rate of inbreeding was seldom affected by the use of sexed semen. However, when all young bull candidates were born following MOET, the results showed that the use of Y-semen in the breeding nucleus tended to decrease the rate of inbreeding as it enabled GS to increase within-family selection. This implies that the benefit from using sexed semen in a modern dairy cattle breeding scheme applying both GS and MOET may be found in its beneficial effect on the rate of inbreeding","author_count":6,"contributors":["Pedersen, Louise Dybdahl","Kargo, Morten","Berg, Peer","Voergaard, Jacob","Hjortø, Line","Sørensen, Anders Christian"],"cuid":["S01-000.00-268212"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Dairy cattle","Genomic selection","Sexed semen","breeding programme"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-PR-OTH","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"genomic selection strategies in dairy cattle breeding programmes sexed semen cannot replace multiple ovulation and embryo transfer as superior reproductive technology","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1111/j.1439-0388.2011.00958.x","version":"Other Version"},"id":"S01-000.00-268212","identifier":[{"id":"84858075673","type":"scopus"},{"id":"22394237","type":"pmid"}],"ids":["au-f37bc742-03f5-4a23-95e6-bfc8c9281462"],"keyword":["MOET","breeding programme","dairy cattle","genomic selection","sexed semen"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-856435CCD4C7DCFFCC5E9FD24317A060"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1111/j.1439-0388.2011.00958.x","version":"Other Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Center for Quantitative Genetics and Genomics"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["Viking Genetics"],"nora_code":"DI-PR-OTH","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Louise Dybdahl","key":"pedersenpau","last":"Pedersen","locid":"7db30fdf-b447-49bb-85b5-f47736335e01","name":"Pedersen, Louise Dybdahl","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Morten","key":"kargopau","last":"Kargo","locid":"a3522626-c405-4303-9d68-3e5f12599c31","name":"Kargo, Morten","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Peer","key":"bergpau","last":"Berg","locid":"142a296b-6be9-4984-8bbb-c6ac4789f017","name":"Berg, Peer","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jacob","key":"voergaardpau","last":"Voergaard","name":"Voergaard, Jacob","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Line Hjortø","key":"buchpau","last":"Buch","locid":"e944b748-5631-41db-a222-ec2f22e7ec67","name":"Hjortø, Line","name_org":"Buch, Line Hjortø","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders Christian","key":"sørensenpau","last":"Sørensen","locid":"8afa1bfd-aee7-4e28-bcfd-25ddabffb8db","name":"Sørensen, Anders Christian","rank":6,"rolecode":"pau"}],"pmid":["22394237"],"pub":{"doi":"10.1111/j.1439-0388.2011.00958.x","issn":["09312668","14390388"],"issn_org":["09312668"],"issue":"2","journal":"Journal of Animal Breeding and Genetics","pages":"152-163","publisher":"Wiley-Blackwell Publishing Ltd","status":"p","title":"Journal of Animal Breeding and Genetics","volume":"129"},"review":"Peer Reviewed","scoID":["2-s2.0-84858075673"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Other Companies","Private Research","Universities","viking genetics"],"PST":["Published"]},"sid":["au-f37bc742-03f5-4a23-95e6-bfc8c9281462"],"src":["AU Aarhus University"],"title":"Genomic selection strategies in dairy cattle breeding programmes: Sexed semen cannot replace multiple ovulation and embryo transfer as superior reproductive technology","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-268212","year":"2012","yearsub":"2012"}
{"abstract":"We combined an ensemble of satellite altimetry, interferometry, and gravimetry data sets using common geographical regions, time intervals, and models of surface mass balance and glacial isostatic adjustment to estimate the mass balance of Earth's polar ice sheets. We find that there is good agreement between different satellite methods--especially in Greenland and West Antarctica--and that combining satellite data sets leads to greater certainty. Between 1992 and 2011, the ice sheets of Greenland, East Antarctica, West Antarctica, and the Antarctic Peninsula changed in mass by -142 ± 49, +14 ± 43, -65 ± 26, and -20 ± 14 gigatonnes year(-1), respectively. Since 1992, the polar ice sheets have contributed, on average, 0.59 ± 0.20 millimeter year(-1) to the rate of global sea-level rise.","author_count":47,"contributors":["Shepherd, Andrew","Ivins, Erik R","A, Geruo","Barletta, Valentina Roberta","Bentley, Mike J","Bettadpur, Srinivas","Briggs, Kate H","Bromwich, David H","Forsberg, René","Galin, Natalia","Horwath, Martin","Jacobs, Stan","Joughin, Ian","King, Matt A","Lenaerts, Jan T M","Li, Jilu","Ligtenberg, Stefan R M","Luckman, Adrian","Luthcke, Scott B","McMillan, Malcolm","Meister, Rakia","Milne, Glenn","Mouginot, Jeremie","Muir, Alan","Nicolas, Julien P","Paden, John","Payne, Antony J","Pritchard, Hamish","Rignot, Eric","Rott, Helmut","Sørensen, Louise Sandberg","Scambos, Ted A","Scheuchl, Bernd","Schrama, Ernst J O","Smith, Ben","Sundal, Aud V","van Angelen, Jan H","van de Berg, Willem J","van den Broeke, Michiel R","Vaughan, David","Velicogna, Isabella","Wahr, John","Whitehouse, Pippa L","Wingham, Duncan J","Yi, Donghui","Young, Duncan","Zwally, H Jay"],"cuid":["S01-000.00-348687"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","University of Colorado Boulder"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"a reconciled estimate of ice sheet mass balance","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1126/science.1228102","version":"Other Version"},"id":"S01-000.00-348687","identifier":[{"id":"84870202275","type":"scopus"}],"ids":["dtu-93d9369e-ee23-4aea-ad92-4d0c7a7b181e"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-C820B732E394B39322E992645FBF8CC9"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1126/science.1228102","version":"Other Version"}],"org":[{"affno":"1","country":"us","key":"university of colorado boulder","loc":["United States","America, North","OECD"],"name":"University of Colorado Boulder","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Space Institute","Technical University of Denmark, National Space Institute, Geodynamics"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Andrew","key":"shepherdpau","last":"Shepherd","name":"Shepherd, Andrew","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Erik R","key":"ivinspau","last":"Ivins","name":"Ivins, Erik R","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Geruo","key":"apau","last":"A","name":"A, Geruo","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Valentina Roberta","key":"barlettapau","last":"Barletta","locid":"9662b7b8-5901-45b2-bba3-dd8e3879f864","name":"Barletta, Vale