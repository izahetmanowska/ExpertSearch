{"author_count":5,"contributors":["Hellwing, Anne Louise Frydendahl","Sørensen, Martin Tang","Weisbjerg, Martin Riis","Vestergaard, Mogens","Lund, Peter"],"cuid":["S01-000.00-160667"],"event":{"end":"2012-11-06","place":"Oslo, no","start":"2012-11-05","title":"Agriculture and greenhouse gases","year":"2012"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"nr","rtype":["clu"],"sorti":"can crushed rapeseed lower methane emissions from heifers","src":["au"],"src-code":["DI-U-AU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-160667","ids":["au-36d45df0-dbec-4d62-8e7d-257893330ef0"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-8E4131F91D554A23162BBC1ABE031236"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Animal and Veterinary Sciences, Department of Animal and Veterinary Sciences - ANIS Nutrition"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Anne Louise Frydendahl","key":"hellwingpau","last":"Hellwing","locid":"ad65c0e8-8a1c-4f17-bb65-80aec2189e32","name":"Hellwing, Anne Louise Frydendahl","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Martin Tang","key":"sørensenpau","last":"Sørensen","locid":"fefc1862-587c-4b1f-9e20-694246b18221","name":"Sørensen, Martin Tang","orcid":"0000-0002-0523-4282","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Martin Riis","key":"weisbjergpau","last":"Weisbjerg","locid":"