sen","locid":"b86d9af7-ea09-4925-a863-eadc0c0e26ee","name":"Sørensen, Louise Bergmann","name_org":"Sørensen, Louise B","rank":4,"rolecode":"pau"},{"affno":"1","first":"Mads Fiil","key":"hjorthpau","last":"Hjorth","locid":"00918fa0-7b1e-4128-919e-a0af9497026b","name":"Hjorth, Mads Fiil","orcid":"0000-0001-9440-2737","rank":5,"rolecode":"pau"},{"affno":"1","first":"Christian","key":"ritzpau","last":"Ritz","locid":"c881424f-d529-443e-b60e-bc2edb674ede","name":"Ritz, Christian","orcid":"0000-0002-5095-0624","rank":6,"rolecode":"pau"},{"affno":"1","first":"Louise","key":"kjølbækpau","last":"Kjølbæk","locid":"704b196a-527d-4a0b-9a32-7dcdfdb8a3fd","name":"Kjølbæk, Louise","orcid":"0000-0003-4310-9332","rank":7,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Rikke","key":"andersenpau","last":"Andersen","locid":"4906b97e-828c-48ec-9440-08178d4d8c5a","name":"Andersen, Rikke","orcid":"0000-0002-5091-6995","rank":8,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Inge","key":"tetenspau","last":"Tetens","locid":"471bd31c-6fe2-423c-a500-8ffab1993a2e","name":"Tetens, Inge","rank":9,"rolecode":"pau"},{"affno":"4 5 6","corresponding":null,"first":"Henrik","key":"kraruppau","last":"Krarup","locid":"72b4ebce-12cf-4f92-bb97-c9a588b06d57","name":"Krarup, Henrik","orcid":"0000-0001-5294-2428","rank":10,"rolecode":"pau"},{"affno":"1","first":"Arne","key":"astruppau","last":"Astrup","locid":"5d943631-c9fc-4b63-8aaa-263ba4248735","name":"Astrup, Arne","orcid":"0000-0001-8968-8996","rank":11,"rolecode":"pau"},{"affno":"1","first":"Kim F.","key":"michaelsenpau","last":"Michaelsen","locid":"c29a2565-4c7e-4a5b-ab39-899baedae963","name":"Michaelsen, Kim F.","orcid":"0000-0003-0449-0839","rank":12,"rolecode":"pau"},{"affno":"1","first":"Christian","key":"mølgaardpau","last":"Mølgaard","locid":"240d0bd3-4221-4d27-bfdb-8fd6887cdb30","name":"Mølgaard, Christian","orcid":"0000-0002-5311-9457","rank":13,"rolecode":"pau"}],"pmid":["26563915"],"pub":{"doi":"10.1017/s000711451500433x","issn":["00071145","14752662"],"issn_org":["00071145"],"journal":"British Journal of Nutrition","pages":"1-12","publisher":"Cambridge University Press","status":"p","title":"British Journal of Nutrition","title_org":"The British Journal of Nutrition","volume":"Ahead of print"},"review":"Peer Reviewed","scoID":["2-s2.0-84951559107"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","All University Colleges","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","Hospitals","North Denmark Region","Technical University of Denmark","UCL University College","Universities","University Colleges","University of Copenhagen"],"PST":["Published"]},"sid":["aau-acfbcc7b-c369-422b-91f1-44fd68b56c11","dtu-16f7d7c9-c8d4-4327-b552-6bef74aacc5d","ku-0d09b975-b6b6-432e-be12-8b9e03830ce4","ucl-c972e0c2-59fc-4f3d-9a75-1ec12a248298"],"src":["AAU Aalborg University","DTU Technical University of Denmark","KU University of Copenhagen","UCL University College"],"title":"Vitamin D status and its determinants during autumn in children at northern latitudes : a cross-sectional analysis from the optimal well-being, development and health for Danish children through a healthy New Nordic Diet (OPUS) School Meal Study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-091.57-008325","year":2016,"yearsub":2016}
{"abstract":"Denne artikel har til formål at stille skarpt på den viden om beskæftigelsespolitikken, der findes i konkrete oplevelser og erfaringer blandt de aktivitetsparate kontanthjælpsmodtagere, som også er genstand for samme politik. Udgangspunktet for artiklen er en erkendelse af, at målgruppen af borgere på kanten af arbejdsmarkedet sjældent bliver hørt – hverken i den politiske debat eller i de forskningsbaserede analyser af politikken – samtidig med, at beskæftigelsespolitikken de sidste mange år har været genstand for en reformtsunami, der gang på gang har ændret på de regler og rammer, hvorunder disse borgere skal agere og søge at være aktive i deres forløb mod arbejdsmarkedet. Det gælder blandt andet kontanthjælpsloftet og 225-timers reglen, som blev genindført i oktober i år samt de seneste års større reformer på kontanthjælps-, førtidspensions- og fleksjobområdet. Ved at trække på ny forskning på feltet, demonstrerer artiklen nogle af de potentialer og former for viden, der dukker op, når borgerne betragtes som kritiske kompetente aktører, der besidder en værdifuld viden i forhold til forståelsen af, hvordan beskæftigelsespolitikken får sin virkning i praksis hos den enkelte borger.","author_count":13,"contributors":["Jensen, Sophie Danneris"],"cuid":["S01-000.00-053019"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"nr","rtype":["clu"],"sorti":"er du klar til at arbejde beskæftigelsesindsatsen set fra et borgerperspektiv","src":["aau"],"src-code":["DI-U-AAU"],"type":"dra","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://www.casa-analyse.dk/wp-content/uploads/2016/12/Social-A%CC%8Arsrapport-2016.pdf","version":"Published Version"},"id":"S01-000.00-053019","ids":["aau-0a5084ac-6a5