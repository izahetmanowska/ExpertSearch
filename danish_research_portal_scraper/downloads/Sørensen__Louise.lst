003-0449-0839","rank":15,"rolecode":"pau"}],"pmid":["25323030"],"pub":{"doi":"10.1017/s0007114514003043","issn":["00071145","14752662"],"issn_org":["00071145"],"issue":"11","journal":"British Journal of Nutrition","pages":"1826-1836","publisher":"Cambridge University Press","status":"p","title":"British Journal of Nutrition","volume":"112"},"review":"Peer Reviewed","scoID":["2-s2.0-84924932802"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-ef61238f-35f4-48f7-b12d-43a40dbaef4c","ku-702d8ff4-0856-4e45-acda-7c40d41619ba"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Provision of healthy school meals does not affect the metabolic syndrome score in 8-11-year-old children, but reduces cardiometabolic risk markers despite increasing waist circumference","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.95-037917","year":"2014","yearsub":"2014"}
{"abstract":"Intraarterial therapy (IAT) in acute ischemic stroke is effective for opening occlusions of major extracranial or intracranial vessels. Clinical efficacy data are lacking pointing to a need for proper patient selection. We examined feasibility, clinical impact, and safety profile of magnetic resonance imaging (MRI) for patient selection before IAT. In this single-center study, we collected epidemiologic, imaging, and outcome data on all intraarterial-treated patients presenting with anterior circulation occlusions at our center from 2004 to 2011. Magnetic resonance imaging was the first imaging choice. Computer tomography (CT) was performed in the presence of a contraindication. We treated 138 patients. Mean age was 64 years and median National Institutes of Health Stroke Scale (NIHSS) was 17. Major reperfusion (thrombolysis in cerebral infarction (TICI) 2b+3) was achieved in 52% and good outcome defined as modified Rankin Scale (mRS) score 0 to 2 at 90 days was achieved in 41%. Mortality at 90 days was 10%. There was only one symptomatic hemorrhage. Recanalization, age, and stroke severity were associated with outcome. Preprocedure MRI was obtained in 83%. Good outcome was significantly associated with smaller diffusion-weighted imaging (DWI) lesion size at presentation and not with the size of the perfusion lesion. It is feasible to triage patients for IAT using MRI with acceptable rates of poor outcome and symptomatic hemorrhage.Journal of Cerebral Blood Flow & Metabolism advance online publication, 2 April 2014; doi:10.1038/jcbfm.2014.57.","author_count":8,"contributors":["Simonsen, Claus Ziegler","Sørensen, Leif Hougaard","Karabegovic, Sanja","Mikkelsen, Irene Klærke","Schmitz, Marie Louise","Juul, Niels","Yoo, Albert J","Andersen, Grethe"],"cuid":["S01-000.00-195960"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","Harvard University"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"mri before intraarterial therapy in ischemic stroke feasibility impact and safety","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1038/jcbfm.2014.57","version":"Other Version"},"id":"S01-000.00-195960","identifier":[{"id":"24690941","type":"pmid"},{"id":"PMC4050253","type":"pmcid"},{"id":"84901828329","type":"scopus"}],"ids":["au-74b9472d-f220-4ce9-a1a4-f44d29b15e9c"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-380A52FF90A2E97A21C085CF7C8C3717"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1038/jcbfm.2014.57","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Department of Neurology"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"us","key":"harvard university","loc":["United States","America, North","OECD"],"name":"Harvard University","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Claus Z","key":"simonsenpau","last":"Simonsen","locid":"ccf2fb52-6a4a-45b2-adb0-d6e83324879f","name":"Simonsen, Claus Ziegler","name_org":"Simonsen, Claus Z","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Leif H","key":"sørensenpau","last":"Sørensen","locid":"c61295b9-5523-47cf-8bb6-bfca2f638826","name":"Sørensen, Leif Hougaard","name_org":"Sørensen, Leif H","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sanja","key":"karabegovicpau","last":"Karabegovic","locid":"9c071e34-fcd5-457f-9b10-0122fa4f099e","name":"Karabegovic, Sanja","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Irene K","key":"mikkelsenpau","last":"Mikkelsen","locid":"449c9e73-c379-4921-993e-0ba5494ecc66","name":"Mikkelsen, Irene Klærke","name_org":"Mikkelsen, Irene K","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Marie L","key":"schmitzpau","last":"Schmitz","locid":"04ecc9db-aa29-4408-9ef5-30b84da5362d","name":"Schmitz, Marie Louise","name_org":"Schmitz, Marie L","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Niels","key":"juulpau","last":"Juul","locid":"88efc83f-3bc8-4166-89f8-b6df5729a5bc","name":"Juul, Niels","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Albert J","key":"yoopau","last":"Yoo","name":"Yoo, Albert J","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Grethe","key":"andersenpau","last":"Andersen","locid":"97e157c9-4cb4-4690-a971-06e4699b50fe","name":"Andersen, Grethe","orcid":"0000-0001-6807-2500","rank":8,"rolecode":"pau"}],"pmid":["24690941"],"pub":{"doi":"10.1038/jcbfm.2014.57","issn":["0271678X","15597016"],"issn_org":["0271678X"],"issue":"6","journal":"Journal of Cerebral Blood Flow and Metabolism","pages":"1076-1081","publisher":"SAGE Publications Inc.","status":"p","title":"Journal of Cerebral Blood Flow and Metabolism","volume":"34"},"review":"Peer Reviewed","scoID":["2-s2.0-84901828329"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-74b9472d-f220-4ce9-a1a4-f44d29b15e9c"],"src":["AU Aarhus University"],"title":"MRI before intraarterial therapy in ischemic stroke : feasibility, impact, and safety","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-195960","year":"2014","yearsub":"2014"}
{"abstract":"Constraining glacial isostatic adjustment (GIA) i.e. the Earth’s viscoelastic response to past ice changes, is an important task, because GIA is a significant correction in gravity-based ice sheet mass balance estimates. Here, we investigate how temporal variations in the observed and modeled crustal displacements due to the Earth’s response to ongoing ice mass changes can contribute to the process of constraining GIA. We use mass change grids of the Greenland ice sheet (GrIS) derived from NASA’s high resolution Ice, Cloud and land Elevation Satellite (ICESat) data in three overlapping time spans covering the period 2004–2009 to estimate temporal variations in the elastic response due to present day ice mass loss. The modeled crustal displacements (elastic + GIA) are compared with GPS time series from five permanent sites (KELY, KULU, QAQ1, THU2, and SCOR). We find, that the modeled pattern of elastic crustal displacements shows pronounced variation during the observation period, where an increase in elastic displacement is found at the northwest coast of Greenland, while a decrease is found at the southeast coast. This pattern of temporal changes is supported by the GPS observations. We find, that the temporal behavior of the ICESat-based modeled elastic response agrees well with the GPS observations at the sites KELY, QAQ1, and SCOR. This suggests, that our elastic models are able to resolve the temporal changes in the observed uplift, which indicates that the elastic uplift models are reliable at these sites. Therefore, we conclude that these sites are useful for constraining GIA.","author_count":8,"contributors":["Nielsen, Karina","Sørensen, Louise Sandberg","Khan, Shfaqat Abbas","Spada, Giorgio","Simonsen, Sebastian Bjerregaard","Forsberg, René"],"cuid":["S01-000.00-312697"],"event":{"end":"2011-07-07","place":"Melbourne, au","start":"2011-06-28","title":"2011 IAG General Assembly","year":"2011"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Italy"],"glorg":["All Global Affiliations","Università degli Studi di Urbino Carlo Bo"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"towards constraining glacial isostatic adjustment in greenland using icesat and gps observations","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/80913070/nielsen2014.pdf","version":"Other Version"},"id":"S01-000.00-312697","identifier":[{"id":"84927609629","type":"scopus"}],"ids":["dtu-1b1e0cbc-336f-418e-a403-3d58c8e08bae"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-0EA607E096EF35B018EDB27CC9C6F1D2"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/80913070/nielsen2014.pdf","version":"Other Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Space Institute","Technical University of Denmark, National Space Institute, Geodesy"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"it","key":"università degli studi di urbino carlo bo","loc":["Italy","Europe, EU","OECD"],"name":"Università degli Studi di Urbino Carlo Bo","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Karina","key":"nielsenpau","last":"Nielsen","locid":"35a43dde-d05b-4527-b0e7-1094f9e66c04","name":"Nielsen, Karina","orcid":"0000-0002-0035-1869","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":