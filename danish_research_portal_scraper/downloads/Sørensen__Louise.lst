 denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Center for Bachelor of Engineering Studies"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Lotte B.","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Lotte B.","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Cheng","key":"wangpau","last":"Wang","name":"Wang, Cheng","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Kaspar","key":"sorensenpau","last":"Sorensen","name":"Sorensen, Kaspar","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Claus Heiner","key":"bangberthelsenpau","last":"Bang-Berthelsen","name":"Bang-Berthelsen, Claus Heiner","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Lars","key":"hansenpau","last":"Hansen","locid":"9030759d-a4e5-4343-ae73-9eb6eb5b8742","name":"Hansen, Lars","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Marie-Louise M.","key":"andersenpau","last":"Andersen","name":"Andersen, Marie-Louise M.","rank":6,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Philip","key":"hougaardpau","last":"Hougaard","name":"Hougaard, Philip","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Anders Christian","key":"juulpau","last":"Juul","locid":"3efaa17d-7c0f-41ab-aa32-c3a8e7cea085","name":"Juul, Anders Christian","rank":8,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Chen-Yu","key":"zhangpau","last":"Zhang","name":"Zhang, Chen-Yu","rank":9,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Flemming","key":"pociotpau","last":"Pociot","name":"Pociot, Flemming","rank":10,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Henrik B.","key":"mortensenpau","last":"Mortensen","name":"Mortensen, Henrik B.","rank":11,"rolecode":"pau"}],"pub":{"doi":"10.1155/2012/896362","issn":["23146745","23146753"],"issn_org":["23146745"],"journal":"Journal of Diabetes Research","paperid":"896362","publisher":"Hindawi Publishing Corporation","status":"p","title":"Journal of Diabetes Research","title_org":"Experimental Diabetes Research","volume":"2012"},"review":"Peer Reviewed","scoID":["2-s2.0-84864981566"],"sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-8d03c0d0-bbf7-4c83-9773-a02da6d4145e"],"src":["DTU Technical University of Denmark"],"title":"Circulating Levels of MicroRNA from Children with Newly Diagnosed Type 1 Diabetes and Healthy Controls: Evidence That miR-25 Associates to Residual Beta-Cell Function and Glycaemic Control during Disease Progression : evidence that miR-25 associates to residual beta-cell function and glycaemic control during disease progression","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-798183","year":"2012","yearsub":"2012"}
{"abstract":"Using the conventional techniques of mineralogy, it has been a challenge to determine mineral identity, crystal orientation and spatial position of micrometer-sized crystals that are embedded in a rock, sediment or soil. Traditionally, the individual grains must be extracted and analyzed separately. Crushing or disintegrating a sample annihilates any possibility for gathering information from the texture of the porous media or the mineral assemblage close to the grains in question. A new method using three-dimensional X-ray diffraction (3DXRD) microscopy can be successfully applied to natural materials. We combined X-ray microtomography (XMT) and 3DXRD to investigate a sample of very fine-grained chalk containing fracture minerals. The XMT technique provides three-dimensional images of the particles and pore structure at very high resolution (350 nm voxel dimension) on samples less than 500 μm in diameter. The minor phases present as crystals in fractures were determined nondestructively with 3DXRD microscopy. The chalk fragment investigated is composed predominantly of randomly oriented nanometric crystals of calcite that produce powder rings where no texture can be observed. Superimposed on this pattern, Bragg diffraction peaks from the other crystalline phases were observed. Individual crystals of barite and pyrite only a few micrometers in diameter are present in the fractures. Magnetite, celestine and siderite, other minerals that might have been expected based on the XMT absorption contrast, were not identified. The crystal shape and in-fracture location, derived from the microtomograms, and the mineral identity, derived from 3DXRD, allowed us to propose that the fractures are original in these tiny drill cuttings; they were not induced by drilling and filled with drilling mud particles, thus allowing reliable estimates to be made of rock porosity and permeability.","author_count":13,"contributors":["Sørensen, Henning O.","Hakim, Sepide S.","Pedersen, Stefan","Christiansen, Christian Bo","Balogh, Zoltan Imre","Hem, Caroline Piper","Pasarin, Ivan S.","Schmidt, Søren","Olsen, Ulrik Lund","Oddershede, Jette","Frandsen, Cathrine","Feidenhans’L, Robert","Stipp, Susan Louise Svane"],"cuid":["S02-099.02-035920"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"keyword":["3DXRD microscopy","Chalk","X Ray Microtomography"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Fuel Cells and Solid State Chemistry Division"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU","DI-U-UND"]},"level3all":["DI-U-DTU","DI-U-KU","DI-U-UND"]},"review":"pr","rtype":["clu"],"sorti":"non destructive identification of micrometer scale minerals and their position within a bulk sample","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.3749/canmin.50.2.501","version":"Other Version"},"id":"S02-099.02-035920","identifier":[{"id":"84864563314","type":"scopus"}],"ids":["dtu-921632aa-a325-41cb-8d82-cc840d5b081f","ku-8e975173-399d-490b-bc1f-d97b592b1982"],"keyword":["3DXRD microscopy","Chalk","Porous natural materials","X-ray microtomography"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-FEBE234FF7742AE5F6F6A14B9B5ED130"],"oa_link":[{"access":"oa","type":"rem","url":"http://www.canmin.org/content/50/2/501.full","version":"Other Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.3749/canmin.50.2.501","version":"Other Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Chemistry"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Informatics and Mathematical Modeling","Technical University of Denmark, Department of Physics","Technical University of Denmark, Department of Physics, Neutrons and X-rays for Materials Physics"],"nora_code":"DI-U-DTU","used":1},{"affno":"3","country":"dk","key":"unclear universities","l2":"DI-U","l2n":"Universities","l3":"DI-U-UND","l3nl":"Undetermined","l3nn":"Unclear Universities","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Unclear Universities","namevar":["Department of Physics"],"nora_code":"DI-U-UND","used":1},{"affno":"4","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Fuel Cells and Solid State Chemistry Division"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","first":"Henning Osholm","key":"sørensenpau","last":"Sørensen","locid":"e1bf7bae-7f0e-445e-99ea-12eb242407fb","name":"Sørensen, Henning Osholm","orcid":"0000-0002-7004-547X","rank":1,"rolecode":"pau"},{"affno":"","first":"Sepidehsadat","key":"hakimpau","last":"Hakim","locid":"60c6860c-4c94-4b91-95ff-45e802cdc01a","name":"Hakim, Sepideh Sadat","name_org":"Hakim, Sepidehsadat","orcid":"0000-0001-6486-4551","rank":2,"rolecode":"pau"},{"affno":"1","first":"Stefan","key":"pedersenpau","last":"Pedersen","name":"Pedersen, Stefan","rank":3,"rolecode":"pau"},{"affno":"1","first":"Bo C.","key":"christiansenpau","last":"Christiansen","locid":"04c4774d-eb7d-4c24-8a96-96e12df83869","name":"Christiansen, Bo C.","rank":4,"rolecode":"pau"},{"af