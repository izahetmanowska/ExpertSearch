m","name":"Søholm, Helle","rank":18,"rolecode":"pau"}],"pub":{"doi":"10.1161/circ.144.suppl_2.10522","issn":["00097322","15244539"],"issn_org":["00097322"],"issue":"Suppl_2","journal":"Circulation","paperid":"10522","publisher":"Lippincott Williams and Wilkins","status":"p","title":"Circulation","volume":"144"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-8acc1421-d4e9-4455-9e49-9b97590b6c0d","sdu-802ca965-11f2-4a6f-bc26-2b04903cd7ad"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"Early Lactate Clearance is Associated With Survival in a National Cohort of Refractory Out-of-Hospital Cardiac Arrest Patients Managed With Extracorporeal Cardiopulmonary Resuscitation","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-088.86-022778","year":"2021","yearsub":"2021"}
{"abstract":"Objectives: Human milk oligosaccharides (HMOs) impact the intestinal microbiota by increasing beneficial bacteria in infants and adults, and are safe and well tolerated in these age groups. Effects on intestinal microbiota, safety, and digestive tolerance in children have not been, however, assessed. The aims of this trial were to evaluate if HMOs are able to specifically modulate the intestinal microbiota in children, and to assess safety and digestive tolerance. Methods: In this randomized, double-blinded, placebo-controlled trial, 75 children with overweight (including obesity) ages 6 to 12 years were randomized to receive 2 '-fucosyllactose (2 ' FL), a mix of 2 ' FL and lacto-N-neotetraose (Mix), or a glucose placebo orally administrated once per day for 8 weeks. Results: The relative abundance of bifidobacteria increased significantly after 4 (P < 0.001) and 8 (P = 0.025) weeks of intervention in the 2 ' FL-group and after 4 weeks (P = 0.033) in the Mix-group, whereas no change was observed in the placebo group. Compared with placebo, the 2 ' FL-group had a significant increase in bifidobacteria abundance after 4 weeks (P < 0.001) and 8 weeks (P = 0.010) and the Mix-group showed a tendency to increased bifidobacteria abundance after 4 (P = 0.071) and 8 weeks (P = 0.071). Bifidobacterium adolescentis drove the bifidogenic effect in the 2 groups. Biochemical markers indicated no safety concerns, and the products did not induce digestive tolerance issues as assessed by Gastrointestinal Symptoms Rating Scale and Bristol Stool Form Scale. Conclusions: Both 2 ' FL and the Mix beneficially modulate intestinal microbiota by increasing bifidobacteria. Furthermore, supplementation with either 2 ' FL alone or a Mix is safe and well tolerated in children.","author_count":10,"contributors":["Fonvig, Cilius Esmann","Amundsen, Ingvild Dybdrodt","Vigsnæs, Louise Kristine","Sørensen, Nikolaj","Frithioff-Bøjsøe, Christine","Christiansen, Michael","Hedley, Paula Louise","Holm, Louise Aas","McConnell, Bruce","Holm, Jens-Christian"],"cuid":["S02-097.90-046380"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Fonvig, Cilius Esmann"],"keyword":["2 Fucosyllactose","Bifidobacteria","Formula","Gut microbiota","Irritable bowel syndrome","Lacto N neotetraose","MODEL","Metabolism","Supplementation"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-PR","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-ZEA"],"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-GV-SSI","DI-HO-ZEA","DI-PR-OTH","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"human milk oligosaccharides modulate fecal microbiota and are safe for use in children with overweight a randomized controlled trial","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1097/MPG.0000000000003205","version":"Published Version"},"id":"S02-097.90-046380","identifier":[{"id":"000683060000029","type":"wos"},{"id":"34139746","type":"pmid"},{"id":"85114846048","type":"scopus"}],"ids":["ku-d0afccfa-7560-48eb-baaf-ad46fc59acf1","sdu-4f9a267a-d11c-45e3-8418-f7ba6ec5d66e"],"keyword":["2 '-Fucosyllactose","FORMULA","IRRITABLE-BOWEL-SYNDROME","METABOLISM","MODEL","SUPPLEMENTATION","bifidobacteria","gut microbiota","lacto-N-neotetraose"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-EED4C1D5ADCA495E15DB2139FB23E4DC"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/276699617/Human_Milk_Oligosaccharides_Modulate_Fecal.27.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1097/MPG.0000000000003205","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/191854164/Open_Access_Version.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Novo Nordisk Foundation Center for Basic Metabolic Research, Hansen Group"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS - Lillebælt Hospital, Research Unit of Paediatrics (Kolding)"],"nora_code":"DI-U-SDU","used":1},{"affno":"3","country":"dk","key":"region zealand","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-ZEA","l3nl":"Region Zealand","l3nn":"Region Zealand","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region Zealand","namevar":["Holbæk Sygehus"],"nora_code":"DI-HO-ZEA","used":1},{"affno":"4","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["DSM, Hørsholm (Biz)"],"nora_code":"DI-PR-OTH","used":1},{"affno":"5","country":"dk","key":"ssi statens serum institut","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-SSI","l3nn":"SSI Statens Serum Institut","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SSI Statens Serum Institut","namevar":["Statens Serum Institut"],"nora_code":"DI-GV-SSI","used":1}],"person":[{"affno":"1 2 3","first":"Cilius Esmann","key":"fonvigciliusesmannpau","last":"Fonvig","locid":"d55161eb-c979-434f-bfa8-05d2675553d2","name":"Fonvig, Cilius Esmann","orcid":"0000-0002-5031-0125","rank":1,"rolecode":"pau"},{"affno":"4","first":"Ingvild Dybdrodt","key":"amundseningvilddybdrodtpau","last":"Amundsen","name":"Amundsen, Ingvild Dybdrodt","rank":2,"rolecode":"pau"},{"affno":"4","first":"Louise Kristine","key":"vigsnæslouisekristinepau","last":"Vigsnæs","name":"Vigsnæs, Louise Kristine","rank":3,"rolecode":"pau"},{"affno":"4","first":"Nikolaj","key":"sørensennikolajpau","last":"Sørensen","name":"Sørensen, Nikolaj","rank":4,"rolecode":"pau"},{"affno":"1","first":"Christine","key":"frithioffbøjsøechristinepau","last":"Frithioff-Bojsoe","locid":"30a3e531-560f-4477-8bd6-976c2c56e21d","name":"Frithioff-Bøjsøe, Christine","name_org":"Frithioff-Bojsoe, Christine","orcid":"0000-0002-5005-7780","rank":5,"rolecode":"pau"},{"affno":"1","first":"Michael","key":"christiansenmichaelpau","last":"Christiansen","locid":"0d441558-1f08-45e7-9c01-3eb9769dd55b","name":"Christiansen, Michael","rank":6,"rolecode":"pau"},{"affno":"5","first":"Paula Louise","key":"hedleypaulalouisepau","last":"Hedley","name":"Hedley, Paula Louise","rank":7,"rolecode":"pau"},{"affno":"1","first":"Louise Aas","key":"holmlouiseaaspau","last":"Holm","locid":"3c8db4dd-1b63-4f0c-8b8b-606ecb645ef9","name":"Holm, Louise Aas","orcid":"0000-0002-5439-5429","rank":8,"rolecode":"pau"},{"affno":"4","first":"Bruce","key":"mcconnellbrucepau","last":"McConnell","name":"McConnell, Bruce","rank":9,"rolecode":"pau"},{"affno":"1","first":"Jens-Christian","key":"holmjenschristianpau","last":"Holm","locid":"d61af840-e87e-4a2e-8be2-b481959ef6c9","name":"Holm, Jens-Christian","rank":10,"rolecode":"pau"}],"pmid":["34139746"],"pub":{"doi":"10.1097/mpg.0000000000003205","issn":["02772116","15364801"],"issn_org":["02772116"],"issue":"3","journal":"Journal of Pediatric Gastroenterology and Nutrition","pages":"408-414","publisher":"Wiley","status":"p","title":"Journal of Pediatric Gastroenterology and Nutrition","volume":"73"},"review":"Peer Reviewed","scoID":["2-s2.0-85114846048"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Hospitals","All Private Research","All Universities","Capital Region of Denmark","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Other Companies","Private Research","Region Zealand","Universities","University of Copenhagen","University of Southern Denmark","clinical microbiomics","clinical-microbiomics a/s (biz)","dsm","dsm, hørsholm (biz)"],"PST":["Published"]},"sid":["ku-d0afccfa-7560-48eb-baaf-ad46fc59acf1","sdu-4f9a267a-d11c-45e3-8418-f7ba6ec5d66e"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Human Milk Oligosaccharides Modulate Fecal Microbiota and Are Safe for Use in Children With Overweight : A Randomized Controlled Trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-097.90-046380","year":"2021","yearsub":"2021"}
{"abstract":"Background: Polycaprolactone (PCL) scaffolds exhibit high biocompatibility and are attractive as vascular conduits. Materials & methods: PCL tubes were cultivated in bioreactor with human adipose regenerative cells to assess ex vivo cytocompatibility, whereas in vivo PCL tube patency was evaluated in sheep carotid bypass with and without antithrombotic treatment. Results: Ex vivo results revealed increasing adipose regenerative cells on PCL using dynamic bioreactor culturing. In vivo data showed that 67% (2/3) of grafts in the antithrombotic group were patent at day 28, while 100% (3/3) of control grafts were occluded already during the first week due to thrombosis. Histology showed that patent PCL grafts were recellularized by host cells. Conclusion: PCL tubes may work as small diameter vascular scaffolds under antithrombotic treatment.","author_count":9,"contributors":["Fang, Shu","Ahlmann, Alexander Høgsted","Langhorn, Louise","Hussein, Kamal","Sørensen, Jens Ahm","Guan, Xiaowei","Sheikh, Søren Paludan","Riber, Lars Peter","Andersen, Ditte Caroline"],"cuid":["S02-099.85-037684"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Africa"],"corresponding_author":["Andersen, Ditte Caroline"],"country":["Egypt"],"glorg":["All Global Affiliations","Assiut University"],"keyword":["Biodegradable","Polycaprolactone","Sheep carotid bypass model","Small diameter artery","Tissue engineered vascular grafts"],"level":"sci","mra":["med","sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-SDU"]},"level3all":["DI-U-DTU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"small diameter polycaprolactone vascular grafts are patent in sheep carotid bypass but require antithrombotic therapy","src":["dtu","sdu"],"src-code":["DI-U-DTU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85103596522","version":"Other Version"},"id":"S02-099.85-037684","identifier":[{"id":"85103596522","type":"scopus"},{"id":"33764157","type":"pmid"}],"ids":["dtu-e3ae3326-0c88-4ff9-9aa3-ea3d989e3a77","sdu-50860593-a202-4263-bd6d-dea8cfbac484"],"keyword":["Biodegradable","Polycaprolactone","Sheep carotid bypass model","Small diameter artery","TEVGs","Tissue engineered vascular grafts"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-256BBA9F001D5F723DBE9E970BCEFE78"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Clinical Biochemistry (Odense)","SDU, The Faculty of Health Sciences, Department of Molecular Medicine, Cardiovascular and Renal Research Unit"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"eg","key":"assiut university","loc":["Egypt","Africa"],"name":"Assiut University","used":1},{"affno":"3","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Centers, Centre of Excellence for Silicon Photonics for Optical Communications","Technical University of Denmark, Department of Photonics Engineering","Technical University of Denmark, Department of Photonics Engineering, Nanophotonic Devices"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Shu","key":"fangpau","last":"Fang","locid":"7add42ac-1b35-4c13-8be6-2bd437324062","name":"Fang, Shu","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Alexander Høgsted","key":"ahlmannpau","last":"Ahlmann","locid":"a8deee4b-acc8-481d-915d-7ba64b16bf7d","name":"Ahlmann, Alexander Høgsted","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Louise","key":"langhornpau","last":"Langhorn","locid":"6edd2d76-1416-4d4a-a33f-28c5108f4b87","name":"Langhorn, Louise","orcid":"0000-0001-5787-1120","rank":3,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Kamal","key":"husseinpau","last":"Hussein","locid":"cd7afed4-097b-4892-aef6-93a735333f99","name":"Hussein, Kamal","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jens Ahm","key":"sørensenpau","last":"Sørensen","locid":"267cd59a-3918-47db-8d23-54015d770b6c","name":"Sørensen, Jens Ahm","orcid":"0000-0003-4903-0094","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Xiaowei","key":"guanpau","last":"Guan","locid":"28e4a5aa-7d40-4a13-b50b-9a4901507b19","name":"Guan, Xiaowei","orcid":"0000-0003-1393-6214","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren Paludan","key":"sheikhpau","last":"Sheikh","locid":"5773a0d9-ed2e-4bd4-8232-b68ee8d6cb09","name":"Sheikh, Søren Paludan","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lars Peter","key":"riberpau","last":"Riber","locid":"607e34a6-2b96-4466-ad5f-48b2c188f589","name":"Riber, Lars","name_org":"Riber, Lars Peter","orcid":"0000-0001-6898-2715","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ditte Caroline","key":"andersenpau","last":"Andersen","locid":"884ca799-a3a4-4b7c-8b36-270846e5b8f9","name":"Andersen, Ditte Caroline","orcid":"0000-0003-4940-7912","rank":9,"rolecode":"pau"}],"pmid":["33764157"],"pub":{"doi":"10.2217/rme-2020-0171","issn":["17460751","1746076X"],"issn_org":["17460751"],"issue":"2","journal":"Regenerative Medicine","pages":"117-130","publisher":"Future Medicine Ltd.","status":"p","title":"Regenerative Medicine","volume":"16"},"review":"Peer Reviewed","scoID":["2-s2.0-85103596522"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["dtu-e3ae3326-0c88-4ff9-9aa3-ea3d989e3a77","sdu-50860593-a202-4263-bd6d-dea8cfbac484"],"src":["DTU Technical University of Denmark","SDU University of Southern Denmark"],"title":"Small diameter polycaprolactone vascular grafts are patent in sheep carotid bypass but require antithrombotic therapy","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.85-037684","year":"2021","yearsub":"2021"}
{"abstract":"Recently, reports of severe thromboses, thrombocytopenia, and hemorrhage in persons vaccinated with the chimpanzee adenovirus-vectored vaccine (ChAdOx1 nCoV-19, AZD1222, Vaxzevria; Oxford/AstraZeneca) against severe acute respiratory syndrome coronavirus 2 have emerged. We describe an otherwise healthy 30-year-old woman who developed thrombocytopenia, ecchymosis, portal vein thrombosis, and cerebral venous sinus thrombosis the second week after she received the ChAdOx1 nCoV-19 vaccine. Extensive diagnostic workup for thrombosis predispositions showed heterozygosity for the prothrombin mutation, but no evidence of myeloproliferative neoplasia or infectious or autoimmune diseases. Her only temporary risk factor was long-Term use of oral contraceptive pills (OCPs). Although both the prothrombin mutation and use of OCPs predispose to portal and cerebral vein thrombosis, the occurrence of multiple thromboses within a short time and the associated pattern of thrombocytopenia and consumption coagulopathy are highly unusual. A maximum 4T heparin-induced thrombocytopenia (HIT) score and a positive immunoassay for anti-platelet factor 4/heparin antibodies identified autoimmune HIT as a potential pathogenic mechanism. Although causality has not been established, our case emphasizes the importance of clinical awareness. Further studies of this potentially new clinical entity have suggested that it should be regarded as a vaccine-induced immune thrombotic thrombocytopenia.","author_count":19,"contributors":["Sorensen, Anne Louise Tolboll","Rolland, Magalie","Hartmann, Jacob","Harboe, Zitta Barrella","Roed, Casper","Jensen, Tomas O.","Kolte, Lilian","El Fassi, Daniel","Hillingsø, Jens","Radziwon-Balicka, Aneta","Soyka, Robert Sebastian","Hansen, Klaus","Kirkby, Nikolai","Goetze, Jens P.","Gybel-Brask, Mikkel","Leinoe, Eva Birgitte","Hvas, Anne Mette","Kampmann, Peter","Stensballe, Jakob"],"cuid":["S02-100.00-021893"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corresponding_author":["Roed, Casper"],"keyword":["Adult","COVID 19 Vaccines","ChAdOx1 nCoV 19","Covid 19","Factor V Leiden","Female","HIT","Humans","IgM","Immunoglobulin","Risk","SARS CoV 2","Surgery","Thrombocytopenia chemically induced","Thrombosis etiology","Vaccination","Venous thromboembolism","heparin induced thrombocytopenia"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"a case of thrombocytopenia and multiple thromboses after vaccination with chadox000000000001 ncov 000000000019 against sars cov 000000000002","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1182/bloodadvances.2021004904","version":"Published Version"},"id":"S02-100.00-021893","identifier":[{"id":"85108710400","type":"scopus"},{"id":"PMC8219289","type":"pmcid"},{"id":"34137813","type":"pmid"},{"id":"000664552400002","type":"wos"}],"ids":["au-7e4bf146-46c6-43fa-91d4-cda9f25ffe80","ku-a444d8a2-4a55-4c26-abdc-3820ed3adca7"],"keyword":["Adult","COVID-19","COVID-19 Vaccines","ChAdOx1 nCoV-19","FACTOR-V-LEIDEN","Female","HEPARIN-INDUCED THROMBOCYTOPENIA","HIT","Humans","IGM","IMMUNOGLOBULIN","RISK","SARS-CoV-2","SURGERY","Thrombocytopenia/chemically induced","Thrombosis/etiology","VENOUS THROMBOEMBOLISM","Vaccination"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-005DAFDB45C0E1820AFFCBA3757ACB5B"],"oa_link":[{"access":"oa","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC8219289/","version":"Authors Final Version"},{"access":"oa","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articl