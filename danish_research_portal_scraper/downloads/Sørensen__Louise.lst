nepau","last":"Sørensen","locid":"509fbee4-1de1-4bcf-9eef-eb4c19e1aff6","name":"Sørensen, Kathrine","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jeppe Karl Busk","key":"sørensenjeppekarlpau","last":"Sørensen","locid":"42f8c87d-2eda-4198-9cf5-fe5d426e9eb7","name":"Sørensen, Jeppe Karl","name_org":"Sørensen, Jeppe Karl Busk","orcid":"0000-0002-0789-8752","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"IEH","key":"madsenidaehpau","last":"Madsen","locid":"7bad9fdb-4af4-46fa-846a-9a16db2a2419","name":"Madsen, Ida E H","name_org":"Madsen, IEH","orcid":"0000-0003-3635-3900","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"R.","key":"ruguliesreinerpau","last":"Rugulies","locid":"4684d49a-5fe6-43e0-b3a6-5959f3d2f472","name":"Rugulies, Reiner","name_org":"Rugulies, R.","orcid":"0000-0002-7752-131X","rank":5,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Governmental Institutions","DI-ALL","DI-GV","DI-GV-ALL","Governmental Institutions"],"PST":["Published"]},"sid":["nfa-787101e0-f378-4c65-bb7f-c62a0af39a07"],"src":["NFA National Research Centre for the Working Environment"],"title":"Time trends in the prevalence of depressive disorder symptoms in the Danish workforce, 2012 to 2018","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-780968","year":"2023","yearsub":"2023"}
{"abstract":"We investigated if diarrhoea-causing bacteria, including Yersinia species, could mimic the symptoms of appendicitis and lead to surgery. This prospective observational cohort study (NCT03349814) included adult patients undergoing surgery for suspected appendicitis. Rectal swabs were analysed with polymerase chain reaction (PCR) for Yersinia, Campylobacter, Salmonella, Shigella and Aeromonas spp. Blood samples were analysed routinely and with an in-house ELISA serological test for Yersinia enterocolitica antibodies. We compared patients without appendicitis and patients with appendicitis confirmed by histopathology. The outcomes included PCR-confirmed infection with Yersinia spp., serologic-confirmed infection with Y. enterocolitica, PCR-confirmed infection with other diarrhoea-causing bacteria and Enterobius vermicularis confirmed by histopathology. A total of 224 patients were included, 51 without and 173 with appendicitis, and followed for 10 days. PCR-confirmed infection with Yersinia spp. was found in one patient (2%) without appendicitis and no patients (0%) with appendicitis (p = 0.23). Serology was positive for Y. enterocolitica for the same patient without appendicitis and two patients with appendicitis (p = 0.54). Campylobacter spp. were detected in 4% vs 1% (p = 0.13) of patients without and with appendicitis, respectively. Infection with Yersinia spp. and other diarrhoea-causing microorganisms in adult patients undergoing surgery for suspected appendicitis was rare.","author_count":13,"contributors":["Fonnes, Siv","Rasmussen, Tilde","Holzknecht, Barbara Juliane","Olesen, Christoffer Skov","Olsen, Joachim Hjalde Halmsted","Schmidt, Line","Alder, Rasmus","Sørensen, Sara Gamborg","Gülen, Sengül","Klarskov, Louise Laurberg","Krogfelt, Karen Angeliki","Westh, Henrik","Rosenberg, Jacob"],"cuid":["S02-089.47-681575"],"filters":{"added":"2023-06","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"keyword":["Appendicitis","Clinical trial","PCR","Serology","Yersinia"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU","DI-U-RUC"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-U-KU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"diarrhoea causing microorganisms are rare in adult patients undergoing diagnostic laparoscopy for suspected appendicitis a prospective observational cohort study","src":["ku","ruc"],"src-code":["DI-U-KU","DI-U-RUC"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/359805609/IKM_APMIS_2023_Fonnes_Diarrhoea_causing_microorganisms_are_rare_in_adult_patients_undergoing_diagnostic_laparoscopy_for.pdf","version":"Authors Final Version"},"id":"S02-089.47-681575","identifier":[{"id":"36932839","type":"pmid"},{"id":"85151462435","type":"scopus"}],"ids":["ku-9fde2767-0646-4eed-a58e-9663de166b2d","ruc-6880990a-01e9-44d7-b26b-1a81c4b392f7"],"keyword":["PCR","appendicitis","clinical trial","serology","yersinia"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-3AEF4B98482F196544FE1BDE550D7FDA"],"oa_link":[{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/359805609/IKM_APMIS_2023_Fonnes_Diarrhoea_causing_microorganisms_are_rare_in_adult_patients_undergoing_diagnostic_laparoscopy_for.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3"