{"author_count":6,"contributors":["Troelsen, Frederikke Schønfeldt","Sørensen, Henrik Toft","Pedersen, Lars","Brix, Lone Dragnes","Grode, Louise Bang","Erichsen, Rune"],"cuid":["S01-000.00-259323"],"event":{"end":"2022-05-24","place":"San Diego, us","start":"2022-05-24","title":"Digestive Disease Week 2022","year":"2022"},"filters":{"added":"2022-10","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"root cause analysis of post colonoscopy colorectal cancers diagnosed within the central denmark region","src":["au"],"src-code":["DI-U-AU"],"type":"dco","type-grp":["all","pub"]},"id":"S01-000.00-259323","ids":["au-e3b35b49-1bfb-46cb-814f-ba89b09593ef"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-1E2647E47B52F1139F87FC20F40732A0"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Clinical Epidemiology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Frederikke Schønfeldt","key":"troelsenpau","last":"Troelsen","locid":"8916df7b-c75a-4a12-bc4d-26d85b836a82","name":"Troelsen, Frederikke Schønfeldt","orcid":"0000-0002-5276-5959","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik Toft","key":"sørensenpau","last":"Sørensen","locid":"4d49d93a-4913-4223-ba59-272e717a845d","name":"Sørensen, Henrik Toft","orcid":"0000-0003-4299-7040","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars","key":"pedersenpau","last":"Pedersen","locid":"a0fdd247-3fb1-4c38-a1b2-f37d89f8f5c9","name":"Pedersen, Lars","orcid":"0000-0002-9341-3888","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lone Dragnes","key":"brixpau","last":"Brix","locid":"8fd625e9-13c5-424e-9eaf-2430cf0dc55c","name":"Brix, Lone Dragnes","orcid":"0000-0002-4446-710X","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Louise Bang","key":"grodepau","last":"Grode","locid":"c84de3b5-d39b-48a5-85e7-ac3619e05aa5","name":"Grode, Louise Bang","orcid":"0000-0003-0948-2328","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rune","key":"erichsenpau","last":"Erichsen","locid":"6ca944c9-6ee4-4ee6-abdb-3bb92452e5cc","name":"Erichsen, Rune","orcid":"0000-0001-9398-9185","rank":6,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-e3b35b49-1bfb-46cb-814f-ba89b09593ef"],"src":["AU Aarhus University"],"title":"Root-cause analysis of post-colonoscopy colorectal cancers diagnosed within the Central Denmark Region","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-259323","year":"2022","yearsub":"2022"}
{"abstract":"Objective End-stage kidney disease and hemodialysis (HD) treatment are associated with a high symptom burden in many patients. This study aimed at updating patient-reported outcomes concerning quality of life, fatigue, anxiety, and depression in HD patients treated in a single center in order to assess the need for palliative care provision. Method A cross-sectional design, in which a sample of patients treated at a single HD department (Rigshospitalet, Denmark) between January and June 2019, was analyzed using the Kidney Disease Quality of Life Short Form, the Multidimensional Fatigue Inventory, and the Hospital Anxiety and Depression Scale. In addition, we compared the results with previously published data from the same department (2000) and with an age-and sex-matched sample from the Danish general population (1997/2014). Chi-square and t-tests were used for comparisons. Results Screened patients = 242, included = 141, analyzed = 131 (70.2% male, mean age = 61.3 years). HD patients reported low scores for quality of life, high scores for fatigue, and approximately 30% had anxiety/depression. Regarding quality of life, they had significantly lower scores on general health (P ≤ 0.000), vitality (P = 0.009), social functioning (P = 0.001), mental health (P = 0.007), and mental component (P = 0.005) compared with former data of HD patients. Moreover, they reported significantly poorer quality of life and worse fatigue compared with the general Danish population. Significance of results In the patients undergoing HD, quality of life was poor and worsened when compared with former HD patients' data. Additionally, fatigue, depression, and anxiety in HD patients were prevalent. A clear need for palliative care provision was observed.","author_count":8,"contributors":["Liem, Ylian Serina","Eidemak, Inge","Larsen, Sille","Sjøgren, Per","Molsted, Stig","Sorensen, Jonas","Laursen, Louise","Kurita, Geana Paula"],"cuid":["S01-000.00-450612"],"filters":{"added":"2022-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Depression","Fatigue","Hemodialysis","Palliative care","Quality of Life"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"identification of palliative care needs in hemodialysis patients an update","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-450612","identifier":[{"id":"34210382","type":"pmid"},{"id":"85135202187","type":"scopus"}],"ids":["ku-5f809c8f-0b70-4cf8-bee6-9f2ee5409656"],"keyword":["Depression","Fatigue","Hemodialysis","Palliative care","Quality of life"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-E99C49996404D68EAE47FDDA77BD6E40"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Clinical Oncology","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Ylian Serina","key":"liempau","last":"Liem","name":"Liem, Ylian Serina","rank":1,"rolecode":"pau"},{"affno":"1","first":"Inge","key":"eidemakpau","last":"Eidemak","name":"Eidemak, Inge","rank":2,"rolecode":"pau"},{"affno":"1","first":"Sille","key":"larsenpau","last":"Larsen","name":"Larsen, Sille","rank":3,"rolecode":"pau"},{"affno":"2","first":"Per","key":"sjogrenpau","last":"Sjogren","locid":"a319b935-f316-4a9c-88b7-8cabd19b1952","name":"Sjøgren, Per","name_org":"Sjogren, Per","orcid":"0000-0002-3822-2958","rank":4,"rolecode":"pau"},{"affno":"2","first":"Stig","key":"molstedpau","last":"Molsted","locid":"05ca8142-78a6-4564-8d6f-ac2e4a5fb9b6","name":"Molsted, Stig","rank":5,"rolecode":"pau"},{"affno":"1","first":"Jonas","key":"sorensenpau","last":"Sorensen","name":"Sorensen, Jonas","rank":6,"rolecode":"pau"},{"affno":"1","first":"Louise","key":"laursenpau","last":"Laursen","name":"Laursen, Louise","rank":7,"rolecode":"pau"},{"affno":"2","first":"Geana Paula","key":"kuritapau","last":"Kurita","locid":"479b54ae-f26a-4027-b797-403bcf437ce5","name":"Kurita, Geana Paula","rank":8,"rolecode":"pau"}],"pmid":["34210382"],"pub":{"doi":"10.1017/s1478951521001036","issn":["14789515","14789523"],"issn_org":["14789515"],"issue":"4","journal":"Palliative & Supportive Care","pages":"505-511","status":"p","title":"Palliative & Supportive Care","title_org":"Palliative and Supportive Care","volume":"20"},"review":"Peer Reviewed","scoID":["2-s2.0-85135202187"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-5f809c8f-0b70-4cf8-bee6-9f2ee5409656"],"src":["KU University of Copenhagen"],"title":"Identification of palliative care needs in hemodialysis patients : An update","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-450612","year":"2022","yearsub":"2022"}
{"abstract":"Rationale: There is a major unmet need for improving the care of children and adolescents with severe asthma and wheeze. Identifying factors contributing to disease severity may lead to improved diagnostics, biomarkers, or therapies. The airway microbiota may be such a key factor. Objectives: To compare the oropharyngeal airway microbiota of children and adolescents with severe and mild/moderate asthma/wheeze. Methods: Oropharyngeal swab samples from school-age and preschool children in the European U-BIOPRED (Unbiased BIOmarkers in the PREDiction of respiratory disease outcomes) multicenter study of severe asthma, all receiving severity-appropriate treatment, were examined using 16S ribosomal RNA gene sequencing. Bacterial taxa were defined as amplicon sequence variants. Results: We analyzed 241 samples from four cohorts: A) 86 school-age children with severe asthma; B) 39 school-age children with mild/moderate asthma; C) 65 preschool children with severe wheeze; and D) 51 preschool children with mild/moderate wheeze. The most common bacteria were Streptococcus (mean relative abundance, 33.5%), Veillonella (10.3%), Haemophilus (7.0%), Prevotella (5.9%), and Rothia (5.5%). Age group (school-age vs. preschool) was associated with the microbiota in β-diversity analysis (F = 3.32, P = 0.011) and in a differential abundance analysis (28 significant amplicon sequence variants). Among all children, we found no significant difference in the microbiota between children with severe and mild/moderate asthma/wheeze in univariable β-diversity analysis (F = 1.99, P = 0.08, N = 241), but a significant difference in a multivariable model (F = 2.66, P = 0.035), including the number of exacerbations in the previous year. Age was also significant when expressed as a microbial maturity score (Spearman Rho, 0.39; P = 4.6 × 10-10); however, this score was not associated with asthma/wheeze severity. Conclusions: There was a modest difference in the oropharyngeal airway microbiota between children with severe and mild/moderate asthma/wheeze across all children but not in individual age groups, and a strong association between the microbiota and age. This suggests the oropharyngeal airway microbiota as an interesting entity in studying asthma severity, but probably without the strength to serve as a biomarker for targeted intervention.","author_count":33,"contributors":["Thorsen, Jonathan","Stokholm, Jakob","Rasmussen, Morten Arendt","Roggenbuck, Michael","Vissing, Nadja H.","Mortensen, Martin Steen","Brejnrod, Asker Daniel","Fleming, Louise","Bush, Andrew","Roberts, Graham","Singer, Florian","Frey, Urs","Hedlin, Gunilla","Nordlund, Björn","Murray, Clare S.","Abdel-Aziz, Mahmoud I.","Hashimoto, Simone","van Aalderen, Wim","Maitland-van der Zee, Anke H.","Shaw, Dominick","Fowler, Stephen J.","Sousa, Ana","Sterk, Peter J.","Chung, Kian Fan","Adcock, Ian M.","Djukanovic, Ratko","Auffray, Charles","Bansal, Aruna T.","Wagers, Scott","Chawes, Bo","Bønnelykke, Klaus","Sørensen, Søren Johannes","Bisgaard, Hans"],"cuid":["S01-000.00-463245"],"filters":{"added":"2023-02","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","Nordic","OECD"],"country":["Belgium","France","Netherlands","Sweden","Switzerland","United Kingdom"],"glorg":["Acclarogen Ltd. (Biz)","All Global Affiliations","BioSci Consulting","European Institute for Systems Biology and Medicine (EISBM)","GlaxoSmithKline","Imperial College London","Karolinska Institutet","Manchester University NHS Foundation Trust","Royal Brompton and Harefield NHS Foundation Trust","University Hospital Bern","University of Amsterdam","University of Basel","University of Manchester","University of Nottingham"],"keyword":["Airway","Microbiota","Pediatrics","Severe asthma","oropharyngeal"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-PR","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"OT":["Clinical and Experimental Sciences"],"PR":["DI-PR-ALL","DI-PR-NOSI"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-PR-NOSI","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"asthma and wheeze severity and the oropharyngeal microbiota in children and adolescents","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/379037601/220419_UBP_mb_manus_AATS_R2_Clean_2_50.pdf","version":"Authors Final Version"},"id":"S01-000.00-463245","identifier":[{"id":"35904980","type":"pmid"},{"id":"85143197291","type":"scopus"}],"ids":["ku-74c0311d-b2c4-4608-8050-e5e7fcd31d54"],"keyword":["airway","microbiota","oropharyngeal","pediatrics","severe asthma"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-DA0172346F2B3700EB6CC43A79B6D30A"],"oa_link":[{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/379037601/220419_UBP_mb_manus_AATS_R2_Clean_2_50.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Novo Nordisk Foundation Center for Basic Metabolic Research"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","country":"dk","key":"novonesis","l2":"DI-PR","l