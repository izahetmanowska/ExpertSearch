loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SEGES Innovation","namevar":["SEGES"],"nora_code":"DI-PR-SEGES","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Martin Tang","key":"sørensenpau","last":"Sørensen","locid":"fefc1862-587c-4b1f-9e20-694246b18221","name":"Sørensen, Martin Tang","orcid":"0000-0002-0523-4282","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Per","key":"tybirkpau","last":"Tybirk","name":"Tybirk, Per","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anne Louise Frydendahl","key":"hellwingpau","last":"Hellwing","locid":"ad65c0e8-8a1c-4f17-bb65-80aec2189e32","name":"Hellwing, Anne Louise Frydendahl","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Christian Friis","key":"børstingpau","last":"Børsting","locid":"335191b3-2ebe-47f4-b7c9-9fc3d198044e","name":"Børsting, Christian Friis","rank":4,"rolecode":"pau"}],"pub":{"status":"X"},"review":"Undetermined","search":{"DAF":["Aarhus University","All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Private Research","Universities"],"PST":["Undefined"]},"sid":["au-e00dde07-9f83-48c7-a472-67103bece2ef"],"src":["AU Aarhus University"],"title":"Kapitel 2 Næringsstofudskillelse fra svin, ab dyr : Normtal for husdyrgødning 2022/2023","type":"Other-Internet Publication","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-257231","year":"2022","yearsub":"2022"}
{"abstract":"Higher socio-economic status (SES) has been proposed to have facilitating and protective effects on brain and cognition. We ask whether relationships between SES, brain volumes and cognitive ability differ across cohorts, by age and national origin. European and US cohorts covering the lifespan were studied (4–97 years, N = 500 000; 54 000 w/brain imaging). There was substantial heterogeneity across cohorts for all associations. Education was positively related to intracranial (ICV) and total gray matter (GM) volume. Income was related to ICV, but not GM. We did not observe reliable differences in associations as a function of age. SES was more strongly related to brain and cognition in US than European cohorts. Sample representativity varies, and this study cannot identify mechanisms underlying differences in associations across cohorts. Differences in neuroanatomical volumes partially explained SES–cognition relationships. SES was more strongly related to ICV than to GM, implying that SES–cognition relations in adulthood are less likely grounded in neuroprotective effects on GM volume in aging. The relatively stronger SES–ICV associations rather are compatible with SES–brain volume relationships being established early in life, as ICV stabilizes in childhood. The findings underscore that SES has no uniform association with, or impact on, brain and cognition.","author_count":29,"contributors":["Walhovd, Kristine B","Fjell, Anders M","Wang, Yunpeng","Amlien, Inge K.","Mowinckel, Athanasia M.","Lindenberger, Ulman","Düzel, Sandra","Bartrés-Faz, David","Ebmeier, Klaus P.","Drevon, Christian A.","Baaré, William F.C.","Ghisletta, Paolo","Johansen, Louise Baruël","Kievit, Rogier A.","Henson, Richard N.","Madsen, Kathrine Skak","Nyberg, Lars","Harris, Jennifer","Solé-Padullés, Christina","Pudas, Sara","Sørensen, Øystein","Westerhausen, René","Zsoldos, Enikö","Nawijn, Laura","Lyngstad, Torkild Hovde","Suri, Sana","Penninx, Brenda","Røgeberg, Ole J.","Brandmaier, Anderas M."],"cuid":["S01-000.00-391057"],"filters":{"added":"2023-02","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-UC"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"UC":["DI-UC-ALL","DI-UC-KP"]},"level3all":["DI-HO-CAP","DI-UC-KP"]},"review":"pr","rtype":["clu"],"sorti":"education and income show heterogeneous relationships to lifespan brain and cognitive differences across european and us cohorts","src":["kp"],"src-code":["DI-UC-KP"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1093/cercor/bhab248","version":"Published Version"},"id":"S01-000.00-391057","identifier":[{"id":"85124576525","type":"scopus"}],"ids":["kp-b76463cb-93eb-4658-ad38-076678d4b142"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-634D3C993B047766F89742F5E8025384"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1093/cercor/bhab248","version":"Published Version"}],"org":[{"affno":"1","key":"kp university college copenhagen","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-KP","l3nl":"KP","l3nn":"KP University College Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KP University College Copenhagen","namevar":["Københavns Professionshøjskole, Rektors område, Fakultet for sundhedsuddannelser - Dekan, Radiografuddannelsen"],"nora_code":"DI-UC-KP","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"","corresponding":null,"first":"Kristine B","key":"walhovdpau","last":"Walhovd","name":"Walhovd, Kristine B","