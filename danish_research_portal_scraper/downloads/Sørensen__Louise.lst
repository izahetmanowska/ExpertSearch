hnology","loc":["Netherlands","Europe, EU","OECD"],"name":"Delft University of Technology","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Joanna","key":"fredenslundlevinsenpau","last":"Fredenslund Levinsen","locid":"55f307d3-198e-4dd1-9f7f-2305c650f50d","name":"Fredenslund Levinsen, Joanna","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"K.","key":"khvorostovskypau","last":"Khvorostovsky","name":"Khvorostovsky, K.","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"F.","key":"ticconipau","last":"Ticconi","name":"Ticconi, F.","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"A.","key":"shepherdpau","last":"Shepherd","name":"Shepherd, A.","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"René","key":"forsbergpau","last":"Forsberg","locid":"be93c88f-cc39-43d8-bf6f-ff4787c55c23","name":"Forsberg, René","orcid":"0000-0002-7288-9545","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Louise Sandberg","key":"sørensenpau","last":"Sørensen","locid":"1c6cb90f-da30-48a2-872f-a94b8100749b","name":"Sørensen, Louise Sandberg","orcid":"0000-0002-3771-4061","rank":6,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"A.","key":"muirpau","last":"Muir","name":"Muir, A.","rank":7,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"N.","key":"piepau","last":"Pie","name":"Pie, N.","rank":8,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"D.","key":"feliksonpau","last":"Felikson","name":"Felikson, D.","rank":9,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"T.","key":"flamentpau","last":"Flament","name":"Flament, T.","rank":10,"rolecode":"pau"},{"affno":"7","corresponding":null,"first":"R.","key":"hurkmanspau","last":"Hurkmans","name":"Hurkmans, R.","rank":11,"rolecode":"pau"},{"affno":"8","corresponding":null,"first":"G.","key":"moholdtpau","last":"Moholdt","name":"Moholdt, G.","rank":12,"rolecode":"pau"},{"affno":"9","corresponding":null,"first":"B.","key":"gunterpau","last":"Gunter","name":"Gunter, B.","rank":13,"rolecode":"pau"},{"affno":"9","corresponding":null,"first":"R. C.","key":"lindenberghpau","last":"Lindenbergh","name":"Lindenbergh, R. C.","rank":14,"rolecode":"pau"},{"affno":"9","corresponding":null,"first":"M.","key":"kleinherenbrinkpau","last":"Kleinherenbrink","name":"Kleinherenbrink, M.","rank":15,"rolecode":"pau"}],"pub":{"doi":"10.5194/tcd-7-5433-2013","issn":["19940432","19940440"],"issn_org":["19940432"],"issue":"7","journal":"The Cryosphere Discussions","pages":"5433-5460","publisher":"Copernicus GmbH","status":"p","title":"The Cryosphere Discussions"},"review":"Peer Reviewed","sdg":["13. Climate Action","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-c93642ac-c9c3-4b10-881d-c46da69729a9"],"src":["DTU Technical University of Denmark"],"title":"ESA's Ice Sheets CCI: validation and inter-comparison of surface elevation changes derived from laser and radar altimetry over Jakobshavn Isbræ, Greenland – Round Robin results","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-364650","year":"2013","yearsub":"2013"}
{"abstract":"Quantification of microbial gene expression is increasingly being used to study key functions in soil microbial communities, yet major limitations still exist for efficient extraction of nucleic acids, especially RNA for transcript analysis, from this complex matrix. We present an improved extraction protocol that was optimized by: i) including an adsorption-site competitor prior to cell lysis to decrease adsorption of nucleic acids to soil particles, and ii) optimizing the PEG concentration used for nucleic acid precipitation. The extraction efficiency was determined using quantitative real-time PCR on both the RNA (after conversion to cDNA) and the DNA fraction of the extracts. Non-adsorptive soils were characterized by low clay content and/or high phosphate content, whereas adsorptive soils had clay contents above 20% and/or a strong presence of divalent Ca in combination with high pH. Modifications to the co-extraction protocol improved nucleic acid extraction efficiency from all adsorptive soils and were successfully validated by DGGE analysis of the indigenous community based on 16S rRNA gene and transcripts in soils representing low biomass and/or high clay content. This new approach reveals a robust co-extraction protocol for a range of molecular analysis of diverse soil environments.","author_count":6,"contributors":["Paulin, Mélanie Marie","Nicolaisen, Mette Haubjerg","Jacobsen, Carsten Suhr","Gimsing, Anne Louise","Sørensen, Jan","Bælum, Jacob"],"cuid":["S01-000.00-411171"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-GEUS"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-GV-GEUS","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"improving griffith s protocol for co extraction of microbial dna and rna in adsorptive soils","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-411171","identifier":[{"id":"84876469893","type":"scopus"}],"ids":["ku-1dcde451-0bbe-4cb2-9323-1f21c7522a36"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-8C58B632C866F39BBE2253355FC52742"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Plant and Environmental Sciences, Microbial Ecology and Biotechnology"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"geus geological survey of denmark and greenland","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-GEUS","l3nn":"GEUS Geological Survey of Denmark and Greenland","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"GEUS Geological Survey of Denmark and Greenland","namevar":["Geological Survey of Denmark and Greenland"],"nora_code":"DI-GV-GEUS","used":1}],"person":[{"affno":"","first":"Mélanie Marie","key":"paulinpau","last":"Paulin","locid":"fab983ca-c74f-4044-8dac-c0d2db1a556e","name":"Paulin, Mélanie Marie","rank":1,"rolecode":"pau"},{"affno":"1","first":"Mette Haubjerg","key":"nicolaisenpau","last":"Nicolaisen","locid":"58de527a-4c42-47cb-9ea0-c65675eca755","name":"Nicolaisen, Mette Haubjerg","orcid":"0000-0002-0983-2466","rank":2,"rolecode":"pau"},{"affno":"1","first":"Carsten Suhr","key":"jacobsenpau","last":"Jacobsen","locid":"26689aa8-b005-406a-a10f-a2a7ffdde9fd","name":"Jacobsen, Carsten Suhr","rank":3,"rolecode":"pau"},{"affno":"","first":"Anne Louise","key":"gimsingpau","last":"Gimsing","locid":"e36993e3-4f44-4d5a-88fd-ce76a369745f","name":"Gimsing, Anne Louise","rank":4,"role