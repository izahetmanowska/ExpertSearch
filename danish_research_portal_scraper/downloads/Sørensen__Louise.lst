u"}],"pmid":["40141174"],"pub":{"doi":"10.3390/ijms26062533","issn":["14220067","16616596"],"issn_org":["16616596"],"issue":"6","journal":"International Journal of Molecular Sciences","paperid":"2533","publisher":"Multidisciplinary Digital Publishing Institute (MDPI)","status":"p","title":"International Journal of Molecular Sciences","volume":"26"},"review":"Peer Reviewed","scoID":["2-s2.0-105001140878"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","North Denmark Region","Other Hospitals","Other Research","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark","copenhagen university hospital - holbæk","department of obstetrics and gynecology"],"PST":["Published"]},"sid":["aau-53131aff-42e0-43f1-8f7b-282a89db3fdc","au-7177ef63-98b7-4867-ad59-a4678c95f2ec","ku-9be165a5-b277-4749-80a5-d39e8c9fb9db","sdu-7771bcc0-4f5c-4ba0-b3f3-6ef8d761da7d"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Maternal-Fetal Outcomes and Antibody Transfer, Depending on the Trimester of SARS-CoV-2 Infection in Non-Vaccinated Women—A Danish Nationwide Prospective Cohort Study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-100.00-822311","year":"2025","yearsub":"2025"}
{"abstract":"Background: Essential tremor is the most common hyperkinetic movement disorder. Magnetic resonance imaging–guided focused ultrasound (MRgFUS) has emerged as second-line therapy. Objective: The aim was to obtain the results of the first 108 patients treated with MRgFUS in Denmark. Methods: Data were entered in a quality assurance database at baseline and 3, 6, and 12 months. Clinician- and patient-rated treatment efficacy was evaluated using the Fahn–Marin–Tolosa (FMT) scale and the Patient Global Impression of Change. Results: A total of 108 persons have currently been treated. Tremor improved by a total mean 6.39 points (95% confidence interval [CI]: 5.01;7.76, P < 0.00001) and 9.63 points (95% CI: 7.60;11.66, P < 0.00001), 10.42 (95% CI: 9.06;11.79, P < 0.00001), and 26.45 (95% CI: 22.46;30.43, P < 0.00001) for FMT parts A, B, and C, respectively, at 3 months. Side effects occurred in 65.7% of patients at 3 months and 33.7% at 12 months. Conclusion: Our findings are in line with existing evidence. Questions regarding persistence of gait- and balance-related side effects remain.","author_count":32,"contributors":["Hvingelby, Victor","Kjeldsen, Pernille Louise","Bergholt, Bo","Schechtmann, Gastón","Danielsen, Erik Hvid","Møller, Mette","Johnsen, Erik Lisbjerg","Mardosiene, Skirmante","Lund, Torben Ellegaard","Zeidler, Dora","Geneser, Michael","Sørensen, Tina Vincens","Bak, Lisa Østergaard","Andreasen, Martin","Andersen, Anne Sofie Møller","Andersen, Lone","Meier, Kaare","Juhl, Niels","Tankisi, Alp","Jespersen, Bo","Fenger-Eriksen, Christian","Rasmussen, Mads","Bechmann Eriksen, Winnie","Barrutia, Birgitte","Kromann, Mette","Baandrup, Ida","Bjørn, Jette","Stjernholm, Rie","Braemer-Madsen, Charlotte","Jørgensen, Signe Mygdal","Sørensen, Jens Christian Hedemann","Glud, Andreas Nørgaard"],"cuid":["S01-000.00-795698"],"filters":{"added":"2025-04","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"corresponding_author":["Hvingelby, Victor"],"keyword":["Essential tremor","Focused ultrasound","Magnetic Resonance Imaging"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-HO-CAP","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"magnetic resonance guided focused ultrasound treatment for essential tremor a single center experience","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1002/mdc3.70012","version":"Published Version"},"id":"S01-000.00-795698","identifier":[{"id":"39968962","type":"pmid"},{"id":"PMC12274985","type":"pmcid"},{"id":"85219730605","type":"scopus"}],"ids":["au-19a903ea-c367-4c6e-9176-d59a0891bc86"],"keyword":["Essential tremor","Focused ultrasound","Magnetic resonance imaging"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-456226A1D028C7919A0C52EAB4225735"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1002/mdc3.70012","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Public Health, Department of Public Health - Forskningsenheden for Almen Praksis"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Bispebjerg og Frederiksberg Universitets Hospital"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Victor","key":"