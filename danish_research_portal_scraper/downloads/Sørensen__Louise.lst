"affno":"1","corresponding":null,"first":"Betina Bang","key":"sørensenpau","last":"Sørensen","locid":"ca7cc666-d0df-48ab-9b18-3a79b66065ac","name":"Sørensen, Betina Bang","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Morten Hulvej","key":"rodpau","last":"Rod","locid":"583541c2-ba4e-4647-ac89-ddc8dce7c469","name":"Rod, Morten Hulvej","orcid":"0000-0003-0178-5885","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Line","key":"zinckernagelpau","last":"Zinckernagel","locid":"b51646a2-7805-43c0-b7cb-1078babcf287","name":"Zinckernagel, Line","orcid":"0000-0002-0141-4374","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Bjarne","key":"laursenpau","last":"Laursen","locid":"d484780f-c917-4d3e-927e-5ff086dd00eb","name":"Laursen, Bjarne","orcid":"0000-0003-0121-9891","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Liselotte","key":"ingholtpau","last":"Ingholt","locid":"c5ba52d5-5b95-4c05-a5d3-7844e9a2ed0f","name":"Ingholt, Liselotte","rank":8,"rolecode":"pau"}],"pub":{"place":"København","publisher":"Statens Institut for Folkesundhed, Det Sundhedsvidenskabelige Fakultet, Syddansk Universitet","status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-52916ed2-91b5-4894-a514-91055b5352fb"],"src":["SDU University of Southern Denmark"],"title":"Trivsel, tobak og rusmidler : Elevprofil for udvalgte grundforløb på Aarhus Tech","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-596904","year":"2013","yearsub":"2013"}
{"abstract":"The Geikie Plateau is a major marine-terminating local ice cap located in central East Greenland just south of Scoresby Sund, covering approx. 7,500 sqkm. South of this region, the Greenland ice sheet has experienced dramatic ice loss over the recent decade, whereas the response has been less prominent north of the region. For the Geikie Plateau itself, ICESat elevation measurements show a thinning of the ice margin and a slight thickening of the interior over the period 2002-2009 (Bolch et al., 2013). However, a longer time span is required to evaluate volume change in the context of climate change. In this work we will compare remotely sensed elevation data collected over more than three decades from the Geikie Ice Cap to evaluate volume change. Elevation data was obtained from aerial stereophotogrammetry based on orthophotos from 1981, spaceborne laser altimetry from ICESat over the period 2002-2009, aerial laser altimetry by the NASA IceBridge campaign 2010-2012 and aerial laser altimetry by the Technical University of Denmark and the Danish Geodata Agency covering 1996-2012. The comparison will facilitate an enhanced understanding of recent mass loss from ice caps and glaciers in East Greenland which is home to nearly half the local ice masses in Greenland.","author_count":12,"contributors":["Ahlstrom, A. P.","Forsberg, René","Skourup, Henriette","Sørensen, Louise Sandberg","Citterio, M.","Kjaer, K. H.","Bjork, A. A.","Khan, Shfaqat Abbas","Andersen, S. B."],"cuid":["S02-086.54-038157"],"event":{"end":"2013-12-13","place":"San Francisco, us","start":"2013-12-09","title":"AGU Fall Meeting 2013","year":"2013"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-GEUS"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-GV-GEUS","DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"three decades of elevation change of the geikie plateau ice cap east greenland","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/84769572/prod11389871218457.AGU7.pdf","version":"Published Version"},"id":"S02-086.54-038157","ids":["dtu-fb51b073-e642-4d1a-81ae-209e2603ba92","ku-5536eefd-1fc7-4c21-ad13-97ced40b0fcb"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-2-312E072F1D8FF56F9AA67A219F7A688B"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/84769572/prod11389871218457.AGU7.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"geus geological survey of denmark and greenland","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-GEUS","l3nn":"GEUS Geological Survey of Denmark and Greenland","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"GEUS Geological Survey of Denmark and Greenland","namevar":["Geological Survey of Denmark and Greenland"],"nora_code":"DI-GV-GEUS","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Space Institute","Technical University of Denmark, National Space Institute, Geodynamics"],"nora_code":"DI-U-DTU","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, The Natural History Museum, Natural History Museum of Denmark"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","corresponding":null,"first":"A. P.","key":"ahlstrompau","last":"Ahlstrom","name":"Ahlstrom, A. P.","rank":1,"rolecode":"pau"},{"affno":"1","first":"Andreas Peter","key":"ahlstrømpau","last":"Ahlstrøm","name":"Ahlstrøm, Andreas Peter","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"René","key":"forsbergpau","last":"Forsberg","locid":"be93c88f-cc39-43d8-bf6f-ff4787c55c23","name":"Forsberg, René","orcid":"0000-0002-7288-9545","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Henriette","key":"skouruppau","last":"Skourup","locid":"f5fe613f-20e5-4a69-9eff-f03779801182","name":"Skourup, Henriette","orcid":"0000-0002-4468-8033","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Louise Sandberg","key":"sørensenpau","last":"Sørensen","locid":"1c6cb90f-da30-48a2-872f-a94b8100749b","name":"Sørensen, Louise Sandberg","orcid":"0000-0002-3771-4061","rank":4,"rolecode":"pau"},{"affno":"1","first":"Michele","key":"citteriopau","last":"Citterio","name":"Citterio, Michele","rank":5,"rolecode":"pau"},{"affno":"3","first":"Kurt H.","key":"kjærpau","last":"Kjær","locid":"edb4315d-1be7-426b-b2d9-a18bddc543b2","name":"Kjær, Kurt H.","orcid":"0000-0002-8871-5179","rank":6,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"K. H.","key":"kjaerpau","last":"Kjaer","name":"Kjaer, K. H.","rank":6,"rolecode":"pau"},{"affno":"3","first":"Anders Anker","key":"bjørkpau","last":"Bjørk","locid":"f2550d56-6b6b-4e84-b759-33415f1aaa9f","name":"Bjørk, Anders Anker","orcid":"0000-0002-4919-792X","rank":7,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"A. A.","key":"bjorkpau","last":"Bjork","name":"Bjork, A. A.","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Shfaqat Abbas","key":"khanpau","last":"Khan","locid":"a1da0a4e-dc92-4c96-9365-0877275c16c6","name":"Khan, Shfaqat Abbas","orcid":"0000-0002-2689-8563","rank":8,"rolecode":"pau"},{"affno":"1","first":"Signe","key":"andersenpau","last":"Andersen","name":"Andersen, Signe","rank":9,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","sdg":["13. Climate Action","14. Life Below Water","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-U","DI-U-ALL","Governmental Institutions","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-fb51b073-e642-4d1a-81ae-209e2603ba92","ku-5536eefd-1fc7-4c21-ad13-97ced40b0fcb"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Three decades of elevation change of the Geikie Plateau ice cap, East Greenland","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-086.54-038157","year":"2013","yearsub":2014}
{"abstract":"BACKGROUND: Accumulating preclinical and clinical evidence indicates that human mesenchymal stromal cells (MSCs) are good candidates for cell therapy. For clinical applications of MSCs extensive in vitro expansion is required to obtain an adequate number of cells. It is evident that the pursuit for cell quantity must not affect quality, but it is also a fact that in vitro culture conditions affect MSC phenotype. One possible variable is the degree of cell confluence during expansion. METHODS: We investigate the influence of cell density on homogeneity and differentiation during culture expansion of un-stimulated MSCs isolated from the bone marrow in DMEM and fetal bovine serum (FBS). MSC morphology, phenotype and differentiation were investigated weekly during 5 weeks culture expansion using electron microscopy, flow cytometry, immunocytochemistry, qualitative RT-PCR and quantitative Q-PCR. RESULTS: The morphological observation and the phenotypic analyses showed that MSCs after 3 weeks cultivation constituted a phenotypically homogenous MSC cell population, which at low levels expressed genes for different cell lineages, confirming their multilineage plasticity, without actual differentiation. This phenotype persisted independent of increasing cell densities. DISCUSSION: These data demonstrate that MSC characteristics and plasticity can be maintained during culture expansion from bone marrow mononuclear cells to MSCs and that a homogeneous phenotype of undifferentiated MSCs which persists independent of cell density can be used for clinical therapies.","author_count":7,"contributors":["Haack-Sørensen, Mandana","Hansen, Susanne Kofoed","Hansen, Louise","Gaster, Michael","Hyttel, Poul","Ekblond, Annette","Kastrup, Jens"],"cuid":["S02-100.00-043870"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"mesenchymal stromal cell phenotype is not influenced by confluence during culture expansion","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s12015-012-9386-3","version":"Other Version"},"id":"S02-100.00-043870","identifier":[{"id":"22644809","type":"pmid"},{"id":"84873728259","type":"scopus"}],"ids":["ku-7fbdd909-af5e-44e1-a031-c2bc35464ce4","sdu-891f4b24-b9ec-4764-88c4-385caff823e2"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-DABE0856CBAC696854E990D4B77D769F"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s12015-012-9386-3","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, KMEB - Molecular Endocrinology Department (Odense)","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Endocrinology (Odense)","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Pathology (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Veterinary Clinical Sciences, Anatomy, Biochemistry and Physiology","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Veterinary Clinical Sciences, IKVH Anatomi og Biokemi"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"","first":"Mandana","key":"haacksørensenmandanapau","last":"Haack-Sørensen","name":"Haack-Sørensen, Mandana","rank":1,"rolecode":"pau"},{"affno":"","first":"Susanne Kofoed","key":"hansensusannekofoedpau","last":"Hansen","name":"Hansen, Susanne Kofoed","rank":2,"rolecode":"pau"},{"affno":"","first":"Louise","key":"hansenlouisepau","last":"Hansen","name":"Hansen, Louise","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Michael","key":"gastermichaelpau","last":"Gaster","locid":"cebaf59c-821a-4aec-af3b-916e70c47972","name":"Gaster, Michael","rank":4,"rolecode":"pau"},{"affno":"2 3","first":"Poul","key":"hyttelpoulpau","last":"Hyttel","locid":"2953c67a-bd1f-4e9a-b85d-6734e4c8d2ab","name":"Hyttel, Poul","rank":5,"rolecode":"pau"},{"affno":"","first":"Annette","key":"ekblondannettepau","last":"Ekblond","name":"Ekblond, Annette","rank":6,"rolecode":"pau"},{"affno":"2","first":"Jens","key":"kastrupjenspau","last":"Kastrup","locid":"12c1241f-23da-492c-84b0-36691cb95255","name":"Kastrup, Jens","rank":7,"rolecode":"pau"}],"pmid":["22644809"],"pub":{"doi":"10.1007/s12015-012-9386-3","issn":["26293269","26293277"],"issn_org":["26293269"],"issue":"1","journal":"Stem Cell Reviews and Reports","pages":"44-58","publisher":"Springer","status":"p","title":"Stem Cell Reviews and Reports","volume":"9"},"review":"Peer Reviewed","scoID":["2-s2.0-84873728259"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-7fbdd909-af5e-44e1-a031-c2bc35464ce4","sdu-891f4b24-b9ec-4764-88c4-385caff823e2"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Mesenchymal Stromal Cell Phenotype is not Influenced by Confluence during Culture Expansion","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-043870","year":"2013","yearsub":"2013"}
{"abstract":"Background: TH2-biased immune responses are important in allergy pathogenesis. Mechanisms of allergen-specific immunotherapy (SIT) might include the induction of regulatory T cells (Tregs) and immunoglobulin (Ig) G4 blocking antibodies, a reduction in the number of effector cells, and skewing of the cytokine profile towards a TH1-polarized immune response. We investigated the effects of SIT on T cells, on immunomodulation of human leukocyte antigen (HLA)-G, which has been associated with allergy, on regulatory cytokine expression, and on serum allergen-specific antibody subclasses (IgE and IgG4). Methods: Eleven birch and/or grass pollen-allergic patients and 10 healthy nonatopic controls were studied before and during SIT. Tregs, chemokine receptors, soluble HLA-G (sHLA-G), Ig-like transcript (ILT) 2, specific IgE, and IgG4 were studied. Peripheral blood mononuclear cells (PBMCs) were stimulated with pollen extract in vitro and immune factors were evaluated. Results: During SIT, the main changes in the peripheral blood were an increase in CXCR3+CD4+CD25+CD127low/- Tregs and a decrease in CCR4+CD4+CD25+CD127low/- Tregs, an increase in allergen-specific IgG4, and a decrease in sHLA-G during the first half of the treatment period. In the PBMC in vitro experiments, the following changes were observed upon allergen-stimulation: an increase in CD4+CD25+CD127low/- Tregs and ILT2+CD4+CD25+CD127low/- Tregs, an increase in IL-10 and IL-2 levels, and an increase in sHLA-G that was most pronounced at the start of SIT. Conclusions: The changes in CXCR3+CD4+CD25+CD127low/- Treg, IgG4, and sHLA-G levels in the peripheral blood and in ILT2+ Treg, IL-10, IL-2, and sHLA-G levels upon in vitro allergen stimulation suggest an upregulation in immunomodulatory factors and, to some degree, a shift towards TH1 during SIT.","author_count":9,"contributors":["Sørensen, Anja Elaine","Johnsen, Claus Rikard","Dalgaard, Louise T","Wurtzen, Peter Adler","Kristensen, Bjarne","Larsen, Margit Hørup","Ullum, Henrik","Søes-Petersen, Ulrik","Hviid, Thomas Vauvert F."],"cuid":["S02-100.00-045513"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-PR","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-ZEA"],"PR":["DI-PR-ALK","DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-KU","DI-U-RUC"]},"level3all":["DI-HO-CAP","DI-HO-ZEA","DI-PR-ALK","DI-PR-OTH","DI-U-KU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"human leukocyte antigen g and regulatory t cells during specific immunotherapy for pollen allergy","src":["ku","ruc"],"src-code":["DI-U-KU","DI-U-RUC"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1159/000353281","version":"Other Version"},"id":"S02-100.00-045513","identifier":[{"id":"24022071","type":"pmid"},{"id":"84887034663","type":"scopus"}],"ids":["ku-b4519b71-b51b-4cd0-9f65-4cfe7b63912e","ruc-1832fc13-434e-4921-9f58-601443b30685"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-23F93EAC7200DEBF0B3518418872C7FD"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1159/000353281","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of Science and Environment, Eukaryot Cellebiologi","Roskilde University, The Department of Science, Systems and Models"],"nora_code":"DI-U-RUC","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":