ode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Christian Friis","key":"børstingpau","last":"Børsting","locid":"335191b3-2ebe-47f4-b7c9-9fc3d198044e","name":"Børsting, Christian Friis","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anne Louise Frydendahl","key":"hellwingpau","last":"Hellwing","locid":"ad65c0e8-8a1c-4f17-bb65-80aec2189e32","name":"Hellwing, Anne Louise Frydendahl","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Peter","key":"kaipau","last":"Kai","locid":"7503d031-8020-4d17-ae34-c18e11bd8f15","name":"Kai, Peter","orcid":"0000-0001-5416-931X","rank":4,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-23159422-8837-4f76-831e-cc1ac95c9614"],"src":["AU Aarhus University"],"title":"Reduceret tildeling af råprotein til slagtegrise - Teknologibeskrivelse udarbejdet som grundlag for revidering af Husdyrgodkendelsesbekendtgørelsens BAT-krav","type":"Memorandum/Exposition","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-149476","year":"2022","yearsub":"2022"}
{"abstract":"Smartwearable solutions for social distancing have appeared during the Covid-19 pandemic with various types of outputs often directed only to the wearer or if directed to others, the visual output is usually displayed on the front side of the wearers body. This paper presents instead a design, implementation, and in-the-wild Wizard of Oz evaluation of a backpack with shape-changing accessory which output is directed to others approaching the wearer from behind. Qualitative findings from six participants suggest that there is potential in shape-changing accessory for keeping social distance in public context, however, the social acceptability issues caused by noisy motors and inclusiveness of the design limit the willingness to wear it. Even though the study was inspired by the Covid-19, other non-pandemic use cases for personal space respecting wearables are discussed also for users with special needs.","author_count":9,"contributors":["Pakanen, Minna","Sørensen, Marie-Louise Stisen Kjerstein","Witt, Frederik","Lynge Eichwald, Jonas"],"cuid":["S01-000.00-215555"],"event":{"end":"2022-11-30","place":"Lisbon, pt","start":"2022-11-27","title":"21st International Conference on Mobile and Ubiquitous Multimedia","year":"2022"},"filters":{"added":"2023-02","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Accessory","Covid 19","Shape changing interfaces","Social distancing","Wearable technology"],"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"ah that is cute i will stay away wearer experiences of a backpack with shape changing accessory for keeping social distance to others in public context","src":["au"],"src-code":["DI-U-AU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85145873612","version":"Other Version"},"id":"S01-000.00-215555","identifier":[{"id":"85145873612","type":"scopus"}],"ids":["au-975aeb90-2ffb-4e4a-9795-183c00a54bab"],"keyword":["Covid- 19","Shape-changing interfaces","Social distancing","Wearable technology","accessory"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Global-Local-2-4-3881B288FF08BC9153E9AB21CE7E7F39"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Arts, School of Communication and Culture, School of Communication and Culture - Department of Digital Design and Information Studies"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Minna","key":"pakanenpau","last":"Pakanen","locid":"49d8360d-2ffe-44e3-b55f-640b032711ff","name":"Pakanen, Minna","orcid":"0000-0002-0933-9479","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Marie-Louise Stisen Kjerstein","key":"sørensenpau","last":"Sørensen","name":"Sørensen, Marie-Louise Stisen Kjerstein","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Frederik","key":"wittpau","last":"Witt","name":"Witt, Frederik","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jonas","key":"lyngeeichwaldpau","last":"Lynge Eichwald","name":"Lynge Eichwald, Jonas","rank":4,"rolecode":"pau"},{"affno":"","first":"Tanja","key":"döringpedh","last":"Döring","name":"Döring, Tanja","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Susanne","key":"bollpedh","last":"Boll","name":"Boll, Susanne","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Ashley","key":"colleypedh","last":"Colley","name":"Colley, Ashley","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first