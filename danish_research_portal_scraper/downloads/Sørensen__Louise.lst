itle":"Scientific Reports","volume":"7"},"review":"Peer Reviewed","scoID":["2-s2.0-85034417799"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["au-a0d3e505-53a5-4a41-8160-0904cffb8608","sdu-f12ffb68-67ee-40ec-9ee2-21a8724ac083"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"The Immunomodulatory Drug Glatiramer Acetate is Also an Effective Antimicrobial Agent that Kills Gram-negative Bacteria","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-096.00-024437","year":"2017","yearsub":"2017"}
{"abstract":"Congenital heart defects are a major cause of perinatal mortality and morbidity, affecting >1% of all live births in the Western world, yet a large fraction of such defects have an unknown etiology. Recent studies demonstrated surprising dual roles for immune-related molecules and their effector mechanisms during fetal development and adult homeostasis. In this article, we describe the function of an endogenous complement inhibitor, mannan-binding lectin (MBL)-associated protein (MAp)44, in regulating the composition of a serine protease-pattern recognition receptor complex, MBL-associated serine protease (MASP)-3/collectin-L1/K1 hetero-oligomer, which impacts cardiac neural crest cell migration. We used knockdown and rescue strategies in zebrafish, a model allowing visualization and assessment of heart function, even in the presence of severe functional defects. Knockdown of embryonic expression of MAp44 caused impaired cardiogenesis, lowered heart rate, and decreased cardiac output. These defects were associated with aberrant neural crest cell behavior. We found that MAp44 competed with MASP-3 for pattern recognition molecule interaction, and knockdown of endogenous MAp44 expression could be rescued by overexpression of wild-type MAp44. Our observations provide evidence that immune molecules are centrally involved in the orchestration of cardiac tissue development.","author_count":10,"contributors":["Mortensen, Simon A","Skov, Louise L","Kjaer-Sorensen, Kasper","Hansen, Annette G","Hansen, Søren","Dagnæs-Hansen, Frederik","Jensenius, Jens Christian","Oxvig, Claus","Thiel, Steffen","Degn, Søren Egedal"],"cuid":["S02-100.00-013131"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["America, North","OECD"],"corresponding_author":["Degn, Søren E."],"country":["United States"],"glorg":["All Global Affiliations","Boston Children's Hospital"],"keyword":["Journal Article"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"endogenous natural complement inhibitor regulates cardiac development","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85017373237","version":"Other Version"},"id":"S02-100.00-013131","identifier":[{"id":"28258200","type":"pmid"},{"id":"85017373237","type":"scopus"}],"ids":["au-075571cc-2fb9-46c4-8f72-426929654d55","sdu-f0b2c63b-6cf8-4b0d-aff3-afb4540ff110"],"keyword":["Journal Article"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-96F2DC726A2F3DAAB64A6490A4E09578"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Biomedicine, Department of Biomedicine - Research and Education, Bartholin Building"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Molecular Medicine, Department of Cancer and Inflammation Research"],"nora_code":"DI-U-SDU","used":1},{"affno":"3","country":"us","key":"boston children s hospital","loc":["United States","America, North","OECD"],"name":"Boston Children's Hospital","used":1}],"person":[{"affno":"1","corresp