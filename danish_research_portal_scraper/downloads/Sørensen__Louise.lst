{"abstract":"Videoen er en del af projektet Den store Opdagelsesrejse, som blev gennemført i 2015-2016 og som handlede om hvordan børn og pædagoger i en vuggestue kan lege og eksperimentere med digitale medier.","author_count":7,"contributors":["Petersen, Anne Charlotte","Knudsen, Jacob","Thestrup, Klaus","Sandvik, Kjetil","Johansen, Stine Liv","Skjærris, Malene","Sørensen, Louise"],"cuid":["S01-000.00-186623"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Digitale medier"],"level":"pop","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"und","rtype":["clu"],"sorti":"den store opdagelsesrejse for de helt små","src":["au"],"src-code":["DI-U-AU"],"type":"dnt","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-ND","type":"rem","url":"https://youtu.be/1E2tBN6py0w","version":"Published Version"},"id":"S01-000.00-186623","ids":["au-64551320-b685-4a4f-af55-67455e26e7b1"],"keyword":["Jacob knudsen","anne charlotte Petersen","digitale medier","vifin","vuggstuebørn"],"lang":"Danish","level":"Popular","mra":["Humanities"],"noi":["Local-1-1-F78D68BD1086DFD52D3CA68816773316"],"oa_link":[{"access":"oa","license":"CC BY-ND","type":"rem","url":"https://youtu.be/1E2tBN6py0w","version":"Published Version"}],"org":[{"affno":"1","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Arts, Centre for Teaching Development and Digital Media"],"nora_code":"DI-U-AU","used":1},{"affno":"3","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Anne Charlotte","key":"petersenppu","last":"Petersen","name":"Petersen, Anne Charlotte","rank":1,"role":"Publisher","rolecode":"ppu"},{"affno":"1","corresponding":null,"first":"Jacob","key":"knudsenppu","last":"Knudsen","name":"Knudsen, Jacob","rank":2,"role":"Publisher","rolecode":"ppu"},{"affno":"2","corresponding":null,"first":"Klaus","key":"thestrupoth","last":"Thestrup","locid":"98a408d8-8e96-4b19-b0e5-fd95a9cde235","name":"Thestrup, Klaus","rank":3,"role":"Other","rolecode":"oth"},{"affno":"3","corresponding":null,"first":"Kjetil","key":"sandvikoth","last":"Sandvik","name":"Sandvik, Kjetil","rank":4,"role":"Other","rolecode":"oth"},{"affno":"2","corresponding":null,"country":"dk","first":"Stine Liv","key":"johansenoth","last":"Johansen","locid":"c5809e2c-a291-482d-bae2-14307180f9b6","name":"Johansen, Stine Liv","orcid":"0000-0002-2832-4029","rank":5,"role":"Other","rolecode":"oth"},{"affno":"1","corresponding":null,"first":"Malene","key":"skjærrispau","last":"Skjærris","name":"Skjærris, Malene","rank":6,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Louise","key":"sørensenpau","last":"Sørensen","name":"Sørensen, Louise","rank":7,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Undetermined","search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-64551320-b685-4a4f-