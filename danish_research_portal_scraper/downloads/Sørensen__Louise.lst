irst":"Christian Juhl","key":"terkelsenpau","last":"Terkelsen","locid":"c0d7f995-6ff2-458e-996a-e9a0fccd663f","name":"Terkelsen, Christian Juhl","rank":10,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Peter Hasse","key":"møllersørensenpau","last":"Møller-Sørensen","name":"Møller-Sørensen, Peter Hasse","rank":11,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"L.","key":"holmvangpau","last":"Holmvang","name":"Holmvang, L.","rank":12,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jesper","key":"kjaergaardpau","last":"Kjaergaard","name":"Kjaergaard, Jesper","rank":13,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Christian","key":"hassagerpau","last":"Hassager","name":"Hassager, Christian","rank":14,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jacob Eifer","key":"møllerpau","last":"Møller","name":"Møller, Jacob Eifer","rank":15,"rolecode":"pau"}],"pub":{"doi":"10.1093/eurheartj/ehac544.1518","issn":["0195668X","15229645"],"issn_org":["0195668X"],"issue":"Supplement 2","journal":"European Heart Journal","paperid":"ehac544.1518,","publisher":"Oxford University Press","status":"p","title":"European Heart Journal","volume":"43"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-0db62756-923d-41e8-b6c1-77cfe3e4341b"],"src":["AU Aarhus University"],"title":"Selection of patients for mechanical circulatory support for refractory out-of-hospital cardiac arrest : a Danish nationwide multicenter study","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-137200","year":"2022","yearsub":"2022"}
{"abstract":"Treatment for metastatic colorectal cancer (mCRC) is focused on prolonging survival and maintaining quality of life. It is important to establish prognostic and predictive markers to avoid extended, ineffective treatment. The aim of the present study was, by a novel approach, to analyze the association between cell-free (cf)DNA levels and outcome in patients receiving systemic therapy for incurable mCRC. The study was a prospective non-interventional biomarker study for patients receiving standard of systemic treatment for mCRC. Patients with mCRC, who, according to standard guidelines, were considered for treatment with EGFR inhibitors, were included. The cfDNA levels in consecutive plasma samples were measured by a direct fluorescence assay. The study included 47 patients. Blood samples were available at baseline (n=47); prior to the third treatment cycle (n=31); the first (n=33), second (n=22) and third response evaluation during treatment (n=17); and at progression (n=22). The disease control rate was 42 and 91% in patients with high (≥75th percentile of baseline cfDNA levels) and low cfDNA levels (<75th percentile of baseline cfDNA levels), respectively (P<0.001). Median progression-free survival (PFS) was 3.8 and 8.5 months in patients with high and low cfDNA levels, respectively (hazard ratio=3.03, 95% CI 1.46-6.29, P<0.01). Median overall survival (OS) was 5.0 and 26.6 months in patients with high and low cfDNA levels, respectively (hazard ratio=3.48, 95% CI 1.44-8.44, P<0.01). In the multivariate analysis, baseline cfDNA levels remained a significant predictor of PFS and OS. In conclusion, cfDNA is a promising prognostic tool in the personalized treatment of mCRC. cfDNA levels were estimated by a simple, rapid and inexpensive method (OPTIPAL II: ClinicalTrials.gov identifier no. NCT03750175; registered November 21, 2018).","author_count":6,"contributors":["Callesen, Louise Bach","Sørensen, Brita Singers","Pallisgaard, Niels","Laugesen, Ina Grønkjær","Boysen, Anders Kindberg","Spindler, Karen-Lise Garm"],"cuid":["S01-000.00-166125"],"filters":{"added":"2022-05","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Callesen, Louise Bach"],"keyword":["Biomarker","Cell free DNA","Systemic therapy"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-ZEA"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-HO-ZEA","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"total cell free dna measurement in metastatic colorectal cancer with a fast and easy direct fluorescent assay","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC8822899/pdf/mco-16-03-02497.pdf","version":"Published Version"},"id":"S01-000.00-166125","identifier":[{"id":"85124161051","type":"scopus"},{"id":"35154704","type":"pmid"},{"id":"PMC8822899","type":"pmcid"}],"ids":["au-409e7d89-d00d-43a6-815b-2ce88b439183"],"keyword":["Biomarker","Cell-free DNA","Colorectal adenocarcinomametastatic colorectal cancer","Systemic therapy"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-D5E9B9BC21B8EA882D14CF18D623B546"],"oa_link":[{"access":"oa","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC8822899/pdf/mco-16-03-02497.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Experimental Clinical Oncology"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"region zealand","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-ZEA","l3nl":"Region Zealand","l3nn":"Region Zealand","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region Zealand","namevar":["Zealand University Hospital"],"nora_code":"DI-HO-ZEA","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Louise Bach","key":"callesenpau","last":"Callesen","locid":"0134dc30-b0d0-4d0a-9710-938c2ff1b563","name":"Callesen, Louise Bach","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Brita Singers","key":"sørensenpau","last":"Sørensen","locid":"e57c5a80-b420-4fba-9090-c5254f617b5d","name":"Sørensen, Brita Singers","orcid":"0000-0002-3955-4735","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Niels","key":"pallisgaardpau","last":"Pallisgaard","name":"Pallisgaard, Niels","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ina Grønkjær","key":"laugesenpau","last":"Laugesen","locid":"a377d7ed-c479-430f-9ada-b0292ebb10cc","name":"Laugesen, Ina Grønkjær","orcid":"0000-0002-1101-4032","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders Kindberg","key":"boysenpau","last":"Boysen","locid":"304f79e0-6a7b-48a3-bbef-db956a9a25bb","name":"Boysen, Anders Kindberg","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Karen Lise Garm","key":"spindlerpau","last":"Spindler","locid":"44550b92-1db9-45d9-97ed-e0dfc3d89e50","name":"Spindler, Karen-Lise Garm","name_org":"Spindler, Karen Lise Garm","rank":6,"rolecode":"pau"}],"pmid":["35154704"],"pub":{"doi":"10.3892/mco.2022.2497","issn":["20499450","20499469"],"issn_org":["20499450"],"issue":"3","journal":"Molecular and Clinical Oncology","paperid":"64","publisher":"Lippincott Williams and Wilkins","status":"p","title":"Molecular and Clinical Oncology","volume":"16"},"review":"Peer Reviewed","scoID":["2-s2.0-85124161051"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region Zealand","Universities"],"PST":["Published"]},"sid":["au-409e7d89-d00d-43a6-815b-2ce88b439183"],"src":["AU Aarhus University"],"title":"Total cell-free DNA measurement in metastatic colorectal cancer with a fast and easy direct fluorescent assay","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-166125","year":"2022","yearsub":"2022"}
{"abstract":"Based on a unique series of deliberative workshops, the report explores and chronicles the attitudes, values and perspectives on organoid research among representatives from the general public, patients, donors, vulnerable groups and CSOs with a particular view to the distinct moral, regulatory and ethical implications of organoid research that emerged from the deliberations. Three deliberative workshops with a total of 51 participants were held in November, 2021 in Italy, Greece and Denmark and hence across three different European countries representing different parts of Europe and different religious, cultural and science-in-society contexts. The deliberations were conducted as part of the Horizon 2020 project HYBRIDA (Em-bedding a comprehensive ethical dimension to organoid-based research and resulting technologies), which aims to develop a conceptual and regulatory framework including operational guidelines for the field and a code of conduct (CoC) for researchers in academia and industry, partly based on a comprehensive three-stage public engagement co-creation and validation process of which the series of deliberative workshops constitute the first course of action. Overall, participants expressed a positive attitude towards organoid research irrespective of participant category and background characteristics such as gender, religious affiliation and age. They found the prospects of progress as well as both current and future benefits of organoid research promising and attached positive expectations to their application and contribution within biomedical research. While the participants broadly supported the use of organoids, they also expressed a number of key concerns and worries related to their current and future derivation and use: Participants expressed unease towards the commercialisation of organoids and were concerned that organoid research would add to existing inequalities if not properly and responsibly governed. Potential misuse and breach of the privacy of personal data in connection with data storage and donation was also emphasised as a considerable concern. Another concern, albeit not dominant, was potential misuse of organoids for war purposes. The two interrelated themes of informed consent and responsible governance were highlighted through-out the deliberations as particularly important for participants in order to safeguard ethical and acceptable use. A majority of participants advocated for some restrictions imposed on consent procedures and recommended that issues of ownership and remuneration be specified in the consent form and be contingent on the type of consent provided. Nonetheless, a majority adopted the position that donations of cells should be viewed as a donation or gift transferred without financial compensation. In general, it is evident from the deliberations that ethical use of cell donations has to be guaranteed through strict governance structures, control and ethical oversight procedures. Both Greek and Italian participants address an association between concerns about misuse of organoid research and a societal distrust in science, which underlines the importance of clear, transparent and objective research dissemination and science communication. It is also evident from the deliberations that cerebral organoids/brain organoids raise specific ethical issues and concerns due to questions concerning conscience and moral status. Participants generally pointed to the dynamic nature of organoids and a concurrent need for ongoing societal debate, regular revisions of ethical guidelines and procedures where ethical needs and requirements are aligned with the state-of-the-art in organoid research as it increasingly moves into clinical and translational research. Participants were divided in their conceptualisations of organoids. While a majority of participants primarily perceived them as research tools in their current stage, many participants regarded them as living organisms. The report provides a broad set of recommendations from participants for key issues to be addressed in future ethical guidelines on organoid research. The first part of the report reviews the main findings from the deliberations; the second part includes three comprehensive reports from each of the national workshops for a more single-case and detailed exposition.","author_count":10,"contributors":["Ravn, Tine","Sørensen, Mads P.","Saugstrup, Louise Isgaard","Picozzi, Mario","Pegoraro, Renzo","Capulli, Emma","Rasori, Giovanni","Spyrakou, Eleni","Stavridi, Vana","Kavouras, Panagiotis"],"cuid":["S01-000.00-171223"],"filters":{"added":"2022-07","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"corresponding_author":["Ravn, Tine"],"country":["Greece","Italy"],"glorg":["All Global Affiliations","National Technical University of Athens","University of Insubria"],"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"nr","rtype":["clu"],"sorti":"d000000000004 000000000003 public attitudes understandings and perspectives on organoid research findings from a series of deliberative workshops","src":["au"],"src-code":["DI-U-AU"],"type":"dr","type-grp":["all","pub"]},"id":"S01-000.00-171223","ids":["au-4981eafc-09b9-4270-9ed5-875bc5b153fd"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-E8807A41804604E02813BEF679C93B76"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus BSS, Department of Political Science, Department of Political Science - Danish Centre for Studies in Research and Research Policy"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"it","key":"university of insubria","loc":["Italy","Europe, EU","OECD"],"name":"University of Insubria","used":1},{"affno":"3","country":"gr","key":"national technical university of athens","loc":["Greece","Europe, EU","OECD"],"name":"National Technical University of Athens","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Tine","key":"ravnpau","last":"Ravn","locid":"5d9fc737-4fb5-4383-b789-448caeab3f0b","name":"Ravn, Tine","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mads P.","key":"sørensenpau","last":"Sørensen","locid":"fa411f34-079c-444b-afc9-a1ad05e462e3","name":"Sørensen, Mads P.","orcid":"0000-0003-2455-2515","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Louise Isgaard","key":"saugstruppau","last":"Saugstrup","locid":"7b78b3b3-f514-4873-bca5-d34cff566038","name":"Saugstrup, Louise Isgaard","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Mario","key":"picozzipau","last":"Picozzi","name":"Picozzi, Mario","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Renzo","key":"pegoraropau","last":"Pegoraro","name":"Pegoraro, Renzo","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Emma","key":"capullipau","last":"Capulli","name":"Capulli, Emma","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Giovanni","key":"rasoripau","last":"Rasori","name":"Rasori, Giovanni","rank":7,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Eleni","key":"spyrakoupau","last":"Spyrakou","name":"Spyrakou, Eleni","rank":8,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Vana","key":"stavridipau","last":"Stavridi","name":"Stavridi, Vana","rank":9,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Panagiotis","key":"kavouraspau","last":"Kavouras","name":"Kavouras, Panagiotis","rank":10,"rolecode":"pau"}],"pub":{"pages":"214","status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-4981eafc-09b9-4270-9ed5-875bc5b153fd"],"src":["AU Aarhus University"],"title":"D4.3. Public attitudes, understandings and perspectives on organoid research : Findings from a series of deliberative workshops","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-171223","year":"2022","yearsub":"2022"}
{"abstract":"Aim/Introduction: 15O-water PET/CT is the gold standard for noninvasive measurements of tissue blood fow and can potentially play a future role in the diagnosis and treatment of peripheral artery disease. In the current study, we aimed to measure the variation of normal resting blood fow in lower leg muscles between individuals (healthy subjects) as well as between repeated measurements in the same individual. Materials and Methods: We have enrolled 7/10 planned healthy subjects who underwent two identical 15O-water PET/CT scans of the lower legs, separated by a 5-minute break. During the break, subjects were taken out of the scanner and asked to take a few steps. After additional 5 minutes of resting in a supine position, they completed the second scan. In both scans, a standardized intravenous injection of 400 MBq 15O-H2O was followed by a 6-minute dynamic PET acquisition. In low-dose CT images, we defned volumes of interest (VOIs) in diferent lower leg muscles (gastrocnemius(GAS), soleus(SOL), tibialis anterior(TA), and peroneus longus(PL)) of each subject. As the PET scan was acquired immediately after the CT, VOIs could be transferred directly to the PET images for quantitative measurements of 15O-H2O uptake, and time-activity curves were extracted. Kinetic analysis was performed using in-house developed software. K1 (ml/100ml/min) was estimated using a single-tissue compartment model. Results: Resting K1 values ranged from 0.16-0.73 ml/100ml/min (median 0.26,IQR:0.21-0.33). At muscle level, variation was observed in the muscle groups, with median K1 values of 0.32(GAS), 0.24(PL), 0.37(SOL), and 0.25(TA) ml/100ml/min in the frst scan. Repeated measurements of 15O-water PET/CT perfusion in lower extremities showed a strong correlation of K1 values (slope:1.02,intercept:- 0.03,r=0.90) and the blood input function did not change between the repeated scans (correlation for AUC: r=0.97 with no signifcant bias). Bland-Altman analysis revealed both negative and positive proportional bias at an individual level in 3/6 scans, suggesting that perfusion changed between the scans. Conclusion: Normal resting blood fow in four muscle groups of the lower leg ranged from 0.16- 0.73 ml/100ml/min in healthy individuals. The largest variation was seen between individuals, whereas a smaller variation was seen between muscle groups. Repeated measurement of resting blood fow yielded a strong overall correlation of K1. When utilizing resting blood fow of the lower extremities for vascular disease evaluation (e.g. diabetes) or treatment response evaluation, inter-patient variation in blood fow, as well as intra-patient variation induced by the small diferences in resting conditions, must be taken into account","author_count":6,"contributors":["Christensen, Nana Louise","Buhl, Christian Selmer","Sørensen, Jens","Bouchelouche, Kirsten","Madsen, Michael Alle","Tolbod, Lars Poulsen"],"cuid":["S01-000.00-219899"],"event":{"end":"2022-12-19","place":"Barcelona, es","start":"2022-10-15","title":"Annual Congress of the European Association of Nuclear Medicine 2022","year":"2022"},"filters":{"added":"2023-02","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Contrast Media","Humans","Hypersensitivity","Iodine","Nuclear Medicine","Radionuclide Imaging"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"repeated measurements of lower leg skeletal muscle perfusion using sup 000000000015 sup o water pet ct","src":["au"],"src-code":["DI-U-AU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-219899","identifier":[{"id":"PMC9388969","type":"pmcid"},{"id":"34585268","type":"pmid"}],"ids":["au-9f028f9f-b4ed-436b-bff6-0e42dc35bd7d"],"keyword":["Contrast Media","Humans","Hypersensitivity","Iodine","Nuclear Medicine","Radionuclide Imaging"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-764D2EF7039E94058344CD44DF49DE27"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Nuclear Medicine","Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - SDCA-Steno Diabetes Center Aarhus"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Nana Louise","key":"christensenpau","last":"Christensen","locid":"796a6fa5-29d9-40b3-b549-0610eb49705c","name":"Christensen, Nana Louise","orcid":"0000-0002-9936-1636","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christian Selmer","key":"buhlpau","last":"Buhl","locid":"1efc3457-5381-4d2d-ad63-c06127066a25","name":"Buhl, Christian Selmer","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens","key":"sørensenpau","last":"Sørensen","locid":"cab278f0-6db5-48a8-8764-b7da319d7818","name":"Sørensen, Jens","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kirsten","key":"bouchelouchepau","last":"Bouchelouche","locid":"f253980f-a953-448a-bdfb-2a0fcfe82101","name":"Bouchelouche, Kirsten","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Michael Alle","key":"madsenpau","last":"Madsen","locid":"e14de478-8675-42c9-ac79-cacf6da61050","name":"Madsen, Michael Alle","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars Poulsen","key":"tolbodpau","last":"Tolbod","locid":"a1e56507-eb80-4f94-9470-df90dcecbc62","name":"Tolbod, Lars Poulsen","orcid":"0000-0002-8105-7046","rank":6,"rolecode":"pau"}],"pmid":["34585268"],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-9f028f9f-b4ed-436b-bff6-0e42dc35bd7d"],"src":["AU Aarhus University"],"title":"Repeated measurements of lower leg skeletal muscle perfusion using <sup>15</sup>O-water PET/CT","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-219899","year":"2022","yearsub":"2022"}
{"abstract":"Staphylococcus aureus is a widespread and highly virulent pathogen that can cause superficial and invasive infections. Interactions between S. aureus surface receptors and the extracellular matrix protein fibronectin mediate the bacterial invasion of host cells and is implicated in the colonization of medical implant surfaces. In this study, we investigate the role of distribution of both fibronectin and cellular receptors on the adhesion of S. aureus to interfaces as a model for primary adhesion at tissue interfaces or biomaterials. We present fibronectin in patches of systematically varied size (100-1000 nm) in a background of protein and bacteria rejecting chemistry based on PLL-g-PEG and studied S. aureus adhesion under flow. We developed a single molecule imaging assay for localizing fibronectin binding receptors on the surface of S. aureus via the super-resolution DNA points accumulation for imaging in nanoscale topography (DNA-PAINT) technique. Our results indicate that S. aureus adhesion to fibronectin biointerfaces is regulated by the size of available ligand patterns, with an adhesion threshold of 300 nm and larger. DNA-PAINT was used to visualize fibronectin binding receptor organization in situ at ∼7 nm localization precision and with a surface density of 38-46 μm-2, revealing that the engagement of two or more receptors is required for strong S. aureus adhesion to fibronectin biointerfaces.","author_count":8,"contributors":["Khateb, Heba","Sørensen, Rasmus Schøler","Cramer, Kimberly","Eklund, Alexandra S.","Kjems, Jørgen","Meyer, Rikke Louise","Jungmann, Ralf","Sutherland, Duncan S"],"cuid":["S01-000.00-265651"],"filters":{"added":"2022-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"corresponding_author":["Sutherland, Duncan S"],"country":["Germany"],"glorg":["All Global Affiliations","Ludwig Maximilian University","Max Planck Institute of Biochemistry"],"keyword":["Colloidal lithography","DNA paint","Fibronectin","protein nanopattern"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"the role of nanoscale distribution of fibronectin in the adhesion of staphylococcus aureus studied by protein patterning and dna paint","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1021/acsnano.2c00630","version":"Published Version"},"id":"S01-000.00-265651","identifier":[{"id":"PMC9330902","type":"pmcid"},{"id":"85136014263","type":"scopus"},{"id":"35801826","type":"pmid"}],"ids":["au-eed6fe74-a3be-4778-becf-6dc23a6b5c8b"],"keyword":["DNA-PAINT","Staphylococcus aureus adhesion","colloidal lithography","fibronectin","fibronectin binding protein localization","protein nanopattern"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-CBAF4A345ABE23BFF22E45B61590B301"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1021/acsnano.2c00630","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC9330902/pdf/nn2c00630.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Interdisciplinary Nanoscience Center"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"de","key":"max planck institute of biochemistry","loc":["Germany","Europe, EU","OECD"],"name":"Max Planck Institute of Biochemistry","used":1},{"affno":"3","country":"de","key":"ludwig maximilian university","loc":["Germany","Europe, EU","OECD"],"name":"Ludwig Maximilian University","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Heba","key":"khatebpau","last":"Khateb","locid":"d98c6ee8-14ca-4dd9-afbb-71f6f71bed40","name":"Khateb, Heba","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rasmus S.","key":"sørensenpau","last":"Sørensen","locid":"dd13ff30-6bd7-4512-bc60-efa5c5b0ebdd","name":"Sørensen, Rasmus Schøler","name_org":"Sørensen, Rasmus S.","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Kimberly","key":"cramerpau","last":"Cramer","name":"Cramer, Kimberly","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Alexandra S.","key":"eklundpau","last":"Eklund","name":"Eklund, Alexandra S.","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jorgen","key":"kjemspau","last":"Kjems","locid":"f5915d75-aca3-437a-9a9d-f4fdfef7accd","name":"Kjems, Jørgen","name_org":"Kjems, Jorgen","orcid":"0000-0003-4128-9317","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rikke L.","key":"meyerpau","last":"Meyer","locid":"f1caa4f6-bc6e-459a-a976-8843c7ea7ff3","name":"Meyer, Rikke Louise","name_org":"Meyer, Rikke L.","orcid":"0000-0002-6485-5134","rank":6,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Ralf","key":"jungmannpau","last":"Jungmann","name":"Jungmann, Ralf","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Duncan S.","key":"sutherlandpau","last":"Sutherland","locid":"5c5c563f-ca05-4219-b60d-8a3d6303ff2f","name":"Sutherland, Duncan S","name_org":"Sutherland, Duncan S.","rank":8,"rolecode":"pau"}],"pmid":["35801826"],"pub":{"doi":"10.1021/acsnano.2c00630","issn":["19360851","1936086X"],"issn_org":["19360851"],"issue":"7","journal":"ACS Nano","pages":"10392-10403","publisher":"American Chemical Society","status"