{"author_count":3,"contributors":["Sørensen, Tina Louise Hove","Eriksson, Birgit","Stage, Carsten"],"cuid":["S01-000.00-727604"],"filters":{"added":"2024-05","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Sørensen, Tina Louise Hove"],"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"nr","rtype":["clu"],"sorti":"editorial experiencing participation","src":["au"],"src-code":["DI-U-AU"],"type":"dje","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.2478/tjcp-2024-0001","version":"Published Version"},"id":"S01-000.00-727604","ids":["au-6eed39a6-e030-45ae-befe-c4a2e8deb434"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Global-Local-2-3-58B2A2727630FC77DEEF13C82564479F"],"oa_link":[{"access":"oa","type":"rem","url":"https://sciendo.com/article/10.2478/tjcp-2024-0001","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.2478/tjcp-2024-0001","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Arts, School of Communication and Culture, School of Communication and Culture - Department of Art History, Aesthetics & Culture and Museology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Tina Louise Hove","key":"sørensenpau","last":"Sørensen","locid":"2560cc73-3cc9-4077-85b7-55dc78426422","name":"Sørensen, Tina Louise Hove","orcid":"0009-0000-0392-0767","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Birgit","key":"erikssonpau","last":"Eriksson","locid":"eb18bab8-bb58-40f8-8388-9e2f2e1f75a1","name":"Eriksson, Birgit","orcid":"0000-0002-7759-7592","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Carsten","key":"stagepau","last":"Stage","locid":"143c9f12-b105-49f0-99e5-3d3a3dae7006","name":"Stage, Carsten","orcid":"0000-0002-7789-4925","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.2478/tjcp-2024-0001","issn":["22463755"],"issue":"1","journal":"Conjunctions : transdisciplinary journal of cultural participation","pages":"1-8","publisher":"Aarhus University, Department of Aesthetics and Communication","status":"p","title":"Conjunctions : transdisciplinary journal of cultural participation","volume":"11"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-6eed39a6-e030-45ae-befe-c4a2e8deb434"],"src":["AU Aarhus University"],"title":"Editorial: Experiencing participation","type":"Editorial","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-727604","year":"2024","yearsub":"2024"}
{"abstract":"Background Acidosis is associated with exacerbated loss of kidney function in CKD. Currently, acid/base status is assessed by plasma measures, although organ-damaging covert acidosis, subclinical acidosis, may be present before reflected in plasma. Low urine NH41 excretion associates with poor kidney outcomes in CKD and is proposed as a marker for subclinical acidosis. However, low NH41 excretion could result from either a low capacity or a low demand for acid excretion. We hypothesized that a urine acid/base score reflecting both the demand and capacity for acid excretion would better predict CKD progression. Methods Twenty-four–hour urine collections were included from three clinical studies of patients with CKD stage 3 and 4: a development cohort (N582), a variation cohort (N558), and a validation cohort (N573). A urine acid/base score was derived and calculated from urinary pH and [NH41]. Subclinical acidosis was defined as an acid/base score below the lower limit of the 95% prediction interval of healthy controls. The main outcomes were change in measured GFR after 18 months and CKD progression (defined as $50% decline in eGFR, initiation of long-term dialysis, or kidney transplantation) during up to 10 years of follow-up. Results Subclinical acidosis was prevalent in all cohorts (n554/82, 48/73, and 40/58, respectively, approximately 67%). Subclinical acidosis was associated with an 18% (95% confidence interval [CI], 2 to 32) larger decrease of measured GFR after 18 months. During a median follow-up of 6 years, subclinical acidosis was associated with a higher risk of CKD progression. Adjusted hazard ratios were 9.88 (95% CI, 1.27 to 76.7) in the development cohort and 11.1 (95% CI, 2.88 to 42.5) in the validation cohort. The acid/base score had a higher predictive value for CKD progression than NH41 excretion alone. Conclusions Subclinical acidosis, defined by a new urine acid/base score, was associated with a higher risk of CKD progression in patients with CKD stage 3 and 4.","author_count":12,"contributors":["Svendsen, Samuel L","Rousing, Amalie Quist","Carlsen, Rasmus Kirkeskov","Khatir, Dinah Sherzad","Jensen, Danny","Hansen, Nikita Misella","Salomo, Louise","Birn, Henrik","Buus, Niels Henrik","Leipziger, Jens","Sørensen, Mads Vaarby","Berg, Peder"],"cuid":["S01-000.00-743581"],"filters":{"added":"2024-08","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Electrolyte","acid base disorders"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-HO-CAP","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"a urine ph ammonium acid base score and ckd progression","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85199385689","version":"Other Version"},"id":"S01-000.00-743581","identifier":[{"id":"39018119","type":"pmid"},{"id":"85199385689","type":"scopus"}],"ids":["au-05b16f4e-e841-422b-9c78-7aa5ca206969"],"keyword":["acid-base disorders","acidosis CKD progression proximal tubule ESKD fluid","electrolyte"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-557AACE0C687C7765DCF31F2E8CFA81D"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Biomedicine, Department of Biomedicine - Forskning og uddannelse, Skou-bygningen","Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - University Clinic in Nephrology and Hypertension, Holstebro Hospital"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Samuel Levi","key":"svendsenpau","last":"Svendsen","locid":"4babea2c-e65b-4494-911f-5802c8db3b62","name":"Svendsen, Samuel L","name_org":"Svendsen, Samuel Levi","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Amalie Quist","key":"rousingpau","last":"Rousing","locid":"74de8ff9-f61c-41e9-be70-ff366780c970","name":"Rousing, Amalie Quist","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rasmus Kirkeskov","key":"carlsenpau","last":"Carlsen","locid":"7194e8fe-7255-45bc-8516-0bf4319378a1","name":"Carlsen, Rasmus Kirkeskov","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Dinah","key":"khatirpau","last":"Khatir","locid":"91ae5ce6-5883-4250-a1bf-140dd1987d4c","name":"Khatir, Dinah Sherzad","name_org":"Khatir, Dinah","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Danny","key":"jensenpau","last":"Jensen","locid":"ca2dfaa2-ed1a-4af8-b275-3fc2b5114612","name":"Jensen, Danny","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Nikita Misella","key":"hansenpau","last":"Hansen","name":"Hansen, Nikita Misella","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Louise","key":"salomopau","last":"Salomo","name":"Salomo, Louise","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik","key":"birnpau","last":"Birn","locid":"1b3c44f6-5d9b-406d-84a3-700b510fb9ff","name":"Birn, Henrik","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Niels Henrik","key":"buuspau","last":"Buus","locid":"cb682ed6-2fe3-4664-90d6-0690462e8f80","name":"Buus, Niels Henrik","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jens","key":"leipzigerpau","last":"Leipziger","locid":"89f75d86-f3d8-4ed3-8754-24c9bcf0080c","name":"Leipziger, Jens","orcid":"0000-0002-6719-7034","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mads Vaarby","key":"sorensenpau","last":"Sorensen","locid":"f42195c2-31a1-460d-aecc-316e6dfe8baf","name":"Sørensen, Mads Vaarby","name_org":"Sorensen, Mads Vaarby","orcid":"0000-0001-6398-1035","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Peder","key":"bergpau","last":"Berg","locid":"e78b0bcb-ed5f-4b7d-ae94-1793d5d65e21","name":"Berg, Peder","orcid":"0000-0002-5216-2891","rank":12,"rolecode":"pau"}],"pmid":["39018119"],"pub":{"doi":"10.1681/asn.0000000000000447","issn":["10466673","15333450"],"issn_org":["10466673"],"issue":"11","journal":"Journal of the American Society of Nephrology","pages":"1533-1545","publisher":"Wolters Kluwer Health","status":"p","title":"Journal of the American Society of Nephrology","volume":"35"},"review":"Peer Reviewed","scoID":["2-s2.0-85199385689"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities"],"PST":["Published"]},"sid":["au-05b16f4e-e841-422b-9c78-7aa5ca206969"],"src":["AU Aarhus University"],"title":"A Urine pH-Ammonium Acid/Base Score and CKD Progression","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-743581","year":"2024","yearsub":"2024"}
{"abstract":"Purpose: Tumour perfusion is a nutrient-agnostic biomarker for cancer metabolic rate. Use of tumour perfusion for cancer growth assessment has been limited by complicated image acquisition, image analysis and limited field-of-view scanners. Long axial field-of-view (LAFOV) PET scan using [15O]H2O, allows quantitative assessment of whole-body tumour perfusion. We created a tool for automated creation of quantitative parametric whole-body tumour perfusion images in metastatic cancer. Methods: Ten metastatic prostate cancer patients underwent dynamic LAFOV [15O]H2O PET (Siemens, Quadra) followed by [18F]PSMA-1007 PET. Perfusion was measured as [15O]H2O K1 (mL/min/mL) with a single-tissue compartment model and an automatically captured cardiac image-derived input function. Parametric perfusion images were automatically calculated using the basis-function method with initial voxel-wise delay estimation and a leading-edge approach. Subsequently, perfusion of volumes-of-interest (VOI) can be directly extracted from the parametric images. We used a [18F]PSMA-1007 SUV 4 fixed threshold for tumour delineation and transferred these VOIs to the perfusion map. Results: For 8 primary tumours, 64 lymph node metastases, and 85 bone metastases, median tumour perfusion were 0.19 (0.15–0.27) mL/min/mL, 0.16 (0.13–0.27) mL/min/mL, and 0.26 (0.21–0.39), respectively. The correlation between calculated perfusion from time-activity-curves and parametric images was excellent (r = 0.99, p < 0.0001). Conclusion: LAFOV PET imaging using [15O]H2O enables truly quantitative parametric images of whole-body tumour perfusion, a potential biomarker for guiding personalized treatment and monitoring treatment response.","author_count":6,"contributors":["Jochumsen, Mads Ryø","Christensen, Nana Louise","Iversen, Peter","Gormsen, Lars Christian","Sørensen, Jens","Tolbod, Lars Poulsen"],"cuid":["S01-000.00-744235"],"filters":{"added":"2024-08","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"corresponding_author":["Jochumsen, Mads Ryø"],"country":["Sweden"],"glorg":["All Global Affiliations","Uppsala University"],"keyword":["Cancer","Dynamic PET","Long axial field of view","Perfusion","Prostate cancer","Tumour blood flow"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"whole body parametric mapping of tumour perfusion in metastatic prostate cancer using long axial field of view sup 000000000015 sup o h sub 000000000002 sub o pet","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1007/s00259-024-06799-3","version":"Published Version"},"id":"S01-000.00-744235","identifier":[{"id":"85197937251","type":"scopus"},{"id":"38940842","type":"pmid"},{"id":"PMC11527927","type":"pmcid"}],"ids":["au-4fa18408-a308-4a5a-b67b-ac23d2727ecf"],"keyword":["Cancer","Dynamic PET","Long axial field-of-view","Perfusion","Prostate cancer","Tumour blood flow"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-A314E12B132329589D3EEE44981927A5"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1007/s00259-024-06799-3","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Nuclear Medicine","Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Nuklearmedicin, RHG"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"se","key":"uppsala university","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Uppsala University","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Mads Ryø","key":"jochumsenpau","last":"Jochumsen","locid":"a37a78df-6321-4fa5-b7c6-bffff0aa5a00","name":"Jochumsen, Mads Ryø","orcid":"0000-0002-7676-2322","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Nana L","key":"christensenpau","last":"Christensen","locid":"796a6fa5-29d9-40b3-b549-0610eb49705c","name":"Christensen, Nana Louise","name_org":"Christensen, Nana L","orcid":"0000-0002-9936-1636","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Peter","key":"iversenpau","last":"Iversen","locid":"652caf77-ea4a-47a4-b9bf-98a5ec21d9dc","name":"Iversen, Peter","orcid":"0000-0003-2455-5142","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars C","key":"gormsenpau","last":"Gormsen","locid":"a360c42f-861a-40d6-9d23-64b560b33190","name":"Gormsen, Lars Christian","name_org":"Gormsen, Lars C","orcid":"0000-0002-0144-1305","rank":4,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Jens","key":"sørensenpau","last":"Sørensen","locid":"cab278f0-6db5-48a8-8764-b7da319d7818","name":"Sørensen, Jens","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars P","key":"tolbodpau","last":"Tolbod","locid":"a1e56507-eb80-4f94-9470-df90dcecbc62","name":"Tolbod, Lars Poulsen","name_org":"Tolbod, Lars P","orcid":"0000-0002-8105-7046","rank":6,"rolecode":"pau"}],"pmid":["38940842"],"pub":{"doi":"10.1007/s00259-024-06799-3","issn":["16197070","16197089"],"issn_org":["16197070"],"issue":"13","journal":"European Journal of Nuclear Medicine and Molecular Imaging","pages":"4134-4140","publisher":"Springer","status":"p","title":"European Journal of Nuclear Medicine and Molecular Imaging","volume":"51"},"review":"Peer Reviewed","scoID":["2-s2.0-85197937251"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-4fa18408-a308-4a5a-b67b-ac23d2727ecf"],"src":["AU Aarhus University"],"title":"Whole-body parametric mapping of tumour perfusion in metastatic prostate cancer using long axial field-of-view [<sup>15</sup>O]H<sub>2</sub>O PET.","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-744235","year":"2024","yearsub":"2024"}
{"abstract":"Multiple studies have shown that cell-free DNA (cfDNA) from cancer patients differ in both fragment length and fragment end motif (FEM) from healthy individuals, yet there is a lack of understanding of how the two factors combined are associated with cancer and gene transcription. In this study, we conducted cfDNA fragmentomics evaluations using plasma from lung cancer patients ( n = 12) and healthy individuals ( n = 7). A personal gene expression profile was established from plasma using H3K36me3 cell-free chromatin immunoprecipitation sequencing (cfChIP-seq). The genes with the highest expression displayed an enrichment of short cfDNA fragments (median = 19.99%, IQR: 16.94-27.13%, p < 0.0001) compared to the genes with low expression. Furthermore, distinct GC-rich FEMs were enriched after cfChIP. Combining the frequency of short cfDNA fragments with the presence of distinct FEMs resulted in an even further enrichment of the most expressed genes (median = 37.85%, IQR: 30.10-39.49%, p < 0.0001). An in vitro size selection of <150 bp cfDNA could isolate cfDNA representing active genes and the size-selection enrichment correlated with the cfChIP-seq enrichment (Spearman r range: 0.499-0.882, p < 0.0001). This study expands the knowledge regarding cfDNA fragmentomics and sheds new light on how gene activity is associated with both cfDNA fragment lengths and distinct FEMs.","author_count":5,"contributors":["Månsson, Christoffer Trier","Thomsen, Louise Skov","Meldgaard, Peter","Nielsen, Anders Lade","Sorensen, Boe Sandahl"],"cuid":["S01-000.00-745375"],"filters":{"added":"2024-08","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Sorensen, Boe Sandahl"],"keyword":["Biomarkers Tumor genetics","Cell Free Nucleic Acids","Gene expression","Histone modifications","Humans","Liquid biopsies","Liquid biopsy","Lung Neoplasms genetics"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"integration of cell free dna end motifs and fragment lengths can identify active genes in liquid biopsies","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/ijms25021243","version":"Published Version"},"id":"S01-000.00-745375","identifier":[{"id":"PMC10815977","type":"pmcid"},{"id":"85183355777","type":"scopus"},{"id":"38279243","type":"pmid"}],"ids":["au-cceed25d-10ef-4920-9c7d-7557bf85b8a6"],"keyword":["Biomarkers, Tumor/genetics","Cell-Free Nucleic Acids","Humans","Liquid Biopsy","Lung Neoplasms/genetics","cell-free chromatin immunoprecipitation","fragment end motifs","fragmentomics","gene expression","histone modifications","liquid biopsies"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-A1A0E7E13422148B02B9FAF5BF80D25C"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/ijms25021243","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Biomedicine","Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of clinical biochemistry"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Christoffer Trier","key":"maanssonpau","last":"Maansson","locid":"a75cde64-0647-4ec3-bf4c-c1b0e758e9a5","name":"Månsson, Christoffer Trier","name_org":"Maansson, Christoffer Trier","orcid":"0000-0002-3071-3437","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Louise Skov","key":"thomsenpau","last":"Thomsen","name":"Thomsen, Louise Skov","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Peter","key":"meldgaardpau","last":"Meldgaard","locid":"ee4ae31a-9e58-4305-92c2-791e09537944","name":"Meldgaard, Peter","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anders Lade","key":"nielsenpau","last":"Nielsen","locid":"2d9b3874-1b36-43f8-8e33-01600c3bf20a","name":"Nielsen, Anders Lade","orcid":"0000-0003-4372-9961","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Boe Sandahl","key":"sorensenpau","last":"Sorensen","locid":"df36b88d-a4e0-49db-9e8e-78f8dc2120c0","name":"Sorensen, Boe Sandahl","orcid":"0000-0002-9472-8099","rank":5,"rolecode":"pau"}],"pmid":["38279243"],"pub":{"doi":"10.3390/ijms25021243","issn":["14220067","16616596"],"issn_org":["16616596"],"issue":"2","journal":"International Journal of Molecular Sciences","paperid":"1243","publisher":"Multidisciplinary Digital Publishing Institute (MDPI)","status":"p","title":"International Journal of Molecular Sciences","volume":"25"},"review":"Peer Reviewed","scoID":["2-s2.0-85183355777"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-cceed25d-10ef-4920-9c7d-7557bf85b8a6"],"src":["AU Aarhus University"],"title":"Integration of Cell-Free DNA End Motifs and Fragment Lengths Can Identify Active Genes in Liquid Biopsies","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-745375","year":"2024","yearsub":"2024"}
{"abstract":"BACKGROUND: Play can help paediatric patients cope with hospitalisation. Education on the use of play for healthcare professionals (HCPs) is lacking, with playful interactions often occurring unsystematically without formal training. This scoping review systematically describe the frameworks, design, and evaluation methods of educational programmes for HCPs on the use of play in paediatric clinical practice. METHODS: We conducted the scoping review by searching nine databases for white literature and websites for grey literature. Two reviewers independently screened titles/abstracts and reviewed full texts. Kirkpatrick's evaluation model was applied to report the evaluation methods of educational programmes. RESULTS: After identifying 16534 white and 955 grey items we included twenty articles but no grey literature. The educational programmes vaguely defined play for procedural and normalising purposes and mostly targeted mono-professional groups, mainly nurses. The evaluation methods identified in the articles were reported in accordance with Kirkpatrick levels 1: reaction ( n  = 13); 2a: attitude ( n  = 7); 2b: knowledge ( n  = 3); 3: behaviour ( n  = 6); 4a: organisational practice ( n  = 1) and 4b: patient outcomes ( n  = 4). CONCLUSION: The few educational programmes available on the use of play for HCPs are not uniformly described. Future educational programmes would benefit from integrating the needs of HCPs, patients and parents, and using a theoretical framework and systematic evaluation.","author_count":11,"contributors":["Krebs, Christine Louise","Thestrup, Jakob","Hybschmann, Jane","Graber, Kelsey","Gjærde, Line Klingen","Topperzer, Martha Krogh","Nielsen, Emilie Tange","Larsen, Anders","Ramchandani, Paul","Frandsen, Thomas Leth","Sørensen, Jette Led"],"cuid":["S01-000.00-777828"],"filters":{"added":"2025-01","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","University of Cambridge"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"a beme review of educational programmes on the use of play in paediatric practice beme guide no 000000000082","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1080/0142159X.2023.2287983","version":"Published Version"},"id":"S01-000.00-777828","identifier":[{"id":"85179976576","type":"scopus"},{"id":"38098168","type":"pmid"}],"ids":["ku-5d0f16ac-c08d-4249-93b6-15d030e4f1a4"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-31DD7AC55B87592FC858BC1C3CE009F3"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1080/0142159X.2023.2287983","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/411059731/A_BEME_review_of_educational_programmes_on_the_use_of_play_in_paediatric_practice_BEME_Guide_No._82.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","country":"gb","key":"university of cambridge","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Cambridge","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU Universit