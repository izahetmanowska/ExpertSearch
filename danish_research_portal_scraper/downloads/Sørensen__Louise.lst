DU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Science, Department of Physics, Chemistry and Pharmacy","SDU, Faculty of Science, Department of Physics, Chemistry and Pharmacy, Chemistry and Pharmacy"],"nora_code":"DI-U-SDU","used":1},{"affno":"4","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Endocrinology and Internal Medicine"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Annemarie B.","key":"villadsenpau","last":"Villadsen","locid":"71f9e538-f8b1-48d5-a0e3-3bb05794c38c","name":"Villadsen, Annemarie Brusen","name_org":"Villadsen, Annemarie B.","orcid":"0000-0002-4064-2900","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Julie N.","key":"holmjacobsenpau","last":"Holm-Jacobsen","locid":"6cbd7c08-bf4a-45d3-b091-bbc180426007","name":"Holm-Jacobsen, Julie Niemann","name_org":"Holm-Jacobsen, Julie N.","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Julie","key":"niemannholmjacobsenpau","last":"Niemann Holm-Jacobsen","name":"Niemann Holm-Jacobsen, Julie","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Bala Krishna","key":"prabhalapau","last":"Prabhala","locid":"32ec1b87-73ae-45aa-a7e1-c5e06c92f8a7","name":"Prabhala, Bala Krishna","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Caspar","key":"bundgaardnielsenpau","last":"Bundgaard-Nielsen","locid":"621f32eb-b0ed-4146-bed9-a4b793ee401d","name":"Bundgaard-Nielsen, Caspar","orcid":"0000-0002-2700-2378","rank":4,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Pam","key":"huntjenspau","l