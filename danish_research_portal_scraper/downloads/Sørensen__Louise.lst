a","key":"university of manitoba","loc":["Canada","America, North","OECD"],"name":"University of Manitoba","used":1},{"affno":"9","country":"gb","key":"scottish association for marine science scottish marine institute","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Scottish Association for Marine Science, Scottish Marine Institute","used":1},{"affno":"10","country":"gb","key":"the scottish association for marine science","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"The Scottish Association for Marine Science","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Heidi Louise","key":"sørensenpau","last":"Sørensen","locid":"7a5442bb-7ee3-464b-9b90-eee87aee3b39","name":"Sørensen, Heidi Louise","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Bo","key":"thamdruppau","last":"Thamdrup","locid":"8ec7b0d0-2ff1-4f66-bb66-22138f5250a7","name":"Thamdrup, Bo","orcid":"0000-0002-1221-7077","rank":2,"rolecode":"pau"},{"affno":"3 4 5 6","corresponding":null,"country":"dk","first":"Erik","key":"jeppesenpau","last":"Jeppesen","locid":"22bb5d6e-a9ae-4f70-81da-df1c57e71163","name":"Jeppesen, Erik","rank":3,"rolecode":"pau"},{"affno":"3 4 7 8","corresponding":null,"country":"dk","first":"Søren","key":"rysgaardpau","last":"Rysgaard","locid":"781dd219-a3b6-45e7-82c8-917c7cb6112e","name":"Rysgaard, Søren","orcid":"0000-0003-1726-2958","rank":4,"rolecode":"pau"},{"affno":"1 3 4 9 2 7 10","corresponding":null,"first":"Ronnie Nøhr","key":"gludpau","last":"Glud","locid":"5ff8cad3-e8cd-4b3b-839b-23e8e8a1785b","name":"Glud, Ronnie N.","name_org":"Glud, Ronnie Nøhr","orcid":"0000-0002-7069-893X","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1007/s00300-017-2082-7","issn":["07224060","14322056"],"issn_org":["07224060"],"issue":"8","journal":"Polar Biology","pages":"1593-1606","publisher":"Springer Science and Business Media Deutschland GmbH","status":"p","title":"Polar Biology","volume":"40"},"review":"Peer Reviewed","scoID":["2-s2.0-85014101693"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["au-04bb7c4a-ff28-4089-b270-cb1434c48dcb","sdu-1636e65f-bdd9-46e9-8b7d-d8680125f156"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"Nutrient availability limits biological production in Arctic sea ice melt ponds","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.94-012948","year":"2017","yearsub":"2017"}
{"abstract":"Paclitaxel is mainly eliminated by CYP2C8 in the liver. CYP2C8 is strongly inhibited by the clopidogrel metabolite acyl-β-D-glucuronide. To determine if this interaction has clinical relevance, we identified 48 patients treated with clopidogrel and paclitaxel using databases and a prescription register. Peripheral sensory neuropathy was retrospectively evaluated from medical charts and compared to that of 88 age and sex matched controls treated with paclitaxel and low dose aspirin. By a cumulative dose of 1500 mg paclitaxel, 35% of the patients had developed severe neuropathy. The overall hazard ratio between clopidogrel use and severe paclitaxel neuropathy was 1.7 (95% CI, 0.9-3.0). Among those receiving a high dose paclitaxel regimen, the hazard ratio was 2.3 (95% CI, 1.1-4.5). Our study indicates that clopidogrel is associated with a clinically relevant increased risk of neuropathy in patients treated with high dose paclitaxel. This article is protected by copyright. All rights reserved.","author_count":15,"contributors":["Agergaard, K","Mau-Sørensen, M","Bjerregaard Stage, T","Jørgensen, T L","Hassel, R E","Steffensen, K D","Pedersen, J W","Milo, Marie Louise Holm","Poulsen, S H","Pottegård, Anton","Hallas, J.","Brøsen, K.","Bergmann, T K"],"cuid":["S03-097.89-010219"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","University of California","University of California at San Francisco"],"keyword":["Aged","Aspirin","Aspirin administration dosage","Clopidogrel","Cytochrome P 450 CYP2C8 metabolism","Dose Response Relationship Drug","Drug Interactions","Female","Humans","Journal Article","Liver","Liver metabolism","Male","Middle Aged","Paclitaxel","Paclitaxel administration dosage","Peripheral Nervous System Diseases","Peripheral Nervous System Diseases chemically induced","Pharmacoepidemiology","Platelet Aggregation Inhibitors","Platelet Aggregation Inhibitors administration dosage","Retrospective Studies","Severity of Illness Index","Ticlopidine","Ticlopidine administration dosage"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"clopidogrel paclitaxel drug drug interaction a pharmacoepidemiologic study","src":["aau","au","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85019672170","version":"Other Version"},"id":"S03-097.89-010219","identifier":[{"id":"000407082400029","type":"wos"},{"id":"85019672170","type":"scopus"},{"id":"28224612","type":"pmid"}],"ids":["aau-d5968a99-ec29-4264-a97a-1f2816cb0e00","au-939947b0-aa97-450a-856e-525e996476a3","sdu-ef14cdd6-ea0a-4a5b-87f9-b18e6fef5e91"],"keyword":["Aged","Aspirin","Aspirin/administration & dosage","Clopidogrel","Cytochrome P-450 CYP2C8","Cytochrome P-450 CYP2C8/metabolism","Dose-Response Relationship, Drug","Drug Interactions","Female","Humans","Journal Article","Liver","Liver/metabolism","Male","Middle Aged","Paclitaxel","Paclitaxel/administration & dosage","Peripheral Nervous System Diseases","Peripheral Nervous System Diseases/chemically induced","Pharmacoepidemiology","Platelet Aggregation Inhibitors","Platelet Aggregation Inhibitors/administration & dosage","Retrospective Studies","Severity of Illness Index","Ticlopidine","Ticlopidine/administration & dosage"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-B6A816D199C66427CEEAA7DA292AAA9B"],"oai":{"class":"Blocked","mra":