{"author_count":8,"contributors":["Unbehaun, Ditte Jørgensen","Møller, Louise Abildgaard","Yde, Tanja","Markvardsen, Anne Kjøbsted","Katholm, Ida","Sørensen, Anette","Jørgensen, Signe Mygdal","Vedelø, Tina Wang"],"cuid":["S01-000.00-255857"],"event":{"end":"2023-05-27","place":"Reykjavík, is","start":"2023-05-25","title":"The 14th EANN Quadrennial Congress of the European Association of Neuroscience Nurses","year":"2023"},"filters":{"added":"2023-05","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Unbehaun, Ditte Jørgensen"],"level":"pop","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"und","rtype":["clu"],"sorti":"creating a competency development program for experienced neuro nurses","src":["au"],"src-code":["DI-U-AU"],"type":"dco","type-grp":["all","pub"]},"id":"S01-000.00-255857","ids":["au-ddac0419-539c-4f31-a8eb-4d208512931e"],"lang":"English","level":"Popular","mra":["Medical Science"],"noi":["Local-1-1-8A08608A0B877FDBB32DC277A3DF7AAA"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Public Health, Department of Public Health - Department of Science in Nursing"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Ditte Jørgensen","key":"unbehaunpau","last":"Unbehaun","name":"Unbehaun, Ditte Jørgensen","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Louise Abildgaard","key":"møllerpau","last":"Møller","locid":"f45ddbc0-e4a9-42b9-99e9-567235a67035","name":"Møller, Louise Abildgaard","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Tanja","key":"ydepau","last":"Yde","name":"Yde, Tanja","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Anne Kjøbsted","key":"markvardsenpau","last":"Markvardsen","name":"Markvardsen, Anne Kjøbsted","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Ida","key":"katholmpau","last":"Katholm","name":"Katholm, Ida","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Anette","key":"sørensenpau","last":"Sørensen","name":"Sørensen, Anette","rank":6,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Signe Mygdal","key":"jørgensenpau","last":"Jørgensen","name":"Jørgensen, Signe Mygdal","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Tina Wang","key":"vedeløpau","last":"Vedelø","locid":"fa719e97-7446-4534-9bb3-a60739cb1f3c","name":"Vedelø, Tina Wang","orcid":"0000-0001-9181-9000","rank":8,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Undetermined","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-ddac0419-539c-4f31-a8eb-4d208512931e"],"src":["AU Aarhus University"],"title":"Creating a competency development program for experienced neuro nurses","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-255857","year":"2023","yearsub":"2023"}
{"abstract":"Background: Given the importance of vaccination against severe acute respiratory syndrome coronavirus 2 (SARS-CoV-2) in the prevention of severe coronavirus disease 2019 (COVID-19), detailed long-term analyses of neutralising antibody responses are required to inform immunisation strategies. Methods: In this study, longitudinal neutralising antibody titres to an ancestral SARS-CoV-2 isolate and cross-neutralisation to delta and omicron isolates were analysed in individuals previously infected with SARS-CoV-2, vaccinated against COVID-19, or a complex mix thereof with up to two years of follow-up. Findings: Both infection-induced and vaccine-induced neutralising responses against SARS-CoV-2 appeared to follow similar decay patterns. Following vaccination in previously infected individuals, neutralising antibody responses were more durable than prior to vaccination. Further, this study shows that vaccination after infection, as well as booster vaccination, increases the cross-neutralising potential to both delta and omicron SARS-CoV-2 variants. Interpretation: Taken together, these results suggest that neither type of antigen exposure is superior for neutralising antibody durability. However, these results support vaccination to increase the durability and cross-neutralisation potential of neutralising responses, thereby enhancing protection against severe COVID-19. Funding: This work was supported by grants from The Capital Region of Denmark's Research Foundation, the Novo Nordisk Foundation, the Independent Research Fund Denmark, the Candys Foundation, and the Danish Agency for Science and Higher Education.","author_count":17,"contributors":["Underwood, Alexander P.","Sølund, Christina","Fernandez-Antunez, Carlota","Villadsen, Signe Lysemose","Mikkelsen, Lotte S.","Fahnøe, Ulrik","Bollerup, Signe","Winckelmann, Anni Assing","Schneider, Uffe Vest","Binderup, Alekxander","Vizgirda, Greta","Sørensen, Anna Louise","Vinten, Caroline Nørløv","Dalegaard, Magnus Illum","Ramirez, Santseharay","Weis, Nina","Bukh, Jens"],"cuid":["S01-000.00-429877"],"filters":{"added":"2023-05","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Covid 19","Cross neutralisation","Delta","Longitudinal","Neutralising antibody","Omicron","SARS CoV 2"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"durability and breadth of neutralisation following multiple antigen exposures to sars cov 000000000002 infection and or covid 000000000019 vaccination","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.ebiom.2023.104475","version":"Published Version"},"id":"S01-000.00-429877","identifier":[{"id":"36870117","type":"pmid"},{"id":"PMC9978324","type":"pmcid"},{"id":"85149279172","type":"scopus"}],"ids":["ku-3d027e81-676c-49f8-97bf-48b42646380b"],"keyword":["COVID-19","Cross-neutralisation","Delta","Longitudinal","Neutralising antibody","Omicron","SARS-CoV-2","Virus isolate"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-5CB66A0CD00856FE1875290FAF0E48EA"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.ebiom.2023.104475","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/340113381/1_s2.0_S2352396423000403_main.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Immunology and Microbiology, Virology"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Amager and Hvidovre"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","first":"Alexander P.","key":"underwoodpau","last":"Underwood","locid":"6bcab5f0-7463-4162-a31c-534dbb306ddb","name":"Underwood, Alexander P.","rank":1,"rolecode":"pau"},{"affno":"2","first":"Christina","key":"sølundpau","last":"Sølund","name":"Sølund, Christina","rank":2,"rolecode":"pau"},{"affno":"1","first":"Carlota","key":"fernandezantunezpau","last":"Fernandez-Antunez","locid":"e181d8b5-a5c0-4346-8817-3c02d8c8a7bd","name":"Fernandez-Antunez, Carlota","rank":3,"rolecode":"pau"},{"affno":"2","first":"Signe Lysemose","key":"villadsenpau","last":"Villadsen","name":"Villadsen, Signe Lysemose","rank":4,"rolecode":"pau"},{"affno":"2","first":"Lotte S.","key":"mikkelsenpau","last":"Mikkelsen","name":"Mikkelsen, Lotte S.","rank":5,"rolecode":"pau"},{"affno":"1","first":"Ulrik","key":"fahnøepau","last":"Fahnøe","locid":"af7d26fe-7626-47c3-8851-4c49157a2198","name":"Fahnøe, Ulrik","orcid":"0000-0002-2527-5751","rank":6,"rolecode":"pau"},{"affno":"2 1","first":"Signe","key":"bolleruppau","last":"Bollerup","locid":"d3485dd3-c29b-42d0-b988-b4dcfb0885eb","name":"Bollerup, Signe","rank":7,"rolecode":"pau"},{"affno":"1","first":"Anni Assing","key":"winckelmannpau","last":"Winckelmann","locid":"7ed79eec-0162-4a30-a993-56388e5e407d","name":"Winckelmann, Anni Assing","rank":8,"rolecode":"pau"},{"affno":"1","first":"Uffe Vest","key":"schneiderpau","last":"Schneider","locid":"fcedbbb4-7a62-4c68-ae20-2424952d916c","name":"Schneider, Uffe Vest","rank":9,"rolecode":"pau"},{"affno":"2","first":"Alekxander","key":"binderuppau","last":"Binderup","name":"Binderup, Alekxander","rank":10,"rolecode":"pau"},{"affno":"2","first":"Greta","key":"vizgirdapau","last":"Vizgirda","name":"Vizgirda, Greta","rank":11,"rolecode":"pau"},{"affno":"2","first":"Anna Louise","key":"sørensenpau","last":"Sørensen","name":"Sørensen, Anna Louise","rank":12,"rolecode":"pau"},{"affno":"2","first":"Caroline Nørløv","key":"vintenpau","last":"Vinten","name":"Vinten, Caroline Nørløv","rank":13,"rolecode":"pau"},{"affno":"2","first":"Magnus Illum","key":"dalegaardpau","last":"Dalegaard","name":"Dalegaard, Magnus Illum","rank":14,"rolecode":"pau"},{"affno":"1","first":"Santseharay","key":"ramirezpau","last":"Ramirez","locid":"ef00eba2-2eb2-46c3-8995-c5809f996734","name":"Ramirez, Santseharay","orcid":"0000-0003-3699-1814","rank":15,"rolecode":"pau"},{"affno":"1","first":"Nina","key":"weispau","last":"Weis","locid":"3a88aaad-c729-432b-b725-999664af7a45","name":"Weis, Nina","rank":16,"rolecode":"pau"},{"affno":"1","first":"Jens","key":"bukhpau","last":"Bukh","locid":"ed84ce10-678e-4b40-9651-982bf9977abc","name":"Bukh, Jens","orcid":"0000-0002-7815-4806","rank":17,"rolecode":"pau"}],"pmid":["36870117"],"pub":{"doi":"10.1016/j.ebiom.2023.104475","issn":["23523964"],"journal":"EBioMedicine","paperid":"104475","status":"p","title":"EBioMedicine","volume":"89"},"review":"Peer Reviewed","scoID":["2-s2.0-85149279172"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-3d027e81-676c-49f8-97bf-48b42646380b"],"src":["KU University of Copenhagen"],"title":"Durability and breadth of neutralisation following multiple antigen exposures to SARS-CoV-2 infection and/or COVID-19 vaccination","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-429877","year":"2023","