t":"Barletta","locid":"9662b7b8-5901-45b2-bba3-dd8e3879f864","name":"Barletta, Valentina Roberta","name_org":"Barletta, Valentina R.","orcid":"0000-0003-4427-0830","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Louise Sandberg","key":"sørensenpau","last":"Sørensen","locid":"1c6cb90f-da30-48a2-872f-a94b8100749b","name":"Sørensen, Louise Sandberg","orcid":"0000-0002-3771-4061","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Thomas","key":"naglerpau","last":"Nagler","name":"Nagler, Thomas","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jan","key":"wuitepau","last":"Wuite","name":"Wuite, Jan","rank":7,"rolecode":"pau"},{"affno":"4 5","corresponding":null,"first":"Andreas","key":"grohpau","last":"Groh","name":"Groh, Andreas","rank":8,"rolecode":"pau"},{"affno":"4 5","corresponding":null,"first":"Martin","key":"horwathpau","last":"Horwath","name":"Horwath, Martin","rank":9,"rolecode":"pau"},{"affno":"1 6","corresponding":null,"first":"Job","key":"rosierpau","last":"Rosier","name":"Rosier, Job","rank":10,"rolecode":"pau"},{"affno":"7 8","first":"Anne","key":"solgaardpau","last":"Solgaard","locid":"6170240c-85c0-40ca-b0b6-ce3c8962f9ca","name":"Solgaard, Anne Munck","name_org":"Solgaard, Anne","rank":11,"rolecode":"pau"},{"affno":"7","first":"Christine S.","key":"hvidbergpau","last":"Hvidberg","locid":"21bdf16f-aeb9-452e-bc06-56442fd393af","name":"Hvidberg, Christine S.","orcid":"0000-0002-9665-1339","rank":12,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"René","key":"forsbergpau","last":"Forsberg","locid":"be93c88f-cc39-43d8-bf6f-ff4787c55c23","name":"Forsberg, René","orcid":"0000-0002-7288-9545","rank":13,"rolecode":"pau"}],"pub":{"doi":"10.3390/rs11121407","issn":["20724292"],"issue":"12","journal":"Remote Sensing","paperid":"1407","publisher":"MDPI AG","publisher_org":"M D P I AG","status":"p","title":"Remote Sensing","volume":"11"},"review":"Peer Reviewed","scoID":["2-s2.0-85068127596"],"