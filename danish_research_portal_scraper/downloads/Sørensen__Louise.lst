GES Innovation","namevar":["SEGES"],"nora_code":"DI-PR-SEGES","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Martin Tang","key":"sørensenpau","last":"Sørensen","locid":"fefc1862-587c-4b1f-9e20-694246b18221","name":"Sørensen, Martin Tang","orcid":"0000-0002-0523-4282","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Elvira","key":"sattarovapau","last":"Sattarova","locid":"12ac237a-508c-45ed-b610-7631e73272c3","name":"Sattarova, Elvira","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anne Louise Frydendahl","key":"hellwingpau","last":"Hellwing","locid":"ad65c0e8-8a1c-4f17-bb65-80aec2189e32","name":"Hellwing, Anne Louise Frydendahl","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Per","key":"tybirkpau","last":"Tybirk","name":"Tybirk, Per","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Camilla","key":"kaaehøjgaardpau","last":"Kaae Højgaard","name":"Kaae Højgaard, Camilla","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Christian Friis","key":"børstingpau","last":"Børsting","locid":"335191b3-2ebe-47f4-b7c9-9fc3d198044e","name":"Børsting, Christian Friis","rank":6,"rolecode":"pau"}],"pub":{"pages":"36","publisher":"DCA - Nationalt Center for Fødevarer og Jordbrug","status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Private Research","Universities"],"PST":["Published"]},"sid":["au-8b6f91f6-e0e8-4030-918d-3a7460bbf449"],"src":["AU Aarhus University"],"title":"Kapitel 2 Næringsstofudskillelse fra grise, ab dyr – Normtal for husdyrgødning 2024/2025","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-772985","year":"2024","yearsub":"2024"}
{"abstract":"We explored the dietary intake and metabolic syndrome (MetS) in 85 survivors of pediatric stem cell transplantation (median age 30 years, median follow-up time 20 years). Overall, the distribution of fatty acid deviated from the recommendations with a higher intake of saturated fat and a lower intake of unsaturated fat but was comparable to that of the background population. The prevalence of MetS was 27%, corresponding to that of the elderly background population. We compared the intake of macronutrients between those with MetS and those without MetS and found that overall fat intake was higher in patients with MetS (36.7E% [range, 27.2–51.2E%] vs. 33,5E% (range, 23.4–45.1E%), P = 0.016). Within the subgroup of patients treated with total body irradiation (TBI), we found a higher fat intake in those with MetS (36.8E% (range, 27.2–51.2E%) versus 32.0E% (range, 24.6–42.1E%), P = 0.013). This was confirmed in a multivariate analysis adjusted for TBI, sex, and age at follow-up (OR 1.20 (1.06–1.39), P = 0.008). Our findings suggest that conditioning with the use of TBI may induce a state of hypersensitivity to the potentially harmful effects of fat in the diet and suggest that this risk of MetS after TBI treatment may be modifiable by dietary changes.","author_count":9,"contributors":["Pedersen, Louise Lindkvist","Gerbek, Tina","Sørum, Maria Ebbesen","Muhic, Ena","Christiansen, Terkel","Kok, Karin","Sørensen, Kaspar","Mølgaard, Christian","Müller, Klaus"],"cuid":["S01-000.00-778387"],"filters":{"added":"2025-01","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"dietary intake and risk of metabolic syndrome in long term survivors of pediatric allogeneic hematopoietic stem cell transplantation","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41409-024-02412-1","version":"Published Version"},"id":"S01-000.00-778387","identifier":[{"id":"39294427","type":"pmid"},{"id":"001315599300001","type":"wos"},{"id":"PMC11611737","type":"pmcid"},{"id":"85204220575","type":"scopus"}],"ids":["ku-90e3bedc-f965-4b41-a1fb-cec4dfdad650"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-DECE06876ED42221E89E1CF537761024"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/414156996/s41409_024_02412_1.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41409-024-02412-1","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Nutrition, Exercise and Sports, Nutrition and Health"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Louise Lindkvist","key":"pedersenpau","last":"Pedersen","name":"Pedersen, Louise Lindkvist","rank":1,"rolecode":"pau"},{"affno":"1","first":"Tina","key":"gerbekpau","last":"Gerbek","name":"Gerbek, Tina","rank":2,"rolecode":"pau"},{"affno":"1","first":"Maria Ebbesen","key":"sørumpau","last":"Sørum","name":"Sørum, Maria Ebbesen","rank":3,"rolecode":"pau"},{"affno":"1","first":"Ena","key":"muhicpau","last":"Muhic","name":"Muhic, Ena","rank":4,"rolecode":"pau"},{"affno":"1","first":"Terkel","key":"christiansenpau","last":"Christiansen","name":"Christiansen, Terkel","rank":5,"rolecode":"pau"},{"affno":"1","first":"Karin","key":"kokpau","last":"Kok","name":"Kok, Karin","rank":6,"rolecode":"pau"},{"affno":"1","first":"Kaspar","key":"sørensenpau","last":"Sørensen","name":"Sørensen, Kaspar","rank":7,"rolecode":"pau"},{"affno":"1 2","first":"Christian","key":"mølgaardpau","last":"Mølgaard","locid":"240d0bd3-4221-4d27-bfdb-8fd6887cdb30","name":"Mølgaard, Christian","orcid":"0000-0002-5311-9457","rank":8,"rolecode":"pau"},{"affno":"1 2","first":"Klaus","key":"müllerpau","last":"Müller","locid":"b909f13e-79e3-4363-aaff-e5a5ecbdf7ce","name":"Müller, Klaus","rank":9,"rolecode":"pau"}],"pmid":["39294427"],"pub":{"doi":"10.1038/s41409-024-02412-1","issn":["02683369","09513078"],"issn_org":["02683369"],"journal":"Bone Marrow Transplantation","pages":"1710-1716","status":"p","title":"Bone Marrow Transplantation","volume":"59"},"review":"Peer Reviewed","scoID":["2-s2.0-85204220575"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-90e3bedc-f965-4b41-a1fb-cec4dfdad650"],"src":["KU University of Copenhagen"],"title":"Dietary intake and risk of metabolic syndrome in long-term survivors of pediatric allogeneic hematopoietic stem cell transplantation","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-778387","year":"2024","yearsub":"2024"}
{"abstract":"In this article, I introduce the Technological Approach, as it has developed within the field of lithic analysis, and discuss its possible application in textile archaeology. The Technological Approach is based on the chaîne opératoire concept, with the goal of reconstructing a prehistoric craft process as well as its related social, cultural, and cognitive aspects. A case study from the Arctic archaeological field concerning a long and fierce discussion on threads excavated from Dorset culture contexts in Arctic eastern Canada, is presented and discussed in light of the Technological Approach. The case study demonstratse the extreme importance and powerfulness that a fibre thread can have when its technological and cultural implications are interpreted. The Technological Approach is in this case employed to systemize the arguments and analysis made, according to the chaîne opératoire of the threads, i.e., in steps from procurement of raw material to discard of the thread. With this article, I hope to enlighten the ‘Arctic thread debate’ and to inspire textile specialist to think in wider technological perspectives.","author_count":4,"contributors":["Sørensen, Mikkel"],"cuid":["S01-000.00-799581"],"filters":{"added":"2025-04","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"an arctic thread","src":["ku"],"src-code":["DI-U-KU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1484/M.NAA-EB.5.141754","version":"Published Version"},"id":"S01-000.00-799581","ids":["ku-5c77e2fe-0a23-4cff-b551-0f2af42780f9"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-384642D16DCBBBDD595EF2466825D458"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1484/M.NAA-EB.5.141754","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://curis.ku.dk/ws/files/426167121/s_rensen_2024_an_arctic_thread.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Humanities, SAXO-Institute - Archaeology, Ethnology, Greek & Latin, History"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Mikkel","key":"sørensenpau","last":"Sørensen","locid":"af0f9fdc-7d0c-4011-85af-5e35a06d1a44","name":"Sørensen, Mikkel","rank":1,"rolecode":"pau"},{"affno":"","first":"Ulla","key":"manneringpedh","last":"Mannering","name":"Mannering, Ulla","rank":2,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Marie Louise","key":"noschpedh","last":"Nosch","name":"Nosch, Marie Louise","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Anne","key":"drewsenpedh","last":"Drewsen","name":"Drewsen, Anne","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1484/m.naa-eb.5.141754","eisbn":["9782503612782"],"isbn":["9782503612775"],"pages":"61-71","place":"Turnhout, Belgium","publisher":"Brepols Publishers","status":"p","subtitle":"Collected Essays in Honour of Eva Andersson Strand","title":"The Common Thread"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-5c77e2fe-0a23-4cff-b551-0f2af42780f9"],"src":["KU University of Copenhagen"],"title":"An Arctic Thread","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-799581","year":"2024","yearsub":"2024"}
{"abstract":"Essential tremor (ET) is a prevalent neurological disorder with a largely unknown underlying biology. In this genome-wide association study meta-analysis, comprising 16,480 ET cases and 1,936,173 controls from seven datasets, we identify 12 sequence variants at 11 loci. Evaluating mRNA expression, splicing, plasma protein levels, and coding effects, we highlight seven putative causal genes at these loci, including CA3 and CPLX1. CA3 encodes Carbonic Anhydrase III and carbonic anhydrase inhibitors have been shown to decrease tremors. CPLX1, encoding Complexin-1, regulates neurotransmitter release. Through gene-set enrichment analysis, we identify a significant association with specific cell types, including dopaminergic and GABAergic neurons, as well as biological processes like Rho GTPase signaling. Genetic correlation analyses reveals a positive association between ET and Parkinson's disease, depression, and anxiety-related phenotypes. This research uncovers risk loci, enhancing our knowledge of the complex genetics of this common but poorly understood disorder, and highlights CA3 and CPLX1 as potential therapeutic targets.","author_count":74,"contributors":["Skuladottir, Astros Th.","Stefansdottir, Lilja","Halldorsson, Gisli H.","Stefansson, Olafur A.","Bjornsdottir, Anna","Jonsson, Palmi","Palmadottir, Vala","Thorgeirsson, Thorgeir E.","Walters, G. Bragi","Gisladottir, Rosa S.","Bjornsdottir, Gyda","Jonsdottir, Gudrun A.","Sulem, Patrick","Gudbjartsson, Daniel F.","Knowlton, Kirk U.","Jones, David A.","Ottas, Aigar","Esko, Tõnu","Mägi, Reedik","Nelis, Mari","Hudjashov, Georgi","Pedersen, Ole B.","Didriksen, Maria","Brunak, Søren","Banasik, Karina","Hansen, Thomas Folkmann","Erikstrup, Christian","Bay, Jakob","Boldsen, Jens Kjærgaard","Brodersen, Thorsten","Burgdorf, Kristoffer","Chalmer, Mona Ameri","Dinh, Khoa Manh","Dowsett, Joseph","Feenstra, Bjarke","Geller, Frank","Gudbjartsson, Daniel","Hindhede, Lotte","Hjalgrim, Henrik","Jacobsen, Rikke Louis