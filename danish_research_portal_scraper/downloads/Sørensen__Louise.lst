-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-3abc3f17-79ae-441d-94ef-587928511330","ku-152f5736-d036-4501-a392-22bcd3b18827"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Genome binning of viral entities from bulk metagenomics data","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-033903","year":"2022","yearsub":"2022"}
{"abstract":"Although the concept of Reconfigurable Manufacturing Systems (RMS) has reached its 20th anniversary, it has only grown in relevance. However, the principles are only applied scarcely, although industry recognize the benefits. The transition is limited by a lack of methods which support the practical design of reconfigurable and modular architectures of manufacturing systems and their constituents in brownfield contexts. To address these issues, recent research proposes to modify the Modular Function Deployment (MFD) with a revised set of drivers and tools. Therefore, this paper presents a modified MFD with value-chain considerations and supportive tools, which is validated in an industrial case.","author_count":6,"contributors":["Kjeldgaard, Stefan","Brunø, Thomas Ditlev","Andersen, Rasmus","Sorensen, Daniel G. H.","Andersen, Ann-Louise","Nielsen, Kjeld"],"cuid":["S01-000.00-103108"],"filters":{"added":"2022-07","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Concept","Modularity","Modularization","Production","Reconfigurability"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"brownfield design of reconfigurable manufacturing architectures an application of a modified mfd to the capital goods industry","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND 4.0","type":"doi","url":"https://doi.org/10.1016/j.procir.2022.05.147","version":"Published Version"},"id":"S01-000.00-103108","identifier":[{"id":"85132294659","type":"scopus"}],"ids":["aau-b6b65f8e-5d31-402e-bb7c-d0a5a491edc7"],"keyword":["Concept","Modularity","Modularization","Production","Reconfigurability"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-22D03E8584862CCF68FDEC0260C43868"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/474994627/1_s2.0_S2212827122004310_main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND 4.0","type":"doi","url":"https://doi.org/10.1016/j.procir.2022.05.147","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, Department of Materials and Production","Aalborg University, The Faculty of Engineering and Science, Department of Materials and Production, Production","Aalborg University, The Faculty of Engineering and Science, Department of Materials and Production, Sustainable Manufacturing Systems research group"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Stefan","key":"kjeldgaardstefanpau","last":"Kjeldgaard","locid":"984795eb-a4a3-4588-8ea7-78be301f33a2","name":"Kjeldgaard, Stefan","orcid":"0000-0002-5481-884X","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Thomas Ditlev","key":"brunøthomasditlevpau","last":"Brunø","locid":"b75a6b6d-0181-4141-b951-6f7f70bae83f","name":"Brunø, Thomas Ditlev","orcid":"0000-0002-9847-6562","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rasmus","key":"andersenrasmuspau","last":"Andersen","locid":"f58ca152-a726-42a3-8424-415c4fdf5c0a","name":"Andersen, Rasmus","orcid":"0000-0001-6788-8217","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Daniel G. H.","key":"sorensendanielghpau","last":"Sorensen","locid":"7c8e8d62-a3ee-4398-8d8a-c4c514667546","name":"Sorensen, Daniel G. H.","orcid":"0000-0001-9395-2411","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ann-Louise","key":"andersenannlouisepau","last":"Andersen","locid":"73d5c9b6-ff83-41c1-b16e-43f380f384d9","name":"Andersen, Ann-Louise","orcid":"0000-0002-7923-6301","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kjeld","key":"nielsenkjeldpau","last":"Nielsen","locid":"ffae8343-8516-499e-89a3-2f0d6179a5fc","name":"Nielsen, Kjeld","orcid":"0000-0002-3720-167X","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.procir.2022.05.147","issn":["22128271"],"journal":"Procedia CIRP","pages":"1293-1298","publisher":"Elsevier","status":"p","title":"Procedia CIRP","volume":"107"},"review":"Peer Reviewed","scoID":["2-s2.0-85132294659"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-b6b65f8e-5d31-402e-bb7c-d0a5a491edc7"],"src":["AAU Aalborg University"],"title":"Brownfield Design of Reconfigurable Manufacturing Architectures : An Application of a Modified MFD to the Capital Goods Industry","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-103108","year":"2022","yearsub":"2022"}
{"abstract":"Importance: Increasing detection of early-stage papillary thyroid neoplasms without improvements in mortality has prompted development of strategies to prevent or mitigate overtreatment. Objective: To determine adoption rates of 2 recent strategies developed to limit overtreatment of low-risk thyroid cancers: (1) a new classification, noninvasive follicular thyroid neoplasm with papillarylike nuclear features (NIFTP), and (2) hemithyroidectomy for selected papillary thyroid carcinomas (PTCs) up to 4 cm in size. Design, Setting, and Participants: This is a cross-sectional analysis of 3368 pathology records of 2 cohorts of patients from 18 hospitals in 6 countries during 2 time periods (2015 and 2019). Participating hospitals were included from the US (n = 12), Canada (n = 2), Denmark (n = 1), South Korea (n = 1), South Africa (n = 1), and India (n = 1). The records of the first 100 patients per institution for each year who underwent thyroid-directed surgery (hemithyroidectomy, total thyroidectomy, or completion thyroidectomy) were reviewed. Main Outcomes and Measures: Frequency of diagnosis of NIFTP, PTCs, and thyroidectomies during the study period. Results: Of the 790 papillary thyroid neoplasms captured in the 2019 cohort, 38 (4.8%) were diagnosed as NIFTP. Diagnosis of NIFTP was observed in the US, South Africa, and India. There was minimal difference in the total proportion of PTCs in the 2015 cohort compared with the 2019 cohort (778 [47.1%] vs 752 [44.5%]; difference, 2.6% [95% CI, -16.9% to 22.1%]). The proportion of PTCs eligible for hemithyroidectomy but treated with total thyroidectomy in the 2 cohorts demonstrated a decreasing trend from 2015 to 2019 (341 of 453 [75.3%] vs 253 of 434 [58.3%]; difference, 17.0% [95% CI, -1.2% to 35.2%]). Conclusions and Relevance: Results of this cohort study showed that the 2 mitigation strategies for preventing overtreatment of early-stage thyroid cancer have had mixed success. The diagnosis of NIFTP has only been applied to a small proportion of thyroid neoplasms compared with expected rates. However, more patients eligible for hemithyroidectomy received it in 2019 compared with 2015, showing some success with this deescalation strategy.","author_count":34,"contributors":["Caulley, Lisa","Eskander, Antoine","Yang, Weining","Auh, Edel","Cairncross, Lydia","Cho, Nancy L","Golbon, Bahar","Iyer, Subramania","Liu, Jeffrey C","Lee, Paul J","Lindeman, Brenessa","Meltzer, Charles","Molin, Nicole","Moore, Alessandra","Noel, Julia","Nozolino, Halie","Pasternak, Jesse","Price, Brendon","Ramsay, Tim","Rolighed, Lars","Sajisevi, Mirabelle","Sharma, Arun","Sinclair, Catherine","Sorensen, Meredith","Tae, Kyung","Tang, Alice L","Tsao, Gabriel","Williams, Michelle","Wrenn, Sean","Xing, Monica H","Zafereo, Mark","Stack, Brendan C","Randolph, Greg","Davies, Louise"],"cuid":["S01-000.00-155880"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Africa","America, North","Asia, East","Asia, South","OECD"],"country":["Canada","India","South Africa","South Korea","United States"],"glorg":["All Global Affiliations","Amrita Vishwa Vidyapeetham","Darthmouth College","Dartmouth-Hitchcock Clinic","Fox Chase Cancer Center","Hanyang University","Harvard University","Ottawa Hopsital","Samuel Lunenfeld Research Institute, Mount Sinai Hospital, Toronto","Southern Illinois University","Stanford University","Temple University","University of Alabama at Birmingham","University of Cape Town","University of Cincinnati","University of Houston","University of Ottawa","University of Texas MD Anderson Cancer Center","University of Vermont"],"keyword":["Age","Cancer incidence","Carcinoma","Lymph node metastasis","Management","Task force","United States","Variant","nodules"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U"