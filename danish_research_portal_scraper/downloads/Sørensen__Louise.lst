":["2-s2.0-84984823934"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-c560aa4e-3190-4779-ab4c-b80cd0d85eae","dtu-4defe94e-55a7-45c2-9072-1c68c0464d4c","ku-a04588e5-6ab8-4eb8-94fd-e7c7fc7c2a93"],"src":["AU Aarhus University","DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Normal weight children have higher cognitive performance – Independent of physical activity, sleep, and diet","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-097.68-026976","year":"2016","yearsub":"2016"}
{"abstract":"Ved AU, Foulum har vi gennemført et forsøg med to niveauer af protein og to niveauer af fedt i foderet til kvier i aldersintervallet 6-13 måneder. Såvel protein- som fedtniveauet er ændret samtidig i rationen. Formålet var at undersøge, dels om kvierne ved en sådan fodringspraksis kan bibeholde deres ydelsespotentiale, dels at undersøge, om forbruget af foderprotein kan sænkes, og om tilsætning af fedt til foderet kan reducere emissionen af metan. Den forskellige fodring i forsøgsperioden fra ca. 6 til 13-månedersalderen gav en lavere tilvækst for kvierne på lavt proteinniveau, men påvirkede ikke den senere mælkeydelse. Dette resultat tyder på, at både proteinforsyningen og kviernes tilvækst kan være relativ lav i denne periode, uden at det påvirker den senere mælkeydelse. Vi anser det dog for sandsynligt, at dette resultat er afhængig af, at kvierne i den efterfølgende periode fra 13 måneder og op til kælvning havde mulighed for at nå en normal vægt ved kælvning. Resultaterne tyder på, at metanemissionen fra kvieopdræt kan reduceres med tilskud af fedt. Ligeledes viser vores resultater, at proteinniveauet i foderret til kvier kan være relativt lavt – i hvert fald i perioder – uden at det går ud over den senere mælkeydelse, og at det samlede forbrug af protein kan reduceres.","author_count":7,"contributors":["Sørensen, Martin Tang","Hellwing, Anne Louise Frydendahl","Sørensen, Pia","Lund, Peter","Weisbjerg, Martin Riis","Vestergaard, Mogens"],"cuid":["S01-000.00-146329"],"event":{"end":"2015-04-23","place":"Foulum, dk","start":"2015-04-23","title":"Temamøde: Malkekoens ernæring","year":"2015"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"pop","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"und","rtype":["clu"],"sorti":"miljøvenlige fodringsstrategier kvier","src":["au"],"src-code":["DI-U-AU"],"type":"dra","type-grp":["all","pub"]},"id":"S01-000.00-146329","ids":["au-1dafa40c-56f9-47f5-b72c-b3c82b763e13"],"lang":"Danish","level":"Popular","mra":["Science/Technology"],"noi":["Local-1-1-929BCF17F449101FBE532158BB8C3F27"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Animal and Veterinary Sciences, Department of Animal and Veterinary Sciences - Integrative physiology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Martin Tang","key":"sørensenmartintangpau","last":"Sørensen","locid":"fefc1862-587c-4b1f-9e20-694246b18221","name":"Sørensen, Martin Tang","orcid":"0000-0002-0523-4282","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anne Louise Frydendahl","key":"hellwingannelouisefrydendahlpau","last":"Hellwing","locid":"ad65c0e8-8a1c-4f17-bb65-80aec2189e32","name":"Hellwing, Anne Louise Frydendahl","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Pia","key":"sørensenpiapau","last":"Sørensen","name":"Sørensen, Pia","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Peter","key":"lundpeterpau","last":"Lund","locid":"c933cda2-363e-4cb6-b596-3df7ef3d30ed","name":"Lund, Peter","orcid":"0000-0002-9113-4500","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Martin Riis","key":"weisbjergmartinriispau","last":"Weisbjerg","locid":"501c877c-de2b-4cd2-9f3c-42e223238a40","name":"Weisbjerg, Martin Riis","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mogens","key":"vestergaardmogenspau","last":"Vestergaard","locid":"f886731d-42d7-485e-b44c-f48981a245e7","name":"Vestergaard, Mogens","orcid":"0000-0002-3630-1396","rank":6,"rolecode":"pau"},{"affno":"","first":"Peter","key":"lundpeterpedh","last":"Lund","name":"Lund, Peter","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["9788793176737"],"pages":"19-25","publisher":"DCA - Nationalt Center for Fødevarer og Jordbrug","status":"p","subtitle":"- Fodringsstrategier målrettet produktivitet og miljøhensyn","title":"Malkekoens ernæring","volume":"60"},"review":"Undetermined","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-1dafa40c-56f9-47f5-b72c-b3c82b763e13"],"src":["AU Aarhus University"],"title":"Miljøvenlige fodringsstrategier - kvier","type":"Report Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-146329","year":"2015","yearsub":"2015"}
{"abstract":"This report outlines the airborne field operations with the ESA airborne Ku‐band interferometric radar (ASIRAS), coincident airborne laser scanner (ALS) and vertical photography to acquire data over sea‐ and land ice along validation sites and CryoSat‐2 ground tracks. The airborne campaign was coordinated by DTU Space using the Norlandair Twin Otter (TF‐POF). The campaign consisted of two experiment periods: Mid‐march to early April and late April to mid‐May with focus on sea ice and land ice, respectively. The sea ice measurements covered several validation sites with sea ice camps located in the Beaufort Sea lead by US office of Naval Research (ONR) and north of Greenland as a dedicated ESA CryoVEx initiative. In addition, selected CryoSat‐2 ground tracks were under‐flown in the Lincoln Sea from CFS Alert, North of Greenland and Svalbard from St. Nord and Longyearbyen. Several of the flights in the Beaufort and Lincoln Sea were coordinated with Uni. of York (UY) lead Basler aircraft towing an electromagnetic (AEM/EM bird) sounder to obtain sea ice thickness and Operation IceBridge (OIB) NASA P‐3 carrying a variety of instruments for sea ice and snow retrievals. Land ice measurements were acquired over the Greenland ice sheet (the EGIG line and selected CryoSat‐ 2 ground tracks), together with Austfonna and Devon ice caps. At Austfonna and Devon ice caps ground teams measured ice and snow properties, and raised corner reflectors acting as a surface reference point in order to estimate the penetration depth of the ASIRAS radar. An opportunity site on the Greenland Ice Sheet was surveyed near Jakobshavn Isbræ. No other ground experiments were coordinated with the CryoVEx campaing on the Greenland Ice Sheet. The CryoVEx 2014 campaign was a success and the processed data is of high quality. The data set includes 13 CryoSat underflights covering distances from 25‐560 km. The preliminary comparisons to CryoSat‐2 data show the potential of the extensive dataset.","author_count":8,"contributors":["Hvidegaard, Sine Munk","Nielsen, Jens Emil","Sørensen, Louise Sandberg","Simonsen, Sebastian Bjerregaard","Skourup, Henriette","Forsberg, René","Helm, V.","Bjerg, T."],"cuid":["S01-000.00-316989"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["Alfred Wegener Institute - Helmholtz Centre for Polar and Marine Research","All Global Affiliations"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"esa cryovex 000000002014 airborne asiras radar and laser scanner measurements during 000000002014 cryovex campaign in the arctic","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/119696070/CryoVEx2014_final_report_DTUprint_20160104.pdf","version":"Published Version"},"id":"S01-000.00-316989","ids":["dtu-29c52c0b-3c4d-4836-a022-b4b33706e03d"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-24CE1897335EC7E8C4FD988970FB6094"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/119696070/CryoVEx2014_final_report_DTUprint_20160104.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Space Institute","Technical University of Denmark, National Space Institute, Geodynamics"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"de","key":"alfred wegener institute helmholtz centre for polar and marine research","loc":["Germany","Europe, EU","OECD"],"name":"Alfred Wegener Institute - Helmholtz Centre for Polar and Marine Research","used":1}],"person":[{"affno":"1","corresponding":null,"first":"S. M.","key":"hvidegaardpau","last":"Hvidegaard","locid":"92b07d8f-692c-4ebb-bc40-f44224f3f143","name":"Hvidegaard, Sine Munk","name_org":"Hvidegaard, S. M.","orcid":"0000-0001-8159-6499","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"J. E.","key":"nielsenpau","last":"Nielsen","locid":"c1ed0703-31fb-4d2b-8c22-eb1566cb603f","name":"Nielsen, Jens Emil","name_org":"Nielsen, J. E.","orcid":"0000-0001-8422-6901","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"L. Sandberg","key":"sørensenpau","last":"Sørensen","locid":"1c6cb90f-da30-48a2-872f-a94b8100749b","name":"Sørensen, Louise Sandberg","name_org":"Sørensen, L. Sandberg","orcid":"0000-0002-3771-4061","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"S. B.","key":"simonsenpau","last":"Simonsen","locid":"d088b945-224e-4fd3-a871-022cc71c5cb1","name":"Simonsen, Sebastian Bjerregaard","name_org":"Simonsen, S. B.","orcid":"0000-0001-9569-1294","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"H.","key":"skouruppau","last":"Skourup","locid":"f5fe613f-20e5-4a69-9eff-f03779801182","name":"Skourup, Henriette","name_org":"Skourup, H.","orcid":"0000-0002-4468-8033","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"R.","key":"forsbergpau","last":"Forsberg","locid":"be93c88f-cc39-43d8-bf6f-ff4787c55c23","name":"Forsberg, René","name_org":"Forsberg, R.","orcid":"0000-0002-7288-9545","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"V.","key":"helmpau","last":"Helm","name":"Helm, V.","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"T.","key":"bjergpau","last":"Bjerg","name":"Bjerg, T.","rank":8,"rolecode":"pau"}],"pub":{"isbn":["978‐87‐91694‐26‐4"],"pages":"166","publisher":"Technical University of Denmark","status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-29c52c0b-3c4d-4836-a022-b4b33706e03d"],"src":["DTU Technical University of Denmark"],"title":"ESA CryoVEx 2014 - Airborne ASIRAS radar and laser scanner measurements during 2014 CryoVEx campaign in the Arctic","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-316989","year":"2015","yearsub":"2015"}
{"abstract":"We studied the diffusion of particles in the highly irregular pore networks of chalk, a very fine-grained rock, by combining three-dimensional X-ray imaging and dissipative particle dynamics (DPD) simulations. X-ray imaging data were collected at 25 nm voxel dimension for two chalk samples with very different porosities (4% and 26%). The three-dimensional pore systems derived from the tomograms were imported into DPD simulations and filled with spherical particles of variable diameter and with an optional attractive interaction to the pore surfaces. We found that diffusion significantly decreased to as much as 60% when particle size increased from 1% to 35% of the average pore diameter. When particles were attracted to the pore surfaces, even very small particles, diffusion was drastically inhibited, by as much as a factor of 100. Thus, the size of particles and their interaction with the pore surface strongly influence particle mobility and must be taken into account for predicting permeability in nanoporous rocks from primary petrophysical parameters such as surface area, porosity, and tortuosity.","author_count":4,"contributors":["Müter, Dirk","Sørensen, Henning Osholm","Bock, H.","Stipp, Susan Louise Svane"],"cuid":["S01-000.00-433285"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","Heriot-Watt University"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"particle diffusion in complex nanoscale pore networks","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"http://pubs.acs.org/userimages/ContentEditor/1285231362937/jpa_user_guide.pdf","type":"loc","url":"https://curis.ku.dk/ws/files/167889174/Mueter_Particle_Diffusion_in_Complex_Nanoscale_Pore_Networks_ver251114.pdf","version":"Authors Final Version"},"id":"S01-000.00-433285","identifier":[{"id":"84929359233","type":"scopus"}],"ids":["ku-42b5beda-5d0e-4bdd-8798-63dcc9ab0dd8"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-7C33F3E892BC9007498E2959544768A4"],"oa_link":[{"access":"oa","license":"http://pubs.acs.org/userimages/ContentEditor/1285231362937/jpa_user_guide.pdf","type":"loc","url":"https://curis.ku.dk/ws/files/167889174/Mueter_Particle_Diffusion_in_Complex_Nanoscale_Pore_Networks_ver251114.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Chemistry, Department of Chemistry"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"gb","key":"heriot watt university","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Heriot-Watt University","used":1}],"person":[{"affno":"1","first":"Dirk","key":"müterpau","last":"Müter","locid":"76c859c0-2a33-42c0-9933-0cab85960fbc","name":"Müter, Dirk","rank":1,"rolecode":"pau"},{"affno":"1","first":"Henning Osholm","key":"sørensenpau","last":"Sørensen","locid":"e1bf7bae-7f0e-445e-99ea-12eb242407fb","name":"Sørensen, Henning Osholm","orcid":"0000-0002-7004-547X","rank":2,"rolecode":"pau"},{"affno":"2","first":"H.","key":"bockpau","last":"Bock","name":"Bock, H.","rank":3,"rolecode":"pau"},{"affno":"1","first":"Susan Louise Svane","key":"stipppau","last":"Stipp","locid":"b907e7ef-d26a-4093-836b-9b7c9238d956","name":"Stipp, Susan Louise Svane","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1021/jp5117867","issn":["19327447","19327455"],"issn_org":["19327447"],"issue":"19","journal":"Journal of Physical Chemistry C","pages":"10329-10335","status":"p","title":"Journal of Physical Chemistry C","volume":"119"},"review":"Peer Reviewed","scoID":["2-s2.0-84929359233"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-42b5beda-5d0e-4bdd-8798-63dcc9ab0dd8"],"src":["KU University of Copenhagen"],"title":"Particle diffusion in complex nanoscale pore networks","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-433285","year":"2015","yearsub":"2015"}
{"abstract":"Emerging evidence has shown that adipose tissue is the richest and most accessible source of mesenchymal stem cells. Many different therapies for chronic wounds exist with varying success rates. The capacity of adipose-derived stem cells (ASCs) to promote angiogenesis, secrete growth factors, regulate the inflammatory process, and differentiate into multiple cell types makes them a potential ideal therapy for chronic wounds. The aim of this article was to review all preclinical trials using ASCs in problem wound models. A systematic search was performed and 12 studies were found where different chronic wound models across different animals were treated with ASCs. Different ASC sources and delivery methods were used in the described studies. Studies demonstrated improved wound healing with utilization of ASC, and this treatment modality has so far shown great potential. However, more preclinical studies and large-scale clinical trials are needed to show if the emerging therapy can satisfy expectations.","author_count":4,"contributors":["Toyserkani, Navid Mohamadpour","Quaade, Marlene Louise","Sheikh, Søren Paludan","Sørensen, Jens Ahm"],"cuid":["S01-000.00-603862"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Adipose derived stem cells","Humans","Preclinical research","Regenerative medicine","Stem Cell Transplantation","Tissue engineering","Wound Healing"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"adipose derived stem cells new treatment for wound healing","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1097/SAP.0000000000000083","version":"Other Version"},"id":"S01-000.00-603862","identifier":[{"id":"84932193523","type":"scopus"},{"id":"24691309","type":"pmid"}],"ids":["sdu-6b4e9fc1-7e96-465d-b48b-cc341bdd2ce5"],"keyword":["Adipocytes/transplantation","Humans","Stem Cell Transplantation","adipose-derived stem cells","preclinical research","regenerative medicine","tissue engineering","wound healing"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-558D2A64227E9E9D6559AB0BA99D9B8C"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1097/SAP.0000000000000083","version":"Other Version"}],"oai":{"class":"Blocked","mra":["Medicine (MED)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Plastic Surgery (Odense)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Navid Mohamadpour","key":"toyserkanipau","last":"Toyserkani","locid":"1fe54f0a-4c69-467e-8d39-62f685e36625","name":"Toyserkani, Navid Mohamadpour","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Marlene Louise","key":"quaadepau","last":"Quaade","locid":"365d389f-829a-4a48-b078-7acdfa2caeb7","name":"Quaade, Marlene Louise","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren Paludan","key":"sheikhpau","last":"Sheikh","locid":"5773a0d9-ed2e-4bd4-8232-b68ee8d6cb09","name":"Sheikh, Søren Paludan","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens Ahm","key":"sørensenpau","last":"Sørensen","locid":"267cd59a-3918-47db-8d23-54015d770b6c","name":"Sørensen, Jens Ahm","orcid":"0000-0003-4903-0094","rank":4,"rolecode":"pau"}],"pmid":["24691309"],"pub":{"doi":"10.1097/sap.0000000000000083","issn":