{"abstract":"Daylight provides us with an understanding of where we are on Earth and of the spaces, we find ourselves in every day. Daylight has a positive impact on our well-being, and we learn and live better in spaces filled with natural light.","author_count":3,"contributors":["Grønlund, Louise","Mathiasen, Nanet","Sørensen, Pernille"],"cuid":["S01-000.00-706414"],"filters":{"added":"2024-02","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Daylight","Daylight Pavillion"],"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-ART","DI-U"],"level3":{"ART":["DI-ART-ALL","DI-ART-RDKA"],"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-ART-RDKA","DI-U-AAU"]},"review":"nr","rtype":["clu"],"sorti":"poetic daylight pavillon","src":["arkc"],"src-code":["DI-ART-RDKA"],"type":"doi","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://www.daylightandarchitecture.com/news/poetic-daylight-pavilion/","version":"Published Version"},"id":"S01-000.00-706414","ids":["arkc-89a2f876-4206-455a-ae1e-2d41b7b1a50a"],"keyword":["Daylight","Daylight Pavillion","Nej"],"lang":"Danish","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-B71EBFB1F1456C729EBE6DFBAD3A73E2"],"oa_link":[{"access":"oa","type":"rem","url":"https://www.daylightandarchitecture.com/news/poetic-daylight-pavilion/","version":"Published Version"}],"org":[{"affno":"1","key":"royal danish academy architecture design conservation","l2":"DI-ART","l2n":"Artistic Higher Education Institutions","l3":"DI-ART-RDKA","l3nn":"Royal Danish Academy - Architecture, Design, Conservation","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Royal Danish Academy - Architecture, Design, Conservation","namevar":["Royal Danish Academy - Architecture, Design, Conservation","Royal Danish Academy - Architecture, Design, Conservation, Center for Interior Studies","Royal Danish Academy - Architecture, Design, Conservation,