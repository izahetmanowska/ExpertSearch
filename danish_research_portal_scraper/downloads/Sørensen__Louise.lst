,{"affno":"1","corresponding":null,"first":"Christine","key":"mordhorstpau","last":"Mordhorst","name":"Mordhorst, Christine","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Helene","key":"stampepau","last":"Stampe","name":"Stampe, Helene","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jens","key":"kastruppau","last":"Kastrup","name":"Kastrup, Jens","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Annette","key":"ekblondpau","last":"Ekblond","name":"Ekblond, Annette","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mandana","key":"haacksørensenpau","last":"Haack-Sørensen","name":"Haack-Sørensen, Mandana","rank":12,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Mohammad","key":"farhadipau","last":"Farhadi","name":"Farhadi, Mohammad","rank":13,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christian","key":"maarepau","last":"Maare","name":"Maare, Christian","rank":14,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jeppe","key":"friborgpau","last":"Friborg","name":"Friborg, Jeppe","rank":15,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Charlotte D.","key":"lynggaardpau","last":"Lynggaard","name":"Lynggaard, Charlotte D.","rank":16,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anne Werner","key":"haugepau","last":"Hauge","name":"Hauge, Anne Werner","rank":17,"rolecode":"pau"},{"affno":"3 1","corresponding":null,"first":"Robin","key":"christensenpau","last":"Christensen","locid":"04bf2bf9-a6d8-4be8-93fd-82f3f2ddc9ba","name":"Christensen, Robin","orcid":"0000-0002-6600-0631","rank":18,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christian","key":"grønhøjpau","last":"Grønhøj","name":"Grønhøj, Christian","rank":19,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christian","key":"vonbuchwaldpau","last":"von Buchwald","name":"von Buchwald, Christian","rank":20,"rolecode":"pau"}],"pmid":["38441659"],"pub":{"doi":"10.1158/1078-0432.ccr-23-3675","issn":["10780432","15573265"],"issn_org":["10780432"],"issue":"10","journal":"Clinical Cancer Research","pages":"2078-2084","publisher":"American Association for Cancer Research Inc.","status":"p","title":"Clinical Cancer Research","volume":"30"},"review":"Peer Reviewed","scoID":["2-s2.0-85193249433"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region Zealand","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-42b5c331-ec26-4e84-9b9e-843091514b56"],"src":["SDU University of Southern Denmark"],"title":"Mesenchymal Stem/Stromal Cell Therapy for Radiation-Induced Xerostomia in Previous Head and Neck Cancer Patients : A Phase II Randomized, Placebo-Controlled Trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-750377","year":"2024","yearsub":"2024"}
{"abstract":"Background: Blood levels of N-terminal pro-B-type natriuretic peptide (NT-proBNP) has been suggested as a future guidance tool for the selection of patients for aortic valve replacement. This study aimed to examine how levels of NT-proBNP pre-transcatheter aortic valve implantation (TAVI) is associated with one-year rates of heart failure (HF) admission and mortality following TAVI. Methods: With Danish nationwide registries, we identified all patients undergoing TAVI from 2014 to 2021 who had at least one recorded NT-pro-BNP measurement within one year before TAVI. Patients were compared by quartiles of pre-TAVI NT-proBNP: quartile 4 (high NT-proBNP group) vs quartile 1–3 (low NT-proBNP group). Comparisons of all-cause mortality and HF-admissions were conducted using Kaplan-Meier analysis, cumulative incidence, and Cox analysis, as appropriate. Results: We identified 1,140 patients undergoing first-time TAVI with a recorded NT-pro-BNP; 846 (74.2 %) with a low NT-proBNP (<420 pmol/L) (55.0 % male, median age 81 year) and 294 (25.8 %) with a high NT-proBNP (≥420 pmol/L) (53.1 % male, median age 82 year). A high versus low NT-proBNP was associated with increased one-year cumulative incidence of HF-admissions (9.1 % vs. 23.1 %, adjusted HR 2.00 [95 % CI, 1.40–2.85]) and all-cause mortality (6.0 % vs. 14.6 %, adjusted HR 1.95 [95 % CI: 1.24–3.07]). A high NT-proBNP was associated with higher rates of outcomes irrespective of previously known atrial fibrillation, HF, chronic kidney disease, and hypertension. Conclusion: In patients undergoing TAVI, a baseline NT-proBNP ≥ 420 pmol/L was associated with increased one-year rates of HF-admission and mortality post-TAVI and may be utilized to identify a high-risk population.","author_count":9,"contributors":["Marqvard Sørensen, Louise","Kofoed Petersen, Jeppe","Emanuel Strange, Jarl","Østergaard, Lauge","Møller, Jacob Eifer","Schou, Morten","Køber, Lars","de Backer, Ole","Fosbøl, Emil"],"cuid":["S01-000.00-751039"],"filters":{"added":"2024-08","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Marqvard Sørensen, Louise"],"keyword":["Aortic stenosis","Aortic valve replacement","Implantation","N terminal pro B type natriuretic peptide","NT proBNP","TAVI","Transcatheter aortic valve"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"n terminal pro b type natriuretic peptide levels pre transcatheter aortic valve implantation and relationship with long term outcomes","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.ijcha.2024.101423","version":"Published Version"},"id":"S01-000.00-751039","identifier":[{"id":"PMC11112331","type":"pmcid"},{"id":"38784048","type":"pmid"},{"id":"85192778943","type":"scopus"}],"ids":["sdu-e0feaa51-8260-4ab3-9691-04e61ccf621f"],"keyword":["Aortic Stenosis","Aortic Valve Replacement","Implantation","N-Terminal Pro-B-Type Natriuretic Peptide","NT-proBNP","TAVI","Transcatheter Aortic Valve"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-53DEBD717A2451D228CCA27B163A9499"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.ijcha.2024.101423","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/263040310/1-s2.0-S2352906724000897-main.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Cardiology (Odense)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Louise","key":"marqvardsørensenpau","last":"Marqvard Sørensen","name":"Marqvard Sørensen, Louise","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jeppe","key":"kofoedpetersenpau","last":"Kofoed Petersen","name":"Kofoed Petersen, Jeppe","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jarl","key":"emanuelstrangepau","last":"Emanuel Strange","name":"Emanuel Strange, Jarl","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lauge","key":"østergaardpau","last":"Østergaard","name":"Østergaard, Lauge","rank":4,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Jacob","key":"eifermøllerpau","last":"Eifer Møller","locid":"5e4d3cb6-b0a0-4541-aea1-30e73f7c10b8","name":"Møller, Jacob Eifer","name_org":"Eifer Møller, Jacob","orcid":"0000-0003-2873-5845","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Morten","key":"schoupau","last":"Schou","name":"Schou, Morten","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lars","key":"køberpau","last":"Køber","name":"Køber, Lars","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ole","key":"debackerpau","last":"de Backer","name":"de Backer, Ole","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Emil","key":"fosbølpau","last":"Fosbøl","name":"Fosbøl, Emil","rank":9,"rolecode":"pau"}],"pmid":["38784048"],"pub":{"doi":"10.1016/j.ijcha.2024.101423","issn":["23529067"],"journal":"IJC Heart and Vasculature","paperid":"101423","publisher":"Elsevier","status":"p","title":"IJC Heart and Vasculature","title_org":"IJC Heart & Vasculature","volume":"52"},"review":"Peer Reviewed","scoID":["2-s2.0-85192778943"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-e0feaa51-8260-4ab3-9691-04e61ccf621f"],"src":["SDU University of Southern Denmark"],"title":"N-terminal pro-B-type natriuretic peptide levels pre-transcatheter aortic valve implantation and relationship with long-term outcomes","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-751039","year":"2024","yearsub":"2024"}
{"abstract":"Background: Comorbidity with type 2 diabetes (T2D) results in worsening of cancer-specific and overall prognosis in colorectal cancer (CRC) patients. The treatment of CRC per se may be diabetogenic. We assessed the impact of different types of surgical cancer resections and oncological treatment on risk of T2D development in CRC patients. Methods: We developed a population-based cohort study including all Danish CRC patients, who had undergone CRC surgery between 2001 and 2018. Using nationwide register data, we identified and followed patients from date of surgery and until new onset of T2D, death, or end of follow-up. Results: In total, 46,373 CRC patients were included and divided into six groups according to type of surgical resection: 10,566 Right-No-Chemo (23%), 4645 Right-Chemo (10%), 10,151 Left-No-Chemo (22%), 5257 Left-Chemo (11%), 9618 Rectal-No-Chemo (21%), and 6136 Rectal-Chemo (13%). During 245,466 person-years of follow-up, 2556 patients developed T2D. The incidence rate (IR) of T2D was highest in the Left-Chemo group 11.3 (95% CI: 10.4–12.2) per 1000 person-years and lowest in the Rectal-No-Chemo group 9.6 (95% CI: 8.8–10.4). Between-group unadjusted hazard ratio (HR) of developing T2D was similar and non-significant. In the adjusted analysis, Rectal-No-Chemo was associated with lower T2D risk (HR 0.86 [95% CI 0.75–0.98]) compared to Right-No-Chemo. For all six groups, an increased level of body mass index (BMI) resulted in a nearly twofold increased risk of developing T2D. Conclusions: This study suggests that postoperative T2D screening should be prioritised in CRC survivors with overweight/obesity regardless of type of CRC treatment applied.","author_count":8,"contributors":["Krag, Caroline","Svane, Maria Saur","Madsbad, Sten","Graversen, Susanne Boel","Christensen, Jesper Frank","Sørensen, Thorkild IA","Lehrskov, Louise Lang","Laurberg, Tinne"],"cuid":["S01-000.00-755491"],"filters":{"added":"2024-09","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Lehrskov, Louise Lang"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"the impact of surgery and oncological treatment on risk of type 000000000002 diabetes onset in patients with colorectal cancer nationwide cohort study in denmark","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.7554/elife.89354.3","version":"Published Version"},"funding_acknowledgement":["The Novo Nordisk Foundation (NNF17SA0031406); TrygFonden (101390; 20045; 125132)."],"id":"S01-000.00-755491","ids":["sdu-a157fe41-1a91-40c0-9ea6-a171e8f02c13"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-4-7-AB9D5D6DC4AA5E65B014C9A02565978A"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.7554/elife.89354.3","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/268607056/elife-89354-v1.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital","Hvidovre Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1},{"affno":"3","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics","SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics, Research Unit of Exercise Epidemiology"],"nora_code":"DI-U-SDU","used":1},{"affno":"4","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Caroline","key":"kragpau","last":"Krag","name":"Krag, Caroline","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Maria Saur","key":"svanepau","last":"Svane","name":"Svane, Maria Saur","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sten","key":"madsbadpau","last":"Madsbad","name":"Madsbad, Sten","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Susanne Boel","key":"graversenpau","last":"Graversen","name":"Graversen, Susanne Boel","rank":4,"rolecode":"pau"},{"affno":"3 1","corresponding":null,"first":"Jesper Frank","key":"christensenpau","last":"Christensen","locid":"ef881205-87ea-4b8f-bee3-f5c75c44e18d","name":"Christensen, Jesper Frank","orcid":"0000-0003-4858-1505","rank":5,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Thorkild IA","key":"sørensenpau","last":"Sørensen","name":"Sørensen, Thorkild IA","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Louise Lang","key":"lehrskovpau","last":"Lehrskov","name":"Lehrskov, Louise Lang","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Tinne","key":"laurbergpau","last":"Laurberg","name":"Laurberg, Tinne","rank":8,"rolecode":"pau"}],"pub":{"doi":"10.7554/elife.89354.3","issn":["2050084X"],"journal":"eLife","paperid":"RP89354","publisher":"eLife Sciences Publications","status":"p","title":"eLife","volume":"12"},"review":"Peer Reviewed","scoID":["2-s2.0-85195905395"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-a157fe41-1a91-40c0-9ea6-a171e8f02c13"],"src":["SDU University of Southern Denmark"],"title":"The impact of surgery and oncological treatment on risk of type 2 diabetes onset in patients with colorectal cancer: nationwide cohort study in Denmark","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-755491","year":"2024","yearsub":"2024"}
{"abstract":"Chronic pain is a complex, debilitating, and escalating health problem worldwide, impacting 1 in 5 adults. Current treatment is compromised by dose-limiting side effects, including high abuse liability, loss of ability to function socially and professionally, fatigue, drowsiness, and apathy. PICK1 has emerged as a promising target for the treatment of chronic pain conditions. Here, we developed and characterized a cell-permeable fatty acid–conjugated bivalent peptide inhibitor of PICK1 and assessed its effects on acute and chronic pain. The myristoylated PICK1 inhibitor, myr-NPEG4-(HWLKV)2 (mPD5), self-assembled into core-shell micelles that provided favorable pharmacodynamic properties and relieved evoked mechanical and thermal hypersensitivity as well as ongoing hypersensitivity and anxiodepressive symptoms in mouse models of neuropathic and inflammatory pain following subcutaneous administration. No overt side effects were associated with mPD5 administration, and it had no effect on acute nociception. Finally, neuropathic pain was relieved far into the chronic phase (18 weeks after spared nerve injury surgery) and while the effect of a single injection ceased after a few hours, repeated administration provided pain relief lasting up to 20 hours after the last injection.","author_count":23,"contributors":["Jensen, Kathrine Louise","Christensen, Nikolaj Riis","Goddard, Carolyn Marie","Jager, Sara Elgaard","Noes-Holt, Gith","Kanneworff, Ida Buur","Jakobsen, Alexander","Jiménez-Fernández, Lucía","Peck, Emily G.","Sivertsen, Line","Baro, Raquel Comaposada","Houser, Grace Anne","Mayer, Felix P.","Diaz-DelCastillo, Marta","Topp, Marie Løth","Hopkins, Chelsea","Thomsen, Cecilie Dubgaard","Soltan, Ahmed Barakat Ibrahim","Tidemand, Frederik Grønbæk","Arleth, Lise","Heegaard, Anne-Marie","Sørensen, Andreas Toft","Madsen, Kenneth Lindegaard"],"cuid":["S01-000.00-777224"],"filters":{"added":"2025-01","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","Wake Forest University"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"peripherally restricted pick000000000001 inhibitor mpd000000000005 ameliorates pain behaviors in murine inflammatory and neuropathic pain models","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1172/jci.insight.170976","version":"Published Version"},"id":"S01-000.00-777224","identifier":[{"id":"PMC11530130","type":"pmcid"},{"id":"85207254369","type":"scopus"},{"id":"39287978","type":"pmid"}],"ids":["ku-284e6788-c3a6-498f-8ba3-7199c3bc8a41"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-9CFC96519BF4D44559E6E2C1290E1F0D"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1172/jci.insight.170976","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/411056788/170976.2_20241015153105_covered_e0fd13ba177f913fd3156f593ead4cfd.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Neuroscience, Neuropharm and Genetics"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"us","key":"wake forest university","loc":["United States","America, North","OECD"],"name":"Wake Forest University","used":1}],"person":[{"affno":"1","first":"Kathrine Louise","key":"jensenpau"