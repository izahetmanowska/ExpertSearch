e":"Sørensen, Trine","orcid":"0000-0001-6396-5502","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Simone","key":"turellasimonepau","last":"Turella","locid":"a8eadad6-5fc9-4351-8df9-0e534001298b","name":"Turella, Simone","orcid":"0000-0002-3411-4837","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Aaron John","key":"andersenaaronjohnchristianpau","last":"Andersen","locid":"de54e1cf-6bc9-49c3-932f-a6e8a40a78a4","name":"Andersen, Aaron John Christian","name_org":"Andersen, Aaron John","orcid":"0000-0002-3876-7480","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Claus","key":"hélixnielsenclauspau","last":"Hélix-Nielsen","locid":"bea497c9-caba-420a-81f8-8f2730634b31","name":"Hélix-Nielsen, Claus","orcid":"0000-0002-9392-7133","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens Christian","key":"frisvadjenschristianpau","last":"Frisvad","locid":"b2d4f948-9e1c-4f8c-9c02-05588bfa21b9","name":"Frisvad, Jens Christian","orcid":"0000-0002-0573-4340","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Teis Esben","key":"sondergaardteisesbenpau","last":"Søndergaard","locid":"c4550265-7489-4e7e-a723-b7cfef89912e","name":"Sondergaard, Teis Esben","name_org":"Søndergaard, Teis Esben","orcid":"0000-0002-4455-7498","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Henrik Rasmus","key":"andersenhenrikrasmuspau","last":"Andersen","locid":"09306f71-b3e1-4dcf-a287-df2c3e01ba59","name":"Andersen, Henrik Rasmus","orcid":"0000-0002-7013-9193","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Maher Abou","key":"abouhachemmaherpau","last":"Hachem","locid":"a81cbffb-ca6f-44ca-8a7d-4211cea18ca1","name":"Abou Hachem, Maher","name_org":"Hachem, Maher Abou","orcid":"0000-0001-8250-1842","rank":10,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.eti.2025.104379","issn":["23521864"],"journal":"Environmental Technology and Innovation","paperid":"104379","publisher":"Elsevier","status":"p","title":"Environmental Technology and Innovation","volume":"40"},"review":"Peer Reviewed","scoID":["2-s2.0-105011515345"],"sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["E-Published (ahead of print)","Published"]},"sid":["aau-f91a578f-75ad-48a3-a3aa-c76335cd2aad","dtu-1cae6eb9-7030-4695-9b77-410f907edb5d"],"src":["AAU Aalborg University","DTU Technical University of Denmark"],"title":"Cladosporium species detoxify multiple water micropollutants of emerging concern","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-098.86-822506","year":"2025","yearsub":"2025"}
{"abstract":"The content of phenolic compounds in chocolate depends on the processing of the cocoa from bean to bar. The aim of this study was to determine the fate of phenolic compounds and theobromine in cocoa beans during roasting at different temperatures. Based on a screening of 12 cocoa bean sorts, three beans (NM, NCC, and NB) with initial high total phenolic content (TPC) were selected for the roasting trial (100 and 150°C up to 20 min). The concentration of three major flavonoids ((−)-catechin, (−)-epicatechin and procyanidin B2) and one methylxanthine (theobromine) were evaluated in both raw and roasted beans. Results showed changes in the concentration of flavonoids and theobromine during roasting. Roasting at 150°C for 15 min was optimal for maintaining high flavonoid levels while reducing theobromine levels. However, sensory evaluation on final product is needed to confirm whether the suggested roasting condition would also result in a final product with pleasant sensory properties.","author_count":7,"contributors":["Hermund, Ditte Baun","Larsen, Louise Kirstein","Trangbæk, Sara Riegels","Madsen, Quoc-Khanh Rose-Marie Therese","Sørensen, Ann-Dorit Moltke","Kaya, Jacob","Jacobsen, Charlotte"],"cuid":["S01-000.00-789447"],"filters":{"added":"2025-02","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Hermund, Ditte Baun"],"keyword":["Antioxidants","Food processing","Phenolic compounds","Quality"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Mellow Chocolate"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"fate of flavonoids and theobromine in cocoa beans during roasting effect of time and temperature","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1002/aocs.12853","version":"Published Version"},"id":"S01-000.00-789447","identifier":[{"id":"85193926400","type":"scopus"}],"ids":["dtu-e8d8fa40-cd9c-4c92-b883-a8969349afbc"],"keyword":["Antioxidants","Food processing","Phenolic compounds","Quality"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-6FA96E745EC3B3177B0D5EE70AD3DEE8"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/386884134/J_Americ_Oil_Chem_Soc_-_2024_-_Hermund_-_Fate_of_flavonoids_and_theobromine_in_cocoa_beans_during_roasting_Effect_of_time_2_.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1002/aocs.12853","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Food Institute","Technical University of Denmark, National Food Institute, Research Group for Bioactives – Analysis and Application"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Mellow Chocolate"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Ditte B.","key":"hermundpau","last":"Hermund","locid":"04c563e9-6f7b-4599-b51f-8b231fbbe3e5","name":"Hermund, Ditte Baun","name_org":"Hermund, Ditte B.","orcid":"0000-0002-8265-2867","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Louise Kirstein","key":"larsenpau","last":"Larsen","name":"Larsen, Louise Kirstein","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Sara Riegels","key":"trangbækpau","last":"Trangbæk","name":"Trangbæk, Sara Riegels","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Quoc-Khanh Rose-Marie Therese","key":"madsenpau","last":"Madsen","name":"Madsen, Quoc-Khanh Rose-Marie Therese","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ann-Dorit Moltke","key":"sørensenpau","last":"Sørensen","locid":"dd7b7dae-3650-43cb-850c-ac4189bf0125","name":"Sørensen, Ann-Dorit Moltke","orcid":"0000-0001-9349-1221","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jacob","key":"kayapau","last":"Kaya","name":"Kaya, Jacob","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Charlotte","key":"jacobsenpau","last":"Jacobsen","locid":"36158d7c-a1ce-4b85-a240-93c6218ea6be","name":"Jacobsen, Charlotte","orcid":"0000-0003-3540-9669","rank":7,"rolecode":"pau"}],"pub":{"doi":"10.1002/aocs.12853","issn":["0003021X","15589331"],"issn_org":["0003021X"],"issue":"1","journal":"Journal of the American Oil Chemists' Society","pages":"35-45","publisher":"John Wiley & Sons Inc.","status":"p","title":"Journal of the American Oil Chemists' Society","volume":"102"},"review":"Peer Reviewed","scoID":["2-s2.0-85193926400"],"search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-e8d8fa40-cd9c-4c92-b883-a8969349afbc"],"src":["DTU Technical University of Denmark"],"title":"Fate of flavonoids and theobromine in cocoa beans during roasting : Effect of time and temperature","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-789447","year":"2025","yearsub":"2025"}
{"abstract":"Background and Aims. Overtesting of low-risk patients with suspect chronic coronary syndrome (CCS) is widespread. The acoustic-based coronary artery disease (CAD)-score has superior rule-out capabilities when added to pre-test probability (PTP). FILTER-SCAD tested whether providing a CAD-score and PTP to cardiologists was superior to PTP alone in limiting testing. Methods. At six Danish and Swedish outpatient clinics, patients with suspected new-onset CCS were randomized to either standard diagnostic examination (SDE) with PTP, or SDE plus CAD-score, and cardiologists provided with corresponding recommended diagnostic flowcharts. The primary endpoint was cumulative number of diagnostic tests at one year and key safety endpoint major adverse cardiac events (MACE). Results. In total, 2008 patients (46% male, median age 63 years) were randomized from October 2019 to September 2022. When randomized to CAD-score (n = 1002), it was successfully measured in 94.5%. Overall, 13.5% had PTP ≤ 5%, and 39.5% had CAD-score ≤ 20. Testing was deferred in 22% with no differences in diagnostic tests between groups (P for superiority = .56). In the PTP ≤ 5% subgroup, the proportion with deferred testing increased from 28% to 52% (P < .001). Overall MACE was 2.4 per 100 person-years. Non-inferiority regarding safety was established, absolute risk difference 0.49% (95% confidence interval −1.96–0.97) (P for non-inferiority = .003). No differences were seen in angina-related health status or quality of life. Conclusions. The implementation strategy of providing cardiologists with a CAD-score alongside SDE did not reduce testing overall but indicated a possible role in patients with low CCS likelihood. Further strategies are warranted to address resistance to modifying diagnostic pathways in this patient population.","author_count":14,"contributors":["Bjerking, Louise Hougesen","Skak-Hansen, Kim Wadt","Heitmann, Merete","Hove, Jens Dahlgaard","Haahr-Pedersen, Sune Ammentorp","Engblom, Henrik","Erlinge, David","Räder, Sune","Brønnum-Schou, Jens","Biering-Sørensen, Tor","Kjærgaard, Camilla Lyngby","Strange, Søren","Galatius, Søren","Prescott, Eva"],"cuid":["S01-000.00-790988"],"filters":{"added":"2025-02","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"country":["Sweden"],"glorg":["All Global Affiliations","Lund University"],"keyword":["Chronic coronary syndrome","Coronary artery disease","Diagnostic strategy","Heart sound","Implementation strategy","Pre test probability","Risk stratification"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"OT":["The Danish Association of Practicing Medical Specialists"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"acoustic based rule out of stable coronary artery disease the filter scad trial","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1093/eurheartj/ehae570","version":"Published Version"},"id":"S01-000.00-790988","identifier":[{"id":"PMC11704391","type":"pmcid"},{"id":"85214512003","type":"scopus"},{"id":"39217444","type":"pmid"}],"ids":["ku-c9b6dc86-4703-4242-8d9a-91d2cfbc190c"],"keyword":["Chronic coronary syndrome","Coronary artery disease","Deferred testing","Diagnostic strategy","Heart sound","Implementation strategy","Pre-test probability","Risk stratification"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-C87BFCC2DA7B47BF6CA473A2339462A5"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://curis.ku.dk/ws/files/420929503/Acoustic_based_rule_out.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1093/eurheartj/ehae570","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Bispebjerg and Frederiksberg"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Internal medicine: Cardiology"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"se","key":"lund university","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Lund University","used":1},{"affno":"4","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["The Danish Association of Practicing Medical Specialists"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","first":"Louise Hougesen","key":"bjerkingpau","last":"Bjerking","name":"Bjerking, Louise Hougesen","rank":1,"rolecode":"pau"},{"affno":"1","first":"Kim Wadt","key":"skakhansenpau","last":"Skak-Hansen","name":"Skak-Hansen, Kim Wadt","rank":2,"rolecode":"pau"},{"affno":"1 2","first":"Merete","key":"heitmannpau","last":"Heitmann","locid":"21d1def5-7b46-4f84-89e9-e9e39bd20c11","name":"Heitmann, Merete","rank":3,"rolecode":"pau"},{"affno":"2 1","first":"Jens Dahlgaard","key":"hovepau","last":"Hove","locid":"4ecfb416-ea53-418e-a6c3-ace7647318ea","name":"Hove, Jens Dahlgaard","orcid":"0000-0002-5600-5623","rank":4,"rolecode":"pau"},{"affno":"1","first":"Sune Ammentorp","key":"haahrpedersenpau","last":"Haahr-Pedersen","name":"Haahr-Pedersen, Sune Ammentorp","rank":5,"rolecode":"pau"},{"affno":"","first":"Henrik","key":"engblompau","last":"Engblom","name":"Engblom, Henrik","rank":6,"rolecode":"pau"},{"affno":"3","first":"David","key":"erlingepau","last":"Erlinge","name":"Erlinge, David","rank":7,"rolecode":"pau"},{"affno":"2 1","first":"Sune Bernd Emil Werner","key":"räderpau","last":"Räder","locid":"6bd2fa06-9229-47fa-8f2f-6a5b0bf6e074","name":"Räder, Sune","name_org":"Räder, Sune Bernd Emil Werner","rank":8,"rolecode":"pau"},{"affno":"1","first":"Jens","key":"brønnumschoupau","last":"Brønnum-Schou","name":"Brønnum-Schou, Jens","rank":9,"rolecode":"pau"},{"affno":"1 2","first":"Tor","key":"bieringsørensenpau","last":"Biering-Sørensen","locid":"2a25298f-30d3-4b37-b20b-646684a29fd8","name":"Biering-Sørensen, Tor","rank":10,"rolecode":"pau"},{"affno":"1","first":"Camilla Lyngby","key":"kjærgaardpau","last":"Kjærgaard","name":"Kjærgaard, Camilla Lyngby","rank":11,"rolecode":"pau"},{"affno":"4","first":"Søren","key":"strangepau","last":"Strange","name":"Strange, Søren","rank":12,"rolecode":"pau"},{"affno":"1","first":"Søren","key":"galatiuspau","last":"Galatius","name":"Galatius, Søren","rank":13,"rolecode":"pau"},{"affno":"1 2","first":"Eva Irene Bossano","key":"prescottpau","last":"Prescott","locid":"f6d11fc8-7565-487b-943a-3c67db7e9e75","name":"Prescott, Eva","name_org":"Prescott, Eva Irene Bossano","rank":14,"rolecode":"pau"}],"pmid":["39217444"],"pub":{"doi":"10.1093/eurheartj/ehae570","issn":["0195668X","15229645"],"issn_org":["0195668X"],"issue":"2","journal":"European Heart Journal","pages":"117-128","status":"p","title":"European Heart Journal","volume":"46"},"review":"Peer Reviewed","scoID":["2-s2.0-85214512003"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-c9b6dc86-4703-4242-8d9a-91d2cfbc190c"],"src":["KU University of Copenhagen"],"title":"Acoustic-based rule-out of stable coronary artery disease : the FILTER-SCAD trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-790988","year":"2025","yearsub":"2025"}
{"abstract":"Background: Intracerebral microdialysis is an advanced method to guide clinicians during intensive care of patients with severe acute brain injury. Using intracerebral microdialysis, markers of brain metabolism and homeostasis can be analysed. Currently, trends are considered more important in clinical decision-making than absolute values. Establishing absolute reference values in healthy brain tissue may facilitate an earlier detection of abnormal brain tissue metabolism and provide better decision support for clinicians. However, the current evidence on normal values in the uninjured human brain has not previously been summarized. The aim of this study was to summarise the literature regarding microdialysate concentrations of common markers of brain energy metabolism (glucose, lactate, pyruvate, glutamate, and glycerol) in vivo in healthy brain tissue of humans and gyrencephalic animals. Method: MEDLINE, Embase, CENTRAL, CINAHL, and Web of Science were searched for published studies that report values of microdialysis in healthy brain tissue. In order to identify unpublished studies, we searched ClinicalTrials.gov, WHO International Clinical Trials Registry Platform (ICTRP), and EU Clinical Trials Register. Study quality was evaluated using a pre-specified protocol. Result: Out of 3257 studies identified, 39 studies were included. Six of these studies were in humans (total n = 54), 26 in pigs/swine (n = 432), two on monkeys (n = 10), one in sheep (n = 15), and one in dogs (n = 10). We found a high degree of clinical and methodological heterogeneity in both human and gyrencephalic animal studies. Conclusion: This scoping review identified studies that applied microdialysis to measure common biomarkers in healthy brain tissue. The clinical and methodological heterogeneity between the measured values was substantial, limiting any conclusions. Furthermore, the quality of several human studies was moderate at best. Methodologically comparable studies are warranted to establish reference values for markers of brain energy metabolism using intracerebral microdialysate.","author_count":5,"contributors":["Granerud, Ingrid Løchen","Fabritius, Maria Louise","Jensen, Helene Ravnholt","Møller, Kirsten","Sørensen, Martin Kryspin"],"cuid":["S01-000.00-809378"],"filters":{"added":"2025-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Biomarkers","Humans"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"cerebral microdialysis values in healthy brain tissue a scoping review","src":["ku"],"src-code":["DI-U-KU"],"type":"djr","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1007/s00701-025-06424-8","version":"Published Version"},"id":"S01-000.00-809378","identifier":[{"id":"40055196","type":"pmid"},{"id":"86000343149","type":"scopus"},{"id":"PMC11889025","type":"pmcid"}],"ids":["ku-2b359c1b-0ca5-4528-a5db-02cd3a43a80b"],"keyword":["Biomarkers","Cerebral microdialysis","Gyrencephalic animals","Healthy brain tissue","Humans"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-1F0D10B92B6C84A419311F5029135262"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/437443564/s00701-025-06424-8.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1007/s00701-025-06424-8","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Anaesthesiology","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Ingrid Løchen","key":"granerudpau","last":"Granerud","name":"Granerud, Ingrid Løchen","rank":1,"rolecode":"pau"},{"affno":"1","first":"Maria Louise","key":"fabritiuspau","last":"Fabritius","name":"Fabritius, Maria Louise","rank":2,"rolecode":"pau"},{"affno":"1","first":"Helene Ravnholt","key":"jensenpau","last":"Jensen","name":"Jensen, Helene Ravnholt","rank":3,"rolecode":"pau"},{"affno":"1 2","first":"Kirsten","key":"møllerpau","last":"Møller","locid":"0781d3e6-9d76-4ba7-8a17-5a4d81e6ab87","name":"Møller, Kirsten","orcid":"0000-0003-3058-1072","rank":4,"rolecode":"pau"},{"affno":"1","first":"Martin Kryspin","key":"sørensenpau","last":"Sørensen","name":"Sørensen, Martin Kryspin","rank":5,"rolecode":"pau"}],"pmid":["40055196"],"pub":{"doi":"10.1007/s00701-025-06424-8","issn":["00016268","09420940"],"issn_org":["00016268"],"issue":"1","journal":"Acta Neurochirurgica","paperid":"62","status":"p","title":"Acta Neurochirurgica","volume":"167"},"review":"Peer Reviewed","scoID":["2-s2.0-86000343149"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-2b359c1b-0ca5-4528-a5db-02cd3a43a80b"],"src":["KU University of Copenhagen"],"title":"Cerebral microdialysis values in healthy brain tissue – a scoping review","type":"Journal Review","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-809378","year":"2025","yearsub":"2025"}
{"abstract":"Diet-induced obesity in mice is an important model for investigating host–diet interactions as well as dietary and pharmacological treatments of metabolic diseases. Experimental reproducibility is, however, a recurrent challenge. To determine key controllable experimental drivers of mouse metabolism, we distributed 338C57BL/6JBomTac mice (males and females) into six research units across two countries, divided them into a variety of housing conditions (i.e., diets, cage types, temperatures, group-housing vs. single-housing) and kept 26 reference mice at the vendor. We applied linear mixed models to rank the influence of each variable on metabolic phenotype (i.e., body weight gain, glucose intolerance, liver, and visceral adipose tissue weight). Group-housing was the most potent driver of metabolic dysfunction apart from sex and diet. Accordingly, single-housed mice exhibited reduced weight gain (∼50%), increased energy expenditure, and diminished respiratory exchange ratio concomitant with improved glucose tolerance (∼20%) compared to their group-housed counterparts. Our results may aid in clarifying the impact of experimental design and promote rational, transparent reporting to increase reproducibility.","author_count":21,"contributors":["Choi, Béatrice S.Y.","Holm, Jacob Bak","Brejnrod, Asker Daniel","Fjære, Even","Xia, Zhongkui","Allingbjerg, Marie-Louise","Larsen, Ida Søgaard","Kristensen, David Møbjerg","Dall, Morten","Myrmel, Lene Secher","Koch, Janne","Danneskiold-Samsøe, Niels Banhos","Kalliokoski, Otto","Treebak, Jonas T.","Xiao, Liang","Hansen, Axel Kornerup","Sørensen, Helle","Madsen, Lise","Arumugam, Manimozhiyan","Kristiansen, Karsten","Jensen, Benjamin Anderschou Holbech"],"cuid":["S01-000.00-818566"],"filters":{"added":"2025-08","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Asia, East","Europe, Non-EU","Nordic","OECD"],"country":["China","Norway"],"glorg":["All Global Affiliations","BGI","Ins