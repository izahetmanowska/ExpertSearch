untry":"dk","first":"Henrik T","key":"sørensenpau","last":"Sørensen","locid":"4d49d93a-4913-4223-ba59-272e717a845d","name":"Sørensen, Henrik Toft","name_org":"Sørensen, Henrik T","orcid":"0000-0003-4299-7040","rank":13,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Reimar W","key":"thomsenpau","last":"Thomsen","locid":"36e7af2c-e02f-48d4-b124-0f1bd95b1748","name":"Thomsen, Reimar Wernich","name_org":"Thomsen, Reimar W","orcid":"0000-0001-9135-3474","rank":14,"rolecode":"pau"}],"pmid":["39663235"],"pub":{"doi":"10.1007/s00125-024-06342-x","issn":["0012186X","14320428"],"issn_org":["0012186X"],"issue":"3","journal":"Diabetologia","pages":"576-587","publisher":"Springer Science and Business Media Deutschland GmbH","status":"p","title":"Diabetologia","volume":"68"},"review":"Peer Reviewed","scoID":["2-s2.0-85212090806"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Other Hospitals","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark","copenhagen university hospital - holbæk"],"PST":["Published"]},"sid":["aau-69d54418-9fd6-404b-a34f-5a8498c7076e","au-e7dccf4d-1bcb-419b-a9d7-84d7108f7e15","ku-4fd7bf1e-0ec2-45e1-adf3-d5c964cbac80","sdu-e2acf858-9075-4d0d-a031-75a3734f76ab"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Elevated risk of infection in individuals with hyperinsulinaemic type 2 diabetes: a Danish 12 year cohort study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-098.29-803709","year":"2025","yearsub":"2025"}
{"abstract":"Urea synthesis is an irreversible, essential for maintenance of health and life, and highly regulated liver function with a very high capacity for production of the end-product urea-nitrogen. The set-point of urea synthesis in relation to its overall substrate, the prevailing blood concentration of L-α-amino acids, contributes to determine whole-body nitrogen balance and the size and composition of the plasma free amino acid pool. Ammonia is definitively eliminated from the body by urea synthesis. Ammonia is released by all tissues as part of their nitrogen metabolism and accumulation of ammonia to supranormal levels is toxic, particularly to the brain where it gives rise to the devastating complication to liver diseases, hepatic encephalopathy. The first line ammonia scavenging has an efficiently high clearance several times over hepatic blood flow and close to cardiac output, under normal conditions securing rapid neutralization of ammonia by synthesis of amino acids and glutamine. This scavenging has a much lower capacity than urea synthesis. Maintenance of the scavenging system, therefore, relies on subsequent definitive depletion and elimination of amino- and amide-nitrogen to urea-nitrogen. In liver diseases, the capacity for urea synthesis is deficient due to reduced functional liver mass and dysregulation, which eventually delays the scavenging so that ammonia overflows. Considering the key role of ammonia in hepatic encephalopathy, this indirect relationship implies that deficient urea synthesis is a prerequisite for development of hyperammonemia and hepatic encephalopathy. This is in accordance with the definition of hepatic encephalopathy as being caused by liver insufficiency, where the insufficiency more specifically likely is deficiency of the urea synthesis.","author_count":6,"contributors":["Vilstrup, Hendrik","Eriksen, Peter Lykke","Kjærgaard, Kristoffer","Sørensen, Michael","Thomsen, Karen Louise","Ott, Peter"],"cuid":["S01-000.00-795794"],"filters":{"added":"2025-02","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Vilstrup, Hendrik"],"keyword":["Ammonia metabolism","Animals","Brain metabolism","Hepatic Encephalopathy metabolism","Humans","Liver metabolism","Nitrogen metabolism"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"down the road towards hepatic encephalopathy i urea synthesis the liver workhorse of nitrogen metabolism","src":["au"],"src-code":["DI-U-AU"],"type":"djr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s11011-024-01437-1","version":"Published Version"},"id":"S01-000.00-795794","identifier":[{"id":"39621237","type":"pmid"},{"id":"PMC11612001","type":"pmcid"},{"id":"85211187685","type":"scopus"}],"ids":["au-23b9c2e2-f135-4a25-b21d-401280050059"],"keyword":["Ammonia/metabolism","Animals","Brain/metabolism","Hepatic Encephalopathy/metabolism","Humans","Liver/metabolism","Nitrogen/metabolism","Urea/metabolism"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-63AEAE5F914A1562F088BE6D7D5FC452"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s11011-024-01437-1","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Hepatology and Gastroenterology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Hendrik","key":"vilstruppau","last":"Vilstrup","locid":"9e1905f3-3094-4aea-bbde-7178733bf6cb","name":"Vilstrup, Hendrik","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Peter Lykke","key":"eriksenpau","last":"Eriksen","locid":"02b5f3f7-8692-403b-9a17-1dc588d638e7","name":"Eriksen, Peter Lykke","orcid":"0000-0003-1115-8308","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kristoffer","key":"kjærgaardpau","last":"Kjærgaard","locid":"35ec4dba-1425-425c-9860-460c3989eba7","name":"Kjærgaard, Kristoffer","orcid":"0000-0002-6440-2784","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Michael","key":"sørensenpau","last":"Sørensen","locid":"52635821-2c0d-418e-848d-e3e1f1175e12","name":"Sørensen, Michael","orcid":"0000-0002-8750-4329","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Karen Louise","key":"thomsenpau","last":"Thomsen","locid":"32baa31f-0b93-4c6d-af7e-0da0519f574f","name":"Thomsen, Karen Louise","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Peter","key":"ottpau","last":"Ott","locid":"60cc04a0-da79-417d-a8d9-c0b200b04caf","name":"Ott, Peter","rank":6,"rolecode":"pau"}],"pmid":["39621237"],"pub":{"doi":"10.1007/s11011-024-01437-1","issn":["08857490","15737365"],"issn_org":["08857490"],"issue":"1","journal":"Metabolic Brain Disease","paperid":"49","publisher":"Springer","status":"p","title":"Metabolic Brain Disease","volume":"40"},"review":"Peer Reviewed","scoID":["2-s2.0-85211187685"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-23b9c2e2-f135-4a25-b21d-401280050059"],"src":["AU Aarhus University"],"title":"Down the road towards hepatic encephalopathy I. Urea synthesis - the liver workhorse of nitrogen metabolism","type":"Journal Review","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-795794","year":"2025","yearsub":"2025"}
{"abstract":"Continuous monitoring of the mass balance of the Greenland ice sheet is crucial to assess its contribution to the rise of sea levels. The GRACE and GRACE-FO missions have provided monthly estimates of the Earth's gravity field since 2002, which have been widely used to estimate monthly mass changes of ice sheets. However, there is an 11 month gap between the two missions. Here, we propose a data-driven approach that combines atmospheric variables from the ERA5 reanalysis with GRACE-derived mass anomalies from previous months to predict mass changes. Using an auto-regressive structure, the model is naturally predictive for shorter times without GRACE/-FO observations. The results show a high r2-score (> 0.73) between model predictions and GRACE/-FO observations. Validating the model's ability to reproduce mass anomalies when observations are available builds confidence in estimates used to bridge the GRACE and GRACE/-FO gap. Although GRACE and GRACE-FO are treated equally by the model, we see a decrease in model performance for the period covered by GRACE-FO, indicating that they may not be as well-calibrated as previously assumed. Gap predictions align well with mass change estimates derived from other geodetic methods and remain within the uncertainty envelope of the GRACE-FO observations.","author_count":5,"contributors":["Puggaard, Anna","Hansen, Nicolaj","Schlager, Elke","Sørensen, Louise Sandberg","Simonsen, Sebastian Bjerregaard"],"cuid":["S01-000.00-827868"],"filters":{"added":"2025-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Puggaard, Anna"],"keyword":["Deep learning","GRACE","Greenland Ice Sheet","Remote sensing"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-DMI"],"U":["DI-U-ALL","DI-U-AU","DI-U-DTU"]},"level3all":["DI-GV-DMI","DI-U-AU","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"filling the grace fo gap of mass balance observation in central west greenland by data driven modelling","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1017/aog.2025.10019","version":"Published Version"},"id":"S01-000.00-827868","identifier":[{"id":"105014961359","type":"scopus"}],"ids":["dtu-aa1c4c8a-2e24-4059-950a-99ed2353e7f5"],"keyword":["Deep learning","GRACE","Greenland Ice Sheet","Remote sensing"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-F4F9720379E5EBFF7803AE10BD2A0CD6"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/413485898/filling-the-grace-fo-gap-of-mass-balance-observation-in-central-west-greenland-by-data-driven-modelling.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1017/aog.2025.10019","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Space Research and Technology","Technical University of Denmark, Department of Space Research and Technology, Geodesy and Earth Observation"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"dk","key":"dmi danish meteorological institute","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-DMI","l3nn":"DMI Danish Meteorological Institute","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DMI Danish Meteorological Institute","namevar":["Danish Meteorological Institute"],"nora_code":"DI-GV-DMI","used":1},{"affno":"3","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Anna","key":"puggaardpau","last":"Puggaard","locid":"55a6a1f4-58fb-4d47-baa8-8d6e8aed3757","name":"Puggaard, Anna","orcid":"0009-0001-6338-975X","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Nicolaj","key":"hansenpau","last":"Hansen","locid":"07d01beb-26c3-43d2-ba33-678dbbc74b85","name":"Hansen, Nicolaj","orcid":"0000-0002-4448-8891","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Elke","key":"schlagerpau","last":"Schlager","name":"Schlager, Elke","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Louise Sandberg","key":"sørensenpau","last":"Sørensen","locid":"1c6cb90f-da30-48a2-872f-a94b8100749b","name":"Sørensen, Louise Sandberg","orcid":"0000-0002-3771-4061","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Sebastian","key":"bjerregaardsimonsenpau","last":"Bjerregaard Simonsen","locid":"d088b945-224e-4fd3-a871-022cc71c5cb1","name":"Simonsen, Sebastian Bjerregaard","name_org":"Bjerregaard Simonsen, Sebastian","orcid":"0000-0001-9569-1294","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1017/aog.2025.10019","issn":["02603055","17275644"],"issn_org":["02603055"],"journal":"Annals of Glaciology","paperid":"e20","publisher":"International Glaciological Society","status":"p","title":"Annals of Glaciology","volume":"66"},"review":"Peer Reviewed","scoID":["2-s2.0-105014961359"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Governmental Institutions","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-U","DI-U-ALL","Governmental Institutions","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-aa1c4c8a-2e24-4059-950a-99ed2353e7f5"],"src":["DTU Technical University of Denmark"],"title":"Filling the GRACE/-FO gap of mass balance observation in central west Greenland by data-driven modelling","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-827868","year":"2025","yearsub":"2025"}
{"abstract":"Objectives: Ethical considerations are central to deciding on resuscitation in a prehospital setting. A systematic study of ethical views can enlighten the area and potentially reveal variations in decision-making. We aimed to explore the ethical views on resuscitation and their impact on the reasoning of prehospital healthcare professionals using a qualitative approach and a structured questionnaire. This study describes the validation of a structured questionnaire designed to explore the ethical views on resuscitation and its impact on the reasoning of prehospital healthcare professionals. Methods: This observational cross-sectional study used a mixed-methods approach. The questionnaire included qualitative free-text fields and quantitative scales. Its first version was developed based on data from a systematic review and an ethnographic study. Validation involved face-to-face interviews and a two-round Delphi process with experts in qualitative research, philosophy, epidemiology, and prehospital medicine. The final questionnaire was field-tested among Danish prehospital physicians. Exploratory factor analysis assessed underlying relationships, and Cronbach’s alpha measured internal consistency. Results: 216 out of 380 invited Danish prehospital physicians completed the questionnaire. The ethical aspects addressed in the cases included “do-not-attempt cardiopulmonary resuscitation,” “socioeconomic status,” “quality of life,” “the patient and family’s cultural background,” and “relatives’ emotional reaction.” The questionnaire demonstrated satisfactory internal consistency, with a Cronbach’s alpha of 0.71. Conclusions: The questionnaire was validated as a tool for assessing moral reasoning and variations in perspectives in prehospital decision-making. The survey can be used to assess the moral reasoning and variations therein in prehospital resuscitation decision-making.","author_count":13,"contributors":["Milling, Louise","Kjær, Jeannett","Sørensen, Oliver B.","Møller, Søren","Hansen, Peter M.","Binderup, Lars G.","Schaffalitzky de Muckadell, Caroline","Christensen, Erika F.","Christensen, Helle Collatz","Lassen, Annmarie T.","Nielsen, Dorthe","Mikkelsen, Søren"],"cuid":["S03-098.25-803613"],"filters":{"added":"2025-04","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"corresponding_author":["Sørensen, Oliver B.","Sørensen, Oliver Beierholm"],"keyword":["Cardiac arrest","Decision making","Medical ethics","Mixed method","Resuscitation"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-NDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-NDR","DI-U-AAU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"development and validation of a case based survey assessing ethical decision making in prehospital resuscitation","src":["aau","ku","sdu"],"src-code":["DI-U-AAU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/healthcare13030267","version":"Published Version"},"id":"S03-098.25-803613","identifier":[{"id":"PMC11817982","type":"pmcid"},{"id":"39942456","type":"pmid"},{"id":"85217791794","type":"scopus"}],"ids":["aau-119dd0bb-34a0-4916-a519-6083cf0f0ef3","ku-df0afaa1-f26b-497a-bd5b-e387cc8e4dca","sdu-f67e21d3-5cc8-494d-8656-1f172506e7f1"],"keyword":["cardiac arrest","decision-making","medical ethics","mixed-method","resuscitation"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-9E8E9CD4C7D570C98E4D35AE6433A6B6"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/428851665/healthcare_13_00267.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/healthcare13030267","version":"Published Version"},{"acce