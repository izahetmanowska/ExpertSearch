r, Kurt H.","orcid":"0000-0002-8871-5179","rank":62,"rolecode":"pau"},{"affno":"9 23 24 25","corresponding":null,"first":"Richard","key":"durbinrichardpau","last":"Durbin","name":"Durbin, Richard","rank":63,"rolecode":"pau"},{"affno":"1 17 3","first":"Rasmus","key":"nielsenrasmuspau","last":"Nielsen","locid":"68905e51-280a-4c0b-bc94-469bb52de9b6","name":"Nielsen, Rasmus","orcid":"0000-0003-0513-6591","rank":64,"rolecode":"pau"},{"affno":"15","corresponding":null,"first":"Olivier","key":"delaneauolivierpau","last":"Delaneau","name":"Delaneau, Olivier","rank":65,"rolecode":"pau"},{"affno":"8 1","first":"Thomas","key":"wergethomaspau","last":"Werge","locid":"905c01bb-6319-4ce6-a38e-ceb5bf73d2f6","name":"Werge, Thomas","rank":66,"rolecode":"pau"},{"affno":"1 7 3 26","first":"Kristian","key":"kristiansenkristianpau","last":"Kristiansen","locid":"6d10c961-d4c9-45dc-9f7b-d872efe06c48","name":"Kristiansen, Kristian","rank":67,"rolecode":"pau"},{"affno":"1 9 27 3 28 29","first":"Eske","key":"willersleveskepau","last":"Willerslev","locid":"21d2e042-0513-44fe-8acd-56b0d00a603e","name":"Willerslev, Eske","orcid":"0000-0002-7081-6748","rank":68,"rolecode":"pau"}],"pmid":["38200294"],"pub":{"doi":"10.1038/s41586-023-06862-3","issn":["00280836","14764687"],"issn_org":["14764687"],"issue":"7994","journal":"Nature","pages":"329-337","publisher":"Nature Research","status":"p","title":"Nature","volume":"625"},"review":"Peer Reviewed","scoID":["2-s2.0-85181852344"],"sdg":["15. Life on Land","All UN SDG Classification"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Governmental Institutions","All Hospitals","All Miscellaneous","All Non-Profit Organisations","All Private Research","All Universities","Capital Region of Denmark","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-NP","DI-NP-ALL","DI-OT","DI-OT-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Miscellaneous","Non-Profit Organisations","Other Companies","Other Research","Private Research","Region Zealand","Technical University of Denmark","Universities","University of Copenhagen","smv company (denmark)"],"PST":["Published"]},"sid":["au-36e20316-953f-4b7e-8bf8-7d9b68312937","dtu-51f0d451-d77c-4b97-a324-cf22ebf8cf7f","ku-a31b4a17-dfc3-4b86-bc27-997244bc73ab","kum-f9506713-be49-427d-b3e5-d6d262522f75"],"src":["AU Aarhus University","DTU Technical University of Denmark","KU University of Copenhagen","KUM Ministry of Culture - Archives, Museums, and Royal Library Denmark"],"title":"100 ancient genomes show repeated population turnovers in Neolithic Denmark","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-095.15-793206","year":"2024","yearsub":"2024"}
{"abstract":"Background [15O]H2O PET/CT allows noninvasive quantification of tissue perfusion and can potentially play a future role in the diagnosis and treatment of peripheral artery disease. We aimed to evaluate the reliability of dynamic [15O]H2O PET imaging for measuring lower extremity skeletal muscle perfusion. Ten healthy participants underwent same-day test–retest study with six dynamic [15O]H2O PET scans of lower legs and feet. Manual volume-of-interests were drawn in skeletal muscles, and PET time activity curves were extracted. K1 values (mL/min/100 mL) were estimated using a single-tissue compartment model (1TCM), autoradiography (ARG), and parametric imaging with blood input functions obtained from separate heart scans. Results Resting perfusion values in the muscle groups of the lower legs ranged from 1.18 to 5.38 mL/min/100 mL (ARG method). In the muscle groups of the feet, perfusion values ranged from 0.41 to 3.41 mL/min/100 mL (ARG method). Test–retest scans demonstrated a strong correlation and good repeatability for skeletal muscle perfusion with an intraclass correlation coefficient (ICC) of 0.88 and 0.87 and a repeatability coefficient of 34% and 53% for lower legs and feet, respectively. An excellent correlation was demonstrated when comparing volume-of-interest-based methods (1TCM and ARG) (lower legs: ICC = 0.96, feet: ICC = 0.99). Parametric images were in excellent agreement with the volume-of-interest-based ARG method (lower legs: ICC = 0.97, feet: ICC = 0.98). Conclusion Parametric images and volume-of-interest-based methods demonstrated comparable resting perfusion values in the lower legs and feet of healthy individuals. The largest variation was seen between individuals, whereas a smaller variation was seen between muscle groups. Repeated measurements of resting blood flow yielded a strong overall correlation for all methods.","author_count":6,"contributors":["Christensen, Nana Louise","Sørensen, Jens","Bouchelouche, Kirsten","Madsen, Michael Alle","Buhl, Christian Selmer","Tolbod, Lars Poulsen"],"cuid":["S01-000.00-718191"],"filters":{"added":"2024-03","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Tolbod, Lars Poulsen"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"repeatability of 000000000015o h000000000002o pet imaging for lower extremity skeletal muscle perfusion a test retest study","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s13550-024-01073-x","version":"Published Version"},"id":"S01-000.00-718191","identifier":[{"id":"38294730","type":"pmid"},{"id":"PMC10830956","type":"pmcid"},{"id":"85183638476","type":"scopus"}],"ids":["au-f361d5f4-a746-4f41-90d8-cbc7ca045fb8"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-8B489114A566B8868673C950748DB22D"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s13550-024-01073-x","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Nuclear Medicine"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Nana Louise","key":"christensenpau","last":"Christensen","locid":"796a6fa5-29d9-40b3-b549-0610eb49705c","name":"Christensen, Nana Louise","orcid":"0000-0002-9936-1636","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens","key":"sørensenpau","last":"Sørensen","locid":"cab278f0-6db5-48a8-8764-b7da319d7818","name":"Sørensen, Jens","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kirsten","key":"bouchelouchepau","last":"Bouchelouche","locid":"f253980f-a953-448a-bdfb-2a0fcfe82101","name":"Bouchelouche, Kirsten","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Michael Alle","key":"madsenpau","last":"Madsen","locid":"e14de478-8675-42c9-ac79-cacf6da61050","name":"Madsen, Michael Alle","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christian Selmer","key":"buhlpau","last":"Buhl","locid":"1efc3457-5381-4d2d-ad63-c06127066a25","name":"Buhl, Christian Selmer","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars Poulsen","key":"tolbodpau","last":"Tolbod","locid":"a1e56507-eb80-4f94-9470-df90dcecbc62","name":"Tolbod, Lars Poulsen","orcid":"0000-0002-8105-7046","rank":6,"rolecode":"pau"}],"pmid":["38294730"],"pub":{"doi":"10.1186/s13550-024-01073-x","issn":["2191219X"],"issue":"1","journal":"EJNMMI Research","paperid":"11","publisher":"Springer Science and Business Media Deutschland GmbH","status":"p","title":"EJNMMI Research","volume":"14"},"review":"Peer Reviewed","scoID":["2-s2.0-85183638476"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-f361d5f4-a746-4f41-90d8-cbc7ca045fb8"],"src":["AU Aarhus University"],"title":"Repeatability of [15O]H2O PET imaging for lower extremity skeletal muscle perfusion: a test–retest study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-718191","year":"2024","yearsub":"2024"}
{"abstract":"Subglacial lakes form beneath ice sheets and ice caps if water is available and if bedrock and surface topography are able to retain the water. On a regional scale, the lakes modulate the timing and rate of freshwater flow through the subglacial system to the ocean by acting as reservoirs. More than 100 hydrologically active subglacial lakes that drain and recharge periodically have been documented under the Antarctic Ice Sheet, while only approximately 20 active lakes have been identified in Greenland. Active lakes may be identified by local changes in ice topography caused by the drainage or recharge of the lake beneath the ice. The small size of the Greenlandic subglacial lakes puts additional demands on mapping capabilities to resolve the evolving surface topography in sufficient detail to record their temporal behaviour. Here, we explore the potential for using CryoSat-2 swath-processed data, together with TanDEM-X digital elevation models, to improve the monitoring capabilities of active subglacial lakes in Greenland. We focus on four subglacial lakes previously described in the literature and combine the data with ArcticDEMs to obtain improved measurements of the evolution of these four lakes. We find that with careful tuning of the swath processor and filtering of the output data, the inclusion of these data, together with the TanDEM-X data, provides important information on lake activity, documenting, for example, that the ice surface collapse basin on Flade Isblink Ice Cap was 50% (30m) deeper than previously recorded. We also present evidence of a new, active subglacial lake in southwestern Greenland, which is located close to an already known lake. Both lakes probably drained within 1 month in the summer of 2012, which suggests either that they are hydrologically connected or that the drainages were independently triggered by extensive surface melt. If the hydrological connection is confirmed, this would to our knowledge be the first indication of hydrologically connected subglacial lakes in Greenland.","author_count":13,"contributors":["Sørensen, Louise Sandberg","Bahbah, Rasmus","Simonsen, Sebastian Bjerregaard","Andersen, Natalia Havelund","Bowling, Jade","Gourmelen, Noel","Horton, Alex","Karlsson, Nanna B.","Leeson, Amber","Maddalena, Jennifer","McMillan, Malcolm","Solgaard, Anne","Wessel, Birgit"],"cuid":["S01-000.00-729609"],"filters":{"added":"2024-05","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","OECD"],"corresponding_author":["Sørensen, Louise Sandberg"],"country":["Germany","United Kingdom"],"glorg":["All Global Affiliations","Earthwave Ltd.","German Aerospace Center","Lancaster University","University of Edinburgh"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-GEUS"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-GV-GEUS","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"improved monitoring of subglacial lake activity in greenland","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.5194/tc-18-505-2024","version":"Published Version"},"id":"S01-000.00-729609","identifier":[{"id":"85186097218","type":"scopus"}],"ids":["dtu-5d83435d-2ad4-4887-887f-538d5b9ada06"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-F4A76D89207FBA0E8B5194A10A8370F9"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/355228039/tc-18-505-2024.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.5194/tc-18-505-2024","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Space Research and Technology","Technical University of Denmark, Department of Space Research and Technology, Geodesy and Earth Observation"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"gb","key":"lancaster university","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Lancaster University","used":1},{"affno":"3","country":"gb","key":"university of edinburgh","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Edinburgh","used":1},{"affno":"4","country":"gb","key":"earthwave ltd","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Earthwave Ltd.","used":1},{"affno":"5","country":"dk","key":"geus geological survey of denmark and greenland","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-GEUS","l3nn":"GEUS Geological Survey of Denmark and Greenland","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"GEUS Geological Survey of Denmark and Greenland","namevar":["Geological Survey of Denmark and Greenland"],"nora_code":"DI-GV-GEUS","used":1},{"affno":"6","country":"de","key":"german aerospace center","loc":["Germany","Europe, EU","OECD"],"name":"German Aerospace Center","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Louise","key":"sandbergsørensenpau","last":"Sandberg Sørensen","locid":"1c6cb90f-da30-48a2-872f-a94b8100749b","name":"Sørensen, Louise Sandberg","name_org":"Sandberg Sørensen, Louise","orcid":"0000-0002-3771-4061","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Rasmus","key":"bahbahpau","last":"Bahbah","name":"Bahbah, Rasmus","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Sebastian B.","key":"simonsenpau","last":"Simonsen","locid":"d088b945-224e-4fd3-a871-022cc71c5cb1","name":"Simonsen, Sebastian Bjerregaard","name_org":"Simonsen, Sebastian B.","orcid":"0000-0001-9569-1294","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Natalia","key":"havelundandersenpau","last":"Havelund Andersen","locid":"c5e34a6f-c973-41a5-8f78-b0ed469d5210","name":"Andersen, Natalia Havelund","name_org":"Havelund Andersen, Natalia","orcid":"0000-0003-4257-1242","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jade","key":"bowlingpau","last":"Bowling","name":"Bowling, Jade","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Noel","key":"gourmelenpau","last":"Gourmelen","name":"Gourmelen, Noel","rank":6,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Alex","key":"hortonpau","last":"Horton","name":"Horton, Alex","rank":7,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Nanna B.","key":"karlssonpau","last":"Karlsson","name":"Karlsson, Nanna B.","rank":8,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Amber","key":"leesonpau","last":"Leeson","name":"Leeson, Amber","rank":9,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jennifer","key":"maddalenapau","last":"Maddalena","name":"Maddalena, Jennifer","rank":10,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Malcolm","key":"mcmillanpau","last":"McMillan","name":"McMillan, Malcolm","rank":11,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Anne","key":"solgaardpau","last":"Solgaard","name":"Solgaard, Anne","rank":12,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Birgit","key":"wesselpau","last":"Wessel","name":"Wessel, Birgit","rank":13,"rolecode":"pau"}],"pub":{"doi":"10.5194/tc-18-505-2024","issn":["19940416","19940424"],"issn_org":["19940416"],"issue":"2","journal":"Cryosphere","pages":"505-523","publisher":"Copernicus GmbH","status":"p","title":"Cryosphere","volume":"18"},"review":"Peer Reviewed","scoID":["2-s2.0-85186097218"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-U","DI-U-ALL","Governmental Institutions","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-5d83435d-2ad4-4887-887f-538d5b9ada06"],"src":["DTU Technical University of Denmark"],"title":"Improved monitoring of subglacial lake activity in Greenland","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-729609","year":"2024","yearsub":"2024"}
{"abstract":"Supraglacial lakes form on the Greenland ice sheet in the melt season (May to October) when meltwater collects in surface depressions on the ice. Supraglacial lakes can act as a control on ice dynamics since, given a large enough volume of water and a favourable stress regime, hydrofracture of the lake can occur, which enables water transfer from the ice surface to the bedrock, where it can lubricate the base. The depth (and thus volume) of these lakes is typically estimated by applying a radiative transfer equation (RTE) to optical satellite imagery. This method can be used at scale across entire ice sheets but is poorly validated due to a paucity of in situ depth data. Here we intercompare supraglacial lake depth detection by means of ArcticDEM digital elevation models, ICESat-2 photon refraction, and the RTE applied to Sentinel-2 images across five lakes in southwest Greenland. We found good agreement between the ArcticDEM and ICESat-2 approaches (Pearson's rCombining double low line0.98) but found that the RTE overestimates lake depth by up to 153% using the green band (543-578nm) and underestimates lake depth by up to 63% using the red band (650-680nm). Parametric uncertainty in the RTE estimates is substantial and is dominated by uncertainty in estimates of reflectance at the lakebed, which are derived empirically. Uncertainty in lake depth estimates translates into a poor understanding of total lake volume, which could mean that hydrofracture likelihood is poorly constrained, in turn affecting ice velocity predictions. Further laboratory studies to constrain spectral radiance loss in the water column and investigation of the potential effects of cryoconite on lakebed reflectance could improve the RTE in its current format. However, we also suggest that future work should explore multi-sensor approaches to deriving lake depth from optical satellite imagery, which may improve depth estimates and will certainly result in better-constrained uncertainties.","author_count":9,"contributors":["Melling, Laura","Leeson, Amber","McMillan, Malcolm","Maddalena, Jennifer","Bowling, Jade","Glen, Emily","Sørensen, Louise Sandberg","Winstrup, Mai","Lørup Arildsen, Rasmus"],"cuid":["S01-000.00-729800"],"filters":{"added":"2024-05","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"corresponding_author":["Melling, Laura"],"country":["United Kingdom"],"glorg":["All Global Affiliations","Lancaster University"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"evaluation of satellite methods for estimating supraglacial lake depth in southwest greenland","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.5194/tc-18-543-2024","version":"Published Version"},"id":"S01-000.00-729800","identifier":[{"id":"85186078272","type":"scopus"}],"ids":["dtu-93712b91-01d2-459c-a2a9-d5d948589370"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-CE82257B4A9432D6426B17C7F2CC6EA5"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.5194/tc-18-543-2024","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/355224271/tc-18-543-2024.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"gb","key":"lancaster university","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Lancaster University","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Space Research and Technology","Technical University of Denmark, Department of Space Research and Technology, Geodesy and Earth Observation"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Laura","key":"mellingpau","last":"Melling","name":"Melling, Laura","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Amber","key":"leesonpau","last":"Leeson","name":"Leeson, Amber","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Malcolm","key":"mcmillanpau","last":"McMillan","name":"McMillan, Malcolm","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jennifer","key":"maddalenapau","last":"Maddalena","name":"Maddalena, Jennifer","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jade","key":"bowlingpau","last":"Bowling","name":"Bowling, Jade","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Emily","key":"glenpau","last":"Glen","name":"Glen, Emily","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Louise","key":"sandbergsørensenpau","last":"Sandberg Sørensen","locid":"1c6cb90f-da30-48a2-872f-a94b8100749b","name":"Sørensen, Louise Sandberg","name_org":"Sandberg Sørensen, Louise","orcid":"0000-0002-3771-4061","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Mai","key":"winstruppau","last":"Winstrup","locid":"5b8bc307-4b30-4668-9e2c-646716b77fcd","name":"Winstrup, Mai","orcid":"0000-0002-4794-4004","rank":8,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Rasmus","key":"løruparildsenpau","last":"Lørup Arildsen","name":"Lørup Arildsen, Rasmus","rank":9,"rolecode":"pau"}],"pub":{"doi":"10.5194/tc-18-543-2024","issn":["19940416","19940424"],"issn_org":["19940416"],"issue":"2","journal":"Cryosphere","pages":"543-558","publisher":"Copernicus GmbH","status":"p","title":"Cryosphere","volume":"18"},"review":"Peer Reviewed","scoID":["2-s2.0-85186078272"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-93712b91-01d2-459c-a2a9-d5d948589370"],"src":["DTU Technical University of Denmark"],"title":"Evaluation of satellite methods for estimating supraglacial lake depth in southwest Greenland","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-729800","year":"2024","yearsub":"2024"}
{"abstract":"This study assesses low-cost sensors (LCS) for the mobile monitoring of air quality, which has thus far been scarcely investigated. NO2 and PM2.5 were measured using LCS and higher-grade instruments while driving across various environments in London (943 km) and northern Europe (2923 km), including urban areas, motorways, and tunnels. The data were classified according to the environment where the measurements were carried out, and the performances of LCS and higher-grade instruments were compared. Results indicate that the performances of the sensors were influenced by the rate of change in pollutant concentration in different environments and not by vehicle speed. Excluding tunnel environments, overall, the particulate matter sensors correlated better with their higher-grade instrument than the electrochemical (EC) sensors, with R2 values from 0.90–0.96 in the different environments, compared with 0.39–0.72 for the EC sensors. Tunnels presented a unique opportunity to test the time response of the systems, given the rapid change in concentration upon entering, and all sensors showed limited response times. This is the first time that EC NO2 sensors have been rigorously tested against reference monitors while mobile. Their absolute measurements appear unaffected by movement; however, their time resolution may not be high enough for mobile monitoring in highly variable environments.","author_count":6,"contributors":["Russell, Hugo S.","Frederickson, Louise B.","Sørensen, Martin O. B.","Schmidt, Johan A.","Hertel, Ole","Johnson, Matthew Stanley"],"cuid":["S01-000.00-748191"],"filters":{"added":"2024-08","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["AirScape","All Global Affiliations"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Devlabs"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"hyperlocal air pollution in london validating low cost sensors for mobile measurements from vehicles","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-748191","ids":["ku-6030360d-95c1-49db-a608-36a2ec887c7a"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-1729E44EE486993A53223B1E64C8FDB6"],"org":[{"affno":"1","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"gb","key":"airscape","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"AirScape","used":1},{"affno":"3","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Devlabs"],"nora_code":"DI-OT","used":1},{"affno":"4","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Chemistry, Department of Chemistry"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1 2","first":"Hugo S.","key":"russellpau","last":"Russell","name":"Russell, Hugo S.","rank":1,"rolecode":"pau"},{"affno":"1 2","first":"Louise B.","key":"fredericksonpau","last":"Frederickson","name":"Frederickson, Louise B.","rank":2,"rolecode":"pau"},{"affno":"1","first":"Martin O. B.","key":"sørensenpau","last":"Sørensen","name":"Sørensen, Martin O. B.","rank":3,"rolecode":"pau"},{"affno":"3","first":"Johan A.","key":"schmidtpau","last":"Schmidt","name":"Schmidt, Johan A.","rank":4,"rolecode":"pau"},{"affno":"1","first":"Ole","key":"hertelpau","last":"Hertel","name":"Hertel, Ole","rank":5,"rolecode":"pau"},{"affno":"4","first":"Matthew S.","key":"johnsonpau","last":"Johnson","locid":"03bbf286-9790-4cc4-a659-4d3956486bf3","name":"Johnson, Matthew Stanley","name_org":"Johnson, Matthew S.","orcid":"0000-0002-3645-3955","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1021/acsestair.3c00043","issn":["28371402"],"issue":"6","journal":"ACS ES&T Air","pages":"438-450","status":"p","title":"ACS ES&T Air","volume":"1"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-6030360d-95c1-49db-a608-36a2ec887c7a"],"src":["KU University of Copenhagen"],"title":"Hyperlocal Air Pollution in London : Validating Low-Cost Sensors for Mobile Measurements from Vehicles","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-748191","year":"2024","yearsub":"2024"}
{"abstract":"Purpose: No effective treatment exists for radiation-induced xerostomia. The objective of this study was to compare the effect of adipose-derived mesenchymal stem/stromal cell (ASC) injection, relative to placebo, on salivary gland function in patients with radiation-induced xerostomia. Patient and Methods: In this single-centre, double-blind, placebo- controlled trial, patients with hyposalivation were randomised to receive ultrasound-guided injections of allogeneic ASCs or placebo into the submandibular glands. Patients were followed for 4 months. We evaluated unstimulated whole salivary flow rate (UWS), stimulated salivary flow rate, and patient-reported outcomes. Adverse events were recorded and immune response determined in blood samples. Results: We enrolled 120 patients. ASC treatment resulted in a statistically significant UWS increase of 0.04 [95% confidence interval (CI), 0.02-0.06] mL/min (38%) compared with pretreatment baseline whereas placebo treatment did not cause a significant increase [0.01 (95% CI, -0.01 to 0.04) mL/min (21%)]. Both the ASC and placebo treatment yielded notable symptom reductions, with dry mouth decreasing by 13.6 and 7.7 units, sticky saliva decreased by 14.8 and 9.3 units, swallowing difficulties decreased by 7.9 and 8.0 units, and the summary score of the Xerostomia Questionnaire decreased 5.9 and 5.1 units for the ASC and placebo arms, respectively. We found no statistically significant group difference between the ASC and placebo arms for any of the outcomes. Conclusions: We could not confirm superiority of the ASC relative to placebo. ASC therapy significantly improved UWS in previous patients with head and neck cancer, whereas placebo resulted in an insignificant increase.","author_count":20,"contributors":["Jakobsen, Kathrine Kronberg","Carlander, Amanda Louise Fenger","Todsen, Tobias","Melchiors, Jacob","Paaske, Natasja","Madsen, Anne Kathrine Ostergaard","Bendtsen, Simone Kloch","Mordhorst, Christine","Stampe, Helene","Kastrup, Jens","Ekblond, Annette","Haack-Sørensen, Mandana","Farhadi, Mohammad","Maare, Christian","Friborg, Jeppe","Lynggaard, Charlotte D.","Hauge, Anne Werner","Christensen, Robin","Grønhøj, Christian","von Buchwald, Christian"],"cuid":["S01-000.00-750377"],"filters":{"added":"2024-08","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"corresponding_author":["Jakobsen, Kathrine Kronberg"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-ZEA"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-ZEA","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"mesenchymal stem stromal cell therapy for radiation induced xerostomia in previous head and neck cancer patients a phase ii randomized placebo controlled trial","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1158/1078-0432.CCR-23-3675","version":"Published Version"},"id":"S01-000.00-750377","identifier":[{"id":"38441659","type":"pmid"},{"id":"PMC11094414","type":"pmcid"},{"id":"85193249433","type":"scopus"}],"ids":["sdu-42b5c331-ec26-4e84-9b9e-843091514b56"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-F0E0377D730B6C8EFD4D5D6A893624C6"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1158/1078-0432.CCR-23-3675","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/263241471/2078.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namev