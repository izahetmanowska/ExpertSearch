ed"]},"sid":["au-3b1adcba-2e2a-4e68-a374-fe3f606506cd"],"src":["AU Aarhus University"],"title":"Septin9 is involved in septin filament formation and cellular stability.","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-163028","year":"2011","yearsub":"2011"}
{"abstract":"After the successful launch of CryoSat-2 in April 2010, the first direct validation campaign of the satellite is planned for spring 2011. DTU Space has been involved in ESA’s CryoSat Validation Experiment (CryoVEx) with airborne activities since 2003. To validate the prelaunch performance of the CryoSat radar altimeter (SIRAL), an airborne version of the SIRAL altimeter (ASIRAS) has been flown together with a laser scanner in 2006 and 2008. Of particular interest is to study the penetration depth of the radar altimeter over both land- and sea ice. This can be done by comparing the radar and laser measurements with in situ observations. Here, an overview of the prelaunch airborne campaigns is given, together with results of the ASIRAS performance over land- and sea ice. The observations, used in this study, are obtained from the Greenland ice sheet and from both multiyear and first year sea ice.","author_count":8,"contributors":["Skourup, Henriette","Hanson, Susanne","Hvidegaard, Sine Munk","Forsberg, René","Kildegaard Rose, Stine","Morris, Elizabeth M.","Sørensen, Louise Sandberg","Stenseng, Lars"],"cuid":["S01-000.00-371453"],"event":{"end":"2011-02-03","place":"Francati (Rome), it","start":"2011-02-01","title":"CryoSat Validation Workshop 2011","year":"2011"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","University of Cambridge"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-DMI"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-GV-DMI","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"airborne campaigns for cryosat prelaunch calibration and validation","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"id":"S01-000.00-371453","ids":["dtu-dfae241b-97f6-4a16-8e98-0e748ae983c7"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-5735F9C50061457E8AC35E8A24791460"],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Space Institute","Technical University of Denmark, National Space Institute, Geodynamics"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"dk","key":"dmi danish meteorological institute","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-DMI","l3nn":"DMI Danish Meteorological Institute","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DMI Danish Meteorological Institute","namevar":["Danish Meteorological Institute"],"nora_code":"DI-GV-DMI","used":1},{"affno":"3","country":"gb","key":"university of cambridge","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Cambridge","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Henriette","key":"skouruppau","last":"Skourup","locid":"f5fe613f-20e5-4a69-9eff-f03779801182","name":"Skourup, Henriette","orcid":"0000-0002-4468-8033","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Susanne","key":"hansonpau","last":"Hanson","name":"Hanson, Susanne","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sine Munk","key":"hvidegaardpau","last":"Hvidegaard","locid":"92b07d8f-692c-4ebb-bc40-f44224f3f143","name":"Hvidegaard, Sine Munk","orcid":"0000-0001-8159-6499","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"René","key":"forsbergpau","last":"Forsberg","locid":"be93c88f-cc39-43d8-bf6f-ff4787c55c23","name":"Forsberg, René","orcid":"0000-0002-7288-9545","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Stine","key":"kildegaardpoulsenpau","last":"Kildegaard Poulsen","locid":"9ddf2fb2-ac61-46a9-b2b4-f788d7e2cdf3","name":"Kildegaard Rose, Stine","name_org":"Kildegaard Poulsen, Stine","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Elizabeth M.","key":"morrispau","last":"Morris","name":"Morris, Elizabeth M.","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Louise Sandberg","key":"sørensenpau","last":"Sørensen","locid":"1c6cb90f-da30-48a2-872f-a94b8100749b","name":"Sørensen, Louise Sandberg","orcid":"0000-0002-3771-4061","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lars","key":"stensengpau","last":"Stenseng","locid":"c0f908ca-1192-4239-b399-ad14c4d9bc6d","name":"Stenseng, Lars","orcid":"0000-0003-4690-4200","rank":8,"rolecode":"pau"}],"pub":{"publisher":"European Space Agency","status":"p","subtitle":"CD","title":"Procedings of CryoSat Validation Workshop 2011"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-U","DI-U-ALL","Governmental Institutions","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-dfae241b-97f6-4a16-8e98-0e748ae983c7"],"src":["DTU Technical University of Denmark"],"title":"Airborne campaigns for CryoSat prelaunch calibration and validation","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-371453","year":"2011","yearsub":"2011"}
{"abstract":"Darier disease is an autosomal dominant genodermatosis caused by germline mutations in the ATP2A2 gene. Clinical expression is variable, including rare segmental phenotypes thought to be caused by postzygotic mosaicism. Genetic counseling of segmental Darier patients is complex, as risk of transmitting a nonsegmental phenotype to offspring is of unknown magnitude. We present the first in-depth molecular analysis of a mosaic patient with segmental disease, quantifying proportions of mutated and normal alleles in various tissues. Pyrosequence analysis of DNA from semen, affected and normal skin, peripheral leukocytes and hair revealed an uneven distribution of the mutated allele, from 14% in semen to 37% in affected skin. We suggest a model for segmental manifestation expression where a threshold number of mutated cells is needed for manifestation development. We further recommend molecular analysis of the ATP2A2 gene in semen of male patients with segmental Darier disease to improve genetic counseling.","author_count":6,"contributors":["Harboe, Theresa Larriba","Willems, Patrick","Jespersgaard, Cathrine","Binderup, Marie Louise Mølgaard","Sørensen, Flemming Brandt","Bisgaard, Søs Marie Luise"],"cuid":["S01-000.00-497692"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"mosaicism in segmental darier disease an in depth molecular analysis quantifying proportions of mutated alleles in various tissues","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1159/000328404","version":"Other Version"},"id":"S01-000.00-497692","identifier":[{"id":"80052475791","type":"scopus"},{"id":"21720150","type":"pmid"}],"ids":[