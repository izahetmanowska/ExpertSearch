{"author_count":5,"contributors":["Khateb, Heba","Sørensen, Rasmus Schøler","Meyer, Rikke Louise","Kjems, Jørgen","Sutherland, Duncan S"],"cuid":["S01-000.00-207129"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"nr","rtype":["clu"],"sorti":"study of multivalency in the interaction of aips with agrc in staphylococcus aureus via dna nanoscaffold of holliday junction","src":["au"],"src-code":["DI-U-AU"],"type":"dw","type-grp":["all","pub"]},"id":"S01-000.00-207129","ids":["au-8854605b-91e2-4c92-afa2-6650fb99ea15"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-354A92D64A17945B23C7C4751D4CE118"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Interdisciplinary Nanoscience Center, Interdisciplinary Nanoscience Center - INANO-Fysik, iNANO-huset"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Heba","key":"khatebpau","last":"Khateb","locid":"d98c6ee8-14ca-4dd9-afbb-71f6f71bed40","name":"Khateb, Heba","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rasmus Schøler","key":"sørensenpau","last":"Sørensen","locid":"dd13ff30-6bd7-4512-bc60-efa5c5b0ebdd","name":"Sørensen, Rasmus Schøler","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rikke Louise","key":"meyerpau","last":"Meyer","locid":"f1caa4f6-bc6e-459a-a976-8843c7ea7ff3","name":"Meyer, Rikke Louise","orcid":"0000-0002-6485-5134","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jørgen","key":"kjemspau","last":"Kjems","name":"Kjems, Jørgen","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Duncan S","key":"sutherlandpau","last":"Sutherland","locid":"5c5c563f-ca05-4219-b60d-8a3d6303ff2f","name":"Sutherland, Duncan S","rank":5,"rolecode":"pau"}],"pub":{"pages":"25","status":"u"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Unpublished"]},"sid":["au-8854605b-91e2-4c92-afa2-6650fb99ea15"],"src":["AU Aarhus University"],"title":"Study of Multivalency in the Interaction of AIPs with AgrC in Staphylococcus aureus via DNA nanoscaffold of Holliday junction .","type":"Working Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-207129","year":"2020","yearsub":"2020"}
{"abstract":"A catalog of common, intermediate and well-documented (CIWD) HLA-A, -B, -C, -DRB1, -DRB3, -DRB4, -DRB5, -DQB1 and -DPB1 alleles has been compiled from over 8 million individuals using data from 20 unrelated hematopoietic stem cell volunteer donor registries. Individuals are divided into seven geographic/ancestral/ethnic groups and data are summarized for each group and for the total population. P (two-field) and G group assignments are divided into one of four frequency categories: common (≥1 in 10 000), intermediate (≥1 in 100 000), well-documented (≥5 occurrences) or not-CIWD. Overall 26% of alleles in IPD-IMGT/HLA version 3.31.0 at P group resolution fall into the three CIWD categories. The two-field catalog includes 18% (n = 545) common, 17% (n = 513) intermediate, and 65% (n = 1997) well-documented alleles. Full-field allele frequency data are provided but are limited in value by the variations in resolution used by the registries. A recommended CIWD list is based on the most frequent category in the total or any of the seven geographic/ancestral/ethnic groups. Data are also provided so users can compile a catalog specific to the population groups that they serve. Comparisons are made to three previous CWD reports representing more limited population groups. This catalog, CIWD version 3.0.0, is a step closer to the collection of global HLA frequencies and to a clearer view of HLA diversity in the human population as a whole.","author_count":38,"contributors":["Hurley, Carolyn K.","Kempenich, Jane","Wadsworth, Kim","Sauter, Jürgen","Hofmann, Jan A.","Schefzyk, Daniel","Schmidt, Alexander H.","Galarza, Pablo","Cardozo, Maria B.R.","Dudkiewicz, Malgorzata","Houdova, Lucie","Jindra, Pavel","Sørensen, Betina Samuelsen","Jagannathan, Latha","Mathur, Ankit","Linjama, Tiina","Torosian, Tigran","Freudenberger, Rafi","Manolis, Anastasios","Mavrommatis, John","Cereb, Nezih","Manor, Sigal","Shriki, Nira","Sacchi, Nicoletta","Ameen, Reem","Fisher, Raewyn","Dunckley, Heather","Andersen, Irene","Alaskar, Ahmed","Alzahrani, Mohsen","Hajeer, Ali","Jawdat, Dunia","Nicoloso, Grazia","Kupatawintu, Pawinee","Cho, Louise","Kaur, Ashminder","Bengtsson, Mats","Dehn, Jason"],"cuid":["S01-000.00-223662"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Asia, Middle East","Europe, EU","Nordic","OECD"],"corresponding_author":["Hurley, Carolyn K."],"country":["Czechia","Saudi Arabia","Sweden","United States"],"glorg":["All Global Affiliations","Charles University","Georgetown University","King Abdulaziz University","University of West Bohemia","Uppsala University"],"keyword":["Alleles","Ethnic Groups","Gene Frequency","HLA"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"common intermediate and well documented hla alleles in world populations ciwd version 000000000003 000000000000 000000000000","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1111/tan.13811","version":"Published Version"},"id":"S01-000.00-223662","identifier":[{"id":"PMC7317522","type":"pmcid"},{"id":"31970929","type":"pmid"},{"id":"85078839466","type":"scopus"}],"ids":["au-a582979e-57c0-44f2-83db-e372d27de7c4"],"keyword":["HLA","alleles","ethnic groups","gene frequency"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-59489879F6587C8CBC65620D3FF82395"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1111/tan.13811","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.au.dk/ws/files/220333787/tan.13811.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":