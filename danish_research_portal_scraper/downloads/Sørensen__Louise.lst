singpau","last":"Wissing","name":"Wissing, Marie Louise Muff","rank":6,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"country":"dk","first":"Marianne Skovsager","key":"andersenpau","last":"Andersen","locid":"94aa4e0a-b026-469f-a635-4bad008d49d7","name":"Andersen, Marianne","name_org":"Andersen, Marianne Skovsager","orcid":"0000-0002-4603-9504","rank":7,"rolecode":"pau"},{"affno":"2","first":"Anne-Lis","key":"mikkelsenenglundpau","last":"Mikkelsen Englund","name":"Mikkelsen Englund, Anne-Lis","rank":8,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Anne Lis Mikkelsen","key":"englundpau","last":"Englund","name":"Englund, Anne Lis Mikkelsen","rank":8,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Louise Torp","key":"dalgaardpau","last":"Dalgaard","locid":"a219fdaf-f994-4a7a-beb8-1f353846ed5a","name":"Dalgaard, Louise Torp","orcid":"0000-0002-3598-2775","rank":9,"rolecode":"pau"}],"pmid":["33112812"],"pub":{"doi":"10.1530/ec-20-0195","issn":["20493614"],"issue":"11","journal":"Endocrine Connections","pages":"1075-1084","publisher":"BioScientifica Ltd.","status":"p","title":"Endocrine Connections","volume":"9"},"review":"Peer Reviewed","scoID":["2-s2.0-85097658293"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Hospitals","Other Research","Region Zealand","Region of Southern Denmark","Roskilde University","Universities","University of Southern Denmark","aleris hamlet hospital group"],"PST":["Published"]},"sid":["ruc-202c42ef-1cb6-4c5c-9d3f-8c9a65f9c6c7","sdu-acbb78bd-1803-46d9-94e0-2756365621ce"],"src":["RUC Roskilde University","SDU University of Southern Denmark"],"title":"Metformin decreases miR-122, miR-223 and miR-29a in women with polycystic ovary syndrome","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-095.08-048175","year":"2020","yearsub":"2020"}
{"abstract":"We use remotely sensed ice velocities in combination with observations of surface elevation and glacier-area change to investigate the dynamics of Hagen Bræ, North Greenland in high detail over the last 35 years. From our data, we can establish for the first time that Hagen Bræ is a surge-type glacier with characteristics of both Alaskan and Svalbard-type surging glaciers. We argue, that the observed surge was preconditioned by the glacier geometry and triggered by englacially stored meltwater. At present, the glacier is in a transitional state between active and quiescence phases and is not building up to its pre-surge geometry. We suggest, that the glacier is adjusting to the loss of its floating section, general thinning and changes in fjord conditions that occurred over the study period which are unrelated to the surge behavior. The high temporal resolution of the ice-velocity data gives insight to the sub-annual glacier flow.","author_count":8,"contributors":["Solgaard, A.M.","Simonsen, Sebastian Bjerregaard","Grinsted, A.","Mottram, R.","Karlsson, N.B.","Hansen, K.","Kusk, Anders","Sørensen, Louise Sandberg"],"cuid":["S02-097.86-035639"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Solgaard, A.M."],"keyword":["Glacier surge","Ice dynamics","Ice flow","North Greenland","Remote sensing"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-DMI","DI-GV-GEUS"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-GV-DMI","DI-GV-GEUS","DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"hagen bræ a surging glacier in north greenland 000000000035 years of observations","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1029/2019GL085802","version":"Published Version"},"id":"S02-097.86-035639","identifier":[{"id":"32713980","type":"pmid"},{"id":"000529097700009","type":"wos"},{"id":"PMC7375144","type":"pmcid"},{"id":"85082527275","type":"scopus"}],"ids":["dtu-84a8b16f-75e3-4f09-8315-97726dc9615e","ku-d73773b6-bcaf-4c18-a4d6-f5f9a2d0398a"],"keyword":["Glacier surge","Ice dynamics","Ice flow","North Greenland","Remote sensing"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-997DE587AFC734C2C7E17B69D4092041"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/210404655/2019GL085802.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1029/2019GL085802","version":"Published Version"},{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/241097364/2019GL085802.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Niels Bohr Institute, Physics of Ice, Climate and Earth"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"geus geological survey of denmark and greenland","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-GEUS","l3nn":"GEUS Geological Survey of Denmark and Greenland","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"GEUS Geological Survey of Denmark and Greenland","namevar":["Geological Survey of Denmark and Greenland"],"nora_code":"DI-GV-GEUS","used":1},{"affno":"3","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical 