":"1","corresponding":null,"first":"B.","key":"gutknechtpau","last":"Gutknecht","name":"Gutknecht, B.","rank":25,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"K.","key":"novotnypau","last":"Novotny","name":"Novotny, K.","rank":26,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"A.","key":"grohpau","last":"Groh","name":"Groh, A.","rank":27,"rolecode":"pau"},{"affno":"11","corresponding":null,"first":"J.","key":"benvenistepau","last":"Benveniste","name":"Benveniste, J.","rank":28,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","sdg":["13. Climate Action","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-985c4460-05f7-4d12-be31-c348a3682aa2"],"src":["DTU Technical University of Denmark"],"title":"Global Sea Level Budget Assessment: Preliminary Results From ESA's CCI Sea Level Budget Closure Project","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-349999","year":"2018","yearsub":"2018"}
{"abstract":"Background: High-intensity interval training is an effective and popular training regime but its feasibility in untrained adults with asthma is insufficiently described. Objective: The randomized controlled trial 'EFFORT Asthma' explored the effects of behavioural interventions including high-intensity interval training on clinical outcomes in nonobese sedentary adults with asthma. In this article we present a sub analysis of data aiming to evaluate if patients' pre-intervention levels of asthma control, FEV1, airway inflammation and airway hyperresponsiveness (AHR) predicted their training response to the high-intensity interval training program, measured as increase in maximal oxygen consumption (VO2max). Design: We used data from the EFFORT Asthma Study. Of the 36 patients randomized to the 8-week exercise intervention consisting of high-intensity training three times per week, 29 patients (45% females) completed the study and were included in this data analysis. Pre-intervention assessment included the asthma control questionnaire (ACQ), spirometry, fractional exhaled nitric oxide (FeNO) and AHR to mannitol. VO2 max was measured during an incremental cycle test. Results: The majority of included patients had partly or uncontrolled asthma reflected by a mean (SD) ACQ at 1.7 (0.6). Median (IQR) FeNO was 28.5 (23.8) ppb and 75% had a positive mannitol test indicating AHR. The association between patients' training response measured as increase in VO2max and pre-intervention ACQ scores was not statistically significant (p = 0.49). Likewise, the association between patients' increase in VO2max and FeNO as well as AHR was not statistically significant (p = 0.80 and p = 0.58). Conclusions: Included asthma patients could adhere to the high-intensity interval protocol and improve their VO2max regardless of pre-intervention levels of asthma control, airway inflammation and AHR.","author_count":6,"contributors":["Tønnesen, Louise Lindhardt","Sørensen, E D","Hostrup, Morten","Porsbjerg, Celeste","Bangsbo, Jens","Backer, Vibeke"],"cuid":["S01-000.00-506718"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Asthma","Asthma control","Exercise","Faculty of Science","High intensity interval training"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"feasibility of high intensity training in asthma","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1080/20018525.2018.1468714","version":"Published Version"},"id":"S01-000.00-506718","identifier":[{"id":"29785255","type":"pmid"},{"id":"85063651813","type":"scopus"},{"id":"PMC5954482","type":"pmcid"}],"ids":["ku-bdc9c8e0-f934-4661-9cea-73da548dec19"],"keyword":["Asthma","Asthma control","Exercise","Faculty of Science","High-intensity interval training"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-5846E31A05857BBCED9054B70B95E530"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/196875953/Toennesen_et_al_European_Clinical_Respiratory_Journal_2018._Vol_5_1_1468714.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1080/20018525.2018.1468714","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Bispebjerg and Frederiksberg"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Nutrition, Exercise and Sports, The August Krogh Section for Human Physiology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Louise Lindhardt","key":"tønnesenpau","last":"Tønnesen","name":"Tønnesen, Louise Lindhardt","rank":1,"rolecode":"pau"},{"affno":"1","first":"E D","key":"sørensenpau","last":"Sørensen","name":"Sørensen, E D","rank":2,"rolecode":"pau"},{"affno":"2","first":"Morten","key":"hostruppau","last":"Hostrup","locid":"2c96b73f-d427-45db-af64-9caf29101092","name":"Hostrup, Morten","orcid":"0000-0002-6201-2483","rank":3,"rolecode":"pau"},{"affno":"2","first":"Celeste","key":"porsbjergpau","last":"Porsbjerg","locid":"990b2125-b509-42b3-8fde-7014125da044","name":"Porsbjerg, Celeste","rank":4,"rolecode":"pau"},{"affno":"2","first":"Jens","key":"bangsbopau","last":"Bangsbo","locid":"24839560-f889-42a6-9b73-97b69f101548","name":"Bangsbo, Jens","orcid":"0000-0003-1305-9274","rank":5,"rolecode":"pau"},{"affno":"2","first":"Vibeke","key":"backerpau","last":"Backer","locid":"8ea3c13b-5a32-4002-b7bb-4621659a1827","name":"Backer, Vibeke","rank":6,"rolecode":"pau"}],"pmid":["29785255"],"pub":{"doi":"10.1080/20018525.2018.1468714","issn":["20018525"],"issue":"1","journal":"European Clinical Respiratory Journal","paperid":"1468714","status":"p","title":"European Clinical Respiratory Journal","volume":"5"},"review":"Peer Reviewed","scoID":["2-s2.0-85063651813"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-bdc9c8e0-f934-4661-9cea-73da548dec19"],"src":["KU University of Copenhagen"],"title":"Feasibility of high-intensity training in asthma","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-506718","year":"2018","yearsub":"2018"}
{"abstract":"In the last decades, a well-established equine wound model has been used to study fibroproliferative wound healing disorders. The aim of this study was to characterize the degree of discomfort of wounding and sampling in an equine excisional wound model by evaluating systemic and local inflammatory responses and signs of pain. A total of 12 cutaneous wounds, three on each shoulder and each metatarsus, were created in a standing surgical procedure. Wounds were biopsied on days 2, 4, 7, 14, 21, and 28 after surgery. Clinical parameters (rectal temperature, heart rate, respiratory frequency) and blood levels of white blood cell, serum amyloid A, fibrinogen, and iron were monitored to evaluate the systemic inflammatory response. Local signs of inflammation (swelling, heat, pain) were subjectively assessed, the limb circumference recorded, and temperature of the wound measured by thermometry. Pain was evaluated by a composite measure pain scale (CMPS). The results demonstrated that the wounding procedure elicits an inflammatory response. Day 1 after surgery, two horses scored 2 and 7 units (of 27 units), respectively, on the CMPS, and day 8 after surgery, one horse scored 3 units. The biopsy procedure did not elicit local or systemic signs of inflammation. Based on these findings, it appears that the equine experimental wound model causes mild discomfort and pain manifestations. This information is important for researchers, who consider using the model. To justify the use of an animal model, it should be demonstrated that the expected benefits of the research outweigh the discomfort imposed to the animal.","author_count":5,"contributors":["Bundgaard, Louise","Sørensen, Mette Aamand","Nilsson, Tina","Salling, Elin","Jacobsen, Stine"],"cuid":["S01-000.00-506770"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Equine","Inflammation","Skin temperature","Wound model"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"evaluation of systemic and local inflammatory parameters and manifestations of pain in an equine experimental wound model","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-506770","identifier":[{"id":"85048577758","type":"scopus"},{"id":"000441148600014","type":"wos"},{"id":"31256894","type":"pmid"}],"ids":["ku-bddfa793-cd9b-4eec-b6ff-ff2ec93d3478"],"keyword":["Composite measure pain scale","Equine","Exuberant granulation tissue","Inflammation","Skin temperature","Wound model"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-59D075DD5C9608FFA9F73BF4FE813CAC"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Veterinary Clinical Sciences, Section for Medicine and Surgery"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Louise","key":"bundgaardpau","last":"Bundgaard","locid":"fac2f738-731c-4ca5-9369-45d6f4486fe2","name":"Bundgaard, Louise","orcid":"0000-0002-0396-883X","rank":1,"rolecode":"pau"},{"affno":"1","first":"Mette Aa.","key":"sorensenpau","last":"Sorensen","locid":"c3ce4ae2-7fda-40ef-8fa7-ff09dc2da244","name":"Sørensen, Mette Aamand","name_org":"Sorensen, Mette Aa.","rank":2,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Tina","key":"nilssonpau","last":"Nilsson","locid":"b4d1198e-2f44-42f6-849f-7eaaf065acef","name":"Nilsson, Tina","rank":3,"rolecode":"pau"},{"affno":"1","country":"dk","f