,{"affno":"1","corresponding":null,"first":"Rasmus H","key":"pihlsbechrasmushpau","last":"Pihlsbech","name":"Pihlsbech, Rasmus H","rank":14,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Caroline B","key":"sørensencarolinebpau","last":"Sørensen","name":"Sørensen, Caroline B","rank":15,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Tore L","key":"rønntorelpau","last":"Rønn","name":"Rønn, Tore L","rank":16,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Alexander B","key":"larsenalexanderbpau","last":"Larsen","name":"Larsen, Alexander B","rank":17,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Laurits R","key":"caspersenlauritsrpau","last":"Caspersen","name":"Caspersen, Laurits R","rank":18,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mathias Æ","key":"møllermathiasæpau","last":"Møller","name":"Møller, Mathias Æ","rank":19,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Chris R","key":"sixhøjchrisrpau","last":"Sixhøj","name":"Sixhøj, Chris R","rank":20,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Niels","key":"frimodtmøllernielspau","last":"Frimodt-Møller","name":"Frimodt-Møller, Niels","rank":21,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Janne K","key":"klitgaardjannekudskpau","last":"Klitgaard","locid":"a0230a75-f632-4365-b9d1-0d17d2d01551","name":"Klitgaard, Janne Kudsk","name_org":"Klitgaard, Janne K","orcid":"0000-0001-5255-2980","rank":22,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Thomas E","key":"andersenthomasemilpau","last":"Andersen","locid":"87fae7cd-ed6a-4d21-80cc-e13da9f91099","name":"Andersen, Thomas Emil","name_org":"Andersen, Thomas E","orcid":"0000-0001-9453-1141","rank":23,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Carsten U","key":"nielsencarstenuhdpau","last":"Nielsen","locid":"69a90973-6315-4248-a49e-c6e0413b526a","name":"Nielsen, Carsten Uhd","name_org":"Nielsen, Carsten U","orcid":"0000-0001-5776-6865","rank":24,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Poul","key":"nielsenpoulpau","last":"Nielsen","locid":"a0f6be7e-096f-4971-bc4c-6f83a2ed85f2","name":"Nielsen, Poul","orcid":"0000-0001-7946-311X","rank":25,"rolecode":"pau"}],"pmid":["40241444"],"pub":{"doi":"10.1021/acs.jmedchem.5c00152","issn":["00222623","15204804"],"issn_org":["00222623"],"issue":"9","journal":"Journal of Medicinal Chemistry","pages":"9479-9500","publisher":"American Chemical Society","status":"p","title":"Journal of Medicinal Chemistry","volume":"68"},"review":"Peer Reviewed","scoID":["2-s2.0-105003412614"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-b5e2499a-614e-4b2f-b5e1-dc3c1357d2ac"],"src":["SDU University of Southern Denmark"],"title":"Linker and Head-Group Exploration of Anti-MRSA Triaromatic Pleuromutilins","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-821594","year":"2025","yearsub":"2025"}
{"abstract":"Surgical stress is gaining increasing focus in surgical oncology due to its impact on complications, prognosis, and survival. The neutrophil-to-lymphocyte ratio (NLR) is a recognized biomarker reflecting inflammation and immune response, key aspects of surgical stress. Sentinel lymph node biopsy (SLNB) and wide local excision (WLE) are considered minimally invasive procedures used in the management of melanoma. Yet, the surgical stress response of WLE and SLNB remains unexplored. This study aims to investigate perioperative changes in the NLR as a marker of surgical stress in patients with melanoma undergoing WLE and SLNB. This prospective pilot study investigated NLR as a marker of surgical stress in patients (n = 20) with melanoma undergoing WLE and SLNB. NLR was calculated from the plasma differential count and measured preoperatively and at 2 and 6 h postoperatively. Surgical stress was categorized into four groups according to the NLR values: No stress, mild, moderate, and severe stress. Paired t-tests tested differences between time points. Mean NLR increases from 1.94 (±0.86) preoperatively to 9.5 (±4.39) at 2 h (P < 0.001) and further increases to 16.04 (±11.11) at 6 h (P = 0.02) postoperatively. This increase reflects a shift from no systemic stress (NLR: 1-3) to a moderate (NLR: 8-18) response, approaching severe thresholds. Changes in NLR are driven by significant neutrophilia and lymphocytopenia. Despite minor procedures, WLE and SLNB elicit a substantial surgical stress response. NLR may serve as a valuable biomarker for monitoring surgical stress in melanoma surgery, with potential implications for surgical and oncologic outcomes.","author_count":3,"contributors":["Kristjansen, Karoline Assifuah","Birk-Sørensen, Lene","Bønnelykke-Behrndtz, Marie Louise"],"cuid":["S01-000.00-824795"],"filters":{"added":"2025-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Kristjansen, Karoline Assifuah"],"keyword":["Melanoma","Neutrophil to lymphocyte ratio","Prospective Studies","Sentinel Lymph Node Biopsy","Surgical oncology","Surgical pathology","Surgical stress"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-NDR"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-HO-NDR","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"perioperative neutrophil to lymphocyte ratio in patients with melanoma a pilot study assessing surgical stress after sentinel lymph node biopsy","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/105010359901","version":"Other Version"},"id":"S01-000.00-824795","identifier":[{"id":"40581943","type":"pmid"},{"id":"105010359901","type":"scopus"}],"ids":["au-32471af5-900f-4404-8d01-612da9920ecf"],"keyword":["melanoma","neutrophil-to-lymphocyte ratio","prospective studies","sentinel lymph node biopsy","surgical oncology","surgical pathology","surgical stress"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-CDFE390E76457148E8305271A4BC4003"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Plastic and Breast surgery"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"north denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-NDR","l3nl":"North Denmark Region","l3nn":"North Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"North Denmark Region","namevar":["Aalborg University Hospital"],"nora_code":"DI-HO-NDR","used":1}],"person":[{"affno":"1 2","corresponding":null,"country":"dk","first":"Karoline Assifuah","key":"kristjansenpau","last":"Kristjansen","locid":"a861c6c8-18d2-40bd-b3ff-25bb41087a6c","name":"Kristjansen, Karoline Assifuah","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lene","key":"birksørensenpau","last":"Birk-Sørensen","name":"Birk-Sørensen, Lene","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Marie Louise","key":"bønnelykkebehrndtzpau","last":"Bønnelykke-Behrndtz","name":"Bønnelykke-Behrndtz, Marie Louise","rank":3,"rolecode":"pau"}],"pmid":["40581943"],"pub":{"doi":"10.1097/cmr.0000000000001052","issn":["09608931","14735636"],"issn_org":["09608931"],"issue":"5","journal":"Melanoma Research","pages":"339-343","publisher":"Lippincott Williams and Wilkins","status":"p","title":"Melanoma Research","volume":"35"},"review":"Peer Reviewed","scoID":["2-s2.0-105010359901"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Universities"],"PST":["Published"]},"sid":["au-32471af5-900f-4404-8d01-612da9920ecf"],"src":["AU Aarhus University"],"title":"Perioperative neutrophil-to-lymphocyte ratio in patients with melanoma : a pilot study assessing surgical stress after sentinel lymph node biopsy","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-824795","year":"2025","yearsub":"2025"}
{"abstract":"INTRODUCTION: The global prevalence of people living with overweight has tripled since 1975 and more than 40% of Danish women enter pregnancy being overweight. With the increasing rates of obesity observed in children, adolescents and adults, there is an urgent need for preventive measures. Risk factors for childhood obesity include maternal overweight or obesity before conception and excessive weight gain during pregnancy. Interventions aimed at modifying maternal lifestyle during pregnancy have demonstrated minimal positive or no impact on the health of the children. The 'healthy lifestyle before and during pregnancy to prevent childhood obesity - the PRE-STORK trial' aims to provide insights into the effect of a lifestyle intervention initiated before conception and continued during pregnancy in women with overweight or obesity, on neonatal adiposity in their children. METHODS AND ANALYSIS: In this randomised, two-arm, parallel-group, controlled trial, we will include 360 women with overweight or obesity (aged 18-40; body mass index 25-44 kg/m2) and their partners. The women will be randomised to receive either standard of care or a lifestyle intervention focused on preconception body weight reduction, regular physical exercise, healthy diet and support from a mentor before and during pregnancy. The primary outcome is the difference in neonatal adiposity measured in their children at birth. Children conceived during the trial will constitute a birth cohort, monitoring the effects on their health until the age of 18 years. ETHICS AND DISSEMINATION: The trial has been approved by the Regional Committee on Health Research Ethics in the Capital Region of Denmark (identification number H-22011403) and will be conducted in agreement with the Declaration of Helsinki. All results, whether positive, negative and inconclusive, will be disseminated at national or international scientific meetings and in peer-reviewed scientific journals. TRIAL REGISTRATION NUMBER: ClinicalTrials.gov: NCT05578690 (October 2022).","author_count":21,"contributors":["Kornerup, Nina","Danielsen, Julie Hagstrøm","Sahl, Ronni Eg","Pico, Majken Lillholm","Johansen, Mette Yun","Knop, Filip K.","Bønnelykke, Klaus","Bergholt, Thomas","Kelstrup, Louise","Foghsgaard, Signe","Ghauri, Nida","Grønlund, Emilie","Lund, Lærke","Vinter, Christina Anne","Forman, Julie Lyng","Barrès, Romain","Kragelund Nielsen, Karoline","Andersen, Andreas","Torekov, Signe Sørensen","Groth Grunnet, Louise","Vilsbøll, Tina"],"cuid":["S02-100.00-793913"],"filters":{"added":"2025-04","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","OECD"],"corresponding_author":["Groth Grunnet, Louise","Vilsbøll, Tina"],"country":["France"],"glorg":["All Global Affiliations","University of Côte d'Azur"],"keyword":["Adolescent","Adult","Body Mass Index","Denmark","Exercise","Female","Healthy Lifestyle","Humans","Infant Newborn","Overweight prevention control","Pediatric Obesity prevention control","Preconception Care methods","Pregnancy","Pregnancy Complications prevention control","Randomized Controlled Trials as Topic","Young Adult"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-PR","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-SDR","DI-HO-STENO"],"OT":["Steno Diabetes Centre, Gentofte, Denmark."],"PR":["DI-PR-ALL","DI-PR-NOVO"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-SDR","DI-HO-STENO","DI-PR-NOVO","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"healthy lifestyle before and during pregnancy to prevent childhood obesity study protocol for a parallel group randomised trial the pre stork trial","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1136/bmjopen-2024-087895","versi