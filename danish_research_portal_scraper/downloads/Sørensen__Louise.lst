","name":"Heick, Thies Marten","rank":13,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Nana","key":"vagndorfpedh","last":"Vagndorf","name":"Vagndorf, Nana","rank":14,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Peter","key":"hartvigpedh","last":"Hartvig","name":"Hartvig, Peter","rank":15,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Steen","key":"sørensenpedh","last":"Sørensen","name":"Sørensen, Steen","rank":16,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["9788793643321"],"issn":["22451684"],"issue":"117","pages":"123-124","publisher":"DCA - Nationalt Center for Fødevarer og Jordbrug","series":"DCA rapport","status":"p","title":"Applied Crop Protection 2017"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-c6b4072e-52cf-4ae0-b98b-432ad3b00a9f"],"src":["AU Aarhus University"],"title":"Results from crop protection trials in minor crops in 2017","type":"Report Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-242769","year":"2018","yearsub":"2018"}
{"abstract":"This study develops a baseline model specifying expected relationships between consumer motivations (health, environmental, and social consciousness), organic food identity, and organic food behavior. Based on an online survey of 1176 Danish food consumers, we investigate whether these relationships are influenced by different levels of personal values (self-transcendence, openness to change, self-enhancement, and conservation). We find that health consciousness has a higher positive influence on organic food identity with higher levels of all four investigated personal values. When openness to change is low, health consciousness has a positive effect on intentional organic food behavior through organic food identity, whereas social consciousness has a negative effect on intentional organic food behavior through organic food identity. Our results provide guidance to those seeking to segment organic food markets based on consumers’ motivations and values.","author_count":3,"contributors":["Hansen, Torben","Ingerslev Sørensen, Maria","Riwerts Eriksen, Marie-Louise"],"cuid":["S01-000.00-293470"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Consumer organic food motivations","Organic food behavior","Organic food identity","Personal values"],"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Mondelez International"],"U":["DI-U-ALL","DI-U-CBS"]},"level3all":["DI-U-CBS"]},"review":"pr","rtype":["clu"],"sorti":"how the interplay between consumer motivations and values influences organic food identity and behavior","src":["cbs"],"src-code":["DI-U-CBS"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://research-api.cbs.dk/ws/files/58362825/torben_hansen_et_al_how_the_interplay_acceptedmanuscript.pdf","version":"Authors Final Version"},"id":"S01-000.00-293470","identifier":[{"id":"85034601859","type":"scopus"}],"ids":["cbs-be62b345-5759-4dbd-aa10-ff5e5771d974"],"keyword":["Consumer organic food motivations","Organic food behavior","Organic food identity","Personal values"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-4-BFE3A20CAB58F6649530CAFF48FFC510"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://research-api.cbs.dk/ws/files/58362825/torben_hansen_et_al_how_the_interplay_acceptedmanuscript.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Social Science (SOC)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of Marketing"],"nora_code":"DI-U-CBS","used":1},{"affno":"2","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Mondelez International"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Torben","key":"hansenpau","last":"Hansen","locid":"a5307dd5-fe40-41e2-845c-accb74da03f0","name":"Hansen, Torben","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Maria","key":"ingerslevsørensenpau","last":"Ingerslev Sørensen","name":"Ingerslev Sørensen, Maria","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Marie-Louise","key":"riwertseriksenpau","last":"Riwerts Eriksen","name":"Riwerts Eriksen, Marie-Louise","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.foodpol.2017.11.003","issn":["03069192","18735657"],"issn_org":["03069192"],"journal":"Food Policy","pages":"39-52","publisher":"Elsevier","status":"p","title":"Food Policy","volume":"74"},"review":"Peer Reviewed","scoID":["2-s2.0-85034601859"],"search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","Copenhagen Business School","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["cbs-be62b345-5759-4dbd-aa10-ff5e5771d974"],"src":["CBS Copenhagen Business School"],"title":"How the Interplay between Consumer Motivations and Values Influences Organic Food Identity and Behavior","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-293470","year":"2018","yearsub":"2018"}
{"abstract":"A long, unbroken sequence of satellite altimetry elevation changes is an essential climate variable. Here,we present the surface elevation change (SEC) record provided in the ESA Greenland ice sheet CCI project, as 5-year running means spanning back to 1992. The 5-year running mean is chosen to show the imprint of climate change on the Greenland ice sheet surface elevation change and limits the imprint of weather variability. We mainly focus on the novel results from ESA's Cryosat- 2 and the French-Indian SARAL/ALtiKa satellite, as this latest generation of radar altimeters provides new opportunities for monitoring Greenland ice sheet SEC. The orbit of Cryosat-2 enables the generation of a higher temporal-resolution data product from Ku-band radar altimetry; a 2-year running mean SEC. This 2-year product shows the inter-annual variability in weather and its imprint in surface elevation. The observational period of SARAL/ALtiKa satellite has now matured, and an experimental SEC product from Ka-band altimetry is being provided in the Greenland ice sheet CCI. The Kaband radar altimetry is less subject to surface penetration in firn covered areas, and map changes in snowfall in the interior region of the Greenland ice sheet. The Greenland ice sheet CCI now provides 11 maps of Greenland SEC generated from Cryosat-2 or SARAL/ALtiKa data. All giving insight into the complex nature of the changing Greenland ice sheet. The emerging patterns from comparing both Cryosat-2 5- year vs. 2-year SEC and Ku-band vs. Ka-band SEC may relate to the interplay between the surface mass balance and internal ice sheet dynamics.","author_count":4,"contributors":["Simonsen, Sebastian Bjerregaard","Khvorostovsky, K.","Sørensen, Louise Sandberg","Forsberg, René"],"cuid":["S01-000.00-329912"],"event":{"end":"2018-09-29","place":"pt","start":"2018-09-24","title":"25 years of progress in radar altimetry symposium","year":"2018"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, Non-EU"],"country":["Russia"],"glorg":["All Global Affiliations","Russian State Hydrometeorological University"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"greenland cci surface elevation change products from cryosat 000000000002 and saral altika","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/164310849/25YPRA_Abstract_Book.pdf","version":"Published Version"},"id":"S01-000.00-329912","identifier":[{"id":"85042533774","type":"scopus"}],"ids":["dtu-55460943-e89f-4e70-8905-dbc336f1036b"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-C3C237DC15E26A1F492AC19C460227B2"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/164310849/25YPRA_Abstract_Book.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Space Institute","Technical University of Denmark, National Space Institute, Geodynamics"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"ru","key":"russian state hydrometeorological university","loc":["Russia","Europe, Non-EU"],"name":"Russian State Hydrometeorological University","used":1}],"person":[{"affno":"1","corresponding":null,"first":"S.","key":"simonsenpau","last":"Simonsen","locid":"d088b945-224e-4fd3-a871-022cc71c5cb1","name":"Simonsen, Sebastian Bjerregaard","name_org":"Simonsen, S.","orcid":"0000-0001-9569-1294","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"K.","key":"khvorostovskypau","last":"Khvorostovsky","name":"Khvorostovsky, K.","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"L.","key":"sandbergsørensenpau","last":"Sandberg Sørensen","locid":"1c6cb90f-da30-48a2-872f-a94b8100749b","name":"Sørensen, Louise Sandberg","name_org":"Sandberg Sørensen, L.","orcid":"0000-0002-3771-4061","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"R.","key":"forsbergpau","last":"Forsberg","locid":"be93c88f-cc39-43d8-bf6f-ff4787c55c23","name":"Forsberg, René","name_org":"Forsberg, R.","orcid":"0000-0002-7288-9545","rank":4,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","sdg":["13. Climate Action","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-55460943-e89f-4e70-8905-dbc336f1036b"],"src":["DTU Technical University of Denmark"],"title":"Greenland CCI Surface Elevation Change Products from Cryosat-2 and SARAL/ALtiKa","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-329912","year":"2018","yearsub":"2018"}
{"abstract":"The Greenland ice sheet has experienced an average mass loss of 142 ± 49 Gt/yr from 1992 to 2011 (Shepherd et al. 2012), making it a significant contributor to sea-level rise. Part of the ice- sheet mass loss is the result of increased dynamic response of outlet glaciers (Rignot et al. 2011). The ice discharge from outlet glaciers can be quantified by coincident measurements of ice velocity and ice thickness (Thomas et al. 2000; van den Broeke et al. 2016). As part of the Programme for monitoring of the Greenland Ice Sheet (PROMICE; Ahlstrøm et al. 2008), three airborne surveys were carried out in 2007, 2011 and 2015, with the aim of measuring the changes in Greenland ice-sheet thicknesses. The purpose of the airborne surveys was to collect data to assess the dynamic mass loss of the Greenland ice sheet (Andersen et al. 2015). Here, we present these datasets of observations from ice-penetrating radar and airborne laser scanning, which, in combination, make us able to determine the ice thickness precisely. Surface-elevation changes between surveys are also presented, although we do not provide an in-depth scientific interpretation of these.","author_count":10,"contributors":["Sørensen, Louise Sandberg","Simonsen, Sebastian Bjerregaard","Forsberg, René","Stenseng, Lars","Skourup, Henriette","Kristensen, Steen Savstrup","Colgan, William"],"cuid":["S01-000.00-362701"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Current research","Denmark","Greenland"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-GEUS"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-GV-GEUS","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"circum greenland ice thickness measurements collected during promice airborne surveys in 000000002007 000000002011 and 000000002015","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/151910662/PROMICE_paper_GEUS.pdf","version":"Published Version"},"id":"S01-000.00-362701","identifier":[{"id":"85069469137","type":"scopus"}],"ids":["dtu-c2726aa3-41e7-49de-a0a1-b737a1eb4475"],"keyword":["Current research","Denmark","Geological Survey of Denmark and Greenland","Greenland","Survey organisations"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-E7DFB33BE79AF152B527464D1081A04F"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/151910662/PROMICE_paper_GEUS.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Space Institute","Technical University of Denmark, National Space Institute, Geodynamics"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"dk","key":"geus geological survey of denmark and greenland","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-GEUS","l3nn":"GEUS Geological Survey of Denmark and Greenland","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"GEUS Geological Survey of Denmark and Greenland","namevar":["Geological Survey of Denmark and Greenland"],"nora_code":"DI-GV-GEUS","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Louise Sandberg","key":"sørensenpau","last":"Sørensen","locid":"1c6cb90f-da30-48a2-872f-a94b8100749b","name":"Sørensen, Louise Sandberg","orcid":"0000-0002-3771-4061","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sebastian B.","key":"simonsenpau","last":"Simonsen","locid":"d088b945-224e-4fd3-a871-022cc71c5cb1","name":"Simonsen, Sebastian Bje