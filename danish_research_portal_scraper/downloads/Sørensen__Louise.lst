:"DI-PR-SEGES","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Martin Tang","key":"sørensenpau","last":"Sørensen","locid":"fefc1862-587c-4b1f-9e20-694246b18221","name":"Sørensen, Martin Tang","orcid":"0000-0002-0523-4282","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Per","key":"tybirkpau","last":"Tybirk","name":"Tybirk, Per","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anne Louise Frydendahl","key":"hellwingpau","last":"Hellwing","locid":"ad65c0e8-8a1c-4f17-bb65-80aec2189e32","name":"Hellwing, Anne Louise Frydendahl","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Christian Friis","key":"børstingpau","last":"Børsting","locid":"335191b3-2ebe-47f4-b7c9-9fc3d198044e","name":"Børsting, Christian Friis","rank":4,"rolecode":"pau"}],"pub":{"status":"X"},"review":"Undetermined","search":{"DAF":["Aarhus University","All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Private Research","Universities"],"PST":["Undefined"]},"sid":["au-66ee1d26-abf3-47d8-9a18-c10f5f521395"],"src":["AU Aarhus University"],"title":"Kapitel 2 Næringsstofudskillelse fra svin, ab dyr – Normtal for husdyrgødning 2021/2022","type":"Other-Internet Publication","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-188091","year":"2022","yearsub":"2022"}
{"abstract":"Introduction: Cardiovascular disease is the major cause of mortality in non-alcoholic fatty liver disease (NAFLD), a disease affecting one quarter of the world's population. Coagulation imbalance may be a contributing factor but is yet to be convincingly disclosed. Aim: To perform an extensive mapping of the hemostatic system; primary and secondary hemostasis and the fibrinolytic system in non-diabetic NAFLD patients. Materials and methods: Twenty-five non-diabetic, biopsy-proven NAFLD patients [12 simple steatosis; 13 non-alcoholic steatohepatitis (NASH)] investigated by a comprehensive panel of coagulation and fibrinolysis tests in a cross-sectional study. Fifty age- and sex-matched healthy persons served as controls for each of the dynamic analyses: platelet aggregation, thrombin generation, fibrin formation and lysis. Body composition, insulin resistance makers, and liver fat assessed by proton density magnetic resonance imaging were measured in the patients. Results: Fibrinolytic function was impaired in simple steatosis [median 50% clot lysis time 1123 (min–max, 618–1967) s] and NASH [1448 (521–2618) s] compared to healthy controls [403 (184–1179) s] (p < 0.0001). Plasminogen activator inhibitor-1 (PAI-1) increased stepwise above reference interval from simple steatosis [54 (29–80) ng/ml] to NASH patients [109 (65–153) ng/ml; p = 0.03]. Impaired fibrinolysis correlated with hepatic fat fraction and insulin resistance; PAI-1 correlated with obesity and insulin resistance (ρ ≥ 0.42; p ≤ 0.04). Platelet aggregation, coagulation factors, natural anticoagulants, and thrombin generation were comparable to healthy controls and established reference intervals. Conclusions: NAFLD patients had impaired fibrinolysis without significant prothrombotic changes in coagulation. The impact of this abnormality on the increased cardiovascular risk remains to be investigated.","author_count":5,"contributors":["Eriksen, Peter Lykke","Thomsen, Karen Louise","Sørensen, Michael","Vilstrup, Hendrik","Hvas, Anne-Mette"],"cuid":["S01-000.00-234715"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Eriksen, Peter Lykke"],"keyword":["Fibrinolysis","Non alcoholic fatty liver disease","Plasminogen Activator Inhibitor 1","Platelet Aggregation","Thrombin generation"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"impaired fibrinolysis without hypercoagulability characterises patients with non alcoholic fatty liver disease","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.thromres.2022.02.023","version":"Published Version"},"id":"S01-000.00-234715","identifier":[{"id":"35256195","type":"pmid"},{"id":"85125743276","type":"scopus"}],"ids":["au-b8b4dd17-1fdc-4dec-b533-96278f393757"],"keyword":["Fibrinolysis","Non-alcoholic fatty liver disease","Plasminogen activator inhibitor-1","Platelet aggregation","Thrombin generation"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-DDF5CAAA94512E7B4A2051D37B81C858"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.au.dk/ws/files/326132966/Impaired_fibrinolysis_without_hypercoagulability_characterises_patients_with_non_alcoholic_fatty_liver_disease.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.thromres.2022.02.023","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Hepatology and Gastroenterology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Peter Lykke","key":"eriksenpau","last":"Eriksen","locid":"02b5f3f7-8692-403b-9a17-1dc588d638e7","name":"Eriksen, Peter Lykke","orcid":"0000-0003-1115-8308","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Karen Louise","key":"thomsenpau","last":"Thomsen","locid":"32baa31f-0b93-4c6d-af7e-0da0519f574f","name":"Thomsen, Karen Louise","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Michael","key":"sørensenpau","last":"Sørensen","locid":"52635821-2c0d-418e-848d-e3e1f1175e12","name":"Sørensen, Michael","orcid":"0000-0002-8750-4329","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Hendrik","key":"vilstruppau","last":"Vilstrup","locid":"9e1905f3-3094-4aea-bbde-7178733bf6cb","name":"Vilstrup, Hendrik","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anne Mette","key":"hvaspau","last":"Hvas","locid":"b4362b49-6deb-4c2c-9027-48dc6cdbd5e6","name":"Hvas, Anne-Mette","name_org":"Hvas, Anne Mette","rank":5,"rolecode":"pau"}],"pmid":["35256195"],"pub":{"doi":"10.1016/j.thromres.2022.02.023","issn":["00493848","08960569"],"issn_org":["00493848"],"journal":"Thrombosis Research","pages":"9-15","publisher":"Pergamon Press","status":"p","title":"Thrombosis Research","volume":"213"},"review":"Peer Reviewed","scoID":["2-s2.0-85125743276"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-b8b4dd17-1fdc-4dec-b533-96278f393757"],"src":["AU Aarhus University"],"title":"Impaired fibrinolysis without hypercoagulability characterises patients with non-alcoholic fatty liver disease","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-234715","year":"2022","yearsub":"2022"}
{"abstract":"In 2020, Trapholt (a Danish museum of modern art, craft and design) and textile designer Iben Høj launched a grand collaborative art project involving almost 800 embroiderers. The project, named Stitches Beyond Borders, was part of the centenary celebratrions of Denmark’s reunification with Southern Jutland, and participants were asked to embroider their personal vision of borders. By using a mixed method approach we firstly analyse how Stitches Beyond Borders, as a collaborative art project, created a strong sense of community and cultivated creative agency. Secondly, we focus on the discursive nature of the female public created by the art project. Taking into account the rich and complex history of embroidery as an underestimated female activity tied to repressive power mechanisms, we discuss whether the project ends up merely (re)creating an innocuous female public by favouring a personal take on the border theme.","author_count":2,"contributors":["Sørensen, Tina Louise Hove","Eriksson, Birgit"],"cuid":["S01-000.00-258128"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"threads of participation crafting female agency in a collaborative art project in denmark","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.2478/tjcp-2022-0003","version":"Published Version"},"id":"S01-000.00-258128","ids":["au-e19a343d-57c9-45e3-8e27-397d24f9b9f3"],"keyword":["Museum 2.0participatory artintimate female publicscultural participationarts and craftcraftivismcreative agencythe participatory museum"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Global-Local-2-3-9DEA57D4A14FFE6F140592DD60EA68BA"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.2478/tjcp-2022-0003","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://pure.au.dk/ws/files/331644685/10.2478_tjcp_2022_0003.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Humanities (HUM)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Arts, School of Communication and Culture, School of Communication and Culture - Department of Art History, Aesthetics & Culture and Museology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Tina Louise Hove","key":"sørensenpau","last":"Sørensen","locid":"2560cc73-3cc9-4077-85b7-55dc78426422","name":"Sørensen, Tina Louise Hove","orcid":"0009-0000-0392-0767","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Birgit","key":"erikssonpau","last":"Eriksson","locid":"eb18bab8-bb58-40f8-8388-9e2f2e1f75a1","name":"Eriksson, Birgit","orcid":"0000-0002-7759-7592","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.2478/tjcp-2022-0003","issn":["22463755"],"issue":"1","journal":"Conjunctions : transdisciplinary journal of cultural participation","pages":"1-16","publisher":"Aarhus University, Department of Aesthetics and Communication","status":"p","title":"Conjunctions : transdisciplinary journal of cultural participation","volume":"9"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-e19a343d-57c9-45e3-8e27-397d24f9b9f3"],"src":["AU Aarhus University"],"title":"Threads of participation : Crafting female agency in a collaborative art project in Denmark","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-258128","year":"2022","yearsub":"2022"}
{"abstract":"In “A Model for Estimating Biological Age From Physiological Biomarkers of Healthy Aging: Cross-sectional Study” (JMIR Aging 2022;5(2):e35696) the authors noted one error. In the originally published article, Figure 4 inadvertently appeared with the same image as that of Figure 3. In the corrected version of the article, Figure 4 was updated with the following image: (Figure Presented) The correction will appear in the online version of the paper on the JMIR Publications website on June 28, 2022, together with the publication of this correction notice. Because this was made after submission to PubMed, PubMed Central, and other full-text repositories, the corrected article has also been resubmitted to those repositories.","author_count":10,"contributors":["Husted, Karina Louise Skov","Brink-Kjær, Andreas","Fogelstrøm, Mathilde","Hulst, Pernille","Bleibach, Akita","Henneberg, Kaj-Åge","Sørensen, Helge Bjarup Dissing","Dela, Flemming","Jacobsen, Jens Christian Brings","Helge, Jørn Wulff"],"cuid":["S01-000.00-319953"],"filters":{"added":"2022-11","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Husted, Karina Louise Skov"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"correction a model for estimating biological age from physiological biomarkers of healthy aging cross sectional study","src":["dtu"],"src-code":["DI-U-DTU"],"type":"djc","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.2196/40508","version":"Published Version"},"id":"S01-000.00-319953","identifier":[{"id":"85134710329","type":"scopus"},{"id":"PMC9282221","type":"pmcid"},{"id":"35763795","type":"pmid"}],"ids":["dtu-339fcd06-d083-407d-a4c5-ba33067a0a3d"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-569ADDF13D676DF4F53697A069278946"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.2196/40508","version":"Published Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/290173896/PDF_1_.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Health Technology","Technical University of Denmark, Department of Health Technology, Digital Health","Technical University of Denmark, Department of Health Technology, Digital Health, Biomedical Signal Processing & AI"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Karina Louise Skov","key":"hustedpau","last":"Husted","name":"Husted, Karina Louise Skov","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Andreas","key":"brinkkjærpau","last":"Brink-Kjær","locid":"0b01af13-ef63-4652-b31f-727d53183a62","name":"Brink-Kjær, Andreas","orcid":"0000-0002-2872-0929","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mathilde","key":"fogelstrømpau","last":"Fogelstrøm","name":"Fogelstrøm, Mathilde","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Pernille","key":"hulstpau","last":"Hulst","name":"Hulst, Pernille","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Akita","key":"bleibachpau","last":"Bleibach","name":"Bleibach, Akita","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Kaj Åge","key":"hennebergpau","last":"Henneberg","locid":"23f7bd0e-5b92-47f9-8cb3-e0f2f5c7e3af","name":"Henneberg, Kaj-Åge","name_org":"Henneberg, Kaj Åge","orcid":"0000-0001-9418-6587","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Helge Bjarup Dissing","key":"sørensenpau","last":"Sørensen","locid":"be0efdb7-17ce-4703-b513-90dfa28f45af","name":"Sørensen, Helge Bjarup Dissing","orcid":"0000-0001-5716-7600","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Flemming","key":"delapau","last":"Dela","name":"Dela, Flemming","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jens Christian Brings","key":"jacobsenpau","last":"Jacobsen","name":"Jacobsen, Jens Christian Brings","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jørn Wulff","key":"helgepau","last":"Helge","name":"Helge, Jørn Wulff","rank":10,"rolecode":"pau"}],"pmid":["35763795"],"pub":{"doi":"10.2196/40508","issn":["25617605"],"issue":"2","journal":"JMIR Aging","paperid":"e40508","publisher":"JMIR Publications Inc.","status":"p","title":"JMIR Aging","volume":"5"},"review":"Peer Reviewed","scoID":["2-s2.0-85134710329"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-339fcd06-d083-407d-a4c5-ba33067a0a3d"],"src":["DTU Technical University of Denmark"],"title":"Correction: A Model for Estimating Biological Age From Physiological Biomarkers of Healthy Aging: Cross-sectional Study","type":"Journal Comment","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-319953","year":"2022","yearsub":"2022"}
{"abstract":"The actuator line method is a widely used technique to model wind turbines in computational fluid dynamics, as it significantly reduces the required computational expense in comparison to simulations using geometrically resolved blades. Actuator line coupled to an aeroelastic solver enables not only the study of detailed wake dynamics but also aeroelastic loads, flexible blade deformation and how this interacts with the flow. Validating aeroelastic actuator line predictions of blade loading, deflection and turbine wakes in complex inflow scenarios is particularly relevant for modern turbine designs and wind farm studies involving realistic inflows, wind shear or yaw misalignment. This work first implements a vortex-based smearing correction in an aeroelastic coupled actuator line, and performs a grid resolution and smearing parameter study which demonstrates significant improvement in the blade loading and in the numerical dependencies of predicted thrust and power output. A validation is then performed using a 2.3 MW turbine with R = 40 m radius, comparing against blade resolved fluid-structure interaction simulations and full-scale measurement data, in both laminar and turbulent inflows including both high shear and high yaw misalignment. For an axisymmetric laminar inflow case, the agreement between blade resolved and actuator line simulations is excellent, with prediction of integrated quantities within 0.2%. In more complex flow cases, good agreement is seen in overall trends but the actuator line predicts lower blade loading and flapwise deflection, leading to underpredictions of thrust by between 5.3% and 8.4%. The discrepancies seen can be attributed to differences in wake flow, induction, the reliance of the actuator line on the provided airfoil data and the force application into the computational domain. Comparing the wake between coupled actuator line and blade resolved simulations for turbulent flow cases also shows good agreement in wake deficit and redirection, even under high yaw conditions. Overall, this work validates the implementation of the vortex-based smearing correction and demonstrates the ability of the actuator line to closely match blade loading and deflection predictions of blade resolved simulations in complex flows, at a significantly lower computational cost.","author_count":7,"contributors":["Hodgson, Emily Louise","Grinderslev, Christian","Meyer Forsting, Alexander Raul","Troldborg, Niels","Sørensen, Niels N.","Sørensen, Jens Nørkær","Andersen, Søren Juhl"],"cuid":["S01-000.00-327535"],"filters":{"added":"2022-08","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Hodgson, Emily Louise"],"keyword":["Actuator Line Method","Fluid structure interaction","Large eddy simulations","Validation","Wind turbine modelling","Yaw misalignment"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"validation of aeroelastic actuator line for wind turbine modelling in complex flows","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/fenrg.2022.864645","version":"Published Version"},"id":"S01-000.00-327535","identifier":[{"id":"85131875278","type":"scopus"},{"id":"000807815800001","type":"wos"}],"ids":["dtu-4d2419b6-41d1-4277-9c13-80866cd3e9c6"],"keyword":["Actuator line method","Blade resolved","Fluid-structure interaction","Large eddy simulations","Validation","Vortex-based smearing correction","Wind turbine modelling","Yaw misalignment"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-FD541D8A2C88C1073E65CE1D3239DC00"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/278765558/fenrg_10_864645.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/fenrg.2022.864645","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Wind and Energy Systems","Technical University of Denmark, Department of Wind and Energy Systems, Wind Turbine Design Division","Technical University of Denmark, Department of Wind and Energy Systems, Wind Turbine Design Division, Aero- and Fluid Dynamics"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Emily L.","key":"hodgsonemilylouisepau","last":"Hodgson","locid":"e882e4e1-d244-45c7-8ac3-e707284bcfdf","name":"Hodgson, Emily Louise","name_org":"Hodgson, Emily L.","orcid":"0000-0001-6443-2628","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Christian","key":"grinderslevchristianpau","last":"Grinderslev","locid":"99ee1e56-7a96-4577-b7f5-f653c49f3230","name":"Grinderslev, Christian","orcid":"0000-0003-3095-9733","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Alexander R.","key":"meyerforstingalexanderraulpau","last":"Meyer Forsting","locid":"64699c0c-51f0-4011-8ca2-6cc81150dc3e","name":"Meyer Forsting, Alexander Raul","name_org":"Meyer Forsting, Alexander R.","orcid":"0000-0002-3133-1860","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Niels","key":"troldborgnielspau","last":"Troldborg","locid":"542863f7-1c93-46a6-ba00-178f1593d257","name":"Troldborg, Niels","rank":4,"rolecode":"pau"},{"aff