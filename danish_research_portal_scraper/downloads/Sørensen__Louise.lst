d","orcid":"0000-0001-6942-5056","rank":10,"rolecode":"pau"}],"pmid":["32317284"],"pub":{"doi":"10.1074/jbc.ra120.013430","issn":["00219258","10678816"],"issn_org":["00219258"],"issue":"22","journal":"Journal of Biological Chemistry","pages":"7620-7634","publisher":"American Society for Biochemistry and Molecular Biology Inc.","status":"p","title":"Journal of Biological Chemistry","volume":"295"},"review":"Peer Reviewed","scoID":["2-s2.0-85085714994"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-9c766350-95e1-4e57-ae00-3cc86c14efcf"],"src":["AAU Aalborg University"],"title":"The arrhythmogenic N53I variant subtly changes the structure and dynamics in the calmodulin N-terminal domain, altering its interaction with the cardiac ryanodine receptor","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-095429","year":"2020","yearsub":"2020"}
