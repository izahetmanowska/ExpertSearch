{"author_count":5,"contributors":["Grønlund, Louise","Mathiasen, Nanet","Frandsen, Anne Kathrine","Sørensen, Pernille"],"cuid":["S02-088.65-685669"],"event":{"end":"2023-09-01","place":"Copenhagen, dk","start":"2023-08-30","title":"EAEA16: Envisioning Architectural Scales in the Analogue and Virtual Representation of Architecture","year":"2023"},"filters":{"added":"2023-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Methodology","Perception"],"level":"sci","mra":["hum","sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-ART","DI-U"],"level3":{"ART":["DI-ART-ALL","DI-ART-RDKA"],"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-ART-RDKA","DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"architectural scale models methodologies for studying daylight qualities","src":["aau","arkc"],"src-code":["DI-ART-RDKA","DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.60558/eaea16-2023-244","version":"Published Version"},"id":"S02-088.65-685669","ids":["aau-67c7845f-fc5c-46b2-afca-145bb2ecc4b8","arkc-e0333378-14d1-4c7a-a29f-e70e3afb2f42"],"keyword":["Architectural scale models","Daylight qualities","Methodology","No","Perception"],"lang":"English","level":"Scientific","mra":["Humanities","Science/Technology"],"noi":["Global-Local-2-3-05C81F77131D58702BD43B18BDF1790F"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/573820805/eaea16-2023-244.pdf","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.60558/eaea16-2023-244","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://adk.elsevierpure.com/ws/files/82319828/eaea16-2023-244.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"royal danish academy architecture design conservation","l2":"DI-ART","l2n":"