fbe4","name":"Petkovic, Marija","rank":1,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Ermelindo C","key":"lealpau","last":"Leal","name":"Leal, Ermelindo C","rank":2,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Anja E.","key":"sørensenpau","last":"Sørensen","locid":"7e5d1e2c-5d4b-4436-bb66-acdca4058c08","name":"Sørensen, Anja Elaine","name_org":"Sørensen, Anja E.","orcid":"0000-0001-7557-5376","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Per T","key":"jørgensenpau","last":"Jørgensen","name":"Jørgensen, Per T","rank":4,"rolecode":"pau"},{"affno":"4 5","corresponding":null,"country":"dk","first":"Jesper T","key":"wengelpau","last":"Wengel","locid":"24a24dc9-0177-4d8a-99f4-8efa1af60d79","name":"Wengel, Jesper T","rank":5,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Rosa","key":"jersiechristensenpau","last":"Jersie-Christensen","locid":"079ce232-2a69-46fb-b7af-81eb3607b4d8","name":"Jersie-Christensen, Rosa","rank":6,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Jesper T.","key":"troelsenpau","last":"Troelsen","locid":"3b39117d-6f4e-47c7-a61d-5192c15b00a9","name":"Troelsen, Jesper","name_org":"Troelsen, Jesper T.","orcid":"0000-0002-4177-3267","rank":7,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Eugenia","key":"carvalhopau","last":"Carvalho","name":"Carvalho, Eugenia","rank":8,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Louise T.","key":"dalgaardpau","last":"Dalgaard","locid":"a219fdaf-f994-4a7a-beb8-1f353846ed5a","name":"Dalgaard, Louise Torp","name_org":"Dalgaard, Louise T.","orcid":"0000-0002-3598-2775","rank":9,"rolecode":"pau"}],"pmid":["40897924"],"pub":{"doi":"10.1007/s00125-025-06522-3","issn":["0012186X","14320428"],"issn_org":["0012186X"],"journal":"Diabetologia","publisher":"Springer","status":"e","title":"Diabetologia"},"review":"Peer Reviewed","scoID":["2-s2.0-105015097711"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Roskilde University","Universities","University of Southern Denmark"],"PST":["E-Published (ahead of print)","Published"]},"sid":["aau-761967e1-4edb-4310-8103-c7cf56fabb3f","ruc-503e6270-cc61-471f-8961-5484fd9b0eb4"],"src":["AAU Aalborg University","RUC Roskilde University"],"title":"Improved wound healing by dual inhibition of miR-146a-5p and miR-29a-3p supports a network action of dysregulated miRNAs in diabetic skin","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.09-822358","year":"2025","yearsub":"2025"}
{"abstract":"AIMS: We investigated associations between overall organic food consumption and consumption of specific organic food groups with the risk of developing atherosclerotic cardiovascular disease (ASCVD). METHODS: The study was based on a prospective cohort of middle-aged women and men from the Danish Diet, Cancer and Health study. Information about organic food consumption of vegetables, fruit, dairy products, eggs, meat, and bread and cereal products was obtained from a food frequency questionnaire. The frequency consumption of the six food groups was summarized into a total organic food score evaluated in categories (never, low, medium and high intake) and as a continuous variable. A total of 41,407 study participants were followed for a median of 16 years during which 5,365 developed ASCVD. RESULTS: Overall organic food consumption was associated with a 6% lower incidence rate of ASCVD per 6-point increment in the total organic food score (HR: 0.94, 95% CI: 0.89-0.99). Organic consumption of eggs was associated with lower incidence of ASCVD for both women (HR, 0.95, 95% CI 0.91-0.99) and men (HR: 0.96, 95% CI: 0.93-0.99), and organic consumption of bread and cereal products were associated with a lower incidence of ASCVD among men (HR: 0.95, 95% CI: 0.91-0.99). CONCLUSIONS: We found that organic food consumption was associated with a lower incidence of ASCVD in a cohort of middle-aged Danish women and men.","author_count":9,"contributors":["Andersen, Julie Louise Munk","Frederiksen, Kirsten","Kyrø, Cecilie","Hansen, Johnni","Raaschou-Nielsen, Ole","Bork, Christian Sørensen","Dahm, Christina Catherine","Tjønneland, Anne","Olsen, Anja"],"cuid":["S02-100.00-792859"],"filters":{"added":"2025-04","altsrc":["No Matches Found"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Andersen, Julie L M","Andersen, Julie Louise Munk"],"keyword":["Atherosclerotic cardiovascular disease","Cohort study","Epidemiology","Organic food consumption"],"level":"sci","mra":["med","sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-NP","DI-U"],"level3":{"NP":["DI-NP-ALL","DI-NP-CAN"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-NP-CAN","DI-U-AAU","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"organic food consumption and the incidence of atherosclerotic cardiovascular disease in the danish diet cancer and health cohort","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"id":"S02-100.00-792859","identifier":[{"id":"39913675","type":"pmid"}],"ids":["aau-4bb304f5-6832-4189-b4dd-6d270eb7ca53","au-50e5740c-d530-4798-85f0-b5df314a9444"],"keyword":["atherosclerotic cardiovascular disease","cohort study","epidemiology","organic food consumption"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-3-0EE266DEAE60F88C6D4228CB983FDC88"],"org":[{"affno":"1","country":"dk","key":"dcrc danish cancer society research center","l2":"DI-NP","l2n":"Non-Profit Organisations","l3":"DI-NP-CAN","l3nn":"DCRC Danish Cancer Society Research Center","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DCRC Danish Cancer Society Research Center","namevar":["Danish Cancer Society"],"nora_code":"DI-NP-CAN","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Environmental Science"],"nora_code":"DI-U-AU","used":1},{"affno":"3","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Cardiology","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-AAU","used":1},{"affno":"4","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Julie Louise Munk","key":"andersenpau","last":"Andersen","name":"Andersen, Julie Louise Munk","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kirsten","key":"frederiksenpau","last":"Frederiksen","name":"Frederiksen, Kirsten","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Cecilie","key":"kyrøpau","last":"Kyrø","name":"Kyrø, Cecilie","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Johnni","key":"hansenpau","last":"Hansen","name":"Hansen, Johnni","rank":4,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Ole","key":"raaschounielsenpau","last":"Raaschou-Nielsen","locid":"9ae8831f-2034-4c09-84bc-01cd649e3b55","name":"Raaschou-Nielsen, Ole","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Christian Sørensen","key":"borkpau","last":"Bork","locid":"9a5f5510-7213-4e16-88c2-74a3af7aa2d9","name":"Bork, Christian Sørensen","orcid":"0000-0001-5233-2902","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Christina C","key":"dahmpau","last":"Dahm","locid":"99090c31-2a55-406a-a3a0-fe4e9c7ab98b","name":"Dahm, Christina C","orcid":"0000-0003-0481-2893","rank":7,"rolecode":"pau"},{"affno":"1 4","corresponding":null,"first":"Anne","key":"tjønnelandpau","last":"Tjønneland","name":"Tjønneland, Anne","rank":8,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Anja","key":"olsenpau","last":"Olsen","locid":"b6599ea6-5ae6-45eb-8540-12be04efbf60","name":"Olsen, Anja","rank":9,"rolecode":"pau"}],"pmid":["39913675"],"pub":{"doi":"10.1093/eurjpc/zwaf057","issn":["20474873","20474881"],"issn_org":["20474873"],"journal":"European Journal of Preventive Cardiology","paperid":"zwaf057","publisher":"Oxford University Press","status":"e","title":"European Journal of Preventive Cardiology"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Non-Profit Organisations","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-NP","DI-NP-ALL","DI-U","DI-U-ALL","Hospitals","Non-Profit Organisations","North Denmark Region","Universities","University of Copenhagen"],"PST":["E-Published (ahead of print)"]},"sid":["aau-4bb304f5-6832-4189-b4dd-6d270eb7ca53","au-50e5740c-d530-4798-85f0-b5df314a9444"],"src":["AAU Aalborg University","AU Aarhus University"],"title":"Organic food consumption and the incidence of atherosclerotic cardiovascular disease in the Danish Diet, Cancer and Health cohort","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-792859","year":"2025","yearsub":"2025"}
{"abstract":"Background and Objectives: Vasovagal reactions (VVRs) are some of the most common adverse reactions (ARs) in blood donors. While researchers have tried to develop precise risk prediction tools, these studies have all combined onsite and offsite reactions as well as reactions with and without the loss of consciousness. This study aimed to investigate potential differences in risk phenotypes in onsite VVRs, here defined as syncope and near-fainting. Materials and Methods: We included 40,543 participants from the Danish Blood Donor Study (136 syncope and 1453 near-fainting cases). Data on lifestyle and health were available from questionnaires. Data on donation type, time of day and ARs were available from the blood bank it-system. The risk of VVRs was assessed in a logistic mixed-effects model which included 345,751 donations. For genotyped participants (N = 21,102), polygenic scores were calculated for syncope, anxiety, neuroticism and cardiometabolic disease. Results: Risk of both types of VVR was found to increase during warmer season and apheresis donation and reduce by donating late in the day. In addition, less donation experience and lower height increased the risk for near-fainting. In contrast, no donor-specific characteristics appeared to mediate the risk of syncope. Genetic predisposition of various traits had no effect on the risk of onsite VVRs. Conclusion: This study indicates that onsite syncope and near-fainting are distinct conditions with different risk profiles. Our findings emphasize the importance of a more detailed analysis of VVRs, suggesting that the common practice of combining VVR subtypes may reduce the accuracy of risk prediction.","author_count":19,"contributors":["Mikkelsen, Christina","Sørensen, Betina Samuelsen","Aagaard, Bitten","Svensson, Sys Hasslund","Bruun, Mie Topholm","Larsen, Rune","Drechsler, Louise Ørnskov","Didriksen, Maria","Schwinn, Michael","Dowsett, Joseph","Sørensen, Erik","Erikstrup, Christian","Pedersen, Ole B","Grarup, Niels","Stefansson, Kari","Hansen, Morten Bagge","Hansen, Torben","Ostrowski, Sisse Rye"],"cuid":["S03-093.33-822351"],"filters":{"added":"2025-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"continent":["Europe, Non-EU","Nordic","OECD"],"corpau":["DBDS Genomic Consortium","Danish Blood Donor Study Genomic Consortium"],"corresponding_author":["Mikkelsen, Christina"],"country":["Iceland"],"glorg":["All Global Affiliations","University of Iceland","deCODE Genetics"],"keyword":["Blood donation","Donor protection","haemovigilance","vasovagal reactions"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"onsite vasovagal reactions with and without loss of consciousness are distinct outcomes with different risk factors","src":["aau","au","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1111/vox.70072","version":"Published Version"},"id":"S03-093.33-822351","identifier":[{"id":"105013756947","type":"scopus"},{"id":"40774814","type":"pmid"}],"ids":["aau-7190e787-94b9-4776-9ff2-779dd5112735","au-11b7b3a6-a021-45c2-ab34-ce32f7a6dbc2","sdu-ecf1fb45-20c2-4d9f-9cf4-ef9f378aef79"],"keyword":["blood donation","donor protection","haemovigilance","vasovagal reactions"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-15EFB3261EA4B1F599CAEA9E94FE63B2"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/295821133/Vox_Sanguinis_-_202