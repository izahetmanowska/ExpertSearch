{"author_count":16,"contributors":["Hartvig, Peter","Kemezys, Andrius Hansen","Hjelmroth, Louise","Madsen, Lis","Nielsen, Magnus Gammelgaard","Ingvordsen, Kaspar","Adserballe, Malthe Oksen"],"cuid":["S01-000.00-261786"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"nr","rtype":["clu"],"sorti":"results of crop protection trials in minor crops in 000000002018","src":["au"],"src-code":["DI-U-AU"],"type":"dra","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.au.dk/ws/files/151971588/10_Results_of_crop_protetion_trials.pdf","version":"Published Version"},"id":"S01-000.00-261786","ids":["au-e8188a0c-5b5c-478d-a5dc-438ef8b756f8"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-6013A59D13B3239F42F9D65FF792A069"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.au.dk/ws/files/151971588/10_Results_of_crop_protetion_trials.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Agroecology, Department of Agroecology - Crop Health"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Peter","key":"hartvigpau","last":"Hartvig","locid":"3b364808-01b2-4c22-9252-384824fca1ed","name":"Hartvig, Peter","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andrius Hansen","key":"kemezyspau","last":"Kemezys","locid":"289ebebd-a097-4936-b84f-ee507c4a02d1","name":"Kemezys, Andrius Hansen","rank":2,"rolecode":"pau"},{"affno":"1","c