affno":"2","first":"Lotte S.","key":"mikkelsenpau","last":"Mikkelsen","name":"Mikkelsen, Lotte S.","rank":7,"rolecode":"pau"},{"affno":"2","first":"Anna Louise","key":"sørensenpau","last":"Sørensen","name":"Sørensen, Anna Louise","rank":8,"rolecode":"pau"},{"affno":"1","first":"Shan","key":"fengpau","last":"Feng","locid":"87c183e9-1a83-4577-a645-c891d9b47fce","name":"Feng, Shan","rank":9,"rolecode":"pau"},{"affno":"1","first":"Ulrik","key":"fahnøepau","last":"Fahnøe","locid":"af7d26fe-7626-47c3-8851-4c49157a2198","name":"Fahnøe, Ulrik","orcid":"0000-0002-2527-5751","rank":10,"rolecode":"pau"},{"affno":"3","first":"Ria","key":"lassaunierepau","last":"Lassauniere","name":"Lassauniere, Ria","rank":11,"rolecode":"pau"},{"affno":"3","first":"Anders","key":"fomsgaardpau","last":"Fomsgaard","name":"Fomsgaard, Anders","rank":12,"rolecode":"pau"},{"affno":"1","first":"Santseharay","key":"ramirezpau","last":"Ramirez","locid":"ef00eba2-2eb2-46c3-8995-c5809f996734","name":"Ramirez, Santseharay","orcid":"0000-0003-3699-1814","rank":13,"rolecode":"pau"},{"affno":"1","first":"Nina","key":"weispau","last":"Weis","locid":"3a88aaad-c729-432b-b725-999664af7a45","name":"Weis, Nina","rank":14,"rolecode":"pau"},{"affno":"1","first":"Jens","key":"bukhpau","last":"Bukh","locid":"ed84ce10-678e-4b40-9651-982bf9977abc","name":"Bukh, Jens","orcid":"0000-0002-7815-4806","rank":15,"rolecode":"pau"}],"pmid":["34419923"],"pub":{"doi":"10.1016/j.ebiom.2021.103519","issn":["23523964"],"journal":"EBioMedicine","paperid":"103519","status":"p","title":"EBioMedicine","volume":"71"},"review":"Peer Reviewed","scoID":["2-s2.0-85113156129"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-3c5c1509-7deb-4517-8d3f-ed58d04047d5"],"src":["KU University of Copenhagen"],"title":"Neutralisation titres against SARS-CoV-2 are sustained 6 months after onset of symptoms in individuals with mild COVID-19","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-429507","year":"2021","yearsub":"2021"}
{"abstract":"Chronic pain is a major healthcare problem that impacts one in five adults across the globe. Current treatment is compromised by dose-limiting side effects including drowsiness, apathy, fatigue, loss of ability to function socially and professionally as well as a high abuse liability. Most of these side effects result from broad suppression of excitatory neurotransmission. Chronic pain states are associated with specific changes in the efficacy of synaptic transmission in the pain pathways leading to amplification of non-noxious stimuli and spontaneous pain. Consequently, a reversal of these specific changes may pave the way for the development of efficacious pain treatment with fewer side effects. We have recently described a high-affinity, bivalent peptide TAT-P4-(C5)2, enabling efficient targeting of the neuronal scaffold protein, PICK1, a key protein in mediating chronic pain sensitization. In the present study, we demonstrate that in an inflammatory pain model, the peptide does not only relieve mechanical allodynia by targeting PICK1 involved in central sensitization, but also by peripheral actions in the inflamed paw. Further, we assess the effects of the peptide on novelty-induced locomotor activity, abuse liability, and memory performance without identifying significant side effects.","author_count":4,"contributors":["Jensen, Kathrine Louise","Noes-Holt, Gith","Sørensen, Andreas Toft","Madsen, Kenneth Lindegaard"],"cuid":["S01-000.00-519412"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Avidity","Neuropathic pain","peptide inhibitor"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"a novel peripheral action of pick000000000001 inhibition in inflammatory pain","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/fncel.2021.750902","version":"Published Version"},"id":"S01-000.00-519412","identifier":[{"id":"34975407","type":"pmid"},{"id":"85121983822","type":"scopus"},{"id":"PMC8714954","type":"pmcid"}],"ids":["ku-d2db4bf3-966a-4ec1-9027-92d8cfe51861"],"keyword":["PDZ inhibitor","PICK1 inhibitor","avidity","bivalent peptide","neuropathic pain","peptide inhibitor"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-FF70C5684FD3806798CFF5ED32EA475A"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/289156064/A_Novel_Peripheral_Action_of_PICK1_Inhibition_in_Inflammatory_Pain.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/fncel.2021.750902","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Neuroscience, Neuropharm and Genetics"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Kathrine Louise","key":"jensenpau","last":"Jensen","locid":"d16cc237-89d6-490c-9519-6265b3ddb48b","name":"Jensen, Kathrine Louise","rank":1,"rolecode":"pau"},{"affno":"1","first":"Gith","key":"noesholtpau","last":"Noes-Holt","locid":"499aa60e-71b0-4ef8-a185-c717b42ff649","name":"Noes-Holt, Gith","rank":2,"rolecode":"pau"},{"affno":"1","first":"Andreas Toft","key":"sørensenpau","last":"Sørensen","locid":"ac0f6a72-7014-4f0c-8c02-6c9a7721ccbd","name":"Sørensen, Andreas Toft","orcid":"0000-0001-5887-9247","rank":3,"rolecode":"pau"},{"affno":"1","first":"Kenneth Lindegaard","key":"madsenpau","last":"Madsen","locid":"4c78e786-e986-4c26-a69e-d9e0797a8aa0","name":"Madsen, Kenneth Lindegaard","orcid":"0000-0001-9274-6691","rank":4,"rolecode":"pau"}],"pmid":["34975407"],"pub":{"doi":"10.3389/fncel.2021.750902","issn":["16625102"],"journal":"Frontiers in Cellular Neuroscience","paperid":"750902","status":"p","title":"Frontiers in Cellular Neuroscience","volume":"15"},"review":"Peer Reviewed","scoID":["2-s2.0-85121983822"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-d2db4bf3-966a-4ec1-9027-92d8cfe51861"],"src":["KU University of Copenhagen"],"title":"A Novel Peripheral Action of PICK1 Inhibition in Inflammatory Pain","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-519412","year":"2021","yearsub":"2021"}
{"abstract":"Background: Due to repeated exacerbations a large group of patients with chronic obstructive pulmonary disease (COPD) are often exposed to oral corticosteroids (OCS). Corticosteroids may be thrombogenic. We evaluated the risk of venous thromboembolia and death in patients with acute exacerbation of COPD (AECOPD) according to two different dosing regimens.Method: This was a nationwide observational cohort study of outpatients with COPD with a 6 month follow up time. It was based on a linked administrative registry data between January 1st 2010 and 28th February 2018. In total 30.473 patients treated with either short course (&lt;250mg) or long course (&gt;250mg) of OCS for AECOPD were included in the study. Cox proportional hazard regression was used to estimate the risk of VTE hospitalization or all-cause mortality.Results: The incidence of VTE was low. However, long course of OCS was associated with an increased risk of VTE compared to short course, (HR 1.73, CI 1.08 to 2.79; p &lt; 0.0001). Furthermore, we found a higher risk of all-cause mortality in the long course group, HR 1.62 (CI 1.57 to 1.62; p&lt;0.0001.)Conclusion: The risk of VTE hospitalization was higher among patients who used long courses of OCS, however the absolute risk was low, suggesting some under-reporting of the condition. Explanations for the finding include a true effect and residual confounding and as such our results need confirmation in experimental studies.FootnotesCite this article as: European Respiratory Journal 2021; 58: Suppl. 65, OA2590.This abstract was presented at the 2021 ERS International Congress, in session “Prediction of exacerbations in patients with COPD”.This is an ERS International Congress abstract. No full-text version is available. Further material to accompany this abstract may be available at www.ers-education.org (ERS member access only).","author_count":22,"contributors":["Rastoder, Ema","Sivapalan, Pradeesh","Eklöf, Josefin","Saeed, Mohamad Isam","Jordan, Alexander Svorre","Meteran, Howraman","Tønnesen, Louise","Biering-Sørensen, Tor","Løkke, Anders","Seershol, Niels","Nielsen, Thyge Lynghøj","Carlsen, Jørn","Janner, Julie","Godtfredsen, Nina","Bodtger, Uffe","Laursen, Christian B","Hilberg, Ole","Knop, Filip Krag","Priemé, Helene","Gottlieb, Vibeke","Wilcke, Jon Torgny","Jensen, Jens Ulrik Stæhr"],"cuid":["S01-000.00-576567"],"event":{"end":"2021-09-08","start":"2021-09-05","title":"ERS International Congress 2021","year":"2021"},"filters":{"added":"2022-03","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"systemic corticosteroids and the risk of venous thromboembolism in copd patients a nationwide study of 000000000030 000000000473 outpatients with severe very severe copd","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://erj.ersjournals.com/content/58/suppl_65/OA2590.abstract","version":"Other Version"},"id":"S01-000.00-576567","ids":["sdu-0bbef12c-bd15-4b2a-be02-c297aeefb534"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-2-F2A2989CA70AF0C2C5015FF79B684B1F"],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Gentofte Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1},{"affno":"3","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS - Næstved, Slagelse, Ringsted Hospitals (NSR), Research Unit of Medicine (Slagelse)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Ema","key":"rastoderpau","last":"Rastoder","name":"Rastoder, Ema","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Pradeesh","key":"sivapalanpau","last":"Sivapalan","name":"Sivapalan, Pradeesh","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Josefin","key":"eklöfpau","last":"Eklöf","name":"Eklöf, Josefin","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mohamad Isam","key":"saeedpau","last":"Saeed","name":"Saeed, Mohamad Isam","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Alexander Svorre","key":"jordanpau","last":"Jordan","name":"Jordan, Alexander Svorre","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Howraman","key":"meteranpau","last":"Meteran","name":"Meteran, Howraman","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Louise","key":"tønnesenpau","last":"Tønnesen","name":"Tønnesen, Louise","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Tor","key":"bieringsørensenpau","last":"Biering-Sørensen","name":"Biering-Sørensen, Tor","rank":8,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Anders","key":"løkkepau","last":"Løkke","name":"Løkke, Anders","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Niels","key":"seersholpau","last":"Seershol","name":"Seershol, Niels","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Thyge Lynghøj","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Thyge Lynghøj","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jørn","key":"carlsenpau","last":"Carlsen","name":"Carlsen, Jørn","rank":12,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Julie","key":"jannerpau","last":"Janner","name":"Janner, Julie","rank":13,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Nina","key":"godtfredsenpau","last":"Godtfredsen","name":"Godtfredsen, Nina","rank":14,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Uffe","key":"bødtgerpau","last":"Bødtger","locid":"2f4e70da-63bb-4b8d-af09-2a959d6df5e8","name":"Bodtger, Uffe","name_org":"Bødtger, Uffe","orcid":"0000-0002-1231-9209","rank":15,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Christian","key":"laursenpau","last":"Laursen","locid":"333fc524-a408-42f4-885a-0fee79e488b9","name":"Laursen, Christian B","name_org":"Laursen, Christian","orcid":"0000-0001-6382-9906","rank":16,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Ole","key":"hilbergpau","last":"Hilberg","locid":"6c545c65-1d94-45a3-a8b4-f90eae06d248","name":"Hilberg, Ole","orcid":"0000-0002-3075-3463","rank":17,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Filip Krag","key":"knoppau","last":"Knop","name":"Knop, Filip Krag","rank":18,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Helene","key":"priemépau","last":"Priemé","name":"Priemé, Helene","rank":19,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Vibeke","key":"gottliebpau","last":"Gottlieb","name":"Gottlieb, Vibeke","rank":20,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jon Torgny","key":"wilckepau","last":"Wilcke","name":"Wilcke, Jon Torgny","rank":21,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jens Ulrik Stæhr","key":"jensenpau","last":"Jensen","name":"Jensen, Jens Ulrik Stæhr","rank":22,"rolecode":"pau"}],"pub":{"doi":"10.1183/13993003.congress-2021.oa2590","issn":["09031936","13993003"],"issn_org":["09031936"],"issue":"suppl. 65","journal":"European Respiratory Journal","paperid":"OA2590","publisher":"European Respiratory Society","status":"p","title":"European Respiratory Journal","volume":"58"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-0bbef12c-bd15-4b2a-be02-c297aeefb534"],"src":["SDU University of Southern Denmark"],"title":"Systemic corticosteroids and the risk of venous thromboembolism in COPD patients: A nationwide study of 30.473 outpatients with severe-very severe COPD","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-576567","year":"2021","yearsub":"2021"}
{"abstract":"Pulmonary surfactant protein D (SP-D) is an important component of the pulmonary innate immune system with the ability to dampen cigarette smoke-induced lung inflammation. However, cigarette smoking mediates translocation of SP-D from the lung to the blood, and serum SP-D (sSP-D) has therefore previously been suggested as marker for smoke-induced lung injury. In support of this notion, associations between high sSP-D and low lung function measurements have previously been demonstrated in smokers and in chronic obstructive lung disease (COPD). The present investigations employ a 12-yr longitudinal Danish twin study to test the hypothesis that baseline sSP-D variation has the capacity to identify smokers with normal baseline lung function who are at high risk of significant future smoke-induced lung function decline. We find that sSP-D is significantly increased in those with normal lung function at baseline who develop lung function decline during follow-up compared with those who stay lung healthy. Moreover, we demonstrate that it is the smoke-induced baseline sSP-D level, and not the constitutional level, which has capacity as biomarker, and which is linearly increased with the decline in lung function during follow-up. In conclusion, we here present first observation of increased sSP-D for identification of high-risk smokers.","author_count":6,"contributors":["Dalgård, Christine","Wang, Fang","Titlestad, Ingrid Louise","Kyvik, Kirsten Ohm","Vestbo, Jørgen","Sorensen, Grith Lykke"],"cuid":["S01-000.00-603205"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East","Europe, Non-EU","OECD"],"corresponding_author":["Sorensen, Grith Lykke"],"country":["China","United Kingdom"],"glorg":["All Global Affiliations","Qingdao Municipal Hospital","University of Manchester"],"keyword":["Biomarker","Chronic obstructive lung disease","Surfactant protein D","Tobacco smoking","Twin study"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-SDR","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"increased serum sp d in identification of high risk smokers at high risk of copd","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/183648238/ajplung.00604.2020.pdf","version":"Authors Final Version"},"id":"S01-000.00-603205","identifier":[{"id":"85107710958","type":"scopus"},{"id":"33759571","type":"pmid"}],"ids":["sdu-68d33b17-f12b-41c4-ac99-a2bd7765681e"],"keyword":["biomarker","chronic obstructive lung disease","surfactant protein D","tobacco smoking","twin study"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-2D414E57B546E34A1EEFE5EA85B67E27"],"oa_link":[{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/183648238/ajplung.00604.2020.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Public Health, Clinical Pharmacology, Pharmacy and Environmental Medicine","SDU, The Faculty of Health Sciences, Department of Public Health, The Danish Twin Registry"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"cn","key":"qingdao municipal hospital","loc":["China","Asia, East"],"name":"Qingdao Municipal Hospital","used":1},{"affno":"3","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Odense University Hospital"],"nora_code":"DI-HO-SDR","used":1},{"affno":"4","country":"gb","key":"university of manchester","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Manchester","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Christine","key":"dalgårdpau","last":"Dalgård","locid":"c6fe5081-86c9-42ef-8d73-f20ead04e1bd","name":"Dalgård, Christine","orcid":"0000-0001-8184-3429","rank":1,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Fang","key":"wangpau","last":"Wang","name":"Wang, Fang","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ingrid Louise","key":"titlestadpau","last":"Titlestad","locid":"67905117-c8b6-4567-b11a-11abb0621cc2","name":"Titlestad, Ingrid Louise","orcid":"0000-0001-6418-0088","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kirsten Ohm","key":"kyvikpau","last":"Kyvik","locid":"33f078c5-34c0-48ab-9f25-b747e8b0ae49","name":"Kyvik, Kirsten Ohm","orcid":"0000-0003-2981-0245","rank":4,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Jørgen","key":"vestbopau","last":"Vestbo","name":"Vestbo, Jørgen","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Grith Lykke","key":"sorensenpau","last":"Sorensen","locid":"950cb689-da86-4abe-835b-a1312ddf5cec","name":"Sorensen, Grith Lykke","orcid":"0000-0002-5273-1097","rank":6,"rolecode":"pau"}],"pmid":["33759571"],"pub":{"doi":"10.1152/ajplung.00604.2020","issn":["10400605","15221504"],"issn_org":["10400605"],"issue":"6","journal":"American Journal of Physiology - Lung Cellular and Molecular Physiology","publisher":"American Physiological Society","status":"p","title":"American Journal of Physiology - Lung Cellular and Molecular Physiology","title_org":"American Journal of Physiology-Lung Cellular and Molecular Physiology","volume":"320"},"review":"Peer Reviewed","scoID":["2-s2.0-85107710958"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-68d33b17-f12b-41c4-ac99-a2bd7765681e"],"src":["SDU University of Southern Denmark"],"title":"Increased serum SP-D in identification of high-risk smokers at high risk of COPD","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-603205","year":"2021","yearsub":"2021"}
{"abstract":"INTRODUCTION: Crowding of the emergency departments is an increasing problem. Many patients with an exacerbation of chronic obstructive pulmonary disease (COPD) are often treated in the emergency departments for a very short period before discharged to their homes. It is possible that this treatment could take place in the patients' homes with sufficient diagnostics supporting the treatment. In an effort to keep the diagnostics and treatment of some of these patients in their homes and thus to reduce the patient load at the emergency departments, we implemented a prehospital treat-and-release strategy based on ultrasonography and blood testing performed by emergency medical technicians (EMT) or paramedics (PM) in patients with acute exacerbation of COPD. METHOD: EMTs and PMs were enrolled in a six-hour educational program covering ultrasonography of the lungs and point of care blood tests. During the seasonal peak of COPD exacerbations (October 2018 - May 2019) all patients who were treated by the ambulance crews for respiratory insufficiency were screened in the ambulances. If the patient had uncomplicated COPD not requiring immediate transport to the hospital, ultrasonographic examination of the lungs, measurements of C-reactive protein and venous blood gases analyses were performed. The response to the initial treatment and the results obtained were discussed via telemedical consultation with a prehospital anaesthesiologist who then decided to either release the patient at the scene or to have the patient transported to the hospital. The primary outcome was strategy feasibility. RESULTS: We included 100 EMTs and PMs in the study. During the study period, 771 patients with respiratory insufficiency were screened. Uncomplicated COPD was rare as only 41patients were treated according to the treat-and-release strategy. Twenty of these patients (49%) were released at the scene. In further ten patients, technical problems were encountered hindering release at the scene. CONCLUSION: In a few selected patients with suspected acute exacerbations of COPD, it was technically and organisationally feasible for EMTs and PMs to perform prehospital POCT-ultrasound and laboratory testing and release the patients following treatment. None of the patients released at the scene requested a secondary ambulance within the first 48 h following the intervention.","author_count":13,"contributors":["Nadim, Giti","Laursen, Christian B","Pietersen, Pia Iben","Wittrock, Daniel","Sørensen, Michael K","Nielsen, Lars B","Rasmussen, Claus-Henrik","Christensen, Helle Marie","Helmerik, Simon","Jørgensen, Gitte","Titlestad, Ingrid Louise","Lassen, Annmarie Touborg","Mikkelsen, Søren"],"cuid":["S01-000.00-625112"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"corresponding_author":["Mikkelsen, Søren"],"keyword":["Chronic pulmonary obstructive disease","Emergency medical technicians","Point of care ultrasound"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-SDR"],"OT":["Responce & Falck Denmark"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-SDR","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"prehospital emergency medical technicians can perform ultrasonography and blood analysis in prehospital evaluation of patients with chronic obstructive pulmonary disease a feasibility study","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s12913-021-06305-7","version":"Published Version"},"id":"S01-000.00-625112","identifier":[{"id":"33789641","type":"pmid"},{"id":"85103746494","type":"scopus"},{"id":"PMC8011095","type":"pmcid"}],"ids":["sdu-b5317038-ff25-46da-a037-04b3bad1c558"],"keyword":["Chronic pulmonary obstructive disease","Emergency medical technicians","Point of care; ultrasound"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-8302331DE01C11CB50206474C23775D0"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s12913-021-06305-7","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/181628292/s12913_021_06305_7.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Emergency Medicine (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Responce & Falck Denmark"],"nora_code":"DI-OT","used":1},{"affno":"3","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Region of Southern Denmark"],"nora_code":"DI-HO-SDR","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Giti","key":"nadimpau","last":"Nadim","locid":"3999e047-8c43-4732-a2e6-1a8d4dc40adb","name":"Nadim, Giti","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christian B","key":"laursenpau","last":"Laursen","locid":"333fc524-a408-42f4-885a-0fee79e488b9","name":"Laursen, Christian B","orcid":"0000-0001-6382-9906","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Pia I","key":"pietersenpau","last":"Pietersen","locid":"b5e80914-ad32-4216-9ec6-150de89d1839","name":"Pietersen, Pia Iben","name_org":"Pietersen, Pia I","orcid":"0000-0001-5718-3635","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Daniel","key":"wittrockpau","last":"Wittrock","locid":"814a1c3f-d86f-459a-93c4-1cb18d4dc813","name":"Wittrock, Daniel","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Michael K","key":"sørensenpau","last":"Sørensen","name":"Sørensen, Michael K","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lars B","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Lars B","rank":6,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Claus-Henrik","key":"rasmussenpau","last":"Rasmussen","locid":"3d4aa700-141d-4c3c-bfc5-d2d368cce808","name":"Rasmussen, Claus-Henrik","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Helle Marie","key":"christensenpau","last":"Christensen","locid":"dec4ebf0-8630-4645-9129-859c046769e7","name":"Christensen, Helle Marie","orcid":"0000-0001-6783-4112","rank":8,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Simon","key":"helmerikpau","last":"Helmerik","name":"Helmerik, Simon","rank":9,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Gitte","key":"jørgensenpau","last":"Jørgensen","name":"Jørgensen, Gitte","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ingrid L","key":"titlestadpau","last":"Titlestad","locid":"67905117-c8b6-4567-b11a-11abb0621cc2","name":"Titlestad, Ingrid Louise","name_org":"Titlestad, Ingrid L","orcid":"0000-0001-6418-0088","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Annmarie T","key":"lassenpau","last":"Lassen","locid":"80e651b5-e70f-43e0-baf8-e88335ac10b8","name":"Lassen, Annmarie Touborg","name_org":"Lassen, Annmarie T","orcid":"0000-0003-4942-6152","rank":12,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren","key":"mikkelsenpau","last":"Mikkelsen","locid":"7df86a29-c6dc-4919-a9f9-6f5c23591e1d","name":"Mikkelsen, Søren","orcid":"0000-0002-5187-7027","rank":13,"rolecode":"pau"}],"pmid":["33789641"],"pub":{"doi":"10.1186/s12913-021-06305-7","issn":["14726963"],"journal":"BMC Health Services Research","paperid":"290","publisher":"BioMed Central","status":"p","title":"BMC Health Services Research","volume":"21"},"review":"Peer Reviewed","scoID":["2-s2.0-85103746494"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Region of Southern Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-b5317038-ff25-46da-a037-04b3bad1c558"],"src":["SDU University of Southern Denmark"],"title":"Prehospital emergency medical technicians can perform ultrasonography and blood analysis in prehospital evaluation of patients with chronic obstructive pulmonary disease : a feasibility study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-625112","year":"2021","yearsub":"2021"}
{"abstract":"CONTEXT: The importance of fasting glucagon-like peptide-1 (GLP-1) in altered metabolic outcomes has been questioned. OBJECTIVE: This work aimed to assess whether fasting GLP-1 differs in children and adolescents with overweight/obesity compared to a population-based reference, and whether concentrations predict cardiometabolic risk (CMR) factors. METHODS: Analyses were based on The Danish Childhood Obesity Data- and Biobank, a cross-sectional study including children and adolescents, aged 6 to 19 years, from an obesity clinic group (n = 1978) and from a population-based group (n = 2334). Fasting concentrations of plasma total GLP-1 and quantitative CMR factors were assessed. The effects of GLP-1 as a predictor of CMR risk outcomes were examined by multiple linear and logistic regression modeling. RESULTS: The obesity clinic group had higher fasting GLP-1 concentrations (median 3.3 pmol/L; interquartile range, 2.3-4.3 pmol/L) than the population-based group (2.8 pmol/L; interquartile range, 2.1-3.8 pmol/L; P < 2.2E-16). Body mass index SD score (SDS), waist circumference, and total body fat percentage were significant predictors of fasting GLP-1 concentrations in boys and girls. Fasting GLP-1 concentrations were positively associated with homeostasis model assessment of insulin resistance, fasting values of insulin, high-sensitivity C-reactive protein, C-peptide, triglycerides, alanine transaminase (ALT), glycated hemoglobin A1c, and SDS of diastolic and systolic blood pressure. A 1-SD increase in fasting GLP-1 was associated with an increased risk of insulin resistance (odds ratio [OR] 1.59), dyslipidemia (OR 1.16), increased ALT (OR 1.14), hyperglycemia (OR 1.12) and hypertension (OR 1.12). CONCLUSION: Overweight/obesity in children and adolescents is associated with increased fasting plasma total GLP-1 concentrations, which was predictive of higher CMR factors.","author_count":13,"contributors":["Stinson, Sara Elizabeth","Jonsson, Anna","Lund, Morten A V","Frithioff-Bøjsøe, Christine","Holm, Louise Aas","Pedersen, Oluf","Ängquist, Lars","Sørensen, Thorkild I A","Holst, Jens Juul","Christiansen, Michael","Holm, Jens-Christian","Hartmann, Bolette","Hansen, Torben"],"cuid":["S02-093.22-045627"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corresponding_author":["Hansen, Torben"],"keyword":["Adolescents","Cardiometabolic risk factors","Children","GLP 1","Obesity"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"fasting plasma glp 000000000001 is associated with overweight obesity and cardiometabolic risk factors in children and adolescents","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1210/clinem/dgab098","version":"Published Version"},"id":"S02-093.22-045627","identifier":[{"id":"000658237600039","type":"wos"},{"id":"85105237123","type":"scopus"},{"id":"PMC8118577","type":"pmcid"},{"id":"33596309","type":"pmid"}],"ids":["ku-b830b88b-1033-409e-b4d4-9306651f820b","sdu-9233dd90-54fd-4eb5-bf21-7ad1c0084c1c"],"keyword":["GLP-1","adolescents","cardiometabolic risk factors","children","obesity"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-7B8EC958CC54C9463971D8AC892FD97A"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/272239715/Fasting_Plasma_GLP_1_Is_Associated_With.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/183727707/dgab098.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1210/clinem/dgab098","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Novo Nordisk Foundation Center for Basic Metabolic Research, Hansen Group"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["University of Southern Denmark"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","first":"Sara E","key":"stinsonsaraelizabethpau","last":"Stinson","locid":"75924fce-d276-4bc3-a247-362923bccbb5","name":"Stinson, Sara Elizabeth","name_org":"Stinson, Sara E","orcid":"0000-0002-1491-9179","rank":1,"rolecode":"pau"},{"affno":"1","first":"Anna E","key":"jonssonannapau","last":"Jonsson","locid":"63e3d75a-e34d-442b-80f1-b0ea09706850","name":"Jonsson, Anna","name_org":"Jonsson, Anna E","orcid":"0000-0003-1252-8673","rank":2,"rolecode":"pau"},{"affno":"1","first":"Morten A V","key":"lundmortenavpau","last":"Lund","name":"Lund, Morten A V","rank":3,"rolecode":"pau"},{"affno":"1","first":"Christine","key":"frithioffbøjsøechristinepau","last":"Frithioff-Bøjsøe","locid":"30a3e531-560f-4477-8bd6-976c2c56e21d","name":"Frithioff-Bøjsøe, Christine","orcid":"0000-0002-5005-7780","rank":4,"rolecode":"pau"},{"affno":"1","first":"Louise Aas","key":"holmlouiseaaspau","last":"Holm","locid":"3c8db4dd-1b63-4f0c-8b8b-606ecb645ef9","name":"Holm, Louise Aas","orcid":"0000-0002-5439-5429","rank":5,"rolecode":"pau"},{"affno":"1","first":"Oluf","key":"pedersenolufpau","last":"Pedersen","locid":"0a2a7ad3-1719-43c6-bdf3-c3491a43a8af","name":"Pedersen, Oluf","orcid":"0000-0002-3321-3972","rank":6,"rolecode":"pau"},{"affno":"1","first":"Lars","key":"ängquistlarspau","last":"Ängquist","locid":"a3dbef57-d1a1-4473-b0f9-cb96376685b2","name":"Ängquist, Lars","orcid":"0000-0002-9516-4424","rank":7,"rolecode":"pau"},{"affno":"1","first":"Thorkild I. A.","key":"sørensenthorkildiapau","last":"Sørensen","locid":"2cb8cf47-6b6b-4010-bdf6-9ec77c7deed3","name":"Sørensen, Thorkild I A","name_org":"Sørensen, Thorkild I. A.","orcid":"0000-0003-4821-430X","rank":8,"rolecode":"pau"},{"affno":"1","first":"Jens J","key":"holstjensjuulpau","last":"Holst","locid":"864b6401-9024-4773-9bdb-f4d4ca57dcad","name":"Holst, Jens Juul","name_org":"Holst, Jens J","orcid":"0000-0001-6853-3805","rank":9,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Michael","key":"christiansenmichaelpau","last":"Christiansen","locid":"cc08c163-4e26-4ca3-8769-47d650079219","name":"Christiansen, Michael","rank":10,"rolecode":"pau"},{"affno":"1","first":"Jens-Christian","key":"holmjenschristianpau","last":"Holm","locid":"d61af840-e87e-4a2e-8be2-b481959ef6c9","name":"Holm, Jens-Christian","rank":11,"rolecode":"pau"},{"affno":"1","first":"Bolette","key":"hartmannbolettepau","last":"Hartmann","locid":"eb04fc6b-068a-4d5b-a106-1b7be3f7e12b","name":"Hartmann, Bolette","orcid":"0000-0001-8509-2036","rank":12,"rolecode":"pau"},{"affno":"1 2","first":"Torben","key":"hansentorbenpau","last":"Hansen","locid":"6b6bfff1-8b14-468b-af77-e71b375018e0","name":"Hansen, Torben","orcid":"0000-0001-8748-3831","rank":13,"rolecode":"pau"}],"pmid":["33596309"],"pub":{"doi":"10.1210/clinem/dgab098","issn":["0021972X","19457197"],"issn_org":["0021972X"],"issue":"6","journal":"Journal of Clinical Endocrinology and Metabolism","pages":"1718-1727","publisher":"Endocrine Society","status":"p","title":"Journal of Clinical Endocrinology and Metabolism","title_org":"The Journal of Clinical Endocrinology & Metabolism","volume":"106"},"review":"Peer Reviewed","scoID":["2-s2.0-85105237123"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Hospitals","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Region Zealand","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-b830b88b-1033-409e-b4d4-9306651f820b","sdu-9233dd90-54fd-4eb5-bf21-7ad1c0084c1c"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Fasting Plasma GLP-1 Is Associated With Overweight/Obesity and Cardiometabolic Risk Factors in Children and Adolescents","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-093.22-045627","year":"2021","yearsub":"2021"}
{"abstract":"Due to frequent exacerbations, many patients with chronic obstructive pulmonary disease (COPD) are exposed to oral corticosteroids (OCS), which may be thrombogenic. We evaluated the risk of hospitalisation with venous thromboembolism (VTE) and death in patients with acute exacerbation of COPD (AECOPD) treated with long and short OCS regimens. In this nationwide cohort study of 30, 473 COPD outpatients treated for AECOPD, we compared the risk of VTE hospitalisation and all-cause mortality within 6 months in OCS dose of > 250 mg vs. ≤ 250 mg. A multivariable Cox proportional hazard regression was used to estimate the risk. The incidence of VTE hospitalisations was 0.23%. A long OCS treatment course was associated with an increased risk of VTE compared to a short course (hazard ratio (HR) 1.69, [95% confidence interval (CI) 1.05 to 2.72], p < 0.031). A higher risk of all-cause mortality was seen in the group of COPD patients treated with a long OCS course (HR 1.71, [95% CI 1.63 to 1.79], p < 0.0001). The risk of reported VTE hospitalisation was higher among AECOPD patients treated with long courses of OCS, but the absolute risk was low, suggesting under-reporting of the condition.","author_count":23,"contributors":["Rastoder, Ema","Sivapalan, Pradeesh","Eklöf, Josefin","Saeed, Mohamad Isam","Jordan, Alexander Svorre","Meteran, Howraman","Tønnesen, Louise","Biering-Sørensen, Tor","Løkke, Anders","Seersholm, Niels","Nielsen, Thyge Lynghøj","Carlsen, Jørn","Janner, Julie","Godtfredsen, Nina","Bodtger, Uffe","Laursen, Christian B.","Hilberg, Ole","Knop, Filip K.","Priemé, Helene","Ingebrigtsen, Truls Sylvan","Gottlieb, Vibeke","Wilcke, Jon Torgny","Jensen, Jens Ulrik Stæhr"],"cuid":["S02-100.00-041112"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corresponding_author":["Rastoder, Ema"],"keyword":["COPD","Corticosteroids","Exacerbation","Pulmonary embolism","Venous thromboembolism"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-ZEA"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-ZEA","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"systemic corticosteroids and the risk of venous thromboembolism in patients with severe copd a nationwide study of 000000000030 000000000473 outpatients","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/biomedicines9080874","version":"Published Version"},"funding_acknowledgement":["Funding: This study was funded by The Novo Nordisk Foundation (grant number: NNF20OC0060657). The grant period started on September 1, 2020 and lasts for 5 years following that date. The grant must be utilized within this period. The administrating institution is Gentofte Hospital."],"id":"S02-100.00-041112","identifier":[{"id":"85111629614","type":"scopus"},{"id":"PMC8389624","type":"pmcid"},{"id":"34440079","type":"pmid"}],"ids":["ku-2bafe12e-7898-4ecb-8cf4-6b07960d4bac","sdu-92d2e468-c1b8-4248-b15e-762cd9569fb9"],"keyword":["COPD","Corticosteroids","Exacerbation","Pulmonary embolism","Venous thromboembolism"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-096DA83F4841D1A422B3202473636FE2"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/biomedicines9080874","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/276275823/biomedicines_09_00874_v3.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/185028886/biomedicines_09_00874_v3.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub