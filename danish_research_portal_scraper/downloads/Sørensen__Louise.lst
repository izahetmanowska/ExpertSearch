3a8e-4d93-bf14-e41f3f75a2c9","ku-0ca097d0-3f1a-4209-b877-73d9b36f173a","sdu-788135a4-7a39-4e43-9413-52bc19a35960"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Danish respiratory society position paper : palliative care in patients with chronic progressive non-malignant lung diseases","type":"Journal Review","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-097.72-004243","year":"2018","yearsub":"2018"}
{"abstract":"The study presented here is focused on the assessment of surface elevations derived from CryoSat-2 SARIn level 1b data over the Austfonna ice cap, Svalbard, in 2016. The processing chain that must be applied to the CryoSat-2 waveforms to derive heights is non-trivial, and consists of multiple steps, all requiring subjective choices of methods such as the choice of retracker, geo-relocation, and outlier rejection. Here, we compare six CryoSat-2 level-2 type data sets of surface elevations derived using different SARIn processing chains. These data sets are validated against surface elevation data collected from an airborne laser scanner, during a dedicated CryoSat validation experiment field campaign carried out in April 2016. The flight pattern of the airborne campaign was designed so that elevations were measured in a grid pattern rather than along single lines, as has previously been the standard procedure. The flight grid pattern was chosen to optimize the comparison with the CryoSat-2 SARIn elevation data, the location of which can deviate from nadir by several kilometers due to topography within the satellite footprint. The processing chains behind the six data sets include different outlier/error rejection approaches, and do not produce the same number of data points in our region of interest. To make a consistent analysis, we provide statistics from the validation of both the full data sets from each processing chain, and on only those data that all the six data sets provide a geo-located elevation estimate for. We find that the CryoSat-2 data sets that agree best with the validation data are those derived from dedicated land ice processing schemes. This study may serve as a benchmark for future CryoSat-2 retracker developments, and the evaluation software and data set are made publicly available.","author_count":10,"contributors":["Sørensen, Louise Sandberg","Simonsen, Sebastian Bjerregaard","Langley, Kirsty","Gray, Laurence","Helm, Veit","Nilsson, Johan","Stenseng, Lars","Skourup, Henriette","Forsberg, René","Davidson, Malcolm"],"cuid":["S01-000.00-321542"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","Europe, EU","Nordic","OECD"],"corresponding_author":["Simonsen, Sebastian Bjerregaard"],"country":["Canada","France","Germany","Greenland","United States"],"glorg":["ASIAQ Greenland Survey","Alfred Wegener Institute - Helmholtz Centre for Polar and Marine Research","All Global Affiliations","European Space Agency - ESA","NASA Jet Propulsion Laboratory","University of Ottawa"],"keyword":["CryoSat 2","CryoVEx","Validation"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"validation of cryosat 000000000002 sarin data over austfonna ice cap using airborne laser scanner measurements","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.3390/rs10091354","version":"Published Version"},"id":"S01-000.00-321542","identifier":[{"id":"85053631688","type":"scopus"}],"ids":["dtu-391b536c-5c42-47b7-8774-6ff545a0e415"],"keyword":["Airborne measurements","Austfonna","CryoSat-2","CryoVEx","Validation"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-896FB17EB4B2BA3C391F7F02C9A01B9B"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.3390/rs10091354","version":"Published Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/152809418/remotesensing_10_01354_v2.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Space Institute","Technical University of Denmark, National Space Institute, Geodynamics"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"gl","key":"asiaq greenland survey","loc":["Greenland","Nordic"],"name":"ASIAQ Greenland Survey","used":1},{"affno":"3","country":"ca","key":"university of ottawa","loc":["Canada","America, North","OECD"],"name":"University of Ottawa","used":1},{"affno":"4","country":"de","key":"alfred wegener institute helmholtz centre for polar and marine research","loc":["Germany","Europe, EU","OECD"],"name":"Alfred Wegener Institute - Helmholtz Centre for Polar and Marine Research","used":1},{"affno":"5","country":"us","key":"nasa jet propulsion laboratory","loc":["United States","America, North","OECD"],"name":"NASA Jet Propulsion Laboratory","used":1},{"affno":"6","country":"fr","key":"european space agency esa","loc":["France","Europe, EU","OECD"],"name":"European Space Agency - ESA","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Louise Sandberg","key":"sørensenpau","last":"Sørensen","locid":"1c6cb90f-da30-48a2-872f-a94b8100749b","name":"Sørensen, Louise Sandberg","orcid":"0000-0002-3771-4061","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sebastian B.","key":"simonsenpau","last":"Simonsen","locid":"d088b945-224e-4fd3-a871-022cc71c5cb1","name":"Simonsen, Sebastian Bjerregaard","name_org":"Simonsen, Sebastian B.","orcid":"0000-0001-9569-1294","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Kirsty","key":"langleypau","last":"Langley","name":"Langley, Kirsty","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Laurence","key":"graypau","last":"Gray","name":"Gray, Laurence","rank":4,"rolecode":"pau"},{"affno":"4","corresponding"