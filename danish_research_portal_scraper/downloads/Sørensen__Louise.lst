Institute of Public Health","SDU, The Faculty of Health Sciences, National Institute of Public Health, Mental health"],"nora_code":"DI-U-SDU","used":1},{"affno":"7","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Public Health, Department of Public Health - Institute of Environmental and Occupational Medicine"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jeppe K","key":"sørensenjeppekarlpau","last":"Sørensen","locid":"42f8c87d-2eda-4198-9cf5-fe5d426e9eb7","name":"Sørensen, Jeppe Karl","name_org":"Sørensen, Jeppe K","orcid":"0000-0002-0789-8752","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Louise","key":"dalsagerlouisepau","last":"Dalsager","locid":"09c67a97-b524-4868-a287-957d4f04e6d6","name":"Dalsager, Louise","orcid":"0000-0002-6931-9525","rank":2,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Lars L","key":"andersenlarslouispau","last":"Andersen","locid":"7918e862-7513-454a-874b-3fdb31af5e48","name":"Andersen, Lars Louis","name_org":"Andersen, Lars L","orcid":"0000-0003-2777-8085","rank":3,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Lars L","key":"andersenlarslpau","last":"Andersen","locid":"7698b281-bcfb-47ec-b41e-3ea20ceb5e52","name":"Andersen, Lars L.","name_org":"Andersen, Lars L","rank":3,"rolecode":"pau"},{"affno":"1 3","first":"Hans","key":"bayhanspau","last":"Bay","locid":"8693d1a9-68b7-4b92-aba6-b8499c9005b7","name":"Bay, Hans","rank":4,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"first":"Anne H","key":"gardeannehelenepau","last":"Garde","locid":"8e894baf-467c-45d3-8abe-41a805b30b22","name":"Garde, Anne Helene","name_org":"Garde, Anne H","orcid":"0000-0002-1553-2291","rank":5,"rolecode":"pau"},{"affno":"4 5","correspo