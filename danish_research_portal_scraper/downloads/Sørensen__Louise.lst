irst":"Maties","key":"torrentmatiespau","last":"Torrent","name":"Torrent, Maties","rank":63,"rolecode":"pau"},{"affno":"","first":"Tanja G. M.","key":"vrijkottetanjagmpau","last":"Vrijkotte","name":"Vrijkotte, Tanja G. M.","rank":64,"rolecode":"pau"},{"affno":"","first":"John","key":"wrightjohnpau","last":"Wright","name":"Wright, John","rank":65,"rolecode":"pau"},{"affno":"","first":"Oleksandr","key":"zvinchukoleksandrpau","last":"Zvinchuk","name":"Zvinchuk, Oleksandr","rank":66,"rolecode":"pau"},{"affno":"","first":"Romy","key":"gaillardromypau","last":"Gaillard","name":"Gaillard, Romy","rank":67,"rolecode":"pau"},{"affno":"","first":"Vincent W. V.","key":"jaddoevincentwvpau","last":"Jaddoe","name":"Jaddoe, Vincent W. V.","rank":68,"rolecode":"pau"}],"pmid":["32810184"],"pub":{"doi":"10.1371/journal.pmed.1003182","issn":["15491277","15491676"],"issn_org":["15491277"],"issue":"8","journal":"PLoS Medicine","paperid":"e1003182","publisher":"Public Library of Science","status":"p","title":"PLoS Medicine","volume":"17"},"review":"Peer Reviewed","scoID":["2-s2.0-85089645516"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-d063aee7-5e11-4aec-b2c1-1b8f1a49395a","sdu-8fbcded0-defc-4b59-9fa3-79ba89eef504"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Changes in parental smoking during pregnancy and risks of adverse birth outcomes and childhood overweight in Europe and North America : An individual participant data meta-analysis of 229,000 singleton births","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-091.98-046369","year":"2020","yearsub":"2020"}
{"abstract":"OBJECTIVE: This study aimed to assess the cost-effectiveness of telehealthcare in heart failure patients as add-on to usual care. DESIGN: A cost-utility analysis was conducted from a public payer perspective alongside the randomised controlled TeleCare North trial. SETTING: The North Denmark Region, Denmark. PARTICIPANTS: The study included 274 heart failure patients with self-reported New York Heart Association class II-IV. INTERVENTIONS: Patients in the intervention group were provided with a Telekit consisting of a tablet, a digital blood pressure monitor, and a scale and were instructed to perform measurements one to two times a week. The responsibility of the education, instructions and monitoring of the heart failure (HF) patients was placed on municipality nurses trained in HF and telemonitoring. Both groups received usual care. OUTCOME MEASURES: Cost-effectiveness was reported as incremental net monetary benefit (NMB). A micro-costing approach was applied to evaluate the derived savings in the first year in the public health sector. Quality-adjusted life-years (QALY) gained were estimated using the EuroQol 5-Dimensions 5-Levels questionnaire at baseline and at a 1-year follow-up. RESULTS: Data for 274 patients were included in the main analysis. The telehealthcare solution provided a positive incremental NMB of £5164. The 1-year adjusted QALY difference between the telehealthcare solution and the usual care group was 0.0034 (95% CI: -0.0711 to 0.0780). The adjusted difference in costs was -£5096 (95% CI: -8736 to -1456) corresponding to a reduction in total healthcare costs by 35%. All sensitivity analyses showed the main results were robust. CONCLUSIONS: The TeleCare North solution for monitoring HF was highly cost-effective. There were significant cost savings on hospitalisations, primary care contacts and total costs. TRIAL REGISTRATION NUMBER: ClinicalTrials.gov: NCT02860013.","author_count":5,"contributors":["Vestergaard, Anne Sig","Hansen, Louise","Sørensen, Sabrina Storgaard","Jensen, Morten Berg","Ehlers, Lars Holger"],"cuid":["S02-096.76-008441"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Health economics","Health informatics","Heart failure","Telemedicine"],"level":"sci","mra":["med","soc"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"is telehealthcare for heart failure patients cost effective an economic evaluation alongside the danish telecare north heart failure trial","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1136/bmjopen-2019-031670","version":"Published Version"},"id":"S02-096.76-008441","identifier":[{"id":"31992604","type":"pmid"},{"id":"85078687868","type":"scopus"},{"id":"PMC7045102","type":"pmcid"}],"ids":["aau-af14ea49-231f-496c-8701-ba2214b56497","au-5d3eaa38-22b1-40a0-911b-78a4c8c9475b"],"keyword":["health economics","health informatics","heart failure","telemedicine"],"lang":"English","level":"Scientific","mra":["Medical Science","Social Science"],"noi":["Global-Local-2-5-C681E8B7F80603D25F5549D79DCB0D7D"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1136/bmjopen-2019-031670","version":"Published Version"},{"access":"oa","license":"CC BY-NC 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/329645074/e031670.full.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine, Danish Center for Healthcare Improvements"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus BSS, Department of Economics and Business Economics"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Anne Sig","key":"vestergaardannesigpau","last":"Sørensen","locid":"6c898410-ecaa-4a9e-8081-57b1be2caa9d","name":"Vestergaard, Anne Sig","name_org":"Sørensen, Anne Sig","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Louise","key":"hansenlouisepau","last":"Hansen","locid":"b7baf576-08d5-4ba6-b916-50e6db07907a","name":"Hansen, Louise","orcid":"0000-0002-4400-2732","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Sabrina Storgaard","key":"sørensensabrinastorgaardpau","last":"Sørensen","locid":"b325e388-fdcf-4b93-8cd2-34d2c3d19c75","name":"Sørensen, Sabrina Storgaard","orcid":"0000-0002-6048-521X","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Morten Berg","key":"jensenmortenbergpau","last":"Jensen","locid":"40ea6794-4b17-47ce-8946-b4e759de75bf","name":"Jensen, Morten Berg","orcid":"0000-0002-9455-0104","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars Holger","key":"ehlerslarsholgerpau","last":"Ehlers","locid":"2ceddc99-bbe0-4721-8040-b4253e22468f","name":"Ehlers, Lars Holger","orcid":"0000-0001-6512-5566","rank":5,"rolecode":"pau"}],"pmid":["31992604"],"pub":{"doi":"10.1136/bmjopen-2019-031670","issn":["20446055"],"issue":"1","journal":"BMJ Open","paperid":"e031670","publisher":"BMJ Publishing Group","status":"p","title":"BMJ Open","volume":"10"},"review":"Peer Reviewed","scoID":["2-s2.0-85078687868"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-af14ea49-231f-496c-8701-ba2214b56497","au-5d3eaa38-22b1-40a0-911b-78a4c8c9475b"],"src":["AAU Aalborg University","AU Aarhus University"],"title":"Is telehealthcare for heart failure patients cost-effective? : An economic evaluation alongside the Danish TeleCare North heart failure trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-096.76-008441","year":"2020","yearsub":"2020"}
{"abstract":"Nanozymes, nanoparticles that mimic the natural activity of enzymes, are intriguing academically and are important in the context of the Origin of Life. However, current nanozymes offer mimicry of a narrow range of mammalian enzymes, near-exclusively performing redox reactions. We present an unexpected discovery of non-proteinaceous enzymes based on metals, metal oxides, 1D/2D-materials, and non-metallic nanomaterials. The specific novelty of these findings lies in the identification of nanozymes with apparent mimicry of diverse mammalian enzymes, including unique pan-glycosidases. Further novelty lies in the identification of the substrate scope for the lead candidates, specifically in the context of bioconversion of glucuronides, that is, human metabolites and privileged prodrugs in the field of enzyme-prodrug therapies. Lastly, nanozymes are employed for conversion of glucuronide prodrugs into marketed anti-inflammatory and antibacterial agents, as well as “nanozyme prodrug therapy” to mediate antibacterial measures.","author_count":19,"contributors":["Walther, Raoul","Winther, Anna","Fruergaard, Anne Sofie","Akker, Wouter van den","Sørensen, Lise","Nielsen, Signe Maria","Olesen, Morten Tobias Jarlstad","Dai, Yitao","Jeppesen, Henrik S.","Lamagni, Paolo","Savateev, Aleksandra","Pedersen, Søren L.","Riber, Camilla Frich","Vigier, Cécile Aude","Lock, Nina","Singh, Mandeep","Bansal, Vipul","Meyer, Rikke Louise","Zelikin, Alexander N."],"cuid":["S01-000.00-148310"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","OECD","Oceania"],"country":["Australia","Germany"],"glorg":["All Global Affiliations","Max Planck Institute of Colloids and Interfaces","Royal Melbourne Institute of Technology University"],"keyword":["Enzyme prodrug therapy","Glucuronide","Nanozymes","Prodrugs"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"identification and directed development of non organic catalysts with apparent pan enzymatic mimicry into nanozymes for efficient prodrug conversion","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85057456567","version":"Other Version"},"id":"S01-000.00-148310","identifier":[{"id":"85057456567","type":"scopus"},{"id":"30408323","type":"pmid"}],"ids":["au-212299d1-9b09-42bd-8c9b-aa2f9fc85ae3"],"keyword":["enzyme mimicry","enzyme-prodrug therapy","glucuronide","nanozymes","prodrugs"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-6780564E8C5E327E636503689A8D2435"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Chemistry"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"de","key":"max planck institute of colloids and interfaces","loc":["Germany","Europe, EU","OECD"],"name":"Max Planck Institute of Colloids and Interfaces","used":1},{"affno":"3","country":"au","key":"royal melbourne institute of technology university","loc":["Australia","Oceania","OECD"],"name":"Royal Melbourne Institute of Technology University","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Raoul","key":"waltherpau","last":"Walther","locid":"994eba41-cfe2-44bb-9280-b648f7292d72","name":"Walther, Raoul","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anna","key":"wintherpau","last":"Winther","locid":"723ed100-b0c9-4c12-9a0b-0bbbb1fe2501","name":"Winther, Anna","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anne Sofie","key":"fruergaardpau","last":"Fruergaard","locid":"0b3396a5-b6e2-4770-b1f7-8ce8600fd784","name":"Fruergaard, Anne Sofie","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Wouter van den","key":"akkerpau","last":"Akker","locid":"357295c8-ba33-41ef-a403-0d16d99ec047","name":"Akker, Wouter van den","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lise","key":"sørensenpau","last":"Sørensen","locid":"d08d61a7-4a7a-4349-ad94-3ce2e7efb01c","name":"Sørensen, Lise","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Signe Maria","key":"nielsenpau","last":"Nielsen","locid":"d1316f0c-0b76-4efe-8f69-89122076619c","name":"Nielsen, Signe Maria","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Morten Tobias Jarlstad","key":"olesenpau","last":"Olesen","locid":"2ee2eed7-1823-4213-a9c4-94c2aab5bb93","name":"Olesen, Morten Tobias Jarlstad","orcid":"0000-0002-7492-5124","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Yitao","key":"daipau","last":"Dai","locid":"c834e410-fa8a-4e8f-ba6c-719141150a04","name":"Dai, Yitao","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Henrik Særkjær","key":"jeppesenpau","last":"Jeppesen","locid":"7cfde68d-cf4c-4168-bdf4-75d5bc949cc2","name":"Jeppesen, Henrik S.","name_org":"Jeppesen, Henrik Særkjær","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Paolo","key":"lamagnipau","last":"Lamagni","locid":"17e5f3e7-11a6-4dc2-af32-336efc5ad1a5","name":"Lamagni, Paolo","rank":10,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Aleksandra","key":"savateevpau","last":"Savateev","name":"Savateev, Aleksandra","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren L.","key":"pedersenpau","last":"Pedersen","locid":"97fc32d4-bc52-414b-ae65-80e66ca7f206","name":"Pedersen, Søren L.","rank":12,"ro