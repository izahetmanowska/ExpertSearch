ty","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-79272e52-36f8-41ff-9896-f7866ccd8519","dtu-c53b658b-0aa3-4aa1-8ff1-70d7be64a424","ku-e2bc8058-507b-46fe-bc0b-d5f5ab4413c9"],"src":["AU Aarhus University","DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Differences in the effects of school meals on children's cognitive performance according to gender, household education and baseline reading skills","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-100.00-021514","year":"2016","yearsub":"2016"}
{"author_count":4,"contributors":["Sørensen, Marie-Louise Kirchhoff","Dahlmann, Casper Mondrup","Jakobsen, Mads Leth","Bækgaard, Martin"],"cuid":["S01-000.00-139756"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["soc"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"nr","rtype":["clu"],"sorti":"spørgeskemaundersøgelse i i forbindelse med region midtjyllands prøvehandling ny styring i et patientperspektiv datarapport","src":["au"],"src-code":["DI-U-AU"],"type":"dw","type-grp":["all","pub"]},"id":"S01-000.00-139756","ids":["au-12010096-1ce8-4188-9e93-84b97459a6cf"],"lang":"Danish","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-B9C3BF43280BF1731704766F7C06069D"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus BSS, Department of Political Science"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Marie-Louise Kirchhoff","key":"sørensenpau","last":"Sørensen","name":"Sørensen, Marie-Louise Kirchhoff","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Casper Mondrup","key":"dahlmannpau","last":"Dahlmann","name":"Dahlmann, Casper Mondrup","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mads Leth","key":"jakobsenpau","last":"Jakobsen","locid":"02d95a60-e9fe-4c26-ba11-45adcce43888","name":"Jakobsen, Mads Leth","orcid":"0000-0001-8923-3502","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Martin","key":"bækgaardpau","last":"Bækgaard","locid":"2446e702-3d88-464c-b83e-0b55cb910b2b","name":"Bækgaard, Martin","orcid":"0000-0001-6683-396X","rank":4,"rolecode":"pau"}],"pub":{"pages":"49","status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-12010096-1ce8-4188-9e93-84b97459a6cf"],"src":["AU Aarhus University"],"title":"Spørgeskemaundersøgelse (I) i forbindelse med Region Midtjyllands prøvehandling ”Ny styring i et patientperspektiv” : Datarapport","type":"Working Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-139756","year":"2016","yearsub":"2016"}
{"abstract":"Diagnosis-related groups are widespread across Europe and they are meant to be a central instrument to improve the activity and efficiency of hospitals. However, there are many examples of diagnosis-related groups having adverse effects which are difficult to control and which endanger the goals of health care systems in terms of efficiency, equity and quality. Political and administrative decision makers therefore need to fundamentally rethink hospital governance and consider new systems of budgeting and performance measurement. Central Denmark Region is currently piloting a system, based on the Triple Aim approach, which may offer inspiration.","author_count":2,"contributors":["Sørensen, Marie-Louise Kirchhoff","Burau, Viola"],"cuid":["S01-000.00-220905"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Diagnosis related groups","Hospital governance"],"level":"sci","mra":["soc"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"nr","rtype":["clu"],"sorti":"why we need to move beyond diagnosis related groups and how we might do so","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84960462009","version":"Other Version"},"id":"S01-000.00-220905","identifier":[{"id":"25972360","type":"pmid"},{"id":"84960462009","type":"scopus"}],"ids":["au-a0b456f0-03d9-47fe-8c65-d846026ab459"],"keyword":["Diagnosis-related groups","Hospital governance","Negative side effects","Triple aim approach"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-4-81F7509A447E7B5CEF5705DD3562FB67"],"org":[{"affno":"1","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus BSS, Department of Political Science"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Marie-Louise Kirchhoff","key":"sørensenpau","last":"Sørensen","name":"Sørensen, Marie-Louise Kirchhoff","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Viola","key":"buraupau","last":"Burau","locid":"6dad91a6-297b-4331-9397-44f2626d05f5","name":"Burau, Viola","orcid":"0000-0003-1225-6583","rank":2,"rolecode":"pau"}],"pmid":["25972360"],"pub":{"doi":"10.1177/1355819615586444","issn":["13558196","17581060"],"issn_org":["13558196"],"issue":"1","journal":"Journal of Health Services Research & Policy","pages":"64-66","publisher":"SAGE Publications Ltd","status":"p","title":"Journal of Health Services Research & Policy","volume":"21"},"review":"No Review","scoID":["2-s2.0-84960462009"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-a0b456f0-03d9-47fe-8c65-d846026ab459"],"src":["AU Aarhus University"],"title":"Why we need to move beyond diagnosis-related groups and how we might do so","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-220905","year":"2016","yearsub":"2016"}
{"abstract":"The ESA “Greenland_ice_sheet_cci” project is currently making past and present space measurements of Greenland ice sheet changes available for use by scientists, stakeholders and the general public. The data are part of a large set of ECV’s (Essential Climate Variables) made available by the ESA Climate Initiative, as a contribution to the global Climate Observing System. The ECV data produced for the Greenlandice sheet include detailed grids of elevation changes and ice flow velocities, as well as line data of grounding lines and calving front locations for major outlet glaciers. The “ice_sheets_cci” goal is to generate a consistent, validated, long-term and timely set of ECV’s, a.o. to improve the impact of satellite data on climate research and coupled ice sheet/climate models. Special focus is on use of data from ESA missions such as ERS, Envisat and the new Sentinel missions, but in the 2nd phase of the project, just initiated, mass balance data from the GRACE mission will also be included. In the presentation the current CCI results are highlighted, including Greenland-wide elevation change results across 23 years of radar altimetrry from ERS, Envisat and CryoSat, ice velocities for the coastal regions and major outlet glaciers, new Greenland-wide ice velocities from the ESA Sentinel-1 mission, and 14 years of mass changes from GRACE. The ECV data confirm a consistent overall picture of accelerating mass loss of the Greenlandice sheet, a mass loss which has more the doubled in the last decade. Current rates of changes well above 250 GT/year, corresponding to 0.7 mm/year global sea level rise, and originating especially from mass loss associated with major outlet glacier systems. In the future it is proposed to add additional ECV parameters to the products, including a.o. high-resolution mass change products from GRACE/CryoSat/S-3, and ocean sea level rise regional “finger print” data from the associated closure of the overall global sea level budget, in cooperation with Glaciers, Antarctica and Sea Level CCI projects.","author_count":17,"contributors":["Forsberg, René","Sørensen, Louise Sandberg","Meister, Rakia","Simonsen, Sebastian Bjerregaard","Dall, Jørgen","Kusk, Anders","Nagler, Thomas","Hetzenegger, Marcus","Evensberget, Dag","Hauglund, Kenneth","Khvorostovsky, Kirill","Shepherd, Andy","Hogg, Anna","Andersen, Signe","Hvidberg, Christine","Svensen, Synne","Engdahl, Marcus"],"cuid":["S01-000.00-338451"],"event":{"end":"2016-05-13","place":"Prague, cz","start":"2016-05-09","title":"ESA Living Planet Symposium 2016","year":"2016"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","Nordic","OECD"],"country":["Austria","Italy","Norway","United Kingdom"],"glorg":["All Global Affiliations","ENVEO IT GmbH","ESRIN - ESA Centre for Earth Observation","Nansen Environmental and Remote Sensing Center","S[&]T Science and Technology AS","University of Leeds"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-DMI","DI-GV-GEUS"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-GV-DMI","DI-GV-GEUS","DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"spaceborne measurement of greenland ice sheet changes the esa greenland cci project","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://lps16.esa.int/page_session185.php#1783p","version":"Published Version"},"id":"S01-000.00-338451","ids":["dtu-718878ce-7c30-45d9-acdb-b8520f3a7ad1"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-7F0EA050BAC2E03055F3CA63C36E3A1D"],"oa_link":[{"access":"oa","type":"rem","url":"http://lps16.esa.int/page_session185.php#1783p","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of d