/j.jhydrol.2019.01.032","issn":["00221694"],"journal":"Journal of Hydrology","pages":"21-35","publisher":"Elsevier","status":"p","title":"Journal of Hydrology","volume":"571"},"review":"Peer Reviewed","scoID":["2-s2.0-85061191617"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-661fdd35-e88f-4249-95b1-819107029ba7","ku-bb0f5f42-1afb-4044-a182-2e65baaede5f"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Transient increase in reactive surface and the macroscopic Damköhler number in chalk dissolution","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-034923","year":"2019","yearsub":"2019"}
