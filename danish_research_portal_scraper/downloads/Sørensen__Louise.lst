":2,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Simon","key":"fagepau","last":"Fage","locid":"255b6adb-2e53-4c19-ad4c-3fbc5c2776bd","name":"Fage, Simon","rank":3,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Howraman","key":"meteranpau","last":"Meteran","locid":"f9af65e8-938a-4e55-a5f0-8482173d33f5","name":"Meteran, Howraman","rank":4,"rolecode":"pau"},{"affno":"1 2","first":"Lone","key":"skovpau","last":"Skov","locid":"3c315ac3-214b-432d-9741-92790d5b5932","name":"Skov, Lone","rank":5,"rolecode":"pau"},{"affno":"1 2","first":"Claus","key":"zachariaepau","last":"Zachariae","locid":"ee5c26db-8a40-4753-b9da-249ffce2b771","name":"Zachariae, Claus","rank":6,"rolecode":"pau"},{"affno":"2 1 5","first":"Filip Krag","key":"knoppau","last":"Knop","locid":"ce6eaad9-59f8-4ecf-8a1e-388a74734f6a","name":"Knop, Filip K.","name_org":"Knop, Filip Krag","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Mia Louise","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Mia Louise","rank":8,"rolecode":"pau"},{"affno":"1 2","first":"Alexander","key":"egebergpau","last":"Egeberg","locid":"e4445a48-c228-4507-b47c-a83175478f82","name":"Egeberg, Alexander","rank":9,"rolecode":"pau"}],"pmid":["38431099"],"pub":{"doi":"10.1016/j.jaad.2024.02.036","issn":["01909622","10976787"],"issn_org":["01909622"],"issue":"1","journal":"Journal of the American Academy of Dermatology","pages":"64-71","publisher":"Elsevier Inc.","status":"p","title":"Journal of the American Academy of Dermatology","volume":"91"},"review":"Peer Reviewed","scoID":["2-s2.0-85189094417"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-083a95a7-6570-4d0d-84da-588e1fab32a6","ku-d388e226-9e88-4e3f-971f-f5c594e7bcb2"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Effects of oral roflumilast therapy on body weight and cardiometabolic parameters in patients with psoriasis – results from a randomized controlled trial (PSORRO)","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.50-741663","year":"2024","yearsub":"2024"}
{"abstract":"Background: Excess abdominal visceral adipose tissue (VAT) is associated with metabolic diseases and poor survival in colon cancer (CC). We assessed the impact of different types of CC surgery on changes in abdominal fat depots. Material and methods: Computed tomography (CT)-scans performed preoperative and 3 years after CC surgery were analyzed at L3-level for VAT, subcutaneous adipose tissue (SAT) and total adipose tissue (TAT) areas. We assessed changes in VAT, SAT, TAT and VAT/SAT ratio after 3 years and compared the changes between patients who had undergone left-sided and right-sided colonic resection in the total population and in men and women separately. Results: A total of 134 patients with stage I-III CC undergoing cancer surgery were included. Patients who had undergone left-sided colonic resection had after 3 years follow-up a 5% (95% CI: 2–9%, p < 0.01) increase in abdominal VAT, a 4% (95% CI: 2–6%, p < 0.001) increase in SAT and a 5% increase (95% CI: 2–7%, p < 0.01) in TAT. Patients who had undergone right-sided colonic resection had no change in VAT, but a 6% (95% CI: 4–9%, p < 0.001) increase in SAT and a 4% (95% CI: 1–7%, p < 0.01) increase in TAT after 3 years. Stratified by sex, only males undergoing left-sided colonic resection had a significant VAT increase of 6% (95% CI: 2–10%, p < 0.01) after 3 years. Conclusion: After 3 years follow-up survivors of CC accumulated abdominal adipose tissue. Notably, those who underwent left-sided colonic resection had increased VAT and SAT, whereas those who underwent right-sided colonic resection demonstrated solely increased SAT. [Figure not available: see fulltext.]","author_count":14,"contributors":["Kays Mohammed Ali, Younes","Dolin, Troels Gammeltoft","Damm Nybing, Janus","Lykke, Jakob","Hvid Linden, Frederik","Høgh-Schmidt, Erik","Sørensen, Thorkild I A","Christensen, Jesper Frank","Nielsen, Yousef Jesper Wirenfeldt","Stenfatt Larsen, Jim","Madsbad, Sten","Johansen, Julia S.","Svane, Maria Saur","Lang Lehrskov, Louise"],"cuid":["S02-100.00-735598"],"filters":{"added":"2024-05","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corresponding_author":["Lang Lehrskov, Louise"],"keyword":["Colonic Neoplasms surgery","Female","Humans","Intra Abdominal Fat diagnostic imaging","Male","Obesity Abdominal complications","Obesity complications","Subcutaneous Fat","Tomography X Ray Computed"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"change in abdominal obesity after colon cancer surgery effects of left sided and right sided colonic resection","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41366-023-01445-8","version":"Published Version"},"funding_acknowledgement":["This work was supported by the Danish Diabetes Association and the Danish Diabetes Academy, which is funded by the Novo Nordisk Foundation under grant number NNF17SA0031406. The Centre for Physical Activity Research (CFAS) is supported by TrygFonden (grants ID 101390, ID 20045, and ID 125132). The VELUX foundation (Grant project number 00018310, salary to TGD) is acknowledged. Chief physician Benny Vittrup is acknowledged for his important contribution to the REBECCA study."],"id":"S02-100.00-735598","identifier":[{"id":"85181255445","type":"scopus"},{"id":"38172335","type":"pmid"},{"id":"PMC10978490","type":"pmcid"}],"ids":["ku-f7f4fd90-9076-4045-86d4-03a69ec6b7f9","sdu-408343ea-e949-4153-8514-7d19d8a2a3e6"],"keyword":["Colonic Neoplasms/surgery","Female","Humans","Intra-Abdominal Fat/diagnostic imaging","Male","Obesity, Abdominal/complications","Obesity/complications","Subcutaneous Fat","Tomography, X-Ray Computed"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-CB21E8039B6233FD240FFD8A60567ACD"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/259713451/s41366-023-01445-8.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/387384947/s41366_023_01445_8.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41366-023-01445-8","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Amager and Hvidovre"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"3","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics","SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics, Research Unit of Exercise Epidemiology"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","first":"Younes","key":"kaysmohammedalipau","last":"Kays Mohammed Ali","name":"Kays Mohammed Ali, Younes","rank":1,"rolecode":"pau"},{"affno":"2 1","first":"Troels Gammeltoft","key":"dolinpau","last":"Dolin","locid":"513a4abd-62d4-4a3b-b81c-d949c9536ba4","name":"Dolin, Troels Gammeltoft","rank":2,"rolecode":"pau"},{"affno":"1","first":"Janus","key":"dammnybingpau","last":"Damm Nybing","name":"Damm Nybing, Janus","rank":3,"rolecode":"pau"},{"affno":"1","first":"Jakob","key":"lykkepau","last":"Lykke","name":"Lykke, Jakob","rank":4,"rolecode":"pau"},{"affno":"1","first":"Frederik","key":"hvidlindenpau","last":"Hvid Linden","name":"Hvid Linden, Frederik","rank":5,"rolecode":"pau"},{"affno":"1","first":"Erik","key":"høghschmidtpau","last":"Høgh-Schmidt","name":"Høgh-Schmidt, Erik","rank":6,"rolecode":"pau"},{"affno":"2","first":"Thorkild I.A.","key":"sørensenpau","last":"Sørensen","locid":"2cb8cf47-6b6b-4010-bdf6-9ec77c7deed3","name":"Sørensen, Thorkild I A","name_org":"Sørensen, Thorkild I.A.","orcid":"0000-0003-4821-430X","rank":7,"rolecode":"pau"},{"affno":"3 1","corresponding":null,"first":"Jesper Frank","key":"christensenpau","last":"Christensen","locid":"ef881205-87ea-4b8f-bee3-f5c75c44e18d","name":"Christensen, Jesper Frank","orcid":"0000-0003-4858-1505","rank":8,"rolecode":"pau"},{"affno":"1 2","first":"Yousef J.W.","key":"nielsenpau","last":"Nielsen","locid":"41cd192a-a0fd-4fd8-9361-cbedd07691f9","name":"Nielsen, Yousef Jesper Wirenfeldt","name_org":"Nielsen, Yousef J.W.","rank":9,"rolecode":"pau"},{"affno":"1","first":"Jim","key":"stenfattlarsenpau","last":"Stenfatt Larsen","name":"Stenfatt Larsen, Jim","rank":10,"rolecode":"pau"},{"affno":"2 1","first":"Sten","key":"madsbadpau","last":"Madsbad","locid":"1018c708-245a-4057-9263-074578042385","name":"Madsbad, Sten","rank":11,"rolecode":"pau"},{"affno":"1 2","first":"Julia","key":"sideniusjohansenpau","last":"Sidenius Johansen","locid":"b2f1fd05-1a2e-4879-b015-af4dfa479876","name":"Johansen, Julia S.","name_org":"Sidenius Johansen, Julia","rank":12,"rolecode":"pau"},{"affno":"1","first":"Maria Saur","key":"svanepau","last":"Svane","name":"Svane, Maria Saur","rank":13,"rolecode":"pau"},{"affno":"1","first":"Louise","key":"langlehrskovpau","last":"Lang Lehrskov","name":"Lang Lehrskov, Louise","rank":14,"rolecode":"pau"}],"pmid":["38172335"],"pub":{"doi":"10.1038/s41366-023-01445-8","issn":["03070565","14765497"],"issn_org":["03070565"],"issue":"4","journal":"International Journal of Obesity","pages":"533-541","publisher":"Springer","status":"p","title":"International Journal of Obesity","volume":"48"},"review":"Peer Reviewed","scoID":["2-s2.0-85181255445"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-f7f4fd90-9076-4045-86d4-03a69ec6b7f9","sdu-408343ea-e949-4153-8514-7d19d8a2a3e6"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Change in abdominal obesity after colon cancer surgery – effects of left-sided and right-sided colonic resection","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-735598","year":"2024","yearsub":"2024"}
{"abstract":"The New Nordic Renal Diet (NNRD) is a meal pattern reduced in phosphorus, protein, and sodium for patients with moderate chronic kidney disease. The NNRD showed improvements in metabolic, and physiological outcomes after 26-weeks intervention. In the original study, participants were randomized to NNRD (n = 30), or control (habitual diet) (n = 30). The aim of this study was to explore adherence to the NNRD 3 months after cessation of intervention (follow-up). Fifty-seven participants completed the follow-up visit, which consisted of fasting blood samples and 24 h urine samples. At follow-up, there was no longer a significant reduction in 24 h urine phosphorus excretion in the NNRD group. From intervention to follow-up, 24 h urine phosphorus increased by 63 mg in the NNRD group, vs. −24.1 mg in the control group, between-group difference 87.1 mg (−10.1, 184.3, p = 0.08). Our findings show that more active intervention is needed to support adherence and maintain beneficial effects of the NNRD.","author_count":8,"contributors":["Hansen, Nikita Misella","Kamper, Anne-Lise","Rix, Marianne","Feldt-Rasmussen, Bo","Sørensen, Mads Vaarby","Berg, Peder","Astrup, Arne","Salomo, Louise"],"cuid":["S02-100.00-741891"],"filters":{"added":"2024-05","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Hansen, Nikita Misella"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-NP","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"NP":["DI-NP-ALL","DI-NP-NOVO"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-NP-NOVO","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"post intervention adherence to the new nordic renal diet among patients with chronic kidney disease stages 000000000003 and 000000000004","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85185458468","version":"Other Version"},"id":"S02-100.00-741891","identifier":[{"id":"85185458468","type":"scopus"},{"id":"38383708","type":"pmid"}],"ids":["au-7a6cd71c-f568-4cf8-8306-829e691deba5","ku-5686916f-a644-493c-9367-8c90201b0f30"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-448B95B904328BC941DD4754CAB6E02B"],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Internal Medicine: Nephrology"],"nora_code":"DI-U-KU","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Biomedicine, Department of Biomedicine - Forskning og uddannelse, Skou-bygningen"],"nora_code":"DI-U-AU","used":1},{"affno":"4","country":"dk","key":"novo nordisk foundation","l2":"DI-NP","l2n":"Non-Profit Organisations","l3":"DI-NP-NOVO","l3nn":"Novo Nordisk Foundation","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Novo Nordisk Foundation","namevar":["Novo Nordisk Foundation"],"nora_code":"DI-NP-NOVO","used":1}],"person":[{"affno":"1","first":"Nikita Misella","key":"hansenpau","last":"Hansen","name":"Hansen, Nikita Misella","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anne-Lise","key":"kamperpau","last":"Kamper","name":"Kamper, Anne-Lise","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Marianne","key":"rixpau","last":"Rix","name":"Rix, Marianne","rank":3,"rolecode":"pau"},{"affno":"1 2","first":"Bo","key":"feldtrasmussenpau","last":"Feldt-Rasmussen","locid":"cdd06e7b-83c5-4118-8808-eb4591586aac","name":"Feldt-Rasmussen, Bo","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Mads Vaarby","key":"sørensenpau","last":"Sørensen","locid":"f42195c2-31a1-460d-aecc-316e6dfe8baf","name":"Sørensen, Mads Vaarby","orcid":"0000-0001-6398-1035","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Peder","key":"bergpau","last":"Berg","locid":"e78b0bcb-ed5f-4b7d-ae94-1793d5d65e21","name":"Berg, Peder","orcid":"0000-0002-5216-2891","rank":6,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Arne","key":"astruppau","last":"Astrup","name":"Astrup, Arne","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Louise","key":"salomopau","last":"Salomo","name":"Salomo, Louise","rank":8,"rolecode":"pau"}],"pmid":["38383708"],"pub":{"doi":"10.1038/s41430-024-01413-z","issn":["09543007","14765640"],"issn_org":["09543007"],"issue":"6","journal":"European Journal of Clinical Nutrition","pages":"544-547","status":"p","title":"European Journal of Clinical Nutrition","volume":"78"},"review":"Peer Reviewed","scoID":["2-s2.0-85185458468"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Non-Profit Organisations","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-NP","DI-NP-ALL","DI-U","DI-U-ALL","Hospitals","Non-Profit Organisations","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-7a6cd71c-f568-4cf8-8306-829e691deba5","ku-5686916f-a644-493c-9367-8c90201b0f30"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Post-intervention Adherence to the New Nordic Renal Diet among patients with chronic kidney disease, stages 3 and 4","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-741891","year":"2024","yearsub":"2024"}
{"abstract":"BACKGROUND: Shared decision making in healthcare is a fundamental right for patients. Healthcare professionals' perception of their own abilities to enable shared decision making is crucial for implementing shared decision making within service. IcanSDM (I can shared decision making) is a brief measure to investigate healthcare professionals' perception of shared decision making approaches to their practices. It was developed in Canada with French and English versions, and recently translated into German. This study aims to adapt the IcanSDM measure for Danish-speaking healthcare professionals, and evaluate its psychometric properties. METHODS: Cultural adaptation and translation based on Beaton et al.'s approach was applied. A forward translation by ten people and a backward translation by two people were performed. To assess comprehensibility, cognitive interviews were conducted with 24 healthcare professionals. Eighty healthcare professionals who were trained in shared decision making for either one hour (n = 65) or one day (n = 15) participated in the psychometric evaluation. The evaluation concerned acceptance, item characteristics, skewness, item difficulties, corrected item-total correlations, inter-item correlations, factorial structure, internal consistency, and responsiveness. RESULTS: The forward and backward translation revealed few discrepancies, and participants understood the items well. The psychometric evaluation showed a high completion rate and acceptable item difficulties and discrimination values. Both the factor analysis and the internal consistency showed a 2-factor structure: 1) healthcare professionals' capacity to implement shared decision making; and 2) healthcare professionals' capacity to practise shared decision making. The IcanSDM_Danish obtained a Cronbach's alpha coefficient of 0.74. The evaluation of responsiveness showed improvement, but was not statistically significant. CONCLUSION: The IcanSDM_Danish has good cross-cultural validity and internal consistency, and a 2-factor structure. The IcanSDM_Danish is capable of providing reliable and valid measurement when evaluating constructed knowledge about shared decision making, and may be able to support the implementation of shared decision making training and evaluation of its impact.","author_count":13,"contributors":["Finderup, Jeanette","Bekker, Hilary L","Albèr, Nadia Thielke","Boel, Susanne","Buur, Louise Engelbrecht","von Essen, Helle Sørensen","Kristensen, Anne Wilhøft","Lyng, Kristian Damgaard","Vedelø, Tina Wang","Rasmussen, Gitte Susanne","Skovlund, Pernille Christiansen","Søndergaard, Stine Rauff","Giguère, Anik"],"cuid":["S03-099.49-767081"],"filters":{"added":"2025-01","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"continent":["America, North","Europe, Non-EU","OECD"],"corresponding_author":["Finderup, Jeanette"],"country":["Canada","United Kingdom"],"glorg":["All Global Affiliations","Leeds Unit of Complex Intervention Development, Leeds Institute of Health Sciences, School of Medicine, University of Leeds, Leeds","Universite Laval","University of Leeds","Université Laval"],"keyword":["Adult","Attitude of Health Personnel","Decision Making Shared","Denmark","Female","Fælles beslutningstagning","Health Personnel","Humans","Implementation","Male","Measurement","Middle Aged","Psychometrics","Psychometrics standards","Reproducibility of Results","Shared decision making","Surveys and Questionnaires standards","Translating","Translation","Translations","sundhedsprofessionelles perspektiver"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR"],"OT":["Department of Family Medicine and Emergency Medicine, University Laval, Quebec City"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-U-AAU","DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"measuring healthcare professionals perceptions of their ability to adopt shared decision making translation and psychometric evaluation of the danish version of the icansdm questionnaire","src":["aau","au","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1186/s12911-024-02747-1","version":"Published Version"},"funding_acknowledgement":["We thank all the HCP participants who took part in this study. We thank Professor Jean-Sebastien Renaud from the Department of Family Medicine and Emergency Medicine at Laval University, Quebec City, Canada, and biostatistician Pierre-Hugues Carmichael from the Centre d'Excellence sur le Vieillissement de Qu\\u00E9bec (CEVQ) in Quebec City, Canada who conducted the statistical analysis."],"id":"S03-099.49-767081","identifier":[{"id":"39548440","type":"pmid"},{"id":"PMC11566505","type":"pmcid"},{"id":"85209065429","type":"scopus"}],"ids":["aau-df5bd43e-a01a-469a-9e11-2fed09542ddd","au-283c81eb-ed80-4f8f-8a64-3fe49db6dd84","sdu-673ee38c-7bf9-4702-97f0-256bc5899699"],"keyword":["Adult","Attitude of Health Personnel","Decision Making, Shared","Denmark","Female","Fælles Beslutningstagning","Health Personnel","Humans","Implementation","Male","Measurement","Middle Aged","Psychometrics","Psychometrics/standards","Reproducibility of Results","Shared decision making","Surveys and Questionnaires/standards","Translating","Translation","Translations","sundhedsprofessionelles perspektiver"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-130CDE0133099C5C24F916B8B232BB23"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/276757058/s12911-024-02747-1.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/