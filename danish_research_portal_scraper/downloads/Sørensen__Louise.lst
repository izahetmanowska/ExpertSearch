ffno":"5 6","corresponding":null,"first":"Judith","key":"piontekpau","last":"Piontek","name":"Piontek, Judith","rank":3,"rolecode":"pau"},{"affno":"5 7 8","corresponding":null,"first":"Benjamin A.","key":"langepau","last":"Lange","name":"Lange, Benjamin A.","rank":4,"rolecode":"pau"},{"affno":"5 8","corresponding":null,"first":"Christian","key":"katleinpau","last":"Katlein","name":"Katlein, Christian","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Heidi Louise","key":"sørensenpau","last":"Sørensen","locid":"7a5442bb-7ee3-464b-9b90-eee87aee3b39","name":"Sørensen, Heidi Louise","rank":6,"rolecode":"pau"},{"affno":"9 10 11","corresponding":null,"first":"Daniel F.","key":"mcginnispau","last":"McGinnis","name":"McGinnis, Daniel F.","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lorenzo","key":"rovellipau","last":"Rovelli","locid":"6b970b0b-6847-4a0c-9f45-f1ad87dfea99","name":"Rovelli, Lorenzo","rank":8,"rolecode":"pau"},{"affno":"4 12 13","corresponding":null,"country":"dk","first":"Søren","key":"rysgaardpau","last":"Rysgaard","locid":"781dd219-a3b6-45e7-82c8-917c7cb6112e","name":"Rysgaard, Søren","orcid":"0000-0003-1726-2958","rank":9,"rolecode":"pau"},{"affno":"5 14 8","corresponding":null,"first":"Frank","key":"wenzhöferpau","last":"Wenzhöfer","name":"Wenzhöfer, Frank","rank":10,"rolecode":"pau"},{"affno":"1 15","corresponding":null,"first":"Ronnie N.","key":"gludpau","last":"Glud","locid":"aa184a3b-a696-4a69-a7de-66a3eea542cf","name":"Glud, Ronnie N.","orcid":"0000-0002-7069-893X","rank":11,"rolecode":"pau"}],"pub":{"doi":"10.1007/s00300-018-2350-1","issn":["07224060","14322056"],"issn_org":["07224060"],"issue":"10","journal":"Polar Biology","pages":"2119-2134","publisher":"Springer Science and Business Media Deutschland GmbH","status":"p","title":"Polar Biology","volume":"41"},"review":"Peer Reviewed","scoID":["2-s2.0-85048370474"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["au-97e4804a-5cac-4d33-b05b-a972aea775f2","sdu-e0513e76-34fb-451b-939e-9d9810fcdcd8"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"Oxygen fluxes beneath Arctic land-fast ice and pack ice : towards estimates of ice productivity","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-023726","year":"2018","yearsub":"2018"}
{"abstract":"We pose a spatial predator–prey model in which the movement of animals is not purely diffusive, but also contains a drift term in the direction of higher specific growth rates. We refer to this as fitness taxis. We conduct a linear stability analysis of the resulting coupled reaction–advection–diffusion equations and derive conditions under which spatial patterns form. We find that for some parameters the problem is ill posed and short waves grow with unbounded speeds. To eliminate this, we introduce spatial kernels in the model, yielding coupled integro-differential equations, and conduct a similar stability analysis for this system. Through numerical simulation, we find that a variety of patterns can emerge, including stationary spatial patterns, standing and travelling waves, and seemingly chaotic spatio-temporal patterns. We argue that fitness taxis represents a simple and generic extension of diffusive motion, is ecologically plausible, and provides an alternative mechanism for formation of patterns in spatially explicit ecosystem models, with emphasis on non-stationary spatio-temporal dynamics.","author_count":3,"contributors":["Heilmann, Irene Louise Torpe","Thygesen, Uffe Høgsbro","Sørensen, Mads Peter"],"cuid":["S01-000.00-341541"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Sørensen, Mads Peter"],"keyword":["Cross diffusion","Fitness taxis","Pattern formation"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"spatio temporal pattern formation in predator prey systems with fitness taxis","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85046695039","version":"Other Version"},"funding_acknowledgement":["This work was supported by the Centre for Ocean Life, a VKR Centre of Excellence funded by the Villum Foundation. Appendix A"],"id":"S01-000.00-341541","identifier":[{"id":"85046695039","type":"scopus"}],"ids":["dtu-7bfa3d09-998f-4447-b690-229a58dba630"],"keyword":["Cross-diffusion","Fitness taxis","Pattern formation","Predator–prey systems"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-0D724D06991972AB2743053EF246C83B"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Applied Mathematics and Computer Science","Technical University of Denmark, National Institute of Aquatic Resources","Technical University of Denmark, National Institute of Aquatic Resources, Centre for Ocean Life"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Irene T.","key":"heilmannpau","last":"Heilmann","locid":"1194dade-cad7-4492-819f-e12576665243","name":"Heilmann, Irene Louise Torpe","name_org":"Heilmann, Irene T.","orcid":"0000-0003-2185-1165","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Uffe Høgsbro","key":"thygesenpau","last":"Thygesen","locid":"2e512345-29bf-435a-b673-5858f7028550","name":"Thygesen, Uffe Høgsbro","orcid":"0000-0002-4311-6324","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mads Peter","key":"sørensenpau","last":"Sørensen","locid":"651b67f7-1e41-4719-8369-01b34075cd6b","name":"Sørensen, Mads Peter","orcid":"0000-0003-0820-8722","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.ecocom.2018.04.003","issn":["1476945X","14769840"],"issn_org":["1476945X"],"journal":"Ecological Complexity: An International Journal on Biocomplexity in the Environment and Theoretical Ecology","pages":"44-57","publisher":"Elsevier","status":"p","title":"Ecological Complexity: An International Journal on Biocomplexity in the Environment and Theoretical Ecology","title_org":"Ecological Complexity","volume":"34"},"review":"Peer Reviewed","scoID":["2-s2.0-85046695039"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-7bfa3d09-998f-4447-b690-229a58dba630"],"src":["DTU Technical University of Denmark"],"title":"Spatio-temporal pattern formation in predator-prey systems with fitness taxis","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-341541","year":"2018","yearsub":"2018"}
{"abstract":"Studies of the sea level budget are a means of assessing and understanding how sea level is changing and what are the causes. Closure of the total sea level budget implies that the observed changes of global mean sea level as determined from satellite altimetry equal the sum of observed (or otherwise assessed) contributions, namely changes in ocean mass and ocean thermal expansion and haline contraction. Here, ocean mass changes can be either derived from GRACE satellite gravimetry (since 2002) or from assessments of the individual contributions from glaciers, ice sheets, land water storage, snow pack and atmospheric water content. Estimates of thermosteric sea level are obtained from ocean in situ measurements with additional plans for the inclusion of satellite derived Sea Surface Temperature information. Misclosure of the sea level budget indicates errors in some of the components or contributions from missing or unassessed elements in the budget. ESA's Climate Change Initiative (CCI) has conducted a number of projects related to sea level. Among those projects, the Sea Level CCI project, the Greenland and Antarctic Ice Sheet CCI projects and the Glaciers CCI project directly benefit from satellite altimetry data. The Glaciers CCI project and the Sea Surface Temperature CCI project provide additional insights into phenomena related to sea level change. The aim of the ongoing CCI Sea Level Budget Closure project is to use the CCI data products, together with further data products provided by the project partners to re-assess the sea level budget. Specifically, the project further develops and analyzes products based on the CCI projects mentioned above in conjunction with in situ data for ocean thermal expansion (e.g., Argo), GRACEbased ocean mass change assessments, and modelbased data for glaciers and land hydrology. The work benefits from directly involving the expertise on the product generation for all the involved sea level contributions.","author_count":28,"contributors":["Horwath, M.","Cazenave, A.","Palanisamy, H.","Marzeion, B.","Paul, F.","Le Bris, R.","Hogg, A.","Otosaka, I.","Shepherd, A.","Döll, P.","Caceres, D.","Müller Schmied, H.","Johannessen, J.","Nilsen, J.","Raj, R.","Forsberg, René","Sørensen, Louise Sandberg","Barletta, Valentina Roberta","Knudsen, Per","Andersen, Ole Baltazar","Villadsen, H.","Merchant, C.","Old, C.","von Schuckmann, K.","Gutknecht, B.","Novotny, K.","Groh, A.","Benveniste, J."],"cuid":["S01-000.00-349999"],"event":{"end":"2018-09-29","place":"pt","start":"2018-09-24","title":"25 years of progress in radar altimetry symposium","year":"2018"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","Nordic","OECD"],"country":["France","Germany","Italy","Norway","Switzerland","United Kingdom"],"glorg":["All Global Affiliations","ESRIN - ESA Centre for Earth Observation","Goethe University Frankfurt","Laboratoire d’Études en Géophysique et Océanographie Spatiales","Mercator Océan","Nansen Environmental and Remote Sensing Center","Technische Universität Dresden","University of Bremen","University of Leeds","University of Reading","University of Zurich"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"global sea level budget assessment preliminary results from esa s cci sea level budget closure project","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/163236042/25YPRA_Abstract_Book.pdf","version":"Published Version"},"id":"S01-000.00-349999","ids":["dtu-985c4460-05f7-4d12-be31-c348a3682aa2"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-2F1EFD6B422C371B36FC17B7E0F42C82"],"o