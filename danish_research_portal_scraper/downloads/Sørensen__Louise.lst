st":"Sørensen","locid":"e1bf7bae-7f0e-445e-99ea-12eb242407fb","name":"Sørensen, Henning Osholm","orcid":"0000-0002-7004-547X","rank":3,"rolecode":"pau"},{"affno":"1","first":"Robert Krarup","key":"feidenhanslpau","last":"Feidenhans'l","locid":"0a3fb80e-6206-4f37-8e19-12d109fdab12","name":"Feidenhans'l, Robert Krarup","orcid":"0000-0002-7963-3649","rank":4,"rolecode":"pau"},{"affno":"1","first":"Susan Louise Svane","key":"stipppau","last":"Stipp","locid":"b907e7ef-d26a-4093-836b-9b7c9238d956","name":"Stipp, Susan Louise Svane","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.cageo.2012.06.024","issn":["00983004","18737803"],"issn_org":["00983004"],"journal":"Computers & Geosciences","pages":"131-139","status":"p","title":"Computers & Geosciences","volume":"49"},"review":"Peer Reviewed","scoID":["2-s2.0-84868261920"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-2d3e3313-89d5-46fd-b412-7eb1264080a8"],"src":["KU University of Copenhagen"],"title":"Improved segmentation of X-ray tomography data from porous rocks using a dual filtering approach","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-420418","year":"2012","yearsub":"2012"}
{"abstract":"Platelets are megakaryocyte subfragments that participate in hemostatic and host defense reactions and deliver pro- and anti-angiogenic factors throughout the vascular system. Platelets are anucleated cells and lack a complex secretory apparatus with distinct Golgi/endoplasmic reticulum compartments. However, studies have in the past demonstrated the presence of glycosyltransferase activities associated with platelets. We show that members of three distinct glycosyltransferase families are found within and on the surface of platelets. Immunocytology and flow cytometry results indicate that megakaryocytes package these Golgi-derived glycosyltransferases into vesicles that are sent via proplatelets to nascent platelets, where they accumulate. These glycosyltransferases are active, and intact platelets glycosylate large exogenous substrates. Furthermore, we show that activation of platelets results in release of soluble glycosyltransferase activities and that platelets contain sufficient levels of sugar nucleotides for detection of glycosylation of exogenously added substrates. Blood platelets are therefore a rich source of both glycosyltransferases and donor sugar substrates, which can be released to function in the extracellular space. This platelet glycosylation machinery offers a pathway to a simple glycoengineering strategy improving storage of platelets and may serve hitherto unknown biological functions.","author_count":10,"contributors":["Wandall, Hans H","Rumjantseva, Viktoria","Sørensen, Anne Louise Tølbøll","Patel-Hett, Sunita","Josefsson, Emma C","Bennett, Eric P","Italiano, Joseph E","Clausen, Henrik","Hartwig, John H","Hoffmeister, Karin M"],"cuid":["S01-000.00-509117"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"the origin and function of platelet glycosyltransferases","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1182/blood-2012-02-409235","version":"Other Version"},"id":"S01-000.00-509117","identifier":[{"id":"PMC3401214","type":"pmcid"},{"id":"22613794","type":"pmid"},{"id":"84864127482","type":"scopus"}],"ids":["ku-c1c9ad63-70ef-4f1b-ae8b-fea941dd1232"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-9CEF1087AD23FFFF4023061163C136E4"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1182/blood-2012-02-409235","version":"Other Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Cellular and Molecular Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Cellular and Molecular Medicine, Glycomics Program"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Hans H","key":"wandallpau","last":"Wandall","locid":"05df527d-13fd-4de9-9bb6-1a7b604bc6fa","name":"Wandall, Hans H","orcid":"0000-0003-0240-9232","rank":1,"rolecode":"pau"},{"affno":"","first":"Viktoria","key":"rumjantsevapau","last":"Rumjantseva","name":"Rumjantseva, Viktoria","rank":2,"rolecode":"pau"},{"affno":"1","first":"Anne Louise Tølbøll","key":"sørensenpau","last":"Sørensen","locid":"f415d4a2-da27-4b48-94dd-ed0df74eb1e1","name":"Sørensen, Anne Louise Tølbøll","rank":3,"rolecode":"pau"},{"affno":"","first":"Sunita","key":"patelhettpau","last":"Patel-Hett","name":"Patel-Hett, Sunita","rank":4,"rolecode":"pau"},{"affno":"","first":"Emma C","key":"josefssonpau","last":"Josefsson"