:"dalskovpau","last":"Dalskov","locid":"56222bcb-fb52-4111-8cfa-0264a3fef7e5","name":"Dalskov, Stine-Mathilde","rank":6,"rolecode":"pau"},{"affno":"1","first":"Rikke Agnete","key":"petersenpau","last":"Petersen","locid":"7ec167a6-8982-42dc-87de-53c245802653","name":"Petersen, Rikke Agnete","rank":8,"rolecode":"pau"},{"affno":"2","first":"M R","key":"andersenpau","last":"Andersen","name":"Andersen, M R","rank":9,"rolecode":"pau"},{"affno":"2","first":"Steen","key":"stenderpau","last":"Stender","name":"Stender, Steen","rank":10,"rolecode":"pau"},{"affno":"1","first":"Christian","key":"mølgaardpau","last":"Mølgaard","locid":"240d0bd3-4221-4d27-bfdb-8fd6887cdb30","name":"Mølgaard, Christian","orcid":"0000-0002-5311-9457","rank":11,"rolecode":"pau"}],"pub":{"issn":["02506807","10189688"],"issn_org":["02506807"],"issue":"suppl. 1","journal":"Annals of Nutrition and Metabolism","pages":"630-631","status":"p","title":"Annals of Nutrition and Metabolism","volume":"63"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-8576ed50-4182-4841-9ea5-b6c1150fb64a","ku-abc0fd17-abcb-4ce4-bf60-c18e960af226"],"src":["KU University of Copenhagen"],"title":"School meals based on New Nordic Diet improve reading performance in Danish 4th grade children : the OPUS School Meal Study","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-086.67-044058","year":"2013","yearsub":"2013"}
{"abstract":"SEPTIN9 (SEPT9) is a filament-forming protein involved in numerous cellular processes. We have used a conditional knock out allele of Sept9 to specifically delete Sept9 in T-cells. As shown by fluorescence-activated cell sorting, loss of Sept9 at an early thymocyte stage in the thymus results in increased numbers of double-negative cells indicating that SEPT9 is involved in the transition from the double-negative stage during T-cell development. Accordingly, the relative numbers of mature T-cells in the periphery are decreased in mice with a T-cell-specific deletion of Sept9. Proliferation of Sept9-deleted CD8(+) T-cells from the spleen is decreased upon stimulation in culture. The altered T-cell homeostasis caused by the loss of Sept9 results in an increase of CD8(+) central memory T-cells.","author_count":7,"contributors":["Lassen, Louise Berkhoudt","Füchtbauer, Annette C.","Schmitz, Alexander","Sørensen, Annette Balle","Pedersen, Finn Skou","Füchtbauer, Ernst-Martin"],"cuid":["S02-100.00-008454"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Animals","CD8 Positive T Lymphocytes","CD8 T cells","Cell Count","Cell Differentiation","Cell Proliferation","Down Regulation","Homeostasis","Immunologic Memory","Integrases","Lymphocyte Depletion","Lymphoid Tissue","Mice","Mice Knockout","Real Time Polymerase Chain Reaction","T cell development","T cell proliferation","Up Regulation"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-OT","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-KUM"],"OT":["Institut for Molekylærbiologi og Genetik - Molekylær celle- og udviklingsbiologi"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-GV-KUM","DI-U-AAU","DI-U-AU","Institut for Molekylærbiologi og Genetik - Molekylær celle- og udviklingsbiologi"]},"review":"pr","rtype":["clu"],"sorti":"em septin000000000009 em is involved in t cell development and cd000000000008 t cell homeostasis","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s00441-013-1618-6","version":"Other Version"},"id":"S02-100.00-008454","identifier":[{"id":"WOS:000319427800022","type":"wos"},{"id":"84878565876","type":"scopus"},{"id":"23644740","type":"pmid"}],"ids":["aau-af8bdc64-5564-45e9-b744-2ebeb5770c87","au-239c7bff-9dcf-4af1-b88f-220ce1128ca1"],"keyword":["Animals","CD8+ T-cells","CD8-Positive T-Lymphocytes","Cell Count","Cell Differentiation","Cell Proliferation","Down-Regulation","Homeostasis","Immunologic Memory","Integrases","Lymphocyte Depletion","Lymphoid Tissue","Mice","Mice (Sept9 cond :Mx-Cre)","Mice, Knockout","Real-Time Polymerase Chain Reaction","Sept9","Septins","T-cell development","T-cell homeostasis","T-cell proliferation","Up-Regulation"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-4AD9F476CDA5C06CCC81370A7404D10E"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s00441-013-1618-6","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Molecular Biology and Genetics"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Institut for Molekylærbiologi og Genetik - Molekylær celle- og udviklingsbiologi"],"nora_code":"DI-OT","used":1},{"a