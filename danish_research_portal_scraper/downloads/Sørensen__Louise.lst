3-4821-430X","rank":10,"rolecode":"pau"},{"affno":"1","first":"Jens J","key":"holstjensjuulpau","last":"Holst","locid":"864b6401-9024-4773-9bdb-f4d4ca57dcad","name":"Holst, Jens Juul","name_org":"Holst, Jens J","orcid":"0000-0001-6853-3805","rank":11,"rolecode":"pau"},{"affno":"1 6","first":"Michael","key":"christiansenmichaelpau","last":"Christiansen","locid":"dc176508-20d5-42ef-96bb-3badf8a00acf","name":"Christiansen, Michael","rank":12,"rolecode":"pau"},{"affno":"3 1","first":"Jens-Christian","key":"holmjenschristianpau","last":"Holm","locid":"d61af840-e87e-4a2e-8be2-b481959ef6c9","name":"Holm, Jens-Christian","rank":13,"rolecode":"pau"},{"affno":"1","first":"Bolette","key":"hartmannbolettepau","last":"Hartmann","locid":"eb04fc6b-068a-4d5b-a106-1b7be3f7e12b","name":"Hartmann, Bolette","orcid":"0000-0001-8509-2036","rank":14,"rolecode":"pau"},{"affno":"1","first":"Torben","key":"hansentorbenpau","last":"Hansen","locid":"6b6bfff1-8b14-468b-af77-e71b375018e0","name":"Hansen, Torben","orcid":"0000-0001-8748-3831","rank":15,"rolecode":"pau"}],"pmid":["35213713"],"pub":{"doi":"10.1210/clinem/dgac108","issn":["0021972X","19457197"],"issn_org":["0021972X"],"issue":"6","journal":"Journal of Clinical Endocrinology and Metabolism","pages":"1569-1576","publisher":"Endocrine Society","status":"p","title":"Journal of Clinical Endocrinology and Metabolism","title_org":"The Journal of Clinical Endocrinology & Metabolism","volume":"107"},"review":"Peer Reviewed","scoID":["2-s2.0-85130766964"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Hospitals","All Private Research","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Novo Nordisk","Other Hospitals","Private Research","Region Zealand","Universities","University of Copenhagen","University of Southern Denmark","copenhagen university hospital - holbæk"],"PST":["Published"]},"sid":["ku-bb764125-51be-4173-9a31-aa6b81c6fc65","sdu-5ec78c2a-9cd9-44a2-b786-230e5e0cbd60"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Hyperglucagonemia in Pediatric Adiposity Associates With Cardiometabolic Risk Factors but Not Hyperglycemia","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-097.28-045721","year":"2022","yearsub":"2022"}
{"abstract":"BACKGROUND: The incidence of women developing gestational diabetes mellitus (GDM) is increasing, which is associated with an increased risk of type 2 diabetes mellitus (T2DM) for both mother and child. Gut microbiota dysbiosis may contribute to the pathogenesis of both GDM and the accompanying risk of T2DM. Thus, a better understanding of the microbial communities associated with GDM could offer a potential target for intervention and treatment in the future. Therefore, we performed a systematic review to investigate if the GDM women have a distinct gut microbiota composition compared to non-GDM women. METHODS: We identified 21 studies in a systematic literature search of Embase and PubMed up to February 24, 2021. Data on demographics, methodology and identified microbial metrics were extracted. The quality of each study was assessed according to the Newcastle-Ottawa Scale. RESULTS: Sixteen of the studies did find a GDM-associated gut microbiota, although no consistency could be seen. Only Collinsella and Blautia showed a tendency to be increased in GDM women, whereas the remaining genera were significantly different in opposing directions. CONCLUSION: Although most of the studies found an association between GDM and gut microbiota dysbiosis, no overall GDM-specific gut microbiota could be identified. All studies in the second trimester found a difference between GDM and non-GDM women, indicating that dysbiosis is present at the time of diagnosis. Nevertheless, it is still unclear when the dysbiosis develops, as no consensus could be seen between the studies investigating the gut microbiota in the first trimester of pregnancy. However, studies varied widely concerning methodology and study design, which might explain the highly heterogeneous gut microbiota compositions between studies. Therefore, future studies need to include multiple time points and consider possible confounding factors such as ethnicity, pre-pregnancy body mass index, and GDM treatment.","author_count":8,"contributors":["Rold, Louise Søndergaard","Bundgaard-Nielsen, Caspar","Holm-Jacobsen, Julie Niemann","Glud Ovesen, Per","Leutscher, Peter Derek Christian","Hagstrøm, Søren","Sørensen, Suzette"],"cuid":["S02-097.72-008183"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Sørensen, Suzette"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR","DI-HO-NDR","DI-HO-STENO"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-HO-CDR","DI-HO-NDR","DI-HO-STENO","DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"characteristics of the gut microbiome in women with gestational diabetes mellitus a systematic review","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"djr","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1371/journal.pone.0262618","version":"Published Version"},"id":"S02-097.72-008183","identifier":[{"id":"PMC8757951","type":"pmcid"},{"id":"35025980","type":"pmid"},{"id":"85123085380","type":"scopus"}],"ids":["aau-a980c0ee-9039-48a6-b2d8-8261fe61850f","au-d2c2b58a-c308-4b28-bea9-e3826e7cf31a"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-E7CD1647270C9FCA63584E8032CAA04E"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1371/journal.pone.0262618","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/460121630/Rold_et_al._2022_._Characteristics_of_the_gut_microbiome_in_women_with_gestational_diabetes_mellitus_A_systematic_review.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Medicin og Akut","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Steno Diabetes Center North Denmark","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine, Center for Clinical Research","Aalborg University, The Faculty of Medicine, North Denmark Regional Hospital"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"dk","key":"north denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-NDR","l3nl":"North Denmark Region","l3nn":"North Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"North Denmark Region","namevar":["The North Denmark Region"],"nora_code":"DI-HO-NDR","used":1},{"affno":"3","country":"dk","key":"steno diabetes centers","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-STENO","l3nn":"Steno Diabetes Centers","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Steno Diabetes Centers","namevar":["Steno Diabetes Centre Copenhagen"],"nora_code":"DI-HO-STENO","used":1},{"affno":"4","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Obstetrics and Gynaecology","Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - SDCA-Steno Diabetes Center Aarhus"],"nora_code":"DI-U-AU","used":1},{"affno":"5","country":"dk","key":"cen