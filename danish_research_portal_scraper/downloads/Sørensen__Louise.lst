npau","last":"Cullen","name":"Cullen, Louise","rank":21,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Dirk","key":"westermannpau","last":"Westermann","name":"Westermann, Dirk","rank":22,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Stefan","key":"blankenbergpau","last":"Blankenberg","name":"Blankenberg, Stefan","rank":23,"rolecode":"pau"}],"pmid":["27903616"],"pub":{"doi":"10.1373/clinchem.2016.262659","issn":["00099147","15308561"],"issn_org":["00099147"],"issue":"1","journal":"Clinical Chemistry","pages":"394-402","publisher":"Oxford University Press","status":"p","title":"Clinical Chemistry","volume":"63"},"review":"Peer Reviewed","scoID":["2-s2.0-85008472877"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-ba568a75-9cfe-40e6-9c10-61be41836609"],"src":["SDU University of Southern Denmark"],"title":"Immediate rule-out of acute myocardial infarction using electrocardiogram and baseline high-sensitivity troponin I","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-626632","year":"2017","yearsub":"2017"}
{"abstract":"Increasing use of engineered nanoparticles has led to extensive research into their potential hazards to the environment and human health. Cellular uptake from the gut is sparsely investigated, and microscopy techniques applied for uptake studies can result in misinterpretations. Various microscopy techniques were used to investigate internalization of 10-nm gold nanoparticles in Daphnia magna gut lumen and gut epithelial cells following 24-h exposure and outline potential artifacts (i.e., high-contrast precipitates from sample preparation related to these techniques). Light sheet microscopy confirmed accumulation of gold nanoparticles in the gut lumen. Scanning transmission electron microscopy and elemental analysis revealed gold nanoparticles attached to the microvilli of gut cells. Interestingly, the peritrophic membrane appeared to act as a semipermeable barrier between the lumen and the gut epithelium, permitting only single particles through. Structures resembling nanoparticles were also observed inside gut cells. Elemental analysis could not verify these to be gold, and they were likely artifacts from the preparation, such as osmium and iron. Importantly, gold nanoparticles were found inside holocrine cells with disrupted membranes. Thus, false-positive observations of nanoparticle internalization may result from either preparation artifacts or mistaking disrupted cells for intact cells. These findings emphasize the importance of cell integrity and combining elemental analysis with the localization of internalized nanoparticles using transmission electron microscopy","author_count":7,"contributors":["Jensen, Louise Helene Søgaard","Skjolding, Lars Michael","Thit, Amalie","Sørensen, Sara Nørgaard","Købler, Carsten","Mølhave, Kristian","Baun, Anders"],"cuid":["S02-082.68-037561"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Aquatic invertebrates","Freshwater toxicology","Nanoparticle","Nanoparticles","Nanotoxicology"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-RUC"]},"level3all":["DI-U-DTU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"not all that glitters is gold electron microscopy study on uptake of gold nanoparticles in daphnia magna and related artefacts","src":["dtu","ruc"],"src-code":["DI-U-DTU","DI-U-RUC"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/127440380/Jensen_et_al_2016_Environmental_Toxicology_and_Chemistry.pdf","version":"Authors Final Version"},"id":"S02-082.68-037561","identifier":[{"id":"27886401","type":"pmid"},{"id":"85007413639","type":"scopus"}],"ids":["dtu-dd264739-4cf0-4b7c-8cd5-b4516ea2574f","ruc-cbf6d71a-60ca-4b36-8c88-f7fa93b99d18"],"keyword":["Aquatic invertebrate","Aquatic invertebrates","Freshwater toxicology","Nanoparticle","Nanoparticles","Nanotoxicology"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-0AF491977BAE61827B03AB6201F0F31F"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/127440380/Jensen_et_al_2016_Environmental_Toxicology_and_Chemistry.pdf","version":"Authors Final Version"},{"access":"oa","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/63869111/not_all_that_glitters_is_gold.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Center for Electron Nanoscopy"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of Science and Environment","Roskilde University, Department of Science and Environment, Environmental Dynamics"],"nora_code":"DI-U-RUC","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Louise Helene Søgaard","key":"jensenlouisehelenesøgaardpau","last":"Jensen","locid":"889f7058-0e0d-47ed-9be7-70832ca080f6","name":"Jensen, Louise Helene Søgaard","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lars Michael","key":"skjoldinglarsmichaelpau","last":"Skjolding","locid":"0f7dbfa4-64f2-449a-bb3e-f9d14d60b2ca","name":"Skjolding, Lars Michael","orcid":"0000-0002-3280-1836","rank":2,"rolecode":"pau"},{"affno":"2","country":"dk","first":"Amalie Thit","key":"thitamaliepau","last":"Jensen","locid":"6d04e3e4-250b-45b9-8083-b0f263aa664c","name":"Thit, Amalie","name_org":"Jensen, Amalie Thit","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Sara Nørgaard","key":"sørensensaranørgaardpau","last":"Sørensen","locid":"1c9842d3-875f-49e3-84a0-d9895fa754fd","name":"Sørensen, Sara Nørgaard","orcid":"0000-0003-3673-9483","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Carsten","key":"køblercarstenpau","last":"Købler","locid":"0fd5e4a0-7092-4082-b36a-23358881355d","name":"Købler, Carsten","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kristian","key":"mølhavekristianpau","last":"Mølhave","locid":"745c31cd-5de7-4dd8-909e-d0f5de0fed5c","name":"Mølhave, Kristian","orcid":"0000-0002-6493-2750","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders","key":"baunanderspau","last":"Baun","locid":"f3cdf4a9-bfc7-4e0e-bf46-df0da8134f0d","name":"Baun, Anders","orcid":"0000-0003-1396-408X","rank":7,"rolecode":"pau"}],"pmid":["27886401"],"pub":{"doi":"10.1002/etc.3697","issn":["07307268","15528618"],"issn_org":["07307268"],"issue":"6","journal":"Environmental Toxicology and Chemistry","pages":"1503-1509","publisher":"24150509","status":"p","title":"Environmental Toxicology and Chemistry","volume":"36"},"review":"Peer Reviewed","scoID":["2-s2.0-85007413639"],"sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Roskilde University","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-dd264739-4cf0-4b7c-8cd5-b4516ea2574f","ruc-cbf6d71a-60ca-4b36-8c88-f7fa93b99d18"],"src":["DTU Technical University of Denmark","RUC Roskilde University"],"title":"Not all that glitters is gold - Electron microscopy study on uptake of gold nanoparticles in Daphnia magna and related artefacts","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-082.68-037561","year":"2017","yearsub":"2017"}
{"abstract":"Context: Osteoporosis is a frequent disease in many populations. The hallmark is fragility fractures, which are harbingers of future fractures, disability, mortality and cost on society. The occurrence increases with age, low vitamin D level and smoking. Smoking rates are high, vitamin D is low and life expectancy is rising steeply in Greenland, as is the need for focus on osteoporosis. We report a case that uses a simple and readily available tool to diagnose osteoporosis at the hospital in Sisimiut, a town of 5000 inhabitants on the west coast of Greenland. Issues: A 51-year-old Inuit woman was seen due to lower back pain. No trauma could be recalled. Laboratory results showed a low vitamin D level and normal S-calcium, S-phosphate, S-parathyroid hormone, S-thyrotropin, erythrocyte sedimentation rate, S-creatinine and hemoglobin. The lateral chest radiograph demonstrated a reduction of anterior height of the seventh and ninth thoracic vertebral bodies of 50% and 40% respectively. Lessons learned: Chest radiographs are frequently done in the towns along the vast coastline of Greenland, the world's largest island. They are transferred to the hospital in the capital city Nuuk using existing tele-technology, and specialist evaluations are given in electronic records available at the coastal hospitals. Effective therapies for osteoporosis are available and the identification of vertebral fractures that merit treatment may prevent future fractures, morbidity and mortality. Fragility fractures are frequent in old age and the steep rise in life expectancy and in the number of old people in Greenland emphasize the need for a focus on management of osteoporosis. Geography provides a diagnostic challenge to rural and remote areas that can be overcome by the use of lateral chest radiographs as it relies on facilities readily available. Clinical risk assessment tools with high specificity may support further osteoporosis risk prediction in remote Arctic societies.","author_count":6,"contributors":["Fleischer, Inuuteq","Schæbel, Louise Holm","Albertsen, Nadja","Sørensen, V.N.","Andersen, Stig"],"cuid":["S02-091.18-008479"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Nordic"],"corresponding_author":["Fleischer, I."],"country":["Greenland"],"glorg":["All Global Affiliations","Sisimiut Regional Hospital"],"keyword":["Age","Chest radiographs","Chronic Disease","Female","Fragility fracture","Greenland","Grønland","Healthcare Disparities","Humans","Knogleskørhed","Middle Aged","Osteoporosis diagnostic imaging","Primary Prevention methods","Risk factor","Rural Health Services organization administration","Secondary Prevention methods"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"diagnosis of osteoporosis in rural arctic greenland a clinical case using plain chest radiography for secondary prevention and consideration of tools for primary prevention in remote areas","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.22605/RRH3910","version":"Published Version"},"id":"S02-091.18-008479","identifier":[{"id":"28201922","type":"pmid"},{"id":"000401945200011","type":"wos"},{"id":"85017554397","type":"scopus"}],"ids":["aau-afe39e6f-fa5b-4585-b1be-df19635bba3b","au-e398696c-74b6-436e-a8fb-7515a2e9ed87"],"keyword":["Age","Chest radiographs","Chronic disease","Developing society","Female","Fragility fracture","Greenland","Grønland","Healthcare Disparities","Humans","Knogleskørhed","Middle Aged","Osteoporosis/diagnostic imaging","Primary Prevention/methods","Risk factor","Rural Health Services/organization & administration","Secondary Prevention/methods"],"lang":"