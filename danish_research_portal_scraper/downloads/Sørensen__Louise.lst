","first":"Jens-Christian","key":"holmjenschristianpau","last":"Holm","locid":"d61af840-e87e-4a2e-8be2-b481959ef6c9","name":"Holm, Jens-Christian","rank":15,"rolecode":"pau"},{"affno":"1","first":"Torben","key":"hansentorbenpau","last":"Hansen","locid":"6b6bfff1-8b14-468b-af77-e71b375018e0","name":"Hansen, Torben","orcid":"0000-0001-8748-3831","rank":16,"rolecode":"pau"}],"pmid":["38087928"],"pub":{"doi":"10.1210/clinem/dgad728","issn":["0021972X","19457197"],"issn_org":["0021972X"],"issue":"6","journal":"Journal of Clinical Endocrinology and Metabolism","pages":"1590-1600","status":"p","title":"Journal of Clinical Endocrinology and Metabolism","volume":"109"},"review":"Peer Reviewed","scoID":["2-s2.0-85193564094"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Region Zealand","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-729ff34b-140b-42ca-95e5-13afc9345b66"],"src":["KU University of Copenhagen"],"title":"Altered Glucagon and GLP-1 Responses to Oral Glucose in Children and Adolescents With Obesity and Insulin Resistance","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-739297","year":"2024","yearsub":"2024"}
