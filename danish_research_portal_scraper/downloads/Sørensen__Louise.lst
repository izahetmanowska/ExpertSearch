92-bc3cc4aa8c45","au-ba4bd48d-d500-495f-9bbc-386023da0983","ku-132e99cd-f40f-460d-8ffe-73643f6d8f3c"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen"],"title":"Development of a method for absolute quantification of equine acute phase proteins using concatenated Peptide standards and selected reaction monitoring","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-099.78-002110","year":"2014","yearsub":"2014"}
{"abstract":"Børnekulturens Netværk iværksatte i 2011 et treårigt modelforsøg, der skulle være med til at skabe udvikling, videndeling og forskning om ungekultur. Hensigten var at kvalificere lokale kunst- og kulturaktiviteter for, med og af unge og at udvikle modeller og metoder, som kunne virke inspirerende for ungeaktiviteter i hele landet. Model forsøget, som nu har kørt i tre år, består af 10 projekter, der favner musik, teater, film, litteratur, arkitektur, projektmageri og design. Projekterne foldes ud i ungdomskulturhuse, kulturinstitutioner, folkeskoler og i offentlige rum, hvor unge færdes og lever. I forbindelse med modelforsøget har Kulturstyrelsen, som Børnekulturens Netværk har været en del af siden 2012, bedt Center for Ungdomsforskning gennemføre et forskningsprojekt, der undersøger, hvordan disse projekter ser ud fra de unges perspektiv. Projektet bygger på interview med 32 unge fra seks af projekterne og sætter fokus på, hvordan rekrutteringen af de unge er foregået, hvad de får ud af at deltage i projekterne, og hvorfor nogle unge falder fra projekterne. Det er dog også et projekt, der i videre forstand handler om, hvilken rolle kunst og kultur kan spille i nutidens ungdomsliv.","author_count":2,"contributors":["Nielsen, Louise Yung","Sørensen, Niels Ulrik"],"cuid":["S01-000.00-074537"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Livskvalitet","Motivation","Projektarbejde","Ungdomskultur","Ungdomsliv","Ungekultur"],"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"nr","rtype":["clu"],"sorti":"unge i kunst og kulturprojekter unges perspektiver på deltagelse i modelforsøg om ungekultur","src":["aau"],"src-code":["DI-U-AAU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/302796184/Endelig_WEB_Unge_i_kunst_og_kulturprojekter_07_web_rgb_150dpi_2_.pdf","version":"Published Version"},"id":"S01-000.00-074537","ids":["aau-5452626d-0bf8-428e-9c7b-10fde57956a9"],"keyword":["Ungdomskultur","livskvalitet","motivation","projektarbejde","ungdomsliv","ungekultur"],"lang":"Danish","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-609E00A8ACA670F8A8D223B4B21E6575"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/302796184/Endelig_WEB_Unge_i_kunst_og_kulturprojekter_07_web_rgb_150dpi_2_.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Humanities","Aalborg University, The Faculty of Humanities, Department of Learning and Philosophy","Aalborg University, The Faculty of Humanities, Department of Learning and Philosophy, Centre for Youth Research (Learning)"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Louise Yung","key":"nielsenpau","last":"Nielsen","locid":"aa4d3415-9b17-4d7e-9a9d-51616d86671d","name":"Nielsen, Louise Yung","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Niels Ulrik","key":"sørensenpau","last":"Sørensen","locid":"bc0b7e8d-a533-48e9-812c-c47dc3057f8e","name":"Sørensen, Niels Ulrik","orcid":"0000-0001-6410-1183","rank":2,"rolecode":"pau"}],"pub":{"pages":"45","place":"København","publisher":"Kulturstyrelsen","status":"p"},"review":"No Review","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-5452626d-0bf8-428e-9c7b-10fde57956a9"],"src":["AAU Aalborg University"],"title":"Unge i kunst- og kulturprojekter : Unges perspektiver på deltagelse i 