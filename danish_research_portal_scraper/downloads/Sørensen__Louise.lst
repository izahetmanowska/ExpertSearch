{"author_count":3,"contributors":["Hansen, Torben","Ingerslev Sørensen, Maria","Riewerts, Marie-Louise Kai"],"cuid":["S01-000.00-279472"],"filters":{"added":"2023-03","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Mondelez International"],"U":["DI-U-ALL","DI-U-CBS"]},"level3all":["DI-U-CBS"]},"review":"nr","rtype":["clu"],"sorti":"how the interplay between consumer motivations and values influences organic food identity and behaviour","src":["cbs"],"src-code":["DI-U-CBS"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"https://rauli.cbs.dk/index.php/ffa/article/view/6762/7208","version":"Published Version"},"id":"S01-000.00-279472","ids":["cbs-2b3af69f-8180-4feb-b9a9-144fb7a66f24"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-D75D6BEC7C7B41B666EB7FAAA3F28287"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"https://rauli.cbs.dk/index.php/ffa/article/view/6762/7208","version":"Published Version"}],"org":[{"affno":"1","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of Marketing"],"nora_code":"DI-U-CBS","used":1},{"affno":"2","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Mondelez International"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Torben","key":"hansenpau","last":"Hansen","locid":"a5307dd5-fe40-41e2-84