ital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-e042f891-3acc-4a98-973c-b2c125260abf"],"src":["KU University of Copenhagen"],"title":"Neuroanatomical heterogeneity and homogeneity in individuals at clinical high risk for psychosis","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-527426","year":"2022","yearsub":"2022"}
{"abstract":"Background Social distancing measures introduced during the coronavirus disease 2019 pandemic have reduced admission rates for various infectious and noninfectious respiratory diseases. We hypothesized that rates of asthma exacerbations would decline following the national lockdown in Denmark. Objective To determine weekly rates of in- and out-of-hospital asthma exacerbations before and during the social distancing intervention implemented on March 12, 2020. Methods All individuals older than 18 years with at least 1 outpatient hospital contact with asthma as the main diagnosis from January 1, 2013, to December 31, 2017, were included. Weekly asthma exacerbation rates from January 1, 2018, to May 22, 2020, were calculated. An interrupted time-series model with the lockdown on March 12, 2020, as the point of interruption was used. Results A total of 38,225 patients with asthma were identified. The interrupted time-series model showed no immediate fall in exacerbation rates during the first week after March 12, 2020. However, there was a significant decline in weekly exacerbation rates in the following 10 weeks (change in trend for exacerbations requiring hospitalization: −0.75 [95% CI, −1.39 to −0.12]; P < .02 and in all asthma exacerbations: −12.2 [95% CI, −19.1 to −5.4; P < .001), amounting to a reduction of approximately 1 and 16.5 exacerbations per year per 100 patients in the cohort, respectively. Conclusions The introduction of the social distancing measures in Denmark did not lead to an immediate reduction in asthma exacerbation rates; however, a gradual decline in exacerbation rates during the following 10-week period was observed.","author_count":11,"contributors":["Toennesen, Louise Lindhardt","Bonnesen, Barbara","Sivapalan, Pradeesh","Jordan, Alexander Svorre","Saeed, Mohamad Isam","Eklöf, Josefin","Ulrik, Charlotte Suppli","Skaarup, Kristoffer Grundtvig","Højberg Lassen, Mats Christian","Biering-Sørensen, Tor","Jensen, Jens Ulrik Stæhr"],"cuid":["S01-000.00-541869"],"filters":{"added":"2022-10","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Asthma","Epidemiology","Exacerbations","Lockdown","Social distancing"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-ZEA"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-HO-ZEA","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"the impact of social distancing in 000000002020 on admission rates for exacerbations in asthma a nationwide cohort study","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"https://www.ncbi.nlm.nih.gov/pmc/about/copyright/","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC9352355/pdf/main.pdf","version":"Published Version"},"id":"S01-000.00-541869","identifier":[{"id":"PMC9352355","type":"pmcid"},{"id":"85130464522","type":"scopus"},{"id":"35500879","type":"pmid"}],"ids":["ku-f8a3cda3-6d49-4517-bb71-d1eddb5fbf25"],"keyword":["Asthma","Epidemiology","Exacerbations","Lockdown","Social distancing"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-BD78EF48FC6D491C4AB9A4E26142903F"],"oa_link":[{"access":"oa","license":"https://www.ncbi.nlm.nih.gov/pmc/about/copyright/","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC9352355/pdf/main.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Amager and Hvidovre","Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","country":"dk","key":"region zealand","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-ZEA","l3nl":"Region Zealand","l3nn":"Region Zealand","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region Zealand","namevar":["Zealand University Hospital - Roskilde"],"nora_code":"DI-HO-ZEA","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Internal Medicine: Respiratory Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Louise Lindhardt","key":"toennesenpau","last":"Toennesen","name":"Toennesen, Louise Lindhardt","rank":1,"rolecode":"pau"},{"affno":"1","first":"Barbara","key":"bonnesenpau","last":"Bonnesen","name":"Bonnesen, Barbara","rank":2,"rolecode":"pau"},{"affno":"1 2","first":"Pradeesh","key":"sivapalanpau","last":"Sivapalan","name":"Sivapalan, Pradeesh","rank":3,"rolecode":"pau"},{"affno":"1","first":"Alexander Svorre","key":"jordanpau","last":"Jordan","name":"Jordan, Alexander Svorre","rank":4,"rolecode":"pau"},{"affno":"1","first":"Mohamad Isam","key":"saeedpau","last":"Saeed","name":"Saeed, Mohamad Isam","rank":5,"rolecode":"pau"},{"affno":"1","first":"Josefin","key":"eklöfpau","last":"Eklöf","name":"Eklöf, Josefin","rank":6,"rolecode":"pau"},{"affno":"3","first":"Charlotte Suppli","key":"ulrikpau","last":"Ulrik","locid":"ea578010-4d8b-498b-b9d0-8f3d8cc424df","name":"Ulrik, Charlotte Suppli","rank":7,"rolecode":"pau"},{"affno":"1","first":"Kristoffer Grundtvig","key":"skaaruppau","last":"Skaarup","name":"Skaarup, Kristoffer Grundtvig","rank":8,"rolecode":"pau"},{"affno":"1","first":"Mats Christian","key":"højberglassenpau","last":"Højberg Lassen","name":"Højberg Lassen, Mats Christian","rank":9,"rolecode":"pau"},{"affno":"1","first":"Tor","key":"bieringsørensenpau","last":"Biering-Sørensen","name":"Biering-Sørensen, Tor","rank":10,"rolecode":"pau"},{"affno":"3","first":"Jens Ulrik","key":"stæhrjensenpau","last":"Stæhr Jensen","locid":"d9593acd-d6ae-4a83-a7c8-64bc2ea541ac","name":"Jensen, Jens Ulrik Stæhr","name_org":"Stæhr Jensen, Jens Ulrik","orcid":"0000-0003-4036-0521","rank":11,"rolecode":"pau"}],"pmid":["35500879"],"pub":{"doi":"10.1016/j.jaip.2022.04.020","issn":["22132198"],"issue":"8","journal":"Journal of Allergy and Clinical Immunology: In Practice","status":"p","title":"Journal of Allergy and Clinical Immunology: In Practice","volume":"10"},"review":"Peer Reviewed","scoID":["2-s2.0-85130464522"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region Zealand","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-f8a3cda3-6d49-4517-bb71-d1eddb5fbf25"],"src":["KU University of Copenhagen"],"title":"The Impact of Social Distancing in 2020 on Admission Rates for Exacerbations in Asthma : A Nationwide Cohort Study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-541869","year":"2022","yearsub":"2022"}
{"abstract":"BACKGROUND: In Denmark emergency medical technicians transport patients with acute COPD exacerbations to the nearest emergency department. From a clinical and economic perspective, this transport and assessment at the hospital may be inconvenient if the patient is immediately discharged from the emergency department. We established an emergency technical technicians point-of-care diagnostics and treatment program of patients with COPD with use of ultrasound and blood analysis. Patients' perspectives on treatment at home and sense of security are important to qualify clinical practice at home with patients with acute exacerbation. AIM AND OBJECTIVES: To explore patient's and relatives' experience of treatment at home during emergency calls due to COPD in exacerbation and to investigate their attitude to avoid hospitalization as well as experience of stress during point-of-care diagnostics in their own home. METHOD: A qualitative study comprising semi-structured interviews with 16 patients carried out from April 1st, 2019 to March 31st, 2020 in Denmark. Data was analysed inspired by Malteruds' text condensation and informed by Critical Psychology with first person perspective focusing on the patient's views on point-of-care diagnostics and treatment of their COPD in acute exacerbation. RESULTS: The interviews revealed that in order to ensure an experience of quality in the assessment and treatment of patients in their own homes, it was important that the ambulance staff showed great safety and experience in the use of the technical equipment and treatment of dyspnea. It was also of importance that the patients felt confident that their general practitioner followed up on the home treatment initiated. CONCLUSION: Patients' perspectives showed that point-of-care diagnostics and treatment of acute COPD in exacerbation was considered a qualitative offer by the patients and their relatives. At the same time, it was crucial that the emergency medical technicians showed experience and safety in handling shortness of breath as well as the technical equipment. TRIAL REGISTRATION: Approved by the Danish Data Protection Agency Project-ID: 20/24845.","author_count":11,"contributors":["Christensen, Helle Marie","Pietersen, Pia Iben","Laursen, Christian B","Wittrock, Daniel","Nadim, Giti","Jørgensen, Georg","Nielsen, L B","Sørensen, M K","Titlestad, Ingrid Louise","Lassen, Annmarie Touborg","Mikkelsen, Søren"],"cuid":["S01-000.00-579728"],"filters":{"added":"2022-06","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"corresponding_author":["Christensen, Helle Marie"],"keyword":["COPD","Exacerbation","Patient perspectives","Point of care","Prehospital"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Responce & Falck Denmark"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"patients perspectives on point of care diagnostics and treatment by emergency medical technicians in acute copd exacerbations a qualitative study","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s13049-022-00999-2","version":"Published Version"},"id":"S01-000.00-579728","identifier":[{"id":"35183239","type":"pmid"},{"id":"PMC8858526","type":"pmcid"},{"id":"85125020560","type":"scopus"}],"ids":["sdu-16d598ab-c137-48d0-a4f3-ee3d352f5489"],"keyword":["COPD","Exacerbation","Patient perspectives","Point-of-care","Prehospital"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-EF8A9EFE5AD6EBA55F6A1F641867A89F"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s13049-022-00999-2","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/201015770/s13049_022_00999_2.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Odense Respiratory Research Unit (ODIN)"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Responce & Falck Denmark"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"first":"H M","key":"christensenpau","last":"Christensen","locid":"dec4ebf0-8630-4645-9129-859c046769e7","name":"Christensen, Helle Marie","name_org":"Christensen, H M","orcid":"0000-0001-6783-4112","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"P I","key":"pietersenpau","last":"Pietersen","locid":"b5e80914-ad32-4216-9ec6-150de89d1839","name":"Pietersen, Pia Iben","name_org":"Pietersen, P I","orcid":"0000-0001-5718-3635","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"C B","key":"laursenpau","last":"Laursen","locid":"333fc524-a408-42f4-885a-0fee79e488b9","name":"Laursen, Christian B","name_org":"Laursen, C B","orcid":"0000-0001-6382-9906","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"D","key":"wittrockpau","last":"Wittrock","locid":"814a1c3f-d86f-459a-93c4-1cb18d4dc813","name":"Wittrock, Daniel","name_org":"Wittrock, D","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"G","key":"nadimpau","last":"Nadim","locid":"