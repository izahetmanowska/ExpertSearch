rd","locid":"f841510b-8964-42ea-b510-22e1baf0b226","name":"Vestergaard, Stine Rom","name_org":"Vestergaard, Stine","rank":48,"role":"Other","rolecode":"oth"},{"affno":"","first":"no-firstname","key":"aidicutrialgrppau","last":"AID ICU Trial Grp","name":"AID ICU Trial Grp, no-firstname","rank":48,"rolecode":"pau"},{"affno":"13","corresponding":null,"first":"Anne-Marie","key":"bunzeloth","last":"Bunzel","locid":"5aa09b7c-0499-4956-9078-a76523b949ba","name":"Bunzel, Anne-Marie Gellert","name_org":"Bunzel, Anne-Marie","rank":49,"role":"Other","rolecode":"oth"},{"affno":"13","corresponding":null,"first":"Rine","key":"moulvadoth","last":"Moulvad","locid":"e57237fc-4c35-458a-95f8-221a377c8734","name":"Siegumfeldt, Rine Moulvad","name_org":"Moulvad, Rine","rank":50,"role":"Other","rolecode":"oth"}],"pmid":["36286254"],"pub":{"doi":"10.1056/nejmoa2211868","issn":["00284793","15334406"],"issn_org":["00284793"],"issue":"20","journal":"The New England Journal of Medicine","pages":"2425-2435","status":"p","title":"The New England Journal of Medicine","title_org":"New England Journal of Medicine","volume":"387"},"review":"Peer Reviewed","scoID":["2-s2.0-85145022604"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-f46327bb-be64-48d2-b8a4-a27761e73718","au-58af8cca-2f4e-4f2f-a266-e2d36acffcec","ku-1475d89e-1675-40fb-88fa-5776182481ed","sdu-8ab1b9aa-8c40-4e58-9d96-ba07ea6f844e"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Haloperidol for the Treatment of Delirium in ICU Patients","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-097.24-011684","y