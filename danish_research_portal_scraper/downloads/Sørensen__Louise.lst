usanneolesenpau","last":"Schaarup","name":"Schaarup, Susanne Olesen","rank":17,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Thomas","key":"sørensenthomaspau","last":"Sørensen","name":"Sørensen, Thomas","rank":18,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Louise Lund Holm","key":"thomsenlouiselundholmpau","last":"Thomsen","name":"Thomsen, Louise Lund Holm","rank":19,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Michael Skovdal","key":"rathleffmichaelskovdalpau","last":"Rathleff","locid":"90c1260f-4cd4-497f-88ca-a98f412bbe7b","name":"Rathleff, Michael Skovdal","orcid":"0000-0003-1173-0335","rank":20,"rolecode":"pau"}],"pub":{"doi":"10.1101/2024.04.29.24306576","publisher":"medRxiv","status":"p"},"review":"Undetermined","search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","All University Colleges","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","Hospitals","Region Zealand","Region of Southern Denmark","Universities","University College of Northern Denmark","University Colleges","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-c5fd12d9-56d9-4a3d-a723-ef6a614c4d81"],"src":["AAU Aalborg University"],"title":"The Effectiveness of Using a Clinical Support Tool in Managing Adolescents with Non-Traumatic Knee Pain (MAP-Knee) : protocol for a cluster-randomised superiority trial with delayed intervention and embedded realist evaluation","type":"Preprint","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-736339","year":"2024","yearsub":"2024"}
{"abstract":"BACKGROUND: Comorbidity with type 2 diabetes (T2D) results in worsening of cancer-specific and overall prognosis in colorectal cancer (CRC) patients. The treatment of CRC per se may be diabetogenic. We assessed the impact of different types of surgical cancer resections and oncological treatment on risk of T2D development in CRC patients. METHODS: We developed a population-based cohort study including all Danish CRC patients, who had undergone CRC surgery between 2001 and 2018. Using nationwide register data, we identified and followed patients from date of surgery and until new onset of T2D, death, or end of follow-up. RESULTS: In total, 46,373 CRC patients were included and divided into six groups according to type of surgical resection: 10,566 Right-No-Chemo (23%), 4645 Right-Chemo (10%), 10,151 Left-No-Chemo (22%), 5257 Left-Chemo (11%), 9618 Rectal-No-Chemo (21%), and 6136 Rectal-Chemo (13%). During 245,466 person-years of follow-up, 2556 patients developed T2D. The incidence rate (IR) of T2D was highest in the Left-Chemo group 11.3 (95% CI: 10.4-12.2) per 1000 person-years and lowest in the Rectal-No-Chemo group 9.6 (95% CI: 8.8-10.4). Between-group unadjusted hazard ratio (HR) of developing T2D was similar and non-significant. In the adjusted analysis, Rectal-No-Chemo was associated with lower T2D risk (HR 0.86 [95% CI 0.75-0.98]) compared to Right-No-Chemo.For all six groups, an increased level of body mass index (BMI) resulted in a nearly twofold increased risk of developing T2D. CONCLUSIONS: This study suggests that postoperative T2D screening should be prioritised in CRC survivors with overweight/obesity regardless of type of CRC treatment applied. FUNDING: The Novo Nordisk Foundation (NNF17SA0031406); TrygFonden (101390; 20045; 125132).","author_count":8,"contributors":["Krag, Caroline","Svane, Maria Saur","Madsbad, Sten","Graversen, Susanne Boel","Christensen, Jesper Frank","Sørensen, Thorkild I A","Lehrskov, Louise Lang","Laurberg, Tinne"],"cuid":["S01-000.00-747626"],"filters":{"added":"2024-08","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Adult","Aged","Aged 80 and over","Cohort Studies","Colorectal Neoplasms epidemiology","Denmark epidemiology","Diabetes Mellitus Type 2 complications","Female","Humans","Incidence","Male","Middle Aged","Registries","Risk Factors"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"the impact of surgery and oncological treatment on risk of type 000000000002 diabetes onset in patients with colorectal cancer nationwide cohort study in denmark","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.7554/eLife.89354","version":"Published Version"},"id":"S01-000.00-747626","identifier":[{"id":"38829205","type":"pmid"},{"id":"PMC11147501","type":"pmcid"}],"ids":["ku-21d86110-020e-4428-bf41-197c62e02ee0"],"keyword":["Adult","Aged","Aged, 80 and over","Cohort Studies","Colorectal Neoplasms/epidemiology","Denmark/epidemiology","Diabetes Mellitus, Type 2/complications","Female","Humans","Incidence","Male","Middle Aged","Registries","Risk Factors"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-4-7-AB9D5D6DC4AA5E65B014C9A02565978A"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/394539926/elife_89354_v1.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.7554/eLife.89354","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of D