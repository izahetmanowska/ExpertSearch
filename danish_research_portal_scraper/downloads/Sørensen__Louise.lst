 University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Obstetrics and Gynaecology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1 2","country":"dk","first":"Anja Elaine","key":"sørensenpau","last":"Sørensen","locid":"7e5d1e2c-5d4b-4436-bb66-acdca4058c08","name":"Sørensen, Anja Elaine","orcid":"0000-0001-7557-5376","rank":1,"rolecode":"pau"},{"affno":"1 3","first":"Pernille","key":"bækgaardudesenpau","last":"Bækgaard Udesen","name":"Bækgaard Udesen, Pernille","rank":2,"rolecode":"pau"},{"affno":"","first":"Pernille B.","key":"udesenpau","last":"Udesen","name":"Udesen, Pernille B.","rank":2,"rolecode":"pau"},{"affno":"1","first":"Grzegorz","key":"maciagpau","last":"Maciag","name":"Maciag, Grzegorz","rank":3,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Julian","key":"geigerpau","last":"Geiger","locid":"62aff51a-b90b-406f-97f0-07262205773a","name":"Geiger, Julian","orcid":"0000-0001-8434-1459","rank":4,"rolecode":"pau"},{"affno":"1","first":"Negar","key":"salianipau","last":"Saliani","name":"Saliani, Negar","rank":5,"rolecode":"pau"},{"affno":"4","first":"Andrzej","key":"januszewskipau","last":"Januszewski","name":"Januszewski, Andrzej","rank":6,"rolecode":"pau"},{"affno":"5","first":"Guozhi","key":"jiangpau","last":"Jiang","name":"Jiang, Guozhi","rank":7,"rolecode":"pau"},{"affno":"5","first":"Ronald C","key":"mapau","last":"Ma","name":"Ma, Ronald C","rank":8,"rolecode":"pau"},{"affno":"4","first":"Anandwardhan Awadhoot","key":"hardikarpau","last":"Hardikar","name":"Hardikar, Anandwardhan Awadhoot","rank":9,"rolecode":"pau"},{"affno":"3","first":"Marie Louise Muff","key":"wissingpau","last":"Wissing","name":"Wissing, Marie Louise Muff","rank":10,"rolecode":"pau"},{"affno":"6","country":"dk","first":"Anne Lis M.","key":"englundpau","last":"Englund","locid":"e7b5bbea-601b-47a2-8256-6b9b8628b633","name":"Englund, A. L.M.","name_org":"Englund, Anne Lis M.","rank":11,"rolecode":"pau"},{"affno":"3","first":"Anne Lis Englund","key":"mikkelsenpau","last":"Mikkelsen","name":"Mikkelsen, Anne Lis Englund","rank":11,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Louise Torp","key":"dalgaardpau","last":"Dalgaard","locid":"a219fdaf-f994-4a7a-beb8-1f353846ed5a","name":"Dalgaard, Louise Torp","orcid":"0000-0002-3598-2775","rank":12,"rolecode":"pau"}],"pmid":["31737638"],"pub":{"doi":"10.3389/fmed.2019.00242","issn":["2296858X"],"issue":"242","journal":"Frontiers in Medicine","paperid":"242","status":"p","title":"Frontiers in Medicine","volume":"6"},"review":"Peer Reviewed","scoID":["2-s2.0-85075382271"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region Zealand","Region of Southern Denmark","Roskilde University","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-7e207ca5-ed3b-46ec-b2a1-196b5531ad5f","ruc-09610f06-11c9-4020-8263-30fa03f5fdc6"],"src":["KU University of Copenhagen","RUC Roskilde University"],"title":"Hyperandrogenism and Metabolic Syndrome Are Associated With Changes in Serum-Derived microRNAs in Women With Polycystic Ovary Syndrome","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-096.86-043810","year":"2019","yearsub":"2019"}
{"abstract":"Women with Polycystic Ovary Syndrome (PCOS) present a heterogeneous reproductive and metabolic profile with an increased lifetime risk of Type 2 Diabetes (T2D). Early biomarkers of these metabolic disturbances in PCOS women have not been identified. The abundance of circulating insulin gene promotor cell-free DNA (INS cfDNA) was shown to be valuable as a predictive biomarker of β-cell death in individuals with Type 1 diabetes (T1D) as well as with gestational diabetes. Since β-cell death is common to the development of T1D as well as in T2D, we aimed to investigate if insulin-coding DNA is more abundant in circulation of PCOS women (vs Controls) and if their levels change after 6 yr. follow-up as a potential measure to predict future T2D. Methods A cohort of 40 women diagnosed with PCOS according to Rotterdam 2003 criteria and eight healthy controls were examined at baseline and 6 years follow-up. Clinical measurements for evaluation of glucose homeostasis as well as blood/serum samples were obtained at each visit. Methylated and unmethylated INS cfDNA were quantified using droplet digital PCR. Differences between groups were assessed using Kruskall-Wallis test and Wilcoxon Signed rank test. Results At baseline, there was no detectable difference in copy number (copies/μL) of methylated (p = 0.74) or unmethylated INS cfDNA (p = 0.34) between PCOS and Control groups. At follow up, neither methylated (p = 0.50) nor unmethylated INScfDNA levels (p = 0.48) differed significantly between these groups. Likewise, when pooling the groups, there was no difference between baseline and follow up, in terms of copies of methylated or unmethylated INS cfDNA (p = 0.38 and p = 0.52, respectively). There were no significant correlations between counts of unmethylated or methylated cfDNA and the clinical measurements of β-cell function and pre-diabetes. Conclusion The circulating level of unmethylated and methylated INScfDNA is similar between PCOS and Controls and cannot be used to predict islet β-cell loss and progression to Type 2 diabetes in a 6-year follow-up. Trial registration The Danish Data Protection Agency (REG-31-2016. Approval: 01-12-2015) and by the Danish Scientific Ethical committee of Region Zealand (Journal no. SJ-525. Approval: 13-06-2016), Clinicaltrials.gov, (NCT03142633, registered 1. March, 2017, Retrospectively registered).","author_count":8,"contributors":["Udesen, Pernille Bækgaard","Sørensen, Anja Elaine","Joglekar, Mugdha V.","Hardikar, Anandwardhan A.","Wissing, Marie Louise Muff","Mikkelsen, Anne Lis","Dalgaard, Louise Torp"],"cuid":["S02-097.48-041750"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["OECD","Oceania"],"country":["Australia"],"glorg":["All Global Affiliations","University of Sydney"],"keyword":["Androgens","Circulating free DNA","Demethylation","Glucose tolerance","Insulin promoter CpG methylation","PCOS","Testosterone"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-ZEA"],"U":["DI-U-ALL","DI-U-KU","DI-U-RUC"]},"level3all":["DI-HO-ZEA","DI-U-KU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"levels of circulating insulin cell free dna in women with polycystic ovary syndrome a longitudinal cohort study","src":["ku","ruc"],"src-code":["DI-U-KU","DI-U-RUC"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s12958-019-0478-7","version":"Published Version"},"id":"S02-097.48-041750","identifier":[{"id":"85063944671","type":"scopus"},{"id":"PMC6451227","type":"pmcid"},{"id":"30953560","type":"pmid"}],"ids":["ku-3eb0a6b3-f554-453f-9b2a-a716a820d3c4","ruc-91052157-308a-4c88-bd40-1a02b8844b39"],"keyword":["Androgens","Circulating free DNA","Demethylation","Glucose tolerance","Insulin promoter CpG methylation","PCOS","Testosterone"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-D984206D534F4ED84AE2BB07375AABC9"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/240703537/document_34_.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/65052587/Levels_of_circulating_insulin_cell_free_DNA_in.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s12958-019-0478-7","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","country":"dk","key":"region zealand","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-ZEA","l3nl":"Region Zealand","l3nn":"Region Zealand","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region Zealand","namevar":["Zealand University Hospital, Køge"],"nora_code":"DI-HO-ZEA","used":1},{"affno":"2","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of Science and Environment","Roskilde University, Department of Science and Environment, Molecular and Medical Biology"],"nora_code":"DI-U-RUC","used":1},{"affno":"3","country":"au","key":"university of sydney","loc":["Australia","Oceania","OECD"],"name":"University of Sydney","used":1},{"affno":"4","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Pernille Bækgaard","key":"udesenpau","last":"Udesen","name":"Udesen, Pernille Bækgaard","rank":1,"rolecode":"pau"},{"affno":"2","country":"dk","first":"Anja Elaine","key":"sørensenpau","last":"Sørensen","locid":"7e5d1e2c-5d4b-4436-bb66-acdca4058c08","name":"Sørensen, Anja Elaine","orcid":"0000-0001-7557-5376","rank":2,"rolecode":"pau"},{"affno":"3","first":"Mugdha","key":"joglekarpau","last":"Joglekar","name":"Joglekar, Mugdha","rank":3,"rolecode":"pau"},{"affno":"2","country":"dk","first":"Anandwardhan Awadhoot","key":"hardikarpau","last":"Hardikar","locid":"6c535712-be9f-4d60-9fd1-cc6746b35702","name":"Hardikar, Anandwardhan A.","name_org":"Hardikar, Anandwardhan Awadhoot","rank":4,"rolecode":"pau"},{"affno":"1","first":"Marie Louise Muff","key":"wissingpau","last":"Wissing","name":"Wissing, Marie Louise Muff","rank":5,"rolecode":"pau"},{"affno":"4","first":"Anne Lis Mikkelsen","key":"englundpau","last":"Englund","locid":"6cbff25a-c0b9-48f6-8cc5-4e7df8c29013","name":"Mikkelsen, Anne Lis","name_org":"Englund, Anne Lis Mikkelsen","rank":6,"rolecode":"pau"},{"affno":"1","first":"Anne-Lis","key":"mikkelsenenglundpau","last":"Mikkelsen Englund","name":"Mikkelsen Englund, Anne-Lis","rank":6,"rolecode":"pau"},{"affno":"2","country":"dk","first":"Louise Torp","key":"dalgaardpau","last":"Dalgaard","locid":"a219fdaf-f994-4a7a-beb8-1f353846ed5a","name":"Dalgaard, Louise Torp","orcid":"0000-0002-3598-2775","rank":7,"rolecode":"pau"}],"pmid":["30953560"],"pub":{"doi":"10.1186/s12958-019-0478-7","issn":["14777827"],"issue":"34","journal":"Reproductive Biology and Endocrinology","paperid":"34","status":"p","title":"Reproductive Biology and Endocrinology","volume":"17"},"review":"Peer Reviewed","scoID":["2-s2.0-85063944671"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region Zealand","Roskilde University","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-3eb0a6b3-f554-453f-9b2a-a716a820d3c4","ruc-91052157-308a-4c88-bd40-1a02b8844b39"],"src":["KU University of Copenhagen","RUC Roskilde University"],"title":"Levels of circulating insulin cell-free DNA in women with Polycystic Ovary Syndrome : a longitudinal cohort study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-097.48-041750","year":"2019","yearsub":"2019"}
{"abstract":"Treatment for chronic diabetic foot ulcers is limited by the inability to simultaneously address the excessive inflammation and impaired re-epithelization and remodeling. Impaired re-epithelization leads to significantly delayed wound closure and excessive inflammation causes tissue destruction, both enhancing wound pathogen colonization. Among many differentially expressed microRNAs, miR-155 is significantly upregulated and fibroblast growth factor 7 (FGF7) mRNA (target of miR-155) and protein are suppressed in diabetic skin, when compared to controls, leading us to hypothesize that topical miR-155 inhibition would improve diabetic wound healing by restoring FGF7 expression. In vitro inhibition of miR-155 increased human keratinocyte scratch closure and topical inhibition of miR-155 in vivo in wounds increased murine FGF7 protein expression and significantly enhanced diabetic wound healing. Moreover, we show that miR-155 inhibition leads to a reduction in wound inflammation, in accordance with known pro-inflammatory actions of miR-155. Our results demonstrate, for the first time, that topical miR-155 inhibition increases diabetic wound fibroblast growth factor 7 expression in diabetic wounds, which, in turn, increases re-epithelization and, consequently, accelerates wound closure. Topical miR-155 inhibition targets both excessive inflammation and impaired re-epithelization and remodeling, being a potentially new and effective treatment for chronic diabetic foot ulcers.","author_count":12,"contributors":["Moura, João","Sørensen, Anja Elaine","Svendsen, Rikke","Carvalho, Lina","Leal, Ermelindo C.","Willemoes, Rie Juul","Jørgensen, Per Trolle","Jenssen, Håvard","Wengel, Jesper","Dalgaard, Louise Torp","Carvalho, Eugenia"],"cuid":["S02-100.00-048393"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["America, North","Europe, EU","OECD"],"corresponding_author":["Carvalho, Eugénia"],"country":["Portugal","United States"],"glorg":["All Global Affiliations","Arkansas Children’s Research Institute","Coimbra University","University of Arkansas for Medical Sciences","University of Coimbra"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-RUC","DI-U-SDU"]},"level3all":["DI-U-RUC","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"microrna 000000000155 inhibition restores fibroblast growth factor 000000000007 expression in diabetic skin and decreases wound inflammation","src":["ruc","sdu"],"src-code":["DI-U-RUC","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41598-019-42309-4","version":"Published Version"},"id":"S02-100.00-048393","identifier":[{"id":"85064080390","type":"scopus"},{"id":"30967591","type":"pmid"},{"id":"PMC6456606","type":"pmcid"}],"ids":["ruc-c314a8c8-a3b3-4f38-ad0b-a797a18520af","sdu-8f6b9e58-e34e-46d3-a4a9-cb9e49969ecc"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-493727D700EBC29FE0BF597DAB4D521C"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/111449286/s41598-019-42309-4.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41598-019-42309-4","version":"Published Version"},{"access":"oa","license":"CC BY","type":"rem","url":"https://www.nature.com/articles/s41598-019-42309-4","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/149344937/microRNA_155_inhibition_restores_Fibroblast_Growth_Factor_7_expression_in_diabetic_skin_and_decreases_wound_inflammation.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","co