010-bdf6-9ec77c7deed3","name":"Sørensen, Thorkild I A","orcid":"0000-0003-4821-430X","rank":6,"rolecode":"pau"},{"affno":"1","first":"Louise Lang","key":"lehrskovpau","last":"Lehrskov","name":"Lehrskov, Louise Lang","rank":7,"rolecode":"pau"},{"affno":"3","first":"Tinne","key":"laurbergpau","last":"Laurberg","name":"Laurberg, Tinne","rank":8,"rolecode":"pau"}],"pmid":["38829205"],"pub":{"doi":"10.7554/elife.89354","issn":["2050084X"],"journal":"eLife","paperid":"RP89354","status":"p","title":"eLife","volume":"12"},"review":"Peer Reviewed","scoID":["2-s2.0-85195905395"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-21d86110-020e-4428-bf41-197c62e02ee0"],"src":["KU University of Copenhagen"],"title":"The impact of surgery and oncological treatment on risk of type 2 diabetes onset in patients with colorectal cancer : nationwide cohort study in Denmark","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-747626","year":"2024","yearsub":"2024"}
{"abstract":"We present an ice-penetrating radar data set acquired over the Greenland ice sheet by aircraft during the years 1971, 1972, 1974, 1978, and 1979. The data set comprises over 177 000 km of flight lines and contains a wealth of information on the state of the Greenland ice sheet, including information on ice thickness and englacial properties. During data collection in the 1970s, the data were recorded on optical film rolls, and in this paper, we document the digitization of these film rolls and their associated geographical information. Our data digitization enables interaction with and analysis of the data and facilitates comparison with modern-day radar observations. The complete data set in full resolution is available in the Stanford Digital Repository (https://doi.org/10.25740/wm135gp2721; Karlsson et al., 2023), with the associated technical reports. Part of the data set is available as low-resolution JPG files at the Technical University of Denmark’s data repository (https://doi.org/10.6084/m9.figshare.c.7235299.v1; Karlsson et al., 2024), with associated technical reports and digitized geographical information . The Stanford Digital Repository serves as long-term storage, providing archival historic preservation in perpetuity, and is not intended as a primary data access point. The Technical University of Denmark (DTU) data repository serves as a primary entry point for data access, with files organized according to acquisition year and flight line in a simple folder structure. Here, we release the full data sets to enable the larger community to access and interact with the data (Karlsson et al., 2023).","author_count":13,"contributors":["Karlsson, Nanna B.","Schroeder, Dustin M.","Sørensen, Louise Sandberg","Chu, Winnie","Dall, Jørgen","Andersen, Natalia Havelund","Dobson, Reese","Mackie, Emma J.","Köhn, Simon J.","Steinmetz, Jillian E.","Tarzona, Angelo S.","Teisberg, Thomas O.","Skou, Niels"],"cuid":["S01-000.00-753696"],"filters":{"added":"2024-09","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","OECD"],"corresponding_author":["Karlsson, Nanna B."],"country":["United States"],"glorg":["All Global Affiliations","Georgia Institute of Technology","Stanford University","University of Florida"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-GEUS"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-GV-GEUS","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"a newly digitized ice penetrating radar data set acquired over the greenland ice sheet in 000000001971 000000001979","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.5194/essd-16-3333-2024","version":"Published Version"},"id":"S01-000.00-753696","identifier":[{"id":"85199255206","type":"scopus"}],"ids":["dtu-3e223aa4-74fa-4850-8228-5d45fcdb2364"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-533753B26303AE711D1D71C697FBF092"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/371364196/essd-16-3333-2024.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.5194/essd-16-3333-2024","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"geus geological survey of denmark and greenland","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-GEUS","l3nn":"GEUS Geological Survey of Denmark and Greenland","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"GEUS Geological Survey of Denmark and Greenland","namevar":["Geological Survey of Denmark and Greenland"],"nora_code":"DI-GV-GEUS","used":1},{"affno":"2","country":"us","key":"stanford university","loc":["United States","America, North","OECD"],"name":"Stanford University"