:"","corresponding":null,"first":"Uffe","key":"holmskovpau","last":"Holmskov","locid":"c1ce73b6-d49f-466e-9730-fc83076f65cd","name":"Holmskov, Uffe","orcid":"0000-0002-2391-9445","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kirsten Ohm","key":"kyvikpau","last":"Kyvik","locid":"33f078c5-34c0-48ab-9f25-b747e8b0ae49","name":"Kyvik, Kirsten Ohm","orcid":"0000-0003-2981-0245","rank":12,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Grith Lykke","key":"sorensenpau","last":"Sorensen","locid":"950cb689-da86-4abe-835b-a1312ddf5cec","name":"Sorensen, Grith Lykke","orcid":"0000-0002-5273-1097","rank":13,"rolecode":"pau"}],"pmid":["24610936"],"pub":{"doi":"10.1152/ajplung.00340.2013","issn":["10400605","15221504"],"issn_org":["10400605"],"issue":"9","journal":"American Journal of Physiology - Lung Cellular and Molecular Physiology","publisher":"American Physiological Society","status":"p","title":"American Journal of Physiology - Lung Cellular and Molecular Physiology","title_org":"American Journal of Physiology: Lung Cellular and Molecular Physiology","volume":"306"},"review":"Peer Reviewed","scoID":["2-s2.0-84900535443"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-0afbc6f6-76f5-4b27-b1da-a971ec15ac10","sdu-c9671ffc-d384-44cf-8cd2-00c0f3605dd9"],"src":["AAU Aalborg University","SDU University of Southern Denmark"],"title":"Surfactant Protein D is a candidate biomarker for subclinical tobacco smoke-induced lung damage","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-098.97-000580","year":"2014","yearsub":"2014"}
{"abstract":"As in other fibroproliferative disorders, hypoxia has been suggested to play a key role in the pathogenesis of exuberant granulation tissue (EGT). The purpose of this study was to investigate metabolism and blood flow locally in full-thickness wounds healing with (limb wounds) and without (body wounds) formation of EGT. Microdialysis was used to recover endogenous metabolites from the wounds, and laser Doppler flowmetry was used to measure blood flow. Measurements were performed before wounding and 1-28 days after wounding. Blood flow was consistently lower in limb wounds than in body wounds throughout the study period with no change over time. After wounding and throughout the study period, the glucose concentration was significantly lower in limb wounds than in body wounds, whereas the lactate level showed a significantly higher concentration in limb wounds. The lactate/glucose ratio displayed a significant difference between body and limb wounds. In conclusion, the metabolic disturbances may suggest an inadequate oxygen supply during the wound healing process in equine limb wounds healing with EGT. This may be related to the inherently decreased perfusion in the wound bed of limb wounds.","author_count":5,"contributors":["Sørensen, Mette A","Petersen, Lars Jelstrup","Bundgaard, Louise","Toft, Nils","Jacobsen, Stine"],"cuid":["S03-099.75-002808"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":3,"keyword":["Animal experimentation"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-NDR","DI-HO-OTH"],"U":["DI-U-AAU","DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-HO-NDR","DI-HO-OTH","DI-U-AAU","DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"regional disturbances in blood flow and metabolism in equine limb wound healing with formation of exuberant granulation tissue","src":["aau","dtu","ku"],"src-code":["DI-U-AAU","DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1111/wrr.12207","version":"Other Version"},"id":"S03-099.75-002808","identifier":[{"id":"WOS:000344179100113","type":"wos"},{"id":"85007200156","type":"scopus"},{"id":"24935817","type":"pmid"}],"ids":["aau-38a69b58-8f4a-4c1a-b628-05e96c0f22fe","dtu-5bc9cda6-0559-450f-8462-e543774c3cce","ku-28f54c2a-9165-446b-9cc8-f35b082b9663"],"keyword":["ANIMAL experimentation"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-6-5D608614831680287F9986AF2FBBB362"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1111/wrr.12207","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Veterinary Clinical Sciences, Section for Medicine and Surgery"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Clinical Cancer Research Center","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Nuclear Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Diagnostik","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-AAU","used":1},{"affno":"3","country":"dk","key":"north denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-NDR","l3nl":"North Denmark Region","l3nn":"North Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"North Denmark Region","namevar":["Aalborg University Hospital"],"nora_code":"DI-HO-NDR","used":1},{"affno":"4","country":"dk","key":"other hospitals","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-OTH","l3nl":"Other Hospitals","l3nn":"Other Hospitals","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Hospitals","namevar":["Klinisk Fysiologi og Nuklearmedicin"],"nora_code":"DI-HO-OTH","used":1},{"affno":"5","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Veterinary Institute","Technical University of Denmark, National Veterinary Institute, Section for Epidemiology"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","first":"Mette Aamand","key":"sørensenpau","last":"Sørensen","locid":"c3ce4ae2-7fda-40ef-8fa7-ff09dc2da244","name":"Sørensen, Mette Aamand","rank":1,"rolecode":"pau"},{"affno":"2 3 4","corresponding":null,"country":"dk","first":"Lars J","key":"petersenpau","last":"Petersen","locid":"e5cf5f25-4cff-407e-9c25-97921d98a7bc","name":"Petersen, Lars Jelstrup","name_org":"Petersen, Lars J","rank":2,"rolecode":"pau"},{"affno":"1","first":"Louise","key":"bundgaardpau","last":"Bundgaard","locid":"fac2f738-731c-4ca5-9369-45d6f4486fe2","name":"Bundgaard, Louise","orcid":"0000-0002-0396-883X","rank":3,"rolecode":"pau"},{"affno":"5","corresponding":null,"country":"dk","first":"Nils","key":"toftpau","last":"Toft","locid":"e4f84efb-d003-4bb4-b699-5d720484cf76","name":"Toft, Nils","orcid":"0000-0002-0265-3764","rank":4,"rolecode":"pau"},{"affno":"1","first":"Stine","key":"jacobsenpau","last":"Jacobsen","locid":"f3957428-a0cc-46ad-a05c-b85ca7d03e9e","name":"Jacobsen, Stine","orcid":"0000-0002-2380-4576","rank":5,"rolecode":"pau"}],"pmid":["24935817"],"pub":{"doi":"10.1111/wrr.12207","issn":["10671927","1524475X"],"issn_org":["10671927"],"issue":"5","journal":"Wound Repair and Regeneration","pages":"647-653","publisher":"Wiley-Blackwell","status":"p","title":"Wound Repair and Regeneration","volume":"22"},"review":"Peer Reviewed","scoID":["2-s2.0-85007200156"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Other Hospitals","Technical University of Denmark","Universities","University of Copenhagen","klinisk fysiologi og nuklearmedicin"],"PST":["Published"]},"sid":["aau-38a69b58-8f4a-4c1a-b628-05e96c0f22fe","dtu-5bc9cda6-0559-450f-8462-e543774c3cce","ku-28f54c2a-9165-446b-9cc8-f35b082b9663"],"src":["AAU Aalborg University","DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Regional disturbances in blood flow and metabolism in equine limb wound healing with formation of exuberant granulation tissue","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-099.75-002808","year":"2014","yearsub":"2014"}
{"abstract":"The aim of this study was the development of a quantitative assay that could support future studies of a panel of acute phase proteins (APPs) in the horse. The assay was based on a quantification concatamer (QconCAT) coupled with selected reaction monitoring methodology. Thirty-two peptides, corresponding to 13 putative or confirmed APPs for the Equus caballus (equine) species were selected for the design of a QconCAT construct. The gene encoding the QconCAT was synthesised and expressed as an isotope-labelled chimaeric protein in Escherichia coli. The QconCAT tryptic peptides were analysed on a triple-quadrupole instrument, and the quantotypic properties were assessed in equine serum, wound tissue and wound interstitial fluid. Reasonable quantotypic performance was found for 12, 14, and 14 peptides in serum, wound tissue, and interstitial fluid, respectively. Seven proteins were quantified in absolute terms in serum collected from a horse before and after the onset of a systemic inflammatory condition, and the observed protein concentrations were in close agreement with previous data. We conclude, that this QconCAT is applicable for concurrent quantitative analysis of multiple APPs in serum and may also support future studies of these proteins in other types of tissues and body fluids from the horse.","author_count":9,"contributors":["Bundgaard, Louise","Jacobsen, Stine","Dyrlund, Thomas F","Sørensen, Mette Aa","Harman, Victoria M","Beynon, Robert J","Brownridge, Philip J","Petersen, Lars Jelstrup","Bendixen, Emøke"],"cuid":["S03-099.78-002110"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":3,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","University of Liverpool"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-OTH"],"OT":["Institut for Molekylærbiologi og Genetik - Proteinvidenskab"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-HO-OTH","DI-U-AAU","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"development of a method for absolute quantification of equine acute phase proteins using concatenated peptide standards and selected reaction monitoring","src":["aau","au","ku"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1021/pr500607s","version":"Other Version"},"id":"S03-099.78-002110","identifier":[{"id":"WOS:000346039400030","type":"wos"},{"id":"25250876","type":"pmid"},{"id":"84915793021","type":"scopus"}],"ids":["aau-29f60ef0-e373-473a-a892-bc3cc4aa8c45","au-ba4bd48d-d500-495f-9bbc-386023da0983","ku-132e99cd-f40f-460d-8ffe-73643f6d8f3c"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-6-2283F7E5EA289E6CAAB7CF68EF6CF280"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1021/pr500607s","version":"Other Version"}],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Molecular Biology and Genetics, Department of Molecular Biology and Genetics - Protein science"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":