n","locid":"6b6bfff1-8b14-468b-af77-e71b375018e0","name":"Hansen, Torben","orcid":"0000-0001-8748-3831","rank":48,"rolecode":"pau"},{"affno":"19","first":"Jens-Christian","key":"holmjenschristianpau","last":"Holm","locid":"d61af840-e87e-4a2e-8be2-b481959ef6c9","name":"Holm, Jens-Christian","rank":49,"rolecode":"pau"},{"affno":"19","first":"Thorkild I A","key":"sørensenthorkildiapau","last":"Sørensen","locid":"2cb8cf47-6b6b-4010-bdf6-9ec77c7deed3","name":"Sørensen, Thorkild I A","orcid":"0000-0003-4821-430X","rank":50,"rolecode":"pau"},{"affno":"1","first":"Struan F A","key":"grantstruanfapau","last":"Grant","name":"Grant, Struan F A","rank":51,"rolecode":"pau"},{"affno":"1","first":"Diana L","key":"cousminerdianalpau","last":"Cousminer","name":"Cousminer, Diana L","rank":52,"rolecode":"pau"}],"pmid":["38229171"],"pub":{"doi":"10.1186/s13059-023-03136-z","issn":["14747596","1474760X"],"issn_org":["14747596"],"journal":"Genome Biology","paperid":"22","status":"p","title":"Genome Biology","volume":"25"},"review":"Peer Reviewed","scoID":["2-s2.0-85183074018"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Hospitals","Other Research","Universities","University of Copenhagen","copenhagen university hospital - holbæk"],"PST":["Published"]},"sid":["ku-3cfed943-fc5c-40f7-9b97-313e42fff3ee"],"src":["KU University of Copenhagen"],"title":"Trans-ancestral genome-wide association study of longitudinal pubertal height growth and shared heritability with adult health outcomes","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-719944","year":"2024","yearsub":"2024"}
{"abstract":"Aims Myocardial perfusion imaging (MPI) using [15O]H2O positron emission tomography (PET) is used to guide the selection of patients with angina for invasive angiography and possible revascularization. Our study evaluated (i) whether atrial fibrillation (AF) reduces global hyperaemic myocardial blood flow (MBF) and (ii) whether [15O]H2O PET MPI effectively guides revascularization procedures for patients with ongoing AF. Methods We prospectively recruited 346 patients with angina and persistent or paroxysmal AF referred for baseline/hyperaemic and results [15O]H2O PET MPI. The primary outcome was revascularization within 3 months of MPI. In the analyses, patients were divided into four groups based on whether they had ongoing AF or sinus rhythm (SR) and whether they had previously documented coronary artery disease (CAD) or not. Thus, four groups were compared: SR-noCAD, AF-noCAD, SR-CAD, and AF-CAD. Hyperaemic MBF was affected by both ongoing AF and prior CAD [MBF (mL/min/g): 2.82 (SR-noCAD) vs. 2.12 (AF-noCAD) vs. 2.22 (SR-CAD) vs. 1.80 (AF-CAD), two-way analysis of variance P < 0.0001]. In multiple linear regression, ongoing AF was independently associated with reduced hyperaemic MBF. Every 0.1 mL/min/g decrease in hyperaemic MBF was associated with a 23% increase in odds of early revascularization. Receiver operating characteristic (ROC) analysis of vessel-specific hyperaemic MBF to predict early revascularization yielded the following areas under the ROC curve: SR-noCAD: 0.95 (P < 0.0001); AF-noCAD: 0.79 (P < 0.0001); SR-CAD: 0.78 (P < 0.0001); and AF-CAD: 0.88 (P < 0.0001). Conclusion Ongoing AF is associated with 19–25% reduced global hyperaemic MBF as measured by [15O]H2O MPI PET. Regardless, vessel-specific hyperaemic MBF still predicts early revascularization in patients with AF.","author_count":8,"contributors":["Madsen, Simon","Kjærulff, Mette Louise Gram","Ejlersen, June Anita","Nielsen, Bent Roni Ranghøj","Jakobsen, Lars","Sørensen, Jens","Tolbod, Lars Poulsen","Gormsen, Lars Christian"],"cuid":["S01-000.00-728483"],"filters":{"added":"2024-05","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Gormsen, Lars Christian"],"keyword":["Aged","Angina Pectoris diagnostic imaging","Atrial Fibrillation diagnostic imaging","Atrial fibrillation","Cohort Studies","Coronary Angiography methods","Coronary Artery Disease diagnostic imaging","Coronary artery disease","Female","Humans","Male","Middle Aged","Myocardial Perfusion Imaging","Myocardial Perfusion Imaging methods","Myocardial Revascularization","Myocardial blood flow","Oxygen Radioisotopes","Positron Emission Tomography methods","Prospective Studies","ROC Curve","Risk Assessment","Severity of Illness Index"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"guiding early revascularization using 000000000015o h000000000002o positron emission tomography myocardial perfusion imaging impact of atrial fibrillation","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85196500504","version":"Other Version"},"id":"S01-000.00-728483","identifier":[{"id":"85196500504","type":"scopus"},{"id":"38376457","type":"pmid"}],"ids":["au-caeede5d-d0b7-4bd3-af19-635956531ac1"],"keyword":["Aged","Angina Pectoris/diagnostic imaging","Atrial Fibrillation/diagnostic imaging","Cohort Studies","Coronary Angiography/methods","Coronary Artery Disease/diagnostic imaging","Female","Humans","Male","Middle Aged","Myocardial Perfusion Imaging/methods","Myocardial Revascularization","Oxygen Radioisotopes","Positron-Emission Tomography/methods","Prospective Studies","ROC Curve","Risk Assessment","Severity of Illness Index","[ O]H O PET MPI","atrial fibrillation","coronary artery disease","myocardial blood flow","myocardial perfusion imaging"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-D3EC497FE117F29F7EE21DD8A9C6C997"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Nuclear Medicine"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"S","key":"madsenpau","last":"Madsen","locid":"7178db82-0c1e-4350-8693-29ddb14306f4","name":"Madsen, Simon","name_org":"Madsen, S","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"M L G","key":"kjaerulffpau","last":"Kjaerulff","locid":"03a92e42-ba02-4e8c-9662-528d92b0640e","name":"Kjærulff, Mette Louise Gram","name_org":"Kjaerulff, M L G","orcid":"0000-0003-1215-2207","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"J A","key":"ejlersenpau","last":"Ejlersen","locid":"cc615f09-11db-4ba1-85e6-b0a038f9b76d","name":"Ejlersen, June Anita","name_org":"Ejlersen, J A","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"B R R","key":"nielsenpau","last":"Nielsen","locid":"896f4a21-d29c-4ad9-b0ef-4e7f8616c234","name":"Nielsen, Bent Roni Ranghøj","name_org":"Nielsen, B R R","orcid":"0000-0001-9228-3869","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"L","key":"jakobsenpau","last":"Jakobsen","locid":"8da74392-7299-4ef1-bd97-faad1809c71d","name":"Jakobsen, Lars","name_org":"Jakobsen, L","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"J","key":"sörensenpau","last":"Sörensen","locid":"cab278f0-6db5-48a8-8764-b7da319d7818","name":"Sørensen, Jens","name_org":"Sörensen, J","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"L P","key":"tolbodpau","last":"Tolbod","locid":"a1e56507-eb80-4f94-9470-df90dcecbc62","name":"Tolbod, Lars Poulsen","name_org":"Tolbod, L P","orcid":"0000-0002-8105-7046","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"L C","key":"gormsenpau","last":"Gormsen","locid":"a360c42f-861a-40d6-9d23-64b560b33190","name":"Gormsen, Lars Christian","name_org":"Gormsen, L C","orcid":"0000-0002-0144-1305","rank":8,"rolecode":"pau"}],"pmid":["38376457"],"pub":{"doi":"10.1093/ehjci/jeae043","issn":["15252167","15322114"],"issn_org":["15252167"],"issue":"7","journal":"European Heart Journal Cardiovascular Imaging","pages":"958-967","publisher":"Oxford University Press","status":"p","title":"European Heart Journal Cardiovascular Imaging","volume":"25"},"review":"Peer Reviewed","scoID":["2-s2.0-85196500504"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-caeede5d-d0b7-4bd3-af19-635956531ac1"],"src":["AU Aarhus University"],"title":"Guiding early revascularization using [15O]H2O positron emission tomography myocardial perfusion imaging : impact of atrial fibrillation","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-728483","year":"2024","yearsub":"2024"}
{"abstract":"CONTEXT: Pediatric obesity is characterized by insulin resistance, yet it remains unclear whether insulin resistance contributes to abnormalities in glucagon and incretin secretion. OBJECTIVE: To examine whether fasting and stimulated glucagon, GLP-1, and GIP concentrations differ between children and adolescents with obesity and insulin resistance (OIR), obesity and normal insulin sensitivity (OIS), and controls with normal weight (NW). METHODS: 80 (34 boys) children and adolescents, aged 7-17 years with OIR (n=22), OIS (n=22), and NW (n=36) underwent an oral glucose tolerance test with measurements of serum insulin, plasma glucose, glucagon, total GLP-1, and total GIP. Homeostatic model assessment of insulin resistance (HOMA-IR), single point insulin sensitivity estimator (SPISE), Matsuda index, insulinogenic index (IGI), and oral disposition index (ODI) were calculated. RESULTS: Fasting concentrations of glucagon and GLP-1 were higher in the OIR-group, with no significant differences for GIP. The OIR-group had higher glucagon total area under the curve (tAUC0-120) and lower GLP-1 incremental AUC (iAUC0-120), with no significant differences for GIP iAUC0-120. Higher fasting glucagon was associated with higher HOMA-IR, lower Matsuda index, lower SPISE, higher IGI, and higher plasma alanine transaminase, whereas higher fasting GLP-1 was associated with higher HOMA-IR, lower Matsuda index, and lower ODI. Higher glucagon tAUC0-120 was associated lower SPISE and lower Matsuda index, whereas lower GLP-1 iAUC0-120 was associated with a higher HOMA-IR, lower Matsuda index, and lower ODI. CONCLUSIONS: The OIR-group had elevated fasting concentrations of glucagon and GLP-1, and higher glucagon, but lower GLP-1 responses during an OGTT compared to the OIS- and NW-groups. In contrast, the OIS-group had similar hormone responses to the NW-group.","author_count":16,"contributors":["Stinson, Sara Elizabeth","Fernández de Retana Alzola, Ierai","Hovendal, Emilie Damgaard Brünner","Lund, Morten Asp Vonsild","Fonvig, Cilius Esmann","Holm, Louise Aas","Jonsson, Anna","Frithioff-Bøjsøe, Christine","Christiansen, Michael","Pedersen, Oluf","Ängquist, Lars","Sørensen, Thorkild I. A.","Holst, Jens Juul","Hartmann, Bolette","Holm, Jens-Christian","Hansen, Torben"],"cuid":["S01-000.00-739297"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-ZEA"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-HO-ZEA","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"altered glucagon and glp 000000000001 responses to oral glucose in children and adolescents with obesity and insulin resistance","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1210/clinem/dgad728","version":"Published Version"},"id":"S01-000.00-739297","identifier":[{"id":"85193564094","type":"scopus"},{"id":"38087928","type":"pmid"},{"id":"PMC11099488","type":"pmcid"}],"ids":["ku-729ff34b-140b-42ca-95e5-13afc9345b66"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-C3CC4B9BA3949F358D7086D526E5FE6A"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/392215323/dgad728.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1210/clinem/dgad728","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Novo Nordisk Foundation Center for Basic Metabolic Research, Hansen Group"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"region zealand","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-ZEA","l3nl":"Region Zealand","l3nn":"Region Zealand","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region Zealand","namevar":["Holbæk Hospital"],"nora_code":"DI-HO-ZEA","used":1},{"affno":"3","country":"dk","key":"ssi statens serum institut","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-SSI","l3nn":"SSI Statens Serum Institut","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SSI Statens Serum Institut","namevar":["Statens Serum Institut"],"nora_code":"DI-GV-SSI","used":1},{"affno":"4","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Herlev and Gentofte"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","first":"Sara Elizabeth","key":"stinsonsaraelizabethpau","last":"Stinson","locid":"75924fce-d276-4bc3-a247-362923bccbb5","name":"Stinson, Sara Elizabeth","orcid":"0000-0002-1491-9179","rank":1,"rolecode":"pau"},{"affno":"1","first":"Ierai","key":"fernándezderetanaalzolaieraipau","last":"Fernández de Retana Alzola","name":"Fernández de Retana Alzola, Ierai","rank":2,"rolecode":"pau"},{"affno":"1 2","first":"Emilie Damgaard Brünner","key":"hovendalemiliedamgaardbrünnerpau","last":"Hovendal","locid":"7887ad94-cef4-4913-bc23-44cae2ccb5a0","name":"Hovendal, Emilie Damgaard Brünner","rank":3,"rolecode":"pau"},{"affno":"2 1","first":"Morten Asp Vonsild","key":"lundmortenaspvonsildpau","last":"Lund","locid":"db42a2c7-efb3-4fc3-b82d-7f015c15cf4a","name":"Lund, Morten Asp Vonsild","orcid":"0000-0002-2711-1259","rank":4,"rolecode":"pau"},{"affno":"2 1","first":"Cilius Esmann