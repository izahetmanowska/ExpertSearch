ast":"Oxvig","locid":"ed472b6b-b72e-45f7-9d27-09bc23d0db9d","name":"Oxvig, Claus","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Michael Toft","key":"overgaardpau","last":"Overgaard","locid":"8bd43772-17bb-45d3-9190-b230a7038933","name":"Overgaard, Michael Toft","orcid":"0000-0002-1423-2481","rank":9,"rolecode":"pau"}],"pmid":["25557436"],"pub":{"doi":"10.1111/febs.13184","issn":["14321033","1742464X"],"issn_org":["1742464X"],"issue":"4","journal":"FEBS Journal","pages":"803-816","publisher":"Wiley-Blackwell Publishing Ltd","publisher_org":"Wiley-Blackwell Publishing Ltd.","status":"p","title":"FEBS Journal","title_org":"FEBS journal","volume":"282"},"review":"Peer Reviewed","scoID":["2-s2.0-84923176771"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-06674a8f-9f6e-43b8-a543-923b654539ea","au-9df2db2a-3cec-4fff-824f-6cdadff82d53"],"src":["AAU Aalborg University","AU Aarhus University"],"title":"Calmodulin mutations causing catecholaminergic polymorphic ventricular tachycardia confer opposing functional and biophysical molecular changes","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-000337","year":"2015","yearsub":2015}
{"abstract":"Pregnancy-associated plasma protein-A2 (PAPP-A2, pappalysin-2) is a large metalloproteinase, known to be required for normal postnatal growth and bone development in mice. We here report the detection of zebrafish papp-a2 mRNA in chordamesoderm, notochord, and lower jaw of zebrafish (Danio rerio) embryos, and that papp-a2 knockdown embryos display broadened axial mesoderm, notochord bends, and severely reduced cranial cartilages. Genetic data link these phenotypes to insulin-like growth factor binding protein-3 (Igfbp-3) and Bmp signaling, and biochemical analysis show specific Igfbp-3 proteolysis by Papp-a2, implicating Papp-a2 in the modulation of Bmp signaling by Igfbp-3 proteolysis. Knockdown of papp-a2 additionally resulted in angiogenesis defects, strikingly similar to previous observations in embryos with mutations in components of the Notch system. Concordantly, we find that Notch signaling is modulated by Papp-a2 in vivo, and, furthermore, that PAPP-A2 is capable of modulating Notch signaling independently of its proteolytic activity in cell culture. Based on these results, we conclude that Papp-a2 modulates Bmp and Notch signaling by independent mechanisms in zebrafish embryos. In conclusion, these data link pappalysin function in zebrafish to two different signaling pathways outside the IGF system.","author_count":9,"contributors":["Kjaer-Sorensen, Kasper","Engholm, Ditte Høyer","Jepsen, Malene R","Mørch, Maria Grymer Metz","Weyer, Kathrin","Hefting, Louise L","Skov, Louise L","Laursen, Lisbeth Schmidt","Oxvig, Claus"],"cuid":["S01-000.00-153596"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"pregnancy associated plasma protein a000000000002 modulates development of cranial cartilage and angiogenesis in zebrafish embryos","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1242/jcs.152587","version":"Other Version"},"id":"S01-000.00-153596","identifier":[{"id":"25236600","type":"pmid"},{"id":"84919400019","type":"scopus"}],"ids":["au-2a5597bb-1ddf-41d0-8295-109e65413865"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-046282D35DC65DE75FA86E0D77BC07B7"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1242/jcs.152587","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Molecular Biology and Genetics, Department of Molecular Biology and Genetics - Molecular Intervention"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Kasper","key":"kjaersorensenpau","last":"Kjaer-Sorensen","locid":"cedf0a18-d9ff-412a-8631-59cc6e28af15","name":"Kjaer-Sorensen, Kasper","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ditte Høyer","key":"engholmpau","last":"Engholm","locid":"135733d3-b362-4f97-8646-a501c305bcde","name":"Engholm, Ditte Høyer","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Malene R","key":"jepsenpau","last":"Jepsen","locid":"1ee33375-7b33-4935-a28e-4357fffe77c2","name":"Jepsen, Malene R","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Maria G","key":"morchpau","last":"Morch","locid":"36ed1103-bb85-43cf-a829-a6262d407afd","name":"Mørch, Maria Grymer Metz","name_org":"Morch, Maria G","rank":4,"rolecode":"pau"},{"affno":"1","