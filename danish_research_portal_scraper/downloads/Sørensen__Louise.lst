,"Europe, EU","Nordic","OECD"],"name":"Steno Diabetes Centers","namevar":["Steno Diabetes Centre Copenhagen"],"nora_code":"DI-HO-STENO","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Public Health, Department of Public Health - Department of Epidemiology"],"nora_code":"DI-U-AU","used":1},{"affno":"4","country":"gb","key":"university of cambridge","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Cambridge","used":1},{"affno":"5","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, National Institute of Public Health, Center for Public health in Greenland","SDU, The Faculty of Health Sciences, National Institute of Public Health, Department of Population Health and Morbidity"],"nora_code":"DI-U-SDU","used":1},{"affno":"6","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Steno Diabetes Centre, Gentofte, Denmark."],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","first":"Charlotte","key":"januspau","last":"Janus","locid":"43d27a16-cbc2-4b44-9ebc-858d3083ec5a","name":"Janus, Charlotte","orcid":"0000-0001-5111-7047","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Dorte","key":"vistisenpau","last":"Vistisen","name":"Vistisen, Dorte","rank":2,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Hanan","key":"amadidpau","last":"Amadid","locid":"5a12ccc6-e53e-47