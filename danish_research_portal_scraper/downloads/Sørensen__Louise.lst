lecode":"pau"},{"affno":"1","corresponding":null,"first":"Betina Bang","key":"sørensenpau","last":"Sørensen","locid":"ca7cc666-d0df-48ab-9b18-3a79b66065ac","name":"Sørensen, Betina Bang","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Morten Hulvej","key":"rodpau","last":"Rod","locid":"583541c2-ba4e-4647-ac89-ddc8dce7c469","name":"Rod, Morten Hulvej","orcid":"0000-0003-0178-5885","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Line","key":"zinckernagelpau","last":"Zinckernagel","locid":"b51646a2-7805-43c0-b7cb-1078babcf287","name":"Zinckernagel, Line","orcid":"0000-0002-0141-4374","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Bjarne","key":"laursenpau","last":"Laursen","locid":"d484780f-c917-4d3e-927e-5ff086dd00eb","name":"Laursen, Bjarne","orcid":"0000-0003-0121-9891","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Liselotte","key":"ingholtpau","last":"Ingholt","locid":"c5ba52d5-5b95-4c05-a5d3-7844e9a2ed0f","name":"Ingholt, Liselotte","rank":8,"rolecode":"pau"}],"pub":{"place":"København","publisher":"Statens Institut for Folkesundhed, Det Sundhedsvidenskabelige Fakultet, Syddansk Universitet","status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-90809123-d359-40ca-a367-990c4ebba59a"],"src":["SDU University of Southern Denmark"],"title":"Trivsel, tobak og rusmidler : Elevprofil for udvalgte grundforløb på Erhvervsskolen Nordsjælland","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-614623","year":"2013","yearsub":"2013"}
{"abstract":"Aim: To develop a microdialysis method for collection of fluid from horse wounds. Background: Collection of sample material for wound healing research in experimental animals is commonly obtained through biopsies. Though, biopsy collection is an invasive procedure and consequently triggers an inflammatory response. Therefore, wounds should only be biopsied once to display the undisturbed, natural healing process. This necessitates the creation of a wound for every required collection time-point. To limit the number of wounds created on each experimental animal, a new method that allows repeated collection from wounds was sought. Methods: Microdialysis is a minimally invasive method for sampling of compounds from the extracellular fluid, where a small probe is inserted into the target tissue and flux of solutes into the probe occurs by simple diffusion. The recovered dialysate reflects changes in the composition of the extracellular water phase. Sample collection can be continued for several hours. Results: Microdialysis was well tolerated by the experimental animal subjects with no signs of discomfort related to the microdialysis procedure. Collection of sample material lasted three hours and was carried out with 11 samplings during a 28 day period. It was safely performed with reliable yield when collecting from vertically positioned experimental wounds in a standing, sedated horse. Conclusions: Microdialysis allowed the collection of wound fluid samples for research purposes in a less invasive way than biopsies. This method also allowed repeated sampling from every wound and the obtained sample material was sufficient in amount for metabolite and protein analysis.","author_count":4,"contributors":["Sørensen, Mette Aamand","Bundgaard, Louise","Jacobsen, Stine","Petersen, Lars Jelstrup"],"cuid":["S01-000.00-727375"],"filters":{"added":"2024-05","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"collection of wound fluids from horses using microdialysis","src":["au"],"src-code":["DI-U-AU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-727375","ids":["au-56666e7b-ae30-4934-a425-9106aa87e610"],"lang":"Danish","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-09732FCD810B438E91F873149C6868BB"],"org":[{"affno":"1","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Fysiologi, Viborg"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Mette Aamand","key":"sørensenpau","last":"Sørensen","name":"Sørensen, Mette Aamand","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Louise","key":"bundgaardpau","last":"Bundgaard","name":"Bundgaard, Louise","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Stine","key":"jacobsenpau","last":"Jacobsen","name":"Jacobsen, Stine","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lars Michael Jelstrup","key":"petersenpau","last":"Petersen","locid":"78c60193-a5b1-40ad-bf56-ba42c1061b30","name":"Petersen, Lars Jelstrup","name_org":"Petersen, Lars Michael Jelstrup","rank":4,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-56666e7b-ae30-4934-a425-9106aa87e610"],"src":["AU Aarhus University"],"title":"Collection of wound fluids from horses using microdialysis","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-727375","year":"2013","yearsub":"2013"}
{"author_count":8,"contributors":["Bundgaard, Louise","Jacobsen, Stine","Sørensen, Mette Aamand","Beynon, Robert J.","Harman, Victoria M.","Petersen, Lars J.","Deutsch, Eric W.","Bendixen, Emøke"],"cuid":["S02-089.29-724934"],"event":{"end":"2013-12-03","place":"Odense, dk","start":"2013-12-03","title":"The 8th symposium of the Danish Proteomics Society","year":"2013"},"filters":{"added":"2022-04","altsrc":["No Matches Found"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["med","sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"towards selected reaction monitoring based research in the horse","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dca","type-grp":["all","pub"]},"id":"S02-089.29-724934","ids":["au-f18cc23b-83be-4f30-b99f-afc6fe54fa68","ku-5161dfe6-9439-4833-b08c-ec3044757358"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Local-1-2-AC7E7104471B1D7779A53E4DFC8C59BF"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Veterinary Clinical Sciences, Section for Medicine and Surgery"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Fysiologi, Viborg"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","first":"Louise","key":"bundgaardpau","last":"Bundgaard","locid":"fac2f738-731c-4ca5-9369-45d6f4486fe2","name":"Bundgaard, Louise","orcid":"0000-0002-0396-883X","rank":1,"rolecode":"pau"},{"affno":"1","first":"Stine","key":"jacobsenpau","last":"Jacobsen","locid":"f3957428-a0cc-46ad-a05c-b85ca7d03e9e","name":"Jacobsen, Stine","orcid":"0000-0002-2380-4576","rank":2,"rolecode":"pau"},{"affno":"","first":"Mette Aamand","key":"sørensenpau","last":"Sørensen","locid":"c3ce4ae2-7fda-40ef-8fa7-ff09dc2da244","name":"Sørensen, Mette Aamand","rank":3,"rolecode":"pau"},{"affno":"","first":"Robert J.","key":"beynonpau","last":"Beynon","name":"Beynon, Robert J.","rank":4,"rolecode":"pau"},{"affno":"","first":"Victoria M.","key":"harmanpau","last":"Harman","name":"Harman, Victoria M.","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lars J.","key":"petersenpau","last":"Petersen","locid":"78c60193-a5b1-40ad-bf56-ba42c1061b30","name":"Petersen, Lars Jelstrup","name_org":"Petersen, Lars J.","rank":6,"rolecode":"pau"},{"affno":"","first":"Eric W.","key":"deutschpau","last":"Deutsch","name":"Deutsch, Eric W.","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Emøke","key":"bendixenpau","last":"Bendixen","locid":"48748d97-85fd-424f-a51e-284e2a4dc849","name":"Bendixen, Emøke","rank":8,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-f18cc23b-83be-4f30-b99f-afc6fe54fa68","ku-5161dfe6-9439-4833-b08c-ec3044757358"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Towards selected reaction monitoring based research in the horse","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-089.29-724934","year":"2013","yearsub":"2013"}
{"abstract":"In 2006, the Danish government decided to take new measures to control Salmonella and Campylobacter in Danish and imported retail meat. The legal basis for these new measures was article 14 in the EU food law, which states that food shall not be placed on the market if it is unsafe, among others, for reasons of contamination. This provision allows each member state to make a specific risk assessment of food batches, and decide whether a batch poses an unacceptable risk to the consumer or not. Here we present the basis for the risk assessment model on Campylobacter used in this new approach and the results of more than 3,000 batches of broiler meat tested since 2007. The risk was assessed for batches with one or more samples positive for Campylobacter (>100 cfu/g). Reductions in the number of positive batches from 2007 to 2010 were observed for both domestic (from 17% to 7%, p=0.01) and imported broiler meat (from 39% to 18%, p<0.0001). During 2007-2010, only relatively few batches were deemed unsafe due to the presence of Campylobacter. The proportion of batches of domestic and imported broiler meat deemed unsafe varied from 0.3% to 1.0% for Danish broiler meat and from 0.2% to 7.7% for imported broiler meat. Still this initiative has been successful in significantly reducing the occurrence of Campylobacter in fresh meat available on the Danish retail market.","author_count":8,"contributors":["Christensen, Bjarke Bak","Nauta, Maarten","Korsgaard, Helle Bisgaard","Sørensen, Anna Irene Vedel","Rosenquist, Hanne","Boysen, Louise","Perge, Annette","Nørrung, Birgit"],"cuid":["S02-100.00-033295"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Broiler meat","Campylobacter","Control programme","Faculty of Health and Medical Sciences","Risk Assessment"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Danish Veterinary and Food Administration"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"case by case risk assessment of broiler meat batches an effective control strategy for em campylobacter em","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.foodcont.2012.10.025","version":"Other Version"},"id":"S02-100.00-033295","identifier":[{"id":"84871650118","type":"scopus"}],"ids":["dtu-203dc557-3735-4f15-88bb-29a835f74d87","ku-f03c84a8-72d8-4940-975a-3ba4abcd7caf"],"keyword":["Broiler meat","Campylobacter","Case-by-case","Control programme","Faculty of Health and Medical Sciences","Risk assessment"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-4E9BF8ED1FF31D2B0382AD68DE2B1539"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.foodcont.2012.10.025","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Microbiology","Technical University of Denmark, National Food Institute"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Danish Veterinary and Food Administration"],"nora_code":"DI-OT","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Veterinary and Animal Sciences, IVH Secretariat"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Bjarke Bak","key":"christensenpau","last":"Christensen","locid":"9a54ec6c-fdc2-4ff0-92fa-0ab3f7f7786a","name":"Christensen, Bjarke Bak","orcid":"0000-0001-9618-6134","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Maarten","key":"nautapau","last":"Nauta","locid":"6bbc1b20-a517-4ce1-abb9-a88b9481e380","name":"Nauta, Maarten","orcid":"0000-0001-8738-4251","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Helle","key":"korsgaardpau","last":"Korsgaard","locid":"bd6d48e5-2d2c-4c29-ba33-467ef364767f","name":"Korsgaard, Helle Bisgaard","name_org":"Korsgaard, Helle","orcid":"0000-0001-9257-9889","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anna Irene Vedel","key":"sørensenpau","last":"Sørensen","locid":"8df5f1a9-ab36-43ad-8a29-12adf0f1b106","name":"Sørensen, Anna Irene Vedel","orcid":"0000-0002-3877-4592","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Hanne","key":"rosenquistpau","last":"Rosenquist","locid":"4acc30c4-897d-45b5-9b10-16c93abb41f7","name":"Rosenquist, Hanne","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Louise","key":"boysenpau","last":"Boysen","locid":"b9b0837a-c236-4562-8674-3d64d4e8efc7","name":"Boysen, Louise","orcid":"0000-0001-9825-7688","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Annette","key":"pergepau","last":"Perge","name":"Perge, Annette","rank":7,"rolecode":"pau"},{"affno":"3","first":"Birgit","key":"nørrungpau","last":"Nørrung","locid":"cbf9dba8-42a0-430f-bbbd-5c7f9ffe402a","name":"Nørrung, Birgit","rank":8,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.foodcont.2012.10.025","issn":["09567135","18737129"],"issn_org":["09567135"],"issue":"2","journal":"Food Control","pages":"485-490","publisher":"Elsevier","status":"p","title":"Food Control","volume":"31"},"review":"Peer Reviewed","scoID":["2-s2.0-84871650118"],"search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-203dc557-3735-4f15-88bb-29a835f74d87","ku-f03c84a8-72d8-4940-975a-3ba4abcd7caf"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Case-by-case risk assessment of broiler meat batches: An effective control strategy for Campylobacter","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-033295","year":"2013","yearsub":2013}
{"abstract":"BACKGROUND: Based on animal studies, n-3 polyunsaturated fatty acids (PUFAs) have been suggested to lower the risk of obesity and inflammation. We aimed to investigate if, among humans, intake of n-3 PUFAs was associated with i) total body fat, ii) body fat distribution and iii) obesity-related inflammatory markers. METHODS: The study population consisted of 1,212 healthy individuals with information on habitual food intake from food frequency questionnaires, six different measures of body fat, and levels of six circulating inflammatory markers. Multiple linear regression analysis of intakes of PUFAs in relation to outcomes were performed and adjusted for potential confounders. RESULTS: Absolute n-3 PUFA intake, but not n-3/n-6, was inversely associated with the different measures of body fat. Among n-3 PUFA derivatives, only α-linolenic acid (ALA) was inversely associated with body fat measures. No significant interactions with the dietary macronutrient composition were observed. Pro-inflammatory cytokines were not associated with absolute PUFA intake, but the macrophage inflammatory protein-1α (MIP-1α) was associated with the n-3/n-6 ratio. CONCLUSION: In humans, intake of n-3 PUFAs, in particular ALA, is beneficially associated with body fatness. The favourable association is, however, not reflected in systemic levels of pro-inflammatory cytokines, nor is it influenced by macronutrients in the diet.","author_count":9,"contributors":["Lund, Anne-Sofie Quist","Hasselbalch, Ann Louise","Gamborg, Michael","Skogstrand, Kristin","Hougaard, David M","Heitmann, Berit L","Kyvik, Kirsten Ohm","Sørensen, Thorkild I A","Jess, Tine"],"cuid":["S02-100.00-047198"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Adipose tissue","Adolescent","Adult","Aged","Alpha linolenic acid","Anthropometry","Biological Markers","Body Fat Distribution","Chemokine CCL3","Diet","Dietary Fats","Fat mass","Fatty Acids Omega 3","Fatty Acids Omega 6","Female","Humans","Inflammation","Inflammation Mediators","Linear Models","Male","Middle Aged","Obesity","Polyunsaturated fatty acids","Questionnaires","Reference Values","Twins","Young Adult"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"n 000000000003 polyunsaturated fatty acids body fat and inflammation","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1159/000354663","version":"Other Version"},"id":"S02-100.00-047198","identifier":[{"id":"84883151947","type":"scopus"},{"id":"23970146","type":"pmid"}],"ids":["ku-ede7ba2c-a579-4f6b-a7fc-061d4a8522db","sdu-9070bc32-be6b-4937-b8b6-f463a6045365"],"keyword":["Adipose Tissue","Adolescent","Adult","Aged","Anthropometry","Biological Markers","Body Fat Distribution","Chemokine CCL3","Diet","Dietary Fats","Fat mass","Fatty Acids, Omega-3","Fatty Acids, Omega-6","Female","Humans","Inflammation","Inflammation Mediators","Linear Models","Male","Middle Aged","Obesity","Polyunsaturated fatty acids","Questionnaires","Reference Values","Twins","Young Adult","alpha-Linolenic Acid"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-958BD3F6A98C9E679EDE10A55325C1D9"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1159/000354663","version":"Other Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, National Institute of Public Health, Department of Population Health and Morbidity"],"nora_code":"DI-U-SDU","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Public Health","Københavns Universitet, Faculty of Health and Medical Sciences, Novo Nordisk Foundation Center for Basic Metabolic Research, Human Genomics and Metagenomics in Metabolism"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Anne-Sofie Q","key":"lundpau","last":"Lund","name":"Lund, Anne-Sofie Q","rank":1,"rolecode":"pau"},{"affno":"","first":"Ann Louise","key":"hasselbalchpau","last":"Hasselbalch","locid":"5ab0e5de-eb71-48f0-8f05-75729a589a81","name":"Hasselbalch, Ann Louise","rank":2,"rolecode":"pau"},{"affno":"","first":"Michael","key":"gamborgpau","last":"Gamborg","name":"Gamborg, Michael","rank":3,"rolecode":"pau"},{"affno":"","first":"Kristin","key":"skogstrandpau","last":"Skogstrand","name":"Skogstrand, Kristin","rank":4,"rolecode":"pau"},{"affno":"","first":"David M","key":"hougaardpau","last":"Hougaard","name":"Hougaard, David M","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Berit L","key":"heitmannpau","last":"Heitmann","locid":"ca6c318b-dc21-48ea-af18-a72c736f6fc7","name":"Heitmann, Berit L","orcid":"0000-0002-6809-4504","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Kirsten O","key":"kyvikpau","last":"Kyvik","locid":"33f078c5-34c0-48ab-9f25-b747e8b0ae49","name":"Kyvik, Kirsten Ohm","name_org":"Kyvik, Kirsten O","orcid":"0000-0003-2981-0245","rank":7,"rolecode":"pau"},{"affno":"3","first":"Thorkild I A","key":"sørensenpau","last":"Sørensen","locid":"2cb8cf47-6b6b-4010-bdf6-9ec77c7deed3","name":"Sørensen, Thorkild I A","orcid":"0000-0003-4821-430X","rank":8,"rolecode":"pau"},{"affno":"","first":"Tine","key":"jesspau","last":"Jess","name":"Jess, Tine","rank":9,"rolecode":"pau"}],"pmid":["23970146"],"pub":{"doi":"10.1159/000354663","issn":["16624025","16624033"],"issn_org":["16624025"],"issue":"4","journal":"Obesity Facts","pages":"369-379","publisher":"S. Karger AG","status":"p","title":"Obesity Facts","volume":"6"},"review":"Peer Reviewed","scoID":["2-s2.0-84883151947"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-ede7ba2c-a579-4f6b-a7fc-061d4a8522db","sdu-9070bc32-be6b-4937-b8b6-f463a6045365"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"N-3 polyunsaturated fatty acids, body fat and inflammation","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-047198","year":"2013","yearsub":"2013"}
{"abstract":"The recently finalized inventory of Greenland's glaciers and ice caps (GIC) allows for the first time to determine the mass changes of the GIC separately from the ice sheet using space-borne laser altimetry data. Corrections for firn compaction and density that are based on climatic conditions are applied for the conversion from volume to mass changes. The GIC which are clearly separable from the icesheet (i.e., have a distinct ice divide or no connection) lost 27.9 ± 10.7 Gt a-1 or 0.08 ± 0.03 mm a-1 sea-level equivalent (SLE) between October 2003 and March 2008. All GIC (including those with strong but hydrologically separable connections) lost 40.9 ± 16.5 Gt a-1 (0.12 ± 0.05 mm a-1 SLE). This is a significant fraction (∼14 or 20%) of the reported overall mass loss of Greenland and up to 10% of the estimated contribution from the world's GIC to sea level rise. The loss was highest in southeastern and lowest in northern Greenland.","author_count":7,"contributors":["Bolch, T.","Sørensen, Louise Sandberg","Simonsen, Sebastian Bjerregaard","Mölg, N.","Machguth, H.","Rastner, P.","Paul, F."],"cuid":["S01-000.00-342649"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["Switzerland"],"glorg":["All Global Affiliations","University of Zurich"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"mass loss of greenland s glaciers and ice caps 000000002003 000000002008 revealed from ices at laser altimetry data","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1002/grl.50270","version":"Other Version"},"id":"S01-000.00-342649","identifier":[{"id":"84876809373","type":"scopus"}],"ids":["dtu-7f8dcfa2-bb5a-4ee5-8e5c-2530504c6b8f"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-A435F0B67FD1E462FCD768D699AD9DAC"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1002/grl.50270","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","country":"ch","key":"university of zurich","loc":["Switzerland","Europe, Non-EU","OECD"],"name":"University of Zurich","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Space Institute","Technical University of Denmark, National Space Institute, Geodynamics"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"T.","key":"bolchpau","last":"Bolch","name":"Bolch, T.","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Louise Sandberg","key":"sørensenpau","last":"Sørensen","locid":"1c6cb90f-da30-48a2-872f-a94b8100749b","name":"Sørensen, Louise Sandberg","orcid":"0000-0002-3771-4061","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Sebastian Bjerregaard","key":"simonsenpau","last":"Simonsen","locid":"d088b945-224e-4fd3-a871-022cc71c5cb1","name":"Simonsen, Sebastian Bjerregaard","orcid":"0000-0001-9569-1294","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"N.","key":"mölgpau","last":"Mölg","name":"Mölg, N.","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"H.","key":"machguthpau","last":"Machguth","name":"Machguth, H.","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"P.","key":"rastnerpau","last":"Rastner","name":"Rastner, P.","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"F.","key":"paulpau","last":"Paul","name":"Paul, F.","rank":7,"rolecode":"pau"}],"pub":{"doi":"10.1002/grl.50270","issn":["00948276","19448007"],"issn_org":["00948276"],"issue":"5","journal":"Geophysical Research Letters","pages":"875-881","publisher":"Wiley-Blackwell","status":"p","title":"Geophysical Research Letters","volume":"40"},"review":"Peer Reviewed","scoID":["2-s2.0-84876809373"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-7f8dcfa2-bb5a-4ee5-8e5c-2530504c6b8f"],"src":["DTU Technical University of Denmark"],"title":"Mass loss of Greenland's glaciers and ice caps 2003-2008 revealed from ICES at laser altimetry data","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-342649","year":"2013","yearsub":"2013"}
{"abstract":"Cospectra and quadrature spectra are calculated for six pairs of tall offshore measurement masts near the Horns Rev I wind farm in the Danish North Sea and the Nysted wind farm in the Baltic sea. The mast-pairs are separated from one another by horizontal distances of 2.13–12.4 km. Cospectra and quadrature spectra for the two sites are classified in terms of the angle between the mean wind direction and the line connecting each pair of masts. The frequency axes of the spectra are normalized to remove the effect of mean wind speed and separation distance. Results indicate a larger contribution to the quadrature spectrum for flow from the sea than for flow from the land, and the patterns in the spectra are clearer and better defined for Horns Rev I (which has a long uninterrupted sea-fetch from the west) than for Nysted (which is surrounded by a more complicated coastline). The analysis is replicated based on 3-month simulations using the weather research and forecasting (WRF) numerical model with a horizontal grid spacing of 2 km. For the sea-fetch directions, good agreement in spectral properties between the model and observations is found. Analytical expressions based on the properties of the cross-correlation function and an exponentially decaying coherence function are fitted to the normalized cospectra and quadrature spectra. The expressions are shown to be a good fit to the spectra calculated from the WRF simulations and to the observed spectra for directions with a long sea-fetch, which suggests that to a good approximation, the average cospectra and quadrature spectra over the sea can be written as functions of frequency, mean wind speed, separation distance and the angle between the wind direction and the orientation of the masts.","author_count":4,"contributors":["Vincent, Claire Louise","Larsén, Xiaoli Guo","Larsen, Søren Ejling","Sørensen, Poul Ejnar"],"cuid":["S01-000.00-381003"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Cross spectrum","Mesoscale modelling","Vindkraftmeteorologi","Wind power meteorology"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"cross spectra over the sea from observations and mesoscale modelling","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s10546-012-9754-1","version":"Other Version"},"id":"S01-000.00-381003","identifier":[{"id":"84872765306","type":"scopus"}],"ids":["dtu-ff42dc64-de2b-4fa2-bef1-1d1abc76d338"],"keyword":["Cross-spectrum","Mesoscale modelling","Vindkraftmeteorologi","Wind power meteorology","Wind-power fluctuations","Wind-speed spectrum"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-002F6284D7919BAA6298CB92AE6C7B36"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s10546-012-9754-1","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Wind Energy","Technical University of Denmark, Department of Wind Energy, Meteorology"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Claire Louise","key":"vincentpau","last":"Vincent","locid":"1b742aa9-0506-494a-8134-1c43196b8dcc","name":"Vincent, Claire Louise","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Xiaoli Guo","key":"larsénpau","last":"Larsén","locid":"b4f442ea-5cb6-4979-b106-e210895b35d8","name":"Larsén, Xiaoli Guo","orcid":"0000-0001-8696-0720","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren Ejling","key":"larsenpau","last":"Larsen","locid":"6fc30efb-9800-4fe7-ba37-bee5bf5243f3","name":"Larsen, Søren Ejling","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Poul Ejnar","key":"sørensenpau","last":"Sørensen","locid":"9c5c0469-f358-4636-b4ec-06fd7611b939","name":"Sørensen, Poul Ejnar","orcid":"0000-0001-5612-6284","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1007/s10546-012-9754-1","issn":["00068314","15731472"],"issn_org":["00068314"],"journal":"Boundary-Layer Meteorology","pages":"297-318","publisher":"Springer Netherlands","status":"p","title":"Boundary-Layer Meteorology","volume":"146"},"review":"Peer Reviewed","scoID":["2-s2.0-84872765306"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-ff42dc64-de2b-4fa2-bef1-1d1abc76d338"],"src":["DTU Technical University of Denmark"],"title":"Cross-spectra over the sea from observations and mesoscale modelling","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381003","year":"2013","yearsub":"2013"}
{"abstract":"En diskussion af det fotografiske medies centrale status i Man Rays ouevre samt dets påvirkning af hans arbejder i andre medier.","author_count":2,"contributors":["Gade, Rune"],"cuid":["S01-000.00-523813"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Det Humanistiske Fakultet","Fotografi","Kunst","Man Ray","Selvbiografi","Surrealisme"],"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"skyggernes eros man ray og fotografiet","src":["ku"],"src-code":["DI-U-KU"],"type":"dba","type-grp":["all","pub"]},"id":"S01-000.00-523813","ids":["ku-da5423c4-5172-4bd2-b4e0-a93a1bfa3d45"],"keyword":["Det Humanistiske Fakultet","Fotografi","Kunst","Man Ray","Selvbiografi","Surrealisme"],"lang":"Danish","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-B675E0A8E3F50C31F71E27FB086CADB9"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Humanities, Department of Arts and Cultural Studies"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Rune","key":"gadepau","last":"Gade","locid":"cf9d618a-5d8c-4e71-a3f0-93d2838562c2","name":"Gade, Rune","rank":1,"rolecode":"pau"},{"affno":"","first":"Louise Birch","key":"sørensenpedh","last":"Sørensen","name":"Sørensen, Louise Birch","rank":2,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["9788788499780"],"pages":"7-31","place":"Holte","publisher":"Gl. Holtegaard","status":"p","subtitle":"Lys &amp; mørke","title":"Man Ray"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Univ