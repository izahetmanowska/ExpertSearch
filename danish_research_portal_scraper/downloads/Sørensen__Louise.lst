adamsenpau","last":"Adamsen","locid":"b9cb7cb6-d18d-4aed-b6ef-9a7b51169ea4","name":"Adamsen, Anders Peter S.","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Peter","key":"kaipau","last":"Kai","locid":"7503d031-8020-4d17-ae34-c18e11bd8f15","name":"Kai, Peter","orcid":"0000-0001-5416-931X","rank":12,"rolecode":"pau"}],"pub":{"pages":"142","status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-c53438c4-2fbe-44df-bd69-68255278c5ee"],"src":["AU Aarhus University"],"title":"Faglig redegørelse og teknologiliste 2016 til brug i forbindelse med ordningen vedrørende tilskud til investeringer i nye teknologier på økologiske bedrifter","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-241913","year":"2016","yearsub":"2016"}
{"abstract":"The main objective of the ESA funded CryoVal-LI project has been to identify and quantify the error sources for the CryoSat-2 mission over land ice. This has been undertaken through the careful documentation of the possible error sources, the identification of suitable validation sites and the creation of a public database containing validation data for these areas from recent ground and airborne field campaigns. These sites also offer considerable potential as sites on which to focus future validation efforts. Through the utilization of these observational datasets, an extensive comparative analysis has been carried out in which Cryosat-2 data has been evaluated against airborne and in-situ data. A number of different Cryosat-2 data sets have been included in this analysis with the goal of testing the performance of different processing and retracking algorithms. A similar, but smaller validation analysis has also been carried out for ICESat data. Here, we present the results of these analyses and outline the conclusions reached. Based on the findings from the project, a set of recommendations for the design of future land-ice/satellite validation campaigns will be given. Furthermore, the outcome of the re-tracker inter-comparison will be used to advocate a set of optimal re-tracking algorithms for Cryosat-2 in the next generation of L2 products.","author_count":13,"contributors":["Sørensen, Louise Sandberg","Baker, Steven","Csatho, Bea","Forsberg, René","Gourmelen, Noel","Helm, Veit","Langley, Kirsty","Martinez, Bernat","Nienow, Peter","Schrama, Ernst","Shepherd, Andrew","Davidson, Malcolm","Simonsen, Sebastian Bjerregaard"],"cuid":["S01-000.00-348719"],"event":{"end":"2016-05-13","place":"Prague, cz","start":"2016-05-09","title":"ESA Living Planet Symposium 2016","year":"2016"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Europe, EU","Europe, Non-EU","Nordic","OECD"],"country":["France","Germany","Greenland","Netherlands","Spain","United Kingdom","United States"],"glorg":["ASIAQ Greenland Survey","Alfred Wegener Institute - Helmholtz Centre for Polar and Marine Research","All Global Affiliations","Delft University of Technology","European Space Agency - ESA","IsardSAT","University College London","University at Buffalo","University of Edinburgh","University of Leeds"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"cryosat land ice product validation within the cryoval li project","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://lps16.esa.int/page_session20.php#1251p","version":"Published Version"},"id":"S01-000.00-348719","ids":["dtu-93fab313-e2e1-4a00-ade3-1b0b9492f8c0"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-FF04FEBA270E19DBBA884A7892B90CA9"],"oa_link":[{"access":"oa","type":"rem","url":"http://lps16.esa.int/page_session20.php#1251p","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Space Institute","Technical University of Denmark, National Space Institute, Geodynamics"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"gb","key":"university college london","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University College London","used":1},{"affno":"3","country":"us","key":"university at buffalo","loc":["United States","America, North","OECD"],"name":"University at Buffalo","used":1},{"aff