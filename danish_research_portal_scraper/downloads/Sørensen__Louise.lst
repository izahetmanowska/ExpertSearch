nik N","key":"mullerpau","last":"Muller","name":"Muller, Dominik N","rank":13,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Henrik Thybo","key":"christesenpau","last":"Christesen","locid":"c8317e72-7a09-4c80-81e9-b69855b68e8f","name":"Christesen, Henrik Thybo","orcid":"0000-0001-5330-6853","rank":14,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Ralf","key":"dechendpau","last":"Dechend","locid":"70214e1d-4e68-4052-88ab-03e3953a24aa","name":"Dechend, Ralf","rank":15,"rolecode":"pau"}],"pmid":["25630909"],"pub":{"doi":"10.1161/jaha.114.001417","issn":["20479980"],"issue":"2","journal":"Journal of the American Heart Association","publisher":"American Heart Association","status":"p","title":"Journal of the American Heart Association","volume":"4"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-50dff13b-96f5-4a94-8e0f-c1b70dd53cb8"],"src":["SDU University of Southern Denmark"],"title":"Vitamin D depletion aggravates hypertension and target-organ damage","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-596382","year":"2015","yearsub":"2015"}
{"abstract":"Lymphoedema is a debilitating condition, manifesting in excess lymphatic fluid and swelling of subcutaneous tissues. Lymphoedema is as of yet still an incurable condition and current treatment modalities are not satisfactory. The capacity of mesenchymal stem cells to promote angiogenesis, secrete growth factors, regulate the inflammatory process, and differentiate into multiple cell types make them a potential ideal therapy for lymphoedema. Adipose tissue is the richest and most accessible source of mesenchymal stem cells and they can be harvested, isolated, and used for therapy in a single stage procedure as an autologous treatment. The aim of this paper was to review all studies using mesenchymal stem cells for lymphoedema treatment with a special focus on the potential use of adipose-derived stem cells. A systematic search was performed and five preclinical and two clinical studies were found. Different stem cell sources and lymphoedema models were used in the described studies. Most studies showed a decrease in lymphoedema and an increased lymphangiogenesis when treated with stem cells and this treatment modality has so far shown great potential. The present studies are, however, subject to bias and more preclinical studies and large-scale high quality clinical trials are needed to show if this emerging therapy can satisfy expectations.","author_count":4,"contributors":["Toyserkani, Navid Mohamadpour","Quaade, Marlene Louise","Sheikh, Søren Paludan","Sørensen, Jens Ahm"],"cuid":["S01-000.00-606599"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Adipose Tissue cytology","Adipose derived stem cells","Animals","Humans","Lymphangiogenesis","Lymphoedema","Mesenchymal Stem Cell Transplantation","Mesenchymal stem cells","Plastic surgery","Regenerative medicine"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"stem cells show promising results for lymphoedema treatment a literature review","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.3109/2000656X.2014.964726","version":"Other Version"},"id":"S01-000.00-606599","identifier":[{"id":"25272309","type":"pmid"},{"id":"84924709518","type":"scopus"}],"ids":["sdu-74b00cd7-f595-4ffd-9315-81be868bcd0b"],"keyword":["Adipose Tissue/cytology","Adipose-derived stem cells","Animals","Humans","Lymphangiogenesis","Lymphedema/surgery","Lymphoedema","Mesenchymal Stem Cell Transplantation","Mesenchymal stem cells","Plastic surgery","Regenerative medicine"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-FDDE4EEF76C6AA32090693D222E0B37C"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.3109/2000656X.2014.964726","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Plastic Surgery (Odense)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Navid Mohamadpour","key":"toyserkanipau","last":"Toyserkani","locid":"1fe54f0a-4c69-467e-8d39-62f685e36625","name":"Toyserkani, Navid Mohamadpour","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Marlene Louise","key":"quaadepau","last":"Quaade","locid":"365d389f-829a-4a48-b078-7acdfa2caeb7","name":"Quaade, Marlene Louise","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren Paludan","key":"sheikhpau","last":"Sheikh","locid":"5773a0d9-ed2e-4bd4-8232-b68ee8d6cb09","name":"Sheikh, Søren Paludan","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens Ahm","key":"sørensenpau","last":"Sørensen","locid":"267cd59a-3918-47db-8d23-54015d770b6c","name":"Sørensen, Jens Ahm","orcid":"0000-0003-4903-0094","rank":4,"rolecode":"pau"}],"pmid":["25272309"],"pub":{"doi":"10.3109/2000656x.2014.964726","issn":["11013923","2000656X"],"issn_org":["2000656X"],"issue":"2","journal":"Journal of Plastic Surgery and Hand Surgery","pages":"65-71","publisher":"Taylor & Francis","status":"p","title":"Journal of Plastic Surgery and Hand Surgery","volume":"49"},"review":"Peer Reviewed","scoID":["2-s2.0-84924709518"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-74b00cd7-f595-4ffd-9315-81be868bcd0b"],"src":["SDU University of Southern Denmark"],"title":"Stem cells show promising results for lymphoedema treatment : A literature review","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-606599","year":"2015","yearsub":"2015"}
