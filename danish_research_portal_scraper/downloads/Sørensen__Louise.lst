{"author_count":7,"contributors":["Sivesgaard, Kim","Jöhnk, Maria Louise","Larsen, Lars P","Sørensen, M.","Kramer, S.","Hansen, Flemming","Pedersen, Erik Morre"],"cuid":["S01-000.00-164868"],"event":{"end":"2015-01-23","place":"Aarhus, dk","start":"2015-01-23","title":"Ph.d.-day","year":"2015"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"whole body mri could aid in the detection of extra hepatic colorectal cancer metastases","src":["au"],"src-code":["DI-U-AU"],"type":"dco","type-grp":["all","pub"]},"id":"S01-000.00-164868","ids":["au-3e6312e8-4a99-4aa5-aa14-d237323d301e"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-E30748A4012467B2ED003441800B561B"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Radiology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Kim","key":"sivesgaardpau","last":"Sivesgaard","locid":"7336b7f0-b751-4b97-a49e-ebe7963020d3","name":"Sivesgaard, Kim","orcid":"0000-0001-6336-9890","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Maria Louise","key":"jöhnkpau","last":"Jöhnk","name":"Jöhnk, Maria Louise","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lars P.S.","key":"larsenpau","last":"Larsen","locid":"814320d4-becd-4a70-9f63-97d3285e8f08","name":"Larsen, Lars P","name_org":"Larsen, Lars P.S.","rank":3,"rolecode":"pau"},{"affno":"1","corre