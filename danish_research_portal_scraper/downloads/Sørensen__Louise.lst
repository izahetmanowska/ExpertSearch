,"src":["SDU University of Southern Denmark"],"title":"Patients' perspectives on point-of-care diagnostics and treatment by emergency medical technicians in acute COPD exacerbations : A qualitative study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-579728","year":"2022","yearsub":"2022"}
{"abstract":"This work presents a Digital Twin (DT) architecture for smart production cells tested on a case of automated drone assembly. In this Industry 4.0 setting each step of the robotic assembly sequence is carefully monitored through feedback from each hardware component being relayed to the overall smart factory, where it is located through an IoT messaging protocol. Through this case study, we illustrate how robotics-centered DTs are programmed through simple visual programming blocks, and assisted by detailed simulation, can be a powerful tool for facilitating production in smart factories.","author_count":13,"contributors":["Mathiesen, Simon","Sørensen, Lars Carøe","Sartori, Alberto","Lindvig, Anders Prier","Waspe, Ralf","Schlette, Christian"],"cuid":["S01-000.00-635040"],"event":{"acronym":"CARV","end":"2020-11-05","place":"Aalborg, dk","start":"2020-11-02","title":"8th International Conference on Changeable, Agile, Reconfigurable and Virtual Production","year":"2020"},"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"corresponding_author":["Mathiesen, Simon"],"keyword":["Collaborative robots","Digital twins","Process monitoring","Smart Factory"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"applying robotics centered digital twins in a smart factory for facilitating integration and improved process monitoring","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85119451301","version":"Other Version"},"id":"S01-000.00-635040","identifier":[{"id":"85119451301","type":"scopus"}],"ids":["sdu-d7b56e30-5482-4a1e-a857-8a6bc942260a"],"keyword":["Assembly automation","Collaborative robots","Digital twins","Process monitoring","Smart factory"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-B08F928F1CEB9745A6B6B87A8BD1959B"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Engineering, The Maersk Mc-Kinney Moller Institute","SDU, The Faculty of Engineering, The Maersk Mc-Kinney Moller Institute, SDU Robotics"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Simon Faarvang","key":"mathiesensimonpau","last":"Mathiesen","locid":"c02a4fd1-0046-43d3-856d-f7369e8aa373","name":"Mathiesen, Simon","name_org":"Mathiesen, Simon Faarvang","orcid":"0000-0002-7764-5849","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lars Carøe","key":"sørensenlarscarøepau","last":"Sørensen","locid":"c5344f74-7ae4-4d04-a050-6523f498d82a","name":"Sørensen, Lars Carøe","orcid":"0000-0003-4165-5719","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Alberto","key":"sartorialbertopau","last":"Sartori","locid":"57bd35f4-2a2e-42e0-8592-de7fce39ae11","name":"Sartori, Alberto","orcid":"0000-0002-7636-2089","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders Prier","key":"lindvigandersprierpau","last":"Lindvig","locid":"af21af9f-f946-4e85-aed7-ebe63f5058ee","name":"Lindvig, Anders Prier","orcid":"0000-0002-6972-0116","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ralf","key":"wasperalfpau","last":"Waspe","locid":"d0e79a33-818e-4ef4-aac6-5d032e346643","name":"Waspe, Ralf","orcid":"0000-0001-5206-387X","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christian","key":"schlettechristianpau","last":"Schlette","locid":"8dcbc7a3-7c6e-4b5e-96ea-f4068a4e258a","name":"Schlette, Christian","orcid":"0000-0003-1676-4374","rank":6,"rolecode":"pau"},{"affno":"","first":"Ann-Louise","key":"andersenannlouisepedh","last":"Andersen","name":"Andersen, Ann-Louise","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Rasmus","key":"andersenrasmuspedh","last":"Andersen","name":"Andersen, Rasmus","rank":8,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Thomas Ditlev","key":"brunoethomasditlevpedh","last":"Brunoe","name":"Brunoe, Thomas Ditlev","rank":9,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Maria Stoettrup Schioenning","key":"larsenmariastoettrupschioenningpedh","last":"Larsen","name":"Larsen, Maria Stoettrup Schioenning","rank":10,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Kjeld","key":"nielsenkjeldpedh","last":"Nielsen","name":"Nielsen, Kjeld","rank":11,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Alessia","key":"napoleonealessiapedh","last":"Napoleone","name":"Napoleone, Alessia","rank":12,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Stefan","key":"kjeldgaardstefanpedh","last":"Kjeldgaard","name":"Kjeldgaard, Stefan","rank":13,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-030-90700-6_34","eisbn":["9783030907006"],"isbn":["9783030906993"],"issn":["21954356"],"pages":"305-313","publisher":"Springer","series":"Lecture Notes in Mechanical Engineering","status":"p","subtitle":"Bridging Smart Products and Manufacturing Systems - Proceedings of the 8th Changeable, Agile, Reconfigurable and Virtual Production Conference CARV 2021 and 10th World Mass Customization and Personalization Conference MCPC 2021","title":"Towards Sustainable Customization"},"review":"Peer Reviewed","scoID":["2-s2.0-85119451301"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-d7b56e30-5482-4a1e-a857-8a6bc942260a"],"src":["SDU University of Southern Denmark"],"title":"Applying Robotics Centered Digital Twins in a Smart Factory for Facilitating Integration and Improved Process Monitoring","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-635040","year":"2022","yearsub":"2022"}
{"abstract":"Background: Individual differences in the rate of aging and susceptibility to disease are not accounted for by chronological age alone. These individual differences are better explained by biological age, which may be estimated by biomarker prediction models. In the light of the aging demographics of the global population and the increase in lifestyle-related morbidities, it is interesting to invent a new biological age model to be used for health promotion. Objective: This study aims to develop a model that estimates biological age based on physiological biomarkers of healthy aging. Methods: Carefully selected physiological variables from a healthy study population of 100 women and men were used as biomarkers to establish an estimate of biological age. Principal component analysis was applied to the biomarkers and the first principal component was used to define the algorithm estimating biological age. Results: The first principal component accounted for 31% in women and 25% in men of the total variance in the biological age model combining mean arterial pressure, glycated hemoglobin, waist circumference, forced expiratory volume in 1 second, maximal oxygen consumption, adiponectin, high-density lipoprotein, total cholesterol, and soluble urokinase-type plasminogen activator receptor. The correlation between the corrected biological age and chronological age was r=0.86 (P<.001) and r=0.81 (P<.001) for women and men, respectively, and the agreement was high and unbiased. No difference was found between mean chronological age and mean biological age, and the slope of the regression line was near 1 for both sexes. Conclusions: Estimating biological age from these 9 biomarkers of aging can be used to assess general health compared with the healthy aging trajectory. This may be useful to evaluate health interventions and as an aid to enhance awareness of individual health risks and behavior when deviating from this trajectory.","author_count":10,"contributors":["Husted, Karina Louise Skov","Brink-Kjær, Andreas","Fogelstrøm, Mathilde","Hulst, Pernille","Bleibach, Akita","Henneberg, Kaj-Åge","Sørensen, Helge Bjarup Dissing","Dela, Flemming","Jacobsen, Jens Christian Brings","Helge, Jørn Wulff"],"cuid":["S02-094.18-036063"],"filters":{"added":"2022-09","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Husted, Karina Louise Skov"],"keyword":["Aging","Biological age","Biomarkers","Body Mass Index","Cardiorespiratory fitness","Cardiovascular risk","Healthy aging","MEN","Model development","Mortality","Physical Fitness","Predictor","Principal component analysis","Selection","Waist Circumference"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U","DI-UC"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"],"UC":["DI-UC-ALL","DI-UC-KP"]},"level3all":["DI-U-DTU","DI-U-KU","DI-UC-KP"]},"review":"pr","rtype":["clu"],"sorti":"a model for estimating biological age from physiological biomarkers of healthy aging cross sectional study","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.2196/35696","version":"Published Version"},"funding_acknowledgement":["This work was supported by the Copenhagen Center for Health Technology, the Center for Healthy Aging, and the University College Copenhagen. The sponsors had no involvement in the study design, writing of the manuscript, or choice of publication."],"id":"S02-094.18-036063","identifier":[{"id":"PMC9131142","type":"pmcid"},{"id":"85130587047","type":"scopus"},{"id":"35536617","type":"pmid"},{"id":"000798395200021","type":"wos"}],"ids":["dtu-986a4fac-1a01-4cff-86a4-41f78c4e70cc","ku-a0a779a9-df86-4def-bec5-7b52aa5d2291"],"keyword":["Aging","BODY-MASS INDEX","Biological age","Biomarkers","CARDIORESPIRATORY FITNESS","CARDIOVASCULAR RISK","Healthy aging","IDEN