k":14,"rolecode":"pau"}],"pmid":["37465323"],"pub":{"doi":"10.1016/j.lanepe.2023.100639","issn":["26667762"],"journal":"The Lancet Regional Health - Europe","paperid":"100639","publisher":"Elsevier","status":"p","title":"The Lancet Regional Health - Europe","volume":"30"},"review":"Peer Reviewed","scoID":["2-s2.0-85153078697"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-d1ef277d-da01-4d7a-b5a8-03147158046b","ku-6a1c7f58-0a14-4592-b5ef-ebb1f6494065"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Efficacy and safety of oral roflumilast for moderate-to-severe psoriasis—a randomized controlled trial (PSORRO)","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.86-724871","year":"2023","yearsub":"2023"}
{"abstract":"Background Lectin-like oxidized low-density lipoprotein (ox-LDL) receptor-1 is a scavenger receptor for oxidized low-density lipoprotein. In adults, higher soluble lectin-like ox-LDL receptor-1 (sLOX-1) levels are associated with cardiovascular disease, type 2 diabetes, and obesity, but a similar link in pediatric overweight/obesity remains uncertain. Methods and Results Analyses were based on the cross-sectional HOLBAEK Study, including 4- to 19-year-olds from an obesity clinic group with body mass index >90th percentile (n=1815) and from a population-based group (n=2039). Fasting plasma levels of sLOX-1 and inflammatory markers were quantified, cardiometabolic risk profiles were assessed, and linear and logistic regression analyses were performed. Pubertal/postpubertal children and adolescents from the obesity clinic group exhibited higher sLOX-1 levels compared with the population (P<0.001). sLOX-1 positively associated with proinflammatory cytokines, matrix metalloproteinases, body mass index SD score, waist SD score, body fat %, plasma alanine aminotransferase, serum high-sensitivity C-reactive protein, plasma low-density lipoprotein cholesterol, triglycerides, systolic and diastolic blood pressure SD score, and inversely associated with plasma high-density lipoprotein cholesterol (all P<0.05). sLOX-1 positively associated with high alanine aminotransferase (odds ratio [OR], 1.16, P=4.1 E-04), insulin resistance (OR, 1.16, P=8.6 E-04), dyslipidemia (OR, 1.25, P=1.8 E-07), and hypertension (OR, 1.12, P=0.02). Conclusions sLOX-1 levels were elevated during and after puberty in children and adolescents with overweight/obesity compared with population-based peers and associated with inflammatory markers and worsened cardiometabolic risk profiles. sLOX-1 may serve as an early marker of cardiometabolic risk and inflammation in pediatric overweight/obesity. Registration The HOLBAEK Study, formerly known as The Danish Childhood Obesity Biobank, ClinicalTrials.gov identifier number NCT00928473, https://clinicaltrials.gov/ct2/show/NCT00928473 (registered June 2009).","author_count":19,"contributors":["Stinson, Sara E.","Jonsson, Anna E.","Andersen, Mette K.","Lund, Morten A.V.","Holm, Louise Aas","Fonvig, Cilius Esmann","Huang, Yun","Stankevič, Evelina","Juel, Helene Bæk","Ängquist, Lars","Sørensen, Thorkild I.A.","Ongstad, Emily L.","Gaddipati, Ranjitha","Grimsby, Joseph","Rhodes, Christopher J.","Pedersen, Oluf","Christiansen, Michael","Holm, Jens Christian","Hansen, Torben"],"cuid":["S02-100.00-046008"],"filters":{"added":"2023-03","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["America, North","OECD"],"corresponding_author":["Hansen, Torben"],"country":["United States"],"glorg":["All Global Affiliations","Regeneron Pharmaceuticals","Regeneron Pharmaceuticals, Inc."],"keyword":["Adolescent","Child","Obesity","Overweight","soluble lectin like oxidized low density lipoprotein receptor 1"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-OT","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-OTH","DI-HO-ZEA"],"OT":["BioPharmaceuticals R&D"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-GV-SSI","DI-HO-OTH","DI-HO-ZEA","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"high plasma levels of soluble lectin like oxidized low density lipoprotein receptor 000000000001 are associated with inflammation and cardiometabolic risk profiles in pediatric overweight and obesity","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1161/JAHA.122.027042","version":"Published Version"},"id":"S02-100.00-046008","identifier":[{"id":"36695299","type":"pmid"},{"id":"85147536246","type":"scopus"},{"id":"000950277200038","type":"wos"},{"id":"PMC9973661","type":"pmcid"}],"ids":["ku-c40a2b80-2c49-45a4-958a-03e4e08402f5","sdu-bde2744c-b99b-46bf-ada4-d59ba1fec07e"],"keyword":["adolescent","child","obesity","overweight","soluble lectin‐like oxidized low‐density lipoprotein receptor‐1"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-C8CE6EE28088B23B7B73D14A3A6C1A83"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1161/JAHA.122.027042","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/336454593/Fulltext.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/221146538/Open_Access_Version.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Novo Nordisk Foundation Center for Basic Metabolic Research, Hansen Group"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"other hospitals","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-OTH","l3nl":"Other Hospitals","l3nn":"Other Hospitals","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Hospitals","namevar":["Copenhagen University Hospital - Holbæk"],"nora_code":"DI-HO-OTH","used":1},{"affno":"3","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS - Holbæk Hospital","SDU, The Faculty of Health Sciences, De