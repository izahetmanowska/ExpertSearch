tions"],"PST":["Published"]},"sid":["nfa-272fbc38-0ab2-42d9-9bc2-2486d796806e"],"src":["NFA National Research Centre for the Working Environment"],"title":"Når chefen er en algoritme: Hvordan skaber man et godt arbejdsmiljø med ny teknologi?","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-780204","year":"2024","yearsub":"2024"}
{"abstract":"Background The human palatal rugae (folds) comprise a detailed pattern in the hard palate. They are described to be very constant during an individual’s lifetime, comparable with a fingerprint, and, importantly within a forensic setting, can serve as an important supplement in odontological identification of deceased. Aim The aim of this study was to test two methods of superimposition in correctly distinguishing between matches (from same individual) and mismatches (from different individuals) of digital scans of rugae. Methods We used an existing research database holding digital intraoral scans of 51 individuals from two points in time approximately 6 months apart. The palatal rugae area was cut manually from the digital scans without regards to teeth position. Two superimposition methods (Iterative Closest Point (ICP) and Random Sample Consensus (RANSAC)) were tested in an all-vs-all manner. Similarity was reported as fitness and inlier Root Mean Squared Error (RMSE). Results For both ICP and RANSAC none of the similarity measures were able to unambiguously distinguish between matches (rugae from same individual at two time points) and mismatches (rugae from different individuals). Conclusion The results imply that the two superimposition methods are not applicable for matching rugae scans. Further exploration of possible methods to distinguish between matches and mismatches are needed to fully exploit the great potential within forensic odontology identification of these digital palatal 3D ‘fingerprints’.","author_count":4,"contributors":["Kofod Petersen, Anika","Bindslev, Dorthe Arenholt","Villesen, Palle","Staun Larsen, Line"],"cuid":["S01-000.00-787535"],"event":{"end":"2024-11-09","place":"Aarhus, dk","start":"2024-11-08","title":"Dansk Selskab for Retsmedicins Årskursus 2024","year":"2024"},"filters":{"added":"2025-02","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Identifikation"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"palatinale rugae til human identifikation test af to metoder til superimposition af 000000000003d digitale skanninger","src":["au"],"src-code":["DI-U-AU"],"type":"dco","type-grp":["all","pub"]},"id":"S01-000.00-787535","ids":["au-8a94a70b-25a6-4d21-8b14-865387023cb4"],"keyword":["3D skanninger","Identifikation","rugae"],"lang":"Danish","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-FA35DE1D83A7E2AD595332BCCE3DF6AB"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Forensic Medicine"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Anika","key":"kofodpetersenpau","last":"Kofod Petersen","locid":"66df1431-908c-44b2-a391-2215ee5b7377","name":"Kofod Petersen, Anika","orcid":"0000-0001-5913-8723","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Dorthe Arenholt","key":"bindslevpau","last":"Bindslev","locid":"a95ac976-ed75-421f-a895-8fc5ec9c62c0","name":"Bindslev, Dorthe Arenholt","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Palle","key":"villesenpau","last":"Villesen","locid":"c1c4bd28-befd-4150-bbbb-10138e528d53","name":"Villesen, Palle","orcid":"0000-0001-7589-8781","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Line","key":"staunlarsenpau","last":"Staun Larsen","locid":"35e2ae60-25db-4a15-893f-dc8906e2bccf","name":"Staun Larsen, Line","orcid":"0000-0002-4155-5884","rank":4,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-8a94a70b-25a6-4d21-8b14-865387023cb4"],"src":["AU Aarhus University"],"title":"Palatinale rugae til human identifikation: : test af to metoder til superimposition af 3D digitale skanninger","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-787535","year":"2024","yearsub":"2024"}
