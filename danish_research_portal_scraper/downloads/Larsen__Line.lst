sity","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-c84fec5c-3124-404a-b733-f24213610f5c"],"src":["KU University of Copenhagen"],"title":"A randomized controlled trial of the effect of supervised progressive cross-continuum strength training and protein supplementation in older medical patients : the STAND-Cph trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-513024","year":"2019","yearsub":"2019"}
{"abstract":"Aim: To investigate the patient experience of pain management, when patient-controlled oral analgesia was compared with standard care for patients admitted to hospital with acute abdominal pain. The primary outcome measures were pain intensity and patient perception of care. Background: Pain management of patients admitted to hospital with acute abdominal pain can be insufficient. Patient involvement in health care has been seen to have benefits for patients. Methods: A before-and-after intervention study was conducted in an emergency department observation unit and a surgical department. Data were collected from a questionnaire (APS-POQ-R-D) with the six subscales: pain severity, perception of care, interference with activity, interference with emotions, side effects and patient-related barriers. Results: A total of 156 patients were included. During admission the median score (0–10 scale) for the pain intensity and patient perception of care subscale was 4 (p = 0.96) and 8 (p = 0.92), respectively, in both the control and intervention group. On the activity subscale, the median scores were 6 and 5 (p = 0.17); on the emotion subscale, the scores were 5 and 4 (p = 0.31); and on the side effect subscale, the scores were 3 and 4 (p = 0.18) in the control and intervention group, respectively. Overall, the score was 5–8 at one item about being allowed to participate in decisions about pain treatment as much as wanted. Conclusion: Patient-controlled oral analgesia did not improve patient experience of pain management for patients admitted to hospital with acute abdominal pain.","author_count":8,"contributors":["Schultz, Helen","Abrahamsen, Line","Rekvad, Lise Ewald","Skræp, Ulla","Schultz Larsen, Tanja","Möller, Sören","Tecedor, Ulla Krogstrup","Qvist, Niels"],"cuid":["S01-000.00-581193"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Schultz, Helen"],"keyword":["Acute pain","Pain Management","Patient Centered Care","Patient involvement","Self administered medication"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"patient controlled oral analgesia at acute abdominal pain a before and after intervention study of pain management during hospital stay","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/178639947/Patient_controlled_oral_analgesia_at_acute_abdominal_pain_A_before_and_after_intervention_study_of_pain_management_during_hospital_stay.pdf","version":"Authors Final Version"},"funding_acknowledgement":["The authors would like to acknowledge funding from the Surgical Department, Odense University Hospital , University of Southern Denmark and Novo Nordisk Foundation ( 13575 )."],"id":"S01-000.00-581193","identifier":[{"id":"85061675025","type":"scopus"},{"id":"30853075","type":"pmid"}],"ids":["sdu-1bd84161-4a33-41fb-8b82-ca91aa6e5327"],"keyword":["Acute pain","Pain management","Patient involvement","Patient-centered care","Revised American Pain Society Patient Outcome Questionnaire, APS-POQ-R","Self-administered medication"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-13F2D4C7DE2366166F8594CA478175FD"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/178639947/Patient_controlled_oral_analgesia_at_acute_abdominal_pain_A_before_and_after_intervention_study_of_pain_management_during_hospital_stay.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research Unit OPEN (Odense)","SDU, The Faculty of Health Sciences, Department of Clinical Research, Surgery"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Helen","key":"schultzpau","last":"Schultz","locid":"dfb1d2c7-3f78-4860-a7f9-09e7770baaf3","name":"Schultz, Helen","orcid":"0000-0003-4815-6349","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Line","key":"abrahamsenpau","last":"Abrahamsen","locid":"1f68928b-5cc4-4dfd-8785-62e5d4bee6c0","name":"Abrahamsen, Line","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lise Ewald","key":"rekvadpau","last":"Rekvad","locid":"3e076e0e-cf3f-4bef-848d-d205a7a3218b","name":"Rekvad, Lise Ewald","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ulla","key":"skræppau","last":"Skræp","locid":"b46f2fa5-6559-4b4e-a447-72a53968c4a4","name":"Skræp, Ulla","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Tanja","key":"schultzlarsenpau","last":"Schultz Larsen","locid":"448e963b-288c-4c0f-a47f-5d0ce63f198a","name":"Schultz Larsen, Tanja","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Sören","key":"möllerpau","last":"Möller","locid":"905018dc-c6c4-4a79-b50d-d0c08618e77a","name":"Möller, Sören","orcid":"0000-0003-0858-4269","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ulla Krogstrup","key":"tecedorpau","last":"Tecedor","locid":"90a3d8bf-a08d-46a1-ace3-481a222428b2","name":"Tecedor, Ulla Krogstrup","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Niels","key":"qvistpau","last":"Qvist","locid":"1e82ad79-62c0-4d35-bb84-5d027f77dedd","name":"Qvist, Niels","orcid":"0000-0002-1113-195X","rank":8,"rolecode":"pau"}],"pmid":["30853075"],"pub":{"doi":"10.1016/j.apnr.2019.02.006","issn":["08971897","15328201"],"issn_org":["08971897"],"journal":"Applied Nursing Research","pages":"43-49","publisher":"WB  Saunders","publisher_org":"W.B. Saunders","status":"p","title":"Applied Nursing Research","volume":"46"},"review":"Peer Reviewed","scoID":["2-s2.0-85061675025"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-1bd84161-4a33-41fb-8b82-ca91aa6e5327"],"src":["SDU University of Southern Denmark"],"title":"Patient-controlled oral analgesia at acute abdominal pain : A before-and-after intervention study of pain management during hospital stay","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-581193","year":"2019","yearsub":"2019"}
{"abstract":"Aims/hypothesis: Adopting a diet containing indigestible fibre compounds such as prebiotics to fuel advantageous bacteria has proven beneficial for alleviating inflammation. The effect of the microbial changes on autoimmunity, however, remains unknown. We studied the effects of prebiotic xylooligosaccharides (XOS) on pancreatic islet and salivary gland inflammation in NOD mice and tested whether these were mediated by the gut microbiota. Methods: Mother and offspring mice were fed an XOS-supplemented diet until diabetes onset or weaning and were compared with a control-fed group. Diabetes incidence was monitored, insulitis and sialadenitis were scored in histological sections from adult mice, and several metabolic and immune variables were analysed in mice before the development of diabetes. Gut barrier function was assessed using an in vivo FITC-dextran permeability test. The importance of XOS-mediated gut microbial changes were evaluated in antibiotic-treated mice fed either XOS or control diet or given a faecal microbiota transplant from test animals. Results: Diabetes onset was delayed in the XOS-fed mice, which also had fewer cellular infiltrations in their pancreatic islets and salivary glands. Interestingly, insulitis was most reduced in the XOS-fed groups when the mice were also treated with an antibiotic cocktail. There was no difference in sialadenitis between the dietary groups treated with antibiotics; the mice were protected by microbiota depletion regardless of diet. Faecal microbiota transplantation was not able to transfer protection. No major differences in glucose–insulin regulation, glucagon-like peptide-1, or short-chain fatty acid production were related to the XOS diet. The XOS diet did, however, reduce gut permeability markers in the small and large intestine. This was accompanied by a more anti-inflammatory environment locally and systemically, dominated by a shift from M1 to M2 macrophages, a higher abundance of activated regulatory T cells, and lower levels of induction of natural killer T cells and cytotoxic T cells. Conclusions/interpretation: Prebiotic XOS have microbiota-dependent effects on salivary gland inflammation and microbiota-independent effects on pancreatic islet pathology that are accompanied by an improved gut barrier that seems able to heighten control of intestinal diabetogenic antigens that have the potential to penetrate the mucosa to activate autoreactive immune responses.","author_count":10,"contributors":["Hansen, Camilla H.F.","Larsen, Christian S.","Petersson, Henriette O.","Zachariassen, Line F.","Vegge, Andreas","Lauridsen, Charlotte","Kot, Witold","Krych, Łukasz","Nielsen, Dennis S.","Hansen, Axel K."],"cuid":["S02-099.95-023011"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Hansen, Camilla H.F."],"keyword":["Gut barrier","Gut microbiota","Insulitis","Mucosal immunology","Prebiotics","Sialadenitis","XOS"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-NOVO"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-PR-NOVO","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"targeting gut microbiota and barrier function with prebiotics to alleviate autoimmune manifestations in nod mice","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s00125-019-4910-5","version":"Published Version"},"id":"S02-099.95-023011","identifier":[{"id":"31139852","type":"pmid"},{"id":"85066480992","type":"scopus"},{"id":"000478770300017","type":"wos"}],"ids":["au-8df5e86c-63ac-497d-9900-89e812ace4db","ku-e102d820-f4d2-45c7-88e3-e8d5d0a81b07"],"keyword":["Gut barrier","Gut microbiota","Insulitis","Mucosal immunology","Prebiotics","Sialadenitis","XOS"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-12BFE42294B20B6D3220CA02C4F4046C"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s00125-019-4910-5","version":"Published Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Veterinary and Animal Sciences, Preclinical Disease Biology"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"novo nordisk","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-NOVO","l3nl":"Novo Nordisk","l3nn":"Novo Nordisk","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Novo Nordisk","namevar":["Novo Nordisk A/S"],"nora_code":"DI-PR-NOVO","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Animal and Veterinary Sciences, Department of Animal and Veterinary Sciences - ANIS Health"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","first":"Camilla H. F.","key":"hansencamillahartmannfriispau","last":"Hansen","locid":"d7f25dbd-3efc-483b-9805-8909e9597652","name":"Hansen, Camilla Hartmann Friis","name_org":"Hansen, Camilla H. F.","orcid":"0000-0002-1860-385X","rank":1,"rolecode":"pau"},{"affno":"1","first":"Christian S.","key":"larsenchristianschiøthpau","last":"Larsen","locid":"48a39b03-cb85-4871-ad38-cb43987be59c","name":"Larsen, Christian Schiøth","name_org":"Larsen, Christian S.","rank":2,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Henriette O.","key":"peterssonhenrietteopau","last":"Petersson","locid":"e1e735ec-6168-4711-9b51-ddc0cb0d8278","name":"Petersson, Henriette O.","rank":3,"rolecode":"pau"},{"affno":"1","first":"Line F.","key":"zachariassenlinefpau","last":"Zachariassen","locid":"cdafe75d-cfc9-4fca-adfe-20ae0c542b57","name":"Zachariassen, Line F.","orcid":"0000-0001-5425-9841","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Andreas","key":"veggeandreaspau","last":"Vegge","name":"Vegge, Andreas","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Charlotte","key":"lauridsencharlottepau","last":"Lauridsen","locid":"892b1da6-ebd2-456b-b88e-0d709e529b1c","name":"Lauridsen, Charlotte","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Witold","key":"kotwitoldpau","last":"Kot","locid":"1ed8825e-1c59-4e9b-bcd7-974d5f6d8f01","name":"Kot, Witold","rank":7,"rolecode":"pau"},{"affno":"1","first":"Lukasz","key":"krychlukaszpau","last":"Krych","locid":"a9463259-048d-4fd6-8218-dde9fb94c96b","name":"Krych, Lukasz","orcid":"0000-0003-3224-1346","rank":8,"rolecode":"pau"},{"affno":"1","first":"Dennis S.","key":"nielsendennissandrispau","last":"Nielsen","locid":"08539a0e-05f4-454e-ad2a-de195363dbd1","name":"Nielsen, Dennis Sandris","name_org":"Nielsen, Dennis S.","orcid":"0000-0001-8121-1114","rank":9,"rolecode":"pau"},{"affno":"1","first":"Axel K.","key":"hansenaxelkorneruppau","last":"Hansen","locid":"ecc439ea-5c9b-4e25-814a-3ee8960bc0d0","name":"Hansen, Axel Kornerup","name_org":"Hansen, Axel K.","orcid":"0000-0003-1575-2507","rank":10,"rolecode":"pau"}],"pmid":["31139852"],"pub":{"doi":"10.1007/s00125-019-4910-5","issn":["0012186X","14320428"],"issn_org":["0012186X"],"issue":"9","journal":"Diabetologia","pages":"1689-1700","publisher":"Springer Science and Business Media Deutschland GmbH","status":"p","title":"Diabetologia","volume":"62"},"review":"Peer Reviewed","scoID":["2-s2.0-85066480992"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Novo Nordisk","Private Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-8df5e86c-63ac-497d-9900-89e812ace4db","ku-e102d820-f4d2-45c7-88e3-e8d5d0a81b07"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Targeting gut microbiota and barrier function with prebiotics to alleviate autoimmune manifestations in NOD mice","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.95-023011","year":"2019","yearsub":"2019"}
{"abstract":"Purpose: Diagnostic delay is a major problem concerning common variable immunodeficiency (CVID). We aimed to determine the pattern of general practitioner (GP) consultations in individuals diagnosed with CVID within 3 years before the diagnosis and whether the risk of diagnosis was associated with the frequency of consultations or character of examinations. Methods: We conducted a nested case-control study, identifying 132 adult CVID patients and 5940 age- and gender-matched controls from national registers during 1997–2013. We used conditional logistic regression to calculate the odds ratios (OR) and 95% confidence intervals (95%CI). Results: The median number of consultations among individuals with CVID was more than twice that of the controls in all 3 years (3rd, 10; 2nd, 11.5; and 1st, 15.4 vs. 4). We found a statistically significant association between the number of consultations and the risk of a subsequent CVID diagnosis, independent of age and gender, but strongest in the individuals < 40 years. In the 3rd year before diagnosis, having 9–15 consultations compared with 1–4 was associated with an OR (95%CI) of 5.0 (2.3–10.9), 2.4 (1.1–5.4), and 1.3 (0.3–5.3) for those aged 18–40, 41–60, and > 60, respectively. Several examinations (i.e., blood tests for inflammation/infection and pulmonary function test) were associated with increased odds of a subsequent CVID diagnosis. Conclusion: The risk of a CVID diagnosis was highly related to both the number of consultations and the character of examinations performed by the GP. CVID should be a differential diagnosis among patients with multiple consultations, especially in patients < 40 years old.","author_count":9,"contributors":["Ilkjær, Frederik V.","Rasmussen, Line D.","Martin-Iguacel, Raquel","Westh, Lena","Katzenstein, Terese L.","Hansen, Ann Brit E.","Nielsen, Thyge L.","Larsen, Carsten Schade","Johansen, Isik S."],"cuid":["S03-100.00-019665"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":3,"corresponding_author":["Ilkjær, Frederik V.","Ilkjær, Frederik Veitland"],"keyword":["CVID","Consultations","Diagnostic delay","Indicators","PID","Primary Health Care"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR"],"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"how to identify common variable immunodeficiency patients earlier general practice patterns","src":["au","ku","sdu"],"src-code":["DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85070107086","version":"Other Version"},"funding_acknowledgement":["FI received funding from the University of Southern Denmark as salary for 6 months. The study was mainly funded by the Department of Infectious Diseases at Odense University Hospital and in part funded by an independent grant from Odense University Hospital. TK has served as a lecturer and attended conferences sponsored by Baxter, Baxalta, Shire , and CSL Behring. CL has served as a lecturer and attended conferences sponsored by Shire, CSL Behring, and Octapharma. AH has received an unrestricted research grant from CSL Behring. All other authors declare that they have no conflict of interest."],"id":"S03-100.00-019665","identifier":[{"id":"85070107086","type":"scopus"},{"id":"31372799","type":"pmid"}],"ids":["au-6062907b-f158-4769-a18c-dea77c1198ff","ku-7113fadb-073a-4c5a-ad2a-10123d0d243b","sdu-6bb5761c-9780-45d1-9056-7f488ae35f9c"],"keyword":["CVID","PID","consultations","diagnostic delay","indicators","primary health care"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-AF148