5f7-99e5-55a77e030d6d","name":"Pittelkow, Michael","orcid":"0000-0002-3371-9500","rank":5,"rolecode":"pau"}],"pmid":["29568444"],"pub":{"doi":"10.1039/c7sc03366d","issn":["20416520","20416539"],"issn_org":["20416520"],"issue":"12","journal":"Chemical Science","pages":"7978-7982","publisher":"Royal Society of Chemistry","status":"p","title":"Chemical Science","volume":"8"},"review":"Peer Reviewed","scoID":["2-s2.0-85034828020"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-687507ed-a96b-4e6c-99f6-914c90bd3a5c","ku-034eb4eb-e81b-4bc9-b99f-235e7279dd05"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Thiosemicarbazone organocatalysis : Tetrahydropyranylation and 2-deoxygalactosylation reactions and kinetics-based mechanistic investigation","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-097.80-034991","year":"2017","yearsub":"2017"}
{"abstract":"Laccases (EC 1.10.3.2) catalyse removal of an electron and a proton from phenolic hydroxyl groups, including phenolic hydroxyls in lignins, to form phenoxy radicals during reduction of O2. We employed electron paramagnetic resonance spectroscopy (EPR) for real time measurement of such catalytic radical formation activity on three types of lignin (two types of organosolv lignin, and a lignin rich residue from wheat straw hydrolysis) brought about by two different fungal laccases, derived from Trametes versicolor (Tv) and Myceliophthora thermophila (Mt), respectively. Laccase addition to suspensions of the individual lignin samples produced immediate time and enzyme dose dependent increases in intensity in the EPR signal with g-values in the range 2.0047–2.0050 allowing a direct quantitative monitoring of the radical formation and thus allowed laccase enzyme kinetics assessment on lignin. The experimental data verified that the laccases acted upon the insoluble lignin substrates in the suspensions. When the action on the lignin substrates of the two laccases were compared on equal enzyme dosage levels (by activity units on syringaldazine) the Mt laccase exerted a significantly faster radical formation than the Tv laccase on all three types of lignin substrates. When comparing the equal laccase dose rates on the three lignin substrates the enzymatic radical formation rate on the wheat straw lignin residue was consistently higher than those of the organosolv lignins. The pH-temperature optimum for the radical formation rate in organosolv lignin was determined by response surface methodology to pH 4.8, 33 °C and pH 5.8, 33 °C for the Tv laccase and the Mt laccase, respectively. The results verify direct radical formation action of fungal laccases on lignin without addition of mediators and the EPR methodology provides a new type of enzyme assay of laccases on lignin.","author_count":3,"contributors":["Munk, Line","Andersen, Mogens Larsen","Meyer, Anne S."],"cuid":["S02-100.00-036700"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"corresponding_author":["Meyer, Anne S."],"keyword":["Dose response treatment","EPR","Laccase kinetics","Phenoxy radicals in lignin","Real time assay"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"direct rate assessment of laccase catalysed radical formation in lignin by electron paramagnetic resonance spectroscopy","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/201610999/Direct_rate_assessment_of_laccase_catalysed_radical_formation_in_lignin_by_electron_paramagnetic_resonance_spectroscopy_2017_accepted.pdf","version":"Authors Final Version"},"id":"S02-100.00-036700","identifier":[{"id":"85025456536","type":"scopus"},{"id":"28859815","type":"pmid"}],"ids":["dtu-b4fc6af6-b511-4da8-978f-28bfb7b7ed09","ku-6d7956ed-9400-4a32-bb90-309167b47bbb"],"keyword":["Dose-response treatment","EPR","Laccase kinetics","Phenoxy radicals in lignin","Real time assay"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-28D07F050FCA4C43CA2E0BE624954A49"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/134438797/MARAC_1_s2.0_S0141022917301333_main.pdf","version":"Authors Final Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/201610999/Direct_rate_assessment_of_laccase_catalysed_radical_formation_in_lignin_by_electron_paramagnetic_resonance_spectroscopy_2017_accepted.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Chemical and Biochemical Engineering","Technical University of Denmark, Department of Chemical and Biochemical Engineering, Center for BioProcess Engineering"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Food Science, Ingredient and Dairy Technology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Line","key":"munkpau","last":"Munk","locid":"9378dbfe-4f2f-4c72-9501-ada5d67f2ce3","name":"Munk, Line","orcid":"0000-0002-4820-5000","rank":1,"rolecode":"pau"},{"affno":"2","first":"Mogens Larsen","key":"andersenpau","last":"Andersen","locid":"cb1b131f-69dc-46eb-bb7a-5d0161d84ab5","name":"Andersen, Mogens Larsen","orcid":"0000-0003-4694-486X","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anne S.","key":"meyerpau","last":"Meyer","locid":"1e9f4759-72d8-4d52-94ec-ce192ffca184","name":"Meyer, Anne S.","orcid":"0000-0001-8910-9931","rank":3,"rolecode":"pau"}],"pmid":["28859815"],"pub":{"doi":"10.1016/j.enzmictec.2017.07.006","issn":["01410229","18790909"],"issn_org":["01410229"],"journal":"Enzyme and Microbial Technology","pages":"88-96","publisher":"Elsevier","status":"p","title":"Enzyme and Microbial Technology","volume":"106"},"review":"Peer Reviewed","scoID":["2-s2.0-85025456536"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-b4fc6af6-b511-4da8-978f-28bfb7b7ed09","ku-6d7956ed-9400-4a32-bb90-309167b47bbb"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Direct rate assessment of laccase catalysed radical formation in lignin by electron paramagnetic resonance spectroscopy","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-036700","year":"2017","yearsub":"2017"}
{"abstract":"OBJECTIVE: To examine the role of mutations in GABRB3 encoding the β3 subunit of the GABAA receptor in individual patients with epilepsy with regard to causality, the spectrum of genetic variants, their pathophysiology, and associated phenotypes. METHODS: We performed massive parallel sequencing of GABRB3 in 416 patients with a range of epileptic encephalopathies and childhood-onset epilepsies and recruited additional patients with epilepsy with GABRB3 mutations from other research and diagnostic programs. RESULTS: We identified 22 patients with heterozygous mutations in GABRB3, including 3 probands from multiplex families. The phenotypic spectrum of the mutation carriers ranged from simple febrile seizures, genetic epilepsies with febrile seizures plus, and epilepsy with myoclonic-atonic seizures to West syndrome and other types of severe, early-onset epileptic encephalopathies. Electrophysiologic analysis of 7 mutations in Xenopus laevis oocytes, using coexpression of wild-type or mutant β3, together with α5 and γ2s subunits and an automated 2-microelectrode voltage-clamp system, revealed reduced GABA-induced current amplitudes or GABA sensitivity for 5 of 7 mutations. CONCLUSIONS: Our results indicate that GABRB3 mutations are associated with a broad phenotypic spectrum of epilepsies and that reduced receptor function causing GABAergic disinhibition represents the relevant disease mechanism.","author_count":43,"contributors":["Møller, Rikke S","Wuttke, Thomas V","Helbig, Ingo","Marini, Carla","Johannesen, Katrine M","Brilstra, Eva H","Vaher, Ulvi","Borggraefe, Ingo","Talvik, Inga","Talvik, Tiina","Kluger, Gerhard","Francois, Laurence L","Lesca, Gaetan","de Bellescize, Julitta","Blichfeldt, Susanne","Chatron, Nicolas","Holert, Nils","Jacobs, Julia","Swinkels, Marielle","Betzler, Cornelia","Syrbe, Steffen","Nikanorova, Marina","Myers, Candace T","Larsen, Line H G","Vejzovic, Sabina","Pendziwiat, Manuela","von Spiczak, Sarah","Hopkins, Sarah","Dubbs, Holly","Mang, Yuan","Mukhin, Konstantin","Holthausen, Hans","van Gassen, Koen L","Dahl, Hans A","Tommerup, Niels","Mefford, Heather C","Rubboli, Guido","Guerrini, Renzo","Lemke, Johannes R","Lerche, Holger","Muhle, Hiltrud","Maljevic, Snezana"],"cuid":["S02-100.00-041569"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"keyword":["Animals","Automation Laboratory","Child","Child Preschool","Cohort Studies","Epilepsy","Female","Heterozygote","High Throughput Nucleotide Sequencing","Humans","Infant","Infant Newborn","Journal Article","Male","Membrane Potentials","Mutation","Oocytes","Patch Clamp Techniques","Phenotype","Receptors GABA A","Xenopus laevis"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-PR","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-FILA"],"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-FILA","DI-PR-OTH","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"mutations in gabrb000000000003 from febrile seizures to epileptic encephalopathies","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC5278942/pdf/NEUROLOGY2016743625.pdf","version":"Published Version"},"id":"S02-100.00-041569","identifier":[{"id":"PMC5278942","type":"pmcid"},{"id":"28053010","type":"pmid"},{"id":"85011263968","type":"scopus"}],"ids":["ku-39c7c371-bf42-48f5-ad48-c3fc2be120e9","sdu-2869c77a-378c-4aeb-b9f6-3a47a0d85491"],"keyword":["Animals","Automation, Laboratory","Child","Child, Preschool","Cohort Studies","Epilepsy","Female","Heterozygote","High-Throughput Nucleotide Sequencing","Humans","Infant","Infant, Newborn","Journal Article","Male","Membrane Potentials","Mutation","Oocytes","Patch-Clamp Techniques","Phenotype","Receptors, GABA-A","Xenop