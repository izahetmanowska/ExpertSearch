ity of Copenhagen","namevar":["IT University of Copenhagen"],"nora_code":"DI-U-ITU","used":1},{"affno":6,"key":"dansk center for museumsforskning","name":"Dansk Center for Museumsforskning","role":"oau"},{"affno":7,"key":"danish centre for museum research","name":"Danish Centre for Museum Research","role":"oau"}],"person":[{"affno":"1","corresponding":null,"first":"Hans Dam","key":"christensenpau","last":"Christensen","name":"Christensen, Hans Dam","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kristian","key":"handbergpau","last":"Handberg","name":"Handberg, Kristian","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jens F.","key":"jensenpau","last":"Jensen","name":"Jensen, Jens F.","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Line Vestergaard","key":"knudsenpau","last":"Knudsen","name":"Knudsen, Line Vestergaard","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Ane Hejlskov","key":"larsenpau","last":"Larsen","locid":"537945d6-e2ef-4d5c-9639-230e8ec1bc40","name":"Larsen, Ane Hejlskov","orcid":"0000-0001-7441-1054","rank":5,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Christian Hviid","key":"mortensenpau","last":"Mortensen","locid":"3cdf6e8d-ed45-4136-84fd-408f346ba53c","name":"Mortensen, Christian Hviid","orcid":"0000-0001-9822-1714","rank":6,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Anne Scott","key":"sørensenpau","last":"Sørensen","locid":"b3025811-2549-4a29-ae4a-d26664b9165c","name":"Sørensen, Anne Scott","orcid":"0000-0003-0655-5093","rank":7,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Vitus","key":"vestergaardpau","last":"Vestergaard","locid":"d0e06d4b-d837-4da6-a158-a5e689b4d63c","name":"Vestergaard, Vitus","orcid":"0000-0003-0447-6711","rank":8,"rolecode":"pau"},{"affno":"3 5","corresponding":null,"country":"dk","first":"Mia Falch","key":"yatespau","last":"Yates","locid":"40440461-a88d-4732-bc69-522df82b473e","name":"Yates, Mia Falch","orcid":"0000-0002-2855-4422","rank":9,"rolecode":"pau"}],"pub":{"issn":["25969714"],"newspaper":"Kulturmonitor","publisher":"JP/Politikens Hus","status":"p","title":"Kulturmonitor"},"review":"Undetermined","search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-1355b96c-5dbf-4451-89bf-35f1658128ed","au-17202fc4-fbca-4626-b2ad-d50022030dae","sdu-5c7ee73b-b7a4-4938-96b5-b3551a35dc01"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"Center for dansk museumsforskning : forskningsbegrebet står alt for svagt i museumsreformrapporten","type":"Newspaper Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-084.09-724476","year":"2024","yearsub":"2024"}
{"abstract":"The white-beaked dolphin (Lagenorhynchus albirostris) is the second most frequently stranded cetacean species along the Danish coastline. The northern North Sea, the Skagerrak, the Kattegat and the Danish straits are part of the species distributional range. Here, we present eight incidents of breeding activity for the white-beaked dolphin in the inner Danish waters, reviewed from yearly reports made by the National Contingency Plan concerning strandings of marine mammals in Denmark from 2009 to 2023, Danish Wildlife Diseases Surveillance reports from 2014 to 2023 and the citizen science database Naturbasen in the period 2002 to 2023. Three pregnant females, three lactating females and one calf were found stranded in the inner Danish waters. Besides this, there have been live sightings of a female with a newborn calf. We conclude that the white-beaked dolphin is breeding in the inner Danish waters.","author_count":12,"contributors":["Alstrup, Aage Kristian Olsen","Kinze, Carl Chr.","Kristensen, Natacha Mia","Jensen, Trine Hammer","Thøstesen, Charlotte Bie","Larsen, Hanne Lyngholm","Ankersen Sønnichsen, Karen","Kyhn, Line Anker","Holm, Thomas Eske","Sigsgaard, Jens Jørgen","Pagh, Sussie"],"cuid":["S03-098.83-822389"],"filters":{"added":"2024-02","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corresponding_author":["Alstrup, Aage Kristian Olsen"],"keyword":["Cetacean","Danish waters","Delphinidae","Odontoceti","Reproduction","Strandings"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Department for Clinical Medicine"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"further evidence for breeding white beaked dolphin lagenorhynchus albirostris in inner danish waters","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.3390/coasts4020013","version":"Published Version"},"id":"S03-098.83-822389","identifier":[{"id":"105011938154","type":"scopus"}],"ids":["aau-919dcc03-a4b8-4df7-98f1-47a338557254","aau-cf67d3b6-690c-4fa4-970c-91a15c55dfc7","au-8b99d4ba-67b4-4b21-b05e-8f808c26c0f3"],"keyword":["Danish waters","Delphinidae","Odontoceti","cetacean","reproduction","strandings"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-6-3A3E6F04A188E7AFF1CD81FAF13F59AE"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/763534795/coasts-04-00013.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.3390/coasts4020013","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Nuclear Medicine"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience"],"nora_code":"DI-U-AAU","used":1},{"affno":"3","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Department for Clinical Medicine"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1 2 3","corresponding":null,"country":"dk","first":"Aage Kristian Olse