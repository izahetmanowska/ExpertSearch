38,"rolecode":"pau"},{"affno":"","first":"Johannes R","key":"lemkejohannesrpau","last":"Lemke","name":"Lemke, Johannes R","rank":39,"rolecode":"pau"},{"affno":"","first":"Holger","key":"lercheholgerpau","last":"Lerche","name":"Lerche, Holger","rank":40,"rolecode":"pau"},{"affno":"","first":"Hiltrud","key":"muhlehiltrudpau","last":"Muhle","name":"Muhle, Hiltrud","rank":41,"rolecode":"pau"},{"affno":"","first":"Snezana","key":"maljevicsnezanapau","last":"Maljevic","name":"Maljevic, Snezana","rank":42,"rolecode":"pau"}],"pmid":["28053010"],"pub":{"doi":"10.1212/wnl.0000000000003565","issn":["00283878","1526632X"],"issn_org":["00283878"],"issue":"5","journal":"Neurology","pages":"483-492","publisher":"Lippincott Williams and Wilkins","status":"p","title":"Neurology","volume":"88"},"review":"Peer Reviewed","scoID":["2-s2.0-85011263968"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Private Research","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Hospitals","Other Companies","Private Research","Universities","University of Copenhagen","University of Southern Denmark","amplexa genetics a/s"],"PST":["Published"]},"sid":["ku-39c7c371-bf42-48f5-ad48-c3fc2be120e9","sdu-2869c77a-378c-4aeb-b9f6-3a47a0d85491"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Mutations in GABRB3 : From febrile seizures to epileptic encephalopathies","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-041569","year":"2017","yearsub":"2017"}
{"abstract":"Observational studies on smoking and risk of hay fever and asthma have shown inconsistent results. However, observational studies may be biased by confounding and reverse causation. Mendelian randomization uses genetic variants as markers of exposures to examine causal effects. We examined the causal effect of smoking on hay fever and asthma by using the smoking-associated single nucleotide polymorphism (SNP) rs16969968/rs1051730. We included 231,020 participants from 22 population-based studies. Observational analyses showed that current vs never smokers had lower risk of hay fever (odds ratio (OR) = 0·68, 95% confidence interval (CI): 0·61, 0·76; P < 0·001) and allergic sensitization (OR = 0·74, 95% CI: 0·64, 0·86; P < 0·001), but similar asthma risk (OR = 1·00, 95% CI: 0·91, 1·09; P = 0·967). Mendelian randomization analyses in current smokers showed a slightly lower risk of hay fever (OR = 0·958, 95% CI: 0·920, 0·998; P = 0·041), a lower risk of allergic sensitization (OR = 0·92, 95% CI: 0·84, 1·02; P = 0·117), but higher risk of asthma (OR = 1·06, 95% CI: 1·01, 1·11; P = 0·020) per smoking-increasing allele. Our results suggest that smoking may be causally related to a higher risk of asthma and a slightly lower risk of hay fever. However, the adverse events associated with smoking limit its clinical significance.","author_count":54,"contributors":["Skaaby, Tea","Taylor, Amy E","Jacobsen, Rikke K.","Paternoster, Lavinia","Thuesen, Betina Heinsbaek","Ahluwalia, Tarunveer S.","Larsen, Sofus C","Zhou, Ang","Wong, Andrew","Gabrielsen, Maiken E","Bjørngaard, Johan H","Flexeder, Claudia","Männistö, Satu","Hardy, Rebecca","Kuh, Diana","Barry, Sarah J","Tang Møllehave, Line","Cerqueira, Charlotte","Friedrich, Nele","Bonten, Tobias N","Noordam, Raymond","Mook-Kanamori, Dennis O","Taube, Christian","Jessen, Leon E","McConnachie, Alex","Sattar, Naveed","Upton, Mark N","McSharry, Charles","Bønnelykke, Klaus","Bisgaard, Hans","Schulz, Holger","Strauch, Konstantin","Meitinger, Thomas","Peters, Annette","Grallert, Harald","Nohr, Ellen Aagaard","Kivimaki, Mika","Kumari, Meena","Völker, Uwe","Nauck, Matthias","Völzke, Henry","Power, Chris","Hyppönen, Elina","Hansen, Torben","Jørgensen, Torben","Pedersen, Oluf","Salomaa, Veikko","Grarup, Niels","Langhammer, Arnulf","Romundstad, Pål R","Skorpen, Frank","Kaprio, Jaakko","R Munafò, Marcus","Linneberg, Allan"],"cuid":["S03-100.00-000378"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"51-200 contributors","class":"merged","cluster_size":3,"continent":["Asia, Middle East","Europe, EU","Europe, Non-EU","Nordic","OECD","Oceania"],"country":["Australia","Finland","Germany","Netherlands","Norway","Saudi Arabia","United Kingdom"],"glorg":["All Global Affiliations","Essen University Hospital","Institute of Human Genetics, Helmholtz Zentrum München","King Faisal Specialist Hospital and Research Center, Riyadh","Leiden University","Leiden University Medical Center","Ludwig-Maximilian University of Munich","National Institute for Health and Welfare","Norwegian University of Science and Technology","South Australian Health And Medical Research Institute","University College London","University Medicine Greifswald","University of Bristol","University of Essex","University of Glasgow","University of Greifswald","University of Helsinki","University of South Australia"],"keyword":["Journal Article"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-STENO"],"OT":["Research unit for Dietary Studies, the Parker Institute, Frederiksberg and Bispebjerg Hospitals, The Capital Region, Frederiksberg, Denmark."],"U":["DI-U-AAU","DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-STENO","DI-U-AAU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"investigating the causal effect of smoking on hay fever and asthma a mendelian randomiza