{"author_count":5,"contributors":["Kongsted, Anne Grete","Ugilt Larsen, Søren","Jensen, Line Dinesen","Horsted, Klaus","Eskildsen, Maria"],"cuid":["S01-000.00-787611"],"event":{"end":"2024-09-05","place":"Firenze, it","start":"2024-09-01","title":"the 75th Annual Meeting of the European Association for Animal Production (EAAP)","year":"2024"},"filters":{"added":"2025-02","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"nr","rtype":["clu"],"sorti":"green willow biomass as feed source for pigs","src":["au"],"src-code":["DI-U-AU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-787611","ids":["au-973ea3e7-1296-4029-a606-ea00929e4ba6"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-28684EFF814AEA0F0E074F72A966D2F6"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Agroecology, Department of Agroecology - Agricultural Systems and Sustainability"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Anne Grete","key":"kongstedpau","last":"Kongsted","locid":"e92d346e-cbd9-44ae-ac1e-377369e6c4b7","name":"Kongsted, Anne Grete","orcid":"0000-0001-7040-7445","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren","key":"ugiltlarsenpau","last":"Ugilt Larsen","locid":"6e72b743-5e26-4bcf-880a-16f77e1fc2a8","name":"Ugilt Larsen, Søren","orcid":"0000-0002-1802-9106","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Line Dinesen","key":"jensenpau","last":"Jensen",