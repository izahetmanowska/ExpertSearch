ffno":"","first":"Richard","key":"farliepau","last":"Farlie","name":"Farlie, Richard","rank":6,"rolecode":"pau"},{"affno":"","first":"Eva","key":"hosethpau","last":"Hoseth","name":"Hoseth, Eva","rank":7,"rolecode":"pau"},{"affno":"","first":"Torben","key":"larsenpau","last":"Larsen","name":"Larsen, Torben","rank":8,"rolecode":"pau"},{"affno":"5","first":"Olav Bjørn","key":"petersenpau","last":"Petersen","name":"Petersen, Olav Bjørn","rank":9,"rolecode":"pau"},{"affno":"","first":"Inger","key":"stornespau","last":"Stornes","name":"Stornes, Inger","rank":10,"rolecode":"pau"},{"affno":"","first":"Lars O.","key":"vejerslevpau","last":"Vejerslev","name":"Vejerslev, Lars O.","rank":11,"rolecode":"pau"},{"affno":"","first":"Helle","key":"zingenbergpau","last":"Zingenberg","name":"Zingenberg, Helle","rank":12,"rolecode":"pau"}],"pmid":["23494847"],"pub":{"doi":"10.1002/uog.12460","issn":["09607692","14690705"],"issn_org":["09607692"],"issue":"5","journal":"Ultrasound in Obstetrics & Gynecology","pages":"530-5","publisher":"John Wiley and Sons Ltd","status":"p","title":"Ultrasound in Obstetrics & Gynecology","title_org":"Ultrasound in obstetrics & gynecology : the official journal of the International Society of Ultrasound in Obstetrics and Gynecology","volume":"42"},"review":"Peer Reviewed","scoID":["2-s2.0-84886949371"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Roskilde University","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-b19c7e28-827b-4912-aea2-c084bfc144f8","ku-50dd4953-19bd-4169-a020-6e179bd586ff","sdu-df00febd-10cc-45d9-8512-a1b4b82293c9"],"src":["AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Detection of triploidy at 11-14 weeks of gestation : A cohort study of 198,000 pregnant women","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-087.50-025622","year":"2013","yearsub":"2013"}
{"abstract":"Background: There is an unmet need for predictive markers for the antiangiogenic agent bevacizumab in metastatic colorectal cancer (mCRC). We aimed to assess whether the location of the primary tumor is associated with bevacizumab effectiveness when combined with capecitabine and oxaliplatin (CAPEOX) in the first-line treatment of patients with mCRC. Patients and methods: A cohort of 667 consecutive patients with mCRC from the general community treated from 2006 to 2011 with CAPEOX and bevacizumab as standard first-line therapy was compared with a cohort of 213 patients treated with CAPEOX from2003 to 2006, before bevacizumab was approved. Main outcome measures were progression-free survival (PFS) and overall survival (OS). Differences in outcome were tested using Kaplan-Meier curves and log-rank tests, and multivariate analyses were carried out using Cox Proportional Hazards models. Results: Patients treated with CAPEOX and bevacizumab with primary tumors originating in the sigmoid colon and rectum had a significantly better outcome than patients with primary tumors originating from the cecum to the descending colon, both for PFS (median PFS 9.3 versus 7.2 months; hazard ratio (HR) 0.68,95% confidence interval (CI) 0.56-0.82) and for OS (median OS 23.5 versus 13.0 months; HR 0.47, 95% CI 0.38-0.57). This difference was confirmed in multivariate analyses after adjustment for other potentially prognostic factors. For patients treated with CAPEOX, there was no association between primarytumor location and outcome, neither in unadjusted nor adjusted analyses. Conclusions: The addition ofbevacizumab to CAPEOX in first-line treatment of patients with mCRC may primarily benefit patients with primary tumors originating in the rectum and sigmoid colon. This hypothesis needs to be validated in data from completed randomized trials. ClinicalTrials.gov identification number: NCT00212615.","author_count":25,"contributors":["Boisen, M. K.","Johansen, J. S.","Dehlendorff, C.","Larsen, J. S.","Østerlind, K.","Hansen, Jørgen","Nielsen, S. E.","Pfeiffer, P.","Tarpgaard, L. S.","Holländer, N. H.","Keldsen, N.","Hansen, T. F.","Jensen, B. B.","Jensen, B. V."],"cuid":["S03-090.51-001921"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"corresponding_author":["Boisen, M. K."],"keyword":["Bevacizumab","Biomarker","Chemotherapy","Metastatic colorectal cancer","Primary tumor"],"level":"sci","mra":["med","soc"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-NP","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-SDR"],"NP":["DI-NP-ALL","DI-NP-CAN"],"OT":["Mogens Karsbol Boisen"],"U":["DI-U-AAU","DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-SDR","DI-NP-CAN","DI-U-AAU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"primary tumor location and bevacizumab effectiveness in patients with metastatic colorectal cancer","src":["aau","ku","sdu"],"src-code":["DI-U-AAU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1093/annonc/mdt253","version":"Other Version"},"id":"S03-090.51-001921","identifier":[{"id":"23864097","type":"pmid"},{"id":"WOS:000325153800015","type":"wos"},{"id":"84884722908","type":"scopus"}],"ids":["aau-2617633a-2f52-4236-9bd3-75a12a3f7ecb","ku-bf29d5db-5cea-4726-9b04-24235d3cebb9","sdu-eafd93ef-02eb-4b4a-bc9b-99584b317b9c"],"keyword":["Bevacizumab","Biomarker","Chemotherapy","Metastatic colorectal cancer","Primary tumor"],"lang":"English","level":"Scientific","mra":["Medical Science","Social Science"],"noi":["Global-Local-2-6-481BCC9DB0619D8F0CB26A550A87911A"],"oa_link":[{"access":"oa","type":"rem","url":"http://www.scopus.com/inward/record.url?scp=84884722908&partnerID=8YFLogxK","version":"Other Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1093/annonc/mdt253","version":"Other 