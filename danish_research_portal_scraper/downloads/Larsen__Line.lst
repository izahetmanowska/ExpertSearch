5 1","first":"Jørgen","key":"rungbypau","last":"Rungby","locid":"16f0bbd5-607e-422d-949d-13546554c84e","name":"Rungby, Jørgen","rank":21,"rolecode":"pau"},{"affno":"1","first":"Torben","key":"hansenpau","last":"Hansen","locid":"6b6bfff1-8b14-468b-af77-e71b375018e0","name":"Hansen, Torben","orcid":"0000-0001-8748-3831","rank":22,"rolecode":"pau"}],"pmid":["36400171"],"pub":{"doi":"10.1016/j.diabres.2022.110159","issn":["01688227","15721671"],"issn_org":["01688227"],"journal":"Diabetes Research and Clinical Practice","paperid":"110159","publisher":"Elsevier Ireland Ltd","status":"p","title":"Diabetes Research and Clinical Practice","volume":"194"},"review":"Peer Reviewed","scoID":["2-s2.0-85143917075"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-48e449f1-fb13-42d7-8dfe-ef06fc7bfc8d","ku-f58ec4b8-1b28-4dba-a363-62a66a09597a","sdu-8134ce27-b9c2-4b87-865e-6ec0e65f02d6"],"src":["AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"14-fold increased prevalence of rare glucokinase gene variant carriers in unselected Danish patients with newly diagnosed type 2 diabetes","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-094.00-017947","year":"2022","yearsub":"2022"}
{"abstract":"The present study investigated the position-specific match demands and heart rate response of female elite footballers, with special focus on the full-game, end-game, and peak-intensity periods. In total, 217 match observations were performed in 94 players from all eight teams of the best Danish Women's League, that is, goalkeepers (GK, n = 10), central defenders (CD, n = 23), full-backs (FB, n = 18), central midfielders (CM, n = 28), external midfielders (EM, n = 18), and forwards (FW, n = 11). Positional data (GPS; 10 Hz Polar Team Pro) and HR responses were collected. HR mean and HR peak were 87%-89% and 98%-99% of HR max, for outfield players, with no positional differences. CM, EM, and FB covered 8%-14% greater (P <.001) match distances than CD. EM, FW, FB, and CM performed 40%-64% more (P <.05) high-speed running and 41%-95% more (P <.01) very-high-speed running (VHSR) than CD. From the first to the last 15-minute period, total distance, except for FW, number of VHSR, except FB, peak speed and sum of accelerations and sum of decelerations decreased (P <.05) for all outfield positions. In the most intense 5-minute period, EM, FB, and CM performed 25%-34% more (P <.01) HSR than CD, whereas EM, FW, and FB performed 36%-49% more (P <.01) VHSR than CD. In conclusion, competitive elite female matches impose high physical demands on all outfield playing positions, with high aerobic loading throughout matches and marked declines in high-speed running and intense accelerations and decelerations toward the end of games. Overall physical match demands are much lower for central defenders than for the other outfield playing positions, albeit this difference is minimized in peak-intensity periods.","author_count":9,"contributors":["Panduro, Jeppe","Ermidis, Georgios","Røddick, Line","Vigh-Larsen, Jeppe F.","Madsen, Esben","Larsen, Malte Nejst","Pettersen, Svein Arne","Krustrup, Peter","Randers, Morten Bredsgaard"],"cuid":["S03-096.29-022511"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":3,"continent":["Asia, East","Europe, EU","Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Randers, Morten B.","Randers, Morten Bredsgaard"],"country":["China","Italy","Norway","United Kingdom"],"glorg":["All Global Affiliations","Research Unit for General Practice, UiT, The Arctic University of Norway, Norway.","Shangai University of Sport","Shanghai University of Sport","UiT The Arctic University of Norway","University of Exeter","University of Exeter Medical School","University of Naples Parthenope"],"keyword":["Accelerations","Athletic Performance physiology","Female","Football","GPS","Geographic Information Systems","Heart Rate","Humans","Physical Functional Performance","Running","Soccer","Soccer physiology","Sprinting","high speed running","peak intensity periods","performance decrements","physically active"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U","DI-UC"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"],"UC":["DI-UC-ALL","DI-UC-KP"]},"level3all":["DI-U-AU","DI-U-SDU","DI-UC-KP"]},"review":"pr","rtype":["clu"],"sorti":"physical performance and loading for six playing positions in elite female football full game end game and peak periods","src":["au","kp","sdu"],"src-code":["DI-U-AU","DI-U-SDU","DI-UC-KP"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1111/sms.13877","version":"Published Version"},"funding_acknowledgement":["We would like to thank the eight clubs in the best Danish League and their coaching staff and players for their participation in and collaboration with the study. The technical and practical assistance provided by Matthias Gjaettermann and Sidsel Damsgaard Thomsen is also greatly appreciated. We would also like to thank the Danish FA (DBU), especially Søren Bennike, Kenneth Grønlund Rasmussen, Peter Møller and Women's national team coach Lars Søndergaard, and the Danish Women's League (Gjensidige Ligaen) for implementing and assisting with the study. The project received funding from the Danish FA."],"id":"S03-096.29-022511","identifier":[{"id":"33749045","type":"pmid"},{"id":"85102812453","type":"scopus"}],"ids":["au-8731d6c0-101b-4779-bfc9-d3bd495eeb7e","kp-b89d4a6c-7896-41d4-be5f-c27c6e4d9ce6","sdu-0743d562-0760-482c-909a-034569de81db"],"keyword":["Athletic Performance/physiology","Female","Football","GPS","Geographic Information Systems","Humans","Physical Functional Performance","Running","Soccer/physiology","accelerations","heart rate","high-speed running","peak-intensity periods","performance decrements","physically active","soccer","sprinting"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-92C36103DFBE0592E099C560CF5BA2C4"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/201789249/Scandinavian_Med_Sci_Sports_2021_Panduro_Physical_performance_and_loading_for_six_playing_positions_in_elite_female.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1111/sms.13877","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics","SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics, Research Unit of Sport and Health Sciences"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","key":"au aarhus university","