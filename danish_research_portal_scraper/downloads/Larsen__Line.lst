affno":"1","corresponding":null,"country":"dk","first":"Line Staun","key":"larsenpau","last":"Larsen","locid":"35e2ae60-25db-4a15-893f-dc8906e2bccf","name":"Staun Larsen, Line","name_org":"Larsen, Line Staun","orcid":"0000-0002-4155-5884","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Vibeke","key":"bælumpau","last":"Bælum","locid":"fa28bbda-971e-4463-be61-3dcc358973b2","name":"Bælum, Vibeke","orcid":"0000-0002-2195-8053","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Livia M.A.","key":"tenutapau","last":"Tenuta","name":"Tenuta, Livia M.A.","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Alan","key":"richardspau","last":"Richards","locid":"2b845949-43a7-481b-b04e-d301d661433b","name":"Richards, Alan","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Bente","key":"nyvadpau","last":"Nyvad","locid":"f0fda280-eb7a-42d4-93f0-45f26e30fc45","name":"Nyvad, Bente","orcid":"0000-0002-9545-0447","rank":5,"rolecode":"pau"}],"pub":{"issn":["00086568","1421976X"],"issn_org":["00086568"],"issue":"4","journal":"Caries Research","pages":"370","paperid":"175","publisher":"S. Karger AG","status":"p","title":"Caries Research","volume":"51"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-994ab61c-1d54-4511-b273-ba2485b41cdb"],"src":["AU Aarhus University"],"title":"Fluoride in Dental Biofilm and Saliva After Use of 1,500 and 5,000 ppm Fluoride (NaF) Mouth Rinses","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-216681","year":"2017","yearsub":"2017"}
{"abstract":"Information on differences in biofilm fluoride concentration across intra-oral regions may help explain the distribution of caries within the dentition. The aim of this cross-sectional study was to describe the fluoride concentration in saliva and in biofilm fluid and biofilm solids across 6 intra-oral regions. Unstimulated whole saliva was collected from 42 participants and biofilm harvested from the buccal sites in the 4 molar and 2 anterior regions. Samples were collected at least 1 h after use of fluoride dentifrice. No attempt was made to control the participants' food consumption or use of other topical agents. Centrifuged saliva, biofilm fluid, and biofilm solids were analysed for fluoride using a fluoride ion-selective electrode, adapted for microanalysis. Fluoride in biofilm varied across intra-oral regions. The mean biofilm fluid fluoride concentrations across the oral cavity ranged from 11.6 to 16.8 µM, being statistically significantly higher in the upper anterior region than in any other region. In all regions the fluoride concentration in biofilm fluid was higher than in saliva. For biofilm solids the fluoride concentration was highest in the lower anterior region (2,461 μmol/kg) and lowest in the lower molar regions (388 and 406 μmol/kg, respectively). Within biofilm, the solids contained most of the fluoride (81 to >99%). The biofilm fluid fluoride concentration was significantly positively associated with salivary fluoride and only marginally associated with that of biofilm solids. In conclusion, this study has shown pronounced differences in fluoride distribution across intra-oral regions and compartments. This shows that the sampling site is a crucial factor for studies of biofilm fluoride.","author_count":5,"contributors":["Staun Larsen, Line","Bælum, Vibeke","Tenuta, Livia Maria Andaló","Richards, Alan","Nyvad, Bente"],"cuid":["S01-000.00-233592"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Journal Article"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"fluoride in dental biofilm varies across intra oral regions","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85021123794","version":"Other Version"},"id":"S01-000.00-233592","identifier":[{"id":"28641301","type":"pmid"},{"id":"85021123794","type":"scopus"}],"ids":["au-b6b9ac57-e85f-42b9-994b-003a4748b335"],"keyword":["Journal Article"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-FF2B03298C504E6C540A35F235AB0E1A"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Dentistry and Oral Health, Department of Dentistry and Oral Health - Section for Oral Ecology and Caries Control"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Line","key":"staunpau","last":"Staun","locid":"35e2ae60-25db-4a15-893f-dc8906e2bccf","name":"Staun Larsen, Line","name_org":"Staun, Line","orcid":"0000-0002-4155-5884","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Vibeke","key":"baelumpau","last":"Baelum","locid":"fa28bbda-971e-4463-be61-3dcc358973b2","name":"Bælum, Vibeke","name_org":"Baelum, Vibeke","orcid":"0000-0002-2195-8053","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Livia Maria Andaló","key":"tenutapau","last":"Tenuta","name":"Tenuta, Livia Maria Andaló","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Alan","key":"richardspau","last":"Richards","locid":"2b845949-43a7-481b-b04e-d301d661433b","name":"Richards, Alan","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Bente","key":"nyvadpau","last":"Nyvad","locid":"f0fda280-eb7a-42d4-93f0-45f26e30fc45","name":"Nyvad, Bente","orcid":"0000-0002-9545-0447","rank":5,"rolecode":"pau"}],"pmid":["28641301"],"pub":{"doi":"10.1159/000475510","issn":["00086568","1421976X"],"issn_org":["00086568"],"journal":"Caries Research","pages":"402-409","publisher":"S. Karger AG","status":"p","title":"Caries Research","volume":"51"},"review":"Peer Reviewed","scoID":["2-s2.0-85021123794"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-b6b9ac57-e85f-42b9-994b-003a4748b335"],"src":["AU Aarhus University"],"title":"Fluoride in Dental Biofilm Varies across Intra-Oral Regions","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-233592","year":"2017","yearsub":"2017"}
{"abstract":"We present a general method for combining two crystals into an interface. The method finds all possible interfaces between the crystals with small coincidence cells and identifies the strain and area of the corresponding two-dimensional cells of the two crystal surfaces. We apply the method to the two semiconductor alloys InAs1−xSbx and GaxIn1−xAs combined with a selection of pure metals or with NbTiN to create semiconductor/superconductor interfaces. The lattice constant of the alloy can be tuned by composition and we can extract the alloy lattice parameters corresponding to zero strain in both the metal and the alloy. The results can be used to suggest new epitaxially matched interfaces between two materials.","author_count":5,"contributors":["Jelver, Line","Larsen, Peter Mahler","Stradi, Daniele","Stokbro, Kurt","Jacobsen, Karsten Wedel"],"cuid":["S01-000.00-380034"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-PR-OTH","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"determination of low strain interfaces via geometric matching","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/136892050/Untitled.pdf","version":"Published Version"},"id":"S01-000.00-380034","identifier":[{"id":"85029693487","type":"scopus"}],"ids":["dtu-fc28fb80-4ae5-484f-b40e-54835d1d1740"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-3B779B11470F40969342EC627D2BC454"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/136892050/Untitled.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Physics","Technical University of Denmark, Department of Physics, Computational Atomic-scale Materials Design"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["QuantumWise A/S"],"nora_code":"DI-PR-OTH","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Line","key":"jelverpau","last":"Jelver","locid":"4b41d4ea-e0ee-41cf-88aa-6550d430f6be","name":"Jelver, Line","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Peter Mahler","key":"larsenpau","last":"Larsen","locid":"24974427-d7d4-4b68-b9f6-1afc17a655bc","name":"Larsen, Peter Mahler","orcid":"0000-0002-7280-5903","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Daniele","key":"stradipau","last":"Stradi","name":"Stradi, Daniele","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Kurt","key":"stokbropau","last":"Stokbro","name":"Stokbro, Kurt","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Karsten Wedel","key":"jacobsenpau","last":"Jacobsen","locid":"cadf247d-aba2-4e55-ab06-d53b7a5e6b5a","name":"Jacobsen, Karsten Wedel","orcid":"0000-0002-1121-2979","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1103/physrevb.96.085306","issn":["1550235X","24699950"],"issn_org":["24699950"],"issue":"8","journal":"Physical Review B","paperid":"085306","publisher":"American Physical Society","status":"p","title":"Physical Review B","volume":"96"},"review":"Peer Reviewed","scoID":["2-s2.0-85029693487"],"search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Other Companies","Private Research","Technical University of Denmark","Universities","quantumwise a/s"],"PST":["Published"]},"sid":["dtu-fc28fb80-4ae5-484f-b40e-54835d1d1740"],"src":["DTU Technical University of Denmark"],"title":"Determination of low-strain interfaces via geometric matching","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-380034","year":"2017","yearsub":"2017"}
{"abstract":"Reduced NaCl in semi-hard cheeses greatly affects textural and sensory properties. The interaction between cheese NaCl concentration and texture was affected by brining time (0–28 h), DL-starter cultures (C1, C2, and C3), chymosin type (bovine or camel), and ripening time (1–12 weeks). Cheese NaCl levels ranged from <0.15 to 1.90% (w/w). NaCl distribution changed during ripening; migration from cheese edge to core led to a more homogeneous NaCl distribution after 12 weeks. As ripening time increased, cheese firmness decreased. Cheeses with reduced NaCl were less firm and more compressible. Cheeses produced with C2 were significantly firmer than those produced with C1; cheeses produced with C3 had higher firmness and compressibility. In NaCl reduced cheese, use of camel chymosin as coagulant resulted in significantly higher firmness than that given using bovine chymosin. Overall, cheese NaCl content is reducible without significant textural impact using well-defined starter cultures and camel chymosin.","author_count":16,"contributors":["Akkerman, Marije","Søndergaard Kristensen, Lise","Jespersen, Lene","Balling Ryssel, Mia","Mackie, Alan","Nørreby Larsen, Nick","Andersen, Ulf","Nørgaard, Maria Kümpel","Løkke, Mette Marie","Møller, Jean Robert","Mielby, Line Ahm","Andersen, Barbara Vad","Kidmose, Ulla","Hammershøj, Marianne"],"cuid":["S02-097.48-016587"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","Norwich Research Park","University of Leeds"],"keyword":["Danish cheese","Semi hard cheese"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-PR","DI-U"],"level3":{"OT":["Unspecified organisation"],"PR":["DI-PR-ALL","DI-PR-ARLA","DI-PR-NOSI","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-PR-ARLA","DI-PR-NOSI","DI-PR-OTH","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"interaction between sodium chloride and texture in semi hard danish cheese as affected by brining time dl starter culture chymosin type and cheese ripening","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/201678425/Int_Dairy_J_Akkerman_2017_accepted.pdf","version":"Authors Final Version"},"id":"S02-097.48-016587","identifier":[{"id":"85007488766","type":"scopus"}],"ids":["au-362527d9-8395-4537-a076-0f1a91f8d9e9","ku-138cc330-f6ba-43a8-9316-40f628dbfd7d"],"keyword":["Danish cheese","Semi-hard cheese","brining time"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-FD66B78145EFD24C301F3DF9F7E1040E"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/201678425/Int_Dairy_J_Akkerman_2017_accepted.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Food Science, Department of Food Science - Food Chemistry"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Food Science, Food Microbiology, Gut Health, and Fermentation"],"nora_code":"DI-U-KU","used":1},{"affno":"3","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1},{"affno":"4","country":"dk","key":"novonesis","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-NOSI","l3nn":"Novonesis","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Novonesis","namevar":["Chr. Hansen"],"nora_code":"DI-PR-NOSI","used":1},{"affno":"5","country":"gb","key":"norwich research park","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Norwich Research Park","used":1},{"affno":"6","country":"gb","key":"university of leeds","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Leeds","used":1},{"affno":"7","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["Thise Dairy"],"nora_code":"DI-PR-OTH","used":1},{"affno":"8","country":"dk","key":"arla foods","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-ARLA","l3nl":"Arla Foods","l3nn":"Arla Foods","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Arla Foods","namevar":["Arla Foods"],"nora_code":"DI-PR-ARLA","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Marije","key":"akkermanmarijepau","last":"Akkerman","locid":"2d67483e-5479-4f75-8d85-a1c189b642dc","name":"Akkerman, Marije","rank":1,"rolecode":"pau"},{"affno":"2","first":"Lise","key":"søndergaardlisepau","last":"Søndergaard","locid":"a6f96b85-6e55-43d6-826b-640f456446ad","name":"Søndergaard, Lise","orcid":"0000-0002-0345-6017","rank":2,"rolecode":"pau"},{"affno":"2","first":"Lene","key":"jespersenlenepau","last":"Jespersen","locid":"a156c6e3-9562-4d35-9305-53a39c62e076","name":"Jespersen, Lene","orcid":"0000-0002-2555-5948","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Mia","key":"ballingrysselmiapau","last":"Balling Ryssel","name":"Balling Ryssel, Mia","rank":4,"rolecode":"pau"},{"affno":"4","first":"Mia","key":"rysselmiapau","last":"Ryssel","name":"Ryssel, Mia","rank":4,"rolecode":"pau"},{"affno":"5 6","corresponding":null,"first":"Alan","key":"mackiealanpau","last":"Mackie","name":"Mackie, Alan","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Nick","key":"nørrebylarsennickpau","last":"Nørreby Larsen","name":"Nørreby Larsen, Nick","rank":6,"rolecode":"pau"},{"affno":"7","first":"Nick Nørreby","key":"larsennicknørrebypau","last":"Larsen","name":"Larsen, Nick Nørreby","rank":6,"rolecode":"pau"},{"affno":"8","corresponding":null,"first":"Ulf","key":"andersenulfpau","last":"Andersen","name":"Andersen, Ulf","rank":7,"rolecode":"pau"},{"affno":"8","corresponding":null,"first":"Maria Kümpel","key":"nørgaardmariakümpelpau","last":"Nørgaard","name":"Nørgaard, Maria Kümpel","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mette Marie","key":"løkkemettemariepau","last":"Løkke","locid":"3a475404-5d5a-4b5c-90f2-ff6cd5b06c04","name":"Løkke, Mette Marie","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jean Robert","key":"møllerjeanrobertpau","last":"Møller","locid":"89e24d46-1b9c-4bb5-b167-997db9605d14","name":"Møller, Jean Robert","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Line Ahm","key":"mielbylineahmpau","last":"Mielby","locid":"05901a11-a277-4e67-af2e-900afde66c00","name":"Mielby, Line Ahm","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Barbara Vad","key":"andersenbarbaravadpau","last":"Andersen","locid":"cfec7c3d-ae0c-40ea-b50b-50e1c710525e","name":"Andersen, Barbara Vad","rank":12,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ulla","key":"kidmoseullapau","last":"Kidmose","locid":"7a1c5721-dba1-4cbe-9786-132f693dde79","name":"Kidmose, Ulla","rank":13,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Marianne","key":"hammershøjmariannepau","last":"Hammershøj","locid":"483a27e1-b030-4e4b-8441-76424c064fed","name":"Hammershøj, Marianne","orcid":"0000-0001-9297-6526","rank":14,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.idairyj.2016.10.011","issn":["09586946","18790143"],"issn_org":["09586946"],"journal":"International Dairy Journal","pages":"34-45","publisher":"Elsevier BV","publisher_org":"Elsevier B.V.","status":"p","title":"International Dairy Journal","volume":"70"},"review":"Peer Reviewed","scoID":["2-s2.0-85007488766"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Private Research","All Universities","Arla Foods","DI-ALL","DI-OT","DI-OT-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Companies","Other Research","Private Research","Universities","University of Copenhagen","thise dairy"],"PST":["Published"]},"sid":["au-362527d9-8395-4537-a076-0f1a91f8d9e9","ku-138cc330-f6ba-43a8-9316-40f628dbfd7d"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Interaction between sodium chloride and texture in semi-hard Danish cheese as affected by brining time, DL-starter culture, chymosin type and cheese ripening","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-097.48-016587","year":"2017","yearsub":"2017"}
{"abstract":"AIM: We investigated the use of non-antiretroviral drugs in the HIV-infected compared to the general population. METHODS: From the Danish HIV Cohort Study, we identified all HIV-infected individuals older than 18 years at HIV diagnosis who received care in Denmark through 1995-2013 and reported no injection drug abuse or hepatitis C infection. Population controls were identified from The Danish Civil Registration System and matched on age and gender (5:1). We analyzed the proportion of individuals who redeemed 0-1, 2-4, 5-9, or 10 or more non-antiretroviral drugs. Data were analyzed according to calendar time, age, time from initiation of combination antiretroviral therapy (cART) and stratified by gender, geographical origin and route of HIV transmission. We further analyzed the use of the 25 most used non-antiretroviral drug classes. RESULTS: We identified 4,928 HIV-infected individuals (median age: 37; 76.4% males). Overall, the HIV-infected population had a higher use of non-antiretroviral drugs compared to the background population. Whereas, the use of non-antiretroviral drugs in the HIV-infected population only changed marginally with time, the use in the background population increased considerably. Thus, use in the HIV-infected population only differed marginally from that of the background population in recent years. This difference was most pronounced in men who have sex with men (MSM). CONCLUSION: Compared to the background population, HIV infected individuals have increased use of non-antiretroviral drugs. The excess use is mainly observed in MSM and has decreased with calendar time, why it in recent years only differs marginally from that observed in the background population.","author_count":7,"contributors":["Rasmussen, Line D","Kronborg, Gitte","Larsen, Carsten Schade","Pedersen, Court","Gerstoft, Jan","Obel, Niels","Pottegård, Anton"],"cuid":["S03-093.55-020805"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":3,"keyword":["Adult","Age Factors","Anti HIV Agents","Antiretroviral Therapy Highly Active","Cohort Studies","Comorbidity","Denmark","Female","HIV Infections","Humans","Journal Article","Male","Middle Aged","Polypharmacy","Registries","Risk Factors","Sexual Minorities","Time Factors"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"use of non antiretroviral drugs among individuals with and without hiv infection a danish nationwide study","src":["au","ku","sdu"],"src-code":["DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84981537947","version":"Other Version"},"id":"S03-093.55-020805","identifier":[{"id":"84981537947","type":"scopus"},{"id":"27686116","type":"pmid"}],"ids":["au-6f361f22-5ffe-4fe3-9b3b-2ccc974f46d1","ku-d6102054-46be-40da-9174-90b43307d16b","sdu-f3ceae4c-250f-4b78-a56b-c96e5355c139"],"keyword":["Adult","Age Factors","Anti-HIV Agents","Antiretroviral Therapy, Highly Active","Cohort Studies","Comorbidity","Denmark","Female","HIV Infections","Humans","Journal Article","Male","Middle Aged","Polypharmacy","Registries","Risk Factors","Sexual Minorities","Time Factors"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-1C97550004673D95F665A5C9A15CFC24"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU Unive