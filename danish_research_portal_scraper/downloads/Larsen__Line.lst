senpau","last":"Larsen","locid":"3ee738b1-09d1-4886-9ddf-67ca132997fe","name":"Larsen, Christina Viskum Lytken","name_org":"Larsen, Christina V L","orcid":"0000-0002-6245-4222","rank":16,"rolecode":"pau"},{"affno":"3","first":"Clara","key":"lemoinepau","last":"Lemoine","name":"Lemoine, Clara","rank":17,"rolecode":"pau"},{"affno":"1","first":"Oluf","key":"pedersenpau","last":"Pedersen","locid":"0a2a7ad3-1719-43c6-bdf3-c3491a43a8af","name":"Pedersen, Oluf","orcid":"0000-0002-3321-3972","rank":18,"rolecode":"pau"},{"affno":"2","first":"Bjarke","key":"feenstrapau","last":"Feenstra","name":"Feenstra, Bjarke","rank":19,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Peter","key":"bjerregaardpau","last":"Bjerregaard","locid":"ef4a2fa7-9735-4b1e-a4fa-b1272def2cfc","name":"Bjerregaard, Peter","orcid":"0000-0001-7153-8447","rank":20,"rolecode":"pau"},{"affno":"1","first":"Mads","key":"melbyepau","last":"Melbye","locid":"5223d59a-d9b3-41ee-9664-4f1313d4b8c6","name":"Melbye, Mads","orcid":"0000-0001-8264-6785","rank":21,"rolecode":"pau"},{"affno":"4 5 7","corresponding":null,"first":"Marit E","key":"jørgensenpau","last":"Jørgensen","locid":"5a2309e5-48cd-4773-9887-7b0255811460","name":"Jørgensen, Marit Eika","name_org":"Jørgensen, Marit E","orcid":"0000-0001-8356-5565","rank":22,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"Nils J","key":"færgemanpau","last":"Færgeman","locid":"448a164d-523a-4d91-923c-fc5536371b95","name":"Færgeman, Nils J.","name_org":"Færgeman, Nils J","orcid":"0000-0002-9281-5287","rank":23,"rolecode":"pau"},{"affno":"2 7 8","first":"Anders","key":"kochpau","last":"Koch","name":"Koch, Anders","rank":24,"rolecode":"pau"},{"affno":"1","first":"Thomas","key":"moritzpau","last":"Moritz","locid":"9cd32ebc-9e16-4f52-9c5f-a3352224064c","name":"Moritz, Thomas","rank":25,"rolecode":"pau"},{"affno":"1","first":"Matthew P.","key":"gillumpau","last":"Gillum","locid":"65c5e8eb-5634-45db-952e-d28bf525bd32","name":"Gillum, Matthew P.","orcid":"0000-0003-4893-012X","rank":26,"rolecode":"pau"},{"affno":"1","first":"Ida","key":"moltkepau","last":"Moltke","locid":"9aab69f1-a07a-4a34-b844-9c7c61756cc5","name":"Moltke, Ida","orcid":"0000-0001-7052-8554","rank":27,"rolecode":"pau"},{"affno":"1 4","first":"Torben","key":"hansenpau","last":"Hansen","locid":"6b6bfff1-8b14-468b-af77-e71b375018e0","name":"Hansen, Torben","orcid":"0000-0001-8748-3831","rank":28,"rolecode":"pau"},{"affno":"1","first":"Anders","key":"albrechtsenpau","last":"Albrechtsen","locid":"4b040c73-6b49-4e97-be60-5e34608e0615","name":"Albrechtsen, Anders","orcid":"0000-0001-7306-031X","rank":29,"rolecode":"pau"}],"pmid":["34914943"],"pub":{"doi":"10.1053/j.gastro.2021.12.236","issn":["00165085","15280012"],"issn_org":["00165085"],"issue":"4","journal":"Gastroenterology","publisher":"Elsevier","status":"p","title":"Gastroenterology","volume":"162"},"review":"Peer Reviewed","scoID":["2-s2.0-85124939212"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Hospitals","All Miscellaneous","All Private Research","All Universities","Capital Region of Denmark","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Miscellaneous","Novo Nordisk","Other Research","Private Research","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-85e14c2a-87d3-4d17-bb76-800a71a7620b","sdu-a0e191ac-a57d-4c2c-b7c9-ad9eb27deedd"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Loss of Sucrase-Isomaltase Function Increases Acetate Levels and Improves Metabolic Health in Greenlandic Cohorts","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-098.67-044070","year":"2022","yearsub":"2022"}
{"abstract":"Objectives: To investigate the association between neonatal complications and neurophysiological development in twins at 18 and 48-60 months of age.Methods: This was a secondary analysis of 841 Danish mono- and dichorionic diamniotic twins from a randomized controlled trial (PREDICT study), which included an assessment of the twin's neurophysiological development using the Ages and Stages Questionnaire (ASQ) that had been filled out by the parents at 18 and 48 or 60 months. The correlation within twin pairs was accounted for by the method of generalized estimating equation. Models were adjusted for maternal educational score and gestational age at delivery.Results: ASQ data were available for 823 children at 18 months and 425 children at 48 or 60 months. Low maternal educational score and preterm delivery <34 weeks were associated with a lower ASQ score at 48-60 months (-15.4 points (95%CI -26.4; -4.5) and -13.2 points (95%CI -23.8; -2.5), respectively). Neonatal sepsis and a compound of intraventricular hemorrhage, retinopathy of prematurity and necrotizing enterocolitis (IVH/ROP/NEC) were associated with lower ASQ score at 18 months (-15.3 points (95%CI -28.1; -2.5) and -30.8 points (95%CI -59.5; -2.1), respectively). Children with IVH/ROP/NEC had a lower ASQ score at 48-60 months (-34.2 points (95%CI -67.9; -0.6)). The associations were not specific to only one ASQ domain.Conclusion: Several neonatal complications are associated with poorer neurophysiological development in twins during childhood, even after adjustment for gestational age at delivery.","author_count":15,"contributors":["Vedel, Cathrine","Larsen, Helle","Holmskov, Anni","Andreasen, Kirsten Riis","Uldbjerg, Niels","Ramb, Jan","Bødker, Birgit","Skibsted, Lillian","Sperling, Lene","Krebs, Lone","Zingenberg, Helle","Laursen, Lone","Christensen, Jeanette Tranberg","Tabor, Ann","Rode, Line"],"cuid":["S04-099.82-001809"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"continent":["Europe, EU","Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Vedel, Cathrine"],"country":["Norway","Sweden"],"glorg":["All Global Affiliations","Helgeland Hospital Trust","Helgelandssykehuset","Helgelandssykehuset Mo i Rana","Karolinska Institute","Karolinska Institutet","Karolinska University Hospital"],"keyword":["Ages and stages questionnaire","Follow Up Studies","Follow up","Gestational Age","Humans","Infant Newborn","Neonatal complications","Pregnancy Twin","Premature Birth","Twins","neurophysiological development"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"neonatal complications and neurophysiological development in twins a long term follow up study","src":["aau","au","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85078456103","version":"Other Version"},"id":"S04-099.82-001809","identifier":[{"id":"85078456103","type":"scopus"},{"id":"31986942","type":"pmid"},{"id":"000511304800001","type":"wos"}],"ids":["aau-2414b965-cc0c-4069-bde1-98671efa9cc4","au-bdf04807-a056-466d-8488-67d0cfb6da37","ku-e083ab6a-dc10-4c40-97a5-5b364190f157","sdu-7b82fba3-4f0e-4f8a-a3c7-6e6f4767430a"],"keyword":["Ages and stages questionnaire","Follow-Up Studies","Gestational Age","Humans","Infant, Newborn","Pregnancy, Twin","Premature Birth","follow-up","neonatal complications","neurophysiological development","twins"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-7-173D68127E29A