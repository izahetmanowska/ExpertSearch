{"author_count":5,"contributors":["Qian, Yang","Kando, Christine Kere","Thorsen, Line","Larsen, Nadja","Jespersen, Lene"],"cuid":["S01-000.00-512050"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Quorum sensing"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"production of autoinducer 000000000002 by aerobic endospore forming bacteria isolated from the west african fermented foods","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-512050","identifier":[{"id":"84949882942","type":"scopus"},{"id":"000366368000005","type":"wos"}],"ids":["ku-c6b87af2-725f-4b53-b9c3-7a741c630cbb"],"keyword":["Lsr system","alkaline fermentations","luxS gene","quorum sensing"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-4227A3DE498D0D4A14820FED7F94CF2B"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Food Science, Food Microbiology, Gut Health, and Fermentation"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Yang","key":"qianpau","last":"Qian","locid":"7d6d1e38-164d-4f52-b30b-4b72532a1646","name":"Qian, Yang","rank":1,"rolecode":"pau"},{"affno":"","first":"Christine Kere","key":"kandopau","last":"Kando","name":"Kando, Christine Kere","rank":2,"rolecode":"pau"},{"affno":"1","first":"Line","key":"thorsenpau","last":"Thorsen","locid":"c882a60f-763a-4496-93be-335fe3451a41","name":"Thorsen, Line","rank":3,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Nadja","key":"larsenpau","last":"Larsen","locid":"be39c304-b5b1-4ff3-bef0-a00768b752d3","name":"Larsen, Nadja","orcid":"0000-0002-5899-4883","rank":4,"rolecode":"pau"},{"affno":"1","first":"Lene","key":"jespersenpau","last":"Jespersen","locid":"a156c6e3-9562-4d35-9305-53a39c62e076","name":"Jespersen, Lene","orcid":"0000-0002-2555-5948","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1093/femsle/fnv186","issn":["03781097","15746968"],"issn_org":["03781097"],"issue":"22","journal":"FEMS Microbiology Letters","paperid":"fnv186","status":"p","title":"FEMS Microbiology Letters","volume":"362"},"review":"Peer Reviewed","scoID":["2-s2.0-84949882942"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-c6b87af2-725f-4b53-b9c3-7a741c630cbb"],"src":["KU University of Copenhagen"],"title":"Production of autoinducer-2 by aerobic endospore-forming bacteria isolated from the West African fermented foods","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-512050","year":"2015","yearsub":"2015"}
{"abstract":"Mutations in the guanine nucleotide-binding protein (G protein), α activating activity polypeptide O (GNAO1) gene have recently been described in 6 patients with early infantile epileptic encephalopathies. In the present study, we report the phenotype and the clinical course of a 4-year-old female with an epileptic encephalopathy (Ohtahara syndrome) and profound intellectual disability due to a de novo GNAO1 mutation (c.692A>G; p.Tyr231Cys). Ohtahara syndrome is a devastating early infantile epileptic encephalopathy that can be caused by mutations in different genes, now also including GNAO1. The mutation was found using a targeted next generation sequencing gene panel and demonstrates targeted sequencing as a powerful tool for identifying mutations in genes where only a few de novo mutations have been identified.","author_count":8,"contributors":["Talvik, Inga","Møller, Rikke S.","Vaher, Merilin","Vaher, Ulvi","Larsen, Line HG","Dahl, Hans A","Ilves, Pilvi","Talvik, Tiina"],"cuid":["S01-000.00-575977"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"corresponding_author":["Talvik, Inga"],"country":["Estonia"],"glorg":["All Global Affiliations","Tartu University Clinic","University of Tartu"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-PR","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-FILA"],"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-FILA","DI-PR-OTH","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"clinical phenotype of de novo gnao000000000001 mutation case report and review of literature","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-575977","identifier":[{"id":"PMC5417033","type":"pmcid"},{"id":"28503590","type":"pmid"}],"ids":["sdu-09bfebd1-74fe-4f21-bb4a-bd6055eae934"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-85BE8515D7FC0AD9CCCFACF717679E84"],"org":[{"affno":"1","country":"ee","key":"tartu university clinic","loc":["Estonia","Europe, EU","OECD"],"name":"Tartu University Clinic","used":1},{"affno":"2","country":"ee","key":"university of tartu","loc":["Estonia","Europe, EU","OECD"],"name":"University of Tartu","used":1},{"affno":"3","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Regional Health Research"],"nora_code":"DI-U-SDU","used":1},{"affno":"4","country":"dk","key":"filadelfia danish epilepsy hospital","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-FILA","l3nn":"Filadelfia - Danish Epilepsy Hospital","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Filadelfia - Danish Epilepsy Hospital","namevar":["Epilepsihospitalet Filadelfia"],"nora_code":"DI-HO-FILA","used":1},{"affno":"5","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["Amplexa Genetics A/S"],"nora_code":"DI-PR-OTH","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Inga","key":"talvikingapau","last":"Talvik","name":"Talvik, Inga","rank":1,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Rikke S","key":"møllerrikkespau","last":"Møller","locid":"85de2fa9-456c-4427-8c30-7dc1bdd4bcf0","name":"Møller, Rikke S.","name_org":"Møller, Rikke S","orcid":"0000-0002-9664-1448","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Merilin","key":"vahermerilinpau","last":"Vaher","name":"Vaher, Merilin","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ulvi","key":"vaherulvipau","last":"Vaher","name":"Vaher, Ulvi","rank":4,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Line HG","key":"larsenlinehgpau","last":"Larsen","name":"Larsen, Line HG","rank":5,"rolecode":"pau"},{"affno":"3 5","corresponding":null,"first":"Hans A","key":"dahlhansapau","last":"Dahl","locid":"47a1b0bc-064a-4f1b-a102-6e455ba8a743","name":"Dahl, Hans A","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Pilvi","key":"ilvespilvipau","last":"Ilves","name":"Ilves, Pilvi","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Tiina","key":"talviktiinapau","last":"Talvik","name":"Talvik, Tiina","rank":8,"rolecode":"pau"}],"pmid":["28503590"],"pub":{"doi":"10.1177/2329048x15583717","issn":["2329048X"],"issue":"2","journal":"Child Neurology Open","status":"p","title":"Child Neurology Open","volume":"2"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Hospitals","All Private Research","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Hospitals","Other Companies","Private Research","Universities","University of Southern Denmark","amplexa genetics a/s"],"PST":["Published"]},"sid":["sdu-09bfebd1-74fe-4f21-bb4a-bd6055eae934"],"src":["SDU University of Southern Denmark"],"title":"Clinical Phenotype of De Novo GNAO1 Mutation : Case Report and Review of Literature","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-575977","year":"2015","yearsub":"2015"}
{"abstract":"Summary Autosomal dominant mutations in the sodium-gated potassium channel subunit gene KCNT1 have been associated with two distinct seizure syndromes, nocturnal frontal lobe epilepsy (NFLE) and malignant migrating focal seizures of infancy (MMFSI). To further explore the phenotypic spectrum associated with KCNT1, we examined individuals affected with focal epilepsy or an epileptic encephalopathy for mutations in the gene. We identified KCNT1 mutations in 12 previously unreported patients with focal epilepsy, multifocal epilepsy, cardiac arrhythmia, and in a family with sudden unexpected death in epilepsy (SUDEP), in addition to patients with NFLE and MMFSI. In contrast to the 100% penetrance so far reported for KCNT1 mutations, we observed incomplete penetrance. It is notable that we report that the one KCNT1 mutation, p.Arg398Gln, can lead to either of the two distinct phenotypes, ADNFLE or MMFSI, even within the same family. This indicates that genotype-phenotype relationships for KCNT1 mutations are not straightforward. We demonstrate that KCNT1 mutations are highly pleiotropic and are associated with phenotypes other than ADNFLE and MMFSI. KCNT1 mutations are now associated with Ohtahara syndrome, MMFSI, and nocturnal focal epilepsy. They may also be associated with multifocal epilepsy and cardiac disturbances.","author_count":31,"contributors":["Møller, Rikke S.","Heron, Sarah E.","Larsen, Line H. G.","Lim, Chiao Xin","Ricos, Michael G.","Bayly, Marta A.","van Kempen, Marjan J. A.","Klinkenberg, Sylvia","Andrews, Ian","Kelley, Kent","Ronen, Gabriel M.","Callen, David","McMahon, Jacinta M.","Yendle, Simone C.","Carvill, Gemma L.","Mefford, Heather C.","Nabbout, Rima","Poduri, Annapurna","Striano, Pasquale","Baglietto, Maria G.","Zara, Federico","Smith, Nicholas J.","Pridmore, Clair","Gardella, Elena","Nikanorova, Marina","Dahl, Hans Atli","Gellert, Pia","Scheffer, Ingrid E.","Gunning, Boudewijn","Kragh-Olsen, Bente","Dibbens, Leanne M."],"cuid":["S01-000.00-579191"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Cardiac arrhythmia","Epileptic encephalopathy","KCNT1","Sudden unexpected death in epilepsy"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-PR","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR","DI-HO-FILA"],"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-CDR","DI-HO-FILA","DI-PR-OTH","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"mutations in kcnt000000000001 cause a spectrum of focal epilepsies","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84940963068","version":"Other Version"},"id":"S01-000.00-579191","identifier":[{"id":"26122718","type":"pmid"},{"id":"84940963068","type":"scopus"}],"ids":["sdu-14eb4f7d-0669-4e41-b6bf-a402577d4f57"],"keyword":["Autosomal dominant nocturnal frontal lobe epilepsy","Cardiac arrhythmia","Epileptic encephalopathy","KCNT1","Sudden unexpected death in epilepsy"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-99F90627D1C0C5227F676EFC28A33DDB"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Regional Health Research","SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS - The Epilepsyhospital Filadelfia"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-P