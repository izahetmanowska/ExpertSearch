nst Torture","namevar":["DIGNITY - Danish Institute Against torture"],"nora_code":"DI-GV-DIG","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Steffen","key":"jensenpau","last":"Jensen","locid":"7f351dd1-7f11-49e7-b12b-80a76e5fb133","name":"Jensen, Steffen","orcid":"0000-0002-9147-2665","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Morten Koch","key":"andersenpau","last":"Andersen","name":"Andersen, Morten Koch","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Kari","key":"øygardlarsenpau","last":"Øygard Larsen","name":"Øygard Larsen, Kari","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Line","key":"vestergaardhanaenpau","last":"Vestergaard Hanaen","name":"Vestergaard Hanaen, Line","rank":4,"rolecode":"pau"}],"pub":{"edition":"1","isbn":["9788771126648"],"pages":"5-38","publisher":"Aalborg Universitetsforlag","status":"p","subtitle":"Violent Exchange and the policing of the urban poor","title":"Corruption and torture"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Governmental Institutions","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-U","DI-U-ALL","Governmental Institutions","Universities"],"PST":["Published"]},"sid":["aau-1c501134-6be4-4939-bd07-cc6bff938509"],"src":["AAU Aalborg University"],"title":"Introduction : Towards Violent Exchange","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-058326","year":"2017","yearsub":"2017"}
{"abstract":"PURPOSE: To examine the association between retinal vessel diameters and retinopathy in participants with and without type 2 diabetes in a Danish population-based cohort. METHODS: The study included 878 persons aged 30 to 60 years from the Inter99 Eye Study. Retinopathy was defined as a presence of one or more retinal hemorrhages or one or more microaneurysms. Vessel diameters were expressed as central retinal artery equivalent diameter (CRAE) and central retinal vein equivalent diameter (CRVE). Multiple linear regression analyses were performed. RESULTS: Among participants with diabetes, CRAE was 6.3 µm (CI 95%: 1.0 to 11.6, p = 0.020) wider and CRVE was 7.9 µm (CI 95%: 0.7 to 15.2, p = 0.030) wider in those with retinopathy compared to those without retinopathy, after adjusting for age, gender, HbA1c, blood pressure, smoking, serum total and HDL cholesterol. In all participants, CRAE increased with presence of retinopathy (p = 0.005) and with smoking (p = 0.001), and CRAE decreased with hypertension (p < 0.001), high HDL cholesterol (p = 0.016) and age (p < 0.001). Central retinal vein equivalent diameter increased with presence of retinopathy (p = 0.022) and with smoking (p < 0.001), and decreased with higher HDL cholesterol (p < 0.001) and age (p = 0.015). Female gender was associated with wider CRVE (p = 0.029). CONCLUSIONS: Wider retinal vessel diameters were associated with the presence of retinopathy in participants with diabetes, but not in participants without diabetes. The associations between retinal vessel diameters and known retinopathy risk factors were confirmed. These results suggest that information obtained by non-invasive imaging of the interior of the eye can contribute to a better understanding of systemic disease processes.","author_count":7,"contributors":["Drobnjak, Dragana","Munch, Inger Christine","Glümer, Charlotte","Færch, Kristine","Kessel, Line","Larsen, Michael","Veiby, Nina C B B"],"cuid":["S01-000.00-402425"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"relationship between retinal vessel diameters and retinopathy in the inter000000000099 eye study","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.jcte.2017.03.002","version":"Published Version"},"id":"S01-000.00-402425","identifier":[{"id":"PMC5651334","type":"pmcid"},{"id":"29067255","type":"pmid"},{"id":"85017166938","type":"scopus"}],"ids":["ku-0f1a97b9-a533-4b0b-96eb-0898b6967fef"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-B10904E89DE53905A7BB4531532652DC"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/194637362/1_s2.0_S2214623717300029.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.jcte.2017.03.002","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Dragana","key":"drobnjakpau","last":"Drobnjak","name":"Drobnjak, Dragana","rank":1,"rolecode":"pau"},{"affno":"1","first":"Inger Christine","key":"munchpau","last":"Munch","locid":"a1af1ee5-c4b4-44d8-a