Copenhagen University Hospital - Næstved, Slagelse and Ringsted"],"nora_code":"DI-HO-ZEA","used":1}],"person":[{"affno":"1 2","corresponding":null,"country":"dk","first":"Linda Aagaard","key":"rasmussenpau","last":"Rasmussen","locid":"321bbf64-b73e-4077-8d16-ba3df95fbbe2","name":"Rasmussen, Linda Aagaard","orcid":"0000-0002-9753-2008","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Niels Lyhne","key":"christensenpau","last":"Christensen","locid":"602d74ce-1885-499c-90da-05dd61bb3148","name":"Christensen, Niels Lyhne","rank":2,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"country":"dk","first":"Anne","key":"wintherlarsenpau","last":"Winther-Larsen","locid":"162faab4-e6ad-4fce-8149-eafe733901ec","name":"Winther-Larsen, Anne","orcid":"0000-0002-2763-595X","rank":3,"rolecode":"pau"},{"affno":"4 5 6","first":"Susanne Oksbjerg","key":"daltonpau","last":"Dalton","locid":"84d10468-fe5d-4cc7-952f-1d89d961390f","name":"Dalton, Susanne Oksbjerg","rank":4,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Line Flytkjær","key":"virgilsenpau","last":"Virgilsen","locid":"6ff51f4d-e27a-4646-8a7a-0123c17fddc7","name":"Virgilsen, Line Flytkjær","rank":5,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Henry","key":"jensenpau","last":"Jensen","locid":"335c9045-5b3d-4141-9fea-fe6e2c71f62e","name":"Jensen, Henry","rank":6,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Peter","key":"vedstedpau","last":"Vedsted","locid":"bb00d9e7-866c-4f04-8e3b-a71c913c39b0","name":"Vedsted, Peter","orcid":"0000-0003-2113-5599","rank":7,"rolecode":"pau"}],"pmid":["36890800"],"pub":{"doi":"10.2147/clep.s396738","issn":["11791349"],"journal":"Clinical Epidemiology","pages":"251-261","publisher":"Dove Medical Press Ltd","status":"p","title":"Clinical Epidemiology","title_org":"Clinical epidemiology","volume":"15"},"review":"Peer Reviewed","scoID":["2-s2.0-85149645758"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Non-Profit Organisations","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-NP","DI-NP-ALL","DI-U","DI-U-ALL","Hospitals","Non-Profit Organisations","Other Hospitals","Region Zealand","Universities","University of Copenhagen","the research unit for general practice"],"PST":["Published"]},"sid":["au-7a570e89-4ed2-484e-8226-6d0cc3f92450","ku-7966fda5-ab83-49de-b10c-ccdf93a63227"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"A Validated Register-Based Algorithm to Identify Patients Diagnosed with Recurrence of Surgically Treated Stage I Lung Cancer in Denmark","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.94-685971","year":"2023","yearsub":"2023"}
{"abstract":"Background: Many children and adolescents with incurable cancer and their families prefer to receive end-of-life care and to die at home. This implies a transition of care from hospital to home and presupposes the establishment of a well-functioning collaboration between the family and professionals across health care sectors. Aim: To identify and explore key elements of home-based end-of-life care collaboration for children with cancer, as experienced by their parents and grandparents and the hospital- and community-based professionals involved. Design: Descriptive qualitative multiple-case study. Data were collected by semi-structured interviews and written responses to open-ended questions, and analyzed inductively across cases using qualitative content analysis. Setting/participants: Cases comprised a criterion sample of five children (aged <18 years), who died of cancer at home. Cases were represented by the children’s bereaved parents (n = 8) and grandparents (n = 7), and community-based professionals (n = 16). Also, hospital-based professionals (n = 10) were interviewed about the children’s end-of-life care through group interviews. Results: We identified five main themes, describing key elements of the end-of-life collaboration: Establishing the collaboration, Bolstering family life, Elucidating organization and integration, Managing challenges, and Closing the collaboration. These themes all came under the overarching theme: A mutual trust-based collaboration. On this basis, we developed the “Home-Based Pediatric End-of-Life Care Model for Children with Cancer.” Conclusions: By highlighting key elements in the family-centered, intersectoral and interprofessional end-of-life care collaboration, our “Home-Based Pediatric End-of-Life Care Model for Children with Cancer” offers a framework for further optimization of home-based end-of-life care services for children with cancer and their families.","author_count":9,"contributors":["Hammer, Nanna Maria","Hansson, Helena","Pedersen, Line Hjøllund","Abitz, Maja","Sjøgren, Per","Schmiegelow, Kjeld","Bidstrup, Pernille Envold","Larsen, Hanne Bækgaard","Olsen, Marianne"],"cuid":["S02-100.00-691694"],"filters":{"added":"2023-02","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Olsen, Marianne"],"keyword":["Adolescent","Child","Home Care Services","Intersectoral collaboration","Palliative care","Pediatrics","Qualitative Research","Terminal Care"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-NP","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-NDR"],"NP":["DI-NP-ALL","DI-NP-CAN"],"U":["DI-U-AAU","DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-HO-NDR","DI-NP-CAN","DI-U-AAU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"intersectoral collaboration in home based end of life pediatric cancer care a qualitative multiple case study integrating families and professionals experiences","src":["aau","ku"],"src-code":["DI-U-AAU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85142382798&partnerID=8YFLogxK","version":"Other Version"},"funding_acknowledgement":["The author(s) disclosed receipt of the following financial support for the research, authorship, and/or publication of this article: This work was supported by the Danish Cancer Society [grant number R173-A11326-17-S51]; the Health Foundation [grant number 19-B-0045]; Axel Muusfeldts Fund [grant number 2019-0137]; Dagmar Marshalls Foundation [grant number 500020]; and Tømrermester Jørgen Holm og Hustru Elisa f. Hansens Mindelegat [grant number 21110]. We would like to extend our gratitude to all the participating families and professionals for sharing their experiences with us. This work is part of Childhood Oncology Network Targeting Research, Organisation & Life expectancy (CONTROL). The author(s) disclosed receipt of the following financial support for the research, authorship, and/or publication of this article: This work was supported by the Danish Cancer Society [grant number R173-A11326-17-S51]; the Health Foundation [grant number 19-B-0045]; Axel Muusfeldts Fund [grant number 2019-0137]; Dagmar Marshalls Foundation [grant number 500020]; and Tømrermester Jørgen Holm og Hustru Elisa f. Hansens Mindelegat [grant number 21110]."],"id":"S02-100.00-691694","identifier":[{"id":"36397271","type":"pmid"},{"id":"85142382798","type":"scopus"}],"ids":["aau-1743d308-917e-492b-8c78-06111b1eb120","ku-12320a8f-ef6d-4e25-83bd-8ffca8c4672a"],"keyword":["Child","adolescent","home care services","intersectoral collaboration","palliative care","pediatrics","qualitative research","terminal care"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-E08A8576FAC3F6A422B0169C575067B1"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","country":"dk","key":"dcrc danish cancer society research center","l2":"DI-NP","l2n":"Non-Profit Organisations","l3":"DI-NP-CAN","l3nn":"DCRC Danish Cancer Society Research Center","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DCRC Danish Cancer Society Research Center","namevar":["Danish Cancer Society"],"nora_code":"DI-NP-CAN","used":1},{"affno":"4","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Paediatrics"],"nora_code":"DI-U-AAU","used":1},{"affno":"5","country":"dk","key":"north denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-NDR","l3nl":"North Denmark Region","l3nn":"North Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"North Denmark Region","namevar":["Aalborg University Hospital"],"nora_code":"DI-HO-NDR","used":1}],"person":[{"affno":"1 2","first":"Nanna Maria","key":"hammerpau","last":"Hammer","locid":"95371952-5d3a-46e6-8e82-0faf5f538aae","name":"Hammer, Nanna Maria","rank":1,"rolecode":"pau"},{"affno":"1","first":"Helena","key":"hanssonpau","last":"Hansson","locid":"b9e04041-9e68-4a36-a738-a6deb1882728","name":"Hansson, Helena","rank":2,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Line Hjøllund","key":"pedersenpau","last":"Pedersen","name":"Pedersen, Line Hjøllund","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Maja","key":"abitzpau","last":"Abitz","name":"Abitz, Maja","rank":4,"rolecode":"pau"},{"affno":"1 2","first":"Per","key":"sjøgrenpau","last":"Sjøgren","locid":"a319b935-f316-4a9c-88b7-8cabd19b1952","name":"Sjøgren, Per","orcid":"0000-0002-3822-2958","rank":5,"rolecode":"pau"},{"affno":"1","first":"Kjeld","key":"schmiegelowpau","last":"Schmiegelow","locid":"6ce2f948-244d-4f19-82aa-f08a71289674","name":"Schmiegelow, Kjeld","rank":6,"rolecode":"pau"},{"affno":"3 1","first":"Pernille Envold","key":"bidstruppau","last":"Bidstrup","locid":"7cef3894-8d41-4b9b-acec-95b1d1b3f890","name":"Bidstrup, Pernille Envold","rank":7,"rolecode":"pau"},{"affno":"1","first":"Hanne Bækgaard","key":"larsenpau","last":"Larsen","locid":"88b48e37-454f-41e8-a110-a385dce66a6e","name":"Larsen, Hanne Bækgaard","rank":8,"rolecode":"pau"},{"affno":"2 4 5","corresponding":null,"first":"Marianne","key":"olsenpau","last":"Olsen","locid":"dc242145-c4fd-4904-a5d9-5765213006c5","name":"Olsen, Marianne","rank":9,"rolecode":"pau"}],"pmid":["36397271"],"pub":{"doi":"10.1177/02692163221135350","issn":["02692163","1477030X"],"issn_org":["02692163"],"issue":"1","journal":"Palliative Medicine","pages":"149-162","publisher":"SAGE Publications","status":"p","title":"Palliative Medicine","title_org":"Palliative medicine","volume":"37"},"review":"Peer Reviewed","scoID":["2-s2.0-85142382798"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Non-Profit Organisations","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-NP","DI-NP-ALL","DI-U","DI-U-ALL","Hospitals","Non-Profit Organisations","North Denmark Region","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["aau-1743d308-917e-492b-8c78-06111b1eb120","ku-12320a8f-ef6d-4e25-83bd-8ffca8c4672a"],"src":["AAU Aalborg University","KU University of Copenhagen"],"title":"Intersectoral collaboration in home-based end-of-life pediatric cancer care : A qualitative multiple-case study integrating families' and professionals' experiences","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-691694","year":"2023","yearsub":"2023"}
{"abstract":"Background: Adolescents and young adults often experience existential concerns in addition to side effects during a cancer trajectory, which they often carry alone. Thus, cohesion with other adolescents and young adults with cancer is essential but difficult due to the relatively small, widely dispersed nationwide population. In cocreation, a smartphone app has been developed and includes an information bank, a symptom tracker, and a social community platform, aiming to improve the quality of life (QoL) in this patient group. Objective: This nationwide, multicenter study aimed to investigate the QoL in adolescents and young adults undergoing a cancer trajectory as they used the app for 6 weeks. Methods: Via youth support initiatives, participants were recruited from hospitals in all regions of Denmark. Inclusion criteria were patients with cancer aged 15-29 years who either initiated any cancer treatment or started follow-up after cancer treatment within 30 days. Participants used the adolescents and young adults cancer app for 6 weeks. Before and after the 6 weeks of app use, they completed the European Organization for Research and Treatment of Cancer Quality of Life Questionnaire Core 30 (EORTC QLQ-C30). The participants were divided into a treatment and a follow-up group for analysis. A high score for a functional scale or the global health or overall QoL represents a high or healthy level of functioning or high QoL, respectively; however, a high score for a symptom scale or item represents a high level of symptomatology. Results: Overall, 81 participants were recruited. However, 4 participants did not answer the questionnaire and 6 participants did not use the app. In the treatment group (n=36), significant improvement was found in 2 domains: “Role functioning” (baseline median 33.33, IQR 16.67-83.33 vs 6 weeks median 66.67, IQR 33.33-83.33; P=.04) and “Pain” (baseline median 33.33, IQR 16.67-50.00 vs 6 weeks median 16.67, IQR 0.00-33.33; P=.04). The “Global health/Overall QoL” scale remained stable (baseline median 58.33, IQR 45.83-77.08 vs 6 weeks median 62.50, IQR 41.67-75.00; P=.25). In the follow-up group (n=35), significant improvement was found in 3 domains: “Physical functioning” (baseline median 79.23, IQR 73.33-93.33 vs 6 weeks median 82.86, IQR 73.33-100.00; P=.03), “Cognitive functioning” (baseline median 62.38, IQR 50.00-83.33 vs 6 weeks median 69.52, IQR 50.00-100.00; P=.02), and “Social functioning” (baseline median 76.19, IQR 50.00-100.00 vs 6 weeks median 85.71, IQR 83.33-100.00; P=.05), as well as in the “Global health/Overall QoL” scale (baseline median 57.14, IQR 83.33-100.00 vs 6 weeks median 75.0, IQR 62.91-85.73; P<.001). Conclusions: In this study, we found an improvement in specific QoL scales for both participants in treatment and follow-up when using the app for 6 weeks. The global health or overall QoL score improved significantly in the follow-up group. In the treatment group, it remained stable. International Registered Report Identifier (IRRID): RR2-10.2196/10098","author_count":8,"contributors":["Bentsen, Line","Hanghøj, Signe","Hjerming, Maiken","Bergmann, Mette Buur","Thycosen, Marianne","Borup, Anette","Larsen, Camilla","Pappot, Helle"],"cuid":["S02-100.00-703614"],"filters":{"added":"2024-02","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Bentsen, Line"],"keyword":["Adolescent","Application","Cancer","Denmark","Development","Grief","Mobile phone","Physical functioning","Quality of Life","Smartphone application","Social community","Treatment","Young Adult","Youth","eHealth","interventional study","symptom tracker"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA"],"U":["DI-U-AAU","DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA","DI-U-AAU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"development of quality of life in adolescents and young adults with cancer using a patient support smartphone app prepost interventional study","src":["aau","sdu"],"src-code":["DI-U-AAU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.2196/49735","version":"Published Version"},"funding_acknowledgement":["All departments mentioned were essential collaboration partners regarding recruitment and study conduction. Additionally, the participation of adolescents and young adults with cancer is highly appreciated. Finally, thanks to Julius Lund-Jacobsen, CEO at Viceron ApS, for support in the statistical program R during the statistical analysis phase. This study was financially supported by Tryg Fonden (grant 120451).","This study was financially supported by Tryg Fonden (grant 120451)."],"id":"S02-100.00-703614","identifier":[{"id":"85180427770","type":"scopus"},{"id":"PMC10734624","type":"pmcid"},{"id":"38048144","type":"pmid"}],"ids":["aau-3ad8eaeb-9f23-4953-ac86-d59bbf0ac27d","sdu-83cd1f06-221c-4676-bc05-88a55d7f87c2"],"keyword":["Denmark","adolescent","application","cancer","development","eHealth","grief","interventional study","mobile phone","physical functioning","quality of life","smartphone application","social community","symptom tracker","treatment","young adult","youth"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-F7D8CC1294386BA404153BF050202ADA"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.2196/49735","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/252659632/PDF.pdf","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/626849430/Bentsen_et_al._2023_._Development_of_Quality_of_Life_in_Adolescents_and_Young_Adults_With_Cancer_Using_a_Patient_Support_Smartphone_App_-_Prepost_Interventional_Study.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Rigshospitalet, Copenhagen University Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","country":"dk","key":"region zealand","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-ZEA","l3nl":"Region Zealand","l3nn":"Region Zealand","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region Zealand","namevar":["Zealand University hospital"],"nora_code":"DI-HO-ZEA","used":1},{"affno":"3","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Oncology (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"4","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Odense University Hospital"],"nora_code":"DI-HO-SDR","used":1},{"affno":"5","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1},{"affno":"6","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Haematology"],"nora_code":"DI-U-AAU","used":1},{"affno":"7","country":"dk","key":"north denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-NDR","l3nl":"North Denmark Region","l3nn":"North Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"North Denmark Region","namevar":["Aalborg University Hospital"],"nora_code":"DI-HO-NDR","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Line","key":"bentsenpau","last":"Bentsen","name":"Bentsen, Line","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Signe","key":"hanghøjpau","last":"Hanghøj","name":"Hanghøj, Signe","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Maiken","key":"hjermingpau","last":"Hjerming","name":"Hjerming, Maiken","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Mette Buur","key":"bergmannpau","last":"Bergmann","name":"Bergmann, Mette Buur","rank":4,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Marianne","key":"thycosenpau","last":"Thycosen","locid":"35ce8a27-3d21-47ca-a4e7-2ab1e74e756d","name":"Thycosen, Marianne","rank":5,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Anette","key":"boruppau","last":"Borup","name":"Borup, Anette","rank":6,"rolecode":"pau"},{"affno":"6 7","corresponding":null,"first":"Camilla","key":"larsenpau","last":"Larsen","locid":"5612e915-7572-4138-b28c-483d1c19a422","name":"Larsen, Camilla","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Helle","key":"pappotpau","last":"Pappot","name":"Pappot, Helle","rank":8,"rolecode":"pau"}],"pmid":["38048144"],"pub":{"doi":"10.2196/49735","issn":["23691999"],"issue":"1","journal":"JMIR Cancer","paperid":"e49735","publisher":"JMIR Publications","status":"p","title":"JMIR Cancer","title_org":"JMIR cancer","volume":"9"},"review":"Peer Reviewed","scoID":["2-s2.0-85180427770"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Region Zealand","Region of Southern Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-3ad8eaeb-9f23-4953-ac86-d59bbf0ac27d","sdu-83cd1f06-221c-4676-bc05-88a55d7f87c2"],"src":["AAU Aalborg University","SDU University of Southern Denmark"],"title":"Development of Quality of Life in Adolescents and Young Adults With Cancer Using a Patient Support Smartphone App: Prepost Interventional Study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-703614","year":"2023","yearsub":"2023"}
{"abstract":"I Danmark dør mennesker med svære psykiske lidelser i gennemsnit 7-10 år tidligere end den øvrige befolkning. Selvom en del af denne overdødelighed skyldes selvmord, kan størstedelen, op imod 60 procent, tilskrives somatiske sygdomme. Den store overdødelighed tydeliggør behovet for øget forebyggelse, tidlig diagnosticering og kvalitet i den somatiske behandling af patienter med psykisk lidelse. Dette er den første af to rapporter, som Behandlingsrådet publicerer vedrørende ulighed i sundhed i 2023 og 2024 under temaet ”Ulighed i den somatiske behandling af patienter med psykiske lidelser”. Rapporterne fokuserer på det danske sundhedsvæsen. Formålet med Behandlingsrådets analyse (2022) er at belyse eventuelle uligheder i somatisk behandling og sygdomsudfald hos patienter med psykisk lidelse sammenlignet med patienter uden psykisk lidelse. Endvidere undersøges betydningen af uddannelse og geografisk bopæl i forhold til eventuelle uligheder mellem patienter med og uden psykisk lidelse","author_count":29,"contributors":["Grønbæk, Morten Klöcker","Andersen, Pernille Tanggaard","Vestergaard, Mogens","Fleming, Emma","Hageman, Ida","Larsen, Finn Breinholt","Caspersen, Lene","Larsen, Beth Bülow","Ulrichsen, Susanne Stockmal","Borup, Kit","Andersen, Lisbeth Lauge","Nielsen, René Ernst","Nordentoft, Merete","Tipsmark, Line Stjernholm","Andersen, Lærke Mai Bonde","Christensen, Pernille Skovgaard","Jeppesen, Josefine Klakk","Johnsen, Søren Paaske","Knudsen, Søren Valgreen","Valentin, Jan Brink"],"cuid":["S03-081.32-792812"],"filters":{"added":"2023-03","altsrc":["No Matches Found"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"corpau":["Dansk Center for Klinisk Sundhedstjenesteforskning (DACS), Aalborg Universitet","Fagudvalget for ulighed i somatisk behandling af patienter med psykiske lidelser","Projektgruppen i Behandlingsrådets sekretariat"],"level":"sci","mra":["hum","med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"leve