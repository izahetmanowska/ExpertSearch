6d9c3","name":"Dalhoff, Kim","name_org":"Dalhoff, Kim Peder","rank":6,"rolecode":"pau"},{"affno":"1","first":"Ove","key":"andersenpau","last":"Andersen","locid":"251ac7c3-391a-4cd6-8696-6d5f1ee26911","name":"Andersen, Ove","orcid":"0000-0002-2274-548X","rank":7,"rolecode":"pau"},{"affno":"2","first":"Jesper","key":"eugenolsenpau","last":"Eugen-Olsen","name":"Eugen-Olsen, Jesper","rank":8,"rolecode":"pau"},{"affno":"2 5 1","first":"Morten Baltzer","key":"houlindpau","last":"Houlind","name":"Houlind, Morten Baltzer","rank":9,"rolecode":"pau"}],"pmid":["34242432"],"pub":{"doi":"10.1111/bcp.14982","issn":["02643774","03065251"],"issn_org":["03065251"],"issue":"4","journal":"British Journal of Clinical Pharmacology","pages":"1679-1690","status":"p","title":"British Journal of Clinical Pharmacology","volume":"88"},"review":"Peer Reviewed","scoID":["2-s2.0-85111670741"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-c4f1b211-3277-442e-bb70-7aa752ccd4ad"],"src":["KU University of Copenhagen"],"title":"Using soluble urokinase plasminogen activator receptor to stratify patients for medication review in the emergency department","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-510970","year":"2022","yearsub":"2022"}
{"abstract":"This thesis investigates the future of the Cloud-Radio Access Network (C-RAN) architecture and its applicability in future mobile networks. Thus, it analyses if C-RAN deployment is worth the trouble of replacing the RAN equipment of a whole mobile network. C-RAN is an evolving mobile network architecture that aims at centralising and virtualising the radio processing functions in three processing units connected by a crosshaul network. Throughout this thesis, the C-RAN architecture is investigated for different functional split options, various crosshaul network opportunities and crosshaul energy consumption. Starting out with a state-of-the-art overview of the different functional split opportunities and quantifying their capabilities according to their location in the radio processing protocol stack. The crosshaul network must comply with heavy requirements to the bitrate and latency and thus different deployment options are analysed including opportunities for sharing the crosshaul network with other traffic sources. Depending on the functional split chosen, the crosshaul bitrate is fixed or varying with user load. A crosshaul bitrate that varies will not occupy the same amount of transport resources all the time. This creates a statistical multiplexing gain enabling capacity to be shared between different sources. However, crosshaul link sharing will add additional latency to the time sensitive transmission, which limits the crosshaul range. Further, this thesis will investigate if existing links can carry crosshaul traffic for improved sustainability. Energy consumption is an important player in the design of future mobile networks, and C-RAN is envisioned to reduce energy consumption in the radio processing units. This work investigates the energy consumption in the crosshaul network by presenting energy consumption models, designed and tested by theoretical calculations. The models show that for different functional splits, the energy consumption in the crosshaul network can reduce 28% considering 4G, but in 5G, it can save up to 99% when different splits are chosen. In conclusion, C-RAN will optimise future mobile networks, but at the cost of user latency and limited opportunities for crosshaul network deployment as well as transport network energy consumption. Thus, C-RAN is not optimal for extreme latency sensitive scenarios. However, depending on the functional split chosen, the C-RAN architecture will bring benefits such as enhanced interference management, mobility management and resource utilisation. Hence, different combinations of functional splits and functional placements will be applicable to different areas depending on cell density and existing crosshaul transport opportunities.","author_count":1,"contributors":["Larsen, Line Maria Pyndt"],"cuid":["S01-000.00-669548"],"filters":{"added":"2023-06","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"und","rtype":["clu"],"sorti":"future mobile networks optimisation using cloud ran architecture","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dtp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/322667975/Line_Maria.pdf","version":"Published Version"},"id":"S01-000.00-669548","ids":["dtu-fe79bd95-8c1f-4004-9fe3-e27e535708ad"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-53C09845D8EE912CDD93EBE3657AF194"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/322667975/Line_Maria.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Electrical and Photonics Engineering","Technical University of Denmark, Department of Electrical and Photonics Engineering, Networks Technology and Service Platforms"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Line Maria Pyndt","key":"larsenpau","last":"Larsen","locid":"e76034cd-61d0-43dd-8c6d-0aa95c672b80","name":"Larsen, Line Maria Pyndt","orcid":"0000-0002-6402-5851","rank":1,"rolecode":"pau"}],"pub":{"pages":"180","publisher":"Technical University of Denmark","status":"p"},"review":"Undetermined","sdg":["7. Affordable and Clean Energy","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-fe79bd95-8c1f-4004-9fe3-e27e535708ad"],"src":["DTU Technical University of Denmark"],"title":"Future Mobile Networks Optimisation using Cloud-RAN Architecture","type":"Thesis PhD","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-669548","year":"2022","yearsub":"2023"}
{"abstract":"The blue-green autofluorescence of the ocular lens increases with age, glycemia and smoking, as the irreplaceable structural proteins of the lens slowly accumulate damage from the encounter with reactive molecular species. We have conducted a prospective study of lens autofluorescence over two decades in a twin cohort. The study included 131 phakic, non-diabetic adult twins (median age at follow-up 58 years, range 41–66 years) who were examined twice at an interval of 21 years. Change in anterior lens peak autofluorescence was analyzed in relation to age, current and baseline glycemia, cumulative smoking and heritability. The level of lens autofluorescence in the study population increased as a function of age and smoking (p ≤.002), but not as a function of glycemia (p ≥.069). Lens autofluorescence remained a highly heritable trait (90.6% at baseline and 93.3% at follow-up), but whereas the combined effect of age and cumulative smoking explained 57.2% of the variance in lens autofluorescence at baseline in mid-life, it only accounted for 31.6% at followup 21 years later. From mid to late adulthood, the level of blue-green fluorescence remained overwhelmingly heritable, but became less predictable from age, smoking habits and glycemic status. Presumably, as the lens ages, its intrinsic characteristics come to dominate over environmental and systemic factors, perhaps in a prelude to the development of cataract.","author_count":8,"contributors":["Bjerager, Jakob","Dabbah, Sami","Belmouhand, Mohamed","Kessel, Line","Hougaard, Jesper Leth","Rothenbuehler, Simon P.","Sander, Birgit","Larsen, Michael"],"cuid":["S02-089.29-042078"],"filters":{"added":"2022-08","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Bjerager, Jakob"],"country":["Sweden","Switzerland"],"glorg":["All Global Affiliations","Lund University","University Hospital of Basel","University of Basel"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-SDR","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"long term development of lens fluorescence in a twin cohort heritability and effects of age and lifestyle","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1371/journal.pone.0268458","version":"Published Version"},"id":"S02-089.29-042078","identifier":[{"id":"35617652","type":"pmid"},{"id":"PMC9135443","type":"pmcid"},{"id":"85130819672","type":"scopus"}],"ids":["ku-4846af4d-5233-4400-982d-ef43d5e43ea3","sdu-663d11ef-d17b-4b4a-a440-08b7bffe57a1"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-A87763436EC72922861CDA55B8A56AFA"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/321642935/journal.pone.0268458.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/204221241/journal.pone.0268458.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1371/journal.pone.0268458","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Ophthalmology (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"3","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Odense University Hospital"],"nora_code":"DI-HO-SDR","used":1},{"affno":"4","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"5","country":"se","key":"lund university","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Lund University","used":1},{"affno":"6","country":"ch","key":"university of basel","loc":["Switzerland","Europe, Non-EU","OECD"],"name":"University of Basel","used":1},{"affno":"7","country":"ch","key":"university hospital of basel","loc":["Switzerland","Europe, Non-EU","OECD"],"name":"University Hospital of Basel","used":1}],"person":[{"affno":"1","first":"Jakob","key":"bjeragerpau","last":"Bjerager","name":"Bjerager, Jakob","rank":1,"rolecode":"pau"},{"affno":"1 2 3","corresponding":null,"first":"Sami","key":"dabbahpau","last":"Dabbah","locid":"9a767e15-695d-437f-9e65-7d7bd7d03df2","name":"Dabbah, Sami","rank":2,"rolecode":"pau"},{"affno":"4 1","first":"Mohamed","key":"belmouhandpau","last":"Belmouhand","locid":"e0ba6ba9-7141-4aa9-9752-ffda8d896814","name":"Belmouhand, Mohamed","rank":3,"rolecode":"pau"},{"affno":"4","first":"Line","key":"kesselpau","last":"Kessel","locid":"3201472a-2f23-417e-bd01-a7950e2ff370","name":"Kessel, Line","orcid":"0000-0002-9375-1510","rank":4,"rolecode":"pau"},{"affno":"5","first":"Jesper Leth","key":"hougaardpau","last":"Hougaard","name":"Hougaard, Jesper Leth","rank":5,"rolecode":"pau"},{"affno":"1 6 7","first":"Simon P.","key":"rothenbuehlerpau","last":"Rothenbuehler","name":"Rothenbuehler, Simon P.","rank":6,"rolecode":"pau"},{"affno":"1","first":"Birgit","key":"sanderpau","last":"Sander","name":"Sander, Birgit","rank":7,"rolecode":"pau"},{"affno":"4","first":"Michael","key":"larsenpau","last":"Larsen","locid":"1d460214-c0db-4a15-a3a5-360c73746ed4","name":"Larsen, Michael","rank":8,"rolecode":"pau"}],"pmid":["35617652"],"pub":{"doi":"10.1371/journal.pone.0268458","issn":["19326203"],"issue":"5","journal":"PLOS ONE","paperid":"e0268458","publisher":"Public Library of Science","status":"p","title":"PLOS ONE","volume":"17"},"review":"Peer Reviewed","scoID":["2-s2.0-85130819672"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-4846af4d-5233-4400-982d-ef43d5e43ea3","sdu-663d11ef-d17b-4b4a-a440-08b7bffe57a1"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Long-term development of lens fluorescence in a twin cohort : Heritability and effects of age and lifestyle","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-089.29-042078","year":"2022","yearsub":"2022"}
{"abstract":"OBJECTIVE: A patient-focused approach is advocated to embody risk of non-adherence to medication and subsequent adverse clinical outcomes following ischaemic heart disease (IHD). This study aimed to explore how patient perceived information on pharmacological prevention was associated with subsequent non-adherence to medication (measured by non-initiation, non-implementation and non-persistence) in patients with incident IHD. DESIGN: Cohort study. SETTING: Denmark. PARTICIPANTS: Register-based cohort of 829 patients with incident IHD in 2013. MEASURES: Perception covered whether patients' experienced being adequately informed about their pharmacological prevention. Information on such was obtained from a survey and divided into 'Well informed', 'Moderately informed' and 'Poorly informed'. Information on baseline characteristics, and reimbursed prescriptions of medication (antiplatelets, statins, ACE-inhibitors/angiotensin receptor blockers and β-blockers) during follow-up were obtained by linkage to nationwide public registers. Non-initiation and non-implementation of medication, measured as proportion of days covered, were analysed by Poisson regression. Non-persistence to medication, measured as risk of discontinuation, was analysed by multivariable Cox proportional hazard regression. PRIMARY AND SECONDARY OUTCOME MEASURES: Non-implementation and non-persistence to medication up to 365 days of follow-up were primary outcomes. Secondary outcomes included non-initiation as well as non-implementation and non-persistence to medication at 180 days of follow-up. RESULTS: A dose-response association was in general found between perception of pharmacological prevention and risk of non-implementation and non-persistence. For example, the hazard of non-persistence to antiplatelets was 1.18 (95% CI 0.71 to 1.96) times higher for patients reporting 'Moderately informed' and 1.89 (95% CI 1.10 to 3.25) times higher for patients reporting 'Poorly informed', compared with patients reporting 'Well informed of perception of pharmacological prevention' up to 365 days of follow-up. CONCLUSION: Lower levels of perception of pharmacological prevention were associated with subsequent non-implementation and non-persistence to medication in patients with incident IHD.","author_count":7,"contributors":["Graversen, Carina","Valentin, Jan Brink","Larsen, Mogens Lytken","Riahi, Sam","Holmberg, Teresa","Zinckernagel, Line","Johnsen, Søren Paaske"],"cuid":["S02-099.93-007141"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Graversen, Carina","Graversen, Christina Boesgaard"],"keyword":["Angiotensin Converting Enzyme Inhibitors therapeutic use","Cohort Studies","Epidemiology","Humans","Ischaemic heart disease","Medication Adherence","Myocardial Ischemia drug therapy","Perception","Rehabilitation medicine","Retrospective Studies"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-NDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-NDR","DI-U-AAU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"perception of pharmacological prevention and subsequent non adherence to medication in patients with ischaemic heart disease a population based cohort study","src":["aau","sdu"],"src-code":["DI-U-AAU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1136/bmjopen-2021-054362","version":"Published Version"},"id":"S02-099.93-007141","identifier":[{"id":"85122856332","type":"scopus"},{"id":"34983767","type":"pmid"},{"id":"PMC8728472","type":"pmcid"}],"ids":["aau-934fded9-69c5-47c0-82d9-26782e80f0f2","sdu-f1250088-9f8e-49c1-9b76-10c7b97f8579"],"keyword":["Angiotensin-Converting Enzyme Inhibitors/therapeutic use","Cohort Studies","Epidemiology","Humans","Ischaemic heart disease","Medication Adherence","Myocardial Ischemia/drug therapy","Perception","Rehabilitation medicine","Retrospective Studies"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-F7C02DA3D28DBDD9F8A6330010F3C51D"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1136/bmjopen-2021-054362","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/204011036/e054362.full.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/459364551/Graversen_et_al._2022_._Perception_of_pharmacological_prevention_and_subsequent_non_adherence_to_medication_in_patients_with_ischaemic_heart_disease_a_population_based_cohort_study.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Cardiology","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Anæstesi, Børn, Kredsløb og Kvinder","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"dk","key":"north denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-NDR","l3nl":"North Denmark Region","l3nn":"North Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"North Denmark Region","namevar":["Aalborg University Hospital"],"nora_code":"DI-HO-NDR","used":1},{"affno":"3","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, National Institute of Public Health","SDU, The Faculty of Health Sciences, National Institute of Public Health, Department of Health and Social Context"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Christina Boesgaard","key":"graversenpau","last":"Graversen","locid":"1a492e53-95ad-4972-97e8-acd622d17ec9","name":"Graversen, Carina","name_org":"Graversen, Christina Boesgaard","orcid":"0000-0001-8392-058X","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jan Brink","key":"valentinpau","last":"Valentin","locid":"4fbcfaf7-a4af-46c9-b3b4-f113b45baf05","name":"Valentin, Jan Brink","orcid":"0000-0002-8205-7179","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mogens Lytken","key":"larsenpau","last":"Larsen","locid":"4dd22edc-ce70-44c0-beff-7afe7a9c8c47","name":"Larsen, Mogens Lytken","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Sam","key":"riahipau","last":"Riahi","locid":"9e5489d8-981a-469c-bd84-20b2e24832de","name":"Riahi, Sam","orcid":"0000-0003-1849-9463","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Teresa","key":"holmbergpau","last":"Holmberg","locid":"5d9ee90d-40f1-460b-b2ed-93a9d7ac67af","name":"Holmberg, Teresa","orcid":"0000-0002-4671-3810","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Line","key":"zinckernagelpau","last":"Zinckernagel","locid":"b51646a2-7805-43c0-b7cb-1078babcf287","name":"Zinckernagel, Line","orcid":"0000-0002-0141-4374","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren Paaske","key":"johnsenp