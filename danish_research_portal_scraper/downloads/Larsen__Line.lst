ersities","All University Colleges","DI-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","Universities","University College Absalon","University Colleges","University of Copenhagen","VIA University College"],"PST":["Published"]},"sid":["via-f2a85399-c8d0-45b0-9a9d-8590ede3025f"],"src":["VIA University College"],"title":"Borgeren, der modtager palliativ indsats i eget hjem eller på hospice","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-661722","year":"2023","yearsub":"2023"}
{"abstract":"Mobile network traffic is increasing and so is the energy consumption. The Radio Access Network (RAN) part is responsible for the largest share of the mobile network energy consumption, and thus; an important consideration when expanding mobile networks to meet traffic demands. This work analyses how the energy consumption of future mobile networks can be minimised by using the right RAN architecture, share the network with other operators and implementing the most efficient energy minimising technologies in the RAN. It is explored how the different approaches can be realised in real life networks as well as the research state of the art is highlighted. Furthermore, this work provides an overview of future research directions for 6G energy saving potentials. Different energy saving contributions are evaluated by a common methodology for more realistic comparison, based on the potential energy saving of the overall mobile network consumption. Results show that implementing selected technologies and architectures, the mobile network overall energy consumption can be reduced by approximately 30%, corresponding to almost half of the RAN energy consumption. Following this, a set of guidelines towards an energy optimised mobile network is provided, proposing changes to be made initially and in the longer run for brownfield network operators as well as a target network for greenfield network operators.","author_count":4,"contributors":["Larsen, Line Maria Pyndt","Christiansen, Henrik Lehrmann","Ruepp, Sarah Renée","Berger, Michael Stübert"],"cuid":["S01-000.00-669226"],"filters":{"added":"2023-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Larsen, Line Maria Pyndt"],"keyword":["5G","6G","AI","C RAN","Green RAN","Network slicing","O RAN","vRAN"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"toward greener 000000000005g and beyond radio access networks a survey","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1109/OJCOMS.2023.3257889","version":"Published Version"},"id":"S01-000.00-669226","identifier":[{"id":"85151504122","type":"scopus"}],"ids":["dtu-3e4ef03c-0eed-4b72-a578-ae8d7b32c836"],"keyword":["5G","6G","AI","C-RAN","Green RAN","MOCN","MORAN","Network slicing","O-RAN","vRAN"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-5173821682FB0C9AC833261B9E1EEBC8"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/320476211/Toward_Greener_5G_and_Beyond_Radio_Access_NetworksA_Survey.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1109/OJCOMS.2023.3257889","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Electrical and Photonics Engineering","Technical University of Denmark, Department of Electrical and Photonics Engineering, Networks Technology and Service Platforms"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Line M.P.","key":"larsenpau","last":"Larsen","locid":"e76034cd-61d0-43dd-8c6d-0aa95c672b80","name":"Larsen, Line Maria Pyndt","name_org":"Larsen, Line M.P.","orcid":"0000-0002-6402-5851","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Henrik L.","key":"christiansenpau","last":"Christiansen","locid":"f3aec174-d663-4d97-aaa0-81cd6f4493a9","name":"Christiansen, Henrik Lehrmann","name_org":"Christiansen, Henrik L.","orcid":"0000-0002-9558-3493","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Sarah","key":"ruepppau","last":"Ruepp","locid":"92dfeab4-28ff-437d-9f5d-e7d8d6a67b93","name":"Ruepp, Sarah Renée","name_org":"Ruepp, Sarah","orcid":"0000-0003-0205-5067","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Michael S.","key":"bergerpau","last":"Berger","locid":"7b367889-bde0-4e40-893f-0a22e4d32371","name":"Berger, Michael Stübert","name_org":"Berger, Michael S.","orcid":"0000-0003-4575-7261","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1109/ojcoms.2023.3257889","issn":["2644125X"],"journal":"IEEE Open Journal of the Communications Society","pages":"768-797","publisher":"Institute of Electrical and Electronics Engineers Inc.","status":"p","title":"IEEE Open Journal of the Communications Society","volume":"4"},"review":"Peer Reviewed","scoID":["2-s2.0-85151504122"],"sdg":["7. Affordable and Clean Energy","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-3e4ef03c-0eed-4b72-a578-ae8d7b32c836"],"src":["DTU Technical University of Denmark"],"title":"Toward Greener 5G and Beyond Radio Access Networks - A Survey","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-669226","year":"2023","yearsub":"2023"}
{"abstract":"The extent to which increased liver fat content influences differences in circulating metabolites and/or lipids between low-birth-weight (LBW) individuals, at increased risk of type 2 diabetes (T2D), and normal-birth-weight (NBW) controls is unknown. The objective of the study was to perform untargeted serum metabolomics and lipidomics analyses in 26 healthy, non-obese early-middle-aged LBW men, including five men with screen-detected and previously unrecognized non-alcoholic fatty liver disease (NAFLD), compared with 22 age- and BMI-matched NBW men (controls). While four metabolites (out of 65) and fifteen lipids (out of 279) differentiated the 26 LBW men from the 22 NBW controls (p ≤ 0.05), subgroup analyses of the LBW men with and without NAFLD revealed more pronounced differences, with 11 metabolites and 56 lipids differentiating (p ≤ 0.05) the groups. The differences in the LBW men with NAFLD included increased levels of ornithine and tyrosine (PFDR ≤ 0.1), as well as of triglycerides and phosphatidylcholines with shorter carbon-chain lengths and fewer double bonds. Pathway and network analyses demonstrated downregulation of transfer RNA (tRNA) charging, altered urea cycling, insulin resistance, and an increased risk of T2D in the LBW men with NAFLD. Our findings highlight the importance of increased liver fat in the pathogenesis of T2D in LBW individuals.","author_count":13,"contributors":["Elingaard-Larsen, Line O.","Villumsen, Sofie O.","Justesen, Louise","Thuesen, Anne Cathrine B.","Kim, Min","Ali, Mina","Danielsen, Else R.","Legido-Quigley, Cristina","van Hall, Gerrit","Hansen, Torben","Ahluwalia, Tarunveer S.","Vaag, Allan A.","Brøns, Charlotte"],"cuid":["S01-000.00-670100"],"filters":{"added":"2023-06","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"country":["Sweden"],"glorg":["All Global Affiliations","Lund University"],"keyword":["Lipidomics","Liver fat","Low birth weight","Metabolomics","Non alcoholic fatty liver disease","Type 2 diabetes"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"OT":["Steno Diabetes Centre, Gentofte, Denmark."],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"circulating metabolomic and lipidomic signatures identify a type 000000000002 diabetes risk profile in low birth weight men with non alcoholic fatty liver disease","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/nu15071590","version":"Published Version"},"id":"S01-000.00-670100","identifier":[{"id":"PMC10096690","type":"pmcid"},{"id":"85152686729","type":"scopus"},{"id":"37049431","type":"pmid"},{"id":"000970084000001","type":"wos"}],"ids":["ku-453fce51-27a5-4b66-abfe-c1f6538f6d73"],"keyword":["lipidomics","liver fat","low-birth-weight","metabolomics","non-alcoholic fatty liver disease","type 2 diabetes"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-7A8FB6BBBF10F825D9D6C77D5ABF7ECE"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/344809931/nutrients_15_01590_v5.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/nu15071590","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Steno Diabetes Centre, Gentofte, Denmark."],"nora_code":"DI-OT","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Novo Nordisk Foundation Center for Basic Metabolic Research, Hansen Group"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"4","country":"se","key":"lund university","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Lund University","used":1}],"person":[{"affno":"1","first":"Line O.","key":"elingaardlarsenpau","last":"Elingaard-Larsen","name":"Elingaard-Larsen, Line O.","rank":1,"rolecode":"pau"},{"affno":"1","first":"Sofie O.","key":"villumsenpau","last":"Villumsen","name":"Villumsen, Sofie O.","rank":2,"rolecode":"pau"},{"affno":"1","first":"Louise","key":"justesenpau","last":"Justesen","name":"Justesen, Louise","rank":3,"rolecode":"pau"},{"affno":"2","first":"Anne Cathrine B.","key":"thuesenpau","last":"Thuesen","locid":"c5410e85-5d9f-4def-87a9-9dc639ce40a7","name":"Thuesen, Anne Cathrine B.","orcid":"0000-0002-8639-9117","rank":4,"rolecode":"pau"},{"affno":"1","first":"Min","key":"kimpau","last":"Kim","name":"Kim, Min","rank":5,"rolecode":"pau"},{"affno":"1","first":"Mina","key":"alipau","last":"Ali","name":"Ali, Mina","rank":6,"rolecode":"pau"},{"affno":"3","first":"Else R.","key":"danielsenpau","last":"Danielsen","name":"Danielsen, Else R.","rank":7,"rolecode":"pau"},{"affno":"1","first":"Cristina","key":"legidoquigleypau","last":"Legido-Quigley","name":"Legido-Quigley, Cristina","rank":8,"rolecode":"pau"},{"affno":"3 2","first":"Gerrit","key":"vanhallpau","last":"van Hall","locid":"55a9b111-6dbb-4a42-a9ab-d5f3785fbdae","name":"van Hall, Gerrit","orcid":"0000-0002-2519-8127","rank":9,"rolecode":"pau"},{"affno":"2","first":"Torben","key":"hansenpau","last":"Hansen","locid":"6b6bfff1-8b14-468b-af77-e71b375018e0","name":"Hansen, Torben","orcid":"0000-0001-8748-3831","rank":10,"rolecode":"pau"},{"affno":"1","first":"Tarunveer S.","key":"ahluwaliapau","last":"Ahluwalia","name":"Ahluwalia, Tarunveer S.","rank":11,"rolecode":"pau"},{"affno":"1 4","first":"Allan A.","key":"vaagpau","last":"Vaag","name":"Vaag, Allan A.","rank":12,"rolecode":"pau"},{"affno":"1","first":"Charlotte","key":"brønspau","last":"Brøns","name":"Brøns, Charlotte","rank":13,"rolecode":"pau"}],"pmid":["37049431"],"pub":{"doi":"10.3390/nu15071590","issn":["20726643"],"issue":"7","journal":"Nutrients","paperid":"1590","status":"p","title":"Nutrients","volume":"15"},"review":"Peer Reviewed","scoID":["2-s2.0-85152686729"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-453fce51-27a5-4b66-abfe-c1f6538f6d73"],"src":["KU University of Copenhagen"],"title":"Circulating Metabolomic and Lipidomic Signatures Identify a Type 2 Diabetes Risk Profile in Low-Birth-Weight Men with Non-Alcoholic Fatty Liver Disease","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-670100","year":"2023","yearsub":"2023"}
{"abstract":"Background The increasing survival after a lung cancer diagnosis implies that patients live longer with the disease, which means that symptoms and side effects of the treatment become part of everyday life. Aim The study explored how older adults make meaning of everyday life when undergoing treatment for their lung cancer. Material and methods A qualitative study using semi-structured interviews was conducted with 12 older adults with lung cancer undergoing various treatments. The analysis followed Giorgi’s phenomenologic five-step method. Results The analysis revealed three partly overlapping themes: meeting the health care system, losing identity, and struggling for meaning in everyday life. The patients appreciate clear and coherent communication at the oncology clinic. They had different needs for support from organised support groups, friends, communities, or relatives to make meaning of everyday life. Conclusion Creating meaning in everyday life is essential despite the disease and the treatments’ side effects. Interpersonal relationships create meaningfulness in everyday life through a salutogenic perspective that makes everyday life comprehensible and manageable. Significance The patients need an everyday life perspective on the disease and the side effects, which a salutogenic approach in the encounter with the health care system could support.","author_count":4,"contributors":["Joensen, Maria Bensen","Lindahl-Jacobsen, Line Elisabeth","Lindahl, Marianne Pia","Mærsk, Jesper Larsen"],"cuid":["S01-000.00-696736"],"filters":{"added":"2023-11","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Communication","Identity","Patient centredness","Salutogenic perspective","Sense of coherence","Support","disease health science and nursing"],"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-UC"],"level3":{"UC":["DI-UC-AB","DI-UC-ALL"]},"level3all":["DI-UC-AB"]},"review":"pr","rtype":["clu"],"sorti":"making meaning of everyday life in the context of lung cancer treatment a qualitative study of outpatients perspectives","src":["pha"],"src-code":["DI-UC-AB"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.tandfonline.com/doi/full/10.1080/11038128.2023.2249043","version":"Other Version"},"id":"S01-000.00-696736","identifier":[{"id":"85169082110","type":"scopus"}],"ids":["pha-4f88949c-8149-4f0b-a5f7-2be56eb80f41"],"keyword":["Communication","Identity","Patient-centredness","Salutogenic perspective","Sense of coherence","Support","Treatments´side effects","disease, health science and nursing"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Global-Local-2-4-7E6893165E091BCAB0824836EBA38FFC"],"org":[{"affno":"1","key":"university college absalon","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-AB","l3nl":"University College Absalon","l3nn":"University College Absalon","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"University College Absalon","namevar":["Professionshøjskolen Absalon, Direktionen - Slagelse, Sundhed, Social og Engineeringområdet, Absalon - Hverdagsliv og Sundhed","Professionshøjskolen Absalon, Direktionen - Slagelse, Sundhed, Social og Engineeringområdet, Ergoterapeutuddannelsen - Næstved"],"nora_code":"DI-UC-AB","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Maria Bensen","key":"joensenpau","last":"Joensen","locid":"ef9b8908-6faf-40e1-9be8-d6ac18ed0e49","name":"Joensen, Maria Bensen","orcid":"0009-0007-3496-6558","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Line Elisabeth","key":"lindahljacobsenpau","last":"Lindahl-Jacobsen","locid":"cb2c3d9c-2ec4-43e2-b6ec-7cf77ac4f758","name":"Lindahl-Jacobsen, Line Elisabeth","orcid":"0000-0002-8538-217X","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Marianne Pia","key":"lindahlpau","last":"Lindahl","locid":"56fba2a2-de56-4bf6-8492-ef23d