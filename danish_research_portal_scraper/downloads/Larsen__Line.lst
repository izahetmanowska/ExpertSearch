cal Medicine - Department of Ophthalmology"],"nora_code":"DI-U-AU","used":1},{"affno":"5","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1},{"affno":"6","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Ophthalmology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Niklas Cyril","key":"hansenpau","last":"Hansen","name":"Hansen, Niklas Cyril","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders","key":"hvidhansenpau","last":"Hvid-Hansen","name":"Hvid-Hansen, Anders","rank":2,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Flemming","key":"møllerpau","last":"Møller","locid":"7e31eb68-19f4-46b5-a28b-0cd55f2df75e","name":"Møller, Flemming","rank":3,"rolecode":"pau"},{"affno":"4 5","corresponding":null,"country":"dk","first":"Toke","key":"bekpau","last":"Bek","locid":"ffc6d181-f10a-40f1-9446-0a5680b91ab8","name":"Bek, Toke","orcid":"0000-0002-0409-2534","rank":4,"rolecode":"pau"},{"affno":"4 5","corresponding":null,"country":"dk","first":"Dorte Ancher","key":"larsenpau","last":"Larsen","locid":"5e903371-0f65-473a-ad66-1a909c98a776","name":"Larsen, Dorte Ancher","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Nina","key":"jacobsenpau","last":"Jacobsen","name":"Jacobsen, Nina","rank":6,"rolecode":"pau"},{"affno":"1 6","first":"Line","key":"kesselpau","last":"Kessel","locid":"3201472a-2f23-417e-bd01-a7950e2ff370","name":"Kessel, Line","orcid":"0000-0002-9375-1510","rank":7,"rolecode":"pau"}],"pmid":["38392608"],"pub":{"doi":"10.3390/jpm14020175","issn":["20754426"],"issue":"2","journal":"Journal of Personalized Medicine","paperid":"175","publisher":"MDPI","status":"p","title":"Journal of Personalized Medicine","volume":"14"},"review":"Peer Reviewed","scoID":["2-s2.0-85185952429"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-5c15650f-1e5f-4334-9dbc-cb92edaf18e7","ku-065f0ef7-61fa-4854-a943-088f8a580937","sdu-a5cf8b65-7055-4f1d-845e-1a62a95330f9"],"src":["AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Two-Year Results of 0.01% Atropine Eye Drops and 0.1% Loading Dose for Myopia Progression Reduction in Danish Children : A Placebo-Controlled, Randomized Clinical Trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-100.00-724636","year":"2024","yearsub":"2024"}
{"abstract":"RNA viruses have evolved elaborate strategies to protect their genomes, including 5' capping. However, until now no RNA 5' cap has been identified for hepatitis C virus 1,2 (HCV), which causes chronic infection, liver cirrhosis and cancer 3. Here we demonstrate that the cellular metabolite flavin adenine dinucleotide (FAD) is used as a non-canonical initiating nucleotide by the viral RNA-dependent RNA polymerase, resulting in a 5'-FAD cap on the HCV RNA. The HCV FAD-capping frequency is around 75%, which is the highest observed for any RNA metabolite cap across all kingdoms of life 4-8. FAD capping is conserved among HCV isolates for the replication-intermediate negative strand and partially for the positive strand. It is also observed in vivo on HCV RNA isolated from patient samples and from the liver and serum of a human liver chimeric mouse model. Furthermore, we show that 5'-FAD capping protects RNA from RIG-I mediated innate immune recognition but does not stabilize the HCV RNA. These results establish capping with cellular metabolites as a novel viral RNA-capping strategy, which could be used by other viruses and affect anti-viral treatment outcomes and persistence of infection.","author_count":28,"contributors":["Sherwood, Anna V.","Rivera-Rangel, Lizandro René","Ryberg, Line Abildgaard","Larsen, Helena S","Anker, Klara M","Costa, Rui","Vågbø, Cathrine B","Jakljevič, Eva","Pham, Long V.","Fernandez-Antunez, Carlota","Indrisiunaite, Gabriele","Podolska, Agnieszka","Grothen, Julius E.R.","Langvad, Nicklas W","Fossat, Nicolas","Offersgaard, Anna","Al-Chaer, Amal","Nielsen, Louise","Kuśnierczyk, Anna","Sølund, Christina","Weis, Nina","Gottwein, Judith Margarete","Holmbeck, Kenn","Bottaro, Sandro","Ramirez, Santseharay","Bukh, Jens","Scheel, Troels K H","Vinther, Jeppe"],"cuid":["S01-000.00-684640"],"filters":{"added":"2023-09","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Europe, Non-EU","Nordic","OECD"],"country":["Norway","United States"],"glorg":["All Global Affiliations","Norwegian University of Science and Technology","Rockefeller University"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"hepatitis c virus rna is 000000000005 capped with flavin adenine dinucleotide","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://curis.ku.dk/ws/files/411064108/Hepatitis_C_virus_RNA.pdf","version":"Authors Final Version"},"id":"S01-000.00-684640","identifier":[{"id":"37407817","type":"pmid"},{"id":"85164200975","type":"scopus"}],"ids":["ku-ed6e24c9-0c64-49a3-a161-ac52cb160c27"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-DB3A6AA0596B6801304A399CBD1F6963"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://curis.ku.dk/ws/files/411064108/Hepatitis_C_virus_RNA.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Biology, Computational and RNA Biology"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Amager and Hvidovre"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","co