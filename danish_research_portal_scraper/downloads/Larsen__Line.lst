onding":null,"first":"Dorte","key":"melgaardpau","last":"Melgaard","locid":"488a91ea-9082-4e88-8f32-27777ef7bbbf","name":"Melgaard, Dorte","orcid":"0000-0002-5656-402X","rank":15,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anne Lund","key":"kraruppau","last":"Krarup","locid":"05957add-3c70-4106-9e06-6db64be7129f","name":"Krarup, Anne Lund","orcid":"0000-0002-2228-7132","rank":16,"rolecode":"pau"}],"pmid":["38166672"],"pub":{"doi":"10.1186/s12876-023-03077-8","issn":["1471230X"],"issue":"1","journal":"BMC Gastroenterology","paperid":"3","publisher":"BioMed Central","status":"p","title":"BMC Gastroenterology","volume":"24"},"review":"Peer Reviewed","scoID":["2-s2.0-85181240671"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-98830de9-d447-45d6-91f0-af6ee3784251"],"src":["AAU Aalborg University"],"title":"A retrospective cohort study on oesophageal food bolus obstruction in the North Denmark region in 2021-two thirds were never diagnosed with a cause","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-716883","year":"2024","yearsub":"2024"}
{"abstract":"As Mobile Network Operators (MNOs) seek to revolutionise their infrastructures and meet the growing demands of a data-centric world, the adoption of open RAN (Radio Access Network) technology has emerged as a compelling solution. This paper offers a comprehensive exploration of open RAN's transformative potential within the MNO landscape and investigates the concrete implementation opportunity of Open-RAN (O-RAN). Starting out by providing an exhaustive overview of the state of the art in open RAN technology, research and deployments, leads to an in-depth analysis of the decision roadmap of open RAN adoption. This roadmap considers the network design, vendor criteria and implementation strategy. This paper contributes with a comprehensive examination of components and an overview of increasingly complex design opportunities including functional split and accelerator options. Thus, it serves as an enlightening and pragmatic guide for MNOs navigating the transition to opening the interfaces in their RAN. Finally the paper proposes a pragmatic exploration of implementation strategies, providing insights to the drawbacks MNOs will face and proposed solutions. Hence, this paper highlights how the O-RAN system is built in modules, which adds additional importance to the increasingly complex design phase when multiple aspects must be evaluated to become the (r)evolution of mobile networks.","author_count":4,"contributors":["Larsen, Line Maria Pyndt","Christiansen, Henrik L.","Ruepp, Sarah Renée","Berger, Michael Stübert"],"cuid":["S01-000.00-729408"],"filters":{"added":"2024-05","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Larsen, Line Maria Pyndt"],"keyword":["Components","Interfaces","MNO","O RAN","Open RAN"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-PR-OTH","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"the evolution of mobile network operations a comprehensive analysis of open ran adoption","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.comnet.2024.110292","version":"Published Version"},"id":"S01-000.00-729408","identifier":[{"id":"85186712135","type":"scopus"}],"ids":["dtu-20e3c831-c749-476e-8b83-989be7e35e27"],"keyword":["Components","Interfaces","MNO","O-RAN","Open RAN"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-251C4E07D02CA01ABFFAA24FA392D148"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.comnet.2024.110292","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/356883947/1-s2.0-S1389128624001245-main.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Electrical and Photonics Engineering","Technical University of Denmark, Department of Electrical and Photonics Engineering, Networks Technology and Service Platforms"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["TDC NET A/S"],"nora_code":"DI-PR-OTH","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Line Maria Pyndt","key":"larsenpau","last":"Larsen","locid":"e76034cd-61d0-43dd-8c6d-0aa95c672b80","name":"Larsen, Line Maria Pyndt","orcid":"0000-0002-6402-5851","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Henrik L.","key":"christiansenpau","last":"Christiansen","name":"Christiansen, Henrik L.","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Sarah","key":"ruepppau","last":"Ruepp","locid":"92dfeab4-28ff-437d-9f5d-e7d8d6a67b93","name":"Ruepp, Sarah Renée","name_org":"Ruepp, Sarah","orcid":"0000-0003-0205-5067","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Michael S.","key":"bergerpau","last":"Berger","locid":"7b367889-bde0-4e40-893f-0a22e4d32371","name":"Berger, Michael Stübert","name_org":"Berger, Michael S.","orcid":"0000-0003-4575-7261","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.comnet.2024.110292","issn":["13891286","13891308"],"issn_org":["13891286"],"journal":"Computer Networks","paperid":"110292","publisher":"Elsevier","status":"p","title":"Computer Networks","volume":"243"},"review":"Peer Reviewed","scoID":["2-s2.0-85186712135"],"search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Other Companies","Private Research","Technical University of Denmark","Universities","tdc net a/s"],"PST":["Published"]},"sid":["dtu-20e3c831-c749-476e-8b83-989be7e35e27"],"src":["DTU Technical University of Denmark"],"title":"The Evolution of Mobile Network Operations : A Comprehensive Analysis of Open RAN Adoption","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-729408","year":"2024","yearsub":"2024"}
{"abstract":"Background: Major depressive disorder (MDD) is a debilitating condition that affects more than 300 million people worldwide. Current treatments are based on a trial-and-error approach, and reliable biomarkers are needed for more informed and personalized treatment solutions. One of the potential biomarkers, gamma-frequency (30–80 Hz) brainwaves, are hypothesized to originate from the excitatory-inhibitory interaction between the pyramidal cells and interneurons. The imbalance between this interaction is described as a crucial pathological mechanism in neuropsychiatric conditions, including MDD, and the modulation of this pathological interaction has been investigated as a potential target. Previous studies attempted to induce gamma activity in the brain using rhythmic light and sound stimuli (GENUS–Gamma Entrainment Using Sensory stimuli) that resulted in neuroprotective effects in Alzheimer’s disease (AD) patients and animal models. Here, we investigate the antidepressant, cognitive, and electrophysiological effects of the novel light therapy approach using 40 Hz masked flickering light for patients diagnosed with MDD. Methods and design: Sixty patients with a current diagnosis of a major depressive episode will be enrolled in a randomized, double-blinded, placebo-controlled trial. The active treatment group will receive 40 Hz masked flickering light stimulation while the control group will receive continuous light matched in color temperature and brightness. Patients in both groups will get daily light treatment in their own homes and will attend four follow-up visits to assess the symptoms of depression, including depression severity measured by Hamilton Depression Rating Scale (HAM-D17), cognitive function, quality of life and sleep, and electroencephalographic changes. The primary endpoint is the mean change from baseline to week 6 in depression severity (HAM-D6 subscale) between the groups.","author_count":11,"contributors":["Sakalauskaitė, Laura","Hansen, Luna S.","Dubois, Julie Margrethe","Ploug Larsen, Malina","Feijóo, Gustavo Miguel","Carstensen, Marcus Schultz","Woznica Miskowiak, Kamilla","Nguyen, Mai","Clemmensen, Line Katrine Harder","Petersen, Paul Michael","Martiny, Klaus"],"cuid":["S01-000.00-746815"],"filters":{"added":"2024-08","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"corresponding_author":["Martiny, Klaus"],"keyword":["Cognition","Major depressive disorder"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-PR-OTH","DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"rationale and design of a double blinded randomized placebo controlled trial of 000000000040 hz light neurostimulation therapy for depression felix","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1080/07853890.2024.2354852","version":"Published Version"},"id":"S01-000.00-746815","identifier":[{"id":"85193676029","type":"scopus"},{"id":"PMC11107857","type":"pmcid"},{"id":"38767238","type":"pmid"}],"ids":["dtu-9a61bbb3-f79f-4598-b2f1-42314ff15e30"],"keyword":["40 Hz stimulation","Cognition","Gamma brainwaves","Light stimulation","Major depressive disorder","Visual flicker"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-94029DB1380AD4AC59ED19781BB8339A"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/361777996/Rationale_and_design_of_a_double-blinded_randomized_placebo-controlled_trial_of_40_Hz_light_neurostimulation_therapy_for_depression_FELIX_.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1080/07853890.2024.2354852","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Electrical and Photonics Engineering"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["OptoCeutics ApS"],"nora_code":"DI-PR-OTH","used":1},{"affno":"3","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Laura","key":"sakalauskaitėpau","last":"Sakalauskaitė","locid":"bf2ca35a-8e7f-418c-96aa-9c39e96143fc","name":"Sakalauskaitė, Laura","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Luna S.","key":"hansenpau","last":"Hansen","name":"Hansen, Luna S.","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Julie Margrethe","key":"duboispau","last":"Dubois","name":"Dubois, Julie Margrethe","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Malina","key":"plouglarsenpau","last":"Ploug Larsen","name":"Ploug Larsen, Malina","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Gustavo Miguel","key":"feijóopau","last":"Feijóo","name":"Feijóo, Gustavo Miguel","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Marcus S.","key":"carstensenpau","last":"Carstensen","locid":"58e7e166-c134-4b4b-beae-5e7779d3d6d6","name":"Carstensen, Marcus Schultz","name_org":"Carstensen, Marcus S.","orcid":"0000-0001-9312-0906","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Kamilla","key":"woznicamiskowiakpau","last":"Woznica Miskowiak","name":"Woznica Miskowiak, Kamilla","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Mai","key":"nguyenpau","last":"Nguyen","name":"Nguyen, Mai","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Line Katrine","key":"harderclemmensenpau","last":"Harder Clemmensen","locid":"4e7ff76e-13f9-4365-83b1-d10bab96517b","name":"Clemmensen, Line Katrine Harder","name_org":"Harder Clemmensen, Line Katrine","orcid":"0000-0001-5527-5798","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Paul Michael","key":"petersenpau","last":"Petersen","locid":"6527577a-b638-4f24-85f1-0c36cec2d880","name":"Petersen, Paul Michael","orcid":"0000-0002-4202-4655","rank":10,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Klaus","key":"martinypau","last":"Martiny","name":"Martiny, Klaus","rank":11,"rolecode":"pau"}],"pmid":["38767238"],"pub":{"doi":"10.1080/07853890.2024.2354852","issn":["07853890","13652060"],"issn_org":["07853890"],"issue":"1","journal":"Annals of Medicine","paperid":"2354852","publisher":"Taylor & Francis","status":"p","title":"Annals of Medicine","volume":"56"},"review":"Peer Reviewed","scoID":["2-s2.0-85193676029"],"search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Other Companies","Private Research","Technical University of Denmark","Universities","University of Copenhagen","optoceutics aps"],"PST":["Published"]},"sid":["dtu-9a61bbb3-f79f-4598-b2f1-42314ff15e30"],"src":["DTU Technical University of Denmark"],"title":"Rationale and design of a double-blinded, randomized placebo-controlled trial of 40 Hz light neurostimulation therapy for depression (FELIX)","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-746815","year":"2024","yearsub":"2024"}
{"abstract":"Unstable proteins are prone to form non-native interactions with other proteins and thereby may become toxic. To mitigate this, destabilized proteins are targeted by the protein quality control network. Here we present systematic studies of the cytosolic aspartoacylase, ASPA, where variants are linked to Canavan disease, a lethal neurological disorder. We determine the abundance of 6152 of the 6260 (~ 98%) possible single amino acid substitutions and nonsense ASPA variants in human cells. Most low abundance variants are degraded through the ubiquitin-proteasome pathway and become toxic upon prolonged expression. The data correlates with predicted changes in thermodynamic stability, evolutionary conservation, and separate disease-linked variants from benign variants. Mapping of degradation signals (degrons) shows that these are often buried and the C-terminal region functions as a degron. The data can be used to interpret Canavan disease variants and provide insight into the relationship between protein stability, degradation and cell fitness.","author_count":13,"contributors":["Grønbæk-Thygesen, Martin","Voutsinos, Vasileios","Johansson, Kristoffer Enøe","Schulze, Thea K.","Cagiada, Matteo","Pedersen, Line","Clausen, Lene","Nariya, Snehal","Powell, Rachel L.","Stein, Amelie","Fowler, Douglas M.","Lindorff-Larsen, Kresten","Hartmann-Petersen, Rasmus"],"cuid":["S01-000.00-748716"],"filters":{"added":"2024-08","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","University of Washington"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"deep mutational scanning reveals a correlation between degradation and toxicity of thousands of aspartoacylase variants","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41467-024-48481-0","version":"Published Version"},"id":"S01-000.00-748716","identifier":[{"id":"PMC11091098","type":"pmcid"},{"id":"38740822","type":"pmid"},{"id":"85192871645","type":"scopus"}],"ids":["ku-9b3aded5-06f4-4528-9dab-23f579f1dbca"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-658E18959D7C1A790298D7D9EB87833D"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41467-024-48481-0","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/392567888/s41467_024_48481_0.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Biology, Biomolecular Sciences"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"us","key":"university of washington","loc":["United States","America, North","OECD"],"name":"University of Washington","used":1}],"person":[{"affno":"1","first":"Martin","key":"grønbækthygesenpau","last":"Grønbæk-Thygesen","locid":"862836e9-af0a-4ed1-aed5-e035725e0f97","name":"Grønbæk-Thygesen, Martin","rank":1,"rolecode":"pau"},{"affno":"1","first":"Vasileios","key":"voutsinospau","last":"Voutsinos","locid":"8692b68e-4a3f-4e98-a681-3db832ca39af","name":"Voutsinos, Vasileios","rank":2,"rolecode":"pau"},{"affno":"1","first":"Kristoffer E.","key":"johanssonpau","last":"Johansson","locid":"34484100-1988-429c-8752-50e9ec016138","name":"Johansson, Kristoffer Enøe","name_org":"Johansson, Kristoffer E.","rank":3,"rolecode":"pau"},{"affno":"1","first":"Thea K.","key":"schulze