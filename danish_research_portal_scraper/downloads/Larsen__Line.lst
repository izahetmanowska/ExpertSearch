{"abstract":"P54","author_count":7,"contributors":["Rasmussen, Line Dahlerup","Obel, Dorrit","Kronborg, Gitte","Larsen, Carsten Schade","Pedersen, Court","Gerstoft, Jan","Obel, Niels"],"cuid":["S01-000.00-580184"],"event":{"end":"2013-10-19","place":"Brussels, be","start":"2013-10-16","title":"EACS European AIDS Clinical Society","year":"2013"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR"],"OT":["Private Clinic of Child and Adolescent Psychiatry"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"utilization of psychotropic drugs prescribed to persons with and without hiv infection a danish nationwide population based cohort study","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-580184","ids":["sdu-184f39d0-1c56-47d5-831b-26e0423b4225"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-01E3765106406EC214B3958086EFE9C1"],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Infectious Diseases (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Private Clinic of Child and Adolescent Psychiatry"],"nora_code":"DI-OT","used":1},{"affno":"3","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Hvidovre Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"4","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Line Dahlerup","key":"rasmussenlinedahleruppau","last":"Rasmussen","locid":"a0349aeb-56d9-4984-86b0-4829aee2a04b","name":"Rasmussen, Line Dahlerup","orcid":"0000-0003-0853-0893","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Dorrit","key":"obeldorritpau","last":"Obel","name":"Obel, Dorrit","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Gitte","key":"kronborggittepau","last":"Kronborg","name":"Kronborg, Gitte","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Carsten Schade","key":"larsencarstenschadepau","last":"Larsen","name":"Larsen, Carsten Schade","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Court","key":"pedersencourtpau","last":"Pedersen","locid":"7f2e0dec-1687-4283-ac30-53e73c124437","name":"Pedersen, Court","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jan","key":"gerstoftjanpau","last":"Gerstoft","name":"Gerstoft, Jan","rank":6,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Niels","key":"obelnielspau","last":"Obel","locid":"cb37dd49-aecb-4187-b99e-3b71e4c3aa2d","name":"Obel, Niels","orcid":"0000-0002-5031-0045","rank":7,"rolecode":"pau"}],"pub":{"issn":["13596535","20402058"],"issn_org":["13596535"],"issue":"A77","journal":"Antiviral Therapy","publisher":"SAG