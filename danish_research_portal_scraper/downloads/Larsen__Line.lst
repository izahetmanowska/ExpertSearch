{"author_count":4,"contributors":["Berliner, Peter","Larsen, Line Natascha","de Casas Soberón, Elena"],"cuid":["S01-000.00-407015"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"case study promoting community resilience with local values greenland s paamiut asasara","src":["ku"],"src-code":["DI-U-KU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/978-1-4614-0586-3_30","version":"Other Version"},"id":"S01-000.00-407015","identifier":[{"id":"84893392416","type":"scopus"}],"ids":["ku-16bc2a16-0410-4d5f-b1e9-7f4f2d605f8f"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-3-5-3A47BB2E6A6F4151B06749B1374DB20A"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1007/978-1-4614-0586-3_30","version":"Other Version"}],"org":[{"affno":"1","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Social Sciences, Department of Psychology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Peter","key":"berlinerpau","last":"Berliner","name":"Berliner, Peter","rank":1,"rolecode":"pau"},{"affno":"2","first":"Line Natascha","key":"larsenpau","last":"Larsen","locid":"4fabeada-6e3d-4b5f-adc5-72b47a89b9ef","name":"Larsen, Line Natascha","rank":2,"rolecode":"pau"},{"affno":"","first":"Elena","key":"decasassoberónpau","last":"de Casas Soberón","name":"de Casas Soberón, Elena","rank":3,"rolecode":"pau"},{"affno":"","first":"Michael","key":"ungarpedh","last":"Ungar","name":"Ungar, Michael","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-1-4614-0586-3_30","eisbn":["9781461405863"],"isbn":["9781461405856"],"pages":"387-397","publisher":"Springer Science+Business Media","status":"p","subtitle":"A Handbook of Theory and Practice","title":"The Social Ecology of Resilience"},"review":"Peer Reviewed","scoID":["2-s2.0-84893392416"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-16bc2a16-0410-4d5f-b1e9-7f4f2d605f8f"],"src":["KU University of Copenhagen"],"title":"Case Study: Promoting Community Resilience with Local Values : Greenland's Paamiut Asasara","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-407015","year":"2012","yearsub":"2012"}
{"abstract":"Purpose: Retinal vascular lesions such as microaneurysms and haemorrhages, while typical of diabetic retinopathy, are also seen in subjects without diabetes where they are associated with elevated cardiovascular mortality. In theory, these lesions could be a consequence of past hyperglycaemia. We examined the prevalence and risk factors for retinopathy, including lens fluorescence, a biomarker of cumulative life-time glycaemia in adults without diabetes. Methods: Cross-sectional population-based study of 711 subjects without diabetes (WHO 1999 criteria) aged 30-60 years, including oral glucose tolerance testing, clinical and laboratory examinations, non-invasive ocular lens fluorometry and seven-field fundus photography. Results: Retinopathy was present in 8.3% (CI(95) 6.3-10.3%) of subjects. Higher systolic blood pressure (SBP) (p = 0.032), increasing body mass index (BMI) (p = 0.014) and wider waist circumference (p = 0.014) were significantly associated with retinopathy after adjusting for age and sex. Retinopathy was not significantly related to long-term, short-term or current glycaemia (lens fluorescence, HbA(1c) , fasting plasma glucose). In the multivariate analysis, the odds ratio (OR) for retinopathy in subjects with SBP =160 mmHg compared to subjects with SBP","author_count":6,"contributors":["Munch, Inger Christine","Kessel, Line","Borch-Johnsen, Knut","Glümer, Charlotte","Lund-Andersen, Henrik","Larsen, Michael"],"cuid":["S01-000.00-809885"],"filters":{"added":"2022-04","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"microvascular retinopathy in subjects without diabetes the inter000000000099 eye study","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1111/j.1755-3768.2011.2148.x","version":"Other Version"},"id":"S01-000.00-809885","identifier":[{"id":"21470389","type":"pmid"},{"id":"84868200453","type":"scopus"}],"ids":["ku-5f1b82d7-1454-492f-8dfb-7fdbc1923eae"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-447C586B1CF0262EE2F1E8E349E2526C"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1111/j.1755-3768.2011.2148.x","version":"Other Version"}],"org":[{"affno":1,"key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Section of Neurology, Psychiatry and Sensory Sciences"],"nora_code":"DI-U-KU"}],"person":[{"affno":"","first":"Inger Christine","key":"munchpau","last":"Munch","name":"Munch, Inger Christine","rank":1,"rolecode":"pau"},{"affno":"","first":"Line","key":"kesselpau","last":"Kessel","name":"Kessel, Line","rank":2,"rolecode":"pau"},{"affno":"","first":"Knut","key":"borchjohnsenpau","last":"Borch-Johnsen","name":"Borch-Johnsen, Knut","rank":3,"rolecode":"pau"},{"affno":"","first":"Charlotte","key":"glümerpau","last":"Glümer","name":"Glümer, Charlotte","rank":4,"rolecode":"pau"},{"affno":"","first":"Henrik","key":"lundandersenpau","last":"Lund-Andersen","name":"Lund-Andersen, Henrik","rank":5,"rolecode":"pau"},{"affno":"","first":"Michael","key":"larsenpau","last":"Larsen","locid":"1d460214-c0db-4a15-a3a5-360c73746ed4","name":"Larsen, Michael","rank":6,"rolecode":"pau"}],"pmid":["21470389"],"pub":{"doi":"10.1111/j.1755-3768.2011.2148.x","issn":["1755375X","17553768"],"issn_org":["1755375X"],"issue":"7","journal":"Acta Ophthalmologica","pages":"613-9","status":"p","title":"Acta Ophthalmologica","volume":"90"},"review":"Peer Re