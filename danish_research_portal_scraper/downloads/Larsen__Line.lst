key":"weberyvonnegpau","last":"Weber","name":"Weber, Yvonne G","rank":28,"rolecode":"pau"}],"pmid":["26677014"],"pub":{"doi":"10.1002/ana.24580","issn":["03645134","15318249"],"issn_org":["03645134"],"issue":"3","journal":"Annals of Neurology","pages":"428-436","publisher":"John Wiley & Sons Inc.","status":"p","title":"Annals of Neurology","volume":"79"},"review":"Peer Reviewed","scoID":["2-s2.0-84960424771"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Private Research","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Hospitals","Other Companies","Private Research","Universities","University of Copenhagen","University of Southern Denmark","amplexa genetics a/s"],"PST":["Published"]},"sid":["au-490f1c52-2eaf-4420-ad93-27989858d4c1","ku-d27cad24-a517-4651-af3b-7e4894b21a4c","sdu-0b5b1464-2a7f-4fee-be06-0a386c024c2b"],"src":["AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Benign Infantile Seizures and Paroxysmal Dyskinesia Caused by an SCN8A Mutation","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-097.90-017963","year":"2016","yearsub":"2016"}
{"abstract":"Aims It is a challenge for health professionals to involve patients with aphasia (PWAs) in their own treatment, care and rehabilitation. Disrupted communication may also influence patient safety and lead to social isolation. In order to increase health care professionals’ ability to engage PWAs in communication and interaction, Supported Conversation for Adults with Aphasia (SCA) was adapted and implemented in a large neurological department at Rigshospitalet-Glostrup in Copenhagen. Method 152 staff members representing different health professionals were assigned to one of eleven courses during a six month period. Each course had 10-12 participants and lasted 6 hours, including instruction in the SCA principles, video analysis, interdisciplinary group work, and practice sessions with PWAs. Self-assessed learning outcomes were evaluated with a brief questionnaire filled out by staff members immediately before course attendance and 3-6 months afterwards. Results Self-rated knowledge of aphasia had significantly improved when assessed 3-6 months after the course and improvement was seen for all groups of health professionals. Comfort and ease in communicating with PWA and ability to solve problems in communication, also showed significant improvements across all staff groups. After the course, more time to spend with patients was perceived as the most important factor to further increase communication success with PWA. Conclusion The results show that interdisciplinary SCA-courses successfully increase hospital staff’s confidence and self-assessed ability to communicate with PWAs.","author_count":7,"contributors":["Forchhammer, Hysse B","Løvholt, Annelise P.","Mathiesen, Lone Lundbak","Iversen, Helle Klingenberg","Larsen, Line Sofie Lunde","Norup, Anne","Jensen, Lise Randrup"],"cuid":["S01-000.00-494907"],"event":{"end":"2016-05-13","place":"Philadelphia, us","start":"2016-05-10","title":"World Congress on Neurorehabilitation","year":"2016"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Aphasia","Communication","Faculty of Humanities"],"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"supported conversation for hospital staff a questionnaire study of self evaluated outcome","src":["ku"],"src-code":["DI-U-KU"],"type":"dco","type-grp":["all","pub"]},"id":"S01-000.00-494907","ids":["ku-a9e16cec-ec34-4cb6-9e52-8c8f6ee1910b"],"keyword":["Faculty of Humanities","aphasia","communication"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-F48214F3C40AD8704E69810C38B8B889"],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Humanities, Department of Nordic Studies and Linguistics"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Hysse B","key":"forchhammerpau","last":"Forchhammer","name":"Forchhammer, Hysse B","rank":1,"rolecode":"pau"},{"affno":"1","first":"Annelise P.","key":"løvholtpau","last":"Løvholt","name":"Løvholt, Annelise P.","rank":2,"rolecode":"pau"},{"affno":"1","first":"Lone Lundbak","key":"mathiesenpau","last":"Mathiesen","name":"Mathiesen, Lone Lundbak","rank":3,"rolecode":"pau"},{"affno":"1","first":"Helle Klingenberg","key":"iversenpau","last":"Iversen","name":"Iversen, Helle Klingenberg","rank":4,"rolecode":"pau"},{"affno":"1","first":"Line Sofie Lunde","key":"larsenpau","last":"Larsen","name":"Larsen, Line Sofie Lunde","rank":5,"rolecode":"pau"},{"affno":"1","first":"Anne","key":"noruppau","last":"Norup","name":"Norup, Anne","rank":6,"rolecode":"pau"},{"affno":"2","first":"Lise Randrup","key":"jensenpau","last":"Jensen","locid":"50c39bb3-215a-4a63-85b9-4817b04308a6","name":"Jensen, Lise Randrup","orcid":"0000-0001-8784-6962","rank":7,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-a9e16cec-ec34-4cb6-9e52-8c8f6ee1910b"],"src":["KU University of Copenhagen"],"title":"Supported Conversation for hospital staff : A questionnaire study of self-evaluated outcome","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-494907","year":"2016","yearsub":"2016"}
{"abstract":"Indholdet i herværende hæfte skal ses som et idé- og inspirationsmateriale til undervisere på professionshøjskolerne. Hæftet er således et inspirationskatalog om hvilke overvejelser, faldgrupper, muligheder og potentialer, der kan være i brugen af digitalt understøttede undervisningsaktiviteter. Hæftet er opstået på bagrund af 3 afviklede forskningsprojekter og 2 igangværende ph.d. projekter. Indholdet baserer sig på digitalt udviklingslaboratoriums (DUITs) mission om at analysere, vurdere, udvikle og integrere digital teknologi i forbindelse med planlægning, gennemførelse og evaluering af studier og undervisning på videregående uddannelser med henblik på at flere lærer mere og bedre. Hæftets brug af forskningsresultaterne stammer fra fund genereret i 2013-2015 i regi DUIT under forskningsprogrammet ’Professionsudvikling og Uddannelsesforskning’ i forsknings- og udviklingsafdelingen på University College Nordjylland (UCN).","author_count":12,"contributors":["Dau, Susanne","Jensen, Louise Bach","Falk, Lars","Horn, Line Helverskov","Kjærgaard, Thomas","Nielsen, Annegrethe","Wahl, Christian","Lukassen, Niels Bech","Pedersen, Annette","Knudsen, Torben Broe","Gudiksen, Maria Boel Klok","Larsen, Louise Landbo"],"cuid":["S01-000.00-651473"],"filters":{"added":"2024-05","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Action research","Design Based Research","Learning","digitale læringsmedier","digitale læringsmiljøer"],"level":"sci","oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-UC"],"level3":{"UC":["DI-UC-ALL","DI-UC-UCN"]},"level3all":["DI-UC-UCN"]},"review":"nr","rtype":["clu"],"sorti":"duit again et inspirationshæfte om hvordan flere kan lære mere og bedre ved brug af it","src":["ucn"],"src-code":["DI-UC-UCN"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://blad.ucn.dk/FoU/Duitagain/","version":"Other Version"},"id":"S01-000.00-651473","ids":["ucn-856e7f1e-a47f-4c19-a0de-271f24ad5a25"],"keyword":["action research","design-based research","digitale læringsmedier","digitale læringsmiljøer","learning"],"lang":"English","level":"Scientific","noi":["Local-1-1-BD6F99382F6D4DE28FAC13C6CBE13E35"],"org":[{"affno":"1","key":"ucn university college of northern denmark","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-UCN","l3nl":"University College of Northern Denmark","l3nn":"UCN University College of Northern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"UCN University College of Northern Denmark","namevar":["Professionshøjskolen UCN, UCN Direktion, UCN Velfærd, UCN Forskning og Udvikling"],"nora_code":"DI-UC-UCN","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Susanne","key":"daupau","last":"Dau","locid":"3bbc0a28-2694-45fa-86db-78ecaf3a8b72","name":"Dau, Susanne","orcid":"0000-0002-5798-0519","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Louise Bach","key":"jensenpau","last":"Jensen","locid":"a7cb5a8a-64c4-4f87-8d52-51d666b2d0b9","name":"Jensen, Louise Bach","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lars","key":"falkpau","last":"Falk","locid":"79426a99-8081-418c-bec7-6a1c18149361","name":"Falk, Lars","orcid":"0000-0003-1729-8555","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Line Helverskov","key":"hornpau","last":"Horn","locid":"2216ddfc-6636-46e8-b5ca-04197f004155","name":"Horn, Line Helverskov","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Thomas","key":"kjærgaardpau","last":"Kjærgaard","locid":"c1024adb-0329-4778-af4d-1632c155910c","name":"Kjærgaard, Thomas","orcid":"0000-0002-9343-200X","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Annegrethe","key":"nielsenpau","last":"Nielsen","locid":"83e758c2-337e-4133-b1a3-78ce812af57f","name":"Nielsen, Annegrethe","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christian","key":"wahlpau","last":"Wahl","locid":"2fcb136b-fcca-431f-baee-9a311e103f69","name":"Wahl, Christian","orcid":"0000-0003-1875-2019","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Niels Bech","key":"lukassenpau","last":"Lukassen","locid":"400fb836-09b4-4dd0-8141-fdcbc8729c08","name":"Lukassen, Niels Bech","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Annette","key":"pedersenpau","last":"Pedersen","locid":"dc321c0b-ba7e-40c3-adf6-fe7bf82ddbdb","name":"Pedersen, Annette","orcid":"0000-0002-7267-2856","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Torben Broe","key":"knudsenpau","last":"Knudsen","locid":"a1db0b56-d161-4c02-8778-cf79ff302952","name":"Knudsen, Torben Broe","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Maria Boel Klok","key":"gudiksenpau","last":"Gudiksen","locid":"e4157ccf-6ff8-4bea-9c24-23bae305435a","name":"Gudiksen, Maria Boel Klok","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Louise Landbo","key":"larsenpau","last":"Larsen","locid":"31d65e99-7ef9-4874-809d-255a8aa44f83","name":"Larsen, Louise Landbo","rank":12,"rolecode":"pau"}],"pub":{"pages":"20","place":"Aalborg","status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All University Colleges","DI-ALL","DI-UC","DI-UC-ALL","University College of Northern Denmark","University Colleges"],"PST":["Published"]},"sid":["ucn-856e7f1e-a47f-4c19-a0de-271f24ad5a25"],"src":["UCN University College of Northern Denmark"],"title":"DUIT AGAIN : et inspirationshæfte om hvordan flere kan lære mere og bedre ved brug af IT","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-651473","year":"2016","yearsub":"2016"}
{"abstract":"OBJECTIVES: To perform a neurophysiological follow-up at 48 or 60 months of age in children exposed prenatally to progesterone compared with a placebo and evaluate their medical histories up to 8 years of age. METHODS: In this study, Danish participants of the PREDICT study, including 989 surviving children from 498 twin pregnancies, were followed-up. PREDICT was a placebo-controlled randomized clinical trial examining the effect of progesterone for prevention of preterm delivery in unselected twin pregnancies. Medical histories of the children were reviewed and neurophysiological development was evaluated by the parent-completed Ages and Stages Questionnaire (ASQ) at either 48 or 60 months after the estimated date of delivery. We used the method of generalized estimating equation to account for the correlation within twins. RESULTS: A total of 492 children had been exposed prenatally to progesterone and 497 to placebo. There was no difference in the number of admissions to or length of stay in hospital between the treatment groups, and we found no overall difference in the rates of diagnoses made. However, the odds ratios (ORs) for a diagnosis concerning the heart was 1.66 (95% CI, 0.81-3.37), favoring placebo, among all children, 2.38 (95% CI, 1.07-5.30) in dichorionic twins and 8.19 (95% CI, 1.02-65.6) in all children when excluding diagnoses made at outpatient clinic visits. ASQ scores were available for 437 children (progesterone, n = 225; placebo, n = 212). Mean ASQ score was slightly higher in the progesterone group compared with the placebo group (P = 0.03). In dichorionic twins, the risk of having a low ASQ score (< 10(th) centile) was decreased in the progesterone group (OR, 0.34 (95% CI, 0.14-0.86)). CONCLUSION: Second- and third-trimester exposure of the fetus to progesterone does not seem to have long-term harmful effects during childhood, but future studies should focus on cardiac disease in the child. Copyright © 2016 ISUOG. Published by John Wiley & Sons Ltd.","author_count":16,"contributors":["Vedel, Cathrine","Larsen, Helle","Holmskov, Anni","Andreasen, Kirsten Riis","Uldbjerg, Niels","Ramb, Jan","Bødker, Birgit","Skibsted, Lillian","Sperling, Lene","Krebs, Lone","Zingenberg, Helle","Laursen, Lone","Christensen, Jeanette Tranberg","Tabor, Ann","Rode, Line"],"cuid":["S04-092.64-001219"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"keyword":["Administration Intravaginal","Adult","Ages and stages questionnaire","Child","Child Development","Child Preschool","Delivery Obstetric","Denmark epidemiology","Female","Follow Up Studies","Gestational Age","Hospital admission","Humans","Infant","Journal Article","Pregnancy","Premature Birth drug therapy","Prenatal Exposure Delayed Effects epidemiology","Preterm delivery","Progesterone","Progesterone administration dosage","Progestins administration dosage","Twins"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-ZEA"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-ZEA","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"long term effects of prenatal progesterone exposure neurophysiological development and hospital admissions in twins up to 000000000008 years of age","src":["aau","au","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84984950717","version":"Other Version"},"id":"S04-092.64-001219","identifier":[{"id":"000383700700017","type":"wos"},{"id":"27106105","type":"pmid"},{"id":"84984950717","type":"scopus"}],"ids":["aau-17b37d31-76eb-495a-b102-332bf5280519","au-34354f77-d6a0-463f-87e1-ffa0e47263f5