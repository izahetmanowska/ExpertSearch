au"},{"affno":"1","corresponding":null,"first":"Tanja","key":"chræmmertanjamortensenpau","last":"Chræmmer","locid":"870ac26a-695b-4c8f-ac1c-7bb48d678789","name":"Chræmmer, Tanja Mortensen","name_org":"Chræmmer, Tanja","orcid":"0000-0002-3797-1834","rank":35,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Teresa Schou","key":"nielsenteresaschoupau","last":"Nielsen","locid":"e3a4174f-7bdc-477c-89e1-3946bd0aebfe","name":"Nielsen, Teresa Schou","rank":36,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ulla Hauge","key":"thostrupullahaugepau","last":"Thostrup","locid":"7283b5c7-6c85-419c-a7ad-c33192368f78","name":"Thostrup, Ulla Hauge","rank":37,"rolecode":"pau"}],"pub":{"pages":"88","place":"UCN","status":"p"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All University Colleges","DI-ALL","DI-UC","DI-UC-ALL","University College of Northern Denmark","University Colleges"],"PST":["Published"]},"sid":["ucn-6917b95a-0304-4bdd-ae52-aabc35dccfd9"],"src":["UCN University College of Northern Denmark"],"title":"Co-bog : Uddannelsernes egne eksempler på hvordan co-creation-aktiviteter indgår i praksis","type":"Book","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-651156","year":"2019","yearsub":"2019"}
{"abstract":"One of the most common copy number variants, the 22q11.2 microdeletion, confers an increased risk for schizophrenia. Since schizophrenia has been associated with an aberrant neural response to repeated stimuli through both reduced adaptation and prediction, we here hypothesized that this may also be the case in nonpsychotic individuals with a 22q11.2 deletion. We recorded high-density EEG from 19 individuals with 22q11.2 deletion syndrome (12–25 years), as well as 27 healthy volunteers with comparable age and sex distribution, while they listened to a sequence of sounds arranged in a roving oddball paradigm. Using posterior probability maps and dynamic causal modelling we tested three different models accounting for repetition dependent changes in cortical responses as well as in effective connectivity; namely an adaptation model, a prediction model, and a model including both adaptation and prediction. Repetition-dependent changes were parametrically modulated by a combination of adaptation and prediction and were apparent in both cortical responses and in the underlying effective connectivity. This effect was reduced in individuals with a 22q11.2 deletion and was negatively correlated with negative symptom severity. Follow-up analysis showed that the reduced effect of the combined adaptation and prediction model seen in individuals with 22q11.2 deletion was driven by reduced adaptation rather than prediction failure. Our findings suggest that adaptation is reduced in individuals with a 22q11.2 deletion, which can be interpreted in light of the framework of predictive coding as a failure to suppress prediction errors.","author_count":10,"contributors":["Larsen, Kit Melissa","Mørup, Morten","Birknow, Michelle Rosgaard","Fischer, Elvira","Olsen, Line","Didriksen, Michael","Baaré, William Frans Christiaan","Werge, Thomas Mears","Garrido, Marta Isabel","Siebner, Hartwig Roman"],"cuid":["S02-100.00-034646"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["OECD","Oceania"],"corresponding_author":["Larsen, Kit Melissa"],"country":["Australia"],"glorg":["All Global Affiliations","University of Queensland"],"keyword":["22q11 deletion syndrome","Dynamic causal modelling","EEG","Mismatch negativity","Posterior probability maps","Repetition suppression"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-NP","DI-PR","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"NP":["DI-NP-ALL","DI-NP-LUND"],"PR":["DI-PR-ALL","DI-PR-LUND"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-NP-LUND","DI-PR-LUND","DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"individuals with 000000000022q000000000011 000000000002 deletion syndrome show intact prediction but reduced adaptation in responses to repeated sounds evidence from bayesian mapping","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.nicl.2019.101721","version":"Published Version"},"funding_acknowledgement":["H.R.S. received honoraria as speaker from Lundbeck A/S, Valby, Denmark, Biogen Idec, Denmark A/S, Genzyme, Denmark and MerckSerono, Denmark, honoraria as editor from Elsevier Publishers, Amsterdam, The Netherlands and Springer Publishing, Stuttgart, Germany, travel support from MagVenture, Denmark, and grant support from Biogen Idec, Denmark A/S. M.R.B is a prior employee at H. Lundbeck A/S, Denmark and received financial support for her PhD from the Innovation Fund Denmark. M.D. is employed with Lundbeck A/S. The authors declare no further biomedical financial interests or potential conflicts of interest. This article is distributed under the Danish legislation governed by the Privacy Act (act# 429, 31/05/2000), which does not permit data sharing at publicly available repositories or in raw formats. Summary statistics can be obtained through contact with the corresponding author ( melissal@drcmr.dk ). We thank all participants and families for taking their time to participate in our study and the Danish National 22q11DS Association for their strong support of our work. We highly appreciate the efforts of Anders Vangkilde and Henriette Schmock for their dedicated assistance in the recruitment and clinical assesments. We thank staff involved in the Danish Blood Donor Study, Capital Region Blood bank, Glostrup and http://www.forsogsperson.dk/ from which our control participants were recruited. This study was funded by the Lundbeck Foundation , Denmark ( R155-2014-1724 ); Lundbeck Foundation [Grant of Excellence “ContAct” R59 A5399 ]; Lundbeck Foundation fellowship ( R105-9813 ); The Capital Region's Research Foundation for Mental Health Research ; the Australian Research Council Centre of Excellence for Integrative Brain Function (ARC Centre Grant 140100007CE ); University of Queensland Fellowship ( 2016000071 ) to MIG. H.R.S. holds a professorship in precision medicine at the Faculty of Health Sciences and Medicine, University of Copenhagen , sponsored by the Lundbeckfonden . Appendix A"],"id":"S02-100.00-034646","identifier":[{"id":"PMC6383326","type":"pmcid"},{"id":"85061628686","type":"scopus"},{"id":"30785050","type":"pmid"}],"ids":["dtu-5a96d2f9-8206-452c-ad6a-59dd71ded557","ku-31a0b262-61e9-455f-a39b-3804f8c4685f"],"keyword":["22q11 deletion syndrome","Dynamic causal modelling","EEG","Mismatch negativity","Posterior probability maps","Repetition suppression"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-19720F29D7E591C4B54E80EDDE8827D6"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.nicl.2019.101721","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/230204541/1_s2.0_S2213158219300713_main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/170361316/HKKR_1_s2.0_S2213158219300713_main.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Applied Mathematics and Computer Science","Technical University of Denmark, Department of Applied Mathematics and Computer Science, Cognitive Systems"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"dk","key":"lundbeck","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-LUND","l3nl":"Lundbeck Pharma","l3nn":"Lundbeck","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Lundbeck","namevar":["Lundbeck"],"nora_code":"DI-PR-LUND","used":1},{"affno":"3","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Amager and Hvidovre"],"nora_code":"DI-HO-CAP","used":1},{"affno":"4","country":"dk","key":"lundbeck foundation","l2":"DI-NP","l2n":"Non-Profit Organisations","l3":"DI-NP-LUND","l3nn":"Lundbeck Foundation","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Lundbeck Foundation","namevar":["iPSYCH - The Lundbeck Foundation Initiative for Integrative Psychiatric Research"],"nora_code":"DI-NP-LUND","used":1},{"affno":"5","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Psychiatry"],"nora_code":"DI-U-KU","used":1},{"affno":"6","country":"au","key":"university of queensland","loc":["Australia","Oceania","OECD"],"name":"University of Queensland","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Kit Melissa","key":"larsenpau","last":"Larsen","locid":"597f3add-c462-4c45-b519-3b17ae15cbec","name":"Larsen, Kit Melissa","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Morten","key":"møruppau","last":"Mørup","locid":"7ffdfaca-76bd-44ec-a98f-13fe4f033b71","name":"Mørup, Morten","orcid":"0000-0003-4985-4368","rank":2,"rolecode":"pau"},{"affno":"2","first":"Michelle Rosgaard","key":"birknowpau","last":"Birknow","name":"Birknow, Michelle Rosgaard","rank":3,"rolecode":"pau"},{"affno":"3","first":"Elvira","key":"fischerpau","last":"Fischer","name":"Fischer, Elvira","rank":4,"rolecode":"pau"},{"affno":"4","first":"Line","key":"olsenpau","last":"Olsen","name":"Olsen, Line","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Michael","key":"didriksenpau","last":"Didriksen","name":"Didriksen, Michael","rank":6,"rolecode":"pau"},{"affno":"3","first":"William Frans Christiaan","key":"baarépau","last":"Baaré","name":"Baaré, William Frans Christiaan","rank":7,"rolecode":"pau"},{"affno":"5","first":"Thomas Mears","key":"wergepau","last":"Werge","locid":"905c01bb-6319-4ce6-a38e-ceb5bf73d2f6","name":"Werge, Thomas","name_org":"Werge, Thomas Mears","rank":8,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Marta Isabel","key":"garridopau","last":"Garrido","name":"Garrido, Marta Isabel","rank":9,"rolecode":"pau"},{"affno":"5","first":"Hartwig Roman","key":"siebnerpau","last":"Siebner","locid":"d9ed8669-a16b-429a-86ed-353ef481bb72","name":"Siebner, Hartwig Roman","rank":10,"rolecode":"pau"}],"pmid":["30785050"],"pub":{"doi":"10.1016/j.nicl.2019.101721","issn":["22131582"],"journal":"NeuroImage: Clinical","paperid":"101721","publisher":"Elsevier","status":"p","title":"NeuroImage: Clinical","volume":"22"},"review":"Peer Reviewed","scoID":["2-s2.0-85061628686"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Non-Profit Organisations","All Private Research","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-NP","DI-NP-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Hospitals","Lundbeck Pharma","Non-Profit Organisations","Private Research","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-5a96d2f9-8206-452c-ad6a-59dd71ded557","ku-31a0b262-61e9-455f-a39b-3804f8c4685f"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Individuals with 22q11.2 deletion syndrome show intact prediction but reduced adaptation in responses to repeated sounds : Evidence from Bayesian mapping","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-034646","year":"2019","yearsub":"2019"}
{"abstract":"BACKGROUND: In patients with incident heart failure, the risk of venous thromboembolism (VTE), defined as pulmonary embolism (PE) and/or deep venous thrombosis (DVT), is sparsely described, especially potential sex differences. We conducted an observational study to evaluate risk of VTE among male and female heart failure patients. METHODS: Population-based cohort study of patients diagnosed with incident heart failure during 2000-2015, identified by record linkage between nationwide registries in Denmark. Using a pseudo-value approach, we calculated relative risks [RR] of VTE at 1 and 3 years of follow-up. Crude VTE risk for males and females are reported and contrasted after adjustment for established clinical risk factors for VTE. RESULTS: A total of 32,330 heart failure patients were included, of which 15,238 (47%) were females. For the combined endpoint of VTE, female sex was associated with a higher risk (1-year adjusted RR: 1.30, 95% confidence interval [CI]: 0.97-1.73; 3-year adjusted RR: 1.34, 95% CI: 1.07-1.67) compared to male patients. For the individual endpoints of PE and DVT after 1-year of follow-up, female sex was only associated with a higher risk of PE and not DVT, compared to male patients. However, female sex was associated with a higher risk of both PE and DVT after 3 years of follow-up. CONCLUSIONS: Among incident heart failure patients, female sex is associated with a higher risk of VTE, mainly driven by an excess risk of PE. This finding may help improve clinical decision-making regarding VTE prophylaxis in patients with heart failure.","author_count":6,"contributors":["Melgaard, Line","Nielsen, Peter Brønnum","Overvad, Thure Filskov","Skjøth, Flemming","Lip, Gregory Y H","Larsen, Torben Bjerregaard"],"cuid":["S01-000.00-069901"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Deep vein thrombosis","Heart failure","Pulmonary embolism","Sex","Venous thromboembolism"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Institute for Cardiovascular Sciences, University of Birmingham, Birmingham, England"],"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"sex differences in risk of incident venous thromboembolism in heart failure patients","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85052084776&partnerID=8YFLogxK","version":"Other Version"},"id":"S01-000.00-069901","identifier":[{"id":"30132063","type":"pmid"},{"id":"85052084776","type":"scopus"}],"ids":["aau-44971339-8d91-42e0-b7bb-a3bb0dd5f4df"],"keyword":["Deep vein thrombosis","Heart failure","Pulmonary embolism","Sex","Venous thromboembolism"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-4FAC78E8B1BE9883B1BE8AE3C2B66507"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Cardiology","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Anæstesi, Børn, Kredsløb og Kvinder","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine, Aalborg Thrombosis Research Unit"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI