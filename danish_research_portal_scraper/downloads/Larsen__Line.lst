{"author_count":1,"contributors":["Staun Larsen, Line"],"cuid":["S01-000.00-796740"],"filters":{"added":"2025-04","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"keyword":["Caries","Erosion"],"level":"pop","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"und","rtype":["clu"],"sorti":"kommentar til forskningsnyt bør man udskyde tandbørstning efter indtag af syreholdige drikke eller fødevarer","src":["au"],"src-code":["DI-U-AU"],"type":"djc","type-grp":["all","pub"]},"id":"S01-000.00-796740","ids":["au-9eec935f-266b-4567-bc0d-220f1dd24e4d"],"keyword":["Caries","Erosion","Forskningsnyt","Tandbørstning"],"lang":"Danish","level":"Popular","mra":["Medical Science"],"noi":["Local-1-1-F64914AB160AC8BA847C24A491D8CE20"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Dentistry and Oral Health, Department of Dentistry and Oral Health - Section for Oral Ecology","Aarhus University, Health, Department of Dentistry and Oral Health, Department of Dentistry and Oral Health - Section for Oral Ecology and Caries Control"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Line Staun","key":"larsenpau","last":"Larsen","locid":"35e2ae60-25db-4a15-893f-dc8906e2bccf","name":"Staun Larsen, Line","name_org":"Larsen, Line Staun","orcid":"0000-0002-4155-5884","rank":1,"rolecode":"pau"}],"pub":{"issn":["00399353","24458112"],"issn_org":["00399353"],"issue":"1","journal":"Tandlægebladet","pages":"16-16","publisher":"Tandlægeforeningen","status":"p","title":"Tandlægebladet","volume":"129"},"review":"Undetermined","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-9eec935f-266b-4567-bc0d-220f1dd24e4d"],"src":["AU Aarhus University"],"title":"Kommentar til forskningsnyt: Bør man udskyde tandbørstning efter indtag af syreholdige drikke eller fødevarer?","type":"Journal Comment","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-796740","year":"2025","yearsub":"2025"}
{"abstract":"Aim: To examine the safety and efficacy of low-dose atropine (0.01% and 0.1% loading dose) after 2-year treatment and 1-year washout in 6-year-old to 12-year-old Danish children with myopia. Methods: Investigator-initiated, placebo-controlled, double-blind, randomised clinical trial. Of 124 screened children, 97 were randomised to receive 0.01% low-dose atropine for 24 months (0.01%) or 0.1% low-dose atropine for 6 months, then 0.01% for 18 months (0.1% loading dose) or placebo, followed by a 1-year washout. Altogether, 91 participants completed the study. The primary outcome was myopia progression (axial length (AL) and spherical equivalent refraction (SER)). Secondary outcomes were adverse events, ocular biometrical measurements and treatment responder eyes (myopia progression less than -0.50 diopters (D)). Constrained linear mixed models were constructed with individual eyes nested by participant ID, according to intention-to-treat. The responder analysis used Fisher's exact test. Significance levels were adjusted for multiple comparisons. Adjusted p values <0.05 were considered significant. Results: At 3 years, the mean AL was -0.06 mm (95% CI -0.18; 0.07) and -0.09 mm (95% CI -0.21; 0.04) less compared with placebo in the 0.1% loading dose group and 0.01% group. Mean SER was -0.02 D (95% CI -0.30; 0.26) less and 0.17 D (95% CI -0.11; 0.45) more compared with placebo in the 0.1% loading dose group and 0.01% group. There was no significant group difference in the responder eyes. Conclusion: There was no difference in myopia progression between groups following washout. A 6-month 0.1% loading dose did not improve efficacy compared with 0.01%. The 0.1% loading dose showed a rebound effect after dose switching.","author_count":7,"contributors":["Hansen, Niklas","Hvid-Hansen, Anders","Moller, Flemming","Bek, Toke","Larsen, Dorte Ancher","Jacobsen, Nina","Kessel, Line"],"cuid":["S01-000.00-807328"],"filters":{"added":"2025-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Hansen, Niklas"],"keyword":["Clinical trial","Optics and Refraction"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-HO-SDR","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"000000000003 year results of 000000000000 000000000001 and 000000000000 000000000001 loading dose atropine treatment including washout in danish children with myopia a placebo controlled randomised clinical trial","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1136/bjo-2024-326918","version":"Published Version"},"id":"S01-000.00-807328","identifier":[{"id":"105001415715","type":"scopus"},{"id":"40122578","type":"pmid"}],"ids":["au-b7082d8a-7ca5-4366-96d0-431bb656a4aa"],"keyword":["Child health (paediatrics)","Clinical Trial","Optics and Refraction"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-72C54678337A821A527A628102700FAA"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1136/bjo-2024-326918","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Lillebælt Hospital"],"nora_code":"DI-HO-SDR","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Ophthalmology"],"nora_code":"DI-U-AU","used":1},{"affno":"4","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Niklas","key":"hansenpau","last":"Hansen","name":"Hansen, Niklas","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders","key":"hvidhansenpau","last":"Hvid-Hansen","name":"Hvid-Hansen, Anders","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Flemming","key":"mollerpau","last":"Moller","name":"Moller, Flemming","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Toke","key":"bekpau","last":"Bek","locid":"ffc6d181-f10a-40f1-9446-0a5680b91ab8","name":"Bek, Toke","orcid":"0000-0002-0409-2534","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Dorte","key":"larsenpau","last":"Larsen","locid":"5e903371-0f65-473a-ad66-1a909c98a776","name":"Larsen, Dorte Ancher","name_org":"Larsen, Dorte","rank":5,"rolecode":"pau"},{"affno":"1 4","corresponding":null,"first":"Nina","key":"jacobsenpau","last":"Jacobsen","name":"Jacobsen, Nina","rank":6,"rolecode":"pau"},{"affno":"1 4","corresponding":null,"first":"Line","key":"kesselpau","last":"Kessel","name":"Kessel, Line","rank":7,"rolecode":"pau"}],"pmid":["40122578"],"pub":{"doi":"10.1136/bjo-2024-326918","issn":["00071161","14682079"],"issn_org":["00071161"],"issue":"9","journal":"British Journal of Ophthalmology","pages":"1056-1063","paperid":"bjo-2024-326918","publisher":"BMJ Publishing Group","status":"p","title":"British Journal of Ophthalmology","volume":"109"},"review":"Peer Reviewed","scoID":["2-s2.0-105001415715"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-b7082d8a-7ca5-4366-96d0-431bb656a4aa"],"src":["AU Aarhus University"],"title":"3-year results of 0.01% and 0.1% loading dose atropine treatment including washout in Danish children with myopia : a placebo-controlled, randomised clinical trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-807328","year":"2025","yearsub":"2025"}
{"abstract":"The increasing demand for enhanced communication systems, driven by applications such as real-time video streaming, online gaming, critical operations, and Internet-of-Things (IoT) services, has necessitated the optimization of cellular networks to meet evolving requirements while addressing power consumption challenges. In this context, various initiatives undertaken by industry, academia, and researchers to reduce the power consumption of cellular network systems are comprehensively reviewed. Particular attention is given to emerging technologies, including Software-Defined Networking (SDN), Network Function Virtualization (NFV), and Cloud-Radio Access Network (C-RAN), which are identified as key enablers for reshaping cellular infrastructure. Their collective potential to enhance energy efficiency while addressing convergence challenges is analyzed, and solutions for sustainable network evolution are proposed. A conceptual architecture based on SDN, NFV, and C-RAN is presented as an illustrative example of integrating these technologies to achieve significant power savings. The proposed framework outlines an approach to developing energy-efficient cellular networks, capable of reducing power consumption by approximately 40 to 50% through the optimal placement of virtual network functions.","author_count":6,"contributors":["Singh, Radheshyam","Larsen, Line M.P.","Ollora Zaballa, Eder","Berger, Michael Stübert","Kloch, Christian","Dittmann, Lars"],"cuid":["S01-000.00-808556"],"filters":{"added":"2025-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Berger, Michael Stübert","Singh, Radheshyam"],"keyword":["C RAN","Cellular network","Green","NFV","Power efficiency","SDN"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GTS","DI-PR","DI-U"],"level3":{"GTS":["DI-GTS-ALL","DI-GTS-FORC"],"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-GTS-FORC","DI-PR-OTH","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"enabling green cellular networks a review and proposal leveraging software defined networking network function virtualization and cloud radio access network","src":["dtu"],"src-code":["DI-U-DTU"],"type":"djr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.3390/fi17040161","version":"Published Version"},"id":"S01-000.00-808556","identifier":[{"id":"105003450373","type":"scopus"}],"ids":["dtu-7f8621d5-3735-4442-91ec-94f2c5c435a1"],"keyword":["C-RAN","Cellular network","NFV","Power efficiency","SDN","green"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-EC27DC697E7D86C0F061B22AECC26947"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/400048441/futureinternet-17-00161-v3.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.3390/fi17040161","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Electrical and Photonics Engineering","Technical University of Denmark, Department of Electrical and Photonics Engineering, Networks Technology and Service Platforms"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["TDC NET A/S"],"nora_code":"DI-PR-OTH","used":1},{"affno":"3","country":"dk","key":"force technology","l2":"DI-GTS","l2n":"GTS Institutes","l3":"DI-GTS-FORC","l3nn":"FORCE Technology","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"FORCE Technology","namevar":["FORCE Technology"],"nora_code":"DI-GTS-FORC","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Radheshyam","key":"singhpau","last":"Singh","locid":"f83d08d9-a6ab-4241-8837-f9a394ec9f6b","name":"Singh, Radheshyam","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Line M.P.","key":"larsenpau","last":"Larsen","name":"Larsen, Line M.P.","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Eder","key":"ollorazaballapau","last":"Ollora Zaballa","locid":"46a22edd-9011-4ff0-9924-c25b5f1467d6","name":"Ollora Zaballa, Eder","orcid":"0000-0003-4669-694X","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Michael Stübert","key":"bergerpau","last":"Berger","locid":"7b367889-bde0-4e40-893f-0a22e4d32371","name":"Berger, Michael Stübert","orcid":"0000-0003-4575-7261","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Christian","key":"klochpau","last":"Kloch","name":"Kloch, Christian","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars","key":"dittmannpau","last":"Dittmann","locid":"7bde347c-50e2-4d7b-bb89-618a9e2f2777","name":"Dittmann, Lars","orcid":"0000-0002-3660-6165","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.3390/fi17040161","issn":["19995903"],"issue":"4","journal":"Future Internet","paperid":"161","publisher":"MDPI","status":"p","title":"Future Internet","volume":"17"},"review":"Peer Reviewed","scoID":["2-s2.0-105003450373"],"sdg":["7. Affordable and Clean Energy","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All GTS Institutes","All Private Research","All Universities","DI-ALL","DI-GTS","DI-GTS-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","GTS Institutes","Other Companies","Private Research","Technical University of Denmark","Universities","tdc net a/s"],"PST":["Published"]},"sid":["dtu-7f8621d5-3735-4442-91ec-94f2c5c435a1"],"src":["DTU Technical University of Denmark"],"title":"Enabling Green Cellular Networks : A Review and Proposal Leveraging Software-Defined Networking, Network Function Virtualization, and Cloud-Radio Access Network","type":"Journal Review","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-808556","year":"2025","yearsub":"2025"}
{"abstract":"Background: Molnupiravir (MOV) is an orally bioavailable ribonucleoside with antiviral activity against all tested SARS-CoV-2 variants. We describe the demographic, clinical, and treatment characteristics of non-hospitalized Danish patients treated with MOV and their clinical outcomes following MOV initiation. Method: Among all adults (>18 years) who received MOV between 16 December 2021 and 30 April 2022 in an outpatient setting in Denmark, we summarized their demographic and clinical characteristics at baseline and post-MOV outcomes using descriptive statistics. Outcomes were emergent hospitalization and all-cause mortality during the 28 days after MOV initiation. We estimated the odds ratios (OR) of outcomes by time from positive test to treatment using logistic regression. Results: We identified 3691 MOV-treated patients, of whom 45.8% were male and mean age was 70.1 years. Most patients (76.2%) initiated MOV within 0-2 days after a positive SARS-CoV-2 test and 16.8% within 3-5 days. Over a 28-day period, rates for all-cause, respiratory- or COVID-19-related, and COVID-19-related hospitalization were 4.8%, 2.6% and 1.5%, respectively. All-cause mortality was 1.6%. Initiation of MOV 3-5 days after a positive SARS-CoV-2 test compared to 1-2 days was associated with an increased risk of all-cause (OR 1.85, 95% CI 1.29-2.67) and respiratory or COVID-19-related (OR 1.78, 95% CI 1.07-2.94) hospitalization, and all-cause mortality (OR 2.90, 95% CI 1.64-5.15). Conclusion: MOV was primarily prescribed to vaccinated elderly persons with multiple comorbidities. The all-cause hospitalization and mortality rates in this population were low. Early initiation of MOV reduced the risk of hospitalization and death compared with late initiation.","author_count":7,"contributors":["Larsen, Carsten Schade","Westergaard, Caroline Louise","Stærke, Nina B.","Arnet, Urs","Liu, Gui","Kantsø, Line R.","Kjellberg, Jakob"],"cuid":["S02-100.00-793469"],"filters":{"added":"2025-04","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["America, North","Europe, EU","Nordic","OECD"],"corresponding_author":["Westergaard, Caroline L."],"country":["Finland","United States"],"glorg":["All Global Affiliations","Center for Observational and Real-world Evidence","Merck"],"keyword":["Coronavirus","Covid 19","Dødelighed","Hospitalization","Molnupiravir","Mortality","SARS CoV 2"],"level":"sci","mra":["med","soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-PR","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-VIVE"],"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-GV-VIVE","DI-PR-OTH","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"clinical outcomes among covid 000000000019 patients initiated on molnupiravir in denmark a national registry study","src":["au","vive"],"src-code":["DI-GV-VIVE","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1177/13596535241313244","version":"Published Version"},"id":"S02-100.00-793469","identifier":[{"id":"85215609507","type":"scopus"},{"id":"39836400","type":"pmid"}],"ids":["au-e6508b1c-d106-4a00-b7f9-66809c848e99","vive-cbefb236-f960-4df4-a836-8a3329caa371"],"keyword":["COVID-19","Coronavirus","SARS-CoV-2","dødelighed","hospitalization","molnupiravir","mortality"],"lang":"English","level":"Scientific","mra":["Medical Science","Social Science"],"noi":["Global-Local-2-4-EC4A1D48FC2E0BFF4B5B4B1BDA382164"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1177/13596535241313244","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Infectious Diseases"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"vive the danish center for social science research","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-VIVE","l3nn":"VIVE The Danish Center for Social Science Research","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"VIVE The Danish Center for Social Science Research","namevar":["VIVE - The Danish Center for Social Science Research, VIVE Health"],"nora_code":"DI-GV-VIVE","used":1},{"affno":"3","country":"fi","key":"center for observational and real world evidence","loc":["Finland","Europe, EU","Nordic","OECD"],"name":"Center for Observational and Real-world Evidence","used":1},{"affno":"4","country":"us","key":"merck","loc":["United States","America, North","OECD"],"name":"Merck","used":1},{"affno":"5","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["MSD Denmark; Ballerup Denmark"],"nora_code":"DI-PR-OTH","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Carsten S.","key":"larsenpau","last":"Larsen","locid":"2435cb82-03bd-498b-909d-1ef0e99443fe","name":"Larsen, Carsten Schade","name_org":"Larsen, Carsten S.","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Caroline Louise","key":"westergaardpau","last":"Westergaard","locid":"764775b5-1fd6-48fe-927f-44aaaf597ee9","name":"Westergaard, Caroline Louise","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Nina B.","key":"stærkepau","last":"Stærke","locid":"67e49a1a-1340-4793-a1a8-8607f305108b","name":"Stærke, Nina Breinholt","name_org":"Stærke, Nina B.","orcid":"0000-0002-5834-2033","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Urs","key":"arnetpau","last":"Arnet","name":"Ar