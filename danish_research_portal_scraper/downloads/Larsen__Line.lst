mi L.","orcid":"0009-0001-1642-2297","rank":35,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Trine A.","key":"andersentrineapau","last":"Andersen","name":"Andersen, Trine A.","rank":36,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Trine C.","key":"larsentrinecpau","last":"Larsen","name":"Larsen, Trine C.","rank":37,"rolecode":"pau"}],"pub":{"doi":"10.11581/dtu.000003","isbn":["9788774813934"],"issn":["13958216"],"issue":"457-2024","pages":"38","publisher":"Danmarks Tekniske Universitet","repno":"DTU Aqua-rapport, 457-2024","series":"DTU Aqua-rapport","status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All GTS Institutes","All Universities","DI-ALL","DI-GTS","DI-GTS-ALL","DI-U","DI-U-ALL","GTS Institutes","Technical University of Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-98125997-674b-4af1-91f2-b7f798a4aed8"],"src":["SDU University of Southern Denmark"],"title":"Ålegræstransplantering og tangdyrkning som marine virkemidler : Potentialer, effekter og juridiske aspekter: Opsummering af hovedresultater fra projektet","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-750732","year":"2024","yearsub":"2024"}
{"abstract":"Wearable technologies such as inertial measurement units (IMUs) can be used to evaluate human gait and improve mobility, but sensor fixation is still a limitation that needs to be addressed. Therefore, aim of this study was to create a machine learning algorithm to predict gait events using a single IMU mimicking the carrying of a smartphone. Fifty-two healthy adults (35 males/17 females) walked on a treadmill at various speeds while carrying a surrogate smartphone in the right hand, front right trouser pocket, and right jacket pocket. Ground-truth gait events (e.g. heel strikes and toe-offs) were determined bilaterally using a gold standard optical motion capture system. The tri-dimensional accelerometer and gyroscope data were segmented in 20-ms windows, which were labelled as containing or not the gait events. A long-short term memory neural network (LSTM-NN) was used to classify the 20-ms windows as containing the heel strike or toe-off for the right or left legs, using 80% of the data for training and 20% of the data for testing. The results demonstrated an overall accuracy of 92% across all phone positions and walking speeds, with a slightly higher accuracy for the right-side predictions (∼94%) when compared to the left side (∼91%). Moreover, we found a median time error <3% of the gait cycle duration across all speeds and positions (∼77 ms). Our results represent a promising first step towards using smartphones for remote gait analysis without requiring IMU fixation, but further research is needed to enhance generalizability and explore real-world deployment.","author_count":4,"contributors":["Larsen, Aske Gye","Sadolin, Line Ø.","Thomsen, Trine Rolighed","Oliveira, Anderson Souza"],"cuid":["S01-000.00-770449"],"filters":{"added":"2025-01","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Artificial intelligence","Gait analysis","IMU","Locomotion","Machine learning","Smartphone"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"accurate detection of gait events using neural networks and imu data mimicking real world smartphone usage","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1080/10255842.2024.2423252","version":"Published Version"},"id":"S01-000.00-770449","identifier":[{"id":"85208967459","type":"scopus"}],"ids":["aau-6bb879ce-f171-452f-a712-4d1a6fce398e"],"keyword":["IMU","Machine learning","artificial intelligence","gait analysis","locomotion","smartphone"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-E6F6D89A4897231E5F24E5DD6B9116FC"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1080/10255842.2024.2423252","version":"Published Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience, Medical Biotechnology"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Aske Gye","key":"larsenpau","last":"Larsen","locid":"46714b8a-5f5a-43f8-b9a9-a59f8255c179","name":"Larsen, Aske Gye","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Line Ø.","key":"sadolinpau","last":"Sadolin","locid":"613d453c-10e0-451e-8317-66aeec7bd8ff","name":"Sadolin, Line Ø.","orcid":"0009-0006-2187-2125","rank":2,"rolecode":"pau"},{"affno":"1","corresponding