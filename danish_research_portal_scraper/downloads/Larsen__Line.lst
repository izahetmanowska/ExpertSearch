{"author_count":10,"contributors":["Alstrøm, Tommy Sonne","Bosco, Filippo","Larsen, Jan","Bache, Michael","Brøgger, Anna Line","Frøhling, Kasper Bayer","Hwu, E. T.","Chen, Ching-Hsiu","Hwang, Ing-Shouh","Boisen, Anja"],"cuid":["S01-000.00-325500"],"event":{"end":"2014-05-02","place":"Madrid, es","start":"2014-04-30","title":"11th Annual International Workshop on Nanomechanical Sensing","year":"2014"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"characterization of the time evolving bending profile of micro cantilevers","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dco","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/98239972/NMC_2014_posterv2.pdf","version":"Published Version"},"id":"S01-000.00-325500","ids":["dtu-4658069d-e22e-43be-99fb-72d0d8755f55"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-07223646FEF21F7843BF8838B6AED61F"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/98239972/NMC_2014_posterv2.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Applied Mathematics and Computer Science","Technical University of Denmark, Department of Applied Mathematics and Computer Science, Cognitive Systems","Technical University of Denmark, Department of Micro- and Nanotechnology"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Tommy Sonne","key":"alstrømpau","last":"Alstrøm","locid":"2c1b856d-1052-4f55-9980-0610fbb49cce","name":"Alstrøm, Tommy Sonne","orcid":"0000-0003-0941-3146","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Filippo","key":"boscopau","last":"Bosco","locid":"e33b40d4-116a-4fe3-b581-6af81aef0039","name":"Bosco, Filippo","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jan","key":"larsenpau","last":"Larsen","locid":"172b79ba-ccb1-4bea-8cd3-30dfd62f4624","name":"Larsen, Jan","orcid":"0000-0003-1880-1810","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Michael","key":"bachepau","last":"Bache","locid":"a9f51f4b-029a-42c4-aa3b-1aa14acf32f6","name":"Bache, Michael","orcid":"0000-0002-5552-3621","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anna Line","key":"brøggerpau","last":"Brøgger","locid":"913e68d4-a104-4202-97fb-7695c85e308c","name":"Brøgger, Anna Line","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kasper Bayer","key":"frøhlingpau","last":"Frøhling","locid":"faf06581-12a9-413f-9a56-259c4d7e9e0e","name":"Frøhling, Kasper Bayer","rank":6,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"E. T.","key":"hwupau","last":"Hwu","name":"Hwu, E. T.","rank":7,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Ching-Hsiu","key":"chenpau","last":"Chen","name":"Chen, Ching-Hsiu","rank":8,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Ing-Shouh","key":"hwangpau","last":"Hwang","name":"Hwang, Ing-Shouh","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anja","key":"boisenpau","last":"Boisen","locid":"898c472f-7fe0-4454-83d8-564450caa2cb","name":"Boisen, Anja","orcid":"0000-0002-9918-6567","rank":10,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish