{"author_count":11,"contributors":["Thilsing, Trine","Christensen, Jeanette Reffstrup","Larrabee Sonderlund, Anders","Thomsen, Janus Laust","Waldorff, Frans Boch","Søndergaard, Jens","Hvidt, Niels Christian","Assing Hvidt, Elisabeth","Svensson, Nanna Herning","Pedersen, Line Bjørnskov","Bruun Larsen, Lars"],"cuid":["S01-000.00-613253"],"event":{"end":"2018-11-16","place":"København, dk","start":"2018-11-12","title":"Lægedage","year":"2018"},"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"projekt tidlig opsporing og forebyggelse tof projektet","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dco","type-grp":["all","pub"]},"id":"S01-000.00-613253","ids":["sdu-8bb25518-726e-442b-9898-e6f59ceb6ab5"],"lang":"Danish","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-5D06E1CEE2016D6F0A14779A45DF6DA9"],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Public Health, Research Unit of General Pratice"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Trine","key":"thilsingpau","last":"Thilsing","locid":"6ae25242-1e96-48cf-ab01-cbac26690f6b","name":"Thilsing, Trine","orcid":"0000-0002-2041-2219","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jeanette Reffstrup","key":"christensenpau","last":"Christensen","locid":"7b0b955e-4090-479a-8bef-6fd6ad983680","name":"Christensen, Jeanette Reffstrup","orcid":"0000-0002-2412-5989","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders","key":"larrabeesonderlundpau","last":"Larrabee Sonderlund","locid":"052e950e-ab44-4d41-869d-4a3d4a37c62e","name":"Larrabee Sonderlund, Anders","orcid":"0000-0002-6627-3322","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Janus Laust","key":"thomsenpau","last":"Thomsen","locid":"109619c5-41c7-4049-897f-5d6f92e4fe12","name":"Thomsen, Janus Laust","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Frans Boch","key":"waldorffpau","last":"Waldorff","locid":"fe7333f7-ac6d-4ad4-84b7-fdf7b5bf6d22","name":"Waldorff, Frans Boch","orcid":"0000-0002-7859-633X","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens","key":"søndergaardpau","last":"Søndergaard","locid":"4829db0c-8486-4ad1-8e6b-d4f3dc56c386","name":"Søndergaard, Jens","orcid":"0000-0002-1629-1864","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Niels Christian","key":"hvidtpau","last":"Hvidt","locid":"13b593c4-9280-4cef-aafc-8b3cd6b7c659","name":"Hvidt, Niels Christian","orcid":"0000-0002-6311-9784","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Elisabeth","key":"assinghvidtpau","last":"Assing Hvidt","locid":"8c678f9e-b6bc-401c-b9ca-561b04c3ec2b","name":"Assing Hvidt, Elisabeth","orcid":"0000-0003-3762-8478","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Nanna Herning","key":"svenssonpau","last":"Svensson","locid":"59d583e0-5617-4c28-8cf9-ae2d078c177a","name":"Svensson, Nanna Herning","orcid":"0000-0002-3359-498X","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Line Bjørnskov","key":"pedersenpau","last":"Pedersen","locid":"b2346680-b60a-41e8-9332-304171fab9be","name":"Pedersen, Line Bjørnskov","orcid":"0000-0001-6804-2045","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lars","key":"bruunlarsenpau","last":"Bruun Larsen","locid":"1418e278-0f71-406e-b479-3429aca4b01d","name":"Bruun Larsen, Lars","orcid":"0000-0001-9120-4751","rank":11,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-8bb25518-726e-442b-9898-e6f59ceb6ab5"],"src":["SDU University of Southern Denmark"],"title":"Projekt Tidlig Opsporing og Forebyggelse (TOF projektet)","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-613253","year":"2018","yearsub":"2018"}
{"abstract":"High coverage is essential for the effectiveness of national screening programmes. Identifying non-screeners across different screening programmes may help inform strategies to improve uptake. This study aims to analyse the association between previous cervical cancer screening (CCS) coverage and participation in breast cancer screening (BCS). This historical register-based cohort study included 91,787 Danish women aged 50-64 years who were invited to participate in the first organised round of BCS in the Central Denmark Region (CDR) in 2008-09. CCS coverage was defined as having a smear registered in the 5 1/2 years preceding the BCS, and BCS participants were divided into participants and non-participants and further categorised as active non-participants (ANP) if they cancelled and passive non-participants (PNP) if they abstained from the appointment. Of all 91,787 women included in the study, 62,391 (68%) were covered both by CCS and participated in BCS. Women not covered by CCS were more likely to be non-participants in BCS than women covered by CCS (PRRadjusted = 2.80, 95% CI: 2.68-2.93). Both PNP (PRRadjusted = 3.99, 95% CI: 3.80-4.19) and ANP (PRRadjusted = 2.50, 95% CI: 2.34-2.68) were more likely not to be covered by the CCS. In conclusion, non-coverage by CCS was strongly associated with nonparticipation in BCS. Specific groups of women only participated in one screening programme. To increase uptake, future interventions may specifically target these groups.","author_count":5,"contributors":["Larsen, S H","Virgilsen, Line Flytkjær","Kristiansen, Bettina Kjær","Andersen, Berit","Vedsted, Peter"],"cuid":["S01-000.00-202724"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Breast cancer screening","Cervical cancer screening","Coverage","Denmark","Mammography","Non participation"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"strong association between cervical and breast cancer screening behaviour among danish women a register based cohort study","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.pmedr.2018.10.017","version":"Published Version"},"id":"S01-000.00-202724","identifier":[{"id":"PMC6234495","type":"pmcid"},{"id":"30450274","type":"pmid"},{"id":"85056321356","type":"scopus"}],"ids":["au-805659ac-f10b-4f49-891c-cb9f84811c3f"],"keyword":["Breast cancer screening","Cervical cancer screening","Coverage","Denmark","Mammography","Non-participation","Smear"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-934AD7E45B972EEB91C0A9499D7B42F8"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.pmedr.2018.10.017","version":"Published Version"},{"access":"oa","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pubmed/30450274","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Public Health, Department of Public Health - Forskningsenheden for Almen Praksis"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"S H","key":"larsenpau","last":"Larsen","locid":"edc532ba-8d47-4b90-91a3-8e3bedc64597","name":"Larsen, S H","orcid":"0009-0001-9795-6572","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"L F","key":"virgilsenpau","last":"Virgilsen","locid":"6ff51f4d-e27a-4646-8a7a-0123c17fddc7","name":"Virgilsen, Line Flytkjær","name_org":"Virgilsen, L F","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"B K","key":"kristiansenpau","last":"Kristiansen","locid":"eaf754ff-9cac-49b6-a15b-a69a4474687f","name":"Kristiansen, Bettina Kjær","name_org":"Kristiansen, B K","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"B","key":"andersenpau","last":"Andersen","locid":"4f64dc11-e5ca-4037-bbad-8ca533d841e4","name":"Andersen, Berit","name_org":"Andersen, B","orcid":"0000-0003-4074-6504","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"P","key":"vedstedpau","last":"Vedsted","locid":"bb00d9e7-866c-4f04-8e3b-a71c913c39b0","name":"Vedsted, Peter","name_org":"Vedsted, P","orcid":"0000-0003-2113-5599","rank":5,"rolecode":"pau"}],"pmid":["30450274"],"pub":{"doi":"10.1016/j.pmedr.2018.10.017","issn":["22113355"],"journal":"Preventive Medicine Reports","pages":"349-354","publisher":"Elsevier Inc.","status":"p","title":"Preventive Medicine Reports","volume":"12"},"review":"Peer Reviewed","scoID":["2-s2.0-85056321356"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-805659ac-f10b-4f49-891c-cb9f84811c3f"],"src":["AU Aarhus University"],"title":"Strong association between cervical and breast cancer screening behaviour among Danish women; A register-based cohort study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-202724","year":"2018","yearsub":"2018"}
{"abstract":"OBJECTIVES: The aim of this randomized, double-blind, crossover study was to measure fluoride in saliva and 7-day-old biofilm fluid and biofilm solids after rinsing three times per day for 3 weeks with 0, 1500, or 5000 ppm fluoride (NaF). MATERIALS AND METHODS: Following the 3-week wash-in/wash-out period, including 1 week of biofilm accumulation, saliva and biofilm samples were collected from 12 participants immediately before (background fluoride), and 10, 30, and 60 min after a single rinse. Biofilm samples were separated into fluid and solids, and samples were analyzed using a fluoride electrode (microanalysis). RESULTS: The background fluoride concentration was statistically significantly higher in the 5000 compared to the 1500 ppm F rinse group in all three compartments (22.3 and 8.1 μM in saliva, 126.8 and 58.5 μM in biofilm fluid, and 10,940 and 4837 μmol/kg in biofilm solids). The 1-h fluoride accumulation for the 5000 ppm F rinse was higher than for the 1500 ppm F rinse in all three compartments, although not statistically significant for saliva and biofilm solids. CONCLUSION: Regular exposure to 5000 ppm fluoride elevates background fluoride concentrations in saliva, biofilm fluid, and biofilm solids compared to 1500 ppm fluoride. Increasing the fluoride concentration almost 3.5 times (from 1500 to 5000 ppm) only elevates the background fluoride concentrations in saliva, biofilm fluid, and biofilm solids twofold. CLINICAL RELEVANCE: Even though fluoride toothpaste may be diluted by saliva, the results of the present study indicate that use of 5000 ppm fluoride toothpaste might lead to improved caries control.","author_count":5,"contributors":["Staun Larsen, Line","Bælum, Vibeke","Tenuta, Livia Maria Andaló","Richards, Alan","Nyvad, Bente"],"cuid":["S01-000.00-249268"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Journal Article"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"fluoride in saliva and dental biofilm after 000000001500 and 000000005000 ppm fluoride exposure","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85028744554","version":"Other Version"},"id":"S01-000.00-249268","identifier":[{"id":"85028744554","type":"scopus"},{"id":"28865065","type":"pmid"}],"ids":["au-d1e60a3c-c58a-46cd-a8f3-fba9404ec1ab"],"keyword":["Journal Article"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-E0708D48433B5960AC48C6715191A003"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Dentistry and Oral Health, Department of Dentistry and Oral Health - Section for Pediatric Dentistry"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Line","key":"staunlarsenpau","last":"Staun Larsen","locid":"35e2ae60-25db-4a15-893f-dc8906e2bccf","name":"Staun Larsen, Line","orcid":"0000-0002-4155-5884","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Vibeke","key":"baelumpau","last":"Baelum","locid":"fa28bbda-971e-4463-be61-3dcc358973b2","name