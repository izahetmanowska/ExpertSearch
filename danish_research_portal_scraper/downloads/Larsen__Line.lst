 University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Geosciences and Natural Resource Management, Landscape Architecture and Planning","Københavns Universitet, Faculty of Science, Department of Geosciences and Natural Resource Management, Nature, Health and Design"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"dk","key":"via university college","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-VIA","l3nl":"VIA University College","l3nn":"VIA University College","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"VIA University College","namevar":["VIA University College"],"nora_code":"DI-UC-VIA","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Line Elisabeth","key":"lindahljacobsenpau","last":"Lindahl-Jacobsen","locid":"cb2c3d9c-2ec4-43e2-b6ec-7cf77ac4f758","name":"Lindahl-Jacobsen, Line Elisabeth","orcid":"0000-0002-8538-217X","rank":1,"rolecode":"pau"},{"affno":"2","first":"Dorthe Varning","key":"poulsenpau","last":"Poulsen","locid":"7605968b-963e-4d7c-a8a8-a40790c0cc2d","name":"Poulsen, Dorthe Varning","orcid":"0000-0001-8547-5424","rank":2,"rolecode":"pau"},{"affno":"3","first":"Lone","key":"toftpau","last":"Toft","name":"Toft, Lone","rank":3,"rolecode":"pau"},{"affno":"","first":"Anette Enemark","key":"larsenpedh","last":"Larsen","name":"Larsen, Anette Enemark","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Lene","key":"duuspedh","last":"Duus","name":"Duus, Lene","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Brigitte","key":"sørensenpedh","last":"Sørensen","name":"Sørensen, Brigitte","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["9788712064893"],"pages":"239-255","place":"København","publisher":"Gad","status":"p","subtitle":"en personcentreret tilgang på tværs af professioner og sektorer","title":"Brugerinvolvering i sundhedsvæsnet"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","All University Colleges","DI-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","Universities","University College Absalon","University Colleges","University of Copenhagen","VIA University College"],"PST":["Published"]},"sid":["ku-28c9e1f7-8cd1-4933-8ef7-61cbbb48db64","pha-3345a40d-99cc-41bd-880c-5ae414bd381f"],"src":["AB University College Absalon","KU University of Copenhagen"],"title":"Borgeren, der modtager palliative indsatser i eget hjemme eller på hospice","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-083.33-686225","year":"2023","yearsub":"2023"}
{"abstract":"Objective: To compare the consumption of antibiotics (AB), systemic steroids, and inhaled bronchodilators/glucocorticoids in the 3 years preceding the diagnosis of common variable immunodeficiency (CVID) among CVID patients and matched controls and to estimate whether the level of consumption was associated with the risk of a subsequent CVID diagnosis. Methods: We conducted a nested case-control study, identifying all individuals (n=130 cases) diagnosed with CVID in Denmark (1994-2014) and 45 age- and sex-matched population controls per case (n=5850 controls) from national registers. Drug consumption was estimated as defined daily doses per person-year. We used conditional logistic regression to compute odds ratios and 95% confidence intervals. Results: In the 3 years preceding a CVID diagnosis, we observed more frequent and higher consumption of all three drug classes. The association between consumption and risk of subsequent CVID diagnosis was statistically significant for all drug classes. The association was stronger with higher consumption and shorter time to CVID diagnosis. The fraction of cases compared to the controls redeeming ≥1 prescription of the included drugs during the study period was higher for AB (97% vs 52%), systemic steroids (35% vs 7.4%), and inhaled bronchodilators/glucocorticoids (46% vs 11.7%) (p<0.001). Conclusion: CVID patients have significantly higher use of AB, systemic steroids, and inhaled bronchodilators/glucocorticoids in the 3 years preceding CVID diagnosis than controls. Prescribing these drugs in primary healthcare could be an opportunity to consider (proactive) screening for CVID. Further studies are needed to identify optimal prescription cutoffs that could endorse its inclusion in public health policies.","author_count":9,"contributors":["Ilkjær, Frederik V.","Johansen, Isik S.","Martin-Iguacel, Raquel","Westh, Lena","Katzenstein, Terese L.","Hansen, Ann-Brit E.","Nielsen, Thyge L.","Larsen, Carsten S.","Rasmussen, Line D."],"cuid":["S04-100.00-741583"],"filters":{"added":"2023-11","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":4,"corresponding_author":["Ilkjær, Frederik V."],"keyword":["Bronchodilator Agents","CVID","Case Control Studies","Common Variable Immunodeficiency diagnosis","Diagnostic delay","Drug Prescriptions","Drug prescription","Humans","Indicators","PID","Primary care","Steroids"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"evaluating drug prescription patterns in undiagnosed common variable immunodeficiency patients","src":["aau","au","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85173026962","version":"Other Version"},"funding_acknowledgement":["The authors of this study greatly appreciate the work of all the physicians who have provided data on the CVID patients, as well as the patients included in this study and the Danish adult CVID cohort; this study could not have been completed without the help of the Danish adult CVID cohort."],"id":"S04-100.00-741583","identifier":[{"id":"85173026962","type":"scopus"},{"id":"37833619","type":"pmid"}],"ids":["aau-e6ad4cbc-2289-4f2c-8376-75d60df66cc7","au-984846e8-72ee-4f5d-bac4-2d265e001666","ku-6c626e01-622e-4f55-9eb7-73d5ff757edd","sdu-52831abd-8789-4172-9589-0efe3cfff73e"],"keyword":["Bronchodilator Agents","CVID","Case-Control Studies","Common Variable Immunodeficiency/diagnosis","Drug Prescriptions","Humans","PID","Steroids","diagnostic delay","drug prescription","indicators","primary care"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-7-C99031773547559CD4977438B882D347"],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Medicinsk Afdeling, Farsø/Hobro/Thisted","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Odense University Hospital"],"nora_code":"DI-HO-SDR","used":1},{"affno":"3","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Infectious Diseases (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"4","country":"dk","key":"north denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-NDR","l3nl":"North Denmark Region","l3nn":"North Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"North Denmark Region","namevar":["Aalborg University Hospital"],"nora_code":"DI-HO-NDR","used":1},{"affno":"5","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Infectious Diseases"],"nora_code":"DI-U-AU","used":1},{"affno":"6","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1},{"affno":"7","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Rigshospitalet, Copenhagen University Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"8","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Internal medicine: infection medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1 2 3 4","corresponding":null,"country":"dk","first":"Frederik V.","key":"ilkjærpau","last":"Ilkjær","locid":"086874bb-598e-40d8-863f-ab8c69fbfbec","name":"Ilkjær, Frederik V.","rank":1,"rolecode":"pau"},{"affno":"3 2","corresponding":null,"first":"Isik S.","key":"johansenpau","last":"Johansen","locid":"d7a439ff-f0ad-43c9-80d8-a269647e1886","name":"Johansen, Isik Somuncu","name_org":"Johansen, Isik S.","orcid":"0000-0002-2189-9823","rank":2,"rolecode":"pau"},{"affno":"3 2","corresponding":null,"first":"Raquel","key":"martiniguacelpau","last":"Martin-Iguacel","locid":"458ec645-67fa-48e3-b302-2239bd857531","name":"Martin-Iguacel, Raquel","orcid":"0000-0003-3543-1970","rank":3,"rolecode":"pau"},{"affno":"5 6","corresponding":null,"first":"Lena","key":"westhpau","last":"Westh","locid":"6c54d03c-7758-4ac9-b27a-c606f993066f","name":"Westh, Lena","rank":4,"rolecode":"pau"},{"affno":"7","corresponding":null,"first":"Terese L.","key":"katzensteinpau","last":"Katzenstein","name":"Katzenstein, Terese L.","rank":5,"rolecode":"pau"},{"affno":"8 7","first":"Ann-Brit E.","key":"hansenpau","last":"Hansen","locid":"29b6e1f5-8374-4247-a7bd-76de887cc30d","name":"Hansen, Ann-Brit Eg","name_org":"Hansen, Ann-Brit E.","rank":6,"rolecode":"pau"},{"affno":"7","corresponding":null,"first":"Thyge L.","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Thyge L.","rank":7,"rolecode":"pau"},{"affno":"5 6","corresponding":null,"country":"dk","first":"Carsten S.","key":"larsenpau","last":"Larsen","locid":"2435cb82-03bd-498b-909d-1ef0e99443fe","name":"Larsen, Carsten Schade","name_org":"Larsen, Carsten S.","rank":8,"rolecode":"pau"},{"affno":"3 2","corresponding":null,"first":"Line D.","key":"rasmussenpau","last":"Rasmussen","locid":"a0349aeb-56d9-4984-86b0-4829aee2a04b","name":"Rasmussen, Line Dahlerup","name_org":"Rasmussen, Line D.","orcid":"0000-0003-0853-0893","rank":9,"rolecode":"pau"}],"pmid":["37833619"],"pub":{"doi":"10.1007/s10875-023-01598-1","issn":["02719142","15732592"],"issn_org":["02719142"],"issue":"8","journal":"Journal of Clinical Immunology","pages":"2181-2191","publisher":"Springer","status":"p","title":"Journal of Clinical Immunology","volume":"43"},"review":"Peer Reviewed","scoID":["2-s2.0-85173026962"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-e6ad4cbc-2289-4f2c-8376-75d60df66cc7","au-984846e8-72ee-4f5d-bac4-2d265e001666","ku-6c626e01-622e-4f55-9eb7-73d5ff757edd","sdu-52831abd-8789-4172-9589-0efe3cfff73e"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Evaluating Drug Prescription Patterns in Undiagnosed Common Variable Immunodeficiency Patients","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-100.00-741583","year":"2023","yearsub":"2023"}
{"abstract":"OBJECTIVE: To compare the risk of a positive SARS-CoV-2 test and COVID-19 outcomes in people living with HIV (PLWH) with the general population, and estimate the association with vaccination status. DESIGN: A nationwide, population based, matched cohort study. METHODS: We included all Danish PLWH ≥18 years (n = 5,276) and an age-and sex matched general population cohort (n = 42,308).We used Cox regression analyses to calculate (adjusted) incidence rate ratios [(a)IRR] and further stratified and restricted the analyses. RESULTS: We observed no major difference in risk of first positive SARS-CoV-2 test [aIRR: 0.8 (95%CI: 0.8-0.9)], but a higher risk of first hospital contact with COVID-19 and hospitalization with severe COVID-19 for PLWH vs. controls [IRR: 2.0; (1.6-2.5), 1.8 (1.4-2.3)]. Risk of first hospitalization decreased substantially in PLWH with calendar time [First half of year 2022 vs. 2020 IRR: 0.3; (0.2-0.6)], whereas the risk compared to population controls remained almost 2-fold increased. We did not observe increased risk of death after SARS-CoV-2 infection [aIRR: 0.7 (95%CI: 0.3-2.0)]. Compared to PLWH who had received two vaccines PLWH who receiving a third vaccine had reduced risk of first positive SARS-CoV-2 test, death (individuals ≥60years) and hospitalization [aIRR: 0.9 (0.7-1.0); 0.2 (0.1-0.7); 0.6 (0.2-1.2)]. CONCLUSION: PLWH have almost the same risk of a positive SARS-CoV-2 test as the general population. Although risk of hospital contacts and severe outcomes following SARS-CoV-2 infection is increased, the risk of death does not seem to be substantially increased. Importantly, a third vaccine is associated with reduced risk of infection, and death.","author_count":13,"contributors":["Rasmussen, Line D","Cowan, Susan","Gerstoft, Jan","Kronborg, Gitte","Johansen, Isik S","Larsen, Carsten Schade","Weise, Lothar","Dalager-Pedersen, Michael","Leth, Steffen","Nielsen, Lars N","Lunding, Suzanne","Omland, Lars H","Obel, Niels"],"cuid":["S01-000.00-264450"],"filters":{"added":"2022-11","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"corresponding_author":["Obel, Niels"],"keyword":["Coronavirus disease 2019","HIV CD4 cell count","Severe acute respiratory syndrome coronavirus 2","severe acute respiratory syndrome coronavirus 2 vaccines"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-ZEA"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-HO-ZEA","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"outcomes following sars cov 000000000002 infection among individuals living with and without hiv a danish nationwide cohort study","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85144590168","version":"Other Version"},"id":"S01-000.00-264450","identifier":[{"id":"36129108","type":"pmid"},{"id":"85144590168","type":"scopus"}],"ids":["au-ecbde8c0-7e2d-4ba1-a230-fdad44569b71"],"keyword":["HIV, CD4 cell count","coronavirus disease 2019","severe acute respiratory syndrome coronavirus 2","severe acute respiratory syndrome coronavirus 2 vaccines"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-3-7-0D8A973537A0282020ECDBCAB4785907"],"org":[{"affno":"1","country":"dk","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["University of Southern Denmark (SDU)"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"ssi statens serum institut","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-SSI","l3nn":"SSI Statens Serum Institut","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SSI Statens Serum Institut","namevar":["Statens Serum Institut"],"nora_code":"DI-GV-SSI","used":1},{"affno":"3","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Capitol Region of Denmark"],"nora_code":"DI-HO-CAP","used":1},{"affno":"4","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"5","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Infectious Diseases"],"nora_code":"DI-U-AU","used":1},{"affno":"6","country":"dk","key":"region zealand","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-ZEA","l3nl":"Region Zealand","l3nn":"Region Zealand","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region Zealand","namevar":["Zealand University Hospital"],"nora_code":"DI-HO-ZEA","used":1},{"affno":"7","country":"dk","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University (AAU)"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Line D","key":"rasmussenpau","last"