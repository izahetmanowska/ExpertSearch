ing":null,"first":"Jan","key":"gerstoftpau","last":"Gerstoft","name":"Gerstoft, Jan","rank":8,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Lars H","key":"omlandpau","last":"Omland","name":"Omland, Lars H","rank":9,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Line D.","key":"rasmussenpau","last":"Rasmussen","locid":"a0349aeb-56d9-4984-86b0-4829aee2a04b","name":"Rasmussen, Line Dahlerup","name_org":"Rasmussen, Line D.","orcid":"0000-0003-0853-0893","rank":10,"rolecode":"pau"}],"pmid":["40463830"],"pub":{"doi":"10.1093/ofid/ofaf289","issn":["23288957"],"issue":"6","journal":"Open Forum Infectious Diseases","paperid":"ofaf289","publisher":"Oxford University Press","status":"p","title":"Open Forum Infectious Diseases","volume":"12"},"review":"Peer Reviewed","scoID":["2-s2.0-105008283165"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-088a1a90-f4f0-4db3-9d7a-68133ee111b5","sdu-9d498bef-b012-4bef-b039-e690804fca35"],"src":["AAU Aalborg University","SDU University of Southern Denmark"],"title":"Pneumocystis Pneumonia—Is it Still a Threat Among People With Human Immunodeficiency Virus (HIV)? : A Danish HIV Cohort Study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-813284","year":"2025","yearsub":"2025"}
{"abstract":"Pregnancy induces a variety of changes in the eye. Mapping these changes provides a pathophysiological basis for understanding pregnancy-associated ocular disorders. In this systematic review and meta-analysis, our aim was to determine how pregnancy affects subfoveal choroidal thickness and to explore temporal changes in subfoveal choroidal thickness during pregnancy and postpartum. On April 7, 2024, we searched eight literature databases for studies which used macular optical coherence tomography to evaluate subfoveal choroidal thickness in healthy pregnant women. We identified 26 studies summarizing data from 1935 healthy women, of which 1096 were pregnant and 839 non-pregnant. We found that pregnant women had a subfoveal choroidal thickness which was 31.1 μm (95% CI: 19.4–42.7 μm) thicker than non-pregnant women. No statistically significant changes were observed throughout trimesters. From the 3rd trimester to postpartum, we found a reduction in the subfoveal choroidal thickness at −41.9 μm (95% CI: −68.5 to −15.2 μm). In conclusion, in healthy women without ocular disease, pregnancy is associated with a thicker subfoveal choroid indicating a higher choroidal perfusion. Choroidal thickness remains stable across trimesters and is reduced postpartum, indicating a temporary physiological adaptation during pregnancy.","author_count":8,"contributors":["Larsen, Maria Prehn","Iqbal, Hunan","Grauslund, Jakob","Klefter, Oliver Niels","Krogh Nielsen, Marie","Petersen, Line","Yanik, Özge","Subhi, Yousif"],"cuid":["S03-097.51-822643"],"filters":{"added":"2025-04","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":3,"continent":["Asia, Middle East","Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Subhi, Yousif"],"country":["Norway","Turkey"],"glorg":["All Global Affiliations","Ankara University","Vestfold Hospital Trust"],"keyword":["Choroidal thickness","Meta analysis","Pregnancy","Systematic review"],"level":"sci","mra":["med"],"oa":"Embargoed Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-SDR","DI-HO-ZEA"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-SDR","DI-HO-ZEA","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"subfoveal choroidal thickness in pregnancy a systematic review with meta analyses","src":["au","ku","sdu"],"src-code":["DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"djr","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85217046243","version":"Other Version"},"id":"S03-097.51-822643","identifier":[{"id":"85217046243","type":"scopus"},{"id":"39912315","type":"pmid"}],"ids":["au-73e6a820-f7b9-42e8-afe8-cedbfb272853","ku-071ed6b8-adf2-4bcb-a654-3445d61afe3d","sdu-d9e692e6-677c-4e04-9eb6-cf11b229968c"],"keyword":["choroidal thickness","meta-analysis","pregnancy","systematic review"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-086A1995540E76FC31F01E5CCBDD2898"],"oa_link":[{"access":"ea","embargo":"2026-02-06","type":"loc","version":"Authors Final Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Ophthalmology (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Odense University Hospital"],"nora_code":"DI-HO-SDR","use