e and Technology","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Center for Neuroplasticity and Pain","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Center for Sensory-Motor Interaction","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Integrative Neuroscience"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Ken S.","key":"frahmpau","last":"Frahm","locid":"cefcbe49-9400-4455-838b-4e3cafcf5358","name":"Frahm, Ken Steffen","name_org":"Frahm, Ken S.","orcid":"0000-0003-0324-3756","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Adam","key":"assadpau","last":"Assad","name":"Assad, Adam","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Asger","key":"bechpau","last":"Bech","name":"Bech, Asger","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Emilie V.","key":"bisgaardpau","last":"Bisgaard","name":"Bisgaard, Emilie V.","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andreas","key":"buschpau","last":"Busch","name":"Busch, Andreas","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Cæcilie","key":"engerspau","last":"Engers","name":"Engers, Cæcilie","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Susanne","key":"khalafpau","last":"Khalaf","name":"Khalaf, Susanne","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Pernille","key":"kristensenpau","last":"Kristensen","name":"Kristensen, Pernille","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Laura","key":"larsenpau","last":"Larsen","name":"Larsen, Laura","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mia","key":"madsenpau","last":"Madsen","name":"Madsen, Mia","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Troels","key":"pedersenpau","l