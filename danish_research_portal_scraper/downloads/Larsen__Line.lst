{"author_count":3,"contributors":["Staun Larsen, Line","Richards, Alan","Nyvad, Bente"],"cuid":["S01-000.00-148081"],"event":{"end":"2018-07-07","place":"København, dk","start":"2018-07-04","title":"65th Congress of the European Organisation for Caries Research","year":"2018"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Mucosa","Saliva","fluorid"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"fluoride on the oral mucosa and in saliva a pilot study","src":["au"],"src-code":["DI-U-AU"],"type":"dco","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://pure.au.dk/ws/files/129533396/StaunLarsen_posterORCA18final.pdf","version":"Other Version"},"id":"S01-000.00-148081","ids":["au-20bd9225-eb71-4e9e-8f52-3b96fd4e7190"],"keyword":["fluorid","mucosa","saliva"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-79373A8D8BA677AED599ACE57DBB07E2"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://pure.au.dk/ws/files/129533396/StaunLarsen_posterORCA18final.pdf","version":"Other Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Dentistry and Oral Health, Department of Dentistry and Oral Health - Section for Pediatric Dentistry"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Line","key":"staunlarsenpau","last":"Staun Larsen","locid":"35e2ae60-25db-4a15-893f-dc8906e2bccf","name":"Staun Larsen, Line","orcid":"0000-0002-4155-5884","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Alan","key":"richardspau","last":"Richards","locid":"2b845949-43a7-481b-b04e-d301d661433b","name":"Richards, Alan","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Bente","key":"nyvadpau","last":"Nyvad","locid":"f0fda280-eb7a-42d4-93f0-45f26e30fc45","name":"Nyvad, Bente","orcid":"0000-0002-9545-0447","rank":3,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-20bd9225-eb71-4e9e-8f52-3b96fd4e7190"],"src":["AU Aarhus University"],"title":"Fluoride on the Oral Mucosa and in Saliva - A Pilot Study","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-148081","year":"2018","yearsub":"2018"}
{"abstract":"Based on the due date of a pregnant woman Danish Health Authority guidelines prescribe time windows for when the woman should have midwife consultations. A principle of continuity of care means that each woman should preferably see the same midwife at every consultation. For the first consultation pregnant women are assigned an arbitrary free time slot belonging to a specific midwife. In turn, this midwife is expected to have consultations with this woman in specific weeks according to authority guidelines. This random assignment of pregnant women to midwives means that each midwife has a very unbalanced workload and that there is an imbalance between the workloads of different midwifes within each week. The aim of this work is to devise a method for assigning and scheduling midwife consultations that results in a balanced workload for each midwife and among the midwives while making sure consultation guidelines are respected. We present a mathematical model for this problem and through simulation of the historical flow of pregnant women show that using this model would have significantly reduced workload imbalances, even when including a further restriction not currently adhered to. The model is too demanding to be implemented at the hospital. Therefore, we develop an assignment tool based on full enumeration for one pregnant woman at a time. Simulations show that this approach can still reduce workload imbalances considerably. The tool, which has now been implemented at the hospital, is also used to test the workload impact of continuity of care.","author_count":3,"contributors":["Græse, Line","Vilhelmsen, Charlotte","Larsen, Jesper"],"cuid":["S01-000.00-362271"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"nr","rtype":["clu"],"sorti":"assignment of pregnant women to midwives","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dr","type-grp":["all","pub"]},"id":"S01-000.00-362271","ids":["dtu-c1127839-1523-4ad3-8b46-1717cc2e18b7"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-987A2167632331418DA677EFC91F55A5"],"org":[{"affno":"1","country":"dk","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Line","key":"græsepau","last":"Græse","name":"Græse, Line","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Charlotte","key":"vilhelmsenpau","last":"Vilhelmsen","locid":"6ceebc69-a38c-4b56-9070-23135aa491c6","name":"Vilhelmsen, Charlotte","orcid":"0000-0001-8260-6791","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper","key":"larsenpau","last":"Larsen","locid":"d1af4d26-e92b-414c-b534-25b2b607a0d9","name":"Larsen, Jesper","orcid":"0000-0002-9119-3586","rank":3,"rolecode":"pau"}],"pub":{"pages":"36","status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-c1127839-1523-4ad3-8b46-1717cc2e18b7"],"src":["DTU Technical University of Denmark"],"title":"Assignment of Pregnant Women to Midwives","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-362271","year":"2018","yearsub":"2018"}
{"abstract":"We evaluated a new epilepsy genetic diagnostic and counseling service covering a UK population of 3.5 million. We calculated diagnostic yield, estimated clinical impact, and surveyed referring clinicians and families. We costed alternative investigational pathways for neonatal onset epilepsy. Patients with epilepsy of unknown aetiology onset < 2 years; treatment resistant epilepsy; or familial epilepsy were referred for counseling and testing. We developed NGS panels, performing clinical interpretation with a multidisciplinary team. We held an educational workshop for paediatricians and nurses. We sent questionnaires to referring paediatricians and families. We analysed investigation costs for 16 neonatal epilepsy patients. Of 96 patients, a genetic diagnosis was made in 34% of patients with seizure onset < 2 years, and 4% > 2 years, with turnaround time of 21 days. Pathogenic variants were seen in SCN8A, SCN2A, SCN1A, KCNQ2, HNRNPU, GRIN2A, SYNGAP1, STXBP1, STX1B, CDKL5, CHRNA4, PCDH19 and PIGT. Clinician prediction was poor. Clinicians and families rated the service highly. In neonates, the cost of investigations could be reduced from £9362 to £2838 by performing gene panel earlier and the median diagnostic delay of 3.43 years reduced to 21 days. Panel testing for epilepsy has a high yield among children with onset < 2 years, and an appreciable clinical and financial impact. Parallel gene testing supersedes single gene testing in most early onset cases that do not show a clear genotype-phenotype correlation. Clinical interpretation of laboratory results, and in-depth discussion of implications for patients and their families, necessitate multidisciplinary input and skilled genetic counseling.","author_count":11,"contributors":["Oates, Stephanie","Tang, Shan","Rosch, Richard","Lear, Rosalie","Hughes, Elaine F.","Williams, Ruth E.","Larsen, Line H.G.","Hao, Qin","Dahl, Hans Atli","Møller, Rikke S.","Pal, Deb K."],"cuid":["S01-000.00-634479"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"corresponding_author":["Pal, Deb K."],"country":["United Kingdom"],"glorg":["All Global Affiliations","Guy's and St Thomas' NHS Foundation Trust","King's College London"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-PR-OTH","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"incorporating epilepsy genetics into clinical practice a 000000000360 evaluation","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41525-018-0052-9","version":"Published Version"},"funding_acknowledgement":["We would like to thank all the children and families that were involved in this study, as well as the members of the South-East Thames Paediatric Epilepsy Group (SETPEG) for their attendance at our Education Day, and their feedback. We would also like to thank the Head of Patient Experience, Sarah Allen, at Guys and St Thomas’s Hospital for her help with our patient satisfaction questionnaire. Finally, we would like to thank all our referring clinicians: Dr. Elaine Hughes, Dr. Ruth Williams, Dr. Karine Lascelles, Dr. Katherine Anderson, Dr. Ming Lim, Prof. Paul Gringras, Dr. Rajesh Gupta, Dr. Nikil Sudarsan, Dr. Vasantha Gowda, Dr. Darshan Das, Dr. Lyvia Dabydeen and Dr. David McCormick. This work was supported by grants from the Canadian Institutes of Health Research (201503MOP-342469, DKP); European Union Programme of the Seventh Framework Programme Development of Strategies for Innovative Research to improve diagnosis, prevention and treatment in children with difficult to treat Epilepsy, 'DESIRE' (602531, DKP); National Institute for Health Research (DKP); Medical Research Council (DKP); Waterloo Foundation (DKP); Charles Sykes Epilepsy Research Trust (DKP); NIHR Specialist Biomedical Research Centre for Mental Health of South London and Maudsley NHS Foundation Trust (DKP)."],"id":"S01-000.00-634479","identifier":[{"id":"PMC5945675","type":"pmcid"},{"id":"85047058205","type":"scopus"},{"id":"29760947","type":"pmid"}],"ids":["sdu-d5d82659-cb0b-473d-a744-90494496daad"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-9B3003C220836E6C072158A335249E2C"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41525-018-0052-9","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/141129240/Incorporating_epilepsy_genetics_into_clinical_practice.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","country":"gb","key":"king s college london","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"King's College London","used":1},{"affno":"2","country":"gb","key":"guy s and st thomas nhs foundation trust","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Guy's and St Thomas' NHS Foundation Trust","used":1},{"affno":"3","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["Amplexa Genetics A/S"],"nora_code":"DI-PR-OTH","used":1},{"affno":"4","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, BRIDGE - Brain Research - Inter Disciplinary Guided Excellence (Odense)","SDU, The Faculty of Health Sciences, Department of Regional Health Research","SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS - The Epilepsyhospital Filadelfia"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Stephanie","key":"oatespau","last":"Oates","name":"Oates, Stephanie","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Shan","key":"tangpau","last":"Tang","name":"Tang, Shan","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Richard","key":"roschpau","last":"Rosch","name":"Rosch, Richard","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rosalie","key":"learpau","last":"Lear","name":"Lear, Rosalie","rank":4,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Elaine F.","key":"hughespau","last":"Hughes","name":"Hughes, Elaine F.","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ruth E.","key":"williamspau","last":"Williams","name":"Williams, Ruth E.","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Line H.G.","key":"larsenpau","last":"Larsen","name":"Larsen, Line H.G.","rank":7,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Qin","key":"haopau","last":"Hao","name":"Hao, Qin","rank":8,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Hans Atli","key":"dahlpau","last":"Dahl","name":"Dahl, Hans Atli","rank":9,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Rikke S.","key":"møllerpau","last":"Møller","locid":"85de2fa9-456c-4427-8c30-7dc1bdd4bcf0","name":"Møller, Rikke S.","orcid":"0000-0002-9664-1448","rank":10,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Deb K.","key":"palpau","last":"Pal","name":"Pal, Deb K.","rank":11,"rolecode":"pau"}],"pmid":["29760947"],"pub":{"doi":"10.1038/s41525-018-0052-9","issn":["20567944"],"journal":"npj Genomic Medicine","paperid":"13","publisher":"Nature Publishing Group","status":"p","title":"npj Genomic Medicine","volume":"3"},"review":"Peer Reviewed","scoID":["2-s2.0-85047058205"],"search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Other Companies","Private Research","Universities","University of Southern Denmark","amplexa genetics a/s"],"PST":["Published"]},"sid":["sdu-d5d82659-cb0b-473d-a744-90494496daad"],"src":["SDU University of Southern Denmark"],"title":"Incorporating epilepsy genetics into clinical practice : A 360°evaluation","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-634479","year":"2018","yearsub":"2018"}
{"abstract":"22q11.2 deletion syndrome (22q11.2DS) is one of the most common copy number variants and confers a markedly increased risk for schizophrenia. As such, 22q11.2DS is a homogeneous genetic liability model which enables studies to delineate functional abnormalities that may precede disease onset. Mismatch negativity (MMN), a brain marker of change detection, is reduced in people with schizophrenia compared to healthy controls. Using dynamic causal modelling (DCM), previous studies showed that top-down effective connectivity linking the frontal and temporal cortex is reduced in schizophrenia relative to healthy controls in MMN tasks. In the search for early risk-markers for schizophrenia we investigated the neural basis of change detection in a group with 22q11.2DS. We recorded high-density EEG from 19 young non-psychotic 22q11.2 deletion carriers, as well as from 27 healthy non-carriers with comparable age distribution and sex ratio, while they listened to a sequence of sounds arranged in a roving oddball paradigm. Despite finding no significant reduction in the MMN responses, whole-scalp spatiotemporal analysis of responses to the tones revealed a greater fronto-temporal N1 component in the 22q11.2 deletion carriers. DCM showed reduced intrinsic connection within right primary auditory cortex as well as in the top-down, connection from the right inferior frontal gyrus to right superior temporal gyrus for 22q11.2 deletion carriers although not surviving correction for multiple comparison. We discuss these findings in terms of reduced adaptation and a general increased sensitivity to tones in 22q11.2DS.","author_count":13,"contributors":["Larsen, Kit Melissa","Mørup, Morten","Birknow, Michelle Rosgaard","Fischer, Elvira","Hulme, Oliver","Vangkilde, Anders","Schmock, Henriette","Baaré, William Frans Christiaan","Didriksen, Michael","Olsen, Line","Werge, Thomas","Siebner, Hartwig R.","Garrido, Marta I."],"cuid":["S02-100.00-035561"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["OECD","Oceania"],"corresponding_author":["Larsen, Kit Melissa"],"country":["Australia"],"glorg":["All Global Affiliations","University of Queensland"],"keyword":["22q11 deletion syndrome","Dynamic causal modelling","EEG","Mismatch negativity"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-LUND"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-PR-LUND","DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"altered auditory processing and effective connectivity in 000000000022q000000000011 000000000002 deletion syndrome","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/143812861/1_s2.0_S0920996418300483_main.pdf","version":"Authors Final Version"},"id":"S02-100.00-035561","identifier":[{"id":"29395612","type":"pmid"},{"id":"85041219932","type":"scopus"}],"ids":["dtu-80def646-a2fd-4cb7-836e-73248ee5b7fb","ku-58f1d322-e5bc-4eed-85d8-5bbb0b6145fe"],"keyword":["22q11 deletion syndrome","Dynamic causal modelling","EEG","Mismatch negativity","N1 component"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-5CF834F99595DB919120C6B9CBD094FE"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/143812861/1_s2.0_S0920996418300483_main.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Applied Mathematics and Computer Science","Technical University of Denmark, Department of Applied Mathematics and Computer Science, Cognitive Systems"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"dk","key":"lundbeck","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-LUND","l3nl":"Lundbeck Pharma","l3nn":"Lundbeck","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Lundbeck","namevar":["H. Lundbeck A/S"],"nora_code":"DI-PR-LUND","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Psychiatry"],"nora_code":"DI-U-KU","used":1},{"affno":"4","country":"au","key":"university of queensland","loc":["Australia","Oceania","OECD"],"name":"University of Queensland","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Kit Melissa","key":"larsenpau","last":"Larsen","locid":"597f3add-c462-4c45-b519-3b17ae15cbec","name":"Larsen, Kit Melissa","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Morten","key":"møruppau","last":"Mørup","locid":"7ffdfaca-76bd-44ec-a98f-13fe4f033b71","name":"Mørup, Morten","orcid":"0000-0003-4985-4368","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Michelle Rosgaard","key":"birknowpau","last":"Birknow","name":"Birknow, Michelle Rosgaard","rank":3,"rolecode":"pau"},{"affno":"","first":"Elvira","key":"fischerpau","last":"Fischer","name":"Fischer, Elvira","rank":4,"rolecode":"pau"},{"affno":"","first":"Oliver","key":"hulmepau","last":"Hulme","name":"Hulme, Oliver","rank":5,"rolecode":"pau"},{"affno":"","first":"Anders","key":"vangkildepau","last":"Vangkilde","name":"Vangkilde, Anders","rank":6,"rolecode":"pau"},{"affno":"","first":"Henriette","key":"schmockpau","last":"Schmock","name":"Schmock, Henriette","rank":7,"rolecode":"pau"},{"affno":"","first":"William Frans Christiaan","key":"baarépau","last":"Baaré","name":"Baaré, William Frans Christiaan","rank":8,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Michael","key":"didriksenpau","last":"Didriksen","name":"Didriksen, Michael","rank":9,"rolecode":"pau"},{"affno":"","first":"Line","key":"olsenpau","last":"Olsen","name":"Olsen, Line","rank":10,"rolecode":"pau"},{"affno":"3","first":"Thomas","key":"wergepau","last":"Werge","locid":"905c01bb-6319-4ce6-a38e-ceb5bf73d2f6","name":"Werge, Thomas","rank":11,"rolecode":"pau"},{"affno":"3","first":"Hartwig R","key":"siebnerpau","last":"Siebner","locid":"d9ed8669-a16b-429a-86ed-353ef481bb72","name":"Siebner, Hartwig Roman","name_org":"Siebner, Hartwig R","rank":12,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Marta I.","key":"garridopau","last":"Garrido","name":"Garrido, Marta I.","rank":13,"rolecode":"pau"}],"pmid":["29395612"],"pub":{"doi":"10.1016/j.schres.2018.01.026","issn":["09209964","15732509"],"issn_org":["09209964"],"journal":"Schizophrenia Research","pages":"328-336","status":"p","title":"Schizophrenia Research","volume":"197"},"review":"Peer Reviewed","scoID":["2-s2.0-85041219932"],"search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Lundbeck Pharma","Private Research","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-80def646-a2fd-4cb7-836e-73248ee5b7fb","ku-58f1d322-e5bc-4eed-85d8-5bbb0b6145fe"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Altered auditory processing and effective connectivity in 22q11.2 deletion syndrome","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-035561","year":"2018","yearsub":"2018"}
{"abstract":"OBJECTIVES: Persons with schizophrenia have a shorter life expectancy by 15-20years compared to the background population, but little is known about deaths caused by accidents. We aimed to investigate the rates of accidental death among persons with schizophrenia and compare these rates with those of the background population. METHODS: We conducted a national register-based cohort study of all persons born in Denmark between 1955 and 2011. The cohort included 2,703,307 persons, representing 56,845,085 person years at risk. We compared rates of accidental death between persons with schizophrenia and those without by using Cox regression analysis. The main outcome measure was hazard ratio (HR) for accidental death. RESULTS: A total of 12,425 accidental deaths were identified, including 371 accidental deaths among persons with schizophrenia. We found an increased HR for both women with schizophrenia (10.47; 95% CI=8.07-13.58) and men with schizophrenia (8.33; 95% CI=7.44-9.33) compared to the background population. After adjusting for substance abuse, we found attenuated HRs for both women (HR=3.22; 95% CI=2.46-4.20) and men (HR=3.23; 95% CI=2.87-3.63). CONCLUSIONS: Schizophrenia is a strong independent risk factor for accidental deaths. Substance abuse seems to constitute a substantial part of the association.","author_count":4,"contributors":["Hellemose, Line Amalie Aarestrup","Laursen, Thomas Munk","Larsen, Janne Tidselbak","Nielsen, Anita Tønder"],"cuid":["S01-000.00-191213"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Bipolar affective disorder","Cohort study","Follow up","Life Expectancy","Mental illness","Mortality","PEOPLE","Register","Risk Factors","Schizoaffective disorder","Schizophrenia","Substance abuse","Suicide"],"level":"sci","mra":["soc"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-NP","DI-U"],"level3":{"NP":["DI-NP-ALL","DI-NP-LUND"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-NP-LUND","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"accidental deaths among persons with schizophrenia a nationwide population based cohort study","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85044339246","version":"Other Version"},"id":"S01-000.00-191213","identifier":[{"id":"85044339246","type":"scopus"},{"id":"29580741","type":"pmid"},{"id":"000444845900023","type":"wos"}],"ids":["au-6c815fe0-8620-4b81-95f8-849e2ec45c6e"],"keyword":["Accidental death","BIPOLAR AFFECTIVE-DISORDER","COUNTY","Cohort study","FOLLOW-UP","LIFE EXPECTANCY","MENTAL-ILLNESS","MORTALITY","PEOPLE","REGISTER","Risk factors","SCHIZOAFFECTIVE DISORDER","SUICIDE","Schizophrenia","Substance abuse"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-4-9EB5F87F90CF7C38FA0B581E58568508"],"oai":{"class":"Unused","mra":["Social Science (SOC)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Public Health, Department of Public Health - National Centre for Register-based Research"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"lundbeck foundation","l2":"DI-NP","l2n":"Non-Profit Organisations","l3":"DI-NP-LUND","l3nn":"Lundbeck Foundation","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Lundbeck Foundation","namevar":["iPSYCH -The Lundbeck Foundation Initiative for Integrative Psychiatric Research"],"nora_code":"DI-NP-LUND","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Line Amalie Aarestrup","key":"hellemosepau","last":"Hellemose","locid":"afe072ab-8f00-447c-81ee-80312fe86f2a