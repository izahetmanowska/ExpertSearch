sity of glasgow","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Glasgow","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Anika","key":"kofodpetersenpau","last":"Kofod Petersen","locid":"66df1431-908c-44b2-a391-2215ee5b7377","name":"Kofod Petersen, Anika","orcid":"0000-0001-5913-8723","rank":1,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Andrew Hugh","key":"forgieoth","last":"Forgie","name":"Forgie, Andrew Hugh","rank":2,"role":"Other","rolecode":"oth"},{"affno":"1","corresponding":null,"country":"dk","first":"Dorthe Arenholt","key":"bindslevoth","last":"Bindslev","locid":"a95ac976-ed75-421f-a895-8fc5ec9c62c0","name":"Bindslev, Dorthe Arenholt","rank":3,"role":"Other","rolecode":"oth"},{"affno":"1","corresponding":null,"country":"dk","first":"Palle","key":"villesenoth","last":"Villesen","locid":"c1c4bd28-befd-4150-bbbb-10138e528d53","name":"Villesen, Palle","orcid":"0000-0001-7589-8781","rank":4,"role":"Other","rolecode":"oth"},{"affno":"1","corresponding":null,"country":"dk","first":"Line","key":"staunlarsenoth","last":"Staun Larsen","locid":"35e2ae60-25db-4a15-893f-dc8906e2bccf","name":"Staun Larsen, Line","orcid":"0000-0002-4155-5884","rank":5,"role":"Other","rolecode":"oth"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-7bcd8f72-641d-42ae-a925-ef45fd3a5846"],"src":["AU Aarhus University"],"title":"Automatic tissue removal from 3D dental photoscans","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-708214","year":"2023","yearsub":"2023"}
{"abstract":"Aim: The use of robot-assisted surgery for left-sided colon cancer is increasing in Denmark; however, it is yet to be established if the robotic approach results in improved clinical outcomes compared with the corresponding laparoscopic approach. The aim of this study was to compare the intraoperative and short-term postoperative outcomes of robot-assisted surgery with laparoscopic surgery for left-sided colon cancer at a national level. Method: The study is a nationwide database study based on data from the Danish Colorectal Cancer Group database. Patients from all colorectal centres in Denmark treated with surgery with curative intent in an elective setting with either robotic or laparoscopic left colectomy or sigmoidectomy during the period 2014–2019 were included. To adjust for confounding, propensity score matching (PSM) was performed and the groups were compared for age, sex, body mass index, American Society of Anesthesiologists classification, performance score, year of diagnosis, neoadjuvant chemotherapy, left colectomy or sigmoidectomy, tumour localization, use of stoma or stenting and pathological T (pT) category. Results: A total of 5532 patients were available for analysis, and after PSM in a ratio of 2:1, 1392 laparoscopic and 696 robotic cases were identified. After matching we found a lower conversion rate and a higher lymph node yield in the robotic group compared with the laparoscopic group (5.8% vs. 11%, p < 0.001 and 27 vs. 24, p < 0.001, respectively). Further, we found a higher proportion of patients with a lymph node yield of 12 or more in the robotic group (97% vs. 94.8%, p = 0.02). Plane of dissection, radicality and pathological disease stages did not differ between the two groups. We found no difference in either overall surgical (13% vs. 11.1%, p = 0.23) or medical (5.6% vs. 6.5%, p = 0.49) postoperative complications and no difference in 30-day (p = 0.369) or 90-day mortality (p = 0.08). Conclusion: Robot-assisted surgery for left-sided colon cancer was associated with a significantly lower conversion rate and a significantly higher lymph node yield than the laparoscopic approach. Postoperative morbidity and mortality were similar in the two groups.","author_count":4,"contributors":["Rein, Line Katrine Larsen","Dohrn, Niclas","Gögenur, Ismail","Falk Klein, Mads"],"cuid":["S01-000.00-740102"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Colon cancer","Laparoscopic surgery","Nationwide","Robotic surgery"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-ZEA"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-HO-ZEA","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"robotic versus laparoscopic approach for left sided colon cancer a nationwide cohort study","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-740102","identifier":[{"id":"37919465","type":"pmid"},{"id":"85175715379","type":"scopus"}],"ids":["ku-f98ac9a3-c42e-424f-b805-56d8bfd9f64d"],"keyword":["colon cancer","laparoscopic surgery","left colectomy","nationwide","robotic surgery"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-E67486A947FCF34CB255ABE62D053248"],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Herlev and Gentofte"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","country":"dk","key":"region zealand","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-ZEA","l3nl":"Region Zealand","l3nn":"Region Zealand","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region Zealand","namevar":["Zealand University Hospital - Køge"],"nora_code":"DI-HO-ZEA","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Surgery"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Line Katrine Larsen","key":"reinpau","last":"Rein","name":"Rein, Line Katrine Larsen","rank":1,"rolecode":"pau"},{"affno":"1 2","first":"Niclas","key":"dohrnpau","last":"Dohrn","name":"Dohrn, Niclas","rank":2,"rolecode":"pau"},{"affno":"2 3","first":"Ismail","key":"gögenurpau","last":"Gögenur","locid":"b95dd257-f723-4e4f-a991-af43f2223bac","name":"Gögenur, Ismail","rank":3,"rolecode":"pau"},{"affno":"1","first":"Mads","key":"falkkleinpau","last":"Falk Klein","name":"Falk Klein, Mads","rank":4,"rolecode":"pau"}],"pmid":["37919465"],"pub":{"doi":"10.1111/codi.16803","issn":["14628910","14631318"],"issn_org":["14628910"],"issue":"12","journal":"Colorectal Disease","pages":"2366-2377","status":"p","title":"Colorectal Disease","volume":"25"},"review":"Peer Reviewed","scoID":["2-s2.0-85175715379"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region Zealand","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-f98ac9a3-c42e-424f-b805-56d8bfd9f64d"],"src":["KU University of Copenhagen"],"title":"Robotic versus laparoscopic approach for left-sided colon cancer : a nationwide cohort study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-740102","year":"2023","yearsub":"2023"}
