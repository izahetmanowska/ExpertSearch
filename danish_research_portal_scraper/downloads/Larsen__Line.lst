Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Ukendt"],"nora_code":"DI-OT","used":1},{"affno":"3","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Humanities, Department of Design, Media and Educational Science"],"nora_code":"DI-U-SDU","used":1},{"affno":"4","country":"dk","key":"steno diabetes centers","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-STENO","l3nn":"Steno Diabetes Centers","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Steno Diabetes Centers","namevar":["Steno Diabetes Center Sjælland"],"nora_code":"DI-HO-STENO","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jesper Larsen","key":"mærskpau","last":"Mærsk","name":"Mærsk, Jesper Larsen","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Tania Erika Aniol","key":"hansenpau","last":"Hansen","name":"Hansen, Tania Erika Aniol","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Edris","key":"qasimipau","last":"Qasimi","name":"Qasimi, Edris","rank":3,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"first":"Marie Konge","key":"nielsenpau","last":"Nielsen","locid":"c97c3053-d857-40be-8fb3-365420bef26c","name":"Nielsen, Marie Konge","orcid":"0000-0002-3683-8361","rank":4,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Peter Bindslev","key":"iversenpau","last":"Iversen","name":"Iversen, Peter Bindslev","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Line","key":"lindahljacobsenpau","last":"Lindahl-Jacobsen","name":"Lindahl-Jacobsen, Line","rank":6,"rolecode":"pau"}],"pub":{"issn":["13973290"],"newspaper":"Dagens Medicin","status":"p","title":"Dagens Medicin"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","All University Colleges","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","Hospitals","Miscellaneous","Other Research","Universities","University College Absalon","University Colleges","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-c62b34f3-e269-437f-bec6-5e82377c918a"],"src":["SDU University of Southern Denmark"],"title":"Sundhedsprofessionelle skal have mere opsøgende rolle i mødet med borgere med type 2-diabetes i sårbare positioner","type":"Newspaper Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-766274","year":"2024","yearsub":"2024"}
{"abstract":"Objectives: This study investigates the feasibility of implementing telescreening for retinopathy of prematurity (ROP) using the ICON GO® widefield camera operated by a non-physician healthcare professional (NPHP). We hypothesized that images captured by an NPHP are adequate to evaluate ROP changes without further examinations. Secondly, the level of agreement between independent ROP graders were evaluated based on the fundus photographs. Methods: National ROP screening criteria were gestational age (GA) < 32 weeks or birthweight (BW) < 1500 g. Exclusion criteria were children hospitalized and born outside the Capital Region and examinations not performed by an NPHP. The screenings were performed using the ICON GO®. The NPHP selected the best images for evaluation by an on-site ophthalmologist, regarding whether re-examination was necessary and if so, whether the re-examination was beneficial. Lastly, the images were re-evaluated by an independent off-site ophthalmologist. Results: A total of 415 screening sessions on 165 patients performed by an NPHP were included. Re-examination was necessary in three screening sessions and beneficial in two. The level of agreement between the on-site and off-site ophthalmologists regarding ROP screening outcome was k = 0.82, ROP stage k = 0.69, plus disease k = 0.69, and lastly ROP zone k = 0.37. Of the screened children, ninety-seven (58.8%) had no ROP at any time points, sixty-two (37.6%) had some stage of ROP not requiring treatment, and six (3.6%) received ROP treatment. Conclusions: Telemedicine screening for ROP with the ICON GO® camera performed by an NPHP was feasible with an almost-perfect agreement and negligible need for re-examinations. The approach effectively identified children needing treatment, supporting the use of telescreening in ROP management.","author_count":11,"contributors":["Al-Abaiji, Hajer A.","Bangsgaard, Regitze","Kofod, Mads","Faber, Carsten","Larsen, Ann Cathrine","Brost, Agnes Galbo","Slidsborg, Carina","Klemp, Kristian","Breindahl, Morten","la Cour, Morten","Kessel, Line"],"cuid":["S01-000.00-777057"],"filters":{"added":"2025-01","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Imaging","Prematurity","Retinopathy of Prematurity"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"evaluating the feasibility of a telescreening program for retinopathy of prematurity rop in denmark","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/jpm14101020","version":"Published Version"},"id":"S01-000.00-777057","identifier":[{"id":"85207701478","type":"scopus"},{"id":"39452528","type":"pmid"},{"id":"PMC11508977","type":"pmcid"}],"ids":["ku-17aac8c8-72ad-46f0-9d31-85786631f67b"],"keyword":["imaging","non-physician healthcare professional","prematurity","retinopathy of prematurity","telescreening"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-B9BB2D459311974D941072B4408F312A"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/jpm14101020","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/411691689/jpm_14_01020.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Ophthalmology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Hajer A.","key":"alabaijipau","last":"Al-Abaiji","name":"Al-Abaiji, Hajer A.","rank":1,"rolecode":"pau"},{"affno":"1","first":"Regitze","key":"bangsgaardpau","last":"Bangsgaard","name":"Bangsgaard, Regitze","rank":2,"rolecode":"pau"},{"affno":"1","first":"Mads","key":"kofodpau","last":"Kofod","name":"Kofod, Mads","rank":3,"rolecode":"pau"},{"affno":"1 2","first":"Carsten","key":"faberpau","last":"Faber","locid":"989bdc3e-2cd9-4feb-9875-f746afb3fe89","name":"Faber, Carsten","rank":4,"rolecode":"pau"},{"affno":"1","first":"Ann Cathrine","key":"larsenpau","last":"Larsen","name":"Larsen, Ann Cathrine","rank":5,"rolecode":"pau"},{"affno":"1","first":"Agnes Galbo","key":"brostpau","last":"Brost","name":"Brost, Agnes Galbo","rank":6,"rolecode":"pau"},{"affno":"1","first":"Carina","key":"slidsborgpau","last":"Slidsborg","name":"Slidsborg, Carina","rank":7,"rolecode":"pau"},{"affno":"1","first":"Kristian","key":"klemppau","last":"Klemp","name":"Klemp, Kristian","rank":8,"rolecode":"pau"},{"affno":"1","first":"Morten","key":"breindahlpau","last":"Breindahl","name":"Breindahl, Morten","rank":9,"rolecode":"pau"},{"affno":"1 2","first":"Morten Dornonville de","key":"lacourpau","last":"la Cour","locid":"00d77351-63df-440c-adc3-7187a374f378","name":"la Cour, Morten","name_org":"la Cour, Morten Dornonville de","rank":10,"rolecode":"pau"},{"affno":"1 2","first":"Line","key":"kesselpau","last":"Kessel","locid":"3201472a-2f23-417e-bd01-a7950e2ff370","name":"Kessel, Line","orcid":"0