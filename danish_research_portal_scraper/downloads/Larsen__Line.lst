first":"Jonas Svenstrup","key":"sverregaardjonassvenstruppau","last":"Sverregaard","name":"Sverregaard, Jonas Svenstrup","rank":34,"rolecode":"pau"},{"affno":"","first":"Rie","key":"troelsenriepau","last":"Troelsen","name":"Troelsen, Rie","rank":35,"rolecode":"pau"},{"affno":"","first":"M.","key":"georgsenmpedh","last":"Georgsen","name":"Georgsen, M.","rank":36,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"A.","key":"qvortrupapedh","last":"Qvortrup","name":"Qvortrup, A.","rank":37,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"publisher":"University College Nordjylland (UCN)","status":"p","title":"Erfaringer og oplevelser med online undervisning på 9 videregående ud- dannelsesinstitutioner i foråret 2020"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Universities","All University Colleges","DI-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","Roskilde University","Universities","University College of Northern Denmark","University Colleges","University of Southern Denmark"],"PST":["Published"]},"sid":["ruc-4bd05a2e-385d-4c62-a35b-7d46a8f76009"],"src":["RUC Roskilde University"],"title":"Erfaringer og oplevelser med online undervisning på 9 videregående uddannelsesinstitutioner i foråret 2020","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-561041","year":"2021","yearsub":"2021"}
{"abstract":"Purpose: Children undergoing surgery and general anesthesia often experience preoperative anxiety (POA) with related negative short-, medium- and long-term consequences. Anxiolytic premedication has negative side effects, and nonpharmacologic interventions are often resource demanding and not always readily available in a busy clinical setting. The use of an age-appropriate game on a tablet computer may reduce POA, postoperative pain, and occurrence of emergence delirium (ED). Design: Children aged 3 to 6 years scheduled to undergo elective minor surgery were randomly assigned to play a game on a tablet computer while in the holding area before anesthesia (n = 30) or prepared as per departmental standard only (n = 30). Methods: POA, ED, and levels of pain were assessed by the modified Yale Preoperative Anxiety Scale, Pediatric Anesthesia Emergence Delirium, and Face, Legs, Activity, Cry, Consolability scale, respectively. Findings: A total of 60 children were randomized to either the intervention group or the control group. Gender, bodyweight, duration of anesthesia and surgery, and fentanyl dosages were comparable between the two groups. Tablet-gaming children tended to be less anxious than control subjects at the time of anesthesia induction (modified Yale Preoperative Anxiety Scale, 55.7 vs 65.8; 95% confidence interval, −0.63 to 20.8; P = .066). There was no difference in occurrence of ED or pain 20 minutes after arrival in the postanesthesia care unit. Conclusions: Although not statistically significant, the use of an age-appropriate tablet computer game may reduce the level of anxiety at the anesthetic induction in 3 to 6 years old children undergoing elective day-case surgery. However, the occurrence of ED and levels of pain appeared unaffected. Standardization of nonpharmacologic interventions to reduce perioperative anxiety and pain is required.","author_count":6,"contributors":["Clausen, Nicola Groes","Madsen, Dorthe","Rosenkilde, Charlotte","Hasfeldt-hansen, Dorthe","Larsen, Line Gry","Hansen, Tom Giedsing"],"cuid":["S01-000.00-600673"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Clausen, Nicola Groes"],"keyword":["Emergence delirium","General anesthesia","Pediatric anesthesia","preoperative anxiety"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-SDR","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"the use of tablet computers to reduce preoperative anxiety in children before anesthesia a randomized controlled study","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85101547506","version":"Other Version"},"id":"S01-000.00-600673","identifier":[{"id":"33637409","type":"pmid"},{"id":"85101547506","type":"scopus"}],"ids":["sdu-5ff9b411-8c04-4dd7-b46f-e64434180560"],"keyword":["emergence delirium","general anesthesia","pediatric anesthesia","preoperative anxiety"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-F0CA9667BADBFC575963771FA74FE12D"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Anaesthesiology and Intensive Care (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Odense University Hospital"],"nora_code":"DI-HO-SDR","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Nicola Groes","key":"clausenpau","last":"Clausen","locid":"66d531b1-92e2-4511-ac5f-1857e34cc1ce","name":"Clausen, Nicola Groes","orcid":"0000-0002-3590-5171","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Dorthe","key":"madsenpau","last":"Madsen","name":"Madsen, Dorthe","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Charlotte","key":"rosenkildepau","last":"Rosenkilde","locid":"9ad4c026-4569-46dc-ad06-af7882dff170","name":"Rosenkilde, Charlotte","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Dorthe","key":"hasfeldthansenpau","last":"Hasfeldt-Hansen","locid":"69b73aac-113b-4875-927c-d56644279012","name":"Hasfeldt-hansen, Dorthe","name_org":"Hasfeldt-Hansen, Dorthe","orcid":"0009-0006-5960-7554","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Line Gry","key":"larsenpau","last":"Larsen","locid":"9e779ea0-e653-4cd5-94e0-a583ca1eb0e6","name":"Larsen, Line Gry","orcid":"0000-0002-0683-4503","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Tom Giedsing","key":"hansenpau","last":"Hansen","locid":"5f66539d-cd24-4c21-8e6b-fefbcdcb0032","name":"Hansen, Tom Giedsing","orcid":"0000-0002-5896-9768","rank":6,"rolecode":"pau"}],"pmid":["33637409"],"pub":{"doi":"10.1016/j.jopan.2020.09.012","issn":["10899472","15328473"],"issn_org":["10899472"],"issue":"3","journal":"Journal of PeriAnesthesia Nursing","pages":"275-278","publisher":"WB  Saunders","publisher_org":"W.B. Saunders","status":"p","title":"Journal of PeriAnesthesia Nursing","volume":"36"},"review":"Peer Reviewed","scoID":["2-s2.0-85101547506"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-5ff9b411-8c04-4dd7-b46f-e64434180560"],"src":["SDU University of Southern Denmark"],"title":"The Use of Tablet Computers to Reduce Preoperative Anxiety in Children Before Anesthesia : A Randomized Controlled Study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-600673","year":"2021","yearsub":"2021"}
{"abstract":"Background Guideline recommendations on the use of non-vitamin K antagonist oral anticoagulants (NOACs) in atrial fibrillation (AF) patients with aortic stenosis are based on studies including a low number of patients with aortic stenosis. The aim of this study was to estimate the effects of NOAC versus warfarin on thromboembolism and major bleeding among AF patients with aortic stenosis. Methods and Results We emulated a target trial using observational data from Danish nationwide registries between 2013 and 2018. Thromboembolism was defined as a hospital diagnosis of ischemic stroke and/or systemic embolism, and major bleeding was defined as a hospital diagnosis of intracranial bleeding, gastrointestinal bleeding, or major or clinically relevant bleeding in other anatomic sites. Treatment effect estimates were based on an intention-to-treat and per-protocol approach. A total of 3726 patients with AF and aortic stenosis claimed a prescription for either a NOAC (2357 patients) or warfarin (1369 patients) and met the eligibility criteria for the trial. During 3 years of follow-up, the adjusted hazard ratios for thromboembolism and major bleeding were 1.62 (95% CI, 1.08-2.45) and 0.73 (0.59-0.91) for NOAC compared with warfarin in the intention-to-treat analyses. Similar results were observed in the per-protocol analyses. Conclusions In this observational study, we observed a higher risk of thromboembolism but a lower risk of major bleeding for treatment with NOACs compared with warfarin in patients with AF and aortic stenosis. This observation needs confirmation in large randomized trials in these commonly encountered patients.","author_count":7,"contributors":["Melgaard, Line","Overvad, Thure Filskov","Jensen, Martin","Christensen, Thomas Decker","Lip, Gregory Y H","Larsen, Torben Bjerregaard","Nielsen, Peter Brønnum"],"cuid":["S02-100.00-011335"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, Non-EU","OECD"],"corresponding_author":["Nielsen, Peter Brønnum"],"country":["United Kingdom"],"glorg":["All Global Affiliations","Liverpool Heart and Chest Hospital NHS Foundation Trust","University of Liverpool"],"keyword":["Atrial fibrillation","Stroke","Valvular heart disease"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-HO-CDR","DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"effectiveness and safety of noac versus warfarin in patients with atrial fibrillation and aortic stenosis","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1161/JAHA.121.022628","version":"Published Version"},"id":"S02-100.00-011335","identifier":[{"id":"000727412400052","type":"wos"},{"id":"34816745","type":"pmid"},{"id":"PMC9075348","type":"pmcid"},{"id":"85121025537","type":"scopus"}],"ids":["aau-ed63cc3c-1dfc-4a7d-b981-2762533964c7","au-ba1ce95b-29b9-4f20-8b5c-9e80f34dabf8"],"keyword":["Atrial fibrillation","Stroke","Valvular heart disease"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-9AC5940967C4F0302EB467922C7AADE6"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1161/JAHA.121.022628","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/454814695/Melgaard_et_al._2021_._Effectiveness_and_Safety_of_NOAC_Versus_Warfarin_in_Patients_With_Atrial_Fibrillation_and_Aortic_Stenosis.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-