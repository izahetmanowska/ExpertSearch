sed":1}],"person":[{"affno":"","corresponding":null,"first":"Line Stenholt","key":"bruunpau","last":"Bruun","name":"Bruun, Line Stenholt","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Johan Kløvgaard","key":"sørensenpau","last":"Sørensen","locid":"d5475d4d-4c11-460a-9e28-686771070cc3","name":"Sørensen, Johan Kløvgaard","orcid":"0009-0006-0087-3719","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens Rolighed","key":"larsenpau","last":"Larsen","locid":"485143af-239d-407f-96e4-f045733fa8c8","name":"Larsen, Jens Rolighed","orcid":"0000-0003-0694-0135","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Charlotte","key":"rungepau","last":"Runge","locid":"eca83862-b388-4479-bc0b-c8a670ae52e9","name":"Runge, Charlotte","orcid":"0000-0001-9480-2490","rank":4,"rolecode":"pau"}],"pmid":["38109796"],"pub":{"doi":"10.1213/ane.0000000000006775","issn":["00032999","11381868"],"issn_org":["00032999"],"issue":"4","journal":"Anesthesia and Analgesia","pages":"904-905","publisher":"Lippincott Williams and Wilkins","status":"p","title":"Anesthesia and Analgesia","volume":"138"},"review":"Peer Reviewed","scoID":["2-s2.0-85188002101"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-9d5a3fa7-92e1-4fc8-95a3-2a8df2782ff9"],"src":["AU Aarhus University"],"title":"Spinal Anesthesia With Ropivacaine for Hip and Knee Arthroplasty : Observations of Duration of Action","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-708700","year":"2024","yearsub":"2024"}
{"abstract":"Background: Visually impaired and blind adolescents fare poorly in educational attainment compared to adolescents without vision impairment. Rehabilitation holds the potential to compensate for the hindrances that the impairment causes. Many rehabilitation initiatives exist. However, the efficacy of these initiatives remains uncertain. This systematic review assessed which rehabilitation initiatives improve participation in an educational setting for visually impaired and blind adolescents. Methods: PubMed, Embase, Scopus, Cinahl, and Cochrane library databases were searched. Only primary studies as randomized controlled trial (parallel group or crossover), cohort studies, case-control studies, qualitative studies, and case-studies were included. Data on the study characteristics, visual impairment, type of intervention, research question, main findings, and implications for practice were extracted from the papers. Critical appraisal was performed using the Critical Appraisal Checklist for Qualitative Research and the Checklist for Quasi-Experimental Studies both from the Joanna Briggs Institute. The data extraction and the critical appraisal were performed independently by two reviewers. Results: A total of 10 studies with visually impaired and blind adolescents were considered eligible, from an original search result of 3210 studies. In the thematic analysis we identified a heightened focus on different means for studying by making the curriculum content more accessible by applying different audio, tactile, or electronic devices (n = 8). A minor focus in the identified studies (n = 2) was placed on the impact of support from the environment on the development of literacy, for example the support from teachers or parents. Outcome parameters representing more diverse rehabilitation initiatives have not been adequately investigated in the literature. The scientific evidence that we identified was based on few publications with contradictory results and some studies were of questionable quality, limiting the applicability of their findings. Conclusions: Overall, the review identified a gap in the evidence regarding rehabilitation initiatives for visually impaired and blind adolescents that enables participation in an educational setting. The overall quality assessment of the 10 studies identified several risks of bias, for which reason the current scientific evidence does not qualify as a basis for decision making, leaving the adolescents in a heightened risk to fall even further behind in the educational system. Further high quality randomized controlled trials are required to establish high-quality evidence.","author_count":4,"contributors":["Milde, Nina","Schmidt, Diana Chabané","Larsen, Anders","Kessel, Line"],"cuid":["S01-000.00-722015"],"filters":{"added":"2024-02","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Adolescents","Blindness","Education","Rehabilitation","Visual impairment"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"which rehabilitation initiatives can effectively improve participation in an educational setting for visually impaired and blind adolescents a systematic review","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s12886-023-03267-8","version":"Published Version"},"id":"S01-000.00-722015","identifier":[{"id":"85181483480","type":"scopus"},{"id":"38178072","type":"pmid"},{"id":"PMC10768278","type":"pmcid"}],"ids":["ku-d6d4d8da-c2a6-429d-87ee-6a568a928190"],"keyword":["Adolescents","Blindness","Education","Improved participation","Rehabilitation","Visual impairment"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-7DD319FD189EC7766655174B432BD32F"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s12886-023-03267-8","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/379655389/s12886_023_03267_8.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Ophthalmology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Nina","key":"mildepau","last":"Milde","name":"Milde, Nina","rank":1,"rolecode":"pau"},{"affno":"1","first":"Diana Chabané","key":"schmidtpau","last":"Schmidt","name":"Schmidt, Diana Chabané","rank":2,"rolecode":"pau"},{"affno":"1","first":"Anders","key":"larsenpau","last":"Larsen","name":"Larsen, Anders","rank":3,"rolecode":"pau"},{"affno":"1 2","first":"Line","key":"kesselpau","last":"Kessel","locid":"3201472a-2f23-417e-bd01-a7950e2ff370","name":"Kessel, Line","orcid":"0000-0002-9375-1510","rank":4,"rolecode":"pau"}],"pmid":["38178072"],"pub":{"doi":"10.1186/s12886-023-03267-8","issn":["14712415"],"issue":"1","journal":"BMC Ophthalmology","paperid":"10","status":"p","title":"BMC Ophthalmology","volume":"24"},"review":"Peer Reviewed","scoID":["2-s2.0-85181483480"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-d6d4d8da-c2a6-429d-87ee-6a568a928190"],"src":["KU University of Copenhagen"],"title":"Which rehabilitation initiatives can effectively improve participation in an educational setting for visually impaired and blind adolescents? A systematic review","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-722015","year":"2024","yearsub":"2024"}
{"abstract":"OBJECTIVE: Genetic high-resolution analyses and improved diagnostic imaging have impacted the ability to detect fetal disorders. It is unknown if this resulted in an alteration in the number of terminations of pregnancy due to fetal anomalies (TOPFA). The objective was to describe the incidence and indication of TOPFA. METHODS: A descriptive study based on records from the Regional Abortion Council in the Central Denmark Region from 2008 to 2021 consisting of 1895 TOPFA. RESULTS: A consistent incidence of TOPFA was observed, accounting for 0.96% of the total births during that period. When examining fetal indications, there was a small increase in the occurrence of genetic aberrations, primarily caused by deletions, duplications, and single nucleotide variations, whereas the number of chromosomal aberrations remained stable. Of 35.5% of the cases with malformations, the central nervous system was the most affected organ system, followed by malformations of the heart 29.6%. Overall, the total number of cases remained stable. DISCUSSION AND CONCLUSION: Unexpectedly, despite the development of new diagnostic tools, the incidence of TOPFA from 2008 to 2021 remained stable. However, the number of cases with genetic aberrations increased. This may be attributed to increased genetic testing for fetuses with identified malformations, resulting in more accurate diagnoses.","author_count":6,"contributors":["Raaby, Line","Lou, Stina","Lodberg Ivarsen, Rikke Ramløv","Sørensen, Jette","Larsen, Ole Halfdan","Vogel, Ida"],"cuid":["S01-000.00-728981"],"filters":{"added":"2024-05","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Raaby, Line"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"has the introduction of increased genetic prenatal testing affected rates of termination of pregnancy due to fetal abnormality","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1002/pd.6526","version":"Published Version"},"id":"S01-000.00-728981","identifier":[{"id":"85185509089","type":"scopus"},{"id":"38348952","type":"pmid"}],"ids":["au-fff36240-9530-40ce-a968-34428d6bf8e4"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-63382338B3B7439AFEC9171E819D642D"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1002/pd.6526","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Molecular Medicine (MOMA)","Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Department of Pathology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Line","key":"raabypau","last":"Raaby","locid":"47a1c989-3031-450d-8d06-995b987ef525","name":"Raaby, Line","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Stina","key":"loupau","last":"Lou","locid":"e734d776-b7d9-4553-a165-7c22d378115e","name":"Lou, Stina","orcid":"0000-0001-6177-5780","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Rikke Ramløv","key":"lodbergivarsenpau","last":"Lodberg Ivarsen","name":"Lodberg Ivarsen, Rikke Ramløv","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jette","key":"sørensenpau","last":"Sørensen","name":"Sørensen, Jette","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ole Halfdan","key":"larsenpau","last":"Larsen","locid":"f280dbc7-1019-42be-badb-da94300ffabd","name":"Larsen, Ole Halfdan","orcid":"0000-0001-5213-7349","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ida","key":"vogelpau","last":"Vogel","locid":"ba41eace-9859-47c4-874f-e6a39110d244","name":"Vogel, Ida","orcid":"0000-0002-1125-0393","rank":6,"rolecode":"pau"}],"pmid":["38348952"],"pub":{"doi":"10.1002/pd.6526","issn":["01973851","10970223"],"issn_org":["01973851"],"issue":"3","journal":"Prenatal Diagnosis","pages":"280-288","publisher":"John Wiley and Sons Ltd","status":"p","title":"Prenatal Diagnosis","volume":"44"},"review":"Peer Reviewed","scoID":["2-s2.0-85185509089"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-fff36240-9530-40ce-a968-34428d6bf8e4"],"src":["AU Aarhus University"],"title":"Has the introduction of increased genetic prenatal testing affected rates of termination of pregnancy due to fetal abnormality?","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-728981","year":"2024","yearsub":"2024"}
{"abstract":"This article presents the outcome and full scale exhibition of the initaitive 'From 4 to 1 Planet' launched by the Realdania and Villum Foundations. The initative aims at reducung the climate impact from residential buildings to a fourth of the current level. Three different pavillions were designes and built by next generation architects.","author_count":7,"contributors":["Beim, Anne","Østerby Arnfred, Lykke","Ejstrup, Henriette","Munch-Petersen, Pelle","Lønberg Petersen, Thorbjørn","Larsen, Kenneth Hviid","Kjær Frederiksen, Line"],"cuid":["S01-000.00-736589"],"event":{"end":"2023-07-06","place":"København, dk","start":"2023-07-02","title":"UIA World Congress of Architects 2023 Copenhagen","year":"2023"},"filters":{"added":"2024-08","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Absolute sustainability","Biogenic Construction","Housing","Planetary boundaries","climate based design","material awareness","radical tectonics"],"level":"pop","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-ART"],"level3":{"ART":["DI-ART-ALL","DI-ART-RDKA"]},"level3all":["DI-ART-RDKA"]},"review":"und","rtype":["clu"],"sorti":"from 000000000004 to 000000000001 planet showcases climate friendly homes of the future","src":["arkc"],"src-code":["DI-ART-RDKA"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.wamp.com.cn/album/catalog/142","version":"Other Version"},"funding_acknowledgement":["Tsinhua Univarsity"],"id":"S01-000.00-736589","ids":["arkc-b3fb7346-50d6-4706-a509-9aeaa7bf5499"],"keyword":["Biogenic Construction","Housing","Yes","absolute sustainability","climate based design","material awareness","planetary boundaries","radical tectonics"],"lang":"English","level":"Popular","mra":["Humanities"],"noi":["Local-1-1-18E8E4B64EE8538F24D71B4647B09D58"],"org":[{"affno":"1","key":"royal danish academy architecture design conservation","l2":"DI-ART","l2n":"Artistic Higher Education Institutions","l3":"DI-ART-RDKA","l3nn":"Royal Danish Academy - Architecture, Design, Conservation","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Royal Danish Academy - Architecture, Design, Conservation","namevar":["Royal Danish Academy - Architecture, Design, Conservation","Royal Danish Academy - Architecture, Design, Conservation, Royal Danish Academy - Architecture, Institute of Architecture and Technology","Royal Danish Academy - Architecture, Design, Conservation, Royal Danish Academy - Architecture, Institute of Architecture and Technology, CINARK - Centre for Industrialised Architecture"],"nora_code":"DI-ART-RDKA","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Anne","key":"beimpau","last":"Beim","locid":"7c36623f-a0bc-40e7-bccb-fe2749487e3b","name":"Beim, Anne","orcid":"0000-0002-5132-553X","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lykke","key":"østerbyarnfredpau","last":"Østerby Arnfred","locid":"8f4a12cd-83e4-4831-b9ce-45322a2932e5","name":"Østerby Arnfred, Lykke","orcid":"0009-0000-1124-907X","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henriette","key":"ejstruppau","last":"Ejstrup","locid":"08c47981-f863-4b14-a258-829f76297744","name":"Ejstrup, Henriette","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Pelle","key":"munchpetersenpau","last":"Munch-Petersen","locid":"643114ce-58d6-44f7-9c9c-103c62d4da47","name":"Munch-Petersen, Pelle","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Thorbjørn","key":"lønbergpetersenpau","last":"Lønberg Petersen","locid":"61f8faf9-6c30-4658-b405-a0f313ac9023","name":"Lønberg Petersen, Thorbjørn","orcid":"0000-0002-0192-1114","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Kenneth Hviid","key":"larsenpau","last":"Larsen","locid":"6f2b0890-9fcf-4f48-b89e-b1e8409ac3b3","name":"Larsen, Kenneth Hviid","rank":6,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Line","key":"kjærfrederiksenpau","last":"Kjær Frederiksen","locid":"286c1c89-f72f-4a18-a40a-fecf478f63b1","name":"Kjær Frederiksen, Line","orcid":"0000-0002-2530-8672","rank":7,"rolecode":"pau"}],"pub":{"issn":["10024832"],"issue":"403","journal":"World Architecture","pages":"26-29","paperid":"7","status":"p","title":"World Architecture","title_org":"World Architecture (WA)"},"review":"Undetermined","search":{"DAF":["All Artistic Higher Education Institutions","All Danish Affiliations","Artistic Higher Education Institutions","DI-ALL","DI-ART","DI-ART-ALL"],"PST":["Published"]},"sid":["arkc-b3fb7346-50d6-4706-a509-9aeaa7bf5499"],"src":["Royal Danish Academy - Architecture, Design, Conservation"],"title":"From 4 to 1 Planet Showcases Climate-Friendly Homes of the Future","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-736589","year":"2024","yearsub":"2024"}
{"abstract":"Denne rapport opsummerer hovedresultaterne fra forskningsprojektet ”Udviklingsinitiativer for marine virkemidler”, der er besluttet og finansieret af ”Aftale om grøn omstilling af dansk landbrug” fra 2021 og udmøntet via Miljøstyrelsen. Projektet skal danne grundlag for beslutning om, og i givet fald hvordan de marine virkemidler ”reetablering af ålegræs” og ”dyrkning af tang” kan anvendes i vandplanlægningen til at opsamle næringsstoffer og/eller opnå andre positive miljøeffekter, som kan bidrage til hurtigere opnåelse af god økologisk tilstand i danske kystvandområder i overensstemmelse med vandrammedirektivet.Forskningsprojektet og nærværende opsummerende rapport er ledet af DTU Aqua ved projektleder Karen Timmermann og udført i samarbejde med Syddansk Universitet (SDU), Københavns Universitet (KU), Aarhus Universitet (AU) og DHI. Rapporten er en del af rapportserien ”Udviklingsinitiativer for marine virkemidler”, som udover den opsummerende rapport omfatter en række baggrundsrapporter med videnskabelig dokumentation for projektets resultater.Baggrundsrapporterne i serien udgives i løbet af 2024 og udgøres af:• En dybdegående projektsynteserapport.• Vidensyntese om ålegræstransplantering.• Videnssyntese om tangdyrkning.• Rapporten ”Muligheder for at indregne marine virkemidler i den nationale drivhusgasopgørelse”.• Rapporten ”Retlige rammer for marine virkemidler og marin natur”.• Arbejdspakkerapporter med videnskabelig dokumentation for resultaterne fra hver af projektets centrale faglige arbejdspakker omhandlende ”Ålegræstransplantering”, ”Dyrkning af sukkertang” og \"Modellering af virkemiddeleffekter”.Miljøstyrelsen har haft rapportudkast til kommentering undervejs i projektgruppens arbejde, men valg af metoder og konklusioner er alene projektgruppens ansvar.","author_count":37,"contributors":["Timmermann, Karen","Mostovaya, Alina","Barnewitz, Anders","Erichsen, Anders","Petersen, Anders Høker","Holbach, Andreas","Bruhn, Annette","Nielsen, Benjamin","Taylor, Daniel","Hansen, Flemming Thorbjørn","Hansen, Frederik H.","Christensen, Freja","Anker, Helle Tegner","Christensen, Jesper","Holding, Johnna","Baaner, Lasse","Hermannsen, Line","Callisen, Lærke W.","Nielsen, Mette Møller","Gommesen, Mia","Lees, Mikkel Keller","Flindt, Mogens","Holst, Niels","Canal-Vergés, Paula","Schmedes, Peter Søndergaard","Kjær, Rasmus Ambus","Steinfurth, Rune","Stæhr, Sanjina Upadhyay","Pedersen, Sidsel Gurholt","Vinbæk, Sidsel Juul","Gyldenkerne, Steen","Andersen, Søren Stig","Boderskov, Teis","Jørgensen, Thor S.","Banke, Timi Løvholt","Andersen, Trine A.","Larsen, Trine C."],"cuid":["S01-000.00-750732"],"filters":{"added":"2024-08","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"corresponding_author":["Timmermann, Karen"],"level":"com","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GTS","DI-U"],"level3":{"GTS":["DI-GTS-ALL","DI-GTS-DHYI"],"U":["DI-U-ALL","DI-U-AU","DI-U-DTU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-GTS-DHYI","DI-U-AU","DI-U-DTU","DI-U-KU","DI-U-SDU"]},"review":"nr","rtype":["clu"],"sorti":"ålegræstransplantering og tangdyrkning som marine virkemidler potentialer effekter og juridiske aspekter opsummering af hovedresultater fra projektet","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.11581/dtu.000003","version":"Published Version"},"id":"S01-000.00-750732","ids":["sdu-98125997-674b-4af1-91f2-b7f798a4aed8"],"lang":"Danish","level":"Commissioned","mra":["Science/Technology"],"noi":["Global-Local-2-2-488C91DA458711B6B97768BBB7818586"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.11581/dtu.000003","version":"Published Version"},{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/265798208/457-2024-Aalegraestransplantering-og-tangdyrkning-som-marine-virkemidler_1_.pdf","version":"Published Version"}],"org":[{"