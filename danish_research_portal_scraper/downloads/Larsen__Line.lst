, Lene Søndergaard","rank":9,"rolecode":"pau"},{"affno":"7 8","first":"L","key":"krebspau","last":"Krebs","locid":"bc118d29-5caa-4a68-b229-16ca0cf1b7cb","name":"Krebs, Lone","name_org":"Krebs, L","orcid":"0000-0001-5433-4776","rank":10,"rolecode":"pau"},{"affno":"7 1","first":"H","key":"zingenbergpau","last":"Zingenberg","locid":"51bffa11-3401-436e-bf07-916d1f2ca344","name":"Zingenberg, Helle","name_org":"Zingenberg, H","rank":11,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Lone","key":"laursenpau","last":"Laursen","locid":"695145e3-40a5-49c1-8ddc-429bb36386ee","name":"Laursen, Lone","rank":12,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jeanette Tranberg","key":"christensenpau","last":"Christensen","name":"Christensen, Jeanette Tranberg","rank":13,"rolecode":"pau"},{"affno":"7 1","first":"Ann","key":"taborpau","last":"Tabor","locid":"812e3aa1-0156-4e1e-a597-44ec3164413a","name":"Tabor, Ann","rank":14,"rolecode":"pau"},{"affno":"1","first":"Line","key":"rodepau","last":"Rode","name":"Rode, Line","rank":15,"rolecode":"pau"}],"pmid":["27106105"],"pub":{"doi":"10.1002/uog.15948","issn":["09607692","14690705"],"issn_org":["09607692"],"issue":"3","journal":"Ultrasound in Obstetrics & Gynecology","pages":"382-389","publisher":"John Wiley and Sons Ltd","status":"p","title":"Ultrasound in Obstetrics & Gynecology","title_org":"Ultrasound in obstetrics & gynecology : the official journal of the International Society of Ultrasound in Obstetrics and Gynecology","volume":"48"},"review":"Peer Reviewed","scoID":["2-s2.0-84984950717"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Region Zealand","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-17b37d31-76eb-495a-b102-332bf5280519","au-3