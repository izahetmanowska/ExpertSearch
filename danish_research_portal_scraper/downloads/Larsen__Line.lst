{"author_count":7,"contributors":["Nielsen, Søren Drud-Heydary","Le, Thao T.","Knudsen, Lotte Juul","Bækgaard, Line Thunæs","Rauh, Valentin","Poulsen, Nina Aagaard","Larsen, Lotte Bach"],"cuid":["S01-000.00-253708"],"event":{"end":"2019-10-11","place":"Papendal, nl","start":"2019-10-08","title":"NIZO Dairy Conference","year":"2019"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"continent":["OECD","Oceania"],"country":["Australia"],"glorg":["All Global Affiliations","Edith Cowan University"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"nr","rtype":["clu"],"sorti":"quantification of sugar independent process induced cross links in dairy proteins","src":["au"],"src-code":["DI-U-AU"],"type":"dco","type-grp":["all","pub"]},"id":"S01-000.00-253708","ids":["au-d9e5e890-6c1a-4f64-93aa-c244384e8cb0"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-D9CFB2F38F99728D8CD88F78B5692A28"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Food Science, Department of Food Science - Food Chemistry"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1},{"affno":"3","country":"au","key":"edith cowan university","loc":["Australia","Oceania","OECD"],"name":"Edith Cowan University","used":1}],"person":[{"affno":"1","corresp