{"author_count":7,"contributors":["Knudsen, Line Vestergaard","Mortensen, Christian Hviid","Larsen, Ane Hejlskov","Dam Christensen,, Hans","Gjedde, Lisa","Jensen, Jens F.","Sørensen, Anne Scott"],"cuid":["S02-096.43-803820"],"filters":{"added":"2025-06","altsrc":["No Matches Found"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Knudsen, Line Vestergaard"],"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"appropriations of cultural sustainability across research fields a global scoping review 000000002001 000000002023","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"id":"S02-096.43-803820","ids":["aau-c6075152-30ab-4a27-af8d-22620247e2f1","au-fbcc3639-e109-4407-b597-c6b9faa02ce7"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Local-1-2-F209EAA2C31C4B40D47530A7898C2ABA"],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science, Department of Mathematical Sciences, AAU BLUE – Marine & Maritime Research","Aalborg University, The Faculty of Social Sciences and Humanities","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Politics and Society","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Politics and Society, History","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Politics and Society, The History Research Group"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"dk","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["University of Southern Denmark (SDU)"],"nora_code":"DI-U-SDU","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Arts, School of Communication and Culture, School of Communication and Culture - Museologi"],"nora_code":"DI-U-AU","used":1},{"affno":"4","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Line Vestergaard","key":"knudsenpau","last":"Knudsen","locid":"513f2017-8169-48fa-b58c-cc7856b72200","name":"Knudsen, Line Vestergaard","orcid":"0000-0003-1783-4397","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Christian Hviid","key":"mortensenpau","last":"Mortensen","name":"Mortensen, Christian Hviid","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Ane Hejlskov","key":"larsenpau","last":"Larsen","locid":"537945d6-e2ef-4d5c-9639-230e8ec1bc40","name":"Larsen, Ane Hejlskov","orcid":"0000-0001-7441-1054","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Hans","key":"damchristensenpau","last":"Dam Christensen","name":"Dam Christensen, Hans","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lisa","key":"gjeddepau","last":"Gjedde","locid":"4e614dda-fee6-42a8-9a15-806c575761a9","name":"Gjedde, Lisa","orcid":"0000-0002-1643-8176","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jens F.","key":"jensenpau","last":"Jensen","name":"Jensen, Jens F.","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Anne Scott","key":"sørensenpau","last":"Sørensen","name":"Sørensen, Anne Scott","rank":7,"rolecode":"pau"}],"pub":{"issn":["11038152","20020503"],"issn_org":["11038152"],"journal":"Nordisk Museologi/The Journal Nordic Museology","publisher":"Universitetet i Oslo","status":"u","title":"Nordisk Museologi/The Journal Nordic Museology"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Submitted","Unpublished"]},"sid":["aau-c6075152-30ab-4a27-af8d-22620247e2f1","au-fbcc3639-e109-4407-b597-c6b9faa02ce7"],"src":["AAU Aalborg University","AU Aarhus University"],"title":"Appropriations of Cultural Sustainability Across Research Fields: A Global Scoping Review, 2001-2023","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-096.43-803820","year":"2025","yearsub":"2025"}
{"abstract":"To investigate levels of specific plasma-biomarkers related to neurodegeneration and inflammation in patients with different chronic degenerative retinal diseases, using an ultrasensitive technology called ‘single molecule array’ (SiMoA). Also, to investigate if biomarkers were measurable in the patient’s blood, dependent on age and medical comorbidities, and useful for stratifying the diseases. This exploratory, cross-sectional study recruited 151 adults at the Department of Ophthalmology, Rigshospitalet, Denmark (period 2019 to 2020). Clinical data came from the electronic medical-record system. The study population consisted of 131 patients: 32 with diabetic retinopathy (DR; 51 diabetes, DM), 27 with glaucoma, 53 with inherited retinal degeneration (IRD and 20 healthy controls (HC). Medical comorbidities included organ failure, other active eye diseases, and comorbidities. Three biomarkers, neurofilament-light-chain (NFL), glial-fibrillary-acidic-protein (GFAP), and CXC-motif chemokine ligand 13 (CXCL13), were measured with SiMoA technology. The age-adjusted values were reported as fold differences (FD) with 95% confidence intervals (CI). Increased NFL levels were found in DR patients compared to HCs (FD 1.81 95%CI 1.43, 2.28, p < 0.001, adj-p < 0.001). Similarly increased NFL levels were reported in advanced DR (PDR, DME), compared to both DM (FD 2.52 (95%CI: 1.71; 3.72, p < 0.001, adj-p < 0.001, and FD 2.04 (95%CI: 1.33; 3.12, p < 0.001, adj-p < 0.001), respectively) and HCs (FD 2.35 (95%CI: 1.67; 3.30, p < 0.001, adj-p < 0.001), and FD 1.89 (95%CI: 1.28; 2.79, p < 0.001, adj-p < 0.001) respectively). Independent of comorbidities, decreased NFL-levels were seen in IRD compared to DR (FD 0.49 (95% CI 0.39; 0.61, p < 0.001; adj-p < 0.001), ±comorbidities). Decreased GFAP levels were seen in DM patients compared to HCs (FD 0.69; 95%CI 0.55, 0.87, p = 0.002, adj-p = 0.02), but contrary to an increasing trend in advanced DR compared to DM (-comorbidities). These results imply that these biomarker-tests are useful for detecting and monitoring development of retinopathy in the circulations of diabetes patients. Plasma-biomarkers may be useful to stratify between retinal disease types. Prospective studies are underway to explore this hypothesis in depth.","author_count":20,"contributors":["Hajari, Javad Nouri","Ilginis, Tomas","Pedersen, Tobias Torp","Lønkvist, Claes Sepstrup","Saunte, Jon Peiter","Hofsli, Mikael","Schmidt, Diana Chabane","Al-abaiji, Hajer Ahmad","Ahmed, Yasmeen","Bach-Holm, Daniella","Kessel, Line","Kolko, Miriam","Bertelsen, Mette","Larsen, Lars Michael","Sørensen, Frederik","Forman, Julie Lyng","Olsen, Dorte Aalund","Rosenberg, Thomas","Brandslund, Ivan","Slidsborg, Carina"],"cuid":["S02-100.00-804487"],"filters":{"added":"2025-06","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corresponding_author":["Slidsborg, Carina"],"keyword":["Age","Confounders","Diagnosis","Disease monitoring","Plasma biomarkers","chronic retinal degenerative disease","diabetic microvascular complication","medical comorbidities"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"novel blood biomarkers to detect retinal neurodegeneration and inflammation in diabetic retinopathy","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/ijms26062625","version":"Published Version"},"id":"S02-100.00-804487","identifier":[{"id":"40141267","type":"pmid"},{"id":"105001105678","type":"scopus"},{"id":"PMC11942211","type":"pmcid"}],"ids":["ku-69c01bc2-082c-4292-882e-00cd19b406d7","sdu-2b410af8-01e0-4c09-bc02-32dc94474be9"],"keyword":["age","chronic retinal degenerative disease","confounders","diabetic microvascular complication","diagnosis","disease monitoring","medical comorbidities","plasma-biomarkers"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-398D353DF4E417CD91B808E0D265DE18"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/446138822/ijms-26-02625-1.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/287640497/Open_Access_Version.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/ijms26062625","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Ophthalmology"],"nora_code":"DI-U-KU","used":1},{"affno":"3","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Regional Health Research","SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS - Lillebælt Hospital, Research Unit of Biochemistry and Immunology (Vejle)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","first":"Javad Nouri","key":"hajaripau","last":"Hajari","name":"Hajari, Javad Nouri","rank":1,"rolecode":"pau"},{"affno":"1","first":"Tomas","key":"ilginispau","last":"Ilginis","name":"Ilginis, Tomas","rank":2,"rolecode":"pau"},{"affno":"1","first":"Tobias Torp","key":"pedersenpau","last":"Pedersen","name":"Pedersen, Tobias Torp","rank":3,"rolecode":"pau"},{"affno":"1","first":"Claes Sepstrup","key":"lønkvistpau","last":"Lønkvist","name":"Lønkvist, Claes Sepstrup","rank":4,"rolecode":"pau"},{"affno":"1","first":"Jon Peiter","key":"sauntepau","last":"Saunte","name":"Saunte, Jon Peiter","rank":5,"rolecode":"pau"},{"affno":"1","first":"Mikael","key":"hofslipau","last":"Hofsli","name":"Hofsli, Mikael","rank":6,"rolecode":"pau"},{"affno":"1","first":"Diana Chabane","key":"schmidtpau","last":"Schmidt","name":"Schmidt, Diana Chabane","rank":7,"rolecode":"pau"},{"affno":"1","first":"Hajer Ahmad","key":"alabaijipau","last":"Al-abaiji","name":"Al-abaiji, Hajer Ahmad","rank":8,"rolecode":"pau"},{"affno":"1","first":"Yasmeen","key":"ahmedpau","last":"Ahmed","name":"Ahmed, Yasmeen","rank":9,"rolecode":"pau"},{"affno":"1","first":"Daniella","key":"bachholmpau","last":"Bach-Holm","name":"Bach-Holm, Daniella","rank":10,"rolecode":"pau"},{"affno":"1 2","first":"Line","key":"kesselpau","last":"Kessel","locid":"3201472a-2f23-417e-bd01-a7950e2ff370","name":"Kessel, Line","orcid":"0000-0002-9375-1510","rank":11,"rolecode":"pau"},{"affno":"1 2","first":"Miriam","key":"kolkopau","last":"Kolko","locid":"424f93ba-9964-4960-bd22-d30bdb0fb45f","name":"Kolko, Miriam","orcid":"0000-0001-8697-0734","rank":12,"rolecode":"pau"},{"affno":"1","first":"Mette","key":"bertelsenpau","last":"Bertelsen","name":"Bertelsen, Mette","rank":13,"rolecode":"pau"},{"affno":"1","first":"Lars Michael","key":"larsenpau","last":"Larsen","name":"Larsen, Lars Michael","rank":14,"rolecode":"pau"},{"affno":"2","first":"Frederik","key":"sørensenpau","last":"Sørensen","name":"Sørensen, Frederik","rank":15,"rolecode":"pau"},{"affno":"2","first":"Julie Lyng","key":"formanpau","last":"Forman","locid":"ddfe2814-4ae0-463d-9748-c1ba0647b469","name":"Forman, Julie Lyng","orcid":"0000-0001-7368-0869","rank":16,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Dorte Aalund","key":"olsenpau","last":"Olsen","locid":"8a3114d0-466f-4593-aa7a-270ce4e6c796","name":"Olsen, Dorte Aalund","rank":17,"rolecode":"pau"},{"affno":"1","first":"Thomas","key":"rosenbergpau","last":"Rosenberg","name":"Rosenberg, Thomas","rank":18,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Ivan","key":"brandslundpau","last":"Brandslund","locid":"a81731b6-2c07-4eb3-8f89-3da6650c226b","name":"Brandslund, Ivan","orcid":"0000-0002-4203-5442","rank":19,"rolecode":"pau"},{"affno":"1","first":"Carina","key":"slidsborgpau","last":"Slidsborg","name":"Slidsborg, Carina","rank":20,"rolecode":"pau"}],"pmid":["40141267"],"pub":{"doi":"10.3390/ijms26062625","issn":["14220067","16616596"],"issn_org":["16616596"],"issue":"6","journal":"International Journal of Molecular Sciences","paperid":"2625","publisher":"MDPI","status":"p","title":"International Journal of Molecular Sciences","volume":"26"},"review":"Peer Reviewed","scoID":["2-s2.0-105001105678"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-69c01bc2-082c-4292-882e-00cd19b406d7","sdu-2b410af8-01e0-4c09-bc02-32dc94474be9"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Novel Blood-Biomarkers to Detect Retinal Neurodegeneration and Inflammation in Diabetic Retinopathy","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-804487","year":"2025","yearsub":"2025"}
{"abstract":"Background We aimed to examine pneumocystis pneumonia (PCP) risk and mortality among people with human immunodeficiency virus (HIV), and associations with (1) time after HIV diagnosis, (2) calendar time, and (3) CD4 cell count. Methods From the Danish HIV cohort study, we identified all adult people with HIV (PWH) (1995-2021). We estimated incidence rates (IRs) and mortality rates. We used Poisson regression analysis to compute adjusted incidence ratios (IRRs) and mortality rate ratios. PCP risk was assessed according to time after HIV diagnosis, calendar time, and low CD4 cell count. Results Among 4882 PWH (53 647 person-years), we observed 336 PCP events (for the time period 2016-2021 compared to 1995-1999, PCP risk decreased by >90% after the first year of HIV diagnosis; aIRR, 0.08 [95% confidence interval {CI},. 02-.29], and by >40% in the first year, if baseline CD4 count was <200 cells/μL [aIRR, 0.57 [95% CI,. 36-.90]). However, no statistically significant change in PCP risk was observed after 1995-1999 for the latter group. PCP risk remained high if the CD4 count was 100 to <200 cells/μL (IR, 16.08 [95% CI, 5.19-49.89]) during the first year of combination antiretroviral therapy (cART), despite a suppressed viral load. Major reductions were found after 1 year of cART (CD4 count 100 to <200 cells/μL). Although nonsignificant, the 3- and 12-month mortality rate decreased by 80% from 1995-1999 to 2016-2021. Conclusions PCP remains a significant problem among late presenters with HIV, emphasizing the importance of early HIV diagnosis. Continuing PCP prophylaxis until the CD4 count is >100 cells/μL, with at least 1 year of cART and viral suppression for >3 months should be considered; however; further studies are needed to confirm these results.","author_count":10,"contributors":["Møller, Anne K","Schnoor, Stine B","Petersen, Inge","Martin-Iguacel, Raquel","Kronborg, Gitte","Larsen, Carsten S","Dalager-Pedersen, Michael","Gerstoft, Jan","Omland, Lars H","Rasmussen, Line D"],"cuid":["S02-100.00-813284"],"filters":{"added":"2025-08","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Rasmussen, Line Dahlerup"],"keyword":["AIDS","HIV","PCP","Pneumocystis jirovecii","cART"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-SDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-SDR","DI-U-AAU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"pneumocystis pneumonia is it still a threat among people with human immunodeficiency virus hiv a danish hiv cohort study","src":["aau","sdu"],"src-code":["DI-U-AAU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1093/ofid/ofaf289","version":"Published Version"},"funding_acknowledgement":["Financial support. The study has received funding from OUH overl\\u00E6ger\\u00E5dets forskningsfond (Ingemann O. Bucks fond). The Danish HIV Cohort Study has received funding from Preben og Anne Simonsens Fond (receipt of grants to L. D. R.)."],"id":"S02-100.00-813284","identifier":[{"id":"40463830","type":"pmid"},{"id":"PMC12131158","type":"pmcid"},{"id":"105008283165","type":"scopus"}],"ids":["aau-088a1a90-f4f0-4db3-9d7a-68133ee111b5","sdu-9d498bef-b012-4bef-b039-e690804fca35"],"keyword":["AIDS","HIV","PCP","Pneumocystis jirovecii","cART"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-D4C09453CAE3C7882B1A885F500F70F0"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/291934214/ofaf289.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1093/ofid/ofaf289","version":"Published Version"},{"access"