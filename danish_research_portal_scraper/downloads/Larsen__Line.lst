{"abstract":"Der svares på spørgsmålet: Er fluoridtilskud til gravide en relevant strategi til cariesforebyggelse i Danmark?","author_count":1,"contributors":["Staun Larsen, Line"],"cuid":["S01-000.00-145573"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"keyword":["fluorid"],"level":"pop","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"und","rtype":["clu"],"sorti":"kommentar til internationalt forskningsnyt det gavner ikke børnenes tænder at moderen spiser fluoridtabletter","src":["au"],"src-code":["DI-U-AU"],"type":"djc","type-grp":["all","pub"]},"id":"S01-000.00-145573","ids":["au-1c54fb87-42b6-440f-9691-b3f6cd7e4e71"],"keyword":["fluorid"],"lang":"Danish","level":"Popular","mra":["Medical Science"],"noi":["Local-1-1-17F7811EF2545BE4C161720A3B0DE116"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Dentistry and Oral Health, Department of Dentistry and Oral Health - Section for Pediatric Dentistry"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Line","key":"staunlarsenpau","last":"Staun Larsen","locid":"35e2ae60-25db-4a15-893f-dc8906e2bccf","name":"Staun Larsen, Line","orcid":"0000-0002-4155-5884","rank":1,"rolecode":"pau"}],"pub":{"issn":["00399353","24458112"],"issn_org":["00399353"],"issue":"11","journal":"Tandlægebladet","pages":"952","publisher":"Tandlægeforeningen","status":"p","title":"Tandlægebladet","volume":"122"},"review":"Undetermined","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"si