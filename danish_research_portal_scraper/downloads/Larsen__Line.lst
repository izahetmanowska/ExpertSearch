University of Copenhagen"],"title":"MicroRNA expression analysis and Multiplex ligation-dependent probe amplification in metastatic and non-metastatic uveal melanoma","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-097.80-033393","year":"2014","yearsub":"2014"}
{"abstract":"The problem of synchronizing automata is concerned with the existence of a word that sends all states of the automaton to one and the same state. This problem has classically been studied for complete deterministic finite automata, with the existence problem being NLOGSPACE-complete. In this paper we consider synchronizing-word problems for weighted and timed automata. We consider the synchronization problem in several variants and combinations of these, including deterministic and non-deterministic timed and weighted automata, synchronization to unique location with possibly different clock valuations or accumulated weights, as well as synchronization with a safety condition forbidding the automaton to visit states outside a safety-set during synchronization (e.g. energy constraints). For deterministic weighted automata, the synchronization problem is proven PSPACE-complete under energy constraints, and in 3-EXPSPACE under general safety constraints. For timed automata the synchronization problems are shown to be PSPACE-complete in the deterministic case, and undecidable in the non-deterministic case.","author_count":5,"contributors":["Doyen, Laurent","Juhl, Line","Larsen, Kim Guldstrand","Markey, Nicolas","Shirmohammadi, Mahsa"],"cuid":["S01-000.00-070290"],"event":{"acronym":"FSTTCS","end":"2014-12-17","place":"New Delhi, in","start":"2014-12-15","title":"34th International Conference on Foundation of Software Technology and Theoretical Computer Science","year":"2014"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Timed automata","Weighted automata"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Laboratoire Spécification and Véreification, CNRS, ENS Cachan"],"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"synchronizing words for weighted and timed automata","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.4230/LIPIcs.FSTTCS.2014.121","version":"Other Version"},"id":"S01-000.00-070290","identifier":[{"id":"84921450045","type":"scopus"}],"ids":["aau-45e3bbef-1796-4be1-8df2-94b94455adc0"],"keyword":["Synchronizing words","Timed automata","Weighted automata"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-053C2FD896E245484F70F2D3E5754C5B"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.4230/LIPIcs.FSTTCS.2014.121","version":"Other Version"},{"access":"oa","type":"rem","url":"http://www.scopus.com/inward/record.url?scp=84921450045&partnerID=8YFLogxK","version":"Other Version"}],"org":[{"affno":"1","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Laboratoire Spécification and Véreification, CNRS, ENS Cachan"],"nora_code":"DI-OT","used":1},{"affno":"2","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (TECH)","Aalborg University, The Technical Faculty of IT and Design, Department of Computer Science","Aalborg University, The Technical Faculty of IT and Design, Department of Computer Science, CISS - Center for Embedded Software Systems"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Laurent","key":"doyenpau","last":"Doyen","name":"Doyen, Laurent","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Line","key":"juhlpau","last":"Juhl","locid":"21a2e37c-da4b-4f37-bae6-c417ac9e513b","name":"Juhl, Line","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Kim G.","key":"larsenpau","last":"Larsen","locid":"27dbc400-17ea-4672-9343-63093ad486c9","name":"Larsen, Kim Guldstrand","name_org":"Larsen, Kim G.","orcid":"0000-0002-5953-3384","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Nicolas","key":"markeypau","last":"Markey","name":"Markey, Nicolas","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mahsa","key":"shirmohammadipau","last":"Shirmohammadi","name":"Shirmohammadi, Mahsa","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.4230/lipics.fsttcs.2014.121","isbn":["9783939897774"],"pages":"121-132","publisher":"Schloss Dagstuhl- Leibniz-Zentrum fur Informatik GmbH, Dagstuhl Publishing","status":"p","title":"Leibniz International Proceedings in Informatics, LIPIcs","volume":"29"},"review":"Peer Reviewed","scoID":["2-s2.0-84921450045"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["aau-45e3bbef-1796-4be1-8df2-94b94455adc0"],"src":["AAU Aalborg University"],"title":"Synchronizing words for weighted and timed automata","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-070290","year":"2014","yearsub":"2014"}
{"author_count":5,"contributors":["Malmkvist, Jens","Peerstrup Ahrendt, Line","Palme, Rupert","Larsen, Torben","Christensen, Janne Winther"],"cuid":["S01-000.00-233187"],"event":{"end":"2014-08-09","place":"Vingsted, dk","start":"2014-08-06","title":"International Equitation Science Conference","year":"2014"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","University of Veterinary Medicine Hannover, Foundation"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"nr","rtype":["clu"],"sorti":"can faecal cortisol metabolites be used to measure weaning stress in foals","src":["au"],"src-code":["DI-U-AU"],"type":"dco","type-grp":["all","pub"]},"id":"S01-000.00-233187","ids":["au-b607b567-ed8c-4133-a358-c9408b6d20f5"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-F8B50BE3DC5B8EFD0E5D03ED8E2EAF49"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Animal and Veterinary Sciences, Department of Animal and Veterinary Sciences - Behaviour and stressbiology"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"de","key":"university of veterinary medicine hannover foundation","loc":["Germany","Europe, EU","OECD"],"name":"University of Veterinary Medicine Hannover, Foundation","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jens","key":"malmkvistpau","last":"Malmkvist","locid":"f0d53a3e-1749-42b4-8cfc-2c09864d0b3e","name":"Malmkvist, Jens","orcid":"0000-0003-3468-3770","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Line","key":"peerstrupahrendtpau","last":"Peerstrup Ahrendt","locid":"600fcc22-666b-4ee2-9846-1514db1ea9b6","name":"Peerstrup Ahrendt, Line","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Rupert","key":"palmepau","last":"Palme","name":"Palme, Rupert","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Torben","key":"larsenpau","last":"Larsen","locid":"6eda720d-adf9-4bee-b02f-2d1a195cf8bf","name":"Larsen, Torben","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Janne Winther","key":"christensenpau","last":"Christensen","locid":"dede47c2-e921-4135-914a-2353bbd5f3a5","name":"Christensen, Janne Winther","orcid":"0000-0003-0227-0648","rank":5,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-b607b567-ed8c-4133-a358-c9408b6d20f5"],"src":["AU Aarhus University"],"title":"Can faecal cortisol metabolites be used to measure weaning stress in foals","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-233187","year":"2014","yearsub":"2014"}
{"abstract":"Objective: Very low-density lipoprotein triglyceride (VLDL-TG) and free fatty acids (FFA) constitute a substantial proportion of human energy supply both at rest and during exercise. Exercise acutely decreases VLDL-TG concentration, and VLDL-TG clearance is increased after an exercise bout. However, the effects of long-term training are not clear. Design: The aim was to investigate long-term effects of training by direct assessments of VLDL-TG and palmitate kinetics and oxidation in healthy lean men (n=9) at rest, before and after a 10-week training program compared with a non-training control group (n=9). Methods: VLDL-TG kinetics were assessed with a primed constant infusion of [1-14C]VLDL-TG, and VLDL-TG oxidation by specific activity (14CO2) in expired air. The metabolic study days were placed 60-72h after the last exercise bout. Results: Palmitate kinetics and oxidation were assessed by a 2h constant infusion of [9,10-3H]palmitate. In the training group (n=9) maximal oxygen uptake increased significantly by ≈20% (p<0.05), and the insulin sensitivity (assessed by the hyperinsulinemic euglycaemic clamp) improved significantly (p<0.05). Despite these metabolic improvements, no changes in VLDL-TG secretion, clearance, or oxidation or in palmitate kinetics were observed. Conclusion: We conclude that 10 weeks of exercise training did not induce changes in VLDL-TG and palmitate kinetics in healthy lean men.","author_count":8,"contributors":["Nellemann, Birgitte","Christensen, Britt","Vissing, Kristian","Thams, Line","Sieljacks, Peter","Larsen, Mads Sørensen","Jørgensen, Jens Otto Lunde","Nielsen, Søren"],"cuid":["S01-000.00-272118"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"ten weeks of aerobic training does not result in persistent changes in vldl triglyceride turnover or oxidation in healthy men","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1530/EJE-14-0333","version":"Other Version"},"id":"S01-000.00-272118","identifier":[{"id":"25117466","type":"pmid"},{"id":"84910148608","type":"scopus"}],"ids":["au-fa4db38e-5643-418d-9978-cd4966ac75a3"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-F0024486181F8F8B38D96752DEDB6D91"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1530/EJE-14-0333","version":"Other Version"}],"oai":{"class":"Blocked","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Endocrinology and Internal Medicine"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Birgitte","key":"nellemannpau","last":"Nellemann","locid":"d715ca68-7276-407b-a149-14c985b93afe","name":"Nellemann, Birgitte","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Britt","key":"christensenpau","last":"Christensen","locid":"818501d4-b691-497c-b25b-b792b1040bc0","name":"Christensen, Britt","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kristian","key":"vissingpau","last":"Vissing","locid":"2a18fabb-7859-4d82-9b88-25be869db47c","name":"Vissing, Kristian","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Line","key":"thamspau","last":"Thams","locid":"55ec50f6-eb73-417e-abef-f9eb51b275e1","name":"Thams, Line","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Peter","key":"sieljackspau","last":"Sieljacks","locid":"027fade5-fd85-47ba-ac29-636265797645","name":"Sieljacks, Peter","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mads Sørensen","key":"larsenpau","last":"Larsen","locid":"7614c2e7-5a5d-4796-ad6d-6bd3b41a1e99","name":"Larsen, Mads Sørensen","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens Otto Lunde","key":"jørgensenpau","last":"Jørgensen","locid":"303ebe86-6861-4b19-b4d7-6bda0526b27e","name":"Jørgensen, Jens Otto Lunde","orcid":"0000-0001-7408-1526","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren","key":"nielsenpau","last":"Nielsen","locid":"da04c1ef-dfa7-4799-8f2a-e862565fc6a1","name":"Nielsen, Søren","rank":8,"rolecode":"pau"}],"pmid":["25117466"],"pub":{"doi":"10.1530/eje-14-0333","issn":["08044643","1479683X"],"issn_org":["08044643"],"issue":"5","journal":"European Journal of Endocrinology","pages":"603-13","publisher":"Oxford University Press","status":"p","title":"European Journal of Endocrinology","volume":"171"},"review":"Peer Reviewed","scoID":["2-s2.0-84910148608"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-fa4db38e-5643-418d-9978-cd4966ac75a3"],"src":["AU Aarhus University"],"title":"Ten weeks of aerobic training does not result in persistent changes in VLDL triglyceride turnover or oxidation in healthy men","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-272118","year":"2014","yearsub":"2014"}
{"abstract":"BACKGROUND: Little is known about health characteristics and the physical activity (PA) patterns in children attending preschools. The objective of this study was to describe the gender differences in relation to body mass index (BMI), motor skills (MS) and PA, including PA patterns by the day type and time of day. Additionally, the between-preschool variation in mean PA was estimated using the intraclass correlation. METHODS: We invited 627 children 5-6 years of age attending 43 randomly selected preschools in Odense, Denmark. Aiming and catching MS was assessed using subtests of the Movement Assessment Battery for Children (Second Edition) and motor coordination MS was assessed by the Kiphard-Schilling body coordination test, Körperkoordination Test für Kinder. PA was measured using accelerometry. The PA patterns were analysed using mixed models. RESULTS: No gender differences in the BMI or norm-referenced MS risk classification, or the average weekly PA level or patterns of PA were observed. However, boys performed better in the aiming and catching score (p < 0.01) and in the motor coordination score (p < 0.05) on average. Girls performed better in the balance subtest (p < 0.001). Relative to the norm-referenced classification of MS, the Danish sample distribution was significantly well for aiming and catching but poorer for the motor coordination test.The total sample and the least active children were most active on weekdays, during preschool time and in the late afternoon at the weekend. However, a relatively larger decrease in PA from preschool to weekday leisure time was observed in children in the lowest PA quartile compared to children in the highest PA quartile. Finally, the preschool accounted for 19% of the total variance in PA, with significant gender differences. CONCLUSIONS: Results of this study could provide a valuable reference material for studies monitoring future trends in obesity, MS and PA behaviour in Denmark and other countries.Knowledge about sources of variation in PA among preschool children is scarce and our findings need to be replicated in future studies. A potentially important finding is the large between-preschool variation in PA, indicating that especially girls are very susceptible to the environment offered for PA during preschool attendance.","author_count":5,"contributors":["Olesen, Line Grønholt","Kristensen, Peter Lund","Ried-Larsen, Mathias","Grøntved, Anders","Froberg, Karsten"],"cuid":["S01-000.00-642059"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Accelerometer","Cluster Analysis","Intraclass correlation"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"physical activity and motor skills in children attending 000000000043 preschools a cross sectional study","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1186/1471-2431-14-229","version":"Other Version"},"id":"S01-000.00-642059","identifier":[{"id":"25213394","type":"pmid"},{"id":"PMC4177063","type":"pmcid"},{"id":"84907216566","type":"scopus"}],"ids":["sdu-f081a885-1c02-478c-8e01-26114ea91753"],"keyword":["Accelerometer","Cluster analysis","Intraclass correlation","KTK test","MABC-2"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-58F74519C9DA15B4D572BE79BF4466B9"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1186/1471-2431-14-229","version":"Other Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics","SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics, RICH - Research In Childhood Health","SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics, Research Unit of Exercise Epidemiology"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Line Grønholt","key":"olesenpau","last":"Olesen","locid":"e9ad7180-8cce-4e88-9707-18dedc4c73e0","name":"Olesen, Line Grønholt","orcid":"0000-0002-6588-8878","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Peter Lund","key":"kristensenpau","last":"Kristensen","locid":"751d26de-66d4-4ef9-8183-880c48c96dc7","name":"Kristensen, Peter Lund","orcid":"0000-0002-5666-9614","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Mathias","key":"riedlarsenpau","last":"Ried-Larsen","locid":"4429747d-bba0-4bed-b4f0-b081efe5d5b8","name":"Ried-Larsen, Mathias","orcid":"0000-0002-8388-5291","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders","key":"grøntvedpau","last":"Grøntved","locid":"393b1ca1-e658-437c-9ca3-73aea925ad58","name":"Grøntved, Anders","orcid":"0000-0003-1584-679X","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Karsten","key":"frobergpau","last":"Froberg","locid":"758b321a-29b7-4147-8414-d0b686bf59b2","name":"Froberg, Karsten","orcid":"0000-0001-5056-710X","rank":5,"rolecode":"pau"}],"pmid":["25213394"],"pub":{"doi":"10.1186/1471-2431-14-229","issn":["14712431"],"issue":"1","journal":"BMC Pediatrics","paperid":"229","publisher":"BioMed Central","status":"p","title":"BMC Pediatrics","volume":"14"},"review":"Peer Reviewed","scoID":["2-s2.0-84907216566"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-f081a885-1c02-478c-8e01-26114ea91753"],"src":["SDU University of Southern Denmark"],"title":"Physical activity and motor skills in children attending 43 preschools : a cross-sectional study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-642059","year":"2014","yearsub":"2014"}
{"abstract":"BACKGROUND AND PURPOSE: The risk of stroke and death in patients with atrial fibrillation is strongly associated with age and concomitant comorbidities. The aim of this study was to examine the age dependence of risk factors for stroke and mortality in young patients with atrial fibrillation. METHODS: This study is a population-based cohort study of 30- to 65-year-old patients with atrial fibrillation and diagnosed during 2000 to 2011, identified by record linkage between nationwide Danish registries. Cox regression models were used to estimate the risk of stroke and mortality according to risk factors within age groups: 30 to 50, 50 to 65, and 65 to 75 years. RESULTS: We identified 73,799 nonvalvular atrial fibrillation patients, of which 37,782 (51.2%) were <65 years old (mean age 62.8). A higher modified cardiac failure or dysfunction, hypertension, age 75 (doubled), diabetes, stroke (doubled), vascular disease, age 65-74 and sex category (female) score (CHA2DS2-VASc score) was associated with decreased survival probability in all age groups. The overall incidence of stroke per year for 1 year (5 years) follow-up was 1.2% (0.6%), 3.5% (1.6%), and 5.6% (2.8%), respectively, for the age groups of 30 to 50, 50 to 65, and 65 to 75. Overall, risk factors such as previous stroke, heart failure, vascular disease, diabetes mellitus, and hypertension remained independent predictors of stroke and death in patients<65 years old with nonvalvular atrial fibrillation. CONCLUSIONS: The CHA2DS2-VASc score is an applicable tool for all age groups and in nonvalvular atrial fibrillation patients<65 years old, the same risk factors apply.","author_count":5,"contributors":["Melgaard, Line","Rasmussen, Lars Hvilsted","Skjøth, Flemming","Lip, Gregory Y H","Larsen, Torben Bjerregaard"],"cuid":["S01-000.00-105742"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"age dependence of risk factors for stroke and death in young patients with atrial fibrillation a nationwide study","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1161/STROKEAHA.114.004903","version":"Published Version"},"id":"S01-000.00-105742","identifier":[{"id":"24676780","type":"pmid"},{"id":"84899985483","type":"scopus"},{"id":"WOS:000335578100035","type":"wos"}],"ids":["aau-c011799b-10c8-44b7-babd-41df85190e73"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-3381CF038FBDF4186B1B57D81DE85C9F"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1161/STROKEAHA.114.004903","version":"Published Version"}],"oai":{"class":"Blocked","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Aalborg AF Study Group","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Hjertemedicin (Kardiologi) [Klinik Hjerte-Lunge]","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Hjerte-Lunge"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Line","key":"melgaardpau","last":"Melgaard","locid":"88687b9c-5b56-4584-a89a-89fdeca4fd54","name":"Melgaard, Line","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars Hvilsted","