"name":"Mtove, George","rank":6,"rolecode":"pau"},{"affno":"1","first":"Joyce","key":"mbwanapau","last":"Mbwana","name":"Mbwana, Joyce","rank":7,"rolecode":"pau"},{"affno":"3","first":"Victoria Marie Linderod","key":"larsenpau","last":"Larsen","name":"Larsen, Victoria Marie Linderod","rank":8,"rolecode":"pau"},{"affno":"3","first":"Emilie Caroline Skuladottir","key":"bøgestadpau","last":"Bøgestad","name":"Bøgestad, Emilie Caroline Skuladottir","rank":9,"rolecode":"pau"},{"affno":"4","first":"Louise Groth","key":"grunnetpau","last":"Grunnet","name":"Grunnet, Louise Groth","rank":10,"rolecode":"pau"},{"affno":"2","first":"Dirk Lund","key":"christensenpau","last":"Christensen","locid":"abda6d9a-232d-4e7d-b46e-2f2973cb2c35","name":"Christensen, Dirk Lund","orcid":"0000-0003-2142-522X","rank":11,"rolecode":"pau"},{"affno":"2","first":"Ib Christian","key":"bygbjergpau","last":"Bygbjerg","locid":"acec49c2-8e30-45f6-8785-19112c22d379","name":"Bygbjerg, Ib Christian","orcid":"0000-0001-9100-2754","rank":12,"rolecode":"pau"},{"affno":"5","first":"David","key":"burgnerpau","last":"Burgner","name":"Burgner, David","rank":13,"rolecode":"pau"},{"affno":"2","first":"Christentze","key":"schmiegelowpau","last":"Schmiegelow","locid":"c40efab4-c1ea-469a-a17a-fd7296acaf7c","name":"Schmiegelow, Christentze","orcid":"0000-0002-9360-9741","rank":14,"rolecode":"pau"},{"affno":"3 2","first":"Peter","key":"garredpau","last":"Garred","locid":"854d72a7-c955-43b5-b455-b7ea1f9bcb1e","name":"Garred, Peter","rank":15,"rolecode":"pau"},{"affno":"2","first":"Line","key":"hjortpau","last":"Hjort","locid":"5088dc31-9ce4-424b-abc5-87fbac8ba468","name":"Hjort, Line","rank":16,"rolecode":"pau"}],"pmid":["36466214"],"pub":{"doi":"10.1016/j.ijregi.2022.11.011","issn":["27727076"],"journal":"IJID Regions","pages":"48-57","status":"p","title":"IJID Regions","title_org":"IJID Regions (Online)","volume":"6"},"review":"Peer Reviewed","scoID":["2-s2.0-85150900933"],"search":{"DAF":["All Danish Affiliations","All