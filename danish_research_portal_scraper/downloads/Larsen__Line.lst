first":"Mogens Larsen","key":"andersenpau","last":"Andersen","locid":"cb1b131f-69dc-46eb-bb7a-5d0161d84ab5","name":"Andersen, Mogens Larsen","orcid":"0000-0003-4694-486X","rank":2,"rolecode":"pau"},{"affno":"","first":"Anne","key":"meyerpau","last":"Meyer","name":"Meyer, Anne","rank":3,"rolecode":"pau"}],"pub":{"issn":["00657727"],"journal":"ABSTRACTS OF PAPERS OF THE AMERICAN CHEMICAL SOCIETY","paperid":"117","status":"p","title":"ABSTRACTS OF PAPERS OF THE AMERICAN CHEMICAL SOCIETY","volume":"255"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-04e10be7-536e-4514-8252-f0b97e62c4ad"],"src":["KU University of Copenhagen"],"title":"Real-time measurement of laccase catalyzed formation of radicals in lignin by electron paramagnetic resonance spectroscopy","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-396388","year":"2018","yearsub":"2018"}
{"abstract":"During weight loss, dairy calcium is proposed to accelerate weight and fat mass loss through increased fecal fat excretion. The primary objective was to investigate if a high-dairy energy-restricted diet is superior to low-dairy in terms of changes in body weight, body composition and fecal fat excretion over 24 weeks. Secondary objectives included fecal energy and calcium excretion, resting energy expenditure, blood pressure, lipid metabolism and gut microbiota. In a randomized, parallel-arm intervention study 11 men and 69 women (BMI 30.60.3 kg/m2, age 441 years) were allocated to a 500 kcal (2100 kJ) deficit diet either high (HD: 1500 mg calcium/d) or low (LD: 600 mg calcium/d) in dairy products for 24 weeks. Habitual calcium intake was ~1000 mg/d. Body weight loss (HD: -6.6±1.3 kg, LD: -7.9±1.5 kg, P=0.73), fat mass loss (HD: -7.8±1.3 %, LD: -8.5±1.1 %, P=0.76), changes in fecal fat excretion (HD: -0.57±0.76 g, LD: 0.46±0.70 g, P=0.12) and microbiota composition were similar for the groups over 24 weeks. However, total fat mass loss was positively associated with relative abundance of <i></i>Papillibacter <i></i>(P=0.017) independent of diet group. Consumption of a high dairy diet did not increase fecal fat or accelerate weight and fat mass loss beyond energy restriction over 24 weeks in overweight and obese adults with a habitual calcium intake of ~1000 mg/d. However, this study indicate that <i>Papillibacter</i> is involved in body compositional changes.","author_count":9,"contributors":["Bendtsen, Line Quist","Blædel, Trine","Holm, Jacob Bak","Lorenzen, Janne Kunchel","Mark, Alicja Budek","Kiilerich, Pia","Kristiansen, Karsten","Astrup, Arne","Larsen, Lesli Hingstrup"],"cuid":["S01-000.00-454911"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Body Weight","Calcium","Dairy","Energy restriction","Microbiota"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"high intake of dairy during energy restriction does not affect energy balance or the intestinal microflora compared to low dairy intake in overweight individuals in a randomized controlled trial","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-454911","identifier":[{"id":"85040090935","type":"scopus"},{"id":"28829923","type":"pmid"}],"ids":["ku-66f2b296-9381-45e3-b37e-4fbe9ebfa0d8"],"keyword":["Body weight","Calcium","Dairy","Energy restriction","Microbiota"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-4979748AB0DBAAC5FBC8E7D648F90C80"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Nutrition, Exercise and Sports, Obesity Research"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Line Quist","key":"bendtsenpau","last":"Bendtsen","locid":"d59f6a91-604e-4dbc-9692-3df71bb7f765","name":"Bendtsen, Line Quist","orcid":"0000-0002-9541-7989","rank":1,"rolecode":"pau"},{"affno":"1","first":"Trine","key":"blædelpau","last":"Blædel","locid":"8bb74fb7-dc65-4af0-a29c-580eac2a1908","name":"Blædel, Trine","orcid":"0000-0003-3440-4217","rank":2,"rolecode":"pau"},{"affno":"1","first":"Jacob Bak","key":"holmpau","last":"Holm","locid":"db5f46b1-98f2-448d-95d3-223362b3b7c2","name":"Holm, Jacob Bak","rank":3,"rolecode":"pau"},{"affno":"1","first":"Janne Kunchel","key":"lorenzenpau","last":"Lorenzen","locid":"d8755162-ea5d-46be-b486-15f75a00b42b","name":"Lorenzen, Janne Kunchel","rank":4,"rolecode":"pau"},{"affno":"1","first":"Alicja Budek","key":"markpau","last":"Mark","locid":"7c8367e6-79b0-4225-8c04-9c83822c03d1","name":"Mark, Alicja Budek","rank":5,"rolecode":"pau"},{"affno":"1","first":"Pia","key":"kiilerichpau","last":"Kiilerich","locid":"ccf01d8e-0bf9-40ce-9e2b-039ea6f19e18","name":"Kiilerich, Pia","orcid":"0000-0001-5665-6074","rank":6,"rolecode":"pau"},{"affno":"1","first":"Karsten","key":"kristiansenpau","last":"Kristiansen","locid":"941041b1-1b8f-4be5-9a65-5e98f662c07e","name":"Kristiansen, Karsten","orcid":"0000-0002-6024-0917","rank":7,"rolecode":"pau"},{"affno":"1","first":"Arne","key":"astruppau","last":"Astrup","locid":"5d943631-c9fc-4b63-8aaa-263ba4248735","name":"Astrup, Arne","orcid":"0000-0001-8968-8996","rank":8,"rolecode":"pau"},{"affno":"1","first":"Lesli Hingstrup","key":"larsenpau","last":"Larsen","locid":"cf1fc793-3fd4-4dca-ab8e-ee3ed914ec04","name":"Larsen, Lesli Hingstrup","orcid":"0000-0001-8827-7992","rank":9,"rolecode":"pau"}],"pmid":["28829923"],"pub":{"doi":"10.1139/apnm-2017-0234","issn":["17155312","17155320"],"issn_org":["17155312"],"issue":"1","journal":"Applied Physiology, Nutrition and Metabolism","pages":"1-10","status":"p","title":"Applied Physiology, Nutrition and Metabolism","volume":"43"},"review":"Peer Reviewed","scoID":["2-s2.0-85040090935"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-66f2b296-9381-45e3-b37e-4fbe9ebfa0d8"],"src":["KU University of Copenhagen"],"title":"High intake of dairy during energy restriction does not affect energy balance or the intestinal microflora compared to low dairy intake in overweight individuals in a randomized controlled trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-454911","year":"2018","yearsub":"2018"}
{"abstract":"PURPOSE: We investigated whether changes in body mass index (BMI) before a breast cancer diagnosis affected mortality and whether trajectories more accurately predict overall mortality compared to a single measure of BMI. METHODS: Our prospective cohort comprised 2012 women with breast cancer who reported their weight in each decade from 20 to 50-64 years of age. We used trajectory analysis to identify groups with similar development patterns in BMI and Cox proportional hazards models to examine the association between trajectory groups and mortality, and interactions with oestrogen receptor status and smoking. We used c-index statistics to compare the trajectory model with the single measure model of BMI. RESULTS: We identified three distinct trajectory groups, with a mean BMI at age 20 of 19, 22 and 24 increasing to 23 (normal-to-normal), 29 (normal-to-overweight) and 37 (normal-to-obese) at 50-64 years of age, respectively. Women in the normal-to-obese trajectory group experienced significantly higher overall mortality than those in the normal-to-normal trajectory group (HR 1.76, 95% CI 1.21‒2.56). The association declined to a non-significant level after adjustments for clinical prognostic factors. Although not significant, the same tendency was seen for breast cancer-specific mortality. The association was strongest in women with oestrogen receptor-negative tumours. Weight changes over time were not significantly different from a single BMI measure before diagnosis to predict survival. CONCLUSION: Weight gain affects overall mortality after breast cancer but clinical prognostic factors largely eliminate the association. Using trajectories of weight changes did not improve the predictive value compared to a single measure of BMI.","author_count":9,"contributors":["Larsen, Signe Benzon","Torstensson, Maia","Kenborg, Line","Christensen, Jane","Kroman, Niels","Dalton, Susanne Oksbjerg","Tjønneland, Anne","Johansen, Christoffer","Bidstrup, Pernille Envold"],"cuid":["S01-000.00-458726"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Adult","Aged","Body Mass Index","Body Weight","Breast Neoplasms diagnosis","Denmark epidemiology","Disease Management","Female","Humans","Middle Aged","Mortality","Prognosis","Proportional Hazards Models","Public Health Surveillance","Registries","Risk Factors","Young Adult"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-NP","DI-U"],"level3":{"NP":["DI-NP-ALL","DI-NP-CAN"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-NP-CAN","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"pre diagnostic changes in body mass index and mortality among breast cancer patients","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-458726","identifier":[{"id":"29637418","type":"pmid"},{"id":"85045141769","type":"scopus"}],"ids":["ku-6d4fa42f-4242-4c1d-9284-3e35a4f654bd"],"keyword":["Adult","Aged","Body Mass Index","Body Weight","Breast Neoplasms/diagnosis","Denmark/epidemiology","Disease Management","Female","Humans","Middle Aged","Mortality","Prognosis","Proportional Hazards Models","Public Health Surveillance","Registries","Risk Factors","Young Adult"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-7A0C0F5D4DAA4BE5EA7240F07EBEB5ED"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinic