":"Jeppesen, Pia","rank":32,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jens Richardt Mollegaard","key":"jepsenjensrichardtmollegaardpau","last":"Jepsen","name":"Jepsen, Jens Richardt Mollegaard","rank":33,"rolecode":"pau"},{"affno":"2","first":"Jens Richardt Møllegaard","key":"jepsenjensrichardtmøllegaardpau","last":"Jepsen","name":"Jepsen, Jens Richardt Møllegaard","rank":33,"rolecode":"pau"},{"affno":"1","first":"Signe","key":"vangkildesignepau","last":"Vangkilde","locid":"b39acb31-2af6-4d3c-90fa-3d0908a0948d","name":"Vangkilde, Signe","orcid":"0000-0002-1622-3108","rank":34,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Markus Harboe","key":"olsenmarkholmpau","last":"Olsen","locid":"61481755-f381-407c-9a69-ca011d3ea1ac","name":"Olsen, Mark Holm","name_org":"Olsen, Markus Harboe","orcid":"0000-0002-8101-7503","rank":35,"rolecode":"pau"},{"affno":"1 2","first":"Markus Harboe","key":"olsenmarkusharboepau","last":"Olsen","locid":"3ce2cba2-2ebf-4e0b-ba96-a8079ac43f1e","name":"Olsen, Markus Harboe","rank":35,"rolecode":"pau"},{"affno":"2","first":"Julie","key":"hagstrømjuliepau","last":"Hagstrøm","name":"Hagstrøm, Julie","rank":36,"rolecode":"pau"},{"affno":"2","first":"Nicole Nadine","key":"lønfeldtnicolenadinepau","last":"Lønfeldt","name":"Lønfeldt, Nicole Nadine","rank":37,"rolecode":"pau"},{"affno":"2 7","first":"Kerstin Jessica","key":"plessenkerstinjessicapau","last":"Plessen","name":"Plessen, Kerstin Jessica","rank":38,"rolecode":"pau"}],"pmid":["35305587"],"pub":{"doi":"10.1186/s12888-021-03669-2","issn":["1471244X"],"issn_org":["1471244x"],"issue":"1","journal":"BMC Psychiatry","paperid":"204","publisher":"BioMed Central Ltd.","status":"p","title":"BMC Psychiatry","volume":"22"},"review":"Peer Reviewed","scoID":["2-s2.0-85126799233"],"sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region Zealand","Technical University of Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-2d8b4148-0b9c-4a6b-889e-8a887de62040","dtu-9e67e3e1-719f-4e68-a86f-a3c6832707b8","ku-3fabf7e2-9711-4d62-9348-dc6127a92991","sdu-e3023677-5b9d-4d5c-b1b8-b17ffec52568"],"src":["AU Aarhus University","DTU Technical University of Denmark","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Family-based cognitive behavioural therapy versus family-based relaxation therapy for obsessive-compulsive disorder in children and adolescents : protocol for a randomised clinical trial (the TECTO trial)","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-096.99-015926","year":"2022","yearsub":"2022"}
{"abstract":"Introduction The number of nursing home residents living with obesity is increasing. People living with obesity experience significant difficulties living independently and engaging in daily occupations such as dressing, personal hygiene, and functional mobility. Nursing research reports second-hand experiences of nursing home residents living with obesity isolating themselves and being ashamed. Other studies indicate that obese nursing home residents are perceived as unmotivated, lacking social support, more dependent, and characterized by depression, anxiety and shame related to obesity. While some studies have addressed the difficulties that nursing home residents living with obesity experience, there is still a lack of knowledge of the impact of obesity on daily occupations from the perspectives of nursing home residents. Objectives This study explores how nursing home residents experience the impact of obesity on their daily occupations. Conclusion The nursing home residents are critical of their daily lives and express what works and what they want to be different. They want to maintain weight loss and level of function, which is expressed through an awareness of diet, performing parts of PADL and other occupations. The environment can either promote or inhibit the experience of well-being","author_count":5,"contributors":["Bentz, Hannah Holt","Dynesen, Anja Weirsøe","Christoffersen, Tenna","Mærsk, Jesper Larsen","Lindahl-Jacobsen, Line Elisabeth"],"cuid":["S01-000.00-553244"],"event":{"end":"2022-08-31","place":"Paris","start":"2022-08-27","title":"World Federation of Occupational Therapists (WFOT) Congress 2022","year":"2022"},"filters":{"added":"2023-07","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-UC"],"level3":{"UC":["DI-UC-AB","DI-UC-ALL"]},"level3all":["DI-UC-AB"]},"review":"nr","rtype":["clu"],"sorti":"from cake to crispbread the impact of obesity on daily occupations experienced by elderly nursing home residents a phenomenological study","src":["pha"],"src-code":["DI-UC-AB"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-553244","ids":["pha-1844eae6-ae03-4cc5-92aa-8522fbf655c1"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-1B550474E3F74B559E52F6A544E19CF0"],"org":[{"affno":"1","key":"university college absalon","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-AB","l3nl":"University College Absalon","l3nn":"University College Absalon","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"University College Absalon","namevar":["Professionshøjskolen Absalon, Direktionen - Slagelse, Sundhed, Social og Engineeringområdet, Absalon - Hverdagsliv og Sundhed","Professionshøjskolen Absalon, Direktionen - Slagelse, Sundhed, Social og Engineeringområdet, Ergoterapeutuddannelsen - Næstved"],"nora_code":"DI-UC-AB","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Hannah Holt","key":"bentzpau","last":"Bentz","locid":"256df32d-de83-40b4-af98-9620f97179a2","name":"Bentz, Hannah Holt","orcid":"0000-0002-9385-4448","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anja Weirsøe","key":"dynesenpau","last":"Dynesen","locid":"6ece8d2e-ca59-484f-8510-d14a97df2620","name":"Dynesen, Anja Weirsøe","orcid":"0000-0002-9573-8336","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Tenna","key":"christoffersenpau","last":"Christoffersen","locid":"ac698243-a4e4-42d9-af8d-d43d4e94deb5","name":"Christoffersen, Tenna","orcid":"0000-0001-6472-8226","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper Larsen","key":"mærskpau","last":"Mærsk","locid":"498dd3b8-2091-4d8a-8316-14799fe80c52","name":"Mærsk, Jesper Larsen","orcid":"0000-0002-5290-7937","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Line Elisabeth","key":"lindahljacobsenpau","last":"Lindahl-Jacobsen","locid":"cb2c3d9c-2ec4-43e2-b6ec-7cf77ac4f758","name":"Lindahl-Jacobsen, Line Elisabeth","orcid":"0000-0002-8538-217X","rank":5,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All University Colleges","DI-ALL","DI-UC","DI-UC-ALL","University College Absalon","University Colleges"],"PST":["Published"]},"sid":["pha-1844eae6-ae03-4cc5-92aa-8522fbf655c1"],"src":["AB University College Absalon"],"title":"From cake to crispbread : The impact of obesity on daily occupations experienced by elderly nursing home residents - A phenomenological study","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-553244","year":"2022","yearsub":"2022"}
{"abstract":"BACKGROUND: Postoperative emergence agitation remains a significant challenge in paediatric anaesthesia. Although short-lived, it may cause harm to the patient and negative experiences for all. Differentiating agitation, delirium and pain is difficult. Electroencephalography allows precise titration of anaesthetic depth, and heart rate variability monitoring permits immediate intervention regarding nociception and pain. We examined if one of these measures could be used to reduce postoperative agitation in an unselected paediatric day surgical population. OBJECTIVE: The primary outcome was postoperative agitation with a Richmond Agitation-Sedation Scale greater than 0. Secondary outcomes were: length of stay, postoperative nausea and vomiting, fentanyl and propofol consumption, pain scores and use of postoperative analgesics. DESIGN: A randomised, single-blinded study constituting children aged 1 to 6 years, undergoing minor general day surgical procedures. SETTING: Paediatric day surgical department 29th March 2019 to 12th June 2020. PATIENTS: Ninety-eight children (ASA 1 or 2) were enrolled, and 93 children were included in the final analysis. INTERVENTIONS: Children received standard monitoring (n=31), standard monitoring plus either Narcotrend (n=31), or Anaesthesia Nociception Index monitoring (n=31). Sevoflurane or fentanyl was titrated immediately according to monitor thresholds. RESULTS: Kaplan-Meier analysis yielded a statistically significant difference between the groups (P = 0.016) with the lowest agitation levels in the Anaesthesia Nociception Index group, intermediate levels in the control group and the highest agitation levels in the Narcotrend monitored group. Intergroup pairwise comparison however, showed no difference. The Anaesthesia Nocioception Index group received slightly more fentanyl (P = 0.277). The control group patients had the highest pain scores despite receiving more caudal blocks and the Narcotrend group had more sevoflurane adjustments. Other secondary outcomes were comparable. CONCLUSION: Children in the Anaesthesia Nociception Index group were the least agitated with the highest fentanyl doses, without increasing the length of stay in the PACU or postoperative nausea and vomiting. CLINICAL REGISTRATION: The study was registered in REDCap online trial database 1/11/2018 trial registration nr. OP720. https://open.rsyd.dk/OpenProjects/openProject.jsp?openNo=720&lang=da.","author_count":5,"contributors":["Larsen, Line Gry","Wegger, Marie","Greves, Sebastian","Erngaard, Liv","Hansen, Tom Giedsing"],"cuid":["S01-000.00-642474"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Larsen, Line Gry"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"emergence agitation in paediatric day case surgery a randomised single blinded study comparing narcotrend and heart rate variability with standard monitoring","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85124056080","version":"Other Version"},"id":"S01-000.00-642474","identifier":[{"id":"34923564","type":"pmid"},{"id":"85124056080","type":"scopus"}],"ids":["sdu-f1ecd26e-647b-450d-8105-db340c0d369d"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-E7C2728E4193AC9CE225E3407E1694D8"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Anaesthesiology and Intensive Care (Odense)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Line Gry","key":"larsenpau","last":"Larsen","locid":"9e779ea0-e653-4cd5-94e0-a583ca1eb0e6","name":"Larsen, Line Gry","orcid":"0000-0002-0683-4503","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Marie","key":"weggerpau","last":"Wegger","locid":"14cbc2a9-998c-48ce-8aac-1e3c0400563a","name":"Wegger, Marie","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sebastian","key":"grevespau","last":"Greves","locid":"17379641-b436-41fe-835a-92de27f63d75","name":"Greves, Sebastian","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Liv","key":"erngaardpau","last":"Erngaard","locid":"b816ac3c-0b50-4919-bfd6-3647b66d25b3","name":"Erngaard, Liv","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Tom Giedsing","key":"hansenpau","last":"Hansen","locid":"5f66539d-cd24-4c21-8e6b-fefbcdcb0032","name":"Hansen, Tom Giedsing","orcid":"0000-0002-5896-9768","rank":5,"rolecode":"pau"}],"pmid":["34923564"],"pub":{"doi":"10.1097/eja.0000000000001649","issn":["02650215","09521941"],"issn_org":["02650215"],"issue":"3","journal":"European Journal of Anaesthesiology","pages":"261-268","publisher":"Lippincott Williams and Wilkins","status":"p","title":"European Journal of Anaesthesiology","volume":"39"},"review":"Peer Reviewed","scoID":["2-s2.0-85124056080"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-f1ecd26e-647b-450d-8105-db340c0d369d"],"src":["SDU University of Southern Denmark"],"title":"Emergence agitation in paediatric day case surgery: A randomised, single-blinded study comparing narcotrend and heart rate variability with standard monitoring","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-642474","year":"2022","yearsub":"2022"}
{"abstract":"BACKGROUND & AIMS: The sucrase-isomaltase (SI) c.273_274delAG loss-of-function variant is common in Arctic populations and causes congenital sucrase-isomaltase deficiency, which is an inability to break down and absorb sucrose and isomaltose. Children with this condition experience gastrointestinal symptoms when dietary sucrose is introduced. We aimed to describe the health of adults with sucrase-isomaltase deficiency. METHODS: The association between c.273_274delAG and phenotypes related to metabolic health was assessed in 2 cohorts of Greenlandic adults (n = 4922 and n = 1629). A sucrase-isomaltase knockout (Sis-KO) mouse model was used to further elucidate the findings. RESULTS: Homozygous carriers of the variant had a markedly healthier metabolic profile than the remaining population, including lower body mass index (β [standard error], -2.0 [0.5] kg/m2; P = 3.1 × 10-5), body weight (-4.8 [1.4] kg; P = 5.1 × 10-4), fat percentage (-3.3% [1.0%]; P = 3.7 × 10-4), fasting triglyceride (-0.27 [0.07] mmol/L; P = 2.3 × 10-6), and remnant cholesterol (-0.11 [0.03] mmol/L; P = 4.2 × 10-5). Further analyses suggested that this was likely mediated partly by higher circulating levels of acetate observed in homozygous carriers (β [standard error], 0.056 [0.002] mmol/L; P = 2.1 × 10-26), and partly by reduced sucrose uptake, but not lower caloric intake. These findings were verified in Sis-KO mice, which, compared with wild-type mice, were leaner on a sucrose-containing diet, despite similar caloric intake, had significantly higher plasma acetate levels in response to a sucrose gavage, and had lower plasma glucose level in response to a sucrose-tolerance test. CONCLUSIONS: These results suggest that sucrase-isomaltase constitutes a promising drug target for improvement of metabolic health, and that the health benefits are mediated by reduced dietary sucrose uptake and possibly also by higher levels of circulating acetate.","author_count":29,"contributors":["Andersen, Mette K.","Skotte, Line","Jørsboe, Emil","Polito, Ryan","Stæger, Frederik Filip","Aldiss, Peter","Hanghøj, Kristian","Waples, Ryan K.","Santander, Cindy G.","Grarup, Niels","Dahl-Petersen, Inger K.","Diaz, Lars J.","Overvad, Maria","Senftleber, Ninna","Søborg, Bolette","Larsen, Christina V. L.","Lemoine, Clara","Pedersen, Oluf","Feenstra, Bjarke","Bjerregaard, Peter","Melbye, Mads","Jørgensen, Marit E.","Færgeman, Nils J.","Koch, Anders","Moritz, Thomas","Gillum, Matthew P.","Moltke, Ida","Hansen, Torben","Albrechtsen, Anders"],"cuid":["S02-098.67-044070"],"filters":{"added":"2022-06","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["America, North","Nordic","OECD"],"corresponding_author":["Albrechtsen, Anders"],"country":["Greenland","United States"],"glorg":["All Global Affiliations","Grønlands Universitet","Stanford University","University of Greenland"],"keyword":["Drug target","Genetics","Loss of function","Metabolic health","Sucrase Isomaltase"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-OT","DI-PR","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-STENO"],"OT":["Steno Diabetes Centre, Gentofte, Denmark."],"PR":["DI-PR-ALL","DI-PR-NOVO"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-HO-STENO","DI-PR-NOVO","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"loss of sucrase isomaltase function increases acetate levels and improves metabolic health in greenlandic cohorts","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1053/j.gastro.2021.12.236","version":"Published Version"},"id":"S02-098.67-044070","identifier":[{"id":"34914943","type":"pmid"},{"id":"000840326600025","type":"wos"},{"id":"85124939212","type":"scopus"}],"ids":["ku-85e14c2a-87d3-4d17-bb76-800a71a7620b","sdu-a0e191ac-a57d-4c2c-b7c9-ad9eb27deedd"],"keyword":["Drug Target","Genetics","Loss of Function","Metabolic Health","Sucrase-Isomaltase"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-24687D79311D73C756D5B157CFF4B529"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/311214306/1_s2.0_S0016508521040658_main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1053/j.gastro.2021.12.236","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/202400420/PIIS0016508521040658.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Novo Nordisk Foundation Center for Basic Metabolic Research, Hansen Group"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"ssi statens serum institut","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-SSI","l3nn":"SSI Statens Serum Institut","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SSI Statens Serum Institut","namevar":["Statens Serum Institut"],"nora_code":"DI-GV-SSI","used":1},{"affno":"3","country":"dk","key":"novo nordisk","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-NOVO","l3nl":"Novo Nordisk","l3nn":"Novo Nordisk","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Novo Nordisk","namevar":["Novo Nordisk"],"nora_code":"DI-PR-NOVO","used":1},{"affno":"4","key":"sdu university of southern denmark","l2":"D