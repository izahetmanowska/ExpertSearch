":"","corresponding":null,"first":"Valentin","key":"rauhpau","last":"Rauh","name":"Rauh, Valentin","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lotte Bach","key":"larsenpau","last":"Larsen","locid":"204d7240-6828-4ee0-8ef5-77a4a2ac92d4","name":"Larsen, Lotte Bach","orcid":"0000-0001-9674-0107","rank":5,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-989932db-bdff-48a0-82ca-1a9a5f5bccfb"],"src":["AU Aarhus University"],"title":"Quantification of the interplay between process-induced protein modifications","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-216243","year":"2020","yearsub":"2020"}
{"abstract":"The ever-changing development of digital technologies and digital infrastructure makes it necessary for us as researchers to change approaches to digital research within the humanities. In terms of research ethics, we can no longer use traditional laws and guidelines that only match the non-digital world. In a time where it is necessary to change and re-think our ways of doing research, we bring to you this second version of Ethical Challenges in Digital Research to initiate discussions about ethical research and to help guide you in your digital research. The compound may serve you as a guideline to ethical research, a helpful tool to those in need of inspiration or merely as a list of literature that is relevant to your field, whether that is: big data, surveillance, privacy, games and gamification, ethics in studies with children and adolescents, health research, journalism, ethnographic studies, visual methods, vulnerable groups, web archives, economy, risky business for researchers or one of the many other categories in this collection of ethical digital research.","author_count":3,"contributors":["Christensen, Line Lisberg","Larsen, Malene Charlotte","Wind, Sanne Tarp"],"cuid":["S02-083.04-006423"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","class":"merged","cluster_size":1,"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"ethical challenges in digital research a guide to discuss ethical issues in digital research second edition","src":["aau"],"src-code":["DI-U-AAU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://dighumlab.org/wp-content/uploads/2018/10/Ethical_challenges_in_digital-research.pdf","version":"Published Version"},"id":"S02-083.04-006423","ids":["aau-84b9d8e5-a363-420d-9ac8-701f122adefd","aau-f7633b9c-0739-4952-95a7-b616a5d2690c"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Local-1-2-F19A7E5DEEDA0936527DF79C37A01625"],"oa_link":[{"access":"oa","type":"rem","url":"https://dighumlab.org/wp-content/uploads/2018/10/Ethical_challenges_in_digital-research.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Humanities","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, E-learning lab"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Line Lisberg","key":"christensenpau","last":"Christensen","locid":"779d079a-0498-4467-a485-b354344b6eb1","name":"Christensen, Line Lisberg","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Malene Charlotte","key":"larsenpau","last":"Larsen","locid":"cc0033d3-6794-4e0c-b451-939e05f9a1ee","name":"Larsen, Malene Charlotte","orcid":"0000-0003-4821-5855","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Sanne Tarp","key":"windpau","last":"Wind","locid":"f737ff9e-90fe-483e-b1da-86f5a83a3813","name":"Wind, Sanne Tarp","rank":3,"rolecode":"pau"}],"pub":{"pages":"136","place":"Aalborg Universitet, Digetik, DigHumLab.","status":"p","volume":"1."},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-84b9d8e5-a363-420d-9ac8-701f122adefd","aau-f7633b9c-0739-4952-95a7-b616a5d2690c"],"src":["AAU Aalborg University"],"title":"Ethical Challenges in Digital Research : A guide to discuss ethical issues in digital research, Second edition","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-083.04-006423","year":2020,"yearsub":2020}
{"abstract":"BACKGROUND: Deliberately training with reduced carbohydrate availability, a paradigm coined training low, has shown to promote adaptations associated with improved aerobic capacity. In this context researchers have proposed that protein may be ingested prior to training as a means to enhance the protein balance during exercise without spoiling the effect of the low carbohydrate availability. Accordingly, this is being practiced by world class athletes. However, the effect of protein intake on muscle protein metabolism during training low has not been studied. This study aimed to examine if protein intake prior to exercise with reduced carbohydrate stores benefits muscle protein metabolism in exercising and non-exercising muscles. METHODS: Nine well-trained subjects completed two trials in random order both of which included a high-intensity interval ergometer bike ride (day 1), a morning (day 2) steady state ride (90 min at 65% VO2peak, 90ss), and a 4-h recovery period. An experimental beverage was consumed before 90ss and contained either 0.5 g whey protein hydrolysate [WPH]/ kg lean body mass or flavored water [PLA]. A stable isotope infusion (L-[ring-13C6]-phenylalanine) combined with arterial-venous blood sampling, and plasma flow rate measurements were used to determine forearm protein turnover. Myofibrillar protein synthesis was determined from stable isotope incorporation into the vastus lateralis. RESULTS: Forearm protein net balance was not different from zero during 90ss exercise (nmol/100 ml/min, PLA: 0.5 ± 2.6; WPH: 1.8, ± 3.3) but negative during the 4 h recovery (nmol/100 ml/min, PLA: - 9.7 ± 4.6; WPH: - 8.7 ± 6.5); no interaction (P = 0.5) or main effect of beverage (P = 0.11) was observed. Vastus lateralis myofibrillar protein synthesis rates were increased during 90ss exercise (+ 0.02 ± 0.02%/h) and recovery (+ 0.02 ± 0.02%/h); no interaction (P = 0.3) or main effect of beverage (P = 0.3) was observed. CONCLUSION: We conclude that protein ingestion prior to endurance exercise in the energy- and carbohydrate-restricted state does not increase myofibrillar protein synthesis or improve net protein balance in the exercising and non-exercising muscles, respectively, during and in the hours after exercise compared to ingestion of a non-caloric control. TRIAL REGISTRATION: clinicaltrials.gov, NCT01320449. Registered 10 May 2017 - Retrospectively registered, https://clinicaltrials.gov/ct2/show/NCT03147001.","author_count":13,"contributors":["Larsen, Mads Sørensen","Holm, Lars","Svart, Mads","Hjelholt, Astrid Johannesson","Bengtsen, Mads Bisgaard","Dollerup, Ole L","Jensen, Line","Vendelbo, Mikkel","van Hall, Gerrit","Møller, Niels","Mikkelsen, Ulla R","Hansen, Mette"],"cuid":["S02-093.90-028661"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","University of Birmingham"],"keyword":["Carbohydrate restriction","Dietary protein","Endurance training","Protein metabolism"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-ARLA"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-PR-ARLA","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"effects of protein intake prior to carbohydrate restricted endurance exercise a randomized crossover trial","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s12970-020-0338-z","version":"Published Version"},"id":"S02-093.90-028661","identifier":[{"id":"85078538575","type":"scopus"},{"id":"000513804900001","type":"wos"},{"id":"31992300","type":"pmid"},{"id":"PMC6986159","type":"pmcid"}],"ids":["au-dc88b443-a30e-4319-9ee7-1e6e71490349","ku-0c9603e8-14de-4b54-8fd6-30a678825265"],"keyword":["Carbohydrate restriction","Dietary protein","Endurance training","Protein metabolism"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-E515869B31B1DD007C2ECBF7029ADC04"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/237099314/OA_Effects_of_protein_intake_prior_to.pdf","version":"Published Version"},{"access":"oa","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC6986159/pdf/12970_2020_Article_338.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s12970-020-0338-z","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Public Health"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"arla foods","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-ARLA","l3nl":"Arla Foods","l3nn":"Arla Foods","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Arla Foods","namevar":["Arla Foods"],"nora_code":"DI-PR-ARLA","used":1},{"affno":"3","country":"gb","key":"university of birmingham","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Birmingham","used":1},{"affno":"4","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Biomedical Sciences, Endocrinology and Metabolism"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Mads S","key":"larsenpau","last":"Larsen","locid":"7614c2e7-5a5d-4796-ad6d-6bd3b41a1e99","name":"Larsen, Mads Sørensen","name_org":"Larsen, Mads S","rank":1,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Lars","key":"holmpau","last":"Holm","name":"Holm, Lars","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mads V","key":"svartpau","last":"Svart","locid":"a8b24d1c-a84f-4d6c-ad15-b8affc06c72d","name":"Svart, Mads","name_org":"Svart, Mads V","orcid":"0000-0002-9574-0612","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Astrid J","key":"hjelholtpau","last":"Hjelholt","locid":"7c969e96-fa50-4878-a9fe-bea51d76ec75","name":"Hjelholt, Astrid Johannesson","name_org":"Hjelholt, Astrid J","orcid":"0000-0002-3114-4176","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mads B","key":"bengtsenpau","last":"Bengtsen","locid":"17a0209b-028a-40c1-8a5a-b65443ed3e56","name":"Bengtsen, Mads Bisgaard","name_org":"Bengtsen, Mads B","orcid":"0000-0001-8985-8385","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ole L","key":"dolleruppau","last":"Dollerup","locid":"571b3fca-42a9-44aa-853b-054665af5b80","name":"Dollerup, Ole L","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Line B","key":"dalgaardpau","last":"Dalgaard","locid":"e136f41f-f605-4357-a0fb-258e8f7a10fc","name":"Jensen, Line","name_org":"Dalgaard, Line B","orcid":"0000-0001-7676-5323","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mikkel H","key":"vendelbopau","last":"Vendelbo","locid":"f2e9a2a2-57fc-433f-b9fb-726b15b1cdc4","name":"Vendelbo, Mikkel","name_org":"Vendelbo, Mikkel H","orcid":"0000-0003-0431-2522","rank":8,"rolecode":"pau"},{"affno":"4","first":"Gerrit","key":"vanhallpau","last":"van Hall","locid":"55a9b111-6dbb-4a42-a9ab-d5f3785fbdae","name":"van Hall, Gerrit","orcid":"0000-0002-2519-8127","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Niels","key":"møllerpau","last":"Møller","locid":"2e0d8e2a-2da1-4d55-b2da-0a25c0375b1e","name":"Møller, Niels","orcid":"0000-0001-5627-7322","rank":10,"rolecode":"pau"},{"affno":"","first":"Niels","key":"mollerpau","last":"Moller","name":"Moller, Niels","rank":10,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ulla R","key":"mikkelsenpau","last":"Mikkelsen","name":"Mikkelsen, Ulla R","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mette","key":"hansenpau","last":"Hansen","locid":"35b198ca-caef-48de-8570-21c9fbab1f8f","name":"Hansen, Mette","orcid":"0000-0002-9383-8202","rank":12,"rolecode":"pau"}],"pmid":["31992300"],"pub":{"doi":"10.1186/s12970-020-0338-z","issn":["15502783"],"issue":"1","journal":"Journal of the International Society of Sports Nutrition","paperid":"7","publisher":"BioMed Central Ltd.","publisher_org":"BioMed Central Ltd","status":"p","title":"Journal of the International Society of Sports Nutrition","title_org":"Journal of the international society of sports nutrition","volume":"17"},"review":"Peer Reviewed","scoID":["2-s2.0-85078538575"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Private Research","All Universities","Arla Foods","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Private Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-dc88b443-a30e-4319-9ee7-1e6e71490349","ku-0c9603e8-14de-4b54-8fd6-30a678825265"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Effects of protein intake prior to carbohydrate-restricted endurance exercise: a randomized crossover trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-093.90-028661","year":"2020","yearsub":"2020"}
{"abstract":"Objectives: This study sought to describe the risk of thromboembolism in nonanticoagulated atrial fibrillation patients with Evaluated Heartvalves, Rheumatic or Artificial (EHRA) Type 2 valvular heart disease (VHD) <65 or 65 to 74 years of age and with 0 or 1 non-sex comorbidity of the CHA 2DS 2-VASc score. Background: A minor, but important, proportion of patients with atrial fibrillation and VHD beyond moderate-to-severe mitral stenosis and/or a mechanical prosthetic valve, so-called EHRA Type 2 VHD, have 0 or 1 coexisting non-sex comorbidities of the CHA 2DS 2-VASc score, and are therefore not strongly recommended oral anticoagulant therapy according to guidelines. Whether these patients are truly low risk of thromboembolism has not been investigated. Methods: This was a cohort study of 55,613 patients identified in nationwide Danish registries from 2000 to 2018, of which 1,907 patients had EHRA Type 2 VHD. Risk of thromboembolism after 1 and 5 years of follow-up were calculated. Results: At 1 year after atrial fibrillation diagnosis, patients with EHRA Type 2 VHD had a risk of thromboembolism between 1.2% and 1.5%, according to age group (<65 or 65 to 74 years of age), and number of non-sex comorbidities of the CHA 2DS 2-VASc score (0 or 1). Interestingly, in patients with EHRA Type 2 VHD <65 years of age with 0 or 1 comorbidity, the risk was 1.5% (95% confidence interval: 0.7% to 2.8%) and 1.5% (95% confidence interval: 0.6% to 3.4%) at 1 year after the atrial fibrillation diagnosis. Conclusions: These observations suggest that in atrial fibrillation patients with EHRA Type 2 VHD, who are not currently recommended oral anticoagulant therapy according to guidelines, the risk of thromboembolism may exceed the level above which oral anticoagulation is considered beneficial.","author_count":6,"contributors":["Melgaard, Line","Overvad, Thure Filskov","Jensen, Martin","Lip, Gregory Y H","Larsen, Torben Bjerregaard","Nielsen, Peter Brønnum"],"cuid":["S01-000.00-056599"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"corresponding_author":["Melgaard, Line"],"country":["United Kingdom"],"glorg":["All Global Affiliations","Liverpool Heart and Chest Hospital NHS Foundation Trust"],"keyword":["Atrial fibrillation","CHADS VASc score","Risk","Thromboembolism","Valvular heart disease"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"thromboembolic risk in non anticoagulated patients with atrial fibrillation and valvular heart disease","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85090481290&partnerID=8YFLogxK","version":"Other Version"},"funding_acknowledgement":["The study was supported by ?The BMS/Pfizer European Thrombosis Investigator Initiated Research Program (ERISTA) 2018? and the Obel Family Foundation. Dr. Melgaard has received grant support from BMS/Pfizer. Prof. Lip has been a consultant for Bayer/Janssen, BMS/Pfizer, Biotronik, Medtronic, Boehringer Ingelheim, Microlife, and Daiichi Sankyo; and has been a speaker for Bayer, BMS/Pfizer, Medtronic, Boehringer Ingelheim, Microlife, Roche, and Daiichi Sankyo. No fees were received personally. Prof. Larsen has been an investigator for Janssen Scientific Affairs, LLC, and Boehringer Ingelheim; and has been a speaker for Bayer, BMS/Pfizer, Janssen Pharmaceuticals, Takeda, Roche Diagnostics, and Boehringer Ingelheim. No fees were received personally. Dr. Nielsen has received speaking fees Boehringer Ingelheim; consulting fees from Bayer; and grant support from BMS/Pfizer. All other authors have reported that they have no relationships relevant to the contents of this paper to disclose."],"id":"S01-000.00-056599","identifier":[{"id":"85090481290","type":"scopus"}],"ids":["aau-164d57c5-9504-48ed-bcf3-9c92a03e018b"],"keyword":["CHADS-VASc score","atrial fibrillation","risk","thromboembolism","valvular heart disease"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-AF1B2DEE3CD8FCE7A72B80EB1E681346"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Cardiology","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Anæstesi, Børn, Kredsløb og Kvinder","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine, Aalborg Thrombosis Research Unit"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"gb","key":"liverpool heart and chest hospital nhs foundation trust","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Liverpool Heart and Chest Hospital NHS Foundation Trust","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Line","key":"melgaardpau","last":"Melgaard","locid":"88687b9c-5b56-4584-a89a-89fdeca4fd54","name":"Melgaard, Line","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Thure Filskov","key":"overvadpau","last":"Overvad","locid":"63d282a2-85c6-4f40-a01b-f4cc59ec37f5","name":"Overvad, Thure Filskov","orcid":"0000-0001-8096-0236","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Martin","key":"jensenpau","last":"Jensen","locid":"d5770e98-1d04-4d3b-aa8c-49c951b21eb0","name":"Jensen, Martin","rank":3,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Gregory Y.H.","key":"lippau","last":"Lip","locid":"8fa30e84-7381-41b4-8037-afc032238a3d","name":"Lip, Gregory Y H","name_org":"Lip, Gregory Y.H.","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Torben Bjerregaard","key":"larsenpau","last":"Larsen","locid":"a3c6747f-b9db-488b-8eb9-887d38742880","name":"Larsen, Torben Bjerregaard","orcid":"0000-0002-8485-8674","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Peter Brønnum","key":"nielsenpau","last":"Nielsen","locid":"3ce5c24a-cc41-4e4c-a071-9a41f036faf8","name":"Nielsen, Peter Brønnum","orcid":"0000-0003-2922-6970","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.jacep.2020.07.005","issn":["2405500X"],"issue":"13","journal":"JACC: Clinical Electrophysiology","pages":"1672-1682","publisher":"Elsevier","status":"p","title":"JACC: Clinical Electrophysiology","volume":"6"},"review":"Peer Reviewed","scoID":["2-s2.0-85090481290"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-164d57c5-9504-48ed-bcf3-9c92a03e018b"],"src":["AAU Aalborg University"],"title":"Thromboembolic Risk in Non-Anticoagulated Patients With Atrial Fibrillation and Valvular Heart Disease","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-056599","year":"2020","yearsub":"2020"}
{"abstract":"Aims: The risks of thromboembolism and bleeding in patients with atrial fibrillation (AF) and valvular heart disease (VHD) are sparsely described. We described the risk of events in non-anticoagulated and anticoagulated patients with AF and VHD according to the evaluated heart valves, rheumatic or artificial valve classification (EHRA classification), EHRA Type 1 and Type 2 VHD, and within subgroups of EHRA Type 1 and Type 2 VHD. Methods and Results: Cohort study of AF patients with coexisting VHD, identified in nationwide Danish registries from 2000 to 2018. Risk of thromboembolism and bleeding after 1 year of follow-up were calculated in each group. We identified 28 770 incident AF patients with VHD. Not surprisingly, we observed the highest risks of thromboembolism in the non-anticoagulated AF patients with EHRA Type 1 and Type 2 VHD (4.9% vs 2.6% and 3.2% vs 1.9%) and the highest risks of bleeding in the anticoagulated AF patients with EHRA Type 1 and Type 2 VHD (6.6% vs 4.3% and 6.1% vs 4.9%). However, within the subgroups of AF patients with EHRA Type 1 and Type 2 VHD, we observed a large proportion of non-anticoagulated patients (32.9%-49.2%), despite a CHA2DS2-VASc score of 2≤ in the majority of these patients (81.9%-95.6%). Conclusions: When using data reflecting contemporary clinical practice, we observed markedly different risks of thromboembolism and bleeding in EHRA Type 1 and Type 2 VHD. Additionally, we observed a potential underuse of oral anticoagulation within the subgroups of AF patients with EHRA Type 1 and Type 2 VHD, underlining need for further attention on this patient group.","author_count":6,"contributors":["Melgaard, Line","Jensen, Martin","Overvad, Thure Filskov","Larsen, Torben Bjerregaard","Lip, Gregory Y H","Nielsen, Peter Brønnum"],"cuid":["S01-000.00-091667"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"corresponding_author":["Melgaard, Line"],"country":["United Kingdom"],"glorg":["All Global Affiliations","Liverpool Heart and Chest Hospital NHS Foundation Trust","University of Liverpool"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"thromboembolic and bleeding outcomes in patients with atrial fibrillation and valvular heart disease a descriptive nationwide cohort study","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/391896823/Thromboembolic_and_bleeding_outcomes_in_patients_with_atrial_fibrillation_and_valvular_heart_disease.pdf","version":"Authors Final Version"},"funding_acknowledgement":["Professor Lip: Consultant for Bayer/Janssen, BMS/Pfizer, Biotronik, Medtronic, Boehringer Ingelheim, Microlife and Daiichi‐Sankyo. Speaker for Bayer, BMS/Pfizer, Medtronic, Boehringer Ingelheim, Microlife, Roche and Daiichi‐Sankyo. No fees are received personally. Professor Larsen: Investigator for Janssen Scientific Affairs, LLC and Boehringer Ingelheim. Speaker for Bayer, BMS/Pfizer, Janssen Pharmaceuticals, Takeda, Roche Diagnostics and Boehringer Ingelheim. No fees are received personally. Mr Nielsen: Speaking fees Boehringer Ingelheim, consulting fees from Bayer and grant support from BMS/Pfizer. Ms Melgaard: Grant support from BMS/Pfizer. Other authors: no conflict of interest. All authors have read and approved the submitted manuscript."],"id":"S01-000.00-091667","identifier":[{"id":"85087653187","type":"scopus"},{"id":"32574395","type":"pmid"}],"ids":["aau-8f3cff2f-4e16-4c4b-b34b-bf5f92c52ce0"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-8D22BE8347B8C1AF2B70245517CFD578"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/391896823/Thromboembolic_and_bleeding_outcomes_in_patients_with_atrial_fibrillation_and_valvular_heart_disease.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Cardiology","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Anæstesi, Børn, Kredsløb og Kvinder","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine, Aalborg Thrombosis Research Unit"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"gb","key":"university of liverpool","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Liverpool","used":1},{"affno":"3","country":"gb","key":"liverpool heart and chest hospital nhs foundation trust","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Liverpool Heart and Chest Hospital NHS Foundation Trust","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Line","key":"melgaardpau","last":"Melgaard","locid":"88687b9c-5b56-4584-a89a-89fdeca4fd54","name":"Melgaard, Line","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Martin","key":"jensenpau","last":"Jensen","locid":"d5770e98-1d04-4d3b-aa8c-49c951b21eb0","name":"Jensen, Martin","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Thure F.","key":"overvadpau","last":"Overvad","locid":"63d282a2-85c6-4f40-a01b-f4cc59ec37f5","name":"Overvad, Thure Filskov","name_org":"Overvad, Thure F.","orcid":"0000-0001-8096-0236","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Torben B.","key":"larsenpau","last":"Larsen","locid":"a3c6747f-b9db-488b-8eb9-887d38742880","name":"Larsen, Torben Bjerregaard","name_org":"Larsen, Torben B.","orcid":"0000-0002-8485-8674","rank":4,"rolecode":"pau"},{"affno":"1 2 3","corresponding":null,"country":"dk","first":"Gregory Y.H.","key":"lippau","last":"Lip","locid":"8fa30e84-7381-41b4-8037-afc032238a3d","name":"Lip, Gregory Y H","name_org":"Lip, Gregory Y.H.","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Peter B.","key":"nielsenpau","last":"Nielsen","locid":"3ce5c24a-cc41-4e4c-a071-9a41f036faf8","name":"Nielsen, Peter Brønnum","name_org":"Nielsen, Peter B.","orcid":"0000-0003-2922-6970","rank":6,"rolecode":"pau"}],"pmid":["32574395"],"pub":{"doi":"10.1111/ijcp.13589","issn":["13685031","1368504X"],"issn_org":["13685031"],"issue":"10","journal":"International Journal of Clinical Practice","paperid":"e13589","publisher":"Wiley","status":"p","title":"International Journal of Clinical Practice","volume":"74"},"review":"Peer Reviewed","scoID":["2-s2.0-85087653187"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-8f3cff2f-4e16-4c4b-b34b-bf5f92c52ce0"],"src":["AAU Aalborg University"],"title":"Thromboembolic and bleeding outcomes in patients with atrial fibrillation and valvular heart disease : A descriptive nationwide cohort study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-091667","year":"2020","yearsub":"2020"}
{"abstract":"Patients with atrial fibrillation and valvular heart disease (VHD) beyond moderate-to-severe mitral stenosis and/or a mechanical prosthetic valve, so-called EHRA Type 2 VHD, have been associated with a higher risk of thromboembolism compared with patients with atrial fibrillation and no VHD. A minor but important proportion of patients with atrial fibrillation and EHRA Type 2 VHD has 0 or 1 coexisting CHA2DS2-VASc stroke risk factors, and are therefore not strongly recommended oral anticoagulant therapy according to guidelines. Whether these patients are “truly low” risk of stroke has not been investigated. We aimed to describe the risk of thromboembolism in non-anticoagulated atrial fibrillation patients with and without EHRA Type 2 VHD and with 0 or 1 non-sex comorbidity of the CHA2DS2-VASc score.Cohort study of atrial fibrillation patients with and without EHRA Type 2 VHD identified in nationwide Danish registries from 2000–2018. 1-year risk of thromboembolism was estimated for the study population divided into four subgroups in relation to non-sex CHA2DS2-VASc score comorbidities (except for previous thromboembolism) and age category (\\lt;65 or 65–74 years).We identified 1,907 and 53,707 incident atrial fibrillation patients with and without EHRA Type 2 VHD. Median age was 57 years and 55 years in patients with and without EHRA Type 2 VHD and 0 comorbidities and 67 years in patients with and without EHRA Type 2 VHD and 1 comorbidity. Percentage of females was approximately 44\\ VHD and 0 comorbidities and 33\\6\\ VHD and 1 comorbidity. In patients with 1 comorbidity, the most prevalent stroke risk factor of the CHA2DS2-VASc score was hypertension. Cumulative incidence of thromboembolism according to presence of EHRA Type 2 VHD and age category in patients with 0 or 1 non-sex comorbidity of the CHA2DS2-VASc score are presented in the figure (the curve for patients with EHRA Type 2 VHD aged 65–74 years and with 0 comorbidities was omitted due to few events). At 1 year after atrial fibrillation diagnosis, patients with and without EHRA Type 2 VHD aged \\lt;65 or 65–74 years and with 0 or 1 comorbidity of the CHA2DS2-VASc score had a risk of thromboembolism ranging 1.3–2.2\\.5–1.7\\DS2-VASc score. In patients with EHRA Type 2 VHD aged \\lt;65 years with 0 or 1 comorbidity, the risk was 1.5\\.2\\ year after the diagnosis of atrial fibrillation.In atrial fibrillation patients with EHRA Type 2 VHD, we observed a risk of thromboembolism that may exceed the level above which oral anticoagulation is considered beneficial. No trial has specifically examined patients with EHRA Type 2 VHD and low CHA2DS2-VASc scores and, therefore, our observations may be important to patients who are not recommended oral anticoagulant therapy according to contemporary guidelines.Figure 1. Cumulative incidence of thromboembolismType of funding source: Private company. Main funding source(s): The study was supported by “The BMS/Pfizer European Thrombosis Investigator Initiated Research Program (ERISTA) 2018” and the Obel Family Foundation.","author_count":6,"contributors":["Melgaard, Line","Overvad, Thure Filskov","Jensen, Martin","Lip, G.Y.H","Larsen, Torben Bjerregaard","Nielsen, Peter Brønnum"],"cuid":["S01-000.00-106757"],"event":{"end":"2020-09-01","place":"Virtuel","start":"2020-08-29","title":"ESC Congress 2020","year":"2020"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","University of Liverpool"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"thromboembolic risk in non anticoagulated atrial fibrillation patients with valvular heart disease and low cha000000000002ds000000000002 vasc scores are these patients truly low risk of stroke","src":["aau"],"src-code":["DI-U-AAU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-106757","ids":["aau-c36977f0-2c1e-414d-aad7-d3b0e14f9bd4"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-45ACE5217153EB225E4E2D089BDA99FC"],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Cardiology","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Anæstesi, Børn, Kredsløb og Kvinder","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine, Aalborg Thrombosis Research Unit"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"gb","key":"university of liverpool","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Liverpool","used":1}],"person":[{"affno":"1","corresponding":null,"first":"L","key":"melgaardpau","last":"Melgaard","locid":"88687b9c-5b56-4584-a89a-89fdeca4fd54","name":"Melgaard, Line","name_org":"Melgaard, L","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"T.F","key":"overvadpau","last":"Overvad","locid":"63d282a2-85c6-4f40-a01b-f4cc59ec37f5","name":"Overvad, Thure Filskov","name_org":"Overvad, T.F","orcid":"0000-0001-8096-0236","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"M","key":"jensenpau","last":"Jensen","locid":"d5770e98-1d04-4d3b-aa8c-49c951b21eb0","name":"Jensen, Martin","name_org":"Jensen, M","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"G.Y.H","key":"lippau","last":"Lip","name":"Lip, G.Y.H","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"T.B","key":"larsenpau","last":"Larsen","locid":"a3c6747f-b9db-488b-8eb9-887d38742880","name":"Larsen, Torben Bjerregaard","name_org":"Larsen, T.B","orcid":"0000-0002-8485-8674","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"P.B","key":"nielsenpau","last":"Nielsen","locid":"3ce5c24a-cc41-4e4c-a071-9a41f036faf8","name":"Nielsen, Peter Brønnum","name_org":"Nielsen, P.B","orcid":"0000-0003-2922-6970","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1093/ehjci/ehaa946.0516","issn":["0195668X","15229645"],"issn_org":["0195668X"],"issue":"Suppl. 2","journal":"European Heart Journal","pages":"516","paperid":"ehaa946.0516","publisher":"Oxford University Press","status":"p","title":"European Heart Journal","volume":"41"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-c36977f0-2c1e-414d-aad7-d3b0e14f9bd4"],"src":["AAU Aalborg University"],"title":"Thromboembolic risk in non-anticoagulated atrial fibrillation patients with valvular heart disease and low CHA2DS2-VASc scores : are these patients truly low risk of stroke?","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-106757","year":"2020","yearsub":"2020"}
{"author_count":3,"contributors":["Nørregaard, Marie-Louise Milvang","Staun Larsen, Line"],"cuid":["S01-000.00-131812"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Caries","Pædodonti","fluorid"],"level":"pop","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"und","rtype":["clu"],"sorti":"caries kontrol og behandlingsmuligheder i det primære tandsæt","src":["au"],"src-code":["DI-U-AU"],"type":"dba","type-grp":["all","pub"]},"id":"S01-000.00-131812","ids":["au-04672eed-7934-4b10-9f3e-3b354974530a"],"keyword":["caries","fluorid","minimal invasiv behandling","non-operativ caries kontrol","operativ caries terapi","primære tænder","pædodonti"],"lang":"Danish","level":"Popular","mra":["Medical Science"],"noi":["Global-Local-2-3-66AF2B87729AE00C0F8374D8552CC1B7"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Dentistry and Oral Health, Department of Dentistry and Oral Health - Section for Pediatric Dentistry"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Marie-Louise Milvang","key":"nørregaardpau","last":"Nørregaard","locid":"60ac237f-94c9-41ef-b27c-1f9a6f2d039e","name":"Nørregaard, Marie-Louise Milvang","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Line","key":"staunlarsenpau","last":"Staun Larsen","locid":"35e2ae60-25db-4a15-893f-dc8906e2bccf","name":"Staun Larsen, Line","orcid":"0000-0002-4155-5884","rank":2,"rolecode":"pau"},{"affno":"","first":"Palle","key":"holmstruppedh","last":"Holmstrup","name":"Holmstrup, Palle","rank":3,"role":"Editor of Ho