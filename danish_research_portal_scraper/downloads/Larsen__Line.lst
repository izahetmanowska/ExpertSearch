ions","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-91b61bbe-9d7c-425e-b9e2-8ad37e434ea6"],"src":["AU Aarhus University"],"title":"Alternative sandheder","type":"Book","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-212399","year":"2022","yearsub":"2022"}
{"abstract":"A liquid chromatography–mass spectrometry method based on multiple reaction monitoring (MRM) was developed for the simultaneous quantification of markers representing two potentially competing pathways, the Maillard reaction and the dehydroalanine pathway. The two pathways involve the same residues in the proteins to some extent, namely, the essential amino acid lysine, as well as free-amino terminals available on proteins and polypeptides, competition between the two pathways in food systems may occur. The developed method comprises the following markers of the Maillard reaction: furosine, N-ε-(carboxyethyl)lysine (CEL) and N-ε-(carboxymethyl)lysine (CML), together with the dehydroalanine reaction pathway markers; lanthionine (LAN) and lysinoalanine (LAL), as well as lysine itself. The validated method was then used for the absolute quantification of heat-induced protein modifications in model systems of micellar casein and whey protein isolates (MCI and WPI, respectively) in the presence or absence of lactose. As expected, the Maillard reaction markers furosine, CEL and CML increased during the applied heat treatment in the presence of lactose, whereas the dehydroalanine markers, LAN and LAL increased with heating in both MCI and WPI, both in the presence and absence of lactose, although at lower levels in the presence of lactose, confirming the competing state of the two pathways.","author_count":5,"contributors":["Nielsen, Søren Drud-Heydary","Knudsen, Lotte Juul","Bækgaard, Line Thunæs","Rauh, Valentin","Larsen, Lotte Bach"],"cuid":["S01-000.00-263100"],"filters":{"added":"2022-05","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Advanced glycation end products","Glycation","Milk","Multiple reaction monitoring","Processing","Protein modification"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-ARLA"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-PR-ARLA","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"influence of lactose on the maillard reaction and dehydroalanine mediated protein cross linking in casein and whey","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.3390/foods11070897","version":"Published Version"},"id":"S01-000.00-263100","identifier":[{"id":"35406984","type":"pmid"},{"id":"85127585050","type":"scopus"},{"id":"PMC8997915","type":"pmcid"}],"ids":["au-ea6312ae-d885-486e-95b5-2b33964a2cd6"],"keyword":["advanced glycation end products","glycation","milk","multiple reaction monitoring","processing","protein modification"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-A196AE75040939C7492378A253476DA1"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.3390/foods11070897","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Food Science, Department of Food Science - Food Chemistry"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"arla foods","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-ARLA","l3nl":"Arla Foods","l3nn":"Arla Foods","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Arla Foods","namevar":["Arla Foods"],"nora_code":"DI-PR-ARLA","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Søren Drud-Heydary","key":"nielsenpau","last":"Nielsen","locid":"030ede5c-2e12-40c1-9d0c-543f0c5ffadf","name":"Nielsen, Søren Drud-Heydary","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lotte Juul","key":"knudsenpau","last":"Knudsen","locid":"7ee04b01-4825-401c-93b0-64ffaa7e3452","name":"Knudsen, Lotte Juul","rank":2,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Line Thunæs","key":"bækgaardpau","last":"Bækgaard","locid":"882d0ac5-af18-405e-8ec0-09e5db71abc7","name":"Bækgaard, Line Thunæs","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Valentin","key":"rauhpau","last":"Rauh","name":"Rauh, Valentin","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lotte Bach","key":"larsenpau","last":"Larsen","locid":"204d7240-6828-4ee0-8ef5-77a4a2ac92d4","name":"Larsen, Lotte Bach","orcid":"0000-0001-9674-0107","rank":5,"rolecode":"pau"}],"pmid":["35406984"],"pub":{"doi":"10.3390/foods11070897","issn":["23048158"],"issue":"7","journal":"Foods","paperid":"897","publisher":"Multidisciplinary Digital Publishing Institute (MDPI)","status":"p","title":"Foods","volume":"11"},"review":"Peer Reviewed","scoID":["2-s2.0-85127585050"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Private Research","All Universities","Arla Foods","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Private Research","Universities"],"PST":["Published"]},"sid":["au-ea6312ae-d885-486e-95b5-2b33964a2cd6"],"src":["AU Aarhus University"],"title":"Influence of Lactose on the Maillard Reaction and Dehydroalanine-Mediated Protein Cross-Linking in Casein and Whey","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-263100","year":"2022","yearsub":"2022"}
{"abstract":"5G mobile networks are currently being deployed leading to a wide range of new opportunities for the mobile network users. This work evaluates the energy consumption in the xhaul segment of the mobile network when expanding to 5G. The mobile xhaul network divides the traditional base station functions into a threefold architecture connected by a fronthaul, midhaul and backhaul network, which together form the xhaul network. This work contributes to Radio Access Networks (RAN) design and planning by combining classical aspects for increasing capacity in a RAN with an energy consumption analysis of the xhaul network. A mathematical model is used to investigate the network behavior when looking into different levels of bandwidth, spectral efficiency and number of cells. Results show that when reaching 5G capacity levels, even though the same capacity is achieved, the fronthaul will carry four times the amount of traffic compared to the midhaul. This work provides recommendations for a more energy efficient xhaul network architecture. Focus points include; identifying the most optimal number of cells, prioritize longer midhaul transport spans over fronthaul, and when possible increase capacity by bandwidth and spectral efficiency.","author_count":4,"contributors":["Larsen, Line Maria Pyndt","Ruepp, Sarah Renée","Berger, Michael Stübert","Christiansen, Henrik Lehrmann"],"cuid":["S01-000.00-314617"],"event":{"end":"2022-06-18","place":"Bucharest, ro","start":"2022-06-16","title":"14<sup>th</sup> International Conference on Communications","year":"2022"},"filters":{"added":"2022-09","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Larsen, Line Maria Pyndt"],"keyword":["5G","C RAN","Crosshaul","Energy savings","Xhaul"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"ran design guidelines for energy efficient 000000000005g mobile xhaul networks","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85135154586","version":"Other Version"},"funding_acknowledgement":["ACKNOWLEDGMENT Financial support from the Nordic University Hub on Industrial IoT – HI2OT, NordForsk grant agreement no. 86220, is gratefully acknowledged."],"id":"S01-000.00-314617","identifier":[{"id":"85135154586","type":"scopus"}],"ids":["dtu-21c6dcaf-fb03-4748-8de5-493341ae1bf5"],"keyword":["5G","C-RAN","Crosshaul","Energy savings","Green networks.functional split","RAN design","Xhaul"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-A99E7B7005560977C59AC39904E06AAC"],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Electrical and Photonics Engineering"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Line M.P.","key":"larsenpau","last":"Larsen","locid":"e76034cd-61d0-43dd-8c6d-0aa95c672b80","name":"Larsen, Line Maria Pyndt","name_org":"Larsen, Line M.P.","orcid":"0000-0002-6402-5851","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Sarah","key":"ruepppau","last":"Ruepp","locid":"92dfeab4-28ff-437d-9f5d-e7d8d6a67b93","name":"Ruepp, Sarah Renée","name_org":"Ruepp, Sarah","orcid":"0000-0003-0205-5067","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Michael S.","key":"bergerpau","last":"Berger","locid":"7b367889-bde0-4e40-893f-0a22e4d32371","name":"Berger, Michael Stübert","name_org":"Berger, Michael S.","orcid":"0000-0003-4575-7261","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Henrik L.","key":"christiansenpau","last":"Christiansen","locid":"f3aec174-d663-4d97-aaa0-81cd6f4493a9","name":"Christiansen, Henrik Lehrmann","name_org":"Christiansen, Henrik L.","orcid":"0000-0002-9558-3493","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1109/comm54429.2022.9817244","eisbn":["9781665494854"],"publisher":"IEEE","status":"p","title":"Proceedings of 14<sup>th</sup> International Conference on Communications"},"review":"Peer Reviewed","scoID":["2-s2.0-85135154586"],"sdg":["7. Affordable and Clean Energy","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-21c6dcaf-fb03-4748-8de5-493341ae1bf5"],"src":["DTU Technical University of Denmark"],"title":"RAN Design Guidelines for Energy Efficient 5G Mobile Xhaul Networks","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-314617","year":"2022","yearsub":"2022"}
{"abstract":"This work identifies and addresses current challenges and shortcomings arising in deployment and expansions of today’s mobile networks, in order to determine the future of the Cloud-Radio Access Network (C-RAN) architecture. C-RAN proposes a three-fold RAN architecture, improving the flexibility, energy efficiency and performance of the RAN. On the other hand, C-RAN requires a division of the base station functionalities resulting in very high requirements to the interconnecting transport network, the xhaul. C-RAN has been promoted as the network architecture for 5G and future mobile networks; however, it has not yet been adopted by the majority of network operators. This work studies existing deployment scenarios and evaluates deployment opportunities for green- and brownfield installations in rural, urban, high mobility and latency sensitive areas. The studies are backed up by examinations of real-life network traffic, predicting that in a group of cells covering multiple different areas, C-RAN will improve network resource utilisation by a factor > 2. The outcome of this work results in a set of concrete deployment guidelines for the introduction of C-RAN in brownfield network installations and future greenfield installations. The deployment guidelines include functional divisions of the RAN, functional placement scenarios and xhaul network requirements.","author_count":4,"contributors":["Larsen, Line Maria Pyndt","Christiansen, Henrik Lehrmann","Ruepp, Sarah Renée","Berger, Michael Stübert"],"cuid":["S01-000.00-330957"],"event":{"end":"2022-11-10","place":"Paris, fr","start":"2022-11-07","title":"11<sup>th</sup> IEEE International Conference on Cloud Networking","year":"2022"},"filters":{"added":"2023-02","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["5G mobile communication","Base stations","Costs","Energy efficiency","Network architecture","Telecommunication traffic","Urban areas"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"deployment guidelines for cloud ran in future mobile networks","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85146121908","version":"Other Version"},"id":"S01-000.00-330957","identifier":[{"id":"85146121908","type":"scopus"}],"ids":["dtu-58c8e1bf-276b-4e8a-bd97-8ab9d21d4b59"],"keyword":["5G mobile communication","Base stations","Costs","Energy efficiency","Network architecture","Telecommunication traffic","Urban areas"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-D0FB0A8201BD46E58182C96B2F0E4D96"],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Electrical and Photonics Engineering","Technical University of Denmark, Department of Photonics Engineering, Networks Technology and Service Platforms"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Line M. P.","key":"larsenpau","last":"Larsen","locid":"e76034cd-61d0-43dd-8c6d-0aa95c672b80","name":"Larsen, Line Maria Pyndt","name_org":"Larsen, Line M. P.","orcid":"0000-0002-6402-5851","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Henrik L.","key":"christiansenpau","last":"Christiansen","locid":"f3aec174-d663-4d97-aaa0-81cd6f4493a9","name":"Christiansen, Henrik Lehrmann","name_org":"Christiansen, Henrik L.","orcid":"0000-0002-9558-3493","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Sarah","key":"ruepppau","last":"Ruepp","locid":"92dfeab4-28ff-437d-9f5d-e7d8d6a67b93","name":"Ruepp, Sarah Renée","name_org":"Ruepp, Sarah","orcid":"0000-0003-0205-5067","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Michael S.","key":"bergerpau","last":"Berger","locid":"7b367889-bde0-4e40-893f-0a22e4d32371","name":"Berger, Michael Stübert","name_org":"Berger, Michael S.","orcid":"0000-0003-4575-7261","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1109/cloudnet55617.2022.9978902","isbn":["9781665486286"],"pages":"141-149","publisher":"IEEE","status":"p","title":"Proceedings of 11<sup>th</sup> International Conference on Cloud Networking"},"review":"Peer Reviewed","scoID":["2-s2.0-85146121908"],"sdg":["7. Affordable and Clean Energy","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-58c8e1bf-276b-4e8a-bd97-8ab9d21d4b59"],"src":["DTU Technical University of Denmark"],"title":"Deployment Guidelines for Cloud-RAN in Future Mobile Networks","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-330957","year":"2022","yearsub":"2022"}
{"abstract":"We compare the application of different modeling strategies in order to predict physical properties of five different industrial pectin formulations based on near-infrared spectral data. Methods from the chemometric toolbox, such as partial least squares regression (PLS1 and PLS2) and ridge regression, were employed and compared to the performance of a 1-D convolutional neural network (CNN). The pectin formulations were modeled in two major scenarios, individually using local models, and jointly using global models, which resulted in better prediction performance of the 1-D CNN.","author_count":7,"contributors":["Einarson, Kasper Alnor","Baum, Andreas","Olsen, Terkel B.","Larsen, Jan","Armagan, Ibrahim","Santacoloma, Paloma A.","Clemmensen, Line Katrine Harder"],"cuid":["S01-000.00-378323"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","OECD"],"corresponding_author":["Baum, Andreas"],"country":["United States"],"glorg":["All Global Affiliations","CP Kelco"],"keyword":["Convolutional neural networks","Deep learning","Multivariate data analysis","Process monitoring","Spectroscopy"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"predicting pectin performance strength using near infrared spectroscopic data a comparative evaluation of 000000000001 d convolutional neural network partial least squares and ridge regression modeling","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85106337521","version":"Other Version"},"id":"S01-000.00-378323","identifier":[{"id":"85106337521","type":"scopus"}],"ids":["dtu-f6920078-7754-4f53-9d20-68eb8528721f"],"keyword":["Convolutional neural networks","Deep learning","Multivariate data analysis","Process monitoring","Spectroscopy"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-39E59E2A6B23E0A4210C704FA1579794"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Applied Mathematics and Computer Science","Technical University of Denmark, Department of Applied Mathematics and Computer Science, Statistics and Data Analysis"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"us","key":"cp kelco","loc":["United States","America, North","OECD"],"name":"CP Kelco","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Kasper A.","key":"einarsonpau","last":"Einarson","locid":"217a98f9-2395-4587-9c3a-d4adeeab2a46","name":"Einarson, Kasper Alnor","name_org":"Einarson, Kasper A.","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Andreas","key":"baumpau","last":"Baum","locid":"adc22cdd-69ad-467f-9ae5-97e0770a4b3b","name":"Baum, Andreas","orcid":"0000-0003-1552-0220","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Terkel B.","key":"olsenpau","last":"Olsen","name":"Olsen, Terkel B.","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jan","key":"larsenpau","last":"Larsen","name":"Larsen, Jan","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ibrahim","key":"armaganpau","last":"Armagan","name":"Armagan, Ibrahim","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Paloma A.","key":"santacolomapau","last":"Santacoloma","name":"Santacoloma, Paloma A.","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Line K.H.","key":"clemmensenpau","last":"Clemmensen","locid":"4e7ff76e-13f9-4365-83b1-d10bab96517b","name":"Clemmensen, Line Katrine Harder","name_org":"Clemmensen, Line K.H.","orcid":"0000-0001-5527-5798","rank":7,"rolecode":"pau"}],"pub":{"doi":"10.1002/cem.3348","issn":["08869383","1099128X"],"issn_org":["08869383"],"issue":"2","journal":"Journal of Chemometrics","paperid":"e3348","publisher":"John Wiley & Sons Ltd","status":"p","title":"Journal of Chemometrics","volume":"36"},"review":"Peer Reviewed","scoID":["2-s2.0-85106337521"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-f6920078-7754-4f53-9d20-68eb8528721f"],"src":["DTU Technical University of Denmark"],"title":"Predicting pectin performance strength using near-infrared spectroscopic data : A comparative evaluation of 1-D convolutional neural network, partial least squares, and ridge regression modeling","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-378323","year":"2022","yearsub":"2022"}
{"abstract":"Experimental and clinical data suggest that a gluten-free diet attenuates the development of type 1 diabetes. A gluten-free diet changes the gut microbiota composition, and such microbial changes are expected to reduce the autoimmune responses. However, in experiments with laboratory mice, a gluten-free diet changes the gut microbiota differently under varying experimental settings, questioning the specific role of the gut microbes. Here we show that a maternal gluten-free diet until weaning of their pups, delayed type 1 diabetes in both dams (parent generation) and offspring (F1 generation) of untreated non-obese diabetic (NOD) mice and in mice treated with a full cocktail of antibiotics that eradicates most of the existing microbiota. Breeding a second (F2) generation of NOD mice, never exposed to the gluten-free diet or the associated microbial changes, also demonstrated a preventative effect on type 1 diabetes even though their parents (the F1 generation) had only been on a gluten-free diet very early in life. Collectively, the experimental data, thus, points towards microbiota-independent dietary protection. Furthermore, both the perinatal gluten-free diet and antibiotic treatment reduced inflammation in the salivary glands and improved glucose challenged beta cell function in the F1 offspring. However, in contrast to the autoimmune response in the pancreas, those changes appeared to be microbiota dependent, as they were missing in the antibiotic treated mice, and do, therefore, not seem to be related to the preventative effect on type 1 diabetes. Interestingly, adoptive transfer of splenocytes from gluten-free fed mice protected NOD.SCID mice from developing diabetes, demonstrating that the anti-diabetic effect of a gluten-free diet was based on early life changes in the evolving immune system. In particular, genes involved in regulation of lymphocyte activation, proliferation, and cell adhesion were highly expressed in the spleen in gluten-free fed mice at weaning compared to control fed mice of the F1 generation, which suggested that gluten promotes autoimmunity by inhibiting immune regulation, though the involvement of the specific genes needs further investigation. In conclusion, gluten-free diet reduces autoimmune inflammation in salivary glands and pancreas in NOD mice in a microbiota-dependent and –independent manner respectively, and has preventative effect on type 1 diabetes by modulating the systemic immune system.","author_count":11,"contributors":["Hansen, Camilla Hartmann Friis","Larsen, Christian Schiøth","Zachariassen, Line F.","Mentzel, Caroline M. Junker","Laigaard, Ann","Krych, Lukasz","Nielsen, Dennis Sandris","Gobbi, Alex","Haupt-Jorgensen, Martin","Buschard, Karsten","Hansen, Axel Kornerup"],"cuid":["S01-000.00-397560"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Epigenetics","Gluten free diet","Gut microbiota","Immune regulation","NOD mice","Type 1 diabetes"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"gluten free diet reduces autoimmune diabetes mellitus in mice across multiple generations in a microbiota independent manner","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-397560","identifier":[{"id":"35101708","type":"pmid"},{"id":"85123638808","type":"scopus"},{"id":"000798049300001","type":"wos"}],"ids":["ku-06d0e08f-377a-4e54-8d24-06e364e8421c"],"keyword":["Epigenetics","Gluten-free diet","Gut microbiota","Immune regulation","NOD mice","Type 1 diabetes"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-4EA71974C5B80AB6D102412F4B71FB5C"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Veterinary and Animal Sciences, Preclinical Disease Biology"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","first":"Camilla H.F.","key":"hansencamillahartmannfriispau","last":"Hansen","locid":"d7f25dbd-3efc-483b-9805-8909e9597652","name":"Hansen, Camilla Hartmann Friis","name_org":"Hansen, Camilla H.F.","orcid":"0000-0002-1860-385X","rank":1,"rolecode":"pau"},{"affno":"1","first":"Christian S.","key":"larsenchristianschiøthpau","last":"Larsen","locid":"48a39b03-cb85-4871-ad38-cb43987be59c","name":"Larsen, Christian Schiøth","name_org":"Larsen, Christian S.","rank":2,"rolecode":"pau"},{"affno":"1","first":"Line F.","key":"zachariassenlinefpau","last":"Zachariassen","locid":"cdafe75d-cfc9-4fca-adfe-20ae0c542b57","name":"Zachariassen, Line F.","orcid":"0000-0001-5425-9841","rank":3,"rolecode":"pau"},{"affno":"1","first":"Caroline M.J.","key":"mentzelcarolinemjunkerpau","last":"Mentzel","locid":"2f4bbdfb-bd14-4dc0-9280-4acf3c694239","name":"Mentzel, Caroline M. Junker","name_org":"Mentzel, Caroline M.J.","orcid":"0000-0003-4688-7367","rank":4,"rolecode":"pau"},{"affno":"1","first":"Ann","key":"laigaardannpau","last":"Laigaard","locid":"1333015e-a5a0-4fbb-9e8b-6974cf20b1c6","name":"Laigaard, Ann","rank":5,"rolecode":"pau"},{"affno":"1","first":"Lukasz","key":"krychlukaszpau","last":"Krych","locid":"a9463259-048d-4fd6-8218-dde9fb94c96b","name":"Krych, Lukasz","orcid":"0000-0003-3224-1346","rank":6,"rolecode":"pau"},{"affno":"1","first":"Dennis S.","key":"nielsendennissandrispau","last":"Nielsen","locid":"08539a0e-05f4-454e-ad2a-de195363dbd1","name":"Nielsen, Dennis Sandris","name_org":"Nielsen, Dennis S.","orcid":"0000-0001-8121-1114","rank":7,"rolecode":"pau"},{"affno":"1","first":"Alex","key":"gobbialexpau","last":"Gobbi","locid":"d75f223f-acb8-47fc-8f40-5aa4a8fed00b","name":"Gobbi, Alex","orcid":"0000-0003-3541-4732","rank":8,"rolecode":"pau"},{"affno":"2","first":"Martin","key":"hauptjorgensenmartinpau","last":"Haupt-Jorgensen","name":"Haupt-Jorgensen, Martin","rank":9,"rolecode":"pau"},{"affno":"2","first":"Karsten","key":"buschardkarstenpau","last":"Buschard","name":"Buschard, Karsten","rank":10,"rolecode":"pau"},{"affno":"1","first":"Axel K.","key":"hansenaxelkorneruppau","last":"Hansen","locid":"ecc439ea-5c9b-4e25-814a-3ee8960bc0d0","name":"Hansen, Axel Kornerup","name_org":"Hansen, Axel K.","orcid":"0000-0003-1575-2507","rank":11,"rolecode":"pau"}],"pmid":["35101708"],"pub":{"doi":"10.1016/j.jaut.2022.102795","issn":["08968411","10959157"],"issn_org":["08968411"],"journal":"Journal of Autoimmunity","paperid":"102795","status":"p","title":"Journal of Autoimmunity","volume":"127"},"review":"Peer Reviewed","scoID":["2-s2.0-85123638808"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-06d0e08f-377a-4e54-8d24-06e364e8421c"],"src":["KU University of Copenhagen"],"title":"Gluten-free diet reduces autoimmune diabetes mellitus in mice across multiple generations in a microbiota-independent manner","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-397560","year":"2022","yearsub":"2022"}
{"abstract":"Solid tumors comprise two major components: the cancer cells and the tumor stroma. The stroma is a mixture of cellular and acellular components including fibroblasts, mesenchymal and cancer stem cells, endothelial cells, immune cells, extracellular matrix, and tumor interstitial fluid. The insufficient tumor perfusion and the highly proliferative state and dysregulated metabolism of the cancer cells collectively create a physicochemical microenvironment characterized by altered nutrient concentrations and varying degrees of hypoxia and acidosis. Furthermore, both cancer and stromal cells secrete numerous growth factors, cytokines, and extracellular matrix proteins which further shape the tumor microenvironment (TME), favoring cancer progression. Transport proteins expressed by cancer and stromal cells localize at the interface between the cells and the TME and are in a reciprocal relationship with it, as both sensors and modulators of TME properties. It has been amply demonstrated how acid-base and nutrient transporters of cancer cells enable their growth, presumably by contributing both to the extracellular acidosis and the exchange of metabolic substrates and waste products between cells and TME. However, the TME also impacts other transport proteins important for cancer progression, such as multidrug resistance proteins. In this review, we summarize current knowledge of the cellular and acellular components of solid tumors and their interrelationship with key ion transport proteins. We focus in particular on acid-base transport proteins with known or proposed roles in cancer development, and we discuss their relevance for novel therapeutic strategies.","author_count":6,"contributors":["Elingaard-Larsen, Line O.","Rolver, Michala G.","Sørensen, Ester E.","Pedersen, Stine Helene Falsig"],"cuid":["S01-000.00-421026"],"filters":{"added":"2022-07","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Acidosis","Hypoxia","Lactate","Monocarboxylate transporters","Na H exchange","Tumor heterogeneity","Tumor stroma"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Steno Diabetes Centre, Gentofte, Denmark."],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"how reciprocal interactions between the tumor microenvironment and ion transport proteins drive cancer progression","src":["ku"],"src-code":["DI-U-KU"],"type":"dba","type-grp":["all","pub"]},"id":"S01-000.00-421026","identifier":[{"id":"32737753","type":"pmid"},{"id":"85129168408","type":"scopus"}],"ids":["ku-2e495fb5-3202-48d4-a129-006200764a33"],"keyword":["Acidosis","Hypoxia","Lactate","Monocarboxylate transporters","Na/H exchange","Na/HCO cotransport","Tumor heterogeneity","Tumor stroma","V-type ATPases","pH regulatory transporters"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-AD967C916EE58F6B5701BC77B8D2F575"],"org":[{"affno":"1","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Steno Diabetes Centre, Gentofte, Denmark."],"nora_code":"DI-OT","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Biology, Cell Biology and Physiology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Line O.","key":"elingaardlarsenpau","last":"Elingaard-Larsen","name":"Elingaard-Larsen, Line O.","rank":1,"rolecode":"pau"},{"affno":"2","first":"Michala G.","key":"rolverpau","last":"Rolver","locid":"e61a699a-cf7a-479e-8cf1-9fd071540db0","name":"Rolver, Michala G.","rank":2,"rolecode":"pau"},{"affno":"2","first":"Ester E.","key":"sørensenpau","last":"Sørensen","name":"Sørensen, Ester E.","rank":3,"rolecode":"pau"},{"affno":"2","first":"Stine F.","key":"pedersenpau","last":"Pedersen","locid":"1d5a844a-2526-46ea-9662-94eccb5854ea","name":"Pedersen, Stine Helene Falsig","name_org":"Pedersen, Stine F.","orcid":"0000-0002-3044-7714","rank":4,"rolecode":"pau"},{"affno":"","first":"Christian","key":"stockpedh","last":"Stock","name":"Stock, Christian","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Luis A.","key":"pardopedh","last":"Pardo","name":"Pardo, Luis A.","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"}],"pmid":["32737753"],"pub":{"doi":"10.1007/112_2020_23","eisbn":["9783030998004"],"isbn":["9783030997991"],"issn":["03034240"],"pages":"1-38","publisher":"Springer","series":"Reviews of Physiology, Biochemistry and Pharmacology","status":"p","subtitle":"Ion Transport in Tumor Biology","title":"From Malignant Transformation to Metastasis"},"review":"Peer Reviewed","scoID":["2-s2.0-85129168408"],"search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-2e495fb5-3202-48d4-a129-006200764a33"],"src":["KU University of Copenhagen"],"title":"How Reciprocal Interactions Between the Tumor Microenvironment and Ion Transport Proteins Drive Cancer Progression","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-421026","year":"2022","yearsub":"2022"}
{"abstract":"Aims: To investigate whether the association between levels of medication use (including polypharmacy and potentially inappropriate medications [PIMs]) and health outcomes such as readmission and mortality is dependent on baseline soluble urokinase plasminogen activator receptor (suPAR). Methods: This registry-based cohort study included medical patients admitted to the emergency department at Copenhagen University Hospital Hvidovre, Denmark. Patients were grouped according to their admission suPAR levels: low (0–3 ng/mL), intermediate (3–6 ng/mL), or high (>6 ng/mL). Hyper-polypharmacy was defined as ≥10 prescribed medications. PIMs were identified based on the EU(7)-PIM list, and data on admissions and mortality were obtained from national registries. Risk of 90-day readmission and mortality was assessed by Cox regression analysis adjusted for sex, age and Charlson comorbidity index. Results were reported as hazard ratios within 90 days of index discharge. Results: In total, 26 291 patients (median age 57.3 y; 52.7% female) were included. Risk of 90-day readmission and mortality increased significantly for patients with higher suPAR or higher number of medications. Among patients with low suPAR, patients with ≥10 prescribed medications had a hazard ratio of 2.41 (95% confidence interval = 2.09–2.78) for 90-day readmission and 8.46 (95% confidence interval = 2.53–28.28) for 90-day mortality compared to patients with 0 medications. Patients with high suPAR generally had high risk of readmission and mortality, and the impact of medication use was less pronounced in this group. Similar, but weaker, association patterns were observed between suPAR and PIMs. Conclusion: The association between levels of medication use and health outcomes is dependent on baseline suPAR.","author_count":9,"contributors":["Bengaard, Anne Kathrine","Iversen, Esben","Kallemose, Thomas","Juul-Larsen, Helle Gybel","Rasmussen, Line Jee Hartmann","Dalhoff, Kim","Andersen, Ove","Eugen-Olsen, Jesper","Houlind, Morten Baltzer"],"cuid":["S01-000.00-510970"],"filters":{"added":"2022-08","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","Duke University","Icahn School of Medicine at Mount Sinai"],"keyword":["Acute care","Biomarker","Clinical pharmacy","Emergency department","Geriatric","Medication Errors","Medication review","Older","Polypharmacy","Potentially inappropriate medication","Soluble urokinase plasminogen activator receptor"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"OT":["Copenhagen University Hospital – The Hospital Pharmacy"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"using soluble urokinase plasminogen activator receptor to stratify patients for medication review in the emergency department","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-510970","identifier":[{"id":"34242432","type":"pmid"},{"id":"85111670741","type":"scopus"}],"ids":["ku-c4f1b211-3277-442e-bb70-7aa752ccd4ad"],"keyword":["acute care","biomarker","clinical pharmacy","emergency department","geriatric","medication errors","medication review","older","polypharmacy","potentially inappropriate medication","soluble urokinase plasminogen activator receptor"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-B1702A207937DB3BA3F73B0C75DE544C"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","