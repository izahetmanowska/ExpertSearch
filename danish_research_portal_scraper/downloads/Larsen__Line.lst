-4751","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders","key":"larrabeesonderlundanderspau","last":"Sønderlund","locid":"052e950e-ab44-4d41-869d-4a3d4a37c62e","name":"Larrabee Sonderlund, Anders","name_org":"Sønderlund, Anders","orcid":"0000-0002-6627-3322","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens","key":"søndergaardjenspau","last":"Søndergaard","locid":"4829db0c-8486-4ad1-8e6b-d4f3dc56c386","name":"Søndergaard, Jens","orcid":"0000-0002-1629-1864","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Janus Laust","key":"thomsenjanuslaustpau","last":"Thomsen","locid":"109619c5-41c7-4049-897f-5d6f92e4fe12","name":"Thomsen, Janus Laust","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Anders","key":"hallinganderspau","last":"Halling","name":"Halling, Anders","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Niels Christian","key":"hvidtnielschristianpau","last":"Hvidt","locid":"13b593c4-9280-4cef-aafc-8b3cd6b7c659","name":"Hvidt, Niels Christian","orcid":"0000-0002-6311-9784","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Elisabeth","key":"assinghvidtelisabethpau","last":"Assing Hvidt","locid":"8c678f9e-b6bc-401c-b9ca-561b04c3ec2b","name":"Assing Hvidt, Elisabeth","orcid":"0000-0003-3762-8478","rank":7,"rolecode":"pau"},{"affno":"3","country":"dk","first":"Troels Sune","key":"mønstedtroelssunepau","last":"Mønsted","locid":"071095b3-eea1-4f6b-be40-2a48bdd16347","name":"Mønsted, Troels Sune","rank":8,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Troels","key":"mønstedtroelspau","last":"Mønsted","name":"Mønsted, Troels","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Line Bjørnskov","key":"pedersenlinebjørnskovpau","last":"Pedersen","locid":"b2346680-b60a-41e8-9332-304171fab9be","name":"Pedersen, Line Bjørnskov","orcid":"0000-0001-6804-2045","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ewa M.","key":"roosewampau","last":"Roos","locid":"8254d823-4e0f-4975-a194-17d7103f5edb","name":"Roos, Ewa M.","orcid":"0000-0001-5425-2199","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Pia Vivian","key":"pedersenpiavivianpau","last":"Pedersen","locid":"9ea8e437-355d-4334-abcd-73ac7c03a6a4","name":"Pedersen, Pia Vivian","orcid":"0000-0002-4560-4727","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Trine","key":"thilsingtrinepau","last":"Thilsing","locid":"6ae25242-1e96-48cf-ab01-cbac26690f6b","name":"Thilsing, Trine","orcid":"0000-0002-2041-2219","rank":12,"rolecode":"pau"}],"pmid":["30031380"],"pub":{"doi":"10.1186/s12875-018-0820-8","issn":["14712296"],"journal":"BMC Family Practice","pages":"124","paperid":"124","publisher":"BioMed Central","status":"p","title":"BMC Family Practice","volume":"19"},"review":"Peer Reviewed","scoID":["2-s2.0-85050496279"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Roskilde University","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["ruc-ce447db0-d91c-4356-af23-711f3075fd37","sdu-91528913-a85d-4680-a2f6-1df074200684"],"src":["RUC Roskilde University","SDU University of Southern Denmark"],"title":"Targeted prevention in primary care aimed at lifestyle-related diseases : a study protocol for a non-randomised pilot study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-096.63-048404","year":"2018","yearsub":"2018"}
{"abstract":"Laccases (EC 1.10.3.2) catalyze oxidation of phenolic groups in lignin to phenoxyl radicals during reduction of O2 to H2O. Here, we examine the influence on this radical formation of mediators which are presumed to act by shuttling electrons between the laccase and the subunits in lignin that the enzyme cannot approach directly. Treatments of three different lignins with laccase-mediator-systems (LMS) including laccases derived from Trametes versicolor and Myceliophthora thermophila, respectively, and four individual mediators, 1-hydroxybenzotriazole (HBT), N-hydroxyphthalimide (HPI), 2,2,6,6-tetramethylpiperidin-1-yloxy (TEMPO), and 2,2′-azino-bis(3-ethylbenzothiazoline-6-sulphonic acid) (ABTS) were assessed by real time electron paramagnetic resonance measurements. Radical steady state concentrations and radical formation rates were quantified. LMS treatments with 500 μM N-OH type mediators (HPI or HBT) did not affect the lignin radical formation, but increased doses of those mediators (5 mM) surprisingly led to significantly decreased radical formation rates and lowered steady state radical concentrations. Laccase-TEMPO treatment at a 5 mM mediator dose was the only system that significantly increased steady state radical concentration and rate of radical formation in beech organosolv lignin. The data suggest that electron shuttling by mediators is not a significant general mechanism for enhancing laccase catalyzed oxidation of biorefinery lignin substrates, and the results thus provide a new view on laccase catalyzed lignin modification.","author_count":3,"contributors":["Munk, Line","Andersen, Mogens Larsen","Meyer, Anne S."],"cuid":["S02-100.00-036986"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"corresponding_author":["Meyer, Anne S."],"keyword":["ABTS","Electron paramagnetic resonance EPR","HBT","HPI","Laccase mediator systems","Myceliophthora thermophila","Tempo","Trametes versicolor"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"influence of mediators on laccase catalyzed radical formation in lignin","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.enzmictec.2018.05.009","version":"Published Version"},"funding_acknowledgement":["This study was partially supported by the Innovation Fund Denmark via the Technology Platform Biomass for the 21 st century – B21 st and the BioValue SPIR Platform for Innovation and Research on Value Added Products from Biomass, case no: 0603–00522B. We also thank University of Hamburg, Germany for kindly donating beech organosolv lignin and Novozymes (Bagsværd, Denmark) for donating the Myceliophthora thermophila laccase."],"id":"S02-100.00-036986","identifier":[{"id":"29887016","type":"pmid"},{"id":"000438662300007","type":"wos"},{"id":"85047404099","type":"scopus"}],"ids":["dtu-c1ef18ee-c842-442b-a3e1-fcd343b715c5","ku-b2b87dbc-ddd0-4b63-b7c3-6cad9d239057"],"keyword":["ABTS","Electron paramagnetic resonance (EPR)","HBT","HPI","Laccase-mediator systems","Myceliophthora thermophila","TEMPO","Trametes versicolor"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-F15CB71EC6B02C1D3D3779B427D13AE0"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/148951686/1_s2.0_S0141022918300516_main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.enzmictec.2018.05.009","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/200820910/Influence_of_mediators_on_laccase_catalyzed_radical_formation_in_lignin.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Chemical and Biochemical Engineering","Technical University of Denmark, Department of Chemical and Biochemical Engineering, Center for BioProcess Engineering"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Food Science, Ingredient and Dairy Technology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Line","key":"munkpau","last":"Munk","locid":"9378dbfe-4f2f-4c72-9501-ada5d67f2ce3","name":"Munk, Line","orcid":"0000-0002-4820-5000","rank":1,"rolecode":"pau"},{"affno":"2","first":"Mogens Larsen","key":"andersenpau","last":"Andersen","locid":"cb1b131f-69dc-46eb-bb7a-5d0161d84ab5","name":"Andersen, Mogens Larsen","orcid":"0000-0003-4694-486X","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anne S.","key":"meyerpau","last":"Meyer","locid":"1e9f4759-72d8-4d52-94ec-ce192ffca184","name":"Meyer, Anne S.","orcid":"0000-0001-8910-9931","rank":3,"rolecode":"pau"}],"pmid":["29887016"],"pub":{"doi":"10.1016/j.enzmictec.2018.05.009","issn":["01410229","18790909"],"issn_org":["01410229"],"journal":"Enzyme and Microbial Technology","pages":"48-56","publisher":"Elsevier","status":"p","title":"Enzyme and Microbial Technology","volume":"116"},"review":"Peer Reviewed","scoID":["2-s2.0-85047404099"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-c1ef18ee-c842-442b-a3e1-fcd343b715c5","ku-b2b87dbc-ddd0-4b63-b7c3-6cad9d239057"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Influence of mediators on laccase catalyzed radical formation in lignin","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-036986","year":"2018","yearsub":"2018"}
{"abstract":"AIMS: The aim of this study was to assess the prognostic value of chronic kidney disease (CKD) in relation to ischaemic stroke, intracranial haemorrhage, major bleeding, and all-cause death in heart failure patients without atrial fibrillation. METHODS AND RESULTS: In this observational cohort study, heart failure patients without atrial fibrillation were identified using Danish nationwide registries. Risk of stroke, major haemorrhage, and death were calculated after 1 and 5 years to compare patients with and without CKD, ±dialysis [dialysis: CKD with renal replacement therapy (CKD-RRT); no dialysis: CKD-no RRT]. A total of 43 199 heart failure patients were included, among which 0.8% had CKD-RRT and 5.9% had CKD-no RRT. When compared with heart failure patients without CKD, both CKD-RRT and CKD-no RRT were associated with a higher 5 year rate of major bleeding (CKD-RRT: adjusted hazard ratio (aHR): 2.91, 95% confidence interval (CI): 2.29 to 3.70; CKD-no RRT: aHR: 1.28, 95% CI: 1.13 to 1.45) and all-cause death (CKD-RRT: aHR: 2.40, 95% CI: 2.07 to 2.77; CKD-no RRT: aHR: 1.63, 95% CI: 1.55 to 1.73). For the endpoints of ischaemic stroke and intracranial bleeding, only CKD-no RRT was associated with significantly higher 5 year rates (ischaemic stroke: aHR: 1.31, 95% CI: 1.13 to 1.52; intracranial haemorrhage: aHR: 1.66, 95% CI: 1.04 to 2.65). CONCLUSIONS: Compared with patients without CKD, among incident heart failure patients without atrial fibrillation, CKD both with and without dialysis was associated with a higher rate of major bleeding and all-cause death. Only CKD-no RRT was associated with a higher rate of ischaemic stroke and intracranial bleeding.","author_count":6,"contributors":["Melgaard, Line","Overvad, Thure Filskov","Skjøth, Flemming","Christensen, Jeppe Hagstrup","Larsen, Torben Bjerregaard","Lip, Gregory Y H"],"cuid":["S01-000.00-064612"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","University of Birmingham"],"keyword":["Bleeding","Chronic kidney disease","Heart failure","Mortality","Stroke"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"risk of stroke and bleeding in patients with heart failure and chronic kidney disease a nationwide cohort study","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.1002/ehf2.12256","version":"Published Version"},"id":"S01-000.00-064612","identifier":[{"id":"85052838375","type":"scopus"},{"id":"000428992300013","type":"wos"},{"id":"29383860","type":"pmid"}],"ids":["aau-32498a16-2d2e-421e-9288-8b39869c1a53"],"keyword":["Bleeding","Chronic kidney disease","Heart failure","Mortality","Stroke"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-8DB11531A4B06F5C086C62E9782A07A3"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.1002/ehf2.12256","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/280038760/Risk_of_stroke.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine, Aalborg Thro