Susanne","orcid":"0000-0002-8187-365X","rank":5,"rolecode":"pau"},{"affno":"3","first":"Ove","key":"andersenpau","last":"Andersen","locid":"251ac7c3-391a-4cd6-8696-6d5f1ee26911","name":"Andersen, Ove","orcid":"0000-0002-2274-548X","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anton","key":"pottegårdpau","last":"Pottegård","locid":"addfc2c1-4fc9-44cd-8087-bce3bc986652","name":"Pottegård, Anton","orcid":"0000-0001-9314-5679","rank":7,"rolecode":"pau"},{"affno":"3","first":"Janne","key":"petersenpau","last":"Petersen","locid":"1cb72724-54f8-4ca1-a201-bfa4a354a129","name":"Petersen, Janne","rank":8,"rolecode":"pau"}],"pmid":["30949726"],"pub":{"doi":"10.1007/s00228-019-02669-2","issn":["00316970","14321041"],"issn_org":["00316970"],"issue":"8","journal":"European Journal of Clinical Pharmacology","pages":"1125-1133","publisher":"Springer Science+Business Media","status":"p","title":"European Journal of Clinical Pharmacology","volume":"75"},"review":"Peer Reviewed","scoID":["2-s2.0-85064515366"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-a2553b70-9560-4e1a-bd6d-0eb1467c4f47","sdu-02c7e786-099a-490c-a3ac-61c61d87e07e"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Use of prescription drugs in the older adult population - a nationwide pharmacoepidemiological study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-044930","year":"2019","yearsub":"2019"}
{"abstract":"Efter lukningen af tre sproguddannelser på Aalborg Universitet har politikerne taget endnu et skridt i retning af en ødelæggelse af den humanistiske forskning, som er en kerne i dansk demokrati og kultur.","author_count":8,"contributors":["Hansen, Kim Toft","Sandst, Line","Lindegaard, Laura Bang","Jørgensen, Jens Lohfert","Larsen, Peter Stein","Back, Tobias Boelt","Jacobsen, Louise Brix","Mønster, Louise"],"cuid":["S01-000.00-062049"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Forskning"],"level":"pop","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"und","rtype":["clu"],"sorti":"politikerne er ved at kvæle vidensdanmark","src":["aau"],"src-code":["DI-U-AAU"],"type":"dna","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://jyllands-posten.dk/debat/kronik/ECE11794403/politikerne-er-ved-at-kvaele-vidensdanmark/","version":"Published Version"},"id":"S01-000.00-062049","ids":["aau-298188b2-5a5b-421d-8ab1-27765b3e4409"],"keyword":["Humanioria","forskning","sproguddannelser","uddannelsesbesparelser"],"lang":"Danish","level":"Popular","mra":["Humanities"],"noi":["Local-1-1-0E831C589FF925C3224970005FAA58AC"],"oa_link":[{"access":"oa","type":"rem","url":"https://jyllands-posten.dk/debat/kronik/ECE11794403/politikerne-er-ved-at-kvaele-vidensdanmark/","version":"Published Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Humanities","Aalborg University, The Faculty of Humanities, Department of Culture and Global Studies (CL)","Aalborg University, The Faculty of Humanities, Department of Culture and Global Studies (CL), IRGiC - The Interdisciplinary Research Group in Culture (CGS)","Aalborg University, The Faculty of Humanities, Department of Culture and Global Studies (CL), Interdisciplinær Medieforskning (CGS)"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Kim Toft","key":"hansenpau","last":"Hansen","locid":"567ec1fd-ed4d-4154-bc84-15920ae7bca1","name":"Hansen, Kim Toft","orcid":"0000-0002-1557-4475","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Line","key":"sandstpau","last":"Sandst","locid":"5ef3c95c-fc16-4aab-beb1-8c13c6b6b053","name":"Sandst, Line","orcid":"0000-0002-9330-0322","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Laura Bang","key":"lindegaardpau","last":"Lindegaard","locid":"3fa7e939-7bf3-4072-bd15-fa6a583bb146","name":"Lindegaard, Laura Bang","orcid":"0000-0002-1563-7077","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens Lohfert","key":"jørgensenpau","last":"Jørgensen","locid":"5998e517-744d-4f84-a067-684c61abd4c2","name":"Jørgensen, Jens Lohfert","orcid":"0000-0003-3542-9352","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Peter Stein","key":"larsenpau","last":"Larsen","locid":"83e6463d-057d-435c-8520-9cd3ecba0509","name":"Larsen, Peter Stein","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Tobias Boelt","key":"backpau","last":"Back","locid":"4ec5a08e-77ab-4fcc-8ad7-33b04a71aa1f","name":"Back, Tobias Boelt","orcid":"0000-0002-5271-4115","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Louise Brix","key":"jacobsenpau","last":"Jacobsen","locid":"5a7f1ad3-4843-4147-a0f1-1cc3c1ae4552","name":"Jacobsen, Louise Brix","orcid":"0000-0003-2189-5619","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Louise","key":"mønsterpau","last":"Mønster","locid":"6104678d-6a83-4e3b-aa45-595f743b48dd","name":"Mønster, Louise","orcid":"0000-0003-3181-144X","rank":8,"rolecode":"pau"}],"pub":{"issn":["01091182"],"newspaper":"Jyllands-Posten","pages":"25","publisher":"Politikens Forlag","status":"p","title":"Jyllands-Posten"},"review":"Undetermined","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-298188b2-5a5b-421d-8ab1-27765b3e4409"],"src":["AAU Aalborg University"],"title":"Politikerne er ved at kvæle Vidensdanmark","type":"Newspaper Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-062049","year":"2019","yearsub":"2019"}
{"abstract":"Controlling the rate of release of molecules from a hydrogel is of high interest for various drug delivery systems and medical devices. A strategy to alter the release profiles of soluble and poorly soluble active ingredients from hydrogels can be to combine the hydrogel forming ability of alginate with the inclusion forming ability of cyclodextrins (CyD). Here, β-CyD was grafted to alginate in a three-step synthesis using periodate oxidation, reductive amination and copper(I)-catalyzed azide-alkyne cycloaddition. A grafting degree of 4.7% mol β-CyD/mol sugar residues was obtained. The grafting degree was controlled by varying the reaction parameters where the amount of linker used in reductive amination was especially influential. Ca-alginate gel beads grafted with β-CyD showed increased uptake of the model molecule methyl orange. Release experiments showed that the grafted material had a prolonged release of methyl orange and an increased total amount of released methyl orange. These results show that the β-CyD grafted alginate is still able to form a hydrogel while the grafted cyclodextrins retain their ability to form inclusion complex with methyl orange. Further testing should be done with this system to investigate capability for drug delivery applications.","author_count":6,"contributors":["Omtvedt, Line Aa","Dalheim, Marianne","Nielsen, Thorbjørn Terndrup","Larsen, Kim Lambertsen","Strand, Berit L.","Aachmann, Finn L."],"cuid":["S01-000.00-066908"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Aachmann, Finn L."],"country":["Norway"],"glorg":["All Global Affiliations","Norwegian University of Science and Technology"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"efficient grafting of cyclodextrin to alginate and performance of the hydrogel for release of model drug","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1038/s41598-019-45761-4","version":"Published Version"},"funding_acknowledgement":["This work was financed by the MARPOL project 221576 funded by the Research Council of Norway. Ann-Sissel Ulset (Department of Biotechnology and Food Science, NTNU) is thanked for SEC-MALS analysis and Reinhard Wimmer (Department of Chemistry and Bioscience, Aalborg University) is credited for running DOSY and advise on the manuscript. Wenche Iren Strand is thanked for excellent technical assistance."],"id":"S01-000.00-066908","identifier":[{"id":"85068070150","type":"scopus"}],"ids":["aau-3a260ea9-764b-4432-a10e-fbdfd11dc68d"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-B6F630F8592E5522C1ED773530772B41"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1038/s41598-019-45761-4","version":"Published Version"},{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/329690948/s41598_019_45761_4.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","country":"no","key":"norwegian university of science and technology","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"Norwegian University of Science and Technology","used":1},{"affno":"2","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience, Section of Chemistry","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience, Supramolekular Chemistry"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Line Aa","key":"omtvedtpau","last":"Omtvedt","name":"Omtvedt, Line Aa","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Marianne","key":"dalheimpau","last":"Dalheim","name":"Dalheim, Marianne","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Thorbjørn T.","key":"nielsenpau","last":"Nielsen","locid":"a8574de5-05a2-402e-a58e-feac9f7fdb89","name":"Nielsen, Thorbjørn Terndrup","name_org":"Nielsen, Thorbjørn T.","orcid":"0000-0002-7624-797X","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Kim L.","key":"larsenpau","last":"Larsen","locid":"112be21c-0345-4fc5-bf89-40e676056dd8","name":"Larsen, Kim Lambertsen","name_org":"Larsen, Kim L.","orcid":"0000-0003-2172-7519","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Berit L.","key":"strandpau","last":"Strand","name":"Strand, Berit L.","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Finn L.","key":"aachmannpau","last":"Aachmann","name":"Aachmann, Finn L.","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1038/s41598-019-45761-4","issn":["20452322"],"issue":"1","journal":"Scientific Reports","paperid":"9325","publisher":"Nature Publishing Group","status":"p","title":"Scientific Reports","volume":"9"},"review":"Peer Reviewed","scoID":["2-s2.0-85068070150"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-3a260ea9-764b-4432-a10e-fbdfd11dc68d"],"src":["AAU Aalborg University"],"title":"Efficient Grafting of Cyclodextrin to Alginate and Performance of the Hydrogel for Release of Model Drug","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-066908","year":"2019","yearsub":"2019"}
{"abstract":"OBJECTIVES: Critical and chronic illness in youth such as diabetes can lead to impaired mental health. Despite the potentially traumatic and life-threatening nature of venous thromboembolism (VTE), the long-term mental health of adolescents and young adults with VTE is unclear. We compared the long-term mental health of adolescents and young adults with VTE versus adolescents and young adults with insulin-dependent diabetes mellitus (IDDM) using psychotropic drug purchase as proxy for mental health. DESIGN: Nationwide registry-based cohort study. SETTING: Denmark 1997-2015. PARTICIPANTS: All patients aged 13-33 years with an incident diagnosis of VTE (n=5065) or IDDM (n=6609). EXPOSURE: First time primary hospital diagnosis of VTE or IDDM. PRIMARY AND SECONDARY OUTCOME MEASURES: Adjusted absolute risk and risk difference at 1 and 5 years follow-up for first psychotropic drug purchase comparing patients with VTE and patients with IDDM. RESULTS: The absolute 1 year risk of psychotropic drug use was 6.2% among VTE patients versus 3.6% among patients with IDDM, at 5 years this was 19.3%-14.7%, respectively. After adjusting for the effect of sex, age and risk factors for VTE this corresponded to a 1 year risk differences of 1.9% (95 % CI 0.1% to 3.3%). At 5 years follow-up the risk difference was 1.9% (95% CI 0.5% to 3.3%). CONCLUSION: One-fifth of adolescents and young adults with incident VTE had claimed a prescription for a psychotropic drug within 5 years, a risk comparable to that of young patients with IDDM.","author_count":7,"contributors":["Højen, Anette Arbjerg","Søgaard, Mette","Melgaard, Line","Lane, Deirdre A.","Sørensen, Erik Elgaard","Goldhaber, Samuel Zachary","Larsen, Torben Bjerregaard"],"cuid":["S01-000.00-110173"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Adolescents","Diabetes","Embolism and thrombosis","Psychology","Venous thromboembolism","Young Adult"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Liverpool Centre for Cardiovascular Science, University of Liverpool, Liverpool John Moores University and Liverpool Heart & Chest Hospital, Liverpool, UK."],"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"psychotropic drug use following venous thromboembolism versus diabetes mellitus in adolescence or young adulthood a danish nationwide cohort study","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC 4.0","type":"doi","url":"https://doi.org/10.1136/bmjopen-2018-026159","version":"Published Version"},"id":"S01-000.00-110173","identifier":[{"id":"31092651","type":"pmid"},{"id":"000471192800163","type":"wos"},{"id":"85065813767","type":"scopus"}],"ids":["aau-cf0f2a6c-658c-45dc-880a-9bcea26c484b"],"keyword":["adolescents","diabetes","embolism and thrombosis","psychology","venous thromboembolism","young adult"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-12FE3463690898056486771E2C1DB137"],"oa_link":[{"access":"oa","license":"CC BY-NC 4.0","type":"doi","url":"https://doi.org/10.1136/bmjopen-2018-026159","version":"Published Version"},{"access":"oa","license":"CC BY-NC 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/303990148/Open_Access_Article.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg U