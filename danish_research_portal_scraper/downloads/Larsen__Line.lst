nk":10,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Sussie","key":"paghpau","last":"Pagh","locid":"ebf3bb90-5d85-4380-8a86-1f5ff811c011","name":"Pagh, Sussie","orcid":"0000-0002-1574-3638","rank":11,"rolecode":"pau"}],"pub":{"doi":"10.3390/coasts4020013","issn":["2673964X"],"issue":"2","journal":"Coasts","pages":"226-234","publisher":"Multidisciplinary Digital Publishing Institute","status":"p","title":"Coasts","volume":"4"},"review":"Peer Reviewed","scoID":["2-s2.0-105011938154"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Private Research","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","NIRAS A/S","Other Research","Private Research","Universities"],"PST":["Published"]},"sid":["aau-919dcc03-a4b8-4df7-98f1-47a338557254","aau-cf67d3b6-690c-4fa4-970c-91a15c55dfc7","au-8b99d4ba-67b4-4b21-b05e-8f808c26c0f3"],"src":["AAU Aalborg University","AU Aarhus University"],"title":"Further Evidence for Breeding White-Beaked Dolphin (Lagenorhynchus albirostris) in Inner Danish Waters","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-098.83-822389","year":"2024","yearsub":"2024"}
{"abstract":"We investigated the two-year safety and efficacy of 0.1% loading dose and 0.01% low-dose atropine eye drops in Danish children for reduction in myopia progression in an investigator-initiated, placebo-controlled, double-masked, randomized clinical trial. Ninety-seven six- to twelve-year old myopic participants were randomized to 0.1% loading dose for six months and then 0.01% for eighteen months (loading dose group, N = 33), 0.01% for two years (0.01% group, N = 32) or placebo for two years (placebo, N = 32). Axial length (AL) and spherical equivalent refraction (SER) were primary outcomes. Secondary outcomes included adverse events and reactions, choroidal thickness, and other ocular biometrical measures. Outcomes were measured from baseline and at six-month intervals. Individual eyes nested by participant ID were analyzed with linear-mixed model analysis. Data were analyzed with intention-to-treat. Mean AL was 0.08 mm less (95% confidence interval (CI): −0.01; 0.17, p-value = 0.08) in the 0.1% loading dose and 0.10 mm less (95% CI: 0.01; 0.19, p-value = 0.02) in the 0.01% group after two years of treatment compared to placebo. Mean SER progression was 0.12 D (95% CI: −0.10; 0.33) less in the loading dose and 0.26 D (95% CI: 0.04; 0.48) less in the 0.01% groups after two years of treatment compared to placebo (p-value = 0.30 and 0.02, respectively). In total, 17 adverse events were reported in the second-year follow-up, and all were rated as mild. Adjusting for iris color did not affect treatment effect estimates. Intra-ocular pressure increased over two years comparably between all groups but remained within normal limits. Two-year treatment with 0.01% low-dose atropine eye drops is a safe and moderately efficacious intervention in Danish children for reducing myopia progression.","author_count":7,"contributors":["Hansen, Niklas Cyril","Hvid-Hansen, Anders","Møller, Flemming","Bek, Toke","Larsen, Dorte Ancher","Jacobsen, Nina","Kessel, Line"],"cuid":["S03-100.00-724636"],"filters":{"added":"2024-05","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":3,"corresponding_author":["Hansen, Niklas Cyril"],"keyword":["Axial length","Myopia","Myopia control","low dose atropine","spherical equivalent"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-SDR","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"two year results of 000000000000 000000000001 atropine eye drops and 000000000000 000000000001 loading dose for myopia progression reduction in danish children a placebo controlled randomized clinical trial","src":["au","ku","sdu"],"src-code":["DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/jpm14020175","version":"Published Version"},"funding_acknowledgement":["This research was funded by Bagenkop Nielsens Øjen-Fond, Fight for Sight Denmark, Fonden for Faglig Udvikling i Speciallægepraksis, The Danish Research Foundation, Synoptik-Fonden, Danish Regions, Gangstedfonden, Reimbursement from Regional COVID-19 funds, Aase og Ejnar Danielsens Fond, and A.P. Møller Fonden (Lægefonden). Publication costs were part of the fund applications and funded the APC."],"id":"S03-100.00-724636","identifier":[{"id":"38392608","type":"pmid"},{"id":"85185952429","type":"scopus"},{"id":"PMC10890135","type":"pmcid"}],"ids":["au-5c15650f-1e5f-4334-9dbc-cb92edaf18e7","ku-065f0ef7-61fa-4854-a943-088f8a580937","sdu-a5cf8b65-7055-4f1d-845e-1a62a95330f9"],"keyword":["axial length","low-dose atropine","myopia","myopia control","spherical equivalent"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-E8EEB09F30E18833304AE6