{"author_count":14,"contributors":["Bech, Rie Sander","Nielsen, Kasper Lindblad","Larsen, Thomas S","Bentzen, Hans Herluf Nørregaard","Lynggaard, Line S","Do, Trung H","Braendstrup, Peter","Brady, Jessica","Mikhaeel, Nabegh George","Dybkær, Karen","Johnsen, Hans Erik","Jensen, Paw","Bøgsted, Martin","El-Galaly, Tarec Christoffer"],"cuid":["S03-100.00-009521"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","Guy's and St Thomas' NHS Foundation Trust"],"keyword":["Follicular lymphoma","Maintenance therapy","Rituximab","immunochemotherapy","non Hodgkin lymphoma"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR"],"OT":["The Department of Haematology L, Herlev University Hospital, University of Copenhagen, Herlev, Denmark."],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-U-AAU","DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"real world data on rituximab maintenance therapy after frontline immunochemotherapy in grade 000000000001 000000000003a follicular lymphoma","src":["aau","au","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85049697295","version":"Other Version"},"id":"S03-100.00-009521","identifier":[{"id":"85049697295","type":"scopus"},{"id":"28542714","type":"pmid"},{"id":"000437830100022","type":"wos"}],"ids":["aau-c63ff84f-4901-4249-867e-de8a79bd9107","au-0b05f9e9-0a15-4232-8316-9af9fc8b298a","sdu-fa8a6b82-f3d1-4d80-afbf-e363e0dea757"],"keyword":["Follicular lymphoma","immunochemotherapy","maintenance therapy","non-Hodgkin lympho