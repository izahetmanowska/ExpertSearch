,"last":"Wester-Larsen","name":"Wester-Larsen, Lærke","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Mads","key":"ejsingpau","last":"Ejsing","name":"Ejsing, Mads","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Caroline Anna","key":"sallingpau","last":"Salling","name":"Salling, Caroline Anna","rank":4,"rolecode":"pau"},{"affno":"2","first":"Frederik Appel","key":"olsenpau","last":"Olsen","name":"Olsen, Frederik Appel","rank":4,"rolecode":"pau"},{"affno":"3","country":"dk","first":"Nikolaj","key":"kornbechpau","last":"Kornbech","locid":"5c85c8d6-dfbf-4960-ae68-1bb13000c475","name":"Kornbech, Nikolaj","orcid":"0000-0002-3643-7277","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Morten Wendler","key":"jørgensenpau","last":"Jørgensen","name":"Jørgensen, Morten Wendler","rank":7,"rolecode":"pau"},{"affno":"4","first":"Oskar Wood","key":"hansenpau","last":"Hansen","name":"Hansen, Oskar Wood","rank":7,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Line Kryger","key":"aagaardpau","last":"Aagaard","name":"Aagaard, Line Kryger","rank":9,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Mikkel Krause","key":"frantzenpau","last":"Frantzen","name":"Frantzen, Mikkel Krause","rank":10,"rolecode":"pau"}],"pub":{"issn":["09071814"],"newspaper":"Politiken","publisher":"JP/Politikens Hus AS","publisher_org":"JP/Politikens Hus A/S","status":"p","title":"Politiken"},"review":"Undetermined","search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Roskilde University","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-e9ff0bc1-c77a-4e4d-9040-d459fd4bf598","ruc-6e8ff0e6-ff6c-4c04-b033-4294c19817cf"],"src":["AU Aarhus University","RUC Roskilde University"],"title":"Treparten er en del af problemet snarere end en del af løsningen : Vi er endt med en aftale, der opretholder en urealistisk tiltro til teknologiske løsninger og uambitiøse frivillige aftaler.","type":"Newspaper Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-083.87-767970","year":"2024","yearsub":"2024"}
{"abstract":"The immune system of neonates is immature and therefore knowledge of possible early-life protection against SARS-CoV-2 infection, such as breastfeeding, is of great importance. Few studies have investigated the presence and duration of SARS-CoV-2 antibodies in breastmilk in relation to the trimester of maternal infection during pregnancy, and none with successful participation from all three trimesters. This study has dual objectives (1) in relation to the trimester of infection to examine the frequency, concentration and duration of IgA and IgG antibodies in breastmilk and blood serum in the third and sixth month post-partum in former SARS-CoV-2-infected mothers and (2) to examine the association in pediatric emergency admission of children within the first six months of life compared to children of non-SARS-CoV-2-infected women. The first objective is based on a prospective cohort and the second is based on a nested case–control design. The study participants are women with a former SARS-CoV-2 infection during pregnancy, whose serology IgG tests at delivery were still positive. Maternal blood and breastmilk samples were collected at three and six months postpartum. Serum IgA frequency three months pp was 72.7% (50%, 90% and 60% in the first, second and third trimester) and 82% six months pp (67%, 91% and 82% in the first, second and third trimester). Breastmilk IgA frequency three months pp was 27% (16.6%, 36% and 20% in first, second and third trimester) and 28% six months pp (0%, 38% and 28% in the first, second and third trimester). The highest IgA concentration in breastmilk was found six months post-partum with infection in the third trimester. Serum IgA was detectable more than 400 days post infection, and serum IgG above threshold was found 430 days after date of infection. We found no correlation between serum IgA and breastmilk IgA, nor between serum IgG and breastmilk IgA regardless of the trimester of infection.","author_count":9,"contributors":["Fich, Line","Christiansen, Ann Marie Hellerung","Nilsson, Anna Christine","Lindman, Johanna","Juul-Larsen, Helle Gybel","Hansen, Christine Bo","Freiesleben, Nina la Cour","Khalil, Mohammed Rohi","Nielsen, Henriette Svarre"],"cuid":["S02-100.00-725145"],"filters":{"added":"2024-05","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Fich, Line"],"keyword":["Antibodies","SARS CoV 2","breastmilk","human research","maternal neonate immunology","trimester of infection"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-SDR","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"sars cov 000000000002 antibodies in breastmilk three and six months postpartum in relation to the trimester of maternal sars cov 000000000002 infection an exploratory study","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/ijms25063269","version":"Published Version"},"id":"S02-100.00-725145","identifier":[{"id":"85189085767","type":"scopus"},{"id":"PMC10970440","type":"pmcid"},{"id":"38542243","type":"pmid"}],"ids":["ku-21208677-0cd0-4388-8828-f8c42f1c8d03","sdu-9403857e-2665-4dcf-a089-cc7dc7ad4daf"],"keyword":["SARS-CoV-2","antibodies","breastmilk","human research","maternal–neonate immunology","trimester of infection"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-A52E7904E4E67CD0722C3FC8428CF7D8"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/ijms25063269","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/258569917/Open_Access_Version.pdf","versi