:"1","corresponding":null,"first":"L","key":"koelneraugustsonpau","last":"Koelner-Augustson","locid":"e77803b7-02ea-4b57-8d9c-5e27b4e418c5","name":"Kølner-Augustson, Line","name_org":"Koelner-Augustson, L","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"R","key":"elsoepau","last":"Elsoe","locid":"d76bd066-40d4-4fcb-b264-ce8421d08fdf","name":"Elsøe, Rasmus","name_org":"Elsoe, R","orcid":"0000-0001-5781-5604","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"J","key":"petruskeviciuspau","last":"Petruskevicius","locid":"a9bf8bdc-f8b3-4f18-bfe4-1230f71df5f7","name":"Petruskevicius, Juozas","name_org":"Petruskevicius, J","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"S","key":"rasmussenpau","last":"Rasmussen","locid":"05d1d595-13be-4295-8ad1-8d29206859c8","name":"Rasmussen, Sten","name_org":"Rasmussen, S","orcid":"0000-0002-8664-352X","rank":5,"rolecode":"pau"}],"pmid":["26683568"],"pub":{"doi":"10.1007/s00068-015-0622-9","issn":["18639933","18639941"],"issn_org":["18639933"],"issue":"2","journal":"European Journal of Trauma and Emergency Surgery","pages":"221-226","publisher":"Springer","status":"p","title":"European Journal of Trauma and Emergency Surgery","volume":"43"},"review":"Peer Reviewed","scoID":["2-s2.0-84950301334"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-b624ffe2-f98a-4023-b8a2-0e437b62f3be"],"src":["AAU Aalborg University"],"title":"The long-term outcome after treatment for patients with tibial fracture treated with intramedullary nailing is not influenced by time of day of surgery and surgeon experience","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-102931","year":"2017","yearsub":"2017"}
{"abstract":"Dette ph.d.-projekt bidrager med ny viden om fordelingen af fluorid i dental biofilm og saliva. For at udforske koncentrationen af fluorid i naturlig (in vivo) biofilmvæske, biofilmsediment og i saliva, blev der udført to meget forskellige kliniske studier. Resultaterne fra tværsnitsstudiet (Studie I), hos en stor gruppe mennesker (n=42) der konsulterede en tandklinik for behandling, bekræfter tidligere viden, at der findes en naturlig biologisk variation i fluoridkoncentrationerne i biofilm fra forskellige intra-orale regioner samt mellem biofilmvæske, biofilmsediment og saliva. Fluoridkoncentrationerne i biofilmvæsken var positivt og statistisk signifikant associeret med fluoridkoncentrationerne i saliva, og var i alle regioner højere end saliva koncentrationerne. De nye resultater om fluorid i biofilmsedimentet afslører et tydeligt intra-oralt mønster mellem de forskellige regioner; de højeste fluoridkoncentrationer i underkæbefronten, intermediære koncentrationer i alle tre overkæberegioner og de laveste koncentrationer i underkæbemolarregionerne. Begge studier viser at biofilmsedimentet indeholder størstedelen af fluorid i biofilm. Set i et bredere perspektiv viser fundene at der er et omvendt forhold mellem fluoridkoncentrationerne i biofilmsediment og fordeling af caries mellem regioner. Forskere anbefales at være opmærksomme på de intra-orale forskelle i fluoridkoncentrationer mellem regioner samt sikre balancering af effekten af region, når der indsamles dental biofilm til fluoridanalyse. I det randomiserede kontrollerede dobbelt-blindede overkrydsningsforsøg (Studie II) mundskyllede 12 raske forsøgsdeltagere i 3 uger med henholdsvis 0 (kontrol), 1.500 og 5.000 ppm fluorid mundskyllevæsker. I de første 2 uger af hver 3-ugers eksperimentperiode brugte forsøgsdeltagerne en fluorid-fri tandpasta. I den sidste uge af hver eksperimentperiode afstod forsøgsdeltagerne fra at udføre deres normale mundhygiejne. Resultaterne viste at regelmæssig anvendelse af 5.000 ppm sammenlignet med 1.500 ppm fluorid forhøjer baggrundsniveauet af fluorid til det dobbelte i saliva og i 7 dage gammel biofilmvæske og biofilmsediment. Dette indikerer at brugen af 5.000 ppm fluorid tandpasta kan føre til forbedret carieskontrol. Det var påfaldende, at en næsten tre en halv ganges forøgelse af fluorideksponeringen kun førte til en fordobling af fluoridbaggrundsniveauerne. Ph.d.-projektets mest overraskende fund er, at akkumuleringen af fluorid i biofilmsedimentet målt over en time efter en mundskylning med fluorid knapt viste nogen forskel mellem 1.500 og 5.000 ppm fluorid mundskyllevæskerne. Yderligere studier må udforske dette fund og kliniske undersøgelser er påkrævet for at klarlægge de mulige kliniske konsekvenser af de forhøjede fluoridkoncentrationer i biofilmvæske, biofilmsediment og i saliva.","author_count":1,"contributors":["Staun Larsen, Line"],"cuid":["S01-000.00-274393"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"keyword":["Dental biofilm","Saliva","biofilmsediment","biofilmvæske","fluorid"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"und","rtype":["clu"],"sorti":"fluoride in dental biofilm and saliva","src":["au"],"src-code":["DI-U-AU"],"type":"dtd","type-grp":["all","pub"]},"id":"S01-000.00-274393","ids":["au-fe429fd6-1246-40f6-a4af-a0d0ff1d91cb"],"keyword":["biofilmsediment","biofilmvæske","dental biofilm","fluorid","saliva"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-7A5D4195EC81241C8113DD25F3C110F5"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Dentistry and Oral Health, Department of Dentistry and Oral Health - Section for Oral Ecology and Caries Control"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Line Staun","key":"larsenpau","last":"Larsen","locid":"35e2ae60-25db-4a15-893f-dc8906e2bccf","name":"Staun Larsen, Line","name_org":"Larsen, Line Staun","orcid":"0000-0002-4155-5884","rank":1,"rolecode":"pau"}],"pub":{"pages":"93","place":"Aarhus","publisher":"Aarhus University","status":"p"},"review":"Undetermined","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-fe429fd6-1246-40f6-a4af-a0d0ff1d91cb"],"src":["AU Aarhus University"],"title":"Fluoride in dental biofilm and saliva","type":"Thesis Doctoral","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-274393","year":"2017","yearsub":"2017"}
