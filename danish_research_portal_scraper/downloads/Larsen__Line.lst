{"author_count":5,"contributors":["larsen, Line H.G.","Rasmussen, Anette","Giessing, Anders","Jogl, Gerwald","Kirpekar, Finn"],"cuid":["S01-000.00-634491"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","Brown University"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"identification and characterization of the em thermus thermophilus em 000000000005 methylcytidine m sup 000000000005 sup c methyltransferase modifying 000000000023 s ribosomal rna rrna base c000000001942","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1074/jbc.M112.376160","version":"Published Version"},"id":"S01-000.00-634491","identifier":[{"id":"84864981568","type":"scopus"}],"ids":["sdu-d5e62fd2-c09e-4517-a2e3-e71cdbf66cc0"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-AE21760975C551BBEE73FB4FABDA7140"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1074/jbc.M112.376160","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["University of Southern Denmark"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"us","key":"brown university","loc":["United States","America, North","OECD"],"name":"Brown University","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Line H.G.","key":"larsenpau","last":"larsen","name":"larsen, Line H.G.","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anette","key":"rasmussenpau","last":"Rasmussen","name":"Rasmussen, Anette","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders","key":"giessingpau","last":"Giessing","locid":"152b0e2c-5377-47a1-a197-82902800cc15","name":"Giessing, Anders","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Gerwald","key":"joglpau","last":"Jogl","name":"Jogl, Gerwald","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Finn","key":"kirpekarpau","last":"Kirpekar","locid":"5a936580-b4b8-47cd-8407-7ab6c6ca5a43","name":"Kirpekar, Finn","orcid":"0000-0003-1901-2266","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1074/jbc.m112.376160","issn":["00219258","10678816"],"issn_org":["00219258"],"issue":"33","journal":"Journal of Biological Chemistry","pages":"27593-27600","publisher":"Elsevier","status":"p","title":"Journal of Biological Chemistry","volume":"287"},"review":"Peer Reviewed","scoID":["2-s2.0-84864981568"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-d5e62fd2-c09e-4517-a2e3-e71cdbf66cc0"],"src":["SDU University of Southern Denmark"],"title":"Identification and characterization of the <em>Thermus thermophilus</em> 5-methylcytidine (m<sup>5</sup>C) methyltransferase modifying 23 S ribosomal RNA (rRNA) base C1942","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-634491","year":"2012","yearsub":"2012"}
{"abstract":"Objective: To assess outcome in twin pregnancies according to chorionicity. Methods: A cohort was retrieved from local ultrasound databases at 14 obstetric departments in Denmark, comprising all twin pregnancies with two live fetuses scanned between weeks 11 and 14 in the period 1 January 2004 to 31 December 2006. Outcome data were retrieved from the National Board of Health. Results: Among 2038 twin pregnancies, 1757 (86.2%) were dichorionic (DC) and 281 (13.8%) were monochorionic diamniotic (MC). In MC pregnancies, the rate of spontaneous fetal loss in both second and third trimesters was more than threefold higher than the comparable rate in DC pregnancies: 6.0% vs. 1.9% for at least one fetus in the second trimester (P <0.001) and 2.1% vs. 0.7% in the third trimester (P = 0.03). In 98.4% of DC pregnancies and in 91.1% of MC pregnancies, at least one infant was liveborn. Amongst pregnancies with two live fetuses at 24 weeks, the proportion with two live infants at 28 days after delivery was 97.5% and 95.1%, respectively. Conclusions: The increased incidence of fetal loss in MC pregnancies compared with DC pregnancies predominantly occurs before 24 weeks' gestation. After this stage, although the risk of intrauterine fetal death is still higher in MC than in DC pregnancies, if both fetuses are alive at 24 weeks, the chance of a woman having two live infants 1 month after delivery is similar in MC and DC pregnancies.","author_count":32,"contributors":["Oldenburg, Anna","Rode, Line","Bødker, Birgit","Ersbak, Vibeke","Holmskov, Anni","Jørgensen, Finn Stener","Larsen, Helle","Larsen, Torben","Laursen, Lone","Mogensen, Helle","Petersen, Olav Bjørn","Rasmussen, Steen","Skibsted, Lillian","Sperling, Lene","Stornes, Inger","Zingenberg, Helle","Tabor, Ann"],"cuid":["S03-090.47-013888"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"keyword":["Adult","Chorion","Cohort Studies","Denmark","Female","Fetal Death","Fetal Diseases","Gestational Age","Humans","Infant Newborn","Perinatal Mortality","Pregnancy","Pregnancy Outcome","Retrospective Studies","Sensitivity and Specificity","Twins","Twins Dizygotic","Twins Monozygotic","Ultrasonography Prenatal"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA"],"OT":["Kvindeafdelingen, Viborg"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"influence of chorionicity on perinatal outcome in a large cohort of danish twin pregnancies","src":["au","ku","sdu"],"src-code":["DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1002/uog.10057","version":"Other Version"},"id":"S03-090.47-013888","identifier":[{"id":"84655163783","type":"scopus"},{"id":"21830245","type":"pmid"}],"ids":["au-1213fcba-2367-440b-a238-26129002c4ac","ku-c50f3b44-164c-4a50-a154-4746fadb8765","sdu-76dde2ea-eb24-45b5-9232-50207b0eb1e0"],"keyword":["Adult","Chorion","Cohort Studies","Denmark","Female","Fetal Death","Fetal Diseases","Gestational Age","Humans","Infant, Newborn","Perinatal Mortality","Pregnancy","Pregnancy Outcome","Retrospective Studies","Sensitivity and Specificity","Twins","Twins, Dizygotic","Twins, Monozygotic","Ultrasonography, Prenatal"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-C43BE05BB377E90E032C0F30B9218A1C"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1002/uog.10057","version":"Other Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU Universit