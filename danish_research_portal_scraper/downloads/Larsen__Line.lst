ark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1}],"person":[{"affno":"1 2","first":"Moug","key":"albakripau","last":"Al-Bakri","locid":"b088ca79-9c7d-45b1-8c4a-1c9289aedf65","name":"Al-Bakri, Moug","rank":1,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Anne Mette","key":"skovgaardpau","last":"Skovgaard","locid":"16faee51-f101-47f9-8757-c611e52d7381","name":"Skovgaard, Anne Mette","orcid":"0000-0002-8793-8303","rank":2,"rolecode":"pau"},{"affno":"2 1","first":"Daniella","key":"bachholmpau","last":"Bach-Holm","locid":"8b33b618-7a43-481a-a590-79dc9de2bc11","name":"Bach-Holm, Daniella","rank":3,"rolecode":"pau"},{"affno":"4 5","corresponding":null,"country":"dk","first":"Dorte Ancher","key":"larsenpau","last":"Larsen","locid":"5e903371-0f65-473a-ad66-1a909c98a776","name":"Larsen, Dorte Ancher","rank":4,"rolecode":"pau"},{"affno":"1","first":"Volkert","key":"siersmapau","last":"Siersma","locid":"70f90acb-f0b0-4ffc-b7f2-a86ca85ac96d","name":"Siersma, Volkert","orcid":"0000-0003-1941-2681","rank":5,"rolecode":"pau"},{"affno":"2 1","first":"Line","key":"kesselpau","last":"Kessel","locid":"3201472a-2f23-417e-bd01-a7950e2ff370","name":"Kessel, Line","orcid":"0000-0002-9375-1510","rank":6,"rolecode":"pau"}],"pmid":["37532485"],"pub":{"doi":"10.1136/bmjopen-2023-072984","issn":["20446055"],"issue":"8","journal":"BMJ Open","paperid":"e072984","publisher":"BMJ Publishing Group","status":"p","title":"BMJ Open","volume":"13"},"review":"Peer Reviewed","scoID":["2-s2.0-85166426875"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-43cdebc3-cec9-43c9-a0e0-6f81e9ff97bf","ku-7f174152-53f1-40e8-b8f6-366bcf5870e7","sdu-9c0fcc79-6830-48e5-9e93-90760515ea5c"],"src":["AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"School performances in children with cataract : results from a population-based cohort study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-099.97-685907","year":"2023","yearsub":"2023"}
{"abstract":"The mechanisms linking tumor microenvironment acidosis to disease progression are not understood. Here, we used mammary, pancreatic, and colon cancer cells to show that adaptation to growth at an extracellular pH (pHe) mimicking acidic tumor niches is associated with upregulated net acid extrusion capacity and elevated intracellular pH at physiological pHe, but not at acidic pHe. Using metabolic profiling, shotgun lipidomics, imaging and biochemical analyses, we show that the acid adaptation-induced phenotype is characterized by a shift toward oxidative metabolism, increased lipid droplet-, triacylglycerol-, peroxisome content and mitochondrial hyperfusion. Peroxisome proliferator-activated receptor-α (PPARA, PPARα) expression and activity are upregulated, at least in part by increased fatty acid uptake. PPARα upregulates genes driving increased mitochondrial and peroxisomal mass and β-oxidation capacity, including mitochondrial lipid import proteins CPT1A, CPT2 and SLC25A20, electron transport chain components, peroxisomal proteins PEX11A and ACOX1, and thioredoxin-interacting protein (TXNIP), a negative regulator of glycolysis. This endows acid-adapted cancer cells with increased capacity for utilizing fatty acids for metabolic needs, while limiting glycolysis. As a consequence, the acid-adapted cells exhibit increased sensitivity to PPARα inhibition. We conclude that PPARα is a key upstream regulator of metabolic changes favoring cancer cell survival in acidic tumor niches.","author_count":14,"contributors":["Rolver, Michala G.","Holland, Lya K.K.","Ponniah, Muthulakshmi","Prasad, Nanditha S.","Yao, Jiayi","Schnipper, Julie","Kramer, Signe Højland","Elingaard-Larsen, Line","Pedraz Cuesta, Elena","Liu, Bin","Pardo, Luis A.","Maeda, Kenji","Sandelin, Albin Gustav","Pedersen, Stine Helene Falsig"],"cuid":["S01-000.00-524589"],"filters":{"added":"2023-03","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["France","Germany"],"glorg":["All Global Affiliations","Jules Verne University of Picardie","Max Planck Institute for Multidisciplinary Sciences"],"keyword":["Cancer metabolism","Fatty acid metabolism","Oxidation","PPARγ"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-NP","DI-OT","DI-U"],"level3":{"NP":["DI-NP-ALL","DI-NP-CAN"],"OT":["Steno Diabetes Centre, Gentofte, Denmark."],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-NP-CAN","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"chronic acidosis rewires cancer cell metabolism through pparα signaling","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1002/ijc.34404","version":"Published Version"},"id":"S01-000.00-524589","identifier":[{"id":"85145420386","type":"scopus"},{"id":"PMC10108231","type":"pmcid"},{"id":"36533672","type":"pmid"}],"ids":["ku-db95b31e-c60e-4c0b-9248-a5534e5a053f"],"keyword":["PPARα","acidic microenvironment","cancer metabolism","fatty acid metabolism","β-oxidation"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-82318461D172D7A80A8489D4CC72714A"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1002/ijc.34404","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/335421279/Intl_Journal_of_Cancer_2022_Rolver_Chronic_acidosis_rewires_cancer_cell_metabolism_through_PPAR_signaling.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Biology, Cell Biolo