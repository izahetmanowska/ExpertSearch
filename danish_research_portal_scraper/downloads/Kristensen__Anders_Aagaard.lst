{"author_count":9,"contributors":["Nielsen, Rasmus","Christiansen, Maja K","Kristensen, Marck S","Møller, Christina","Hedegaard, Christian","Aagaard, Nicolaj","Sejersen, Henrik","Hjortdal, Jesper","Ivarsen, Anders"],"cuid":["S01-000.00-176998"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"reproducibility of subjective refraction before and after small incision lenticule extraction smile for myopia","src":["au"],"src-code":["DI-U-AU"],"type":"djc","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85067382417","version":"Other Version"},"id":"S01-000.00-176998","identifier":[{"id":"85067382417","type":"scopus"},{"id":"31184408","type":"pmid"}],"ids":["au-5391e3a8-63da-4f6e-bd76-2bdaae6ee3d4"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-56F1F7B5251F31623E11666892272120"],"org":[{"affno":"1","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University (AU)"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Rasmus","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Rasmus","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Maja K","key":"christiansenpau","last":"Christiansen","name":"Christiansen, Maja K","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Marck S","key":"kristensenpau","last":"Kristensen","name":"Kristensen, Marck S","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christina","key":"møllerpau",