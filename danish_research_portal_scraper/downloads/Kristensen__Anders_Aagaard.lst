I-HO-ZEA","used":1},{"affno":"6","country":"gb","key":"complete physio","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Complete Physio","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Charlotte","key":"ankerpetersenpau","last":"Anker-Petersen","locid":"cf566f14-3bd2-48c1-9bd5-55305970ccf9","name":"Anker-Petersen, Charlotte","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Birgit","key":"juulkristensenpau","last":"Juul-Kristensen","locid":"887ddfe7-cfa6-4b72-a17d-ecf86987c5c0","name":"Juul-Kristensen, Birgit","orcid":"0000-0002-4973-8415","rank":2,"rolecode":"pau"},{"affno":"3","first":"Jarrod","key":"antflickpau","last":"Antflick","name":"Antflick, Jarrod","rank":3,"rolecode":"pau"},{"affno":"4 5","first":"Henrik","key":"aagaardpau","last":"Aagaard","locid":"1382c92d-fe31-477f-80c0-46677dc8f834","name":"Aagaard, Henrik","rank":4,"rolecode":"pau"},{"affno":"6","first":"Christopher","key":"myerspau","last":"Myers","name":"Myers, Christopher","rank":5,"rolecode":"pau"},{"affno":"2","first":"Anders Ploug","key":"boesenpau","last":"Boesen","name":"Boesen, Anders Ploug","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Eleanor","key":"boylepau","last":"Boyle","locid":"79e9e639-9ded-45fe-bc17-4677eb6c95e3","name":"Boyle, Eleanor","orcid":"0000-0002-9012-9128","rank":7,"rolecode":"pau"},{"affno":"4 2","first":"Per","key":"hölmichpau","last":"Hölmich","locid":"dbb82dee-c9f9-47c8-b3d8-f810ae75ee69","name":"Hölmich, Per","rank":8,"rolecode":"pau"},{"affno":"4 2","first":"Kristian","key":"thorborgpau","last":"Thorborg","locid":"7c1f3592-61a0-469e-b376-7adea54a0fa9","name":"Thorborg, Kristian","rank":9,"rolecode":"pau"}],"pmid":["34407248"],"pub":{"doi":"10.1111/sms.14034","issn":["09057188","16000838"],"issn_org":["09057188"],"issue":"11","journal":"Scandinavian Journal of Medicine & Science in Sports","pages":"2133-2143","publisher":"Wiley","status":"p","title":"Scandinavian Journal of Medicine & Science in Sports","title_org":"Scandinavian Journal of Medicine and Science in Sports","volume":"31"},"review":"Peer Reviewed","scoID":["2-s2.0-85113588331"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region Zealand","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-39ee36c1-f4e1-447e-9989-340596f682a4","sdu-5f5e7566-3b1d-4278-9669-028b11a94cec"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Six weeks of intensive rehearsals for the Swan Lake ballet shows ultrasound tissue characterization changes of the Achilles tendons in dancers","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-041571","year":"2021","yearsub":"2021"}
{"abstract":"PURPOSE: To evaluate the association between anti-Müllerian hormone (AMH) and follicle density in infertile women with diminished ovarian reserve (DOR) versus women with normal ovarian reserve? METHODS: Case-control study comparing follicle densities in ovarian cortex from 20 infertile women with DOR (AMH ≤ 5 pmol/L) and 100 controls with presumed normal ovarian reserve. RESULTS: For all women > 25 years, the follicle densities correlated positively with AMH levels. For each single picomole per liter increase in AMH the follicle density increased by 6% (95% CI 3.3-8.5%) when adjusted for age. This was similar for women with DOR and controls. The follicle density was 1.8 follicles/mm3 cortical tissue in women with DOR versus 7.0 in age-paired controls (p = 0.04). The women with DOR had a median AMH of 1.8 pmol/L versus 14.4 pmol/L in the age-paired control group (p < 0.001). The ratio of AMH/follicle density was 1:1 (1.8/1.8) in women with DOR and 2:1 (14.4/7.0) in the age-paired controls. Analyses for gonadotropin receptor polymorphisms could not explain the characteristics of women with DOR. The proportion of secondary follicles was higher in women with DOR compared with controls (4.6% versus 1.4%, p = 0.0003). Pooling all patients, the follicle density decreased significantly by 7.7% for every year added (p < 0.0001). The women with DOR had lower follicle densities than the controls, but the slopes were equal in the two cohorts. CONCLUSIONS: Follicle density and AMH concentrations correlate also when AMH is low. However, AMH is only a reliable marker for the true ovarian reserve when age is included in the estimation and women with DOR may have more follicles than their AMH levels imply.","author_count":12,"contributors":["Lunding, Stine Aagaard","Pors, Susanne Elisabeth","Kristensen, Stine Gry","Bøtkjær, Jane Alrø","Ramløse, Maja","Jeppesen, Janni Vikkelsø","Flachs, Esben Meulengracht","Pinborg, Anja","Macklon, Kirsten Tryde","Pedersen, Anette Tønnes","Andersen, Claus Yding","Andersen, Anders Nyboe"],"cuid":["S01-000.00-546094"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"ovarian cortical follicle density in infertile women with low anti müllerian hormone","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"http://europepmc.org/Copyright","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC7000582/pdf/10815_2019_Article_1633.pdf","version":"Published Version"},"id":"S01-000.00-546094","identifier":[{"id":"PMC7000582","type":"pmcid"},{"id":"85075475353","type":"scopus"},{"id":"31758514","type":"pmid"}],"ids":["ku-ffe3c86e-4f6e-49ee-9f65-2e79f596ca75"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-7D90F7501619F278FF4F813DF1811E06"],"oa_link":[{"access":"oa","license":"http://europepmc.org/Copyright","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC7000582/pdf/10815_2019_Article_1633.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Obstetrics and Gynaecology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Stine Aagaard","key":"lundingstineaagaardpau","last":"Lunding","name":"Lunding, Stine Aagaard","rank":1,"rolecode":"pau"},{"affno":"","first":"Susanne Elisabeth","key":"porssusanneelisabethpau","last":"Pors","name":"Pors, Susanne Elisabeth","rank":2,"rolecode":"pau"},{"affno":"","first":"Stine Gry","key":"kristensenstinegrypau","last":"Kristensen","name":"Kristensen, Stine Gry","rank":3,"rolecode":"pau"},{"affno":"1","first":"Jane Alrø","key":"bøtkjærjanealrøpau","last":"Bøtkjær","name":"Bøtkjær, Jane Alrø","rank":4,"rolecode":"pau"},{"affno":"1","first":"Maja","key":"ramløsemajapau","last":"Ramløse","name":"Ramløse, Maja","rank":5,"rolecode":"pau"},{"affno":"1","first":"Janni Vikkelsø","key":"jeppesenjannivikkelsøpau","last":"Jeppesen","name":"Jeppesen, Janni Vikkelsø","rank":6,"rolecode":"pau"},{"affno":"","first":"Esben Meulengracht","key":"flachsesbenmeulengrachtpau","last":"Flachs","name":"Flachs, Esben Meulengracht","rank":7,"rolecode":"pau"},{"affno":"2","first":"Anja","key":"pinborganjapau","last":"Pinborg","locid":"28eb0e05-b8d4-4063-9350-54ae5d522ed4","name":"Pinborg, Anja","rank":8,"rolecode":"pau"},{"affno":"1","first":"Kirsten Tryde","key":"macklonkirstentrydepau","last":"Macklon","name":"Macklon, Kirsten Tryde","rank":9,"rolecode":"pau"},{"affno":"2","first":"Anette Tønnes","key":"pedersenanettetønnespau","last":"Pedersen","locid":"de173c3f-f7b8-47fb-b3c4-6138fa53337c","name":"Pedersen, Anette Tønnes","rank":10,"rolecode":"pau"},{"affno":"1","first":"Claus Yding","key":"andersenclausydingpau","last":"Andersen","name":"Andersen, Claus Yding","rank":11,"rolecode":"pau"},{"affno":"2","