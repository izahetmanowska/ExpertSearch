T","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Roskilde University","Universities"],"PST":["Published"]},"sid":["ruc-62176817-c061-4363-b405-52c36f2bae71"],"src":["RUC Roskilde University"],"title":"USING A CO-CREATIVE ETHNOGRAPHIC APPROACH TO INCORPORATE CULTURAL VALUES IN DEFINING IT REQUIREMENTS","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-830611","year":"2025","yearsub":"2025"}
{"abstract":"Many paradoxes accompany the vast digitalization taking place in society today. There is a digitalization paradox; there are myriad cybersecurity paradoxes;and there are digital versions of other well-known paradoxes. This paper explains a paradox arising when nations (or organizations) seek to improve society (or operations) by empowering citizens (or clients) and governance (or processes) through digitalization. This empowerment paradox results from the use of digitalization to empower a class of digitalization beneficiaries that simultaneously disempowers a class of digitalization victims. The effects on these classes of people or organizations may be intended or unintended. This paper uses historical research methodology to examine the case of the digitalization of Denmark, one of the most digitalized nations in the World. Our study of the development of this national digitalization experience is a cycle of victory in achieving massive digitalization accompanied by defeat in helping to victimize its citizens and other stakeholders.","author_count":4,"contributors":["Baskerville, Richard","Fleron, Benedicte","Pries-Heje, Jan"],"cuid":["S01-000.00-755234"],"event":{"end":"2024-01-06","place":"Honolulu, us","start":"2024-01-03","title":"57th Annual Hawaii International Conference on System Sciences, HICSS 2024","year":"2024"},"filters":{"added":"2024-09","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","Georgia State University"],"keyword":["Cybersecurity","Digitalization","Historical research","Paradox","eGovernment"],"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-RUC"]},"level3all":["DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"the digital empowerment paradox the experience in denmark","src":["ruc"],"src-code":["DI-U-RUC"],"type":"dcp","type-grp":["all","pub"]},"id":"S01-000.00-755234","identifier":[{"id":"85199810019","type":"scopus"}],"ids":["ruc-ac625516-8791-4971-9842-6e2732c321b5"],"keyword":["cybersecurity","digitalization","eGovernment","historical research","paradox"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Global-Local-2-3-0E5ECD68090020DA36F4ABD4969BCE79"],"org":[{"affno":"1","country":"us","key":"georgia state university","loc":["United States","America, North","OECD"],"name":"Georgia State University","used":1},{"affno":"2","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of People and Technology","Roskilde University, Department of People and Technology, Sustainable Digitalization"],"nora_code":"DI-U-RUC","used":1}],"person":[{"affno":"1","first":"Richard","key":"baskervillepau","last":"Baskerville","name":"Baskerville, Richard","rank":1,"rolecode":"pau"},{"affno":"2","country":"dk","first":"Benedicte","key":"fleronpau","last":"Fleron","locid":"1eac1461-da4c-47d8-9661-106a1a39ae9f","name":"Fleron, Benedicte","orcid":"0009-0002-6000-9923","rank":2,"rolecode":"pau"},{"affno":"2","country":"dk","first":"Jan","key":"prieshejepau","last":"Pries-Heje","locid":"6dbca1cc-ed5b-479e-be59-0cf0ae86a2a8","name":"Pries-Heje, Jan","rank":3,"rolecode":"pau"},{"affno":"","first":"Tung X.","key":"buipedh","last":"Bui","name":"Bui, Tung X.","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"eisbn":["9780998133171"],"issn":["15301605"],"pages":"1891-1900","publisher":"IEEE Computer Society Press","series":"Proceedings of the Annual Hawaii International Conference on System Sciences","status":"p","title":"Proceedings of the 57th Annual Hawaii International Conference on System Sciences, HICSS 2024"},"review":"Peer Reviewed","sco