versen","locid":"558df261-ca9f-440a-8bee-7d38813c253f","name":"Iversen, Kasper","rank":22,"rolecode":"pau"},{"affno":"1 2","first":"Peter","key":"garredpau","last":"Garred","locid":"854d72a7-c955-43b5-b455-b7ea1f9bcb1e","name":"Garred, Peter","rank":23,"rolecode":"pau"},{"affno":"1 2","first":"Susanne Dam","key":"nielsenpau","last":"Nielsen","locid":"2baa36fa-2709-482a-9595-52c5b9537801","name":"Nielsen, Susanne Dam","rank":24,"rolecode":"pau"}],"pmid":["39715497"],"pub":{"doi":"10.1097/qad.0000000000004026","issn":["02699370"],"issue":"15","journal":"AIDS","pages":"2100-2103","status":"p","title":"AIDS","volume":"38"},"review":"Peer Reviewed","scoID":["2-s2.0-85213870234"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-d5e15d13-ad58-423f-aa67-666c87bd44e3"],"src":["KU University of Copenhagen"],"title":"Humoral response 24 months after the first COVID-19 vaccination in people with HIV with and without diabetes","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-791056","year":"2024","yearsub":"2024"}
{"abstract":"Cost performance for major infrastructure projects continues to be challenging for countries and governments experiencing large cost overruns. Major public IT projects may be particularly vulnerable to cost overrun and combined with the increasing digitalization of the public sectors, this creates a challenging arena for countries and governments. This also applies to Denmark and Norway where major public IT projects have large differences in cost overruns. We investigated nine Danish and seven Norwegian major public IT projects of considerable size together with the national governance structures for major public IT projects in Denmark and Norway. The study shows a significant difference in cost overrun: Norway has an average of 8% while Denmark has 108%. The maximum cost overrun is 84% for Norwegian projects and 414% for Danish ones. The reasons for the results are analyzed and discussed and include, among other things, differences in governance structures and cost estimation methods. The results and analysis are relevant for policymaking, practice, and research, especially learning across countries.","author_count":4,"contributors":["Svejvig, Per","Welde, Morten","Pries-Heje, Jan","Kaas Ollendorff, Natasha"],"cuid":["S02-091.38-793256"],"event":{"end":"2024-06-13","place":"Stockholm, se","start":"2024-06-12","title":"IRNOP 2024 conference (15th)","year":"2024"},"filters":{"added":"2024-05","altsrc":["No Matches Found"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"continent":["Europe, Non-EU","Nordic","OECD"],"country":["Norway"],"glorg":["All Global Affiliations","Norwegian University of Science and Technology"],"level":"sci","mra":["sci","soc"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-RUC"]},"level3all":["DI-U-AU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"cost performance in major public it projects a cross country comparison between denmark and norway","src":["au","ruc"],"src-code":["DI-U-AU","DI-U-RUC"],"type":"dcp","type-grp":["all","pub"]},"id":"S02-091.38-793256","ids":["au-55c4ecf0-6698-4c60-8ede-2ed84dea6f92","ruc-50e50a6d-4b8d-4e94-822b-3589ef282ce5"],"lang":"English","level":"Scientific","mra":["Science/Technology","Social Science"],"noi":["Local-1-2-F2DDC9AD6BCD6DFF8373043C1DBD37AA"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus BSS, Department of Management"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of People and Technology","Roskilde University, Department of People and Technology, Sustainable Digitalization"],"nora_code":"DI-U-RUC","used":1},{"affno":"3","country":"no","key":"norwegian university of science and technology","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"Norwegian University of Science and Technology","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Per","key":"svejvigpau","last":"Svejvig","locid":"40558617-c35b-464e-a0f6-7a2940494271","name":"Svejvig, Per","orcid":"0000-0002-8758-4031","rank":1,"rolecode":"pau"},{"affno":"2","country":"dk","first":"Jan","key":"prieshejepau","last":"Pries-Heje","locid":"6dbca1cc-ed5b-479e-be59-0cf0ae86a2a8","name":"Pries-Heje, Jan","rank":1,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Morten","key":"weldepau","last":"Welde","name":"Welde, Morten","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Natasha","key":"kaasollendorffpau","last":"Kaas Ollendorff","name":"Kaas Ollendorff, Natasha","rank":4,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Roskilde University","Universities"],"PST":["Published"]},"sid":["au-55c4ecf0-6698-4c60-8ede-2ed84dea6f92","ruc-50e50a6d-4b8d-4e94-822b-3589ef282ce5"],"src":["AU Aarhus University","RUC Roskilde University"],"title":"Cost Performance in Major Public IT Projects: A Cross-Country Comparison Between Denmark and Norway","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-091.38-793256","year":"2024","yearsub":"2024"}
{"abstract":"Cities worldwide are engaging in smart city digital transformation. However, delivering sustainable improvements while pursuing high-level transformational goals is highly complex. Based on interviews with smart city leaders, we identify eight challenges to sustaining and scaling-up smart city transformation. These challenges are underpinned by a clash between traditional institutional city logic and emerging smart city logic. We describe three boundary management strategies for addressing this clash and the associated challenges, and provide a framework to help smart city leaders select appropriate boundary management strategies","author_count":2,"contributors":["Cranefield, Jocelyn","Pries-Heje, Jan"],"cuid":["S01-000.00-572119"],"filters":{"added":"2023-03","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["OECD","Oceania"],"country":["New Zealand"],"glorg":["All Global Affiliations","Victoria University of Wellington"],"keyword":["Digital technology","Digital transformation","Institutional logic","Smart cities"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-RUC"]},"level3all":["DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"boundary management strategies for leading digital transformation in smart cities","src":["ruc"],"src-code":["DI-U-RUC"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/109006056/Cranefield_Pries-Heje_2022_-_Smart_City_Boundary_Strategies_-_Last_version_before_publishing.pdf","version":"Authors Final Version"},"id":"S01-000.00-572119","ids":["ruc-efb9cb9c-300c-4762-9533-93e59db39d20"],"keyword":["Cities & towns","Digital technology","Institutional logic","Smart cities","digital transformation"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-2ADE94ADA55BBB0B2A021DB9E3DB4A6E"],"oa_link":[{"access":"oa","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/109006056/Cranefield_Pries-Heje_2022_-_Smart_City_Boundary_Strategies_-_Last_version_before_publishing.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","country":"nz","key":"victoria university of wellington","loc":["New Zealand","Oceania","OECD"],"name":"Victoria University of Wellington","used":1},{"affno":"2","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of People and Technology"],"nora_code":"DI-U-RUC","used":1}],"person":[{"affno":"1","first":"Jocelyn","key":"cranefieldpau","last":"Cranefield","name":"Cranefield, Jocelyn","rank":1,"rolecode":"pau"},{"affno":"2","country":"dk","first":"Jan","key":"prieshejepau","last":"Pries-Heje","locid":"6dbca1cc-ed5b-479e-be59-0cf0ae86a2a8","name":"Pries-Heje, Jan","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.17705/2msqe.00077","issn":["15401960","15401979"],"issn_org":["15401960"],"issue":"2","journal":"MIS Quarterly Executive","pages":"129-146","status":"p","title":"MIS Quarterly Executive","volume":"22"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Roskilde University","Universities"],"PST":["Published"]},"sid":["ruc-efb9cb9c-300c-4762-9533-93e59db39d20"],"src":["RUC Roskilde University"],"title":"Boundary Management Strategies for Leading Digital Transformation in Smart Cities","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-572119","year":"2023","yearsub":"2023"}
{"abstract":"A symptom is a feature which is regarded as indicating a condition or disease. For an organization a symptom may indicate a problematic condition. Based on 600 maturity CMMI assessments we identified 32 common symptoms across the organizations. We developed a web site with a survey instrument asking 44 companies whether they recognized the symptoms? Thus, from this survey we know which symptoms are common and which ones that rarely are perceived to be present. We then analyzed the symptoms using the Cognitive Maps techniques and identified consequences and root causes for each symptom. We also identified relationships between the symptoms and presented a map thereof. Further, we mapped the root causes from the cognitive maps to CMMI and the recommendations to improve. Finally, we discuss whether and how one can use the symptoms to make recommendations for improvements as a kind of “discount improvement model”. We conclude with an example of the intended use.","author_count":8,"contributors":["Pries-Heje, Jan","Johansen, Jørn","Korsaa, Morten","Cristian Riis, Hans"],"cuid":["S01-000.00-830629"],"event":{"acronym":"EuroSPI","end":"2023-09-01","place":"Grenoble, fr","start":"2023-08-30","title":"30th European Conference on Systems, Software and Services Process Improvement","year":"2023"},"filters":{"added":"2025-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["CMMI","Cognitive map","Improvement","Maturity","Process improvement"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-RUC"]},"level3all":["DI-PR-OTH","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"process improvement based on symptom analysis","src":["ruc"],"src-code":["DI-U-RUC"],"type":"dcp","type-grp":["all","pub"]},"id":"S01-000.00-830629","identifier":[{"id":"85172161047","type":"scopus"}],"ids":["ruc-76b1dcdf-2f1a-4857-a8cf-d5da1f7ef5c2"],"keyword":["CMMI","Cognitive map","Improvement","Maturity","Process Improvement"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-E6E96A3F634E28432B205FCA778E8044"],"org":[{"affno":"1","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of People and Technology","Roskilde University, Department of People and Technology, Sustainable Digitalization"],"nora_code":"DI-U-RUC","used":1},{"affno":"2","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["Whitebox"],"nora_code":"DI-PR-OTH","used":1}],"person":[{"affno":"1","country":"dk","first":"Jan","key":"prieshejepau","last":"Pries-Heje","locid":"6dbca1cc-ed5b-479e-be59-0cf0ae86a2a8","name":"Pries-Heje, Jan","rank":1,"rolecode":"pau"},{"affno":"2","first":"Jørn","key":"johansenpau","last":"Johansen","name":"Johansen, Jørn","rank":2,"rolecode":"pau"},{"affno":"2","first":"Morten","key":"korsaapau","last":"Korsaa","name":"Korsaa, Morten","rank":3,"rolecode":"pau"},{"affno":"2","first":"Hans","key":"cristianriispau","last":"Cristian Riis","name":"Cristian Riis, Hans","rank":4,"rolecode":"pau"},{"affno":"","first":"Murat","key":"yilmazpedh","last":"Yilmaz","name":"Yilmaz, Murat","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Paul","key":"clarkepedh","last":"Clarke","name":"Clarke, Paul","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Andreas","key":"rielpedh","last":"Riel","name":"Riel, Andreas","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Richard","key":"messnarzpedh","last":"Messnarz","name":"Messnarz, Richard","rank":8,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-031-42307-9_20","eisbn":["9783031423079"],"isbn":["9783031423062"],"issn":["18650929"],"pages":"273-286","publisher":"Springer","series":"Communications in Computer and Information Science","status":"p","subtitle":"30th European Conference, EuroSPI 2023, Proceedings","title":"Systems, Software and Services Process Improvement"},"review":"Peer Reviewed","scoID":["2-s2.0-85172161047"],"search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Other Companies","Private Research","Roskilde University","Universities","whitebox"],"PST":["Published"]},"sid":["ruc-76b1dcdf-2f1a-4857-a8cf-d5da1f7ef5c2"],"src":["RUC Roskilde University"],"title":"Process Improvement Based on Symptom Analysis","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-830629","year":"2023","yearsub":"2023"}
{"abstract":"Transformative artificially intelligent tools, such as ChatGPT, designed to generate sophisticated text indistinguishable from that produced by a human, are applicable across a wide range of contexts. The technology presents opportunities as well as, often ethical and legal, challenges, and has the potential for both positive and negative impacts for organisations, society, and individuals. Offering multi-disciplinary insight into some of these, this article brings together 43 contributions from experts in fields such as computer science, marketing, information systems, education, policy, hospitality and tourism, management, publishing, and nursing. The contributors acknowledge ChatGPT’s capabilities to enhance productivity and suggest that it is likely to offer significant gains in the banking, hospitality and tourism, and information technology industries, and enhance business activities, such as management and marketing. Nevertheless, they also consider its limitations, disruptions to practices, threats to privacy and security, and consequences of biases, misuse, and misinformation. However, opinion is split on whether ChatGPT’s use should be restricted or legislated. Drawing on these contributions, the article identifies questions requiring further research across three thematic areas: knowledge, transparency, and ethics; digital transformation of organisations and societies; and teaching, learning, and scholarly research. The avenues for further research include: identifying skills, resources, and capabilities needed to handle generative AI; examining biases of generative AI attributable to training datasets and processes; exploring business and societal contexts best suited for generative AI implementation; determining optimal combinations of human and generative AI for various tasks; identifying ways to assess accuracy of text produced by generative AI; and uncovering the ethical and legal issues in using generative AI across different contexts.","author_count":73,"contributors":["Dwivedi, Yogesh","Kshetri, Nir","Hughes, Laurie","Slade, Emma Louise","Jeyaraj, Anand","Kar, Arpan Kumar","Baabdullah, Abdullah M.","Koohang, Alex","Raghavan, Vishnupriya","Ahuja, Manju","Albanna, Hanaa","Albashrawi, Mousa Ahmad","Al-Busaidi, Adil S.","Balakrishnan, Janarthanan","Barlette, Yves","Basu, Sriparna","Bose, Indranil","Brooks, Laurence","Buhalis, Dimitrios","Carter, Lemuria","Chowdhury, Soumyadeb","Crick, Tom","Cunningham, Scott W.","Davies, Gareth H.","Davison, Robert M.","Dé, Rahul","Dennehy, Denis","Duan, Yanqing","Dubey, Rameshwar","Dwivedi, Rohita","Edwards, John S.","Flavián, Carlos","Gauld, Robin","Grover, Varun","Hu, Mei-Chih","Janssen, Marijn","Jones, Paul","Junglas, Iris","Khorana, Sangeeta","Kraus, Sascha","Larsen, Kai R.","Latreille, Paul","Laumer, Sven","Malik, F. Tegwen","Mardani, Abbas","Mariani, Marcello","Mithas, Sunil","Mogaji, Emmanuel","Nord, Jeretta Horn","O'Connor, Siobhan","Okumus, Fevzi","Pagani, Margherita","Pandey, Neeray","Papagiannidis, Savvas","Pappas, Ilias O.","Pathak, Nishith","Pries-Heje, Jan","Raman, Ramakrishnan","Rana, Nripenda P.","Rehm, Sven-Volker","Ribeiro-Navarrete, Samuel","Richter, Alexander","Rowe, Frantz","Sarker, Suprateek","Stahl, Bernd Carsten","Tiwari, Manoj Kumar","van der Aalst, Wil","Venkatesh, Viswanath","Viglia, Giampaolo","Wade, Michael","Walton, Paul","Wirtz, Jochen","Wright, Ryan"],"cuid":["S01-000.00-560418"],"filters":{"added":"2023-05","altsrc":["Global Data"],"author_count":"51-200 contributors","cluster_size":1,"continent":["Africa","America, North","Asia, East","Asia, Middle East","Asia, South","Europe, EU","Europe, Non-EU","Nordic","OECD","Oceania"],"country":["Australia","France","Germany","Hong Kong","India","Italy","Netherlands","New Zealand","Norway","Oman","Poland","Qatar","Saudi Arabia","Singapore","South Africa","Spain","Switzerland","Taiwan","United Kingdom","United States"],"glorg":["All Global Affiliations","Aston Business School","Bournemouth Uni