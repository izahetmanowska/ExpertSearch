{"author_count":5,"contributors":["Hagedorn-Rasmussen, Peter","Pries-Heje, Jan","Bødker, Keld","Elsborg, Steen","Scheuer, John Damm"],"cuid":["S01-000.00-571524"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["soc"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-RUC"]},"level3all":["DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"robust organisationsforandring design og implementering i orkanens øje","src":["ruc"],"src-code":["DI-U-RUC"],"type":"db","type-grp":["all","pub"]},"id":"S01-000.00-571524","ids":["ruc-e70d6b85-08a8-4407-b260-4e502e2d4027"],"lang":"Danish","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-3CFB6BA0895127169F4F740B74E7886A"],"org":[{"affno":"1","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of People and Technology","Roskilde University, Department of People and Technology, Organization, Ethics & Social Sustainability","Roskilde University, Department of People and Technology, Working Life"],"nora_code":"DI-U-RUC","used":1}],"person":[{"affno":"1","country":"dk","first":"Peter","key":"hagedornrasmussenped","last":"Hagedorn-Rasmussen","locid":"cccef43a-82d0-4805-bddb-42ee8de3b6c2","name":"Hagedorn-Rasmussen, Peter","rank":1,"role":"Editor","rolecode":"ped"},{"affno":"1","country":"dk","first":"Jan","key":"prieshejeped","last":"Pries-Heje","locid":"6dbca1cc-ed5b-479e-be59-0cf0ae86a2a8","name":"Pries-Heje, Jan","rank":2,"role":"Editor","rolecode":"ped"},{"affno":"1","country":"dk","first":"Keld","key":"bødkerped","last":"Bødker","locid":"215aba14-144b-4bec-aba1-c4e93cd7f07f","name":"Bødker, Keld","orcid":"0000-0001-7938-0277","rank":3,"role":"Editor","rolecode":"ped"},{"affno":"1","country":"dk","first":"Steen","key":"elsborgped","last":"Elsborg","locid":"72cddadb-f34f-4e4e-93a2-17799d04098e","name":"Elsborg, Steen","rank":4,"role":"Editor","rolecode":"ped"},{"affno":"1","country":"dk","first":"John Damm","key":"scheuerped","last":"Scheuer","locid":"8e76bd10-35fb-4c67-900f-e0a61bf8c797","name":"Scheuer, John Damm","rank":5,"role":"Editor","rolecode":"ped"}],"pub":{"isbn":["9788759323977"],"pages":"250","place":"Frederiksberg","publisher":"Samfundslitteratur","status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Roskilde University","Universities"],"PST":["Published"]},"sid":["ruc-e70d6b85-08a8-4407-b260-4e502e2d4027"],"src":["RUC Roskilde University"],"title":"Robust organisationsforandring : Design og implementering i orkanens øje","type":"Book","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-571524","year":"2016","yearsub":"2016"}
{"abstract":"Evaluation of design artefacts and design theories is a key activity in Design Science Research (DSR), as it provides feedback for further development and (if done correctly) assures the rigour of the research. However, the extant DSR literature provides insufficient guidance on evaluation to enable Design Science Researchers to effectively design and incorporate evaluation activities into a DSR project that can achieve DSR goals and objectives. To address this research gap, this research paper develops, explicates, and provides evidence for the utility of a Framework for Evaluation in Design Science (FEDS) together with a process to guide design science researchers in developing a strategy for evaluating the artefacts they develop within a DSR project. A FEDS strategy considers why, when, how, and what to evaluate. FEDS includes a two-dimensional characterisation of DSR evaluation episodes (particular evaluations), with one dimension being the functional purpose of the evaluation (formative or summative) and the other dimension being the paradigm of the evaluation (artificial or naturalistic). The FEDS evaluation design process is comprised of four steps: (1) explicate the goals of the evaluation, (2) choose the evaluation strategy or strategies, (3) determine the properties to evaluate, and (4) design the individual evaluation episode(s). The paper illustrates the framework with two examples and provides evidence of its utility via a naturalistic, summative evaluation through its use on an actual DSR project.","author_count":3,"contributors":["Venable, John","Pries-Heje, Jan","Baskerville, Richard"],"cuid":["S02-090.00-038274"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"continent":["America, North","OECD","Oceania"],"country":["Australia","United States"],"glorg":["All Global Affiliations","Curtin University","Georgia State University"],"keyword":["Design science research","Evaluation","Evaluation method","Evaluation strategy","Information systems","Research Design","Research methodology","information systems evaluation"],"level":"sci","mra":["hum","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-RUC"]},"level3all":["DI-U-ITU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"feds a framework for evaluation in design science research","src":["itu","ruc"],"src-code":["DI-U-ITU","DI-U-RUC"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1057/ejis.2014.36","version":"Published Version"},"id":"S02-090.00-038274","identifier":[{"id":"84959456148","type":"scopus"}],"ids":["itu-24603506-a58d-4550-bca0-d366c5393070","ruc-1485c0fb-77c9-41b1-9051-0f92b7e01b18"],"keyword":["Design science research","artefact evaluation","evaluation","evaluation method","evaluation strategy","information systems","information systems evaluation","research design","research methodology","utility evaluation"],"lang":"English","level":"Scientific","mra":["Humanities","Science/Technology"],"noi":["Global-Local-2-5-37C0D22FE0D46800F55BF6DB23B8B1D6"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1057/ejis.2014.36","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/58874543/art_10.1057_ejis.2014.36.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Humanities (HUM)","Science / Technology (SCI)"],"yearPub":"2015","yearSub":2015},"org":[{"affno":"1","country":"au","key":"curtin university","loc":["Australia","Oceania","OECD"],"name":"Curtin University","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT"],"nora_code":"DI-U-ITU","used":1},{"affno":"3","country":"dk","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University"],"nora_code":"DI-U-RUC","used":1},{"affno":"4","country":"us","key":"georgia state university","loc":["United States","America, North","OECD"],"name":"Georgia State University","used":1}],"person":[{"affno":"1","first":"John","key":"venablepau","last":"Venable","name":"Venable, John","rank":1,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"country":"dk","first":"Jan","key":"prieshejepau","last":"Pries-Heje","name":"Pries-Heje, Jan","rank":2,"rolecode":"pau"},{"affno":"4","first":"Richard","key":"baskervillepau","last":"Baskerville","name":"Baskerville, Richard","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1057/ejis.2014.36","issn":["0960085X","14769344"],"issn_org":["0960085X"],"issue":"1","journal":"European Journal of Information Systems","pages":"77-89","status":"p","title":"European Journal of Information Systems","volume":"25"},"review":"Peer Reviewed","scoID":["2-s2.0-84959456148"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Roskilde University","Universities"],"PST":["Published"]},"sid":["itu-24603506-a58d-4550-bca0-d366c5393070","ruc-1485c0fb-77c9-41b1-9051-0f92b7e01b18"],"src":["ITU IT University of Copenhagen","RUC Roskilde University"],"title":"FEDS : A Framework for Evaluation in Design Science Research","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-090.00-038274","year":2016,"yearsub":2016}
{"abstract":"The rising number of major public IT projects is mirrored by a growing research interest in the management of such projects. Both can benefit from a more complete understanding of project governance that should lead to a practical framework for project governance. The present paper proposes such a framework. It was developed from the literature on major and mega-projects, both public and private, that concern infrastructure, engineering and IT. The proposed framework for project governance comprises six major elements: governance structure, management approach, stakeholders, value, systems integration and complexity. Empirical research has identified a number of characteristics for these project governance elements. In the second part of the paper the framework was tested in a case study of the Danish smart card Rejsekort project. The framework was found to be robust, and that in this case important questions relating to stakeholders and dynamic complexity needed greater attention for the project to be successful.","author_count":5,"contributors":["Riis, Eva","Harboe, Peter Georg"],"cuid":["S02-096.00-049538"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Framework","Project governance","Project management"],"level":"sci","mra":["soc"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U","DI-UC"],"level3":{"U":["DI-U-ALL","DI-U-SDU"],"UC":["DI-UC-ALL","DI-UC-VIA"]},"level3all":["DI-U-SDU","DI-UC-VIA"]},"review":"pr","rtype":["clu"],"sorti":"a framework for project governance in major public it projects","src":["sdu","via"],"src-code":["DI-U-SDU","DI-UC-VIA"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://samfundslitteratur.dk/bog/project-management-achieving-change","version":"Other Version"},"id":"S02-096.00-049538","ids":["sdu-d117ad1b-4045-4e7c-8e24-80769fd90d84","via-fab48470-043b-4d1a-b762-08048985815d"],"keyword":[", major public IT projects","Framework","Project governance","project management"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Local-1-2-70867A54018A940CC81BCA3BA1265CEF"],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Business and Social Sciences, Department of Business & Management (DBM)","SDU, The Faculty of Business and Social Sciences, Department of Business & Management (DBM), Centre for Integrative Innovation Management"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","key":"via university college","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-VIA","l3nl":"VIA University College","l3nn":"VIA University College","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"VIA University College","namevar":["VIA, Efter- og videreuddannelse og digitalisering, Efter- og videreuddannelse"],"nora_code":"DI-UC-VIA","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Eva","key":"riispau","last":"Riis","locid":"b3ba2d53-b280-4404-97c7-57d6a66f094d","name":"Riis, Eva","orcid":"0000-0003-3651-4241","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Peter Georg","key":"harboepau","last":"Harboe","locid":"a36db0bf-d28d-43ba-a19f-caa01e82e56b","name":"Harboe, Peter Georg","orcid":"0000-0001-9267-3955","rank":1,"rolecode":"pau"},{"affno":"","first":"Jan","key":"prieshejepedh","last":"Pries-Heje","name":"Pries-Heje, Jan","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Jan Pries","key":"hejepedh","last":"Heje","name":"Heje, Jan Pries","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Per","key":"svejvigpedh","last":"Svejvig","name":"Svej