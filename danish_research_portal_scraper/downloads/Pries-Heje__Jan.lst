-U","DI-U-ALL","Other Companies","Private Research","Roskilde University","Universities","mannaz a/s"],"PST":["Published"]},"sid":["ruc-7fb2c73d-da4a-4614-a443-992f85a37012"],"src":["RUC Roskilde University"],"title":"Metoder, teknikker og udfordringer","type":"Report Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-564563","year":"2018","yearsub":"2018"}
{"abstract":"I dette kapitel ser vi på, hvilke udfordringer der er ved distribuerede projektteams – forstået som et projekt, der gennemføres på flere geografiske lokationer. Det kan være to lokationer i Danmark, men det kan også være flere lokationer med store forskelle i geografi, tid, kultur og meget andet – altså et projektteam med op til flere tusind kilometer mellem deltagerne. Alligevel skal de spredte deltagere arbejde sammen som et projektteam.","author_count":6,"contributors":["Pries-Heje, Jan","Bødker, Keld"],"cuid":["S01-000.00-571599"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-RUC"]},"level3all":["DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"distribuerede projekter","src":["ruc"],"src-code":["DI-U-RUC"],"type":"dra","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://www.mannaz.com/da/konsulentydelser/program-og-projektledelse/projektlederundersoegelsen-2018/","version":"Published Version"},"id":"S01-000.00-571599","ids":["ruc-e824a20e-711c-4c7e-bce0-04790d408fef"],"lang":"Danish","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-B0BFA121EB225B6BD88E46D86CC9E314"],"oa_link":[{"access":"oa","type":"rem","url":"https://www.mannaz.com/da/konsulentydelser/program-og-projektledelse/projektlederundersoegelsen-2018/","version":"Published Version"}],"org":[{"affno":"1","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of People and Technology","Roskilde University, Department of People and Technology, User-Driven IT Innovation"],"nora_code":"DI-U-RUC","used":1}],"person":[{"affno":"1","country":"dk","first":"Jan","key":"prieshejepau","last":"Pries-Heje","locid":"6dbca1cc-ed5b-479e-be59-0cf0ae86a2a8","name":"Pries-Heje, Jan","rank":1,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Keld","key":"bødkerpau","last":"Bødker","locid":"215aba14-144b-4bec-aba1-c4e93cd7f07f","name":"Bødker, Keld","orcid":"0000-0001-7938-0277","rank":2,"rolecode":"pau"},{"affno":"","first":"Dirk Bredgaard","key":"buckalassenpedh","last":"Bucka-Lassen","name":"Bucka-Lassen, Dirk Bredgaard","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Frank Mogens","key":"mikkelsenpedh","last":"Mikkelsen","name":"Mikkelsen, Frank Mogens","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Jan","key":"prieshejepedh","last":"Pries-Heje","name":"Pries-Heje, Jan","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Keld","key":"bødkerpedh","last":"Bødker","name":"Bødker, Keld","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"pages":"33-38","place":"Hørsholm","publisher":"Mannaz AS","publisher_org":"Mannaz A/S","status":"p","subtitle":"Projektlederundersøgelsen 2018","title":"Hvordan går det ProjektDanmark?"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Roskilde University","Universities"],"PST":["Published"]},"sid":["ruc-e824a20e-711c-4c7e-bce0-04790d408fef"],"src":["RUC Roskilde University"],"title":"Distribuerede projekter","type":"Report Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-571599","year":"2018","yearsub":"2018"}
{"abstract":"User-based redesign after implementation has been studied in many contexts gone by many different names, such as appropriation of technology, malleable design and secondary design. The phenomenon of redesigning content has mainly revolved around technologies such as Facebook, Twitter, or Wikipedia or portal-based technology with configuration abilities, with very little focus on technologies where users can change both functionality, content and the level of technology complexity. We coin this type of secondary design deep secondary design. In this paper, we investigate how to enable deep secondary design by analyzing two cases where secondary designers fundamentally change functionality, content and technology complexity level. The first case redesigns a decision model for agile development in an insurance company; the second creates a contingency model for choosing project management tools and techniques in a hospital. Our analysis of the two cases leads to the identification of four principles of design implementation that primary designers can apply to enable secondary design and four corresponding design implementation principles that secondary designers themselves need to apply.","author_count":6,"contributors":["Pries-Heje, Jan","Hansen, Magnus Rotvit Perlt"],"cuid":["S01-000.00-557447"],"event":{"end":"2017-08-09","place":"Halden, no","start":"2017-08-06","title":"8th Scandinavian Conference on Information Systems","year":"2017"},"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Case study","Design theory","Principles","Secondary design"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-RUC"]},"level3all":["DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"principles for enabling deep secondary design","src":["ruc"],"src-code":["DI-U-RUC"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/63864119/principles_for_enabling_deep_secondary_design.pdf","version":"Published Version"},"id":"S01-000.00-557447","identifier":[{"id":"85028348316","type":"scopus"}],"ids":["ruc-15ca3fca-8134-4d5c-807d-b6a98296d980"],"keyword":["Case study","Design theory","Principles","Secondary design"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-0F1D968AF6463002BC605ADE762B5941"],"oa_link":[{"access":"oa","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/63864119/principles_for_enabling_deep_secondary_design.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of People and Technology","Roskilde University, Department of People and Technology, User-Driven IT Innovation"],"nora_code":"DI-U-RUC","used":1}],"person":[{"affno":"1","country":"dk","first":"Jan","key":"prieshejepau","last":"Pries-Heje","locid":"6dbca1cc-ed5b-479e-be59-0cf0ae86a2a8","name":"Pries-Heje, Jan","rank":1,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Magnus Rotvit Perlt","key":"hansenpau","last":"Hansen","locid":"d9c2134a-0799-45eb-8a15-e0523fc96da2","name":"Hansen, Magnus Rotvit Perlt","rank":2,"rolecode":"pau"},{"affno":"","first":"Susanne","key":"stigbergpedh","last":"Stigberg","name":"Stigberg, Susanne","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Joackim","key":"karlsenpedh","last":"Karlsen","name":"Karlsen, Joackim","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Harald","key":"holonepedh","last":"Holone","name":"Holone, Harald","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Cathrine","key":"linnespedh","last":"Linnes","name":"Linnes, Cathrine","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-319-64695-4_6","eisbn":["9783319646954"],"isbn":["9783319646954"],"issn":["18651348"],"pages":"67-82","publisher":"Springer","series":"Lecture Notes in Business Information Processing","status":"p","subtitle":"8th Scandinavian Conference on Information Systems","title":"Nordic Contributions in IS Research"},"review":"Peer Reviewed","scoID":["2-s2.0-85028348316"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Roskilde University","Universities"],"PST":["Published"]},"sid":["ruc-15ca3fca-8134-4d5c-807d-b6a98296d980"],"src":["RUC Roskilde University"],"title":"Principles for enabling deep secondary design","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-557447","year":"2017","yearsub":"2017"}
{"abstract":"This workshop is an applied tutorial, aimed at novice and experienced researchers who wish to learn more about Design Science Research (DSR) and/or to develop and progress their own DSR work. During the workshop, attendees will be introduced to various DSR concepts and current trends, to create a coherent perspective on DSR and its relationship to other research paradigms. Attendees will also be introduced to three specific and applied techniques for planning and conducting DSR, which were developed by the workshop organisers. When covering the applied techniques and tools, both to further attendees’ learning and to develop their research, attendees will be invited to apply the techniques to their own ongoing, planned, or potential DSR research projects. The organisers have developed workbooks that the attendees can use to carry out practical exercises and take them away afterwards. The workshop organisers will be on hand to assist participants in planning their research and answering questions about the application of the techniques to the participants’ own research.","author_count":3,"contributors":["Pries-Heje, Jan","Venable, John","Baskerville, Richard L."],"cuid":["S01-000.00-560015"],"event":{"end":"2017-06-10","place":"Guimaraes, pt","start":"2017-06-05","title":"European Conference on Information Systems (ECIS)","year":"2017"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","OECD","Oceania"],"country":["Australia","United States"],"glorg":["All Global Affiliations","Curtin University","Georgia State University"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-RUC"]},"level3all":["DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"design science research a hands on tutorial","src":["ruc"],"src-code":["DI-U-RUC"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://aisel.aisnet.org/ecis2017/","version":"Published Version"},"id":"S01-000.00-560015","ids":["ruc-3be7f650-f792-4aae-98f4-a7ca9e11e4af"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-ECFD224686E8164F630D512B98284C98"],"oa_link":[{"access":"oa","type":"rem","url":"http://aisel.aisnet.org/ecis2017/","version":"Published Version"}],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of People and Technology","Roskilde University, Department of People and Technology, User-Driven IT Innovation"],"nora_code":"DI-U-RUC","used":1},{"affno":"2","country":"au","key":"curtin university","loc":["Australia","Oceania","OECD"],"name":"Curtin University","used":1},{"affno":"3","country":"us","key":"georgia state university","loc":["United States","America, North","OECD"],"name":"Georgia State University","used":1}],"person":[{"affno":"1","country":"dk","first":"Jan","key":"prieshejepau","last":"Pries-Heje","locid":"6dbca1cc-ed5b-479e-be59-0cf0ae86a2a8","name":"Pries-Heje, Jan","rank":1,"rolecode":"pau"},{"affno":"2","first":"John","key":"venablepau","last":"Venable","name":"Venable, John","rank":2,"rolecode":"pau"},{"affno":"3","first":"Richard L.","key":"baskervillepau","last":"Baskerville","name":"Baskerville, Richard L.","rank":3,"rolecode":"pau"}],"pub":{"issn":["00000034"],"publisher":"ECIS, European Conference on Information Systems","series":"Proceedings of the European Conference on Information Systems","status":"p","subtitle":"Electronic Proceedings","title":"European Conference on Information Systems (ECIS'2017)"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Roskilde University","Universities"],"PST":["Published"]},"sid":["ruc-3be7f650-f792-4aae-98f4-a7ca9e11e4af"],"src":["RUC Roskilde University"],"title":"Design Science Research : A Hands-on Tutorial","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-560015","year":"2017","yearsub":"2017"}
{"abstract":"Design Science Research (DSR) is a popular new research approach and paradigm, for which a number of research methodologies have been developed. One of the challenges facing researchers wanting to apply this new approach is the choice of research methodology. In this paper we give an account of six DSR methodologies and we compare them using a Design Science Research Methodology Comparison Framework that we adapted from an existing Information Systems Development Methodology Comparison Framework. Based on the outcomes of the comparison, we develop a set of technological rules that forms a contingency-based framework to support Design Science Researchers in choosing an appropriate and well-suited DSR methodology, depending on the contingencies of the situation at hand.","author_count":3,"contributors":["Venable, John R.","Pries-Heje, Jan","Baskerville, Richard"],"cuid":["S01-000.00-568029"],"event":{"acronym":"ICIS","end":"2017-12-06","place":"Hobart, au","start":"2017-12-04","title":"28th Australasian Conference on Information Systems","year":"2017"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","OECD","Oceania"],"country":["Australia","United States"],"glorg":["All Global Affiliations","Curtin University","Georgia State University"],"keyword":["Design Science Research DSR","Design science research methodology","Design theory","Research Design"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-RUC"]},"level3all":["DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"choosing a design science research methodology","src":["ruc"],"src-code":["DI-U-RUC"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/61055477/ACIS2017_paper_255_FULL.pdf","version":"Published Version"},"id":"S01-0