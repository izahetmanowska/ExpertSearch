","name":"Wareham, Jonathan","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Xavier","key":"busquetspedh","last":"Busquets","name":"Busquets, Xavier","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Josep","key":"valorpedh","last":"Valor","name":"Valor, Josep","rank":8,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Sandra","key":"seiberpedh","last":"Seiber","name":"Seiber, Sandra","rank":9,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"eisbn":["9788488971548"],"issn":["00000034"],"place":"Atlanta, GA","publisher":"Association for Information Systems. AIS Electronic Library (AISeL)","series":"Proceedings of the European Conference on Information Systems","status":"p","title":"ECIS 2012 Proceedings"},"review":"Peer Reviewed","scoID":["2-s2.0-84905758035"],"search":{"DAF":["All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["cbs-fbe6dd5d-d3a5-4ad8-81a8-bbac05ea5d25"],"src":["CBS Copenhagen Business School"],"title":"Crowdpushing : The Flip Side of Crowdsourcing","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-299460","year":"2012","yearsub":"2012"}
