ies"],"PST":["Published"]},"sid":["ruc-b3851179-4ef1-4995-bec8-d0a93e49d457"],"src":["RUC Roskilde University"],"title":"Choosing a Design Science Research Methodology","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-568029","year":"2017","yearsub":"2017"}
{"abstract":"Knowledge networks enable businesses to enhance their levels of innovation and market competitiveness. In this paper, we propose five principles for designing IT tools that can support the facilitation and improvement of knowledge networks. We also introduce a new value proposition that constitutes a nascent design theory in the domain of knowledge network improvement. The design principles are derived from an iterative process applied in three different case settings. In each case, we apply and evaluate the network nexus tool to determine whether the knowledge network provides value to its participants.","author_count":2,"contributors":["Hansen, Magnus Rotvit Perlt","Pries-Heje, Jan"],"cuid":["S01-000.00-558817"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Business strategy","Design science research","Innovation","Knowledge networks","Network groups","Nexus","Value"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-RUC"]},"level3all":["DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"value creation in knowledge networks five design principles","src":["ruc"],"src-code":["DI-U-RUC"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/63514118/Value_Creation_in_Knowledge_Networks.pdf","version":"Published Version"},"id":"S01-000.00-558817","identifier":[{"id":"85039897502","type":"scopus"}],"ids":["ruc-2ac253e4-e787-403e-a927-ca996ad55741"],"keyword":["Business strategy","Design science research","Innovation","Knowledge networks","Network groups","Nexus","Value"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-EE2F63C2C06783385D72AA16544AA986"],"oa_link":[{"access":"oa","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/63514118/Value_Creation_in_Knowledge_Networks.pdf","version":"P