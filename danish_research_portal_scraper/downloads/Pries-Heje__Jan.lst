jepau","last":"Pries-Heje","locid":"6dbca1cc-ed5b-479e-be59-0cf0ae86a2a8","name":"Pries-Heje, Jan","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.4018/jeis.2011010101","issn":["15481115","15481123"],"issn_org":["15481115"],"issue":"1","journal":"International Journal of Enterprise Information Systems","pages":"1-17","publisher":"IGI Publishing","status":"p","title":"International Journal of Enterprise Information Systems","volume":"7"},"review":"Peer Reviewed","scoID":["2-s2.0-80052911044"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Roskilde University","Universities"],"PST":["Published"]},"sid":["au-2f1fce29-046d-4b61-b3d6-5ddf790a273c","ruc-f1ea2894-4822-416d-8deb-8ce1293a3732"],"src":["AU Aarhus University","RUC Roskilde University"],"title":"Enterprise Systems Outsourcing “Behind the Curtain” : A case study showing how rational and institutional explanations co-exist and complement each other","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-016033","year":"2011","yearsub":"2011"}
