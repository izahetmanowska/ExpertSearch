u"},{"affno":"1","first":"Mia","key":"prieshejepau","last":"Pries-Heje","locid":"f6ffd512-b0c2-4a0b-be43-5fc299240ae2","name":"Pries-Heje, Mia","rank":7,"rolecode":"pau"},{"affno":"2","first":"Kamille","key":"foghpau","last":"Fogh","name":"Fogh, Kamille","rank":8,"rolecode":"pau"},{"affno":"1","first":"Jan","key":"gerstoftpau","last":"Gerstoft","locid":"c7e948db-fe0f-4a67-9b86-7ccc43ae64f5","name":"Gerstoft, Jan","rank":9,"rolecode":"pau"},{"affno":"1","first":"Kirsten","key":"grønbækpau","last":"Grønbæk","locid":"82ff4ce1-979f-44c9-b095-72c4a3dca507","name":"Grønbæk, Kirsten","rank":10,"rolecode":"pau"},{"affno":"1","first":"Sisse Rye","key":"ostrowskipau","last":"Ostrowski","locid":"ba497828-2322-4b15-bfae-1e8a8c3895e7","name":"Ostrowski, Sisse Rye","orcid":"0000-0001-5288-3851","rank":11,"rolecode":"pau"},{"affno":"1","first":"Ruth","key":"frikkeschmidtpau","last":"Frikke-Schmidt","locid":"bce2c3b4-6e08-46c7-96c6-7e385b0ec8b3","name":"Frikke-Schmidt, Ruth","rank":12,"rolecode":"pau"},{"affno":"2","first":"Erik","key":"sørensenpau","last":"Sørensen","name":"Sørensen, Erik","rank":13,"rolecode":"pau"},{"affno":"2","first":"Linda","key":"hilstedpau","last":"Hilsted","name":"Hilsted, Linda","rank":14,"rolecode":"pau"},{"affno":"1","first":"Henning","key":"bundgaardpau","last":"Bundgaard","locid":"254c7f8d-79dd-4a5d-870f-3ed78cb56464","name":"Bundgaard, Henning","rank":15,"rolecode":"pau"},{"affno":"1","first":"Peter","key":"garredpau","last":"Garred","locid":"854d72a7-c955-43b5-b455-b7ea1f9bcb1e","name":"Garred, Peter","rank":16,"rolecode":"pau"},{"affno":"1","first":"Kasper","key":"iversenpau","last":"Iversen","locid":"558df261-ca9f-440a-8bee-7d38813c253f","name":"Iversen, Kasper","rank":17,"rolecode":"pau"},{"affno":"3 4","first":"Caroline","key":"sabinpau","last":"Sabin","name":"Sabin, Caroline","rank":18,"rolecode":"pau"},{"affno":"2","first":"Susanne Dam","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Susanne Dam","rank":19,"rolecode":"pau"}],"pmid":["37331161"],"pub":{"doi":"10.1016/j.ebiom.2023.104661","issn":["23523964"],"journal":"EBioMedicine","paperid":"104661","status":"p","title":"EBioMedicine","volume":"93"},"review":"Peer Reviewed","scoID":["2-s2.0-85162027082"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-8815ba61-41c6-4b37-968d-af5e809a94a7"],"src":["KU University of Copenhagen"],"title":"Humoral and cellular immune responses eleven months after the third dose of BNT162b2 an mRNA-based COVID-19 vaccine in people with HIV – a prospective observational cohort study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-684208","year":"2023","yearsub":"2023"}
{"abstract":"When adopting and diffusing new Information Systems (IS) people often show signs of resistance and animosity when they are required to change their behaviour through use of new digital technology in organisational settings. However, resistance may take many forms and may vary from stakeholder to stakeholder. Further, it may be very challenging to know how to handle and cope with different types of resistance. Understanding the type of resistance and how it is expressed externally is an extremely important part of any digital transformation in order to make the wished-for change happen. In this paper we analyse 6000 Facebook posts that revolve around a new digital healthcare platform with more than 40,000 daily users that all were required to adopt and use the new system. We infer an overall framework of resistance to change (RtC) that enhances the understanding of the phenomenon and paves the way for new potential coping strategies.","author_count":3,"contributors":["Fleron, Benedicte","Pries-Heje, Jan","Hansen, Magnus Rotvit Perlt"],"cuid":["S01-000.00-679793"],"event":{"acronym":"ECIS","end":"2023-06-16","place":"Kristiansand, no","start":"2023-06-11","title":"31st European Conference on Information Systems","year":"2023"},"filters":{"added":"2023-07","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Adoption and diffusion","Digital transformation","Resistance to change","information systems evaluation"],"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-RUC"]},"level3all":["DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"understanding resistance to is related change","src":["ruc"],"src-code":["DI-U-RUC"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/94401059/Understanding_resistance_to_IS_related_change.pdf","version":"Published Version"},"id":"S01-000.00-679793","ids":["ruc-4b205601-2002-4da0-b09a-d1022b13e4af"],"keyword":["Adoption and diffusion","Digital transformation","Resistance to change","information systems evaluation"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-17A931DAE81CF46C96FFDD5BEA750EA7"],"oa_link":[{"access":"oa","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/94401059/Understanding_resistance_to_IS_related_change.pdf","version":"Published Version"},{"access":"oa","type":"rem","url":"https://aisel.aisnet.org/ecis2023_rp/250/","version":"Published Version"}],"org":[{"affno":"1","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of People and Technology"],"nora_code":"DI-U-RUC","used":1}],"person":[{"affno":"1","country":"dk","first":"Benedicte","key":"fleronpau","last":"Fleron","locid":"1eac1461-da4c-47d8-9661-106a1a39ae9f","name":"Fleron, Benedicte","orcid":"0009-0002-6000-9923","rank":1,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Jan","key":"prieshejepau","last":"Pries-Heje","locid":"6dbca1cc-ed5b-479e-be59-0cf0ae86a2a8","name":"Pries-Heje, Jan","rank":2,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Magnus Rotvit Perlt","key":"hansenpau","last":"Hansen","locid":"d9c2134a-0799-45eb-8a15-e0523fc96da2","name":"Hansen, Magnus Rotvit Perlt","rank":3,"rolecode":"pau"}],"pub":{"issn":["00000034"],"journal":"Proceedings / European Conference on Information Systems","status":"p","title":"Proceedings / European Conference on Information Systems","title_org":"Proceedings of the European Conference on Information Systems","volume":"2023"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Roskilde University","Universities"],"PST":["Published"]},"sid":["ruc-4b205601-200