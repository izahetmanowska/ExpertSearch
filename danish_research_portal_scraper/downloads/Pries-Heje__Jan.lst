","name":"Elsborg, Steen","rank":2,"rolecode":"pau"},{"affno":"","first":"Peter","key":"hagedornrasmussenpedh","last":"Hagedorn-Rasmussen","name":"Hagedorn-Rasmussen, Peter","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Jan","key":"prieshejepedh","last":"Pries-Heje","name":"Pries-Heje, Jan","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Keld","key":"bødkerpedh","last":"Bødker","name":"Bødker, Keld","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Steen","key":"elsborgpedh","last":"Elsborg","name":"Elsborg, Steen","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"John Damm","key":"scheuerpedh","last":"Scheuer","name":"Scheuer, John Damm","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"eisbn":["9788759327258"],"isbn":["9788759323977"],"pages":"185-202","place":"Frederiksberg","publisher":"Samfundslitteratur","status":"p","subtitle":"Design og implementering i orkanens øje","title":"Robust organisationsforandring"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Roskilde University","Universities"],"PST":["Published"]},"sid":["ruc-1ae7f9be-0258-481e-9a59-da814caa3abe"],"src":["RUC Roskilde University"],"title":"Forandring som læreproces","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-557789","year":"2016","yearsub":"2016"}
{"abstract":"Learning is important to improvement. But how do you make sure that the right lessons are learned? In a case of Digital Post digitalization from Denmark the project of coercive e-government was presented as a success but when taking a closer look a very different story emerges. We present and discuss the case using project management theory and IT project success theory as a lens for understanding. Our conclusion being that you need to do a thorough and extensive analysis to elicit the real learning from a large and complex e-government project.","author_count":4,"contributors":["Pries-Heje, Jan","Berger, Jesper Bull"],"cuid":["S01-000.00-559396"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-RUC"]},"level3all":["DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"when stage setting a success gets in the way of real learning","src":["ruc"],"src-code":["DI-U-RUC"],"type":"dba","type-grp":["all","pub"]},"id":"S01-000.00-559396","ids":["ruc-33281406-c922-4d35-8961-b7540d737e61"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-3DD0FF5F339B942F1D3E823FCB41855F"],"org":[{"affno":"1","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of People and Technology","Roskilde University, Department of People and Technology, User-Driven IT Innovation"],"nora_code":"DI-U-RUC","used":1}],"person":[{"affno":"1","country":"dk","first":"Jan","key":"prieshejepau","last":"Pries-Heje","locid":"6dbca1cc-ed5b-479e-be59-0cf0ae86a2a8","name":"Pries-Heje, Jan","rank":1,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Jesper Bull"