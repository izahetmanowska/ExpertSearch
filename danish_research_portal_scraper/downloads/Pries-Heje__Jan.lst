{"abstract":"Project Management Theory Meets Practice contains the proceedings from the 1st Danish Project Management Research Conference (DAPMARC 2015), held in Copenhagen, Denmark, on May 21st, 2015.","author_count":2,"contributors":["Pries.Heje, Jan","Svejvig, Per"],"cuid":["S02-091.35-019790"],"event":{"end":"2015-05-21","place":"Copenhagen, dk","start":"2015-05-21","title":"3rd Danish Project Management Research Conference (DAPMARC3)","year":"2017"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["hum","soc"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-RUC"]},"level3all":["DI-U-AU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"project management theory meets practice","src":["au","ruc"],"src-code":["DI-U-AU","DI-U-RUC"],"type":"db","type-grp":["all","pub"]},"id":"S02-091.35-019790","ids":["au-624aab28-7d5a-427f-b362-86f6c70a774c","ruc-95f02baa-06e2-4f02-9c23-4c6bc51a0153"],"lang":"English","level":"Scientific","mra":["Humanities","Social Science"],"noi":["Local-1-2-28685D15BB49DD10A6310D94433BEB63"],"org":[{"affno":"1","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of People and Technology, User-Driven IT Innovation","Roskilde University, The Department of Communication, Business and Information Technologies"],"nora_code":"DI-U-RUC","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus BSS, Department of Management"],"nora_code":"DI-U-AU","used"