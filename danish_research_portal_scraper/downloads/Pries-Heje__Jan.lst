{"abstract":"This is an answer and an elaboration to Carsten Sørensens’ “The Curse of the Smart Machine?”. My answer disagrees with the postulate of a mainframe focus within the IS field. Instead I suggest that it is a struggle between old and new science. The answer then agrees with the notion that we need new and more agile publication mechanisms and I elaborate that.","author_count":1,"contributors":["Pries-Heje, Jan"],"cuid":["S01-000.00-564009"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"1 contributor","cluster_size":1,"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-RUC"]},"level3all":["DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"smart er research","src":["ruc"],"src-code":["DI-U-RUC"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/59391628/5_28_2_Pries_Heje_IRIS_web_.pdf","version":"Published Version"},"id":"S01-000.00-564009","identifier":[{"id":"85008395167","type":"scopus"}],"ids":["ruc-7803bcf8-8810-49fb-8ba2-d8b75b05b71c"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Global-Local-2-2-2808EDCDDCAB79C5FA2B5312B1B6B772"],"oa_link":[{"access":"oa","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/59391628/5_28_2_Pries_Heje_IRIS_web_.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Humanities (HUM)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of People and Technology","Roskilde University, Department of People and Technology, User-Driven IT Innovation"],"nora_code":"DI-U-RUC","used":1}],"person":[{"affno":"1","country":"dk","first":"Jan","key":"pr