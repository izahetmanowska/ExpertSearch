{"abstract":"Dette kapitel redegør for 3 oversættelsesteoriers forståelse af implementering i organisationer, beskriver de opmærksomhedspunkter som de giver anledning til for en forandringsagent. Og demonstrerer disse i forhold til en praktisk case.","author_count":6,"contributors":["Scheuer, John Damm"],"cuid":["S01-000.00-557335"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Implementering","Organisationsforandring","Oversættelse"],"level":"sci","mra":["soc"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-RUC"]},"level3all":["DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"forandring gennem oversættelse","src":["ruc"],"src-code":["DI-U-RUC"],"type":"dba","type-grp":["all","pub"]},"id":"S01-000.00-557335","ids":["ruc-1406a6d5-3dcb-4747-94e4-d79db80e0c0f"],"keyword":["Implementering","organisationsforandring","oversættelse"],"lang":"Danish","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-024ECB18160E2F53E1955554B2B61F3F"],"org":[{"affno":"1","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of Social Sciences and Business","Roskilde University, Department of Social Sciences and Business, Management and organization"],"nora_code":"DI-U-RUC","used":1}],"person":[{"affno":"1","country":"dk","first":"John Damm","key":"scheuerpau","last":"Scheuer","locid":"8e76bd10-35fb-4c67-900f-e0a61bf8c797","name":"Scheuer, John Damm","rank":1,"rolecode":"pau"},{"affno":"","first":"Peter","key":"hagedornrasmussenpedh","last":"Hagedorn-Rasmussen","name":"Hagedorn-Rasmussen, Peter","rank":2,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Jan","key":"prieshejepedh","last":"Pries-Hej