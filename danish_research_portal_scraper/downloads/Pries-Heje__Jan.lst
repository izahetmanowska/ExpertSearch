 of Host Publication","rolecode":"pedh"},{"affno":"","first":"Jan","key":"prieshejepedh","last":"Pries-Heje","name":"Pries-Heje, Jan","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["9788788361094"],"pages":"75-81","place":"Roskilde","publisher":"Roskilde Universitet","status":"p","title":"The Future of Project Management"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Other Companies","Private Research","Roskilde University","Universities","whitebox"],"PST":["Published"]},"sid":["ruc-6718c56e-f49c-4ee1-a2be-e1f70e612d5e"],"src":["RUC Roskilde University"],"title":"Using ISO 33014 : An International Standard for Process Improvement Projects","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-562856","year":"2017","yearsub":"2017"}
{"abstract":"This paper demonstrates how a report used in a Master in Project management and Process improvement training at Roskilde University Denmark can be used to evaluate if a student can pass the ECQA SPI Manager exam. It also demonstrates how the structure of the report addresses all necessary competences, which should or could be brought into play during the project – and therefor also in one way or another addresses the quality of the activated competences in the improvement project – a kind of qualification. The clue is that the structure of the report follows the units and element in the SPI Manager job role, which is based on the SPI Manifesto and the ImprovAbilityTM model (part of ISO/IEC 33014 Guideline for Process Improvement) among other types of knowledge and research.","author_count":9,"contributors":["Johansen, Jørn","Back, Karsten Kristensen","Korsaa, Morten","Pries-Heje, Jan","Schweigert, Tomas"],"cuid":["S01-000.00-571314"],"event":{"acronym":"EuroSPI","end":"2017-09-08","place":"Ostrava, cz","start":"2017-09-06","title":"24th European Conference on Software Process Improvement","year":"2017"},"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","SQS Software Quality Systems AG"],"keyword":["ECQA SPI manager job role","ISE IEC33014","Process improvement","SPI Manifesto ImprovAbility"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-PR","DI-U"],"level3":{"OT":["Roskilde Katedralskole"],"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-RUC"]},"level3all":["DI-PR-OTH","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"documentation of improvement competences","src":["ruc"],"src-code":["DI-U-RUC"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://link.springer.com/chapter/10.1007/978-3-319-64218-