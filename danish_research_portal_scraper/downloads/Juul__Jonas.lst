derkopppau","last":"Wedderkopp","locid":"bcfae344-0a75-458d-8ba2-4198ee915d40","name":"Wedderkopp, Niels","orcid":"0000-0002-9660-6618","rank":5,"rolecode":"pau"}],"pub":{"issn":["16002830"],"issue":"2","journal":"Børn i Fysioterapi","pages":"16-18","publisher":"Dansk selskab for Pædiatrisk Fysioterapi","publisher_org":"Dansk Selskab for Pædiatrisk Fysioterapi","status":"p","title":"Børn i Fysioterapi","volume":"2015"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","All University Colleges","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","Hospitals","Region of Southern Denmark","UCL University College","Universities","University Colleges","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-7d4a2ac2-a578-43d3-9a46-abf4396b72cf","ucl-fdd02e72-011d-4783-9632-860ae18bde87"],"src":["SDU University of Southern Denmark","UCL University College"],"title":"Forringet kontrol af knæet under hop hos børn/unge med hypermobilitet","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-089.42-049158","year":"2015","yearsub":"2015"}
{"abstract":"Watch and wait (WAW) is a common approach for asymptomatic, advanced stage follicular lymphoma (FL), but single-agent rituximab is an alternative for these patients. In this nationwide study we describe the outcome of patients selected for WAW. A cohort of 286 out of 849 (34%) stage III-IVA FL patients seen between 2000 and 2011, were managed expectantly and included. The 5-year progression-free survival (PFS) was 35% [95% confidence interval (CI) 29-42]. The 10-year overall survival (OS) was 65% (95%CI 54-78), and the cumulative risk of dying from lymphoma within 10 years of diagnosis was 13% (95%CI 7-20). Elevated lactate dehydrogenase and > four nodal regions involved were associated with a higher risk of lymphoma treatment and death from lymphoma. The WAW patients and a matched background population had similar OS during the first 50 months after diagnosis (P = 0·7), but WAW patients had increased risk of death after 50 months (P < 0·001). The estimated loss of residual life after 10 years was 6·8 months. The 10-year cumulative risk of histological transformation was 22% (95%CI 15-29) and the 3-year OS after transformation was 71% (95%CI 58-87%). In conclusion, advanced stage FL managed by WAW had a favourable outcome and abandoning this strategy could lead to overtreatment in some patients.","author_count":19,"contributors":["El-Galaly, Tarec Christoffer","Bilgrau, Anders Ellern","de Nully Brown, Peter","Mylam, Karen J","Ahmad, Syed A","Pedersen, Lars M","Gang, Anne O","Bentzen, Hans H","Juul, Maja B","Bergmann, Olav J","Pedersen, Robert S","Nielsen, Berit Jamie","Johnsen, Hans Erik","Dybkær, Karen","Bøgsted, Martin","Hutchings, Martin"],"cuid":["S02-098.05-003682"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"keyword":["Adult","Aged","Aged 80 and over","Bone Marrow","Female","Follicular lymphoma","Histological transformation","Humans","Lymphoma Follicular","Male","Middle Aged","Neoplasm Grading","Neoplasm Staging","Overall survival","Patient Outcome Assessment","Population Surveillance","Prognosis","Progression Free Survival","Retrospective Studies","Watch and wait","Watchful Waiting"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-ZEA"],"U":["DI-U-AAU","DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-ZEA","DI-U-AAU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"a population based study of prognosis in advanced stage follicular lymphoma managed by watch and wait","src":["aau","sdu"],"src-code":["DI-U-AAU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84927693567","version":"Other Version"},"id":"S02-098.05-003682","identifier":[{"id":"25709094","type":"pmid"},{"id":"WOS:000353033800013","type":"wos"},{"id":"84927693567","type":"scopus"}],"ids":["aau-4b967cad-52dd-4bc9-97c1-1bba8d0797a7","sdu-a59c52ad-3640-4696-9f8c-22af1c39364e"],"keyword":["Adult","Aged","Aged, 80 and over","Bone Marrow","Female","Follicular lymphoma","Histological transformation","Humans","Lymphoma, Follicular","Male","Middle Aged","Neoplasm Grading","Neoplasm Staging","Overall survival","Patient Outcome Assessment","Population Surveillance","Prognosis","Progression-free survival","Retrospective Studies","Watch and wait","Watchful Waiting"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-E37B763610C743396FCC9C2E67FC7040"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Facu