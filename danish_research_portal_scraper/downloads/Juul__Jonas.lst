{"abstract":"Ændret neuromuskulær kontrol af knæet under landing i hop hos 10-15 årige børn med generaliseret led hypermobilitet og samtidig knæhypermobilitet. – Et substudie af Svendborgprojektet","author_count":5,"contributors":["Junge, Tina","Juul-Kristensen, Birgit","Søgaard, Karen","Thorlund, Jonas Bloch","Wedderkopp, Niels"],"cuid":["S02-089.42-049158"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Fysioterapi"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U","DI-UC"],"level3":{"HO":["DI-HO-ALL","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-SDU"],"UC":["DI-UC-ALL","DI-UC-UCL"]},"level3all":["DI-HO-SDR","DI-U-SDU","DI-UC-UCL"]},"review":"pr","rtype":["clu"],"sorti":"forringet kontrol af knæet under hop hos børn unge med hypermobilitet","src":["sdu","ucl"],"src-code":["DI-U-SDU","DI-UC-UCL"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"http://www.boernefysioterapi.dk/Upload/Faggr/boernefysioterapi/B%C3%B8rn%20i%20fysioterapi,%20efter%C3%A5r%202015.pdf","version":"Published Version"},"id":"S02-089.42-049158","ids":["sdu-7d4a2ac2-a578-43d3-9a46-abf4396b72cf","ucl-fdd02e72-011d-4783-9632-860ae18bde87"],"keyword":["fysioterapi"],"lang":"Danish","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-2-93FD17E24CDEAD8639BFAF4F49F7D59E"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"http://www.boernefysioterapi.dk/Upload/Faggr/boernefysioterapi/B%C3%B8rn%20i%20fysioterapi,%20efter%C3%A5r%202015.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","name