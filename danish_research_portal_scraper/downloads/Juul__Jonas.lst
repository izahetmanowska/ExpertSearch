u"},{"affno":"10","corresponding":null,"first":"Josefine","key":"pallepau","last":"Palle","name":"Palle, Josefine","rank":11,"rolecode":"pau"},{"affno":"11","corresponding":null,"first":"Cornelis Jan","key":"pronkpau","last":"Pronk","name":"Pronk, Cornelis Jan","rank":12,"rolecode":"pau"},{"affno":"12","corresponding":null,"first":"Kadri","key":"sakspau","last":"Saks","name":"Saks, Kadri","rank":13,"rolecode":"pau"},{"affno":"13","corresponding":null,"first":"Anne","key":"tierenspau","last":"Tierens","name":"Tierens, Anne","rank":14,"rolecode":"pau"},{"affno":"14","corresponding":null,"first":"Bernward","key":"zellerpau","last":"Zeller","name":"Zeller, Bernward","rank":15,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jonas","key":"abrahamssonpau","last":"Abrahamsson","name":"Abrahamsson, Jonas","rank":16,"rolecode":"pau"}],"pmid":["36762836"],"pub":{"doi":"10.1111/bjh.18685","issn":["00071048"],"issue":"4","journal":"British Journal of Haematology","pages":"757-765","publisher":"John Wiley & Sons Inc.","status":"p","title":"British Journal of Haematology","volume":"201"},"review":"Peer Reviewed","scoID":["2-s2.0-85147567145"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-a4122e1b-d8b1-4b1c-ba0a-69dd9a3f17b2"],"src":["AU Aarhus University"],"title":"Characteristics and outcome of primary resistant disease in paediatric acute myeloid leukaemia","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-222799","year":"2023","yearsub":"2023"}
{"abstract":"AIMS: The voltage-gated potassium channel K v 11.1 is important for repolarising the membrane potential in excitable cells such as myocytes, pancreatic α- and β-cells. Moxifloxacin blocks the K v 11.1 channel and increases the risk of hypoglycaemia in patients with diabetes. We investigated glucose regulation and secretion of glucoregulatory hormones in young people with and without moxifloxacin a drug known to block the K v 11.1 channel. MATERIAL AND METHODS: The effect of moxifloxacin (800 mg/day for four days) or placebo on glucose regulation was assessed in a randomised, double-blind, crossover study of young men and women (age 20-40 years and BMI 18.5-27.5 kg/m 2 ) without chronic disease, using 6-hour oral glucose tolerance tests (OGTT) and continuous glucose monitoring (CGM). RESULTS: Thirty-eight participants completed the study. Moxifloxacin prolonged the QTcF-interval and increased heart rate. Hypoglycaemia was more frequently observed with moxifloxacin, both during the eight days of CGM and during the OGTT. Hypoglycaemia questionnaire scores were higher after intake of moxifloxacin. Moxifloxacin reduced early plasma-glucose response (AUC 0-30min ) by 7% (95%CI: -9% to -4%, p<0.01), and overall insulin response (AUC 0-360min ) decreased by 18% (95%CI: -24% to -11%, p<0.01) and plasma glucagon increased by 17% (95%CI: 4% to 33%, p=0.03). Insulin sensitivity calculated as Matsuda index increased by 11%, and MISI, an index of muscle insulin sensitivity, increased by 34%. CONCLUSIONS: In young men and women, moxifloxacin a drug known to block the K v 11.1 channel increased QT interval, decreased glucose levels, and was associated with increased muscle insulin sensitivity and more frequent episodes of hypoglycaemia. This article is protected by copyright. All rights reserved.","author_count":12,"contributors":["Juhl, Christian Rimer","Burgdorf, Josephine","Knudsen, Cecilie","Lubberding, Anniek Frederike","Veedfald, Simon","Isaksen, Jonas L.","Hartmann, Bolette","Frikke-Schmidt, Ruth","Mandrup-Poulsen, Thomas","Holst, Jens Juul","Kanters, Jørgen K.","Torekov, Signe Sørensen"],"cuid":["S01-000.00-432493"],"filters":{"added":"2023-02","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"a randomised double blind crossover study of the effect of the fluoroquinolone moxifloxacin on glucose levels and insulin sensitivity in young men and women","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1111/dom.14851","version":"Published Version"},"id":"S01-000.00-432493","identifier":[{"id":"PMC10087839","type":"pmcid"},{"id":"85137852402","type":"scopus"},{"id":"36054143","type":"pmid"}],"ids":["ku-4155e42f-fc8f-4026-8968-77e54cdba82a"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-6DF01DF676AC568BEB403A043A5E9599"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://curis.ku.dk/ws/files/329427442/Diabetes_Obesity_Metabolism_2022_Juhl_A_randomized_double_blind_crossover_study_of_the_effect_of_the.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1111/dom.14851","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Biomedical Sciences, Endocrinology and Metabolism"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Christian R","key":"juhlpau","last":"Juhl","locid":"18d8e8fd-21c1-4352-a747-6c0cc9087510","name":"Juhl, Christian Rimer","name_org":"Juhl, Christian R","orcid":"0000-0003-3024-4017","rank":1,"rolecode":"pau"},{"affno":"1","first":"Josephine","key":"burgdorfpau","last":"Burgdorf","name":"Burgdorf, Josephine","rank":2,"rolecode":"pau"},{"affno":"1","first":"Cecilie","key":"knudsenpau","last":"Knudsen","name":"Knudsen, Cecilie","rank":3,"rolecode":"pau"},{"affno":"1","first":"Anniek F","key":"lubberdingpau","last":"Lubberding","locid":"1e6eede6-d706-4e3a-903b-fb86d5374d13","name":"Lubberding, Anniek Frederike","name_org":"Lubberding, Anniek F","orcid":"0000-0002-6691-8581","rank":4,"rolecode":"pau"},{"affno":"1","first":"Simon","key":"veedfaldpau","last":"Veedfald","locid":"b6633087-c392-4c8b-814e-abeeb5865b71","name":"Veedfald, Simon","rank":5,"rolecode":"pau"},{"affno":"1","first":"Jonas L","key":"isaksenpau","last":"Isaksen","locid":"46a93bd5-94a8-4b64-b64f-e7cffd686aa7","name":"Isaksen, Jonas L.","name_org":"Isaksen, Jonas L","orcid":"0000-0003-3227-1131","rank":6,"rolecode":"pau"},{"affno":"1","first":"Bolette","key":"hartmannpau","last":"Hartmann","locid":"eb04fc6b-068a-4d5b-a106-1b7be3f7e12b","name":"Hartmann, Bolette","orcid":"0000-0001-8509-2036","rank":7,"rolecode":"pau"},{"affno":"1","first":"Ruth","key":"frikkeschmidtpau","last":"Frikke-Schmidt","locid":"bce2c3b4-6e08-46c7-96c6-7e385b0ec8b3","name":"Frikke-Schmidt, Ruth","rank":8,"rolecode":"pau"},{"affno":"1","first":"Thomas","key":"mandruppoulsenpau","last":"Mandrup-Poulsen","locid":"3d24585d-c2e8-4656-b1a6-3aa703263d73","name":"Mandrup-Poulsen, Thomas","rank":9,"rolecode":"pau"},{"affno":"1","first":"Jens J","key":"holstpau","last":"Holst","locid":"864b6401-9024-4773-9bdb-f4d4ca57dcad","name":"Holst, Jens Juul","name_org":"Holst, Jens J","orcid":"0000-0001-6853-3805","rank":10,"rolecode":"pau"},{"affno":"1","first":"Jørgen K","key":"kanterspau","last":"Kanters","locid":"f544654f-76ab-44f6-a780-d0a011eb7341","name":"Kanters, Jørgen K.","name_org":"Kanters, Jørgen K","orcid":"0000-0002-3267-4910","rank":11,"rolecode":"pau"},{"affno":"1","first":"Signe S","key":"torekovpau","last":"Torekov","locid":"c1d71a61-ee09-4c29-ae48-7520707a73be","name":"Torekov, Signe Sørensen","name_org":"Torekov, Signe S","orcid":"0000-0001-6779-0252","rank":12,"rolecode":"pau"}],"pmid":["36054143"],"pub":{"doi":"10.1111/dom.14851","issn":["14628902","14631326"],"issn_org":["14628902"],"issue":"1","journal":"Diabetes, Obesity and Metabolism","pages":"98-109","status":"p","title":"Diabetes, Obesity and Metabolism","volume":"25"},"review":"Peer Reviewed","scoID":["2-s2.0-85137852402"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-4155e42f-fc8f-4026-8968-77e54cdba82a"],"src":["KU University of Copenhagen"],"title":"A randomised, double-blind, crossover study of the effect of the fluoroquinolone moxifloxacin on glucose levels and insulin sensitivity in young men and women","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-432493","year":"2023","yearsub":"2023"}
{"abstract":"Humans collaborate in different contexts such as in creative or scientific projects, in workplaces and in sports. Depending on the project and external circumstances, a newly formed collaboration may include people that have collaborated before in the past, and people with no collaboration history. Such existing relationships between team members have been reported to influence the performance of teams. However, it is not clear how existing relationships between team members should be quantified, and whether some relationships are more likely to occur in new collaborations than others. Here we introduce a new family of structural patterns, m-patterns, which formalize relationships between collaborators and we study the prevalence of such structures in data and a simple random-hypergraph null model. We analyze the frequency with which different collaboration structures appear in our null model and show how such frequencies depend on size and hyperedge density in the hypergraphs. Comparing the null model to data of human and non-human collaborations, we find that some collaboration structures are vastly under- and overrepresented in empirical datasets. Finally, we find that structures of scientific collaborations on COVID-19 papers in some cases are statistically significantly different from those of non-COVID-19 papers. Examining citation counts for 4 different scientific fields, we also find indications that repeat collaborations are more successful for 2-author scientific publications and less successful for 3-author scientific publications as compared to other collaboration structures.","author_count":3,"contributors":["Juul, Jonas L.","Benson, Austin R.","Kleinberg, Jon"],"cuid":["S01-000.00-718669"],"filters":{"added":"2024-03","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","OECD"],"corresponding_author":["Juul, Jonas L."],"country":["United States"],"glorg":["All Global Affiliations","Cornell University"],"keyword":["Covid 19","Hypergraphs","Motifs","Random graphs","Team performance"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"hypergraph patterns and collaboration structure","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.3389/fphy.2023.1301994","version":"Published Version"},"id":"S01-000.00-718669","identifier":[{"id":"85182954445","type":"scopus"}],"ids":["dtu-a4b31362-433f-4aba-ae0c-6e7e1dd55f8c"],"keyword":["COVID-19","Collaboration structure","Hypergraphs","Motifs","Random graphs","Team performance"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-5C8E5094B8ADD8755D8700014037241D"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/351167775/fphy-11-1301994.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.3389/fphy.2023.1301994","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Applied Mathematics and Computer Science","Technical University of Denmark, Department of Applied Mathematics and Computer Science, Cognitive Systems"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"us","key":"cornell university","loc":["United States","America, North","OECD"],"name":"Cornell University","used":1}],"person":[{"affno":"1 2","corresponding":null,"country":"dk","first":"Jonas L.","key":"juulpau","last":"Juul","locid":"d8293ed2-35e5-4031-8602-349a86b5b33e","name":"Juul, Jonas L.","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Austin R.","key":"bensonpau","last":"Benson","name":"Benson, Austin R.","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jon","key":"kleinbergpau","last":"Kleinberg","name":"Kleinberg, Jon","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.3389/fphy.2023.1301994","issn":["2296424X"],"journal":"Frontiers in Physics","paperid":"1301994","publisher":"Frontiers Media SA","publisher_org":"Frontiers Media S.A.","status":"p","title":"Frontiers in Physics","volume":"11"},"review":"Peer Reviewed","scoID":["2-s2.0-85182954445"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-a4b31362-433f-4aba-ae0c-6e7e1dd55f8c"],"src":["DTU Technical University of Denmark"],"title":"Hypergraph patterns and collaboration structure","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-718669","year":"2023","yearsub":"2024"}
{"abstract":"Survivin, a well-known member of the inhibitor of apoptosis protein family, is upregulated in many cancer cells, which is associated with resistance to chemotherapy. To circumvent this, inhibitors are currently being developed to interfere with the nuclear export of survivin by targeting its protein-protein interaction (PPI) with the export receptor CRM1. Here, we combine for the first time a supramolecular tweezer motif, sequence-defined macromolecular scaffolds, and ultrasmall Au nanoparticles (us-AuNPs) to tailor a high avidity inhibitor targeting the survivin-CRM1 interaction. A series of biophysical and biochemical experiments, including surface plasmon resonance measurements and their multivalent evaluation by EVILFIT, reveal that for divalent macromolecular constructs with increasing linker distance, the longest linkers show superior affinity, slower dissociation, as well as more efficient PPI inhibition. As a drawback, these macromolecular tweezer conjugates do not enter cells, a critical feature for potential applications. The problem is solved by immobilizing the tweezer conjugates onto us-AuNPs, which enables efficient transport into HeLa cells. On the nanoparticles, the tweezer valency rises from 2 to 16 and produces a 100-fold avidity increase. The hierarchical combination of different scaffolds and controlled multivalent presentation of supramolecular binders was the key to the development of highly efficient survivin-CRM1 competitors. This concept may also be useful for other PPIs.","author_count":17,"contributors":["Seiler, Theresa","Lennartz, Annika","Klein, Kai","Hommel, Katrin","Figueroa Bietti, Antonio","Hadrovic, Inesa","Kollenda, Sebastian","Sager, Jonas","Beuck, Christine","Chlosta, Emilia","Bayer, Peter","Juul-Madsen, Kristian","Vorup-Jensen, Thomas","Schrader, Thomas","Epple, Matthias","Knauer, Shirley K","Hartmann, Laura"],"cuid":["S01-000.00-682781"],"filters":{"added":"2023-09","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","Heinrich Heine University Düsseldorf","Helmholtz Association of German Research Centres","University of Duisburg-Essen"],"keyword":["Active Transport Cell Nucleus","Cancer","Cell Nucleus metabolism","Gold","HeLa Cells","Humans","Macromolecular Substances metabolism","Metal nanoparticles","Multivalency","Polyvalent","Survivin"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"potentiating tweezer affinity to a protein interface with sequence defined macromolecules on nanoparticles","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85167831937","version":"Other Version"},"id":"S01-000.00-682781","identifier":[{"id":"85167831937","type":"scopus"},{"id":"37507377","type":"pmid"}],"ids":["au-c90aa2fa-6bd0-4718-b258-46dcbcf9f725"],"keyword":["Active Transport, Cell Nucleus","Cell Nucleus/metabolism","Gold","HeLa Cells","Humans","Inhibitor of Apoptosis Proteins/metabolism","Macromolecular Substances/metabolism","Metal Nanoparticles","Polyvalent","Survivin","cancer","multivalency"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-7EC0DA3D5F49CE7957BBCFB67B60D9F0"],"org":[{"affno":"1","country":"de","key":"heinrich heine university düsseldorf","loc":["Germany","Europe, EU","OECD"],"name":"Heinrich Heine University Düsseldorf","used":1},{"affno":"2","country":"de","key":"university of duisburg essen","loc":["Germany","Europe, EU","OECD"],"name":"University of Duisburg-Essen","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Biomedicine, Department of Biomedicine - Forskning og uddannelse, Skou-bygningen"],"nora_code":"DI-U-AU","used":1},{"affno":"4","country":"de","key":"helmholtz association of german research centres","loc":["Germany","Europe, EU","OECD"],"name":"Helmholtz Association of German Research Centres","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Theresa","key":"seilerpau","last":"Seiler","name":"Seiler, Theresa","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Annika","key":"lennartzpau","last":"Lennartz","name":"Lennartz, Annika","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Kai","key":"kleinpau","last":"Klein","name":"Klein, Kai","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Katrin","key":"hommelpau","last":"Hommel","name":"Hommel, Katrin","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Antonio","key":"figueroabiettipau","last":"Figueroa Bietti","name":"Figueroa Bietti, Antonio","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Inesa","key":"hadrovicpau","last":"Hadrovic","name":"Hadrovic, Inesa","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Sebastian","key":"kollendapau","last":"Kollenda","name":"Kollenda, Sebastian","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jonas","key":"sagerpau","last":"Sager","name":"Sager, Jonas","rank":8,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Christine","key":"beuckpau","last":"Beuck","name":"Beuck, Christine","rank":9,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Emilia","key":"chlostapau","last":"Chlosta","name":"Chlosta, Emilia","rank":10,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Peter","key":"bayerpau","last":"Bayer","name":"Bayer, Peter","rank":11,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"country":"dk","first":"Kristian","key":"juulmadsenpau","last":"Juul-Madsen","locid":"e1f1360b-467e-4b44-b1c1-d5c6a0da4acf","name":"Juul-Madsen, Kristian","orcid":"0000-0002-5309-5221","rank":12,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Thomas","key":"vorupjensenpau","last":"Vorup-Jensen","locid":"77b03498-95a4-453b-81a8-e2c05fa0ca0c","name":"Vorup-Jensen, Thomas","orcid":"0000-0002-4140-6563","rank":13,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Thomas","key":"schraderpau","last":"Schrader","name":"Schrader, Thomas","rank":14,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Matthias","key":"epplepau","last":"Epple","name":"Epple, Matthias","rank":15,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Shirley K","key":"knauerpau","last":"Knauer","name":"Knauer, Shirley K","rank":16,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Laura","key":"hartmannpau","last":"Hartmann","name":"Hartmann, Laura","rank":17,"rolecode":"pau"}],"pmid":["37507377"],"pub":{"doi":"10.1021/acs.biomac.3c00393","issn":["15257797","15264602"],"issn_org":["15257797"],"issue":"8","journal":"Biomacromolecules","pages":"3666-3679","publisher":"American Chemical Society","status":"p","title":"Biomacromolecules","volume":"24"},"review":"Peer Reviewed","scoID":["2-s2.0-85167831937"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-c90aa2fa-6bd0-4718-b258-46dcbcf9f725"],"src":["AU Aarhus University"],"title":"Potentiating Tweezer Affinity to a Protein Interface with Sequence-Defined Macromolecules on Nanoparticles","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-682781","year":"2023","yearsub":"2023"}
{"abstract":"Terrorists use violence in pursuit of political goals. While terror often has severe consequences for victims, it remains an open question how terror attacks affect the general population. We study the behavioral response of citizens of cities affected by 7 different terror attacks. We compare real-time mobile communication patterns in the first 24 hours following a terror attack to the corresponding patterns on days with no terror attack. We find that the difference between male and female communication patterns are amplified following a terror attack. Knowledge about citizens’ behavior response patterns following terror attacks may have important implications for the public response during and after an attack.","author_count":6,"contributors":["Juul, Jonas L.","Alessandretti, Laura","Dammeyer, Jesper","Zettler, Ingo","Lehmann, Sune","Mathiesen, Joachim"],"cuid":["S02-095.74-716217"],"filters":{"added":"2023-02","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Juul, Jonas L."],"keyword":["Behavior change","Gender","Gender differences","Impact of terror","Telecommunication","Terror attacks"],"level":"sci","mra":["sci","soc"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"group specific behavior change following terror attacks","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/342669003/2004.02957.pdf","version":"Pre-print"},"funding_acknowledgement":["J.L.J received funding through the Carlsberg Foundation grant CF21-0342. J.L.J. J.D. I.Z. S.L. and J.M. received funding through the University of Copenhagen UCPH 2016 Excellence Programme for Interdisciplinary Research."],"id":"S02-095.74-716217","identifier":[{"id":"85141699069","type":"scopus"}],"ids":["dtu-30a50f0d-8187-4a54-8a41-fbaef52252bd","ku-86347fa6-2c08-4b00-be4a-827804de0c93"],"keyword":["Behavior change","Gender","Gender differences","Impact of terror","Telecommunication","Terror attacks"],"lang":"English","level":"Scientific","mra":["Science/Technology","Social Science"],"noi":["Global-Local-2-5-80907248616C600041D3A7A0AA236BD1"],"oa_link":[{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/342669003/2004.02957.pdf","version":"Pre-print"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Applied Mathematics and Computer Science","Technical University of Denmark, Department of Applied Mathematics and Computer Science, Cognitive Systems"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1 2","corresponding":null,"country":"dk","first":"Jonas L.","key":"juulpau","last":"Juul","locid":"d8293ed2-35e5-4031-8602-349a86b5b33e","name":"Juul, Jonas L.","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Laura","key":"alessandrettipau","last":"Alessandretti","locid":"0e9909a3-464d-4dbe-8e3a-05327a3bc245","name":"Alessandretti, Laura","orcid":"0000-0001-6003-1165","rank":2,"rolecode":"pau"},{"affno":"2","first":"Jesper","key":"dammeyerpau","last":"Dammeyer","locid":"4e00d381-dd0b-4b42-a335-652388c7f73b","name":"Dammeyer, Jesper","orcid":"0000-0001-6753-8516","rank":3,"rolecode":"pau"},{"affno":"2","first":"Ingo","key":"zettlerpau","last":"Zettler","locid":"97f75ec6-e574-4f43-8b3a-6a57c6515cab","name":"Zettler, Ingo","orcid":"0000-0001-6140-7160","rank":4,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Sune","key":"lehmannpau","last":"Lehmann","locid":"9049a0bd-7e6f-4f06-80f6-88ac447289e7","name":"Lehmann, Sune","orcid":"0000-0001-6099-2345","rank":5,"rolecode":"pau"},{"affno":"2","first":"Joachim","key":"mathiesenpau","last":"Mathiesen","locid":"cd2606a2-f61e-4bf0-bcfb-b4888682b5ad","name":"Mathiesen, Joachim","orcid":"0000-0002-5621-5487","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1007/s42001-022-00188-2","issn":["24322717","24322725"],"issn_org":["24322717"],"journal":"Journal of Computational Social Science","pages":"1-18","status":"p","title":"Journal of Computational Social Science","volume":"6"},"review":"Peer Reviewed","scoID":["2-s2.0-85141699069"],"sdg":["16. Peace, Justice and Strong Institutions","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-30a50f0d-8187-4a54-8a41-fbaef52252bd","ku-86347fa6-2c08-4b00-be4a-827804de0c93"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Group-specific behavior change following terror attacks","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-095.74-716217","year":2023,"yearsub":2023}
{"abstract":"Hypodiploidy, defined as modal numbers (MNs) 45 or lower, has not been independently investigated in pediatric acute myeloid leukemia (AML) but is a well-described high-risk factor in pediatric acute lymphoblastic leukemia. We aimed to characterize and study the prognostic impact of hypodiploidy in pediatric AML. In this retrospective cohort study, we included children below 18 years of age with de novo AML and a hypodiploid karyotype diagnosed from 2000 to 2015 in 14 childhood AML groups from the International Berlin-Frankfurt-Münster (I-BFM) framework. Exclusion criteria comprised constitutional hypodiploidy, monosomy 7, composite karyotype, and t(8;21) with concurring sex chromosome loss. Hypodiploidy occurred in 81 patients (1.3%) with MNs, 45 (n = 66); 44 (n = 10) and 43 (n = 5). The most frequently lost chromosomes were chromosome 9 and sex chromosomes. Five-year event-free survival (EFS) and overall survival (OS) were 34% and 52%, respectively, for the hypodiploid cohort. Children with MN≤44 (n = 15) had inferior EFS (21%) and OS (33%) compared with children with MN = 45 (n = 66; EFS, 37%; OS, 56%). Adjusted hazard ratios (HRs) were 4.9 (P = .001) and 6.1 (P = .003). Monosomal karyotype or monosomy 9 had particular poor OS (43% and 15%, respectively). Allogeneic stem cell transplantation (SCT) in first complete remission (CR1) (n = 18) did not mitigate the unfavorable outcome of hypodiploidy (adjusted HR for OS was 1.5; P = .42). We identified pediatric hypodiploid AML as a rare subgroup with an inferior prognosis even in the patients treated with SCT in CR1.","author_count":22,"contributors":["Hammer, Anne Sofie Borg","Juul-Dam, Kristian Løvvik","Sandahl, Julie Damgaard","Abrahamsson, Jonas","Czogala, Malgorzata","Delabesse, Emmanuelle","Haltrich, Iren","Jahnukainen, Kirsi","Kolb, E. Anders","Kovács, Gábor L","Leverger, Guy","Locatelli, Franco","Masetti, Riccardo","Norén-Nyström, Ulrika","Raimondi, Susana C","Rasche, Mareike","Reinhardt, Dirk","Taki, Tomohiko","Tomizawa, Daisuke","Hasle, Henrik","Kjeldsen, Eigil","Zeller, Bernward","Hasle, Henrik","Kjeldsen, Eigil"],"cuid":["S01-000.00-274371"],"filters":{"added":"2022-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Asia, East","Europe, EU","Europe, Non-EU","Nordic","OECD"],"corpau":["The I-BFM-AML Study Group"],"corresponding_author":["Hammer, Anne Sofie Borg"],"country":["Finland","France","Germany","Hungary","Italy","Japan","Norway","Poland","Sweden","United States"],"glorg":["Alfred I. duPont Hospital for Children","All Global Affiliations","Catholic University of the Sacred Heart","Hopital Armand-Trousseau","Kyorin University","National Center for Child Health and Development","Sahlgrenska University Hospital","Semmelweis University","St. Jude Children Research Hospital","Umeå University","University Institute for Cancer Research - Toulouse","University of Bologna","University of Duisburg-Essen","University of Helsinki","University of Oslo","Universytet Jagielloński"],"keyword":["Child","Humans","Leukemia Myeloid Acute genetics","Precursor Cell Lymphoblastic Leukemia Lymphoma","Prognosis","Remission Induction","Retrospective Studies"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"hypodiploidy has unfavorable impact on survival in pediatric acute myeloid leukemia an i bfm study group collaboration","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1182/bloodadvances.2022008251","version":"Published Version"},"id":"S01-000.00-274371","identifier":[{"id":"36332007","type":"pmid"},{"id":"PMC10036516","type":"pmcid"},{"id":"85152915961","type":"scopus"}],"ids":["au-fe39383d-6bce-4b0c-91d6-2d65e8192a65"],"keyword":["Child