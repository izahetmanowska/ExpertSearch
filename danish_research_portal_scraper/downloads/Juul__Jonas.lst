{"abstract":"Undervisningsforløb om brugen af skitse og tegninger i geometri. Forløbet tager udgangspunkt i designprocesser, hvor man bruger skitse og præcise tegninger samt inddrager arbejdet med målestoksforhold.","author_count":2,"contributors":["Hansen, Jonas Juul"],"cuid":["S01-000.00-689226"],"filters":{"added":"2023-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Geometri","Læring pædagogik og undervisning","Matematik","Matematikundervisning"],"level":"edu","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-UC"],"level3":{"UC":["DI-UC-ALL","DI-UC-KP"]},"level3all":["DI-UC-KP"]},"review":"und","rtype":["clu"],"sorti":"skitse og tegning","src":["kp"],"src-code":["DI-UC-KP"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://matematik.alinea.dk/course/9YNC-skitse-og-tegning?portalclick=coursessection","version":"Other Version"},"id":"S01-000.00-689226","ids":["kp-d7f2f8df-58e6-4f2d-83ea-c5c0f20cbb97"],"keyword":["Læring, pædagogik og undervisning","Matematik","Matematikundervisning","geometri"],"lang":"Danish","level":"Educational","mra":["Humanities"],"noi":["Local-1-1-6FEB295C8E807D75A5724283E00AD637"],"org":[{"affno":"1","key":"kp university college copenhagen","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-KP","l3nl":"KP","l3nn":"KP University College Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KP University College Copenhagen","namevar":["Københavns Professionshøjskole, Rektors område, Fakultet for læreruddannelse og livslang læring - Dekan, CFU Vejledning og formidling"],"nora_code":"DI-UC-KP","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jonas Juul","key":"hansenpau","last":"Hansen","locid":"869fff1a-19d9-4da5-86c2-ca41f1ce3968","name":"Hansen, Jonas Juul","rank":1,"rolecode":"pau"},{"affno":"","first":"Susanne","key":"schulianpedh","last":"Schulian","name":"Schulian, Susanne","ran