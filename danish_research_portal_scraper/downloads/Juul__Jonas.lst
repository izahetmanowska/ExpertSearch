ristian","orcid":"0000-0001-6551-6647","rank":27,"rolecode":"pau"},{"affno":"1","first":"Sisse R.","key":"ostrowskisisseryepau","last":"Ostrowski","locid":"ba497828-2322-4b15-bfae-1e8a8c3895e7","name":"Ostrowski, Sisse Rye","name_org":"Ostrowski, Sisse R.","orcid":"0000-0001-5288-3851","rank":28,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Sisse R","key":"ostrowskisisserpau","last":"Ostrowski","name":"Ostrowski, Sisse R","rank":28,"rolecode":"pau"},{"affno":"1","first":"Susanne Dam","key":"nielsensusannedampau","last":"Nielsen","locid":"2baa36fa-2709-482a-9595-52c5b9537801","name":"Nielsen, Susanne Dam","rank":29,"rolecode":"pau"},{"affno":"1","first":"Henning","key":"bundgaardhenningpau","last":"Bundgaard","locid":"254c7f8d-79dd-4a5d-870f-3ed78cb56464","name":"Bundgaard, Henning","rank":30,"rolecode":"pau"}],"pmid":["34543759"],"pub":{"doi":"10.1016/j.cmi.2021.09.005","issn":["1198743X","14690691"],"issn_org":["1198743X"],"issue":"5","journal":"Clinical Microbiology and Infection","pages":"710-717","publisher":"Elsevier BV","publisher_org":"Elsevier B.V.","status":"p","title":"Clinical Microbiology and Infection","volume":"28"},"review":"Peer Reviewed","scoID":["2-s2.0-85116788811"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Governmental Institutions","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Miscellaneous","Other Research","Region Zealand","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-9bd0933e-b051-48f8-bb53-fbcff4260867","ku-410084e1-ade0-479e-8183-64d8fa010f57","sdu-5d4e38dc-27c3-4e7e-aed1-125f10e99f72"],"src":["AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Seroprevalence of SARS-CoV-2 antibodies and reduced risk of reinfection through 6 months : a Danish observational cohort study of 44 000 healthcare workers","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-100.00-024022","year":"2022","yearsub":"2022"}
{"abstract":"Loss-of-function (LoF) mutations in KCNQ1, encoding the voltage-gated K+ channel Kv7.1, lead to long QT syndrome 1 (LQT1). LQT1 patients also present with post-prandial hyperinsulinemia and hypoglycaemia. In contrast, KCNQ1 polymorphisms are associated with diabetes, and LQTS patients have a higher prevalence of diabetes. We developed a mouse model with a LoF Kcnq1 mutation using CRISPR-Cas9 and hypothesized that this mouse model would display QT prolongation, increased glucose-stimulated insulin secretion and allow for interrogation of Kv7.1 function in islets. Mice were characterized by electrocardiography and oral glucose tolerance tests. Ex vivo, islet glucose-induced insulin release was measured, and beta-cell area quantified by immunohistochemistry. Homozygous mice had QT prolongation. Ex vivo, glucose-stimulated insulin release was increased in islets from homozygous mice at 12-14 weeks, while beta-cell area was reduced. Non-fasting blood glucose levels were decreased at this age. In follow-up studies 8-10 weeks later, beta-cell area was similar in all groups, while glucose-stimulated insulin secretion was now reduced in islets from hetero- and homozygous mice. Non-fasting blood glucose levels had normalized. These data suggest that Kv7.1 dysfunction is involved in a transition from hyper- to hyposecretion of insulin, potentially explaining the association with both hypoglycemia and hyperglycemia in LQT1 patients.","author_count":17,"contributors":["Lubberding, Anniek Frederike","Zhang, Jinyi","Lundh, Morten","Nielsen, Thomas Svava","Søndergaard, Mathilde S","Villadsen, Maria","Skovhøj, Emil Z.","Boer, Geke Aline","Hansen, Jakob Bondo","Thomsen, Morten B.","Treebak, Jonas T.","Holst, Jens Juul","Kanters, Jørgen K.","Mandrup-Poulsen, Thomas","Jespersen, Thomas","Emanuelli, Brice","Torekov, Signe Sørensen"],"cuid":["S01-000.00-442392"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-NOVO"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-PR-NOVO","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"age dependent transition from islet insulin hypersecretion to hyposecretion in mice with the long qt syndrome loss of function mutation kcnq000000000001 a000000000340v","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41598-021-90452-8","version":"Published Version"},"id":"S01-000.00-442392","identifier":[{"id":"85107461248","type":"scopus"},{"id":"PMC8192901","type":"pmcid"},{"id":"000663785600003","type":"wos"},{"id":"34112814","type":"pmid"}],"ids":["ku-51f59b66-97e6-47f6-b669-894d49285525"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-53E32EADACF96D991650E3994DEE2F55"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/272640852/s41598_021_90452_8.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41598-021-90452-8","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Biomedical Sciences, Inflammation, Metabolism and Oxidation"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"novo nordisk","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-NOVO","l3nl":"Novo Nordisk","l3nn":"Novo Nordisk","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Novo Nordisk","namevar":["Novo Nordisk"],"nora_code":"DI-PR-NOVO","used":1}],"person":[{"affno":"1","first":"Anniek F","key":"lubberdingpau","last":"Lubberding","locid":"1e6eede6-d706-4e3a-903b-fb86d5374d13","name":"Lubberding, Anniek Frederike","name_org":"Lubberding, Anniek F","orcid":"0000-0002-6691-8581","rank":1,"rolecode":"pau"},{"affno":"1 2","first":"Jinyi","key":"zhangpau","last":"Zhang","locid":"6516c7b0-962b-41cf-8ff9-eac3ee2d054e","name":"Zhang, Jinyi","rank":2,"rolecode":"pau"},{"affno":"1","first":"Morten","key":"lundhpau","last":"Lundh","locid":"68d27e9f-656d-4e57-9090-56f9e9373fc1","name":"Lundh, Morten","orcid":"0000-0003-0918-577X","rank":3,"rolecode":"pau"},{"affno":"1","first":"Thomas Svava","key":"nielsenpau","last":"Nielsen","locid":"a579c623-8238-41b9-92fd-0d670a5cac39","name":"Nielsen, Thomas Svava","orcid":"0000-0002-9457-8000","rank":4,"rolecode":"pau"},{"affno":"1","first":"Mathilde S","key":"søndergaardpau","last":"Søndergaard","name":"Søndergaard, Mathilde S","rank":5,"rolecode":"pau"},{"affno":"1","first":"Maria","key":"villadsenpau","last":"Villadsen","name":"Villadsen, Maria","rank":6,"rolecode":"pau"},{"affno":"1","first":"Emil Z.","key":"skovhøjpau","last":"Skovhøj","name":"Skovhøj, Emil Z.","rank":7,"rolecode":"pau"},{"affno":"1","first":"Geke A","key":"boerpau","last":"Boer","locid":"550f14ad-8b44-4ade-9a01-3335ac6a3502","name":"Boer, Geke Aline","name_org":"Boer, Geke A","orcid":"0000-0003-3847-153X","rank":8,"rolecode":"pau"},{"affno":"1","first":"Jakob B","key":"hansenpau","last":"Hansen","locid":"42ca4a29-4121-40df-8854-4ae63ab60939","name":"Hansen, Jakob Bondo","name_org":"Hansen, Jakob B","orcid":"0000-0002-6837-0919","rank":9,"rolecode":"pau"},{"affno":"1","first":"Morten B","key":"thomsenpau","last":"Thomsen","locid":"de1e0c60-60e1-46cb-b71c-32232c6ba6ed","name":"Thomsen, Morten B.","name_org":"Thomsen, Morten B","orcid":"0000-0002-2469-6458","rank":10,"rolecode":"pau"},{"affno":"1","first":"Jonas T","key":"treebakpau","last":"Treebak","locid":"a648ef82-ccb3-4add-83c1-384e0d90952b","name":"Treebak, Jonas T.","name_org":"Treebak, Jonas T","orcid":"0000-0003-1488-7012","rank":11,"rolecode":"pau"},{"affno":"1","first":"Jens J","key":"holstpau","last":"Holst","locid":"864b6401-9024-4773-9bdb-f4d4ca57dcad","name":"Holst, Jens Juul","name_org":"Holst, Jens J","orcid":"0000-0001-6853-3805","rank":12,"rolecode":"pau"},{"affno":"1","first":"Jørgen K","key":"kanterspau","last":"Kanters","locid":"f544654f-76ab-44f6-a780-d0a011eb7341","name":"Kanters, Jørgen K.","name_org":"Kanters, Jørgen K","orcid":"0000-0002-3267-4910","rank":13,"rolecode":"pau"},{"affno":"1","first":"Thomas","key":"mandruppoulsenpau","last":"Mandrup-Poulsen","locid":"3d24585d-c2e8-4656-b1a6-3aa703263d73","name":"Mandrup-Poulsen, Thomas","rank":14,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Thomas","key":"jespersenpau","last":"Jespersen","locid":"db23d6cb-3abe-4ba2-b1d3-44f918c72e51","name":"Jespersen, Thomas","orcid":"0000-0001-6575-360X","rank":15,"rolecode":"pau"},{"affno":"1","first":"Brice","key":"emanuellipau","last":"Emanuelli","locid":"67a4f742-a844-427b-9de5-db0ccf844016","name":"Emanuelli, Brice","orcid":"0000-0001-5795-5666","rank":16,"rolecode":"pau"},{"affno":"1","first":"Signe S","key":"torekovpau","last":"Torekov","locid":"c1d71a61-ee09-4c29-ae48-7520707a73be","name":"Torekov, Signe Sørensen","name_org":"Torekov, Signe S","orcid":"0000-0001-6779-0252","rank":17,"rolecode":"pau"}],"pmid":["34112814"],"pub":{"doi":"10.1038/s41598-021-90452-8","issn":["20452322"],"issue":"1","journal":"Scientific Reports","paperid":"12253","status":"p","title":"Scientific Reports","volume":"11"},"review":"Peer Reviewed","scoID":["2-s2.0-85107461248"],"search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Novo Nordisk","Private Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-51f59b66-97e6-47f6-b669-894d49285525"],"src":["KU University of Copenhagen"],"title":"Age-dependent transition from islet insulin hypersecretion to hyposecretion in mice with the long QT-syndrome loss-of-function mutation Kcnq1-A340V","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-442392","year":"2021","yearsub":"2021"}
{"abstract":"Background: The risk for cardiovascular adverse events after acute myocardial infarction (AMI) remains high despite potent medical treatment including low-density lipoprotein cholesterol (LDL-C) lowering with statins. Proprotein convertase subtilisin/kexin type 9 (PCSK9) antibodies substantially reduce LDL-C when added to statin. Alirocumab, a monoclonal antibody to PCSK9, reduces major adverse cardiovascular events after AMI. The effects of alirocumab on coronary atherosclerosis including plaque burden, plaque composition and fibrous cap thickness in patients presenting with AMI remains unknown. Aims: To determine the effect of LDL-C lowering with alirocumab on top of high-intensity statin therapy on intravascular ultrasound (IVUS)-derived percent atheroma volume (PAV), near-infrared spectroscopy (NIRS)-derived maximum lipid core burden index within 4 mm (maxLCBI4 mm) and optical coherence tomography (OCT)-derived fibrous cap thickness (FCT) in patients with AMI. Methods: In this multicenter, double-blind, placebo-controlled trial, 300 patients with AMI (ST-elevation or non-ST-elevation myocardial infarction) were randomly assigned to receive either biweekly subcutaneous alirocumab (150 mg) or placebo beginning <24 hours after the acute event as add-on therapy to rosuvastatin 20 mg. Patients undergo serial IVUS, NIRS and OCT in the two non-infarct related arteries at baseline (at the time of treatment of the culprit lesion) and at 52 weeks. The primary endpoint, change in IVUS-derived PAV, and the powered secondary endpoints, change in NIRS-derived maxLCBI4 mm, and OCT-derived minimal FCT, will be assessed 52 weeks post randomization. The PACMAN-AMI trial will determine the effect of alirocumab on top of high-intensity statin therapy on high-risk coronary plaque characteristics as assessed by serial, multimodality intracoronary imaging in patients presenting with AMI. Clinical trial registration: NCT03067844","author_count":24,"contributors":["Zanchin, Christian","Koskinas, Konstantinos C.","Ueki, Yasushi","Losdat, Sylvain","Häner, Jonas D.","Bär, Sarah","Otsuka, Tatsuhiko","Inderkum, Andrea","Jensen, Maria Radu Juul","Lonborg, Jacob","Fahrni, Gregor","Ondracek, Anna S.","Daemen, Joost","van Geuns, Robert Jan","Iglesias, Juan F.","Matter, Christian M.","Spirk, David","Juni, Peter","Mach, Francois","Heg, Dik","Engstrøm, Thomas","Lang, Irene","Windecker, Stephan","Räber, Lorenz"],"cuid":["S01-000.00-534144"],"filters":{"added":"2022-06","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Europe, EU","Europe, Non-EU","OECD"],"country":["Austria","Canada","Netherlands","Switzerland"],"glorg":["All Global Affiliations","Erasmus University Rotterdam","Medical University of Vienna","Radboud University Nijmegen","University of Basel","University of Bern","University of Geneva","University of Toronto","University of Zurich"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"effects of the pcsk000000000009 antibody alirocumab on coronary atherosclerosis in patients with acute myocardial infarction a serial multivessel intravascular ultrasound near infrared spectroscopy and optical coherence tomography imaging study rationale and design of the pacman ami trial","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-534144","identifier":[{"id":"33951415","type":"pmid"},{"id":"85107049244","type":"scopus"}],"ids":["ku-ebabc6ec-0963-43b1-a57d-bb8a63d16fbe"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-1993DD2346D682EA0D8E032B84B14404"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"ch","key":"university of bern