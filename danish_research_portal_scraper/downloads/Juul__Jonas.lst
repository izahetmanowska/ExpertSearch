nish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-20ff102f-8652-4953-a875-f5087afb3ef4"],"src":["AU Aarhus University"],"title":"International Trade and the Labour Market","type":"Thesis Doctoral","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-148232","year":"2017","yearsub":"2017"}
{"abstract":"BACKGROUND: Dual anti-platelet treatment with clopidogrel and aspirin is indicated for most patients after myocardial infarction. We examined the risk/benefit relationship of dual anti-platelet treatment according to age in a nationwide cohort of 30,532 myocardial infarction patients without revascularization. METHODS: Patients admitted with first-time myocardial infarction in 2002-2010, not undergoing revascularization, were identified from nationwide Danish registers. Dual anti-platelet treatment use was assessed by claimed prescriptions. Stratified into age groups, risk of bleeding, all-cause mortality and a combined endpoint of cardiovascular death, recurrent myocardial infarction and ischaemic stroke was analysed by Cox proportional-hazard models and tested in a propensity-score matched population. RESULTS: A total of 21,302 users and 9230 non-users of dual anti-platelet treatment were included (mean age 67.02 (±13.8) years and 64.7% males). Use of dual anti-platelet treatment decreased with age: 80% (<60 years), 76% (60-69 years), 66% (70-79 years) and 52% (>79 years). We found a reduced risk of cardiovascular death, recurrent myocardial infarction and ischaemic stroke in users <60 years (Hazard ratio (HR) =0.69; 95% confidence interval (CI) 0.59-0.80), 60-69 years (HR=0.64; 95% CI 0.56-0.73), 70-79 years (HR=0.80; 95% CI 0.72-0.89) and >79 years (HR=0.92; 95% CI 0.84-1.01, NS). Risk of bleeding increased with dual anti-platelet treatment use in patients aged <60 years (HR=1.63; 95% CI 1.17-2.26), 60-69 years (HR=1.22; 95% CI 0.97-1.59, NS), 70-79 years (HR=1.42; 95% CI 1.17-1.72) and >79 years (HR=1.46; 95% CI 1.22-1.74). Similar tendencies in all four age groups were found in the propensity-matched population. CONCLUSION: Dual anti-platelet treatment use was less likely among elderly patients although similar effects regarding both risk and benefit were found in all age groups. Increased focus on initiating dual anti-platelet treatment in elderly, non-invasively treated myocardial infarction patients is warranted.","author_count":9,"contributors":["Juul, Nikolai","Gislason, Gunnar","Olesen, Jonas Bjerring","Lamberts, Morten","Hansen, Morten Lock","Karasoy, Deniz","Christiansen, Christine Benn","Torp-Pedersen, Christian","Sorensen, Rikke"],"cuid":["S03-095.29-002103"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":3,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-AAU","DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-AAU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"risk and benefit of dual antiplatelet treatment among non revascularized myocardial infarction patients in different age groups","src":["aau","ku","sdu"],"src-code":["DI-U-AAU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85049035691","version":"Other Version"},"id":"S03-095.29-002103","identifier":[{"id":"85049035691","type":"scopus"},{"id":"24936092","type":"pmid"}],"ids":["aau-29dc68c5-31ef-423f-88fa-a7887f044adc","ku-df81bef9-e364-440c-b6a0-69de5c2b9124","sdu-37884246-bb90-4cec-bc6f-10bd960b8803"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-5657B7688E6200AD4E52EDFFE31854F4"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Gentofte Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Internal medicine: Cardiology"],"nora_code":"DI-U-KU","used":1},{"affno":"3","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, National Institute of Public Health, Research Programme on Health and Morbidity in Denmark"],"nora_code":"DI-U-SDU","used":1},{"affno":"4","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Public Health and Epidemiology"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Nikolai","key":"juulpau","last":"Juul","name":"Juul, Nikolai","rank":1,"rolecode":"pau"},{"affno":"2 1 3","first":"Gunnar","key":"gislasonpau","last":"Gislason","locid":"c0f678a6-eb13-49a3-9485-8fae1e72e2a1","name":"Gislason, Gunnar","orcid":"0000-0002-0548-402X","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jonas Bjerring","key":"olesenpau","last":"Olesen","name":"Olesen, Jonas Bjerring","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Morten","key":"lambertspau","last":"Lamberts","name":"Lamberts, Morten","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Morten Lock","key":"hansenpau","last":"Hansen","name":"Hansen, Morten Lock","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Deniz","key":"karasoypau","last":"Karasoy","name":"Karasoy, Deniz","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christine Benn","key":"christiansenpau","last":"Christiansen","name":"Christiansen, Christine Benn","rank":7,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"Christian","key":"torppedersenpau","last":"Torp-Pedersen","locid":"5417d806-0578-4505-b3fe-68ae0359913e","name":"Torp-Pedersen, Christian","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rikke","key":"sorensenpau","last":"Sorensen","name":"Sorensen, Rikke","rank":9,"rolecode":"pau"}],"pmid":["24936092"],"pub":{"doi":"10.1177/2048872614538848","issn":["20488726","20488734"],"issn_org":["20488734"],"issue":"6","journal":"European Heart Journal: Acute Cardiovascular Care","pages":"511-521","publisher":"Oxford University Press","status":"p","title":"European Heart Journal: Acute Cardiovascular Care","title_org":"European Heart Journal - Acute Cardiovascular Care","volume":"6"},"review":"Peer Reviewed","scoID":["2-s2.0-85049035691"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-29dc68c5-31ef-423f-88fa-a7887f044adc","ku-df81bef9-e364-440c-b6a0-69de5c2b9124","sdu-37884246-bb90-4cec-bc6f-10bd960b8803"],"src":["AAU Aalborg University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Risk and benefit of dual antiplatelet treatment among nonrevascularized myocardial infarction patients in different age groups","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-095.29-002103","year":"2017","yearsub":"2017"}
{"abstract":"Glucagon-like peptide-1 (GLP-1) is an incretin hormone increasing postprandial insulin release. GLP-1 also induces diuresis and natriuresis in humans and rodents. The GLP-1 receptor is extensively expressed in the renal vascular tree in normotensive rats where acute GLP-1 treatment leads to increased mean arterial pressure (MAP) and increased renal blood flow (RBF). In hypertensive animal models, GLP-1 has been reported both to increase and decrease MAP. The aim of this study was to examine expression of renal GLP-1 receptors in spontaneously hypertensive rats (SHR) and to assess the effect of acute intrarenal infusion of GLP-1. We hypothesized that GLP-1 would increase diuresis and natriuresis and reduce MAP in SHR. Immunohistochemical staining and in situ hybridization for the GLP-1 receptor were used to localize GLP-1 receptors in the kidney. Sevoflurane-anesthetized normotensive Sprague-Dawley rats and SHR received a 20 min intrarenal infusion of GLP-1 and changes in MAP, RBF, heart rate, dieresis, and natriuresis were measured. The vasodilatory effect of GLP-1 was assessed in isolated interlobar arteries from normo- and hypertensive rats. We found no expression of GLP-1 receptors in the kidney from SHR. However, acute intrarenal infusion of GLP-1 increased MAP, RBF, dieresis, and natriuresis without affecting heart rate in both rat strains. These results suggest that the acute renal effects of GLP-1 in SHR are caused either by extrarenal GLP-1 receptors activating other mechanisms (e.g., insulin) to induce the renal changes observed or possibly by an alternative renal GLP-1 receptor.","author_count":5,"contributors":["Ronn, Jonas","Jensen, Elisa P","Wewer Albrechtsen, Nicolai J","Holst, Jens Juul","Sørensen, Charlotte Mehlin"],"cuid":["S01-000.00-505914"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"glucagon like peptide 000000000001 acutely affects renal blood flow and urinary flow rate in spontaneously hypertensive rats despite significantly reduced renal expression of glp 000000000001 receptors","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.14814/phy2.13503","version":"Published Version"},"id":"S01-000.00-505914","identifier":[{"id":"85049983565","type":"scopus"},{"id":"29233907","type":"pmid"},{"id":"PMC5727271","type":"pmcid"}],"ids":["ku-bc72dab9-f3ff-4f14-826c-b9556498cfc2"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-C24D776B7BCD6E4C658FE616958461DF"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/192114789/e13503.full.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.14814/phy2.13503","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Biomedical Sciences"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Jonas","key":"ronnpau","last":"Ronn","locid":"ac534c5e-bfdb-4e6f-a45a-164cdc19d603","name":"Ronn, Jonas","rank":1,"rolecode":"pau"},{"affno":"1","first":"Elisa P","key":"jensenpau","last":"Jensen","locid":"f1b5e371-9e23-4d3c-9879-c76a109807d5","name":"Jensen, Elisa P","rank":2,"rolecode":"pau"},{"affno":"1","first":"Nicolai J","key":"weweralbrechtsenpau","last":"Wewer Albrechtsen","locid":"0d59b767-fdca-42a0-b879-70fb0ec55651","name":"Wewer Albrechtsen, Nicolai J","orcid":"0000-0003-4230-5753","rank":3,"rolecode":"pau"},{"affno":"1","first":"Jens Juul","key":"holstpau","last":"Holst","locid":"864b6401-9024-4773-9bdb-f4d4ca57dcad","name":"Holst, Jens Juul","orcid":"0000-0001-6853-3805","rank":4,"rolecode":"pau"},{"affno":"1","first":"Charlotte M","key":"sorensenpau","last":"Sorensen","locid":"0ceca69d-e5cd-43dc-9995-305ac5855c4f","name":"Sørensen, Charlotte Mehlin","name_org":"Sorensen, Charlotte M","orcid":"0000-0002-9984-3125","rank":5,"rolecode":"pau"}],"pmid":["29233907"],"pub":{"doi":"10.14814/phy2.13503","issn":["2051817X"],"issue":"23","journal":"Physiological Reports","paperid":"e13503","status":"p","title":"Physiological Reports","volume":"5"},"review":"Peer Reviewed","scoID":["2-s2.0-85049983565"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-bc72dab9-f3ff-4f14-826c-b9556498cfc2"],"src":["KU University of Copenhagen"],"title":"Glucagon-like peptide-1 acutely affects renal blood flow and urinary flow rate in spontaneously hypertensive rats despite significantly reduced renal expression of GLP-1 receptors","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-505914","year":"2017","yearsub":"2017"}
{"abstract":"On the basis of bass cabinets, this paper deals with the problem of reducing loudspeaker enclosure weight. An introductory market analysis emphasizes that lighter cabinets are sought, but maintenance of sound quality is vital. The problem is challenged through experiments and simulations in COMSOL Multiphysics, which indicate that weight reduction and sound quality maintenance is possible by reducing wall thickness and using adequate bracing and lining.","author_count":5,"contributors":["Juul-Nyholm, Herle Kjemtrup","Severinsen, Jonas Corfitz","Schneider, Henrik","Mortensen, Niels Henrik","Andersen, Michael A. E."],"cuid":["S01-000.00-366931"],"event":{"end":"2017-05-23","place":"Berlin, de","start":"2017-05-20","title":"142nd Audio Engineering Society Convention","year":"2017"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"construction of lightweight loudspeaker enclosures","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/132613635/AES_Convention_Paper_Construction_of_Lightweight_Loudspeaker_Enclosures.pdf","version":"Authors Final Version"},"id":"S01-000.00-366931","identifier":[{"id":"85026659821","type":"scopus"}],"ids":["dtu-d0c13221-82f3-4636-bdea-4b30a10f6a56"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-D54F27E5B122183E85EB0FF1BDE556CD"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/132613635/AES_Convention_Paper_Construction_of_Lightweight_Loudspeaker_Enclosures.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Mechanical Engineering","Technical University of Denmark, Department of Mechanical Engineering, Engineering Design and Product Development"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Herle Bagh","key":"juulnyholmpau","last":"Juul-Nyholm","locid":"0fb4790c-0c9d-419b-9eb4-e2e1a1371055","name":"Juul-Nyholm, Herle Kjemtrup","name_org":"Juul-Nyholm, Herle Bagh","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jonas Corfitz","key":"severinsenpau","last":"Severinsen","locid":"1a62711b-e659-451e-8c4d-041e90699be2","name":"Severinsen, Jonas Corfitz","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik","key":"schneiderpau","last":"Schneider","locid":"932f50c3-c0f6-4a9a-a531-fd529a8d0dc8","name":"Schneider, Henrik","orcid":"0000-0003-3039-2845","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Niels Henrik","key":"mortensenpau","last":"Mortensen","locid":"3c76e390-158f-485c-9d64-f15130baecf2","name":"Mortensen, Niels Henrik","orcid":"0000-0002-1886-5358","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Michael A. E.","key":"andersenpau","last":"Andersen","locid":"1e71af2a-0149-4a90-8b9a-2488dea17dcd","name":"Andersen, Michael A. E.","orcid":"0000-0002-5612-0541","rank":5,"rolecode":"pau"}],"pub":{"publisher":"Audio Engineering Society","status":"p","title":"Proceedings of the 142<sup>nd</sup> Audio Engineering Convention Convention"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-d0c13221-82f3-4636-bdea-4b30a10f6a56"],"src":["DTU Technical University of Denmark"],"title":"Construction of Lightweight Loudspeaker Enclosures","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-366931","year":"2017","yearsub":"2017"}
{"abstract":"Undervisningsforløb til matematikundervisningen som en del af et fælles tema - digital dannelse - i grundskolen. Forløbet arbejde med geometri, 2d og 3d grafik, hvor eleverne skal designe og redesigne deres eget klasseværelse i Virtual Reality via programmet CoSpaces.","author_count":2,"contributors":["Hansen, Jonas Juul","Exner, Martin"],"cuid":["S01-000.00-689209"],"filters":{"added":"2023-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Dannelse","Digital dannelse","Læring pædagogik og undervisning","Matematik","Matematikundervisning","Teknologi","Teknologiforståelse"],"level":"edu","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-UC"],"level3":{"UC":["DI-UC-ALL","DI-UC-KP"]},"level3all":["DI-UC-KP"]},"review":"und","rtype":["clu"],"sorti":"din skole i virtual reality","src":["kp"],"src-code":["DI-UC-KP"],"type":"doo","type-grp":["all","pub"]},"id":"S01-000.00-689209","ids":["kp-4349cc15-b92b-4f5f-a42d-9288b89da51c"],"keyword":["Dannelse","Digital dannelse","Læring, pædagogik og undervisning","Matematikundervisning","Teknologi","Teknologiforståelse","matematik"],"lang":"Danish","level":"Educational","mra":["Humanities"],"noi":["Local-1-1-05C3326F867631CFFAFCFEFA84DDBAF9"],"org":[{"affno":"1","key":"kp university college copenhagen","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-KP","l3nl":"KP","l3nn":"KP University College Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KP University College Copenhagen","namevar":["Københavns Professionshøjskole, Rektors område, Fakultet for læreruddannelse og livslang læring - Dekan, CFU Vejledning og formidling"],"nora_code":"DI-UC-KP","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jonas Juul","key":"hansenpau","last":"Hansen","locid":"869fff1a-19d9-4da5-86c2-ca41f1ce3968","name":"Hansen, Jonas Juul","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Martin","key":"exnerpau","last":"Exner","locid":"43749912-9103-4ae1-87ab-75b896578ad5","name":"Exner, Martin","rank":2,"rolecode":"pau"}],"pub":{"publisher":"Børne- og Undervisningsministeriet","status":"p"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All University Colleges","DI-ALL","DI-UC","DI-UC-ALL","KP","University Colleges"],"PST":["Published"]},"sid":["kp-4349cc15-b92b-4f5f-a42d-9288b89da51c"],"src":["KP University College Copenhagen"],"title":"Din skole i Virtual Reality","type":"Other-Unknown","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-689209","year":"2017","yearsub":"2017"}
{"abstract":"Background: This intervention study aimed to enhance patient safety attitudes through the design of an in situ simulation program based on a needs analysis involving thematic analysis of patient safety data and short-term ethnography. The study took place at an Emergency Department (ED) in the Central Region of Denmark. Research suggests that poor handover communication can increase the likelihood of critical incidents and adverse events in the ED. Furthermore, simulation is an effective strategy for training handover communication skills. Research is lacking, however, on how to use patient safety data and a needs analysis to the design of in situ simulation communication training. Methods: This is a prospective pre-post study investigating the interventional effects of in situ simulation. It used a three-pronged strategy: (1) thematic analysis of patient safety data consisting of reported critical incidents and adverse events, (2) a needs analysis based on short-term ethnography in the ED, and (3) pre-post evaluation using the validated Safety Attitudes Questionnaire (SAQ) and the Trainee Reactions Score. Results: Sixteen different healthcare teams participated composed by 9 physicians and 30 nurses. In the SAQ, participating staff scored their safety attitudes in six categories (n = 39). Two measures where significantly higher for the post-SAQ than those for the pre-SAQ: teamwork climate (p < 0.001) and safety climate (p < 0.05). The Trainee Reactions Score showed that the training was positively evaluated. Conclusions: This study designed a feasible strategy for implementing in situ simulation based on a needs analysis of critical incidents and adverse events and short-term ethnography.","author_count":5,"contributors":["Paltved, Charlotte","Bjerregaard, Anders Thais","Krogh, Kristian","Pedersen, Jonas Juul","Musaeus, Peter"],"cuid":["S02-092.24-685958"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":1,"corresponding_author":["Musaeus, Peter"],"keyword":["Education","In situ simulation","Kommunikation","Patientsikkerhed","Simulation and Training","Uddannelse","skadestue"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"designing in situ simulation in the emergency department evaluating safety attitudes amongst physicians and nurses","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1186/s41077-017-0037-2","version":"Published Version"},"id":"S02-092.24-685958","identifier":[{"id":"PMC5806390","type":"pmcid"},{"id":"85062327459","type":"scopus"},{"id":"29450005","type":"pmid"}],"ids":["au-71e16f44-6961-4ef2-af97-ab56ceadb51d","au-ed8c3fb4-90de-4afb-9c98-274decb7a672"],"keyword":["Education","Emergency medicine and first responders","In situ simulation","Interprofessional collaborative practice","Kommunikation","Simulation and Training","Uddannelse","patientsikkerhed","skadestue"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-01C3BA7AF866D11975922F8560E2B7D9"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.au.dk/ws/files/110872540/Paltved_et_al_2017_Advances_in_Simulation_1_.pdf","version":"Other Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1186/s41077-017-0037-2","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, HE Centre, HE Centre - Centre for Health Sciences Education"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Charlotte","key":"paltvedpau","last":"Paltved","locid":"0d936f91-a209-44cf-8266-0bd9b128bd43","name":"Paltved, Charlotte","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders Thais","key":"bjerregaardpau","last":"Bjerregaard","locid":"6c5bdca5-b217-426c-9c41-da963da31be1","name":"Bjerregaard, Anders Thais","rank":2,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Kristian","key":"kroghpau","last":"Krogh","locid":"48e5c15c-34b7-48c3-9827-eb6c7fe8e20f","name":"Krogh, Kristian","orcid":"0000-0002-8490-1150","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jonas Juul","key":"pedersenpau","last":"Pedersen","locid":"1cae35fa-86f5-4035-9ea0-da5a6fcfd7af","name":"Pedersen, Jonas Juul","rank":4,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Peter","key":"musaeuspau","last":"Musaeus","locid":"3fdac7f7-8bb3-4bb8-94ae-ddf95cf31744","name":"Musaeus, Peter","orcid":"0000-0001-6062-055X","rank":5,"rolecode":"pau"}],"pmid":["29450005"],"pub":{"doi":"10.1186/s41077-017-0037-2","issn":["20590628"],"journal":"Advances in Simulation","pages":"1-10","paperid":"4","publisher":"BioMed Central","status":"p","title":"Advances in Simulation","volume":"2"},"review":"Peer Reviewed","scoID":["2-s2.0-85062327459"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-71e16f44-6961-4ef2-af97-ab56ceadb51d","au-ed8c3fb4-90de-4afb-9c98-274decb7a672"],"src":["AU Aarhus University"],"title":"Designing in situ simulation in the emergency department : Evaluating safety attitudes amongst physicians and nurses","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-092.24-685958","year":"2017","yearsub":"2017"}
{"abstract":"Purpose The general outlook for patients with diffuse large B-cell lymphoma (DLBCL) in first remission is important information for patients and for planning post-treatment follow-up. The purpose of this study was to evaluate the survival of patients with DLBCL in remission compared with a matched general population. Methods A total of 1,621 patients from the Danish Lymphoma Registry who were newly diagnosed with DLBCL between 2003 and 2011 were included in this study. All patients were ≥ 16 years of age at diagnosis and had achieved complete remission or complete remission unconfirmed after first-line rituximab plus cyclophosphamide, doxorubicin, vincristine, and prednisone (R-CHOP) or R-CHOP-like therapy. Results The 5-year post-treatment DLBCL survival was inferior to survival in the matched general population (78%; 95% CI, 76 to 80; v 87%; standardized mortality ratio, 1.75; P < .001). Excess mortality was present but reduced for patients achieving post-treatment event-free survival for 24 months (pEFS24; standardized mortality ratio, 1.27; P < .001). In age-stratified analyses, the survival of patients < 50 years of age was normalized to the general population after achieving pEFS24 ( P = .99). During the first 8 years after pEFS24, the average loss of lifetime was 0.31 mo/y (95% CI, 0.11 to 0.50 mo/y). Excess mortality diminished when analyzing death from lymphoma as competing event to death from other causes, suggesting that early and late relapse is responsible for increased mortality in patients with DLBCL. Conclusion Although this population-based study does not support complete normalization of survival for patients with DLBCL achieving pEFS24, the estimated loss of residual lifetime was low for patients in continuous remission 2 years after ending treatment. Therefore, pEFS24 is an appealing and relevant milestone for patient counseling and could be a surrogate end point in clinical trials.","author_count":15,"contributors":["Jakobsen, Lasse Hjort","Bøgsted, Martin","Brown, Peter De Nully","Arboe, Bente","Jørgensen, Judit","Larsen, Thomas Stauffer","Juul, Maja Bech","Schurmann, Lene","Højberg, Linda","Bergmann, Olav Jonas","Lassen, Therese","Josefsson, Pär Lars","Jensen, Paw","Johnsen, Hans Erik","El-Galaly, Tarec Christoffer"],"cuid":["S04-099.98-010055"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"keyword":["Adolescent","Adult","Aged","Antibodies Monoclonal Murine Derived","Antineoplastic Combined Chemotherapy Protocols","Cyclophosphamide","Denmark","Disease Free Survival","Doxorubicin","Female","Humans","Journal Article","Life Expectancy","Lymphoma Large B Cell Diffuse","Male","Middle Aged","Prednisone","Remission Induction","Vincristine","Young Adult"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"minimal loss of lifetime for patients with diffuse large b cell lymphoma in remission and event free 000000000024 months after treatment a danish population based study","src":["aau","au","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85014008148","version":"Other Version"},"id":"S04-099.98-010055","identifier":[{"id":"000396366100012","type":"wos"},{"id":"85014008148","type":"scopus"},{"id":"28095160","type":"pmid"}],"ids":["aau-d1f341d6-f59f-460a-866f-179499e6afb7","au-976c9b9c-bc42-4f8a-93a8-48f7be018936","ku-cc79cc03-b6fc-4030-ac56-4e539950ce00","sdu-64ee3052-bd77-4126-89be-d0c57a907f9f"],"keyword":["Adolesce