:"vistisenpau","last":"Vistisen","name":"Vistisen, Dorte","rank":5,"rolecode":"pau"},{"affno":"","first":"Kristian","key":"karstoftpau","last":"Karstoft","name":"Karstoft, Kristian","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Frederik","key":"perssonpau","last":"Persson","name":"Persson, Frederik","rank":7,"rolecode":"pau"},{"affno":"","first":"Mathias","key":"riedlarsenpau","last":"Ried-Larsen","name":"Ried-Larsen, Mathias","rank":8,"rolecode":"pau"},{"affno":"2","first":"Jens J.","key":"holstpau","last":"Holst","locid":"864b6401-9024-4773-9bdb-f4d4ca57dcad","name":"Holst, Jens Juul","name_org":"Holst, Jens J.","orcid":"0000-0001-6853-3805","rank":9,"rolecode":"pau"},{"affno":"2","first":"Nicolai J.","key":"weweralbrechtsenpau","last":"Wewer Albrechtsen","locid":"0d59b767-fdca-42a0-b879-70fb0ec55651","name":"Wewer Albrechtsen, Nicolai J","name_org":"Wewer Albrechtsen, Nicolai J.","orcid":"0000-0003-4230-5753","rank":10,"rolecode":"pau"},{"affno":"2","first":"Signe S.","key":"torekovpau","last":"Torekov","locid":"c1d71a61-ee09-4c29-ae48-7520707a73be","name":"Torekov, Signe Sørensen","name_org":"Torekov, Signe S.","orcid":"0000-0001-6779-0252","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jonas S.","key":"quistpau","last":"Quist","name":"Quist, Jonas S.","rank":12,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"first":"Marit E.","key":"jørgensenpau","last":"Jørgensen","locid":"5a2309e5-48cd-4773-9887-7b0255811460","name":"Jørgensen, Marit Eika","name_org":"Jørgensen, Marit E.","orcid":"0000-0001-8356-5565","rank":13,"rolecode":"pau"},{"affno":"","first":"Marit E.","key":"jorgensenpau","last":"Jorgensen","name":"Jorgensen, Marit E.","rank":13,"rolecode":"pau"},{"affno":"2","first":"Kristine","key":"faerchpau","last":"Faerch","locid":"21e08d16-438a-4801-9fbd-94ab9cee9426","name":"Færch, Kristine","name_org":"Faerch, Kristine","rank":14,"rolecode":"pau"}],"pmid":["33146457"],"pub":{"doi":"10.1111/dom.14246","issn":["14628902","14631326"],"issn_org":["14628902"],"issue":"2","journal":"Diabetes, Obesity and Metabolism","pages":"530-539","publisher":"Wiley","status":"p","title":"Diabetes, Obesity and Metabolism","volume":"23"},"review":"Peer Reviewed","scoID":["2-s2.0-85096652496"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-0aababd1-737b-4ef2-a8b1-81abcdc71243","sdu-648fe11d-60d2-4e19-9f12-e0fcff4b90c7"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"No effects of dapagliflozin, metformin or exercise on plasma glucagon concentrations in individuals with prediabetes : A post hoc analysis from the randomized controlled PRE-D trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-097.30-040022","year":"2021","yearsub":"2021"}
{"abstract":"Most individuals seroconvert after infection with severe acute respiratory syndrome coronavirus 2 (SARS-CoV-2), but being seronegative is observed in 1 to 9%. We aimed to investigate the risk factors associated with being seronegative following PCR-confirmed SARS-CoV-2 infection. In a prospective cohort study, we screened health care workers (HCW) in the Capital Region of Denmark for SARSCoV-2 antibodies. We performed three rounds of screening from April to October 2020 using an enzyme-linked immunosorbent assay (ELISA) method targeting SARS-CoV-2 total antibodies. Data on all participants’ PCR for SARS-CoV-2 RNA were captured from national registries. The Kaplan-Meier method and Cox proportional hazards models were applied to investigate the probability of being seronegative and the related risk factors, respectively. Of 36,583 HCW, 866 (2.4%) had a positive PCR before or during the study period. The median (interquartile range [IQR]) age of 866 HCW was 42 (31 to 53) years, and 666 (77%) were female. After a median of 132 (range, 35 to 180) days, 21 (2.4%) of 866 were seronegative. In a multivariable model, independent risk factors for being seronegative were self-reported asymptomatic or mild infection hazard ratio (HR) of 6.6 (95% confidence interval [CI], 2.6 to 17; P, 0.001) and body mass index (BMI) of $30, HR 3.1 (95% CI, 1.1 to 8.8; P = 0.039). Only a few (2.4%) HCW were not seropositive. Asymptomatic or mild infection as well as a BMI above 30 were associated with being seronegative. Since the presence of antibodies against SARS-CoV-2 reduces the risk of reinfection, efforts to protect HCW with risk factors for being seronegative may be needed in future COVID-19 surges. IMPORTANCE Most individuals seroconvert after infection with severe acute respiratory syndrome coronavirus 2 (SARS-CoV-2), but negative serology is observed in 1 to 9%. We found that asymptomatic or mild infection as well as a BMI above 30 were associated with being seronegative. Since the presence of antibodies against SARSCoV-2 reduces the risk of reinfection, efforts to protect HCW with risk factors for being seronegative may be needed in future COVID-19 surges.","author_count":36,"contributors":["Johannesen, Caroline Klint","Rezahosseini, Omid","Gybel-Brask, Mikkel","Kristensen, Jonas Henrik","Hasselbalch, Rasmus Bo","Pries-Heje, Mia Marie","Nielsen, Pernille Brok","Knudsen, Andreas Dehlbæk","Fogh, Kamille","Norsk, Jakob Boesgaard","Andersen, Ove","Jensen, Claus Antonio Juul","Torp-Pedersen, Christian","Rungby, Jørgen","Ditlev, Sisse Bolm","Hageman, Ida","Møgelvang, Rasmus","Dessau, Ram B","Sørensen, Erik","Harritshøj, Lene Holm","Folke, Fredrik","Sten, Curt","Møller, Maria Elizabeth Engel","Engsig, Frederik Neess","Ullum, Henrik","Jørgensen, Charlotte Sværke","Ostrowski, Sisse R","Bundgaard, Henning","Iversen, Kasper Karmark","Fischer, Thea Kølsen","Nielsen, Susanne Dam"],"cuid":["S03-098.29-004370"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"corresponding_author":["Nielsen, Susanne Dam"],"keyword":["Asymptomatic infections","Body Mass Index","Health care workers","Risk factor","SARS CoV 2","Seroconversion"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-AAU","DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-U-AAU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"risk factors for being seronegative following sars cov 000000000002 infection in a large cohort of health care workers in denmark","src":["aau","ku","sdu"],"src-code":["DI-U-AAU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1128/Spectrum.00904-21","version":"Published Version"},"id":"S03-098.29-004370","identifier":[{"id":"85119135631","type":"scopus"},{"id":"PMC8528102","type":"pmcid"},{"id":"34668738","type":"pmid"},{"id":"000728629300130","type":"wos"}],"ids":["aau-5995bbfc-7fbc-4d1f-a65d-43b844f5d44c","ku-29b1b186-00f2-4f7d-a857-ebf75755d592","sdu-e0d9918b-2253-4c96-b1ed-23f1064e2335"],"keyword":["Asymptomatic infections","Body mass index","Health care workers","Risk factor","SARS-CoV-2","Seroconversion"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-8663D5BF914B6A7B3030336E9DB59F5E"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1128/Spectrum.00904-21","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/194156382/Spectrum.00904_21.pdf","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/452590438/Johannesen_et_al._2021_._Risk_Factors_for_Being_Seronegative_following_SARS_CoV_2_Infection_in_a_Large_Cohort_of_Health_Care_Workers_in_Denmark.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/287606789/Risk_Factors_for_Being_Seronegative_following_SARS_CoV_2_Infection_in_a_Large_Cohort_of_Health_Care_Workers_in_Denmark.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OEC