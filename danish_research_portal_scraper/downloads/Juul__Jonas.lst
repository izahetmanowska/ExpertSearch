2e0567","name":"Pedersen, Julie Rønne","orcid":"0000-0002-7924-5312","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"James","key":"youngpau","last":"Young","locid":"358a4251-6873-4b1b-99df-826eaf19035d","name":"Young, James J.","name_org":"Young, James","orcid":"0000-0003-1210-3106","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jonas Bloch","key":"thorlundpau","last":"Thorlund","locid":"5b59bfe4-8aff-41d8-8b2d-4b19ab3e56c4","name":"Thorlund, Jonas Bloch","orcid":"0000-0001-7789-8224","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Birgit","key":"juulkristensenpau","last":"Juul-Kristensen","locid":"887ddfe7-cfa6-4b72-a17d-ecf86987c5c0","name":"Juul-Kristensen, Birgit","orcid":"0000-0002-4973-8415","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Carsten","key":"juhlpau","last":"Juhl","locid":"9381fad1-5721-4b98-ac99-7df1c6e4d837","name":"Juhl, Carsten Bogh","name_org":"Juhl, Carsten","orcid":"0000-0001-8456-5364","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1136/bjsports-2021-ioc.86","issn":["03063674","14730480"],"issn_org":["03063674"],"issue":"Suppl. 1","journal":"British Journal of Sports Medicine","paperid":"090","publisher":"BMJ Publishing Group","status":"p","title":"British Journal of Sports Medicine","volume":"55"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-699eaddf-aea8-4117-aaf9-45348966b055"],"src":["SDU University of Southern Denmark"],"title":"Joint hypermobility in athletes is associated with shoulder injury and shoulder pain: a systematic review and meta-analysis","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-603397","year":"2021","yearsub":"2021"}
{"abstract":"Purpose: The aim of this study was to investigate whether ESWT with a higher energy as an add-on therapy to vacuum-pump followed by manipulation exercises could reduce the penile curvature, pain and improve IIEF-5 score. Materials and Methods: Men aged >18 and <80 years and diagnosed with PD in stable phase with no history of penile surgery or previous ESWT treatment were eligible to participate. They were randomised to either active ESWT (n = 16) or sham ESWT (n = 16). Both groups were treated once a week for five weeks. Each treatment session consisted of 2000 shockwaves at 0.5mJ/mm2 . All patients in both groups used a vacuum pump followed by manipulation exercises. Results: Thirty men completed the study protocol. Mean age in the treatment group was 61.7 (SD 8.3) and 63 (SD 7.35) in the control group. After six months, mean change in penile curvature was −12.8 (SD 13) degrees in the treatment group and −6.6 (SD 8.9) in the control group (p = 0.204). Mean IIEF-5 score decreased by 0.17 (SD 3) in the treatment group and 3.06 (SD 5.5) in the control group (p = 0.086) at six-month follow-up. Pain was assessed using both VAS and PDQ and demonstrated no difference between the groups after six months (p = 0.648). Conclusion: In the treatment group, we observed a greater but non-significant change in penile curvature and no adverse effects.","author_count":4,"contributors":["Mortensen, Jonas","Møller Jeppesen, Sune","Juul Ladegaard, Peter Bill","Lund, Lars"],"cuid":["S01-000.00-622510"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Mortensen, Jonas"],"keyword":["ESWT","Erectile Dysfunction","Peyronie s disease","Vacuum pump"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-SDR","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"a randomized single blinded clinical trial evaluating the effect of extracorporeal shockwave treatment eswt as add on therapy to vacuum erectile device on peyronie s disease","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.2147/RRU.S325929","version":"Published Version"},"id":"S01-000.00-622510","identifier":[{"id":"85115807738","type":"scopus"},{"id":"PMC8453443","type":"pmcid"},{"id":"34557454","type":"pmid"}],"ids":["sdu-ac23b0d9-58fd-48bf-9197-d15314580180"],"keyword":["ESWT","Erectile dysfunction","Manipulation exercises","Peyronie’s disease","Vacuum pump"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-AF80107592BF2BCDA44BB0A74E35236B"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/192573164/RRU_325929_a_randomized_single_blinded_clinical_trial_evaluating_the_e.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.2147/RRU.S325929","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Odense University Hospital"],"nora_code":"DI-HO-SDR","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Urology (Odense)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jonas","key":"mortensenpau","last":"Mortensen","name":"Mortensen, Jonas","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Sune Møller","key":"skovjeppesenpau","last":"Skov-Jeppesen","locid":"bbfa7fca-0d95-4e1e-8cac-a6c578455c80","name":"Møller Jeppesen, Sune","name_org":"Skov-Jeppesen, Sune Møller","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Peter Bill Juul","key":"ladegaardpau","last":"Ladegaard","locid":"68dfcff8-58aa-4868-b66f-832fd5d60b9d","name":"Juul Ladegaard, Peter Bill","name_org":"Ladegaard, Peter Bill Juul","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lars","key":"lundpau","last":"Lund","locid":"2b53d464-d075-4614-9ee3-a9fedc0827b5","name":"Lund, Lars","orcid":"0000-0003-0391-9568","rank":4,"rolecode":"pau"}],"pmid":["34557454"],"pub":{"doi":"10.2147/rru.s325929","issn":["22532447"],"journal":"Research and Reports in Urology","pages":"715-722","publisher":"Dove Medical Press","status":"p","title":"Research and Reports in Urology","volume":"13"},"review":"Peer Reviewed","scoID":["2-s2.0-85115807738"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-ac23b0d9-58fd-48bf-9197-d15314580180"],"src":["SDU University of Southern Denmark"],"title":"A randomized, single-blinded clinical trial evaluating the effect of extracorporeal shockwave treatment (Eswt) as add-on therapy to vacuum erectile device on peyronie’s disease","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-622510","year":"2021","yearsub":"2021"}
