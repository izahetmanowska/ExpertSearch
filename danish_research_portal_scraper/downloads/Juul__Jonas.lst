0"},"review":"Peer Reviewed","scoID":["2-s2.0-85081714954"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-33183195-e00f-41ef-b4a1-c3185107ba0e","sdu-8b5915d8-0bd5-4beb-a12b-34fcebdf29e4"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"Measurable residual disease assessment by qPCR in peripheral blood is an informative tool for disease surveillance in childhood acute myeloid leukaemia","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-016347","year":"2020","yearsub":"2020"}
{"abstract":"This paper analyzes changes in within-firm inequality of hourly wages arising from export shocks to exporting firms in Denmark. We provide causal evidence that export demand shocks increase within-firm inequality. Decomposing overall inequality into within and between components for occupational and educational groups, the results show that exports lead to a significant increase in within-group wage inequality but do not affect the between-group component. We develop a partial equilibrium model, featuring heterogeneous workers, which rationalizes these observations and shows how export demand shocks induce a complementarity effect, leading to increases in wage inequality within firms.","author_count":2,"contributors":["Georgiev, Boris","Henriksen, Jonas Juul"],"cuid":["S01-000.00-215041"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"within firm wage inequality and firm level exports","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1111/roie.12439","version":"Published Version"},"id":"S01-000.00-215041","identifier":[{"id":"85073996122","type":"scopus"},{"id":"000486768600001","type":"wos"}],"ids":["au-967c8ad8-ea2b-45c8-b384-d7596379b003"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-4-59423CDE2F91F8093874189C145D14C6"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1111/roie.12439","version":"Published Version"}],"oai":{"class":"Blocked","mra":["Social Science (SOC)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus BSS, Department of Economics and Business Economics"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Boris","key":"georgievpau","last":"Georgiev","locid":"52e42ec3-6fc9-4104-99df-f63bc354c189","name":"Georgiev, Boris","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jonas Juul","key":"henriksenpau","last":"Henriksen","locid":"32789d28-a8b8-4325-8752-72763246d56d","name":"Henriksen, Jonas Juul","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1111/roie.12439","issn":["09657576","14679396"],"issn_org":["09657576"],"issue":"1","journal":"Review of International Economics","pages":"1-34","publisher":"Wiley-Blackwell Publishing Ltd","status":"p","title":"Review of International Economics","volume":"28"},"review":"Peer Reviewed","scoID":["2-s2.0-85073996122"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-967c8ad8-ea2b-45c8-b384-d7596379b003"],"src":["AU Aarhus University"],"title":"Within-firm wage inequality and firm-level exports","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-215041","year":"2020","yearsub":"2020"}
