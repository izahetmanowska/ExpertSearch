skningsportal.dk/search?modus=sin&s=LOI:S01-000.00-405938","year":"2022","yearsub":"2022"}
{"abstract":"Tissue sensitivity and response to exercise vary according to the time of day and alignment of circadian clocks, but the optimal exercise time to elicit a desired metabolic outcome is not fully defined. To understand how tissues independently and collectively respond to timed exercise, we applied a systems biology approach. We mapped and compared global metabolite responses of seven different mouse tissues and serum after an acute exercise bout performed at different times of the day. Comparative analyses of intra- and inter-tissue metabolite dynamics, including temporal profiling and blood sampling across liver and hindlimb muscles, uncovered an unbiased view of local and systemic metabolic responses to exercise unique to time of day. This comprehensive atlas of exercise metabolism provides clarity and physiological context regarding the production and distribution of canonical and novel time-dependent exerkine metabolites, such as 2-hydroxybutyrate (2-HB), and reveals insight into the health-promoting benefits of exercise on metabolism.","author_count":22,"contributors":["Sato, Shogo","Dyar, Kenneth A","Treebak, Jonas T.","Jepsen, Sara L","Ehrlich, Amy M.","Ashcroft, Stephen P","Trost, Kajetan","Kunzke, Thomas","Prade, Verena M","Small, Lewin","Basse, Astrid Linde","Schönke, Milena","Chen, Siwei","Samad, Muntaha","Baldi, Pierre","Barrès, Romain","Walch, Axel","Moritz, Thomas","Holst, Jens Juul","Lutter, Dominik","Zierath, Juleen R","Sassone-Corsi, Paolo"],"cuid":["S01-000.00-410338"],"filters":{"added":"2022-04","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Europe, EU","Nordic","OECD"],"country":["Germany","Sweden","United States"],"glorg":["All Global Affiliations","German Research Center for Environmental Health","Helmholtz Centre Munich","Helmholtz Zentrum München - German Research Center for Environmental Health","Karolinska Institutet","University of California at Irvine","University of Southern California"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-NOVO"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-PR-NOVO","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"atlas of exercise metabolism reveals time dependent signatures of metabolic homeostasis","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.cmet.2021.12.016","version":"Published Version"},"id":"S01-000.00-410338","identifier":[{"id":"000809732500014","type":"wos"},{"id":"85123585233","type":"scopus"},{"id":"35030324","type":"pmid"}],"ids":["ku-1c5c11c4-c8f1-4cb7-b82b-e818199b59b7"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-D32381CDDB9CFA4EB558F705B825B551"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/291221317/1_s2.0_S1550413121006355_main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.cmet.2021.12.016","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"us","key":"university of southern california","loc":["United States","America, North","OECD"],"name":"University of Southern California","used":1},{"affno":"2","country":"de","key":"helmholtz centre munich","loc":["Germany","Europe, EU","OECD"],"name":"Helmholtz Centre Munich","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Novo Nordisk Foundation Center for Basic Metabolic Resear