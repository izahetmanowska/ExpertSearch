_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Christian","key":"zanchinpau","last":"Zanchin","name":"Zanchin, Christian","rank":1,"rolecode":"pau"},{"affno":"1","first":"Konstantinos C.","key":"koskinaspau","last":"Koskinas","name":"Koskinas, Konstantinos C.","rank":2,"rolecode":"pau"},{"affno":"1","first":"Yasushi","key":"uekipau","last":"Ueki","name":"Ueki, Yasushi","rank":3,"rolecode":"pau"},{"affno":"1","first":"Sylvain","key":"losdatpau","last":"Losdat","name":"Losdat, Sylvain","rank":4,"rolecode":"pau"},{"affno":"1","first":"Jonas D.","key":"hänerpau","last":"Häner","name":"Häner, Jonas D.","rank":5,"rolecode":"pau"},{"affno":"1","first":"Sarah","key":"bärpau","last":"Bär","name":"Bär, Sarah","rank":6,"rolecode":"pau"},{"affno":"1","first":"Tatsuhiko","key":"otsukapau","last":"Otsuka","name":"Otsuka, Tatsuhiko","rank":7,"rolecode":"pau"},{"affno":"1","first":"Andrea","key":"inderkumpau","last":"Inderkum","name":"Inderkum, Andrea","rank":8,"rolecode":"pau"},{"affno":"2","first":"Maria Radu Juul","key":"jensenpau","last":"Jensen","name":"Jensen, Maria Radu Juul","rank":9,"rolecode":"pau"},{"affno":"2","first":"Jacob","key":"lonborgpau","last":"Lonborg","name":"Lonborg, Jacob","rank":10,"rolecode":"pau"},{"affno":"3","first":"Gregor","key":"fahrnipau","last":"Fahrni","name":"Fahrni, Gregor","rank":11,"rolecode":"pau"},{"affno":"4","first":"Anna S.","key":"ondracekpau","last":"Ondracek","name":"Ondracek, Anna S.","rank":12,"rolecode":"pau"},{"affno":"5","first":"Joost","key":"daemenpau","last":"Daemen","name":"Daemen, Joost","rank":13,"rolecode":"pau"},{"affno":"6","first":"Robert Jan","key":"vangeunspau","last":"van Geuns","name":"van Geuns, Robert Jan","rank":14,"rolecode":"pau"},{"affno":"7","first":"Juan F.","key":"iglesiaspau","last":"Iglesias","name":"Iglesias, Juan F.","rank":15,"rolecode":"pau"},{"affno":"8","first":"Christian M.","key":"matterpau","last":"Matter","name":"Matter, Christian M.","rank":16,"rolecode":"pau"},{"affno":"1","first":"David","key":"spirkpau","last":"Spirk","name":"Spirk, David","rank":17,"rolecode":"pau"},{"affno":"9","first":"Peter","key":"junipau","last":"Juni","name":"Juni, Peter","rank":18,"rolecode":"pau"},{"affno":"7","first":"Francois","key":"machpau","last":"Mach","name":"Mach, Francois","rank":19,"rolecode":"pau"},{"affno":"1","first":"Dik","key":"hegpau","last":"Heg","name":"Heg, Dik","rank":20,"rolecode":"pau"},{"affno":"10","first":"Thomas","key":"engstrompau","last":"Engstrom","locid":"77ddb69e-092a-4c53-bbf0-409cdd3d12f7","name":"Engstrøm, Thomas","name_org":"Engstrom, Thomas","rank":21,"rolecode":"pau"},{"affno":"4","first":"Irene","key":"langpau","last":"Lang","name":"Lang, Irene","rank":22,"rolecode":"pau"},{"affno":"1","first":"Stephan","key":"windeckerpau","last":"Windecker","name":"Windecker, Stephan","rank":23,"rolecode":"pau"},{"affno":"1","first":"Lorenz","key":"räberpau","last":"Räber","name":"Räber, Lorenz","rank":24,"rolecode":"pau"}],"pmid":["33951415"],"pub":{"doi":"10.1016/j.ahj.2021.04.006","issn":["00028703","10976744"],"issn_org":["00028703"],"journal":"American Heart Journal","pages":"33-44","status":"p","title":"American Heart Journal","volume":"238"},"review":"Peer Reviewed","scoID":["2-s2.0-85107049244"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-ebabc6ec-0963-43b1-a57d-bb8a63d16fbe"],"src":["KU University of Copenhagen"],"title":"Effects of the PCSK9 antibody alirocumab on coronary atherosclerosis in patients with acute myocardial infarction : a serial, multivessel, intravascular ultrasound, near-infrared spectroscopy and optical coherence tomography imaging study–Rationale and design of the PACMAN-AMI trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-534144","year":"2021","yearsub":"2021"}
{"abstract":"Grundbog og tilhørende WEB til matematikundervisningen i 10. klasse. Bogen og aktiviteter på web-delen tager udgangspunkt i undersøgende aktiviteter med tilhørende faglige pointer. Der tænkes på elev-elev og elev-lærer feedback i hvert forløb som en naturlig del af hvert kapitel.","author_count":2,"contributors":["Hansen, Jonas Juul"],"cuid":["S01-000.00-689224"],"filters":{"added":"2023-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["10 klasse","Digitale læremidler","Læremidler","Læring pædagogik og undervisning","Matematik","Matematikundervisning","Undersøgende matematikundervisning"],"level":"edu","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-UC"],"level3":{"UC":["DI-UC-ALL","DI-UC-KP"]},"level3all":["DI-UC-KP"]},"review":"und","rtype":["clu"],"sorti":"mat 000000000010","src":["kp"],"src-code":["DI-UC-KP"],"type":"dba","type-grp":["all","pub"]},"id":"S01-000.00-689224","ids":["kp-ce624ebe-2005-4eda-b9f2-5d7a7c0866df"],"keyword":["10.klasse","Læring, pædagogik og undervisning","Matematik","Matematikundervisning","digitale læremidler","læremidler","undersøgende matematikundervisning"],"lang":"Danish","level":"Educational","mra":["Humanities"],"noi":["Local-1-1-D467D25165828054FE66DB4811449A20"],"org":[{"affno":"1","key":"kp university college copenhagen","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-KP","l3nl":"KP","l3nn":"KP University College Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KP University College Copenhagen","namevar":["Københavns Professionshøjskole, Rektors område, Fakultet for læreruddannelse og livslang læring - Dekan, CFU Vejledning og formidling"],"nora_code":"DI-UC-KP","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jonas Juul","key":"hansenpau","last":"Hansen","locid":"869fff1a-19d9-4da5-86c2-ca41f1ce3968","name":"Hansen, Jonas Juul","rank":1,"rolecode":"pau"},{"affno":"","first":"Susanne","key":"schulianpedh","last":"Schulian","name":"Schulian, Susanne","rank":2,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"publisher":"Alinea","status":"p","title":"MAT 10"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All University Colleges","DI-ALL","DI-UC","DI-UC-ALL","KP","University Colleges"],"PST":["Published"]},"sid":["kp-ce624ebe-2005-4eda-b9f2-5d7a7c0866df"],"src":["KP University College Copenhagen"],"title":"MAT 10","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-689224","year":"2021","yearsub":"2021"}
{"abstract":"Introduction: Previous studies have indicated that low-intensity extracorporeal shockwave therapy (Li-ESWT) may improve male erectile dysfunction (ED) of vascular aetiology. Aim: To investigate penile rehabilitation of Li-ESWT in a randomized, placebo-controlled trial in men with ED following robotic nerve-sparing radical prostatectomy (RARP). Methods: Included were men with ED following nerve-sparing RP with a score <22 in the 5-item International Index of Erectile Function (IIEF-5) questionnaire. Participants were divided into an active A (n = 20) and a placebo/sham B group (n = 18). They were randomized consecutively upon study entry. Each study arm had one treatment a week for 5 weeks. Main outcome measures: Sexual outcomes were assessed by international validated questionnaires, Erection Hardness Score (EHS) and IIEF-5 at baseline and at 4 and 12 weeks after treatment. Results: A total of 38 (n = 38) participants were enrolled; there were no dropouts. A significant increase was observed in IIEF-5 and EHS in group A at both 4 and 12 weeks. At 12 weeks, the mean IIEF-5 score had increased by 3.45 points (P =.026), while the mean EHS score had increased by 0.5 points (P=.019). Conclusion: This randomized study indicates that Li-ESWT for ED in men undergone RP might be effective and safe. However, further and more robust research is needed before Li-ESWT can be characterized as a reliable treatment modality. PBJ Ladegaard, J Mortensen, SM Skov-Jeppesen, et al. Erectile Dysfunction A Prospective Randomized Placebo-Controlled Study Evaluating the Effect of Low-Intensity Extracorporeal Shockwave Therapy (LI-ESWT) in Men With Erectile Dysfunction Following Radical Prostatectomy. J Sex Med 2021;XX:XXX–XXX.","author_count":4,"contributors":["Juul Ladegaard, Peter Bill","Mortensen, Jonas","Møller Jeppesen, Sune","Lund, Lars"],"cuid":["S01-000.00-607511"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Lund, Lars"],"keyword":["Erectile Dysfunction","Extracorporeal shockwave","Penis","Radical prostatectomy"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-SDR","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"erectile dysfunction a prospective randomized placebo controlled study evaluating the effect of low intensity extracorporeal shockwave therapy li eswt in men with erectile dysfunction following radical prostatectomy","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.esxm.2021.100338","version":"Published Version"},"id":"S01-000.00-607511","identifier":[{"id":"33789173","type":"pmid"},{"id":"85103423978","type":"scopus"},{"id":"PMC8240152","type":"pmcid"}],"ids":["sdu-77b956a8-add0-453c-9f73-f01fc3c4d567"],"keyword":["Erectile dysfunction","Extracorporeal shockwave","Penis","Radical prostatectomy"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-782255FC19722D150D38AF6CDFCF5D3E"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/181336609/PIIS2050116121000180_1_.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.esxm.2021.100338","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Urology (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Odense University Hospital"],"nora_code":"DI-HO-SDR","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Peter Bill Juul","key":"ladegaardpau","last":"Ladegaard","locid":"68dfcff8-58aa-4868-b66f-832fd5d60b9d","name":"Juul Ladegaard, Peter Bill","name_org":"Ladegaard, Peter Bill Juul","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jonas","key":"mortensenpau","last":"Mortensen","name":"Mortensen, Jonas","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sune Møller","key":"skovjeppesenpau","last":"Skov-Jeppesen","locid":"bbfa7fca-0d95-4e1e-8cac-a6c578455c80","name":"Møller Jeppesen, Sune","name_org":"Skov-Jeppesen, Sune Møller","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lars","key":"lundpau","last":"Lund","locid":"2b53d464-d075-4614-9ee3-a9fedc0827b5","name":"Lund, Lars","orcid":"0000-0003-0391-9568","rank":4,"rolecode":"pau"}],"pmid":["33789173"],"pub":{"doi":"10.1016/j.esxm.2021.100338","issn":["20501161"],"issue":"3","journal":"Sexual Medicine","paperid":"100338","publisher":"Oxford University Press","status":"p","title":"Sexual Medicine","volume":"9"},"review":"Peer Reviewed","scoID":["2-s2.0-85103423978"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-77b956a8-add0-453c-9f73-f01fc3c4d567"],"src":["SDU University of Southern Denmark"],"title":"Erectile Dysfunction A Prospective Randomized Placebo-Controlled Study Evaluating the Effect of Low-Intensity Extracorporeal Shockwave Therapy (LI-ESWT) in Men With Erectile Dysfunction Following Radical Prostatectomy","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-607511","year":"2021","yearsub":"2021"}
{"abstract":"BACKGROUND: Joint hypermobility in athletes is associated with increased risk of knee injuries, but its role in relation to shoulder injuries has not been scrutinized. Therefore, our aim was to synthesize the evidence on the association between joint hypermobility and shoulder injuries in athletes. METHODS: Data sources were MEDLINE, CINAHL, EMBASE, and SPORTDiscus from inception to 27th February 2021. Eligibility criteria were observational studies of athletes (including military personnel), mean age ≥ 16 years, and with a transparent grouping of those with and without joint hypermobility. A broad definition of joint hypermobility as the exposure was accepted (i.e., generalised joint hypermobility (GJH), shoulder joint hypermobility including joint instability). Shoulder injuries included acute and overuse injuries, and self-reported pain was accepted as a proxy for shoulder injuries. The Odds Ratios (OR) for having shoulder injuries in exposed compared with non-exposed athletes were estimated using a random effects meta-analysis. Subgroup analyses were performed to explore the effect of sex, activity type, sports level, study type, risk of bias, and exposure definition. Risk of bias and the overall quality of evidence were assessed using, respectively, the Newcastle-Ottawa Scale and the Grading of Recommendations Assessment, Development and Evaluation (GRADE). RESULTS: Among 6207 records, six studies were included with 2335 (range 118-718) participants (34.1% females; athlete mean age 19.9 years). Athletes with joint hypermobility were more likely to have shoulder injuries compared with athletes without joint hypermobility (OR = 3.25, 95% CI 1.64, 6.43, I2 = 75.3%; p = 0.001). Exposure definition (GJH, OR = 1.97, 95% CI 1.32, 2.94; shoulder joint hypermobility, OR = 8.23, 95% CI 3.63, 18.66; p = 0.002) and risk of bias (low, OR = 5.25, 95% CI 2.56, 10.8; high, OR = 1.6, 95% CI 0.78, 3.29; p = 0.024) had large impacts on estimates, while the remaining subgroup analyses showed no differences. The overall quality of evidence was low. CONCLUSION: Joint hypermobility in athletes is associated with a threefold higher odds of having shoulder injuries, highlighting the need for prevention strategies in this population. However, due to low quality of evidence, future research will likely change the estimated strength of the association. PROTOCOL REGISTRATION: Open Science Framework registration osf.io/3wrn9.","author_count":6,"contributors":["Liaghat, Behnam","Pedersen, Julie Rønne","Young, James J.","Thorlund, Jonas Bloch","Juul-Kristensen, Birgit","Juhl, Carsten Bogh"],"cuid":["S01-000.00-583646"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","OECD"],"corresponding_author":["Liaghat, Behnam"],"country":["Canada"],"glorg":["All Global Affiliations","Canadian Memorial Chiropractic College"],"keyword":["Adolescent","Adult","Athletes","Athletic Injuries diagnosis","Female","Humans","Joint Instability","Joint Instability diagnosis","Knee Injuries","Male","Meta analysis","Odds Ratio","Risk Factors","Shoulder Injuries","Shoulder Joint","Sports","Young Adult"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"joint hypermobility in athletes is associated with shoulder injuries a systematic review and meta analysis","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s12891-021-04249-x","version":"Published Version"},"id":"S01-000.00-583646","identifier":[{"id":"85106666650","type":"scopus"},{"id":"PMC8077913","type":"pmcid"},{"id":"33902511","type":"pmid"}],"ids":["sdu-2471353d-9fe7-425b-b5dd-5e79ac73a364"],"keyword":["Adolescent","Adult","Athletes","Athletic Injuries/diagnosis","Female","Humans","Joint Instability/diagnosis","Joint instability","Knee Injuries","Male","Meta-analysis","Odds Ratio","Risk factors","Shoulder Injuries","Shoulder Joint","Sports","Young Adult"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-88A886DDE83B31103256C8523DCA8AF4"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/181946468/s12891_021_04249_x.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s12891-021-04249-x","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics","SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics, Research Unit of Musculoskeletal Function and Physiotherapy"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"ca","key":"canadian memorial chiropractic college","loc":["Canada","America, North","OECD"],"name":"Canadian Memorial Chiropractic College","used":1},{"affno":"3","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Behnam","key":"liaghatpau","last":"Liaghat","locid":"02a3f8a6-b47d-4c88-9c31-6ffb568e3937","name":"Liaghat, Behnam","orcid":"0000-0002-3050-0028","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Julie Rønne","key":"pedersenpau","last":"Pedersen","locid":"1c6a3d31-e981-4d31-834d-fd06962e0567","name":"Pedersen, Julie Rønne","orcid":"0000-0002-7924-5312","rank":2,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"James J","key":"youngpau","last":"Young","locid":"358a4251-6873-4b1b-99df-826eaf19035d","name":"Young, James J.","name_org":"Young, James J","orcid":"0000-0003-1210-3106","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jonas Bloch","key":"thorlundpau","last":"Thorlund","locid":"5b59bfe4-8aff-41d8-8b2d-4b19ab3e56c4","name":"Thorlund, Jonas Bloch","orcid":"0000-0001-7789-8224","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Birgit","key":"juulkristensenpau","last":"Juul-Kristensen","locid":"887ddfe7-cfa6-4b72-a17d-ecf86987c5c0","name":"Juul-Kristensen, Birgit","orcid":"0000-0002-4973-8415","rank":5,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"first":"Carsten Bogh","key":"juhlpau","last":"Juhl","locid":"9381fad1-5721-4b98-ac99-7df1c6e4d837","name":"Juhl, Carsten Bogh","orcid":"0000-0001-8456-5364","rank":6,"rolecode":"pau"}],"pmid":["33902511"],"pub":{"doi":"10.1186/s12891-021-04249-x","issn":["14712474"],"issue":"1","journal":"BMC Musculoskeletal Disorders","paperid":"389","publisher":"BioMed Central","status":"p","title":"BMC Musculoskeletal Disorders","volume":"22"},"review":"Peer Reviewed","scoID":["2-s2.0-85106666650"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-2471353d-9fe7-425b-b5dd-5e79ac73a364"],"src":["SDU University of Southern Denmark"],"title":"Joint hypermobility in athletes is associated with shoulder injuries : a systematic review and meta-analysis","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-583646","year":"2021","yearsub":"2021"}
{"abstract":"Across the world, scholars are racing to predict the spread of the novel coronavirus, COVID-19. Such predictions are often pursued by numerically simulating epidemics with a large number of plausible combinations of relevant parameters. It is essential that any forecast of the epidemic trajectory derived from the resulting ensemble of simulated curves is presented with confidence intervals that communicate the uncertainty associated with the forecast. Here we argue that the state-of-the-art approach for summarizing ensemble statistics does not capture crucial epidemiological information. In particular, the current approach systematically suppresses information about the projected trajectory peaks. The fundamental problem is that each time step is treated separately in the statistical analysis. We suggest using curve-based descriptive statistics to summarize trajectory ensembles. The results presented allow researchers to report more representative confidence intervals, resulting in more realistic projections of epidemic trajectories and -- in turn -- enable better decision making in the face of the current and future pandemics.","author_count":5,"contributors":["Juul, Jonas L.","Græsbøll, Kaare","Christiansen, Lasse Engbo","Lehmann, Sune"],"cuid":["S02-091.86-037347"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"continent":["America, North","OECD"],"corresponding_author":["Juul, Jonas L."],"country":["United States"],"glorg":["All Global Affiliations","Cornell University"],"level":"sci","mra":["sci","soc"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"fixed time descriptive statistics underestimate extremes of epidemic curve ensembles","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1038/s41567-020-01121-y","version":"Published Version"},"id":"S02-091.86-037347","identifier":[{"id":"85097275062","type":"scopus"}],"ids":["dtu-d278cddd-773e-40a9-af94-6e55e769aedc","ku-84267459-af6e-45e4-9ae1-c1033cd88c6d"],"lang":"English","level":"Scientific","mra":["Science/Technology","Social Science"],"noi":["Global-Local-2-5-2FC9314A5F7C76F2BF35393E19A955F8"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://curis.ku.dk/ws/files/274435166/Excellence_and_power_in_the_Black_physics_community.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1038/s41567-020-01121-y","version":"Published Version"},{"access":"oa","type":"rem","url":"https://rdcu.be/ccpB5","version":"Published Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Applied Mathematics and Computer Science","Technical University of Denmark, Department of Applied Mathematics and Computer Science, Cognitive Systems"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Social Sciences, Department of Sociology, Department of Sociology","Københavns Universitet, Faculty of Social Sciences, Faculty of Social Sciences, shared expenditure, Copenhagen Center for Social Data Science (SODAS)","Københavns Unive