{"abstract":"Talens magt er en indføring i mundtlig retorik. Bogen tager afsæt i den klassiske retoriske tradition. Bogen foreligger i en russisk udgave, og er oversat og bearbejdet af cand mag. Jan Nielsen.","author_count":2,"contributors":["Gabrielsen, Jonas","Juul Christiansen, Tanja"],"cuid":["S01-000.00-572634"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-RUC"]},"level3all":["DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"cилa cлoba введение в устную риторику russisk oversættelse og bearbejdning af bogen talens magt","src":["ruc"],"src-code":["DI-U-RUC"],"type":"db","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.ozon.ru/context/detail/id/33569792/","version":"Other Version"},"id":"S01-000.00-572634","ids":["ruc-f72a32d5-915d-4b42-8112-051e0ae3d53a"],"keyword":["Retorik, Mundtlighed"],"lang":"Danish","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-AD96AF3AFF3DA6A91B6BB7D378B4F043"],"org":[{"affno":"1","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, The Department of Communication, Business and Information Technologies"],"nora_code":"DI-U-RUC","used":1}],"person":[{"affno":"1","country":"dk","first":"Jonas","key":"gabrielsenpau","last":"Gabrielsen","locid":"e0b2df49-33d6-4b7a-a8bf-058014d6d4d6","name":"Gabrielsen, Jonas","orcid":"0000-0003-3679-4407","rank":1,"rolecode":"pau"},{"affno":"","first":"Tanja","key":"juulchristiansenpau","last":"Juul Christiansen","name":"Juul Christiansen, Tanja","rank":2,"rolecode":"pau"}],"pub":{"isbn":["9785879023305"],"pages":"172","place":"Moskva","publisher":"МИК, Moskva"