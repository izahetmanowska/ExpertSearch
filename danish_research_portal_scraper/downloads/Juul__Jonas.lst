-493e-8b41-0def45f77ce8","name":"Folke, Fredrik","rank":21,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Curt","key":"stencurtpau","last":"Sten","name":"Sten, Curt","rank":22,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Maria Elizabeth Engel","key":"møllermariaelizabethengelpau","last":"Møller","name":"Møller, Maria Elizabeth Engel","rank":23,"rolecode":"pau"},{"affno":"1","first":"Maria Elizabeth Engel","key":"mollermariaelizabethengelpau","last":"Moller","name":"Moller, Maria Elizabeth Engel","rank":23,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Frederik Neess","key":"engsigfrederikneesspau","last":"Engsig","name":"Engsig, Frederik Neess","rank":24,"rolecode":"pau"},{"affno":"2 5","first":"Henrik","key":"ullumhenrikpau","last":"Ullum","locid":"ef594d49-5aeb-4d32-80b4-4bfc281b5cbb","name":"Ullum, Henrik","orcid":"0000-0001-7306-9058","rank":25,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Charlotte Sværke","key":"jørgensencharlottesværkepau","last":"Jørgensen","name":"Jørgensen, Charlotte Sværke","rank":26,"rolecode":"pau"},{"affno":"5","first":"Charlotte Svaerke","key":"jorgensencharlottesvaerkepau","last":"Jorgensen","name":"Jorgensen, Charlotte Svaerke","rank":26,"rolecode":"pau"},{"affno":"2","first":"Sisse R.","key":"ostrowskisisseryepau","last":"Ostrowski","locid":"ba497828-2322-4b15-bfae-1e8a8c3895e7","name":"Ostrowski, Sisse Rye","name_org":"Ostrowski, Sisse R.","orcid":"0000-0001-5288-3851","rank":27,"rolecode":"pau"},{"affno":"2","first":"Henning","key":"bundgaardhenningpau","last":"Bundgaard","locid":"254c7f8d-79dd-4a5d-870f-3ed78cb56464","name":"Bundgaard, Henning","rank":28,"rolecode":"pau"},{"affno":"2","first":"Kasper Karmark","key":"iversenkasperpau","last":"Iversen","locid":"558df261-ca9f-440a-8bee-7d38813c253f","name":"Iversen, Kasper","name_org":"Iversen, Kasper Karmark","rank":29,"rolecode":"pau"},{"affno":"2","first":"Thea Kolsen","key":"fischertheakpau","last":"Fischer","locid":"97c4bf8d-8bd1-470b-8e0b-91eb4faf7703","name":"Fischer, Thea K.","name_org":"Fischer, Thea Kolsen","rank":30,"rolecode":"pau"},{"affno":"2","first":"Susanne Dam","key":"nielsensusannedampau","last":"Nielsen","locid":"2baa36fa-2709-482a-9595-52c5b9537801","name":"Nielsen, Susanne Dam","rank":31,"rolecode":"pau"}],"pmid":["34668738"],"pub":{"doi":"10.1128/spectrum.00904-21","issn":["21650497"],"issue":"2","journal":"Microbiology Spectrum","paperid":"e0090421","publisher":"American Society for Microbiology","status":"p","title":"Microbiology Spectrum","volume":"9"},"review":"Peer Reviewed","scoID":["2-s2.0-85119135631"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Governmental Institutions","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","North Denmark Region","Region Zealand","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-5995bbfc-7fbc-4d1f-a65d-43b844f5d44c","ku-29b1b186-00f2-4f7d-a857-ebf75755d592","sdu-e0d9918b-2253-4c96-b1ed-23f1064e2335"],"src":["AAU Aalborg University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Risk Factors for Being Seronegative following SARS-CoV-2 Infection in a Large Cohort of Health Care Workers in Denmark","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-098.29-004370","year":"2021","yearsub":"2021"}
{"abstract":"Background: Health-care workers are thought to be highly exposed to severe acute respiratory syndrome coronavirus 2 (SARS-CoV-2) infection. We aimed to investigate the prevalence of antibodies against SARS-CoV-2 in health-care workers and the proportion of seroconverted health-care workers with previous symptoms of COVID-19. Methods: In this observational cohort study, screening was offered to health-care workers in the Capital Region of Denmark, including medical, nursing, and other students who were associated with hospitals in the region. Screening included point-of-care tests for IgM and IgG antibodies against SARS-CoV-2. Test results and participant characteristics were recorded. Results were compared with findings in blood donors in the Capital Region in the study period. Findings: Between April 15 and April 23, 2020, we screened 29 295 health-care workers, of whom 28 792 (98·28%) provided their test results. We identified 1163 (4·04% [95% CI 3·82–4·27]) seropositive health-care workers. Seroprevalence was higher in health-care workers than in blood donors (142 [3·04%] of 4672; risk ratio [RR] 1·33 [95% CI 1·12–1·58]; p<0·001). Seroprevalence was higher in male health-care workers (331 [5·45%] of 6077) than in female health-care workers (832 [3·66%] of 22 715; RR 1·49 [1·31–1·68]; p<0·001). Frontline health-care workers working in hospitals had a significantly higher seroprevalence (779 [4·55%] of 16 356) than health-care workers in other settings (384 [3·29%] of 11 657; RR 1·38 [1·22–1·56]; p<0·001). Health-care workers working on dedicated COVID-19 wards (95 [7·19%] of 1321) had a significantly higher seroprevalence than other frontline health-care workers working in hospitals (696 [4·35%] of 15 983; RR 1·65 [1·34–2·03]; p<0·001). 622 [53·5%] of 1163 seropositive participants reported symptoms attributable to SARS-CoV-2. Loss of taste or smell was the symptom that was most strongly associated with seropositivity (377 [32·39%] of 1164 participants with this symptom were seropositive vs 786 [2·84%] of 27 628 without this symptom; RR 11·38 [10·22–12·68]). The study is registered at ClinicalTrials.gov, NCT04346186. Interpretation: The prevalence of health-care workers with antibodies against SARS-CoV-2 was low but higher than in blood donors. The risk of SARS-CoV-2 infection in health-care workers was related to exposure to infected patients. More than half of seropositive health-care workers reported symptoms attributable to COVID-19. Funding: Lundbeck Foundation.","author_count":28,"contributors":["Iversen, Kasper","Bundgaard, Henning","Hasselbalch, Rasmus Bo","Kristensen, Jonas Henrik","Nielsen, Pernille Brok","Pries-Heje, Mia","Knudsen, Andreas D.","Christensen, Casper E.","Fogh, Kamille","Norsk, Jakob Boesgaard","Andersen, Ove","Fischer, Thea K.","Jensen, Claus Antonio Juul","Larsen, Margit","Torp-Pedersen, Christian","Rungby, Jørgen","Ditlev, Sisse B.","Hageman, Ida","Møgelvang, Rasmus","Hother, Christoffer E.","Gybel-Brask, Mikkel","Sørensen, Erik","Harritshøj, Lene Holm","Folke, Fredrik","Sten, Curt","Benfield, Thomas","Nielsen, Susanne Dam","Ullum, Henrik"],"cuid":["S01-000.00-509369"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"risk of covid 000000000019 in health care workers in denmark an observational cohort study","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Andet","type":"doi","url":"https://doi.org/10.1016/S1473-3099(20)30589-2","version":"Published Version"},"id":"S01-000.00-509369","identifier":[{"id":"85089980210","type":"scopus"},{"id":"PMC7398038","type":"pmcid"},{"id":"32758438","type":"pmid"}],"ids":["ku-c234fef5-ea5b-4743-8fcf-bd1715a35d6b"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-ABC71FF34B3622BBE8BB51D97EDE2756"],"oa_link":[{"access":"oa","license":"https://www.ncbi.nlm.nih.gov/pmc/about/copyright/","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC7398038/pdf/main.pdf","version":"Published Version"},{"access":"oa","license":"Andet","type":"doi","url":"https://doi.org/10.1016/S1473-3099(20)30589-2","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Emergency Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital – North Zealand"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","first":"Kasper","key":"iversenkasperpau","last":"Iversen","locid":"558df261-ca9f-440a-8bee-7d38813c253f","name":"Iversen, Kasper","rank":1,"rolecode":"pau"},{"affno":"1","first":"Henning","key":"bundgaardhenningpau","last":"Bundgaard","locid":"254c7f8d-79dd-4a5d-870f-3ed78cb56464","name":"Bundgaard, Henning","rank":2,"rolecode":"pau"},{"affno":"1","first":"Rasmus B.","key":"hasselbalchrasmusbopau","last":"Hasselbalch","locid":"8dfc4eeb-90da-420f-bf73-bc70213d98ab","name":"H