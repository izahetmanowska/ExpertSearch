no":"5","corresponding":null,"first":"Olav Jonas","key":"bergmannpau","last":"Bergmann","locid":"40e7b69b-5730-415e-9e06-da52fac32e73","name":"Bergmann, Olav Jonas","rank":10,"rolecode":"pau"},{"affno":"8","corresponding":null,"first":"Therese","key":"lassenpau","last":"Lassen","name":"Lassen, Therese","rank":11,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Pär Lars","key":"josefssonpau","last":"Josefsson","name":"Josefsson, Pär Lars","rank":12,"rolecode":"pau"},{"affno":"1 9","corresponding":null,"first":"Paw","key":"jensenpau","last":"Jensen","locid":"f94ee9fd-5a23-4aa3-bc46-03c15cad7fc1","name":"Jensen, Paw","orcid":"0000-0002-5248-0523","rank":13,"rolecode":"pau"},{"affno":"1 9","corresponding":null,"country":"dk","first":"Hans Erik","key":"johnsenpau","last":"Johnsen","locid":"534a42b8-2774-424e-a4de-384f478549ea","name":"Johnsen, Hans Erik","orcid":"0000-0001-8253-2913","rank":14,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Tarec Christoffer","key":"elgalalypau","last":"El-Galaly","locid":"1d601b96-c71c-4a76-ac06-4d95e0a50a74","name":"El-Galaly, Tarec Christoffer","orcid":"0000-0002-4406-380X","rank":15,"rolecode":"pau"}],"pmid":["28095160"],"pub":{"doi":"10.1200/jco.2016.70.0765","issn":["0732183X","15277755"],"issn_org":["0732183X"],"issue":"7","journal":"Journal of Clinical Oncology","pages":"778-784","publisher":"American Society of Clinical Oncology","status":"p","title":"Journal of Clinical Oncology","volume":"35"},"review":"Peer Reviewed","scoID":["2-s2.0-85014008148"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-d1f341d6-f59f-460a-866f-179499e6afb7",