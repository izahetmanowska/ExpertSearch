"},{"affno":"3","corresponding":null,"first":"Jason","key":"silvermanpau","last":"Silverman","name":"Silverman, Jason","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Alice","key":"leepau","last":"Lee","name":"Lee, Alice","rank":4,"rolecode":"pau"},{"affno":"","first":"Birgit","key":"pepinpedh","last":"Pepin","name":"Pepin, Birgit","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Ghislaine","key":"gueudetpedh","last":"Gueudet","name":"Gueudet, Ghislaine","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Jeffrey","key":"choppinpedh","last":"Choppin","name":"Choppin, Jeffrey","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-031-45667-1_50","isbn":["21971951"],"issn":["21971951"],"pages":"851-881","publisher":"Springer","series":"Springer International Handbook of Education","status":"p","title":"Teachers’ Knowledge and Capacity for Using Digital Resources in Mathematics Education"},"review":"Peer Reviewed","scoID":["2-s2.0-85200479773"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-accef11f-dcd3-4d2a-a8fa-31c04fd50a39"],"src":["ITU IT University of Copenhagen"],"title":"Teachers’ Knowledge and Capacity for Using Digital Resources in Mathematics Education","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-759415","year":"2024","yearsub":"2024"}
{"abstract":"This paper explores two types of lever potentials of CAS and a tool for designing such activities. In the first activity, CAS is used for students to study the concept of equations. In the second activity, CAS is used to strengthen the relation between traditional algebraic paper-andpencil manipulations of equations and the theory that the solution of the equation must remain the same. As the design tool for CAS-based activities that capitalise on the potential of CAS, the notion of praxeology from the Anthropological Theory of Didactical is employed.","author_count":1,"contributors":["Carlsen, Louise Meier"],"cuid":["S01-000.00-759427"],"filters":{"added":"2024-10","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"keyword":["Algebra","CAS","Lower Secondary School","Praxeology","Task design"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"designing activities for cas based student work realising the lever potential","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.24529/hjme.1601","version":"Published Version"},"id":"S01-000.00-759427","ids":["itu-f44b151c-37d0-469a-85d0-37cb702f24a7"],"keyword":["Algebra","CAS","Lower Secondary School","Praxeology","Task Design"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-C31EF7E696769E649302F59D4537AA0F"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.24529/hjme.1601","version":"Published Version"},{"access":"oa","type":"rem","url":"https://www.jstage.jst.go.jp/article/hjme/16/0/16_1601/_pdf/-char/en","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Computing Education Research","IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data, Systems, and Robotics, Pattern Recognition Revisited lab"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Louise Meier","key":"carlsenpau","last":"Carlsen","locid":"d6d93566-d546-42a8-8864-766098389589","name":"Carlsen, Louise Meier","orcid":"0000-0003-3987-9350","rank":1,"rolecode":"pau"}],"pub":{},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"]},"sid":["itu-f44b151c-37d0-469a-85d0-37cb702f24a7"],"src":["ITU IT University of Copenhagen"],"title":"Designing Activities for CAS-based Student Work Realising the Lever Potential","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-759427","year":"2023","yearsub":"2023"}
