olume":"39"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-c1b6495c-6565-4796-88e7-34a622e5d97c"],"src":["ITU IT University of Copenhagen"],"title":"Combining CAS based teaching with lesson study: A Theoretical paper","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-759420","year":"2015","yearsub":"2015"}
{"abstract":"Background/Objectives:Differences in the quality of complementary feeding between infants of obese and nonobese mothers have not been examined sufficiently. The aim of this paper was to compare dietary patterns, foods, nutrients and energy intakes of 9-month-old Danish infants in a cohort comprising obese mothers (SKOT II, n=184; SKOT, Danish abbreviation of small children's diet and well-being) with a cohort consisting mainly of nonobese mothers (SKOT I, n=329).Subjects/Methods:Dietary intake was assessed by 7-day records, and dietary patterns were identified by principal component analysis.Results:SKOT I was characterized by a lower maternal body mass index (BMI) and a higher social class than SKOT II in relation to parental education and occupation. Infants in SKOT II had lower scores on a Health-Conscious Food pattern reflected at the food group level, for example, with lower intake of the food groups Fruit and Vegetable but higher intake of WheatBreadNoWholegrain in SKOT II compared with SKOT I. Moreover, SKOT II had shorter durations of breastfeeding, earlier introductions of complementary feeding, higher energy intake from protein but lower energy intakes from monounsaturated fatty acids and polyunsaturated fatty acids at 9 months. SKOT II had higher weight-for-age and length-for-age z-scores, but no differences in BMI z-scores, as compared with SKOT I at 9 months.Conclusions:Infants of obese mothers from a lower social class seem to have a less healthy diet and higher weight and length z-scores at 9 months. Therefore, the promotion of healthy complementary feeding might be beneficial for the prevention of health implications, such as obesity, later in life for these infants.European Journal of Clinical Nutrition advance online publication, 3 December 2014; doi:10.1038/ejcn.2014.258.","author_count":8,"contributors":["Andersen, Louise Beltoft Borup","Pipper, Christian Bressen","Trolle, Ellen","Bro, R.","Larnkjær, Anni","Carlsen, E. M.","Mølgaard, Christian","Michaelsen, Kim F."],"cuid":["S02-100.00-034127"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"maternal obesity and offspring dietary patterns at 000000000009 months of age","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1038/ejcn.2014.258","version":"Other Version"},"id":"S02-100.00-034127","identifier":[{"id":"84930475160","type":"scopus"},{"id":"25469467","type":"pmid"}],"ids":["dtu-440fd561-2354-44ca-80cc-3f383edfa149","ku-eaac9369-8ab5-4250-864e-6b521ca580b6"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-7DDBEF69CA06AB45CEDFC9C2405D57A9"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1038/ejcn.2014.258","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Nutrition, Exercise and Sports, Lifecourse Nutrition & Health"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Food Institute","Technical University of Denmark, National Food Institute, Division of Nutrition"],"nora_code":"DI-U-DTU","used":1},{"affno":"3","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Amager and Hvidovre"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","first":"Louise Beltoft Borup","key":"andersenpau","last":"Andersen","locid":"9e0f0fee-747c-4eeb-84f3-e0f7dd9a3abd","name":"Andersen, Louise Beltoft Borup","rank":1,"rolecode":"pau"},{"affno":"1","first":"Christian Bressen","key":"pipperpau","last":"Pipper","locid":"c002fade-f477-46eb-aa1f-34702fdd3746","name":"Pipper, Christian Bressen","orcid":"0000-0003-0261-616X","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Ellen","key":"trollepau","last":"Trolle","locid":"608d6f7f-db78-45d2-b5b2-fb9c1379a0be","name":"Trolle, Ellen","orcid":"0000-0001-9482-1931","rank":3,"rolecode":"pau"},{"affno":"1","first":"Rasmus","key":"bropau","last":"Bro","locid":"8c7956da-91f7-4c67-8c19-42bc9c446c87","name":"Bro, Rasmus","orcid":"0000-0002-7641-4854","rank":4,"rolecode":"pau"},{"affno":"1","first":"Anni","key":"larnkjærpau","last":"Larnkjær","locid":"988a7c84-01db-4679-8549-d375f2f92cd1","name":"Larnkjær, Anni","orcid":"0000-0002-7790-7888","rank":5,"rolecode":"pau"},{"affno":"1 3","first":"E M","key":"carlsenpau","last":"Carlsen","locid":"2977a554-93a3-4d7d-8e72-2baec8fdb23b","name":"Carlsen, Eva Maria Meier","name_org":"Carlsen, E M","rank":6,"rolecode":"pau"},{"affno":"1","first":"Christian","key":"mølgaardpau","last":"Mølgaard","locid":"240d0bd3-4221-4d27-bfdb-8fd6887cdb30","name":"Mølgaard, Christian","orcid":"0000-0002-5311-9457","rank":7,"rolecode":"pau"},{"affno":"1","first":"Kim F.","key":"michaelsenpau","last":"Michaelsen","locid":"c29a2565-4c7e-4a5b-ab39-899baedae963","name":"Michaelsen, Kim F.","orcid":"0000-0003-0449-0839","rank":8,"rolecode":"pau"}],"pmid":["25469467"],"pub":{"doi":"10.1038/ejcn.2014.258","issn":["09543007","14765640"],"issn_org":["09543007"],"issue":"6","journal":"European Journal of Clinical Nutrition","pages":"668-675","publisher":"Springer Nature","status":"p","title":"European Journal of Clinical Nutrition","volume":"69"},"review":"Peer Reviewed","scoID":["2-s2.0-84930475160"],"sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-440fd561-2354-44ca-80cc-3f383edfa149","ku-eaac9369-8ab5-4250-864e-6b521ca580b6"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Maternal obesity and offspring dietary patterns at 9 months of age","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-034127","year":"2015","yearsub":"2015"}
