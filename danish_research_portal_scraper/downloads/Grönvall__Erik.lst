","rank":2,"rolecode":"pau"}],"pub":{"isbn":["9780857299123"],"pages":"61-80","place":"New York","publisher":"Springer","status":"p","title":"Ecscw 2011 Proceedings of the 12th European Conference on Computer Supported Cooperative Work"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-ff8da1e7-0a81-457b-b7d3-ab9c88ff7644"],"src":["ITU IT University of Copenhagen"],"title":"Challenges and Opportunities for Collaborative Technologies for Home Care Work.","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-385014","year":"2011","yearsub":"2011"}
{"abstract":"This article offers an exploration of home care work and the design of computational devices in support of such work. We present findings from a field study and four participatory design workshops. Themes emerging from the findings suggest that home care work may be highly cooperative in nature and requires substantial articulation work among the actors, such as family members and care workers engaged in providing care for older adults. Although they provide home care for older adults in cooperation, family members and care workers harbour diverging attitudes and values towards their joint efforts. The themes emerging are used to elicit a number of design implications and to promote some illustrative design concepts for new devices in support of cooperative home care work.","author_count":6,"contributors":["Christensen, Lars Rune","Grönvall, Erik"],"cuid":["S01-000.00-153221"],"event":{"end":"2011-09-28","place":"Aarhus, dk","start":"2011-09-24","title":"European Conference on Computer-Supported Cooperative Work 2011","year":"2011"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"challenges and opportunities for collaborative technologies for home care work","src":["au"],"src-code":["DI-U-AU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://www.ecscw.org/2011/07-%20RuneChristensenGronvall%2061-80.pdf","version":"Other Version"},"id":"S01-000.00-153221","ids":["au-29a3763a-be9e-4911-9eb0-c2d3a55ffbaa"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-3-4-46136C8859DCA46B4F49B5AFB0D6F977"],"oa_link":[{"access":"oa","type":"rem","url":"http://www.ecscw.org/2011/07-%20RuneChristensenGronvall%2061-80.pdf","ver