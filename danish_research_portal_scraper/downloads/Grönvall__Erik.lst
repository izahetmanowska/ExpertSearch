e","key":"læssøepau","last":"Læssøe","locid":"f2c779f7-db32-43f5-8856-c9708e0a90aa","name":"Læssøe, Uffe","orcid":"0000-0001-5388-1671","rank":2,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Erik","key":"grönvallpau","last":"Grönvall","name":"Grönvall, Erik","rank":3,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"first":"Jens-Jacob Mølby","key":"henriksenpau","last":"Henriksen","locid":"43487c91-615f-4d14-b725-569576a00246","name":"Henriksen, Jens-Jacob Mølby","rank":4,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"country":"dk","first":"Else Marie Skjøde","key":"damsgaardpau","last":"Damsgaard","locid":"ff0acccb-79dd-419e-a0b2-036fa65e9e31","name":"Damsgaard, Else Marie Skjøde","orcid":"0000-0001-5499-4731","rank":5,"rolecode":"pau"}],"pmid":["26981283"],"pub":{"doi":"10.1155/2016/7026317","issn":["20902867","20902875"],"issn_org":["20902875"],"journal":"Rehabilitation Research and Practice","paperid":"7026317","publisher":"John Wiley and Sons Ltd","status":"p","title":"Rehabilitation Research and Practice","title_org":"Rehabilitation research and practice","volume":"2016"},"review":"Peer Reviewed","scoID":["2-s2.0-85042809780"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","All University Colleges","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","Hospitals","IT University of Copenhagen","Universities","University College of Northern Denmark","University Colleges","VIA University College"],"PST":["Published"]},"sid":["au-bb6c42a6-696e-457c-9455-c5d4a9c91280","ucn-344bc5a5-e969-4f9a-91f8-7a6f203531a9","via-344bc5a5-e969-4f9a-91f8-7a6f203531a9"],"src":["AU Aarhus University","UCN University College of Northern Denmark","VIA University College"],"title":"The Use of Computer-Assisted Home Exercises to Preserve Physical Function after a Vestibular Rehabilitation Program: A Randomized Controlled Study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-096.67-026290","year":"2016","yearsub":"2016"}
{"abstract":"The healthcare sector is undergoing large changes in which technology is given a more active role in both in-clinic and out-of-clinic care. Authoritative healthcare models such as compliance and adherence which relies on asymmetric patient doctor relationships are being challenged as society, patient roles and care contexts transforms, for example when care activities move into non-clinical contexts. Concordance is an alternative model proposed by the medical field that favours an equal and collaborative patient-doctor relationship in the negotiation of care. Similarly, HCI researchers have applied diverse models of engagement in IT design ranging from authoritative models (e.g. perceiving people as human factors to design for) to more democratic design processes (e.g. Participatory Design). IT design has also been crafted as on-going processes that are integrated parts of everyday use. Based on the best practice of participation from the medical and the HCI fields, we identify critical alternatives for healthcare design. These alternatives highlight opportunities with ongoing design processes in which the design of care regimens and care IT are perceived as one process.","author_count":6,"contributors":["Gronvall, Erik","Verdezoto, Nervo","Bagalkot, Naveen L.","Sokoler, Tomas"],"cuid":["S01-000.00-229193"],"event":{"end":"2015-08-21","place":"Aarhus, dk","start":"2015-08-17","title":"The fifth decennial Aarhus conference","year":"2015"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Concordance","Critical Alternative","Healthcare","Infrastructuring","Participatory Design"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU","DI-U-ITU"]},"level3all":["DI-U-AU","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"concordance a critical participatory alternative in healthcare it","src":["au"],"src-code":["DI-U-AU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.7146/aahcc.v1i1.21315","version":"Published Version"},"id":"S01-000.00-229193","identifier":[{"id":"85062375593","type":"scopus"}],"ids":["au-af10bc85-0dea-4d45-b0cb-e8a8bffbebed"],"keyword":["Concordance","Critical Alternative","Healthcare","Ongoing design","Participatory Design","infrastructuring"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-3-5-39804CA33B6236C833C9A0AD6CC008FF"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.7146/aahcc.v1i1.21315","version":"Published Version"},{"access":"oa","type":"loc","url":"https://pure.au.dk/ws/files/90453124/ConcordanceCAMERAREADY.pdf","version":"Pre-print"}],"org":[{"affno":"1","country":"dk","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Computer Science"],"nora_code":"DI-U-AU","used":1},{"affno":"3","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Erik","key":"gronvallpau","last":"Gronvall","name":"Gronvall, Erik","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Nervo","key":"verdezotopau","last":"Verdezoto","locid":"ce629209-5619-4b43-88fb-b8fd03725adb","name":"Verdezoto, Nervo","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Naveen L.","key":"bagalkotpau","last":"Bagalkot","name":"Bagalkot, Naveen L.","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Tomas","key":"sokolerpau","last":"Sokoler","name":"Sokoler, Tomas","rank":4,"rolecode":"pau"},{"affno":"","first":"Olav W.","key":"bertelsenpedh","last":"Bertelsen","name":"Bertelsen, Olav W.","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Kim","key":"halskovpedh","last":"Halskov","name":"Halskov, Kim","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.7146/aahcc.v1i1.21315","issn":["24457221"],"issue":"1","publisher":"Department of Computer Science, Aarhus University","series":"Aarhus Series on Human Centered Computing","status":"p","subtitle":"conference proceedings, conference papers.","title":"Critical Alternatives, 5th decennial Aarhus Conference"},"review":"Peer Reviewed","scoID":["2-s2.0-85062375593"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-af10bc85-0dea-4d45-b0cb-e8a8bffbebed"],"src":["AU Aarhus University"],"title":"Concordance: A Critical Participatory Alternative in Healthcare IT","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-229193","year":"2015","yearsub":"2015"}
{"abstract":"Self-monitoring activities are increasingly becoming part of people’s everyday lives. Some of these measurements are taken voluntarily rather than being referred by a physician and conducted because of either a preventive health interest or to better understand the body and its functions (the so-called Quantified Self). In this article, we explore socio-technical complexities that may occur when introducing preventive health-measurement technologies into older adults’ daily routines and everyday lives. In particular, the original study investigated blood pressure (BP) measurement in non-clinical settings, to understand existing challenges, and uncover opportunities for self-monitoring technologies to support preventive healthcare activities among older adults. From our study, several important aspects emerged to consider when designing preventive self-monitoring technology, such as the complexity of guidelines for self-measuring, the importance of interpretation, understanding and health awareness, sharing self-monitoring information for prevention, various motivational factors, the role of the doctor in prevention, and the home as a distributed information space. An awareness of these aspects can help designers to develop better tools to support people’s preventive self-monitoring needs, compared to existing solutions. Supporting the active and informed individual can help improve people’s self-care, awareness, and implementation of preventive care. Based on our study, we also reflect on the findings to illustrate how these aspects can both inform people engaged in Quantified Self activities and designers alike, and the tools and approaches that have sprung from the so-called Quantified Self movement","author_count":2,"contributors":["Verdezoto, Nervo","Grönvall, Erik"],"cuid":["S02-089.29-023579"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Challenges","Design","Home","Preventive care","Quantified self","Self monitoring","home based healthcare technology","home based technology"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-ITU"]},"level3all":["DI-U-AU","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"on preventive blood pressure self monitoring at home","src":["au","itu"],"src-code":["DI-U-AU","DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/81822309/Verdezoto_Gronvall_on_preventive_self_monitoring_at_home.pdf","version":"Authors Final Version"},"id":"S02-089.29-023579","identifier":[{"id":"84948137859","type":"scopus"}],"ids":["au-95b9c48b-f3ec-4dff-9c76-2091a26e16d7","itu-7f27f16d-8f25-4e75-ba42-b933a89bb360"],"keyword":["Challenges","Design","Home","Self-monitoring","home-based healthcare technology","home-based technology","preventive care","quantified self"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-1FDBFC4D661C9691739D97B6C499E0C0"],"oa_link":[{"access":"oa","type":"rem","url":"http://link.springer.com/article/10.1007/s10111-015-0358-7","version":"Other Version"},{"access":"oa","type":"loc","url":"https://pure.au.dk/ws/files/95046972/OnPreventiveBPSelf_monitoring.pdf","version":"Other Version"},{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/81822309/Verdezoto_Gronvall_on_preventive_self_monitoring_at_home.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Computer Science"],"nora_code":"DI-U-AU"