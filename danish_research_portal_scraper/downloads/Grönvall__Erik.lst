tockholm University","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Erik","key":"gronvallpau","last":"Gronvall","locid":"1e0534b4-fe3e-4c5e-ad6d-5f1c7df6a14e","name":"Grönvall, Erik","name_org":"Gronvall, Erik","orcid":"0000-0002-7377-6091","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Luigina","key":"ciolfipau","last":"Ciolfi","name":"Ciolfi, Luigina","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Gabriela","key":"avrampau","last":"Avram","name":"Avram, Gabriela","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Chiara","key":"rossittopau","last":"Rossitto","name":"Rossitto, Chiara","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1007/s00779-016-0937-5","issn":["16174909","16174917"],"issn_org":["16174909"],"issue":"4","journal":"Personal and Ubiquitous Computing","pages":"481-485","publisher":"Springer","status":"p","title":"Personal and Ubiquitous Computing","volume":"20"},"review":"No Review","scoID":["2-s2.0-84973615739"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-4698b9c1-11f3-4dd6-899e-f1411b094b3f"],"src":["ITU IT University of Copenhagen"],"title":"HCI at the boundary of work and life","type":"Editorial","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382320","year":"2016","yearsub":"2016"}
{"abstract":"FeltRadio is a portable technology for sensing WiFi through sensorial augmentation and Electric Muscle Stimulation (EMS). The technology enables its wearer to sensorially engage with the radio waves and WiFi activities that have become an integrated part of our everyday lives. The sensorial engagement changes people’s experience of WiFi activities, and allows them to participate in wireless communication infrastructures in novel ways. This is both an immediately embodied activity as it is a new form of social awareness. In this paper, we briefly present the FeltRadio technology and show how it facilitates new forms of critical reflection through sensorial participation in our contemporary experience of wireless traffic.","author_count":2,"contributors":["Fritsch, Jonas","Grönvall, Erik"],"cuid":["S01-000.00-383004"],"event":{"acronym":"COOP","end":"2016-05-27","place":"Trento, it","start":"2016-05-22","title":"COOP 2016","year":"2016"},"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Critical reflection","Electric muscle stimulation","Sensorial Augmentation","Sensory Engagement","Wireless communication"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"feltradio experiencing community generated wifi activities","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.springer.com/us/book/9783319334639","version":"Other Version"},"id":"S01-000.00-383004","ids":["itu-75c876ff-e479-4bcd-ac98-c9d5677d2baf"],"keyword":["Critical Reflection","Electric Muscle Stimulation","Sensorial Augmentation","Sensory Engagement","Wireless Communication"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-86B33A7051CCF927C3164D708ACF5D85"],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","IT University of Copenhagen, Digital Design","The Department, People and Computational Things"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jonas","key":"fritschpau","last":"Fritsch","locid":"d37cba38-dff2-4c27-a515-226cfadfd849","name":"Fritsch, Jonas","orcid":"0000-0001-9065-2843","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Erik","key":"gronvallpau","last":"Gronvall","locid":"1e0534b4-fe3e-4c5e-ad6d-5f1c7df6a14e","name":"Grönvall, Erik","name_org":"Gronvall, Erik","orcid":"0000-0002-7377-6091","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1007/978-3-319-33464-6_21","eisbn":["9783319334646"],"isbn":["9783319334639"],"pages":"315-321","publisher":"Springer","status":"p","title":"COOP 2016: Proceedings of the 12th International Conference on the Design of Cooperative Systems, 23-27 May 2016, Trento, Italy"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-75c876ff-e479-4bcd-ac98-c9d5677d2baf"],"src":["ITU IT University of Copenhagen"],"title":"FeltRadio – Experiencing Community-generated WiFi Activities","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383004","year":"2016","yearsub":"2016"}
{"abstract":"This paper presents a theoretical framework for analyzing the aesthetics of participation of media architecture. The framework is based on a close reading of French philosopher Jacques Rancière and provides four points of emphasis: modes of sense perception, forms of engagement, community and emancipation. The framework is put to use in the analysis of three experimental media architectural projects; Ekkomaten/Echoes from Møllevangen, the coMotion Bench and FeltRadio. We discuss the findings from this analysis and outline future perspectives on how to develop and use the framework prospectively in the design of media architectural projects and other interactive environments.","author_count":3,"contributors":["Fritsch, Jonas","Grönvall, Erik","Breinbjerg, Morten"],"cuid":["S01-000.00-737486"],"event":{"end":"2016-06-04","place":"Sydney, au","start":"2016-06-01","title":"Media Architecture Biennale 2016","year":"2016"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Aesthetics of participation","Media architecture"],"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-ITU"]},"level3all":["DI-U-AU","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"analyzing the aesthetics of participation of media architecture","src":["au"],"src-code":["DI-U-AU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85015397417","version":"Other Version"},"id":"S01-000.00-737486","identifier":[{"id":"85015397417","type":"scopus"}],"ids":["au-a23c1023-0509-47dc-9215-0855e33b7041"],"keyword":["Aesthetics of participation","Experience philosophy","Media architecture","Politics of sensation"],"lang":"Danish","level":"Scientific","mra":["Humanities"],"noi":["Global-Local-3-5-9B6E766D7FA5239E0EDB4FBD824AAC22"],"org":[{"affno":"1","country":"dk","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Arts, School of Communication and Culture, School of Communication and Culture - Centre for Advanced Visualisation and Interaction","Aarhus University, Arts, School of Communication and Culture, School of Communication and Culture - Information Science","Aarhus University, Arts, School of Communication and Culture, School of Communication and Culture - Participatory Information Technology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jonas","key":"fritschpau","last":"Fritsch","name":"Fritsch, Jonas","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Erik","key":"grönvallpau","last":"Grönvall","name":"Grönvall, Erik","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Morten","key":"breinbjergpau","last":"Breinbjerg","locid":"b02f3aab-f1ab-4748-bb16-255759b46b0d","name":"Breinbjerg, Morten","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1145/2946803.2946807","eisbn":["978145034749"],"place":"New York","publisher":"Association for Computing Machinery","status":"p","subtitle":"Media Architecture Biennale 2016","title":"Proceedings of the 3rd Media Architecture Biennale Conference, MAB 2016"},"review":"Peer Reviewed","scoID":["2-s2.0-85015397417"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["au-a23c1023-0509-47dc-9215-0855e33b7041"],"src":["AU Aarhus University"],"title":"Analyzing the aesthetics of participation of media architecture","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-737486","year":"2016","yearsub":"2016"}
{"abstract":"Objective. The purpose of this study was to evaluate whether elderly patients with vestibular dysfunction are able to preserve physical functional level, reduction in dizziness, and the patient's quality of life when assistive computer technology is used in comparison with printed instructions. Materials and Methods. Single-blind, randomized, controlled follow-up study. Fifty-seven elderly patients with chronic dizziness were randomly assigned to a computer-assisted home exercise program or to home exercises as described in printed instructions and followed for tree month after discharge from an outpatient clinic. Results. Both groups had maintained their high functional levels three months after finishing the outpatient rehabilitation. No statistically significant difference was found in outcome scores between the two groups. In spite of moderate compliance levels, the patients maintained their high functional level indicating that the elderly should not necessarily exercise for the first three months after termination of the training in the outpatient clinic. Conclusion. Elderly vestibular dysfunction patients exercising at home seem to maintain their functional level, level of dizziness, and quality of life three months following discharge from hospital. In this specific setup, no greater effect was found by introducing a computer-assisted training program, when compared to standard home training guided by printed instructions. This trial is registered with NCT01344408.","author_count":6,"contributors":["Brandt, Michael Smærup","Læssøe, Uffe","Grönvall, Erik","Henriksen, Jens-Jacob Mølby","Damsgaard, Else Marie Skjøde"],"cuid":["S03-096.67-026290"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":3,"keyword":["Elderly","Physiotherapy"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U","DI-UC"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-ITU"],"UC":["DI-UC-ALL","DI-UC-UCN","DI-UC-VIA"]},"level3all":["DI-HO-CDR","DI-U-AAU","DI-U-AU","DI-U-ITU","DI-UC-UCN","DI-UC-VIA"]},"review":"pr","rtype":["clu"],"sorti":"the use of computer assisted home exercises to preserve physical function after a vestibular rehabilitation program a randomized controlled study","src":["au","ucn","via"],"src-code":["DI-U-AU","DI-UC-UCN","DI-UC-VIA"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1155/2016/7026317","version":"Published Version"},"id":"S03-096.67-026290","identifier":[{"id":"85042809780","type":"scopus"},{"id":"26981283","type":"pmid"},{"id":"PMC4766343","type":"pmcid"}],"ids":["au-bb6c42a6-696e-457c-9455-c5d4a9c91280","ucn-344bc5a5-e969-4f9a-91f8-7a6f203531a9","via-344bc5a5-e969-4f9a-91f8-7a6f203531a9"],"keyword":["elderly","physiotherapy"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-9712F0F3C4991F7158D8D6796AB43A2B"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1155/2016/7026317","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Ældresygdomme"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"via university college","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-VIA","l3nl":"VIA University College","l3nn":"VIA University College","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"VIA University College","namevar":["VIA, Forskning og udvikling, Forsk.center Sundhed og velfærdsteknologi, Program for aldring","VIA, Forskning og udvikling, Forskningsområde for sundhed og samfund, Programme for Health Technolog