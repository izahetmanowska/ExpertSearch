6e7d5941","name":"Dinesen, Birthe","name_org":"Dinesen, Birthe Irene","orcid":"0000-0001-5893-9676","rank":8,"rolecode":"pau"}],"pmid":["26579590","PMC4754508"],"pub":{"doi":"10.1089/g4h.2015.0001","issn":["2161783X","21617856"],"issn_org":["2161783X"],"issue":"1","journal":"Games for Health","pages":"27-33","publisher":"Mary AnnLiebert, Inc. Publishers","status":"p","title":"Games for Health","volume":"5"},"review":"Peer Reviewed","scoID":["2-s2.0-84993661525"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","IT University of Copenhagen","Miscellaneous","North Denmark Region","Other Research","Universities"],"PST":["Published"]},"sid":["aau-55f9fe73-7b4f-4ac0-9e5d-c16a7c8c3308","au-677ee36f-a08b-4804-8e13-fb585c9df2ae","itu-a6e7bc4f-f2d1-498f-a95b-17b1a245ae92"],"src":["AAU Aalborg University","AU Aarhus University","ITU IT University of Copenhagen"],"title":"\"The Heart Game\" : using gamification as part of a telerehabilitation programme for heart patients","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-095.79-004200","year":"2016","yearsub":"2016"}
{"abstract":"Community-based PD projects are often characterized by the meeting of conflicting values among stakeholder groups, but in research there is no uncontested account of the relation between design and conflicting values. Through analysis of three community-based PD cases in Denmark and South Africa, this paper identifies and discusses challenges for community-based PD that exist in these settings based on the emergence of contrasting and often conflicting values among participants and stakeholders. Discussions of participation are shaped through two theoretical perspectives: the notion of thinging and design things; and different accounts of values in design. Inspired by the concept of design things, and as a consequence of the need for continuous negotiation of values observed in all three cases, we suggest the concept of thinging as fruitful for creating productive agonistic spaces with a stronger attention towards the process of negotiating values in community-based PD.","author_count":3,"contributors":["Grönvall, Erik","Malmborg, Lone","Messeter, Jörn"],"cuid":["S01-000.00-381677"],"event":{"acronym":"PDC","end":"2016-08-19","place":"Aarhus, dk","start":"2016-08-15","title":"Participatory Design Conference","year":"2016"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Community","Participatory Design","Values","agonistic"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"negotiation of values as driver in community based pd","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1145/2940299.2940308","version":"Published Version"},"id":"S01-000.00-381677","identifier":[{"id":"85014708734","type":"scopus"}],"ids":["itu-1b890ac0-7098-4ace-af18-c10a614c5653"],"keyword":["agonistic","community","participatory design","values"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-10AE6B1B19DD01C876C65A2478D67DE8"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82419077/PDC2016_Negotiation_of_values_CAMERAREADY_FINAL_NO_COPYRIGHT.pdf","version":"Authors Final Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1145/2940299.2940308","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","The Department, People and Computational Things"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Erik","key":"gronvallpau","last":"Gronvall","locid":"1e0534b4-fe3e-4c5e-ad6d-5f1c7df6a14e","name":"Grönvall, Erik","name_org":"Gronvall, Erik","orcid":"0000-0002-7377-6091","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lone","key":"malmborgpau","last":"Malmborg","name":"Malmborg, Lone","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jörn","key":"messeterpau","last":"Messeter","locid":"a4c1604d-b01f-46ef-baf3-74d2a8046d6b","name":"Messeter, Jörn","orcid":"0000-0002-2181-149X","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1145/2940299.2940308","isbn":["9781450340465"],"issn":["21505896"],"pages":"41-50","publisher":"Association for Computing Machinery","series":"Proceedings of the Participatory Design Conference","status":"p","subtitle":"Full papers - Volume 1","title":"PDC '16 Proceedings of the 14th Participatory Design Conference"},"review":"Peer Reviewed","scoID":["2-s2.0-85014708734"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-1b890ac0-7098-4ace-af18-c10a614c5653"],"src":["ITU IT University of Copenhagen"],"title":"Negotiation of values as driver in community-based PD","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381677","year":"2016","yearsub":"2016"}
{"abstract":"Radio waves surround us but still they remain largely undetected by our senses. Unless we use specifically tuned hardware, such as FM radios, cell phones or WiFi modems, human beings cannot perceive wirelessly transmitted data. This paper presents FeltRadio, a portable and wireless technology that makes it possible to turn radio signals into visual and tactile stimuli as a form of sensorial augmentation. FeltRadio explores and makes us reflect upon what it would be like if we could sense, and feel, wireless traffic such as WiFi or Bluetooth. We present the technological design behind FeltRadio and the outcome of two exploratory studies with the technology focused on people's experience of being able to suddenly sense and make sense of wireless traffic. We discuss the possible qualities of this embodied experience of FeltRadio and point to future experiments with the technology.","author_count":3,"contributors":["Grönvall, Erik","Fritsch, Jonas","Vallgårda, Anna"],"cuid":["S01-000.00-382932"],"event":{"acronym":"DIS","title":"ACM Conference on Designing Interactive Systems"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Human Computer Interaction","Radio Signal Detection","Sensorial Augmentation","Tactile Stimuli","Wireless technology"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"feltradio sensing and making sense of wireless traffic","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84978704846","version":"Other Version"},"id":"S01-000.00-382932","identifier":[{"id":"84978704846","type":"scopus"}],"ids":["itu-6fcced39-0691-4cd2-b71d-623b5f65d30e"],"keyword":["Human-Computer Interaction","Radio Signal Detection","Sensorial Augmentation","Tactile Stimuli","Wireless Technology"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-AE67B03C51A0B86937902EF634EDF9A8"],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","The Department, People and Computational Things"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Erik","key":"gronvallpau","last":"Gronvall","locid":"1e0534b4-fe3e-4c5e-ad6d-5f1c7df6a14e","name":"Grönvall, Erik","name_org":"Gronvall, Erik","orcid":"0000-0002-7377-6091","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jonas","key":"fritschpau","last":"Fritsch","locid":"d37cba38-dff2-4c27-a515-226cfadfd849","name":"Fritsch, Jonas","orcid":"0000-0001-9065-2843","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anna","key":"vallgårdapau","last":"Vallgårda","locid":"2fa5dc89-7d78-45d0-96c7-e8f39b78dd3e","name":"Vallgårda, Anna","orcid":"0000-0001-9898-8106","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1145/2901790.2901818","isbn":["9781450340311"],"pages":"829-840","publisher":"Association for Computing Machinery","status":"p","subtitle":"DIS '16","title":"Proceedings of the 2016 ACM Conference on Designing Interactive Systems"},"review":"Peer Reviewed","scoID":["2-s2.0-84978704846"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-6fcced39-0691-4cd2-b71d-623b5f65d30e"],"src":["ITU IT University of Copenhagen"],"title":"FeltRadio: Sensing and Making Sense of Wireless Traffic","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382932","year":"2016","yearsub":"2016"}
