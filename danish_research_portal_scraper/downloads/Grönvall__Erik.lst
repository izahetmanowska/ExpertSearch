I-GTS-ALL","DI-U","DI-U-ALL","GTS Institutes","IT University of Copenhagen","Undetermined","Universities"],"PST":["Published"]},"sid":["aau-2e2e741d-ea7d-4327-a958-3e68bdbd3f45","au-e1a1b4cb-0d3a-415b-b844-0216ef7e68b3","itu-97bf6a62-e5ff-471c-9c7f-62b76c15465b"],"src":["AAU Aalborg University","AU Aarhus University","ITU IT University of Copenhagen"],"title":"CareCoor : Augmenting the Coordination of Cooperative Home Care Work","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-095.38-002318","year":"2013","yearsub":"2013"}
{"abstract":"This paper discusses how calendars and time coordination can be used across social and organizational borders, bridging between work and non-work, and between family coordination and external collaborators. The paper moves beyond family on-line calendars towards coordination and collaboration with professional caregivers and public authorities, and discusses how such shared calendars revitalize some of the very basic discussions of CSCW: The notion of shared goals in cooperative activities, the understanding of time and time-granularity in cooperation, common information spaces, and in particular boundary-crossing capacities and the holding back of information for fragmented exchange. Based on two cases, in which we have worked with sharing and coordination of time-resources in families on the one hand, and external parties such as external caregivers, employers and municipal authorities on the other, this paper will reopen these old CSCW debates. This paper questions if calendars, in particular family calendars should be designed based on shared goals and common interests. We argue that collaboration needs to be supported, even when families and their professional and amateur collaborators do not share the same goals, rhythms and routines","author_count":6,"contributors":["Bødker, Susanne","Grönvall, Erik"],"cuid":["S01-000.00-139076"],"event":{"acronym":"ECSCW","end":"2013-09-25","place":"Paphos, cy","start":"2013-09-21","title":"European Conference on Computer-Supported Cooperative Work","year":"2013"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"calendars time coordination and overview in families and beyond","src":["au"],"src-code":["DI-U-AU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/978-1-4471-5346-7_4","version":"Other Version"},"id":"S01-000.00-139076","ids":["au-10e6d89a-4a45-423f-b7d3-812c601e13d5"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-2BC0B5797D6A01589B942C82350989B7"],"oa_link":[{"access":"oa","type":"rem","url":"https://ecscw2013.cs.ucy.ac.cy/files/ECSCW%202013%20Manuscript.pdf","version":"Other Version"},{"access":"oa","type":"rem","url":"http://link.springer.com/chapter/10.1007/978-1-4471-5346-7_4","version":"Other Version"},{"access":"oa","type":"rem","url":"https://ecscw2013.cs.ucy.ac.cy/","version":"Other Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1007/978-1-4471-5346-7_4","version":"Other Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Arts, School of Communication and Culture, School of Communication and Culture - Participatory Information Technology","Aarhus University, Natural Sciences, Department of Computer Science"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Susanne","key":"bødkerpau","last":"Bødker","locid":"87d4fbb6-b38c-449e-b87d-59f693b7d6f0","name":"Bødker, Susanne","orcid":"0000-0002-3571-1617","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Erik","key":"grönvallpau","last":"Grönvall","locid":"b600b501-1612-47fd-9286-f687efaefaf0","name":"Grönvall, Erik","rank":2,"rolecode":"pau"},{"affno":"","first":"Olav W.","key":"bertelsenpedh","last":"Bertelsen","name":"Bertelsen, Olav W.","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Luigina","key":"ciolfipedh","last":"Ciolfi","name":"Ciolfi, Luigina","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Maria Antonietta","key":"grassopedh","last":"Grasso","name":"Grasso, Maria Antonietta","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"George Angelos","key":"papadopoulospedh","last":"Papadopoulos","name":"Papadopoulos, George Angelos","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-1-4471-5346-7_4","eisbn":["9781447153467"],"isbn":["9781447153450"],"pages":"63-81","publisher":"Springer VS","status":"p","subtitle":"Proceedings of the 13th European Conference on Computer Supported Cooperative Work, 2013","title":"ECSCW 2013"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-10e6d89a-4a45-423f-b7d3-812c601e13d5"],"src":["AU Aarhus University"],"title":"Calendars : Time coordination and overview in families and beyond","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-139076","year":"2013","yearsub":"2013"}
{"abstract":"More and more care, for example of older adults, is performed at home. Municipality home-care workers and novel technologies support this translocation of care. At home, an important care provider is also the immediate family. A recent trend is to formalize this volunteer-, and family-based care. However, this formalization requires new support systems for collaboration and communication. Also, when informal care turns formal there is a risk that a caring family-member might have to give up professional goals such as a career, or suffer economically as one may not be able to work fulltime while caring for another family member, such as an older parent. Hence it is both in the society and the individual’s interests that future supportive care technologies consider already at design time how to support care while not impede the everyday lives and possibilities for the caring family.","author_count":1,"contributors":["Grönvall, Erik"],"cuid":["S01-000.00-197641"],"event":{"end":"2013-09-21","place":"Paphos, cy","start":"2013-09-21","title":"Workshop at CSCW at the Boundary of Work and Life","year":"2013"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"aspects of family managed care at home","src":["au"],"src-code":["DI-U-AU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.au.dk/ws/files/56170934/gronvall_aspects_of_family_managed_care_at_home.pdf","version":"Pre-print"},"id":"S01-000.00-197641","ids":["au-77707f47-e320-4126-8b4d-a39a35a35bbe"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-EDD1FFC52C66F809FA3F3844572664C5"],"oa_link":[{"access":"oa","type":"rem","url":"http://cscwworkandlife.wordpress.com/","version":"Other Version"},{"access":"oa","type":"loc","url":"https://pure.au.dk/ws/files/56170934/gronvall_aspects_of_family_managed_care_at_home.pdf","version":"Pre-print"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Arts, School of Communication and Culture, School of Communication and Culture - Participatory Information Technology","Aarhus University, Natural Sciences, Department of Computer Science"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Erik","key":"grönvallpau","last":"Grönvall","locid":"b600b501-1612-47fd-9286-f687efaefaf0","name":"Grönvall, Erik","rank":1,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-77707f47-e320-4126-8b4d-a39a35a35bbe"],"src":["AU Aarhus University"],"title":"Aspects of family-managed care at home","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-197641","year":"2013","yearsub":"2013"}
{"abstract":"Participatory design (PD) activities in private homes challenge how we relate to the PD process, compared to PD in professional settings. Grounded in a project related to chronic dizziness among older people, we identified four challenges when performing PD with ill, weak users in their private homes. The challenges are (1) designing for, and negotiating knowledge about, the home, (2) ill, weak users and their participation in PD, (3) divergent interests of participants and (4) usable and sustainable post-project solutions. These challenges have to be carefully addressed, and we use them to reflect upon differences between a home-based PD process with non-workers, such as ours, and work-place projects, such as Utopia. Through this reflection, the paper contributes to a more general discussion on PD in non-work settings with weak users. Indeed, differences do exist between traditional PD projects in work settings, such as Utopia, and home-based PD with weak users especially in relation to knowledge about settings and how to reconcile differences in interests. The home as a place for (technology-assisted) treatment and PD must be carefully analyzed. Diverse interests and roles as well as possibilities for post-project solutions should be negotiated among all stakeholders","author_count":2,"contributors":["Grönvall, Erik","Kyng, Morten"],"cuid":["S01-000.00-231156"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Challenges","Healthcare","Home","Participatory Design"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"on participatory design of home based healthcare","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s10111-012-0226-7","version":"Other Version"},"id":"S01-000.00-231156","identifier":[{"id":"84885860245","type":"scopus"}],"ids":["au-b27753e2-15d9-4512-8a05-f5d8460b7bbe"],"keyword":["Challenges","Healthcare","Participants’ interests and motivation","Participatory design","Weak users","home"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-2CE51A114112F3A28D73B5D34BE8872B"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s10111-012-0226-7","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Computer Science"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Erik","key":"grönvallpau","last":"Grönvall","locid":"b600b501-1612-47fd-9286-f687efaefaf0","name":"Grönvall, Erik","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Morten","key":"kyngpau","last":"Kyng","locid":"f0486b10-a937-4cd9-aa99-168060eea4fc","name":"Kyng, Morten","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1007/s10111-012-0226-7","issn":["14355558","14355566"],"issn_org":["14355558"],"issue":"4","journal":"Cognition, Technology and Work","pages":"389-401","publisher":"Springer","status":"p","title":"Cognition, Technology and Work","volume":"15"},"review":"Peer Reviewed","scoID":["2-s2.0-84885860245"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-b27753e2-15d9-4512-8a05-f5d8460b7bbe"],"src":["AU Aarhus University"],"title":"On participatory design of home-based healthcare","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-231156","year":"2013","yearsub":"2013"}
{"abstract":"The herein presented study explores socio-technical complexities that may occur when introducing preventive health-measurement technologies in older adults’ daily routines and everyday lives. Using mainly blood pressure measurements in private homes, the study applied qualitative and quantitative methods to understand existing challenges and uncover opportunities of self-monitoring technologies to support preventive healthcare activities among older adults. Emerging challenges from our study were: rule complexity for self-measuring, reliability of measurements, interpretation, understanding and health awareness, the sharing activity for prevention, motivational factors, the role of the doctor for prevention, older adult’s use of technology, the home as a distributed information space, and visualization of health data. An awareness of these challenges can help designers to develop better tools to support people’s preventive self-monitoring needs compared with existing solutions. Furthermore, supporting the active and informed citizen can improve older adult’s care abilities, awareness and activation towards preventive care.","author_count":5,"contributors":["Grönvall, Erik","Verdezoto, Nervo"],"cuid":["S01-000.00-258123"],"event":{"acronym":"ECCE","end":"2013-08-28","place":"Toulouse, fr","start":"2013-08-26","title":"The European Conference on Cognitive Ergonomics","year":"2013"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Preventive care","Self monitoring","home based technology"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"understanding challenges and opportunities of preventive blood pressure self monitoring at home","src":["au"],"src-code":["DI-U-AU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.au.dk/ws/files/57006550/a31_gronvall.pdf","version":"Published Version"},"id":"S01-000.00-258123","identifier":[{"id":"84884639905","type":"scopus"}],"ids":["au-e1953f89-c521-4841-a741-d5084a952663"],"keyword":["home-based technology","preventive care","self-monitoring"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-37429A1D52755978A275A411B23D6C7E"],"oa_link":[{"access":"oa","type":"rem","url":"http://dl.acm.org/citation.cfm?id=2501962","version":"Other Version"},{"access":"oa","type":"loc","url":"https://pure.au.dk/ws/files/57006550/a31_gronvall.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1145/2501907.2501962","version":"Other Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Arts, School of Communication and Culture, School of Communication and Culture - Participatory Information Technology","Aarhus University, Natural Sciences, Department of Computer Science"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Erik","key":"grönvallpau","last":"Grönvall","locid":"b600b501-1612-47fd-9286-f687efaefaf0","name":"Grönvall, Erik","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Nervo","key":"verdezotopau","last":"Verdezoto","locid":"ce629209-5619-4b43-88fb-b8fd03725adb","name":"Verdezoto, Nervo","rank":2,"rolecode":"pau"},{"affno":"","first":"Philippe","key":"palanquepedh","last":"Palanque","name":"Palanque, Philippe","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Françoise","key":"détiennepedh","last":"Détienne","name":"Détienne, Françoise","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"André","key":"tricotpedh","last":"Tricot","name":"Tricot, André","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1145/2501907.2501962","eisbn":["9781450322515"],"publisher":"Association for Computing Machinery","status":"p","title":"Proceedings of the 31st European Conference on Cognitive Ergonomics (ACM ECCE 2013)"},"review":"Peer Reviewed","scoID":["2-s2.0-84884639905"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-e1953f89-c521-4841-a741-d5084a952663"],"src":["AU Aarhus University"],"title":"Understanding Challenges and Opportunities of Preventive Blood Pressure Self-Monitoring at Home","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-258123","year":"2013","yearsub":"2013"}
{"abstract":"Healthcare activities in private home settings that are not supervised by a healthcare professional can challenge older adults. To support such unsupervised care activities, an increasingly number of reminders and monitoring systems are designed. However, most of these systems target a specific treatment or a specific condition. In this paper, we discuss experiences from designing the tablet-based application MediFrame. MediFrame is a personal medication management system to support older adults in non-clinical settings such as the home. The paper describes the user-centered design process and the resulting tablet application. We show how MediFrame can be used to support adherence in medical treatments through fieldwork informed use scenarios. Based on early qualitative feedback, we also discuss lessons learned and how designers can support a holistic medication experience for an older adult’s everyday life.","author_count":3,"contributors":["Dalgaard, Lea Gulstav","Grönvall, Erik","Verdezoto, Nervo"],"cuid":["S01-000.00-264887"],"event":{"end":"2013-09-11","place":"Philadelphia, us","start":"2013-09-09","title":"IEEE International Conference on Healthcare Informatics","year":"2013"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Design","Medication management","Older adults","Tablet","User Centered Design"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GTS","DI-U"],"level3":{"GTS":["DI-GTS-ALL","DI-GTS-ALX"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-GTS-ALX","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"mediframe a tablet application to plan inform remind and sustain older adults medication intake","src":["au"],"src-code":["DI-U-AU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.au.dk/ws/files/57005852/MediFrameICHI2013.pdf","version":"Published Version"},"id":"S01-000.00-264887","identifier":[{"id":"84893457858","type":"scopus"}],"ids":["au-ed862b49-7f70-4eba-8dd2-a000f710f746"],"keyword":["Older Adults","User-centered design","design","medication management","tablet"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-299BFF14760C0C38C83819076AB92249"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.au.dk/ws/files/57005852/MediFrameICHI2013.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1109/ICHI.2013.12","version":"Other Version"}],"org":[{"affno":"1","country":"dk","key":"alexandra institute","l2":"DI-GTS","l2n":"GTS Institutes","l3":"DI-GTS-ALX","l3nn":"Alexandra Institute","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Alexandra Institute","namevar":["Alexandra Institute"],"nora_code":"DI-GTS-ALX","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Arts, School of Communication and Culture, School of Communication and Culture - Participatory Information Technology","Aarhus University, Natural Sciences, Department of Computer Science"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Lea Gulstav","key":"dalgaardpau","last":"Dalgaard","name":"Dalgaard, Lea Gulstav","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Erik","key":"grönvallpau","last":"Grönvall","locid":"b600b501-1612-47fd-9286-f687efaefaf0","name":"Grönvall, Erik","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Nervo","key":"verdezotopau","last":"Verdezoto","locid":"ce629209-5619-4b43-88fb-b8fd03725adb","name":"Verdezoto, Nervo","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1109/ichi.2013.12","eisbn":["9780769550893/13"],"isbn":["9780769550893/13"],"pages":"36-45","publisher":