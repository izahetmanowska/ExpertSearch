e":"Volume 2","title":"PDC '16 Proceedings of the 14th Participatory Design Conference: Short Papers, Interactive Exhibitions, Workshops"},"review":"Peer Reviewed","scoID":["2-s2.0-85017397003"],"search":{"DAF":["All Artistic Higher Education Institutions","All Danish Affiliations","All Miscellaneous","All Universities","Artistic Higher Education Institutions","DI-ALL","DI-ART","DI-ART-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["itu-360f8809-3440-45b8-8626-0feae99afecc"],"src":["ITU IT University of Copenhagen"],"title":"Migration of a sharing platform from Copenhagen to Aarhus: a live exploration of how social innovations may travel","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382065","year":"2016","yearsub":"2016"}
{"abstract":"This paper disseminates work from the European Give&Take project, which aims at co-designing service sharing among senior citizens based on a mobile and distributed platform. With this project as a frame, our paper addresses methodological considerations of participation in co-design for ageing. Based on the notions of design culture, communities of everyday practice and situated elderliness we present accounts from two European countries, and discuss methodological issues related to mobilizing senior citizens in co-design work as they have manifested themselves and influenced the Give&Take project. Challenges for mobilization are identified, based on an analysis of attitudes and values among design researchers and senior citizens. This analysis lead us to identify and discuss three strategies for mobilizing senior citizens in co-design of mobile technology: 1) Understanding being ‘elderly’ as situated elderliness rather than closed categories; 2) Understanding how ad hoc or loosely coupled infrastructures can define a community rather than a formal, organisational structure; and 3) Understanding the nature of mobilization and motivation for participation as processes that continue, and need to be supported, also after completion of the project. These strategies have emerged in our work on mobilization and service sharing, but may apply to a broader context of infrastructuring and ongoing negotiations.","author_count":5,"contributors":["Malmborg, Lone","Grönvall, Erik","Messeter, Jörn","Raben, Thomas","Werner, Katharina"],"cuid":["S01-000.00-383682"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Austria"],"glorg":["All Global Affiliations","Vienna University of Technology"],"keyword":["Co design","Design Culture","Infrastructuring","Negotiation","communities of everyday practices","mobilization work","situated elderliness"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Frederiksberg kommune"],"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"mobilizing senior citizens in co design of mobile technology","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82419043/MobileCHI2015Malmborgetalformattedfinalwithauthors_figures.pdf","version":"Authors Final Version"},"id":"S01-000.00-383682","identifier":[{"id":"84988383498","type":"scopus"}],"ids":["itu-a58f1b20-fa27-42e4-b17c-37226b7fb89e"],"keyword":["Co-design","communities of everyday practices","design culture","infrastructuring","mobilization work","negotiation","situated elderliness"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-B2B2119EDB9D3E69C13B0C01CD4F2329"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82419043/MobileCHI2015Malmborgetalformattedfinalwithauthors_figures.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","The Department, People and Computational Things"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Frederiksberg kommune"],"nora_code":"DI-OT","used":1},{"affno":"3","country":"at","key":"vienna university of technology","loc":["Austria","Europe, EU","OECD"],"name":"Vienna University of Technology","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Lone","key":"malmborgpau","last":"Malmborg","name":"Malmborg, Lone","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Erik","key":"gronvallpau","last":"Gronvall","locid":"1e0534b4-fe3e-4c5e-ad6d-5f1c7df6a14e","name":"Grönvall, Erik","name_org":"Gronvall, Erik","orcid":"0000-0002-7377-6091","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jörn","key":"messeterpau","last":"Messeter","locid":"a4c1604d-b01f-46ef-baf3-74d2a8046d6b","name":"Messeter, Jörn","orcid":"0000-0002-2181-149X","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Thomas","key":"rabenpau","last":"Raben","name":"Raben, Thomas","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Katharina","key":"wernerpau","last":"Werner","name":"Werner, Katharina","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.4018/ijmhci.2016100103","issn":["1942390X","19423918"],"issn_org":["1942390X"],"issue":"4","journal":"International Journal of Mobile Human Computer Interaction","pages":"42-67","publisher":"IGI global","status":"p","title":"International Journal of Mobile Human Computer Interaction","volume":"8"},"review":"Peer Reviewed","scoID":["2-s2.0-84988383498"],"search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["itu-a58f1b20-fa27-42e4-b17c-37226b7fb89e"],"src":["ITU IT University of Copenhagen"],"title":"Mobilizing Senior Citizens in Co-Design of Mobile Technology","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383682","year":"2016","yearsub":"2016"}
{"abstract":"This paper presents a theoretical framework for analyzing the aesthetics of participation of media architecture. The framework is based on a close reading of French philosopher Jacques Rancière and provides four points of emphasis: modes of sense perception, forms of engagement, community and emancipation. The framework is put to use in the analysis of three experimental media architectural projects; Ekkomaten/Echoes from Møllevangen, the coMotion Bench and FeltRadio. We discuss the findings from this analysis and outline future perspectives on how to develop and use the framework prospectively in the design of media architectural projects and other interactive environments.","author_count":3,"contributors":["Fritsch, Jonas","Grönvall, Erik","Breinbjerg, Morten"],"cuid":["S01-000.00-776420"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Aesthetics of participation","Interactive Environments","Jacques Rancière","Media architecture","Sense Perception"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-ITU"]},"level3all":["DI-U-AU","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"analyzing the aesthetics of participation of media architecture","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82943432/MAB2016_AestheticsOfParticipation_CAMERAREADY.pdf","version":"Authors Final Version"},"id":"S01-000.00-776420","identifier":[{"id":"85015397417","type":"scopus"}],"ids":["itu-82ddc544-072e-4264-a30c-f6e82a03f7ea"],"keyword":["Aesthetics of Participation","Interactive Environments","Jacques Rancière","Media Architecture","Sense Perception"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-3-5-9B6E766D7FA5239E0EDB4FBD824AAC22"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82943432/MAB2016_AestheticsOfParticipation_CAMERAREADY.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Play, Culture, and AI, Media, Art & Design"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jonas","key":"fritschpau","last":"Fritsch","locid":"d37cba38-dff2-4c27-a515-226cfadfd849","name":"Fritsch, Jonas","orcid":"0000-0001-9065-2843","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Erik","key":"grönvallpau","last":"Grönvall","locid":"1e0534b4-fe3e-4c5e-ad6d-5f1c7df6a14e","name":"Grönvall, Erik","orcid":"0000-0002-7377-6091","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Morten","key":"breinbjergpau","last":"Breinbjerg","name":"Breinbjerg, Morten","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1145/2946803.2946807","eisbn":["ISBN: 9781450347495"],"place":"ACM New York, NY, USA","publisher":"Association for Computing Machinery","status":"p","title":"Proceedings of the 3rd Conference on Media Architecture Biennale"},"review":"Peer Reviewed","scoID":["2-s2.0-85015397417"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-82ddc544-072e-4264-a30c-f6e82a03f7ea"],"src":["ITU IT University of Copenhagen"],"title":"Analyzing the Aesthetics of Participation of Media Architecture","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-776420","year":"2016","yearsub":"2018"}
{"abstract":"OBJECTIVE: The aim of this article is to describe the development and testing of a prototype application (\"The Heart Game\") using gamification principles to assist heart patients in their telerehabilitation process in the Teledialog project. MATERIALS AND METHODS: A prototype game was developed via user-driven innovation and tested on 10 patients 48-89 years of age and their relatives for a period of 2 weeks. The application consisted of a series of daily challenges given to the patients and relatives and was based on several gamification principles. A triangulation of data collection techniques (interviews, participant observations, focus group interviews, and workshop) was used. Interviews with three healthcare professionals and 10 patients were carried out over a period of 2 weeks in order to evaluate the use of the prototype. RESULTS: The heart patients reported the application to be a useful tool as a part of their telerehabilitation process in everyday life. Gamification and gameful design principles such as leaderboards, relationships, and achievements engaged the patients and relatives. The inclusion of a close relative in the game motivated the patients to perform rehabilitation activities. CONCLUSIONS: \"The Heart Game\" concept presents a new way to motivate heart patients by using technology as a social and active approach to telerehabilitation. The findings show the potential of using gamification for heart patients as part of a telerehabilitation program. The evaluation indicated that the inclusion of the patient's spouse in the rehabilitation activities could be an effective strategy. A major challenge in using gamification for heart patients is avoiding a sense of defeat while still adjusting the level of difficulty to the individual patient.","author_count":10,"contributors":["Dithmer, Marcus","Rasmussen, Jack Ord","Grönvall, Erik","Spindler, Helle","Hansen, John","Nielsen, Gitte","Sørensen, Stine Bæk","Dinesen, Birthe"],"cuid":["S03-095.79-004200"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":3,"keyword":["Gameful Design Principles","Gamification","Heart Patients","Telerehabilitation","User driven innovation"],"level":"sci","mra":["med","sci","soc"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-NDR"],"OT":["Unspecified organisation"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-ITU"]},"level3all":["DI-HO-NDR","DI-U-AAU","DI-U-AU","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"the heart game using gamification as part of a telerehabilitation programme for heart patients","src":["aau","au","itu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1089/g4h.2015.0001","version":"Published Version"},"id":"S03-095.79-004200","identifier":[{"id":"PMC4754508","type":"pmcid"},{"id":"26579590","type":"pmid"},{"id":"000370842800005","type":"wos"},{"id":"PMC4754508","type":"pmid"},{"id":"84993661525","type":"scopus"}],"ids":["aau-55f9fe73-7b4f-4ac0-9e5d-c16a7c8c3308","au-677ee36f-a08b-4804-8e13-fb585c9df2ae","itu-a6e7bc4f-f2d1-498f-a95b-17b1a245ae92"],"keyword":["Gameful Design Principles","Gamification","Heart Patients","Telerehabilitation","User-Driven Innovation"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology","Social Science"],"noi":["Global-Local-2-6-A105E58F9EDBD73A71C11DA50265E6BC"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1089/g4h.2015.0001","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/230246981/g4h_2E2015_2E0001_1_.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.itu.dk/ws/files/82342931/g4h.2015.0001.pdf","version":"Publis