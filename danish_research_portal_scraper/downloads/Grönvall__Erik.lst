"affno":"2","corresponding":null,"first":"Geraldine","key":"fitzpatrickpau","last":"Fitzpatrick","name":"Fitzpatrick, Geraldine","rank":4,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Cristiano","key":"stornipau","last":"Storni","name":"Storni, Cristiano","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Morten","key":"kyngpau","last":"Kyng","locid":"f0486b10-a937-4cd9-aa99-168060eea4fc","name":"Kyng, Morten","rank":6,"rolecode":"pau"},{"affno":"","first":"Virpi","key":"rotopedh","last":"Roto","name":"Roto, Virpi","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Jonna","key":"häkkiläpedh","last":"Häkkilä","name":"Häkkilä, Jonna","rank":8,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1145/2639189.2654837","isbn":["9781450325424"],"pages":"821-824","publisher":"Association for Computing Machinery","status":"p","subtitle":"Fun, Fast, Foundational","title":"NordiCHI '14, Proceedings of the 8th Nordic Conference on Human-Computer Interaction"},"review":"Peer Reviewed","scoID":["2-s2.0-84911423368"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["au-dc7d5519-da4e-49dd-a625-e8bb19e6ae0a"],"src":["AU Aarhus University"],"title":"Designing self-care for everyday life","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-255176","year":"2014","yearsub":"2014"}
{"abstract":"In this paper we introduce coMotion, a shape-changing bench. We explore how physical changes of the bench can shape social situations and how contextual atmospheres may affect users’ experience of the shape-changing bench and its surroundings. The bench was tested in three different contexts; a concert hall, an airport and a shopping mall. We gathered insights from more than 120 people, as they unexpectedly encountered the shape changing capabilities of the bench. By taking the user tests out of the lab and into the wild, we explored the influence of context on the users experience of a shape-changing interface, as well as on the experienced atmospheres.","author_count":4,"contributors":["Kinch, Sofie","Grönvall, Erik","Petersen, Marianne Graves","Rasmussen, Majken"],"cuid":["S02-080.41-761667"],"event":{"acronym":"TEI","title":"International Conference on Tangible, Embedded and Embodied Interactions"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Atmosfære","Contextual Atmospheres","Public spaces","Shape changing Bench","Social dynamics","User experience"],"level":"sci","mra":["hum","sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-ART","DI-GTS","DI-U"],"level3":{"ART":["DI-ART-AAA","DI-ART-ALL"],"GTS":["DI-GTS-ALL","DI-GTS-ALX"],"U":["DI-U-AAU","DI-U-ALL","DI-U-ITU"]},"level3all":["DI-ART-AAA","DI-GTS-ALX","DI-U-AAU","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"encounters on a shape changing bench exploring atmospheres and social behaviour in situ","src":["arka","itu"],"src-code":["DI-ART-AAA","DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1145/2540930.2540947","version":"Other Version"},"id":"S02-080.41-761667","identifier":[{"id":"84897551971","type":"scopus"}],"ids":["arka-654bddcb-5b68-40e9-beba-5984326380c9","itu-8130b28a-dc83-4fb8-9f6f-678fc6a2eb65"],"k