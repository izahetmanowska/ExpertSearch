{"author_count":4,"contributors":["Rasmussen, Majken Kirkegaard","Grönvall, Erik","Kinch, Sofie","Petersen, Marianne Graves"],"cuid":["S01-000.00-743475"],"event":{"end":"2013-11-29","place":"Adelaide, au","start":"2013-11-25","title":"Ozchi","year":"2013"},"filters":{"added":"2023-01","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-ART","DI-U"],"level3":{"ART":["DI-ART-AAA","DI-ART-ALL"],"U":["DI-U-ALL","DI-U-AU","DI-U-ITU"]},"level3all":["DI-ART-AAA","DI-U-AU","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"it s alive it s magic it s in love with you opportunities challenges and open questions for actuated interfaces","src":["arka"],"src-code":["DI-ART-AAA"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://adk.elsevierpure.com/ws/files/40324394/OzCHI2013_final_submission.pdf","version":"Pre-print"},"id":"S01-000.00-743475","identifier":[{"id":"84893243066","type":"scopus"}],"ids":["arka-d7f48102-e72b-4177-987c-36ad97c424f0"],"keyword":["No"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-621A2C62A29FB93F1DB0B5F5E9EAE990"],"oa_link":[{"access":"oa","type":"loc","url":"https://adk.elsevierpure.com/ws/files/40324394/OzCHI2013_final_submission.pdf","version":"Pre-print"}],"org":[{"affno":"1","country":"dk","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT Universitetet, Computer Games and Interaction Design"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","key":"aarhus school of architecture","l2":"DI-ART","l2n":"Artistic Higher Education Institutions","l3":"DI-ART-AAA","l3nn":"Aarhus School of Architecture","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Aarhus School of Architecture","namevar":["Aarhus School of Architecture","Aarhus School of Architecture, REform"],"nora_code":"DI-ART-AAA","used":1},{"affno":"3","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus Universitet, Institut for Datalogi"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Majken Kirkegaard","key":"rasmussenpau","last":"Rasmussen","locid":"aca60dc3-a969-49cd-9705-cb4dbe4c5e8c","name":"Rasmussen, Majken Kirkegaard","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Erik","key":"grönvallpau","last":"Grönvall","name":"Grönvall, Erik","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Sofie","key":"kinchpau","last":"Kinch","locid":"5c59cf7a-d3b6-436e-9c47-474429d46633","name":"Kinch, Sofie","orcid":"0000-0001-6525-2493","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Marianne Graves","key":"petersenpau","last":"Petersen","name":"Petersen, Marianne Graves","rank":4,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Artistic Higher Education Institutions","All Danish Affiliations","All Universities","Artistic Higher Education Institutions","DI-ALL","DI-ART","DI-ART-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["arka-d7f48102-e72b-4177-987c-36ad97c424f0"],"src":["Aarhus School of Architecture"],"title":"\"It’s alive, it’s magic, it’s in love with you” : Opportunities, Challenges and Open Questions for Actuated Interfaces","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-743475","year":"2013","yearsub":"2013"}
{"abstract":"Actuated Interfaces are receiving a great deal of interest from the research community. The field can now present a range of point designs, illustrating the potential design space of Actuated Interfaces. However, despite the increasing interest in Actuated Interfaces, the research carried out is nevertheless primarily preoccupied with the technical challenges and potential application areas, rather than how users actually approach, experience, interpret and understand Actuated Interfaces. Based on three case studies, investigating how people experience Actuated Interfaces, we point to; magic, movement and ambiguity as fruitful perspectives for understanding users' experiences with Actuated Interfaces. The three perspectives are employed to reflect upon opportunities and challenges, as well as point to open questions and relevant areas for future research for Actuated Interfaces.","author_count":9,"contributors":["Rasmussen, Majken Kirkegård","Grönvall, Erik","Kinch, Sofie","Petersen, Marianne Graves"],"cuid":["S01-000.00-745142"],"event":{"acronym":"OzCHI","end":"2013-11-29","place":"Adelaide, au","start":"2013-11-25","title":"Australian Computer-Human Interaction Conference","year":"2013"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GTS","DI-U"],"level3":{"GTS":["DI-GTS-ALL","DI-GTS-ALX"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-GTS-ALX","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"it s alive it s magic it s in love with you opportunities challenges and open questions for actuated interfaces","src":["au"],"src-code":["DI-U-AU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1145/2541016.2541033","version":"Other Version"},"id":"S01-000.00-745142","identifier":[{"id":"84893243066","type":"scopus"}],"ids":["au-b3f83384-7aba-49f1-bb6d-d148c0a13944"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-666818CCAF3DC4B448898214E2A354D3"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1145/2541016.2541033","version":"Other Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Computer Science"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"alexandra institute","l2":"DI-GTS","l2n":"GTS Institutes","l3":"DI-GTS-ALX","l3nn":"Alexandra Institute","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Alexandra Institute","namevar":["Alexandra Instituttet A/S"],"nora_code":"DI-GTS-ALX","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Majken Kirkegård","key":"rasmussenpau","last":"Rasmussen","locid":"a2d4fb12-ea2c-4bd9-b389-d6c4becd13f0","name":"Rasmussen, Majken Kirkegård","orcid":"0000-0003-2530-2331","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Erik","key":"grönvallpau","last":"Grönvall","locid":"b600b501-1612-47fd-9286-f687efaefaf0","name":"Grönvall, Erik","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Sofie","key":"kinchpau","last":"Kinch","locid":"c34d1347-56d7-4f18-84e1-56754f6e20e2","name":"Kinch, Sofie","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Marianne Graves","key":"petersenpau","last":"Petersen","locid":"da3161f7-ece7-471a-af07-f05e91059d3a","name":"Petersen, Marianne Graves","rank":4,"rolecode":"pau"},{"affno":"","first":"Haifeng","key":"shenpedh","last":"Shen","name":"Shen, Haifeng","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Ross","key":"smithpedh","last":"Smith","name":"Smith, Ross","rank":6,"role":"Editor of Host 