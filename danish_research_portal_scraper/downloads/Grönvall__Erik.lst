"Published"]},"sid":["au-8999909e-12a8-4750-9000-01fde7e7c624"],"src":["AU Aarhus University"],"title":"Turning training into play : embodied gaming, seniors, physical training and motivation","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-207838","year":"2011","yearsub":"2011"}
{"abstract":"This paper presents an ongoing work developing and testing a Service Composition framework based upon the REST architecture named SECREST. A minimalistic approach have been favored instead of a creating a complete infrastructure. One focus has been on the system's interaction model. Indeed, an aim is to allow users in different healthcare scenarios to experiment with service composition to support highly individual and changing needs.","author_count":4,"contributors":["Grönvall, Erik","Ingstrup, Mads","Pløger, Morten","Rasmussen, Morten"],"cuid":["S01-000.00-241041"],"event":{"end":"2011-09-22","place":"Pittsburgh, PA, us","start":"2011-09-18","title":"2011 IEEE Symposium on Visual Languages and Human-Centric Computing","year":"2011"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"rest based service composition exemplified in a care network scenario","src":["au"],"src-code":["DI-U-AU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1109/VLHCC.2011.6070417","version":"Other Version"},"id":"S01-000.00-241041","identifier":[{"id":"82855169249","type":"scopus"}],"ids":["au-c3c377b1-50a1-4c29-8b37-acb24126cff7"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-669B6CDE10893281AF9C903E76F5EA43"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1109/VLHCC.2011.6070417","version":"Other Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of