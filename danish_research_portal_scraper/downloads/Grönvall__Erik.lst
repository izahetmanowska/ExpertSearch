ities"],"PST":["Published"]},"sid":["au-9bc6e45e-fb92-4f2c-8e81-be16820fc899"],"src":["AU Aarhus University"],"title":"Heritability and polygenic load for comorbid anxiety and depression","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-807104","year":"2025","yearsub":"2025"}
{"abstract":"MusicalAid is a tangible music system that allows people with different musical literacy and gross/fine motoric skills to play and create music together, either guided by a predefined rhythm or in a ‘free play’ mode. The system is composed of a main unit and a set of ‘instruments’, for example joysticks, a board with large buttons or soft interfaces like pillows with areas that act as switches. MusicalAid is designed so all instruments can at a basic level be synchronized to play to the same rhythm or beat, so they all sound at the same time. MusicalAid was originally developed for adults on the autistic spectrum with gross/fine-motoric limitations but MusicalAid can also allow people in general with different musical and motoric capabilities to play together. Therefore, MusicalAid enables a fun music experience for people that find handling traditional musical instruments challenging, or simply someone who just likes to jam.","author_count":1,"contributors":["Grönvall, Erik"],"cuid":["S01-000.00-747217"],"filters":{"added":"2024-08","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"keyword":["Autism","Beat","Collaborative","Dementia","Fun","Music","MusicalAid","Play","Rhythm"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"musicalaid a playful collaborative music tool for people finding it difficult to handle common instruments","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://pure.itu.dk/ws/files/105752057/MusicalAid_TEI24_fromACM.pdf","version":"Authors Final Version"},"id":"S01-000.00-747217","ids":["itu-2bf60fbf-892b-4220-a0e1-e58457850273"],"keyword":["MusicalAid","autism","beat","collaborative","dementia","fun","music","play","rhythm"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-3B3E6A7E1D94F9019A40B9C452D2D088"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://pure.itu.dk/ws/files/105752057/MusicalAid_TEI24_fromACM.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Digital Design, Design Research Section","IT University of Copenhagen, Human-Computer Interaction and Design, Co-Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Erik","key":"grönvallpau","last":"Grönvall","locid":"1e0534b4-fe3e-4c5e-ad6d-5f1c7df6a14e","name":"Grönvall, Erik","orcid":"0000-0002-7377-6091","rank":1,"rolecode":"pau"}],"pub":{"pages":"1-6","publisher":"Association for Computing Machinery","status":"p","title":"TEI '24: Proceedings of the Eighteenth International Conference on Tangible, Embedded, and Embodied Interaction"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-2bf60fbf-892b-4220-a0e1-e58457850273"],"src":["ITU IT University of Copenhagen"],"title":"MusicalAid: A Playful Collaborative Music Tool for People Finding it Difficult to Handle Common Instruments","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-747217","year":"2024","yearsub":"2024"}
{"abstract":"Longstanding practices of participatory co-design have sought to engage communities in the development of shared resources, services, and technologies. However, approaches such as citizencentered design and digital civics bring these design methods to bear on the development of digital technologies in support of civic and third sector organizations in particularly complex and rapidly changing socio-technical landscapes. Such endeavors frequently need to engage marginalized, under-served and hard to reach communities. In these design spaces, the ‘Digital Citizen’ becomes a contested concept, deserving of deeper exploration. In this one-day workshop we seek to bring together the DIS community, industry practitioners and third sector representatives to mutually explore the concept of the digital citizen, its boundaries, and opportunities, and in response to a rapidly changing environment of smart digital services, the ways in which design methods might be evolved to better support designing for and with these digital citizens.","author_count":10,"contributors":["Kirk, David S.","Boztepe, Suzan","Christansson, Jörn","Götzen, Amalia De","Ehrenberg, Nils","Grönvall, Erik","Lawson, Shaun","Linde, Per","Saad-Sulonen, Joanna","Vlachokyriakos, Vasilis"],"cuid":["S01-000.00-743440"],"event":{"end":"2024-07-05","place":"Copenhagen, dk","start":"2024-07-01","title":"ACM Conference on Designing Interactive Systems 2024","year":"2024"},"filters":{"added":"2024-08","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Kirk, David S."],"country":["Finland","Sweden","United Kingdom"],"glorg":["Aalto University","All Global Affiliations","Linköping University","Malmö University","Newcastle University","Northumbria University"],"keyword":["Citizen Centered Design","Codesign","Digital Citizen","Digital Social Innovation","Participatory Design"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-AAU","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"designing for and with the digital citizen","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.1145/3656156.3658383","version":"Published Version"},"funding_acknowledgement":["This workshop is funded by the EPSRC Next Stage Digital Economy Centre for Digital Citizens (EP/T022582/1), and the Civic Agency in Public E-service innovation (CAPE) project funded by NordForsk (project: 98907)."],"id":"S01-000.00-743440","identifier":[{"id":"85198900774","type":"scopus"}],"ids":["aau-f9e7cce2-2d94-4805-9fd1-2e81b2aae5a4"],"keyword":["Citizen-Centered Design","CoDesign","Digital Citizen","Digital Social Innovation","Participatory Design"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-3-5-45CC9D32EB3F1E78EF12602EC72C03DB"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.1145/3656156.3658383","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/721436654/3656156.3658383.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"gb","key":"newcastle university","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Newcastle University","used":1},{"affno":"2","country":"se","key":"linköping university","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Linköping University","used":1},{"affno":"3","country":"dk","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen"],"nora_code":"DI-U-ITU","used":1},{"affno":"4","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Technical Faculty of IT and Design","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology, Section for Media Technology - Campus Copenhagen","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology, Service Systems Design"],"nora_code":"DI-U-AAU","used":1},{"affno":"5","country":"fi","key":"aalto university","loc":["Finland","Europe, EU","Nordic","OECD"],"name":"Aalto University","used":1},{"affno":"6","country":"gb","key":"northumbria university","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Northumbria University","used":1},{"affno":"7","country":"se","key":"malmö university","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Malmö University","used":1}],"person":[{"affno":"1","corresponding":null,"first":"David S.","key":"kirkpau","last":"Kirk","name":"Kirk, David S.","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Suzan","key":"boztepepau","last":"Boztepe","name":"Boztepe, Suzan","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jörn","key":"christanssonpau","last":"Christansson","name":"Christansson, Jörn","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"Amalia","key":"degötzenpau","last":"de Götzen","locid":"3e5ee7f6-ec4c-4cca-a8ba-749ffd5f8f17","name":"Götzen, Amalia De","name_org":"de Götzen, Amalia","orcid":"0000-0001-7214-5856","rank":4,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Nils","key":"ehrenbergpau","last":"Ehrenberg","name":"Ehrenberg, Nils","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Erik","key":"grönvallpau","last":"Grönvall","name":"Grönvall, Erik","rank":6,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Shaun","key":"lawsonpau","last":"Lawson","name":"Lawson, Shaun","rank":7,"rolecode":"pau"},{"affno":"7","corresponding":null,"first":"Per","key":"lindepau","last":"Linde","name":"Linde, Per","rank":8,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Joanna","key":"saadsulonenpau","last":"Saad-Sulonen","name":"Saad-Sulonen, Joanna","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Vasilis","key":"vlachokyriakospau","last":"Vlachokyriakos","name":"Vlachokyriakos, Vasilis","rank":10,"rolecode":"pau"}],"pub":{"doi":"10.1145/3656156.3658383","eisbn":["9798400706325"],"pages":"467-469","publisher":"Association for Computing Machinery (ACM)","status":"p","subtitle":"Companion Publication of the 2024 ACM Designing Interactive Systems Conference","title":"DIS 2024 - Proceedings of the 2024 ACM Designing Interactive Systems Conference"},"review":"Peer Reviewed","scoID":["2-s2.0-85198900774"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["aau-f9e7cce2-2d94-4805-9fd1-2e81b2aae5a4"],"src":["AAU Aalborg University"],"title":"Designing for and with the ‘Digital Citizen’","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-743440","year":"2024","yearsub":"2024"}
{"abstract":"Participatory design has struggled in the context of large public systems development. Two decades ago, PD researchers addressed these issues in a “reformist PD agenda”, inviting PD practitioners to consider participation in public sector development, assess paradigm claims and revitalise the political perspective of PD. Today’s digitalisation wave, with public digital services becoming the only option for citizen interaction with authorities, reveals digital inequalities in society that once again puts focus on civic agency in public sector design. This paper investigates user participation in digital public service design through an empirical study, composed by twelve semi-structured interviews with key actors in digitalizing public services in Denmark, followed by a thematic analysis. The study highlights how the national digital strategy, procurement processes, available competence and other factors shape user participation in public sector design. Based on these findings, we reflect on the potential role of PD in contemporary public sector design.","author_count":3,"contributors":["Messeter, Jörn","Grönvall, Erik","Saad-Sulonen, Joanna"],"cuid":["S01-000.00-798539"],"event":{"acronym":"PDC","title":"Participatory Design Conference"},"filters":{"added":"2025-04","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"country":["Finland"],"glorg":["All Global Affiliations","Lappeenranta–Lahti University of Technology"],"keyword":["Design","Digitalisation","Mapping","Participation","Public services"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"mapping user participation in the design of digital public services is pd relevant","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1145/3666094.3666102","version":"Published Version"},"id":"S01-000.00-798539","identifier":[{"id":"85204901036","type":"scopus"}],"ids":["itu-74865088-44cf-4e02-ba25-3a287add7970"],"keyword":["Design","Digitalisation","Mapping","Participation","Public Services"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-A92FD3DDCC3FA9CF1AF5C91D9AF7F331"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1145/3666094.3666102","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Digital Design, Design Research Section","IT University of Copenhagen, Human-Computer Interaction and Design, Co-Design"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"fi","key":"lappeenranta lahti university of technology","loc":["Finland","Europe, EU","Nordic","OECD"],"name":"Lappeenranta–Lahti University of Technology","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jörn","key":"christianssonpau","last":"Christiansson","locid":"a4c1604d-b01f-46ef-baf3-74d2a8046d6b","name":"Messeter, Jörn","name_org":"Christiansson, Jörn","orcid":"0000-0002-2181-149X","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Erik","key":"grönvallpau","last":"Grönvall","locid":"1e0534b4-fe3e-4c5e-ad6d-5f1c7df6a14e","name":"Grönvall, Erik","orcid":"0000-0002-7377-6091","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Joanna","key":"saadsulonenpau","last":"Saad-Sulonen","name":"Saad-Sulonen, Joanna","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1145/3666094.3666102","isbn":["9798400708084"],"place":"New York, NY, United States","publisher":"Association for Computing Machinery","status":"p","title":"Proceedings of the Participatory Design Conference 2024","volume":"1"},"review":"Peer Reviewed","scoID":["2-s2.0-85204901036"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-74865088-44cf-4e02-ba25-3a287add7970"],"src":["ITU IT University of Copenhagen"],"title":"Mapping User Participation in the Design of Digital Public Services : Is PD Relevant?","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-798539","year":"2024","yearsub":"2024"}
{"abstract":"Longstanding practices of participatory co-design have sought to engage communities in the development of shared resources, services, and technologies. However, approaches such as citizen-centered design and digital civics bring these design methods to bear on the development of digital technologies in support of civic and third sector organizations in particularly complex and rapidly changing socio-technical landscapes. Such endeavors frequently need to engage marginalized, under-served and hard to reach communities. In these design spaces, the ‘Digital Citizen’ becomes a contested concept, deserving of deeper exploration. In this one-day workshop we seek to bring together the DIS community, industry practitioners and third sector representatives to mutually explore the concept of the digital citizen, its boundaries, and opportunities, and in response to a rapidly changing environment of smart digital services, the ways in which design methods might be evolved to better support designing for and with these digital citizens.","author_count":10,"contributors":["Kirk, David","Boztepe, Suzan","Messeter, Jörn","Götzen, Amalia de","Ehrenberg, Nils","Grönvall, Erik","Lawson, Shaun","Linde, Per","Saad-Sulonen, Joanna","Vlachokyriakos, Vasilis"],"cuid":["S01-000.00-747236"],"event":{"acronym":"DIS","title":"ACM Conference on Designing Interactive Systems"},"filters":{"added":"2024-08","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","Nordic","OECD"],"country":["Finland","Sweden","United Kingdom"],"glorg":["Aalto University","All Global Affiliations","Lappeenranta–Lahti University of Technology","Linköping University","Malmö University","Newcastle University","Northumbria University"],"keyword":["Citizen Centered Design","Co design","Digital Citizen","Digital Social Innovation","Participatory Design"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-AAU","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"designing for and with the digital citizen in companion publication of the 000000002024 acm designing interactive systems conference dis 000000000024 companion association for computing machinery new york ny usa 000000000467 000000000469 https doi org 000000000010 000000001145 000003656156 000003658383","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1145/3656156.3658383","version":"Published Version"},"id":"S01-000.00-747236","identifier":[{"id":"85198900774","type":"scopus"}],"ids":["itu-78aa13f7-5150-4002-8315-a99a097fd890"],"keyword":["Citizen-Centered Design","Co- Design","Digital Citizen","Digital Social Innovation","Participatory Design"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-3-5-45CC9D32EB3F1E78EF12602EC72C03DB"],"oa_link":[{"access":"oa","type":"rem","url":"https://dl.acm.org/doi/pdf/10.1145/3656156.3658383","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1145/3656156.3658383","version":"Published Version"}],"org":[{"affno":"1","country":"gb","key":"newcastle university","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Newcastle University","used":1},{"affno":"2","country":"se","key":"linköping university","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Linköping University","used":1},{"affno":"3","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Digital Design, Design Research Section","IT University of Copenhagen, Human-Computer Interactio