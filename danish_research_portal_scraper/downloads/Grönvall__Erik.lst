d4fb12-ea2c-4bd9-b389-d6c4becd13f0","name":"Rasmussen, Majken Kirkegård","orcid":"0000-0003-2530-2331","rank":4,"rolecode":"pau"},{"affno":"","first":"Andreas","key":"butzpedh","last":"Butz","name":"Butz, Andreas","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Saul","key":"greenbergpedh","last":"Greenberg","name":"Greenberg, Saul","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1145/2540930.2540947","isbn":["9781450326353"],"pages":"233-240","publisher":"Association for Computing Machinery","status":"p","title":"Proceedings of the 8th International Conference on Tangible, Embedded and Embodied Interaction, TEI '14"},"review":"Peer Reviewed","scoID":["2-s2.0-84897551971"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All GTS Institutes","All Universities","DI-ALL","DI-GTS","DI-GTS-ALL","DI-U","DI-U-ALL","GTS Institutes","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["au-525498bc-ce4e-458a-af56-b9ec8cfd31b8"],"src":["AU Aarhus University"],"title":"Encounters on a Shape-changing Bench : Exploring atmospheres and social behaviour in situ","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-737067","year":"2014","yearsub":"2014"}
{"abstract":"Healthcare HCI research has explored various designs that encourage people to follow prescribed treatments, mostly adopting compliance and adherence as design ideals. However, within the medical sciences the notion of concordance also exists. Concordance promotes negotiation between the patient and healthcare professional for forging a therapeutic alliance. However, the HCI community has still not adopted concordance as a design ideal. This paper revisits four old design-cases to explore the role of concordance in out-of-clinic healthcare. We argue that concordance, as a design ideal, can guide new designs that promote a more active patient-role both at the clinic and beyond.","author_count":3,"contributors":["Bagalkot, Naveen L.","Grönvall, Erik","Sokoler, Tomas"],"cuid":["S01-000.00-382304"],"event":{"acronym":"CHI","title":"ACM Conference on Human Factors in Computing Systems"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Asia, South"],"country":["India"],"glorg":["All Global Affiliations","Srishti Manipal Institute of Art, Design and Technology"],"keyword":["Adherence","Compliance","Concordance","Healthcare HCI","Therapeutic alliance"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"concordance design ideal for facilitating situated negotiations in out of clinic healthcare","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1145/2559206.2578873","version":"Other Version"},"id":"S01-000.00-382304","identifier":[{"id":"84900550570","type":"scopus"}],"ids":["itu-45b5fcf8-7f76-4556-af4d-686f484c5a4b"],"keyword":["Adherence","Compliance","Concordance","Healthcare HCI","Therapeutic Alliance"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-A4FD917E070CBFBF482973A8BCB7CAAD"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1145/2559206.2578873","version":"Other Version"}],"org":[{"affno":"1","country":"in","key":"srishti manipal institute of art design and technology","loc":["India","Asia, South"],"name":"Srishti Manipal Institute of Art, Design and Technology","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","The Department, Computer Games and Interaction Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Naveen L.","key":"bagalkotpau","last":"Bagalkot","name":"Bagalkot, Naveen L.","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Erik","key":"gronvallpau","last":"Gronvall","locid":"1e0534b4-fe3e-4c5e-ad6d-5f1c7df6a14e","name":"Grönvall, Erik","name_org":"Gronvall, Erik","orcid":"0000-0002-7377-6091","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Tomas","key":"sokolerpau","last":"Sokoler","name":"Sokoler, Tomas","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1145/2559206.2578873","isbn":["9781450324748/1"],"publisher":"Association for Computing Machinery","status":"p","subtitle":"Extended Abstracts of CHI2014","title":"The ACM SIGCHI Conference on Human Factors in Computing Systems"},"review":"Peer Reviewed","scoID":["2-s2.0-84900550570"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-45b5fcf8-7f76-4556-af4d-686f484c5a4b"],"src":["ITU IT University of Copenhagen"],"title":"Concordance: Design Ideal for Facilitating Situated Negotiations in Out-of-clinic Healthcare","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382304","year":"2014","yearsub":"2014"}
{"abstract":"Managing chronic conditions can be challenging. People in such conditions, and the people around them, have to: deal with symptoms, adapt to the resulting disability, manage emotions, and change habits to keep the condition under control. Self-care technologies have the potential to support self-care and mediate the relationship between patients (and caregivers) and the condition. However, these technologies often disregard the complexity of the settings in which they are used and fail to become integrated in everyday life. In this workshop we will discuss how to design self-care technologies that are in harmony with people's everyday life. Therefore, we invite designers, researchers and practitioners to participate in a full-day workshop in which we will reflect on each other's work, and do a design exercise with patients and caregivers.","author_count":6,"contributors":["Verdezoto, Nervo","Nunes, Francisco","Grönvall, Erik","Fitzpatrick, Geraldine","Storni, Cristiano","Kyng, Morten"],"cuid":["S01-000.00-182476"],"event":{"end":"2014-10-27","place":"Helsinki, fi","start":"2014-10-27","title":"Workshop on Designing Self-care for Everyday Life","year":"2014"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Austria","Ireland"],"glorg":["All Global Affiliations","University of Limerick","Vienna University of Technology"],"keyword":["Chronic care","Personal health management","Self Care","Self care technology","Self management"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-ITU"]},"level3all":["DI-U-AU","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"proceedings of designing self care for everyday life workshop in conjunction with nordichi 000000002014 000000000027th october 000000002014 helsinki finland","src":["au"],"src-code":["DI-U-AU"],"type":"db","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://ojs.statsbiblioteket.dk/index.php/daimipb/issue/view/2772","version":"Other Version"},"id":"S01-000.00-182476","ids":["au-5d202a99-febf-4dd2-817b-781964402198"],"keyword":["Personal health management","Self-care","Self-management","chronic care","self-care technology"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-6BFD6052B411E2EA1CE75FD524A12A8F"],"oa_link":[{"access":"oa","type":"rem","url":"http://ojs.statsbiblioteket.dk/index.php/daimipb/issue/view/2772","version":"Other Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Computer Science"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"at","key":"vienna university of technology","loc":["Austria","Europe, EU","OECD"],"name":"Vienna University of Technology","used":1},{"affno":"3","country":"dk","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen"],"nora_code":"DI-U-ITU","used":1},{"affno":"4","country":"ie","key":"university of limerick","loc":["Ireland","Europe, EU","OECD"],"name":"University of Limerick","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Nervo","key":"verdezotoped","last":"Verdezoto","locid":"ce629209-5619-4b43-88fb-b8fd03725adb","name":"Verdezoto, Nervo","rank":1,"role":"Editor","rolecode":"ped"},{"affno":"2","corresponding":null,"first":"Francisco","key":"nunesped","last":"Nunes","name":"Nunes, Francisco","rank":2,"role":"Editor","rolecode":"ped"},{"affno":"3"