d","last":"Teli","locid":"3fb25d29-be2b-4845-85fc-b192d8a5af29","name":"Teli, Maurizio","orcid":"0000-0002-6654-1788","rank":2,"role":"Editor","rolecode":"ped"},{"affno":"3","corresponding":null,"first":"Ann","key":"lightped","last":"Light","name":"Light, Ann","rank":3,"role":"Editor","rolecode":"ped"},{"affno":"4","corresponding":null,"first":"Yanki","key":"leeped","last":"Lee","name":"Lee, Yanki","rank":4,"role":"Editor","rolecode":"ped"},{"affno":"5","corresponding":null,"first":"Carl","key":"disalvoped","last":"DiSalvo","name":"DiSalvo, Carl","rank":5,"role":"Editor","rolecode":"ped"},{"affno":"6","corresponding":null,"first":"Erik","key":"grönvallped","last":"Grönvall","name":"Grönvall, Erik","rank":6,"role":"Editor","rolecode":"ped"},{"affno":"7","corresponding":null,"country":"dk","first":"Anne Marie","key":"kanstrupped","last":"Kanstrup","locid":"3e4fb5d6-eabc-4a90-a6e4-bf5a514d5cfa","name":"Kanstrup, Anne Marie","orcid":"0000-0002-3149-1194","rank":7,"role":"Editor","rolecode":"ped"},{"affno":"8","corresponding":null,"first":"Keld","key":"bødkerped","last":"Bødker","name":"Bødker, Keld","rank":8,"role":"Editor","rolecode":"ped"}],"pub":{"eisbn":["9781450355742"],"issn":["21505896"],"place":"New York","publisher":"Association for Computing Machinery (ACM)","series":"Proceedings of Participatory Design Conference","status":"p","volume":"2"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Roskilde University","Universities"],"PST":["Published"]},"sid":["aau-c2946c34-17cb-4c73-92ac-d03d233c85aa"],"src":["AAU Aalborg University"],"title":"Proceedings of the 15th Participatory Design Conference : Short Papers, Situated Actions, Workshops and Tutorial - Volume 2","type":"Book","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-106508","year":"2018","yearsub":"2018"}
{"abstract":"This paper reports on early field explorations with WiredRadio. WiredRadio is a device that intercepts 2.4GHz radio activity and based on the received data signal strength activates a motor with a string attached to it. Similar to the classical ‘dangling sting’ installation by Jeremijenko, the more wireless network traffic there is, the more will the string move. The paper discuss insights derived from a field deployment where WiredRadio was installed in a family house for three weeks. The insights deals with the family’s perception and understanding of WiredRadio, their relationship with WiredRadio as an artifact and ambient display and how WiredRadio influence their understanding of wireless data traffic and what it may represent.","author_count":1,"contributors":["Grönvall, Erik"],"cuid":["S01-000.00-382095"],"event":{"acronym":"DIS","title":"ACM Conference on Designing Interactive Systems"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"1 contributor","cluster_size":1,"keyword":["2 4GHz Radio Activity","Ambient Display","Family Interaction","WiredRadio","Wireless Data Traffic Perception"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"wiredradio a study of living with radio awareness","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83142564/DIS2018_WiP_WiredRadio_prep_Cameraready_FINAL.pdf","version":"Authors Final Version"},"id":"S01-000.00-382095","identifier":[{"id":"85054160141","type":"scopus"}],"ids":["itu-37e6d00f-0642-4a88-a43d-2e67516bf428"],"keyword":["2.4GHz Radio Activity","Ambient Display","Family Interaction","WiredRadio","Wireless Data Traffic Perception"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-E3CAE0496C8924AFEB77DC7C5126EF93"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83142564/DIS2018_WiP_WiredRadio_prep_Cameraready_FINAL.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Human-Computer Interaction and Design, Co-Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Erik","key":"grönvallpau","last":"Grönvall","locid":"1e0534b4-fe3e-4c5e-ad6d-5f1c7df6a14e","name":"Grönvall, Erik","orcid":"0000-0002-7377-6091","rank":1,"rolecode":"pau"}],"pub":{"doi":"10.1145/3197391.3205423","eisbn":["9781450356312"],"pages":"123-127","place":"New York, US","publisher":"Association for Computing Machinery","status":"p","title":"Proceedings of the 2017 ACM Conference Companion Publication on Designing Interactive Systems"},"review":"Peer Reviewed","scoID":["2-s2.0-85054160141"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-37e6d00f-0642-4a88-a43d-2e67516bf428"],"src":["ITU IT University of Copenhagen"],"title":"WiredRadio: A Study of Living with Radio Awareness","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382095","year":"2018","yearsub":"2018"}
{"abstract":"There are few examples of academic work that describe Participatory Design (PD) and Co-design instruction. This paper presents experiences from four years of teaching a university course on Co-design and PD to an average of 57 students per year. A main part of our pedagogical approach is the implementation of Donald Schön’s concept of a reflective practicum, via a mandatory ‘live’ project that runs for the whole semester. We discuss the potential and challenges of teaching PD and Co-design to large classes using live projects, including how to give students first-hand experience of the whole PD process, how to coach students in collecting and using field data, and what expectations of a Co-design process and its participants are realistic. The paper also examines how PD-related challenges affect teaching PD as an academic subject.","author_count":3,"contributors":["Messeter, Jörn","Grönvall, Erik","Yndigegn, Signe Louise"],"cuid":["S01-000.00-382167"],"event":{"acronym":"PDC","title":"Participatory Design Conference"},"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Analysis","Co design","Lessons learnt","Live projects","Participatory Design","Reflections","Teaching","University course"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"teaching participatory design using live projects critical reflections and lessons learnt","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83392524/PDC2018_teachingPD_FINAL_18052018_preprint.pdf","version":"Authors Final Version"},"id":"S01-000.00-382167","ids":["itu-3cf1ce47-12ed-4ffe-95e8-002b4382b378"],"keyword":["Analysis","Co-design","Lessons learnt","Live projects","Participatory Design","Reflections","Teaching","University course"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-F35BC0DC0DBA570BAD0CFBED3A62A093"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83392524/PDC2018_teachingPD_FINAL_18052018_preprint.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jörn","key":"christianssonpau","last":"Christiansson","locid":"a4c1604d-b01f-46ef-baf3-74d2a8046d6b","name":"Messeter, Jörn","name_org":"Christiansson, Jörn","orcid":"0000-0002-2181-149X","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Erik","key":"grönvallpau","last":"Grönvall","locid":"1e0534b4-fe3e-4c5e-ad6d-5f1c7df6a14e","name":"Grönvall, Erik","orcid":"0000-0002-7377-6091","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Signe Louise","key":"yndigegnpau","last":"Yndigegn","locid":"b3e022c2-a124-41f0-a7fc-4c4f6ab5e99c","name":"Yndigegn, Signe Louise","orcid":"0000-0002-3438-7288","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1145/3210586.3210597","isbn":["9781450363716"],"issn":["21505896"],"pages":"1-11","place":"New York, US","publisher":"Association for Computing Machinery","series":"Proceedings of the Participatory Design Conference","status":"p","title":"PDC '18 Proceedings of the 15th Participatory Design Conference : Full papers - Volume 1"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-3cf1ce47-12ed-4ffe-95e8-002b4382b378"],"src":["ITU IT University of Copenhagen"],"title":"Teaching Participatory Design using Live Projects: Critical Reflections and Lessons Learnt","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382167","year":"2018","yearsub":"2018"}
{"abstract":"The internet has long been a core infrastructure especially for the western societies. In the last decade, the usage of the internet changed from a mainly communication infrastructure giving mainly access to static information to become a platform to full-scale applications implemented as services. Even more recently we can observe a growing use of the internet to collect and provide data: social media platforms and search engines collect, use and sell data about their usage and users; online shops use data to recommend goods to the buyer; municipalities and other public organisations provide data through open data interfaces so it can be used by companies, e.g. to provide advice for car drivers searching for a parking lot. The data infrastructure making data accessible, though, requires IT expertise. In this position paper we explore the implication of this development from a participatory design perspective and argue that we need to engage in infrastructuring in order to make the common data a common good.","author_count":3,"contributors":["Dittrich, Yvonne","Seidelin, Cathrine","Grönvall, Erik"],"cuid":["S01-000.00-383190"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Data Accessibility","Data driven services","Internet infrastructure","Open data interfaces","Participatory Design"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"nr","rtype":["clu"],"sorti":"data as infrastructure infrastructuring for data analytics","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-ND","type":"loc","url":"https://pure.itu.dk/ws/files/83630235/Data_as_Infrastructure_1.0.pdf","version":"Other Version"},"id":"S01-000.00-383190","ids":["itu-82e759e9-1c41-4dea-9d66-076e2bc261aa"],"keyword":["Data accessibility","Data-driven services","Internet infrastructure","Open data interfaces","Participatory design"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-16766B87DBBBC50C22843BEF2F223E4D"],"oa_link":[{"access":"oa","license":"CC BY-ND","type":"loc","url":"https://pure.itu.dk/ws/files/83630235/Data_as_Infrastructure_1.0.pdf","version":"Other Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Software Engineering, Software Engineering"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Yvonne","key":"dittrichpau","last":"Dittrich","locid":"f2136570-f73c-446f-9fb0-6d9e461e2124","name":"Dittrich, Yvonne","orcid":"0000-0003-4757-3394","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Cathrine","key":"seidelinpau","last":"Seidelin","name":"Seidelin, Cathrine","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Erik","key":"grönvallpau","last":"Grönvall","locid":"1e0534b4-fe3e-4c5e-ad6d-5f1c7df6a14e","name":"Grönvall, Erik","orcid":"0000-0002-7377-6091","rank":3,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-82e759e9-1c41-4dea-9d66-076e2bc261aa"],"src":["ITU IT University of Copenhagen"],"title":"Data as Infrastructure – Infrastructuring for Data Analytics","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383190","year":"2018","yearsub":"2018"}
