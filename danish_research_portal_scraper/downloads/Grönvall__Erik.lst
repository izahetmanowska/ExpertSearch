:"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","The Department, People and Computational Things"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Nervo","key":"verdezotopau","last":"Verdezoto","name":"Verdezoto, Nervo","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Francisco","key":"nunespau","last":"Nunes","name":"Nunes, Francisco","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Geraldine","key":"fitzpatrickpau","last":"Fitzpatrick","name":"Fitzpatrick, Geraldine","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Erik","key":"gronvallpau","last":"Gronvall","locid":"1e0534b4-fe3e-4c5e-ad6d-5f1c7df6a14e","name":"Grönvall, Erik","name_org":"Gronvall, Erik","orcid":"0000-0002-7377-6091","rank":4,"rolecode":"pau"}],"pub":{"issn":["18269745","22832998"],"issn_org":["18269745"],"issue":"Winter 2014","journal":"Interaction Design and Architecture","pages":"140-141","publisher":"Interaction Design and Architecture(s)","status":"p","title":"Interaction Design and Architecture","title_org":"Interaction Design & Architecture(s)","volume":"23"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-adc2a286-2eb9-40b2-9c32-79a749d971dd"],"src":["ITU IT University of Copenhagen"],"title":"Preface to the Focus Section : Designing Self-Care For Everyday Life","type":"Editorial","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383790","year":"2015","yearsub":"2015"}
{"abstract":"In this paper, we analyse the challenges of working between organizations and established information infrastructures. The Care Hotel is a municipal healthcare facility where persons, typically following a hospital stay, undergo rehabilitation to enable them to live independently at home. Admission, stay, and discharge from the Care Hotel entail numerous coordination activities with a variety of frequent and sporadic, heterogeneous, external collaborators, including general practitioners, relatives, and hospitals, some of which are already part of large information infrastructures, whereas others are too small or shifting to allow for stable arrangements. Hence, work at the Care Hotel may be characterized as \"collaboration in-between\". We propose a design solution for flexible use to further stimulate reflection on design implications, and how to meet the challenges of collaboration in-between. As large infrastructures continue to develop, we posit that many \"in-between settings\" will encounter similar challenges to collaboration. Healthcare providers in contexts of fragmented healthcare are also likely to face such challenges.","author_count":2,"contributors":["Bossen, Claus","Grönvall, Erik"],"cuid":["S02-082.41-024976"],"event":{"acronym":"CSCW","title":"ACM Conference on Computer Supported Cooperative Work"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Flexible Design Solutions","Healthcare Coordination","Healthcare IT","Information infrastructures","Infrastructuring","Inter organizational collaboration","Rehabilitation Services","Transitional care"],"level":"sci","mra":["hum","sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-ITU"]},"level3all":["DI-U-AU","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"collaboration in between the care hotel and designing for flexible use the care hotel and designing for flexible use","src":["au","itu"],"src-code":["DI-U-AU","DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1145/2675133.2675243","version":"Other Version"},"id":"S02-082.41-024976","identifier":[{"id":"84963619167","type":"scopus"}],"ids":["au-a8a8d596-bd05-41fd-8e0f-2b96b2405805","itu-bd3bd29f-bfec-41b2-86d8-8d4f2775a5bf"],"keyword":["Cross-organizational work","Flexible Design Solutions","Healthcare Coordination","Healthcare IT","Information Infrastructures","Inter-organizational Collaboration","Rehabilitation Services","collaboration in-between","infrastructuring","transitional care"],"lang":"English","level":"Scientific","mra":["Humanities","Science/Technology"],"noi":["Global-Local-2-5-7DF23859AD47DE2CA9EBD1CB9693E381"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1145/2675133.2675243","version":"Other Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Arts, School of Communication and Culture, School of Communication and Culture - Information Science"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","The Department, People and Computational Things"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Claus","key":"bossenpau","last":"Bossen","locid":"f989b328-ea2e-4b6f-b6c5-90d61465d153","name":"Bossen, Claus","orcid":"0000-0002-3698-0675","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Erik","key":"gronvallpau","last":"Gronvall","locid":"1e0534b4-fe3e-4c5e-ad6d-5f1c7df6a14e","name":"Grönvall, Erik","name_org":"Gronvall, Erik","orcid":"0000-0002-7377-6091","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1145/2675133.2675243","isbn":["9781450329224"],"pages":"1289-1301","publisher":"Association for Computing Machinery","series":"ACM Conference on Computer-Supported Cooperative Work and Social Computing","status":"p","subtitle":"CSCW '15","title":"Proceedings of the 18th ACM Conference on Computer Supported Cooperative Work &amp; Social Computing"},"review":"Peer Reviewed","scoID":["2-s2.0-84963619167"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["au-a8a8d596-bd05-41fd-8e0f-2b96b2405805","itu-bd3bd29f-bfec-41b2-86d8-8d4f2775a5bf"],"src":["AU Aarhus University","ITU IT University of Copenhagen"],"title":"Collaboration in-between The Care Hotel and Designing for Flexible Use : The Care Hotel and Designing for Flexible Use","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-082.41-024976","year":"2015","yearsub":"2015"}
{"abstract":"Many studies show that self-care technologies can support patients with chronic conditions and their carers in understanding the ill body and increasing control of their condition. However, many of these studies have largely privileged a medical perspective and thus overlooked how patients and carers integrate self-care into their daily lives and mediate their conditions through technology. In this review, we focus on how patients and carers use and experience self-care technology through a Human-Computer Interaction (HCI) lens. We analyse studies of self-care published in key HCI journals and conferences using the Grounded Theory Literature Review (GTLR) method and identify research trends and design tensions. We then draw out opportunities for advancing HCI research in self-care, namely, focusing further on patients’ everyday life experience, considering existing collaborations in self-care, and increasing the influence on medical research and practice around self-care technology.","author_count":6,"contributors":["Nunes, Francisco","Verdezoto, Nervo","Fitzpatrick, Geraldine","Kyng, Morten","Grönvall, Erik","Storni, Cristiano"],"cuid":["S02-095.71-025598"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","OECD"],"country":["Austria","Ireland"],"glorg":["All Global Affiliations","University of Limerick","Vienna University of Technology"],"keyword":["Chronic conditions","Chronic diseases","Grounded Theory Literature Review GTLR","Home care","Home monitoring","Human Computer Interaction HCI","Literature review","Patient experience","Pervasive health","Self Care","Self care technology","Self management","Telecare","Telehealth"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-ITU"]},"level3all":["DI-U-AU","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sor