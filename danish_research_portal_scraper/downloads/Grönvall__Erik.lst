enmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","The Department, People and Computational Things"],"nora_code":"DI-U-ITU","used":1},{"affno":"4","country":"ie","key":"university of limerick","loc":["Ireland","Europe, EU","OECD"],"name":"University of Limerick","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Francisco","key":"nunespau","last":"Nunes","name":"Nunes, Francisco","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Nervo","key":"verdezotopau","last":"Verdezoto","locid":"ce629209-5619-4b43-88fb-b8fd03725adb","name":"Verdezoto, Nervo","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Geraldine","key":"fitzpatrickpau","last":"Fitzpatrick","name":"Fitzpatrick, Geraldine","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Morten","key":"kyngpau","last":"Kyng","locid":"f0486b10-a937-4cd9-aa99-168060eea4fc","name":"Kyng, Morten","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Erik","key":"gronvallpau","last":"Gronvall","locid":"1e0534b4-fe3e-4c5e-ad6d-5f1c7df6a14e","name":"Grönvall, Erik","name_org":"Gronvall, Erik","orcid":"0000-0002-7377-6091","rank":5,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Cristiano","key":"stornipau","last":"Storni","name":"Storni, Cristiano","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1145/2803173","issn":["10730516","15577325"],"issn_org":["10730516"],"issue":"6","journal":"ACM Transactions on Computer-Human Interaction","paperid":"33","publisher":"Association for Computing Machinery","status":"p","title":"ACM Transactions on Computer-Human Interaction","title_org":"A C M Transactions on Computer - Human Interaction","volume":"22"},"review":"Peer Reviewed","scoID":["2-s2.0-84954118592"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen"