lecode":"pau"},{"affno":"6","corresponding":null,"first":"Shaun","key":"lawsonpau","last":"Lawson","name":"Lawson, Shaun","rank":7,"rolecode":"pau"},{"affno":"7","corresponding":null,"first":"Per","key":"lindepau","last":"Linde","name":"Linde, Per","rank":8,"rolecode":"pau"},{"affno":"8","corresponding":null,"first":"Joanna","key":"saadsulonenpau","last":"Saad-Sulonen","name":"Saad-Sulonen, Joanna","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Vasilis","key":"vlachokyriakospau","last":"Vlachokyriakos","name":"Vlachokyriakos, Vasilis","rank":10,"rolecode":"pau"}],"pub":{"doi":"10.1145/3656156.3658383","pages":"467-469","publisher":"Association for Computing Machinery","status":"p","title":"Companion Publication of the 2024 ACM Designing Interactive Systems Conference (DIS '24 Companion)"},"review":"Peer Reviewed","scoID":["2-s2.0-85198900774"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-78aa13f7-5150-4002-8315-a99a097fd890"],"src":["ITU IT University of Copenhagen"],"title":"Designing for and with the ‘Digital Citizen’. In Companion Publication of the 2024 ACM Designing Interactive Systems Conference (DIS '24 Companion). Association for Computing Machinery, New York, NY, USA, 467–469. https://doi.org/10.1145/3656156.3658383","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-747236","year":"2024","yearsub":"2024"}
{"abstract":"Municipalities around the world have become increasingly reliant upon digital technologies in their everyday operations. In pursuit of a faster, cheaper, and more efficient local government, service platforms and applications that mediate citizen-government interactions, smart city infrastructures, and automated decision-making systems have proliferated. More recently, digital technologies are also sought to address socially complex issues and foster civic engagement. These ambitions, motivated by both rational and democratic perspectives, however, confront many challenges such as designing with wide heterogeneous groups, navigating organizational structures, and dealing with the political agendas and conflicting perspectives of multiple stakeholders. Designing digital technologies for municipalities, therefore, requires an ability to address the technical, social, institutional, and political challenges critically, practically, and holistically. This hybrid workshop aims to bring together researchers and practitioners to (1) explore how this could be achieved and (2) map the existing and emerging challenges and opportunities for designing public digital services and technologies.","author_count":5,"contributors":["Boztepe, Suzan","Glöss, Mareike","Grönvall, Erik","Messeter, Jörn","Linde, Per"],"cuid":["S01-000.00-677325"],"event":{"acronym":"C&T","title":"International Conference on Communities and Technologies"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"country":["Sweden"],"glorg":["All Global Affiliations","Malmö University"],"keyword":["Civic engagement","Digital technologies","Municipal Governance","Public Digital Services","Smart cities"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"designing the city challenges and opportunities in digital public service design","src":["itu"],"src-code":["DI-U-ITU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://pure.itu.dk/ws/files/99321635/designingthecity_submitted.docx","version":"Pre-print"},"id":"S01-000.00-677325","identifier":[{"id":"85161410006","type":"scopus"}],"ids":["itu-a0b6f945-4156-4395-9ac4-e922436da592"],"keyword":["Civic Engagement","Digital Technologies","Municipal Governance","Public Digital Services","Smart Cities"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-AF0DA8150B8B1904809CE5EF08B9D09C"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://pure.itu.dk/ws/files/99321635/designingthecity_submitted.docx","version":"Pre-print"}],"org":[{"affno":"1","country":"se","key":"malmö university","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Malmö University","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Digital Design, Design Research Section","IT University of Copenhagen, Human-Computer Interaction and Design, Co-Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Suzan","key":"boztepepau","last":"Boztepe","name":"Boztepe, Suzan","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mareike","key":"glösspau","last":"Glöss","name":"Glöss, Mareike","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Erik","key":"grönvallpau","last":"Grönvall","locid":"1e0534b4-fe3e-4c5e-ad6d-5f1c7df6a14e","name":"Grönvall, Erik","orcid":"0000-0002-7377-6091","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jörn","key":"christianssonpau","last":"Christiansson","locid":"a4c1604d-b01f-46ef-baf3-74d2a8046d6b","name":"Messeter, Jörn","name_org":"Christiansson, Jörn","orcid":"0000-0002-2181-149X","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Per","key":"lindepau","last":"Linde","name":"Linde, Per","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1145/3593743.3593788","pages":"266-269","publisher":"Association for Computing Machinery","status":"p","subtitle":"Humanization of Digital Technologies","title":"C&amp;T '23: Proceedings of the 11th International Conference on Communities and Technologies"},"review":"Peer Reviewed","scoID":["2-s2.0-85161410006"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-a0b6f945-4156-4395-9ac4-e922436da592"],"src":["ITU IT University of Copenhagen"],"title":"Designing the City : Challenges and Opportunities in Digital Public Service Design","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-677325","year":"2023","yearsub":"2023"}
{"abstract":"The broad notion of communities required a fine-grained vocabulary to investigate how communities interact with digital technologies. We can identify various constructs in the literature, such as temporary groups, coalitions, movements, communities of practice, place, and interest, that can describe different collaborative configurations. Despite the diversity of concepts describing the formation of “collectives”, we still need to understand how the formation of collectives and communities emerges through collaboration. We propose a vocabulary to analyze emergent forms of collaboration and the appropriation of technologies over time. This paper focuses on emergent, spontaneous, or unplanned collaborations facilitated by digital technologies in response to changing circumstances or problems. To frame different types of emergent collaboration, we borrow three concepts from activity theory, urban planning, and educational psychology: knotworking, self-organization, and the formation of publics. The paper examines these concepts in detail and describes their history and how they relate to each other, highlighting their qualities, similarities, and differences. Using these concepts, the paper aims to increase awareness of the complexity of emergent collaboration and its challenges and help designers operate with a more dynamic understanding of collaborative work outside established organizational settings.","author_count":3,"contributors":["Abou Amsha, Khuloud","Grönvall, Erik","Saad-Sulonen, Joanna"],"cuid":["S01-000.00-677331"],"event":{"acronym":"C&T","title":"International Conference on Communities and Technologies"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["France"],"glorg":["All Global Affiliations","Troyes University of Technology"],"keyword":["Digital technologies","Emergent Collaboration","Formation of Publics","Knotworking","Self organization"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"emergent collaborations outside of organizational frameworks exploring relevant concepts","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://pure.itu.dk/ws/files/99320745/CT23_33_PDF.pdf","version":"Pre-print"},"id":"S01-000.00-677331","identifier":[{"id":"85161367269","type":"scopus"}],"ids":["itu-b5e04f1f-3ada-427f-8888-3ebe072d405d"],"keyword":["Digital Technologies","Emergent Collaboration","Formation of Publics","Knotworking","Self-Organization"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-8D290665F382C8D72D9D29B730EB2EBE"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://pure.itu.dk/ws/files/99320745/CT23_33_PDF.pdf","version":"Pre-print"}],"org":[{"affno":"1","country":"fr","key":"troyes university of technology","loc":["France","Europe, EU","OECD"],"name":"Troyes University of Technology","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Digital Design, Design Research Section","IT University of Copenhagen, Human-Computer Interaction and Design, Co-Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Khuloud","key":"abouamshapau","last":"Abou Amsha","name":"Abou Amsha, Khuloud","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Erik","key":"grönvallpau","last":"Grönvall","locid":"1e0534b4-fe3e-4c5e-ad6d-5f1c7df6a14e","name":"Grönvall, Erik","orcid":"0000-0002-7377-6091","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Joanna","key":"saadsulonenpau","last":"Saad-Sulonen","name":"Saad-Sulonen, Joanna","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1145/3593743.3593778","pages":"163-173","publisher":"Association for Computing Machinery","status":"p","title":"C&amp;T '23: Proceedings of the 11th International Conference on Communities and Technologies"},"review":"Peer Reviewed","scoID":["2-s2.0-85161367269"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-b5e04f1f-3ada-427f-8888-3ebe072d405d"],"src":["ITU IT University of Copenhagen"],"title":"Emergent Collaborations Outside of Organizational Frameworks: Exploring Relevant Concepts","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-677331","year":"2023","yearsub":"2023"}
{"abstract":"Health data cannot easily move from one healthcare provider to another, let alone between different countries. There is a de facto lack of health data interoperability in many healthcare systems preventing mobility and sharing of health data. Hitherto the literature has mainly considered technical aspects and challenges related to interoperability, but this paper will foremost explore semantic aspects. Using two cases of exploring data interoperability and the democratisation of health data as a backdrop, this paper presents existing challenges preventing sustainable health systems by focusing on semantic aspects of data interoperability in healthcare. A key finding is that data interoperability is possible and standardised data semantics are key resources to support data access within or across systems, for example between countries. The democratisation of health data, allowing different health systems to interact with each other, requires management of the shared semantic resources and the governance structures defining them. Domain experts, like medical doctors, can play an important role in co-designing and managing such shared, semantic resources.","author_count":2,"contributors":["Bestek, Mate","Grönvall, Erik"],"cuid":["S01-000.00-747229"],"event":{"acronym":"PervasiveHealth","title":"EAI International Conference on Pervasive Computing Technologies for Healthcare"},"filters":{"added":"2024-08","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"health data semantics exploring requirements for sustainable health systems","src":["itu"],"src-code":["DI-U-ITU"],"type":"dba","type-grp":["all","pub"]},"id":"S01-000.00-747229","ids":["itu-55abcd0a-1768-40d6-97a6-3d6c0284562a"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-63DEAC6E4184C704E59C3A9C811172DC"],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Digital Design, Design Research Section","IT University of Copenhagen, Human-Computer Interaction and Design, Co-Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Mate","key":"bestekpau","last":"Bestek","name":"Bestek, Mate","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Erik","key":"grönvallpau","last":"Grönvall","locid":"1e0534b4-fe3e-4c5e-ad6d-5f1c7df6a14e","name":"Grönvall, Erik","orcid":"0000-0002-7377-6091","rank":2,"rolecode":"pau"}],"pub":{"pages":"1-16","publisher":"European Alliance for Innovation","status":"p","title":"EAI PervasiveHealth 2022 - 16th EAI International Conference on Pervasive Computing Technologies for Healthcare"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-55abcd0a-1768-40d6-97a6-3d6c0284562a"],"src":["ITU IT University of Copenhagen"],"title":"Health data semantics: Exploring requirements for sustainable health systems","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-747229","year":"2022","yearsub":"2022"}
{"abstract":"Commons and commoning are of increasing interest to the PD community. We argue that off-the-shelf digital commons can be used in the context of PD to support groups in their commoning practices. This approach presents some advantages: it allows focusing resources on participation rather than software development and it fosters sustainability of results when researchers leave. But how do we understand whether an off-the-shelf tool can be considered a commons or not? Where do we find digital commons? How do we select them? In this paper, we will try to answer these questions by proposing theoretical considerations and practical criteria based on the reflexive account of a case study in Europe.","author_count":13,"contributors":["Bettega, Mela","Masu, Raul","Hansen, Nicolai Brodersen","Teli, Maurizio"],"cuid":["S01-000.00-052578"],"event":{"end":"2022-09-01","place":"Newcastle upon Tyne, gb","start":"2022-08-19","title":"Participatory Design Conference 2022","year":"2022"},"filters":{"added":"2022-10","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Asia, South","Europe, EU","OECD"],"country":["Portugal","Thailand"],"glorg":["All Global Affiliations","King Mongkut's Institute of Technology Ladkrabang","NOVA University Lisbon"],"keyword":["Adoption","Digital Commons","Off the shelf","Sustainability"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"off the shelf digital tools as a resource to nurture the commons","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/483966535/3536169.3537787.pdf","version":"Authors Final Version"},"id":"S01-000.00-052578","identifier":[{"id":"85134497681","type":"scopus"}],"ids":["aau-08af19a8-1963-4690-9f01-4e4c1dd6a522"],"keyword":["adoption","digital commons","off-the-shelf","sustainability"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-E33172B7DAD3B678C56C26C50E03F7FA"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/483966535/3536169.3537787.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","country":"pt","key":"nova university lisbon","loc":["Portugal","Europe, EU","OECD"],"name":"NOVA University Lisbon","used":1},{"affno":"2","country":"th","key":"king mongkut s institute of technology ladkrabang","loc":["Thailand","Asia, South"],"name":"King Mongkut's Institute of Technology Ladkrabang","used":1},{"affno":"3","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Technical Faculty of IT and Design","Aalborg University, The Technical Faculty of IT and Design, Department of Computer Science","Aalborg University, The Technical Faculty of IT and Design, Department of Computer Science, Human-Centered Computing"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Mela","key":"bettegapau","last":"Bettega","name":"Bettega, Mela","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Raul","key":"masupau","last":"Masu","name":"Masu, Raul","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Nicolai Brodersen","key":"hansenpau","last":"Hansen","locid":"ce7632d8-4bab-4bde-a531-9581f71ee214","name":"Hansen, Nicolai Brodersen","orcid":"0000-0003-2187-0104","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Maurizio","key":"telipau","last":"Teli","locid":"3fb25d29-be2b-4845-85fc-b192d8a5af29","name":"Teli, Maurizio","orcid":"0000-0002-6654-1788","rank":4,"rolecode":"pau"},{"affno":"","first":"Vasilis"