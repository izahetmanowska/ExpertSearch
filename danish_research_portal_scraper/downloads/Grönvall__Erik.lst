{"abstract":"This paper addresses methodological considerations of participation in design for ageing. Based on the notions of design culture, communities of everyday practice and situated elderliness we present accounts from two settings and discuss methodological issues related to mobilizing senior citizens in co-design work.","author_count":5,"contributors":["Malmborg, Lone","Werner, Katharina","Grönvall, Erik","Messeter, Jörn","Raben, Thomas"],"cuid":["S01-000.00-381898"],"event":{"acronym":"MobileHCI","title":"International Conference on Human-Computer Interaction with Mobile Devices and Services"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Austria"],"glorg":["All Global Affiliations","Vienna University of Technology"],"keyword":["Ageing","Co design","Communities of practice","Design Culture","Participation in Design"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Frederiksberg kommune"],"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"mobilizing senior citizens in co design work","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84962849991","version":"Other Version"},"id":"S01-000.00-381898","identifier":[{"id":"84962849991","type":"scopus"}],"ids":["itu-29fe9b32-bc9b-42d4-b94b-838ea3f0a1ec"],"keyword":["Ageing","Co-Design","Communities of Practice","Design Culture","Participation in Design"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-B8ABAA098D3423AD30F9157CCAAEDA50"],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["De