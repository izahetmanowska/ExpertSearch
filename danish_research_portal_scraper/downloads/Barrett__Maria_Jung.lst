{"author_count":4,"contributors":["Jakobsen, Terne Sasha Thorn","Barrett, Maria Jung","Søgaard, Anders","Lassen, David Dreyer"],"cuid":["S01-000.00-384672"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-KU"]},"level3all":["DI-U-ITU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"the sensitivity of annotator bias to task definitions in argument mining","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://aclanthology.org/2022.law-1.6.pdf","version":"Authors Final Version"},"id":"S01-000.00-384672","identifier":[{"id":"85146041801","type":"scopus"}],"ids":["itu-e73576c1-5ee1-471f-873b-8e260c1c6a62"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-071C371667B68F3C545C3790D67AF791"],"oa_link":[{"access":"oa","type":"rem","url":"https://aclanthology.org/2022.law-1.6.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, NLPnorth"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Terne Sasha Thorn","key":"jakobsenpau","