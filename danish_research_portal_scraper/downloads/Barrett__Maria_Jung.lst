isepau","last":"White","name":"White, Rachel Louise","rank":301,"rolecode":"pau"},{"affno":"66","corresponding":null,"first":"David William","key":"wolfsondavidwilliampau","last":"Wolfson","name":"Wolfson, David William","rank":302,"rolecode":"pau"},{"affno":"200","corresponding":null,"first":"Andrew","key":"woodandrewpau","last":"Wood","name":"Wood, Andrew","rank":303,"rolecode":"pau"},{"affno":"201","corresponding":null,"first":"Scott W.","key":"yancoscottwpau","last":"Yanco","name":"Yanco, Scott W.","rank":304,"rolecode":"pau"},{"affno":"168","corresponding":null,"first":"Jian D.L.","key":"yenjiandlpau","last":"Yen","name":"Yen, Jian D.L.","rank":305,"rolecode":"pau"},{"affno":"202","corresponding":null,"first":"Casey","key":"youngfleshcaseypau","last":"Youngflesh","name":"Youngflesh, Casey","rank":306,"rolecode":"pau"},{"affno":"56","corresponding":null,"first":"Giacomo","key":"ziliogiacomopau","last":"Zilio","name":"Zilio, Giacomo","rank":307,"rolecode":"pau"},{"affno":"203","corresponding":null,"first":"Cédric","key":"zimmercédricpau","last":"Zimmer","name":"Zimmer, Cédric","rank":308,"rolecode":"pau"},{"affno":"204","corresponding":null,"first":"Gregory Mark","key":"zimmermangregorymarkpau","last":"Zimmerman","name":"Zimmerman, Gregory Mark","rank":309,"rolecode":"pau"},{"affno":"72","corresponding":null,"first":"Rachel A.","key":"zitomerrachelapau","last":"Zitomer","name":"Zitomer, Rachel A.","rank":310,"rolecode":"pau"}],"pmid":["39915771"],"pub":{"doi":"10.1186/s12915-024-02101-x","issn":["14754924","17417007"],"issn_org":["17417007"],"issue":"1","journal":"BMC Biology","paperid":"35","publisher":"BioMed Central","status":"p","title":"BMC Biology","volume":"23"},"review":"Peer Reviewed","scoID":["2-s2.0-85218290951"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-56fb5558-6430-4fa2-85de-d9b44e6f9f56"],"src":["AU Aarhus University"],"title":"Same data, different analysts : variation in effect sizes due to analytical decisions in ecology and evolutionary biology","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-796205","year":"2025","yearsub":"2025"}
{"abstract":"Facial mimicry—the automatic, unconscious imitation of others' expressions—is vital for emotional understanding. This study investigates how mimicry differs across emotions using Face Action Units from videos and participants' responses. Dynamic Time Warping quantified the temporal alignment between participants' and stimuli's facial expressions, revealing significant emotional variations. Post-hoc tests indicated greater mimicry for 'Fear' than 'Happy' and reduced mimicry for 'Anger' compared to 'Fear'. The mimicry correlations with personality traits like Extraversion and Agreeableness were significant, showcasing subtle yet meaningful connections. These findings suggest specific emotions evoke stronger mimicry, with personality traits playing a secondary role in emotional alignment. Notably, our results highlight how personality-linked mimicry mechanisms extend beyond interpersonal communication to affective computing applications, such as remote human-human interactions and human-virtual-agent scenarios. Insights from temporal facial mimicry—e.g., designing digital agents that adaptively mirror user expressions—enable developers to create empathetic, personalized systems, enhancing emotional resonance and user engagement.","author_count":4,"contributors":["Seikavandi, Meisam Jamshidi","Fimland, Jostein","Barrett, Maria Jung","Burelli, Paolo"],"cuid":["S01-000.00-828172"],"filters":{"added":"2025-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Affective Computing","Dynamic Time Warping","Facial mimicry","Personality traits"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"exploring the temporal dynamics of facial mimicry in emotion processing using action units","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.48550/arXiv.2503.17306","version":"Authors Final Version"},"id":"S01-000.00-828172","ids":["itu-acb09860-e19d-472a-9d1a-6764e02efa5c"],"keyword":["Affective computing","Dynamic Time Warping","Facial Action Units","Facial mimicry","Personality traits"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-8112E3C9BE96D0A3D9611C78A3F2E46B"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.48550/arXiv.2503.17306","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Data Science, Machine Learning","IT University of Copenhagen, Play, Culture, and AI"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Meisam Jamshidi","key":"seikavandipau","last":"Seikavandi","locid":"0080607f-9f26-4f73-a974-36b4940fb777","name":"Seikavandi, Meisam Jamshidi","orcid":"0000-0002-1271-2481","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jostein","key":"fimlandpau","last":"Fimland","name":"Fimland, Jostein","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Maria Jung","key":"barrettpau","last":"Barrett","name":"Barrett, Maria Jung","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Paolo","key":"burellipau","last":"Burelli","locid":"cf5e1d64-5489-4534-ba34-8dba5fd354a6","name":"Burelli, Paolo","orcid":"0000-0003-2804-9028","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.48550/arxiv.2503.17306","publisher":"IEEE","series":"IEEE International Conference on Automatic Face and Gesture","status":"p","title":"2025 IEEE International Conference on Automatic Face and Gesture"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-acb09860-e19d-472a-9d1a-6764e02efa5c"],"src":["ITU IT University of Copenhagen"],"title":"Exploring the Temporal Dynamics of Facial Mimicry in Emotion Processing Using Action Units","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-828172","year":"2025","yearsub":"2025"}
{"abstract":"Face Emotion Recognition (FER) is a foundational human skill crucial for social interactions and understanding others' mental states. The use of eye tracking as a tool for investigating FER has provided valuable insights into the underlying cognitive processes. In this study, we adopted an instructionless paradigm, collecting eye movement data from 21 participants to explore two distinct FER processes: free viewing and grounded FER. We extracted fixational, pupillary, and microsaccadic events from eye movements and demonstrated their correlation with emotion perception and individual participant performance in the grounded task. By defining regions of interest on the face, we delved into the role of eye-gaze strategies in face processing and its connection to the presented emotions and emotion perception performance. During the free viewing phase, participants revealed distinct attention patterns for the different emotions. In the grounded FER tasks, participants interpreted emotions based on words, allowing for the assessment of performance and context. Interestingly, the participants' gaze patterns during free viewing were predictive of their success in the grounded FER tasks, emphasizing the importance of initial gaze behavior in emotion perception. We leveraged features from pre-trained deep-learning models for face recognition to analyze attention during free viewing, enhancing scalability and comparability across datasets and populations. This approach also enabled the prediction and modeling of individual emotion perception performance from limited observations. Our study contributes to a deeper understanding of the relationship between eye movements and emotion perception, with implications for psychology, human-computer interaction, and affective computing. Furthermore, it opens avenues for the development of precise emotion recognition systems.","author_count":3,"contributors":["Seikavandi, Meisam Jamshidi","Barrett, Maria Jung","Burelli, Paolo"],"cuid":["S01-000.00-789566"],"filters":{"added":"2025-02","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Eye tracking","Face Emotion Recognition","Gaze","Human Computer Interaction"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"modeling face emotion perception from naturalistic face viewing insights from fixational events and gaze strategies","src":["itu"],"src-code":["DI-U-ITU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/107930553/DL_Book_Chapter.pdf","version":"Pre-print"},"id":"S01-000.00-789566","ids":["itu-a5116a6f-5baf-4130-8314-2b6b2eafea80"],"keyword":["Eye Tracking","Face Emotion Recognition","Gaze","Human Computer Interaction"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-B2A2EFDE1DB8CE532A477A6F33EB82DD"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/107930553/DL_Book_Chapter.pdf","version":"Pre-print"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Play, Culture, and AI, brAIn lab"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Meisam Jamshidi","key":"seikavandipau","last":"Seikavandi","locid":"0080607f-9f26-4f73-a974-36b4940fb777","name":"Seikavandi, Meisam Jamshidi","orcid":"0000-0002-1271-2481","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Maria Jung","key":"barrettpau","last":"Barrett","locid":"ffc6db77-95ed-452f-92ac-ca143a9db73c","name":"Barrett, Maria Jung","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Paolo","key":"burellipau","last":"Burelli","locid":"cf5e1d64-5489-4534-ba34-8dba5fd354a6","name":"Burelli, Paolo","orcid":"0000-0003-2804-9028","rank":3,"rolecode":"pau"}],"pub":{"isbn":["9781032944623"],"publisher":"Taylor & Francis","status":"p","subtitle":"New Techniques and Practical Examples","title":"Recent Advances in Deep Learning Applications","volume":"1"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-a5116a6f-5baf-4130-8314-2b6b2eafea80"],"src":["ITU IT University of Copenhagen"],"title":"Modeling Face Emotion Perception from Naturalistic Face Viewing: Insights from Fixational Events and Gaze Strategies","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-789566","year":"2024","yearsub":"2024"}
{"abstract":"Textual domain is a crucial property within the Natural Language Processing (NLP) community due to its effects on downstream model performance. The concept itself is, however, loosely defined and, in practice, refers to any non-typological property, such as genre, topic, medium or style of a document. We investigate the core notion of domains via the human proficiency in identifying related intrinsic textual properties, specifically the concepts of genre (communicative purpose) and topic (subject matter), and publish our annotations in TGeGUM: A collection of 9.1k sentences from the GUM dataset (Zeldes, 2017) with single sentence and larger context (i.e., prose) annotations for one of 11 genres (source type), and its topic/subtopic as per the Dewey Decimal library classification system (Dewey, 1979), consisting of 10/100 hierarchical topics of increased granularity. Each instance is annotated by three annotators, for a total of 32.7k annotations, allowing us to examine the level of human disagreement and the relative difficulty of each annotation task. With a Fleiss’ kappa of at most 0.53 on the sentence level and 0.66 at the prose level, it is evident that despite the ubiquity of domains in NLP, there is actually little human consensus on how to define them. By training classifiers to perform the same task, we find that this uncertainty also extends to NLP models.","author_count":6,"contributors":["Barrett, Maria","Müller-Eberstein, Max","Bassignana, Elisa","Pauli, Amalie Brogaard","Zhang, Mike","van der Goot, Rob"],"cuid":["S02-094.66-741398"],"event":{"end":"2024-05-25","place":"Torino, it","start":"2024-05-20","title":"LREC-COLING 2024","year":"2024"},"filters":{"added":"2024-05","altsrc":["No Matches Found"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","Nordic","OECD"],"country":["Finland"],"glorg":["All Global Affiliations","Silo AI"],"keyword":["DOMAIN","Genre","Topic","multi annotation"],"level":