ia Jung","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Marina","key":"björnsdóttirpau","last":"Björnsdóttir","name":"Björnsdóttir, Marina","rank":3,"rolecode":"pau"}],"pub":{"pages":"1712-1720","place":"Marseille, France","publisher":"European Language Resources Association","status":"p","title":"Proceedings of the Thirteenth Language Resources and Evaluation Conference"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["itu-54feda49-0fee-422d-92bf-44a1204108c7","ku-29026734-bc08-4510-a34e-c02a50a39429"],"src":["ITU IT University of Copenhagen","KU University of Copenhagen"],"title":"The Copenhagen Corpus of Eye Tracking Recordings from Natural Reading of Danish Texts","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-087.98-038301","year":"2022","yearsub":"2022"}
{"abstract":"Recent work in cross-topic argument mining attempts to learn models that generalise across topics rather than merely relying on within-topic spurious correlations. We examine the effectiveness of this approach by analysing the output of single-task and multi-task models for cross-topic argument mining, through a combination of linear approximations of their decision boundaries, manual feature grouping, challenge examples, and ablations across the input vocabulary. Surprisingly, we show that cross-topic models still rely mostly on spurious correlations and only generalise within closely related topics, e.g., a model trained only on closed-class words and a few common open-class words outperforms a state-of-the-art cross-topic model on distant target topics.","author_count":3,"contributors":["Jakobsen, Terne Sasha Thorn","Barrett, Maria","Søgaard, Anders"],"cuid":["S02-087.55-038306"],"event":{"end":"2021-08-06","place":"Online","start":"2021-08-05","title":"Tenth Joint Conference on Lexical and Computational Semantics - SEM 2021","year":"2021"},"filters":{"added":"2022-04","altsrc":["No Matches Found"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Linear approximations","cross topic argument mining","input vocabulary ablations","multi task models","spurious correlations"],"level":"sci","mra":["sci","soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-KU"]},"level3all":["DI-U-ITU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"spurious correlations in cross topic argument mining","src":["itu","ku"],"src-code":["DI-U-ITU","DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.18653/v1/2021.starsem-1.25","version":"Published Version"},"id":"S02-087.55-038306","identifier":[{"id":"85117978163","type":"scopus"}],"ids":["itu-570ddab9-2881-4aca-8395-6adfd7714b9b","ku-95458fc0-bc32-4c1a-8bc9-224068252985"],"keyword":["cross-topic argument mining","input vocabulary ablations","linear approximations","multi-task models","spurious correlations"],"lang":"English","level":"Scientific","mra":["Science/Technology","Social Science"],"noi":["Global-Local-2-3-DE5CCE7A680D3ED2FBB875D60D293593"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.18653/v1/2021.starsem-1.25","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/300082793/Spurious_Correlations_in_Cross_Topic_Argument_Mining.pdf","version":"Published Version"},{"access":"oa","type":"rem","url":"https://aclanthology.org/2021.starsem-1.25.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Social Sciences, Faculty of Social Sciences, shared expenditure, Copenhagen Center for Social Data Science (SODAS)","Københavns Universitet, Faculty of Social Sciences, Faculty of Social Sciences, shared expenditure, Social Data Science"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, NLPnorth"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","first":"Terne Sasha","key":"thornjakobsenpau","last":"Thorn Jakobsen","locid":"551b3a30-c5fb-4e4e-8251-b36deef0f89e","name":"Jakobsen, Terne Sasha Thorn","name_org":"Thorn Jakobsen, Terne Sasha","orcid":"0000-0002-3124-1320","rank":1,"rolecode":"pau"},{"affno":"2"