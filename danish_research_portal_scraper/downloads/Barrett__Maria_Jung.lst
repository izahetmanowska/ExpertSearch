u","last":"Zielińska","name":"Zielińska, Anita","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Maria Jung","key":"barrettpau","last":"Barrett","locid":"ffc6db77-95ed-452f-92ac-ca143a9db73c","name":"Barrett, Maria Jung","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rob","key":"vandergootpau","last":"van der Goot","locid":"8e5f2a6c-c817-4a90-b48b-d9171743ad0f","name":"van der Goot, Rob","orcid":"0009-0003-1999-4156","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.18653/v1/2023.acl-srw.26","pages":"152-159","status":"p","title":"Proceedings of the 61st Annual Meeting of the Association for Computational Linguistics (Volume 4: Student Research Workshop)"},"review":"Peer Reviewed","scoID":["2-s2.0-85173460461"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-08b74e2b-f8b5-44c3-8c67-948c6c392eb7"],"src":["ITU IT University of Copenhagen"],"title":"Native Language Prediction from Gaze: a Reproducibility Study","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-695220","year":"2023","yearsub":"2023"}
{"abstract":"Dyslexia screening in adults is an open challenge since difficulties may not align with standardised tests designed for children. We collect eye-tracking data from natural reading of Danish texts from readers with dyslexia while closely following the experimental design of a corpus of readers without dyslexia. Research suggests that the opaque orthography of the Danish language affects the diagnostic characteristics of dyslexia. To the best of our knowledge, this is the first attempt to classify dyslexia from eye movements during reading in Danish. We experiment with various machine-learning methods, and our best model yields 0.85 F1 score.","author_count":3,"contributors":["Björnsdóttir, Marina","Hollenstein, Nora","Barrett, Maria Jung"],"cuid":["S01-000.00-695264"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Adult Dyslexia","Dyslexia Screening","Eye tracking","Machine learning","Natural Reading"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-KU"]},"level3all":["DI-U-ITU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"dyslexia prediction from natural reading of danish texts","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://aclanthology.org/2023.nodalida-1.7.pdf","version":"Published Version"},"id":"S01-000.00-695264","identifier":[{"id":"85187176261","type":"scopus"}],"ids":["itu-9045aa70-2d03-472e-89f2-d8768f9719be"],"keyword":["Adult Dyslexia","Dyslexia Screening","Eye-tracking","Machine Learning","Natural Reading"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-82D0323BB7289693B79D61B256820DA6"],"oa_link":[{"access":"oa","type":"rem","url":"https://aclanthology.org/2023.nodalida-1.7.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Marina","key":"björnsdóttirpau","last":"Björnsdóttir","name":"Björnsdóttir, Marina","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Nora","key":"hollensteinpau","last":"Hollenstein","name":"Hollenstein, Nora","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Maria Jung","key":"barrettpau","last":"Barrett","locid":"ffc6db77-95ed-452f-92ac-ca143a9db73c","name":"Barrett, Maria Jung","rank":3,"rolecode":"pau"}],"pub":{"pages":"60-70","status":"p","title":"Proceedings of the 24th Nordic Conference on Computational Linguistics (NoDaLiDa)"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["itu-9045aa70-2d03-472e-89f2-d8768f9719be"],"src":["ITU IT University of Copenhagen"],"title":"Dyslexia Prediction from Natural Reading of Danish Texts","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-695264","year":"2023","yearsub":"2023"}
