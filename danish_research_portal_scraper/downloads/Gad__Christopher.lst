schabathmatthewbpau","last":"Schabath","name":"Schabath, Matthew B.","rank":46,"rolecode":"pau"},{"affno":"36","first":"Melinda C.","key":"aldrichmelindacpau","last":"Aldrich","name":"Aldrich, Melinda C.","rank":47,"rolecode":"pau"},{"affno":"37","first":"Alpa","key":"patelalpapau","last":"Patel","name":"Patel, Alpa","rank":48,"rolecode":"pau"},{"affno":"23","first":"Xihong","key":"linxihongpau","last":"Lin","name":"Lin, Xihong","rank":49,"rolecode":"pau"},{"affno":"3","first":"Krista A.","key":"zanettikristaapau","last":"Zanetti","name":"Zanetti, Krista A.","rank":50,"rolecode":"pau"},{"affno":"3","first":"Curtis C","key":"harriscurtiscpau","last":"Harris","name":"Harris, Curtis C","rank":51,"rolecode":"pau"},{"affno":"3","first":"Stephen","key":"chanockstephenpau","last":"Chanock","name":"Chanock, Stephen","rank":52,"rolecode":"pau"},{"affno":"38","first":"James D","key":"mckayjamesdpau","last":"McKay","name":"McKay, James D","rank":53,"rolecode":"pau"},{"affno":"5 6","first":"Ann G.","key":"schwartzanngpau","last":"Schwartz","name":"Schwartz, Ann G.","rank":54,"rolecode":"pau"},{"affno":"39 40","first":"Rayjean J.","key":"hungrayjeanjpau","last":"Hung","name":"Hung, Rayjean J.","rank":55,"rolecode":"pau"},{"affno":"1 2","first":"Christopher I","key":"amoschristopheripau","last":"Amos","name":"Amos, Christopher I","rank":56,"rolecode":"pau"}],"pmid":["40341939"],"pub":{"doi":"10.1093/hmg/ddaf059","issn":["09646906","14602083"],"issn_org":["09646906"],"issue":"14","journal":"Human Molecular Genetics","pages":"1227-1237","status":"p","title":"Human Molecular Genetics","volume":"34"},"review":"Peer Reviewed","scoID":["2-s2.0-105010569347"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-3ee66c02-1bd8-4efa-8ff7-a852237b5cf2"],"src":["KU University of Copenhagen"],"title":"Genome-wide association study for lung cancer in 6531 African Americans reveals new susceptibility loci","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-828726","year":"2025","yearsub":"2025"}
{"abstract":"Background: Clinical, molecular, and genetic epidemiology studies displayed remarkable differences between ever- and never-smoking lung cancer. Methods: We conducted a stratified multi-population (European, East Asian, and African descent) association study on 44, 823 ever-smokers and 20, 074 never-smokers to identify novel variants that were missed in the non-stratified analysis. Functional analysis including expression quantitative trait loci (eQTL) colocalization and DNA damage assays, and annotation studies were conducted to evaluate the functional roles of the variants. We further evaluated the impact of smoking quantity on lung cancer risk for the variants associated with ever-smoking lung cancer. Results: Five novel independent loci, GABRA4, intergenic region 12q24.33, LRRC4C, LINC01088, and LCNL1 were identified with the association at two or three populations (P < 5 ͯ 10-8). Further functional analysis provided multiple lines of evidence suggesting the variants affect lung cancer risk through excessive DNA damage (GABRA4) or cis-regulation of gene expression (LCNL1). The risk of variants from 12 independent regions, including the well-known CHRNA5, associated with ever-smoking lung cancer was evaluated for never-smokers, light-smokers (packyear ≤ 20), and moderate-to-heavy-smokers (packyear > 20). Different risk patterns were observed for the variants among the different groups by smoking behavior. Conclusions: We identified novel variants associated with lung cancer in only ever- or never-smoking groups that were missed by prior main-effect association studies. Impact: Our study highlights the genetic heterogeneity between ever- and never-smoking lung cancer and provides etiologic insights into the complicated genetic architecture of this deadly cancer.","author_count":58,"contributors":["Li, Yafang","Xiao, Xiangjun","Li, Jianrong","Han, Younghun","Cheng, Chao","Fernandes, Gail F.","Slewitzke, Shannon E.","Rosenberg, Susan M.","Zhu, Meng","Byu