irst":"Huijue","key":"jiahuijuepau","last":"Jia","name":"Jia, Huijue","rank":40,"rolecode":"pau"},{"affno":"13 12","corresponding":null,"first":"Kunlun","key":"hekunlunpau","last":"He","name":"He, Kunlun","rank":41,"rolecode":"pau"},{"affno":"2 3 7 1","first":"Karsten","key":"kristiansenkarstenpau","last":"Kristiansen","locid":"941041b1-1b8f-4be5-9a65-5e98f662c07e","name":"Kristiansen, Karsten","orcid":"0000-0002-6024-0917","rank":42,"rolecode":"pau"}],"pmid":["29018189"],"pub":{"doi":"10.1038/s41467-017-00900-1","issn":["20411723"],"issue":"1","journal":"Nature Communications","paperid":"845","publisher":"Nature Research","status":"p","title":"Nature Communications","volume":"8"},"review":"Peer Reviewed","scoID":["2-s2.0-85031012310"],"sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-5c030443-cb4a-41bb-9990-d1f92c6f7ed6","ku-87ea155d-deab-458d-8307-1984751690fd"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"The gut microbiome in atherosclerotic cardiovascular disease","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-098.25-034679","year":"2017","yearsub":"2017"}
{"abstract":"Emerging evidence has linked the gut microbiome to human obesity. We performed a metagenome-wide association study and serum metabolomics profiling in a cohort of lean and obese, young, Chinese individuals. We identified obesity-associated gut microbial species linked to changes in circulating metabolites. The abundance of Bacteroides thetaiotaomicron, a glutamate-fermenting commensal, was markedly decreased in obese individuals and was inversely correlated with serum glutamate concentration. Consistently, gavage with B. thetaiotaomicron reduced plasma glutamate concentration and alleviated diet-induced body-weight gain and adiposity in mice. Furthermore, weight-loss intervention by bariatric surgery partially reversed obesity-associated microbial and metabolic alterations in obese individuals, including the decreased abundance of B. thetaiotaomicron and the elevated serum glutamate concentration. Our findings identify previously unknown links between intestinal microbiota alterations, circulating amino acids and obesity, suggesting that it may be possible to intervene in obesity by targeting the gut microbiota.","author_count":48,"contributors":["Liu, Ruixin","Hong, Jie","Xu, Xiaoqiang","Feng, Qiang","Zhang, Dongya","Gu, Yanyun","Shi, Juan","Zhao, Shaoqian","Liu, Wen","Wang, Xiaokai","Xia, Huihua","Liu, Zhipeng","Cui, Bin","Liang, Peiwen","Xi, Liuqing","Jin, Jiabin","Ying, Xiayang","Wang, Xiaolin","Zhao, Xinjie","Li, Wanyu","Jia, Huijue","Lan, Zhou","Li, Fengyu","Wang, Rui","Sun, Yingkai","Yang, Minglan","Shen, Yuxin","Jie, Zhuye","Li, Junhua","Chen, Xiaomin","Zhong, Huanzi","Xie, Hailiang","Zhang, Yifei","Gu, Weiqiong","Deng, Xiaxing","Shen, Baiyong","Xu, Xun","Yang, Huanming","Xu, Guowang","Bi, Yufang","Lai, Shenghan","Wang, Jian","Qi, Lu","Madsen, Lise","Wang, Jiqiu","Ning, Guang","Kristiansen, Karsten","Wang, Weiqing"],"cuid":["S01-000.00-538661"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_siz