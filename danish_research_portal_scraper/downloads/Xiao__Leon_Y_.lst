me":"Liu, Chun-Jen","rank":88,"rolecode":"pau"},{"affno":"75","corresponding":null,"first":"Fredrik","key":"åbergfredrikpau","last":"Åberg","name":"Åberg, Fredrik","rank":89,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"George","key":"laugeorgepau","last":"Lau","name":"Lau, George","rank":90,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jacob","key":"georgejacobpau","last":"George","name":"George, Jacob","rank":91,"rolecode":"pau"},{"affno":"76","corresponding":null,"first":"Shiv Kumar","key":"sarinshivkumarpau","last":"Sarin","name":"Sarin, Shiv Kumar","rank":92,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jing-Ya","key":"zhoujingyapau","last":"Zhou","name":"Zhou, Jing-Ya","rank":93,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Ming-Hua","key":"zhengminghuapau","last":"Zheng","name":"Zheng, Ming-Hua","rank":94,"rolecode":"pau"}],"pmid":["38878111"],"pub":{"doi":"10.1007/s12072-024-10702-5","issn":["19360533","19360541"],"issn_org":["19360533"],"issue":"4","journal":"Hepatology International","pages":"1178-1201","publisher":"Springer","status":"p","title":"Hepatology International","title_org":"Hepatology international","volume":"18"},"review":"Peer Reviewed","scoID":["2-s2.0-85196002868"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities"],"PST":["Published"]},"sid":["aau-b0669e92-3b96-4520-8e48-648ad49c7745","au-f65cf71b-6b35-465b-a456-c54052fb17c3"],"src":["AAU Aalborg University","AU Aarhus University"],"title":"A global survey on the use of the international classification of diseases codes for metabolic dysfunction-associated fatty liver disease","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-093.38-751619","year":"2024","yearsub":"2024"}
{"abstract":"Loot boxes in video games that provide random rewards in exchange for real-world money have been identified as gambling-like and potentially harmful. Many stakeholders are concerned. One regulatory approach is to label games with loot boxes with a presence warning. This has been adopted by the age rating organizations of Germany (the USK), North America (the ESRB), and Europe (PEGI). Previous research, by cross-checking the historical age rating decisions made by the ESRB and PEGI between April 2020 and September 2022, has identified mistakes where one or both organizations failed to label certain games with loot boxes as containing them. The USK only started identifying loot box presence from 2023 and so could not previously be studied. All age rating decisions concerning games with loot boxes made in 2023 by the USK, the ESRB, and PEGI were compared. This process identified how the USK has seemingly (i) failed to label two games as containing loot boxes and (ii) adopted an unspoken policy of giving games with loot boxes a USK 12 rating (i.e., ‘approved for children aged 12 and above’) at a minimum. Confirmation of the above has been sought from the USK, and an official reply has been promised and is expected imminently. In addition, the ESRB and PEGI have correctly labelled all games with loot boxes that they assessed in 2023 as containing them, thus giving the public more confidence in the reliability of their age rating information and demonstrating an improvement from their performance in previous years.","author_count":1,"contributors":["Xiao, Leon Y."],"cuid":["S01-000.00-759414"],"filters":{"added":"2024-10","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"keyword":["Consumer protection","Loot boxes","Video game law","Video games","Videogaming regulation"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"is loot box presence in video games being correctly and consistently labelled comparing all age rating decisions made by the german usk the american esrb and the european pegi in 000000002023","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.31219/osf.io/765zb","version":"Authors Final Version"},"id":"S01-000.00-759414","identifier":[{"id":"85199510006","type":"scopus"}],"ids":["itu-ab784e83-3e1d-4fc0-b544-28c67f145eff"],"keyword":["Consumer protection","Loot boxes","Video game law","Video games","Videogaming regulation"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-5C023D5A0FD145C3E0F031C38245FF9D"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.31219/osf.io/765zb","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Digital Play","IT University of Copenhagen, Digital Design","IT University of Copenhagen, Play, Culture, and AI, Games Research Group"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Leon Y.","key":"xiaopau","last":"Xiao","locid":"0a2a2206-180b-4443-bdb7-92deba889221","name":"Xiao, Leon Y.","orcid":"0000-0003-0709-0777","rank":1,"rolecode":"pau"}],"pub":{"doi":"10.31219/osf.io/765zb","publisher":"IEEE","status":"p","title":"Proceedings of 2024 IEEE Gaming, Entertainment, and Media Conference (GEM)"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-ab784e83-3e1d-4fc0-b544-28c67f145eff"],"src":["ITU IT University of Copenhagen"],"title":"Is loot box presence in video games being correctly and consistently labelled? Comparing all age rating decisions made by the German USK, the American ESRB, and the European PEGI in 2023","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-759414","year":"2024","yearsub":"2024"}
{"abstract":"Loot boxes can be bought with real-world money inside video games to obtain random items of varying value. Although these mechanics are gambling-like, they are widely available for purchase, including in children's games. Many countries are considering better regulation. The rapid regulatory and policy developments and proposals across the world in recent years are summarized: (i) probability disclosure requirements in Taiwan, South Korea, and China; (ii) enforcement of gambling law in Belgium, Austria, Finland, the Netherlands, France, the UK, and Australia; (iii) enforcement of EU consumer protection law in Italy, the Netherlands, and the UK; (iv) age ratings and warning labels in Germany, Australia, and the U.S.; (v) expanding the legal definition of “gambling” so as to encompass loot boxes in Finland and Brazil; (vi) the ambitious dedicated regulatory regime in Spain; (vii) class action civil litigation in the U.S. and Canada; (viii) industry self-regulation in the UK; and (ix) attempts to ban online games of chance in India.","author_count":1,"contributors":["Xiao, Leon Y."],"cuid":["S01-000.00-759416"],"filters":{"added":"2024-10","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"loot box state of play 000000002023 law regulation policy and enforcement around the world","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1089/glr2.2024.0006","version":"Published Version"},"id":"S01-000.00-759416","ids":["itu-b1393e33-c476-48f0-b82f-da73cf6b3ab3"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-3-4-264A7055C148B1A1EF66F74188289916"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.31219/osf.io/q2yv6","version":"Authors Final Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.itu.dk/ws/files/105965365/xiao-2024-loot-box-state-of-play-2023-law-regulation-policy-and-enforcement-around-the-world.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1089/glr2.2024.0006","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Digital Play","IT University of Copenhagen, Digital Design","IT University of Copenhagen, Play, Culture, and AI, Games Research Group"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Leon Y.","key":"xiaopau","last":"Xiao","locid":"0a2a2206-180b-4443-bdb7-92deba889221","name":"Xiao, Leon Y.","orcid":"0000-0003-0709-0777","rank":1,"rolecode":"pau"}],"pub":{"doi":"10.31219/osf.io/q2yv6","issn":["25725300"],"journal":"Gaming Law Review","publisher":"Mary Ann Liebert Inc.","publisher_org":"Mary Ann Liebert, Inc.","status":"p","title":"Gaming Law Review"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-b1393e33-c476-48f0-b82f-da73cf6b3ab3"],"src":["ITU IT University of Copenhagen"],"title":"LOOT BOX STATE OF PLAY 2023: LAW, REGULATION, POLICY, AND ENFORCEMENT AROUND THE WORLD","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-759416","year":"2024","yearsub":"2024"}
{"abstract":"BACKGROUND: Common metabolic diseases, such as type 2 diabetes mellitus (T2DM), hypertension, obesity, hypercholesterolemia, and metabolic dysfunction-associated steatotic liver disease (MASLD), have become a global health burden in the last three decades. The Global Burden of Disease, Injuries, and Risk Factors Study (GBD) data enables the first insights into the trends and burdens of these metabolic diseases from 1990 to 2021, highlighting regional, temporal and differences by sex. METHODS: Global estimates of disability-adjusted life years (DALYs) and deaths from GBD 2021 were analyzed for common metabolic diseases (T2DM, hypertension, obesity, hypercholesterolemia, and MASLD). Age-standardized DALYs (mortality) per 100,000 population and annual percentage change (APC) between 1990 and 2021 were estimated for trend analyses. Estimates are reported with uncertainty intervals (UI). RESULTS: In 2021, among five common metabolic diseases, hypertension had the greatest burden (226 million [95 % UI: 190-259] DALYs), whilst T2DM (75 million [95 % UI: 63-90] DALYs) conferred much greater disability than MASLD (3.67 million [95 % UI: 2.90-4.61]). The highest absolute burden continues to be found in the most populous countries of the world, particularly India, China, and the United States, whilst the highest relative burden was mostly concentrated in Oceania Island states. The burden of these metabolic diseases has continued to increase over the past three decades but has varied in the rate of increase (1.6-fold to 3-fold increase). The burden of T2DM (0.42 % [95 % UI: 0.34-0.51]) and obesity (0.26 % [95 % UI: 0.17-0.34]) has increased at an accelerated rate, while the rate of increase for the burden of hypertension (-0.30 % [95 % UI: -0.34 to -0.25]) and hypercholesterolemia (-0.33 % [95 % UI: -0.37 to -0.30]) is slowing. There is no significant change in MASLD over time (0.05 % [95 % UI: -0.06 to 0.17]). CONCLUSION: In the 21st century, common metabolic diseases are presenting a significant global health challenge. There is a concerning surge in DALYs and mortality associated with these conditions, underscoring the necessity for a coordinated global health initiative to stem the tide of these debilitating diseases and improve population health outcomes worldwide.","author_count":56,"contributors":["Zhang, Huai","Zhou, Xiao-Dong","Shapiro, Michael D","Lip, Gregory Y H","Tilg, Herbert","Valenti, Luca","Somers, Virend K","Byrne, Christopher D","Targher, Giovanni","Yang, Wah","Viveiros, Octavio","Opio, Christopher Kenneth","Mantzoros, Christos S","Ryan, John D","Kok, Kenneth Yuh Yen","Jumaev, Nozim Adxamovich","Perera, Nilanka","Robertson, Andrew Gerard","Abu-Abeid, Adam","Misra, Anoop","Wong, Yu Jun","Ruiz-Úcar, Elena","Ospanov, Oral","Kızılkaya, Mehmet Celal","Luo, Fei","Méndez-Sánchez, Nahum","Zuluaga, Mauricio","Lonardo, Amedeo","Al Momani, Hazem","Toro-Huamanchumo, Carlos Jesus","Adams, Leon","Al-Busafi, Said A","Sharara, Ala I","Chan, Wah-Kheong","Abbas, Syed Imran","Sookoian, Silvia","Treeprasertsuk, Sombat","Ocama, Ponsiano","Alswat, Khalid","Kong, Alice Pik-Shan","Ataya, Karim","Lim-Loo, Michelle Ching","Oviedo, Rodolfo J","Szepietowski, Olivia","Fouad, Yasser","Zhang, Huijie","Abdelbaki, Tamer N","Katsouras, Christos S","Prasad, Arun","Thaher, Omar","Ali, Arshad","Molina, Gabriel Alejandro","Sung, Ki-Chul","Chen, Qin-Fen","Lesmana, Cosmas Rinaldi Adithya","Zheng, Ming-Hua"],"cuid":["S01-000.00-757277"],"filters":{"added":"2024-10","altsrc":["Global Data"],"author_count":"51-200 contributors","cluster_size":1,"continent":["Africa","America, North","Asia, Central","Asia, East","Asia, Middle East","Asia, South","Europe, EU","Europe, Non-EU","OECD","Oceania"],"corresponding_author":["Zheng, Ming-Hua"],"country":["Australia","Austria","Canada","China","Egypt","Greece","Italy","Kazakhstan","Malaysia","Oman","Pakistan","Saudi Arabia","South Korea","Sri Lanka","Thailand","United Kingdom","United States","Uzbekistan"],"glorg":["Aga Khan University","All Global Affiliations","Astana Medical University","Central South University","Chulalongkorn University","Edith Cowan University","Harvard University","Innsbruck Medical University","King Saud University","Liverpool Centre for Cardiovascular Science","Liverpool Heart and Chest Hospital NHS Foundation Trust","Liverpool John Moores University","Mayo Clinic College of Medicine and Science","Minia University","Southern Medical University","Sultan Qaboos University","Sungkyunkwan University","Tashkent Medical Academy","The Chinese University of Hong Kong, Shenzhen","University of Ioannina","University of Liverpool","University of Malaya","University of Montreal","University of Southampton","University of Sri Jayewardenepura","University of Verona"],"keyword":["Global Burden of Disease","Metabolic Diseases","Metabolic dysfunction associated fatty liver disease","Metabolic dysfunction associated steatotic liver disease","Obesity"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"global burden of metabolic diseases 000000001990 000000002021","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85201690774&partnerID=8YFLogxK","version":"Other Version"},"funding_acknowledgement":["This paper was funded by grants from the National Natural Science Foundation of China (82070588, 82370577), National Key Research and Development Program of China (2023YFA1800801)."],"id":"S01-000.00-757277","identifier":[{"id":"39151887","type":"pmid"},{"id":"85201690774","type":"scopus"}],"ids":["aau-c89f2c0f-32a9-4514-a45c-b2c6ebad9eda"],"keyword":["Global Burden of Disease","Metabolic diseases","Metabolic dysfunction-associated fatty liver disease","Metabolic dysfunction-associated steatotic l