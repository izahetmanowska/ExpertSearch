me":"Ali, Arshad","rank":51,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Gabriel Alejandro","key":"molinagabrielalejandropau","last":"Molina","name":"Molina, Gabriel Alejandro","rank":52,"rolecode":"pau"},{"affno":"26","corresponding":null,"first":"Ki-Chul","key":"sungkichulpau","last":"Sung","name":"Sung, Ki-Chul","rank":53,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Qin-Fen","key":"chenqinfenpau","last":"Chen","name":"Chen, Qin-Fen","rank":54,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Cosmas Rinaldi Adithya","key":"lesmanacosmasrinaldiadithyapau","last":"Lesmana","name":"Lesmana, Cosmas Rinaldi Adithya","rank":55,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Ming-Hua","key":"zhengminghuapau","last":"Zheng","name":"Zheng, Ming-Hua","rank":56,"rolecode":"pau"}],"pmid":["39151887"],"pub":{"doi":"10.1016/j.metabol.2024.155999","issn":["00260495","15328600"],"issn_org":["00260495"],"journal":"Metabolism","paperid":"155999","publisher":"WB  Saunders","publisher_org":"W.B. Saunders","status":"p","title":"Metabolism","volume":"160"},"review":"Peer Reviewed","scoID":["2-s2.0-85201690774"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-c89f2c0f-32a9-4514-a45c-b2c6ebad9eda"],"src":["AAU Aalborg University"],"title":"Global burden of metabolic diseases, 1990-2021","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-757277","year":"2024","yearsub":"2024"}
{"abstract":"Loot boxes are gambling-like mechanics in video games that can be bought with real-world money to obtain random rewards. Regulators in many countries have considered whether different loot box implementations fall within the existing legal definition of ‘gambling.’ Most countries’ regulators say that only loot boxes (i) players spent real-world money to purchase and (ii) provide randomised content (iii) that possesses real-world monetary value (e.g., be transferable between players) legally constitute ‘gambling.’ A comprehensive review of Valve’s Steam platform for PC games identified 35 games, including some of the most popular games with hundreds of thousands of concurrent players, that implement paid loot boxes with transferable content worth real-world money. These would likely fall afoul of current gambling laws in many countries. Contrary to previous statements published by gambling regulators promising enforcement, consumers, policymakers, and other stakeholders should be aware of the existence and popularity of these presumably illegal loot boxes and how gambling law has not actually been enforced against them. The situation remained unchanged one year later. This longitudinal perspective demonstrates a continued state of non-compliance by game companies and non-enforcement by gambling regulators that leaves consumers unprotected and at risk of encountering illegal content and experiencing harm.","author_count":1,"contributors":["Xiao, Leon Y."],"cuid":["S01-000.00-759428"],"filters":{"added":"2024-10","altsrc":["Global Data"],"author_count":"1 contributor","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"illegal video game loot boxes with transferable content on steam a longitudinal study on their presence and non compliance with and non enforcement of gambling law","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1080/14459795.2024.2390827","version":"Published Version"},"id":"S01-000.00-759428","identifier":[{"id":"85202079780","type":"scopus"}],"ids":["itu-f51b3303-7720-4949-8e91-d20d2f96f436"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-2817FC0456BAB7A1FC2A28CC7862FEE5"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1080/14459795.2024.2390827","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.itu.dk/ws/files/106301344/10.1080_14459795.2024.2390827.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.31219/osf.io/taes2","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Digital Play","IT University of Copenhagen, Digital Design","IT University of Copenhagen, Play, Culture, and AI, Games Research Group"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Leon Y.","key":"xiaopau","last":"Xiao","locid":"0a2a2206-180b-4443-bdb7-92deba889221","name":"Xiao, Leon Y.","orcid":"0000-0003-0709-0777","rank":1,"rolecode":"pau"}],"pub":{"doi":"10.31219/osf.io/taes2","issn":["14459795","14794276"],"journal":"International Gambling Studies","publisher":"Taylor & Francis","status":"p","title":"International Gambling Studies"},"review":"Peer Reviewed","scoID":["2-s2.0-85202079780"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-f51b3303-7720-4949-8e91-d20d2f96f436"],"src":["ITU IT University of Copenhagen"],"title":"Illegal video game loot boxes with transferable content on Steam: a longitudinal study on their presence and non-compliance with and non-enforcement of gambling law","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-759428","year":"2024","yearsub":"2024"}
{"abstract":"Loot boxes can be bought with real-world money to obtain random content inside video games (Drummond and Sauer 2018). Loot boxes are viewed by many as gambling-like and are prevalently implemented globally (Xiao 2023; Xiao, Henderson, and Newall 2023; 2022; Zendle et al. 2020; 2022), including in the People’s Republic of China (PRC). Previous Western and international studies have consistently found loot box spending to be positively correlated with problem gambling (Zendle and Cairns 2018; Spicer et al. 2021; Garea et al. 2021). Previous Western studies presented mixed results as to the correlations between loot box purchasing and gambling-related risk factors, mental wellbeing, and psychological distress (Etchells, Morgan, and Quintana 2022; cf. Drummond, Hall, and Sauer 2022). A large-scale survey of adult video game players from Mainland China (N = 2,601) was conducted through Tencent Survey to assess the relationships between loot box spending and potential gambling-related risk factors and mental health. The positive correlations between loot box spending and problem gambling, and between loot box spending and problem videogaming, were successfully replicated. However, other potential risk factors (i.e., impulsivity/impulsiveness; binary past-year gambling participation status; and sensation-seeking tendencies) either did not positively correlate with loot box spending or only did so weakly. Contrary to expectations (see Garrett et al. 2023), high impulsivity was negatively associated with loot box engagement. The Risky Loot Box Index (RLI) (see Brooks and Clark 2019) most strongly positively correlated with, and was the best predictor in multiple linear regression models for, loot box spending. The RLI may be effective at measuring loot box harms cross-culturally (see Forsström et al. 2022). A surprising weak positive correlation was found between loot box engagement and PRC players’ mental wellbeing, and high psychological distress unexpectedly negatively predicted loot box purchasing. No evidence was found that loot box engagement correlated negatively with mental wellbeing or positively with psychological distress amongst PRC video game players. In fact, there was weak support for the opposite. The practical harms of engaging with loot boxes (if any) need further elucidation. Cross-cultural research can contribute to a better understanding of loot box harms.","author_count":4,"contributors":["Xiao, Leon Y.","Fraser, Tullia C.","Nielsen, Rune Kristian Lundedal","Newall, Philip W.S."],"cuid":["S01-000.00-718826"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","University of Bristol","University of Glasgow"],"keyword":["Computer games","Loot boxes","Mainland China","Problem gambling","videogaming"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"loot boxes gambling related risk factors and mental health in mainland china a large scale survey","src":["itu"],"src-code":["DI-U-ITU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.31219/osf.io/qgbe6","version":"Published Version"},"id":"S01-000.00-718826","ids":["itu-091bf607-b8a6-41f2-af25-af985888d17d"],"keyword":["Mainland China","Problem gambling","computer games","loot boxes","videogaming"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-7DA6F0BEC51E1BA3F8C296DD086CE453"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.itu.dk/ws/files/101903945/PRC_LB_Survey_Redux_CDiGRA_2023.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.31219/osf.io/qgbe6","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Digital Play","IT University of Copenhagen, Digital Design","IT University of Copenhagen, Play, Culture, and AI, Games Research Group"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"gb","key":"university of glasgow","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Glasgow","used":1},{"affno":"3","country":"gb","key":"university of bristol","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Bristol","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Leon Y.","key":"xiaopau","last":"Xiao","locid":"0a2a2206-180b-4443-bdb7-92deba889221","name":"Xiao, Leon Y.","orcid":"0000-0003-0709-0777","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Tullia C.","key":"fraserpau","last":"Fraser","name":"Fraser, Tullia C.","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rune Kristian Lundedal","key":"nielsenpau","last":"Nielsen","locid":"80784458-06f6-4eff-b0c8-df982ffa9835","name":"Nielsen, Rune Kristian Lundedal","orcid":"0000-0002-7209-9041","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Philip W.S.","key":"newallpau","last":"Newall","name":"Newall, Philip W.S.","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.31219/osf.io/qgbe6","status":"p","title":"Proceedings of the 10th Annual Chinese Digital Games Research Association (CDiGRA) Conference 2023 (Chinese DiGRA 2023)"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-091bf607-b8a6-41f2-af25-af985888d17d"],"src":["ITU IT University of Copenhagen"],"title":"Loot boxes, gambling-related risk factors, and mental health in Mainland China: A large-scale survey","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-718826","year":"2023","yearsub":"2023"}
{"abstract":"In March 2022, the highest administrative court in the Netherlands, the Administrative Jurisdiction Division of the Council of State, found that loot boxes in the Ultimate Team Mode of the FIFA video games (FUT) published by Electronic Arts (EA) did not contravene Dutch gambling law, contrary to the Netherlands Gambling Authority's (Kansspelautoriteit) previous 2018 interpretation of the law and overruling a previous 2020 judgment that confirmed the Kansspelautoriteit's aforementioned interpretation. The Council of State decided that the player packs (i.e., loot boxes) in the FUT mode cannot be considered a separate game that is capable of being assessed on its own as to whether it constitutes a “game of chance” and therefore potentially contravenes gambling regulation. Instead, the overarching video game containing the loot boxes should be assessed more broadly as to whether that game constitutes a “game of chance” or a “game of skill.” We argue that the Council of State's unique approach of not considering the loot boxes separately as to whether they constitute gambling underplayed the importance of paid loot boxes as a monetization method in contemporary video games. The Council of State unsatisfyingly built its main argument on the supposed “importance” of non-paid loot boxes. Further, the Council of State's overreliance on how the so-called “majority” of players experience the video game importantly failed to account for the experiences of the small minority of high-spending players who are most at risk of potential harms and in need of consumer protection. The Council of State's interpretation of Dutch gambling law should not necessarily be relied on by other countries considering the regulation of loot boxes. Dutch legislators should consider whether this restrictive interpretation, which has made future application of gambling regulation to loot boxes highly unlikely, was intended and may require legislative amendments.","author_count":2,"contributors":["Xiao, Leon Y.","Declerck, Pieterjan"],"cuid":["S01-000.00-718843"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Belgium"],"glorg":["All Global Affiliations","University of Gent"],"keyword":["Gambling regulation","Interactive entertainment law","Loot boxes","The Netherlands and Dutch law","Video games","Video gaming regulation","video game player protection"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"paid video game loot boxes are i not i gambling under dutch gambling regulation shifting the goalpost in i electronic arts v kansspelautoriteit i","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.31219/osf.io/pz24d","version":"Authors Final Version"},"id":"S01-000.00-718843","ids":["itu-4021bd52-2661-43ae-a477-f41be989c587"],"keyword":["The Netherlands and Dutch law","gambling regulation","interactive entertainment law","loot boxes","video game player protection","video games","video gaming regulation"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-0AE6706A0791F8BDDAFF9F9BBF38127B"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.31219/osf.io/pz24d","version":"Authors Final Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.itu.dk/ws/files/101473358/Dutch_Loot_Box_Judgment_Postprint.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Digital Play","IT University of Copenhagen, Digital Design","IT University of Copenhagen, Play, Culture, and AI, Games Research Group"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"be","key":"university of gent","loc":["Belgium","Europe, EU","OECD"],"name":"University of Gent","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Leon Y.","key":"xiaopau","last":"Xiao","locid":"0a2a2206-180b-4443-bdb7-92deba889221","name":"Xiao, Leon Y.","orcid":"0000-0003-0709-0777","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Pieterjan","key":"declerckpau","last":"Declerck","name":"Declerck, Pieterjan","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.31219/osf.io/pz24d","issn":["25725300"],"issue":"9","journal":"Gaming Law Review","pages":"445-459","publisher":"Mary Ann Liebert Inc.","publisher_org":"Mary Ann Liebert, Inc.","status":"p","title":"Gaming Law Review","volume":"27"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-4021bd52-2661-43ae-a477-f41be989c587"],"src":["ITU IT University of Copenhagen"],"title":"PAID VIDEO GAME LOOT BOXES ARE <i>NOT</i> GAMBLING UNDER DUTCH GAMBLING REGULATION? SHIFTING THE GOALPOST IN <i>ELECTRONIC ARTS V. KANSSPELAUTORITEIT</i>","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-718843","year":"2023","yearsub":"2023"}
{"abstract":"Loot boxes in video games are a form of in-game transactions with randomised elements. Concerns have been raised about loot boxes’ similarities with gambling and their potential harms (e.g., overspending). Recognising players’ and parents’ concerns, in mid-2020, the Entertainment Software Rating Board (ESRB) and PEGI (Pan-European Game Information) announced that games containing loot boxes or any forms of in-game transactions with randomised elements will be marked by a new label stating ‘In-Game Purchases (Includes Random Items).’ The same label has also been adopted by the International Age Rating Coalition (IARC) and thereby assigned to games available on digital storefronts, e.g., the Google Play Store. The label is intended to provide more information to consumers and allow them to make more informed purchasing decisions. This measure is not legally-binding and has been adopted as industry self-regulation or corporate social responsibility. Previous research has suggested that industry self-regulation might not be effectively complied with due to conflicting commercial interests. Compliance with the ESRB’s, PEGI’s, and IARC’s loot box presence warning label was assessed in two studies. The first study found that 60.6% of all games labelled by either the ESRB or PEGI (or 16.1% using a more equitable methodology) were not labelled by the other. The majority of the inconsistencies were caused by the ESRB refusing to apply the measure retroactively. Five instances where one age rating organisation culpably failed to accurately identify loot box presence were identified (although only two cases were admitted by the relevant organisation). Generally, with newly released games, consumers can rely on the PEGI and ESRB labels. PEGI has retroactively labelled many older games meaning that consumers can expect the labelling to be accurate. However, due to the ESRB’s policies (which it has refused to improve), North American consumers cannot rely on the label for many older games containing loot boxes, unlike their European counterparts. The data suggest that the loot box issue is far more pressing on mobile platforms than console/PC platforms. The second study found that 71.0% of popular games containing loot boxes on the Google Play Store (whose age rating system is regulated through IARC) did not display the label and were therefore non-compliant. The IARC’s current policy on the Google Play Store is that only games submitted for rating after February 2022 are required to be labelled. This policy (which the IARC has refused to improve) means that most popular and high-grossing games can be, and presently are, marketed without the label, thus significantly reducing the measure’s scope and potential benefit. The Apple App Store still does not allow loot box presence to be disclosed. At present, consumers and parents cannot rely on this self-regulatory measure to provide accurate information as to loot box presence for mobile games. Due to their immense scale, the mobile markets pose regulatory and enforcement challenges that PEGI admits are not yet resolved. The mere existence of this measure cannot be used to justify the non-regulation of loot boxes by governments, given the poor compliance and doubtful efficacy (even if when complied with satisfactorily). Improvements to the existing age rating systems are proposed. Preregistered Stage 1 protocol: https://doi.org/10.17605/OSF.IO/E6QBM (date of in-principle acceptance: 12 January 2023).","author_count":1,"contributors":["Xiao, Leon Y."],"cuid":["S01-000.00-677316"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"1 contributor","cluster_size":1,"keyword":["Consumer protection","Loot boxes","Video games","Video gaming regulation","industry self regulation and social corporate responsibility","information technology and interactive entertainment law"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"beneath the label unsatisfactory compliance with esrb pegi and iarc industry self regulation requiring loot box presence warning labels by video game companies","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1098/rsos.230270","version":"Published Version"},"id":"S01-000.00-677316","identifier":[{"id":"85151342002","type":"scopus"}],"ids":["itu-6a18899f-d62c-47d7-88c5-212e57bb9cdc"],"keyword":["consumer protection","industry self-regulation and social corporate responsibility","information technology and interactive entertainment law","loot boxes","video games","video gaming regulation"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-319DCE950154D888D12A553D35093047"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1098/rsos.230270","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Digital Play","IT University of Copenhagen, Digital Design","IT University of Copenhagen, Play, Culture, and AI, Games Research Group"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Leon Y.","key":"xiaopau","last":"Xiao","locid":"0a2a2206-180b-4443-bdb7-92deba889221","name":"Xiao, Leon Y.","orcid":"0000-0003-0709-0777","rank":1,"rolecode":"pau"}],"pub":{"doi":"10.1098/rsos.230270","issn":["20545703"],"issue":"3","journal":"Royal Society Open Science","paperid":"230270","status":"p","title":"Royal Society Open Science","volume":"10"},"review":"Peer Reviewed","scoID":["2-s2.0-85151342002"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-6a18899f-d62c-47d7-88c5-212e57bb9cdc"],"src":["ITU IT University of Copenhagen"],"title":"Beneath the label: unsatisfactory compliance with ESRB, PEGI, and IARC industry self-regulation requiring loot box presence warning labels by video game companies","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-677316","year":"2023","yearsub":"2023"}
{"abstract":"This extended abstract considers the ‘margins’ between video games and gambling embodied by so-called ‘loot boxes’ and the regulation thereof. Players spend real-world money on this form of in-game monetisation to obtain randomised rewards (Nielsen and Grabarczyk 2019). Concerns have been raised about loot boxes’ similarities with gambling and the risks that consumers might overspend money and experience harm (Zendle and Cairns 2018; Garea et al. 2021; Spicer et al. 2021). Children and other vulnerable consumers (e.g., people experiencing problem gambling issues) might be at particular risk of harm. Many countries are considering imposing legal regulation and a few countries have already taken regulatory actions. However, in most countries at present, paid loot boxes are specifically regulated only through industry self-regulation (Xiao et al. 2022). Previous research has repeatedly considered probability disclosures informing players of their odds of winning specific items (e.g., Xiao, Henderson, and Newall 2021), but another measure, text-based warning labels attached to age ratings, has received little research attention.","author_count":1,"contributors":["Xiao, Leon Y."],"cuid":["S01-000.00-677326"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"keyword":["Consumer protection","Gambling regulation","In game monetisation","Loot boxes","Probability Disclosure"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"beneath the label assessing video games compliance with esrb and pegi loot box warning label industry self regulation","src":["itu"],"src-code":["DI-U-ITU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.31219/osf.io/skz58","version":"Published Version"},"id":"S01-000.00-677326","ids":["itu-a8e8ae99-805f-42b2-85b7-0e4afc5b09f7"],"keyword":["Consumer protection","Gambling regulation","In-game monetisation","Loot boxes","Probability disclosure"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-927829106C542D6C80E5D6375F4B8A49"],"oa_link":[{"access":"oa","type":"rem","url":"https://osf.io/skz58/download","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.31219/osf.io/skz58","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Digital Play","IT University of Copenhagen, Digital Design","IT University of Copenhagen, Play, Culture, and AI, Games Research Group"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Leon Y.","key":"xiaopau","last":"Xiao","locid":"0a2a2206-180b-4443-bdb7-92deba889221","name":"Xiao, Leon Y.","orcid":"0000-0003-0709-0777","rank":1,"rolecode":"pau"}],"pub":{"doi":"10.31219/osf.io/skz58","pages":"1-4","publisher":"Digital Games Research Association","status":"p","subtitle":"Limits and Margins of Games","title":"Digital Games Research Association (DiGRA) International Conference 2023"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-a8e8ae99-805f-42b2-85b7-0e4afc5b09f7"],"src":["ITU IT University of Copenhagen"],"title":"Beneath the label: Assessing video games’ compliance with ESRB and PEGI loot box warning label industry self-regulation","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-677326","year":"2023","yearsub":"2023"}
{"abstract":"Loot boxes in video games are gambling-like mechanics that players buy to obtain randomised rewards of varying value. Loot boxes are conceptually and psychologically similar to gambling, and loot box expenditure is positively correlated with self-reported problem gambling severity. Citing consumer protection concerns, the Belgian Gaming Commission opined that such mechanics constitute gambling under existing law and effectively ‘banned’ loot boxes by threatening criminal prosecution of non-compliant companies implementing paid loot boxes without a gambling licence. The effectiveness of this ban at influencing the compliance behaviour of video game companies (and, by implication, consumers’, including children’s, exposure to and consumer protection from loot boxes) was assessed. Paid loot boxes remained widely available amongst the 100 highest-grossing iPhone games in Belgium: 82.0% continued to generate revenue through a randomised monetisation method, as did 80.2% of games rated suitable for young people aged 12+. The Belgian ‘ban’ on loot boxes has not been effectively enforced. Although the initial imposition of this measure promoted public discussion and debate about loot box regulation (both domestically and internationally) and likely provided better consumer protection in relation to specific games operated by well-known companies, an unenforced ‘ban’ has many negative consequences, including (i) giving consumers, parents, and policymakers a false sense of security and (ii) allowing non-compliant games to replace games that have been removed from the national market by more socially responsible companies. Indeed, even an effectively enforced ban has potential disadvantages. Finally, technical measures taken by companies to comply with the ban were easily circumvented, and some highly dedicated players (who are likely to be the highest spending and most vulnerable) could reasonably be expected to do so. Therefore, the complete elimination of the loot box mechanic from a country may not be practically achievable. Belgium should re-evaluate its regulatory position. A blanket ban approach to loot box regulation cannot be recommended to other countries. Other less restrictive approaches to loot box regulation should be considered. Preregistered Stage 1 protocol: https://doi.org/10.17605/OSF.IO/5MXP6 (date of in-principle acceptance: 7 April 2022).","author_count":1,"contributors":["Xiao, Leon Y."],"cuid":["S01-000.00-677335"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"1 contributor","cluster_size":1,"keyword":["Belgium","Consumer potection","Gambling law","Loot boxes","Video gaming regulation"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"breaking ban belgium s ineffective gambling law regulation of video game loot boxes","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1525/collabra.57641","version":"Published Version"},"id":"S01-000.00-677335","identifier":[{"id":"85147693425","type":"scopus"}],"ids":["itu-c63316b3-099b-48c0-9694-e7ed71078437"],"keyword":["Belgium","Consumer potection","Gambling law","Loot boxes","Video gaming regulation"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-528F443DF8D190C56B398FC5B8E5F24E"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1525/collabra.57641","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Digital Play","IT University of Copenhagen, Digital Design","IT University of Copenhagen, Play, Culture, and AI, Games Research Group"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Leon Y.","key":"xiaopau","last":"Xiao","locid":"0a2a2206-180b-4443-bdb7-92deba889221","name":"Xiao, Leon Y.","orcid":"0000-0003-0709-0777","rank":1,"rolecode":"pau"}],"pub":{"doi":"10.1525/collabra.57641","issn":["24747394"],"issue":"1","journal":"Collabra: Psychology","paperid":"57641","publisher":"University of California Press","status":"p","title":"Collabra: Psychology","volume":"9"},"review":"Peer Reviewed","scoID":["2-s2.0-85147693425"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-c63316b3-099b-48c0-9694-e7ed71078437"],"src":["ITU IT University of Copenhagen"],"title":"Breaking Ban: Belgium’s Ineffective Gambling Law Regulation of Video Game Loot Boxes","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-677335","year":"2023","yearsub":"2023"}
{"abstract":"Loot boxes are gambling-like products in video games that players can buy with real-world money to obtain random prizes. Many countries are concerned by their potential harms and are considering regulation. Industry self-regulation of companies’ own behavior is an alternative approach to direct government intervention through legislation. The self-regulatory age rating organizations in North America and Europe began assigning a loot box presence warning label (‘In-Game Purchases (Includes Random Items)’) since April 2020. This consumer protection measure has also been introduced to many digital storefronts. My recent study found that only 29% of popular games containing loot boxes were correctly labeled on the Google Play Store. The age rating organizations have seemingly suggested that other digital storefronts with significantly less content would, in contrast, perform significantly better. The present study found that the compliance rates were indeed higher on the Microsoft (89.1%), Sony (70.3%), and Nintendo (54.2%) stores. However, none met the target 95% compliance rate. Concerningly, the Epic Games Store’s compliance rate was only 7.1%. Some remedial actions have been taken following the present study: while appreciated, they have failed to address all outstanding concerns. Companies and platform providers must better comply with and enforce the rules. Besides poor efficacy on mobile platforms, the industry self-regulatory loot box warning label is also not sufficiently reliable on PC and console platforms.","author_count":1,"contributors":["Xiao, Leon Y."],"cuid":["S01-000.00-718874"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"keyword":["Compliance","Consumer protection","Content moderation","Industry self regulation","Information technology law","Interactive entertainment law","Loot boxes","Videogaming regulation","age ratings","computer games law","product information disclosure","social corporate responsibility"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"shopping around for loot box presence warning labels unsatisfactory compliance on epic nintendo sony and microsoft platforms","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1145/3630631","version":"Published Version"},"id":"S01-000.00-718874","ids":["itu-7c398dd3-ea24-49ad-ba5c-7775314da24b"],"keyword":["Loot boxes","age ratings","compliance","computer games law","consumer protection","content moderation","industry self-regulation","information technology law","interactive entertainment law","product information disclosure","social corporate responsibility","videogaming regulation"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-3-4-8F15456630BBE6E22B64EB15070E5466"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.31219/osf.io/sbtcf","version":"Authors Final Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1145/3630631","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.itu.dk/ws/files/102543461/3630631_updated.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Digital Play","IT University of Copenhagen, Digital Design","IT University of Copenhagen, Play, Culture, and AI, Games Research Group"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Leon Y.","key":"xiaopau","last":"Xiao","locid":"0a2a2206-180b-4443-bdb7-92deba889221","name":"Xiao, Leon Y.","orcid":"0000-0003-0709-0777","rank":1,"rolecode":"pau"}],"pub":{"doi":"10.31219/osf.io/sbtcf","issn":["28325516"],"issue":"4","journal":"Games: Research and Practice","paperid":"25","publisher":"Association for Computing Machinery","status":"p","title":"Games: Research and Practice","volume":"1"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-7c398dd3-ea24-49ad-ba5c-7775314da24b"],"src":["ITU IT University of Copenhagen"],"title":"Shopping around for loot box presence warning labels: Unsatisfactory compliance on Epic, Nintendo, Sony, and Microsoft platforms","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-718874","year":"2023","yearsub":"2023"}
{"abstract":"Academic research collaborations with the technology industry should be complementary to and, importantly, must not replace noncollaborative research that is independent from the industry (and, in particular, ‘adversarial research’ whose negative findings will likely operate against industry interests). Reflecting on the author's own research projects concerning companies' compliance with video game loot box regulation, he agrees with Livingstone et al.'s proposition (Child and Adolescent Mental Health, 2022, 28, 150) that research seeking to identify problems (and thereby work against the industry's interests) should be conducted independently (p. 151), at least initially. He also echoes the sentiment expressed by Zendle and Wardle (Child and Adolescent Mental Health, 2022, 28, 155) that ‘a moratorium’ (p. 156) or a ban on industry collaborations is not a proportional response to legitimate concerns about conflict of interest stemming from the video game industry's discretionary provision of data access. A combined approach that conducts both noncollaborative and collaborative research, but with the latter being conducted only after the former's unbiased results are known, might prove fruitful. Academics must bear in mind that industry involvement at any particular stage of the research, or at all, is not always appropriate. Some research questions should not and cannot be answered objectively with industry involvement. Funding bodies and other stakeholders should also recognise this and not render industry collaboration compulsory.","author_count":1,"contributors":["Xiao, Leon Y."],"cuid":["S01-000.00-677304"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"1 contributor","cluster_size":1,"keyword":["Data access in academia","Independent research","Industry conflict of interest","Research collaboration","Video game regulation"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"debate academics should collaborate with the technology industry but not in lieu of non collaborative research","src":["itu"],"src-code":["DI-U-ITU"],"type":"djc","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1111/camh.12644","version":"Published Version"},"id":"S01-000.00-677304","identifier":[{"id":"85149448919","type":"scopus"}],"ids":["itu-3941d691-3dbb-4457-a645-c6e91f0d8ed3"],"keyword":["Data access in academia","Independent research","Industry conflict of interest","Research collaboration","Video game regulation"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-2A9E05B0AF3B2CEAE66BF11B7C4482C6"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1111/camh.12644","version":"Published Version"},{"access":"oa","license":"CC BY","type":"rem","url":"https://acamh.onlinelibrary.wiley.com/doi/epdf/10.1111/camh.12644","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Digital Play","IT University of Copenhagen, Digital Design","IT University of Copenhagen, Play, Culture, and AI, Games Research Group"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Leon Y.","key":"xiaopau","last":"Xiao","locid":"0a2a2206-180b-4443-bdb7-92deba889221","name":"Xiao, Leon Y.","orcid":"0000-0003-0709-0777","rank":1,"rolecode":"pau"}],"pub":{"doi":"10.1111/camh.12644","issn":["1475357X","14753588"],"issn_org":["14753588"],"journal":"Child and Adolescent Mental Health","publisher":"Wiley-Blackwell","status":"p","title":"Child and Adolescent Mental Health"},"review":"Peer Reviewed","scoID":["2-s2.0-85149448919"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-3941d691-3dbb-4457-a645-c6e91f0d8ed3"],"src":["ITU IT University of Copenhagen"],"title":"Debate: Academics should collaborate with the technology industry, but not in lieu of non-collaborative research","type":"Journal Comment","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-677304","year":"2023","yearsub":"2023"}
{"abstract":"Loot boxes are gambling-like products found in video games that players can buy with real-world money to obtain random rewards. A positive correlation between loot box spending and problem gambling severity has been well-replicated. Some researchers recently argued that this observed positive correlation may be due to participants incorrectly interpreting problem gambling questions as applying to their loot box expenditure because they see loot box purchasing as a form of ‘gambling.’ We experimentally tested this alternative explanation for the observed positive correlation (N = 2027) by manipulating whether all participants were given the problem gambling scale, as the previous literature generally had done (the ‘non-screening’ approach; n = 1005), or by ‘screening’ participants (n = 1022) by only giving the problem gambling scale to those reporting recent gambling expenditure. Through the latter screening process, we clarified and calibrated what ‘gambling’ means by providing an exhaustive list of activities that should be accounted for and specifically instructed participants that loot box purchasing is not to be considered a form of ‘gambling.’ Results showed positive correlations between loot box spending and problem gambling across both experimental conditions. In addition, a predicted positive correlation emerged between binary past-year gambling participation and loot box expenditure in the screening group. These experimental results confirm that the association between loot box spending and problem gambling severity is likely not due to participants misinterpreting problem gambling questions as being relevant to their loot box spending. However, problem gambling severity was inflated in the non-screening group, meaning that future research on gambling-like products should include gambling participation screening questions; better define what ‘gambling’ means; potentially exclude non-gamblers from analysis; and, importantly, provide explicit instructions on whether certain activities should not be considered a form of ‘gambling.’","author_count":3,"contributors":["Xiao, Leon Y.","Newall, Philip","James, Richard J.E."],"cuid":["S01-000.00-718882"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","University of Bristol","University of Nottingham"],"keyword":["Consumer protection","Loot boxes","Problem gambling","Research methodology","Video gaming","Videogames"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"to screen or not to screen an experimental comparison of two methods for correlating video game loot box expenditure and problem gambling severity","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.chb.2023.108019","version":"Published Version"},"id":"S01-000.00-718882","ids":["itu-8788feeb-ac07-4547-8640-0ed9c5b0d9f9"],"keyword":["Consumer protection","Loot boxes","Problem gambling","Research methodology","Video gaming","Videogames"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-3-5-3D773046F1D47E78595782EDD4B38713"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.itu.dk/ws/files/102154314/CHB108019.pdf","version":"Other Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.31219/osf.io/cefnv","version":"Authors Final Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.chb.2023.108019","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Digital Play","IT University of Copenhagen, Digital Design","IT University of Copenhagen, Play, Culture, and AI, Games Research Group"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"gb","key":"university of bristol","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Bristol","used":1},{"affno":"3","country":"gb","key":"university of nottingham","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Nottingham","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Leon Y.","key":"xiaopau","last":"Xiao","locid":"0a2a2206-180b-4443-bdb7-92deba889221","name":"Xiao, Leon Y.","orcid":"0000-0003-0709-0777","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Philip","key":"newallpau","last":"Newall","name":"Newall, Philip","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Richard J.E.","key":"jamespau","last":"James","name":"James, Richard J.E.","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.31219/osf.io/cefnv","issn":["07475632","18737692"],"issn_org":["07475632"],"journal":"Computers in Human Behavior","paperid":"108019","publisher":"Elsevier","status":"p","title":"Computers in Human Behavior","volume":"151"},"review":"Peer Reviewed","scoID":["2-s2.0-85177615016"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-8788feeb-ac07-4547-8640-0ed9c5b0d9f9"],"src":["ITU IT University of Copenhagen"],"title":"To screen, or not to screen: An experimental comparison of two methods for correlating video game loot box expenditure and problem gambling severity","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-718882","year":"2023","yearsub":"2023"}
{"abstract":"Fishing ‘mini-games’ are common in many contemporary video games. But what makes certain fishing-related video gaming elements into a ‘fishing mini-game’ per se and not merely a ‘fishing mechanic’? I answer this by examining how fishing elements vary from one implementation to another. Through analysing eight recent games with fishing, I identify and categorise a list of features where different implementations may vary. The resultant framework can assist designers to implement differently to cater to various player types and achieve specific goals. I also make a first attempt at distinguishing fishing mini-games from other fishing elements in video games. I identify two core considerations that, in my view, are crucial in rendering certain gameplay elements, but not others, a ‘mini-game:’ (i) gameplay-wise, the mini-game should be substantially different from other elements of the overarching video game and (ii) engagement with the mini-game should not be compulsory or effectively so.","author_count":1,"contributors":["Xiao, Leon Y."],"cuid":["S01-000.00-677302"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"keyword":["Fishing mini games","Game Mechanics","Gameplay differentiation","Player Engagement","Video game design"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"what s a mini game the anatomy of fishing mini games","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.31219/osf.io/4g9ku","version":"Published Version"},"id":"S01-000.00-677302","ids":["itu-2d7e975b-e781-49c7-95be-0fb37bb1cff8"],"keyword":["Fishing mini-games","Game mechanics","Gameplay differentiation","Player engagement","Video game design"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-A98BE1D37545A6E1F161A672B6BD2CB9"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.31219/osf.io/4g9ku","version":"Published Version"},{"access":"oa","license":"CC BY","type":"rem","url":"https://osf.io/4g9ku/download","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Digital Play","IT University of Copenhagen, Digital Design","IT University of Copenhagen, Play, Culture, and AI, Games Research Group"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Leon Y.","key":"xiaopau","last":"Xiao","locid":"0a2a2206-180b-4443-bdb7-92deba889221","name":"Xiao, Leon Y.","orcid":"0000-0003-0709-0777","rank":1,"rolecode":"pau"}],"pub":{"doi":"10.31219/osf.io/4g9ku","pages":"1-12","place":"Sevilla, España","publisher":"Digital Games Research Association","status":"p","subtitle":"Limits and Margins of Games","title":"Digital Games Research Association (DiGRA) International Conference 2023"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-2d7e975b-e781-49c7-95be-0fb37bb1cff8"],"src":["ITU IT University of Copenhagen"],"title":"What’s a Mini-Game? The Anatomy of Fishing Mini-Games","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-677302","year":"2023","yearsub":"2023"}
{"abstract":"Loot boxes can be bought with real-world money to obtain random content inside video games. Loot boxes are viewed by many as gambling-like and are prevalently implemented globally. Previous Western and international studies have consistently found loot box spending to be positively correlated with problem gambling. Previous Western studies presented mixed results as to the correlations between loot box purchasing and gambling-related risk factors, mental wellbeing, and psychological distress. A large-scale survey of adult video game players from the People’s Republic of China (PRC) (N = 2601) was conducted through Tencent Survey. The positive correlations between loot box spending and problem gambling, and between loot box spending and problem videogaming, were successfully replicated. However, other potential risk factors (i.e., impulsivity/impulsiveness; binary past-year gambling participation status; and sensation-seeking tendencies) either did not positively correlate with loot box spending or only did so weakly. Contrary to expectations, high impulsivity was negatively associated with loot box engagement. The Risky Loot Box Index (RLI) most strongly positively correlated with, and was the best predictor in multiple linear regression models for, loot box spending. The RLI may be effective at measuring loot box harms cross-culturally. A surprising weak positive correlation was found between loot box engagement and PRC players’ mental wellbeing, and high psychological distress unexpectedly negatively predicted loot box purchasing. Although gambling-like, the risk and protective factors of loot boxes are seemingly different, meaning they should rightfully be treated as novel products. Cross-cultural research can contribute to a better understanding of loot box harms.","author_count":4,"contributors":["Xiao, Leon Y.","Fraser, Tullia C.","Nielsen, Rune Kristian Lundedal","Newall, Philip W.S."],"cuid":["S01-000.00-718829"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","University of Bristol","University of Glasgow"],"keyword":["Consumer protection","Gambling law","Loot boxes","Mainland China","People s Republic of China","Video games","Video gaming regulation"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"loot boxes gambling related risk factors and mental health in mainland china a large scale survey","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.addbeh.2023.107860","version":"Published Version"},"id":"S01-000.00-718829","identifier":[{"id":"85171649523","type":"scopus"}],"ids":["itu-16ab68b2-aa2a-492b-9efb-b884f6c66b60"],"keyword":["Consumer protection","Gambling law","Loot boxes","Mainland China","People’s Republic of China","Video games","Video gaming regulation"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-5D19243F9EF631D66FE4499247F36312"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.addbeh.2023.107860","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.itu.dk/ws/files/101629101/10.1016_j.addbeh.2023.107860.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Digital Play","IT University of Copenhagen, Digital Design"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"gb","key":"university of glasgow","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Glasgow","used":1},{"affno":"3","country":"gb","key":"university of bristol","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Bristol","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Leon Y.","key":"xiaopau","last":"Xiao","locid":"0a2a2206-180b-4443-bdb7-92deba889221","name":"Xiao, Leon Y.","orcid":"0000-0003-0709-0777","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Tullia C.","key":"fraserpau","last":"Fraser","name":"Fraser, Tullia C.","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rune Kristian Lundedal","key":"nielsenpau","last":"Nielsen","locid":"80784458-06f6-4eff-b0c8-df982ffa9835","name":"Nielsen, Rune Kristian Lundedal","orcid":"0000-0002-7209-9041","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Philip W.S.","key":"newallpau","last":"Newall","name":"Newall, Philip W.S.","rank":4,"rolecode":"pau"}],"pub":{"status":"X"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Undefined"]},"sid":["itu-16ab68b2-aa2a-492b-9efb-b884f6c66b60"],"src":["ITU IT University of Copenhagen"],"title":"Loot boxes, gambling-related risk factors, and mental health in Mainland China: A large-scale survey","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-718829","year":"2023","yearsub":"2023"}
{"abstract":"Loot boxes are gambling-like products in video games that can be purchased with real-world money to obtain random rewards. Regulations have been imposed in some jurisdictions to attempt to address potential harms. Two recent policy studies assessed companies’ compliance (but more often, non-compliance) with those regulations. The first study found that a supposed ‘ban’ on loot boxes in Belgium was not enforced so the product remained widely accessible. A preprint reporting this was widely publicised by the media. This enhanced awareness led to companies newly complying with the law and helped policymakers to view the practicality of banning loot boxes with more due scepticism. Researchers should consider actively sharing non-peer-reviewed preprint results to protect consumers more promptly. The second study found that, contrary to regulations, many games with loot boxes were not labelled. Subsequent engagement with the media and the industry self-regulators caused remedial actions to be taken: unlabelled games have since been correctly labelled, and non-compliant companies have been punished with (albeit insignificant) fines. The societal impacts of loot box policy studies demonstrate the importance of actively communicating research results to the public through media engagement and challenging companies and regulators when they are not complying with or enforcing regulations.","author_count":1,"contributors":["Xiao, Leon Y."],"cuid":["S01-000.00-718867"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"keyword":["Consumer protection","Corporate compliance","Gambling and gaming law and regulation","Loot boxes","Policy impact","Regulatory enforcement","Video games law","Videogaming regulation"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"opening the compliance and enforcement loot box a retrospective on some practice and policy impacts achieved through academic research","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.socimp.2023.100018","version":"Published Version"},"id":"S01-000.00-718867","ids":["itu-6d2d3a50-6b0c-4cb8-af2e-0a11c160b785"],"keyword":["Consumer protection","Corporate compliance","Gambling and gaming law and regulation","Loot boxes","Policy impact","Regulatory enforcement","Video games law","Videogaming regulation"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-A0180E8EB60DDB03053F5B7242BF82CC"],"oa_link":[{"access":"oa","license":"CC BY","type":"rem","url":"https://www.sciencedirect.com/science/article/pii/S2949697723000188/pdfft?md5=1156b38f92e908b03961240acfcf92cc&pid=1-s2.0-S2949697723000188-main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.itu.dk/ws/files/102138740/1-s2.0-S2949697723000188-main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.socimp.2023.100018","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Digital Play","IT University of Copenhagen, Digital Design","IT University of Copenhagen, Play, Culture, and AI, Games Research Group"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Leon Y.","key":"xiaopau","last":"Xiao","locid":"0a2a2206-180b-4443-bdb7-92deba889221","name":"Xiao, Leon Y.","orcid":"0000-0003-0709-0777","rank":1,"rolecode":"pau"}],"pub":{"status":"X"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Undefined"]},"sid":["itu-6d2d3a50-6b0c-4cb8-af2e-0a11c160b785"],"src":["ITU IT University of Copenhagen"],"title":"Opening the compliance and enforcement loot box: A retrospective on some practice and policy impacts achieved through academic research","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-718867","year":"2023","yearsub":"2023"}
{"abstract":"Governments around the world are considering regulatory measures to reduce young people's time spent on digital devices, particularly video games. This raises the question of whether proposed regulatory measures would be effective. Since the early 2000s, the Chinese government has been enacting regulations to directly restrict young people's playtime. In November 2019, it limited players aged under 18 to 1.5 hours of daily playtime and 3 hours on public holidays. Using telemetry data on over seven billion hours of playtime provided by a stakeholder from the video games industry, we found no credible evidence for overall reduction in the prevalence of heavy playtime following the implementation of regulations: individual accounts became 1.14 times more likely to play heavily in any given week (95% confidence interval 1.139-1.141). This falls below our preregistered smallest effect size of interest (2.0) and thus is not interpreted as a practically meaningful increase. Results remain robust across a variety of sensitivity analyses, including an analysis of more recent (2021) adjustments to playtime regulation. This casts doubt on the effectiveness of such state-controlled playtime mandates.","author_count":6,"contributors":["Zendle, David","Flick, Catherine","Gordon-Petrovskaya, Elena","Ballou, Nick","Xiao, Leon Y","Drachen, Anders"],"cuid":["S02-093.62-716294"],"filters":{"added":"2023-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, Non-EU","OECD"],"corresponding_author":["Zendle, David"],"country":["United Kingdom"],"glorg":["All Global Affiliations","De Montfort University","Queen Mary University of London","University of York"],"keyword":["Digital Device Regulation","Policy effectiveness","Telemetry Data Analysis","Video Game Usage","Youth Playtime Restrictions"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-SDU"]},"level3all":["DI-U-ITU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"no evidence that chinese playtime mandates reduced heavy gaming in one segment of the video games industry","src":["itu","sdu"],"src-code":["DI-U-ITU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41562-023-01669-8","version":"Published Version"},"id":"S02-093.62-716294","identifier":[{"id":"85167511059","type":"scopus"},{"id":"PMC10593605","type":"pmcid"},{"id":"37563302","type":"pmid"}],"ids":["itu-e054d3dd-f393-44b5-8613-db19842d638e","sdu-39f1a203-561c-4531-93cc-b30e3ce7ae98"],"keyword":["Digital Device Regulation","Policy Effectiveness","Telemetry Data Analysis","Video Game Usage","Youth Playtime Restrictions"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-87BFA13AA7112D64A5497107431C4D43"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41562-023-01669-8","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.itu.dk/ws/files/101402716/s41562-023-01669-8.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/243359137/s41562_023_01669_8_1_.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"gb","key":"university of york","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of York","used":1},{"affno":"2","country":"gb","key":"de montfort university","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"De Montfort University","used":1},{"affno":"3","country":"gb","key":"queen mary university of london","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Queen Mary University of London","used":1},{"affno":"4","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Digital Play","IT University of Copenhagen, Digital Design","IT University of Copenhagen, Play, Culture, and AI, Games Research Group"],"nora_code":"DI-U-ITU","used":1},{"affno":"5","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Engineering, The Maersk Mc-Kinney Moller Institute","SDU, The Faculty of Engineering, The Maersk Mc-Kinney Moller Institute, SDU Metaverse Lab"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"David","key":"zendlepau","last":"Zendle","name":"Zendle, David","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Catherine","key":"flickpau","last":"Flick","name":"Flick, Catherine","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Elena","key":"gordonpetrovskayapau","last":"Gordon-Petrovskaya","name":"Gordon-Petrovskaya, Elena","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Nick","key":"balloupau","last":"Ballou","name":"Ballou, Nick","rank":4,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Leon Y.","key":"xiaopau","last":"Xiao","locid":"0a2a2206-180b-4443-bdb7-92deba889221","name":"Xiao, Leon Y.","orcid":"0000-0003-0709-0777","rank":5,"rolecode":"pau"},{"affno":"1 5","corresponding":null,"first":"Anders","key":"drachenpau","last":"Drachen","locid":"a6262138-7239-47ee-9131-4bf75fc621e0","name":"Drachen, Anders","orcid":"0000-0002-1002-0414","rank":6,"rolecode":"pau"}],"pmid":["37563302"],"pub":{"doi":"10.1038/s41562-023-01669-8","issn":["23973374"],"issue":"10","journal":"Nature Human Behaviour","page