aue","key":"christensenpau","last":"Christensen","name":"Christensen, Emily Louisa Laue","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Maria","key":"paasivaarapau","last":"Paasivaara","name":"Paasivaara, Maria","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1145/3529320.3529331","status":"p","title":"Proceedings of the International Conference on Software and System Processes and International Conference on Global Software Engineering (ICSSP’22)"},"review":"Peer Reviewed","scoID":["2-s2.0-85130789858"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-a213e64a-5430-423d-b54a-f48a11813996"],"src":["ITU IT University of Copenhagen"],"title":"Learning Soft Skills through Distributed Software Development","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383626","year":"2022","yearsub":"2022"}
{"abstract":"ABSTRACT Scrum is best learned by doing, e.g. through simulation, as it is simple to understand but di\"cult to master. During the Covid19 pandemic, we could not use the traditional face-to-face Scrum Lego simulation game, but had to utilize something workable in an online environment. In this paper we present an online Scrum simulation for distributed teams that was created in a multiplayer game “Don’t Starve Together” (DST) through iterative re#ective work and analysis. We ran the simulation with 25 Scrum teams on four di$erent courses with participants from eight universities located in three countries. We collected feedback from 244 participants by analysing 196 student learning diaries and 84 student evaluation surveys, and by running a retrospective with 19 industry participants. The participants’ feedback was highly positive. The main reported learning outcomes were communication, estimation, Scrum in practice, communication and collaboration with industrial Product Owners, Scrum events, work organisation, teamwork and prioritisation.","author_count":2,"contributors":["Christensen, Emily Louisa Laue","Paasivaara, Maria"],"cuid":["S01-000.00-382708"],"event":{"acronym":"ICSE","title":"International Conference on Software Engineering"},"filters":{"added":"2023-03","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"country":["Finland"],"glorg":["All Global Affiliations","Lappeenranta–Lahti University of Technology"],"keyword":["Play","Scrum","Simulation","Software Engineering Education"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"respond to change or die an educational scrum simulation for distributed teams","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/92612529/RespondtoChangeorDie_AnEducationalScrumSimulationforDistributedTeams.pdf","version":"Authors Final Version"},"id":"S01-000.00-382708","ids":["itu-5f786c03-9f35-4478-85cc-643f4c4e50e8"],"keyword":["Scrum","play","simulation","software engineering education"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-347918B29243943A3C60003668494ECD"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/92612529/RespondtoChangeorDie_AnEducationalScrumSimulationforDistributedTeams.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Software Engineering, Software Engineering"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"fi","key":"lappeenranta lahti university of technology","loc":["Finland","Europe, EU","Nordic","OECD"],"name":"Lappeenranta–Lahti University of Technology","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Emily Louisa Laue","key":"christensenpau","last":"Christensen","name":"Christensen, Emily Louisa Laue","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Maria","key":"paasivaarapau","last":"Paasivaara","name":"Paasivaara, Maria","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1145/3510456.3514145","pages":"235-246","status":"p","title":"ACM/IEEE 44th International Conference on Software Engineering: Software Engineering Education and Training (ICSE-SEET '22)"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-5f786c03-9f35-4478-85cc-643f4c4e50e8"],"src":["ITU IT University of Copenhagen"],"title":"Respond to change or die: an educational scrum simulation for distributed teams","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382708","year":"2022","yearsub":"2022"}
