es":"28-33","publisher":"Open Publishing Association","status":"p","title":"Electronic Proceedings in Theoretical Computer Science","title_org":"Electronic Proceedings of Theoretical Computer Science. EPTCS","volume":"5"},"review":"Peer Reviewed","scoID":["2-s2.0-85041084828"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-6020fd16-d2ad-4ded-ba00-e9c720ab2e94"],"src":["ITU IT University of Copenhagen"],"title":"Merging Multiparty Protocols in Multiparty Choreographies","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382713","year":"2012","yearsub":"2012"}
{"abstract":"Correlation sets define a powerful mechanism for routing incoming communications to the correct running session within a server, by inspecting the content of the received messages. We present a language for programming services based on correlation sets taking into account key aspects of service-oriented systems, such as distribution, loose coupling, open-endedness and integration. Distinguishing features of our approach are the notion of correlation aliases and an asynchronous communication model. Our language is equipped with formal syntax, semantics, and a typing system for ensuring desirable properties of programs with respect to correlation sets. We provide an implementation as an extension of the JOLIE language and apply it to a nontrivial real-world example of a fully-functional distributed user authentication system.","author_count":2,"contributors":["Montesi, Fabrizio","Carbone, Marco"],"cuid":["S01-000.00-382597"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Asynchronous communication","Correlation Sets","Distributed Authentication Systems","JOLIE Language","Service Oriented Systems"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"programming services with correlation sets","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/82055183860","version":"Other Version"},"id":"S01-000.00-382597","identifier":[{"id":"82055183860","type":"scopus"}],"ids":["itu-59bafbc6-a6bb-4d7a-96f2-ed793e959338"],"keyword":["Asynchronous Communication","Correlation Sets","Distributed Authentication Systems","JOLIE Language","Service-Oriented Systems"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-7632FD155A69D5CCCA9659B5BEA6A4D1"],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Fabrizio","key":"montesipau","last":"Montesi","name":"Montesi, Fabrizio","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Marco","key":"carbonepau","last":"Carbone","locid":"9027b41a-4159-4db7-9ddd-8fc8f41f1fb3","name":"Carbone, Marco","orcid":"0000-0001-9479-2632","rank":2,"rolecode":"pau"}],"pub":{"isbn":["9783642255359_9"],"pages":"125-141","publisher":"Springer","status":"p","subtitle":"Lecture Notes in Computer Science","title":"Service Oriented Computing","volume":"7084"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-59bafbc6-a6bb-4d7a-96f2-ed793e959338"],"src":["ITU IT University of Copenhagen"],"title":"Programming services with correlation sets","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382597","year":"2011","yearsub":"2011"}
