modus=sin&s=LOI:S01-000.00-594094","year":"2016","yearsub":"2016"}
{"abstract":"We propose a Curry-Howard correspondence between a language for programming multiparty sessions and a generalisation of Classical Linear Logic (CLL). In this framework, propositions correspond to the local behaviour of a participant in a multiparty session type, proofs to processes, and proof normalisation to executing communications. Our key contribution is generalising duality, from CLL, to a new notion of n-ary compatibility, called coherence. Building on coherence as a principle of compositionality, we generalise the cut rule of CLL to a new rule for composing many processes communicating in a multiparty session. We prove the soundness of our model by showing the admissibility of our new rule, which entails deadlock-freedom via our correspondence.","author_count":6,"contributors":["Carbone, Marco","Montesi, Fabrizio","Schürmann, Carsten","Yoshida, Nobuko"],"cuid":["S02-084.11-038319"],"event":{"acronym":"CONCUR","end":"2015-09-04","place":"Madrid, es","start":"2015-09-01","title":"26th International Conference on Concurrency Theory","year":"2015"},"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","Imperial College London"],"keyword":["Classical Linear Logic","Curry Howard correspondence","Deadlock freedom","Linear Logic","Multiparty Session Types","Programming Languages","Proof Normalisation","Session types","Type systems"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-SDU"]},"level3all":["DI-U-ITU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"multiparty session types as coherence proofs","src":["itu","sdu"],"src-code":["DI-U-ITU","DI-U-SDU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/135422869/Multiparty_Session_Types_as_Coherence_Proofs.pdf","version":"Published Version"},"id":"S02-084.11-038319","identifier":[{"id":"84958245137","type":"scopus"}],"ids":["itu-6fb7e123-7910-4ff9-83a9-08680ab15d72","sdu-543c40fe-373d-4fc8-bae3-9390b8e94576"],"keyword":["Classical Linear Logic","Curry-Howard Correspondence","Deadlock-Freedom","Linear Logic","Multiparty Session Types","Programming languages","Proof Normalisation","Session types","Type systems"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-AF1DFEAE2F9D3DD0BBC6E774734CCD0F"],"oa_link":[{"access":"oa","type":"rem","url":"http://drops.dagstuhl.de/opus/volltexte/2015/5366/pdf/6.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/135422869/Multiparty_Session_Types_as_Coherence_Proofs.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.itu.dk/ws/files/83025649/6.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Theoretical Computer Science, Programming Logic and Semantics","The Department, Theoretical Computer Science"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Science, Department of Mathematics and Computer Science","SDU, Faculty of Science, Department of Mathematics and Computer Science, Computer Science"],"nora_code":"DI-U-SDU","used":1},{"affno":"3","country":"gb","key":"imperial college london","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Imperial College London","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Marco","key":"carbonepau","last":"Carbone","locid":"9027b41a-4159-4db7-9ddd-8fc8f41f1fb3","name":"Carbone, Marco","orcid":"0000-0001-9479-2632","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Fabrizio","key":"montesipau","last":"Montesi","locid":"81d9220c-ba43-48b1-aa21-129c942a9c92","name":"Montesi, Fabrizio","orcid":"0000-0003-4666-901X","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Carsten","key":"schürmannpau","last":"Schürmann","locid":"1313519f-2074-41d6-8b79-589648e37211","name":"Schürmann, Carsten","orcid":"0000-0003-4793-0099","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Nobuko","key":"yoshidapau","last":"Yoshida","name":"Yoshida, Nobuko","rank":4,"rolecode":"pau"},{"affno":"","first":"Luca","key":"acetopedh","last":"Aceto","name":"Aceto, Luca","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"David","key":"defrutosescrigpedh","last":"de Frutos Escrig","name":"de Frutos Escrig, David","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.4230/lipics.concur.2015.412","eisbn":["9783939897910"],"issn":["18688969"],"pages":"412","publisher":"Schloss Dagstuhl - Leibniz-Zentrum fuer Informatik GmbH","status":"p","subtitle":"Leibniz International Proceedings in Informatics","title":"26th International Conference on Concurrency Theory (CONCUR 2015)","volume":"42"},"review":"Peer Reviewed","scoID":["2-s2.0-84958245137"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["itu-6fb7e123-7910-4ff9-83a9-08680ab15d72","sdu-543c40fe-373d-4fc8-bae3-9390b8e94576"],"src":["ITU IT University of Copenhagen","SDU University of Southern Denmark"],"title":"Multiparty Session Types as Coherence Proofs","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-084.11-038319","year":"2015","yearsub":"2015"}
{"abstract":"A session-based process satisfies the progress property if its sessions never get stuck when it is executed in an adequate context. Previous work studied how to define progress by introducing the notion of catalysers, execution contexts generated from the type of a process. In this paper, we refine such definition to capture a more intuitive notion of context adequacy for checking progress. Interestingly, our new catalysers lead to a novel characterisation of progress in terms of the standard notion of lock-freedom. Guided by this discovery, we also develop a conservative extension of catalysers that does not depend on types, generalising the notion of progress to untyped session-based processes. We combine our results with existing techniques for lock-freedom, obtaining a new methodology for proving progress. Our methodology captures new processes wrt previous progress analysis based on session types.","author_count":3,"contributors":["Carbone, Marco","Dardha, Ornela","Montesi, Fabrizio"],"cuid":["S01-000.00-381303"],"event":{"acronym":"COORDINATION","title":"International Conference on Coordination Models and Languages"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Catalysers","Context adequacy","Lock freedom","Progress property","Session based processes"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"progress as compositional lock freedom","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/978-3-662-43376-8_4","version":"Other Version"},"id":"S01-000.00-381303","identifier":[{"id":"84902583426","type":"scopus"}],"ids":["itu-0329c3b7-3920-4332-9d07-06ee80b16596"],"keyword":["Catalysers","Context adequacy","Lock-freedom","Progress property","Session-based processes"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-95DCD6845E752D2CB734DDAC8BF89FC9"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1007/978-3-662-43376-8_4","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Theoretical Computer Science, Programming Logic and Semantics","The Department, Theoretical Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Marco","key":"carbonepau","last":"Carbone","locid":"9027b41a-4159-4db7-9ddd-8fc8f41f1fb3","name":"Carbone, Marco","orcid":"0000-0001-9479-2632","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Ornela","key":"dardhapau","last":"Dardha","locid":"b6c98930-e1c7-422f-bb9c-808f1394344a","name":"Dardha, Ornela","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Fabrizio","key":"montesipau","last":"Montesi","name":"Montesi, Fabrizio","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1007/978-3-662-43376-8_4","issn":["03029743","16113349"],"issn_org":["03029743"],"journal":"Lecture Notes in Computer Science","pages":"49-64","publisher":"Springer","status":"p","title":"Lecture Notes in Computer Science"},"review":"Peer Reviewed","scoID":["2-s2.0-84902583426"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-0329c3b7-3920-4332-9d07-06ee80b16596"],"src":["ITU IT University of Copenhagen"],"title":"Progress as Compositional Lock-Freedom","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381303","year":"2014","yearsub":"2014"}
{"abstract":"In Choreographic Programming, a distributed system is programmed by giving a choreography, a global description of its interactions, instead of separately specifying the behaviour of each of its processes. Process implementations in terms of a distributed language can then be automatically projected from a choreography. We present Linear Compositional Choreographies (LCC), a proof theory for reasoning about programs that modularly combine choreographies with processes. Using LCC, we logically reconstruct a semantics and a projection procedure for programs. For the first time, we also obtain a procedure for extracting choreographies from process terms.","author_count":3,"contributors":["Carbone, Marco","Montesi, Fabrizio","Schürmann, Carsten"],"cuid":["S01-000.00-382053"],"event":{"acronym":"CONCUR","title":"International Conference on Concurrency Theory"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Choreographic Programming","Distributed systems","Linear Compositional Choreographies","Process Automation","Semantics Reconstruction"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-SDU"]},"level3all":["DI-U-ITU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"choreographies logically","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84906772581","version":"Other Version"},"id":"S01-000.00-382053","identifier":[{"id":"84906772581","type":"scopus"}],"ids":["itu-35a5f0b1-5ec1-4d23-a209-13884ca228e2"],"keyword":["Choreographic Programming","Distributed Systems","Linear Compositional Choreographies","Process Automation","Semantics Reconstruction"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-3-5-5CEF541C508C5461A480C409A156C5C3"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Theoretical Computer Science, Programming Logic and Semantics","The Department, Theoretical Computer Science"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"dk","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["University of Southern Denmark"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Marco","key":"carbonepau","last":"Carbone","locid":"9027b41a-4159-4db7-9ddd-8fc8f41f1fb3","name":"Carbone, Marco","orcid":"0000-0001-9479-2632","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Fabrizio","key":"montesipau","last":"Montesi","name":"Montesi, Fabrizio","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Carsten","key":"schürmannpau","last":"Schürmann","locid":"1313519f-2074-41d6-8b79-589648e37211","name":"Schürmann, Carsten","orcid":"0000-0003-4793-0099","rank":3,"rolecode":"pau"}],"pub":{"issn":["03029743","16113349"],"issn_org":["03029743"],"journal":"Lecture Notes in Computer Science","pages":"47-62","publisher":"Springer","status":"p","title":"Lecture Notes in Computer Science","volume":"8704"},"review":"Peer Reviewed","scoID":["2-s2.0-84906772581"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["itu-35a5f0b1-5ec1-4d23-a209-13884ca228e2"],"src":["ITU IT University of Copenhagen"],"title":"Choreographies, Logically","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382053","year":"2014","yearsub":"2014"}
{"abstract":"The efficient use of health care ressources requires the use of Information and Communication Technology (ICT). During a treatment process, patients have often been tested and partially treated with different diagnoses in mind before the precise diagnosis is identified. To use resources well it becomes necessary to adapt the prescribed treatments to make use of the tests and partial treatments already performed, rather than always starting from square one. We propose to facilitate this through the design of declarative process models accounting for the involvement of distributed groups of medical specialists and the adaptation of treatments, and through the evaluation of the trustworthiness of models taking account of test results and actual treatments compared to the clinical guidelines.","author_count":6,"contributors":["Carbone, Marco","Christensen, Anders Skovbo","Nielson, Flemming","Nielson, Hanne Riis","Hildebrandt, Thomas","Sølvkjær, Martin"],"cuid":["S01-000.00-327455"],"event":{"end":"2013-08-23","place":"Macau, cn","start":"2013-08-21","title":"3rd International Symposium on Foundations of Health Information Engineering and Systems (FHIES 2013)","year":"2013"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Adaptability","Clinical guidelines","Trustworthiness"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Center for It, Medico og Telefoni"],"U":["DI-U-ALL","DI-U-DTU","DI-U-ITU"]},"level3all":["DI-U-DTU","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"ict powered health care processes","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/978-3-642-53956-5_5","version":"Other Version"},"id":"S01-000.00-327455","identifier":[{"id":"84927595744","type":"scopus"}],"ids":["dtu-4cdc9298-3960-479c-bcca-8b13b9903efa"],"keyword":["Adaptability","Clinical guidelines","Declarative and stochastic process models","Trustworthiness"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-519E69D339E2BD9C4F3006719F6D3700"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1007/978-3-642-53956-5_5","version":"Other Version"}],"org":[{"affno":"1","country":"dk","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Center for It, Medico og Telefoni"],"nora_code":"DI-OT","used":1},{"affno":"3","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Applied Mathematics and Computer Science","Technical University of Denmark, Department of Applied Mathematics and Computer Science, Language-Based Technology"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Marco","key":"carbonemarcopau","last":"Carbone","name":"Carbone, Marco","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Anders Skovbo","key":"christensenandersskovbopau","last":"Christensen","name":"Christensen, Anders Skovbo","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Flemming","key":"nielsonflemmingpau","last":"Nielson","locid":"f63ba194-185f-465d-9b2b-1f6ff489bc3d","name":"Nielson, Flemming","orcid":"0000-0001-7362-6176","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Hanne Riis","key":"nielsonhanneriispau","last":"Nielson","locid":"44a7d08e-b083-4419-a466-8f4392a7112f","name":"Nielson, Hanne Riis","orcid":"0000-0002-2484-5580","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Thomas","key":"hildebrandtthomaspau","last":"Hildebrandt","name":"Hildebrandt, Thomas","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Martin","key":"sølvkjærmartinpau","last":"Sølvkjær","name":"Sølvkjær, Martin","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1007/978-3-642-53956-5_5","eisbn":["9783642539565"],"isbn":["9783642539558"],"issn":["03029743"],"pages":"59-68","publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","subtitle":"Third International Symposium, FHIES 2013, Macau, China, August 21-23, 2013. Revised Selected Papers","title":"Foundations of Health Information Engineering and Systems"},"review":"Peer Reviewed","scoID":["2-s2.0-84927595744"],"search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Miscellaneous","Other Research","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-4cdc9298-3960-479c-bcca-8b13b9903efa"],"src":["DTU Technical University of Denmark"],"title":"ICT-powered Health Care Processes","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-327455","year":"2014","yearsub":"2014"}
{"abstract":"In our body, cells are continuously exposed to physical forces that can regulate different cell functions such as cell proliferation, differentiation and death. In this work, we employed two different strategies to mechanically stress cancer cells. The cancer and healthy cell populations were treated either with mechanical stress delivered by a micropump (fabricated by deep X-ray nanolithography) or by ultrasound wave stimuli. A specific down-regulation of Major Histocompatibility Complex (MHC) class I molecules expression on cancer cell membrane compared to different kinds of healthy cells (fibroblasts, macrophages, dendritic and lymphocyte cells) was observed, stimulating the cells with forces in the range of nano-newton, and pressures between 1 and 10 bar (1 bar5100.000 Pascal), depending on the devices used. Moreover, Raman spectroscopy analysis, after mechanical treatment, in the range between 700–1800 cm-1, indicated a relative concentration variation of MHC class I. PCA analysis was also performed to distinguish control and stressed cells within different cell lines. These mechanical induced phenotypic changes increase the tumor immunogenicity, as revealed by the related increased susceptibility to Natural Killer (NK) cells cytotoxic recognition.","author_count":19,"contributors":["La Rocca, Rosanna","Tallerico, Rossana","Hassan, Almosawy Talib","Das, Gobind","Tadepally, Lakshmikanth","Matteucci, Marco","Liberale, Carlo","Mesuraca, Maria","Scumaci, Domenica","Gentile, Francesco","Cojoc, Gheorghe","Perozziello, Gerardo","Ammendolia, Antonio","Gallo, Adriana","Kärre, Klas","Cuda, Giovanni","Candeloro, Patrizio","Di Fabrizio, Enzo","Carbone, Ennio"],"cuid":["S01-000.00-348092"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"country":["Italy","Sweden"],"glorg":["All Global Affiliations","Karolinska Institutet","Magna Græcia University","National Research Council of Italy"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"mechanical stress downregulates mhc class i expression on human cancer cell membrane","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/104402758/036_LaRocca_PlosOne.pdf","version":"Published Version"},"id":"S01-000.00-348092","identifier":[{"id":"PMC4277281","type":"pmcid"},{"id":"84919933010","type":"scopus"},{"id":"25541692","type":"pmid"}],"ids":["dtu-91bf88fa-eca2-4044-8070-68da171fcce9"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-2BA5065616C807378C978D745B34E47C"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/104402758/036_LaRocca_PlosOne.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1371/journal.pone.0111758","version":"Other Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","country":"it","key":"magna græcia university","loc":["Italy","Europe, EU","OECD"],"name":"Magna Græcia University","used":1},{"affno":"2","country":"se","key":"karolinska institutet","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Karolinska Institutet","used":1},{"affno":"3","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Micro- and Nanotechnology","Technical University of Denmark, Department of Micro- and Nanotechnology, Polymer Micro & Nano Engineering"],"nora_code":"DI-U-DTU","used":1},{"affno":"4","country":"it","key":"national research council of italy","loc":["Italy","Europe, EU","OECD"],"name":"National Research Council of Italy","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Rosanna","key":"laroccapau","last":"La Rocca","name":"La Rocca, Rosanna","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rossana","key":"tallericopau","last":"Tallerico","name":"Tallerico, Rossana","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Almosawy Talib","key":"hassanpau","last":"Hassan","name":"Hassan, Almosawy Talib","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Gobind","key":"daspau","last":"Das","name":"Das, Gobind","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lakshmikanth","key":"tadepallypau","last":"Tadepally","name":"Tadepally, Lakshmikanth","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Marco","key":"matteuccipau","last":"Matteucci","locid":"630673b0-2302-41d2-91f8-83c174c11cc1","name":"Matteucci, Marco","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Carlo","key":"liberalepau","last":"Liberale","name":"Liberale, Carlo","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Maria","key":"mesuracapau","last":"Mesuraca","name":"Mesuraca, Maria","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Domenica","key":"scumacipau","last":"Scumaci","name":"Scumaci, Domenica","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Francesco","key":"gentilepau","last":"Gentile","name":"Gentile, Francesco","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Gheorghe","key":"cojocpau","last":"Cojoc","name":"Cojoc, Gheorghe","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Gerardo","key":"perozziellopau","last":"Perozziello","name":"Perozziello, Gerardo","rank":12,"rolecode":"pau"},{"