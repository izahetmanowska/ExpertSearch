Copenhagen, Computer Science","IT University of Copenhagen, Software Engineering, Software Engineering"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Engineer","key":"bainomugishaped","last":"Bainomugisha","name":"Bainomugisha, Engineer","rank":1,"role":"Editor","rolecode":"ped"},{"affno":"2","corresponding":null,"first":"Michel","key":"chaudronped","last":"Chaudron","name":"Chaudron, Michel","rank":2,"role":"Editor","rolecode":"ped"},{"affno":"3","corresponding":null,"first":"Imed","key":"hammoudaped","last":"Hammouda","name":"Hammouda, Imed","rank":3,"role":"Editor","rolecode":"ped"},{"affno":"4","corresponding":null,"first":"Yvonne","key":"dittrichped","last":"Dittrich","locid":"f2136570-f73c-446f-9fb0-6d9e461e2124","name":"Dittrich, Yvonne","orcid":"0000-0003-4757-3394","rank":4,"role":"Editor","rolecode":"ped"}],"pub":{"isbn":["9781728122786"],"publisher":"IEEE","status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-d05a95b5-5069-4dd9-89e4-c8df3a2e5114"],"src":["ITU IT University of Copenhagen"],"title":"Proceedings of the 2nd Symposium on Software Engineering in Africa, SEiA@ICSE 2019, Montreal, QC, Canada, May 28, 2019","type":"Book","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384326","year":"2019","yearsub":"2019"}
{"abstract":"Software today is more and more often part of either product or platform ecosystems. Examples are ERP systems, scientific software, but also the India stack (http://indiastack.org/about/). Software development in such ecosystems is often distributed over several organizations: the software provider/platform developer; application developers and customizers; and sometimes even end users acting as developers. Software products and platforms need to be continuously evolved to keep up with the evolving use and business cases. In the context of societal infrastructures, the design of functionality and interaction needs to be adapted to technically savy subcultures as well as underprivileged communities. Here, the design for and with underprivileged communities is especially challenging. In the talk, I draw on research on software eco-systems in Scandinavia and user centered design and development of software in Scandinavia, India and Africa. The lecture will outline challenges and possibilities of use-oriented design in the context of software ecosystems.","author_count":1,"contributors":["Dittrich, Yvonne"],"cuid":["S01-000.00-383894"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"keyword":["Interaction design","user oriented design"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"und","rtype":["clu"],"sorti":"use oriented design and software ecosystems","src":["itu"],"src-code":["DI-U-ITU"],"type":"doo","type-grp":["all","pub"]},"id":"S01-000.00-383894","identifier":[{"id":"85062338380","type":"scopus"}],"ids":["itu-b4a825f0-ba87-4cff-9855-6d947a3ad64c"],"keyword":["Interaction design","user-oriented design"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-461BE525826674F553FF9AADBFC59F90"],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Software Engineering, Software Engineering"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Yvonne","key":"dittrichpau","last":"Dittrich","locid":"f2136570-f73c-446f-9fb0-6d9e461e2124","name":"Dittrich, Yvonne","orcid":"0000-0003-4757-3394","rank":1,"rolecode":"pau"}],"pub":{"publisher":"Association for Computing Machinery","status":"p"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-b4a825f0-ba87-4cff-9855-6d947a3ad64c"],"src":["ITU IT University of Copenhagen"],"title":"Use-Oriented Design and Software Ecosystems","type":"Other-Unknown","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383894","year":"2019","yearsub":"2019"}
{"abstract":"User-centered design (UCD)1 addresses the design of interactive systems placing the users in the center of the design with the aim of improving usability and user experience. Developing economies are in dear need of UCD; low IT literacy, low infrastructure and funds; and heterogeneity in culture and livelihood result in special requirements on usability in order to harvest the possible benefits of IT. Traditional UCD methods, however, are often regarded as heavy-weight and expensive. Agile software development methods are light-weight, flexible and iterative in order to accommodate the changing requirements and unsure funding and are therefore important for IT companies in developing economies. Can we adjust UCD methods to fit the need of developing economies and with agile development while taking advantage of the iterative character of agile development methods? The research appropriated an action research approach called Cooperative Method Development (CMD). Based on the empirical investigation, UCD challenges were identified, innovative use of light-weight UCD methods was deliberated and implemented. The improvements include: working with local IT personnel, light-weight and incremental use of personas, support departments performing acceptance testing on release versions, culturally adapted user testing in pairs and heuristic evaluation as adapted UCD practices. The evaluation together with the involved practitioners shows improvements in the development process including reduced reworks; satisfied users; better collaboration with stakeholders; and a close understanding of users and their needs. The evaluation of the resulting integrated approach with the involved practitioners as well as software engineers not involved in the research indicates that the results are transferable to similar contexts.","author_count":3,"contributors":["Teka, Degif","Dittrich, Yvonne","Kifle, Mesfin"],"cuid":["S01-000.00-382568"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Africa"],"country":["Ethiopia"],"glorg":["Addis Ababa University","All Global Affiliations","Hawassa University"],"keyword":["agile development discount usability methods heuristic evaluation lightweight UCD personas user pair test"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"adapting lightweight user centered design with the scrum based development process","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83630059/SEiA_2018_V4_final.pdf","version":"Pre-print"},"id":"S01-000.00-382568","identifier":[{"id":"85051480367","type":"scopus"}],"ids":["itu-57991860-f478-4225-9d56-41397bbe3b88"],"keyword":["agile development, discount usability methods, heuristic evaluation, lightweight UCD, personas, user-pair test"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-51C470D54998219472FBA16FCED92A6B"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83630059/SEiA_2018_V4_final.pdf","version":"Pre-print"}],"org":[{"affno":"1","country":"et","key":"hawassa university","loc":["Ethiopia","Africa"],"name":"Hawassa University","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Software Engineering, Software Engineering"],"nora_code":"DI-U-ITU","used":1},{"affno":"3","country":"et","key":"addis ababa university","loc":["Ethiopia","Africa"],"name":"Addis Ababa University","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Degif","key":"tekapau","last":"Teka","name":"Teka, Degif","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Yvonne","key":"dittrichpau","last":"Dittrich","locid":"f2136570-f73c-446f-9fb0-6d9e461e2124","name":"Dittrich, Yvonne","orcid":"0000-0003-4757-3394","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Mesfin","key":"kiflepau","last":"Kifle","name":"Kifle, Mesfin","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1145/3195528.3195530","eisbn":["9781450357197"],"isbn":["9781450357197"],"issn":["00010782"],"pages":"35-42","place":"New York, New York, USA","publisher":"Association for Computing Machinery","series":"SEiA '18","status":"p","title":"Proceedings of the 2018 International Conference on Software Engineering in Africa - SEiA '18"},"review":"Peer Reviewed","scoID":["2-s2.0-85051480367"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-57991860-f478-4225-9d56-41397bbe3b88"],"src":["ITU IT University of Copenhagen"],"title":"Adapting Lightweight User-centered Design with the Scrum-based Development Process","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382568","year":"2018","yearsub":"2018"}
{"abstract":"Background: Agile and distributed software development are two trends that continue to increase rapidly in today's software industry. Even though the benefits achievable by combining them are potentially many, the intrinsic challenges of such marriage often lead to severe complications that can jeopardize the successful completion of software projects. Method: To investigate empirically how these two trends can coexist without compromising on the agile core values and principles, we conducted an exploratory holistic case study. Focusing on the development team of a Danish SME having both distributed offices as well as teleworking arrangements, we showcase (the evolution of) their practices. Results: The case is an example of the effective application of the agile reflective culture that allowed the company to evolve to a level in which the collocation restrictions of agile software development are overcome by a continuously evolving software process geared towards reducing waste to achieve speed and simplicity. Conclusions: Even though results need to be considered carefully due to the single nature of the reported case, we highlight five elements that have been fundamental in such journey: agile servant-leader, agile team, trust, virtual work environment, inspect & adapt, and reduce waste. Extensive information is provided to frame the context and to allow meaningful future comparisons.","author_count":5,"contributors":["Lous, Pernille","Tell, Paolo","Michelsen, Christian Bo","Dittrich, Yvonne","Ebdrup, Allan"],"cuid":["S01-000.00-384049"],"event":{"acronym":"ICSP","title":"International Conference on Software and Systems Process"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["agile software development case study continuous deployment continuous software engineering distributed software engineering software process improvement"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"from scrum to agile a journey to tackle the challenges of distributed development in an agile team","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83527136/ICSSP_2018_author_version.pdf","version":"Authors Final Version"},"id":"S01-000.00-384049","identifier":[{"id":"85048358650","type":"scopus"}],"ids":["itu-bddc0cb2-59e9-41a7-8b27-fdce2e25909c"],"keyword":["agile software development, case study, continuous deployment, continuous software engineering, distributed software engineering, software process improvement"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-E625A56E7AF9656A40670F6CBA7E9AF1"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83527136/ICSSP_2018_author_version.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Pernille","key":"louspau","last":"Lous","name":"Lous, Pernille","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Paolo","key":"tellpau","last":"Tell","locid":"2b8ff3a4-e9b0-403d-8bd8-1bf26121c234","name":"Tell, Paolo","orcid":"0000-0001-7391-0046","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Christian Bo","key":"michelsenpau","last":"Michelsen","name":"Michelsen, Christian Bo","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Yvonne","key":"dittrichpau","last":"Dittrich","locid":"f2136570-f73c-446f-9fb0-6d9e461e2124","name":"Dittrich, Yvonne","orcid":"0000-0003-4757-3394","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Allan","key":"ebdruppau","last":"Ebdrup","name":"Ebdrup, Allan","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1145/3202710.3203149","isbn":["9781450364591"],"issn":["00010782"],"pages":"11-20","publisher":"Association for Computing Machinery","series":"ICSSP '18","status":"p","title":"Proceedings of the 2018 International Conference on Software and System Process"},"review":"Peer Reviewed","scoID":["2-s2.0-85048358650"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-bddc0cb2-59e9-41a7-8b27-fdce2e25909c"],"src":["ITU IT University of Copenhagen"],"title":"From Scrum to Agile: A Journey to Tackle the Challenges of Distributed Development in an Agile Team","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384049","year":"2018","yearsub":"2018"}
{"abstract":"The term Human-Data Interaction (HDI) conceptualizes the growing importance of understanding how people need and desire to use and interact with data. Previous HDI cases have mainly focused on the interface between personal health data and the healthcare sector. This paper argues that it is relevant to consider HDI at an organisational level and examines how HDI can look in such a context, where data and data maintenance are core assets and activities. We report on initial findings of a study of a knowledge-broker organisation, where we follow how data are produced, shared, and maintained in a cross-organisational context. We discuss similarities and differences of HDI around personal health data and cross-organisational data maintenance. We propose to extend the notion of HDI to include the complexity of cross-organisational data work.","author_count":3,"contributors":["Seidelin, Cathrine","Dittrich, Yvonne","Grönvall, Erik"],"cuid":["S01-000.00-384322"],"event":{"acronym":"HCI","title":"International BCS Human Computer Interaction Conference"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Cross Organisational Data","Data Maintenance","Data Usage Practices","Human data interaction","Knowledge Brokerage"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"data work in a knowledge broker organization how cross organizational data maintenance shapes human data interactions","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.14236/ewic/HCI2018.14","version":"Published Version"},"id":"S01-000.00-384322","identifier":[{"id":"85058124017","type":"scopus"}],"ids":["itu-d0464844-a319-43e4-9351-03c58973ed7c"],"keyword":["Cross-Organisational Data","Data Maintenance","Data Usage Practices","Human-Data Interaction","Knowledge Brokerage"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-04C615381F0628363497AECA0D82A527"],"oa_link":[{"access":"oa","type":"rem","url":"https://ewic.bcs.org/content/conWebDoc/59990","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.14236/ewic/HCI2018.14","version":"Published Version"},{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83317750/BHCI_2018_paper_48.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Software Engineering, Software Engineering"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Cathrine","key":"seidelinpau","last":"Seidelin","name":"Seidelin, Cathrine","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Yvonne","key":"dittrichpau","last":"Dittrich","locid":"f2136570-f73c-446f-9fb0-6d9e461e2124","name":"Dittrich, Yvonne","orcid":"0000-0003-4757-3394","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Erik","key":"grönvallpau","last":"Grönvall","locid":"1e0534b4-fe3e-4c5e-ad6d-5f1c7df6a14e","name":"Grönvall, Erik","orcid":"0000-0002-7377-6091","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.14236/ewic/hci2018.14","isbn":["N/A"],"pages":"1-12","place":"Belfast, Northern Ireland","publisher":"BCS Learning and Development Ltd","status":"p","title":"British Human Computer Interaction Conference 2018"},"review":"Peer Reviewed","scoID":["2-s2.0-85058124017"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-d0464844-a319-43e4-9351-03c58973ed7c"],"src":["ITU IT University of Copenhagen"],"title":"Data Work in a Knowledge-Broker Organization: How Cross-Organizational Data Maintenance shapes Human Data Interactions.","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384322","year":"2018","yearsub":"2018"}
{"abstract":"The internet has long been a core infrastructure especially for the western societies. In the last decade, the usage of the internet changed from a mainly communication infrastructure giving mainly access to static information to become a platform to full-scale applications implemented as services. Even more recently we can observe a growing use of the internet to collect and provide data: social media platforms and search engines collect, use and sell data about their usage and users; online shops use data to recommend goods to the buyer; municipalities and other public organisations provide data through open data interfaces so it can be used by companies, e.g. to provide advice for car drivers searching for a parking lot. The data infrastructure making data accessible, though, requires IT expertise. In this position paper we explore the implication of this development from a participatory design perspective and argue that we need to engage in infrastructuring in order to make the common data a common good.","author_count":3,"contributors":["Dittrich, Yvonne","Seidelin, Cathrine","Grönvall, Erik"],"cuid":["S01-000.00-383190"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Data Accessibility","Data driven services","Internet infrastructure","Open data interfaces","Participatory Design"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"nr","rtype":["clu"],"sorti":"data as infrastructure infrastructuring for data analytics","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-ND","type":"loc","url":"https://pure.itu.dk/ws/files/83630235/Data_as_Infrastructure_1.0.pdf","version":"Other Version"},"id":"S01-000.00-383190","ids":["itu-82e759e9-1c41-4dea-9d66-076e2bc261aa"],"keyword":["Data accessibility","Data-driven services","Internet infrastructure","Open data interfaces","Participatory design"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-16766B87DBBBC50C22843BEF2F223E4D"],"oa_link":[{"access":"oa","license":"CC BY-ND","type":"loc","url":"https://pure.itu.dk/ws/files/83630235/Data_as_Infrastructure_1.0.pdf","version":"Other Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Software Engineering, Software Engineering"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Yvonne","key":"dittrichpau","last":"Dittrich","locid":"f2136570-f73c-446f-9fb0-6d9e461e2124","name":"Dittrich, Yvonne","orcid":"0000-0003-4757-3394","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Cathrine","key":"seidelinpau","last":"Seidelin","name":"Seidelin, Cathrine","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Erik","key":"grönvallpau","last":"Grönvall","locid":"1e0534b4-fe3e-4c5e-ad6d-5f1c7df6a14e","name":"Grönvall, Erik","orcid":"0000-0002-7377-6091","rank":3,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-82e759e9-1c41-4dea-9d66-076e2bc261aa"],"src":["ITU IT University of Copenhagen"],"title":"Data as Infrastructure – Infrastructuring for Data Analytics","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383190","year":"2018","yearsub":"2018"}
{"abstract":"This exploratory paper examines the relationship between Participatory Design (PD) and Sustainability as it emerges from the Participatory Design Conference (PDC). The reinvigorated political agenda of PD, together with the enlargements of its application domains and scopes of interest, calls for reinvigorating the early concerns of the field for long-term, durable, and positive change. The objective of this paper is to explore what \"sustainability\" means in and for the field. The study is based on a literature review of the PDC Proceedings and it provides both an outline of the structural aspects of the literature and a mapping of three use patterns of the concept: PD for Sustainability; Sustainability of PD Practice; and Sustainability of PD Results. Based on our interpretation of these patterns we also provide a general definition of sustainability. We believe the findings of this paper can support PD scholars in conceptualizing sustainability and to position their works in relation to it.","author_count":2,"contributors":["Poderi, Giacomo","Dittrich, Yvonne"],"cuid":["S01-000.00-383736"],"event":{"acronym":"PDC","title":"Participatory Design Conference"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Literature review","PDC proceedings","Sustainability"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"participatory design and sustainability a literature review of pdc proceedings","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83378625/PDC_Sustainability_vCAMERAREADY.pdf","version":"Authors Final Version"},"id":"S01-000.00-383736","identifier":[{"id":"85055532279","type":"scopus"}],"ids":["itu-a9e2c3e8-cff9-43f8-9ee6-6926ab41b0d2"],"keyword":["PDC proceedings","Sustainability","literature review"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-CBD5E9459301CDB94AFA19EEF442FC05"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83378625/PDC_Sustainability_vCAMERAREADY.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Giacomo","key":"poderipau","last":"Poderi","name":"Poderi, Giacomo","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Yvonne","key":"dittrichpau","last":"Dittrich","locid":"f2136570-f73c-446f-9fb0-6d9e461e2124","name":"Dittrich, Yvonne","orcid":"0000-0003-4757-3394","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1145/3210604.3210624","isbn":["9781450355742"],"issn":["21505896"],"pages":"1-5","publisher":"Association for Computing Machinery","series":"Proceedings of the Participatory Design Conference","status":"p","subtitle":"Short Papers, Situated Actions, Workshops and Tutorial - Volume 2","title":"Proceedings of the Participatory Design Conference"},"review":"Peer Reviewed","scoID":["2-s2.0-85055532279"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-a9e2c3e8-cff9-43f8-9ee6-6926ab41b0d2"],"src":["ITU IT University of Copenhagen"],"title":"Participatory Design and Sustainability : a literature review of PDC Proceedings","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383736","year":"2018","yearsub":"2018"}
{"abstract":"ROS (Robot Operating System) is an open source community in robotics that is developing standard robotics operating system facilities such as hardware abstraction, low-level device control, communication middleware, and a wide range of software components for robotics functionality. This paper studies the quality assurance practices of the ROS community. We use qualitative methods to understand how ideology, priorities of the community, culture, sustainability, complexity, and adaptability of the community affect the implementation of quality assurance practices. Our analysis suggests that software engineering practices require social and cultural alignment and adaptation to the community particularities to achieve seamless implementation in open source environments. This alignment should be incorporated into the design and implementation of quality assurance practices in open source communities.","author_count":3,"contributors":["Alami, Adam","Dittrich, Yvonne","Wasowski, Andrzej"],"cuid":["S01-000.00-384162"],"event":{"acronym":"ICSE","title":"International Conference on Software Engineering"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["OSS Community","Open source software","Quality assurance"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"influencers of quality assurance in an open source community","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83271131/CHASE_2018_AlamiDitrichWasowski_.pdf","version":"Authors Final Version"},"id":"S01-000.00-384162","identifier":[{"id":"85051174484","type":"scopus"}],"ids":["itu-c531bcec-602a-4fc3-ba37-27291dc776d6"],"keyword":["OSS Community","Open Source Software","Quality Assurance"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-E07D37059F85E28E4E784CFE17DCF075"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83271131/CHASE_2018_AlamiDitrichWasowski_.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Adam","key":"alamipau","last":"Alami","name":"Alami, Adam","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Yvonne","key":"dittrichpau","last":"Dittrich","locid":"f2136570-f73c-446f-9fb0-6d9e461e2124","name":"Dittrich, Yvonne","orcid":"0000-0003-4757-3394","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1145/3195836.3195853","eisbn":["9781450357258/18/05"],"pages":"61-68","publisher":"Association for Computing Machinery","status":"p","title":"Proceedings of the 11th International Workshop on Cooperative and Human Aspects of Software Engineering (CHASE '18)"},"review":"Peer Reviewed","scoID":["2-s2.0-85051174484"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-c531bcec-602a-4fc3-ba37-27291dc776d6"],"src":["ITU IT University of Copenhagen"],"title":"Influencers of Quality Assurance in an Open Source Community","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384162","year":"2018","yearsub":"2018"}
{"abstract":"Even though agile methods have been flourishing in the last decades, their implementation in (globally) distributed arrangements still presents hard challenges. Due to this tension, practices are either modified or added to compensate with the additional control required by the setup. In this paper, we present a case study that, by embracing the characteristics of distributed development, managed to incrementally design a process that does not compromise the foundations of the agile philosophy. We show how a virtual work environment has been crafted by continuously improving practices and carefully selecting technologies to allow each team member of the development team to fully participate regardless of the actual physical location. Aware of the single nature limitation of the reported case, we present extensive information to frame the context allowing meaningful comparisons by researchers and providing concrete examples for practitioners.","author_count":6,"contributors":["Lous, Pernille","Tell, Paolo","Michelsen, Christian Bo","Dittrich, Yvonne","Kuhrmann, Marco","Ebdrup, Allan"],"cuid":["S01-000.00-381474"],"event":{"acronym":"ICGSE","title":"IEEE/ACM International Conference on Global Software Engineering"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","Clausthal University of Technology"],"keyword":["agile development global software engineering virtual teams"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Debitoor"],"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"virtual by design how a work environment can support agile distributed software development","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83268651/main.pdf","version":"Authors Final Version"},"id":"S01-000.00-381474","identifier":[{"id":"85051519398","type":"scopus"}],"ids":["itu-0dd8d322-a9cd-4518-ae26-b7850cecb8cd"],"keyword":["agile development, global software engineering, virtual teams"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-2014F37EB1965CE30CE324F0879DD595"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83268651/main.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"de","key":"clausthal university of technology","loc":["Germany","Europe, EU","OECD"],"name":"Clausthal University of Technology","used":1},{"affno":"3","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Debitoor"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Pernille","key":"louspau","last":"Lous","name":"Lous, Pernille","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Paolo","key":"tellpau","last":"Tell","locid":"2b8ff3a4-e9b0-403d-8bd8-1bf26121c234","name":"Tell, Paolo","orcid":"0000-0001-7391-0046","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Christian Bo","key":"michelsenpau","last":"Michelsen","name":"Michelsen, Christian Bo","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Yvonne","key":"dittrichpau","last":"Dittrich","locid":"f2136570-f73c-446f-9fb0-6d9e461e2124","name":"Dittrich, Yvonne","orcid":"0000-0003-4757-3394","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Marco","key":"kuhrmannpau","last":"Kuhrmann","name":"Kuhrmann, Marco","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Allan","key":"ebdruppau","last":"Ebdrup","name":"Ebdrup, Allan","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1145/3196369.3196374","isbn":["9781450357173"],"issn":["00010782"],"pages":"102-111","place":"New Yorck, NY, USA","publisher":"Association for Computing Machinery","series":"ICGSE '18","status":"p","title":"Proceedings of the 13th Conference on Global Software Engineering (ICGSE '18)"},"review":"Peer Reviewed","scoID":["2-s2.0-85051519398"],"search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["itu-0dd8d322-a9cd-4518-ae26-b7850cecb8cd"],"src":["ITU IT University of Copenhagen"],"title":"Virtual by Design: How a Work Environment Can Support Agile Distributed Software Development","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381474","year":"2018","yearsub":"2018"}
{"abstract":"Continuous Software Engineering (CSE)---continuous development and deployment of software---and DevOps---the close cooperation or integration of operations and software development---is about to change how software is developed. Together with the tighter integration of development and operations also with usage this will change coordination and collaboration both between IT professionals and between developers and users. In this short paper, we discuss the CHASE dimension of three core research themes that begin to crystallize in literature. This position paper is intended as a 'call to arms' for the CHASE community to study CSE.","author_count":9,"contributors":["Dittrich, Yvonne","Nørbjerg, Jacob","Tell, Paolo","Bendix, Lars"],"cuid":["S02-081.14-031459"],"event":{"acronym":"SE","end":"2018-05-27","place":"Gotheburg, se","start":"2018-05-27","title":"11th International Workshop on Cooperative and Human Aspects of Software Engineering. CHASE 2018","year":"2018"},"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","Nordic","OECD"],"country":["Sweden"],"glorg":["All Global Affiliations","Lund University"],"keyword":["Continuous software engineering","DevOps","continuous software engineering devops"],"level":"sci","mra":["sci","soc"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS","DI-U-ITU"]},"level3all":["DI-U-CBS","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"researching cooperation and communication in continuous software engineering","src":["cbs","itu"],"src-code":["DI-U-CBS","DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"https://pure.itu.dk/ws/files/83268813/main.pdf","version":"Published Version"},"id":"S02-081.14-031459","identifier":[{"id":"85051236914","type":"scopus"}],"ids":["cbs-4c646c41-5447-481a-a58b-dd5dbff0172c","itu-541dc284-0516-4e38-a9c1-f0341179e2ab"],"keyword":["Continuous software engineering","DevOps","continuous software engineering, devops"],"lang":"English","level":"Scientific","mra":["Science/Technology","Social Science"],"noi":["Global-Local-2-5-D69BADA90C9E4F932E5824361987CD02"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83268813/main.pdf","version":"Authors Final Version"}],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Software Engineering, Software Engineering"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of Digitalization"],"nora_code":"DI-U-CBS","used":1},{"affno":"3","country":"se","key":"lund university","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Lund University","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Yvonne","key":"dittrichpau","last":"Dittrich","locid":"f2136570-f73c-446f-9fb0-6d9e461e2124","name":"Dittrich, Yvonne","orcid":"0000-0003-4757-3394","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jacob","key":"nørbjergpau","last":"Nørbjerg","locid":"b2359cd5-eff1-4b71-8498-35a0561d471e","name":"Nørbjerg, Jacob","orcid":"0000-0002-9557-276X","rank":2,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"first":"Paolo","key":"tellpau","last":"