U","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Software Engineering, Software Engineering"],"nora_code":"DI-U-ITU","used":1},{"affno":"5","country":"at","key":"centre for social innovation","loc":["Austria","Europe, EU","OECD"],"name":"Centre for Social Innovation","used":1},{"affno":"6","country":"gb","key":"open data institute","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Open Data Institute","used":1}],"person":[{"affno":"1","corresponding":null,"first":"MARKUS","key":"rasmussonpau","last":"RASMUSSON","name":"RASMUSSON, MARKUS","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Nicklas","key":"guldåkerpau","last":"Guldåker","name":"Guldåker, Nicklas","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Per-Olof","key":"hallinpau","last":"Hallin","name":"Hallin, Per-Olof","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jonathan","key":"brightpau","last":"Bright","name":"Bright, Jonathan","rank":4,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Yvonne","key":"dittrichpau","last":"Dittrich","locid":"f2136570-f73c-446f-9fb0-6d9e461e2124","name":"Dittrich, Yvonne","orcid":"0000-0003-4757-3394","rank":5,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Susanne","key":"dobnerpau","last":"Dobner","name":"Dobner, Susanne","rank":6,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Leonard","key":"mackpau","last":"Mack","name":"Mack, Leonard","rank":7,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Christian","key":"voigtpau","last":"Voigt","name":"Voigt, Christian","rank":8,"rolecode":"pau"}],"pub":{"pages":"44","status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-4651c2cc-9232-4ca6-96a3-9ae734323236"],"src":["ITU IT University of Copenhagen"],"title":"Data Visualisation and Decision Making Solutions to Forecast and Manage Complex Urban Challenges: STAKEHOLDER EVALUATION REPORT","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382313","year":"2017","yearsub":"2017"}
{"abstract":"Usability and user centered design (UCD) are central to software development. In developing countries, the gap between IT development and the local use situation is larger than in western countries. However, usability is neither well addressed in software practice nor at the policy making level in Ethiopia. Software practitioners focus on functional requirements, meeting deadlines and budget. The software development industry in Ethiopia is in its early stage. The article aims at understanding usability practices in an Ethiopian software development company. Developers, system analysts, product owners and users were studied. In this first phase of the research, participatory observation, a workshop and interviews with practitioners and operational staff were analyzed. Informal discussions have been observed to outweigh formal meetings for sharing experience and ideas. Practitioners' internal configuration, their experience, cultural knowledge and common sense regarding the users' situation guided the design. Prototypes and fast delivery of working versions helped in getting user feedback even if early user focus proved to be a challenge as communication between developers and users suffered from several layers of indirection. Further challenges are the heterogeneity of users to be supported, a lack of awareness of usability methods, and lacking resources.","author_count":3,"contributors":["Teka, Degif","Dittrich, Yvonne","Kifle, Mesfin"],"cuid":["S01-000.00-381306"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Africa"],"country":["Ethiopia"],"glorg":["Addis Ababa University","All Global Affiliations"],"keyword":["Ethiopian IT Industry","Software development","Usability","User Centered Design","User feedback"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"usability challenges in an ethiopian software development organization","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/81850840/Usability_challenges_in_an_Ethiopian_software_deve.pdf","version":"Authors Final Version"},"id":"S01-000.00-381306","identifier":[{"id":"84974625230","type":"scopus"}],"ids":["itu-034483e5-c3c9-4c44-84a6-776e878a258e"],"keyword":["Ethiopian IT Industry","Software Development","Usability","User Centered Design","User Feedback"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-2AE6C30E6F2A80AAF5DBE4BAFDA70414"],"oa_link":[{"access":"oa","type":"rem","url":"https://www.researchgate.net/profile/Yvonne_Dittrich/publication/303323831_Usability_challenges_in_an_Ethiopian_software_development_organization/links/574328da08aea45ee84c5cd6.pdf","version":"Authors Final Version"},{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/81850840/Usability_challenges_in_an_Ethiopian_software_deve.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","country":"et","key":"addis ababa university","loc":["Ethiopia","Africa"],"name":"Addis Ababa University","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Software Engineering, Software Engineering","The Department, Software & Systems"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Degif","key":"tekapau","last":"Teka","name":"Teka, Degif","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Yvonne","key":"dittrichpau","last":"Dittrich","locid":"f2136570-f73c-446f-9fb0-6d9e461e2124","name":"Dittrich, Yvonne","orcid":"0000-0003-4757-3394","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mesfin","key":"kiflepau","last":"Kifle","name":"Kifle, Mesfin","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1145/2897586.2897604","isbn":["9781450341554"],"pages":"114-120","publisher":"Association for Computing Machinery","status":"p","title":"Proceedings of the 9th International Workshop on Cooperative and Human Aspects of Software Engineering, CHASE@ICSE 2016, Austin, Texas, USA, May 16, 2016"},"review":"Peer Reviewed","scoID":["2-s2.0-84974625230"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-034483e5-c3c9-4c44-84a6-776e878a258e"],"src":["ITU IT University of Copenhagen"],"title":"Usability challenges in an Ethiopian software development organization","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381306","year":"2016","yearsub":"2016"}
{"abstract":"Context Methods and processes, along with the tools to support them, are at the heart of software engineering as a discipline. However, as we all know, that often the use of the same method neither impacts software projects in a comparable manner nor the software they result in. What is lacking is an understanding of how methods affect software development. Objective The article develops a set of concepts based on the practice-concept in philosophy of sociology as a base to describe software development as social practice, and develop an understanding of methods and their application that explains the heterogeneity in the outcome. Practice here is not understood as opposed to theory, but as a commonly agreed upon way of acting that is acknowledged by the team. Method The article applies concepts from philosophy of sociology and social theory to describe software development and develops the concepts of method and method usage. The results and steps in the philosophical argumentation are exemplified using published empirical research. Results The article develops a conceptual base for understanding software development as social and epistemic practices, and defines methods as practice patterns that need to be related to, and integrated in, an existing development practice. The application of a method is conceptualized as a development of practice. This practice is in certain aspects aligned with the description of the method, but a method always under-defines practice. The implication for research, industrial software development and teaching are indicated. Conclusion The theoretical/philosophical concepts allow the explaining of heterogeneity in application of software engineering methods in line with empirical research results.","author_count":1,"contributors":["Dittrich, Yvonne"],"cuid":["S01-000.00-382700"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"1 contributor","cluster_size":1,"keyword":["Cooperative and human aspects of software engineering Software engineering methods Practice theory"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"what does it mean to use a method towards a practice theory for software engineering","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://pure.itu.dk/ws/files/82510715/Practice_Theory_3.3.pdf","version":"Authors Final Version"},"id":"S01-000.00-382700","identifier":[{"id":"84937231525","type":"scopus"}],"ids":["itu-5f063d8c-dc2c-4c39-b1eb-57a623f59e34"],"keyword":["Cooperative and human aspects of software engineering; Software engineering methods; Practice theory"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-5049FC55A541F63E55E831F50C16690E"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://pure.itu.dk/ws/files/82510715/Practice_Theory_3.3.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Software Engineering, Software Engineering","The Department, Software & Systems"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Yvonne","key":"dittrichpau","last":"Dittrich","locid":"f2136570-f73c-446f-9fb0-6d9e461e2124","name":"Dittrich, Yvonne","orcid":"0000-0003-4757-3394","rank":1,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.infsof.2015.07.001","issn":["09505849","18736025"],"issn_org":["09505849"],"journal":"Information and Software Technology","pages":"220-231","publisher":"Elsevier","status":"p","title":"Information and Software Technology","volume":"70"},"review":"Peer Reviewed","scoID":["2-s2.0-84949534612"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-5f063d8c-dc2c-4c39-b1eb-57a623f59e34"],"src":["ITU IT University of Copenhagen"],"title":"What does it mean to use a method? Towards a practice theory for software engineering","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382700","year":"2016","yearsub":"2016"}
{"abstract":"Software Engineering and Human-Computer Interaction look at the development process from different perspectives. They apparently use very different approaches, are inspired by different principles and address different needs. But, they definitively have the same goal: develop high quality software in the most effective way. The second edition of the workshop puts particular attention on efforts of the two communities in enhancing system quality. The research question discussed is: who, what, where, when, why, and how should we evaluate?","author_count":6,"contributors":["Abrahão, Silvia","Baldassarre, Maria Teresa","Caivano, Danilo","Dittrich, Yvonne","Lanzilotti, Rosa","Piccinno, Antonio"],"cuid":["S01-000.00-381712"],"event":{"acronym":"PROFES","title":"International Conference on Product-Focused Software Process Improvement"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Italy","Spain"],"glorg":["All Global Affiliations","University of Bari","University of Valencia"],"keyword":["Evaluation methods","Human Computer Interaction","Interdisciplinary Development","Software Engineering","System Quality"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"human factors in software development processes measuring system quality","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/81850958/HuFo_2016_Preface.pdf","version":"Authors Final Version"},"id":"S01-000.00-381712","identifier":[{"id":"84998785522","type":"scopus"}],"ids":["itu-1deb17a0-18a7-44fa-9602-2331a37647da"],"keyword":["Evaluation Methods","Human-Computer Interaction","Interdisciplinary Development","Software Engineering","System Quality"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-52329416483D9CC15AC881F0EC2F32F4"],"oa_link":[{"access":"oa","type":"rem","url":"https://www.researchgate.net/profile/Silvia_Abrahao/publication/309710570_Human_Factors_in_Software_Development_Processes_Measuring_System_Quality/links/581f1c4308ae40da2cb02a85.pdf","version":"Authors Final Version"},{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/81850958/HuFo_2016_Preface.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","country":"es","key":"university of valencia","loc":["Spain","Europe, EU","OECD"],"name":"University of Valencia","used":1},{"affno":"2","country":"it","key":"university of bari","loc":["Italy","Europe, EU","OECD"],"name":"University of Bari","used":1},{"affno":"3","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Software Engineering, Software Engineering","The Department, Software & Systems"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Silvia","key":"abrahãopau","last":"Abrahão","name":"Abrahão, Silvia","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Maria Teresa","key":"baldassarrepau","last":"Baldassarre","name":"Baldassarre, Maria Teresa","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Danilo","key":"caivanopau","last":"Caivano","name":"Caivano, Danilo","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Yvonne","key":"dittrichpau","last":"Dittrich","locid":"f2136570-f73c-446f-9fb0-6d9e461e2124","name":"Dittrich, Yvonne","orcid":"0000-0003-4757-3394","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Rosa","key":"lanzilottipau","last":"Lanzilotti","name":"Lanzilotti, Rosa","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Antonio","key":"piccinnopau","last":"Piccinno","name":"Piccinno, Antonio","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1007/978-3-319-49094-6_57","eisbn":["9783319490939"],"issn":["03029743"],"pages":"691-696","publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","subtitle":"Proceedings","title":"Product-Focused Software Process Improvement - 17th International Conference, PROFES 2016, Trondheim, Norway, November 22-24, 2016,"},"review":"Peer Reviewed","scoID":["2-s2.0-84998785522"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-1deb17a0-18a7-44fa-9602-2331a37647da"],"src":["ITU IT University of Copenhagen"],"title":"Human Factors in Software Development Processes: Measuring System Quality","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381712","year":"2016","yearsub":"2016"}
{"abstract":"Ethnography is a qualitative research method used to study people and cultures. It is largely adopted in disciplines outside software engineering, including different areas of computer science. Ethnography can provide an in-depth understanding of the socio-technological realities surrounding everyday software development practice, i.e., it can help to uncover not only what practitioners do, but also why they do it. Despite its potential, ethnography has not been widely adopted by empirical software engineering researchers, and receives little attention in the related literature. The main goal of this paper is to explain how empirical software engineering researchers would benefit from adopting ethnography. This is achieved by explicating four roles that ethnography can play in furthering the goals of empirical software engineering: to strengthen investigations into the social and human aspects of software engineering; to inform the design of software engineering tools; to improve method and process development; and to inform research programmes. This article introduces ethnography, explains its origin, context, strengths and weaknesses, and presents a set of dimensions that position ethnography as a useful and usable approach to empirical software engineering research. Throughout the paper, relevant examples of ethnographic studies of software practice are used to illustrate the points being made.","author_count":3,"contributors":["Sharp, Helen","Dittrich, Yvonne","Souza, Cleidson R. B. de"],"cuid":["S01-000.00-384100"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, South","Europe, Non-EU","OECD"],"country":["Brazil","United Kingdom"],"glorg":["All Global Affiliations","Federal University of Para","The Open University","Vale Institute of Technology"],"keyword":["Computer supported collaborative work","Design Tools and Techniques","Human Factors in Software Design","Software engineering process"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"the role of ethnographic studies in empirical software engineering","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82419396/The_Role_of_Ethnographic_Studies_in_Empirical_Software_Engineering.pdf","version":"Authors Final Version"},"id":"S01-000.00-384100","identifier":[{"id":"84983294257","type":"scopus"}],"ids":["itu-c1f15012-8172-460d-a7d6-b9219d804ae4"],"keyword":["Computer-supported collaborative work","Design Tools and Techniques","Human Factors in Software Design","Software Engineering Process"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-9A9552155B1177DDAA3E49941360A810"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82419396/The_Role_of_Ethnographic_Studies_in_Empirical_Software_Engineering.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","country":"gb","key":"the open university","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"The Open University","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Software Engineering, Software Engineering","The Department, Software & Systems"],"nora_code":"DI-U-ITU","used":1},{"affno":"3","country":"br","key":"vale institute of technology","loc":["Brazil","America, South"],"name":"Vale Institute of Technology","used":1},{"affno":"4","country":"br","key":"federal university of para","loc":["Brazil","America, South"],"name":"Federal University of Para","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Helen","key":"sharppau","last":"Sharp","name":"Sharp, Helen","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Yvonne","key":"dittrichpau","last":"Dittrich","locid":"f2136570-f73c-446f-9fb0-6d9e461e2124","name":"Dittrich, Yvonne","orcid":"0000-0003-4757-3394","rank":2,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Cleidson R. B. de","key":"souzapau","last":"Souza","name":"Souza, Cleidson R. B. de","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1109/tse.2016.2519887","issn":["00985589","19393520"],"issn_org":["00985589"],"issue":"8","journal":"IEEE Transactions on Software Engineering","pages":"786-804","publisher":"IEEE","status":"p","title":"IEEE Transactions on Software Engineering","title_org":"I E E E Transactions on Software Engineering","volume":"42"},"review":"Peer Reviewed","scoID":["2-s2.0-84983294257"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-c1f15012-8172-460d-a7d6-b9219d804ae4"],"src":["ITU IT University of Copenhagen"],"title":"The Role of Ethnographic Studies in Empirical Software Engineering","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384100","year":"2016","yearsub":"2016"}
{"abstract":"Whilst knowledge transfer is one of the most widely-claimed benefits of pair programming, little is known about how knowledge transfer is achieved in this setting. This is particularly pertinent for novice−expert constellations, but knowledge transfer takes place to some degree in all constellations. We ask “what does it take to be a good “expert” and how can a “novice” best learn from a more experienced developer?”. An in-depth investigation of video and audio excerpts of professional pair programming sessions using Interaction Analysis reveals: six teaching strategies, ranging from “giving direct instructions” to “subtle hints”; and challenges and benefits for both partners. These strategies are instantiations of some but not all teaching methods promoted in cognitive apprenticeship; novice articulation, reflection and exploration are not seen in the data. The context of pair programming influences the strategies, challenges and benefits, in particular the roles of driver and navigator and agile prioritisation which considers business value rather than educational progression. Utilising these strategies more widely and recognizing the challenges and benefits for both partners will help developers to maximise the benefits from pairing sessions.","author_count":4,"contributors":["Plonka, Laura","Sharp, Helen","van der Linden, Janet","Dittrich, Yvonne"],"cuid":["S01-000.00-382814"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","The Open University"],"keyword":["Cognitive apprenticeship","Interaction analysis","Knowledge transfer","Pair programming","Qualitative analysis"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"knowledge transfer in pair programming an in depth analysis","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/81825741/revised_submission.pdf","version":"Authors Final Version"},"id":"S01-000.00-382814","identifier":[{"id":"84907888023","type":"scopus"}],"ids":["itu-66d84b99-c2f2-4a7a-a8b7-c90c5bfa5c13"],"keyword":["Cognitive apprenticeship","Interaction analysis","Knowledge transfer","Pair programming","Qualitative analysis"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-FC2DC50FBA501B59791E0863689673EF"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/81825741/revised_submission.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","country":"gb","key":"the open university","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"The Open University","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Software Engineering, Software Engineering","The Department, Software & Systems"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Laura","key":"plonkapau","last":"Plonka","name":"Plonka, Laura","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Helen","key":"sharppau","last":"Sharp","name":"Sharp, Helen","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Janet","key":"vanderlindenpau","last":"van der Linden","name":"van der Linden, Janet","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Yvonne","key":"dittrichpau","last":"Dittrich","locid":"f2136570-f73c-446f-9fb0-6d9e461e2124","name":"Dittrich, Yvonne","orcid":"0000-0003-4757-3394","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.ijhcs.2014.09.001","issn":["10715819","10959300"],"issn_org":["10715819"],"journal":"International Journal of Human-Computer Studies","pages":"66-78","publisher":"Academic Press","status":"p","title":"International Journal of Human-Computer Studies","volume":"73"},"review":"Peer Reviewed","scoID":["2-s2.0-84907888023"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-66d84b99-c2f2-4a7a-a8b7-c90c5bfa5c13"],"src":["ITU IT University of Copenhagen"],"title":"Knowledge transfer in pair programming: An in-depth analysis","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382814","year":"2015","yearsub":"2015"}
