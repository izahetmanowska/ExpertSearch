{"author_count":4,"contributors":["Gonsalves, Timothy .A.","Dittrich, Yvonne","Vaidyanathan, Lakshmi","Jhunjhunwala, Ashok"],"cuid":["S01-000.00-384425"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"prototyping socio technical systems for banking services for rural india","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"id":"S01-000.00-384425","ids":["itu-d6aa4377-77e5-4ccc-bc7a-b86d7427664c"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-D1C16D27DEC54A4C87808C09530E8534"],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Software Engineering, Software Engineering","The Department, Software & Systems"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Timothy .A.","key":"gonsalvespau","last":"Gonsalves","name":"Gonsalves, Timothy .A.","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Yvonne","key":"dittrichpau","last":"Dittrich","locid":"f2136570-f73c-446f-9fb0-6d9e461e2124","name":"Dittrich, Yvonne","orcid":"0000-0003-4757-3394","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Lakshmi","key":"vaidyanathanpau","last":"Vaidyanathan","name":"Vaidyanathan, Lakshmi","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Ashok","key":"jhunjhunwalapau","last":"Jhunjhunwala","name":"Jhunjhunwala, Ashok","rank":4,"rolecode":"pau"}],"pub":{"isbn":["9781450310512"],"publisher":"Association for Computing Machinery","status":"p","title":"Learning from Marginalized Users"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-d6aa4377-77e5-4ccc-bc7a-b86d7427664c"],"src":["ITU IT University of Copenhagen"],"title":"Prototyping Socio-Technical Systems for Banking Services for Rural India.","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384425","year":"2012","yearsub":"2012"}
{"abstract":"The aim of this paper is to present a design strategy for collaborative knowledge-management systems based on a semiotic approach. The contents and structure of experts' knowledge is highly dependent on professional or individual practice. Knowledge-management systems that support cooperation between experts from different (sub-)fields need to be situated and tailored to provide effective support even if the common aspects of the data need to be described by ontologies that are generic in respect to the sub-disciplines involved. To understand and approach this design problem, we apply a semiotic perspective to computer application and human–computer interaction. From a semiotic perspective, the computer application is both a message from the designer to the user about the structure of the problem domain, as well as about interaction with it, and a structured channel for the user's communication with herself, himself or other users of the software. Tailoring or “end-user development” – i.e. adapting the knowledge-management system to a specific (sub-)discipline, task or context – then refines both the message and adapts the structure of the interaction to the situated requirements. The essential idea of this paper is to define a new perspective for designing and developing interactive systems to support collaborative knowledge management. The key concept is to involve domain experts in participatory knowledge design for mapping and translating their professional models into the proper vocabularies, notations, and suitable visual structures for navigating among interface elements. To this end, the paper describes how our semiotic approach supports processes for representing, storing, accessing, and transferring knowledge through which the information architecture of an interactive system can be defined. Finally, the results of applying our approach to a real-world case in an archaeological context are presented.","author_count":3,"contributors":["Valtolina, Stefano","Barricelli, Barbara Rita","Dittrich, Yvonne"],"cuid":["S01-000.00-381302"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Co design"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"participatory knowledge management design a semiotic approach","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.jvlc.2011.11.007","version":"Other Version"},"id":"S01-000.00-381302","identifier":[{"id":"84858288333","type":"scopus"}],"ids":["itu-0316a004-a3d9-43ea-a9ea-ba1c5092d0c4"],"keyword":["Co-design"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-0FC99B0095176E51EEB374AA85A3874F"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.jvlc.2011.11.007","version":"Other Version"},{"access":"oa","type":"rem","url":"http://www.sciencedirect.com/science/article/pii/S1045926X11000784","version":"Other Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Software Engineering, Software Engineering","The Department, Software & Systems"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Stefano","key":"valtolinapau","last":"Valtolina","name":"Valtolina, Stefano","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Barbara Rita","key":"barricellipau","last":"Barricelli","name":"Barricelli, Barbara Rita","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Yvonne","key":"dittrichpau","last":"Dittrich","locid":"f2136570-f73c-446f-9fb0-6d9e461e2124","name":"Dittrich, Yvonne","orcid":"0000-0003-4757-3394","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.jvlc.2011.11.007","issn":["1045926X","10958533"],"issn_org":["1045926X"],"issue":"2","journal":"Journal of Visual Languages and Computing","pages":"103-115","publisher":"Academic Press","status":"p","title":"Journal of Visual Languages and Computing","volume":"23"},"review":"Peer Reviewed","scoID":["2-s2.0-84858288333"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-0316a004-a3d9-43ea-a9ea-ba1c5092d0c4"],"src":["ITU IT University of Copenhagen"],"title":"Participatory knowledge-management design: A semiotic approach","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381302","year":"2012","yearsub":"2012"}
{"abstract":"Collaboration between industry and academia supports improvement and innovation in industry and helps to ensure industrial relevance in academic research. This article presents an exploratory study of factors for successful collaboration between industry and academia. A survey designed for data collection was first conducted in Sweden and then replicated in Australia. The context for the two studies is different, thus forming a starting point for potential generalizations in the future: the industrial side of collaboration is the key element for successful collaboration, with key factors being buy-in and support from company management and collaboration champion on site. These findings may help industry and academia to set up successful collaborative ventures in the future","author_count":14,"contributors":["Wohlin, Claes","Aurum, Aybüke","Angelis, Lefteris","Phillips, Laura","Dittrich, Yvonne","Gorschek, Tony","Grahn, Håkan","Henningsson, Kenneth","Kågström, Simon","Low, Graham","Rovegård, Per","Tomaszewski, Piotr","Toorn, van, Christine","Winter, Jeff"],"cuid":["S01-000.00-383384"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Collaboration","Factors","Industry","Success","Technology","Transfer"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"the success factors powering industry academia collaboration","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84857563440","version":"Other Version"},"id":"S01-000.00-383384","identifier":[{"id":"84857563440","type":"scopus"}],"ids":["itu-8f93001d-4c4d-4d26-97cc-ddb2c5953151"],"keyword":["Collaboration","Factors","Industry","Success","Technology","Transfer"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-5DA18F177675164AD65C2D70374BA232"],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Software Engineering, Software Engineering","The Department, Software & Systems"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Claes","key":"wohlinpau","last":"Wohlin","name":"Wohlin, Claes","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Aybüke","key":"aurumpau","last":"Aurum","name":"Aurum, Aybüke","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Lefteris","key":"angelispau","last":"Angelis","name":"Angelis, Lefteris","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Laura","key":"phillipspau","last":"Phillips","name":"Phillips, Laura","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Yvonne","key":"dittrichpau","last":"Dittrich","locid":"f2136570-f73c-446f-9fb0-6d9e461e2124","name":"Dittrich, Yvonne","orcid":"0000-0003-4757-3394","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Tony","key":"gorschekpau","last":"Gorschek","name":"Gorschek, Tony","rank":6,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Håkan","key":"grahnpau","last":"Grahn","name":"Grahn, Håkan","rank":7,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Kenneth","key":"henningssonpau","last":"Henningsson","name":"Henningsson, Kenneth","rank":8,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Simon","key":"kågströmpau","last":"Kågström","name":"Kågström, Simon","rank":9,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Graham","key":"lowpau","last":"Low","name":"Low, Graham","rank":10,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Per","key":"rovegårdpau","last":"Rovegård","name":"Rovegård, Per","rank":11,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Piotr","key":"tomaszewskipau","last":"Tomaszewski","name":"Tomaszewski, Piotr","rank":12,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Christine","key":"toornvanpau","last":"Toorn, van","name":"Toorn, van, Christine","rank":13,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jeff","key":"winterpau","last":"Winter","name":"Winter, Jeff","rank":14,"rolecode":"pau"}],"pub":{"issn":["07407459"],"issue":"2","journal":"IEEE Software","pages":"67-73","publisher":"IEEE","status":"p","title":"IEEE Software","title_org":"I E E E Software","volume":"29"},"review":"Peer Reviewed","scoID":["2-s2.0-84857563440"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-8f93001d-4c4d-4d26-97cc-ddb2c5953151"],"src":["ITU IT University of Copenhagen"],"title":"The Success Factors Powering Industry-Academia Collaboration","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383384","year":"2012","yearsub":"2012"}
{"abstract":"In this article, the gap between participatory design of services and planning processes is identified. This means that any innovations in service design – whether technological, social, or locality-based – are not fully developed. The authors address the relationship between operational design and strategic planning. The article feeds some of the insights gained from participatory design into debates about collaborative and communicative planning by drawing on two exemplars. One focuses on creating a synergy between designing and planning in transforming neighborhood-based children’s services: the other discusses the design of Web 2.0 for on-line public consultancy for comprehensive planning and for mobile services for disabled people. All require synergies between operational design and strategic planning to support participation in collaborative planning for accessibility in urban spaces. The article shows how the development of design constituencies within various contexts of participatory design provides a vehicle for developing collaborative and communicative planning.","author_count":4,"contributors":["Wessels, Bridgitte","Dittrich, Yvonne","Ekelin, Anelie","Eriksén, Sara"],"cuid":["S01-000.00-384343"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","Nordic","OECD"],"country":["Sweden","United Kingdom"],"glorg":["All Global Affiliations","Blekinge Institute of Technology","University of Sheffield"],"keyword":["E Planning","E government","Information Technology IT Infrastructure","Innovation","Participatory Design","Synergy"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"creating synergies between participatory design of e services and collaborative planning","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-384343","ids":["itu-d1b41e50-3294-4dd3-b9b6-743353354426"],"keyword":["E-Government","E-Planning","Information Technology (IT) Infrastructure","Innovation","Participatory Design","Synergy"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-412E5B3333DC88E71A7DD3C0AF61B010"],"org":[{"affno":"1","country":"gb","key":"university of sheffield","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Sheffield","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Software Engineering, Software Engineering","The Department, Software & Systems"],"nora_code":"DI-U-ITU","used":1},{"affno":"3","country":"se","key":"blekinge institute of technology","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Blekinge Institute of Technology","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Bridgitte","key":"wesselspau","last":"Wessels","name":"Wessels, Bridgitte","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Yvonne","key":"dittrichpau","last":"Dittrich","locid":"f2136570-f73c-446f-9fb0-6d9e461e2124","name":"Dittrich, Yvonne","orcid":"0000-0003-4757-3394","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Anelie","key":"ekelinpau","last":"Ekelin","name":"Ekelin, Anelie","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Sara","key":"eriksénpau","last":"Eriksén","name":"Eriksén, Sara","rank":4,"rolecode":"pau"}],"pub":{"issn":["21609918","21609926"],"issn_org":["21609918"],"issue":"3","journal":"International Journal of E-Planning Research","pages":"1-16","publisher":"I