ed"]},"sid":["itu-9ead329e-331d-4056-9a41-7238df054a8a"],"src":["ITU IT University of Copenhagen"],"title":"Action Research Booklet","type":"Book","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-747253","year":"2024","yearsub":"2024"}
{"abstract":"Ethnography has become one of the established methods for empirical research on software engineering. Although there is a wide variety of introductory books available, there has been no material targeting software engineering students particularly, until now.In this chapter, we provide an introduction to teaching and learning ethnography for faculty teaching ethnography to software engineering graduate students and for students themselves of such courses. The contents of the chapter focuses on what we think is the core basic knowledge for newbies to ethnography as a research method. We complement the text with proposals for exercises, tips for teaching and pitfalls that we and our students have experienced. The chapter is designed to support part of a course on empirical software engineering and provides pointers and literature for further reading.","author_count":7,"contributors":["Dittrich, Yvonne","Sharp, Helen, C.","Souza, Cleidson de"],"cuid":["S01-000.00-789564"],"filters":{"added":"2025-02","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, South","Europe, Non-EU","OECD"],"country":["Brazil","United Kingdom"],"glorg":["All Global Affiliations","Federal University of Technology - Paraná","The Open University"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"teaching and learning ethnography for software engineering contexts","src":["itu"],"src-code":["DI-U-ITU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"rem","url":"https://arxiv.org/abs/2407.04596","version":"Authors Final Version"},"id":"S01-000.00-789564","identifier":[{"id":"105002497423","type":"scopus"}],"ids":["itu-8b70e5a6-4eac-4ca6-81a9-3d1d05b6a701"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-98CAD1865B0B81637994B5278C90385F"],"oa_link":[{"access":"oa","license":"CC BY","type":"rem","url":"https://arxiv.org/abs/2407.04596","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Software Engineering, Software Engineering","IT University of Copenhagen, The Maritime Hub"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"gb","key":"the open university","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"The Open University","used":1},{"affno":"3","country":"br","key":"federal university of technology paraná","loc":["Brazil","America, South"],"name":"Federal University of Technology - Paraná","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Yvonne","key":"dittrichpau","last":"Dittrich","locid":"f2136570-f73c-446f-9fb0-6d9e461e2124","name":"Dittrich, Yvonne","orcid":"0000-0003-4757-3394","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Helen, C.","key":"sharppau","last":"Sharp","name":"Sharp, Helen, C.","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Cleidson de","key":"souzapau","last":"Souza","name":"Souza, Cleidson de","rank":3,"rolecode":"pau"},{"affno":"","first":"Daniel","key":"mendezpedh","last":"Mendez","name":"Mendez, Daniel","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Paris","key":"avgerioupedh","last":"Avgeriou","name":"Avgeriou, Paris","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Marcos","key":"kalinowskipedh","last":"Kalinowski","name":"Kalinowski, Marcos","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Nauman Bin","key":"alipedh","last":"Ali","name":"Ali, Nauman Bin","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-031-71769-7_21","isbn":["9783031717697"],"pages":"593-630","place":"Cham","publisher":"Springer","status":"p","title":"Handbook on Teaching Empirical Software Engineering"},"review":"Peer Reviewed","scoID":["2-s2.0-105002497423"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-8b70e5a6-4eac-4ca6-81a9-3d1d05b6a701"],"src":["ITU IT University of Copenhagen"],"title":"Teaching and Learning Ethnography for Software Engineering Contexts","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-789564","year":"2024","yearsub":"2024"}
{"abstract":"Programming robots presents significant challenges, including high costs, extensive time commitments and steep learning curves, particularly for individuals lacking technical background in engineering. These barriers have been partially mitigated by the emergence of end-user development methodologies. Yet existing approaches often fall short in equipping users with the necessary software engineering competencies to develop comprehensive robot behaviors or to effectively maintain and re-purpose their creations. In this paper, we introduce a novel end-user development approach designed to empower physical therapists to independently specify robot-assisted physical training exercises, eliminating the need for robotics experts' intervention. Our approach is based on a set of design goals obtained through a participatory design study with experts in the field. It utilizes a textual domain-specific language (DSL) that enables users to define expected robot behaviors through Behaviour-Driven Development (BDD) scenarios. This paper discusses key themes, design objectives, and the evolution of requirements that emerged from an evaluative workshop.","author_count":4,"contributors":["De La Rosa Gutierrez, Jose Pablo","Silva, Thiago Rocha","Dittrich, Yvonne","Sørensen, Anders Stengaard"],"cuid":["S01-000.00-747265"],"filters":{"added":"2024-08","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Behaviour Driven Development BDD","CCS Concepts","Computer systems organization","Domain Specific Languages DSLs","Empirical studies in HCI","End User Development","External interfaces for robotics","Graphical user interfaces","HCI design and evaluation methods","Human centered computing","Low Code Development","Robot programming"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-SDU"]},"level3all":["DI-U-ITU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"design goals for end user development of robot assisted physical training activities a participatory design study","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"rem","url":"https://dl.acm.org/doi/pdf/10.1145/3664632","version":"Published Version"},"id":"S01-000.00-747265","identifier":[{"id":"85196436466","type":"scopus"}],"ids":["itu-cdd68bf3-b3d6-49a1-a91e-6081b55ed3b9"],"keyword":["Behaviour-Driven Development (BDD)","CCS Concepts","Computer systems organization","Domain-Specific Languages (DSLs)","Empirical studies in HCI","End-User Development","External interfaces for robotics","Graphical user interfaces","HCI design and evaluation methods","Human-centered computing","Low-Code Development","Robot Programming"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-3-5-2D6628F09D7EC734D5AA02940B6BD1DE"],"oa_link":[{"access":"oa","license":"CC BY","type":"rem","url":"https://dl.acm.org/doi/pdf/10.1145/3664632","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["University of Southern Denmark"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Software Engineering, Software Engineering"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jose Pablo","key":"delarosagutierrezpau","last":"De La Rosa Gutierrez","name":"De La Rosa Gutierrez, Jose Pablo","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Thiago Rocha","key":"silvapau","last":"Silva","name":"Silva, Thiago Rocha","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Yvonne","key":"dittrichpau","last":"Dittrich","locid":"f2136570-f73c-446f-9fb0-6d9e461e2124","name":"Dittrich, Yvonne","orcid":"0000-0003-4757-3394","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders Stengaard","key":"sørensenpau","last":"Sørensen","name":"Sørensen, Anders Stengaard","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1145/3664632","issue":"EICS","journal":"Proc. ACM Hum. Comput. Interact.","pages":"1-31","publisher":"Association for Computing Machinery","status":"p","title":"Proc. ACM Hum. Comput. Interact.","title_org":"Proc. ACM Hum.-Comput. Interact.","volume":"8"},"review":"Peer Reviewed","scoID":["2-s2.0-85196436466"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["itu-cdd68bf3-b3d6-49a1-a91e-6081b55ed3b9"],"src":["ITU IT University of Copenhagen"],"title":"Design Goals for End-User Development of Robot-Assisted Physical Training Activities: A Participatory Design Study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-747265","year":"2024","yearsub":"2024"}
{"abstract":"Action research provides the opportunity to explore the usefulness and usability of software engineering methods in industrial settings and makes it possible to develop methods, tools and techniques with software engineering practitioners. However, as the research moves beyond the observational approach, it requires a different kind of interaction with the software development organisation. This makes action research a challenging endeavour, and it makes it difficult to teach action research through a course that goes beyond explaining the principles. This chapter is intended to support learning and teaching action research, by providing a rich set of examples and identifying tools that we found helpful in our action research projects. The core of this chapter focusses on our interaction with the participating developers and domain experts and the organisational setting. This chapter is structured around a set of challenges that reoccurred in the action research projects in which the authors participated. Each section is accompanied by a toolkit that presents related techniques and tools. The exercises are designed to explore the topics and practise using the tools and techniques presented. We hope the material in this chapter encourages researchers who are new to action research to further explore this promising opportunity.","author_count":7,"contributors":["Dittrich, Yvonne","Bolmsten, Johan","Seidelin, Cathrine"],"cuid":["S01-000.00-789560"],"filters":{"added":"2025-02","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"country":["Sweden"],"glorg":["All Global Affiliations","World Maritime University, Malmö"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-NOVO"],"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-PR-NOVO","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"action research with industrial software engineering an educational perspective","src":["itu"],"src-code":["DI-U-ITU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/105002509303","version":"Other Version"},"id":"S01-000.00-789560","identifier":[{"id":"105002509303","type":"scopus"}],"ids":["itu-7c9d27d5-d359-4167-8bba-3c12e5d3a302"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-E0FEDCB8984FC856C484D55929D08810"],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Software Engineering, Software Engineering","IT University of Copenhagen, The Maritime Hub"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"se","key":"world maritime university malmö","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"World Maritime University, Malmö","used":1},{"affno":"3","country":"dk","key":"novo nordisk","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-NOVO","l3nl":"Novo Nordisk","l3nn":"Novo Nordisk","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Novo Nordisk","namevar":["Novo Nordisk"],"nora_code":"DI-PR-NOVO","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Yvonne","key":"dittrichpau","last":"Dittrich","locid":"f2136570-f73c-446f-9fb0-6d9e461e2124","name":"Dittrich, Yvonne","orcid":"0000-0003-4757-3394","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Johan","key":"bolmstenpau","last":"Bolmsten","name":"Bolmsten, Johan","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Cathrine","key":"seidelinpau","last":"Seidelin","name":"Seidelin, Cathrine","rank":3,"rolecode":"pau"},{"affno":"","first":"Daniel","key":"mendezpedh","last":"Mendez","name":"Mendez, Daniel","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Paris","key":"avgerioupedh","last":"Avgeriou","name":"Avgeriou, Paris","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Marcos","key":"kalinowskipedh","last":"Kalinowski","name":"Kalinowski, Marcos","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Nauman Bin","key":"alipedh","last":"Ali","name":"Ali, Nauman Bin","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-031-71769-7_15","isbn":["9783031717697"],"pages":"413-461","place":"Cham","publisher":"Springer","status":"p","title":"Handbook on Teaching Empirical Software Engineering"},"review":"Peer Reviewed","scoID":["2-s2.0-105002509303"],"search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Novo Nordisk","Private Research","Universities"],"PST":["Published"]},"sid":["itu-7c9d27d5-d359-4167-8bba-3c12e5d3a302"],"src":["ITU IT University of Copenhagen"],"title":"Action Research with Industrial Software Engineering: An Educational Perspective","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-789560","year":"2024","yearsub":"2024"}
{"abstract":"Programming robots presents significant challenges, including high costs, extensive time commitments and steep learning curves, particularly for individuals lacking technical background in engineering. These barriers have been partially mitigated by the emergence of end-user development methodologies. Yet existing approaches often fall short in equipping users with the necessary software engineering competencies to develop comprehensive robot behaviors or to effectively maintain and re-purpose their creations. In this paper, we introduce a novel end-user development approach designed to empower physical therapists to independently specify robot-assisted physical training exercises, eliminating the need for robotics experts' intervention. Our approach is based on a set of design goals obtained through a participatory design study with experts in the field. It utilizes a textual domain-specific language (DSL) that enables users to define expected robot behaviors through Behaviour-Driven Development (BDD) scenarios. This paper discusses key themes, design objectives, and the evolution of requirements that emerged from an evaluative workshop.","author_count":4,"contributors":["Gutierrez, Jose Pablo De la Rosa","Silva, Thiago Rocha","Dittrich, Yvonne","Sørensen, Anders Stengaard"],"cuid":["S01-000.00-750466"],"event":{"end":"2024-06-28","place":"Cagliari, it","start":"2024-06-24","title":"The 16th ACM SIGCHI Symposium on Engineering Interactive Computing Systems (EICS)","year":"2024"},"filters":{"added":"2024-08","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Gutierrez, Jose Pablo De la Rosa"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-SDU"]},"level3all":["DI-U-ITU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"design goals for end user development of robot assisted physical training activities a participatory design study","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1145/3664632","version":"Published Version"},"id":"S01-000.00-750466","identifier":[{"id":"85196436466","type":"scopus"}],"ids":["sdu-5666e785-10c0-4f04-a788-7c9f8cbbe8a5"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-3-5-2D6628F09D7EC734D5AA02940B6BD1DE"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/266011668/Design_Goals_for_End-User_Development_of_Robot-Assisted_Physical_Training_Activities_A_Participatory_Design_Study.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1145/3664632","version":"Published Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Engineering, The Maersk Mc-Kinney Moller Institute","SDU, The Faculty of Engineering, The Maersk Mc-Kinney Moller Institute, SDU UAS Center"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jose Pablo De La Rosa","key":"gutierrezpau","last":"Gutierrez","locid":"8a5174fd-f76d-4e58-980b-6c9e0f1d55f6","name":"Gutierrez, Jose Pablo De la Rosa","name_org":"Gutierrez, Jose Pablo De La Rosa","orcid":"0000-0002-1879-3833","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Thiago Rocha","key":"silvapau","last":"Silva","locid":"bac2db00-9e7d-4ee1-bc9f-a0fd397042ad","name":"Silva, Thiago Rocha","orcid":"0000-0001-8961-4663","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Yvonne","key":"dittrichpau","last":"Dittrich","name":"Dittrich, Yvonne","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anders Stengaard","key":"sørensenpau","last":"Sørensen","locid":"bbd0410a-e7d2-41fd-b535-5702797b1670","name":"Sørensen, Anders Stengaard","orcid":"0000-0003-0184-7281","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1145/3664632","issn":["25730142"],"issue":"EICS","journal":"Proceedings of the ACM on Human-Computer Interaction","paperid":"258","publisher":"Association for Computing Machinery","status":"p","title":"Proceedings of the ACM on Human-Computer Interaction","volume":"8"},"review":"Peer Reviewed","scoID":["2-s2.0-85196436466"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-5666e785-10c0-4f04-a788-7c9f8cbbe8a5"],"src":["SDU University of Southern Denmark"],"title":"Design Goals for End-User Development of Robot-Assisted Physical Training Activities : A Participatory Design Study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-750466","year":"2024","yearsub":"2024"}
{"abstract":"This paper investigates and evaluates the role of bug Triage in software evolution and maintenance. Traditionally, Triage decision-making has been based on bug reports. Decisionmaking concerns whether a bug is to be fixed and, if so, when and by whom. Research in this area focuses on automation of some aspects of bug fixing, enhancing information on bugs reports, and most significantly, automating Triage through Machine Learning (ML) techniques. Our paper is based on an ethnographic study of a software team, and includes Triage and Stand-up meeting observation, analysis of bug report documents, study of the development environment and ad-hoc meetings. The framework of Distributed Cognition for Teamwork served as a theoretical lens for this study. Based on the analysis 33 complex bugs, the paper argues that Triage was used as a major information hub for discussing a wide range of information (e.g. about organisational processes and development of the software), allowing knowledge development that is valuable in software evolution beyond bug fixing alone.","author_count":2,"contributors":["Dittrich, Yvonne","Begum, Marjahan"],"cuid":["S01-000.00-776394"],"filters":{"added":"2025-01","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","University of Nottingham"],"keyword":["Collaborative and social computing","Empirical studies","Software Engineering"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"nr","rtype":["clu"],"sorti":"what happens in triage an empirical study of bug triage in software product evolution","src":["itu"],"src-code":["DI-U-ITU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/107765844/Technical_Report_IT_University_210_DEC_2024_.pdf","version":"Published Version"},"id":"S01-000.00-776394","ids":["itu-402bda2b-0cb3-496c-b0de-497f583656ee"],"keyword":["Collaborative and social computing","DiCoT","Empirical studies","Software engineering"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-6646679F6810D07D1F4BBC579C75EFFE"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/107765844/Technical_Report_IT_University_210_DEC_2024_.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Software Engineering, Software Engineering"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"gb","key":"university of nottingham","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Nottingham","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Yvonne","key":"dittrichpau","last":"Dittrich","locid":"f2136570-f73c-446f-9fb0-6d9e461e2124","name":"Dittrich, Yvonne","orcid":"0000-0003-4757-3394","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Marjahan","key":"begumpau","last":"Begum","name":"Begum, Marjahan","rank":2,"rolecode":"pau"}],"pub":{"issn":["16006100"],"issue":"TR-2024-210","pages":"13","place":"Copenhagen","publisher":"IT-Universitetet i København","repno":"IT University Technical Report Series, TR-2024-210","series":"IT University Technical Report Series","status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-402bda2b-0cb3-496c-b0de-497f583656ee"],"src":["ITU IT University of Copenhagen"],"title":"What happens in Triage? : An Empirical Study of Bug Triage in Software Product Evolution?","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-776394","year":"2024","yearsub":"2024"}
{"abstract":"This report documents the program and the outcomes of Dagstuhl Seminar 23042 “Quality of Sustainable Experience (QoSE)”. The seminar aimed to bring together people from different fields, perspectives and backgrounds. The participants discussed how experiences – as the main selling point of products and services – in various ICT-related domains can be made more sustainable, how they can contribute to relevant sustainable development goals, and how the quality and degree of sustainability of such experiences may be evaluated and be better understood. The main objectives of the seminar were to foster new alliances, to inspire, to trigger scientific renewal, as well as to identify future opportunities and research challenges through a hands-on approach.","author_count":5,"contributors":["Dittrich, Yvonne","De Moor, Katrien","Fiedler, Markus","Jhunjhunwala, Ashok","Raake, Alexander"],"cuid":["S01-000.00-718918"],"event":{"end":"2014-11-08","place":"Saarbrücken, de","start":"2014-11-07","title":"Quality-Television - Zwischen Laudatio und In Memoriam","year":"2014"},"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Asia, South","Europe, EU","Europe, Non-EU","Nordic","OECD"],"country":["Germany","India","Norway","Sweden"],"glorg":["All Global Affiliations","Blekinge Institute of Technology","Department of Neuroscience, NTNU, Norway.","Ilmenau University of Technology","Indian Institute of Technology Mandi"],"keyword":["Design for sustainability","Digitalisation","Human Computer Interaction","Information and communication technology","Wellbeing"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"nr","rtype":["clu"],"sorti":"000000000003 000000000006 sustainable software engineering for sustainable development","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.4230/DagRep.13.1.184","version":"Published Version"},"id":"S01-000.00-718918","ids":["itu-ce7a1ee0-200f-431a-89ce-f0467a11788e"],"keyword":["Design for Sustainability","Digitalisation,","Human-Computer Interaction,","Information and Communication Technology,","Wellbeing"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-1DE747A9381AADE7B794410821F88806"],"oa_link":[{"access":"oa","license":"CC BY","type":"rem","url":"https://drops.dagstuhl.de/storage/04dagstuhl-reports/volume13/issue01/23042/DagRep.13.1.184/DagRep.13.1.184.pdf#page=7","version":"Published Version"},{"access":"oa","license":"CC BY","type":"rem","url":"https://drops.dagstuhl.de/storage/04dagstuhl-reports/volume13/issue01/23042/DagRep.13.1.184/DagRep.13.1.184.pdf#page=20","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.4230/DagRep.13.1.184","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Software Engineering, Software Engineering"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"no","key":"department of neuroscience ntnu norway","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"Department of Neuroscience, NTNU, Norway.","used":1},{"affno":"3","country":"se","key":"blekinge institute of technology","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Blekinge Institute of Technology","used":1},{"affno":"4","country":"in","key":"indian institute of technology mandi","loc":["India","Asia, South"],"name":"Indian Institute of Technology Mandi","used":1},{"affno":"5","country":"de","key":"ilmenau university of technology","loc":["Germany","Europe, EU","OECD"],"name":"Ilmenau University of Technology","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Yvonne","key":"dittrichpau","last":"Dittrich","locid":"f2136570-f73c-446f-9fb0-6d9e461e2124","name":"Dittrich, Yvonne","orcid":"0000-0003-4757-3394","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Katrien","key":"demoorped","last":"De Moor","name":"De Moor, Katrien","rank":2,"role":"Editor","rolecode":"ped"},{"affno":"3","corresponding":null,"first":"Markus","key":"fiedlerped","last":"Fiedler","name":"Fiedler, Markus","rank":3,"role":"Editor","rolecode":"ped"},{"affno":"4","corresponding":null,"first":"Ashok","key":"jhunjhunwalaped","last":"Jhunjhunwala","name":"Jhunjhunwala, Ashok","rank":4,"role":"Editor","rolecode":"ped"},{"affno":"5","corresponding":null,"first":"Alexander","key":"raakeped","last":"Raake","name":"Raake, Alexander","rank":5,"role":"Editor","rolecode":"ped"}],"pub":{"doi":"10.4230/dagrep.13.1.184","issn":["21925283"],"issue":"1","journal":"Dagstuhl Reports","pages":"190-191","publisher":"Schloss Dagstuhl - Leibniz-Zentrum fuer Informatik GmbH","status":"p","title":"Dagstuhl Reports","volume":"13"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-ce7a1ee0-200f-431a-89ce-f0467a11788e"],"src":["ITU IT University of Copenhagen"],"title":"3.6 Sustainable Software Engineering for Sustainable Development","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-718918","year":"2023","yearsub":"2023"}
{"abstract":"Environmental, social, and governance (ESG) performance evaluation criteria have become increasingly important for Fintech as tools to assess a company’s ability to generate environmental and societal value. On the one hand, Fintech is well-positioned to take advantage of ESG in their business models. The application of digital technology to financial services generates a significant amount of financial data that can be both shared with and analysed by governments and investors to inform the development of ESG guidelines. On the other hand, Fintech businesses are also under compliance pressure to integrate ESG in their own financial reporting and operations, as well as to adapt to new performance assessment criteria. ESG becomes even more important as customers and investors in Fintech businesses pay increasing attention to ESG performance, and talent and founders focus more and more on being sustainability-conscious and impact-driven. This report provides an overview of the current ESG reporting status of Fintech businesses in Denmark and the European Union (EU). We focus on startups as they tend to be disproportionately burdened by compliance and investment pressure due to their limited resources. Our goal is to take a first step towards developing a collective ESG reporting model for Fintech startups that enhances their competitive advantage despite a volatile economic and regulatory environment. This report presents the current state of ESG reporting in the Danish Fintech sector as informed by wider international discussions within the sector. In it, we map out the five forces that shape the Fintech ESG landscape: 1) policy and regulatory authorities; 2) capital providers; 3) clients and customers; 4) talent; and 5) knowledge communities. We focus on ESG reporting needs, practices, and challenges from different stakeholders’ perspectives. Building on these insights, we suggest a collective approach to ESG reporting in Fintech that is adaptive to the dynamic nature of developments in both ESG and Fintech. The findings and insights are based on a series of interviews with various practitioners in the Fintech ESG sector conducted from February to August 2022 alongside an analysis of relevant documents. The document analysis includes both existing ESG regulations and venture specific ESG frameworks.","author_count":4,"contributors":["Wang, Cancan","Jiang, Qiuyu","Dittrich, Yvonne","Østerlund, Carsten Svarrer"],"cuid":["S01-000.00-683626"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","Syracuse University"],"keyword":["Digital financial services","ESG compliance","ESG performance evaluation","Fintech","Sustainability in startups"],"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-ITU"]},"level3all":["DI-U-AU","DI-U-ITU"]},"review":"und","rtype":["clu"],"sorti":"esg in fintech an overview","src":["itu"],"src-code":["DI-U-ITU"],"type":"doi","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/101319385/TR-2023-209.pdf","version":"Published Version"},"id":"S01-000.00-683626","ids":["itu-fc28080e-72d7-47e7-9a4a-715527905639"],"keyword":["Digital financial services","ESG compliance","ESG performance evaluation","Fintech","Sustainability in startups"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-ED9F9872DF4700D4F26FBC44201C0CDF"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/101319385/TR-2023-209.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","IT University of Copenhagen, Digitalization, Democracy, and Governance, REFLACT"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University"],"nora_code":"DI-U-AU","used":1},{"affno":"3","country":"us","key":"syracuse university","loc":["United States","America, North","OECD"],"name":"Syracuse University","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Cancan","key":"wangpau","last":"Wang","locid":"605b59ab-91b4-4f8e-bb12-df68ce0491c5","name":"Wang, Cancan","orcid":"0000-0002-9065-6884","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Qiuyu","key":"jiangpau","last":"Jiang","name":"Jiang, Qiuyu","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Yvonne","key":"dittrichpau","last":"Dittrich","locid":"f2136570-f73c-446f-9fb0-6d9e461e2124","name":"Dittrich, Yvonne","orcid":"0000-0003-4757-3394","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Carsten Svarrer","key":"østerlundpau","last":"Østerlund","name":"Østerlund, Carsten Svarrer","rank":4,"rolecode":"pau"}],"pub":{"publisher":"IT University of Copenhagen","status":"p"},"review":"Undetermined","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-fc28080e-72d7-47e7-9a4a-715527905639"],"src":["ITU IT University of Copenhagen"],"title":"ESG in Fintech: An Overview","type":"Other-Internet Publication","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-683626","year":"2023","yearsub":"2023"}
{"abstract":"Environmental, social, and corporate governance (ESG) reporting has become an important instrument for the sustainable transition of the next generation of business-startup. Nonetheless, poor ESG data quality impedes effective reporting, especially in domains such as Fintech where top-down ESG metrics may overlook pertinent material issues. This action research study applies a design probe in the form of the notion of an ESG data commons to explore possible strategies to improve ESG data quality in Fintech startup. By reporting on the initial results of an ongoing study of a Danish Fintech startup cluster, we develop a practice-based approach that highlights the changing processes, teleoaffective structures, and sociomaterial dynamics of ESG data commons. We contribute to information systems (IS) research in two areas. First, we contribute to the call for a data-driven approach to ESG reporting. Second, the study extends the IS design literature by applying data commons as a design probe.","author_count":4,"contributors":["Wang, Cancan","Østerlund, Carsten","Jiang, Qiuyu","Dittrich, Yvonne"],"cuid":["S01-000.00-382240"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","Syracuse University"],"keyword":["Action research","Data Commons","ESG","Fintech","Practice theory","Startup"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"becoming sustainable together esg data commons for fintech startups","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/90464219/Becoming_Sustainable_Together_Revision_Final.pdf","version":"Authors Final Version"},"id":"S01-000.00-382240","ids":["itu-41ae3a75-fc4e-4140-9d41-cabaa9c4b267"],"keyword":["Action Research","Data Commons","ESG","Fintech","Practice Theory","Startup"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-8D0706EBD5725B0F41CF95864461A5B8"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/90464219/Becoming_Sustainable_Together_Revision_Final.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","IT University of Copenhagen, Center for Digital Welfare","IT University of Copenhagen, Digitalization, Democracy, and Governance, REFLACT"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"us","key":"syracuse university","loc":["United States","America, North","OECD"],"name":"Syracuse University","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Cancan","key":"wangpau","last":"Wang","locid":"605b59ab-91b4-4f8e-bb12-df68ce0491c5","name":"Wang, Cancan","orcid":"0000-0002-9065-6884","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Carsten","key":"østerlundpau","last":"Østerlund","name":"Østerlund, Carsten","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Qiuyu","key":"jiangpau","last":"Jiang","locid":"0284519c-3320-48a2-8b0d-b4ae9351a403","name":"Jiang, Qiuyu","orcid":"0000-0002-6888-897X","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Yvonne","key":"dittrichpau","last":"Dittrich","locid":"f2136570-f73c-446f-9fb0-6d9e461e2124","name":"Dittrich, Yvonne","orcid":"0000-0003-4757-3394","rank":4,"rolecode":"pau"}],"pub":{"issn":["00000033"],"journal":"Proceedings / International Conference on Information Systems","status":"p","title":"Proceedings / International Conference on Information Systems","title_org":"Proceedings / International Conference on Information Systems (ICIS)"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-41ae3a75-fc4e-4140-9d41-cabaa9c4b267"],"src":["ITU IT University of Copenhagen"],"title":"Becoming Sustainable Together : ESG Data Commons for Fintech Startups","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382240","year":"2022","yearsub":"2022"}
{"abstract":"The rise of Big Data and data science has prompted a focus on data as an essential component of making and innovating data-based services. Traditionally, however, digital data has not been object to co-design as have other physical or functional dimensions of IT application design. This is problematic, because it hinders domain experts who are not IT professionals from taking part in the discussions and design of the data-based services they use and provide. We argue that to address this challenge, it is necessary to empower such domain experts to be able to consider data as an object of design, so they may contribute their expertise to the design of data-based services and their underlying data structures. This paper describes how data may be foregrounded as an explicit element of design that support domain experts’ understanding of data as something that can be designed. We present a detailed interaction analysis of video recordings of three collaborative design workshops, in which we propose a form of data notation and two data representations. We find that data may become an object of design for domain experts when tangible and flexible representations of data are used. Based on our findings, we discuss five lessons learned for foregrounding data in co-design. Together, these provide practical insights for future work.","author_count":3,"contributors":["Seidelin, Cathrine","Dittrich, Yvonne","Grönvall, Erik"],"cuid":["S01-000.00-382975"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Co design","Data","Data as an object of design","Data as input for design","Participatory Design"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"foregrounding data in co design an exploration of how data may become an object of design","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.ijhcs.2020.102505","version":"Published Version"},"id":"S01-000.00-382975","identifier":[{"id":"85087910706","type":"scopus"}],"ids":["itu-7368138d-33e4-4132-84c5-a86f61b50c2b"],"keyword":["Co-design","Data","Data as an object of design","Data as input for design","Participatory design"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-2EB1CECEDFC15F08DCB44F3E2972CF11"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.ijhcs.2020.102505","version":"Published Version"},{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85444034/20200703_ForegroundingData_JournalPreProof.pdf","version":"Other Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Software Engineering, Software Engineering"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Cathrine","key":"seidelinpau","last":"Seidelin","name":"Seidelin, Cathrine","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Yvonne","key":"dittrichpau","last":"Dittrich","locid":"f2136570-f73c-446f-9fb0-6d9e461e2124","name":"Dittrich, Yvonne","orcid":"0000-0003-4757-3394","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Erik","key":"grönvallpau","last":"Grönvall","locid":"1e0534b4-fe3e-4c5e-ad6d-5f1c7df6a14e","name":"Grönvall, Erik","orcid":"0000-0002-7377-6091","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.ijhcs.2020.102505","issn":["10715819","10959300"],"issn_org":["10715819"],"journal":"International Journal of Human-Computer Studies","pages":"1-18","publisher":"Academic Press","status":"p","title":"International Journal of Human-Computer Studies","volume":"143"},"review":"Peer Reviewed","scoID":["2-s2.0-85087910706"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-7368138d-33e4-4132-84c5-a86f61b50c2b"],"src":["ITU IT University of Copenhagen"],"title":"Foregrounding data in co-design – An exploration of how data may become an object of design","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382975","year":"2020","yearsub":"2020"}
{"author_count":24,"contributors":["Ralph, Paul","Baltes, Sebastian","Bianculli, Domenico","Dittrich, Yvonne","Felderer, Michael","Feldt, Robert","Filieri, Antonio","Furia, Carlo Alberto","Graziotin, Daniel","He, Pinjia","Hoda, Rashina","Juristo, Natalia","Kitchenham, Barbara A.","Robbes, Romain","Méndez, Daniel","Molleri, Jefferson","Spinellis, Diomidis","Staron, Miroslaw","Stol, Klaas-Jan","Tamburri, Damian","Torchiano, Marco","Treude, Christoph","Turhan, Burak","Vegas, Sira"],"cuid":["S01-000.00-383504"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Europe, EU","Europe, Non-EU","Nordic","OECD","Oceania"],"country":["Australia","Austria","Canada","Germany","Greece","Ireland","Italy","Luxembourg","Netherlands","Spain","Sweden","Switzerland","United Kingdom"],"glorg":["All Global Affiliations","Athens University of Economics and Business","Blekinge Institute of Technology","Chalmers University of Technology","Dalhousie University","Eindhoven University of Technology","Imperial College London","Keele University","Libera Università di Bolzano","Monash University","Polytechnic University of Turin","Swiss Federal Institute of Technology Zürich","Technical University of Madrid","Universite du Luxembourg","University College Cork","University of Adelaide","University of Gothenburg","University of Innsbruck","University of Stuttgart","Università della Svizzera italiana"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"nr","rtype":["clu"],"sorti":"acm sigsoft empirical standards","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://arxiv.org/abs/2010.03525","version":"Other Version"},"id":"S01-000.00-383504","ids":["itu-9838d2b0-fc73-4fe1-9ec8-7dd0af866913"],"lang":"Eng