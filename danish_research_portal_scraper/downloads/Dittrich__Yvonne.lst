g":null,"first":"Miroslaw","key":"staronpau","last":"Staron","name":"Staron, Miroslaw","rank":18,"rolecode":"pau"},{"affno":"18","corresponding":null,"first":"Klaas-Jan","key":"stolpau","last":"Stol","name":"Stol, Klaas-Jan","rank":19,"rolecode":"pau"},{"affno":"19","corresponding":null,"first":"Damian","key":"tamburripau","last":"Tamburri","name":"Tamburri, Damian","rank":20,"rolecode":"pau"},{"affno":"20","corresponding":null,"first":"Marco","key":"torchianopau","last":"Torchiano","name":"Torchiano, Marco","rank":21,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Christoph","key":"treudepau","last":"Treude","name":"Treude, Christoph","rank":22,"rolecode":"pau"},{"affno":"11","corresponding":null,"first":"Burak","key":"turhanpau","last":"Turhan","name":"Turhan, Burak","rank":23,"rolecode":"pau"},{"affno":"12","corresponding":null,"first":"Sira","key":"vegaspau","last":"Vegas","name":"Vegas, Sira","rank":24,"rolecode":"pau"}],"pub":{"issn":["00000000"],"journal":"CoRR","status":"p","title":"CoRR","volume":"abs/2010.03525"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-9838d2b0-fc73-4fe1-9ec8-7dd0af866913"],"src":["ITU IT University of Copenhagen"],"title":"ACM SIGSOFT Empirical Standards","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383504","year":"2020","yearsub":"2020"}
{"abstract":"When software products and services are developed and maintained over longer time, software engineering practices tend to drift away from both structured and agile methods. Nonetheless, in many cases the evolving practices are far from ad hoc or chaotic. How are the teams involved able to coordinate their joint development?This article reports on an ethnographic study of a small team at a successful provider of software as a service. What struck us was the very explicit way in which the team adopted and adapted their practices to fit the needs of the evolving development. The discussion relates the findings to the concepts of social practices and methods in software engineering, and explores the differences between degraded behavior and the coordinated evolution of development practices. The analysis helps to better understand how software engineering practices evolve, and thus provides a starting point for rethinking software engineering methods and their relation to software engineering practice.","author_count":8,"contributors":["Dittrich, Yvonne","Michelsen, Christian Bo","Tell, Paolo","Lous, Pernille","Ebdrup, Allan"],"cuid":["S01-000.00-382335"],"event":{"acronym":"ESEC/FSE","title":"ACM Joint European Software Engineering Conference and Symposium on the Foundations of Software Engineering (ESEC/FSE)"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Agile methods","Coordinated development","Ethnographic study","Software as a service","Software engineering practices"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"exploring the evolution of software practices","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85597518/FSE2020_Evolving_Practices_author_version_for_the_web.pdf","version":"Pre-print"},"id":"S01-000.00-382335","identifier":[{"id":"85097200820","type":"scopus"}],"ids":["itu-477045ae-ed39-4b83-9812-da0c73101d14"],"keyword":["Agile methods","Coordinated development","Ethnographic study","Software as a service","Software engineering practices"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-EA611A42FF6E64739D329829F76043BE"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85597518/FSE2020_Evolving_Practices_author_version_for_the_web.pdf","version":"Pre-print"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Software Engineering, Software Engineering"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Yvonne","key":"dittrichpau","last":"Dittrich","locid":"f2136570-f73c-446f-9fb0-6d9e461e2124","name":"Dittrich, Yvonne","orcid":"0000-0003-4757-3394","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Christian Bo","key":"michelsenpau","last":"Michelsen","name":"Michelsen, Christian Bo","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Paolo","key":"tellpau","last":"Tell","locid":"2b8ff3a4-e9b0-403d-8bd8-1bf26121c234","name":"Tell, Paolo","orcid":"0000-0001-7391-0046","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Pernille","key":"louspau","last":"Lous","name":"Lous, Pernille","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Allan","key":"ebdruppau","last":"Ebdrup","name":"Ebdrup, Allan","rank":5,"rolecode":"pau"},{"affno":"","first":"Prem","key":"devanbupedh","last":"Devanbu","name":"Devanbu, Prem","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Myra B.","key":"cohenpedh","last":"Cohen","name":"Cohen, Myra B.","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Thomas","key":"zimmermannpedh","last":"Zimmermann","name":"Zimmermann, Thomas","rank":8,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1145/3368089.3409766","pages":"493-504","publisher":"Association for Computing Machinery","status":"p","title":"ESEC/FSE '20: 28th ACM Joint European Software Engineering Conference and Symposium on the Foundations of Software Engineering, Virtual Event, USA, November 8-13, 2020"},"review":"Peer Reviewed","scoID":["2-s2.0-85097200820"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-477045ae-ed39-4b83-9812-da0c73101d14"],"src":["ITU IT University of Copenhagen"],"title":"Exploring the evolution of software practices","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382335","year":"2020","yearsub":"2020"}
{"abstract":"Today, organizations have to deal with multiple heterogeneous data sources from different systems and platforms to maintain and develop their services. Therefore, there is a need for tools to support organizations to determine what data sources can advance and innovate their services. This paper reports on how we addressed this need by designing and implementing two design tools – the Data Sphere and the Data Experiment Template – to support domain experts’ exploration with different data sources which they selected themselves. We find that (1) domain experts’ exploration of data sources make the cross-organizational dependency of data and data work visible; (2) the value of co-design becomes evident to address this dependency; and by that, (3) the data became ‘design things’, that means data are object of design that at the same time create a space for members of the organization to together explore how to use data to innovate their services.","author_count":3,"contributors":["Seidelin, Cathrine","Dittrich, Yvonne","Grönvall, Erik"],"cuid":["S01-000.00-383799"],"event":{"acronym":"NordiCHI","title":"Nordic Conference on Human-Computer Interaction"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Co design","Data Experiments","Data Sphere","Data work","Design Things","Organization"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"co designing data experiments domain experts exploration and experimentation with self selected data sources","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85460420/CoDesigningDataExperiments.pdf","version":"Authors Final Version"},"id":"S01-000.00-383799","identifier":[{"id":"85123041762","type":"scopus"}],"ids":["itu-ae489b73-54d7-4ecc-be55-c1428caddb24"],"keyword":["Co-design","Data Experiments","Data Sphere","Data Work","Design Things","Organization"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-25A24E8C19BC3BF201AD4CE7959745FF"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85460420/CoDesigningDataExperiments.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Software Engineering, Software Engineering"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Cathrine","key":"seidelinpau","last":"Seidelin","name":"Seidelin, Cathrine","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Yvonne","key":"dittrichpau","last":"Dittrich","locid":"f2136570-f73c-446f-9fb0-6d9e461e2124","name":"Dittrich, Yvonne","orcid":"0000-0003-4757-3394","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Erik","key":"grönvallpau","last":"Grönvall","locid":"1e0534b4-fe3e-4c5e-ad6d-5f1c7df6a14e","name":"Grönvall, Erik","orcid":"0000-0002-7377-6091","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1145/3419249.3420152","eisbn":["9781450375795"],"pages":"1-11","publisher":"Association for Computing Machinery","status":"p","title":"NordiCHI '20: Proceedings of the 11th Nordic Conference on Human-Computer Interaction: Shaping Experiences, Shaping Society"},"review":"Peer Reviewed","scoID":["2-s2.0-85123041762"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-ae489b73-54d7-4ecc-be55-c1428caddb24"],"src":["ITU IT University of Copenhagen"],"title":"Co-designing Data Experiments: Domain Experts’ Exploration and Experimentation with self-selected Data Sources","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383799","year":"2020","yearsub":"2020"}
{"abstract":"This note explores how data work takes place in a public sector arena. We report on findings from a 3-year research project with a Danish organisation, which, amongst other things, aimed to improve current data practices in the organisation. We make use of the notion of ‘social arenas’ as a lens to understand the complex setting the organisation is situated in. We find that data work in this context takes place among multiple stakeholders and requires cooperation across organisational boundaries. Moreover, changes in data practices in one site changes cooperation among multiple stakeholders in the arena. Additionally, we develop a diagram of this complex setting, which constitutes an analytical tool that supports our understanding of the site (or sites) of intervention where data work is examined. Our study contributes to the field of CSCW by proposing and showing how the notion of sub-arena helps to comprehend the cooperation and interaction within the surprisingly complex public sector and locate the (sub-)arenas and stakeholders affected by a change in how data is provided and used.","author_count":3,"contributors":["Seidelin, Cathrine","Lee, Charlotte P.","Dittrich, Yvonne"],"cuid":["S01-000.00-382901"],"event":{"acronym":"CSCW","title":"ACM Conference on Computer Supported Cooperative Work"},"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","University of Washington"],"keyword":["CSCW","Collaboration","Cross organizational interaction","Data","Organisational aspects","Public sector","Services"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"understanding data and cooperation in a public sector arena","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.18420/ecscw2020_n01","version":"Published Version"},"id":"S01-000.00-382901","ids":["itu-6dd60fe2-e15a-425a-8d58-6ff0f080d102"],"keyword":["CSCW","Cross-organizational interaction","Data","Public sector","Services","collaboration","organisational aspects"],"lang":"Danish","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-0CF01759FFD0056BBCD679EFC9B40641"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.18420/ecscw2020_n01","version":"Published Version"},{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85285053/ecscw2020_n01.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"us","key":"university of washington","loc":["United States","America, North","OECD"],"name":"University of Washington","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Cathrine","key":"seidelinpau","last":"Seidelin","name":"Seidelin, Cathrine","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Charlotte P.","key":"leepau","last":"Lee","name":"Lee, Charlotte P.","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Yvonne","key":"dittrichpau","last":"Dittrich","locid":"f2136570-f73c-446f-9fb0-6d9e461e2124","name":"Dittrich, Yvonne","orcid":"0000-0003-4757-3394","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.18420/ecscw2020_n01","issn":["25102591"],"issue":"no. 1","journal":"Proceedings of 18th European Conference on Computer-Supported Cooperative Work","publisher":"European Society for Socially Embedded Technologies (EUSSET)","status":"p","title":"Proceedings of 18th European Conference on Computer-Supported Cooperative Work","volume":"vol. 4"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-6dd60fe2-e15a-425a-8d58-6ff0f080d102"],"src":["ITU IT University of Copenhagen"],"title":"Understanding Data and Cooperation in a Public Sector Arena","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382901","year":"2020","yearsub":"2020"}
{"abstract":"Service design (SD) is acknowledged as an approach that can help organisations to address service innovation. However, organisations are struggling to build design capabilities and develop sustainable SD cultures within the organisations. This paper focuses on this central challenge by exploring how a small and medium-sized “non-design-intensive organisation” can integrate SD both as a way to develop internal design capabilities and as an approach to service innovation. We report on an action research study in which we initiated seven SD micro cases. The findings show how our designed SD learning activities developed autonomous SD initiatives within the organisation, and thus over time fostered a sustainable SD culture in this context. Based on our findings, we conclude that organisational appropriation of SD tools and methods is crucial for an organisation’s ability to build and sustain capabilities which can foster an SD culture.","author_count":7,"contributors":["Seidelin, Cathrine","Moeslund Sivertsen, Stine","Dittrich, Yvonne"],"cuid":["S01-000.00-695247"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Design Capabilities","Non Design Intensive Organisation","Service Design","Service innovation","Sustainable SD Culture"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Industriens Uddannelsessekretariat"],"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"designing an organisation s design culture how appropriation of service design tools and methods cultivates sustainable design capabilities in smes","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://www.ep.liu.se/ecp/173/001/ecp20173001.pdf","version":"Published Version"},"id":"S01-000.00-695247","ids":["itu-6071d4c6-81eb-4bd3-92cf-879af89227b0"],"keyword":["Design Capabilities","Non-Design-Intensive Organisation","Service Design","Service Innovation","Sustainable SD Culture"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-2404E91232DA367DB28CCBC1F7123D64"],"oa_link":[{"access":"oa","type":"rem","url":"http://www.ep.liu.se/ecp/173/001/ecp20173001.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Software Engineering, Software Engineering"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Industriens Uddannelsessekretariat"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Cathrine","key":"seidelinpau","last":"Seidelin","name":"Seidelin, Cathrine","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Stine","key":"moeslundsivertsenpau","last":"Moeslund Sivertsen","name":"Moeslund Sivertsen, Stine","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Yvonne","key":"dittrichpau","last":"Dittrich","locid":"f2136570-f73c-446f-9fb0-6d9e461e2124","name":"Dittrich, Yvonne","orcid":"0000-0003-4757-3394","rank":3,"rolecode":"pau"},{"affno":"","first":"Yoko","key":"akamapedh","last":"Akama","name":"Akama, Yoko","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Liam","key":"fennessypedh","last":"Fennessy","name":"Fennessy, Liam","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Sara","key":"harringtonpedh","last":"Ha