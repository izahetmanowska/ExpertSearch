{"abstract":"Despite rapid revascularisation with circulatory support using inotropes and intra-aortic balloon counterpulsation, the mortality of cardiogenic shock complicating acute myocardial infarction still exceeds 50%. An alternative treatment strategy is restoration of cardiac output by using a ventricular assist device which can be inserted in the acute setting using the Impella device, a catheter-based flow pump. DanShock is a Danish multicentre study that will assess whether circulatory support using the Impella device will improve the outcome of cardiogenic shock compared to conventional management.","author_count":18,"contributors":["Junker, Anders","Kaltoft, Anne Kjer","Hassager, Christian","Christensen, Erika Frischknecht","Lippert, Freddy","Ravn, Hanne Berg","Eiskjær, Hans","Tilsted, Hans-Henrik","Schmidt, Henrik","de Haas, Inge","Møller, Jacob Eifer","Ravkilde, Jan","Lassen, Jens Flensted","Wachtell, Kristian","Holmvang, Lene","Jensen, Lise Okkels","Greve, Matias Lindholm","Engstrøm, Thomas"],"cuid":["S02-082.99-011167"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corpau":["DanShockInvestigatorerne"],"keyword":["Cardiac Output","Denmark","Fluoroscopy","Heart Assist Devices","Humans","Prosthesis Design","Shock Cardiogenic","Treatment Outcome","Ventricular Function Left"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-NDR","DI-HO-OTH"],"OT":["Anæstesiologisk Afdeling, NBG"],"U":["DI-U-AAU","DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-NDR","DI-HO-OTH","DI-U-AAU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"behandling af kardiogent shock med perkutan mekanisk cirkulationsstøtte","src":["aau","ku"],"src-code":["DI-U-AAU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://lfappet.laeger.dk/LF/UFL/2013/4/pdf/VP08120500.pdf","version":"Other Version"},"id":"S02-082.99-011167","identifier":[{"id":"84872968464","type":"scopus"},{"id":"23347740","type":"pmid"}],"ids":["aau-e99324d3-614c-4934-8408-197cd442226c","ku-8bad01f1-e90a-4e39-8e3b-430aad6affd1"],"keyword":["Cardiac Output","Denmark","Fluoroscopy","Heart-Assist Devices","Humans","Prosthesis Design","Shock, Cardiogenic","Treatment Outcome","Ventricular Function, Left"],"lang":"Danish","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-3-6-16DE1415387D5F3395829D411CE1A16A"],"oa_link":[{"access":"oa","type":"rem","url":"http://lfappet.laeger.dk/LF/UFL/2013/4/pdf/VP08120500.pdf","version":"Other Version"}],"oai":{"class":"Blocked","mra":["Medicine (MED)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","country":"dk","key":"other hospitals","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-OTH","l3nl":"Other Hospitals","l3nn":"Other Hospitals","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Hospitals","namevar":["Hjertemedicinsk Afdeling B, SKS"],"nora_code":"DI-HO-OTH","used":1},{"affno":"2","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Anæstesiologisk Afdeling, NBG"],"nora_code":"DI-OT","used":1},{"affno":"3","country":"dk","key":"north denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-NDR","l3nl":"North Denmark Region","l3nn":"North Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"North Denmark Region","namevar":["Aalborg University Hospital"],"nora_code":"DI-HO-NDR","used":1},{"affno":4,"key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine, Aalborg University Hospital"],"nora_code":"DI-U-AAU"},{"affno":5,"key":"danshockinvestigatorerne","name":"DanShockInvestigatorerne","role":"oau"},{"affno":6,"key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Section of Surgery and Internal Medicine"],"nora_code":"DI-U-KU"}],"person":[{"affno":"","corresponding":null,"first":"Hanne Berg","key":"ravnpau","last":"Ravn","name":"Ravn, Hanne Berg","rank":1,"rolecode":"pau"},{"affno":"","first":"Anders","key":"junkerpau","last":"Junker","name":"Junker, Anders","rank":1,"rolecode":"pau"},{"affno":"1","first":"Anne Kjer","key":"kaltoftpau","last":"Kaltoft","name":"Kaltoft, Anne Kjer","rank":2,"rolecode":"pau"},{"affno":"","first":"Christian","key":"hassagerpau","last":"Hassager","name":"Hassager, Christian","rank":3,"rolecode":"pau"},{"affno":"2","first":"Erika Frischknecht","key":"christensenpau","last":"Christensen","name":"Christensen, Erika Frischknecht","rank":4,"rolecode":"pau"},{"affno":"","first":"Freddy","key":"lippertpau","last":"Lippert","locid":"48ac5d81-3437-4345-b6c3-394683a09d5d","name":"Lippert, Freddy","orcid":"0000-0002-2356-8809","rank":5,"rolecode":"pau"},{"affno":"1","first":"Hans","key":"eiskjærpau","last":"Eiskjær","name":"Eiskjær, Hans","rank":7,"rolecode":"pau"},{"affno":"","first":"Hans-Henrik","key":"tilstedpau","last":"Tilsted","name":"Tilsted, Hans-Henrik","rank":8,"rolecode":"pau"},{"affno":"2","first":"Henrik","key":"schmidtpau","last":"Schmidt","name":"Schmidt, Henrik","rank":9,"rolecode":"pau"},{"affno":"","first":"Inge","key":"dehaaspau","last":"de Haas","name":"de Haas, Inge","rank":10,"rolecode":"pau"},{"affno":"","first":"Jacob Eifer","key":"møllerpau","last":"Møller","name":"Møller, Jacob Eifer","rank":11,"rolecode":"pau"},{"affno":"3","first":"Jan","key":"ravkildepau","last":"Ravkilde","name":"Ravkilde, Jan","rank":12,"rolecode":"pau"},{"affno":"1","first":"Jens Flensted","key":"lassenpau","last":"Lassen","name":"Lassen, Jens Flensted","rank":13,"rolecode":"pau"},{"affno":"","first":"Kristian","key":"wachtellpau","last":"Wachtell","name":"Wachtell, Kristian","rank":14,"rolecode":"pau"},{"affno":"","first":"Lene","key":"holmvangpau","last":"Holmvang","name":"Holmvang, Lene","rank":15,"rolecode":"pau"},{"affno":"","first":"Lise Okkels","key":"jensenpau","last":"Jensen","name":"Jensen, Lise Okkels","rank":16,"rolecode":"pau"},{"affno":"","first":"Matias Lindholm","key":"grevepau","last":"Greve","name":"Greve, Matias Lindholm","rank":17,"rolecode":"pau"},{"affno":"","first":"Thomas","key":"engstrømpau","last":"Engstrøm","name":"Engstrøm, Thomas","rank":18,"rolecode":"pau"}],"pmid":["23347740"],"pub":{"issn":["00415782","13994174"],"issn_org":["00415782"],"issue":"4","journal":"Ugeskrift for Læger","pages":"205-8","publisher":"Almindelige Danske Laegeforening","status":"p","title":"Ugeskrift for Læger","title_org":"Ugeskrift for Laeger","volume":"175"},"review":"Peer Reviewed","scoID":["2-s2.0-84872968464"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","North Denmark Region","Other Hospitals","Other Research","Universities","University of Copenhagen","hjertemedicinsk afdeling b, sks"],"PST":["Published"]},"sid":["aau-e99324d3-614c-4934-8408-197cd442226c","ku-8bad01f1-e90a-4e39-8e3b-430aad6affd1"],"src":["AAU Aalborg University","KU University of Copenhagen"],"title":"Behandling af kardiogent shock med perkutan mekanisk cirkulationsstøtte","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-082.99-011167","year":"2013","yearsub":"2013"}
{"abstract":"This paper demonstrates how pressure gradients in a pulsatile flow environment can be measured non-invasively using ultrasound. The proposed method relies on vector velocity fields acquired from ultrasound data. 2-D flow data are acquired at 18-23 frames/sec using the Transverse Oscillation approach. Pressure gradients are calculated from the measured velocity fields using the Navier-Stokes equation. Velocity fields are measured during constant and pulsating flow on a carotid bifurcation phantom and on a common carotid artery in-vivo. Scanning is performed with a 5 MHz BK8670 linear transducer using a BK Medical 2202 UltraView Pro Focus scanner. The calculated pressure gradients are validated through a finite element simulation of the constant flow model. The geometry of the flow simulation model is reproduced using MRI data, thereby providing identical flow domains in measurement and simulation. The proposed method managed to estimate pressure gradients that varied from 0 kPa/m–7 kPa/m during constant flow and from 0 kPa/m–200 kPa/m in the pulsatile flow environments. The estimator showed, in comparison to the simulation model, a bias of -9% and -8% given in reference to the peak gradient for the axial and lateral gradient component, respectively.","author_count":6,"contributors":["Olesen, Jacob Bjerring","Traberg, Marie Sand","Pihl, Michael Johannes","Hansen, Peter Møller","Nielsen, Michael Bachmann","Jensen, Jørgen Arendt"],"cuid":["S01-000.00-307767"],"event":{"end":"2013-07-25","place":"Prague, cz","start":"2013-07-21","title":"2013 IEEE International Ultrasonics Symposium","year":"2013"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-HO-CAP","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"non invasive measurement of pressure gradients in pulsatile flow using ultrasound","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/56779212/paper_final.pdf","version":"Pre-print"},"id":"S01-000.00-307767","identifier":[{"id":"84894357945","type":"scopus"}],"ids":["dtu-0a84d622-0c24-4618-a5a4-ade5f317e562"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-D0AE6E1CAE247FDDC9987619BDC7C1DE"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/56779212/paper_final.pdf","version":"Pre-print"},{"access":"oa","type":"doi","url":"https://doi.org/10.1109/ULTSYM.2013.0516","version":"Other Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Electrical Engineering","Technical University of Denmark, Department of Electrical Engineering, Biomedical Engineering"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital Herlev and Gentofte"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jacob Bjerring","key":"olesenpau","last":"Olesen","locid":"024aaa55-d5a4-4763-8004-b2fb701dfd2b","name":"Olesen, Jacob Bjerring","orcid":"0000-0002-5169-1644","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Marie Sand","key":"trabergpau","la