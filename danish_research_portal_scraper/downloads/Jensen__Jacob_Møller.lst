Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"5","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Steno Diabetes Centre, Gentofte, Denmark."],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","first":"Camilla Fuchs","key":"andersencamillafuchspau","last":"Andersen","name":"Andersen, Camilla Fuchs","rank":1,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Julie Hempel","key":"larsenjuliehempelpau","last":"Larsen","locid":"750e6fe3-4c0c-4940-bfa9-7159856181ef","name":"Larsen, Julie Hempel","orcid":"0000-0002-2326-5736","rank":2,"rolecode":"pau"},{"affno":"1","first":"Jesper","key":"jensenjesperpau","last":"Jensen","name":"Jensen, Jesper","rank":3,"rolecode":"pau"},{"affno":"4 2","corresponding":null,"first":"Massar","key":"omarmassarpau","last":"Omar","locid":"3a6641e9-a451-482c-a139-b60841705f94","name":"Omar, Massar","orcid":"0000-0002-9634-3889","rank":4,"rolecode":"pau"},{"affno":"1","first":"Nina","key":"nouhraveshninapau","last":"Nouhravesh","name":"Nouhravesh, Nina","rank":5,"rolecode":"pau"},{"affno":"4 1","first":"Caroline","key":"kistorpcarolinepau","last":"Kistorp","locid":"42328645-d772-4f53-9f70-438ff40291b9","name":"Kistorp, Caroline","orcid":"0000-0002-3019-6775","rank":6,"rolecode":"pau"},{"affno":"1","first":"Christian","key":"tuxenchristianpau","last":"Tuxen","name":"Tuxen, Christian","rank":7,"rolecode":"pau"},{"affno":"1","first":"Finn","key":"gustafssonfinnpau","last":"Gustafsson","name":"Gustafsson, Finn","rank":8,"rolecode":"pau"},{"affno":"1 4 5","first":"Filip K","key":"knopfilipkpau","last":"Knop","locid":"ce6eaad9-59f8-4ecf-8a1e-388a74734f6a","name":"Knop, Filip K.","name_org":"Knop, Filip K","rank":9,"rolecode":"pau"},{"affno":"4","first":"Julie Lyng","key":"formanjulielyngpau","last":"Forman","locid":"ddfe2814-4ae0-463d-9748-c1ba0647b469","name":"Forman, Julie Lyng","orcid":"0000-0001-7368-0869","rank":10,"rolecode":"pau"},{"affno":"1","first":"Filip Soeskov","key":"davidovskifilipsoeskovpau","last":"Davidovski","name":"Davidovski, Filip Soeskov","rank":11,"rolecode":"pau"},{"affno":"1 4","first":"Lars Thorbjørn","key":"jensenlarsthorbjørnpau","last":"Jensen","locid":"905e0cf1-9944-4189-bcfb-106593026421","name":"Jensen, Lars Thorbjørn","rank":12,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Kurt","key":"højlundkurtpau","last":"Højlund","locid":"de11c7e6-25a6-4e23-95bb-fe86d3d775ab","name":"Højlund, Kurt","orcid":"0000-0002-0891-4224","rank":13,"rolecode":"pau"},{"affno":"1 4","first":"Lars","key":"køberlarspau","last":"Køber","locid":"e3f0c57c-605a-431a-9c63-2213c46621e6","name":"Køber, Lars","rank":14,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Lisbeth","key":"antonsenlisbethpau","last":"Antonsen","locid":"bcaa40a5-514d-4f57-8c7f-6cabbb689e3c","name":"Antonsen, Lisbeth","rank":15,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Mikael Kjær","key":"poulsenmikaelkjærpau","last":"Poulsen","locid":"a8da3614-e99d-403f-933f-f5dfab3976af","name":"Poulsen, Mikael Kjær","orcid":"0000-0003-4051-7197","rank":16,"rolecode":"pau"},{"affno":"1 4","first":"Morten","key":"schoumortenpau","last":"Schou","locid":"48fa6ec9-1941-4566-b931-14b0cc8cbae3","name":"Schou, Morten","rank":17,"rolecode":"pau"},{"affno":"2 1","corresponding":null,"first":"Jacob Eifer","key":"møllerjacobeiferpau","last":"Møller","locid":"5e4d3cb6-b0a0-4541-aea1-30e73f7c10b8","name":"Møller, Jacob Eifer","orcid":"0000-0003-2873-5845","rank":18,"rolecode":"pau"}],"pmid":["38365073"],"pub":{"doi":"10.1016/j.ahj.2024.02.005","issn":["00028703","10976744"],"issn_org":["00028703"],"journal":"American Heart Journal","pages":"84-96","publisher":"Elsevier","status":"p","title":"American Heart Journal","volume":"271"},"review":"Peer Reviewed","scoID":["2-s2.0-85188007738"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-f3960168-6395-4d7a-bdf4-55426a3c97a7","sdu-2e86eeb4-0fe5-49b0-9bfa-04c922d10dab"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Empagliflozin to elderly and obese patients with increased risk of developing heart failure : Study protocol for the Empire Prevent trial program","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-725286","year":"2024","yearsub":"2024"}
{"abstract":"Background: In selected cases of cardiogenic shock, veno-arterial extracorporeal membrane oxygenation (V-A ECMO) is combined with trans valvular micro axial flow pumps (ECMELLA). Observational studies indicate that ECMELLA may reduce mortality but exposing the patient to two advanced mechanical support devices may affect the early inflammatory response. We aimed to explore inflammatory biomarkers in a porcine cardiogenic shock model managed with V-A ECMO or ECMELLA. Methods: Fourteen landrace pigs had acute myocardial infarction-induced cardiogenic shock with minimal arterial pulsatility by microsphere embolization and were afterwards managed 1:1 with either V-A ECMO or ECMELLA for 4 h. Serial blood samples were drawn hourly and analyzed for serum concentrations of interleukin 6 (IL-6), IL-8, tumor necrosis factor alpha, and serum amyloid A (SAA). Results: An increase in IL-6, IL-8, and SAA levels was observed during the experiment for both groups. At 2–4 h of support, IL-6 levels were higher in ECMELLA compared to V-A ECMO animals (difference: 1416 pg/ml, 1278 pg/ml, and 1030 pg/ml). SAA levels were higher in ECMELLA animals after 3 and 4 h of support (difference: 401 ng/ml and 524 ng/ml) and a significant treatment-by-time effect of ECMELLA on SAA was identified (p = 0.04). No statistical significant between-group differences were observed in carotid artery blood flow, urine output, and lactate levels. Conclusions: Left ventricular unloading with Impella during V-A ECMO resulted in a more extensive inflammatory reaction despite similar end-organ perfusion.","author_count":14,"contributors":["Gregers, Emilie","Frederiksen, Peter H.","Udesen, Nanna L.J.","Linde, Louise","Banke, Ann","Povlsen, Amalie L.","Larsen, Jeppe P.","Hassager, Christian","Jensen, Lisette O.","Lassen, Jens F.","Schmidt, Henrik","Ravn, Hanne B.","Heegaard, Peter M. H.","Møller, Jacob E."],"cuid":["S02-100.00-735397"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corresponding_author":["Gregers, Emilie"],"keyword":["Acute myocardial infarction","Cardiogenic shock","ECMELLA","ECMO","Unloading of the left ventricle","Venoarterial extracorporeal membrane oxygenation"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-DTU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"immediate inflammatory response to mechanical circulatory support in a porcine model of severe cardiogenic shock","src":["dtu","sdu"],"src-code":["DI-U-DTU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s40635-024-00625-8","version":"Published Version"},"id":"S02-100.00-735397","identifier":[{"id":"38647741","type":"pmid"},{"id":"85191053969","type":"scopus"},{"id":"PMC11035503","type":"pmcid"}],"ids":["dtu-7be470cb-5537-487c-809c-a5428bf8bef9","sdu-58d98f09-8d5c-4099-a4e4-7b81d162b074"],"keyword":["Acute myocardial infarction","Cardiogenic shock","ECMELLA","ECMO","Unloading of the left ventricle","Venoarterial extracorporeal membrane oxygenation"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-27CF737E96C0241E419EF06BCBD5AEB9"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s40635-024-00625-8","version":"Published Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/360251386/66284ef557bd3d98bcd5a76b.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Cardiology (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"4","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Health Technology","Technical University of Denmark, Department of Health Technology, Bio Facility","Technical University of Denmark, Department of Health Technology, Experimental & Translational Immunology","Technical University of Denmark, Department of Health Technology, Experimental & Translational Immunology, Innate Immunology and Metabolism"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Emilie","key":"gregerspau","last":"Gregers","name":"Gregers, Emilie","rank":1,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Peter H.","key":"frederiksenpau","last":"Frederiksen","locid":"85d6facd-93bf-44ee-a117-269fb26a52be","name":"Frederiksen, Peter H.","orcid":"0000-0003-3712-7980","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Nanna L.J.","key":"udesenpau","last":"Udesen","locid":"f71f56f5-4f36-4de5-a7ae-e5e51f101a83","name":"Udesen, Nanna Louise Junker","name_org":"Udesen, Nanna L.J.","orcid":"0000-0003-1542-3260","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Louise","key":"lindepau","last":"Linde","locid":"4fc23628-00d4-466a-9e6e-269e23160481","name":"Linde, Louise","orcid":"0000-0002-7757-2571","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Ann","key":"bankepau","last":"Banke","locid":"0d350637-c6ce-4cf8-82ba-e965da703690","name":"Banke, Ann","orcid":"0000-0002-1036-580X","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Amalie L.","key":"povlsenpau","last":"Povlsen","locid":"085efe15-36a1-434b-9b9e-b4341cd84a0d","name":"Povlsen, Amalie Ling","name_org":"Povlsen, Amalie L.","orcid":"0000-0001-6044-8841","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jeppe P.","key":"larsenpau","last":"Larsen","locid":"9c1f7b9d-9e43-45ec-aa4d-310cdce6686a","name":"Larsen, Jeppe P.","rank":7,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Christian","key":"hassagerpau","last":"Hassager","name":"Hassager, Christian","rank":8,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Lisette O.","key":"jensenpau","last":"Jensen","locid":"b78c452e-5a69-41fe-ba49-0096c84d1d4d","name":"Jensen, Lisette Okkels","name_org":"Jensen, Lisette O.","orcid":"0000-0002-4838-2429","rank":9,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jens F.","key":"lassenpau","last":"Lassen","locid":"2af194b2-635f-4b62-84c2-26bd7dc3263b","name":"Lassen, Jens Flensted","name_org":"Lassen, Jens F.","orcid":"0000-0001-7972-9192","rank":10,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Henrik","key":"schmidtpau","last":"Schmidt","locid":"9789920f-4b31-4f28-8211-97afced9d61e","name":"Schmidt, Henrik","rank":11,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Hanne B.","key":"ravnpau","last":"Ravn","locid":"25de7650-3dc1-4594-b758-9c36f6de6306","name":"Ravn, Hanne Berg","name_org":"Ravn, Hanne B.","orcid":"0000-0003-4702-5195","rank":12,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"Peter M.H.","key":"heegaardpau","last":"Heegaard","locid":"f15c1dfb-4275-4369-9b2b-2af936d2e0e6","name":"Heegaard, Peter M. H.","name_org":"Heegaard, Peter M.H.","orcid":"0000-0003-4506-4932","rank":13,"rolecode":"pau"},{"affno":"3 2","corresponding":null,"first":"Jacob E.","key":"møllerpau","last":"Møller","locid":"5e4d3cb6-b0a0-4541-aea1-30e73f7c10b8","name":"Møller, Jacob Eifer","name_org":"Møller, Jacob E.","orcid":"0000-0003-2873-5845","rank":14,"rolecode":"pau"}],"pmid":["38647741"],"pub":{"doi":"10.1186/s40635-024-00625-8","issn":["2197425X"],"issue":"1","journal":"Intensive Care Medicine Experimental","paperid":"39","publisher":"Springer Nature","status":"p","title":"Intensive Care Medicine Experimental","volume":"12"},"review":"Peer Reviewed","scoID":["2-s2.0-85191053969"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Technical University of Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["dtu-7be470cb-5537-487c-809c-a5428bf8bef9","sdu-58d98f09-8d5c-4099-a4e4-7b81d162b074"],"src":["DTU Technical University of Denmark","SDU University of Southern Denmark"],"title":"Immediate inflammatory response to mechanical circulatory support in a porcine model of severe cardiogenic shock","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-735397","year":"2024","yearsub":"2024"}
{"abstract":"BACKGROUND: In DanGer Shock (the Danish-German Cardiogenic Shock trial), use of a microaxial flow pump (mAFP) in patients with ST-segment-elevation myocardial infarction-related cardiogenic shock led to lower all-cause mortality but higher rates of renal replacement therapy (RRT). In this prespecified analysis, rates and predictors of acute kidney injury (AKI) and RRT were assessed. METHODS: In this international, randomized, open-label, multicenter trial, 355 adult patients with ST-segment-elevation myocardial infarction-related cardiogenic shock were randomized to mAFP (n=179) or standard care alone (n=176). AKI was defined according to RIFLE criteria (Risk, Injury, Failure, Loss, and End-stage kidney disease) and assessed using logistic regression models. Use of RRT was assessed accounting for the competing risk of death using Fine-Gray subdistribution hazard models. RESULTS: AKI (RIFLE ≥1) was recorded in 110 patients (61%) in the mAFP group and 79 patients (45%) in the control group (P<0.01); RRT was used in 75 (42%) and 47 (27%) patients, respectively (P<0.01). About two-thirds of the RRTs were initiated within the first 24 hours from admission (n=48 [64%] in the mAFP group and n=31 [66%] in the control group). Occurrence of AKI and RRT were associated with higher 180-day mortality in both study arms. At 180 days, all patients alive were free of RRT. mAFP use was associated with higher rates of RRT, even when accounting for competing risk of death (subdistribution hazard, 1.67 [1.18-2.35]). This association was largely consistent among prespecified subgroups. Allocation to mAFP was associated with lower 180-day mortality irrespective of AKI or RRT (Pinteraction=0.84). Relevant predictors of AKI in both groups comprised reduced left ventricular ejection fraction, baseline kidney function, shock severity, bleeding events, and positive fluid balance. Predictors of AKI specific to mAFP were suction events, higher pump speed, and longer duration of support. CONCLUSIONS: Shock severity, allocation to mAFP, and device-related complications were associated with an increased risk of AKI. AKI was generally associated with higher mortality, but the allocation to mAFP consistently led to lower mortality rates at 180 days irrespective of the occurrence of AKI with or without RRT initiation. REGISTRATION: URL: https://www.clinicaltrials.gov; Unique identifier: NCT01633502.","author_count":26,"contributors":["Zweck, Elric","Hassager, Christian","Beske, Rasmus P.","Jensen, Lisette O.","Eiskjær, Hans","Mangner, Norman","Polzin, Amin","Schulze, P. Christian","Skurk, Carsten","Nordbeck, Peter","Clemmensen, Peter","Panoulas, Vasileios","Zimmer, Sebastian","Schäfer, Andreas","Kelm, Malte","Engstrøm, Thomas","Holmvang, Lene","Junker, Anders","Schmidt, Henrik","Terkelsen, Christian J.","Linke, Axel","Westenfeld, Ralf","Møller, Jacob E.","Sørensen, Rikke","Lønborg, Jacob"],"cuid":["S04-094.14-793028"],"filters":{"added":"2025-01","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"continent":["Europe, EU","Europe, Non-EU","OECD"],"corpau":["DanGer Shock investigators"],"corresponding_author":["Møller, Jacob E.","Møller, Jacob Eifer"],"country":["Germany","United Kingdom"],"glorg":["All Global Affiliations","Charité – Universitätsmedizin Berlin","Deutsches Herzzentrum Berlin","Dresden University of Technology","Friedrich Schiller University Jena","German Centre for Cardiovascular Research","Guy's and St Thomas' NHS Foundation Trust","Hannover Medical School","Heinrich Heine University Düsseldorf","Jena University Hospital","Royal Brompton and Harefield NHS Foundation Trust","Technische Universität Dresden","University Clinic Hamburg–Eppendorf (UKE)","University Hospital Bonn","University Hospital Carl Gustav Carus","University Hospital Düsseldorf","University Hospital Wishaw & University Hospital Monklands","University Hospital Würzburg","University Hospital of Düsseldorf","University Medi