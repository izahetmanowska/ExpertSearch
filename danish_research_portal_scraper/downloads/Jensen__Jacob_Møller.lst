":"pau"},{"affno":"3 4 2","corresponding":null,"first":"Jacob E","key":"møllerpau","last":"Møller","locid":"5e4d3cb6-b0a0-4541-aea1-30e73f7c10b8","name":"Møller, Jacob Eifer","name_org":"Møller, Jacob E","orcid":"0000-0003-2873-5845","rank":3,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"country":"dk","first":"Henrik","key":"schmidtpau","last":"Schmidt","locid":"9789920f-4b31-4f28-8211-97afced9d61e","name":"Schmidt, Henrik","rank":4,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Lisette O","key":"jensenpau","last":"Jensen","locid":"b78c452e-5a69-41fe-ba49-0096c84d1d4d","name":"Jensen, Lisette Okkels","name_org":"Jensen, Lisette O","orcid":"0000-0002-4838-2429","rank":5,"rolecode":"pau"},{"affno":"1","first":"Lene","key":"holmvangpau","last":"Holmvang","locid":"54b8ef01-f8ed-4c49-a126-2109e2fd351f","name":"Holmvang, Lene","rank":6,"rolecode":"pau"},{"affno":"1","first":"Hanne B.","key":"ravnpau","last":"Ravn","locid":"3049e7b7-0f18-413b-88ab-a3d77ebc079b","name":"Ravn, Hanne Berg","name_org":"Ravn, Hanne B.","rank":7,"rolecode":"pau"},{"affno":"1 3","first":"Christian","key":"hassagerpau","last":"Hassager","locid":"49196e5d-0f61-44b2-a6b9-cd6c5f8f3bc2","name":"Hassager, Christian","orcid":"0000-0002-1199-0981","rank":8,"rolecode":"pau"}],"pmid":["33620420"],"pub":{"doi":"10.1093/ehjacc/zuaa010","issn":["20488726","20488734"],"issn_org":["20488734"],"issue":"1","journal":"European Heart Journal: Acute Cardiovascular Care","pages":"33-39","publisher":"Oxford University Press","status":"p","title":"European Heart Journal: Acute Cardiovascular Care","title_org":"European Heart Journal - Acute Cardiovascular Care","volume":"10"},"review":"Peer Reviewed","scoID":["2-s2.0-85105521220"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-d19fa67e-ee2c-4c91-829f-5eaa6f4e6500","sdu-c207ecc7-55c8-4183-897f-c7d818bf4332"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Cardiogenic shock due to predominantly right ventricular failure complicating acute myocardial infarction","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.94-046407","year":"2021","yearsub":"2021"}
{"abstract":"BACKGROUND: The mechanisms by which hypertension accelerates coronary artery disease are poorly understood. Patients with hypertension often have confounding humoral changes, and to date, no experimental models have allowed analysis of the isolated effect of pressure on atherosclerosis in a setting that recapitulates the dimensions and biomechanics of human coronary arteries. OBJECTIVES: This study sought to analyze the effect of pressure on coronary atherosclerosis and explore the underlying mechanisms. METHODS: Using inflatable suprarenal aortic cuffs, we increased mean arterial pressure by >30 mm Hg in the cephalad body part of wild-type and hypercholesterolemic proprotein convertase subtilisin kexin type 9 (PCSK9)D374Y Yucatan minipigs for >1 year. Caudal pressures remained normal. RESULTS: Under hypercholesterolemic conditions in PCSK9D374Y transgenic minipigs, cephalad hypertension accelerated coronary atherosclerosis to almost 5-fold with consistent development of fibroatheromas that were sufficiently large to cause stenosis on computed tomography angiography. This was caused by local pressure forces, because vascular beds shielded from hypertension, but exposed to the same humoral factors, showed no changes in lesion formation. The same experiment was conducted under normocholesterolemic conditions in wild-type minipigs to examine the underlying mechanisms. Hypertension produced clear changes in the arterial proteome with increased abundance of mechanical strength proteins and reduced levels of infiltrating plasma macromolecules. This was paralleled by increased smooth muscle cells and increased intimal accumulation of low-density lipoproteins in the coronary arteries. CONCLUSIONS: Increased pressure per se facilitates coronary atherosclerosis. Our data indicate that restructuring of the artery to match increased tensile forces in hypertension alters the passage of macromolecules and leads to increased intimal accumulation of low-density lipoproteins.","author_count":19,"contributors":["Al-Mashhadi, Rozh","Al-Mashhadi, Ahmed Ludvigsen","Nasr, Zahra P.","Mortensen, Martin Bødtker","Lewis, Esmeralda A","Camafeita, Emilio","Ravlo, Kristian","Al-Mashhadi, Zheer","Kjær, Daniel Willy","Palmfeldt, Johan","Bie, Peter","Jensen, Jesper Møller","Nørgaard, Bjarne Linde","Falk, Erling","Vázquez, Jesús","Bentzon, Jacob Fog"],"cuid":["S02-100.00-024452"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","OECD"],"corresponding_author":["Al-Mashhadi, Rozh","Al-Mashhadi, Rozh H.","Bentzon, Jacob F."],"country":["Spain"],"glorg":["All Global Affiliations","Centro Nacional de Investigaciones Cardiovasculares (CNIC)","Centro de Investigación Biomédica en Red de Enfermedades Cardiovasculares","Centro de Investigación Biomédica en Red en Enfermedades Cardiovasculares (CIBERCV)"],"keyword":["Atherosclerosis","Coronary artery disease","Hypertension","Low density lipoproteins","Minipigs","Proteome"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR"],"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-HO-CDR","DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"local pressure drives low density lipoprotein accumulation and coronary atherosclerosis in hypertensive minipigs","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85099651916","version":"Other Version"},"funding_acknowledgement":["This work was supported by grants from the Danish Heart Foundation Independent Research Funding Denmark and the Ministerio de Economia, Industria y Competividad with cofunding from the Fondo Europeo de Desarrollo Regional (SAF2016-75580-R and PGC2018-097019-B-I00), the Carlos III Institute of Health-Fondo de Investigación Sanitaria (IPT17/0019–ISCIII-SGEFI/ERDF, ProteoRed), the Fundació la Marató de TV3 (grant 122/C/2015) and “la Caixa” Banking Foundation (project code HR17-00247). The CNIC is supported by the Instituto de Salud Carlos III, the Ministerio de Ciencia e Innovación, and the Pro Centro Nacional de Investigaciones Cardiovasculares Foundation and is a Severo Ochoa Center of Excellence (SEV-2015-0505). The authors have reported that they have no relationships relevant to the contents of this paper to disclose."],"id":"S02-100.00-024452","identifier":[{"id":"85099651916","type":"scopus"},{"id":"33538256","type":"pmid"}],"ids":["au-a0ede8d9-e0d7-488f-ab95-998d83afd28e","sdu-abcb48b7-151e-4a01-a1e4-56cd58c1b386"],"keyword":["atherosclerosis","coronary artery disease","hypertension","low-density lipoproteins","minipigs","proteome"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-E10CC840C7F7BFB588FEB76725ACD755"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Radiology","Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Department of Cardiological Medicine B"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"es","key":"centro nacional de investigaciones cardiovasculares","loc":["Spain","Europe, EU","OECD"],"name":"Centro Nacional de Investigaciones Cardiovasculares (CNIC)","used":1},{"affno":"3","country":"es","key":"centro de investigación biomédica en red en enfermedades cardiovasculares","loc":["Spain","Europe, EU","OECD"],"name":"Centro de Investigación Biomédica en Red en Enfermed