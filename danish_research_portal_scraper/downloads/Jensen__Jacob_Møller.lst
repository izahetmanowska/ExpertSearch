"rank":14,"rolecode":"pau"}],"pmid":["38649295"],"pub":{"doi":"10.1002/ehf2.14780","issn":["20555822"],"issue":"4","journal":"ESC Heart Failure","pages":"2305-2313","publisher":"Wiley","status":"p","title":"ESC Heart Failure","volume":"11"},"review":"Peer Reviewed","scoID":["2-s2.0-85191153245"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-9ec5f08b-0cef-46dd-b3ad-a784ad27067f"],"src":["SDU University of Southern Denmark"],"title":"Haemodynamic implications of VA-ECMO vs. VA-ECMO plus Impella CP for cardiogenic shock in a large animal model","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-755487","year":"2024","yearsub":"2024"}
{"abstract":"Recent genome-wide association studies (GWAS) have identified multiple vascular cell-expressed genes linked to coronary artery disease (CAD), suggesting that smooth muscle cells (SMCs) and SMC-derived metaplastic cells are promising targets for novel antiatherosclerosis therapies. However, the disease-promoting pathways of most GWAS-identified genes are unknown, hindering their translation into therapeutic targets. This study integrated public GWAS data for CAD and single-cell RNA sequencing (scRNA-seq) analyses of human atherosclerotic plaques to identify 20 GWAS risk genes with a putative mechanism of action in SMCs or SMC-derived cells. Gene perturbation experiments in SMCs coaxed to plaque-relevant phenotypes revealed that the selected risk genes, despite encoding very different types of proteins, regulated shared sets of genes associated with contractile functions, cell cycle pathways, NFκB, and type I interferon signaling. By integrating information about GWAS gene effect direction and a deep analysis of cholesterol- and stretch-induced gene modules in SMCs, we find evidence that cholesterol-induced signaling is a pro-atherogenic disease mechanism in SMCs that is upregulated by detrimental and downregulated by protective GWAS genes. Overall, our study identifies a set of candidate disease mechanisms in SMCs that are regulated by multiple GWAS genes across several SMC assays. Furthermore, it provides proof-of-concept for using GWAS gene effect directionality to predict the pathogenic effect of candidate disease mechanisms that can be extended to other GWAS genes and cell types in the future.","author_count":19,"contributors":["Albarrán-Juárez, Julián","Markov, Anton","Jensen, Anne Louise","Møller, Peter Loof","Uryga, Anna K.","Djordjevic, Djordje","Hansen, Jakob","Jensen, Lise Filt","Sharysh, Diana","Pyke, Charles","Moreno, Jaime","Borghetti, Giulia","Bachmann, Julian","Herum, Kate","Røge, Lisa Maria","Traylor, Matthew","Nyberg, Michael","Nyegaard, Mette","Bentzon, Jacob Fog"],"cuid":["S01-000.00-794543"],"filters":{"added":"2025-04","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Spain"],"glorg":["All Global Affiliations","Centro Nacional de Investigaciones Cardiovasculares"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-PR","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-STENO"],"PR":["DI-PR-ALL","DI-PR-NOVO"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-HO-STENO","DI-PR-NOVO","DI-U-AAU","DI-U-AU"]},"review":"und","rtype":["clu"],"sorti":"mapping atherogenesis mechanisms in smooth muscle cells by targeting genes linked to coronary artery disease","src":["aau"],"src-code":["DI-U-AAU"],"type":"dpr","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-ND 4.0","type":"doi","url":"https://doi.org/10.1101/2024.11.11.623011","version":"Published Version"},"id":"S01-000.00-794543","ids":["aau-5e97a4f4-8634-47d3-8415-1f048b861e57"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-6687B29E9829B898A4C7DD6CDE2F5F2B"],"oa_link":[{"access":"oa","license":"CC BY-ND 4.0","type":"doi","url":"https://doi.org/10.1101/2024.11.11.623011","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Genomic Medicine"],"nora_code":"DI-U-AAU","used":1},{"affno":"3","country":"dk","key":"novo nordisk","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-NOVO","l3nl":"Novo Nordisk","l3nn":"Novo Nordisk","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Novo Nordisk","namevar":["Novo Nordisk A/S"],"nora_code":"DI-PR-NOVO","used":1},{"affno":"4","country":"es","key":"centro nacional de investigaciones cardiovasculares","loc":["Spain","Europe, EU","OECD"],"name":"Centro Nacional de Investigaciones Cardiovasculares","used":1},{"affno":"5","country":"dk","key":"steno diabetes centers","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-STENO","l3nn":"Steno Diabetes Centers","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Steno Diabetes Centers","namevar":["Steno Diabetes Centers"],"nora_code":"DI-HO-STENO","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Julián","key":"albarránjuárezjuliánpau","last":"Albarrán-Juárez","name":"Albarrán-Juárez, Julián","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anton","key":"markovantonpau","last":"Markov","name":"Markov, Anton","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anne Louise","key":"jensenannelouisepau","last":"Jensen","name":"Jensen, Anne Louise","rank":3,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Peter Loof","key":"møllerpeterloofpau","last":"Møller","locid":"766c3808-41bf-4dc1-8169-016655a28b63","name":"Møller, Peter Loof","orcid":"0000-0003-1405-5136","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Anna K.","key":"urygaannakpau","last":"Uryga","name":"Uryga, Anna K.","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Djordje","key":"djordjevicdjordjepau","last":"Djordjevic","name":"Djordjevic, Djordje","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jakob","key":"hansenjakobpau","last":"Hansen","name":"Hansen, Jakob","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lise Filt","key":"jensenlisefiltpau","last":"Jensen","name":"Jensen, Lise Filt","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Diana","key":"sharyshdianapau","last":"Sharysh","name":"Sharysh, Diana","rank":9,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Charles","key":"pykecharlespau","last":"Pyke","name":"Pyke, Charles","rank":10,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jaime","key":"morenojaimepau","last":"Moreno","name":"Moreno, Jaime","rank":11,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Giulia","key":"borghettigiuliapau","last":"Borghetti","name":"Borghetti, Giulia","rank":12,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Julian","key":"bachmannjulianpau","last":"Bachmann","name":"Bachmann, Julian","rank":13,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Kate","key":"herumkatepau","last":"Herum","name":"Herum, Kate","rank":14,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lisa Maria","key":"røgelisamariapau","last":"Røge","name":"Røge, Lisa Maria","rank":15,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Matthew","key":"traylormatthewpau","last":"Traylor","name":"Traylor, Matthew","rank":16,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Michael","key":"nybergmichaelpau","last":"Nyberg","name":"Nyberg, Michael","rank":17,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Mette","key":"nyegaardmettepau","last":"Nyegaard","locid":"c048a688-cd64-40ca-a277-53f16360f7a1","name":"Nyegaard, Mette","orcid":"0000-0003-4973-8543","rank":18,"rolecode":"pau"},{"affno":"1 4 5","corresponding":null,"first":"Jacob Fog","key":"bentzonjacobfogpau","last":"Bentzon","name":"Bentzon, Jacob Fog","rank":19,"rolecode":"pau"}],"pub":{"doi":"10.1101/2024.11.11.623011","pages":"40","publisher":"bioRxiv","status":"p"},"review":"Undetermined","search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Private Research","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Hospitals","Novo Nordisk","Private Research","Universities"],"PST":["Published"]},"sid":["aau-5e97a4f4-8634-47d3-8415-1f048b861e57"],"src":["AAU Aalborg University"],"title":"Mapping atherogenesis mechanisms in smooth muscle cells by targeting genes linked to coronary artery disease","type":"Preprint","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-794543","year":"2024","yearsub":"2024"}
{"abstract":"Background: Despite significant progress in recent years, the mortality rate following double lung transplantation (DLTx) remain higher than those observed for other solid organ transplantations. Traditionally, serial longitudinal monitoring has relied on dynamic spirometric indices, but diffusing capacity of the lung for carbon monoxide corrected for hemoglobin (DLCOc) is now also routinely assessed. Here, we sought to investigate the relative impact of changes in FEV1, FVC, and DLCOc from serial testing over time on all-cause mortality after DLTx. Methods: We conducted a retrospective cohort study and included a total of 234 patients who underwent DLTx at a tertiary hospital between January 2012 and January 2019. We performed a time-dependent multivariable Cox hazards model, including all available lung function tests after transplantation. It was performed to evaluate the association between baseline characteristics, sex, native lung disease and changes in lung function metrics over time with all-cause mortality from transplant to death, re-transplantation or to end of follow-up. Results: Following time-dependent multivariable analysis adjusted for predictors of mortality, FEV1 (HR 1.01, 95% CI: 1.004-1.017, p = 0.002), FVC (HR 1.011 95% CI: 1.001-1.021, p = 0.025) and DLCOc (HR 1.016 95% CI: 1.005-1.028, p = 0.006) as % of predicted all remained significantly associated with all-cause mortality. Conclusion: Both reduced FEV1, FVC and DLCOc as % of predicted are independent predictors of death in DLTx patients over time regardless of baseline characteristics, supporting the clinical use of serial full lung function testing for risk assessment and prognostic stratification.","author_count":11,"contributors":["Mohammad, Milan","Peter Hartmann, Jacob","Warncke Kristensen, Anna","Ete Wareham, Neval","Møller Greve, Anders","Kromann Lund, Thomas","Lawaetz Schultz, Hans Henrik","Jensen, Kristine","Perch, Michael","Berg, Ronan M.G.","Mortensen, Jann"],"cuid":["S01-000.00-811425"],"filters":{"added":"2025-06","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"nr","rtype":["clu"],"sorti":"impact of serial lung function metrics after lung transplantation a retrospective cohort study","src":["ku"],"src-code":["DI-U-KU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-811425","ids":["ku-efc0886a-cd68-4f19-bd61-7aa92137ef22"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-2-4F000F271A8C4E8A41FD99E47D31A297"],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Biomedical Sciences, Renal and Vascular Research"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Milan","key":"mohammadpau","last":"Mohammad","name":"Mohammad, Milan","rank":1,"rolecode":"pau"},{"affno":"1","first":"Jacob","key":"peterhartmannpau","last":"Peter Hartmann","name":"Peter Hartmann, Jacob","rank":2,"rolecode":"pau"},{"affno":"1","first":"Anna","key":"warnckekristensenpau","last":"Warncke Kristensen","name":"Warncke Kristensen, Anna","rank":3,"rolecode":"pau"},{"affno":"1","first":"Neva