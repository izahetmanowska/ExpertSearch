":"perneranderspau","last":"Perner","locid":"8a389541-d529-4ee3-8364-66bfc85f77c9","name":"Perner, Anders","rank":68,"rolecode":"pau"},{"affno":"23","corresponding":null,"first":"Rine Moulvad","key":"siegumfeldtrinemoulvadoth","last":"Siegumfeldt","locid":"e57237fc-4c35-458a-95f8-221a377c8734","name":"Siegumfeldt, Rine Moulvad","rank":69,"role":"Other","rolecode":"oth"},{"affno":"23","corresponding":null,"first":"Stine Rom","key":"vestergaardstineromoth","last":"Vestergaard","locid":"f841510b-8964-42ea-b510-22e1baf0b226","name":"Vestergaard, Stine Rom","rank":70,"role":"Other","rolecode":"oth"}],"pmid":["35709019"],"pub":{"doi":"10.1056/nejmoa2202707","issn":["00284793","15334406"],"issn_org":["00284793"],"issue":"26","journal":"The New England Journal of Medicine","pages":"2459-2470","publisher":"Massachussetts Medical Society","status":"p","title":"The New England Journal of Medicine","title_org":"New England Journal of Medicine","volume":"386"},"review":"Peer Reviewed","scoID":["2-s2.0-85133214877"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","North Denmark Region","Other Research","Region Zealand","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-9eac7765-86f2-4d3c-856f-6537ab1cecb6","au-34a83b86-7b4a-467d-9ec7-adf72b6e7b09","ku-637bb267-bce9-4d5e-8032-f7b892c52dc0","sdu-126603fd-5865-4179-9637-4c1cd22c7ff5"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Restriction of Intravenous Fluid in ICU Patients with Septic Shock","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-096.18-007689","year":"2022","yearsub":"2022"}
{"abstract":"AIMS: In refractory out-of-hospital cardiac arrest (OHCA) with prolonged whole-body ischaemia, global tissue injury proceeds even after establishment of circulation with extracorporeal cardiopulmonary resuscitation (ECPR). We aimed to investigate the role of biomarkers reflecting hypoperfusion, inflammation, and organ injury in prognostication of patients with refractory OHCA managed with ECPR. METHODS AND RESULTS: This nationwide retrospective study included 226 adults with refractory OHCA managed with ECPR in Denmark (2011-2020). Biomarkers the first days after ECPR-initiation were assessed. Odds ratio of favourable neurological status (Cerebral Performance Category 1-2) at hospital discharge was estimated by logistic regression analyses. Cut-off values were calculated using the Youden's index. Fifty-six patients (25%) survived to hospital discharge, 51 (91%) with a favourable neurological status. Factors independently associated with favourable neurological status were low flow time <81 min, admission leukocytes ≥12.8 × 109/L, admission lactate <13.2 mmol/L, alkaline phosphatase (ALP) < 56 (day1) or <55 U/L (day2), and day 1 creatine kinase MB (CK-MB) < 500 ng/mL. Selected biomarkers (leukocytes, C-reactive protein, and lactate) were significantly better predictors of favourable neurological status than classic OHCA-variables (sex, age, low-flow time, witnessed arrest, shockable rhythm) alone (P = 0.001) after hospital admission. CONCLUSION: Biomarkers of hypoperfusion (lactate), inflammation (leucocytes), and organ injury (ALP and CK-MB) were independently associated with neurological status at hospital discharge. Biomarkers of hypoperfusion and inflammation (at hospital admission) and organ injury (days 1 and 2 after ECPR) may aid in the clinical decision of when to prolong or terminate ECPR in cases of refractory OHCA.","author_count":20,"contributors":["Gregers, Emilie","Mørk, Sivagowry Rasalingam","Linde, Louise","Andreasen, Jo Bønding","Smerup, Morten","Kjærgaard, Jesper","Møller-Sørensen, Peter Hasse","Holmvang, Lene","Christensen, Steffen","Terkelsen, Christian Juhl","Tang, Mariann","Møller, Jacob Eifer","Lassen, Jens Flensted","Schmidt, Henrik","Riber, Lars Peter","Winther-Jensen, Matilde","Thomassen, Sisse Anette","Laugesen, Helle","Hassager, Christian","Søholm, Helle"],"cuid":["S04-097.65-665735"],"filters":{"added":"2022-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"corresponding_author":["Gregers, Emilie"],"keyword":["Adult","Biomarkers","Cardiopulmonary Resuscitation methods","Consensus statement","Coronary intervention","Elevation","Extracorporeal cardiopulmonary resuscitation","HOSPITAL CARDIAC ARREST","Humans","Hypoperfusion","Inflammation","Lactates","Neurological outcome","Organ injury","Out of Hospital Cardiac Arrest therapy","Out of hospital cardiac arrest","Retrospective Studies","SCORE"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-NP","DI-PR","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA"],"NP":["DI-NP-ALL","DI-NP-HJER"],"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA","DI-NP-HJER","DI-PR-OTH","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"extracorporeal cardiopulmonary resuscitation a national study on the association between favourable neurological status and biomarkers of hypoperfusion inflammation and organ injury","src":["aau","au","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85162232273","version":"Other Version"},"id":"S04-097.65-665735","identifier":[{"id":"36229928","type":"pmid"},{"id":"000879846200001","type":"wos"},{"id":"85162232273","type":"scopus"}],"ids":["aau-273126ed-3e85-457b-a9d1-1626d3717283","au-179eb697-44e9-4a15-8607-ed530d2702c4","ku-8aba445f-d595-4f96-af45-73ff68a80603","sdu-1852763f-b9bc-466d-9460-27ed055174d6"],"keyword":["Adult","Biomarkers","CONSENSUS STATEMENT","CORONARY INTERVENTION","CREATINE KINASE-MB","Cardiopulmonary Resuscitation/methods","ELEVATION","Extracorporeal cardiopulmonary resuscitation","HOSPITAL CARDIAC-ARREST","Humans","Hypoperfusion","Inflammation","Lactates","Neurological outcome","Organ injury","Out-of-Hospital Cardiac Arrest/therapy","Out-of-hospital cardiac arrest","Retrospective Studies","SCORE"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-7-B83BD2AB46C626A0A606C4381B482B20"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Rigshospitalet, Copenhagen University Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Department of Cardiological Medicine B"],"nora_code":"DI-U-AU","used":1},{"affno":"3","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1},{"affno":"4","key":"sdu university of southern denmark","l