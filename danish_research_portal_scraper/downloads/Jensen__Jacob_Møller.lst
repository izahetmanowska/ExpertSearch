793"],"issue":"10","journal":"The New England Journal of Medicine","pages":"888-897","status":"p","title":"The New England Journal of Medicine","title_org":"New England Journal of Medicine","volume":"388"},"review":"Peer Reviewed","scoID":["2-s2.0-85150000006"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-46cfe058-66a5-4eb1-8dc1-67e52fde286e","sdu-3e99d5f2-7e6f-4e2e-bd57-2fba45f0b9ff"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Duration of Device-Based Fever Prevention after Cardiac Arrest","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.94-686241","year":"2023","yearsub":"2023"}
{"abstract":"Extracellular matrix (ECM) remodeling of the skin is a continuous process necessary for maintaining tissue homeostasis. Type VI collagen (COL6) is characterized as a beaded filament, located in the dermal ECM, where COL6-α6-chain has been demonstrated upregulated in atopic dermatitis. The aim of this study was to develop and validate a competitive ELISA, targeting the N-terminal of COL6-α6-chain, named C6A6, and evaluate its associations with the dermatological condition’s atopic dermatitis, psoriasis, hidradenitis suppurativa, systemic lupus erythematosus, systemic sclerosis, urticaria, vitiligo, and cutaneous malignant melanoma in comparison, to healthy controls. A monoclonal antibody was raised and employed in an ELISA assay. The assay was developed, technically validated, and evaluated in two independent patient cohorts. Cohort 1 showed C6A6 was significantly elevated in patients with atopic dermatitis (p < 0.0001), psoriasis (p < 0.0001), hidradenitis suppurativa (p = 0.0095), systemic lupus erythematosus (p = 0.0032) and melanoma (p < 0.0001) compared to healthy donors. Cohort 2 confirmed C6A6 being upregulated in atopic dermatitis compared to healthy controls (p < 0.0001), but also associated with disease severity (SCORAD, p = 0.046) and lowered in patients receiving calcineurin inhibitors (p = 0.014). These findings are hypothesis generating, and the utility of the C6A6 biomarker for disease severity and treatment response needs to be validated in larger cohorts and longitudinal studies.","author_count":11,"contributors":["Holm Nielsen, Signe","Port, Helena","Møller Hausgaard, Cecilie","Holm, Jesper Grønlund","Thyssen, Jacob P.","Groen, Solveig Skovlund","Karsdal, Morten","Nielsen, Valdemar Wendelboe","Egeberg, Alexander","Bay-Jensen, Anne Christine","Thomsen, Simon Francis"],"cuid":["S01-000.00-436997"],"filters":{"added":"2023-04","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-PR","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"PR":["DI-PR-ALL","DI-PR-NBIO"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-PR-NBIO","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"a fragment of type vi collagen alpha 000000000006 chain is elevated in serum from patients with atopic dermatitis psoriasis hidradenitis suppurativa systemic lupus erythematosus and melanoma","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41598-023-28746-2","version":"Published Version"},"id":"S01-000.00-436997","identifier":[{"id":"PMC9945456","type":"pmcid"},{"id":"36810294","type":"pmid"},{"id":"85148551029","type":"scopus"}],"ids":["ku-48f6949a-d381-49c6-a081-425895fe593d"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-93875E08B4D0F6A34E0134CA53F23655"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/337994023/A_fragment_of_type_VI_collagen.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41598-023-28746-2","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"nordic bioscience","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-NBIO","l3nl":"Nordic Bioscience","l3nn":"Nordic Bioscience","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Nordic Bioscience","namevar":["Nordic Bioscience"],"nora_code":"DI-PR-NBIO","used":1},{"affno":"2","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Bispebjerg and Frederiksberg"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","first":"Signe","key":"holmnielsenpau","last":"Holm Nielsen","name":"Holm Nielsen, Signe","rank":1,"rolecode":"pau"},{"affno":"1 2","first":"Helena","key":"portpau","last":"Port","name":"Port, Helena","rank":2,"rolecode":"pau"},{"affno":"1","first":"Cecilie","key":"møllerhausgaardpau","last":"Møller Hausgaard","name":"Møller Hausgaard, Cecilie","rank":3,"rolecode":"pau"},{"affno":"3","first":"Jesper Grønlund","key":"holmpau","last":"Holm","name":"Holm, Jesper Grønlund","rank":4,"rolecode":"pau"},{"affno":"3 2","first":"Jacob P.","key":"thyssenpau","last":"Thyssen","locid":"c02c08ab-10c1-4ce8-bec3-447154952fc2","name":"Thyssen, Jacob P.","rank":5,"rolecode":"pau"},{"affno":"1 2","first":"Solveig Skovlund","key":"groenpau","last":"Groen","locid":"c3ed8d9e-938e-4f49-a455-50b597700222","name":"Groen, Solveig Skovlund","rank":6,"rolecode":"pau"},{"affno":"1","first":"Morten","key":"karsdalpau","last":"Karsdal","name":"Karsdal, Morten","rank":7,"rolecode":"pau"},{"affno":"3","first":"Valdemar Wendelboe","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Valdemar Wendelboe","rank":8,"rolecode":"pau"},{"affno":"3 2","first":"Alexander","key":"egebergpau","last":"Egeberg","locid":"e4445a48-c228-4507-b47c-a83175478f82","name":"Egeberg, Alexander","rank":9,"rolecode":"pau"},{"affno":"1","first":"Anne Christine","key":"bayjensenpau","last":"Bay-Jensen","name":"Bay-Jensen, Anne Christine","rank":10,"rolecode":"pau"},{"affno":"3 2","first":"Simon Francis","key":"thomsenpau","last":"Thomsen","locid":"045de28d-7e61-4908-8fa9-afd09ac8234a","name":"Thomsen, Simon Francis","rank":11,"rolecode":"pau"}],"pmid":["36810294"],"pub":{"doi":"10.1038/s41598-023-28746-2","issn":["20452322"],"issue":"1","journal":"Scientific Reports","paperid":"3056","status":"p","title":"Scientific Reports","volume":"13"},"review":"Peer Reviewed","scoID":["2-s2.0-85148551029"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Private Research","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Hospitals","Nordic Bioscience","Private Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-48f6949a-d381-49c6-a081-425895fe593d"],"src":["KU University of Copenhagen"],"title":"A fragment of type VI collagen alpha-6 chain is elevated in serum from patients with atopic dermatitis, psoriasis, hidradenitis suppurativa, systemic lupus erythematosus and melanoma","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-436997","year":"2023","yearsub":"2023"}
{"abstract":"Objective: Child mortality and stillbirth rates (SBR) remain high in low-income countries but may be underestimated due to incomplete reporting of child deaths in retrospective pregnancy/birth histories. The aim of this study is to compare stillbirth and mortality estimates derived using two different methods: the method assuming full information and the prospective method. Methods: Bandim Health Project's Health and Demographic Surveillance Systems (HDSS) follows women of reproductive age and children under five through routine home visits every 1, 2 or 6 months. Between 2012 and 2020, we estimated and compared early neonatal (ENMR, <7 days), neonatal (NMR, <28 days), and infant mortality (IMR, <1 year) per 1000 live births and SBR per 1000 births. Risk time for children born to registered women was calculated from birth (the method assuming full information) versus date of first observation in the HDSS (the prospective method), either at birth (for pregnancy registration) or registration. Rates were calculated using the Kaplan–Meier estimator and compared in generalised linear models allowing for within-child correlation obtaining relative risks (RR). Results: We registered and followed 29,413 infants (1380 deaths; 1459 stillbirths) prospectively. An additional 164 infant deaths and 129 stillbirths were registered retrospectively and included in the method assuming full information. The ENMR was 24.5 (95%CI: 22.6–26.4) for the method assuming full information and 25.8 (23.7–27.8) for the prospective method, RR = 0.96 (0.93–0.99). Differences were smaller for the NMRs and IMRs. For SBRs, the estimates were 53.5 (50.9–56.0) and 58.6 (55.7–61.5); RR = 0.91 (0.90–0.93). The difference between methods became more pronounced when the analysis was limited to areas visited every 6 months: RR for ENMR: 0.91 (0.86–0.96) and RR for SBR: 0.85 (0.83–0.87). Conclusions: Assuming full information underestimates SBR and ENMR. Accounting for omissions of stillbirths and early neonatal deaths may lead to more accurate estimates and improved ability to monitor mortality.","author_count":7,"contributors":["Jensen, Andreas Møller","Thysen, Sanne Marie","Furtado, Oides","Correia, Claudino","Helleringer, Stéphane","Hjelmborg, Jacob","Fisker, Ane Bærent"],"cuid":["S01-000.00-685400"],"filters":{"added":"2023-09","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Africa","Asia, Middle East"],"corresponding_author":["Jensen, Andreas Møller"],"country":["Guinea-Bissau","United Arab Emirates"],"glorg":["All Global Affiliations","Bandim Health Project","INDEPTH Network","New York University of Abu Dhabi"],"keyword":["Child mortality","Female","Humans","Infant","Infant Mortality","Infant Newborn","Low income countries","Mortality rates","Pregnancy","Retrospective Studies","Risk","Stillbirth epidemiology"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"stillbirth and early neonatal mortality rates may be underestimated using recall information a comparison of demographic surveillance methodologies","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1111/tmi.13903","version":"Published Version"},"funding_acknowledgement":["This work was supported by a Faculty Scholarship from University of Southern Denmark to AMJ; and a Sapere Aude grant from Independent Research Fund Denmark [9060‐00018B] to ABF."],"id":"S01-000.00-685400","identifier":[{"id":"85161370382","type":"scopus"},{"id":"37269131","type":"pmid"}],"ids":["sdu-cdb35fbd-4cfc-44a2-bde9-0a94f3ab7d73"],"keyword":["Female","Health and Demographic Surveillance Systems","Humans","Infant","Infant Mortality","Infant, Newborn","Pregnancy","Retrospective Studies","Risk","Stillbirth/epidemiology","child mortality","low-income countries","mortality rates","prospective data","stillbirth rates"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-511C54A3378BAD73E62CB71604251AE7"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/237029720/Tropical_Med_Int_Health_2023_Jensen.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1111/tmi.13903","version":"Published Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Open - Bandim"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"gw","key":"bandim health project","loc":["Guinea-Bissau","Africa"],"name":"Bandim Health Project","used":1},{"affno":"3","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Bispebjerg and Frederiksberg Hospitals"],"nora_code":"DI-HO-CAP","used":1},{"affno":"4","country":"gw","key":"indepth network","loc":["Guinea-Bissau","Africa"],"name":"INDEPTH Network","used":1},{"affno":"5","country":"ae","key":"new york university of abu dhabi","loc":["United Arab Emirates","Asia, Middle East"],"name":"New York University of Abu Dhabi","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Andreas Møller","key":"jensenpau","last":"Jensen","locid":"ed00ca99-bbe1-4902-a8c6-e489882f5918","name":"Jensen, Andreas Møller","orcid":"0000-0003-4340-3822","rank":1,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Sanne Marie","key":"thysenpau","last":"Thysen","name":"Thysen, Sanne Marie","rank":2,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Oides","key":"furtadopau","last":"Furtado","name":"Furtado, Oides","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Claudino","key":"correiapau","last":"Correia","name":"Correia, Claudino","rank":4,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Stéphane","key":"helleringerpau","last":"Helleringer","name":"Helleringer, Stéphane","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jacob","key":"vonbornemannhjelmborgpau","last":"von Bornemann Hjelmborg","locid":"7cec567c-2361-426a-8f47-f331d15d8c30","name":"Hjelmborg, Jacob","name_org":"von Bornemann Hjelmborg, Jacob","orcid":"0000-0001-9630-9149","rank":6,"rolecode":"pau"},{"affno":"2 1","corresponding":null,"first":"Ane Bærent","key":"fiskerpau","last":"Fisker","locid":"4f3e979a-3c2b-45ab-8a76-06b96437348b","name":"Fisker, Ane Bærent","orcid":"0000-0002-8521-0992","rank":7,"rolecode":"pau"}],"pmid":["37269131"],"pub":{"doi":"10.1111/tmi.13903","issn":["13602276","13653156"],"issn_org":["13602276"],"issue":"7","journal":"Tropical Medicine & International Health","pages":"562-570","publisher":"Wiley","status":"p","title":"Tropical Medicine & International Health","title_org":"Tropical Medicine and International Health","volume":"28"},"review":"Peer Reviewed","scoID":["2-s2.0-85161370382"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-cdb35fbd-4cfc-44a2-bde9-0a94f3ab7d73"],"src":["SDU University of Southern Denmark"],"title":"Stillbirth and early neonatal mortality rates may be underestimated using recall information : A comparison of demographic surveillance methodologies","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-685400","year":"2023","yearsub":"2023"}
{"abstract":"The molecular events governing skeletal muscle glucose uptake have pharmacological potential for managing insulin resistance in conditions such as obesity, diabetes, and cancer. With no current pharmacological treatments to target skeletal muscle insulin sensitivity, there is an unmet need to identify the molecular mechanisms that control insulin sensitivity in skeletal muscle. Here, the Rho guanine dissociation inhibitor α (RhoGDIα) is identified as a point of control in the regulation of insulin sensitivity. In skeletal muscle cells, RhoGDIα interacted with, and thereby inhibited, the Rho GTPase Rac1. In response to insulin, RhoGDIα was phosphorylated at S101 and Rac1 dissociated from RhoGDIα to facilitate skeletal muscle GLUT4 translocation. Accordingly, siRNA-mediated RhoGDIα depletion increased Rac1 activity and elevated GLUT4 translocation. Consistent with RhoGDIα's inhibitory effect, rAAV-mediated RhoGDIα overexpression in mouse muscle decreased insulin-stimulated glucose uptake and was detrimental to whole-body glucose tolerance. Aligning with RhoGDIα's negative role in insulin sensitivity, RhoGDIα protein content was elevated in skeletal muscle from insulin-resistant patients with type 2 diabetes. These data identify RhoGDIα as a clinically relevant controller of skeletal muscle insulin sensitivity and whole-body glucose homeostasis, mechanistically by modulating Rac1 activity.","author_count":20,"contributors":["Møller, Lisbeth Liliendal Valbjørn","Ali, Mona Sadek","Davey, Jonathan","Raun, Steffen Henning","Andersen, Nicoline Resen","Long, Jonathan Z","Qian, Hongwei","Jeppesen, Jacob","Henriquez-Olguin, Carlos","Frank, Emma","Jensen, Thomas Elbenhardt","Højlund, Kurt","Wojtaszewski, Jørgen","Nielsen, Joachim","Chiu, Tim T","Jedrychowski, Mark P","Gregorevic, Paul","Klip, Amira","Richter, Erik A.","Sylow, Lykke"],"cuid":["S02-095.00-686344"],"filters":{"added":"2023-08","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["America, North","America, South","OECD","Oceania"],"corresponding_author":["Sylow, Lykke"],"country":["Australia","Canada","Chile","United States"],"glorg":["All Global Affiliations","Dana-Farber Cancer Institute","Finis Terrae University","Harvard Medical School","Harvard University","Stanford University","The Hospital for Sick Children","The Hospital for Sick Children, Toronto","Universidad Finis Terrae","University of Melbourne","University of Toronto"],"keyword":["Diabetes Mellitus Type 2 metabolism","GLUT4 translocation","Glucose uptake","Insulin Resistance","Insulin sensitivity","Mice","Skeletal muscle","Type 2 diabetes"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"the rho guanine dissociation inhibitor α inhibits skeletal muscle rac000000000001 activity and insulin action","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1073/pnas.2211041120","version":"Published Version"},"id":"S02-095.00-686344","identifier":[{"id":"85163335724","type":"scopus"},{"id":"37364105","type":"pmid"},{"id":"PMC10318982","type":"pmcid"}],"ids":["ku-ff175eb2-e863-4b51-aa25-d72b58d5e0dd","sdu-2347e2ce-2ae2-46c2-8258-dd4ad521dad6"],"keyword":["Diabetes Mellitus, Type 2 / Metabolism","GLUT4 translocation","Glucose uptake","Insulin resistance","Insulin sensitivity","Mice","Rho guanine nucleotide Dissociation Inhibitor alpha/metabolism","Skeletal muscle","Type 2 diabetes"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-DB76BC688FDD785952FD4CDCAA8AAB28"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1073/pnas.2211041120","version":"Published Version"},{"acces