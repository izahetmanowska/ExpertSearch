47-8758","rank":1,"rolecode":"pau"},{"affno":"4","first":"Jakob","key":"josiassenpau","last":"Josiassen","name":"Josiassen, Jakob","rank":2,"rolecode":"pau"},{"affno":"5","first":"Christian","key":"hassagerpau","last":"Hassager","locid":"49196e5d-0f61-44b2-a6b9-cd6c5f8f3bc2","name":"Hassager, Christian","orcid":"0000-0002-1199-0981","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lisette Okkels","key":"jensenpau","last":"Jensen","locid":"b78c452e-5a69-41fe-ba49-0096c84d1d4d","name":"Jensen, Lisette Okkels","orcid":"0000-0002-4838-2429","rank":4,"rolecode":"pau"},{"affno":"5","first":"Lene","key":"holmvangpau","last":"Holmvang","locid":"54b8ef01-f8ed-4c49-a126-2109e2fd351f","name":"Holmvang, Lene","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Nanna Louise Junker","key":"udesenpau","last":"Udesen","locid":"f71f56f5-4f36-4de5-a7ae-e5e51f101a83","name":"Udesen, Nanna Louise Junker","orcid":"0000-0003-1542-3260","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Henrik","key":"schmidtpau","last":"Schmidt","locid":"9789920f-4b31-4f28-8211-97afced9d61e","name":"Schmidt, Henrik","rank":7,"rolecode":"pau"},{"affno":"5","first":"Hanne","key":"bergravnpau","last":"Berg Ravn","locid":"3049e7b7-0f18-413b-88ab-a3d77ebc079b","name":"Ravn, Hanne Berg","name_org":"Berg Ravn, Hanne","rank":8,"rolecode":"pau"},{"affno":"2 6","corresponding":null,"first":"Jacob Eifer","key":"mollerpau","last":"Moller","locid":"5e4d3cb6-b0a0-4541-aea1-30e73f7c10b8","name":"Møller, Jacob Eifer","name_org":"Moller, Jacob Eifer","orcid":"0000-0003-2873-5845","rank":9,"rolecode":"pau"}],"pmid":["32201591"],"pub":{"doi":"10.1136/openhrt-2019-001214","issn":["20533624","2398595X"],"issn_org":["2398595X"],"issue":"1","journal":"Open Heart","paperid":"e001214","publisher":"BMJ Publishing Group","status":"p","title":"Open Heart","volume":"7"},"review":"Peer Reviewed","scoID":["2-s2.0-85081219360"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-630517d5-23b5-497b-b9c1-7ee063ab1fb4","ku-e6666bbd-3a82-4eaa-9408-810ab9356c21","sdu-c3d434ed-8d15-4b34-85b0-d41970ea7b2e"],"src":["AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Contemporary trends in use of mechanical circulatory support in patients with acute MI and cardiogenic shock","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-100.00-019848","year":"2020","yearsub":"2020"}
{"abstract":"PURPOSE: While several studies have investigated clinical outcomes following coronary artery bypass grafting (CABG) vs. percutaneous coronary intervention (PCI), studies investigating self-reported health and the association with adverse outcomes are limited. Thus, the aim was to investigate differences in health-related quality of life (HRQoL), anxiety and depression at discharge and the association with a composite endpoint of the first event of acute cardiac readmission, revascularisation or 1-year mortality among patients undergoing CABG vs. PCI. METHODS: Data from the national cohort study, DenHeart, were used, including measures of HRQoL; EuroQoL-5D-5L (EQ-5D Index Score and VAS) and HeartQoL (Global, Physical and Emotional), anxiety and depression (Hospital Anxiety and Depression Scale, HADS) and register-based follow-up. A total of 7000 patients were included (CABG n = 652, PCI n = 6348) (median age 65, 75% men). Cox Proportional Hazard models were performed among a propensity-matched population of responders (n = 520). RESULTS: HRQoL was significantly better among patients undergoing PCI vs. CABG, but with no differences in time to readmission or revascularisation. HRQoL, anxiety and depression were significantly associated with the risk of the composite endpoint among the PCI group (Hazard Ratio, HR (95% confidence intervals, CI) [EQ-5D index score 3.07 (1.67-5.67), EQ-5D VAS 0.97 (0.96-0.99), HeartQol Global 0.61 (0.38-0.95), HeartQol Emotional 0.56 (0.39-0.80), HADS-D ≥ 8 3.12 (1.61-6.01), HADS-A ≥ 8 2.08 (1.14-3.80)]. CONCLUSION: Patients undergoing PCI reported better HRQoL at discharge compared with patients undergoing CABG, whereas readmission rates were similar. Self-reported health was associated with the risk of adverse events among patients undergoing PCI, but not among patients undergoing CABG. CLINICAL TRIAL REGISTRATION: NCT01926145.","author_count":13,"contributors":["Nielsen, Stine Nørris","Rasmussen, Trine Bernholdt","Lassen, Jens Flensted","Berg, Selina Kikkenborg","Thrysoee, Lars","Møller, Jacob Eifer","Jensen, Lisette Okkels","Thuesen, Anne Langhoff","Christensen, Anne Vinggaard","Ekholm, Ola","Mols, Rikke","Thorup, Charlotte Brun","Borregaard, Britt"],"cuid":["S04-100.00-009776"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"corresponding_author":["Nielsen, Stine Nørris"],"keyword":["Anxiety","Cardiac readmission","Coronary artery bypass grafting","Depression","Disease","Mortality","Percutaneous Coronary Intervention","Propensity Score","Quality of Life","Questionnaire","Reliability","Surgery","Symptoms"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"the association between self reported health status and adverse events a comparison among coronary artery bypass grafting cabg versus percutaneous coronary intervention pci","src":["aau","au","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/290598401/Nielsen_etal_The_association_between_self_reported_health_status_and_adverse_events_accepted_version_.pdf","version":"Authors Final Version"},"id":"S04-100.00-009776","identifier":[{"id":"32857268","type":"pmid"},{"id":"85089982142","type":"scopus"},{"id":"000563648000001","type":"wos"}],"ids":["aau-cbe7c719-d841-49b0-a869-003a4c74bcda","au-f38af06e-0a99-469b-85fd-75078e535bde","ku-8c9100ab-7381-4344-85fc-5fc7fa3f98e8","sdu-1765d5df-2aa9-4a13-99d9-91c74749199e"],"keyword":["Anxiety","Cardiac readmission","Coronary artery bypass grafting","DISEASE","Depression","MORTALITY","PROPENSITY SCORE","Percutaneous coronary intervention","QUESTIONNAIRE","Quality of life","RELIABILITY","SURGERY","SYMPTOMS"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-7-BA6AC75CE1EE59B6580A82F42AC1E014"],"oa_link":[{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/290598401/Nielsen_etal_The_association_between_self_reported_health_status_and_adverse_events_accepted_version_.pdf","version":"Authors Final Version"},{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/174295932/Manuskript_20_20word_20fil.pdf","version":"Authors Final Version"},{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/458823315/Manuskript_20_20word_20fil.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Cardiology (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, No speciality"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capit