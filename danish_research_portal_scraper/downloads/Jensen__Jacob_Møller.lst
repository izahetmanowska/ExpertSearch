mpau","last":"Zuberi","name":"Zuberi, Sameer M.","rank":79,"rolecode":"pau"},{"affno":"49","corresponding":null,"first":"Renzo","key":"guerrinirenzopau","last":"Guerrini","name":"Guerrini, Renzo","rank":80,"rolecode":"pau"},{"affno":"16","corresponding":null,"first":"Heather C.","key":"meffordheathercpau","last":"Mefford","name":"Mefford, Heather C.","rank":81,"rolecode":"pau"},{"affno":"77","corresponding":null,"first":"Chirag","key":"patelchiragpau","last":"Patel","name":"Patel, Chirag","rank":82,"rolecode":"pau"},{"affno":"14 15","corresponding":null,"first":"Yue Hua","key":"zhangyuehuapau","last":"Zhang","name":"Zhang, Yue Hua","rank":83,"rolecode":"pau"},{"affno":"6 5","corresponding":null,"first":"Rikke S.","key":"møllerrikkespau","last":"Møller","locid":"85de2fa9-456c-4427-8c30-7dc1bdd4bcf0","name":"Møller, Rikke S.","orcid":"0000-0002-9664-1448","rank":84,"rolecode":"pau"},{"affno":"1 8 9 10","corresponding":null,"first":"Ingrid E.","key":"schefferingridepau","last":"Scheffer","name":"Scheffer, Ingrid E.","rank":85,"rolecode":"pau"}],"pmid":["33144681"],"pub":{"doi":"10.1038/s41436-020-00988-9","issn":["10983600","15300366"],"issn_org":["10983600"],"issue":"2","journal":"Genetics in Medicine","pages":"363-373","publisher":"Elsevier BV","publisher_org":"Elsevier B.V.","status":"p","title":"Genetics in Medicine","title_org":"Genetics in medicine : official journal of the American College of Medical Genetics","volume":"23"},"review":"Peer Reviewed","scoID":["2-s2.0-85094911047"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["au-e1131532-0dbb-452b-b498-161c14d65f97","sdu-0aa30400-118a-4c72-8dc9-988b48fea31e"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"NEXMIF encephalopathy : an X-linked disorder with male and female phenotypic patterns","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-093.18-028991","year":"2021","yearsub":"2021"}
{"abstract":"The aim was to translationally compare a pharmacologic strategy versus treatment with the Impella RP in profound RV cardiogenic shock (CS). The pigs were allocated to either vasoactive therapy with norepinephrine (0.10 μg/kg/min) for the first 30 min, supplemented by an infusion of milrinone (0.4 μg/kg/min) for additional 150 min, or treatment with the Impella RP device for 180 min. Total RV workload (Pressure-volume-area × heart rate*103(mmHg/min)) remained unaffected upon treatment with the Impella RP and increased in the vasoactive group (CS 179[147;228] to norepinephrine 268[247;306](p = 0.002 compared to Impella RP) and norepinephrine + milrinone 366[329;422] (p = 0.002 compared to Impella RP). A trend towards higher venous cerebral oxygen saturation was observed with norepinephrine than Impella RP (Impella RP 51[47;61]% vs norepinephrine 62[57;71]%; p = 0.07), which became significantly higher with the addition of milrinone (Impella RP 45[32;63]% vs norepinephrine + milrinone 73[66;81]%; p = 0.002). The Impella RP unloaded the failing RV. In contrast, vasoactive treatment led to enhanced cerebral venous oxygen saturation.","author_count":10,"contributors":["Josiassen, Jakob","Helgestad, Ole K.L.","Udesen, Nanna L.J.","Banke, Ann","Frederiksen, Peter H.","Schmidt, Henrik","Jensen, Lisette O.","Hassager, Christian","Møller, Jacob E.","Ravn, Hanne Berg"],"cuid":["S02-100.00-043324"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Josiassen, Jakob"],"keyword":["Cardiogenic shock","Hemodynamics","Impella RP","Translational science","Vasopressor","Ventricular unloading"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"impella rp versus pharmacologic vasoactive treatment in profound cardiogenic shock due to right ventricular failure","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85105464348","version":"Other Version"},"funding_acknowledgement":["This work was supported by the Danish Heart Foundation, Abiomed, and the Jørgen Møller Foundation. The funders had no influence on any aspects of current work. Professor Møller has received a research grant from Abiomed. The remaining authors declare no competing interests."],"id":"S02-100.00-043324","identifier":[{"id":"33977379","type":"pmid"},{"id":"85105464348","type":"scopus"}],"ids":["ku-6f26d48f-7dc3-4787-b7e8-82966dc07741","sdu-11d8067a-0e3c-48e4-b5b8-d51498c44eab"],"keyword":["Cardiogenic shock","Hemodynamics","Impella RP","Translational science","Vasopressor","Ventricular unloading"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-B36F51206CAC83CB090F09951D79A06E"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","key":"sdu university of southern denmark","l2":"DI-U","l2n