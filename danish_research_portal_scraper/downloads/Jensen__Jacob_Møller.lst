istensenpau","last":"Christensen","locid":"ccaa5c92-7e05-4fcc-a0cd-d968e54ac51b","name":"Christensen, Jacob Højgaard","orcid":"0000-0002-9835-4522","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christian C.","key":"kjeldsenpau","last":"Kjeldsen","locid":"401b523f-a4ff-43e9-aaeb-b38bf32f0fd9","name":"Kjeldsen, Christian Christrup","name_org":"Kjeldsen, Christian C.","orcid":"0000-0001-5283-5622","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rune Müller","key":"kristensenpau","last":"Kristensen","locid":"7abd3b5a-d4f5-4357-a3e9-faae69a9cfd9","name":"Kristensen, Rune Müller","orcid":"0000-0001-5132-2462","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lenette Møller","key":"jensenpau","last":"Jensen","locid":"71c7a611-86fe-4e01-bc59-49cb489dedc6","name":"Jensen, Lenette Møller","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Elisabeth","key":"rasmussenpau","last":"Rasmussen","locid":"e69e45b4-a2ba-46ad-8b4a-02eff43bde5a","name":"Rasmussen, Elisabeth","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Cristina","key":"delavillagonzalezpau","last":"de la Villa Gonzalez","locid":"aaade40a-ed4a-4b3b-b602-b668fb83b04e","name":"de la Villa Gonzalez, Cristina","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jeppe","key":"bundsgaardpau","last":"Bundsgaard","locid":"4a1b113e-a953-4404-afd0-5ed58703e8b1","name":"Bundsgaard, Jeppe","orcid":"0000-0003-0102-0321","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Sofie Gry","key":"bindslevpau","last":"Bindslev","locid":"c83214e2-0c50-42fd-a024-539ab34e5a02","name":"Bindslev, Sofie Gry","rank":8,"rolecode":"pau"}],"pub":{"status":"X"},"review":"Undetermined","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Undefined"]},"sid":["au-3b392323-49b7-44bc-a2d8-59c31c57f42b"],"src":["AU Aarhus University"],"title":"Vi har nået bagkanten af pandemien – men hvordan er det gået med elevernes faglighed?","type":"Other-Internet Publication","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-163104","year":"2022","yearsub":"2022"}
{"abstract":"Aims: To evaluate and compare survival after out-of-hospital (OHCA), where an automated external defibrillator (AED) was used, in densely, moderately and thinly populated areas. Also, to evaluate the association between AED retrieval distance and survival after OHCA. Methods: From 2014 to 2018, AEDs used during OHCA in the region of Southern Denmark were systematically collected. OHCAs were included if the OHCA address was known. OHCAs at nursing homes were excluded. To evaluate population density, a map with 1000 × 1000 meter grid cells was used with each cell color-graded according to the number of inhabitants. Densely, moderately and thinly populated areas were defined as ≥200 inhabitants, 20–199 inhabitants and 0–19 inhabitants per km 2, respectively. Primary outcome was 30-day survival. Results: A total of 423 cases of OHCA were included, of which 207 (49%) occurred in densely populated areas, while 78 (18%) and 138 (33%) occurred in moderately and thinly populated areas, respectively. AED retrieval distances were: densely populated 105 m (IQR 5–450), moderately populated 220 m (IQR 5–450) and thinly populated 350 m (IQR 5–1500) (P < 0.001). Thirty-day survival was 40%, 31% and 34%, respectively (P = 0.3). In a multivariable regression analysis, mortality increased with 10% per 100 m an AED was placed further away from the site of OHCA. Conclusion: Survival after OHCA, where an AED was used, did not seem to differ in thinly, moderately and densely populated areas. The length of the AED retrieval distance, however, was correlated with reduced survival after adjusting for other potentially explanatory variables.","author_count":9,"contributors":["Sarkisian, Laura","Mickley, Hans","Schakow, Henrik","Gerke, Oke","Starck, Simon Michael","Jensen, Jonas Junghans","Møller, Jacob Eifer","Jørgensen, Gitte","Henriksen, Finn Lund"],"cuid":["S01-000.00-616312"],"filters":{"added":"2022-05","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Sarkisian, Laura"],"keyword":["Automated external defibrillator","Bystander defibrillation","Out of hospital cardiac arrest","Resuscitation","Volunteer first responders"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-SDR"],"OT":["Emergency Medical Services, Region of Southern Denmark, Damhaven 12, 7100 Vejle"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-SDR","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"longer retrieval distances to the automated external defibrillator reduces survival after out of hospital cardiac arrest","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/194476129/RESUS_D_21_00957_R2.pdf","version":"Authors Final Version"},"id":"S01-000.00-616312","identifier":[{"id":"34767901","type":"pmid"},{"id":"85119411955","type":"scopus"}],"ids":["sdu-9686fe3d-1a41-4826-b8a2-d10862d95f91"],"keyword":["Automated external defibrillator","Bystander defibrillation","Out-of-hospital cardiac arrest","Resuscitation","Volunteer first responders"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-B1FE53CE3E02B96E0943DDFD5F92B120"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/194476129/RESUS_D_21_00957_R2.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research Unit OPEN (Odense)","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Cardiology (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Emergency Medical Services, Region of Southern Denmark, Damhaven 12, 7100 Vejle"],"nora_code":"DI-OT","used":1},{"affno":"3","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Odense University Hospital"],"nora_code":"DI-HO-SDR","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Laura","key":"sarkisianpau","last":"Sarkisian","locid":"472392ba-c3e3-4a00-ae8e-9a24b7706ab3","name":"Sarkisian, Laura","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hans","key":"mickleypau","last":"Mickley","locid":"f6789f9a-e23b-4ab8-bd7d-a3c168107cdb","name":"Mickley, Hans","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Henrik","key":"schakowpau","last":"Schakow","name":"Schakow, Henrik","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Oke","key":"gerkepau","last":"Gerke","locid":"596baeb1-6754-4d53-948f-30470dd1d976","name":"Gerke, Oke","orcid":"0000-0001-6335-3303","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Simon Michael","key":"starckpau","last":"Starck","name":"Starck, Simon Michael","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jonas Junghans","key":"jensenpau","last":"Jensen","name":"Jensen, Jonas Junghans","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jacob Eifer","key":"møllerpau","last":"Møller","locid":"5e4d3cb6-b0a0-4541-aea1-30e73f7c10b8","name":"Møller, Jacob Eifer","orcid":"0000-0003-2873-5845","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Gitte","key":"jørgensenpau","last":"Jørgensen","name":"Jørgensen, Gitte","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Finn Lund","key":"henriksenpau","last":"Henriksen","locid":"df341fee-5044-4b19-b725-cfbd0e7914bf","name":"Henriksen, Finn Lund","orcid":"0000-0002-1192-532X","rank":9,"rolecode":"pau"}],"pmid":["34767901"],"pub":{"doi":"10.1016/j.resuscitation.2021.11.001","issn":["03009572","18731570"],"issn_org":["03009572"],"journal":"Resuscitation","pages":"44-52","publisher":"Elsevier","status":"p","title":"Resuscitation","volume":"170"},"review":"Peer Reviewed","scoID":["2-s2.0-85119411955"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Region of Southern Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-9686fe3d-1a41-4826-b8a2-d10862d95f91"],"src":["SDU University of Southern Denmark"],"title":"Longer Retrieval Distances to the Automated External Defibrillator Reduces Survival After Out-of-Hospital Cardiac Arrest","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-616312","year":"2022","yearsub":"2022"}
{"abstract":"Abstract Funding Acknowledgements Type of funding sources: None. Background Differences in outcome between men and women among patients with acute myocardial infarction (AMI) have previously been investigated[1–4], while evidence concerning sex differences in patients with AMI complicated by cardiogenic shock (AMICS) is limited. Purpose The aim of this study was to investigate sex differences in patients with AMICS related to demographics, treatment and long-term outcome. Methods All adult patients (age ≥18 years) with AMICS hospitalized at one of two tertiary heart centers with a catchment area corresponding to 4 million citizens were included in this study. In the study period from January 1st, 2010 to December 31st, 2017, a total of 1716 AMICS patients were identified following individual validation. Data regarding patient characteristics, treatment and clinical outcome including short-term follow-up were extracted from medical records and an 8,5-year long-term follow-up were obtained from the national patients registry. A multivariate cox regression model was used to adjust for significant sex differences known to be associated with outcome in AMICS including age and an out-of-hospital cardiac arrest (OHCA) presentation. Results Of the 1716 included AMICS patients, 438 (26%) were women. Women were older than men, 71±12 years and 66±11 years, P=","author_count":11,"contributors":["Holle, S","Josiassen, J","Helgestad, Ole Kristian Lerche","Schmidt, Henrik","Holmvang, L","Jensen, Lisette Okkels","Ravn, Hanne Berg","Møller, Jacob Eifer","Fosboel, EL","Thoegersen, M","Hassager, C"],"cuid":["S01-000.00-626786"],"event":{"end":"2022-03-19","start":"2022-03-18","title":"ESC Acute CardioVascular Care 2022","year":"2022"},"filters":{"added":"2022-11","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"sex differences in treatment and outcome of patients with cardiogenic shock complicating acute myocardial infarction","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1093/ehjacc/zuac041.022","version":"Published Version"},"id":"S01-000.00-626786","ids":["sdu-baecd3fe-8756-4736-9fe4-12e9c42f8c69"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-CEE4814A1FF13D4E4276FF8B3E8F6CCA"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1093/ehjacc/zuac041.022","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Cardiology (Odense)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"S","key":"hollepau","last":"Holle","name":"Holle, S","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"J","key":"josiassenpau","last":"Josiassen","name":"Josiassen, J","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"OKL","key":"helgestadpau","last":"Helgestad","locid":"ab9f3165-500c-482b-9c2f-1879b3abedb3","name":"Helgestad, Ole Kristian Lerche","name_org":"Helgestad, OKL","orcid":"0000-0003-3847-8758","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"H","key":"schmidtpau","last":"Schmidt","locid":"9789920f-4b31-4f28-8211-97afced9d61e","name":"Schmidt, Henrik","name_org":"Schmidt, H","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"L","key":"holmvangpau","last":"Holmvang","name":"Holmvang, L","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"LO","key":"jensenpau","last":"Jensen","locid":"b78c452e-5a69-41fe-ba49-0096c84d1d4d","name":"Jensen, Lisette Okkels","name_org":"Jensen, LO","orcid":"0000-0002-4838-2429","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"HB","key":"ravnpau","last":"Ravn","locid":"25de7650-3dc1-4594-b758-9c36f6de6306","name":"Ravn, Hanne Berg","name_org":"Ravn, HB","orcid":"0000-0003-4702-5195","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"JE","key":"moellerpau","last":"Moeller","locid":"5e4d3cb6-b0a0-4541-aea1-30e73f7c10b8","name":"Møller, Jacob Eifer","name_org":"Moeller, JE","orcid":"0000-0003-2873-5845","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"EL","key":"fosboelpau","last":"Fosboel","name":"Fosboel, EL","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"M","key":"thoegersenpau","last":"Thoegersen","name":"Thoegersen, M","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"C","key":"hassagerpau","last":"Hassager","name":"Hassager, C","rank":11,"rolecode":"pau"}],"pub":{"doi":"10.1093/ehjacc/zuac041.022","issn":["20488726","20488734"],"issn_org":["20488734"],"issue":"Suppl. 1","journal":"European Heart Journal: Acute Cardiovascular Care","paperid":"20047","publisher":"Oxford University Press","status":"p","title":"European Heart Journal: Acute Cardiovascular Care","title_org":"European Heart Journal - Acute Cardiovascular Care","volume":"11"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-baecd3fe-8756-4736-9fe4-12e9c42f8c69"],"src":["SDU University of Southern Denmark"],"title":"Sex differences in treatment and outcome of patients with cardiogenic shock complicating acute myocardial infarction","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-626786","year":"2022","yearsub":"2022"}
{"abstract":"BACKGROUND: The appropriate oxygenation target for mechanical ventilation in comatose survivors of out-of-hospital cardiac arrest is unknown. METHODS: In this randomized trial with a 2-by-2 factorial design, we randomly assigned comatose adults with out-of-hospital cardiac arrest in a 1:1 ratio to either a restrictive oxygen target of a partial pressure of arterial oxygen (Pao2) of 9 to 10 kPa (68 to 75 mm Hg) or a liberal oxygen target of a Pao2 of 13 to 14 kPa (98 to 105 mm Hg); patients were also assigned to one of two blood-pressure targets (reported separately). The primary outcome was a composite of death from any cause or hospital discharge with severe disability or coma (Cerebral Performance Category [CPC] of 3 or 4; categories range from 1 to 5, with higher values indicating more severe disability), whichever occurred first within 90 days after randomization. Secondary outcomes were neuron-specific enolase levels at 48 hours, death from any cause, the score on the Montreal Cognitive Assessment (ranging from 0 to 30, with higher scores indicating better cognitive ability), the score on the modified Rankin scale (ranging from 0 to 6, with higher scores indicating greater disability), and the CPC at 90 days. RESULTS: A total of 789 patients underwent randomization. A primary-outcome event occurred in 126 of 394 patients (32.0%) in the restrictive-target group and in 134 of 395 patients (33.9%) in the liberal-target group (hazard ratio, 0.95; 95% confidence interval, 0.75 to 1.21; P = 0.69). At 90 days, death had occurred in 113 patients (28.7%) in the restrictive-target group and in 123 (31.1%) in the liberal-target group. On the CPC, the median category was 1 in the two groups; on the modified Rankin scale, the median score was 2 in the restrictive-target group and 1 in the liberal-target group; and on the Montreal Cognitive Assessment, the median score was 27 in the two groups. At 48 hours, the median neuron-specific enolase level was 17 μg per liter in the restrictive-target group and 18 μg per liter in the liberal-target group. The incidence of adverse events was similar in the two groups. CONCLUSIONS: Targeting of a restrictive or liberal oxygenation strategy in comatose patients after resuscitation for cardiac arrest resulted in a similar incidence of death or severe disability or coma. (Funded by the Novo Nordisk Foundation; BOX ClinicalTrials.gov number, NCT03141099.).","author_count":30,"contributors":["Schmidt, Henrik","Kjærgaard, Jesper","Hassager, Christian","Mølstrøm, Simon","Grand, Johannes","Borregaard, Britt","Roelsgaard Obling, Laust E.","Venø, Søren","Sarkisian, Laura","Mamaev, Dmitry","Jensen, Lisette Okkels","Nyholm, Benjamin","Høfsten, Dan E.","Josiassen, Jakob","Thomsen, Jakob H.","Thune, Jens J.","Lindholm, Matias G.","Stengaard Meyer, Martin A.","Winther-Jensen, Matilde","Sørensen, Marc","Frydland, Martin","Beske, Rasmus P.","Frikke-Schmidt, Ruth","Wiberg, Sebastian","Boesgaard, Søren","Lind Jørgensen, Vibeke","Møller, Jacob Eifer"],"cuid":["S02-098.38-047545"],"filters":{"added":"2022-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corresponding_author":["Møller, Jacob Eifer"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-SDR","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"oxygen targets in comatose survivors of cardiac arrest","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1056/NEJMoa2208686","version":"Published Version"},"id":"S02-098.38-047545","identifier":[{"id":"36027567","type":"pmid"},{"id":"85140415254","type":"scopus"}],"ids":["ku-f8e6b4c7-39a3-44d2-9e0b-f8b85a9a44ea","sdu-dedef7f3-8fb6-4143-b2e5-0e2378081f0e