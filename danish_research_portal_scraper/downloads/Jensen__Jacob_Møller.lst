{"abstract":"Solvated lithium closo-dodecaborate, Li2B12H12 with tetrahydrofuran and acetonitrile, show unexpected melting below 150 °C. This feature has been explored to melt-infiltrate Li2B12H12 in a nanoporous SiO2 scaffold. The ionic conductivity of Li2B12H12·xACN reaches 0.08 mS cm-1 in the liquid state at 150 °C making them suitable as battery electrolytes.","author_count":10,"contributors":["Møller, Kasper Trans","Paskevicius, Mark","Andreasen, Jacob Ginnerup","Lee, Junqiao","Chen-Tan, Nigel","Overgaard, Jacob","Payandeh GharibDoust, SeyedHosein","Silvester, Debbie S.","Buckley, Craig E.","Jensen, Torben René"],"cuid":["S01-000.00-213156"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["OECD","Oceania"],"country":["Australia"],"glorg":["All Global Affiliations","Curtin University"],"keyword":["Conduction","Hydrogen","LI2B12H12","Lithium","Stability"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"molten metal i closo i borate solvates","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85062824393","version":"Other Version"},"id":"S01-000.00-213156","identifier":[{"id":"85062824393","type":"scopus"},{"id":"000461397500021","type":"wos"},{"id":"30839031","type":"pmid"}],"ids":["au-9325f9e5-8df9-4147-8c2b-69ad820fe932"],"keyword":["CONDUCTION","HYDROGEN","LI2B12H12","LITHIUM","STABILITY"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-A03CDB6CFA986C4DC207928F4BD96B4E"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus Un