Jakob Hartvig","key":"thomsenpau","last":"Thomsen","name":"Thomsen, Jakob Hartvig","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Martin","key":"frydlandpau","last":"Frydland","name":"Frydland, Martin","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Matilde","key":"wintherjensenpau","last":"Winther-Jensen","name":"Winther-Jensen, Matilde","rank":6,"rolecode":"pau"},{"affno":"3 1","first":"Matias Greve","key":"lindholmpau","last":"Lindholm","locid":"4333dd58-10c3-4fea-aadb-048bdc7cbc3a","name":"Lindholm, Matias Greve","rank":7,"rolecode":"pau"},{"affno":"3","first":"Dan Eik","key":"høfstenpau","last":"Høfsten","locid":"42d653b9-b7de-437a-bf4a-05269ffad300","name":"Høfsten, Dan E.","name_org":"Høfsten, Dan Eik","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Dan Eik","key":"hofstenpau","last":"Hofsten","name":"Hofsten, Dan Eik","rank":8,"rolecode":"pau"},{"affno":"3","first":"Thomas","key":"engstrømpau","last":"Engstrøm","locid":"77ddb69e-092a-4c53-bbf0-409cdd3d12f7","name":"Engstrøm, Thomas","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Thomas","key":"engstrompau","last":"Engstrom","name":"Engstrom, Thomas","rank":9,"rolecode":"pau"},{"affno":"3 1","first":"Lars","key":"køberpau","last":"Køber","locid":"e3f0c57c-605a-431a-9c63-2213c46621e6","name":"Køber, Lars","rank":10,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jacob Eifer","key":"mollerpau","last":"Moller","locid":"5e4d3cb6-b0a0-4541-aea1-30e73f7c10b8","name":"Møller, Jacob Eifer","name_org":"Moller, Jacob Eifer","orcid":"0000-0003-2873-5845","rank":11,"rolecode":"pau"},{"affno":"","first":"Jacob Eifer","key":"møllerpau","last":"Møller","name":"Møller, Jacob Eifer","rank":11,"rolecode":"pau"},{"affno":"3 1","first":"Christian","key":"hassagerpau","last":"Hassager","locid":"49196e5d-0f61-44b2-a6b9-cd6c5f8f3bc2","name":"Hassager, Christian","orcid":"0000-0002-1199-0981","rank":12,"rolecode":"pau"}],"pmid":["29189347"],"pub":{"doi":"10.1097/ccm.0000000000002814","issn":["00903493","10637389"],"issn_org":["15300293"],"issue":"2","journal":"Critical Care Medicine","publisher":"Wolters Kluwer","status":"p","title":"Critical Care Medicine","volume":"46"},"review":"Peer Reviewed","scoID":["2-s2.0-85068218566"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-96795d9f-6e62-437c-a617-157aa59e6484","sdu-4551b304-153c-4d54-890b-c4b2f52451ec"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"The Glucagon-Like Peptide-1 Analog Exenatide Increases Blood Glucose Clearance, Lactate Clearance, and Heart Rate in Comatose Patients After Out-of-Hospital Cardiac Arrest","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-095.00-044562","year":"2018","yearsub":"2018"}
{"abstract":"BACKGROUND: The incidence of cardiogenic shock (CS) in patients with ST-segment elevation myocardial infarction (STEMI) is as high as 10%. The majority of patients are thought to develop CS after admission (late CS), but the incidence in a contemporary STEMI cohort admitted for primary percutaneous intervention remains unknown. AIM: The aim of this study was to assess the incidence and time of CS onset in patients with suspected STEMI admitted in two high-volume tertiary heart centres and to assess the variables associated with the development of late CS. METHODS: We included consecutive patients admitted for acute coronary angiography with suspected STEMI in a 1-year period. Cardiogenic shock was based on clinical criteria and subdivided into patients with shock on admission, patients developing shock during catheterisation and patients developing shock later during hospitalisation. Follow-up for all-cause mortality was done using registries. RESULTS: A total of 2247 patients with suspected STEMI were included, whereof 225 (10%) developed CS. The majority (56%) had CS on admission, 16% developed CS in the catheterisation laboratory and 28% developed late CS. Thirty-day mortality was 3.1% versus 47% in non-CS versus CS patients ( plogrank < 0.0001). Age, stroke, time from symptom onset to intervention, anterior STEMI, heart rate/systolic blood pressure ratio and being comatose after resuscitation from cardiac arrest were independently associated with the development of late CS. CONCLUSION: In this study, 10% of patients admitted with suspected STEMI for acute coronary angiography presented with or developed CS. Most were in shock on admission. Irrespective of the timing of shock, mortality was high.","author_count":13,"contributors":["Obling, Laust","Frydland, Martin","Hansen, Rikke","Møller-Helgestad, Ole Kristian","Lindholm, Matias Greve","Holmvang, Lene","Ravn, Hanne Berg","Wiberg, Sebastian","Thomsen, Jakob Hartvig","Jensen, Lisette Okkels","Kjærgaard, Jesper","Møller, Jacob Eifer","Hassager, Christian"],"cuid":["S02-100.00-042889"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"keyword":["Cardiogenic shock","Denmark epidemiology","Follow Up Studies","Hospital Mortality trends","Incidence","Mortality","Patient Admission trends","Percutaneous Coronary Intervention","Prediction","Prognosis","Prospective Studies","Registries","Risk Factors","ST Elevation Myocardial Infarction complications","STEMI","Survival Rate trends","Time Factors"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-SDR","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"risk factors of late cardiogenic shock and mortality in st segment elevation myocardial infarction patients","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85048687020","version":"Other Version"},"id":"S02-100.00-042889","identifier":[{"id":"28452562","type":"pmid"},{"id":"85048687020","type":"scopus"}],"ids":["ku-612b2b36-4f60-4a74-a9f6-4f57a78c850f","sdu-21577a91-28ad-41bd-a93d-51d1e5f5ff51"],"keyword":["Cardiogenic shock","Denmark/epidemiology","Follow-Up Studies","Hospital Mortality/trends","Incidence","Patient Admission/trends","Percutaneous Coronary Intervention","Prognosis","Prospective Studies","Registries","Risk Factors","ST Elevation Myocardial Infarction/complications","STEMI","Shock, Cardiogenic/epidemiology","Survival Rate/trends","Time Factors","mortality","prediction"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-477E33D0D86CF852B9BF65B68FC8510B"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2018","