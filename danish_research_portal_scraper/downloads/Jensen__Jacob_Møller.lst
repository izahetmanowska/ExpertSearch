"Andersen","name":"Andersen, Zorana Jovanovic","rank":18,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Steffen","key":"loftpau","last":"Loft","name":"Loft, Steffen","rank":19,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Peter","key":"møllerpau","last":"Møller","name":"Møller, Peter","rank":20,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ole","key":"raaschounielsenpau","last":"Raaschou-Nielsen","name":"Raaschou-Nielsen, Ole","rank":21,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Elvira Vaclavik","key":"braunerpau","last":"Brauner","name":"Brauner, Elvira Vaclavik","rank":22,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Thomas","key":"ellermannpau","last":"Ellermann","locid":"5e5a2168-23db-4863-b6d5-bda7dcb1f662","name":"Ellermann, Thomas","rank":23,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Non-Profit Organisations","All Universities","DI-ALL","DI-NP","DI-NP-ALL","DI-U","DI-U-ALL","Non-Profit Organisations","Universities"],"PST":["Published"]},"sid":["au-d6fb8959-a803-4ac1-92d8-936dce059482"],"src":["AU Aarhus University"],"title":"Assessment of human air pollution exposure - results and perspectives in Danish studies","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-252094","year":"2017","yearsub":"2017"}
{"abstract":"BACKGROUND: QRS duration has previously shown association with mortality in patients with acute myocardial infarction treated with thrombolytics, less is known in patients with suspected ST segment elevation myocardial infarction (STEMI) when assessing QRS duration on prehospital ECG. Thus, the objective was to investigate the prognostic effect of QRS duration on prehospital ECG and presence of classic left and right bundle branch block (LBBB/RBBB) for all-cause mortality in patients with suspected STEMI. METHOD: In total 2105 consecutive patients (mean age 64±13years, 72% men) with suspected STEMI were prospectively included. QRS duration was registered from automated QRS measurement on prehospital ECG and patients were divided according to quartiles of QRS duration (<89ms, 89-98ms, 99-111ms and >111ms). Primary endpoint was all-cause 30-day mortality. Predictors of all-cause mortality were assessed using Cox proportional hazards analysis. RESULTS: Among all patients median QRS duration was 98ms (IQR 88-112ms). RBBB-morphology was seen in 126 patients (6.0%) and LBBB in 88 patients (4.2%), 80% were treated with percutaneous coronary intervention and the final diagnosis was STEMI in 1777 patients (84%). Thirty-day mortality was 7.6% in patients with suspected STEMI. In multivariable analysis, QRS duration>111ms (hazard ratio (HR) 3.08; 95% confidence interval (CI): 1.71-5.57, p=0.0002), LBBB - morphology (HR 3.0; 95% CI: 1.38-6.53, p=0.006) and RBBB (HR 3.68; 95% CI: 1.95-6.95, p<0.0001) were associated with 30 day all-cause mortality. CONCLUSION: In patients with suspected STEMI, QRS prolongation, LBBB, and RBBB on prehospital ECG are associated with increased risk of death.","author_count":10,"contributors":["Hansen, Rikke","Frydland, Martin","Møller-Helgestad, Ole Kristian","Lindholm, Matias Greve","Jensen, Lisette Okkels","Holmvang, Lene","Ravn, Hanne Berg","Kjærgaard, Jesper","Hassager, Christian","Møller, Jacob Eifer"],"cuid":["S02-100.00-044142"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-SDR","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"association between qrs duration on prehospital ecg and mortality in patients with suspected stemi","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85029723884","version":"Other Version"},"id":"S02-100.00-044142","identifier":[{"id":"29121757","type":"pmid"},{"id":"85029723884","type":"scopus"}],"ids":["ku-884f6693-6a99-4280-ae72-7d1b653007eb","sdu-61854752-3295-4ec4-9baf-4d8b258fc43f"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-5D9EE66F3519046D523D9DA4447B0A3C"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","country":"dk","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["University of Southern Denmark"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"4","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Odense University Hospital"],"nora_code":"DI-HO-SDR","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Rikke","key":"hansenpau","last":"Hansen","name":"Hansen, Rikke","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Martin","key":"frydlandpau","last":"Frydland","name":"Frydland, Martin","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ole Kristian","key":"møllerhelgestadpau","last":"Møller-Helgestad","locid":"ab9f3165-500c-482b-9c2f-1879b3abedb3","name":"Helgestad, Ole Kristian Lerche","name_org":"Møller-Helgestad, Ole Kristian","orcid":"0000-0003-3847-8758","rank":3,"rolecode":"pau"},{"affno":"3 2","first":"Matias Greve","key":"lindholmpau","last":"Lindholm","locid":"4333dd58-10c3-4fea-aadb-048bdc7cbc3a","name":"Lindholm, Matias Greve","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lisette Okkels","key":"jensenpau","last":"Jensen","locid":"b78c452e-5a69-41fe-ba49-0096c84d1d4d","name":"Jensen, Lisette Okkels","orcid":"0000-0002-4838-2429","rank":5,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Lene","key":"holmvangpau","last":"Holmvang","name":"Holmvang, Lene","rank":6,"rolecode":"pau"},{"affno":"3 2","first":"Hanne Berg","key":"ravnpau","last":"Ravn","locid":"3049e7b7-0f18-413b-88ab-a3d77ebc079b","name":"Ravn, Hanne Berg","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jesper","key":"kjærgaardpau","last":"Kjærgaard","name":"Kjærgaard, Jesper","rank":8,"rolecode":"pau"},{"affno":"3 2","first":"Christian","key":"hassagerpau","last":"Hassager","locid":"49196e5d-0f61-44b2-a6b9-cd6c5f8f3bc2","name":"Hassager, Christian","orcid":"0000-0002-1199-0981","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jacob Eifer","key":"møllerpau","last":"Møller","locid":"5e4d3cb6-b0a0-4541-aea1-30e73f7c10b8","name":"Møller, Jacob Eifer","orcid":"0000-0003-2873-5845","rank":10,"rolecode":"pau"}],"pmid":["29121757"],"pub":{"doi":"10.1016/j.ijcard.2017.07.049","issn":["01675273","18741754"],"issn_org":["01675273"],"journal":"International Journal of Cardiology","pages":"55-60","publisher":"Elsevier","status":"p","title":"International Journal of Cardiology","volume":"249"},"review":"Peer Reviewed","scoID":["2-s2.0-85029723884"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-884f6693-6a99-4280-ae72-7d1b653007eb","sdu-61854752-3295-4ec4-9baf-4d8b258fc43f"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Association between QRS duration on prehospital ECG and mortality in patients with suspected STEMI","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-044142","year":"2017","yearsub":"2017"}
{"abstract":"The fate of total solids, volatile solids, total organic carbon, fossil carbon, biogenic carbon and 17 substances (As, Ca, CaCO3, Cd, Cl, Cr, Cu, H, Hg, K, Mg, N, Ni, O, P, Pb, S, Zn) in a combined dry anaerobic digestion and post-composting facility were assessed. Mass balances showed good results with low uncertainties for non-volatile substances, while balances for nitrogen, carbon, volatile solids and total organic carbon showed larger but reasonable uncertainties, due to volatilisation and emissions into the air. Material and substance flow analyses were performed in order to obtain transfer coefficients for a combined dry anaerobic digestion and post-composting facility. All metals passed through the facility and ended up in compost or residues, but all concentrations of metals in the compost complied with legislation. About 23% of the carbon content of the organic waste was transferred to the biogas, 24% to the compost, 13% to residues and 40% into the atmosphere. For nitrogen, 69% was transferred to the compost, 10% volatilised to the biofilter, 11% directly into the atmosphere and 10% to residues. Finally, a full life cycle inventory was conducted for the combined dry anaerobic digestion and post-composting facility, including waste received, fuel consumption, energy use, gaseous emissions, products, energy production and chemical composition of the compost produced.","author_count":3,"contributors":["Jensen, Morten Bang","Møller, Jacob","Scheutz, Charlotte"],"cuid":["S01-000.00-305989"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Compost","Emissions","Food waste","Life cycle inventory","Mass balance"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"assessment of a combined dry anaerobic digestion and post composting treatment facility for source separated organic household waste using material and substance flow analysis and life cycle inventory","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85017414966","version":"Other Version"},"id":"S01-000.00-305989","identifier":[{"id":"85017414966","type":"scopus"},{"id":"28427738","type":"pmid"}],"ids":["dtu-049f7a71-68e3-41b6-8108-52f7c42c7ba3"],"keyword":["Compost","Emissions","Food waste","Life cycle inventory","Mass balance","Mass flows","Substance transfer coefficients"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-1BF96AFBFCD5EC2E1CBFBAE1BFD2802A"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Environmental Engineering","Technical University of Denmark, Department of Environmental Engineering, Residual Resource Engineering"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Morten Bang","key":"jensenpau","last":"Jensen","locid":"647f1ac7-93b2-4476-9ff2-a2d1a245e948","name":"Jensen, Morten Bang","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jacob","key":"møllerpau","last":"Møller","locid":"ba375b02-d34a-4a26-958d-59b8bd17fa42","name":"Møller, Jacob","orcid":"0000-0003-3475-1251","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Charlotte","key":"scheutzpau","last":"Scheutz","locid":"48fe2850-fdc6-4282-9b97-ac5773419e5c","name":"Scheutz, Charlotte","orcid":"0000-0003-2218-5934","rank":3,"rolecode":"pau"}],"pmid":["28427738"],"pub":{"doi":"10.1016/j.wasman.2017.03.029","issn":["0956053X","18792456"],"issn_org":["0956053X"],"journal":"Waste Management","pages":"23-35","publisher":"Elsevier","status":"p","title":"Waste Management","volume":"66"},"review":"Peer Reviewed","scoID":["2-s2.0-85017414966"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-049f7a71-68e3-41b6-8108-52f7c42c7ba3"],"src":["DTU Technical University of Denmark"],"title":"Assessment of a combined dry anaerobic digestion and post-composting treatment facility for source-separated organic household waste, using material and substance flow analysis and life cycle inventory","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-305989","year":"2017","yearsub":"2017"}
{"abstract":"Whole-site emissions of methane and nitrous oxide, from a combined dry anaerobic digestion and composting facility treating biowaste, were quantified using a tracer dispersion technique that combines a controlled tracer gas release from the treatment facility with time-resolved concentration measurements downwind of the facility. Emission measurements were conducted over a period of three days, and in total, 80 plume traverses were obtained. On-site screening showed that important processes resulting in methane emissions were aerobic composting reactors, anaerobic digester reactors, composting windrows and the site's biofilter. Average whole-site methane emissions measured during the three days were 27.5±7.4, 28.5±6.1 and 30.1±11.4kg CH4 h-1, respectively. Turning the windrows resulted in an increase in methane emission from about 26.3-35.9kg CH4 h-1. Lower emissions (21.5kg CH4 h-1) were measured after work hours ended, in comparison to emissions measured during the facility's opening hours (30.2kg CH4 h-1). Nitrous oxide emission was too small for a downwind quantification. Direct on-site measurements, however, suggested that the main part of the emitted nitrous oxide came from the biofilter (about 1.4kg N2O h-1). Whole-site emissions were compared to emissions previously measured at different point sources on-site. Whole-site fugitive emissions were three to eight times higher than the sum of emissions measured at on-site sources. The magnitude of the emissions had a significant influence on the overall environmental impact of the treatment facility, assessed by consequential life cycle assessment. Including the higher whole-site fugitive emissions led to an increase in global warming potential, from a saving of 97kgCO2-eq.tonne-1 of treated waste (wet weight) to a loading of 71kg CO2-eq. tonne-1, ultimately flipping the environmental profile of the treatment facility.","author_count":4,"contributors":["Jensen, Morten Bang","Møller, Jacob","Mønster, Jacob","Scheutz, Charlotte"],"cuid":["S01-000.00-316821"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Biogas","Biowaste","Composting","Environmental assessment","Life cycle assessment LCA","Tracer dispersion"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"quantification of greenhouse gas emissions from a biological waste treatment facility","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85019677998","version":"Other Version"},"id":"S01-000.00-316821","identifier":[{"id":"85019677998","type":"scopus"},{"id":"28571663","type":"pmid"}],"ids":["dtu-2933f4b4-4647-427c-bd23-3eec6ec5ee5d"],"keyword":["Biogas","Biowaste","Composting","Emission measurement","Environmental assessment","Life cycle assessment (LCA)","Tracer dispersion"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-61139BD5B617806D955A262D5C267E92"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Environmental Engineering","Technical University of Denmark, Department of Environmental Engineering, Residual Resource Engineering"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Morten Bang","key":"jensenpau","last":"Jensen","locid":"647f1ac7-93b2-4476-9ff2-a2d1a245e948","na