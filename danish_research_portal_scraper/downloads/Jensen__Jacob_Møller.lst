50508","name":"Hingst, Janne Rasmuss","orcid":"0000-0001-9302-6813","rank":9,"rolecode":"pau"},{"affno":"1","first":"Sine L","key":"hansenpau","last":"Hansen","locid":"4c2d883d-7f7e-4cd8-a37a-c8c0186e8740","name":"Hansen, Sine L","rank":10,"rolecode":"pau"},{"affno":"5","first":"Sophia","key":"dollpau","last":"Doll","name":"Doll, Sophia","rank":11,"rolecode":"pau"},{"affno":"5","first":"Philip E","key":"geyerpau","last":"Geyer","name":"Geyer, Philip E","rank":12,"rolecode":"pau"},{"affno":"1","first":"Atul Shahaji","key":"deshmukhpau","last":"Deshmukh","locid":"ec9031a8-0215-4c06-ba88-f66863916df9","name":"Deshmukh, Atul S.","name_org":"Deshmukh, Atul Shahaji","orcid":"0000-0002-2278-1843","rank":13,"rolecode":"pau"},{"affno":"1","first":"Jens Juul","key":"holstpau","last":"Holst","locid":"864b6401-9024-4773-9bdb-f4d4ca57dcad","name":"Holst, Jens Juul","orcid":"0000-0001-6853-3805","rank":14,"rolecode":"pau"},{"affno":"1 6","first":"Lise","key":"madsenpau","last":"Madsen","locid":"194bda7c-3b62-451f-b9b3-6742361fe601","name":"Madsen, Lise","rank":15,"rolecode":"pau"},{"affno":"1 7","first":"Karsten","key":"kristiansenpau","last":"Kristiansen","locid":"941041b1-1b8f-4be5-9a65-5e98f662c07e","name":"Kristiansen, Karsten","orcid":"0000-0002-6024-0917","rank":16,"rolecode":"pau"},{"affno":"1","first":"Jørgen","key":"wojtaszewskipau","last":"Wojtaszewski","locid":"06441180-44ed-4f23-b077-4d90876cc68b","name":"Wojtaszewski, Jørgen","orcid":"0000-0001-8185-3408","rank":17,"rolecode":"pau"},{"affno":"1","first":"Erik A.","key":"richterpau","last":"Richter","locid":"c9ba60ad-a6b9-439f-bbd2-e6fd31a4e009","name":"Richter, Erik A.","orcid":"0000-0002-6850-3056","rank":18,"rolecode":"pau"},{"affno":"1","first":"Bente","key":"kienspau","last":"Kiens","locid":"d0bf12e6-2968-49da-b7ce-9e6ab6434ba1","name":"Kiens, Bente","orcid":"0000-0001-5705-5625","rank":19,"rolecode":"pau"}],"pmid":["30269983"],"pub":{"doi":"10.1016/j.cmet.2018.08.022","issn":["15504131","19327420"],"issn_org":["15504131"],"issue":"1","journal":"Cell Metabolism","status":"p","title":"Cell Metabolism","volume":"29"},"review":"Peer Reviewed","scoID":["2-s2.0-85054376676"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-ea4500c7-51bd-4a2d-bced-e1827fdbae30"],"src":["KU University of Copenhagen"],"title":"Mechanisms preserving insulin action during high dietary fat intake","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-533354","year":"2019","yearsub":"2019"}
{"abstract":"AIMS: The aim of this study was to evaluate the Impella CP over veno-arterial extracorporeal membrane oxygenation (VA-ECMO) and their impact on left ventricular unloading and end-organ perfusion. METHODS AND RESULTS: Cardiogenic shock (CS) was induced by injecting microspheres into the left coronary artery in fourteen adult female swine. Impella CP or VA-ECMO was initiated in the presence of CS and evaluated after 60 minutes. Left ventricular pressure-volume area (PVA, total mechanical work) was obtained from a conductance catheter. Results are presented as mean (95% confidence interval) and the rank-sum test was used to assess differences between devices. Compared to the CS state, PVA was unaffected by Impella CP and increased on VA-ECMO (from 2,548 [2,193; 2,904] mmHg x mL during CS to 5,775 [4,451; 7,099], between device p-value=0.02). Arterial lactate increased during CS and decreased on support with no difference between devices. Renal venous oxygen saturation decreased during CS and increased on support with no difference between devices. Cerebral venous oxygen saturation increased to 33% [25, 40] on Impella CP and to 69% [49, 89] on VA-ECMO, p=0.04. CONCLUSIONS: In this porcine model of profound CS, Impella CP unloaded the left ventricle compared to VA-ECMO. Both devices improved end-organ perfusion, with a tendency towards higher venous oxygen saturations on VA-ECMO.","author_count":10,"contributors":["Møller-Helgestad, Ole Kristian","Hyldebrandt, Janus A","Banke, Ann","Rud, Charlotte S","Udesen, Nanna L J","Linde, Louise","Okkels-Jensen, Lisette","Schmidt, Henrik","Ravn, Hanne Berg","Møller, Jacob E"],"cuid":["S02-089.07-047674"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, Non-EU","Nordic","OECD"],"country":["Norway"],"glorg":["Akershus University Hospital","All Global Affiliations"],"keyword":["Animals","Disease Models Animal","Extracorporeal Membrane Oxygenation","Female","Heart Assist Devices","Heart Ventricles","Shock Cardiogenic","Swine"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-SDR","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"impella cp or va ecmo in profound cardiogenic shock left ventricular unloading and organ perfusion in a large animal model","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85063236059","version":"Other Version"},"id":"S02-089.07-047674","identifier":[{"id":"30418160","type":"pmid"},{"id":"85063236059","type":"scopus"}],"ids":["ku-fd9bb5db-fb24-4509-a80f-6e94f5bbe56a","sdu-0b51c46d-b8d4-470b-8960-543f251be091"],"keyword":["Animals","Disease Models, Animal","Extracorporeal Membrane Oxygenation","Female","Heart Ventricles","Heart-Assist Devices","Shock, Cardiogenic","Swine"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-1A6B241E050A3EC17E1D5D9E04A99444"],"oai":{"class":"Blocked","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Cardiology (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"no","key":"akershus university hospital","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"Akershus University Hospital","used":1},{"affno":"3","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Odense University Hospital"],"nora_code":"DI-HO-SDR","used":1},{"affno":"4","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Anaesthesiology","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"5","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Ole Kristian","key":"møllerhelgestadpau","last":"Møller-Helgestad","locid":"ab9f3165-500c-482b-9c2f-1879b3abedb3","name":"Helgestad, Ole Kristian Lerche","name_org":"Møller-Helgestad, Ole Kristian","orcid":"0000-0003-3847-8758","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Janus A","key":"hyldebrandtpau","last":"Hyldebrandt","name":"Hyldebrandt, Janus A","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ann","key":"bankepau","last":"Banke","locid":"0d350637-c6ce-4cf8-82ba-e965da703690","name":"Banke, Ann","orcid":"0000-0002-1036-580X","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Charlotte S","key":"rudpau","last":"Rud","name":"Rud, Charlotte S","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Nanna L J","key":"udesenpau","last":"Udesen","locid":"f71f56f5-4f36-4de5-a7ae-e5e51f101a83","name":"Udesen, Nanna Louise Junker","name_org":"Udesen, Nanna L J","orcid":"0000-0003-1542-3260","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Louise","key":"lindepau","last":"Linde","locid":"4fc23628-00d4-466a-9e6e-269e23160481","name":"Linde, Louise","orcid":"0000-0002-7757-2571","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lisette","key":"okkelsjensenpau","last":"Okkels-Jensen","locid":"b78c452e-5a69-41fe-ba49-0096c84d1d4d","name":"Jensen, Lisette Okkels","name_org":"Okkels-Jensen, Lisette","orcid":"0000-0002-4838-2429","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Henrik","key":"schmidtpau","last":"Schmidt","locid":"9789920f-4b31-4f28-8211-97afced9d61e","name":"Schmidt, Henrik","rank":8,"rolecode":"pau"},{"affno":"4 5","first":"Hanne B","key":"ravnpau","last":"Ravn","locid":"3049e7b7-0f18-413b-88ab-a3d77ebc079b","name":"Ravn, Hanne Berg","name_org":"Ravn, Hanne B","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jacob E","key":"møllerpau","last":"Møller","locid":"5e4d3cb6-b0a0-4541-aea1-30e73f7c10b8","name":"Møller, Jacob Eifer","name_org":"Møller, Jacob E","orcid":"0000-0003-2873-5845","rank":10,"rolecode":"pau"}],"pmid":["30418160"],"pub":{"doi":"10.4244/eij-d-18-00684","issn":["1774024X","19696213"],"issn_org":["1774024X"],"issue":"15","journal":"EuroIntervention","publisher":"Europa Group","status":"p","title":"EuroIntervention","volume":"14"},"review":"Peer Reviewed","scoID":["2-s2.0-85063236059"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-fd9bb5db-fb24-4509-a80f-6e94f5bbe56a","sdu-0b51c46d-b8d4-470b-8960-543f251be091"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Impella CP or VA-ECMO in profound cardiogenic shock : left ventricular unloading and organ perfusion in a large animal model","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-089.07-047674","year":"2019","yearsub":"2019"}
{"abstract":"Hypertension is a common health problem and may be caused by dysfunction of the stretch sensitive baroreceptors in the carotid bulb. Velocity changes and vortices are present in the carotid bulb, and a better evaluation of the local flow and pressures may be important to further understand hypertension. The intravascular pressure catheter is a common tool in the clinic and is currently considered to be the reference standard for intravascular pressure measurement, but the method is invasive, ionizing, and has been reported to be inaccurate. Vector flow imaging (VFI) is an angle independent, noninvasive, and nonionizing ultrasound method that can estimate pressure differences. In this study, pressure differences between the common carotid artery and the carotid bulb obtained with VFI were compared with catheter measurements in three carotid bifurcation phantoms. A fluid-structure interaction (FSI) simulation model was used as reference. Additionally, 10 repeated VFI and catheter measurements were performed in one phantom for a precision assessment. The mean absolute pressure difference between the catheter and FSI method in the three phantoms was 140.5 Pa, and 10 repeated catheter tests measured a mean pressure decrease with a large variation (mean: -133.3 Pa, SD: 786%). VFI estimated pressure increases in all phantoms with a mean standard deviation of 11.6%, and the mean absolute pressure difference compared with FSI was 16.7 Pa. Ten repeated VFI estimations found a mean pressure increase with low variation (mean: 40.1 Pa, SD: 10.9%). VFI precisely estimated small pressure differences in a carotid bifurcation phantom setup, whereas the fluid-filled pressure catheter measurements were imprecise.","author_count":9,"contributors":["Nguyen, Tin-Quoc","Traberg, Marie Sand","Olesen, Jacob Bjerring","Moshavegh, Ramin","Møller-Sørensen, Peter Hasse","Lönn, Lars","Jensen, Jørgen Arendt","Nielsen, Michael Bachmann","Lindskov Hansen, Kristoffer"],"cuid":["S01-000.00-335673"],"event":{"end":"2019-10-09","place":"Glasgow, gb","start":"2019-10-06","title":"2019 IEEE International Ultrasonics Symposium","year":"2019"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Carotid bifurcation","Fluid filled pressure catheter","Phantom study","Pressure difference estimation","Vector flow imaging"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-PR","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-HO-CAP","DI-PR-OTH","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"pressure difference estimation in carotid bulbs using vector flow imaging a phantom study","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/194235944/ref_nguyen_et_al_2019.pdf","version":"Authors Final Version"},"id":"S01-000.00-335673","identifier":[{"id":"85077542048","type":"scopus"}],"ids":["dtu-68269ac1-79eb-4a29-b26e-52c4388ee4bd"],"keyword":["Carotid bifurcation","Fluid-filled pressure catheter","Fluid-structure interaction simulation","Phantom study","Pressure difference estimation","Vector flow imaging"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-000121AA02631DDEB010ED089CCF9B19"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/194235944/ref_nguyen_et_al_2019.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital Herlev and Gentofte"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Health Technology","Technical University of Denmark, Department of Health Technology, Biomedical Engineering","Technical University of Denmark, Department of Health Technology, Biomedical Engineering, Cardiovascular Biomechanics","Technical University of Denmark, Department of Health Technology, Biomedical Engineering, Center for Fast Ultrasound Imaging"],"nora_code":"DI-U-DTU","used":1},{"affno":"3","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["BK Medical ApS"],"nora_code":"DI-PR-OTH","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Tin-Quoc","key":"nguyenpau","last":"Nguyen","name":"Nguyen, Tin-Quoc","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Marie Sand","key":"trabergpau","last":"Traberg","locid":"4da6fca0-b677-4b9a-a006-a87b72ac6ee3","name":"Traberg, Marie Sand","orcid":"0000-0001-7090-6607","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jacob Bjerring","key":"olesenpau","last":"Olesen","name":"Olesen, Jacob Bjerring","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Ramin","key":"moshaveghpau","last":"Moshavegh","name":"Moshavegh, Ramin","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Peter Hasse","key":"møllersørensenpau","last":"Møller-Sørensen","name":"Møller-Sørensen, Peter Hasse","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lars","key":"lönnpau","last":"Lönn","name":"Lönn, Lars","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Jørgen Arendt","key":"jensenpau","last":"Jensen","locid":"e197c9fc-743f-4736-8d06-3825897e0989","name":"Jensen, Jørgen Arendt","orcid":"0000-0002-7896-3136","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Michael Bachmann","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Michael Bachmann","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kristoffer","key":"lindskovhansenpau","last":"Lindskov Hansen","name":"Lindskov Hansen, Kristoffer","rank":9,"rolecode":"pau"}],"pub":{"doi":"10.1109/ultsym.2019.8926268","eisbn":["9781728145969"],"pages":"872-875","publisher":"IEEE","status":"p","title":"Proceedings of the IEEE International Ultrasonic Symposium 2019"},"review":"Peer Reviewed","scoID":["2-s2.0-85077542048"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Private Research","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Hospitals","Other Companies","Private Research","Technical University of Denmark","Universities","bk medical aps"],"PST":["Published"]},"sid":["dtu-68269ac1-79eb-4a29-b26e-52c4388ee4bd"],"src":["DTU Technical University of Denmark"],"title":"Pressure Difference Estimation in Carotid Bulbs using Vector Flow Imaging - A Phantom Study","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-335673","year":"2019","yearsub":"2019"}
{"abstract":"Background Aortic stenosis (AS) is a progressive disease in which left ventricular (LV) diastolic dysfunction is common. However, the association between diastolic dysfunction and right ventricular (RV) loading conditions and function has not been investigated in asymptomatic AS patients. Methods and findings A total of 41 patients underwent right heart catheterization and simultaneous echocardiography at rest and during maximal supine exercise, stratified according to resting diastolic function. Cardiac chamber size and morphology was assessed using cardiac magnetic resonance imaging (cMRI). RV stroke work index, pulmonary artery (PA) compliance, PA elastance, PA pulsatility index, and right atrial pressure (RAP) were calculated at rest and maximal exercise. Ten patients (24%) had normal LV filling pattern, 20 patients (49%) had grade 1, and 11 patients (27%) had grade 2 diastolic dysfunction. Compared to patients with normal diastolic filling pattern, patients with diastolic dysfunction had lower RV end-diastolic volume (66 ± 11 ml/m2 vs. 79 ± 15 ml/m2, p = 0.02) and end-systolic volume (25 ± 7 ml/m2 vs. 32 ± 9 ml/m2, p = 0.04). An increase in mean RAP to 15 mmHg following exercise was not seen in patients with normal LV filling, compared to 4 patients (20%) with mild and 7 patients (63%) with moderate diastolic dysfunction (p = 0.003). PA pressure and PA elastance was increased in grade 2 diastolic dysfunction and correlated with RV volume and maximal oxygen consumption (r = -0.71, p < 0.001). Conclusions Moderate diastolic dysfunction is associated with increased RV afterload (elastance), which is compensated at rest, but is associated with increased RAP and inversely related to maximal oxygen consumption during maximal exercise.","author_count":9,"contributors":["Christensen, Nicolaj Lyhne","Dahl, Jordi Sanchez","Carter-Storch, Rasmus","Jensen, Kurt","Pecini, Redi","Hald Steffensen, Flemming","Søndergaard, Eva","Videbæk, Lars","Møller, Jacob Eifer"],"cuid":["S01-000.00-615727"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Møller, Jacob Eifer"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"association between left ventricular diastolic function and right ventricular function and morphology in asymptomatic aortic stenosis","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1371/journal.pone.0215364","version":"Published Version"},"id":"S01-000.00-615727","identifier":[{"id":"31361748","type":"pmid"},{"id":"85070101704","type":"scopus"},{"id":"PMC6667115","type":"pmcid"}],"ids":["sdu-945cbbb3-9bb8-4326-b848-d92127a640d3"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-9FD8A62451508E7AD7B27992349B9B84"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/152934392/journal.pone.0215364.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1371/journal.pone.0215364","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Cardiology (Odense)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Nicolaj Lyhne","key":"christensenpau","last":"Christensen","locid":"1589e1dd-c542-4a6e-a1f6-2efa5c8ace32","name":"Christensen, Nicolaj Lyhne","orcid":"0000-0002-4895-0588","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jordi Sanchez","key":"dahlpau","last":"Dahl","locid":"fa82ce60-e408-4c0f-b013-151f87c6998c","name":"Dahl, Jordi Sanchez","orcid":"0000-0002-8345-204X","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rasmus","key":"carterstorchpau","last":"Carter-Storch","locid":"1fdaaa20-9ae8-40c9-9b5a-d9d7885a200b","name":"Carter-Storch, Rasmus","orcid":"0000-0002-0359-8728","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kurt","key":"jensenpau","last":"Jensen","locid":"f8a07351-d436-44c5-b0d3-9cd052bbc89f","name":"Jensen, Kurt","orcid":"0000-0001-9014-2093","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Redi","key":"pecinipau","last":"Pecini","locid":"2167a2e8-13c0-4b78-95ac-8f5ff03aa373","name":"Pecini, Redi","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Flemming Hald","key":"steffensenpau","last":"Steffensen","locid":"d071bc54-c431-4b1b-a1ec-0ce7e12c2ef6","name":"Hald Steffensen, Flemming","name_org":"Steffensen, Flemming Hald","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Eva Vad","key":"søndergaardpau","last":"Søndergaard","locid":"2f272042-43cc-4278-90d0-ef2a0d3d08a7","name":"Søndergaard, Eva","name_org":"Søndergaard, Eva Vad","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lars Melgaard","key":"videbækpau","last":"Videbæk","locid":"c0abdf18-4e26-411a-99c3-de3cbe029dee","name":"Videbæk, Lars","name_org":"Videbæk, Lars Melgaard","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jacob Eifer","key":"møllerpau","last":"Møller","locid":"5e4d3cb6-b0a0-4541-aea1-30e73f7c10b8","name":"Møller, Jacob Eifer","orcid":"0000-0003-2873-5845","rank":9,"rolecode":"pau"}],"pmid":["31361748"],"pub":{"doi":"10.1371/journal.pone.0215364","issn":["19326203"],"issue":"7","journal":"PLOS ONE","paperid":"e0215364","publisher":"Public Library of Science","status":"p","title":"PLOS ONE","volume":"14"},"review":"Peer Reviewed","scoID":["2-s2.0-85070101704"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-945cbbb3-9bb8-4326-b848-d92127a640d3"],"src":["SDU University of Southern Denmark"],"title":"Association between left ventricular diastolic function and right ventricular function and morphology in asymptomatic aortic stenosis","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-615727","year":"2019","yearsub":"2019"}
{"abstract":"OBJECTIVES: This study sought to evaluate the long-term risk of developing heart failure (HF) in patients receiving trastuzumab therapy. BACKGROUND: Trastuzumab has improved the prognosis in patients with HER2-positive breast cancer, but it can induce left ventricular dysfunction with reduced ejection fraction or HF during treatment. The long-term risk of HF is less well described. METHODS: In a nationwide Danish retrospective cohort study, 9,901 patients scheduled for adjuvant treatment for early-stage breast cancer were identified in the Danish Breast Cancer Cooperative Group database. Of these, 8,812 patients (25% HER2-positive; 51.7 ± 8.5 years of age) received chemotherapy including anthracycline; and if they were HER2 positive, trastuzumab was added. The primary endpoint was a diagnosis of HF assessed before and after 18 months in a landmark analysis to distinguish short- and long-term risks. RESULTS: Median follow-up was 5.4 years (interquartile range [IQR]: 4.1 to 6.8 years). In the trastuzumab group, 60 patients had HF by 9 years versus 51 in the group who were treated with chemotherapy alone, corresponding to incidence rates per 1,000 patient years of 5.3 (95% confidence interval [CI]: 4.1 to 6.8) versus 1.4 (95% CI: 1.1 to 1.8), respectively. The cumulative incidence of HF was higher in the trastuzumab group at both the short- and long-term (p < 0.01), yielding adjusted hazard ratios of 8.7 (95% CI: 4.6 to 16.5; p < 0.01) for early HF and 1.9 (95% CI: 1.2 to 3.3; p = 0.01) for late HF associated with trastuzumab treatment. CONCLUSIONS: Trastuzumab treatment is associated with a 2-fold increased risk of late HF compared with chemotherapy treatment alone.","author_count":11,"contributors":["Banke, Ann","Fosbøl, Emil","Ewertz, Marianne","Videbæk, Lars","Dahl, Jordi S","Poulsen, Mikael Kjær","Cold, Søren","Jensen, Maj-Britt","Gislason, Gunnar","Schou, Morten","Møller, Jacob E"],"cuid":["S02-100.00-042199"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corresponding_author":["Banke, Ann"],"keyword":["Breast cancer","Cardiotoxicity","Epidemiology","Heart failure","Trastuzumab"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-NP","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"NP":["DI-NP-ALL","DI-NP-HJER"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-NP-HJER","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"long term risk of heart failure in breast cancer patients after adjuvant chemotherapy with or without trastuzumab","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/160298251/Long_term_risk_of_heart_failure_in_breast_cancer_patients.pdf","version":"Authors Final Version"},"funding_acknowledgement":["The study was approved by the Danish Data Protection Agency (ref. 2007-58-0015/GEH-2014-012; I-suite number 02720). Approval by the Ethics Committee and informed consent are not required for retrospective registry-based studies in Denmark."],"id":"S02-100.00-042199","identifier":[{"id":"85061549095","type":"scopus"},{"id":"30819377","type":"pmid"}],"ids":["ku-4bbfe557-c3d8-426e-92f6-5cfa4f16e59e","sdu-b1b355bf-af31-4082-aba1-06a8a65138d8"],"keyword":["breast cancer","cardiotoxicity","epidemiology","heart failure","trastuzumab"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-2F69F8E86530FF478B972B470EB2428C"],"oa_link":[{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/257743243/Long_Term_Risk_of_Heart_Failure_in_Breast_Cancer_Patients_After_Adjuvant_Chemotherapy_With_or_Without_Trastuzumab_Pre_print_.pdf","version":"Pre-print"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/160298251/Long_term_risk_of_heart_failure_in_breast_cancer_patients.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Cardiology (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"4","country":"dk","key":"danish heart foundation","l2":"DI-NP","l2n":"Non-Profit Organisations","l3":"DI-NP-HJER","l3nn":"Danish Heart Foundation","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Danish Heart Foundation","namevar":["Hjerteforeningen"],"nora_code":"DI-NP-HJER","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Ann","key":"bankepau","last":"Banke","locid":"0d350637-c6ce-4cf8-82ba-e965da703690","name":"Banke, Ann","orcid":"0000-0002-1036-580X","rank":1,"rolecode":"pau"},{"affno":"2 3","first":"Emil L","key":"fosbølpau","la