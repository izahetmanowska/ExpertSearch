 5","corresponding":null,"first":"Lars Peter","key":"riberpau","last":"Riber","locid":"607e34a6-2b96-4466-ad5f-48b2c188f589","name":"Riber, Lars","name_org":"Riber, Lars Peter","orcid":"0000-0001-6898-2715","rank":15,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Matilde","key":"wintherjensenpau","last":"Winther-Jensen","name":"Winther-Jensen, Matilde","rank":16,"rolecode":"pau"},{"affno":"6 7","corresponding":null,"first":"Sisse","key":"thomassenpau","last":"Thomassen","locid":"73e2edc3-99c7-480b-830d-e5e7631b9179","name":"Thomassen, Sisse Anette","name_org":"Thomassen, Sisse","orcid":"0000-0003-0955-4600","rank":17,"rolecode":"pau"},{"affno":"6 7","corresponding":null,"first":"Helle","key":"laugesenpau","last":"Laugesen","locid":"5269ef7c-7cb5-4497-bd6f-582f6eeb1fe2","name":"Laugesen, Helle","rank":18,"rolecode":"pau"},{"affno":"8","first":"Christian","key":"hassagerpau","last":"Hassager","locid":"49196e5d-0f61-44b2-a6b9-cd6c5f8f3bc2","name":"Hassager, Christian","orcid":"0000-0002-1199-0981","rank":19,"rolecode":"pau"},{"affno":"1 11","corresponding":null,"first":"Helle","key":"søholmpau","last":"Søholm","name":"Søholm, Helle","rank":20,"rolecode":"pau"}],"pmid":["36229928"],"pub":{"doi":"10.1093/ehjacc/zuac135","issn":["20488726","20488734"],"issn_org":["20488734"],"issue":"11","journal":"European Heart Journal: Acute Cardiovascular Care","pages":"808-817","publisher":"Oxford University Press","status":"p","title":"European Heart Journal: Acute Cardiovascular Care","title_org":"European Heart Journal - Acute Cardiovascular Care","volume":"11"},"review":"Peer Reviewed","scoID":["2-s2.0-85162232273"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Non-Profit Organisations","All Private Research","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-NP","DI-NP-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Hospitals","Non-Profit Organisations","North Denmark Region","Other Companies","Private Research","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark","danish heart foundation"],"PST":["Published"]},"sid":["aau-273126ed-3e85-457b-a9d1-1626d3717283","au-179eb697-44e9-4a15-8607-ed530d2702c4","ku-8aba445f-d595-4f96-af45-73ff68a80603","sdu-1852763f-b9bc-466d-9460-27ed055174d6"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Extracorporeal cardiopulmonary resuscitation : a national study on the association between favourable neurological status and biomarkers of hypoperfusion, inflammation, and organ injury","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-097.65-665735","year":"2022","yearsub":"2022"}
{"abstract":"Abstract Funding Acknowledgements Type of funding sources: Public hospital(s). Main funding source(s): Hjertecentrets Forskningsudvalg, Rigshospitalet Background Cardiogenic shock often induces an inflammatory response, but the prognostic importance of this is not well studied. Purpose The present study investigates whether the inflammatory response as reflected in routine blood samples taken during admission is associated with 30-day mortality in patients with cardiogenic shock due to acute myocardial infarction (AMICS). We assessed patients surviving 2 days, since a full CRP-response may take more than 48 hours to develop. Methods Consecutive patients (N=1716) with a validated diagnosis of AMICS admitted to one of two tertiary heart centres covering a base population of approximately 4 million in the period from 2010 to 2017 were included. The median values of total leucocyte count (WBC) and C-reactive protein (CRP) corresponded well to optimum thresholds found using ROC analysis and were used as cut-off for stratification. Results A total of 1114 (1122) of the 1716 patients were alive and had WBC (CRP) measured at day 3. Median WBC was 12.6 x 109/L. Median CRP was 146 mg/L. Patients with an elevated leucocyte response were significantly older (66 vs 64 yrs, P","author_count":9,"contributors":["Bo Kunkel, J","Josiassen, J","Helgestad, Ole Kristian Lerche","Schmidt, Henrik","Holmvang, L","Jensen, Lisette Okkels","Ravn, Hanne Berg","Møller, Jacob Eifer","Hassager, C"],"cuid":["S01-000.00-593163"],"event":{"end":"2022-03-19","start":"2022-03-18","title":"ESC Acute CardioVascular Care 2022","year":"2022"},"filters":{"added":"2022-11","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"association between inflammatory biomarkers and 000000000030 day mortality in patients with acute myocardial infarction complicated by cardiogenic shock","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1093/ehjacc/zuac041.113","version":"Published Version"},"id":"S01-000.00-593163","ids":["sdu-45935916-c2d9-41d5-b9e5-fd367596b897"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-3EA631C743F81CE476EA5FEDA5C777FD"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1093/ehjacc/zuac041.113","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Cardiology (Odense)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"J","key":"bokunkelpau","last":"Bo Kunkel","name":"Bo Kunkel, J","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"J","key":"josiassenpau","last":"Josiassen","name":"Josiassen, J","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"O K","key":"helgestadpau","last":"Helgestad","locid":"ab9f3165-500c-482b-9c2f-1879b3abedb3","name":"Helgestad, Ole Kristian Lerche","name_org":"Helgestad, O K","orcid":"0000-0003-3847-8758","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"H","key":"schmidtpau","last":"Schmidt","locid":"9789920f-4b31-4f28-8211-97afced9d61e","name":"Schmidt, Henrik","name_org":"Schmidt, H","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"L","key":"holmvangpau","last":"Holmvang","name":"Holmvang, L","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"L","key":"okkelsjensenpau","last":"Okkels Jensen","locid":"b78c452e-5a69-41fe-ba49-0096c84d1d4d","name":"Jensen, Lisette Okkels","name_org":"Okkels Jensen, L","orcid":"0000-0002-4838-2429","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"H","key":"bergravnpau","last":"Berg Ravn","locid":"25de7650-3dc1-4594-b758-9c36f6de6306","name":"Ravn, Hanne Berg","name_org":"Berg Ravn, H","orcid":"0000-0003-4702-5195","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"J","key":"eifermoellerpau","last":"Eifer Moeller","locid":"5e4d3cb6-b0a0-4541-aea1-30e73f7c10b8","name":"Møller, Jacob Eifer","name_org":"Eifer Moeller, J","orcid":"0000-0003-2873-5845","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"C","key":"hassagerpau","last":"Hassager","name":"Hassager, C","rank":9,"rolecode":"pau"}],"pub":{"doi":"10.1093/ehjacc/zuac041.113","issn":["20488726","20488734"],"issn_org":["20488734"],"issue":"Supplement_1","journal":"European Heart Journal: Acute Cardiovascular Care","paperid":"20219","publisher":"Oxford University Press","status":"p","title":"European Heart Journal: Acute Cardiovascular Care","title_org":"European Heart Journal - Acute Cardiovascular Care","volume":"11"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-45935916-c2d9-41d5-b9e5-fd367596b897"],"src":["SDU University of Southern Denmark"],"title":"Association between inflammatory biomarkers and 30-day mortality in patients with acute myocardial infarction complicated by cardiogenic shock","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-593163","year":"2022","yearsub":"2022"}
{"abstract":"Contemporary management of cardiogenic shock (CS) with vasopressors is associated with increased cardiac workload and despite the use of unloading devices such as the Impella pump, concomitant vasopressors are often necessary. Therefore, we compared if cardiac workload could be reduced and end-organ perfusion preserved with biventricular support (Bipella) compared to ImpellaCP and norepinephrine in pigs with left ventricular (LV) CS caused by left main coronary microembolization. Cardiac workload was calculated from heart rate × ventricular pressure-volume area obtained from conductance catheters placed in the LV and right ventricle (RV), whereas organ perfusion was measured from venous oxygen saturation in the pulmonary artery (SvO2) and the kidney- and the cerebral vein. A cross-over design was used to access the difference after 30 minutes of ImpellaCP and norepinephrine 0.1 µg/kg/min versus Bipella for 60 minutes. Bipella treatment reduced LV workload (p = 0.0078) without significant difference in RV workload from ImpellaCP and norepinephrine, however a decrease in SvO2 (49[44-58] vs. 66[63-73]%, p = 0.01) and cerebral venous oxygen saturations (62[48-66] vs. 71[63-77]%, p = 0.016) was observed during Bipella compared to ImpellaCP and norepinephrine. We conclude that Bipella reduced LV workload but did not preserve end-organ perfusion compared to ImpellaCP and norepinephrine in short-term LV CS.","author_count":9,"contributors":["Udesen, Nanna Louise Junker","Josiassen, Jakob","Helgestad, Ole Kristian Lerche","Banke, Ann","Frederiksen, Peter H.","Jensen, Lisette Okkels","Schmidt, Henrik","Ravn, Hanne Berg","Møller, Jacob Eifer"],"cuid":["S01-000.00-631018"],"filters":{"added":"2022-11","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Udesen, Nanna Louise Junker"],"keyword":["Animals","Cardiac work","Cardiogenic shock","Cross Over Studies","Experimental study","Heart Assist Devices","Heart Ventricles","Impella","Mechanical circulatory support","Norepinephrine therapeutic use","Organ perfusion","Shock Cardiogenic therapy","Swine","Vasoconstrictor Agents","Vasopressors"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"biventricular compared to left ventricular impella and norepinephrine support in a porcine model of severe cardiogenic shock","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85137745760","version":"Other Version"},"id":"S01-000.00-631018","identifier":[{"id":"85137745760","type":"scopus"},{"id":"34967781","type":"pmid"}],"ids":["sdu-c9af64ff-5c3b-44e2-a6c0-7fe5e488201b"],"keyword":["Animals","Cross-Over Studies","Heart Ventricles","Heart-Assist Devices","Impella","Norepinephrine/therapeutic use","Shock, Cardiogenic/therapy","Swine","Vasoconstrictor Agents","cardiac work","cardiogenic shock","experimental study","mechanical circulatory support","organ perfusion","pressure-volume area","vasopressors"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-07664A468D0ACFCA348D39083B593F30"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Cardiology (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Nanna L J","key":"udesenpau","last":"Udesen","locid":"f71f56f5-4f36-4de5-a7ae-e5e51f101a83","name":"Udesen, Nanna Louise Junker","name_org":"Udesen, Nanna L J","orcid":"0000-0003-1542-3260","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jakob","key":"josiassenpau","last":"Josiassen","name":"Josiassen, Jakob","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ole K L","key":"helgestadpau","last":"Helgestad","locid":"ab9f3165-500c-482b-9c2f-1879b3abedb3","name":"Helgestad, Ole Kristian Lerche","name_org":"Helgestad, Ole K L","orcid":"0000-0003-3847-8758","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ann B S","key":"bankepau","last":"Banke","locid":"0d350637-c6ce-4cf8-82ba-e965da703690","name":"Banke, Ann","name_org":"Banke, Ann B S","orcid":"0000-0002-1036-580X","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Peter H","key":"frederiksenpau","last":"Frederiksen","locid":"85d6facd-93bf-44ee-a117-269fb26a52be","name":"Frederiksen, Peter H.","name_org":"Frederiksen, Peter H","orcid":"0000-0003-3712-7980","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lisette O","key":"jensenpau","last":"Jensen","locid":"b78c452e-5a69-41fe-ba49-0096c84d1d4d","name":"Jensen, Lisette Okkels","name_org":"Jensen, Lisette O","orcid":"0000-0002-4838-2429","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik","key":"schmidtpau","last":"Schmidt","locid":"9789920f-4b31-4f28-8211-97afced9d61e","name":"Schmidt, Henrik","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hanne B","key":"ravnpau","last":"Ravn","locid":"25de7650-3dc1-4594-b758-9c36f6de6306","name":"Ravn, Hanne Berg","name_org":"Ravn, Hanne B","orcid":"0000-0003-4702-5195","rank":8,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Jacob E","key":"møllerpau","last":"Møller","locid":"5e4d3cb6-b0a0-4541-aea1-30e73f7c10b8","name":"Møller, Jacob Eifer","name_org":"Møller, Jacob E","orcid":"0000-0003-2873-5845","rank":9,"rolecode":"pau"}],"pmid":["34967781"],"pub":{"doi":"10.1097/mat.0000000000001636","issn":["10582916","1538943X"],"issn_org":["10582916"],"issue":"9","journal":"ASAIO Journal","pages":"1141-1148","publisher":"Lippincott Williams and Wilkins","status":"p","title":"ASAIO Journal","volume":"68"},"review":"Peer Reviewed","scoID":["2-s2.0-85137745760"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-c9af64ff-5c3b-44e2-a6c0-7fe5e488201b"],"src":["SDU University of Southern Denmark"],"title":"Biventricular Compared to Left Ventricular Impella and Norepinephrine Support in a Porcine Model of Severe Cardiogenic Shock","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-631018","year":"2022","yearsub":"2022"}
{"abstract":"BACKGROUND: Typhoid fever, caused by S. enterica ser. Typhi, continues to be a substantial health burden in developing countries. Little is known of the genotypic diversity of S. enterica ser. Typhi in Zimbabwe, but this is key for understanding the emergence and spread of this pathogen and devising interventions for its control. OBJECTIVES: To report the molecular epidemiology of S. enterica ser. Typhi outbreak strains circulating from 2012 to 2019 in Zimbabwe, using comparative genomics. METHODS: : A review of typhoid cases records from 2012 to 2019 in Zimbabwe was performed. The phylogenetic relationship of outbreak isolates from 2012 to 2019 and emergence of antibiotic resistance was investigated by whole-genome sequence analysis. RESULTS: A total 22 479 suspected typhoid cases, 760 confirmed cases were reported from 2012 to 2019 and 29 isolates were sequenced. The majority of the sequenced isolates were predicted to confer resistance to aminoglycosides, β-lactams, phenicols, sulphonamides, tetracycline and fluoroquinolones (including qnrS detection). The qnrS1 gene was associated with an IncN (subtype PST3) plasmid in 79% of the isolates. Whole-genome SNP analysis, SNP-based haplotyping and resistance determinant analysis showed that 93% of the isolates belonged to a single clade represented by multidrug-resistant H58 lineage I (4.3.1.1), with a maximum pair-wise distance of 22 SNPs. CONCLUSIONS: This study has provided detailed genotypic characterization of the outbreak strain, identified as S. Typhi 4.3.1.1 (H58). The strain has reduced susceptibility to ciprofloxacin due to qnrS carried by an IncN (subtype PST3) plasmid resulting from ongoing evolution to full resistance.","author_count":23,"contributors":["Mashe, Tapfumanei","Leekitcharoenphon, Pimlapas","Mtapuri-Zinyowera, Sekesai","Kingsley, Robert A","Robertson, V","Tarupiwa, Andrew","Kock, Marleen M","Makombe, Evidence P","Chaibva, Blessmore V","Manangazira, Portia","Phiri, Isaac","Nyadundu, Simon","Chigwena, Chriswell T","Mufoya, Last P","Thilliez, Gaetan","Midzi, Stanely","Mwamakamba, Lusubilo W","Hamblion, Esther L","Matheu, Jorge","Jensen, Jacob Dyring","Aarestrup, Frank Møller","Hendriksen, Rene S.","Ehlers, Marthie M"],"cuid":["S01-000.00-372174"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Africa","Europe, EU","Europe, Non-EU","OECD"],"corresponding_author":["Mashe, Tapfumanei"],"country":["Germany","South Africa","Switzerland","United Kingdom","Zimbabwe"],"glorg":["All Global Affiliations","Gweru Provincial Hospital","Medecins Sans Frontieres","Ministry of Health and Child Care, Zimbabwe","Quadram Institute","University of Pretoria","World Health Organization Regional Office for Africa","World Health Organization Regional Office for Europe","Zimbabwe Open University"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"salmonella enterica serovar typhi h000000000058 clone has been endemic in zimbabwe from 000000002012 to 000000002019","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85104900012","version":"Other Version"},"id":"S01-000.00-372174","identifier":[{"id":"33347558","type":"pmid"},{"id":"85104900012","type":"scopus"}],"ids":["dtu-e2275c58-50fb-4d01-8596-c3085e61af80"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-BF848896B4847A6C86B974024D4F6A6D"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"za","key":"university of pretoria","loc":["South Africa","Africa"],"name":"University of Pretoria","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":