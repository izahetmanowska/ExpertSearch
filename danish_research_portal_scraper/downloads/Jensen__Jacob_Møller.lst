, Sivagowry Rasalingam","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Carsten","key":"stengaardpau","last":"Stengaard","name":"Stengaard, Carsten","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Louise","key":"lindepau","last":"Linde","locid":"4fc23628-00d4-466a-9e6e-269e23160481","name":"Linde, Louise","orcid":"0000-0002-7757-2571","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jacob Eifer","key":"møllerpau","last":"Møller","locid":"5e4d3cb6-b0a0-4541-aea1-30e73f7c10b8","name":"Møller, Jacob Eifer","orcid":"0000-0003-2873-5845","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lisette Okkels","key":"jensenpau","last":"Jensen","locid":"b78c452e-5a69-41fe-ba49-0096c84d1d4d","name":"Jensen, Lisette Okkels","orcid":"0000-0002-4838-2429","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Henrik","key":"schmidtpau","last":"Schmidt","locid":"9789920f-4b31-4f28-8211-97afced9d61e","name":"Schmidt, Henrik","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lars Peter","key":"riberpau","last":"Riber","locid":"607e34a6-2b96-4466-ad5f-48b2c188f589","name":"Riber, Lars","name_org":"Riber, Lars Peter","orcid":"0000-0001-6898-2715","rank":7,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jo Bønding","key":"andreasenpau","last":"Andreasen","name":"Andreasen, Jo Bønding","rank":8,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Sisse Anette","key":"thomassenpau","last":"Thomassen","name":"Thomassen, Sisse Anette","rank":9,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Helle","key":"laugesenpau","last":"Laugesen","name":"Laugesen, Helle","rank":10,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Phillip Michael","key":"freemanpau","last":"Freeman","name":"Freeman, Phillip Michael","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Steffen","key":"christensenpau","last":"Chri