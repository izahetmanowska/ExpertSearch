-458e-996a-e9a0fccd663f","name":"Terkelsen, Christian Juhl","rank":9,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Christian Juhl","key":"therkelsenpau","last":"Therkelsen","name":"Therkelsen, Christian Juhl","rank":9,"rolecode":"pau"},{"affno":"7","corresponding":null,"country":"dk","first":"Mariann","key":"tangpau","last":"Tang","locid":"0fdc96d2-9f5c-4e81-9396-e8ab7652b824","name":"Tang, Mariann","orcid":"0000-0003-2861-682X","rank":10,"rolecode":"pau"},{"affno":"7 4","corresponding":null,"country":"dk","first":"Steffen","key":"christensenpau","last":"Christensen","locid":"43687f4c-bb2b-418b-9051-39c0d5135c05","name":"Christensen, Steffen","orcid":"0000-0001-6149-7186","rank":11,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jacob Eifer","key":"møllerpau","last":"Møller","locid":"5e4d3cb6-b0a0-4541-aea1-30e73f7c10b8","name":"Møller, Jacob Eifer","orcid":"0000-0003-2873-5845","rank":12,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jens Flensted","key":"lassenpau","last":"Lassen","locid":"2af194b2-635f-4b62-84c2-26bd7dc3263b","name":"Lassen, Jens Flensted","orcid":"0000-0001-7972-9192","rank":13,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Matilde","key":"wintherjensenpau","last":"Winther-Jensen","name":"Winther-Jensen, Matilde","rank":14,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Sisse","key":"thomassenpau","last":"Thomassen","name":"Thomassen, Sisse","rank":15,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Sisse","key":"tomassenpau","last":"Tomassen","name":"Tomassen, Sisse","rank":15,"rolecode":"pau"},{"affno":"5 6","corresponding":null,"first":"Helle","key":"laugesenpau","last":"Laugesen","name":"Laugesen, Helle","rank":16,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Christian","key":"hassagerpau","last":"Hassager","name":"Hassager, Christian","rank":17,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Helle","key":"søholmpau","last":"Søholm","name":"Søholm, Helle","rank":18,"rolecode":"pau"}],"pub":{"doi":"10.1161/circ.144.suppl_2.10522","issn":["00097322","15244539"],"issn_org":["00097322"],"issue":"Suppl_2","journal":"Circulation","paperid":"10522","publisher":"Lippincott Williams and Wilkins","status":"p","title":"Circulation","volume":"144"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-8acc1421-d4e9-4455-9e49-9b97590b6c0d","sdu-802ca965-11f2-4a6f-bc26-2b04903cd7ad"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"Early Lactate Clearance is Associated With Survival in a National Cohort of Refractory Out-of-Hospital Cardiac Arrest Patients Managed With Extracorporeal Cardiopulmonary Resuscitation","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-088.86-022778","year":"2021","yearsub":"2021"}
{"abstract":"Objectives: This study examined the link between accelerometer recordings and cardiac pathophysiology measured with right heart cauterization at rest and with exercise in patients with HFrEF. Background: Patient-worn accelerometers are increasingly being used in patients with heart failure with reduced ejection fraction (HFrEF) to assess activity and serve as surrogate endpoints in heart failure trials. Methods: Physical average daily activity (PADA) and total average daily activity according to accelerometer units were assessed in 63 patients (mean age 58 ± 10 years; mean ejection fraction 26% ± 4%). Patients underwent hemodynamic exercise testing and accelerometry. Patients were divided according to PADA in PADALow and PADAHigh activity level groups based on median counts per minute of physical activity. Results: Patients in the PADALow group were older and more frequently treated with diuretics. At rest, the PADALow group was characterized by a lower cardiac index (2.2 ± 0.4 L/min/m2 vs 2.4 ± 0.4 L/min/m2; P = 0.01) and stroke volume (70 ± 19 mL vs 81 ± 17 mL; P = 0.02) but not pulmonary capillary wedge pressure (12 ± 5 mm Hg vs 11 ± 5 mm Hg; P = 0.3). The PADALow group reached a lower cardiac index (4.8 ± 1.7 L/min/m2 vs 6.6 ± 1.7 L/min/m2; P < 0.001) but not in pulmonary capillary wedge pressure (31 ± 12 mm Hg vs 27 ± 8 mm Hg; P = 0.2) at peak exercise. The attenuated increase was associated with an attenuated increase in stroke volume (94 ± 32 mL vs 121 ± 29 mL; P < 0.001) rather than a reduced increase in heart rate (42 ± 23 beats/min vs 52 ± 21 beats/min; P = 0.07). PADA and total average daily accelerometer units were associated with patient-reported functional impairment according to the Kansas City Cardiomyopathy Questionnaire but not with New York Heart Association functional class. Conclusions: Among stable ambulatory patients with HFrEF, lower daily activity is associated with poorer cardiac index reserve and reduced cardiac index during exercise. (Empagliflozin in Heart Failure Patients With Reduced Ejection Fraction; NCT03198585)","author_count":10,"contributors":["Omar, Massar","Jensen, Jesper","Frederiksen, Peter H.","Videbæk, Lars","Poulsen, Mikael Kjær","Brønd, Jan Christian","Gustafsson, Finn","Borlaug, Barry A.","Schou, Morten","Møller, Jacob Eifer"],"cuid":["S02-092.16-047247"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["America, North","OECD"],"corresponding_author":["Omar, Massar"],"country":["United States"],"glorg":["All Global Affiliations","Mayo Clinic","Mayo Clinic Rochester, MN"],"keyword":["Accelerometer","Accelerometry","Aged","Exercise testing","HFrEF","Heart failure","Hemodynamics","Humans","Middle Aged","Pulmonary Wedge Pressure","Stroke Volume","patient centric outcome"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"hemodynamic determinants of activity measured by accelerometer in patients with stable heart failure","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85117161453","version":"Other Version"},"funding_acknowledgement":["This work was supported by the Danish Heart Foundation (grants 17-R116-A7714-22076 and 18-R124-A8573-22107), Steno Diabetes Center Odense, Denmark (grant 3363), and the A.P. Møller Foundation for the Advancement of Medical Science (grant 17-L-0339). The funders took no part in the design of the study and had no role during its execution, analyses, interpretation of the data, or decision to submit results. Dr Omar has received grants from the Danish Heart Foundation, The Steno Diabetes Center Odense, Denmark, and the A.P. Møller Foundation during the conduct of the study. Dr Jensen has received grants from the Research Council at Herlev and Gentofte University Hospital, Denmark, the Research and Innovation Foundation of the Department of Cardiology (FUHAS; formerly FUKAP), Herlev and Gentofte University Hospital, Denmark, and the A.P. Møller Foundation for the Advancement of Medical Science, Denmark, during the conduct of the study. Dr Gustafsson has received personal fees from Boehringer Ingelheim, during the conduct of the study; personal fees from Novartis; grants and personal fees from Pfizer; and personal fees from Orion Pharma Abbott, Bayer, AstraZeneca, and Carmat, outside the submitted work. Dr Borlaug has received grants from a research project grant program, from the National Institutes of Health (R01 HL128526). Dr Schou has received grants from The Capital Region of Denmark and the Danish Heart Foundation, during the conduct of the study; and personal fees and nonfinancial support from AstraZeneca; and personal fees from Novo Nordisk and Boehringer Ingelheim, outside the submitted work. Dr Møller has received grants and personal fees from Abiomed; and personal fees from Novartis and Orion Pharma, outside the submitted work. All other authors have reported that they have no relationships relevant to the contents of this paper to disclose."],"id":"S02-092.16-047247","identifier":[{"id":"85117161453","type":"scopus"},{"id":"34509409","type":"pmid"}],"ids":["ku-ef6c2fec-6df6-48cc-b19a-be7785b460a4","sdu-7707546f-2b06-4150-879c-19444dcf3f1c"],"keyword":["Accelerometry","Aged","HFrEF","Heart Failure","Humans","Middle Aged","Pulmonary Wedge Pressure","Stroke Volume","accelerometer","exercise testing","hemodynamics","patient-centric outcome"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-889F1D279D1E11EA37EFA066580C8EF0"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"a