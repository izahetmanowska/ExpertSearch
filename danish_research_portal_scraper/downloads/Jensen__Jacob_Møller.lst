rk"],"title":"Effects of empagliflozin on erythropoiesis in heart failure : data from the Empire HF trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-097.25-026117","year":"2023","yearsub":"2023"}
{"abstract":"Neutrophil gelatinase-associated lipocalin (NGAL) is an inflammatory biomarker related to acute kidney injury (AKI). Including 1892 consecutive patients with ST-elevation myocardial infarction (STEMI), in which NGAL was measured in 1624 (86%) on admission and in a consecutive subgroup at 6–12 h (n = 163) and 12–24 h (n = 222) after admission, this study aimed to evaluate the prognostic value of NGAL in predicting AKI and mortality. Patients were stratified based on whether their admission NGAL plasma concentration was greater than or equal to/less than the median. The primary endpoint was a composite of the first occurrence of AKI or all-cause death within 30 days. AKI was classified by the maximal plasma creatinine increase from baseline during index admission as KDIGO1 (<200% increase) or KDIGO23 (≥200% increase) according to the Kidney Disease Improving Global Outcomes (KDIGO) system. Admission NGAL > the median was independently associated with a higher risk of severe AKI (KDIGO2-3) and 30-day all-cause mortality when adjusted for age, admission systolic blood pressure and high-sensitivity C-reactive protein, left-ventricular ejection fraction, known kidney dysfunction, and cardiogenic shock with an odds ratio (95% confidence interval) of 2.26 (1.18–4.51), p = 0.014. Finally, we observed increasing predictive values in a subgroup during the first day of hospitalization suggesting that assessment of NGAL should be delayed for optimal prognostic purposes.","author_count":12,"contributors":["Højagergaard, Mathias Alexander","Beske, Rasmus Paulin","Hassager, Christian","Holmvang, Lene","Jensen, Lisette Okkels","Shacham, Yacov","Meyer, Martin Abild Stengaard","Møller, Jacob Eifer","Helgestad, Ole Kristian Lerche","Mark, Peter Dall","Møgelvang, Rasmus","Frydland, Martin"],"cuid":["S02-100.00-692302"],"filters":{"added":"2023-08","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["Asia, Middle East","OECD"],"corresponding_author":["Frydland, Martin"],"country":["Israel"],"glorg":["All Global Affiliations","Tel Aviv University"],"keyword":["AKI","Acute kidney injury","Acute myocardial infarction","Biomarker","Mortality","NGAL","Neutrophil gelatinase associated lipocalin","Plasma","ST elevation myocardial infarction","STEMI"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-SDR","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"neutrophil gelatinase associated lipocalin ngal in patients with st elevation myocardial infarction and its association with acute kidney injury and mortality","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/jcm12113681","version":"Published Version"},"funding_acknowledgement":["This work was supported by Righospitalets Forskningsfond (Grant number: 07IO), Forskningspuljen ml RH og OUH [Grant number 13-A750, 25-A1365], The Danish Heart Foundation (Hjerteforeningen) [Grant number A6024], Lundbeck Foundation (R186-2015-2132), and Hjertecentrets Forskningsudvalg, Rigshospitalet [no grant number]."],"id":"S02-100.00-692302","identifier":[{"id":"PMC10254065","type":"pmcid"},{"id":"37297879","type":"pmid"},{"id":"85161406417","type":"scopus"}],"ids":["ku-be75d6e8-7db6-4cdc-ac93-0b877821d05a","sdu-38325745-da98-4a2e-8198-969d525dc067"],"keyword":["AKI","NGAL","Neutrophil gelatinase-associated lipocalin","ST-elevation myocardial infarction","STEMI","acute kidney injury","acute myocardial infarction","biomarker","mortality","plasma"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-0970C58A8E861645C133584777784937"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/369127956/jcm_12_03681.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/jcm12113681","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/233564187/jcm_12_03681.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Internal medicine: Cardiology"],"nora_code":"DI-U-KU","used":1},{"affno":"3","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Cardiology (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"4","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Odense University Hospital"],"nora_code":"DI-HO-SDR","used":1},{"affno":"5","country":"il","key":"tel aviv university","loc":["Israel","Asia, Middle East","OECD"],"name":"Tel Aviv University","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Mathias Alexander","key":"højagergaardpau","last":"Højagergaard","name":"Højagergaard, Mathias Alexander","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rasmus Paulin","key":"beskepau","last":"Beske","name":"Beske, Rasmus Paulin","rank":2,"rolecode":"pau"},{"affno":"1 2","first":"Christian","key":"hassagerpau","last":"Hassager","locid":"49196e5d-0f61-44b2-a6b9-cd6c5f8f3bc2","name":"Hassager, Christian","orcid":"0000-0002-1199-0981","rank":3,"rolecode":"pau"},{"affno":"1 2","first":"Lene","key":"holmvangpau","last":"Holmvang","locid":"54b8ef01-f8ed-4c49-a126-2109e2fd351f","name":"Holmvang, Lene","rank":4,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Lisette Okkels","key":"jensenpau","last":"Jensen","locid":"b78c452e-5a69-41fe-ba49-0096c84d1d4d","name":"Jensen, Lisette Okkels","orcid":"0000-0002-4838-2429","rank":5,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Yacov","key":"shachampau","last":"Shacham","name":"Shacham, Yacov","rank":6,"rolecode":"pau"},{"affno":"1 2","first":"Martin Abild Stengaard","key":"meyerpau","last":"Meyer","locid":"ce7fea12-4585-4fd8-99fd-1e89902675e3","name":"Meyer, Martin Abild Stengaard","rank":7,"rolecode":"pau"},{"affno":"1 3 4","corresponding":null,"first":"Jacob Eifer","key":"moellerpau","last":"Moeller","locid":"5e4d3cb6-b0a0-4541-aea1-30e73f7c10b8","name":"Møller, Jacob Eifer","name_org":"Moeller, Jacob Eifer","orcid":"0000-0003-2873-5845","rank":8,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Ole Kristian Lerche","key":"helgestadpau","last":"Helgestad","locid":"ab9f3165-500c-482b-9c2f-1879b3abedb3","name":"Helgestad, Ole Kristian Lerche","orcid":"0000-0003-3847-8758","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Peter Dall","key":"markpau","last":"Mark","name":"Mark, Peter Dall","rank":10,"rolecode":"pau"},{"affno":"1 2","first":"Rasmus","key":"møgelvangpau","last":"Møgelvang","locid":"0863bdef-1d17-423f-b966-d42aba8df925","name":"Møgelvang, Rasmus","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Martin","key":"frydlandpau","last":"Frydland","name":"Frydland, Martin","rank":12,"rolecode":"pau"}],"pmid":["37297879"],"pub":{"doi":"10.3390/jcm12113681","issn":["20770383"],"issue":"11","journal":"Journal of Clinical Medicine","paperid":"3681","publisher":"MDPI","status":"p","title":"Journal of Clinical Medicine","volume":"12"},"review":"Peer Reviewed","scoID":["2-s2.0-85161406417"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-be75d6e8-7db6-4cdc-ac93-0b877821d05a","sdu-38325745-da98-4a2e-8198-969d525dc067"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Neutrophil Gelatinase-Associated Lipocalin (NGAL) in Patients with ST-Elevation Myocardial Infarction and Its Association with Acute Kidney Injury and Mortality","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-692302","year":"2023","yearsub":"2023"}
{"abstract":"BACKGROUND: Vasoactive treatment is a cornerstone in treating hypoperfusion in cardiogenic shock following acute myocardial infarction (AMICS). The purpose was to compare the achievement of treatment targets and outcome in relation to vasoactive strategy in AMICS patients stratified according to the Society of Cardiovascular Angiography and Interventions (SCAI) shock classification. METHODS: Retrospective analysis of patients with AMICS admitted to cardiac intensive care unit at two tertiary cardiac centers during 2010-2017 with retrieval of real-time hemodynamic data and dosages of vasoactive drugs from intensive care unit databases. RESULTS: Out of 1,249 AMICS patients classified into SCAI class C, D, and E, mortality increased for each shock stage from 34% to 60%, and 82% (p<0.001). Treatment targets of mean arterial blood pressure > 65mmHg and venous oxygen saturation > 55% were reached in the majority of patients; however, more patients in SCAI class D and E had values below treatment targets within 24 hours (p<0.001) despite higher vasoactive load and increased use of epinephrine for each severity stage (p<0.001). In univariate analysis no significant difference in mortality within SCAI class D and E regarding vasoactive strategy was observed, however in SCAI class C, epinephrine was associated with higher mortality and a significantly higher vasoactive load to reach treatment targets. In multivariate analysis there was no statistically association between individually vasoactive choice within each SCAI class and 30-day mortality. CONCLUSION: Hemodynamic treatment targets were achieved in most patients at the expense of increased vasoactive load and more frequent use of epinephrine for each shock severity stage. Mortality was high regardless of vasoactive strategy; only in SCAI class C, epinephrine was associated with a significantly higher mortality, but the signal was not significant in adjusted analysis.","author_count":12,"contributors":["Udesen, Nanna Louise Junker","Helgestad, Ole Kristian Lerche","Josiassen, Jakob","Hassager, Christian","Højgaard, Henrik Frederiksen","Linde, Louise","Kjaergaard, Jesper","Holmvang, Lene","Jensen, Lisette Okkels","Schmidt, Henrik","Ravn, Hanne Berg","Møller, Jacob Eifer"],"cuid":["S02-087.18-040173"],"filters":{"added":"2022-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corresponding_author":["Udesen, Nanna Louise Junker"],"keyword":["Angiography","Epinephrine therapeutic use","Humans","Myocardial Infarction complications","Retrospective Studies","Shock Cardiogenic"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-SDR","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"vasoactive pharmacological management according to scai class in patients with acute myocardial infarction and cardiogenic shock","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1371/journal.pone.0272279","version":"Published Version"},"id":"S02-087.18-040173","identifier":[{"id":"85135426530","type":"scopus"},{"id":"35925990","type":"pmid"},{"id":"PMC9352108","type":"pmcid"}],"ids":["ku-0f0b5320-ce4c-4bc5-8d69-ca32a2e728f4","sdu-4437a510-e04e-43d3-9543-6554dc396fa5"],"keyword":["Angiography","Epinephrine/therapeutic use","Humans","Myocardial Infarction/complications","Retrospective Studies","Shock, Cardiogenic"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-6FCD1700587A1DCF9E73EA53D3C430C7"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/207044862/journal.pone.0272279.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1371/journal.pone.0272279","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/327138875/journal.pone.0272279.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Cardiology (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Odense University Hospital"],"nora_code":"DI-HO-SDR","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"4","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Nanna Louise Junker","key":"u