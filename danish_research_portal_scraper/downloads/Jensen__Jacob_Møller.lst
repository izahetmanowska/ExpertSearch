no":"2","corresponding":null,"first":"Nanne Louise Junker","key":"udesenpau","last":"Udesen","name":"Udesen, Nanne Louise Junker","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ann","key":"bankepau","last":"Banke","locid":"0d350637-c6ce-4cf8-82ba-e965da703690","name":"Banke, Ann","orcid":"0000-0002-1036-580X","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Peter Hartmund","key":"frederiksenpau","last":"Frederiksen","locid":"85d6facd-93bf-44ee-a117-269fb26a52be","name":"Frederiksen, Peter H.","name_org":"Frederiksen, Peter Hartmund","orcid":"0000-0003-3712-7980","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Janus Adler","key":"hyldebrandtpau","last":"Hyldebrandt","name":"Hyldebrandt, Janus Adler","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Henrik","key":"schmidtpau","last":"Schmidt","name":"Schmidt, Henrik","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lisette Okkels","key":"jensenpau","last":"Jensen","locid":"b78c452e-5a69-41fe-ba49-0096c84d1d4d","name":"Jensen, Lisette Okkels","orcid":"0000-0002-4838-2429","rank":8,"rolecode":"pau"},{"affno":"4 1","first":"Christian","key":"hassagerpau","last":"Hassager","locid":"49196e5d-0f61-44b2-a6b9-cd6c5f8f3bc2","name":"Hassager, Christian","orcid":"0000-0002-1199-0981","rank":9,"rolecode":"pau"},{"affno":"4 2","first":"Hanne Berg","key":"ravnpau","last":"Ravn","locid":"3049e7b7-0f18-413b-88ab-a3d77ebc079b","name":"Ravn, Hanne Berg","orcid":"0000-0003-4702-5195","rank":10,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Jacob E.","key":"mollerpau","last":"Moller","locid":"5e4d3cb6-b0a0-4541-aea1-30e73f7c10b8","name":"Møller, Jacob Eifer","name_org":"Moller, Jacob E.","orcid":"0000-0003-2873-5845","rank":11,"rolecode":"pau"}],"pmid":["32785808"],"pub":{"doi":"10.1186/s40635-020-00326-y","issn":["2197425X"],"journal":"Intensive Care Medicine Experimental","paperid":"41","publisher":"Springer","status":"p","title":"Intensive Care Medicine Experimental","volume":"8"},"review":"Peer Reviewed","scoID":["2-s2.0-85105492876"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-8b0dcf35-69da-49a0-995b-cdc6f5e20783","sdu-8859b9de-a6d7-43d2-9ccb-7055639e60ac"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Unloading using Impella CP during profound cardiogenic shock caused by left ventricular failure in a large animal model : impact on the right ventricle","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.69-044214","year":"2020","yearsub":"2020"}
{"abstract":"Background: Inhibition of the sodium-glucose cotransporter-2 (SGLT2i) improves outcomes in patients with heart failure (HF) and reduced ejection fraction (HFrEF), but the mechanism by which they improve outcomes remains unclear. Objectives: This study aimed to investigate the effects of sodium-glucose cotransporter-2 inhibitor empagliflozin on central hemodynamics in patients with HF and HFrEF. Methods: This investigator-initiated, double-blinded, placebo-controlled, randomized trial enrolled 70 patients with HFrEF from March 6, 2018, to September 10, 2019. Patients were assigned to empagliflozin of 10 mg or matching placebo once daily on guideline-driven HF therapy for 12 weeks. The primary outcome was ratio of pulmonary capillary wedge pressure (PCWP) to cardiac index (CI) at peak exercise after 12 weeks. Patients underwent right-heart catheterization at rest and during exercise at baseline and 12-week follow-up. Results: Patients with HFrEF, mean age of 57 years, mean left-ventricular ejection fraction, 26%, and 12 (17%) with type 2 diabetes mellitus were randomized. There was no significant treatment effect on peak PCWP/CI (−0.13 mm Hg/l/min/m2; 95% confidence interval: −1.60 to 1.34 mm Hg/l/min/m2; p = 0.86). Considering hemodynamics over the full range of exercise loads, PCWP was significantly reduced (−2.40 mm Hg; 95% confidence interval: −3.96 to −0.84 mm Hg; p = 0.003), but not CI (−0.09 l/min/m2; 95% confidence interval: −0.14 to 0.32 l/min/m2; p = 0.448) by empagliflozin. This was consistent among patients with and without type 2 diabetes. Conclusions: Among patients with stable HFrEF, empagliflozin for 12 weeks reduced PCWP compared with placebo. There was no significant improvement in neither CI nor PCWP/CI at rest or exercise.","author_count":13,"contributors":["Omar, Massar","Jensen, Jesper","Frederiksen, Peter H.","Kistorp, Caroline","Videbæk, Lars","Poulsen, Mikael Kjær","Möller, Sören","Ali, Mulham","Gustafsson, Finn","Køber, Lars","Borlaug, Barry A.","Schou, Morten","Møller, Jacob Eifer"],"cuid":["S02-100.00-046703"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["America, North","OECD"],"corresponding_author":["Omar, Massar"],"country":["United States"],"glorg":["All Global Affiliations","Mayo Clinic","Mayo Clinic Rochester, MN"],"keyword":["Exercise","Hemodynamics","SGLT2 inhibitor","heart failure reduced ejection fraction"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"effect of empagliflozin on hemodynamics in patients with heart failure and reduced ejection fraction","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85096482653","version":"Other Version"},"funding_acknowledgement":["This study is a separate part of the empagliflozin in heart failure patients with reduced ejection fraction (Empire HF) randomized, double-blinded, placebo-controlled trial ( 12 ). The study protocol and statistical analysis plan are available in the Appendix, respectively. The Empire HF trial tested the effect of empagliflozin on brain natriuretic peptide after 12 weeks of treatment and failed to detect a reduction ( 13 ). The current study examined 70 patients, enrolled from March 6, 2018, to September 10, 2019, at a single tertiary center (Odense University Hospital, Denmark) ( Supplemental Figure 1 ). The trial was designed, conducted, and reported complied with the Declaration of Helsinki; was approved by the ethics committee in Denmark (reference number 61738); and was conducted according to Good Clinical Practice. All patients provided written informed consent. The study was designed and conducted without any interference or financial support from the manufacturer of empagliflozin. This work was supported by the Danish Heart Foundation (grant numbers 17-R116-A7714-22076, 18-R124-A8573-22107); Steno Diabetes Center Odense, Denmark (grant number 3363), and A.P. Møller Foundation for the Advancement of Medical Science (grant number 17-L-0339). The foundations took no part in the design of this study and hand no role during its execution, analysis, interpretation of the data, or decision to submit results. The manufacturer of empagliflozin was not involved nor funded the study. Dr. Omar has received grants from the Danish Heart Foundation, The Steno Diabetes Center Odense, Denmark, and the A.P. Møller Foundation. Dr. Jensen has received grants from the Research Council at Herlev and Gentofte University Hospital, Denmark, the Research and Innovation Foundation of the Department of Cardiology (FUHAS [formerly FUKAP]), Herlev and Gentofte University Hospital, Denmark, and the A.P. Møller Foundation for the Advancement of Medical Science, Denmark. Dr. Kistorp has received personal fees from scientific advisory panels and speaker fees from Boehringer Ingelheim, Merck Sharp & Dohme, AstraZeneca, Amgen, Novartis, Novo Nordisk, and Shire. Dr. Gustafsson has received personal fees from Boehringer Ingelheim, Novartis, Orion Pharma Abbott, Bayer, AstraZeneca, and Carmat; and has received grants and personal fees from Pfizer. Dr. Køber has received speaker honoraria from Novartis, AstraZeneca, and Boehringer Ingelheim. Dr. Borlaug has received grants from research project grant program (RO1) HL128526R01 from the National Institutes of Health. Dr. Schou has received grants from The Capital Region of Denmark and the Danish Heart Foundation; has received personal fees and nonfinancial support from AstraZeneca; and has received personal fees from Novo Nordisk and Boehringer Ingelheim. Dr. Møller has received grants and personal fees from Abiomed; and has received personal fees from Novartis and Orion Pharma. All other authors have reported that they have no relationships relevant to the contents of this paper to disclose."],"id":"S02-100.00-046703","identifier":[{"id":"33272368","type":"pmid"},{"id":"85096482653","type":"scopus"}],"ids":["ku-dcd1abe1-9ad7-4874-b5e4-bda7258a5dde","sdu-38d6732b-5c35-43c6-98e0-e7e4771aefa8"],"keyword":["SGLT2 inhibitor","exercise","heart failure reduced ejection fraction","hemodynamics"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-1251B0F1A274247ADF9B2D29F46D0ED6"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Cardiology (Odense)","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of SDCO - Steno Diabetes Center Odense"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"us","key":"mayo clinic rochester mn","loc":["United States","America, North","OECD"],"name":"Mayo Clinic Rochester, MN","used":1},{"affno":"4","country":"us","key":"mayo clinic","loc":["United States","America, North","OECD"],"name":"Mayo Clinic","used":1},{"affno":"5","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Massar","key":"omarpau","last":"Omar","locid":"3a6641e9-a451-482c-a139-b60841705f94","name":"Omar, Massar","orcid":"0000-0002-9634-3889","rank":1,"rolecode":"pau"},{"affno":"2","first":"Jesper","key":"jensenpau","last":"Jensen","locid":"e9d2d407-3550-4e0e-a0da-a9770d60e5a0","name":"Jensen, Jesper","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Peter H.","key":"frederiksenpau","last":"Frederiksen","locid":"85d6facd-93bf-44ee-a117-269fb26a52be","name":"Frederiksen, Peter H.","orcid":"0000-0003-3712-7980","rank":3,"rolecode":"pau"},{"affno":"2","first":"Caroline","key":"kistorppau","last":"Kistorp","locid":"42328645-d772-4f53-9f70-438ff40291b9","name":"Kistorp, Caroline","orcid":"0000-0002-3019-6775","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lars","key":"videbækpau","last":"Videbæk","locid":"c0abdf18-4e26-411a-99c3-de3cbe029dee","name":"Videbæk, Lars","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mikael Kjær","key":"poulsenpau","last":"Poulsen","locid":"a8da3614-e99d-403f-933f-f5dfab3976af","name":"Poulsen, Mikael Kjær","orcid":"0000-0003-4051-7197","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Sören","key":"möllerpau","last":"Möller","locid":"905018dc-c6c4-4a79-b50d-d0c08618e77a","name":"Möller, Sören","orcid":"0000-0003-0858-4269","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mulham","key":"alipau","last":"Ali","locid":"c5edf0d7-b5bb-496e-87f9-67dee7af19a9","name":"Ali, Mulham","rank":8,"rolecode":"pau"},{"affno":"2","first":"Finn","key":"gustafssonpau","last":"Gustafsson","locid":"6716eef1-891b-4209-a823-e96e765b9433","name":"Gustafsson, Finn","rank":9,"rolecode":"pau"},{"affno":"2","first":"Lars","key":"køberpau","last":"Køber","locid":"e3f0c57c-605a-431a-9c63-2213c46621e6","name":"Køber, Lars","rank":10,"rolecode":"pau"},{"affno":"3 4","first":"Barry A.","key":"borlaugpau","last":"Borlaug","name":"Borlaug, Barry A.","rank":11,"rolecode":"pau"},{"affno":"2","first":"Morten","key":"schoupau","last":"Schou","locid":"48fa6ec9-1941-4566-b931-14b0cc8cbae3","name":"Schou, Morten","rank":12,"rolecode":"pau"},{"affno":"1 5","corresponding":null,"first":"Jacob Eifer","key":"møllerpau","last":"Møller","locid":"5e4d3cb6-b0a0-4541-aea1-30e73f7c10b8","name":"Møller, Jacob Eifer","orcid":"0000-0003-2873-5845","rank":13,"rolecode":"pau"}],"pmid":["33272368"],"pub":{"doi":"10.1016/j.jacc.2020.10.005","issn":["07351097","15583597"],"issn_org":["07351097"],"issue":"23","journal":"Journal of the American College of Cardiology","pages":"2740-2751","publisher":"Elsevier","status":"p","title":"Journal of the American College of Cardiology","volume":"76"},"review":"Peer Reviewed","scoID":["2-s2.0-85096482653"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-dcd1abe1-9ad7-4874-b5e4-bda7258a5dde","sdu-38d6732b-5c35-43c6-98e0-e7e4771aefa8"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Effect of Empagliflozin on Hemodynamics in Patients With Heart Failure and Reduced Ejection Fraction","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-046703","year":"2020","yearsub":"2020"}
{"abstract":"We apply recent state-of-the-art optimal control techniques to a challenging many-body problem: driving the superfluid-Mott insulator transition in an optical lattice. At system sizes well beyond the reach of exact diagonalization approaches, and thus requiring a matrix product state ansatz, we obtain fidelities in the range 0.99-0.9999 and beyond with associated quantum speed limit estimates. Whereas previous efforts yielded lower fidelity solutions with smooth, monotonic controls, we efficiently identify a rich hierarchy of bang-bang-like solutions. These facilitate the non-adiabatic quantum interference pathways using sequential tunneling and phase-imprinting dynamics necessary for high fidelity. Mapping out the optimal solutions at various process durations, we observe a characteristic, exponential dependence for the fidelity across several orders of magnitude. Overall, we achieve these results by utilizing the counter-intuitive fact that appropriate dynamical approximations lead to a more precise and significantly cheaper implementation of optimal control than a full dynamical solution. In discussing the technique's generality, this demonstration may pave the way for fulfilling the comprehensive demands for efficient high-fidelity control in very high-dimensional systems which has hitherto not been feasible.","author_count":4,"contributors":["Jensen, Jesper Hasseriis Mohr","Møller, Frederik Skovbo","Sørensen, Jens Jakob Winther H","Sherson, Jacob"],"cuid":["S01-000.00-195370"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"corresponding_author":["Jensen, Jesper Hasseriis Mohr"],"country":["Austria"],"glorg":["All Global Affiliations","Vienna University of Technology"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"achieving fast high fidelity control of many body dynamics","src":["au"],"src-code":["DI-U-AU"],"type":"dw","type-grp":["all","pub"]},"id":"S01-000.00-195370","ids":["au-73b7b410-85c1-412c-9bf1-582feec53f46"],"lang":"Danish","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-D9FF9A194ABC5686B2F61EE7C47AA8F7"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Physics and Astronomy"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"at","key":"vienna university of technology","loc":["Austria","Europe, EU","OECD"],"name":"Vienna University of Technology","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jesper Hasseriis Mohr","key":"jensenpau","last":"Jensen","locid":"90e2a5b6-a5b4-46be-b61b-3e1140888954","name":"Jensen, Jesper Hasseriis Mohr","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Frederik Skovbo","key":"møllerpau","last":"Møller","name":"Møller, Frederik Skovbo","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jens Jakob Winther H","key":"sørensenpau","last":"Sørensen","locid":"5ce4a9ba-0fd6-404b-bdf7-0e9ae99b5891","name":"Sørensen, Jens Jakob Winther H","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jacob","key":"shersonpau","last":"Sherson","locid":"3d8e1590-c4fa-495b-81b4-588fe374b36c","name":"Sherson, Jacob","orcid":"0000-0001-6048-587X","rank":4,"rolecode":"pau"}],"pub":{"status":"e"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["E-Published (ahead of print)"]},"sid":["au-73b7b410-85c1-412c-9bf1-582feec53f46"],"src":["AU Aarhus University"],"title":"Achieving fast high-fidelity control of many-body dynamics","type":"Working Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-195370","year":"2020","yearsub":"2020"}
{"abstract":"BACKGROUND: Thirty-day mortality in ST-elevation myocardial infarction (STEMI) patients is primarily driven by cardiogenic shock (CS). High neutrophil counts and high neutrophil/lymphocyte ratios (NLR) have previously been associated with mortality in STEMI patients; however, there is only sparse knowledge regarding their association with CS. PURPOSE: We sought to assess the associations between neutrophil count and NLR with the development of CS as well as 30-day mortality in STEMI patients. METHODS: Patients admitted with STEMI at two tertiary Heart Centres throughout 1 year were included in the study and stratified into quartiles according to the level of leukocyte count upon admission. The primary endpoint was development of CS both before (early CS) and after leaving the catheterization laboratory (late CS). The secondary endpoint was all-cause 30-day mortality. RESULTS: A total of 1,892 STEMI patients were included, whereof 194 (10%) developed CS while 122 (6.4%) died within 30 days. Patients in the highest quartile of neutrophils (OR: 2.54; 95% CI: 1.40-4.60; P = 0.002) and NLR (OR: 3.64; 95% CI: 2.02-6.54; P<0.0001) were at increased risk of developing late CS compared with patients in the lower quartiles, whereas there was no risk difference across quartiles regarding development of early CS. Both biomarkers correlated strongly to an increased 30-day mortality (plogrank<0.0001) and, moreover, a high level of neutrophils was independently associated with 30-day mortality (HR: 1.95; 95% CI: 1.25-3.03; P = 0.003). CONCLUSION: High levels of neutrophils and a high NLR upon admission for STEMI were independently associated with an increased risk of developing late CS and, additionally, both biomarkers showed association to 30-day mortality.","author_count":16,"contributors":["Klein, Anika","Wiberg, Sebastian","Hassager, Christian","Winther-Jensen, Matilde","Frikke-Schmidt, Ruth","Bang, Lia Evi","Lindholm, Matias Greve","Holmvang, Lene","Moeller-Helgestad, Ole","Ravn, Hanne Berg","Jensen, Lisette Okkels","Kjærgaard, Jesper","Møller, Jacob Eifer","Frydland, Martin"],"cuid":["S02-088.89-042165"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"keyword":["Acute coronary syndrome","Acute heart failure","Clinical biochemistry","Inflammation","Prediction"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"admission leukocyte count is associated with late cardiogenic shock development and all cause 000000000030 day mortality in patients with st elevation myocardial infarction","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85079201300","version":"Other Version"},"id":"S02-088.89-042165","identifier":[{"id":"31058719","type":"pmid"},{"id":"85079201300","type":"scopus"}],"ids":["ku-4b014a79-9e3e-4991-922f-043681233564","sdu-2e708804-872f-4aa3-86a9-b3cc487d4b59"],"keyword":["Acute coronary syndrome","Acute heart failure","Clinical biochemistry","Inflammation","Prediction"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-C51B586672F9FB64701B0C9A7D27E07D"],"oai":{"class":"Blocked","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Internal medicine: Cardiology"],"nora_code":"DI-U-KU","used":1},{"affno":"3","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Cardiology (Odense)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Anika","key":"kleinpau","last":"Klein","name":"Klein, Anika","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sebastian","key":"wibergpau","last":"Wiberg","name":"Wiberg, Sebastian","rank":2,"rolecode":"pau"},{"affno":"2","first":"Christian","key":"hassagerpau","last":"Hassager","locid":"49196e5d-0f61-44b2-a6b9-cd6c5f8f3bc2","name":"Hassager, Christian","orcid":"0000-0002-1199-0981","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Matilde","key":"wintherjensenpau","last":"Winther-Jensen","name":"Winther-Jensen, Matilde","rank":4,"rolecode":"pau"},{"affno":"2","first":"Ruth","key":"frikkeschmidtpau","last":"Frikke-Schmidt","locid":"bce2c3b4-6e08-46c7-96c6-7e385b0ec8b3","name":"Frikke-Schmidt, Ruth","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lia Evi","key":"bangpau","last":"Bang","name":"Bang, Lia Evi","rank":6,"rolecode":"pau"},{"affno":"2 1","first":"Matias Greve","key":"lindholmpau","last":"Lindholm","locid":"4333dd58-10c3-4fea-aadb-048bdc7cbc3a","name":"Lindholm, Matias Greve","rank":7,"rolecode":"pau"},{"affno":"2 1","first":"Lene","key":"holmvangpau","last":"Holmvang","locid":"54b8ef01-f8ed-4c49-a126-2109e2fd351f","name":"Holmvang, Lene","rank":8,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Ole","key":"moellerhelgestadpau","last":"Moeller-Helgestad","locid":"ab9f3165-500c-482b-9c2f-1879b3abedb3","name":"Helgestad, Ole Kristian Lerche","name_org":"Moeller-Helgestad, Ole","orcid":"0000-0003-3847-8758","rank":9,"rolecode":"pau"},{"affno":"2","first":"Hanne Berg","key":"ravnpau","last":"Ravn","locid":"3049e7b7-0f18-413b-88ab-a3d77ebc079b","name":"Ravn, Hanne Berg","rank":10,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Lisette Okkels","key":"jensenpau","last":"Jensen","locid":"b78c452e-5a69-41fe-ba49-0096c84d1d4d","name":"Jensen, Lisette Okkels","orcid":"0000-0002-4838-2429","rank":11,"rolecode":"pau"},{"affno":"","first":"Jesper","key":"kjærgaardpau","last":"Kjærgaard","name":"Kjærgaard, Jesper","rank":12,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper","key":"kjaergaardpau","last":"Kjaergaard","name":"Kjaergaard, Jesper","rank":12,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jacob Eifer","key":"moellerpau","last":"Moeller","locid":"5e4d3cb6-b0a0-4541-aea1-30e73f7c10b8","name":"Møller, Jacob Eifer","name_org":"Moeller, Jacob Eifer","orcid":"0000-0003-2873-5845","rank":13,"rolecode":"pau"},{"affno":"","first":"Jacob Eifer","key":"møllerpau","last":"Møller","name":"Møller, Jacob Eifer","rank":13,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Martin","key":"frydlandpau","last":"Frydland","name":"Frydland, Martin","rank":14,"rolecode":"pau"}],"pmid":["31058719"],"pub":{"doi":"10.1097/shk.0000000000001369","issn":["10732322","15400514"],"issn_org":["10732322"],"issue":"3","journal":"Shock","pages":"299-306","publisher":"Lippincott Williams and Wilkins","status":"p","title":"Shock","title_org":"Shock (Augusta, Ga.)","volume":"53"},"review":"Peer Reviewed","scoID":["2-s2.0-85079201300"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-4b014a79-9e3e-4991-922f-043681233564","sdu-2e708804-872f-4aa3-86a9-b3cc487d4b59"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Admission Leukocyte Count is Associated with Late Cardiogenic Shock Development and All-Cause 30-Day Mortality in Patients with St-Elevation Myocardial Infarction","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-088.89-042165","year":"2020","yearsub":"2020"}
{"abstract":"BACKGROUND: Cardiogenic shock is the leading cause of death in patients with acute myocardial infarction, with short-term mortality of approximately 50%. Whether diabetes mellitus and high blood glucose levels are associated with mortality in contemporary patients with acute myocardial infarction complicated by cardiogenic shock is inadequately described. PURPOSE: To investigate if diabetes mellitus and high admission blood glucose were associated with 30-day mortality in a large, contemporary population with acute myocardial infarction complicated by cardiogenic shock. METHODS: Patients with acute myocardial infarction complicated by cardiogenic shock admitted at two tertiary centres in Denmark from 2010 to 2017 were individually identified through patient charts, resulting in the inclusion of 1716 cardiogenic shock patients. Glucose level at admission to the intensive care unit was available in 1302 patients. RESULTS: There was no significant difference in 30-day mortality between diabetes mellitus types I and II (63% vs. 62%, NS). Thirty-day mortality was significantly higher in diabetes patients compared to non-diabetes patients (62% vs. 50%, P < 0.001). Increasing admission glucose was associated with increasing 30-day mortality in a dose-dependent manner in diabetes mellitus (4-8 mmol/L, 41%; 8-12 mmol/L, 49%; 12-16 mmol/L, 63%; >16 mmol/L, 67%; P = 0.028) and non-diabetes patients (4-8 mmol/L, 32%; 8-12 mmol/L, 43%; 12-16 mmol/L, 57%; >16 mmol/l; 68%; P < 0.001). CONCLUSION: Patients with acute myocardial infarction complicated by cardiogenic shock and concomitant diabetes mellitus type I or II had a significantly higher 30-day mortality in comparison to patients without diabetes mellitus, whereas no difference was found between diabetes mellitus types I and II. High glucose levels on admission to the intensive care unit were associated with increased 30-day mortality in diabetes mellitus and non-diabetes mellitus patients.","author_count":9,"contributors":["Thoegersen, Michael","Josiassen, Jakob","Helgestad, Ole Kl","Ravn, Hanne Berg","Schmidt, Henrik","Holmvang, Lene","Jensen, Lisette Okkels","Møller, Jacob Eller","Hassager, Christian"],"cuid":["S02-100.00-042481"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Acute myocardial infarction","Cardiogenic shock","Diabetes","Glucose","Mortality"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"the association of diabetes and admission blood glucose with 000000000030 day mortality in patients with acute myocardial infarction complicated by cardiogenic shock","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/180399650/Kandidat_speciale_artikel.pdf","version":"Authors Final Version"},"id":"S02-100.00-042481","identifier":[{"id":"85101690542","type":"scopus"},{"id":"32450719","type":"pmid"}],"ids":["ku-542f2d8f-4980-4cb3-b77e-eb825d448200","sdu-09024798-33d2-4df6-8ffb-4bc4acef1188"],"keyword":["Cardiogenic shock","acute myocardial infarction","diabetes","glucose","mortality"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-B113D674F5950CE8B2BFBDA82114E877"],"oa_link":[{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/180399650/Kandidat_speciale_artikel.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmar