sen, Kristoffer Lindskov","rank":5,"rolecode":"pau"},{"affno":"2 3","first":"Michael Bachmann","key":"nielsenpau","last":"Nielsen","locid":"6c91b654-63b7-4eeb-8a6e-ee4a2708020a","name":"Nielsen, Michael Bachmann","orcid":"0000-0002-9380-1688","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Bo","key":"bechpau","last":"Bech","name":"Bech, Bo","rank":7,"rolecode":"pau"},{"affno":"2","first":"Lars","key":"lonnpau","last":"Lonn","locid":"c30d6f51-c103-4f4b-a7db-30af02137484","name":"Lönn, Lars","name_org":"Lonn, Lars","rank":8,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Lars","key":"lönnpau","last":"Lönn","name":"Lönn, Lars","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Marie Sand","key":"trabergpau","last":"Traberg","locid":"4da6fca0-b677-4b9a-a006-a87b72ac6ee3","name":"Traberg, Marie Sand","orcid":"0000-0001-7090-6607","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jørgen Arendt","key":"jensenpau","last":"Jensen","locid":"e197c9fc-743f-4736-8d06-3825897e0989","name":"Jensen, Jørgen Arendt","orcid":"0000-0002-7896-3136","rank":10,"rolecode":"pau"}],"pmid":["29733275"],"pub":{"doi":"10.1109/tuffc.2018.2808328","issn":["08853010","15258955"],"issn_org":["08853010"],"issue":"5","journal":"IEEE Transactions on Ultrasonics, Ferroelectrics and Frequency Control","pages":"709-719","status":"p","title":"IEEE Transactions on Ultrasonics, Ferroelectrics and Frequency Control","title_org":"IEEE Transactions on Ultrasonics, Ferroelectrics, and Frequency Control","volume":"65"},"review":"Peer Reviewed","scoID":["2-s2.0-85042378455"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-b5f4dc50-8144-4f46-a849-a31e16e65146","ku-cde9ed5b-4891-417d-bf0f-8295ee21cdb2"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Noninvasive Estimation of Pressure Changes Using 2-D Vector Velocity Ultrasound : An Experimental Study with In Vivo Examples","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-091.21-036722","year":"2018","yearsub":"2018"}
{"abstract":"OBJECTIVES: To investigate the effects of the glucagon-like peptide-1 analog exenatide on blood glucose, lactate clearance, and hemodynamic variables in comatose, resuscitated out-of-hospital cardiac arrest patients. DESIGN: Predefined post hoc analyzes from a double-blind, randomized clinical trial. SETTING: The ICU of a tertiary heart center. PATIENTS: Consecutive sample of adult, comatose patients undergoing targeted temperature management after out-of-hospital cardiac arrest from a presumed cardiac cause, irrespective of the initial cardiac rhythm. INTERVENTIONS: Patients were randomized 1:1 to receive 6 hours and 15 minutes of infusion of either 17.4 μg of the glucagon-like peptide-1 analog exenatide (Byetta; Lilly) or placebo within 4 hours from sustained return of spontaneous circulation. The effects of exenatide were examined on the following prespecified covariates within the first 6 hours from study drug initiation: lactate level, blood glucose level, heart rate, mean arterial pressure, and combined dosage of norepinephrine and dopamine. MEASUREMENTS AND MAIN RESULTS: The population consisted of 106 patients receiving either exenatide or placebo. During the first 6 hours from study drug initiation, the levels of blood glucose and lactate decreased 17% (95% CI, 8.9-25%; p = 0.0004) and 21% (95% CI, 6.0-33%; p = 0.02) faster in patients receiving exenatide versus placebo, respectively. Exenatide increased heart rate by approximately 10 beats per minute compared to placebo (p < 0.0001). There was no effect of exenatide on other hemodynamic variables. CONCLUSIONS: In comatose out-of-hospital cardiac arrest patients, infusion with exenatide lowered blood glucose and resulted in increased clearance of lactate as well as increased heart rate. The clinical importance of these physiologic effects remains to be investigated.","author_count":15,"contributors":["Wiberg, Sebastian","Kjaergaard, Jesper","Schmidt, Henrik","Thomsen, Jakob Hartvig","Frydland, Martin","Winther-Jensen, Matilde","Lindholm, Matias Greve","Høfsten, Dan E.","Engstrøm, Thomas","Køber, Lars","Møller, Jacob Eifer","Hassager, Christian"],"cuid":["S02-095.00-044562"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"keyword":["Blood Glucose drug effects","Coma blood","Double Blind Method","Exenatide","Female","Glucagon Like Peptide 1 analogs derivatives","Heart Rate drug effects","Hemodynamics","Hemodynamics drug effects","Humans","Lactic Acid metabolism","Male","Middle Aged","Out of Hospital Cardiac Arrest complications","Out of hospital cardiac arrest","glucagon like peptide 1 analogs"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"the glucagon like peptide 000000000001 analog exenatide increases blood glucose clearance lactate clearance and heart rate in comatose patients after out of hospital cardiac arrest","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85068218566","version":"Other Version"},"id":"S02-095.00-044562","identifier":[{"id":"85068218566","type":"scopus"},{"id":"29189347","type":"pmid"}],"ids":["ku-96795d9f-6e62-437c-a617-157aa59e6484","sdu-4551b304-153c-4d54-890b-c4b2f52451ec"],"keyword":["Blood Glucose/drug effects","Coma/blood","Double-Blind Method","Exenatide/pharmacology","Female","Glucagon-Like Peptide 1/analogs & derivatives","Heart Rate/drug effects","Hemodynamics/drug effects","Humans","Lactic Acid/metabolism","Male","Middle Aged","Out-of-Hospital Cardiac Arrest/complications","exenatide","glucagon-like peptide-1 analogs","hemodynamics","lactate clearance","out-of-hospital cardiac arre