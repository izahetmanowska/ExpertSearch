 O.","orcid":"0000-0002-4838-2429","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik","key":"schmidtpau","last":"Schmidt","locid":"9789920f-4b31-4f28-8211-97afced9d61e","name":"Schmidt, Henrik","rank":7,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Elazer R.","key":"edelmanpau","last":"Edelman","name":"Edelman, Elazer R.","rank":8,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Brian Y.","key":"changpau","last":"Chang","name":"Chang, Brian Y.","rank":9,"rolecode":"pau"},{"affno":"5 2","first":"Hanne B","key":"ravnpau","last":"Ravn","locid":"3049e7b7-0f18-413b-88ab-a3d77ebc079b","name":"Ravn, Hanne Berg","name_org":"Ravn, Hanne B","rank":10,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Jacob E.","key":"møllerpau","last":"Møller","locid":"5e4d3cb6-b0a0-4541-aea1-30e73f7c10b8","name":"Møller, Jacob Eifer","name_org":"Møller, Jacob E.","orcid":"0000-0003-2873-5845","rank":11,"rolecode":"pau"}],"pmid":["32188462"],"pub":{"doi":"10.1186/s13054-020-2816-8","issn":["1466609X"],"issn_org":["13648535"],"journal":"Critical Care","paperid":"95","publisher":"BioMed Central","status":"p","title":"Critical Care","volume":"24"},"review":"Peer Reviewed","scoID":["2-s2.0-85081997829"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-caea6cd6-546b-4163-9b63-486f0f5a9365","sdu-29d055d0-4138-479b-901b-c96d776ffc29"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Impact of concomitant vasoactive treatment and mechanical left ventricular unloading in a porcine model of profound cardiogenic shock","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-086.79-046211","year":"2020","yearsub":"2020"}
{"abstract":"Background: Most studies in acute myocardial infarction complicated by cardiogenic shock (AMICS) include patients presenting with and without out-of-hospital cardiac arrest (OHCA). The aim was to compare OHCA and non-OHCA AMICS patients in terms of hemodynamics, management in the intensive care unit (ICU) and outcome. Methods: From a cohort corresponding to two thirds of the Danish population, all patients with AMICS admitted from 2010-2017 were individually identified through patient records. Results: A total of 1716 AMICS patients were identified of which 723 (42%) presented with OHCA. A total of 1532 patients survived to ICU admission. At the time of ICU arrival, there were no differences between OHCA and non-OHCA AMICS patients in variables commonly used in the AMICS definition (mean arterial pressure (MAP) (72mmHg vs 70mmHg, p = 0.12), lactate (4.3mmol/L vs 4.0mmol/L, p = 0.09) and cardiac output (CO) (4.6L/min vs 4.4L/min, p = 0.30)) were observed. However, during the initial days of ICU treatment OHCA patients had a higher MAP despite a lower need for vasoactive drugs, higher CO, SVO2 and lactate clearance compared to non-OHCA patients (p<0.05 for all). In multivariable analysis outcome was similar but cause of death differed significantly with hypoxic brain injury being leading cause in OHCA and cardiac failure in non-OHCA AMICS patients. Conclusion: OHCA and non-OHCA AMICS patients initially have comparable metabolic and hemodynamic profiles, but marked differences develop between the groups during the first days of ICU treatment. Thus, pooling of OHCA and non-OHCA patients as one clinical entity in studies should be done with caution.","author_count":10,"contributors":["Josiassen, Jakob","Helgestad, Ole Kristian Lerche","Møller, Jacob Eifer","Kjaergaard, Jesper","Hoejgaard, Henrik Frederiksen","Schmidt, Henrik","Jensen, Lisette Okkels","Holmvang, Lene","Ravn, Hanne Berg","Hassager, Christian"],"cuid":["S02-088.00-045676"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Josiassen, Jakob"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"hemodynamic and metabolic recovery in acute myocardial infarction related cardiogenic shock is more rapid among patients presenting with out of hospital cardiac arrest","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1371/journal.pone.0244294","version":"Published Version"},"funding_acknowledgement":["The study was funded by The Danish Heart Foundation, The J?rgen M?ller foundation and a research grant from Abiomed. The funding parts were not involved in any aspects of the creation or publishing of current study."],"id":"S02-088.00-045676","identifier":[{"id":"PMC7757873","type":"pmcid"},{"id":"33362228","type":"pmid"},{"id":"85099075119","type":"scopus"}],"ids":["ku-b9f4f55c-86bb-488a-ac1f-9cd18ea5c406","sdu-08fbaec7-2856-4bcf-b9be-e836e1418852"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-CA1FB2BFE65D36EB300ED832928016C7"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/255458220/journal.pone.0244294.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/179488657/journal.pone.0244294.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1371/journal.pone.0244294","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":