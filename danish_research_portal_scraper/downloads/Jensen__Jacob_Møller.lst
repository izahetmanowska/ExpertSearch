4f28-8211-97afced9d61e","name":"Schmidt, Henrik","rank":20,"rolecode":"pau"},{"affno":"22 23","first":"Hanne B.","key":"ravnpau","last":"Ravn","locid":"3049e7b7-0f18-413b-88ab-a3d77ebc079b","name":"Ravn, Hanne Berg","name_org":"Ravn, Hanne B.","rank":21,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jacob E.","key":"møllerpau","last":"Møller","locid":"5e4d3cb6-b0a0-4541-aea1-30e73f7c10b8","name":"Møller, Jacob Eifer","name_org":"Møller, Jacob E.","orcid":"0000-0003-2873-5845","rank":22,"rolecode":"pau"},{"affno":"24","first":"Daniel","key":"burkhoffpau","last":"Burkhoff","name":"Burkhoff, Daniel","rank":23,"rolecode":"pau"},{"affno":"1","first":"Navin K.","key":"kapurpau","last":"Kapur","name":"Kapur, Navin K.","rank":24,"rolecode":"pau"}],"pmid":["34227396"],"pub":{"doi":"10.1161/jaha.120.020085","issn":["20479980"],"issue":"14","journal":"Journal of the American Heart Association","paperid":"e020085","publisher":"American Heart Association","status":"p","title":"Journal of the American Heart Association","volume":"10"},"review":"Peer Reviewed","scoID":["2-s2.0-85111038945"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-11bd6cd4-4da3-4622-90e6-59b0e856f44a","sdu-6f3829c4-d160-457b-854b-23763ea41865"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Phenotyping cardiogenic shock","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-040288","year":"2021","yearsub":"2021"}
{"abstract":"Bleeding after acute myocardial infarction (AMI) is associated with an increased morbidity and mortality. The frequency and consequences of bleeding events in patients with AMICS are not well described. The objective was to investigate incidence and outcome of bleeding complications among unselected patients with AMI complicated by cardiogenic shock (AMICS) and referred for immediate revascularization. Bleeding events were assessed by review of medical records in consecutive AMICS patients admitted between 2010 and 2017. Bleedings during admission were classified according to Bleeding Academic Research Consortium classification. Patients who did not survive to admission in the intensive care unit were excluded. Of the 1,716 patients admitted with AMICS, 1,532 patients (89%) survived to ICU admission. At 30 days, mortality was 48%. Severe bleedings classified as BARC 3/5 were seen in 87 non-coronary bypass grafting patients (6.1%). Co-morbidity did not differ among patients; however, patients who had a BARC 3/5 bleeding had significantly higher lactate and lower systolic blood pressure at admission, indicating a more severe state of shock. The use of mechanical assist devices was significantly associated with severe bleeding events. Univariable analysis showed that patients with a BARC 3/5 bleeding had a significantly higher 30-day mortality hazard compared with patients without severe bleedings. The association did not sustain after multivariable adjustment (hazard ratio 0.90, 95% confidence interval 0.64; 1.26, p = 0.52). In conclusion, severe bleeding events according to BARC classification in an all-comer population of patients with AMICS were not associated with higher mortality when adjusting for immediate management, hemodynamic, and metabolic state. This indicates that mortality in these patients is primarily related to other factors.","author_count":12,"contributors":["Ratcovich, Hanna","Josiassen, Jakob","Helgestad, Ole K.L.","Linde, Louise","Sadjadieh, Golnaz","Engstrøm, Thomas","Jensen, Lisette O.","Ravn, Hanne Berg","Schmidt, Henrik","Hassager, Christian","Møller, Jacob E.","Holmvang, Lene"],"cuid":["S02-100.00-040462"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corresponding_author":["Ratcovich, Hanna"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"incidence predictors and outcome of in hospital bleeding in patients with cardiogenic shock complicating acute myocardial infarction","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85099390690","version":"Other Version"},"funding_acknowledgement":["Funding: Dr Hanna Ratcovich has received a research grant from the Rigshospitalet and Odense University Hospital Research Foundation. Dr Jacob Eifer Møller has received research grant and speakers fee from Abiomed."],"id":"S02-100.00-040462","identifier":[{"id":"85099390690","type":"scopus"},{"id":"33383003","type":"pmid"}],"ids":["ku-16c57b69-d1ba-4aa8-822e-de72433df08d","sdu-154a7db3-15ff-49a9-a346-36afb7e8214d"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-3DEE32EB7B7F3BB14DC4346FB54C1D99"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"3","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research Unit OPEN (Odense)","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Cardiology (Odense)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Hanna","key":"ratcovichpau","last":"Ratcovich","name":"Ratcovich, Hanna","rank":1,"rolecode":"pau"},{"affno":"2 1","first":"Jakob","key":"josiassenpau","last":"Josiassen","locid":"3bad0c12-b148-41c0-8a21-4ab4911c27e9","name":"Josiassen, Jakob","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Ole K.L.","key":"helgestadpau","last":"Helgestad","locid":"ab9f3165-500c-482b-9c2f-1879b3abedb3","name":"Helgestad, Ole Kristian Lerche","name_org":"Helgestad, Ole K.L.","orcid":"0000-0003-3847-8758","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Louise","key":"lindepau","last":"Linde","locid":"4fc23628-00d4-466a-9e6e-269e23160481","name":"Linde, Louise","orcid":"0000-0002-7757-2571","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Golnaz","key":"sadjadiehpau","last":"Sadjadieh","name":"Sadjadieh, Golnaz","rank":5,"rolecode":"pau"},{"affno":"2","first":"Thomas","key":"engstrømpau","last":"Engstrøm","locid":"77ddb69e-092a-4c53-bbf0-409cdd3d12f7","name":"Engstrøm, Thomas","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Lisette O.","key":"jensenpau","last":"Jensen","locid":"b78c452e-5a69-41fe-ba49-0096c84d1d4d","name":"Jensen, Lisette Okkels","name_org":"Jensen, Lisette O.","orcid":"0000-0002-4838-2429","rank":7,"rolecode":"pau"},{"affno":"2","first":"Hanne B.","key":"ravnpau","last":"Ravn","locid":"3049e7b7-0f18-413b-88ab-a3d77ebc079b","name":"Ravn, Hanne Berg","name_org":"Ravn, Hanne B.","rank":8,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Henrik","key":"schmidtpau","last":"Schmidt","locid":"9789920f-4b31-4f28-8211-97afced9d61e","name":"Schmidt, Henrik","rank":9,"rolecode":"pau"},{"affno":"2","first":"Christian","key":"hassagerpau","last":"Hassager","locid":"49196e5d-0f61-44b2-a6b9-cd6c5f8f3bc2","name":"Hassager, Christian","orcid":"0000-0002-1199-0981","rank":10,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"first":"Jacob E.","key":"møllerpau","last":"Møller","locid":"5e4d3cb6-b0a0-4541-aea1-30e73f7c10b8","name":"Møller, Jacob Eifer","name_org":"Møller, Jacob E.","orcid":"0000-0003-2873-5845","rank":11,"rolecode":"pau"},{"affno":"2","first":"Lene","key":"holmvangpau","last":"Holmvang","locid":"54b8ef01-f8ed-4c49-a126-2109e2fd351f","name":"Holmvang, Lene","rank":12,"rolecode":"pau"}],"pmid":["33383003"],"pub":{"doi":"10.1016/j.amjcard.2020.12.045","issn":["00029149","18791913"],"issn_org":["00029149"],"journal":"American Journal of Cardiology","pages":"13-19","publisher":"Elsevier","status":"p","title":"American Journal of Cardiology","volume":"144"},"review":"Peer Reviewed","scoID":["2-s2.0-85099390690"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-16c57b69-d1ba-4aa8-822e-de72433df08d","sdu-154a7db3-15ff-49a9-a346-36afb7e8214d"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Incidence, Predictors, and Outcome of In-Hospital Bleeding in Patients With Cardiogenic Shock Complicating Acute Myocardial Infarction","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-040462","year":"2021","yearsub":"2021"}
{"abstract":"Background: Acute myocardial infarction complicated by cardiogenic shock (AMICS) with or without out-of-hospital cardiac arrest (OHCA) have some pathophysiological differences and could potentially be considered as two individual clinical entities. Thus, there may also be differences in terms of blood borne biomarkers. Purpose: To explore potential differences in concentrations of the biomarkers lactate, mid-regional proadrenomedullin (MRproADM), Copeptin, pro-atrial natriuretic peptide (proANP), Syndecan-1, soluble thrombomodulin (sTM), soluble suppression of tumorigenicity 2 (sST2) and neutrophil gelatinase-associated lipocalin (NGAL), in patients with AMICS with or without OHCA. Method: Patients admitted for acute coronary angiography due to suspected ST-elevation myocardial infarction were enrolled during a 1-year period. In the present study 86 patients with confirmed AMICS at admission were included. Results: In the adjusted analysis OHCA patients had higher levels of lactate (p = 0.008), NGAL (p = 0.03) and sTM (p = 0.011) while the level of sST2 was lower (p = 0.029). There was little difference in 30-day mortality between the OHCA and non-OHCA groups (OHCA 37% vs. non-OHCA 38%). Conclusion: AMICS patients with or without OHCA had similar 30-day mortality but differed in terms of Lactate, NGAL, sTM and sST2 levels. These findings support that non-OHCA and OHCA patients with CS could be considered as two individual clinical entities.","author_count":8,"contributors":["Thøgersen, Michael","Frydland, Martin","Lerche Helgestad, Ole Kristian","Okkels Jensen, Lisette","Josiassen, Jakob","Goetze, Jens P.","Møller, Jacob Eifer","Hassager, Christian"],"cuid":["S02-100.00-041215"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Thøgersen, Michael"],"keyword":["Acute myocardial infarction","Cardiogenic shock","Cardiovascular disease","Intensive care","Out of hospital cardiac arrest"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-SDR","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"admission biomarkers among patients with acute myocardial infarction related cardiogenic shock with or without out of hospital cardiac arrest an exploratory study","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85112564185","version":"Other Version"},"id":"S02-100.00-041215","identifier":[{"id":"34259098","type":"pmid"},{"id":"85112564185","type":"scopus"}],"ids":["ku-2e8c0221-2003-49ea-b123-cfd4442577e9","sdu-ebec6730-ae0f-4a8e-9fe1-13f39558df73"],"keyword":["Cardiovascular disease","acute myocardial infarction","cardiogenic shock","intensive care","out-of-hospital cardiac arrest"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-58773036E0238285519292FEB0C56CDE"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Cardiology (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"3","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Odense University Hospital"],"nora_code":"DI-HO-SDR","used":1},{"affno":"4","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Michael","key":"thøgersenpau","last":"Thøgersen","name":"Thøgersen, Michael","rank":1,"rolecode":"pau"},{"affno":"1","first":"Martin","key":"frydlandpau","last":"Frydland","name":"Frydland, Martin","rank":2,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Ole Kristian","key":"lerchehelgestadpau","last":"Lerche Helgestad","locid":"ab9f3165-500c-482b-9c2f-1879b3abedb3","name":"Helgestad, Ole Kristian Lerche","name_org":"Lerche Helgestad, Ole Kristian","orcid":"0000-0003-3847-8758","rank":3,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Lisette","key":"okkelsjensenpau","last":"Okkels Jensen","locid":"b78c452e-5a69-41fe-ba49-0096c84d1d4d","name":"Jensen, Lisette Okkels","name_org":"Okkels Jensen, Lisette","orcid":"0000-0002-4838-2429","rank":4,"rolecode":"pau"},{"affno":"4 1","first":"Jakob","key":"josiassenpau","last":"Josiassen","locid":"3bad0c12-b148-41c0-8a21-4ab4911c27e9","name":"Josiassen, Jakob","rank":5,"rolecode":"pau"},{"affno":"4 1","first":"Jens Peter","key":"goetzepau","last":"Goetze","locid":"980bceaf-dbf3-4f7a-a8d7-0a8e81b638b2","name":"Goetze, Jens P.","name_org":"Goetze, Jens Peter","orcid":"0000-0001-6356-3829","rank":6,"rolecode":"pau"},{"affno":"1 2 3","corresponding":null,"first":"Jacob Eifer","key":"møllerpau","last":"Møller","locid":"5e4d3cb6-b0a0-4541-aea1-30e73f7c10b8","name":"Møller, Jacob Eifer","orcid":"0000-0003-2873-5845","rank":7,"rolecode":"pau"},{"affno":"4 1","first":"Christian","key":"hassagerpau","last":"Hassager","locid":"49196e5d-0f61-44b2-a6b9-cd6c5f8f3bc2","name":"Hassager, Christian","orcid":"0000-0002-1199-0981","rank":8,"rolecode":"pau"}],"pmid":["34259098"],"pub":{"doi":"10.1080/1354750x.2021.1955975","issn":["1354750X","13665804"],"issn_org":["1354750X"],"issue":"7","journal":"Biomarkers","pages":"632-638","publisher":"Informa Healthcare","status":"p","title":"Biomarkers","volume":"26"},"review":"Peer Reviewed","scoID":["2-s2.0-85112564185"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-2e8c0221-2003-49ea-b123-cfd4442577e9","sdu-ebec6730-ae0f-4a8e-9fe1-13f39558df73"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Admission biomarkers among patients with acute myocardial-infarction related cardiogenic shock with or without out-of-hospital cardiac arrest an exploratory study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-041215","year":"2021","yearsub":"2021"}
{"abstract":"Aims: The obesity paradox suggests a better prognosis in overweight or obese patients with heart failure and acute myocardial infarction (AMI) than patients with normal weight. Few studies have investigated the association between BMI and mortality in patients with AMI complicated by cardiogenic shock (AMICS). The aim of this study was to evaluate the association between BMI and 30-day mortality in patients with AMICS. Methods and Results: A retrospective study of 1,716 patients with AMICS treated at 2 tertiary centers in south-eastern Denmark between 2010 and 2017. Patients undergoing revascularization and who were admitted to the intensive care unit were included (n = 1,216). BMI was available in 1,017 patients (83.6%). Patients were divided according to the WHO classification as normal weight BMI <24.9 kg/m2 (n = 453), overweight BMI 25-29.9 kg/m2 (n = 391), obese class 1 BMI 30-34.9 kg/m2 (n = 131), and obese class 2 + 3 BMI >35 kg/m2 (n = 42). Differences in baseline characteristics, in-hospital treatment, and the primary outcome of all-cause mortality at 30 days were examined. Obese patients had more comorbidities such as diabetes, hypertension, and dyslipidemia than patients with normal weight. Need for renal replacement therapy was higher among obese patients (normal weight, 19% vs. obese class 2 + 3, 35%, p = 0.02); otherwise, no difference in management was found. No difference in 30-day mortality was observed between groups (normal weight 44%, overweight 38%, obese class 1 41%, and obese class 2 + 3 45% at 30 days; ns). Conclusions: Thirty-day mortality in patients with AMICS was not associated with the BMI category. Thus, evidence of an \"obesity paradox\"was not observed in this contemporary cohort of patients with AMICS in Denmark.","author_count":12,"contributors":["Hermansen, Gustav Fridolf","Junker Udesen, Nanna Louise","Josiassen, Jakob","Lerche Helgestad, Ole Kristian","Møller, Emilie Eifer","Povlsen, Amalie Ling","Ravn, Hanne Berg","Jensen, Lisette Okkels","Holmvang, Lene","Schmidt, Henrik","Hassager, Christian","Møller, Jacob Eifer"],"cuid":["S02-100.00-046943"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corresponding_author":["Møller, Jacob Eifer"],"keyword":["Acute myocardial infarction","Body Mass Index","Cardiogenic shock","Obesity","Overweight"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-SDR","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"association of body mass index with mortality in patients with cardiogenic shock following acute myocardial infarction a contemporary danish cohort analysis","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85111578759","version":"Other Version"},"funding_acknowledgement":["The study has been funded by research grants from the Danish Heart Foundation, Research foundation for Rigshospitalet and Odense University Hospital, and Abiomed."],"id":"S02-100.00-046943","identifier":[{"id":"34284382","type":"pmid"},{"id":"85111578759","type":"scopus"}],"ids":["ku-e5458a09-3826-45aa-b536-1d0c619ef0e4","sdu-ce9fd709-fbe1-4026-ad86-4c93e60f21d2"],"keyword":["Acute myocardial infarction","Body mass index","Cardiogenic shock","Obesity","Overweight"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-A10E9EBA696D4E48060C5E4192EB2F52"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Den