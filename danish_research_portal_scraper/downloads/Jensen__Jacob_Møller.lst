Clinical Research, KI, OUH, Research unit of Cardiology (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"3","country":"nl","key":"academic medical center","loc":["Netherlands","Europe, EU","OECD"],"name":"Academic Medical Center","used":1},{"affno":"4","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Clinical Biochemistry","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Martin","key":"frydlandpau","last":"Frydland","name":"Frydland, Martin","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jacob Eifer","key":"møllerpau","last":"Møller","locid":"5e4d3cb6-b0a0-4541-aea1-30e73f7c10b8","name":"Møller, Jacob Eifer","orcid":"0000-0003-2873-5845","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sebastian","key":"wibergpau","last":"Wiberg","name":"Wiberg, Sebastian","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Matias Greve","key":"lindholmpau","last":"Lindholm","name":"Lindholm, Matias Greve","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Rikke","key":"hansenpau","last":"Hansen","locid":"a932d7ec-000d-4578-b5f6-90bf1c1d9e61","name":"Hansen, Rikke","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jose P S","key":"henriquespau","last":"Henriques","name":"Henriques, Jose P S","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ole Kristian","key":"møllerhelgestadpau","last":"Møller-Helgestad","locid":"ab9f3165-500c-482b-9c2f-1879b3abedb3","name":"Helgestad, Ole Kristian Lerche","name_or