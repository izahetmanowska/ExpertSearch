aergaard","name":"Kjaergaard, Jesper","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Henrik Frederiksen","key":"hoejgaardpau","last":"Hoejgaard","locid":"98c46706-c074-48d3-a62c-d3fb83d08ab2","name":"Højgaard, Henrik Frederiksen","name_org":"Hoejgaard, Henrik Frederiksen","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Henrik","key":"schmidtpau","last":"Schmidt","locid":"9789920f-4b31-4f28-8211-97afced9d61e","name":"Schmidt, Henrik","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Lisette Okkels","key":"jensenpau","last":"Jensen","locid":"b78c452e-5a69-41fe-ba49-0096c84d1d4d","name":"Jensen, Lisette Okkels","orcid":"0000-0002-4838-2429","rank":7,"rolecode":"pau"},{"affno":"1","first":"Lene","key":"holmvangpau","last":"Holmvang","locid":"54b8ef01-f8ed-4c49-a126-2109e2fd351f","name":"Holmvang, Lene","rank":8,"rolecode":"pau"},{"affno":"1","first":"Hanne Berg","key":"ravnpau","last":"Ravn","locid":"3049e7b7-0f18-413b-88ab-a3d77ebc079b","name":"Ravn, Hanne Berg","rank":9,"rolecode":"pau"},{"affno":"1 2","first":"Christian","key":"hassagerpau","last":"Hassager","locid":"49196e5d-0f61-44b2-a6b9-cd6c5f8f3bc2","name":"Hassager, Christian","orcid":"0000-0002-1199-0981","rank":10,"rolecode":"pau"}],"pmid":["33362228"],"pub":{"doi":"10.1371/journal.pone.0244294","issn":["19326203"],"issue":"12","journal":"PLOS ONE","paperid":"e0244294","publisher":"Public Library of Science","status":"p","title":"PLOS ONE","volume":"15"},"review":"Peer Reviewed","scoID":["2-s2.0-85099075119"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-b9f4f55c-86bb-488a-ac1f-9cd18ea5c406","sdu-08fbaec7-2856-4bcf-b9be-e836e1418852"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Hemodynamic and metabolic recovery in acute myocardial infarction-related cardiogenic shock is more rapid among patients presenting with out-of-hospital cardiac arrest","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-088.00-045676","year":"2020","yearsub":"2020"}
{"abstract":"Background: Cardiogenic shock complicating ST-elevation myocardial infarction is characterised by progressive left ventricular dysfunction causing inflammation and neurohormonal activation. Often, cardiogenic shock develops after hospital admission. Whether inflammation and a neurohormonal activation precede development of clinical cardiogenic shock is unknown. Methods and results: In 93% of 2247 consecutive patients with suspected ST-elevation myocardial infarction admitted at two tertiary heart centres, admission plasma levels of pro-atrial natriuretic peptide, copeptin, mid-regional pro-adrenomedullin and stimulation-2 were measured on hospital admission. Patients were stratified according to no cardiogenic shock development and cardiogenic shock developed before (early cardiogenic shock) or after (late cardiogenic shock) leaving the catheterization laboratory. In total, 225 (10%) patients developed cardiogenic shock, amongst these patients late cardiogenic shock occurred in 64 (2.9%). All four biomarkers were independently associated with the development of late cardiogenic shock (odds ratio per two-fold increase in risk: 1.19-3.13) even when adjusted for the recently developed Observatoire Regional Breton sur l'Infarctus risk score for prediction of late cardiogenic shock development. Furthermore, pro-atrial natriuretic peptide, copeptin and mid-regional pro-adrenomedullin, but not stimulation-2, added significant predictive information, when added to the Observatoire Regional Breton sur l'Infarctus risk score (area under the receiver-operating characteristic curve, pro-atrial natriuretic peptide: 0.87, p=0.0008; copeptin: 0.86, p<0.05; mid-regional pro-adrenomedullin: 0.88, p=0.006). Conclusions: Pro-atrial natriuretic peptide, copeptin, mid-regional pro-adrenomedullin and stimulation-2 admission plasma concentration were associated with late cardiogenic shock development in patients admitted with suspected ST-elevation myocardial infarction. Pro-atrial natriuretic peptide, mid-regional pro-adrenomedullin and copeptin had independent predictive value for late cardiogenic shock development.","author_count":18,"contributors":["Frydland, Martin","Moller, Jacob E.","Lindholm, Matias Greve","Hansen, Rikke","Wiberg, Sebastian","Helgestad, Ole Kristian Lerche","Thomsen, Jakob H.","Goetze, Jens P.","Engstrøm, Thomas","Frikke-Schmidt, Ruth","Ravn, Hanne Berg","Holmvang, Lene","Jensen, Lisette O.","Kjaergaard, Jesper","Hassager, Christian"],"cuid":["S02-096.45-041706"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","Nordic","OECD"],"country":["Sweden"],"glorg":["All Global Affiliations","Lund University"],"keyword":["Biomarkers","Cardiogenic shock","Inflammation","ST elevation myocardial infarction","neuroendocrine response"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"biomarkers predictive of late cardiogenic shock development in patients with suspected st elevation myocardial infarction","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85088297874","version":"Other Version"},"id":"S02-096.45-041706","identifier":[{"id":"31961195","type":"pmid"},{"id":"85088297874","type":"scopus"},{"id":"000508775400001","type":"wos"}],"ids":["ku-3d94576a-00de-4d1d-9e1f-bd8a0f402440","sdu-dd3f2fa1-3137-4e30-8f3a-767f19701ccc"],"keyword":["ST-elevation myocardial infarction","biomarkers","cardiogenic shock","inflammation","neuroendocrine response"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-03B5E5D8EA17D33ECF19481550AC9591"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital","Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Cardiology (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"3","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"4","country":"se","key":"lund university","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Lund University","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Martin","key":"frydlandpau","last":"Frydland","name":"Frydland, Martin","rank":1,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Jacob E","key":"møllerpau","last":"Møller","locid":"5e4d3cb6-b0a0-4541-aea1-30e73f7c10b8","name":"Møller, Jacob Eifer","name_org":"Møller, Jacob E","orcid":"0000-0003-2873-5845","rank":2,"rolecode":"pau"},{"affno":"","first":"Jacob E.","key":"mollerpau","last":"Moller","name":"Moller, Jacob E.","rank":2,"rolecode":"pau"},{"affno":"3 1","first":"Matias G.","key":"lindholmpau","last":"Lindholm","locid":"4333dd58-10c3-4fea-aadb-048bdc7c