"},{"affno":"1","corresponding":null,"first":"Peter H.","key":"frederiksenpau","last":"Frederiksen","locid":"85d6facd-93bf-44ee-a117-269fb26a52be","name":"Frederiksen, Peter H.","orcid":"0000-0003-3712-7980","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lars","key":"videbækpau","last":"Videbæk","locid":"c0abdf18-4e26-411a-99c3-de3cbe029dee","name":"Videbæk, Lars","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mikael Kjær","key":"poulsenpau","last":"Poulsen","locid":"a8da3614-e99d-403f-933f-f5dfab3976af","name":"Poulsen, Mikael Kjær","orcid":"0000-0003-4051-7197","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jan Christian","key":"brøndpau","last":"Brønd","locid":"da4ecea2-2b7f-4027-9859-416024dca432","name":"Brønd, Jan Christian","orcid":"0000-0001-6718-3022","rank":6,"rolecode":"pau"},{"affno":"2","first":"Finn","key":"gustafssonpau","last":"Gustafsson","locid":"6716eef1-891b-4209-a823-e96e765b9433","name":"Gustafsson, Finn","rank":7,"rolecode":"pau"},{"affno":"3 4","first":"Barry A.","key":"borlaugpau","last":"Borlaug","name":"Borlaug, Barry A.","rank":8,"rolecode":"pau"},{"affno":"2","first":"Morten","key":"schoupau","last":"Schou","locid":"48fa6ec9-1941-4566-b931-14b0cc8cbae3","name":"Schou, Morten","rank":9,"rolecode":"pau"},{"affno":"1 5","corresponding":null,"first":"Jacob Eifer","key":"møllerpau","last":"Møller","locid":"5e4d3cb6-b0a0-4541-aea1-30e73f7c10b8","name":"Møller, Jacob Eifer","orcid":"0000-0003-2873-5845","rank":10,"rolecode":"pau"}],"pmid":["34509409"],"pub":{"doi":"10.1016/j.jchf.2021.05.013","issn":["22131779","22131787"],"issn_org":["22131779"],"issue":"11","journal":"JACC: Heart Failure","pages":"824-835","publisher":"Elsevier","status":"p","title":"JACC: Heart Failure","volume":"9"},"review":"Peer Reviewed","scoID":["2-s2.0-85117161453"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-ef6c2fec-6df6-48cc-b19a-be7785b460a4","sdu-7707546f-2b06-4150-879c-19444dcf3f1c"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Hemodynamic Determinants of Activity Measured by Accelerometer in Patients With Stable Heart Failure","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-092.16-047247","year":"2021","yearsub":"2021"}
{"abstract":"Aims The objective was to describe patient characteristics, interventions, and outcome in acute myocardial infarction complicated by cardiogenic shock (AMICS), due to predominantly right ventricular (RV) failure after revascularization, in comparison with patients suffering from left ventricular (LV) failure as these patients remain sparsely characterized. Methods and results From 2010 to 2017, consecutive AMICS patients admitted to either of two tertiary heart centres, covering 3.9 million citizens, corresponding to two-thirds of the Danish population, were identified and individually reviewed through patient records. A total of 1716 AMICS patients were identified, of which 1482 underwent acute revascularization and included for analysis. Hereof, 101 (7%) patients developed cardiogenic shock due to predominantly RV failure, while 1381 (93%) had significant LV involvement. Female sex was the only demographic factor associated with RV failure (35% vs. 25%, P = 0.01). Despite having a preserved LV ejection fraction, patients with predominantly RV failure were comparable to patients with LV involvement, in terms of haemodynamic and metabolic profile, here among variables commonly used in the cardiogenic shock definition including blood pressure ( 82 mmHg vs. 83 mmHg, P = 0.90) and lactate level (5.7 mmol/L vs. 5.4 mmol/L, P = 0.70). Patients with RV AMICS had significantly lower 30-day mortality than LV AMICS, and this result persisted after multivariable adjustment (RV vs. LV; hazard ratio 0.61, 95% confidence interval 0.41-0.92, P = 0.01). Conclusion In contemporary AMICS patients undergoing revascularization, patients with predominantly RV failure had comparable haemodynamics and metabolic derangement on admission compared to patients with LV failure but was associated with female sex and a significantly lower 30-day mortality.","author_count":8,"contributors":["Josiassen, Jakob","Helgestad, Ole Kristian L.","Møller, Jacob E.","Schmidt, Henrik","Jensen, Lisette O","Holmvang, Lene","Ravn, Hanne Berg","Hassager, Christian"],"cuid":["S02-099.94-046407"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Josiassen, Jakob"],"keyword":["Acute heart failure","Acute myocardial infarction","Cardiogenic shock","Right ventricular failure"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-SDR","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"cardiogenic shock due to predominantly right ventricular failure complicating acute myocardial infarction","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1093/ehjacc/zuaa010","version":"Published Version"},"id":"S02-099.94-046407","identifier":[{"id":"000637043000006","type":"wos"},{"id":"85105521220","type":"scopus"},{"id":"33620420","type":"pmid"}],"ids":["ku-d19fa67e-ee2c-4c91-829f-5eaa6f4e6500","sdu-c207ecc7-55c8-4183-897f-c7d818bf4332"],"keyword":["Acute heart failure","Acute myocardial infarction","Cardiogenic shock","Right ventricular failure"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-C22AB320490C6A5F248F1D9AC22D3C88"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/302816829/zuaa010.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1093/ehjacc/zuaa010","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/200069946/zuaa010.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},