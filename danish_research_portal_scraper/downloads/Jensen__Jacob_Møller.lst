k":27,"rolecode":"pau"},{"affno":"2","first":"Jesper","key":"kjaergaardjesperpau","last":"Kjaergaard","locid":"10ffadd9-ed9c-4251-954a-a2c12ce83aca","name":"Kjaergaard, Jesper","rank":28,"rolecode":"pau"},{"affno":"2","first":"Kirsten","key":"møllerkirstenpau","last":"Møller","locid":"0781d3e6-9d76-4ba7-8a17-5a4d81e6ab87","name":"Møller, Kirsten","orcid":"0000-0003-3058-1072","rank":29,"rolecode":"pau"},{"affno":"2","first":"Daniel","key":"kondzielladanielpau","last":"Kondziella","locid":"419f5316-712d-4e8a-bc24-a3b548df5069","name":"Kondziella, Daniel","rank":30,"rolecode":"pau"}],"pmid":["36097353"],"pub":{"doi":"10.1093/brain/awac335","issn":["00068950","14602156"],"issn_org":["00068950"],"issue":"1","journal":"Brain","pages":"50-64","status":"p","title":"Brain","volume":"146"},"review":"Peer Reviewed","scoID":["2-s2.0-85153505161"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-c6d99c75-9d93-4ce4-b2ab-e850b4edf529"],"src":["KU University of Copenhagen"],"title":"Multimodal prediction of residual consciousness in the intensive care unit : the CONNECT-ME study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-702291","year":"2023","yearsub":"2023"}
{"abstract":"AIMS: Cardiogenic shock (CS) is known to induce an inflammatory response. The prognostic utility of this remains unclear. To investigate the association between C-reactive protein (CRP) levels and leucocyte count and mortality in patients with acute myocardial infarction complicated by CS (AMICS). METHODS AND RESULTS: Consecutive patients (N = 1716) admitted between 2010 and 2017 with an individually validated diagnosis of AMICS were included. The analysis was restricted to patients alive at 48 h after first medical contact and a valid CRP and leucocyte measurement at 48 ± 12 h from the first medical contact. A combined inflammatory score for each patient was computed by summing the CRP and leucocyte count z-scores to normalize the response on a standard deviation scale. Associations with mortality were analysed using a multivariable Cox proportional hazards model stratified by inflammatory response quartiles: Of the 1716 patients in the cohort, 1111 (64.7%) fulfilled inclusion criteria. The median CRP level at 48 h was 145 mg/dL [interquartile range (IQR) 96-211]. The median leucocyte count was 12.6 × 10-9/L (IQR 10.1-16.4). Patients with the highest inflammatory response (Q4) had lower median left ventricular ejection fractions and higher lactate levels at the time of diagnosis. The 30-day all-cause mortality rates were 46% in Q4 and 21% in Q1 (P < 0.001). In multivariable models, the inflammatory response remained associated with mortality [hazard ratio (HR)Q4 2.32, 95% confidence interval (CI) 1.59-3.39, P < 0.001]. The finding was also significant in AMICS patients presenting with out-of-hospital cardiac arrest following multivariable adjustment (HRQ4 3.37, 95% CI 2.02-4.64, P < 0.001). CONCLUSION: Cardiogenic shock induces an acute inflammatory response, the severity of which is associated with mortality.","author_count":11,"contributors":["Kunkel, Joakim Bo","Josiassen, Jakob","Helgestad, Ole Kristian Lerche","Schmidt, Henrik","Holmvang, Lene","Jensen, Lisette Okkels","Thøgersen, Michael","Fosbøl, Emil","Ravn, Hanne Berg","Møller, Jacob Eifer","Hassager, Christian"],"cuid":["S02-099.94-686213"],"filters":{"added":"2023-07","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corresponding_author":["Kunkel, Joakim Bo"],"keyword":["Acute myocardial infarction","Biomarkers","Cardiogenic shock","Hospital Mortality","Hospitalization","Humans","Inflammation","Myocardial Infarction diagnosis","Prognosis","Shock Cardiogenic"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-SDR","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"inflammatory response by 000000000048 h after admission and mortality in patients with acute myocardial infarction complicated by cardiogenic shock","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85164554648","version":"Other Version"},"id":"S02-099.94-686213","identifier":[{"id":"36857166","type":"pmid"},{"id":"85164554648","type":"scopus"}],"ids":["ku-1e09e9ae-f119-4c90-a4d3-9414bfacd9a2","sdu-88fd330e-652f-4f97-a3a0-9e656fd483f8"],"keyword":["Acute myocardial infarction","Biomarkers","Cardiogenic shock","Hospital Mortality","Hospitalization","Humans","Inflammation","Myocardial Infarction/diagnosis","Prognosis","Shock, Cardiogenic"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-FAC624CBF74CB5B7EC30F6B52115CBCF"],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"3","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Cardiology (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"4","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Odense University Hospital"],"nora_code":"DI-HO-SDR","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Joakim Bo","key":"kunkelpau","last":"Kunkel","name":"Kunkel, Joakim Bo","rank":1,"rolecode":"pau"},{"affno":"1 2","first":"Jakob","key":"josiassenpau","last":"Josiassen","locid":"3bad0c12-b148-41c0-8a21-4ab4911c27e9","name":"Josiassen, Jakob","rank":2,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Ole Kristian Lerche","key":"helgestadpau","last":"Helgestad","locid":"ab9f3165-500c-482b-9c2f-1879b3abedb3","name":"Helgestad, Ole Kristian Lerche","orcid":"0000-0003-3847-8758","rank":3,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Henrik","key":"schmidtpau","last":"Schmidt","locid":"9789920f-4b31-4f28-8211-97afced9d61e","name":"Schmidt, Henrik","rank":4,"rolecode":"pau"},{"affno":"1 2","first":"Lene","key":"holmvangpau","last":"Holmvang","locid":"54b8ef01-f8ed-4c49-a126-2109e2fd351f","name":"Holmvang, Lene","rank":5,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Lisette Okkels","key":"jensenpau","last":"Jensen","locid":"b78c452e-5a69-41fe-ba49-0096c84d1d4d","name":"Jensen, Lisette Okkels","orcid":"0000-0002-4838-2429","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Michael","key":"thøgersenpau","last":"Thøgersen","name":"Thøgersen, Michael","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Emil","key":"fosbølpau","last":"Fosbøl","name":"Fosbøl, Emil","rank":8,"rolecode":"pau"},{"affno":"3 4 2","corresponding":null,"first":"Hanne Berg","key":"ravnpau","last":"Ravn","locid":"25de7650-3dc1-4594-b758-9c36f6de6306","name":"Ravn, Hanne Berg","orcid":"0000-0003-4702-5195","rank":9,"rolecode":"pau"},{"affno":"3 1 4","corresponding":null,"first":"Jacob Eifer","key":"møllerpau","last":"Møller","locid":"5e4d3cb6-b0a0-4541-aea1-30e73f7c10b8","name":"Møller, Jacob Eifer","orcid":"0000-0003-2873-5845","rank":10,"rolecode":"pau"},{"affno":"1 2","first":"Christian","key":"hassagerpau","last":"Hassager","locid":"49196e5d-0f61-44b2-a6b9-cd6c5f8f3bc2","name":"Hassager, Christian","orcid":"0000-0002-1199-0981","rank":11,"rolecode":"pau"}],"pmid":["36857166"],"pub":{"doi":"10.1093/ehjacc/zuad018","issn":["20488726","20488734"],"issn_org":["20488734"],"issue":"5","journal":"European Heart Journal: Acute Cardiovascular Care","pages":"306-314","publisher":"Oxford University Press","status":"p","title":"European Heart Journal: Acute Cardiovascular Care","title_org":"European Heart Journal - Acute Cardiovascular Care","volume":"12"},"review":"Peer Reviewed","scoID":["2-s2.0-85164554648"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-1e09e9ae-f119-4c90-a4d3-9414bfacd9a2","sdu-88fd330e-652f-4f97-a3a0-9e656fd483f8"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Inflammatory response by 48 h after admission and mortality in patients with acute myocardial infarction complicated by cardiogenic shock","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.94-686213","year":"2023","yearsub":"2023"}
{"abstract":"BACKGROUND: Guidelines recommend active fever prevention for 72 hours after cardiac arrest. Data from randomized clinical trials of this intervention have been lacking. METHODS: We randomly assigned comatose patients who had been resuscitated after an out-of-hospital cardiac arrest of presumed cardiac cause to device-based temperature control targeting 36°C for 24 hours followed by targeting of 37°C for either 12 or 48 hours (for total intervention times of 36 and 72 hours, respectively) or until the patient regained consciousness. The primary outcome was a composite of death from any cause or hospital discharge with a Cerebral Performance Category of 3 or 4 (range, 1 to 5, with higher scores indicating more severe disability; a category of 3 or 4 indicates severe cerebral disability or coma) within 90 days after randomization. Secondary outcomes included death from any cause and the Montreal Cognitive Assessment score (range, 0 to 30, with higher scores indicating better cognitive ability) at 3 months. RESULTS: A total of 393 patients were randomly assigned to temperature control for 36 hours, and 396 patients were assigned to temperature control for 72 hours. At 90 days after randomization, a primary end-point event had occurred in 127 of 393 patients (32.3%) in the 36-hour group and in 133 of 396 patients (33.6%) in the 72-hour group (hazard ratio, 0.99; 95% confidence interval, 0.77 to 1.26; P = 0.70) and mortality was 29.5% in the 36-hour group and 30.3% in the 72-hour group. At 3 months, the median Montreal Cognitive Assessment score was 26 (interquartile range, 24 to 29) and 27 (interquartile range, 24 to 28), respectively. There was no significant between-group difference in the incidence of adverse events. CONCLUSIONS: Active device-based fever prevention for 36 or 72 hours after cardiac arrest did not result in significantly different percentages of patients dying or having severe disability or coma. (Funded by the Novo Nordisk Foundation; BOX ClinicalTrials.gov number, NCT03141099.).","author_count":29,"contributors":["Hassager, Christian","Schmidt, Henrik","Møller, Jacob Eifer","Grand, Johannes","Mølstrøm, Simon","Beske, Rasmus P","Boesgaard, Søren","Borregaard, Britt","Bekker-Jensen, Ditte","Dahl, Jordi Sanchez","Frydland, Martin S","Høfsten, Dan E","Isse, Yusuf A","Josiassen, Jakob","Lind Jørgensen, Vibeke R","Kondziella, Daniel","Lindholm, Matias G","Moser, Emil","Nyholm, Benjamin C","Obling, Laust E R","Sarkisian, Laura","Søndergaard, Frederik T","Thomsen, Jakob H","Thune, Jens J","Venø, Søren","Wiberg, Sebastian C","Winther-Jensen, Matilde","Meyer, Martin A S","Kjaergaard, Jesper"],"cuid":["S02-099.94-686241"],"filters":{"added":"2023-05","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corresponding_author":["Hassager, Christian"],"keyword":["Body Temperature","Cardiac arrest","Cardiology","Cardiology General","Cardiopulmonary resuscitation","Clinical Medicine","Clinical Medicine General","Coma etiology","Consciousness","Critical care","Emergency Medicine General","Emergency medicine","Fever etiology","Hospital Based Clinical Medicine","Humans","Hypothermia Induced adverse effects","Neurology Neurosurgery","Neurology Neurosurgery General","Out of Hospital Cardiac Arrest complications","Pulmonary Critical Care","Pulmonary Critical Care General","Treatment Outcome"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-SDR","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"duration of device based fever prevention after cardiac arrest","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/225458861/Duration_of_Device_Based_Fever_Preventio