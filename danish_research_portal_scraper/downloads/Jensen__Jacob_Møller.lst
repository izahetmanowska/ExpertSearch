enadamespepau","last":"Hansen","locid":"b36de088-99f8-4b75-bef2-96150f50a6e7","name":"Hansen, Adam Espe","orcid":"0000-0002-6457-1537","rank":10,"rolecode":"pau"},{"affno":"4","first":"Christian","key":"hassagerchristianpau","last":"Hassager","locid":"49196e5d-0f61-44b2-a6b9-cd6c5f8f3bc2","name":"Hassager, Christian","orcid":"0000-0002-1199-0981","rank":11,"rolecode":"pau"},{"affno":"1","first":"Joan Lilja S.","key":"højgaardjoanliljaspau","last":"Højgaard","name":"Højgaard, Joan Lilja S.","rank":12,"rolecode":"pau"},{"affno":"1","first":"Helene Ravnholt","key":"jensenheleneravnholtpau","last":"Jensen","name":"Jensen, Helene Ravnholt","rank":13,"rolecode":"pau"},{"affno":"1","first":"Niels Vendelbo","key":"knudsennielsvendelbopau","last":"Knudsen","name":"Knudsen, Niels Vendelbo","rank":14,"rolecode":"pau"},{"affno":"1","first":"Emilie Lund","key":"laursenemilielundpau","last":"Laursen","name":"Laursen, Emilie Lund","rank":15,"rolecode":"pau"},{"affno":"1","first":"Jacob E.","key":"møllerjacobepau","last":"Møller","name":"Møller, Jacob E.","rank":16,"rolecode":"pau"},{"affno":"1","first":"Vardan","key":"nersesjanvardanpau","last":"Nersesjan","name":"Nersesjan, Vardan","rank":17,"rolecode":"pau"},{"affno":"1","first":"Miki","key":"nicolicmikipau","last":"Nicolic","name":"Nicolic, Miki","rank":18,"rolecode":"pau"},{"affno":"1","first":"Sigurdur Thor","key":"sigurdssonsigurdurthorpau","last":"Sigurdsson","name":"Sigurdsson, Sigurdur Thor","rank":19,"rolecode":"pau"},{"affno":"5","first":"Jacobo D.","key":"sittjacobodpau","last":"Sitt","name":"Sitt, Jacobo D.","rank":20,"rolecode":"pau"},{"affno":"1","first":"Christine","key":"søllingchristinepau","last":"Sølling","name":"Sølling, Christine","rank":21,"rolecode":"pau"},{"affno":"1","first":"Karen Lise","key":"wellingkarenlisepau","last":"Welling","name":"Welling, Karen Lise","rank":22,"rolecode":"pau"},{"affno":"1","first":"Lisette M.","key":"willumsenlisettempau","last":"Willumsen","name":"Willumsen, Lisette M.","rank":23,"rolecode":"pau"},{"affno":"1","first":"John","key":"hauerbergjohnpau","last":"Hauerberg","name":"Hauerberg, John","rank":24,"rolecode":"pau"},{"affno":"1","first":"Vibeke Andrée","key":"larsenvibekeandréepau","last":"Larsen","name":"Larsen, Vibeke Andrée","rank":25,"rolecode":"pau"},{"affno":"4","first":"Martin Ejler","key":"fabriciusmartinpau","last":"Fabricius","locid":"d8502d06-4e46-4356-8f2d-85bf96292d7e","name":"Fabricius, Martin","name_org":"Fabricius, Martin Ejler","rank":26,"rolecode":"pau"},{"affno":"4","first":"Gitte Moos","key":"knudsengittemoospau","last":"Knudsen","locid":"f02aee9e-69cf-491a-9765-ff062f734db8","name":"Knudsen, Gitte Moos","orcid":"0000-0003-1508-6866","rank":27,"rolecode":"pau"},{"affno":"1","first":"Jesper","key":"kjærgaardjesperpau","last":"Kjærgaard","name":"Kjærgaard, Jesper","rank":28,"rolecode":"pau"},{"affno":"4","first":"Kirsten","key":"møllerkirstenpau","last":"Møller","locid":"0781d3e6-9d76-4ba7-8a17-5a4d81e6ab87","name":"Møller, Kirsten","orcid":"0000-0003-3058-1072","rank":29,"rolecode":"pau"},{"affno":"4","first":"Daniel","key":"kondzielladanielpau","last":"Kondziella","locid":"419f5316-712d-4e8a-bc24-a3b548df5069","name":"Kondziella, Daniel","rank":30,"rolecode":"pau"}],"pmid":["37697124"],"pub":{"doi":"10.1007/s12028-023-01816-z","issn":["15416933","15560961"],"issn_org":["15416933"],"journal":"Neurocritical Care","pages":"718-733","status":"p","title":"Neurocritical Care","volume":"40"},"review":"Peer Reviewed","scoID":["2-s2.0-85170360067"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-d5439bec-3774-4da5-898d-3b046a3328f6"],"src":["KU University of Copenhagen"],"title":"Multimodal Prediction of 3- and 12-Month Outcomes in ICU Patients with Acute Disorders of Consciousness","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-732509","year":"2024","yearsub":"2024"}
{"abstract":"INTRODUCTION: Sodium-glucose cotransporter 2 (SGLT2) inhibitors have previously demonstrated cardioprotective properties in patients with type 2 diabetes, suggesting a preventive effect on heart failure (HF). The Empire Prevent trial program investigates the therapeutic potential for HF prevention by evaluating the cardiac, metabolic, and renal effects of the SGLT2 inhibitor empagliflozin in patients with increased risk of developing HF, but without diabetes or established HF. METHODS: The Empire Prevent trial program is an investigator-initiated, double-blind, randomized clinical trial program including elderly and obese patients (60-84 years, body mass index >28 kg/m2) with at least one manifestation of hypertension, cardiovascular or chronic kidney disease, but no history of diabetes or HF. The aims are to investigate the effects of empagliflozin on 1) physical capacity and left ventricular and atrial structural changes with peak oxygen consumption and left ventricular mass as primary endpoints (Empire Prevent Cardiac), and 2) cardiac-adipose tissue interaction and volume homeostasis with primary endpoints of changes in epicardial adipose tissue and estimated extracellular volume (Empire Prevent Metabolic). At present, 138 of 204 patients have been randomized in the Empire Prevent trial program. Patients are randomized 1:1 to 180 days treatment with empagliflozin 10 mg daily or placebo, while undergoing a comprehensive examination program at baseline and follow-up. DISCUSSION: The Empire Prevent trial program will mark the first step towards elucidating the potential of SGLT2 inhibition for HF prevention in an outpatient setting in elderly and obese patients with increased risk of developing HF, but with no history of diabetes or established HF. Furthermore, the Empire Prevent trial program will supplement the larger event-driven trials by providing mechanistic insights to the beneficial effects of SGLT2 inhibition. TRIAL REGISTRATION: Both parts of the trial program have been registered on September 13th 2021 (Clinical Trial Registration numbers: NCT05084235 and NCT05042973) before enrollment of the first patient. All patients will provide oral and written informed consent. The trial is approved by The Regional Committee on Health Research Ethics and the Danish Medicines Agency. Data will be disseminated through scientific meetings and peer-reviewed journals irrespective of outcome.","author_count":18,"contributors":["Andersen, Camilla Fuchs","Larsen, Julie Hempel","Jensen, Jesper","Omar, Massar","Nouhravesh, Nina","Kistorp, Caroline","Tuxen, Christian","Gustafsson, Finn","Knop, Filip K.","Forman, Julie Lyng","Davidovski, Filip Soeskov","Jensen, Lars Thorbjørn","Højlund, Kurt","Køber, Lars","Antonsen, Lisbeth","Poulsen, Mikael Kjær","Schou, Morten","Møller, Jacob Eifer"],"cuid":["S02-100.00-725286"],"filters":{"added":"2024-05","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corresponding_author":["Andersen, Camilla Fuchs"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-SDR"],"OT":["Steno Diabetes Centre, Gentofte, Denmark."],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-SDR","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"empagliflozin to elderly and obese patients with increased risk of developing heart failure study protocol for the empire prevent trial program","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.ahj.2024.02.005","version":"Published Version"},"id":"S02-100.00-725286","identifier":[{"id":"85188007738","type":"scopus"},{"id":"38365073","type":"pmid"}],"ids":["ku-f3960168-6395-4d7a-bdf4-55426a3c97a7","sdu-2e86eeb4-0fe5-49b0-9bfa-04c922d10dab"],"lang":"English