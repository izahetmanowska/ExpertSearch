"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Department of Cardiological Medicine B"],"nora_code":"DI-U-AU","used":1},{"affno":"6","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Ann","key":"bankepau","last":"Banke","locid":"0d350637-c6ce-4cf8-82ba-e965da703690","name":"Banke, Ann","orcid":"0000-0002-1036-580X","rank":1,"rolecode":"pau"},{"affno":"2","first":"Emil L.","key":"fosbølpau","last":"Fosbøl","name":"Fosbøl, Emil L.","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jacob E.","key":"møllerpau","last":"Møller","locid":"5e4d3cb6-b0a0-4541-aea1-30e73f7c10b8","name":"Møller, Jacob Eifer","name_org":"Møller, Jacob E.","orcid":"0000-0003-2873-5845","rank":3,"rolecode":"pau"},{"affno":"3 2 4","first":"Gunnar H.","key":"gislasonpau","last":"Gislason","locid":"c0f678a6-eb13-49a3-9485-8fae1e72e2a1","name":"Gislason, Gunnar","name_org":"Gislason, Gunnar H.","rank":4,"rolecode":"pau"},{"affno":"5 6","corresponding":null,"country":"dk","first":"Mads","key":"andersenpau","last":"Andersen","locid":"19d72cda-3d6c-4f48-9d4b-6fe5dee888ba","name":"Andersen, Mads Jønsson","name_org":"Andersen, Mads","orcid":"0000-0002-9320-8227","rank":5,"rolecode":"pau"},{"affno":"2","first":"Mogens","key":"bernsdorfpau","last":"Bernsdorf","name":"Bernsdorf, Mogens","rank":6,"rolecode":"pau"},{"affno":"2","first":"Maj Britt","key":"jensenpau","last":"Jensen","name":"Jensen, Maj Britt","rank":7,"rolecode":"pau"},{"affno":"3 2","first":"Morten","key":"schoupau","last":"Schou","locid":"48fa6ec9-1941-4566-b931-14b0cc8cbae3","name":"Schou, Morten","rank":8,"rolecode":"pau"},{"affno":"2 3","first":"Bent","key":"ejlertsenpau","last":"Ejlertsen","locid":"ce56d151-8290-475e-ba9b-f24dd31507ac","name":"Ejlertsen, Bent","rank":9,"rolecode":"pau"}],"pmid":["29493047"],"pub":{"doi":"10.1002/ejhf.1168","issn":["13889842","18790844"],"issn_org":["13889842"],"issue":"10","journal":"European Journal of Heart Failure","pages":"1447-1453","publisher":"John Wiley and Sons Ltd","status":"p","title":"European Journal of Heart Failure","volume":"20"},"review":"Peer Reviewed","scoID":["2-s2.0-85042594109"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Non-Profit Organisations","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-NP","DI-NP-ALL","DI-U","DI-U-ALL","Hospitals","Non-Profit Organisations","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-eec1f191-86bf-42dd-b567-a66c52b517df","ku-601339d5-7642-4c27-9861-6228c9b9361a","sdu-c9dee511-62e0-4f6a-8184-015761f100a1"],"src":["AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Long-term effect of epirubicin on incidence of heart failure in women with breast cancer : Insight from a randomized clinical trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-099.86-029966","year":"2018","yearsub":"2018"}
{"abstract":"RATIONALE: Short-term mechanical circulatory support is increasingly used in the management of cardiogenic shock, but data from controlled studies are sparse. Thus, real-life data on complication rates and predictors of adverse outcome are important. OBJECTIVE: The objective of this study was to analyse the experience with Impella devices in the management of profound cardiogenic shock. METHODS AND RESULTS: A retrospective study of 109 consecutive patients with severe shock after myocardial infarction, acute heart failure, or cardiac surgery. Possible device-related complications were registered and predictors of death while on Impella support and within 180 days were identified. In 79 patients (72%) cardiogenic shock was caused by myocardial infarction, acute heart failure in 16 (15%) and post-cardiotomy shock in 14 patients (13%). Thirty-five patients (32%) were comatose after cardiac arrest and in seven, the Impella was placed during chest compression. Mean age was 62±12 years, mean arterial pressure was 57±13 mmHg, pH 7.19±0.17 and lactate 7.5±5.7 mmol/l (range 1.8-30.0 mmol/l) at placement. During Impella therapy, 26 patients (28%) died among patients with myocardial infarction or acute heart failure. Of data available prior to placement lactate (hazard ratio 1.14, 95% confidence interval 1.04-1.25, P=0.004) was the only predictor of death on support. During support, five patients (5%) developed leg ischaemia requiring intervention. Bleeding from the Impella insertion site was seen in 14 patients (13%). CONCLUSION: Impella treatment is feasible in profound cardiogenic shock at an acceptable rate of complications. Despite an aggressive approach to restore cardiac output, mortality was high. Besides the severity of lactic acidosis there were no strong predictors of early death.","author_count":10,"contributors":["Jensen, Peter Blom","Høegholm Kann, Sigrun","Veien, Karsten Tange","Helgestad, Ole Kristian Lerche","Dahl, Jordi Sanchez","Rud, Charlotte Svejstrup","Jensen, Marianne Kjær","Jensen, Lisette Okkels","Schmidt, Henrik","Møller, Jacob Eifer"],"cuid":["S01-000.00-629014"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Cardiac Surgical Procedures methods","Cardiogenic shock","Denmark epidemiology","Female","Follow Up Studies","Heart Assist Devices","Humans","Journal Article","Left ventricular assist device","Male","Middle Aged","Myocardial Infarction complications","Retrospective Studies","Shock Cardiogenic etiology","Survival Rate trends","Treatment Outcome"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-SDR","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"single centre experience with the impella cp 000000000005 000000000000 and rp in 000000000109 consecutive patients with profound cardiogenic shock","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85051011196","version":"Other Version"},"id":"S01-000.00-629014","identifier":[{"id":"29148290","type":"pmid"},{"id":"85051011196","type":"scopus"}],"ids":["sdu-c2d2d25f-8fd9-442a-bbff-e98993dfcbe3"],"keyword":["Cardiac Surgical Procedures/methods","Cardiogenic shock","Denmark/epidemiology","Female","Follow-Up Studies","Heart-Assist Devices","Humans","Journal Article","Male","Middle Aged","Myocardial Infarction/complications","Retrospective Studies","Shock, Cardiogenic/etiology","Survival Rate/trends","Treatment Outcome","left ventricular assist device"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-21166ADA3A58581C7F49DBC507D0B26A"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"sdu university of southern denma