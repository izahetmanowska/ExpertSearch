0c12-b148-41c0-8a21-4ab4911c27e9","name":"Josiassen, Jakob","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ole Kristian","key":"helgestadolekristianlerchepau","last":"Lerche Helgestad","locid":"ab9f3165-500c-482b-9c2f-1879b3abedb3","name":"Helgestad, Ole Kristian Lerche","name_org":"Lerche Helgestad, Ole Kristian","orcid":"0000-0003-3847-8758","rank":4,"rolecode":"pau"},{"affno":"4","first":"Emilie Eifer","key":"mølleremilieeiferpau","last":"Møller","name":"Møller, Emilie Eifer","rank":5,"rolecode":"pau"},{"affno":"4","first":"Amalie Ling","key":"povlsenamalielingpau","last":"Povlsen","name":"Povlsen, Amalie Ling","rank":6,"rolecode":"pau"},{"affno":"3","first":"Hanne Berg","key":"ravnhannebergpau","last":"Ravn","locid":"3049e7b7-0f18-413b-88ab-a3d77ebc079b","name":"Ravn, Hanne Berg","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lisette Okkels","key":"jensenlisetteokkelspau","last":"Jensen","locid":"b78c452e-5a69-41fe-ba49-0096c84d1d4d","name":"Jensen, Lisette Okkels","orcid":"0000-0002-4838-2429","rank":8,"rolecode":"pau"},{"affno":"3","first":"Lene","key":"holmvanglenepau","last":"Holmvang","locid":"54b8ef01-f8ed-4c49-a126-2109e2fd351f","name":"Holmvang, Lene","rank":9,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Henrik","key":"schmidthenrikpau","last":"Schmidt","locid":"9789920f-4b31-4f28-8211-97afced9d61e","name":"Schmidt, Henrik","rank":10,"rolecode":"pau"},{"affno":"3","first":"Christian","key":"hassagerchristianpau","last":"Hassager","locid":"49196e5d-0f61-44b2-a6b9-cd6c5f8f3bc2","name":"Hassager, Christian","orcid":"0000-0002-1199-0981","rank":11,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Jacob Eifer","key":"møllerjacobeiferpau","last":"Møller","locid":"5e4d3cb6-b0a0-4541-aea1-30e73f7c10b8","name":"Møller, Jacob Eifer","orcid":"0000-0003-2873-5845","rank":12,"rolecode":"pau"}],"pmid":["34284382"],"pub":{"doi":"10.1159/000515063","issn":["00086312","14219751"],"issn_org":["00086312"],"issue":"5","journal":"Cardiology","pages":"575-582","publisher":"S. Karger AG","status":"p","title":"Cardiology","volume":"146"},"review":"Peer Reviewed","scoID":["2-s2.0-85111578759"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-e5458a09-3826-45aa-b536-1d0c619ef0e4","sdu-ce9fd709-fbe1-4026-ad86-4c93e60f21d2"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Association of Body Mass Index with Mortality in Patients with Cardiogenic Shock following Acute Myocardial Infarction : A Contemporary Danish Cohort Analysis","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-046943","year":"2021","yearsub":"2021"}
{"abstract":"Accurate derivatives are important for locally traversing and converging efficiently in quantum optimization landscapes. By deriving analytically exact control derivatives (gradient and Hessian) for unitary control tasks, we show here that the computational feasibility of meeting this accuracy requirement depends on the choice of propagation scheme and problem representation. Even when exact propagation is sufficiently cheap it is, perhaps surprisingly, much more efficient to optimize the (appropriately) approximate propagators: Approximations in the dynamics are traded off for significant complexity reductions in the exact derivative calculations. Importantly, past the initial analytical considerations, only standard numerical techniques are explicitly required with straightforward application to realistic systems. These results are numerically verified for two concrete problems of increasing Hilbert space dimensionality. The best schemes obtain unit fidelity to machine precision, whereas the results for other schemes are separated consistently by orders of magnitude in computation time and in worst-case ten orders of magnitude in achievable fidelity. Since these gaps continually increase with system size and complexity, this methodology allows numerically efficient optimization of very high-dimensional dynamics, e.g., in many-body contexts, operating in the high-fidelity regime.","author_count":4,"contributors":["Jensen, Jesper Hasseriis Mohr","Møller, Frederik Skovbo","Sørensen, Jens Jakob Winther H","Sherson, Jacob"],"cuid":["S01-000.00-227313"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"corresponding_author":["Jensen, Jesper Hasseriis Mohr"],"country":["Austria"],"glorg":["All Global Affiliations","Vienna University of Technology"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"approximate dynamics leading to more optimal control efficient exact derivatives","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://arxiv.org/pdf/2005.09943.pdf","version":"Pre-print"},"id":"S01-000.00-227313","identifier":[{"id":"85108732165","type":"scopus"}],"ids":["au-abcf7fc6-fa49-4bec-9340-aedc6d330f9b"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-1089EC5477C6F2CD7FEB8C4BB20603BB"],"oa_link":[{"access":"oa","type":"rem","url":"https://arxiv.org/pdf/2005.09943.pdf","version":"Pre-print"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Physics and Astronomy"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"at","key":"vienna university of technology","loc":["Austria","Europe, EU","OECD"],"name":"Vienna University of Technology","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jesper Hasseriis Mohr","key":"jensenpau","last":"Jensen","locid":"90e2a5b6-a5b4-46be-b61b-3e1140888954","name":"Jensen, Jesper Hasseriis Mohr","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Frederik Skovbo","key":"møllerpau","last":"Møller","name":"Møller, Frederik Skovbo","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jens Jakob","key":"sørensenpau","last":"Sørensen","locid":"5ce4a9ba-0fd6-404b-bdf7-0e9ae99b5891","name":"Sørensen, Jens Jakob Winther H","name_org":"Sørensen, Jens Jakob","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jac