iversity Hospital"],"nora_code":"DI-HO-SDR","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Peter","key":"frederiksenpau","last":"Frederiksen","locid":"85d6facd-93bf-44ee-a117-269fb26a52be","name":"Frederiksen, Peter H.","name_org":"Frederiksen, Peter","orcid":"0000-0003-3712-7980","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jakob","key":"josiassenpau","last":"Josiassen","name":"Josiassen, Jakob","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ole","key":"helgestadpau","last":"Helgestad","locid":"ab9f3165-500c-482b-9c2f-1879b3abedb3","name":"Helgestad, Ole Kristian Lerche","name_org":"Helgestad, Ole","orcid":"0000-0003-3847-8758","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Nanna Louise Junker","key":"udesenpau","last":"Udesen","locid":"f71f56f5-4f36-4de5-a7ae-e5e51f101a83","name":"Udesen, Nanna Louise Junker","orcid":"0000-0003-1542-3260","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ann Bøcher Secher","key":"bankepau","last":"Banke","locid":"0d350637-c6ce-4cf8-82ba-e965da703690","name":"Banke, Ann","name_org":"Banke, Ann Bøcher Secher","orcid":"0000-0002-1036-580X","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Henrik","key":"schmidtpau","last":"Schmidt","locid":"9789920f-4b31-4f28-8211-97afced9d61e","name":"Schmidt, Henrik","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lisette Okkels","key":"jensenpau","last":"Jensen","locid":"b78c452e-5a69-41fe-ba49-0096c84d1d4d","name":"Jensen, Lisette Okkels","orcid":"0000-0002-4838-2429","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hanne Berg","key":"ravnpau","last":"Ravn","locid":"25de7650-3dc1-4594-b758-9c36f6de6306","name":"Ravn, Hanne Berg","orcid":"0000-0003-4702-5195","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jacob Eifer","key":"møllerpau","last":"Møller","locid":"5e4d3cb6-b0a0-4541-aea1-30e73f7c10b8","name":"Møller, Jacob Eifer","orcid":"0000-0003-2873-5845","rank":9,"rolecode":"pau"}],"pub":{"doi":"10.1016/s0735-1097(22)01487-5","issn":["07351097","15583597"],"issn_org":["07351097"],"issue":"9 Suppl.","journal":"Journal of the American College of Cardiology","pages":"496","publisher":"Elsevier","status":"p","title":"Journal of the American College of Cardiology","volume":"79"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-23c6a932-d12c-4574-bcf1-a17d41d57de2"],"src":["SDU University of Southern Denmark"],"title":"IMPACT OF IMPELLA RP VERSUS VASOACTIVE TREATMENT ON LEFT VENTRICULAR STRAIN IN A PORCINE MODEL OF ACUTE CARDIOGENIC SHOCK DUE TO RIGHT CORONARY ARTERY EMBOLIZATION.","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-583440","year":"2022","yearsub":"2022"}
{"abstract":"Background: The sodium-glucose co-transporter-2 (SGLT2) inhibitors were developed as glucose-lowering drugs to treat type 2 diabetes (T2D). However, significant reductions in clinical outcomes have now been demonstrated in patients with heart failure with reduced ejection fraction (HFrEF), irrespective of the presence of T2D. Multiple hypotheses have been proposed for the underlying mechanisms, and the data to support these proposals are emerging. Objectives: To review the clinical outcome data with SGLT2 inhibitors in HFrEF and the data to support the mechanisms for these clinical effects. Methods: Literature review was supported by a PubMed search for relevant articles up to 19 April 2022. Findings: Current data support increased diuresis and reverse cardiac remodelling as important mechanisms for the reductions in heart failure hospitalizations and mortality observed with SGLT2 inhibitors (empagliflozin or dapagliflozin) in patients with HFrEF. Alteration in intrarenal haemodynamic is likely contributing to the observed renoprotective effect of SGLT2 inhibitors. Conclusions: Solid clinical data support the current recommendations to use empagliflozin or dapagliflozin in HFrEF. The underlying mechanisms likely include changes in cardiac and intrarenal haemodynamic. Yet, these mechanisms do not seem to solely explain the observed magnitude of clinical effect with SGLT2 inhibitors in HFrEF, and other mechanisms may contribute.","author_count":7,"contributors":["Jensen, Jesper","Omar, Massar","Kistorp, Caroline","Gustafsson, Finn","Køber, Lars","Møller, Jacob Eifer","Schou, Morten"],"cuid":["S02-084.13-046000"],"filters":{"added":"2022-07","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Jensen, Jesper"],"keyword":["Clinical","Heart failure","Mechanisms","SGLT2 inhibitors","Treatment"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-SDR","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"sodium glucose co transporter 000000000002 inhibitors in heart failure with reduced ejection fraction current evidence and future perspectives","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/320107593/IKM_Basic_Clin_Pharma_Tox_2022_Jensen_Sodium_Glucose_Cotransporter_2_Inhibitors_in_Heart_Failure_with_Reduced_Ejection.pdf","version":"Authors Final Version"},"funding_acknowledgement":["reports grants from The Danish Heart Foundation, Denmark, and The CARDIOHGH at the Department of Cardiology, Herlev and Gentofte University Hospital, Denmark, during the conduct of the submitted work; personal fees from scientific advisory board from AstraZeneca, outside the submitted work; grants from The Research Council at Herlev and Gentofte University Hospital, Denmark; grants from The CARDIOHGH (formerly FUHAS), Herlev and Gentofte University Hospital, Denmark; and grants from The A.P. Møller Foundation for the Advancement of Medical Science, Denmark (as sub‐investigator of the Empire HF trial). reports grants from The Steno Diabetes Center Odense, Denmark (as sub‐investigator of the Empire HF trial). reports personal fees from scientific advisory panel and speaker fees from Boehringer Ingelheim, Merck, Sharp & Dohme, AstraZeneca, Amgen, Novartis, Novo Nordisk and Shire, outside the submitted work. reports personal fees from scientific advisory panel and speaker fees from AstraZeneca, Boehringer Ingelheim, Abbott, Orion Pharma, Pfizer and Novartis, and acting as an unpaid advisor for Corvia, outside the submitted work. reports personal fees from speaker honorarium from Novartis, AstraZeneca, Novo Nordisk and Boehringer Ingelheim, outside the submitted work. reports grants from Abiomed Inc. and personal fees from speaker honorarium from Novartis and Orion Pharma, outside the submitted work. reports grants from The Danish Heart Foundation, Denmark, and from The Capital Region of Denmark, Denmark (as the sponsor and primary investigator of the Empire HF trial); personal fees from speaker honorarium and non‐financial support (as the national lead investigator of the DAPA‐HF trial) from AstraZeneca; and personal fees from speaker honorarium from Novo Nordisk and Boehringer Ingelheim, outside the submitted work. Dr Jensen Dr Omar Dr Kistorp Dr Gustafsson Dr Køber Dr Møller Dr Schou Funding was obtained from The Danish Heart Foundation, Denmark [grant number 21‐R150‐A9936‐22197] and The CARDIOHGH at the Department of Cardiology, Herlev and Gentofte University Hospital, Denmark [institutional research grant]."],"id":"S02-084.13-046000","identifier":[{"id":"85130118062","type":"scopus"},{"id":"35510595","type":"pmid"}],"ids":["ku-c3d559e6-132d-44e7-a93a-9b1206cdc9a5","sdu-5f102b88-2e41-4d10-9ddf-401711623f13"],"keyword":["SGLT2 inhibitors","clinical","heart failure","mechanisms","treatment"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-91FD2B79686C4B8688D275E124EA90C8"],"oa_link":[{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/320107593/IKM_Basic_Clin_Pharma_Tox_2022_Jensen_Sodium_Glucose_Cotransporter_2_Inhibitors_in_Heart_Failure_with_Reduced_Ejection.pdf","version":"Authors Final Version"},{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/203034812/bcpt.13739.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","name