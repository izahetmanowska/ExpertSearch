2-2532-6854","rank":7,"rolecode":"pau"},{"affno":"11","corresponding":null,"country":"dk","first":"Jacob Dyring","key":"jensenpau","last":"Jensen","locid":"0c03557e-9e42-4e40-afb3-fd3e6c70260e","name":"Jensen, Jacob Dyring","orcid":"0009-0003-5155-3633","rank":8,"rolecode":"pau"},{"affno":"1","first":"Michael","key":"alifrangispau","last":"Alifrangis","locid":"37b8a24a-9862-4b32-85d0-8a96747142c2","name":"Alifrangis, Michael","orcid":"0000-0002-3835-3333","rank":9,"rolecode":"pau"},{"affno":"11","corresponding":null,"country":"dk","first":"Ole","key":"lundpau","last":"Lund","locid":"d2f5060c-0c9a-4875-820f-91180f3bb685","name":"Lund, Ole","orcid":"0000-0003-1108-0491","rank":10,"rolecode":"pau"},{"affno":"11","corresponding":null,"country":"dk","first":"Frank","key":"mølleraarestruppau","last":"Møller Aarestrup","locid":"8a1eb030-2c37-4557-bce1-7bc6d5c75aaa","name":"Aarestrup, Frank Møller","name_org":"Møller Aarestrup, Frank","orcid":"0000-0002-7116-2723","rank":11,"rolecode":"pau"}],"pmid":["29471822"],"pub":{"doi":"10.1186/s12936-018-2232-6","issn":["14752875"],"issue":"1","journal":"Malaria Journal","paperid":"91","publisher":"BioMed Central","status":"p","title":"Malaria Journal","volume":"17"},"review":"Peer Reviewed","scoID":["2-s2.0-85042548918"],"sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Technical University of Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["dtu-d5c999ef-baa0-4b17-8b5e-ad8a3643a733","ku-acd80e82-cea7-4e4f-a40f-a48bfb83aeb2","sdu-56b61f3e-1b76-4ffa-be24-b8a57dad4809"],"src":["DTU Technical University of Denmark","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Direct whole-genome sequencing of Plasmodium falciparum specimens from dried erythrocyte spots","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-098.85-037420","year":"2018","yearsub":"2018"}
{"abstract":"Mobile technologies have become an important part of run training, however, existing technologies focus on performance metrics (e.g., distance and pace), which makes it difficult for runners to improve their running technique. In this paper, we present Strive, a wearable running technology that aims to assist runners in achieving rhythmic breathing; a running technique that potentially leads to improved results and lower injury risk. Strive continuously collects physiological data and uses haptic feedback to provide real-time assistance during runs. As communicating technique-related information in the dynamic and complex context of a run is challenging, we present two studies. The first study investigates how runners adapt to two different vibration patterns; and the second study explores the temporality of the assistance through three different approaches: Continuous, periodical, and self-serviced. Based on these studies, we discuss and provide insights on interacting with technologies during runs.","author_count":11,"contributors":["Valsted, Frederik Mørch","Nielsen, Christopher V. H.","Jensen, Jacob Qvist","Sonne, Tobias","Jensen, Mads Møller"],"cuid":["S01-000.00-167923"],"event":{"acronym":"OzCHI","end":"2017-12-01","place":"Brisbane, au","start":"2017-11-28","title":"Proceedings of the 29th Australian Conference on Computer-Human Interaction","year":"2017"},"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","University College London"],"keyword":["Haptic interaction","Running","Sports","Wearable technology"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"strive exploring assistive haptic feedback on the run","src":["au"],"src-code":["DI-U-AU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85044188940","version":"Other Version"},"id":"S01-000.00-167923","identifier":[{"id":"85044188940","type":"scopus"}],"ids":["au-43bf639a-49a2-478d-985c-088e89791d39"],"keyword":["Haptic interaction","Running","Sports","Wearable technology","haptic interaction, running, sports, wearable technology"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-7F0C1A07A94CE86F593A58C658C478C0"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Computer Science"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"gb","key":"university college london","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University College London","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Frederik Mørch","key":"valstedfrederikmørchpau","last":"Valsted","locid":"1b999063-0ff8-403c-88c1-461f118ca027","name":"Valsted, Frederik Mørch","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christopher V. H.","key":"nielsenchristophervhpau","last":"Nielsen","locid":"3166b26c-39af-4bf5-bdbc-8de37b9df40a","name":"Nielsen, Christopher V. H.","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jacob Qvist","key":"jensenjacobqvistpau","last":"Jensen","locid":"5c9494f9-6aa0-483c-a3fc-351f89eafead","name":"Jensen, Jacob Qvist","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Tobias","key":"sonnetobiaspau","last":"Sonne","name":"Sonne, Tobias","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mads Møller","key":"jensenmadsmøllerpau","last":"Jensen","locid":"40358716-217e-41cc-bdab-91e75d7db6