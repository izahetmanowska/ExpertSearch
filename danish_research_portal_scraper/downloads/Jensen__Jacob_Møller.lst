{"author_count":10,"contributors":["Jensen, Jesper","Omar, Massar","Kistorp, Caroline","Tuxen, Christian","Poulsen, Mikael Kjær","Faber, Jens","Køber, Lars","Gustafsson, Finn","Møller, Jacob Eifer","Schou, Morten"],"cuid":["S02-100.00-044678"],"filters":{"added":"2022-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Jensen, Jesper"],"keyword":["Biomarkers","Clinical trial","Heart failure","Sodium Glucose Transporter 2 Inhibitors","Therapeutics"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-SDR","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"effect of empagliflozin on multiple biomarkers in heart failure insights from the empire heart failure trial","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85136020997","version":"Other Version"},"funding_acknowledgement":["The Empire HF (Heart Failure) trial was supported by the Danish Heart Foundation, Copenhagen, Denmark (grants 17-R116-A7714-22076 and 18-R124-A8573-22107); the Research Council at Herlev and Gentofte University Hospital, Herlev, Denmark (institutional research grant); the Research and Innovation Foundation of the Department of Cardiology (FUHAS, formerly FUKAP), Herlev and Gentofte University Hospital, Herlev, Denmark (institutional research grant); the A.P. Møller Foundation for the Advancement of Medical Science, Copenhagen, Denmark (grant 17-L-0002); Steno Diabetes Center Odense, Odense, Denmark (institutional research grant); and the Capital Region of Denmark, Copenhagen, Denmark (grant A6058). Thermo Fischer Scientific (Hennigsdorf, Germany) funded the endothelin-1 kits. The manufacturer of empagliflozin had no role in any aspect of the study. Dr Jensen reports grants from the Research Council at Herlev and Gentofte University Hospital, Herlev, Denmark, grants from the Research and Innovation Foundation of the Department of Cardiology (FUHAS, formerly FUKAP), Herlev and Gentofte University Hospital, Herlev, Denmark, and grants from the A.P. Møller Foundation for the Advancement of Medical Science, Copenhagen, Denmark, during the conduct of the study; and grants from the Danish Heart Foundation and personal fees from scientific advisory board from AstraZeneca and Boehringer Ingelheim, outside the submitted work. Dr Omar reports grants from the Steno Diabetes Center Odense, Odense, Denmark, during the conduct of the study. Dr Kistorp reports personal fees from scientific advisory panel and speaker fees from Boehringer Ingelheim, Merck, Sharp & Dohme, AstraZeneca, Amgen, Novartis, Novo Nordisk, and Shire, outside the submitted work. Dr Tuxen reports personal fees from scientific advisory board and speaker fees from Bayer and Orion Pharma outside the submitted work. Dr Køber reports and personal fees from speaker honorarium from Novartis, AstraZeneca, Novo Nordisk, and Boehringer Ingelheim, outside the submitted work. Dr Gustafsson reports personal fees from scientific advisory panel and speaker fees from AstraZeneca, Boehringer Ingelheim, Abbott, Orion Pharma, Pfizer, and Novartis, and acting as an unpaid advisor for Corvia, outside the submitted work. Dr Møller reports grants from Abiomed Inc, and personal fees from speaker honorarium from Novartis and Orion Pharma, outside the submitted work. Dr Schou reports grants from the Danish Heart Foundation, Copenhagen, Denmark, and from the Capital Region of Denmark, Copenhagen, Denmark, during the conduct of the study; personal fees from speaker honorarium and nonfinancial support (as the national lead investigator of the DAPA-HF trial [Dapagliflozin and Prevention of Adverse Outcomes in Heart Failure]) from AstraZeneca, and personal fees from speaker honorarium from Novo Nordisk and Boehringer Ingelheim, outside the submitted work. The other authors report no conflicts."],"id":"S02-100.00-044678","identifier":[{"id":"35973031","type":"pmid"},{"id":"85136020997","type":"scopus"}],"ids":["ku-9a1c89a5-8c71-4cef-9441-e2444de73edc","sdu-a036c22b-6530-4038-9b8c-29a2ad29ca75"],"keyword":["biomarkers","clinical trial","heart failure","sodium-glucose transporter 2 inhibitors","therapeutics"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-D342765FB7204A863FFDA610945C07A2"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Herlev og Gentofte Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Cardiology (Odense)","SDU, The Faculty of Health Sciences, Department of Clinica