r Rheumatic Diseases","SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS - Hospital Sønderjylland"],"nora_code":"DI-U-SDU","used":1},{"affno":"3","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Sygehus Lillebælt"],"nora_code":"DI-HO-SDR","used":1},{"affno":"4","country":"dk","key":"region zealand","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-ZEA","l3nl":"Region Zealand","l3nn":"Region Zealand","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region Zealand","namevar":["Næstved-Slagelse-Ringsted Hospitals"],"nora_code":"DI-HO-ZEA","used":1},{"affno":"5","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Duer-Jensen","key":"annepau","last":"Anne","name":"Anne, Duer-Jensen","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Kim","key":"hørslevpetersenpau","last":"Hørslev-Petersen","locid":"72fb7058-9ac2-4dcb-a3cf-eb9b400c3661","name":"Hørslev-Petersen, Kim","orcid":"0000-0002-5475-7610","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"L.","key":"bakpau","last":"Bak","name":"Bak, L.","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Julia Sidenius","key":"johansenpau","last":"Johansen","name":"Johansen, Julia Sidenius","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Michael Sejer","key":"hansenpau","last":"Hansen","name":"Hansen, Michael Sejer","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Merete Lund","key":"hetlandpau","last":"Hetland","name":"Hetland, Merete Lund","rank":6,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Bo J.","key":"ejbjergpau","last":"Ejbjerg","name":"Ejbjerg, Bo J.","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Hanne Merete","key":"lindegaardpau","last":"Lindegaard","locid":"84162349-4120-418e-8358-3c416b6107a1","name":"Lindegaard, Hanne Merete","orcid":"0000-0002-5675-3859","rank":8,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"H.","key":"vinterbergpau","last":"Vinterberg","name":"Vinterberg, H.","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jacob","key":"møllerpau","last":"Møller","name":"Møller, Jacob","rank":10,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Mikkel","key":"østergaardpau","last":"Østergaard","name":"Østergaard, Mikkel","rank":11,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-5a788cb6-dfbc-4174-bf16-5c2b33f191ce"],"src":["SDU University of Southern Denmark"],"title":"Using MRI Synivitis to count involved Joints in the ACR/EULAR 2010 RA criteria increases their sensitivity and specificity","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-599144","year":"2012","yearsub":"2012"}
{"abstract":"[Open access] Background: Widespread occupational exposure to carbon black nanoparticles (CBNPs) raises concerns over their safety. CBNPs are genotoxic in vitro but less is known about their genotoxicity in various organs in vivo. Methods. We investigated inflammatory and acute phase responses, DNA strand breaks (SB) and oxidatively damaged DNA in C57BL/6 mice 1, 3 and 28 days after a single instillation of 0.018, 0.054 or 0.162 mg Printex 90 CBNPs, alongside sham controls. Bronchoalveolar lavage (BAL) fluid was analyzed for cellular composition. SB in BAL cells, whole lung and liver were assessed using the alkaline comet assay. Formamidopyrimidine DNA glycosylase (FPG) sensitive sites were assessed as an indicator of oxidatively damaged DNA. Pulmonary and hepatic acute phase response was evaluated by Saa3 mRNA real-time quantitative PCR. Results: Inflammation was strongest 1 and 3 days post-exposure, and remained elevated for the two highest doses (i.e., 0.054 and 0.162 mg) 28 days post-exposure (P <0.001). SB were detected in lung at all doses on post-exposure day 1 (P <0.001) and remained elevated at the two highest doses until day 28 (P <0.05). BAL cell DNA SB were elevated relative to controls at least at the highest dose on all post-exposure days (P <0.05). The level of FPG sensitive sites in lung was increased throughout with significant increases occurring on post-exposure days 1 and 3, in comparison to controls (P <0.001-0.05). SB in liver were detected on post-exposure days 1 (P <0.001) and 28 (P <0.001). Polymorphonuclear (PMN) cell counts in BAL correlated strongly with FPG sensitive sites in lung (r = 0.88, P <0.001), whereas no such correlation was observed with SB (r = 0.52, P = 0.08). CBNP increased the expression of Saa3 mRNA in lung tissue on day 1 (all doses), 3 (all doses) and 28 (0.054 and 0.162 mg), but not in liver. Conclusions: Deposition of CBNPs in lung induces inflammatory and genotoxic effects in mouse lung that persist considerably after the initial exposure. Our results demonstrate that CBNPs may cause genotoxicity both in the primary exposed tissue, lung and BAL cells, and in a secondary tissue, the liver.","author_count":12,"contributors":["Bourdon, Julie A","Saber, Anne T","Jacobsen, Nicklas R","Jensen, Keld A","Madsen, Anne M","Lamson, Jacob S","Wallin, Håkan","Møller, Peter","Loft, Steffen","Yauk, Carole L","Vogel, Ulla Birgitte"],"cuid":["S02-088.30-769286"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["med","soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-WORK"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-GV-WORK","DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"carbon black nanoparticle instillation induces sustained inflammation and genotoxicity in mouse lung and liver","src":["ku","nfa"],"src-code":["DI-GV-WORK","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1186/1743-8977-9-5","version":"Published Version"},"id":"S02-088.30-769286","identifier":[{"id":"22300514","type":"pmid"},{"id":"84856505316","type":"scopus"},{"id":"PMC3293019","type":"pmcid"}],"ids":["ku-e1a0720e-6e31-49a2-80b8-a47aef0b40f7","nfa-fb8aaae9-1ea7-4993-8243-126332cd2f7a"],"lang":"English","level":"Scientific","mra":["Medical Science","Social Science"],"noi":["Global-Local-2-5-54A15C12F7D5B94B2135E256971CAF33"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1186/1743-8977-9-5","version":"Published Version"}],"org":[{"affno":"1","key":"nfa national research centre for the working environment","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-WORK","l3nn":"NFA National Research Centre for the Working Environment","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"NFA National Research Centre for the Working Environment","namevar":["The National Research Centre for the Working Environment, Directors, Chemical Working Environment, Toxicology, Nanosafety, and Microbiology"],"nora_code":"DI-GV-WORK","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Public Health","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Public Health, Section of Environmental Health"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"dk","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"","first":"Julie A","key":"bourdonpau","last":"Bourdon","name":"Bourdon, Julie A","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anne Thoustrup","key":"saberpau","last":"Saber","locid":"9c022777-353e-4c49-9101-e011eac8dddd","name":"Saber, Anne Thoustrup","orcid":"0000-0002-7626-709X","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Nicklas Raun","key":"jacobsenpau","last":"Jacobsen","locid":"2767126a-8d1d-42ef-a04e-a9f126721bbe","name":"Jacobsen, Nicklas Raun","orcid":"0000-0002-2504-2229","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Keld Alstrup","key":"jensenpau","last":"Jensen","locid":"5b93ba18-9ef8-4419-8d4f-5b7c9634ba2f","name":"Jensen, Keld Alstrup","orcid":"0000-0002-2764-3634","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anne Mette","key":"madsenpau","last":"Madsen","loci