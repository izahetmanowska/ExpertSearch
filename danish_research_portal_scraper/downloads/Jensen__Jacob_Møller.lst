tal cardiac arrest","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-607262","year":"2017","yearsub":"2017"}
{"abstract":"Data presented in this article relates to the research article entitled “Association between QRS duration on prehospital ECG and mortality in patients with suspected STEMI” (Hansen et al., in press) [1]. Data on the prognostic effect of automatically recoded QRS duration on prehospital ECG and presence of classic left and right bundle branch block in 1777 consecutive patients with confirmed ST segment elevation AMI is presented. Multivariable analysis, suggested that QRS duration >111 ms, left bundle branch block and right bundle branch block were independent predictors of 30 days all-cause mortality. For interpretation and discussion of these data, refer to the research article referenced above.","author_count":10,"contributors":["Hansen, Rikke","Frydland, Martin","Møller-Helgestad, Ole Kristian","Lindholm, Matias Greve","Jensen, Lisette Okkels","Holmvang, Lene","Ravn, Hanne Berg","Kjærgaard, Jesper","Hassager, Christian","Møller, Jacob Eifer"],"cuid":["S02-099.83-042312"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-SDR","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"data on association between qrs duration on prehospital ecg and mortality in patients with confirmed stemi","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.dib.2017.08.051","version":"Published Version"},"id":"S02-099.83-042312","identifier":[{"id":"85029701311","type":"scopus"},{"id":"PMC5609869","type":"pmcid"},{"id":"28971117","type":"pmid"}],"ids":["ku-4ec203cc-24ee-44b8-9b74-b68523d3fd37","sdu-50fc7b77-1b72-41b1-8b74-104fabc135b4"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-01410353960A80F8544D371E86D57977"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.dib.2017.08.051","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/189361575/1_s2.0_S2352340917304286_main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/136347766/Data_on_association_between_QRS_duration_on_prehospital_ECG_and_mortality_in_patients_with_confirmed_STEMI.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","country":"dk","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["University of Southern Denmark"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"4","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Odense University Hospital"],"nora_code":"DI-HO-SDR","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Rikke","key":"hansenpau","last":"Hansen","name":"Hansen, Rikke","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Martin","key":"frydlandpau","last":"Frydland","name":"Frydland, Martin","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ole Kristian","key":"møllerhelgestadpau","last":"Møller-Helgestad","locid":"ab9f3165-500c-482b-9c2f-1879b3abedb3","name":"Helgestad, Ole Kristian Lerche","name_org":"Møller-Helgestad, Ole Kristian","orcid":"0000-0003-3847-8758","rank":3,"rolecode":"pau"},{"affno":"3 2","first":"Matias Greve","key":"lindholmpau","last":"Lindholm","locid":"4333dd58-10c3-4fea-aadb-048bdc7cbc3a","name":"Lindholm, Matias Greve","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lisette Okkels","key":"jensenpau","last":"Jensen","locid":"b78c452e-5a69-41fe-ba49-0096c84d1d4d","name":"Jensen, Lisette Okkels","orcid":"0000-0002-4838-2429","rank":5,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Lene","key":"holmvangpau","last":"Holmvang","name":"Holmvang, Lene","rank":6,"rolecode":"pau"},{"affno":"3 2","first":"Hanne Berg","key":"ravnpau","last":"Ravn","locid":"3049e7b7-0f18-413b-88ab-a3d77ebc079b","name":"Ravn, Hanne Berg","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jesper","key":"kjærgaardpau","last":"Kjærgaard","name":"Kjærgaard, Jesper","rank":8,"rolecode":"pau"},{"affno":"3 2","first":"Christian","key":"hassagerpau","last":"Hassager","locid":"49196e5d-0f61-44b2-a6b9-cd6c5f8f3bc2","name":"Hassager, Christian","orcid":"0000-0002-1199-0981","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jacob Eifer","key":"møllerpau","last":"Møller","locid":"5e4d3cb6-b0a0-4541-aea1-30e73f7c10b8","name":"Møller, Jacob Eifer","orcid":"0000-0003-2873-5845","rank":10,"rolecode":"pau"}],"pmid":["28971117"],"pub":{"doi":"10.1016/j.dib.2017.08.051","issn":["23523409"],"journal":"Data in Brief","pages":"12-17","publisher":"Elsevier","status":"p","title":"Data in Brief","volume":"15"},"review":"Peer Reviewed","scoID":["2-s2.0-85029701311"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-4ec203cc-24ee-44b8-9b74-b68523d3fd37","sdu-50fc7b77-1b72-41b1-8b74-104fabc135b4"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Data on association between QRS duration on prehospital ECG and mortality in patients with confirmed STEMI","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.83-042312","year":"2017","yearsub":"2017"}
{"abstract":"This study assessed the management of the organic household waste in the Danish-German border region and points out major differences between the systems and their potential effects on the environment using life cycle assessment (LCA). The treatment of organic waste from households in the Danish-German border region is very different on each side of the border; the Danish region only uses incineration for the treatment of organic household waste while the German region includes combined biogas production and composting, mechanical and biological treatment (MBT) and incineration. Data on all parts of the organic waste treatment was collected including waste composition data and data from treatment facilities and their respective energy systems. Based on that the organic waste management systems in the border region were modelled using the EASETECH waste management LCA-model. The main output is a life cycle assessment showing large differences in the environmental performance of the two different regions with the Danish region performing better in 10 out of 14 impact categories. Furthermore, the importance of the substituted district heating systems was investigated showing an impact up to 34% of the entire system for one impact category and showing large difference between each heating system substituted, e.g. in \"Global Warming\" the impact was from -16 to -1.1 milli person equivalent/tonne treated waste from substitution of centralised hard coal and decentralised natural gas, respectively.","author_count":3,"contributors":["Jensen, Morten Bang","Møller, Jacob","Scheutz, Charlotte"],"cuid":["S01-000.00-329808"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Biogas","Biogas production","Biological treatment","District heating","District heating system","Environmental management","Environmental performance","Global warming","Heating","Heating equipment","Incineration","LCA","Life cycle","Life cycle assessment LCA","Organic household waste","Organic household wastes","Waste composition","Waste incineration","Waste management","Waste treatment","Wastes"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"comparison of the organic waste management systems in the danish german border region using life cycle assessment lca","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84956997053","version":"Other Version"},"id":"S01-000.00-329808","identifier":[{"id":"84956997053","type":"scopus"},{"id":"26856446","type":"pmid"}],"ids":["dtu-54da2ed3-b213-415c-b28a-d742d81f9c90"],"keyword":["Biogas","Biogas production","Biological treatment","District heating","District heating system","Environmental management","Environmental performance","Global warming","Heating","Heating equipment","Incineration","LCA","Life Cycle Assessment (LCA)","Life cycle","Marginal heat","Organic household waste","Organic household wastes","Potential effects","Waste composition","Waste incineration","Waste management","Waste treatment","Wastes"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-67C71CF6294F29E558A63300752F4840"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Environmental Engineering","Technical University of Denmark, Department of Environmental Engineering, Residual Resource Engineering"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Morten Bang","key":"jensenpau","last":"Jensen","locid":"647f1ac7-93b2-4476-9ff2-a2d1a245e948","name":"Jensen, Morten Bang","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jacob","key":"møllerpau","last":"Møller","locid":"ba375b02-d34a-4a26-958d-59b8bd17fa42","name":"Møller, Jacob","orcid":"0000-0003-3475-1251","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Charlotte","key":"scheutzpau","last":"Scheutz","locid":"48fe2850-fdc6-4282-9b97-ac5773419e5c","name":"Scheutz, Charlotte","orcid":"0000-0003-2218-5934","rank":3,"rolecode":"pau"}],"pmid":["26856446"],"pub":{"doi":"10.1016/j.wasman.2016.01.035","issn":["0956053X","18792456"],"issn_org":["0956053X"],"journal":"Waste Management","pages":"491-504","publisher":"Elsevier","status":"p","title":"Waste Management","volume":"49"},"review":"Peer Reviewed","scoID":["2-s2.0-84956997053"],"sdg":["12. Responsible Consumption and Production","7. Affordable and Clean Energy","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-54da2ed3-b213-415c-b28a-d742d81f9c90"],"src":["DTU Technical University of Denmark"],"title":"Comparison of the organic waste management systems in the Danish-German border region using life cycle assessment (LCA)","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-329808","year":"2016","yearsub":"2016"}
{"author_count":5,"contributors":["Møller, Jacob","Naroznova, Irina","Scheutz, Charlotte","Foged Larsen, Bjarne","Peter Jensen, Jens"],"cuid":["S01-000.00-332242"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"com","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-PR","DI-U"],"level3":{"OT":["BF Larsen"],"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-PR-OTH","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"fremstilling af et højværdisubstrat til biogasproduktion ved sampulpning af have parkaffald og kildesorteret organisk dagrenovation vha ecogiteknologien","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/127862105/978_87_93529_28_1.pdf","version":"Published Version"},"id":"S01-000.00-332242","ids":["dtu-5cfd8e3a-3691-467f-933b-a2d100a30f5c"],"lang":"Danish","level":"Commissioned","mra":["Science/Technology"],"noi":["Local-1-1-5EE1965F63D4FB5679EDB89855F79FB4"],"oa_link":[{"access":"oa","type":"rem","url":"http://www2.mst.dk/Udgiv/publikationer/2016/11/978-87-93529-28-1.pdf","version":"Published Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/127862105/978_87_93529_28_1.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Environmental Engineering","Technical University of Denmark, Department of Environmental Engineering, Residual Resource Engineering"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["BF Larsen"],"nora_code":"DI-OT","used":1},{"affno":"3","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["KomTek Miljø af 2012 A/S"],"nora_code":"DI-PR-OTH","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jacob","key":"møllerpau","last":"Møller","locid":"ba375b02-d34a-4a26-958d-59b8bd17fa42","name":"Møller, Jacob","orcid":"0000-0003-3475-1251","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Irina","key":"naroznovapau","last":"Naroznova","locid":"e24a9d73-2e37-4a15-b742-995ce845e719","name":"Naroznova, Irina","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Charlotte","key":"scheutzpau","last":"Scheutz","locid":"48fe2850-fdc6-4282-9b97-ac5773419e5c","name":"Scheutz, Charlotte","orcid":"0000-0003-2218-5934","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Bjarne","key":"fogedlarsenpau","last":"Foged Larsen","name":"Foged Larsen, Bjarne","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jens","key":"peterjensenpau","last":"Peter Jensen","name":"Peter Jensen, Jens","rank":5,"rolecode":"pau"}],"pub":{"pages":"122","place":"København K","publisher":"Miljøstyrelsen","status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Private Research","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Companies","Other Research","Private Research","Technical University of Denmark","Universities","komtek miljø af 2012 a/s"],"PST":["Published"]},"sid":["dtu-5cfd8e3a-3691-467f-933b-a2d100a30f5c"],"src":["DTU Technica