ab726","name":"Boesgaard, Søren","rank":7,"rolecode":"pau"},{"affno":"","first":"Peter Bo","key":"hansenpau","last":"Hansen","locid":"62397f35-17c0-4258-9225-22d9342d48d3","name":"Hansen, Peter Bo","rank":8,"rolecode":"pau"},{"affno":"","first":"Peter Skov","key":"olsenpau","last":"Olsen","locid":"dff97918-6285-4e4c-b072-f2e7b8695a25","name":"Olsen, Peter Skov","rank":9,"rolecode":"pau"},{"affno":"","first":"Kåre","key":"sanderpau","last":"Sander","locid":"0279543c-5c54-412a-bb12-78fe4769c7af","name":"Sander, Kåre","rank":10,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Niels H","key":"secherpau","last":"Secher","locid":"fc54cecb-0c67-47bd-b27f-1e0127af0e4d","name":"Secher, Niels H.","name_org":"Secher, Niels H","rank":11,"rolecode":"pau"},{"affno":"","first":"Per Lav","key":"madsenpau","last":"Madsen","locid":"267156f7-77df-4317-9a18-c34453d1f469","name":"Madsen, Per Lav","rank":12,"rolecode":"pau"}],"pmid":["21765126"],"pub":{"doi":"10.1161/circheartfailure.110.958041","issn":["19413289","19413297"],"issn_org":["19413289"],"issue":"5","journal":"Circulation: Heart Failure","pages":"554-560","status":"p","title":"Circulation: Heart Failure","title_org":"Circulation. Heart Failure","volume":"4"},"review":"Peer Reviewed","scoID":["2-s2.0-84856379721"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-d3035568-d42e-40f3-89eb-19cbff219050"],"src":["KU University of Copenhagen"],"title":"Central and peripheral blood flow during exercise with a continuous-flow left ventricular assist device: constant versus increasing pump speed: a pilot study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-519520","year":"2011","yearsub":"2011"}
{"abstract":"The degradability of cereal straw is of importance when it is used for animal feed, biological means of bioenergy production such as bioethanol production and when it is incorporated in soil. We examined wheat straw from 106 different winter wheat cultivars representing the northwest European contemporary gene pool. The cultivars were grown at two different locations to assess the potential for breeding for improved degradability. The straws exhibited much variation in degradability ranging from 258 g kg1 to 407 g kg1 of dry matter. The heritability for degradability was estimated to 29% indicating a reasonable potential for response to selection. Inclusion of height as a regression-term, indicated that only a minor part of genetic differences are directly related to plant height and that improvements in degradability may be achieved without unacceptable changes in straw length. Finally, a lack of correlation between degradability and grain yield indicated that straw degradability may be improved through breeding without serious negative effect on grain yield.","author_count":5,"contributors":["Jensen, Jacob Wagner","Magid, Jakob","Hansen-Møller, Jens","Andersen, Sven Bode","Bruun, Sander"],"cuid":["S02-100.00-026271"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Bioenergy","Biomass","Digestibility","Heritability","Triticum aestivum L"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Husdyrernæring og Miljø"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"genetic variation in degradability of wheat straw and potential for improvement through plant breeding","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.biombioe.2010.11.036","version":"Other Version"},"id":"S02-100.00-026271","identifier":[{"id":"79451468965","type":"scopus"}],"ids":["au-bb1c86b1-370c-4965-baf2-dfdd87daee0e","ku-7f646a41-a4c4-4e17-8706-0a36cb788f20"],"keyword":["Bioenergy","Biomass","Convertability","Digestibility","Heritability","Triticum aestivum L"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-6CB2847DAEDABB86B93981CC0273BEA5"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.biombioe.2010.11.036","version":"Other Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Life Sciences, Forest & Landscape Denmark"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus University, Faculty of Agricultural Sciences, Animal nutrition and environmental impact","Aarhus University, Aarhus University, Faculty of Agricultural Sciences, Department of Animal Health and Bioscience"],"nora_code":"DI-U-AU","used":1},{"affno":"3","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Husdyrernæring og Miljø"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","first":"Jacob Wagner","key":"jensenpau","last":"Jensen","locid":"3c6428df-2168-4bdb-90c6-da5725ebc63b","name":"Jensen, Jacob Wagner","rank":1,"rolecode":"pau"},{"affno":"1","first":"Jakob","key":"magidpau","last":"Magid","locid":"4bb2346c-31