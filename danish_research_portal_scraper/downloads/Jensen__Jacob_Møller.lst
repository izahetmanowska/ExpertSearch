":"2","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Ukendt"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"","corresponding":null,"first":"Ole Kristian","key":"mollerhelgestadpau","last":"Moller-Helgestad","locid":"ab9f3165-500c-482b-9c2f-1879b3abedb3","name":"Helgestad, Ole Kristian Lerche","name_org":"Moller-Helgestad, Ole Kristian","orcid":"0000-0003-3847-8758","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Janus Adler","key":"hyldebrandtpau","last":"Hyldebrandt","name":"Hyldebrandt, Janus Adler","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Nanna Louise Junker","key":"udesenpau","last":"Udesen","locid":"f71f56f5-4f36-4de5-a7ae-e5e51f101a83","name":"Udesen, Nanna Louise Junker","orcid":"0000-0003-1542-3260","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ann","key":"bankepau","last":"Banke","locid":"0d350637-c6ce-4cf8-82ba-e965da703690","name":"Banke, Ann","orcid":"0000-0002-1036-580X","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Charlotte Svejstrup","key":"rudpau","last":"Rud","name":"Rud, Charlotte Svejstrup","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Louise","key":"lindepau","last":"Linde","locid":"4fc23628-00d4-466a-9e6e-269e23160481","name":"Linde, Louise","orcid":"0000-0002-7757-2571","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lisette","key":"jensenpau","last":"Jensen","locid":"b78c452e-5a69-41fe-ba49-0096c84d1d4d","name":"Jensen, Lisette Okkels","name_org":"Jensen, Lisette","orcid":"0000-0002-4838-2429","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik","key":"schmidtpau","last":"Schmidt","locid":"9789920f-4b31-4f28-8211-97afced9d61e","name":"Schmidt, Henrik","rank":8,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Hanne Berg","key":"ravnpau","last":"Ravn","name":"Ravn, Hanne Berg","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jacob","key":"mollerpau","last":"Moller","locid":"5e4d3cb6-b0a0-4541-aea1-30e73f7c10b8","name":"Møller, Jacob Eifer","name_org":"Moller, Jacob","orcid":"0000-0003-2873-5845","rank":10,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-c0ca5eb3-9252-4f45-bcc7-82c21876f6c1"],"src":["SDU University of Southern Denmark"],"title":"MECHANICAL CIRCULATORY SUPPORT BY VENO-ARTERIAL EXTRACORPOREAL MEMBRANE OXYGENATION OR IMPELLA CP IN A PORCINE MODEL OF PROFOUND CARDIOGENIC SHOCK: IMPACT ON LEFT VENTRICULAR UNLOADING AND END ORGAN PERFUSION","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-628489","year":"2018","yearsub":"2018"}
{"abstract":"Background: Plasmodium falciparum malaria remains a major health burden and genomic research represents one of the necessary approaches for continued progress towards malaria control and elimination. Sample acquisition for this purpose is troublesome, with the majority of malaria-infected individuals living in rural areas, away from main infrastructure and the electrical grid. The aim of this study was to describe a low-tech procedure to sample P. falciparum specimens for direct whole genome sequencing (WGS), without use of electricity and cold-chain. Methods: Venous blood samples were collected from malaria patients in Bandim, Guinea-Bissau and leukocyte-depleted using Plasmodipur filters, the enriched parasite sample was spotted on Whatman paper and dried. The samples were stored at ambient temperatures and subsequently used for DNA-extraction. Ratios of parasite:human content of the extracted DNA was assessed by qPCR, and five samples with varying parasitaemia, were sequenced. Sequencing data were used to analyse the sample content, as well as sample coverage and depth as compared to the 3d7 reference genome. Results: qPCR revealed that 73% of the 199 samples were applicable for WGS, as defined by a minimum ratio of parasite:human DNA of 2:1. WGS revealed an even distribution of sequence data across the 3d7 reference genome, regardless of parasitaemia. The acquired read depths varied from 16 to 99×, and coverage varied from 87.5 to 98.9% of the 3d7 reference genome. SNP-analysis of six genes, for which amplicon sequencing has been performed previously, confirmed the reliability of the WGS-data. Conclusion: This study describes a simple filter paper based protocol for sampling P. falciparum from malaria patients for subsequent direct WGS, enabling acquisition of samples in remote settings with no access to electricity.","author_count":11,"contributors":["Nag, Sidsel","Kofoed, Poul Erik","Ursing, Johan","Lemvigh, Camilla K.","Allesøe, Rosa Lundbye","Rodrigues, Amabelia","Svendsen, Christina Aaby","Jensen, Jacob Dyring","Alifrangis, Michael","Lund, Ole","Aarestrup, Frank Møller"],"cuid":["S03-098.85-037420"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"continent":["Africa","Europe, EU","Nordic","OECD"],"corresponding_author":["Nag, Sidsel"],"country":["Guinea-Bissau","Sweden"],"glorg":["All Global Affiliations","Bandim Health Project","Danderyd Hospital","Danderyds Hospital","Karolinska Institute","Karolinska Institutet","National Institute of Public Health in Guinea-Bissau"],"keyword":["Dried blood spots","Dried erythrocyte spots","Leukocyte depletion","Malaria","Plasmodium falciparum","Sub Saharan Africa","Whole genome sequencing"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"OT":["Bandim Health Project, Bissau, Guinea-Bissau."],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-DTU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"direct whole genome sequencing of plasmodium falciparum specimens from dried erythrocyte spots","src":["dtu","ku","sdu"],"src-code":["DI-U-DTU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s12936-018-2232-6","version":"Published Version"},"funding_acknowledgement":["The authors would like to acknowledge Aase og Ejner Danielsens Fond for funding the sampling in Bandim as well as Civilingeniør Frode V. Nielsens Fond for funding part of the sequencing expenses. The study was also supported by the Center for Genomic Epidemiology (http://www.genomicepidemiology. org) grant 09‑067103/DSF from the Danish Council for Strategic Research. Lastly, the authors would like to acknowledge Marlene Dalgaard for assisting in trouble shooting on sample extractions and sequencing."],"id":"S03-098.85-037420","identifier":[{"id":"PMC5824530","type":"pmcid"},{"id":"29471822","type":"pmid"},{"id":"85042548918","type":"scopus"}],"ids":["dtu-d5c999ef-baa0-4b17-8b5e-ad8a3643a733","ku-acd80e82-cea7-4e4f-a40f-a48bfb83aeb2","sdu-56b61f3e-1b76-4ffa-be24-b8a57dad4809"],"keyword":["Dried blood spots","Dried erythrocyte spots","Leukocyte depletion","Malaria","Plasmodium falciparum","Sub-Saharan Africa","Whole-genome sequencing"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-6-F919209E3717222360EC909B8021C3FF"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/216258904/s12936_018_2232_6.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/143664509/s12936_018_2232_6.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s12936-018-2232-6","version":"Published Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/144523020/10.1186_2Fs12936_018_2232_6.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Immunology and Microbiology, DRUGS team","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Immunology and Microbiology, Department of Immunology and Microbiology"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Den