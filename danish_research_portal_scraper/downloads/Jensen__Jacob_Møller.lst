 Research, KI, OUH, Research unit of Medicine (Svendborg)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Rikke","key":"asmussenandreasenpau","last":"Asmussen Andreasen","locid":"b94cce6f-a220-4514-bf60-7f899fe25f12","name":"Asmussen Andreasen, Rikke","orcid":"0000-0002-4992-5229","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Amir","key":"emamifarpau","last":"Emamifar","locid":"ff24e337-1f4c-416b-9b28-efb2225ce953","name":"Emamifar, Amir","orcid":"0000-0001-5329-1364","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jacob Christian","key":"bangpau","last":"Bang","locid":"86ec2e26-c79d-4b32-b312-e431240cb020","name":"Bang, Jacob Christian","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Michael Boe","key":"møllerpau","last":"Møller","locid":"edd876e8-0651-4c8f-8f0f-95f4519e1654","name":"Møller, Michael Boe","orcid":"0000-0003-2041-3630","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Inger Marie","key":"jensenhansenpau","last":"Jensen Hansen","locid":"e6350066-c71d-48a0-945e-259b7989d1c6","name":"Jensen Hansen, Inger Marie","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.14800/ip.759","issn":["23779756"],"issue":"2","journal":"Itch & Pain","paperid":"e759","publisher":"Smart Science & Technology LLC","status":"p","title":"Itch & Pain","volume":"2"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-73c99135-c7eb-4aee-8c96-f50b731ce739"],"src":["SDU University of Southern Denmark"],"title":"Severe joint pain as a manifestation of paraneoplastic rheumatic syndrome in a patient with a malignant lymphoma : a case report and review of the literature","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-606330","year":"2015","yearsub":"2015"}
{"abstract":"Volume flow in arteriovenous fistulas for hemodialysis was measured using the angle-independent ultrasound technique Vector Flow Imaging and compared with flow measurements using the ultrasound dilution technique during dialysis. Using an UltraView 800 ultrasound scanner (BK Medical, Herlev, Denmark) with a linear transducer, 20 arteriovenous fistulas were scanned directly on the most superficial part of the fistula just before dialysis. Vector Flow Imaging volume flow was estimated with two different approaches, using the maximum and the average flow velocities detected in the fistula. Flow was estimated to be 242 mL/min and 404 mL/min lower than the ultrasound dilution technique estimate, depending on the approach. The standard deviations of the two Vector Flow Imaging approaches were 175.9 mL/min and 164.8 mL/min compared with a standard deviation of 136.9 mL/min using the ultrasound dilution technique. The study supports that Vector Flow Imaging is applicable for volume flow measurements.","author_count":10,"contributors":["Hansen, Peter Møller","Olesen, Jacob Bjerring","Pihl, Michael Johannes","Lange, Theis","Heerwagen, Søren","Pedersen, Mads Møller","Rix, Marianne","Lönn, Lars","Jensen, Jørgen Arendt","Nielsen, Michael Bachmann"],"cuid":["S02-100.00-035025"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Arteriovenous fistula","Hemodialysis","Ultrasound","Ultrasound dilution technique","Vector flow imaging"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"volume flow in arteriovenous fistulas using vector velocity ultrasound","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.ultrasmedbio.2014.06.004","version":"Other Version"},"id":"S02-100.00-035025","identifier":[{"id":"84907964829","type":"scopus"},{"id":"25282482","type":"pmid"}],"ids":["dtu-69bb94ec-7c28-4f7d-b750-2e85afdb9bc6","ku-f7b3e4d6-a814-45d7-9b70-6e9197055d27"],"keyword":["Arteriovenous fistula","Flow velocity estimation","Hemodialysis","Ultrasound","Ultrasound dilution technique","Vector Flow Imaging","Volume flow estimation"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-3A78EC89C4AE5BCDD97719C6B0837241"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.ultrasmedbio.2014.06.004","version":"Other Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital Herlev and Gentofte"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Centers, Center for Fast Ultrasound Imaging","Technical University of Denmark, Department of Electrical Engineering","Technical University of Denmark, Department of Electrical Engineering, Biomedical Engineering"],"nora_code":"DI-U-DTU","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Public Health, Section of Biostatistics"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Peter Møller","key":"hansenpau","last":"Hansen","name":"Hansen, Peter Møller","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Jacob Bjerring","key":"olesenpau","last":"Olesen","locid":"024aaa55-d5a4-4763-8004-b2fb701dfd2b","name":"Olesen, Jacob Bjerring","orcid":"0000-0002-5169-1644","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Michael Johannes","key":"pihlpau","last":"Pihl","locid":"efb04be2-6e73-4643-94c3-5b37126d55b0","name":"Pihl, Michael Johannes","rank":3,"rolecode":"pau"},{"affno":"3","first":"Theis","key":"langepau","last":"Lange","locid":"e4664578-01fc-4a93-8efd-1dbffb72cdd6","name":"Lange, Theis","orcid":"0000-0001-6807-8347","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren","key":"heerwagenpau","last":"Heerwagen","name":"Heerwagen, Søren","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mads Møller","key":"pedersenpau","last":"Pedersen","name":"Pedersen, Mads Møller","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Marianne","key":"rixpau","last":"Rix","name":"Rix, Marianne","rank":7,"rolecode":"pau"},{"affno":"1 3","first":"Lars","key":"lönnpau","last":"Lönn","locid":"c30d6f51-c103-4f4b-a7db-30af02137484","name":"Lönn, Lars","rank":8,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Jørgen Arendt","key":"jensenpau","last":"Jensen","locid":"e197c9fc-743f-4736-8d06-3825897e0989","name":"Jensen, Jørgen Arendt","orcid":"0000-0002-7896-3136","rank":9,"rolecode":"pau"},{"affno":"1 3","first":"Michael Bachmann","key":"nielsenpau","last":"Nielsen","locid":"6c91b654-63b7-4eeb-8a6e-ee4a2708020a","name":"Nielsen, Michael Bachmann","orcid":"0000-0002-9380-1688","rank":10,"rolecode":"pau"}],"pmid":["25282482"],"pub":{"doi":"10.1016/j.ultrasmedbio.2014.06.004","issn":["03015629","1879291X"],"issn_org":["03015629"],"issue":"11","journal":"Ultrasound in Medicine & Biology","pages":"2707-2714","publisher":"Elsevier","status":"p","title":"Ultrasound in Medicine & Biology","volume":"40"},"review":"Peer Reviewed","scoID":["2-s2.0-84907964829"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-69bb94ec-7c28-4f7d-b750-2e85afdb9bc6","ku-f7b3e4d6-a814-45d7-9b70-6e9197055d27"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Volume Flow in Arteriovenous Fistulas Using Vector Velocity Ultrasound","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-035025","year":"2014","yearsub":"2014"}
{"abstract":"This paper investigates sources of error for a vector velocity volume flow estimator. Quantification of the estima tor’s accuracy is performed theoretically and investigated in vivo . Womersley’s model for pulsatile flow is used to simulate velo city profiles and calculate volume flow errors in cases of elliptic al vessels and not placing the transducer at the vessel center. Simulations show, i.e., that volume flow is underestimated w ith 5 %, when the transducer is placed 15 % from the vessel center. Twenty patients with arteriovenous fistulas for hemodialys is are scanned in a clinical study. A BK Medical UltraView 800 ultrasound scanner with a 9 MHz linear array transducer is used to obtain Vector Flow Imaging sequences of a superficial part of the fistulas. Cross-sectional diameters of each fistu la are measured on B-mode images by rotating the scan plane 90 degrees. The major axis of the fistulas was on average 8.6 % larger than the minor axis, so elliptic dimensions should be taken into account in volume flow estimation. The ultrasound beam w as on average 1.5 ± 0.8 mm off-axis, corresponding to 28.5 ± 11.3 % of the major semi-axis of a fistula, and this could result in 15 % underestimated volume flow according to the simulation. Volume flow estimates were corrected for the beam being off- axis, but was not able to significantly decrease the error rel ative to measurements with the reference method.","author_count":5,"contributors":["Jensen, Jonas","Olesen, Jacob Bjerring","Hansen, Peter Møller","Nielsen, Michael Bachmann","Jensen, Jørgen Arendt"],"cuid":["S02-086.73-035487"],"event":{"end":"2014-09-06","place":"Chicago, us","start":"2014-09-03","title":"2014 IEEE International Ultrasonics Symposium, IUS 2014","year":"2014"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"accuracy and sources of error for an angle independent volume flow estimator","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1109/ULTSYM.2014.0425","version":"Other Version"},"id":"S02-086.73-035487","identifier":[{"id":"84910091484","type":"scopus"}],"ids":["dtu-7e30d7cb-dd29-424e-936e-f3a36905e028","ku-97a3ac5f-92a7-47ad-b9bb-10fbd2d7f62a"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-DBCB09BC42682BF71480C7F97A00D352"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1109/ULTSYM.2014.0425","version":"Other Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/104358476/postprint.pdf","version":"Other Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Centers, Center for Fast Ultrasound Imaging","Technical University of Denmark, Department of Electrical Engineering","Technical University of Denmark, Department of Electrical Engineering, Biomedical Engineering"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Radiology"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital Herlev and Gentofte"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jonas","key":"jensenjonaspau","last":"Jensen","locid":"ce6e719b-4e0f-4795-a9ac-91265cc918a8","name":"Jensen, Jonas","orcid":"0000-0003-4456-0838","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jacob Bjerring","key":"olesenjacobbjerringpau","last":"Olesen","locid":"024aaa55-d5a4-4763-8004-b2fb701dfd2b","name":"Olesen, Jacob Bjerring","orcid":"0000-0002-5169-1644","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Peter Møller","key":"hansenpetermøllerpau","last":"Hansen","locid":"3fd47ccb-1081-429f-8844-57b3ccc67092","name":"Hansen, Peter Møller","rank":3,"rolecode":"pau"},{"affno":"2 3","first":"Michael Bachmann","key":"nielsenmichaelbachmannpau","last":"Nielsen","locid":"6c91b654-63b7-4eeb-8a6e-ee4a2708020a","name":"Nielsen, Michael Bachmann","orcid":"0000-0002-9380-1688","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jørgen Arendt","key":"jensenjørgenarendtpau","last":"Jensen","locid":"e197c9fc-743f-4736-8d06-3825897e0989","name":"Jensen, Jørgen Arendt","orcid":"0000-0002-7896-3136","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1109/ultsym.2014.0425","eisbn":["9781479970490"],"isbn":["9781479970490"],"issn":["19485719"],"pages":"1714-1717","publisher":"IEEE Computer Society Press","series":"IEEE International Ultrasonics Symposium, IUS","status":"p","title":"IEEE International Ultrasonics Symposium, IUS"},"review":"Peer Reviewed","scoID":["2-s2.0-84910091484"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-7e30d7cb-dd29-424e-936e-f3a36905e028","ku-97a3ac5f-92a7-47ad-b9bb-10fbd2d7f62a"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Accuracy and Sources of Error for an Angle Independent Volume Flow Estimator","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-086.73-035487","year":"2014","yearsub":"2014"}
{"abstract":"Initiation of cancer investigations in general practice Background Close to 90% of all cancers are diagnosed because the patient presents symptoms and signs. Of these patients, 85% initiate the diagnostic pathway in general practice. Therefore, the initiation of a diagnostic pathway in general practice becomes extremely important. On average, a general practitioner (GP) is involved in 7500 consultations each year, and in the diagnostic process of 8-10 incident cancers. One half of cancer patients consult their GP with either general symptoms, which are not indicative of cancer, or vague and non-specific symptoms. The other half present with what the GP assess as alarm symptoms. Three months prior to diagnosis, patients who are later diagnosed with cancer have twice as many GP consultations than a comparable reference population. Thus the complex diagnostic process in general practice requires the GP to react on very different and vague symptoms to ensure early cancer diagnosis. To enable earlier cancer diagnosis, we need much more knowledge and a better understanding of the initiation of cancer-specific tests and investigations in general practice. Aim To investigate how, how often and on which background investigation for suspected cancer is initiated in general practice. Methods Participating Danish GPs will fill in an electronic questionnaire after random consultations. A total of 70,000 consultations will be included. Perspectives The results will show how often and why GPs suspect cancer, how they perform the initial investigations and whether this process can be supported and optimised. This insight is crucial in order to improve the diagnostic pathway.","author_count":5,"contributors":["Jensen, Jacob Reinholdt","Møller, Henrik","Thomsen, Janus Laust","Christensen, Morten Bondo","Vedsted, Peter"],"cuid":["S01-000.00-162451"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"pop","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"und","rtype":["clu"],"sorti":"cancer investigation in general practice","src":["au"],"src-code":["DI-U-AU"],"type":"dco","type-grp":["all","pub"]},"id":"S01-000.00-162451","ids":["au-3a0da49b-01de-49d1-b232-331f651fdb28"],"lang":"English","level":"Popular","mra":["Medical Science"],"noi":["Local-1-1-2B2676A54F67E96B9C217E1B144F7B59"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Public Health, Department of Public Health - Forskningsenheden for Almen Praksis"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jacob Reinholdt","key":"jensenpau","last":"Jensen","locid":"b306232c-d66a-47ec-8315-619d14d14af3","name":"Jensen, Jacob Reinholdt","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Henrik","key":"møllerpau","last":"Møller","locid":"0ece6c31-06ba-4864-945e-6f562db152ff","name":"Møller, Henrik","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Janus Laust","key":"thomsenpau","last":"Thomsen","locid":"938ae281-3eff-4638-9a0e-ced7dc4be1c1","name":"Thomsen, Janus Laust","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Morten Bondo","key":"christensenpau","last":"Christensen","locid":"b40aa4d7-4e95-4e8a-bef8-e7602ddabb82","name":"Christensen, Morten Bondo","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Peter","key":"vedstedpau","last":"Vedsted","locid":"bb00d9e7-866c-4f04-8e3b-a71c913c39b0","name":"Vedsted, Peter","orcid":"0000-0003-2113-5599","rank":5,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Undetermined","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-3a0da49b-01de-49d1-b232-331f651fdb28"],"src":["AU Aarhus University"],"title":"Cancer Investigation in General Practice","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-162451","year":"2014","yearsub":"2014"}
{"abstract":"The last decade’s advancements in computer technology have facilitated a growing interest in the development of interactive sports-training equipment. This development has provided athletes and coaches with measurement and training tools, with performance analysis or skill improvement as purpose. However, most of these tools are created with a single goal, either to measure or train, and are often used and tested in very controlled settings. In this paper, we present an interactive football-training platform, called Football Lab, featuring sensor- mounted rebounders as well as audio-visual feedback. Football Lab enables the creation of novel training games, which aim to improve players’ technical skills, and simultaneously function as a tool for measuring player performance and development over time. A logging of the Football Lab was conducted through 92 weeks, where the platform was available for the general public, analysis of a subset of the 20.000 games played in the period are discussed. Moreover, the paper contains a discussion covering challenges in data collection, transferability issues for interactive training equipment, as well as examples of experiments conducted with the platform. Finally, directions for future research within the area of interactive training equipment are proposed.","author_count":5,"contributors":["Jensen, Mads Møller","Grønbæk, Kaj","Thomassen, Nikolaj","Andersen, Jacob","Nielsen, Jesper"],"cuid":["S01-000.00-190284"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GTS","DI-OT","DI-U"],"level3":{"GTS":["DI-GTS-ALL","DI-GTS-ALX"],"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-GTS-ALX","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"interactive football training based on rebounders with hit position sensing and audio visual feedback","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://iacss.org/fileadmin/user_upload/IJCSS_FullPaper/Vol13_2014_Ed1/IJCSS-Volume13_2014_Edition1_Jensen.pdf","version":"Other Version"},"id":"S01-000.00-190284","identifier":[{"id":"84902531232","type":"scopus"}],"ids":["au-6ac9cc00-64ee-4eac-84f2-3c9e7be935fc"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-9CFB2660B874E20731A0413F91CA43F4"],"oa_link":[{"access":"oa","type":"rem","url":"http://www.iacss.org/index.php?id=146","version":"Other Version"},{"access":"oa","type":"rem","url":"http://iacss.org/fileadmin/user_upload/IJCSS_FullPaper/Vol13_2014_Ed1/IJCSS-Volume13_2014_Edition1_Jensen.pdf","version":"Other Version"}],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Computer Science"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1},{"affno":"3","key":"alexandra institute","l2":"DI-GTS","l2n":"GTS Institutes","l3":"DI-GTS-ALX","l3nn":"Alexandra Institute","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Alexandra Institute","namevar":["Alexandra Instituttet A/S"],"nora_code":"DI-GTS-ALX","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Mads Møller","key":"jensenpau","last":"Jensen","locid":"40358716-217e-41cc-bdab-91e75d7db60b","name":"Jensen, Mads Møller","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kaj","key":"grønbækpau","last":"Grønbæk","locid":"c7b908c7-ad69-4b60-bfb2-f6d7f490bb4f","name":"Grønbæk, Kaj","orcid":"0000-0002-3752-6714","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Nikolaj","key":"thomassenpau","last":"Thomassen","name":"Thomassen, Nikolaj","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Jacob","key":"andersenpau","last":"Andersen","locid":"6a2eb103-1f3b-49e2-b413-aec23fffdd7e","name":"Andersen, Jacob","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jesper","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Jesper","rank":5,"rolecode":"pau"}],"pub":{"issn":["16844769"],"issue":"1, part 2","journal":"International Journal of Computer Science in Sport","pages":"57-68","publisher":"Sciendo","status":"p","title":"International Journal of Computer Science in Sport","volume":"13"},"review":"Peer Reviewed","scoID":["2-s2.0-84902531232"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All GTS Institutes","All Miscellaneous","All Universities","DI-ALL","DI-GTS","DI-GTS-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","GTS Institutes","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-6ac9cc00-64ee-4eac-84f2-3c9e7be935fc"],"src":["AU Aarhus University"],"title":"Interactive Football-Training Based on Rebounders with Hit Position Sensing and Audio-Visual Feedback","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-190284","year":"2014","yearsub":"2014"}
{"abstract":"A 65-year-old female patient suffered biventricular failure due to severe lymphoid myocarditis. Mechanical circulatory support was established with peripheral arterial-venous extracorporeal membrane oxygenation (AV-ECMO). The left ventricle was relieved by subclavian Impella 5.0. AV-ECMO was weaned with the use of only Impella 5.0 until the 17th day of use, whereupon Impella was phased out. This case report illustrates the use-fulness of combined peripheral VA-ECMO with subclavian Impella 5.0 with the prospect of single use of the subclavian Impella 5.0 until cardiac recovery thereby avoiding central cannulation.","author_count":6,"contributors":["Hansen, Lars Nikolaj","Fabrin, Anja","Jensen, Marianne Kjær","Schmidt, Henrik","Junker, Anders","Møller, Jacob Eifer"],"cuid":["S01-000.00-640801"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"mekanisk kredsløbsstøtte ved hjælp af cirkulationspumpe anlagt gennem vena subclavia hos en patient med akut hjertesvigt","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85040639723","version":"Other Version"},"id":"S01-000.00-640801","identifier":[{"id":"25294330","type":"pmid"},{"id":"85040639723","type":"scopus"}],"ids":["sdu-ebff7437-a9f7-4477-89dd-5bb256b50240"],"lang":"Danish","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-826D3EB5E1A039598FAD82B46CE7F161"],"oai":{"class":"Blocked","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Anaesthesiology and Intensive Care (Odense)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Lars Nikolaj","key":"hansenpau","last":"Hansen","locid":"683ef875-194e-4520-8e85-207a671c109d","name":"Hansen, Lars Nikolaj","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anja","key":"fabrinpau","last":"Fabrin","locid":"2ea5ab5f-dcce-4df3-9f4c-31f99b1bcf4a","name":"Fabrin, Anja","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Marianne Kjær","key":"jensenpau","last":"Jensen","locid":"050f3ec3-6e7b-4fa4-81f5-e82039666e0b","name":"Jensen, Marianne Kjær","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik","key":"schmidtpau","last":"Schmidt","locid":"9789920f-4b31-4f28-8211-97afced9d61e","name":"Schmidt, Henrik","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders","key":"junkerpau","last":"Junker","locid":"6264f415-f938-426e-97fe-34dd6a53301a","name":"Junker, Anders","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jacob Eifer","key":"møllerpau","last":"Møller","locid":"5e4d3cb6-b0a0-4541-aea1-30e73f7c10b8","name":"Møller, Jacob Eifer","orcid":"0000-0003-2873-5845","rank":6,"rolecode":"pau"}],"pmid":["25294330"],"pub":{"issn":["00415782","13994174"],"issn_org":["00415782"],"issue":"39","journal":"Ugeskrift for Læger","pages":"2-3","publisher":"Lægeforeningen","status":"p","title":"Ugeskrift for Læger","volume":"176"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-ebff7437-a9f7-4477-89dd-5bb256b50240"],"src":["SDU University of Southern Denmark"],"title":"Mekanisk kredsløbsstøtte ved hjælp af cirkulationspumpe anlagt gennem vena subclavia hos en patient med akut hjertesvigt","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-640801","year":"2014","yearsub":"2014"}
{"abstract":"Vector velocity imaging using the Transverse Oscillation (TO) approach has recently been FDA approved for linear array transducers on a commercial platform. It can now be used clinically for studying the complex flow at e.g. bifurcations, valves, and the heart in real time. Several clinical examples from venous flow to rotational flow in the heart will be shown. The technique is also being further developed and adapted for convex and phased array probes, for spectral velocity estimation, pressure estimation, and for three dimensional velocity tensor imaging. It is shown how the methods are optimized using Field II simulations along with several examples of their performance.","author_count":6,"contributors":["Jensen, Jørgen Arendt","Pihl, Michael Johannes","Olesen, Jacob Bjerring","Møller Hansen, Peter","Lindskov Hansen, Kristoffer","Bachmann Nielsen, Michael"],"cuid":["S01-000.00-336619"],"event":{"end":"2013-02-14","place":"Lake Buena Vista, us","start":"2013-02-09","title":"SPIE Medical Imaging 2013","year":"2013"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Medical ultrasound","Transverse oscillation","Vector velocity imaging"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-HO-CAP","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"new developments in vector velocity imaging using the transverse oscillation approach","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1117/12.2013701","version":"Other Version"},"id":"S01-000.00-336619","identifier":[{"id":"84878418690","type":"scopus"}],"ids":["dtu-6b4828ad-f80e-4860-ac30-d39c3e10c67f"],"keyword":["Medical Ultrasound","Transverse oscillation","Vector velocity imaging"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-450EDBF0079BD2123F1F8B5DA621A739"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1117/12.2013701","version":"Other Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/55238022/New_Developments_in_Vector_Velocity.pdf","version":"Other Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Centers, Center for Fast Ultrasound Imaging","Technical University of Denmark, Department of Electrical Engineering","Technical University of Denmark, Department of Electrical Engineering, Biomedical Engineering"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital Herlev and Gentofte"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jørgen Arendt","key":"jensenpau","last":"Jensen","locid":"e197c9fc-743f-4736-8d06-3825897e0989","name":"Jensen, Jørgen Arendt","orcid":"0000-0002-7896-3136","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Michael Johannes","key":"pihlpau","last":"Pihl","locid":"efb04be2-6e73-4643-94c3-5b37126d55b0","name":"Pihl, Michael Johannes","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jacob Bjerring","key":"olesenpau","last":"Olesen","locid":"024aaa55-d5a4-4763-8004-b2fb701dfd2b","name":"Olesen, Jacob Bjerring","orcid":"0000-0002-5169-1644","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Peter","key":"møllerhansenpau","last":"Møller Hansen","name":"Møller Hansen, Peter","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Kristoffer","key":"lindskovhansenpau","last":"Lindskov Hansen","name":"Lindskov Hansen, Kristoffer","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Michael","key":"bachmannnielsenpau","last":"Bachmann Nielsen","name":"Bachmann Nielsen, Michael","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1117/12.2013701","publisher":"SPIE - International Society for Optical Engineering","status":"p","subtitle":"Medical Imaging 2013: Ultrasonic Imaging, Tomography, and Therapy","title":"Proceedings of SPIE","volume":"8675"},"review":"Peer Reviewed","scoID":["2-s2.0-84878418690"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-6b4828ad-f80e-4860-ac30-d39c3e10c67f"],"src":["DTU Technical University of Denmark"],"title":"New Developments in Vector Velocity Imaging using the Transverse Oscillation Approach","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-336619","year":"2013","yearsub":"2013"}
{"abstract":"The 5'-AMP-activated protein kinase (AMPK) is considered \"a metabolic master-switch\" in skeletal muscle reducing ATP- consuming processes whilst stimulating ATP regeneration. Within recent years, AMPK has also been proposed as a potential target to attenuate insulin resistance, although the exact role of AMPK is not well understood. Here we hypothesized that mice lacking a2AMPK activity in muscle would be more susceptible to develop insulin resistance associated with ageing alone or in combination with high fat diet. Young (~4 month) or old (~18 month) wild type and muscle specific a2AMPK kinase-dead mice on chow diet as well as old mice on 17 weeks of high fat diet were studied for whole body glucose homeostasis (OGTT, ITT and HOMA-IR), insulin signaling and insulin-stimulated glucose uptake in muscle. We demonstrate that high fat diet in old mice results in impaired glucose homeostasis and insulin stimulated glucose uptake in both the soleus and extensor digitorum longus muscle, coinciding with reduced insulin signaling at the level of Akt (pSer473 and pThr308), TBC1D1 (pThr590) and TBC1D4 (pThr642). In contrast to our hypothesis, the impact of ageing and high fat diet on insulin action was not worsened in mice lacking functional a2AMPK in muscle. It is concluded that a2AMPK deficiency in mouse skeletal muscle does not cause muscle insulin resistance in young and old mice and does not exacerbate obesity-induced insulin resistance in old mice suggesting that decreased a2AMPK activity does not increase susceptibility for insulin resistance in skeletal muscle.","author_count":13,"contributors":["Frøsig, Christian","Jensen, Thomas Elbenhardt","Jeppesen, Jacob","Pehmøller, Christian","Treebak, Jonas T.","Maarbjerg, Stine Just","Kristensen, Jonas Møller","Sylow, Lykke","Alsted, Thomas Junker","Schjerling, Peter","Kiens, Bente","Wojtaszewski, Jørgen","Richter, Erik A."],"cuid":["S01-000.00-432857"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"ampk and insulin action responses to ageing and high fat diet","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/120591235/journal.pone.0062338.pdf","version":"Published Version"},"id":"S01-000.00-432857","identifier":[{"id":"23671593","type":"pmid"},{"id":"84877089184","type":"scopus"},{"id":"PMC3645997","type":"pmcid"}],"ids":["ku-41f014cb-a379-4682-b890-af29dc483793"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-02697F2761CC23D9B382D521F480481C"],"oa_link":[{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/120591235/journal.pone.0062338.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1371/journal.pone.0062338","version":"Other Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Nutrition, Exercise and Sports, The August Krogh Section for Molecular Physiology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Christian","key":"frøsigpau","last":"Frøsig","locid":"c4105a37-7498-4f25-8de2-6f3c2cd1ed24","name":"Frøsig, Christian","orcid":"0000-0001-9302-9328","rank":1,"rolecode":"pau"},{"affno":"1","first":"Thomas Elbenhardt","key":"jensenpau","last":"Jensen","locid":"861af484-eb17-43a5-bbab-3d4f553a4537","name":"Jensen, Thomas Elbenha