name":"Region of Southern Denmark","namevar":["Odense University Hospital"],"nora_code":"DI-HO-SDR","used":1}],"person":[{"affno":"1 2","first":"Camilla Fuchs","key":"andersenpau","last":"Andersen","name":"Andersen, Camilla Fuchs","rank":1,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Massar","key":"omarpau","last":"Omar","locid":"3a6641e9-a451-482c-a139-b60841705f94","name":"Omar, Massar","orcid":"0000-0002-9634-3889","rank":2,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Julie Hempel","key":"larsenpau","last":"Larsen","locid":"750e6fe3-4c0c-4940-bfa9-7159856181ef","name":"Larsen, Julie Hempel","orcid":"0000-0002-2326-5736","rank":3,"rolecode":"pau"},{"affno":"1 2","first":"Caroline","key":"kistorppau","last":"Kistorp","locid":"42328645-d772-4f53-9f70-438ff40291b9","name":"Kistorp, Caroline","orcid":"0000-0002-3019-6775","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Christian","key":"tuxenpau","last":"Tuxen","name":"Tuxen, Christian","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Finn","key":"gustafssonpau","last":"Gustafsson","name":"Gustafsson, Finn","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lars","key":"køberpau","last":"Køber","name":"Køber, Lars","rank":7,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Mikael Kjær","key":"poulsenpau","last":"Poulsen","locid":"a8da3614-e99d-403f-933f-f5dfab3976af","name":"Poulsen, Mikael Kjær","orcid":"0000-0003-4051-7197","rank":8,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jan Christian","key":"brøndpau","last":"Brønd","locid":"da4ecea2-2b7f-4027-9859-416024dca432","name":"Brønd, Jan Christian","orcid":"0000-0001-6718-3022","rank":9,"rolecode":"pau"},{"affno":"3 2","corresponding":null,"first":"Jacob Eifer","key":"møllerpau","last":"Møller","locid":"5e4d3cb6-b0a0-4541-aea1-30e73f7c10b8","name":"Møller, Jacob Eifer","orcid":"0000-0003-2873-5845","rank":10,"rolecode":"pau"},{"affno":"2 1","first":"Morten","key":"schoupau","last":"Schou","locid":"48fa6ec9-1941-4566-b931-14b0cc8cbae3","name":"Schou, Morten","rank":11,"rolecode":"pau"},{"affno":"2 1","first":"Jesper","key":"jensenpau","last":"Jensen","locid":"e9d2d407-3550-4e0e-a0da-a9770d60e5a0","name":"Jensen, Jesper","rank":12,"rolecode":"pau"}],"pmid":["39209211"],"pub":{"doi":"10.1016/j.ahj.2024.08.017","issn":["00028703","10976744"],"issn_org":["00028703"],"journal":"American Heart Journal","pages":"14-23","publisher":"Elsevier","status":"p","title":"American Heart Journal","volume":"278"},"review":"Peer Reviewed","scoID":["2-s2.0-85203841382"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-79d3b19f-e61f-43fe-bfbd-93dee2005a45","sdu-e7014d0a-fce3-4933-87c2-02d71a607cfe"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Accelerometer-measured physical activity in patients with heart failure and reduced ejection fraction : Determinants and relationship with patient-reported health status","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.06-793797","year":"2024","yearsub":"2024"}
{"abstract":"PURPOSE: Invasive mechanical ventilation (IMV) is widely used in patients with cardiogenic shock following acute myocardial infarction (AMICS), but evidence to guide practice remains sparse. We sought to evaluate trends in the rate of IMV utilization, applied settings, and short term-outcome of a contemporary cohort of AMICS patients treated with IMV according to out-of-hospital cardiac arrest (OHCA) at admission. METHODS: Consecutive AMICS patients receiving IMV in an intensive care unit (ICU) at two tertiary centres between 2010 and 2017. Data were analysed in relation to OHCA. RESULTS: A total of 1274 mechanically ventilated AMICS patients were identified, 682 (54%) with OHCA. Frequency of IMV increased during the study period, primarily due to higher occurrence of OHCA admissions. Among 566 patients with complete ventilator data, positive-end-expiratory pressure, inspired oxygen fraction, and minute ventilation during the initial 24 h in ICU were monitored. No differences were observed between 30-day survivors and non-survivors with OHCA. In non-OHCA, these ventilator requirements were significantly higher among 30-day non-survivors (P for all<0.05), accompanied by a lower PaO2/FiO2 ratio (median 143 vs. 230, P < 0.001) and higher arterial lactate levels (median 3.5 vs. 1.5 mmol/L, P < 0.001) than survivors. Physiologically normal PaO2 and pCO2 levels were achieved in all patients irrespective of 30-day survival and OHCA status. CONCLUSION: In the present contemporary cohort of AMICS patients, physiologically normal blood gas values were achieved both in OHCA and non-OHCA in the early phase of admission. However, increased demand of ventilatory support was associated with poorer survival only in non-OHCA patients.","author_count":12,"contributors":["Povlsen, Amalie Ling","Helgestad, Ole Kristian Lerche","Josiassen, Jakob","Christensen, Steffen","Højgaard, Henrik Frederiksen","Kjærgaard, Jesper","Hassager, Christian","Schmidt, Henrik","Jensen, Lisette Okkels","Holmvang, Lene","Møller, Jacob Eifer","Ravn, Hanne Berg"],"cuid":["S02-100.00-735362"],"filters":{"added":"2024-08","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corresponding_author":["Povlsen, Amalie Ling"],"keyword":["Acute myocardial infarction","Aged","Aged 80 and over","Cardiac arrest","Cardiogenic shock","Cohort Studies","Denmark epidemiology","Female","Humans","Intensive Care Units trends","Intensive care unit","Invasive mechanical ventilation","Male","Middle Aged","Myocardial Infarction complications","OHCA","Out of Hospital Cardiac Arrest therapy","Respiration Artificial methods","Retrospective Studies","Shock Cardiogenic therapy"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-SDR","DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"invasive mechanical ventilation in cardiogenic shock complicating acute myocardial infarction a contemporary danish cohort analysis","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.ijcard.2024.131910","version":"Published Version"},"id":"S02-100.00-735362","identifier":[{"id":"38423479","type":"pmid"},{"id":"85186658355","type":"scopus"}],"ids":["au-fd25fdea-444c-44d8-ac34-e256b12494fa","sdu-178cd062-7404-4f78-9f97-7ce6b0f31064"],"keyword":["Acute myocardial infarction","Aged","Aged, 80 and over","Cardiac arrest","Cardiogenic shock","Cohort Studies","Denmark/epidemiology","Female","Humans","Intensive Care Units/trends","Intensive care unit","Invasive mechanical ventilation","Male","Middle Aged","Myocardial Infarction/complications","OHCA","Out-of-Hospital Cardiac Arrest/therapy","Respiration, Artificial/methods","Retrospective Studies","Shock, Cardiogenic/therapy"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-D062807610050246974A2856ECCF64BC"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/259855658/1-s2.0-S0167527324003565-main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.ijcard.2024.131910","version":"Published Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Anaesthesiology and Intensive Care (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Odense University Hospital"],"nora_code":"DI-HO-SDR","used":1},{"affno":"4","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Cardiology, RHG"],"nora_code":"DI-U-AU","used":1},{"affno":"5","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1}],"person":[{"affno":"1 2 3","corresponding":null,"first":"Amalie Ling","key":"povlsenpau","last":"Povlsen","locid":"085efe15-36a1-434b-9b9e-b4341cd84a0d","name":"Povlsen, Amalie Ling","orcid":"0000-0001-6044-8841","rank":1,"rolecode":"pau"},{"affno":"3 4 1 5","corresponding":null,"first":"Ole Kristian Lerche","key":"helgestadpau","last":"Helgestad","locid":"14e9d183-bd4f-440b-b56f-c28d41855fe9","name":"Helgestad, Ole Kristian Lerche","orcid":"0000-0003-3847-8758","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jakob","key":"josiassenpau","last":"Josiassen","name":"Josiassen, Jakob","rank":3,"rolecode":"pau"},{"affno":"4 5","corresponding":null,"country":"dk","first":"Steffen","key":"christensenpau","last":"Christensen","locid":"43687f4c-bb2b-418b-9051-39c0d5135c05","name":"Christensen, Steffen","orcid":"0000-0001-6149-7186","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Henrik Frederiksen","key":"højgaardpau","last":"Højgaard","locid":"98c46706-c074-48d3-a62c-d3fb83d08ab2","name":"Højgaard, Henrik Frederiksen","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jesper","key":"kjærgaardpau","last":"Kjærgaard","name":"Kjærgaard, Jesper","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Christian","key":"hassagerpau","last":"Hassager","name":"Hassager, Christian","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Henrik","key":"schmidtpau","last":"Schmidt","locid":"9789920f-4b31-4f28-8211-97afced9d61e","name":"Schmidt, Henrik","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lisette Okkels","key":"jensenpau","last":"Jensen","locid":"b78c452e-5a69-41fe-ba49-0096c84d1d4d","name":"Jensen, Lisette Okkels","orcid":"0000-0002-4838-2429","rank":9,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lene","key":"holmvangpau","last":"Holmvang","name":"Holmvang, Lene","rank":10,"rolecode":"pau"},{"affno":"2 1","corresponding":null,"first":"Jacob Eifer","key":"møllerpau","last":"Møller","locid":"5e4d3cb6-b0a0-4541-aea1-30e73f7c10b8","name":"Møller, Jacob Eifer","orcid":"0000-0003-2873-5845","rank":11,"rolecode":"pau"},{"affno":"2 1","corresponding":null,"first":"Hanne Berg","key":"ravnpau","last":"Ravn","locid":"25de7650-3dc1-4594-b758-9c36f6de6306","name":"Ravn, Hanne Berg","orcid":"0000-0003-4702-5195","rank":12,"rolecode":"pau"}],"pmid":["38423479"],"pub":{"doi":"10.1016/j.ijcard.2024.131910","issn":["01675273","18741754"],"issn_org":["01675273"],"journal":"International Journal of Cardiology","paperid":"131910","publisher":"Elsevier Ireland Ltd","status":"p","title":"International Journal of Cardiology","volume":"405"},"review":"Peer Reviewed","scoID":["2-s2.0-85186658355"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["au-fd25fdea-444c-44d8-ac34-e256b12494fa","sdu-178cd062-7404-4f78-9f97-7ce6b0f31064"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"Invasive mechanical ventilation in cardiogenic shock complicating acute myocardial infarction : A contemporary Danish cohort analysis","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-735362","year":"2024","yearsub":"2024"}
{"abstract":"Background and importance Traumatic cardiac arrest is associated with poor prognosis, and timely evidence-based treatment is paramount for increasing survival rates. Physician-staffed helicopter emergency medical service use in major trauma has demonstrated improved outcomes. However, the sparsity of data highlights the necessity for a comprehensive understanding of the epidemiology of traumatic cardiac arrest. Objectives The primary objective of the present study was to evaluate survival and return of spontaneous circulation (ROSC) and to investigate the characteristics of patients with traumatic cardiac arrest assessed by the Danish HEMS. Design This was a population-based cohort study based on data from the Danish helicopter emergency medical service database. Settings and participants The study included all patients assessed by the Danish helicopter emergency medical services between 2016 and 2021. Outcome measures and analysis Data were analysed using descriptive statistics, non-parametric testing and logistic regression analyses. Descriptive analysis of prehospital interventions included cardiopulmonary resuscitation, defibrillation, airway management, administration of blood products, and thoracic decompression. The primary outcome was 30-day survival, and the key secondary outcome was prehospital ROSC. Main results A total of 223 patients with TCA were included. The median age was 54 years (IQR 34-68), and the majority were males. Overall, 23% of patients achieved prehospital ROSC, and the 30-day survival rate was 4%. Factors associated with an increased likelihood of ROSC were an initial shockable cardiac rhythm, odds ratio (OR) of 3.78 (95% CI 1.33-11.00) and endotracheal intubation, OR 7.10 (95% CI 2.55-22.85). Conclusion This study highlights the low survival rates observed among patients with traumatic cardiac arrest assessed by helicopter emergency medical services. The findings support the positive impact of an initial shockable cardiac rhythm and endotracheal intubation in improving the likelihood of ROSC. The study contributes to the limited literature on traumatic cardiac arrests assessed by physician-staffed helicopter emergency services. Finally, the findings emphasise the need for further research to understand and improve outcomes in this subgroup of cardiac arrest.","author_count":10,"contributors":["Wolthers, Signe Amalie","Breindahl, Niklas","Jensen, Theo Walther","Holgersen, Mathias Geldermann","Møller, Thea Palsgaard","Blomberg, Stig Nikolaj Fasmer","Andersen, Lars Bredevang","Mikkelsen, Søren","Steinmetz, Jacob","Christensen, Helle Collatz"],"cuid":["S03-100.00-756090"],"filters":{"added":"2024-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":3,"corresponding_author":["Wolthers, Signe Amalie"],"keyword":["EMS","Epidemiology","HEMS","traumatic cardiac arrest"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-OTH","DI-HO-SDR","DI-HO-ZEA"],"OT":["Prehospital Center"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-OTH","DI-HO-SDR","DI-HO-ZEA","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"prehospital interventions and outcomes in traumatic cardiac arrest a population based cohort study using the danish helicopter emergency medical services data","src":["au","ku","sdu"],"src-code":["DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1097/MEJ.0000000000001108","version":"Published Version"},"id":"S03-100.00-756090","identifier":[{"id":"PMC11356682","type":"pmcid"},{"id":"38100645","type":"pmid"},{"id":"85186735883","type":"scopus"}],"ids":["au-bf374a31-fe8a-45d4-9417-6bb28e740a94","ku-94184c12-cf4a-40d5-8060-83abd1edc14a","sdu-5cff08e6-292a-4e1d-87cc-c02ad1c66dc9"