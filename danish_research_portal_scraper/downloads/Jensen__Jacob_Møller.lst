{"author_count":7,"contributors":["Hendriksen, Rene S.","Kunstmann, Lars","Jensen, Jacob Dyring","Karlsmose, Susanne","Jensen, Arne Bent","Dahl Larsen, Heidi Kristina","Aarestrup, Frank Møller"],"cuid":["S01-000.00-312608"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-PR-OTH","DI-U-DTU"]},"review":"nr","rtype":["clu"],"sorti":"ringtesten for identifikation og resistensbestemmelse af mastitispatogener 000000002011","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/6324381/prod21323790712683.Ringtest-rapport_2011_WEB.pdf","version":"Published Version"},"id":"S01-000.00-312608","ids":["dtu-1ac63c30-0ab0-42f9-a87e-af0b4c456c1a"],"lang":"Danish","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-FB5A7606CBF05BDB77B78BAF02AA5615"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/6324381/prod21323790712683.Ringtest-rapport_2011_WEB.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Food Institute","Technical University of Denmark, National Food Institute, Division of Microbiology and Risk Assessment"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic",