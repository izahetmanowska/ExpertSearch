-0002-4838-2429","rank":7,"rolecode":"pau"},{"affno":"1 4","corresponding":null,"first":"Anne Langhoff","key":"thuesenpau","last":"Thuesen","locid":"2da71e82-156a-4326-ae9d-ad19516efee0","name":"Thuesen, Anne Langhoff","orcid":"0000-0003-4447-8607","rank":8,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Anne Vinggaard","key":"christensenpau","last":"Christensen","name":"Christensen, Anne Vinggaard","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ola","key":"ekholmpau","last":"Ekholm","locid":"b59d640e-8087-46d7-8284-5a45e6ebd03f","name":"Ekholm, Ola","orcid":"0000-0002-5563-7098","rank":10,"rolecode":"pau"},{"affno":"5 6","corresponding":null,"country":"dk","first":"Rikke","key":"molspau","last":"Mols","locid":"3e2aef4e-9f9f-433c-91c5-e30cee4aa5dc","name":"Mols, Rikke Elmose","name_org":"Mols, Rikke","rank":11,"rolecode":"pau"},{"affno":"7 8","corresponding":null,"first":"Charlotte Brun","key":"thoruppau","last":"Thorup","locid":"90bf6dfd-49cd-42dc-a945-c22f8561c981","name":"Thorup, Charlotte Brun","rank":12,"rolecode":"pau"},{"affno":"1 4","corresponding":null,"first":"Britt","key":"borregaardpau","last":"Borregaard","locid":"ca3a0f85-e4e4-42dc-98f0-a7ddfe619020","name":"Borregaard, Britt","orcid":"0000-0003-2702-0231","rank":13,"rolecode":"pau"}],"pmid":["32857268"],"pub":{"doi":"10.1007/s11136-020-02573-8","issn":["09629343"],"issue":"11","journal":"Quality of Life Research","pages":"3017-3029","publisher":"Springer","status":"p","title":"Quality of Life Research","volume":"29"},"review":"Peer Reviewed","scoID":["2-s2.0-85089982142"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-cbe7c719-d841-49b0-a869-003a4c74bcda","au-f38af06e-0a99-469b-85fd-75078e535bde","ku-8c9100ab-7381-4344-85fc-5fc7fa3f98e8","sdu-1765d5df-2aa9-4a13-99d9-91c74749199e"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"The association between self-reported health status and adverse events : a comparison among coronary artery bypass grafting (CABG) versus percutaneous coronary intervention (PCI)","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-100.00-009776","year":"2020","yearsub":"2020"}
{"abstract":"Although survival rates among patients with coronary artery disease have increased since the introduction of treatment with percutaneous coronary intervention, PCI, the effect of psychological factors such as symptoms of anxiety and depression on adverse outcomes are sparsely described.The objective of the current study was to investigate the association between symptoms of anxiety and depression and 1-year mortality after PCI.A national cross-sectional survey at hospital discharge (responders, n=3,366) with register-based follow-up among patients having undergone elective or emergency PCI. Mental health was measured using the Hospital Anxiety and Depression Scale, HADS, and divided into symptoms of anxiety (HADS-A) and symptoms of depression (HADS-D). The association between mental health (HADS-A and HADS-D) and 1-year all-cause mortality were investigated with Cox Proportional Hazard models with time to death as the underlying time scale. The results are presented as hazard ratios (HR) with 95\\CI) and adjusted for sex, age and Tu-comorbidity score.At discharge, 32\\HADS-A ≥8) and 19\\HADS-D ≥8). After one year, the mortality rate among patients being alive at discharge was 2.1\\cause mortality did not differ among patients reporting symptoms of anxiety compared to patients without symptoms of anxiety (2.3\\.9\\ p=0.454), whereas all-cause mortality was higher among patients reporting symptoms of depression compared to those, who did not (4.3\\.6\\ p≤0.001).In the regression analyses, symptoms of anxiety (HADS-A ≥8) was not associated with 1-year mortality (HR 1.16 95\\.70–1.92); however, symptoms of depression was (HADS-D ≥8, HR 2.27 95\\.38–3.73, adjusted analyses). Based on the continuous scores of HADS-D, a one-point increase in scores was associated with a 12\\-year mortality (HR 1.12 95\\.05–1.18) (Figure 1).After PCI, nearly one-third of patient report symptoms of anxiety and one-fifth symptoms of depression. Symptoms of anxiety was not associated with 1-year mortality, whereas symptoms of depression increased the risk of 1-year mortality.Figure 1Type of funding source: None","author_count":16,"contributors":["Borregaard, Britt","Nielsen, Stine Nørris","Lassen, Jens Flensted","Jensen, Lisette Okkels","Thrysøe, Lars","Berg, Selina Kikkenborg","Møller, Jacob Eifer","Christensen, A. V.","Ekholm, Ola","Mols, Rikke Elmose","Thorup, Charlotte Brun","Rasmussen, T. B."],"cuid":["S02-092.50-003157"],"event":{"end":"2020-09-01","place":"Virtuel","start":"2020-08-29","title":"ESC Congress 2020 - The Digital Experience","year":"2020"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corpau":["DenHeart group"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-U-AAU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"symptoms of depression at discharge after pci are associated with an increased risk of 000000000001 year mortality findings from the national denheart study","src":["aau","sdu"],"src-code":["DI-U-AAU","DI-U-SDU"],"type":"dca","type-grp":["all","pub"]},"id":"S02-092.50-003157","ids":["aau-40447f93-940a-42fa-9ca5-3edbd40b5631","sdu-e3841da3-03cb-4477-bc50-400778b737bf"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-B9161D615BBB6D2A50E9B794C3C1CAD9"],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of