au"},{"affno":"3","country":"dk","first":"S.","key":"sarkarsubirpau","last":"Sarkar","locid":"7a12f440-f513-4395-8387-d4f2434a8a35","name":"Sarkar, Subir","name_org":"Sarkar, S.","orcid":"0000-0002-3542-858X","rank":48,"rolecode":"pau"},{"affno":"3","first":"T.","key":"stuttardthomassimonpau","last":"Stuttard","locid":"7cfef799-4ff6-4242-98e6-60b3b0222516","name":"Stuttard, Thomas Simon","name_org":"Stuttard, T.","orcid":"0000-0001-7944-279X","rank":50,"rolecode":"pau"}],"pub":{"doi":"10.1103/physrevd.97.072009","issn":["15502368","24700010"],"issn_org":["24700010"],"issue":"7","journal":"Physical Review D","paperid":"072009","status":"p","title":"Physical Review D","volume":"97"},"review":"Peer Reviewed","scoID":["2-s2.0-85046737475"],"search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-371df422-2529-43bc-bd07-7b0ff9010feb"],"src":["KU University of Copenhagen"],"title":"Search for nonstandard neutrino interactions with IceCube DeepCore","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-426211","year":"2018","yearsub":"2018"}
{"abstract":"Individual response to stress is correlated with neuroticism and is an important predictor of both neuroticism and the onset of major depressive disorder (MDD). Identification of the genetics underpinning individual differences in response to negative events (stress-sensitivity) may improve our understanding of the molecular pathways involved, and its association with stress-related illnesses. We sought to generate a proxy for stress-sensitivity through modelling the interaction between SNP allele and MDD status on neuroticism score in order to identify genetic variants that contribute to the higher neuroticism seen in individuals with a lifetime diagnosis of depression compared to unaffected individuals. Meta-analysis of genome-wide interaction studies (GWIS) in UK Biobank (N = 23,092) and Generation Scotland: Scottish Family Health Study (N = 7,155) identified no genome-wide significance SNP interactions. However, gene-based tests identified a genome-wide significant gene, ZNF366, a negative regulator of glucocorticoid receptor function implicated in alcohol dependence (p = 1.48x10-7; Bonferroni-corrected significance threshold p < 2.79x10-6). Using summary statistics from the stress-sensitivity term of the GWIS, SNP heritability for stress-sensitivity was estimated at 5.0%. In models fitting polygenic risk scores of both MDD and neuroticism derived from independent GWAS, we show that polygenic risk scores derived from the UK Biobank stress-sensitivity GWIS significantly improved the prediction of MDD in Generation Scotland. This study may improve interpretation of larger genome-wide association studies of MDD and other stress-related illnesses, and the understanding of the etiological mechanisms underpinning stress-sensitivity.","author_count":46,"contributors":["Arnau-Soler, Aleix","Adams, Mark J.","Hayward, Caroline","Thomson, Pippa A.","Porteous, David","Campbell, Archie","Smith, Blair H.","Black, Corri","Padmanabhan, Sandosh","McIntosh, Andrew M.","Wray, Naomi R.","Ripke, Stephan","Mattheisen, Manuel","Trzaskowski, Maciej","Byrne, Enda M.","Abdellaoui, Abdel","Agerbo, Esben","Air, Tracy M.","Andlauer, Till F.M.","Bacanu, Silviu Alin","Bækvad-Hansen, Marie","Beekman, Aartjan T.F.","Bigdeli, Tim B.","Binder, Elisabeth B.","Blackwood, Douglas H.R.","Bryois, Julien","Buttenschøn, Henriette N.","Bybjerg-Grauholm, Jonas","Cai, Na","Castelao, Enrique","Christensen, Jane Hvarregaard","Clarke, Toni Kim","Coleman, Jonathan R.I.","Colodro-Conde, Lucía","Couvy-Duchesne, Baptiste","Craddock, Nick","Crawford, Gregory E.","Davies, Gail","Deary, Ian J.","Degenhardt, Franziska","Derks, Eske M.","Direk, Nese","Dolan, Conor V.","Hansen, Christine Søholm","Hansen, Thomas F.","Krogh, Jesper","Pedersen, Carsten Bøcker","Pedersen, Marianne Giørtz","Nordentoft, Merete","Werge, Thomas"],"cuid":["S02-086.08-023688"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["America, North","Asia, Middle East","Europe, EU","Europe, Non-EU","Nordic","OECD","Oceania"],"corpau":["Generation Scotland","Major Depressive Disorder Working Group of the Psychiatric Genomics Consortium"],"country":["Australia","Germany","Netherlands","Sweden","Switzerland","Turkey","United Kingdom","United States"],"glorg":["All Global Affiliations","Cardiff University","Charité – Universitätsmedizin Berlin","Dokuz Eylul University","Duke University","Emory University","Erasmus University Rotterdam","European Bioinformatics Institute","Harvard University","Karolinska Institutet","King's College London","Max Planck Institute of Psychiatry","Munich Cluster for Systems Neurology","Queensland Institute of Medical Research","University of Adelaide","University of Bonn","University of Edinburgh","University of Lausanne","University of Queensland","Virginia Commonwealth University","Virginia Institute for Psychiatric and Behavior Genetics","Vrije Universiteit Amsterdam","Wellcome Sanger Institute"],"keyword":["Alcohol use","Anxiety","Association analysis","Genetic epidemiology","Life events","Metaanalysis","Neuroticism","Perceived stress","Personality"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-NP","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP"],"NP":["DI-NP-ALL","DI-NP-LUND"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-NP-LUND","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"genome wide interaction study of a proxy for stress sensitivity and its prediction of major depressive disorder","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1371/journal.pone.0209160","version":"Published Version"},"id":"S02-086.08-023688","identifier":[{"id":"PMC6301766","type":"pmcid"},{"id":"30571770","type":"pmid"},{"id":"85058923883","type":"scopus"}],"ids":["au-977777fc-f037-4312-8756-fa5d8c9edd40","ku-e622d015-b3ec-4a70-a2f0-57e48a008598"],"keyword":["ALCOHOL-USE","ANXIETY","ASSOCIATION ANALYSIS","GENETIC EPIDEMIOLOGY","LIFE EVENTS","METAANALYSIS","NEUROTICISM","PERCEIVED STRESS","PERSONALITY","PTP4A1-PHF3-EYS VARIANTS"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-064B4E87E0285397389787B8B4729948"],"oa_link":[{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/215516760/journal.pone.0209160.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"rem","url":"https://journals.plos.org/plosone/article/file?id=10.1371/journal.pone.0209160&type=printable","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1371/journal.pone.0209160","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","country":"gb","key":"university of 