a, A.","rank":2022,"rolecode":"pau"}],"pub":{"doi":"10.3847/2041-8213/aa91c9","issn":["20418205","20418213"],"issn_org":["20418205"],"issue":"2","journal":"Astrophysical Journal Letters","paperid":"L12","publisher":"IOP Publishing","status":"p","title":"Astrophysical Journal Letters","title_org":"The Astrophysical Journal Letters","volume":"848"},"review":"Peer Reviewed","scoID":["2-s2.0-85037171677"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-502d6e10-ff8c-4af2-9a7d-233c34d9e838","ku-fd9ee2fa-2c24-4f69-b9de-f0a93567a432"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Multi-messenger Observations of a Binary Neutron Star Merger","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-080.67-034387","year":"2017","yearsub":"2017"}
{"abstract":"Patients with neuropathic pain are heterogeneous in etiology, pathophysiology, and clinical appearance. They exhibit a variety of pain-related sensory symptoms and signs (sensory profile). Different sensory profiles might indicate different classes of neurobiological mechanisms, and hence subgroups with different sensory profiles might respond differently to treatment. The aim of the investigation was to identify subgroups in a large sample of patients with neuropathic pain using hypothesis-free statistical methods on the database of 3 large multinational research networks (German Research Network on Neuropathic Pain (DFNS), IMI-Europain, and Neuropain). Standardized quantitative sensory testing was used in 902 (test cohort) and 233 (validation cohort) patients with peripheral neuropathic pain of different etiologies. For subgrouping, we performed a cluster analysis using 13 quantitative sensory testing parameters. Three distinct subgroups with characteristic sensory profiles were identified and replicated. Cluster 1 (sensory loss, 42%) showed a loss of small and large fiber function in combination with paradoxical heat sensations. Cluster 2 (thermal hyperalgesia, 33%) was characterized by preserved sensory functions in combination with heat and cold hyperalgesia and mild dynamic mechanical allodynia. Cluster 3 (mechanical hyperalgesia, 24%) was characterized by a loss of small fiber function in combination with pinprick hyperalgesia and dynamic mechanical allodynia. All clusters occurred across etiologies but frequencies differed. We present a new approach of subgrouping patients with peripheral neuropathic pain of different etiologies according to intrinsic sensory profiles. These 3 profiles may be related to pathophysiological mechanisms and may be useful in clinical trial design to enrich the study population for treatment responders.","author_count":22,"contributors":["Baron, Ralf","Maier, Christoph","Attal, Nadine","Binder, Andreas","Bouhassira, Didier","Cruccu, Giorgio","Finnerup, Nanna B","Haanpää, Maija","Hansson, Per","Hüllemann, Philipp","Jensen, Troels S","Freynhagen, Rainer","Kennedy, Jeffrey D","Magerl, Walter","Mainka, Tina","Reimer, Maren","Rice, Andrew S C","Segerdahl, Märta","Serra, Jordi","Sindrup, Søren Hein","Sommer, Claudia","Tölle, Thomas","Vollert, Jan","Treede, Rolf-Detlef"],"cuid":["S02-099.35-022254"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","Nordic","OECD"],"corpau":["German Neuropathic Pain Research Network (DFNS), and the EUROPAIN and NEUROPAINconsortia.","on behalf of the German Neuropathic Pain Research Network (DFNS), and the EUROPAIN and NEUROPAIN#consortia"],"country":["Sweden"],"glorg":["All Global Affiliations","Karolinska Institute"],"keyword":["Adult","Aged","Clinical trials","Cluster Analysis","Cohort Studies","Databases Factual statistics numerical data","Epidemiology","Europe epidemiology","Female","Humans","Hyperalgesia physiopathology","International Cooperation","Male","Middle Aged","Neuralgia epidemiology","Neuropathic pain","Pain Measurement","Pain Threshold physiology","QST","Sensory signs","Surveys and Questionnaires"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-LUND"],"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-PR-LUND","DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"peripheral neuropathic pain a mechanism related organizing principle based on sensory profiles","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1097/j.pain.0000000000000753","version":"Published Version"},"id":"S02-099.35-022254","identifier":[{"id":"27893485","type":"pmid"},{"id":"PMC5266425","type":"pmcid"},{"id":"85018196890","type