:232,"rolecode":"pau"},{"affno":"","first":"Chao","key":"tianchaopau","last":"Tian","name":"Tian, Chao","rank":233,"rolecode":"pau"},{"affno":"","first":"Joyce Y.","key":"tungjoyceypau","last":"Tung","name":"Tung, Joyce Y.","rank":234,"rolecode":"pau"},{"affno":"","first":"Vladimir","key":"vacicvladimirpau","last":"Vacic","name":"Vacic, Vladimir","rank":235,"rolecode":"pau"},{"affno":"","first":"Catherine H.","key":"wilsoncatherinehpau","last":"Wilson","name":"Wilson, Catherine H.","rank":236,"rolecode":"pau"}],"pmid":["30197049"],"pub":{"doi":"10.1016/j.bpsc.2018.07.006","issn":["24519022"],"issue":"1","journal":"Biological Psychiatry: Cognitive Neuroscience and Neuroimaging","pages":"91-100","status":"p","title":"Biological Psychiatry: Cognitive Neuroscience and Neuroimaging","volume":"4"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-951c2c30-e9e5-40f2-a360-1848dce5ca70"],"src":["KU University of Copenhagen"],"title":"Association of Whole-Genome and NETRIN1 Signaling Pathway–Derived Polygenic Risk Scores for Major Depressive Disorder and White Matter Microstructure in the UK Biobank","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-748663","year":"2019","yearsub":"2019"}
{"abstract":"Design har meget at byde på, når det handler om omstilling og fornyelse af den offentlige sektor. Designtankegangen bliver derfor ofte bragt i spil, når det offentlige vil genopfinde sig selv i mødet med borgerne. Co-design er en særlig designpraksis, som involverer brugere og andre interessenter i designprocessen. Co-design interesserer sig for, hvordan designforslag kan fremme demokratisk medborgerskab og sætte nye perspektiver på aktuelle samfundsspørgsmål. I dette kapitel reflekterer professor MSO Thomas Binder og professor MSO Eva Brandt fra Det Kongelige Danske Kunstakademis Skoler for Arkitektur, Design og Konservering over co-design som designpraksis i offentlige samarbejdsprocesser. De argumenterer for, at designere kan medvirke til at skabe innovation gennem demokratiske designeksperimenter, der hviler på myndigt medborgerskab og direkte deltagelse. Forfatterne præsenterer, hvad de forstår ved design og giver eksempler på nogle af de udfordringer co-designere møder i samskabelse og i de nye partnerskaber mellem borgere og offentlige.","author_count":4,"contributors":["Binder, Thomas","Brandt, Eva"],"cuid":["S01-000.00-127947"],"event":{"end":"2018-11-28","place":"Copenhagen, dk","start":"2018-11-28","title":"Work &amp; Talk: Ledelse og samskabelse","year":"2018"},"filters":{"added":"2023-01","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Ledelse","Offentlige sektor","Samskabelse"],"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-ART"],"level3":{"ART":["DI-ART-ALL","DI-ART-RDKA"]},"level3all":["DI-ART-RDKA"]},"review":"nr","rtype":["clu"],"sorti":"hvad har design med samskabelse at gøre","src":["arkc"],"src-code":["DI-ART-RDKA"],"type":"dba","type-grp":["all","pub"]},"id":"S01-000.00-127947","ids":["arkc-b3e9ea48-187b-419e-b3bb-d07d461281fb"],"keyword":["Nej","ledelse","offentlige sektor","samskabelse","vidensfestival"],"lang":"Danish","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-0E590C6D788B264C4631FA2E286D4E75"],"org":[{"affno":"1","key":"royal danish academy architecture design conservation","l2":"DI-ART","l2n":"Artistic Higher Education Institutions","l3":"DI-ART-RDKA","l3nn":"Royal Danish Academy - Architecture, Design, Conservation","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Royal Danish Academy - Architecture, Design, Conservation","namevar":["Royal Danish Academy - Architecture, Design, Conservation, Royal Danish Academy - Design, Institute of Design and Visual Interaction","Royal Danish Academy - Architecture, Design, Conservation, Royal Danish Academy - Design, Institute of Design and Visual Interaction, CODE - Centre for Codesign","The Royal Danish Academy of Fine Arts, Schools of Architecture, Design and Conservation"],"nora_code":"DI-ART-RDKA","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Thomas","key":"binderpau","last":"Binder","locid":"c74da6b3-52d3-4ac5-9078-0921bcae572c","name":"Binder, Thomas","orcid":"0000-0001-8244-1798","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Eva","key":"brandtpau","last":"Brandt","locid":"4186dd98-15a8-4d67-a630-5d0875e85920","name":"Brandt, Eva","rank":2,"rolecode":"pau"},{"affno":"","first":"Morten","key":"kuskfoggaardpedh","last":"Kusk Foggaard","name":"Kusk Foggaard, Morten","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Manon","key":"dejonghpedh","last":"de Jongh","name":"de Jongh, Manon","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["9788771585728"],"pages":"327-355","place":"Dansk Psykologisk Forlag","status":"p","title":"Ledelse og samskabelse i den offentlige sektor"},"review":"No Review","search":{"DAF":["All Artistic Higher Education Institutions","All Danish Affiliations","Artistic Higher Education Institutions","DI-ALL","DI-ART","DI-ART-ALL"],"PST":["Published"]},"sid":["arkc-b3e9ea48-187b-419e-b3bb-d07d461281fb"],"src":["Royal Danish Academy - Architecture, Design, Conservation"],"title":"Hvad har design med samskabelse at gøre?","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-127947","year":"2018","yearsub":"2018"}
