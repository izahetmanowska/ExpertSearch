first":"Anna C.","key":"mavromanolipau","last":"Mavromanoli","name":"Mavromanoli, Anna C.","rank":23,"rolecode":"pau"},{"affno":"9","corresponding":null,"first":"Claude","key":"jabbourpau","last":"Jabbour","name":"Jabbour, Claude","rank":24,"rolecode":"pau"},{"affno":"10","corresponding":null,"first":"Irene","key":"langpau","last":"Lang","name":"Lang, Irene","rank":25,"rolecode":"pau"},{"affno":"11","corresponding":null,"first":"Francis","key":"couturaudpau","last":"Couturaud","name":"Couturaud, Francis","rank":26,"rolecode":"pau"},{"affno":"12","corresponding":null,"first":"Christian","key":"heisspau","last":"Heiss","name":"Heiss, Christian","rank":27,"rolecode":"pau"},{"affno":"13","corresponding":null,"first":"Harald","key":"binderpau","last":"Binder","name":"Binder, Harald","rank":28,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Stavros","key":"konstantinidespau","last":"Konstantinides","name":"Konstantinides, Stavros","rank":29,"rolecode":"pau"}],"pmid":["40442449"],"pub":{"doi":"10.1007/s11239-025-03110-5","issn":["09295305","1573742X"],"issn_org":["09295305"],"issue":"6","journal":"Journal of Thrombosis and Thrombolysis","pages":"689-698","paperid":"e3521","publisher":"Springer","status":"p","title":"Journal of Thrombosis and Thrombolysis","volume":"58"},"review":"Peer Reviewed","scoID":["2-s2.0-105006823637"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities"],"PST":["Published"]},"sid":["au-d3ae0c85-8a55-4e75-8036-7bc13c613e95"],"src":["AU Aarhus University"],"title":"Enhanced recovery and abbreviated length of anticoagulation for thromboprophylaxis after primary hip arthroplasty rationale and design of the ENABLE-hip trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-816710","year":"2025","yearsub":"2025"}
{"abstract":"For designers and design researchers, the ecological crisis and the quest for sustainability do not only mean a reorientation in what design provides in terms of products, services, and systems. It also demands a change in how design is done, acknowledging that sustainable design and use have to co-evolve through speculative dialogues addressing a radical re-configuration of both the crafts of making and the crafts of use. This paper is an attempt to revisit one of the key tenants of contemporary design practice, the prototype, to find a language of prototyping that can sensitize us to what evolves when engaging with future sustainable practices through such speculative dialogues. In this paper, we dive into three co-explorative design engagements of a research project on sustainable knitwear design to further explore what we call prototyping dialogues. Through these accounts of prototyping dialogues, we argue that prototypes are outcomes of the dialogues rather than distinct proposals from the designer to be iteratively presented and evaluated. Furthermore, we suggest that the prototype, as an outcome, comes about through a dialectic between different modes of engagement which we term the 'experiential' and the 'experimental', having both material, performative, and speculative manifestations in the collaborative encounters.","author_count":2,"contributors":["Ravnløkke, Louise","Binder, Thomas"],"cuid":["S01-000.00-706546"],"event":{"end":"2023-06-20","place":"Milan, it","start":"2023-06-19","title":"Design Research Society Special Interest Group on Experiential Knowledge (EKSIG)","year":"2023"},"filters":{"added":"2024-02","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Prototypes","Prototyping","Sustainability","collaborative encounters"],"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-ART"],"level3":{"ART":["DI-ART-ALL","DI-ART-DSKD"]},"level3all":["DI-ART-DSKD"]},"review":"pr","rtype":["clu"],"sorti":"prototyping dialogues","src":["arkk"],"src-code":["DI-ART-DSKD"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://www.eksig2023.polimi.it/assets/EKSIG-Proceedings.pdf","version":"Published Version"},"id":"S01-000.00-706546","ids":["arkk-99ca875b-0a6b-4724-9e98-8e0507bd98db"],"keyword":["No","collaborative encounters","design engagement","prototypes","prototyping","sustainability"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-7B9C2023769F859847350118E629B1B2"],"oa_link":[{"access":"oa","type":"rem","url":"https://www.eksig2023.polimi.it/assets/EKSIG-Proceedings.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"design school kolding","l2":"DI-ART","l2n":"Artistic Higher Education Institutions","l3":"DI-ART-DSKD","l3nn":"Design School Kolding","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Design School Kolding","namevar":["Design School Kolding","Design School Kolding, Design for Planet - LAB for Sustainability and Design"],"nora_code":"DI-ART-DSKD","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Louise","key":"ravnløkkepau","last":"Ravnløkke","locid":"179a0131-e4e0-4be6-bfe9-706614fab55c","name":"Ravnløkke, Louise","orcid":"0000-0003-4872-5062","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Thomas","key":"binderpau","last":"Binder","name":"Binder, Thomas","rank":2,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Artistic Higher Education Institutions","All Danish Affiliations","Artistic Higher Education Institutions","DI-ALL","DI-ART","DI-ART-ALL"],"PST":["Published"]},"sid":["arkk-99ca875b-0a6b-4724-9e98-8e0507bd98db"],"src":["Design School Kolding"],"title":"Prototyping Dialogues","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-706546","year":"2023","yearsub":"2023"}
{"abstract":"Core-collapse supernovae are a promising potential high-energy neutrino source class. We test for correlation between seven years of IceCube neutrino data and a catalog containing more than 1000 core-collapse supernovae of types IIn and IIP and a sample of stripped-envelope supernovae. We search both for neutrino emission from individual supernovae as well as for combined emission from the whole supernova sample, through a stacking analysis. No significant spatial or temporal correlation of neutrinos with the cataloged supernovae was found. All scenarios were tested against the background expectation and together yield an overall p-value of 93%; therefore, they show consistency with the background only. The derived upper limits on the total energy emitted in neutrinos are 1.7 × 1048 erg for stripped-envelope supernovae, 2.8 × 1048 erg for type IIP, and 1.3 × 1049 erg for type IIn SNe, the latter disfavoring models with optimistic assumptions for neutrino production in interacting supernovae. We conclude that stripped-envelope supernovae and supernovae of type IIn do not contribute more than 14.6% and 33.9%, respectively, to the diffuse neutrino flux in the energy range of about [ 103-105] GeV, assuming that the neutrino energy spectrum follows a power-law with an index of −2.5. Under the same assumption, we can only constrain the contribution of type IIP SNe to no more than 59.9%. Thus, core-collapse supernovae of types IIn and stripped-envelope supernovae can both be ruled out as the dominant source of the diffuse neutrino flux under the given assumptions.","author_count":50,"contributors":["Abbasi, R.","Ackermann, M.","Adams, J.","Agarwalla, S. K.","Aguilar, J. A.","Ahlers, Markus Tobias","Alameddine, J. M.","Amin, N. M.","Andeen, K.","Anton, G.","Argüelles, C.","Ashida, Y.","Athanasiadou, S.","Axani, S. N.","Bai, X.","A. Balagopal, V.","Baricevic, M.","Barwick, S. W.","Basu, V.","Bay, R.","Beatty, J. J.","Becker, K. H.","Tjus, J. Becker","Beise, J.","Bellenghi, C.","BenZvi, S.","Berley, D.","Bernardini, E.","Besson, D. Z.","Binder, G.","Bindig, D.","Blaufuss, E.","Blot, S.","Bontempo, F.","Book, J. Y.","Meneguolo, C. Boscolo","Böser, S.","Botner, O.","Böttcher, J.","Bourbeau, Etienne","Braun, J.","Brinson, B.","Brostean-Kaiser, J.","Burley, R. T.","Busse, R. S.","Koskinen, D. Jason","Kozynets, Tetiana","Mead, James Vincent","Søgaard, Andreas","Stuttard, Thomas Simon"],"cuid":["S01-000.00-720147"],"filters":{"added":"2024-02","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Europe, EU","Nordic","OECD","Oceania"],"corpau":["Icecube Collaboration"],"country":["Australia","Belgium","Germany","Italy","New Zealand","Sweden","United States"],"glorg":["All Global Affiliations","Free University of Brussels","Friedrich-Alexander University Erlangen-Nürnberg","Georgia Institute of Technology","German Electron Synchrotron","Harvard University","Johannes Gutenberg University Mainz","Karlsruhe Institute of Technology","Loyola University Chicago","Marquette University","Ohio State University","RWTH Aachen University","Ruhr University Bochum","South Dakota School of Mines & Technology","TU Dortmund University","Technical University of Munich","University of Adelaide","University of California at Berkeley","University of California at Irvine","University of Canterbury","University of Delaware","University of Kansas","University of Maryland, College Park","University of Münster","University of Padua","University of Rochester","University of Wisconsin-Madison","University of Wuppertal","Uppsala University"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"constraining high energy neutrino emission from supernovae with icecube","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"