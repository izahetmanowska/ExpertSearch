78fee8","itu-19001ca3-5eee-4ad9-8b75-5402a274e26e"],"src":["ITU IT University of Copenhagen","Royal Danish Academy - Architecture, Design, Conservation"],"title":"SeniorInteraktion : Innovation gennem dialog","type":"Book","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-090.48-012428","year":"2012","yearsub":"2012"}
{"abstract":"Sociale medier giver mange muligheder for at danne og fastholde sociale netværk. Men hvordan indledes en dialog omkring mulighederne med teknologi og sociale medier, når for eksempel mobiltelefoner eller Facebook af mange seniorer bliver opfattet som forbeholdt børnebørnenes generation? Vi diskuterer designkonceptet SuperPrikker, som en måde at gøre dialogen og den fælles udforskning på en workshop konkret, håndgribelig og meningsfuld for deltagerene.","author_count":7,"contributors":["Foverskov, Maria","Brandt, Eva"],"cuid":["S01-000.00-126437"],"filters":{"added":"2023-01","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Brugerdreven innovation","Co design","Servicedesign","praksisbaseret designforskning"],"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-ART"],"level3":{"ART":["DI-ART-ALL","DI-ART-RDKA"]},"level3all":["DI-ART-RDKA"]},"review":"nr","rtype":["clu"],"sorti":"superprikker rekvisitter til at åbne dialog om sociale medier","src":["arkc"],"src-code":["DI-ART-RDKA"],"type":"dba","type-grp":["all","pub"]},"id":"S01-000.00-126437","ids":["arkc-30554bf4-4c3a-4e0c-bcf0-2b76c46626ea"],"keyword":["Co-design","Nej","Servicedesign","brugerdreven innovation","praksisbaseret designforskning"],"lang":"Danish","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-261B67590C5ADD55A9865551D2BAC3AB"],"org":[{"affno":"1","key":"royal danish academy architecture design conservation","l2":"DI-ART","l2n":"Artistic Higher Education Institutions","l3":"DI-ART-RDKA","l3nn":"Royal Danish Academy - Architecture, Design, Conservation","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Royal Danish Academy - Architecture, Design, Conservation","namevar":["The Royal Danish Academy of Fine Arts, Schools of Architecture, Design and Conservation, School of Design","The Royal Danish Academy of Fine Arts, Schools of Architecture, Design and Conservation, School of Design, Danish Centre for Design Research, DKDS"],"nora_code":"DI-ART-RDKA","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Maria","key":"foverskovpau","last":"Foverskov","locid":"89003506-4bb4-4682-9708-acbe77fc994b","name":"Foverskov, Maria","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Eva","key":"brandtpau","last":"Brandt","locid":"4186dd98-15a8-4d67-a630-5d0875e85920","name":"Brandt, Eva","rank":2,"rolecode":"pau"},{"affno":"","first":"Eva","key":"brandtpedh","last":"Brandt","name":"Brandt, Eva","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Pernille","key":"fjerritslevmortensenpedh","last":"Fjerritslev Mortensen","name":"Fjerritslev Mortensen, Pernille","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Lone","key":"malmborgpedh","last":"Malmborg","name":"Malmborg, Lone","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Thomas","key":"binderpedh","last":"Binder","name":"Binder, Thomas","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Tomas","key":"sokolerpedh","last":"Sokoler","name":"Sokoler, Tomas","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"edition":"1","isbn":["9788778303042"],"pages":"62-70","place":"Det Kongelige Danske Kunstakademis Skoler for Arkitektur, Design og Konservering","status":"p","subtitle":"Innovation gennem Dialog","title":"SeniorInteraktion","volume":"1"},"review":"No Review","search":{"DAF":["All Artistic Higher Education Institutions","All Danish Affiliations","Artistic Higher Education Institutions","DI-ALL","DI-ART","DI-ART-ALL"],"PST":["Published"]},"sid":["arkc-30554bf4-4c3a-4e0c-bcf0-2b76c46626ea"],"src":["Royal Danish Academy - Architecture, Design, Conservation"],"title":"SuperPrikker: Rekvisitter til at åbne dialog om sociale medier","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-126437","year":"2012","yearsub":"2012"}
{"abstract":"Vi skal ikke skabe innovation for de ældre, men for mennesker, som er ældre nogen gange. I brugerdreven innovation er definitionen af brugerne mere end noget andet det, som sætter rammerne for innovationsprocessen. Men hvad betyder det egentlig at være bruger? Når vi taler om innovation for og med seniorer, skal vi hverken definere brugerne ved deres eventuelle skavanker eller ved deres livsstil. I stedet må vi opsøge situationer og lade hverdagsfællesskaber være kernen i design til det gode (senior)liv.","author_count":6,"contributors":["Brandt, Eva"],"cuid":["S01-000.00-127341"],"filters":{"added":"2023-01","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Co design","Praksisfællesskaber","Social innovation","praksisbaseret designforskning","ældre"],"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-ART"],"level3":{"ART":["DI-ART-ALL","DI-ART-RDKA"]},"level3all":["DI-ART-RDKA"]},"review":"nr","rtype":["clu"],"sorti":"ældre til tider men ikke altid","src":["arkc"],"src-code":["DI-ART-RDKA"],"type":"dba","type-grp":["all","pub"]},"id":"S01-000.00-127341","ids":["arkc-8277620a-d4dc-4a59-a0cd-0011b5ddc923"],"keyword":["Nej","Praksisfællesskaber","co-design","praksisbaseret designforskning","social innovation","ældre"],"lang":"Danish","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-E955BEDC97B9A7CE8F87D3A0477A8566"],"org":[{"affno":"1","key":"royal danish academy architecture design conservation","l2":"DI-ART","l2n":"Artistic Higher Education Institutions","l3":"DI-ART-RDKA","l3nn":"Royal Danish Academy - Architecture, Design, Conservation","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Royal Danish Academy - Architecture, Design, Conservation","namevar":["The Royal Danish Academy of Fine Arts, Schools of Architecture, Design and Conservation, School of Design","The Royal Danish Academy of Fine Arts, Schools of Architecture, Design and Conservation, School of Design, CO-design","The Royal Danish Academy of Fine Arts, Schools of Architecture, Design and Conservation, School of Design, Center for Teori og Metode","The Royal Danish Academy of Fine Arts, Schools of Architecture, Design and Conservation, School of Design, Danish Centre for Design Research, DKDS"],"nora_code":"DI-ART-RDKA","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Eva","key":"brandtpau","last":"Brandt","locid":"4186dd98-15a8-4d67-a630-5d0875e85920","name":"Brandt, Eva","rank":1,"rolecode":"pau"},{"affno":"","first":"Eva","key":"brandtpedh","last":"Brandt","name":"Brandt, Eva","rank":2,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Pernille","key":"fjerritslevmortensenpedh","last":"Fjerritslev Mortensen","name":"Fjerritslev Mortensen, Pernille","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Lone","key":"malmborgpedh","last":"Malmborg","name":"Malmborg, Lone","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Thomas","key":"binderpedh","last":"Binder","name":"Binder, Thomas","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Tomas","key":"sokolerpedh","last":"Sokoler","name":"Sokoler, Tomas","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["9788778303042"],"pages":"39-42","place":"Det kongelige danske Kunstakademis Skoler for Arkitektur, Design og Konservering","status":"p","subtitle":"Innovation gennem dialog","title":"SeniorInteraktion"},"review":"No Review","search":{"DAF":["All Artistic Higher Education Institutions","All Danish Affiliations","Artistic Higher Education Institutions","DI-ALL","DI-ART","DI-ART-ALL"],"PST":["Published"]},"sid":["arkc-8277620a-d4dc-4a59-a0cd-0011b5ddc923"],"src":["Royal Danish Academy - Architecture, Design, Conservation"],"title":"Ældre til tider - men ikke altid","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-127341","year":"2012","yearsub":"2012"}
{"abstract":"Participatory design is not one approach but a proliferating family of design practices that hosts many design agendas and comes with a varied set of toolboxes. In this chapter we will give examples of toolboxes with the ambition to show that there is a richness of tools and techniques available that may be combined, adapted and extended to form the basis for yet new PD practices. It is shown how the making of things, the telling of stories and the enactment of possible futures together provide the basis for forming a temporary community in which the new can be envisioned. The introduction frames tools and techniques within participatory design and describes participatory design as various practices of participation. The following sections give examples of how designers and non-designers participate in PD practices through activities focusing on telling, making and enacting. The final section reflects on present and future challenges. We present a wide selection of tools and techniques for PD, describing how they support participants in making, telling and enacting aspects of future design. The aim is to stimulate further proliferation of formats and procedures that may bring PD to new design challenges and to new designer/user communities. Our claim is not that tools and techniques have to be applied rigorously. Instead we suggest that sensitivity to the coherence of making, telling and enacting provides sufficient grounding for designers (and non-designers) to make the tools and techniques relevant for whatever participatory action they are involved in. Thin includes being aware of what is accomplished as particular tools and techniques become part of specific participatory design practices. Finding out how these in combination can create formats and procedures that can create engagement, a common image of the vision or PD development task, and last but not least, create ownership for the results.","author_count":5,"contributors":["Brandt, Eva","Binder, Thomas","Sanders, Elizabeth B.-N."],"cuid":["S01-000.00-128753"],"filters":{"added":"2023-01","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","Ohio State University"],"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-ART"],"level3":{"ART":["DI-ART-ALL","DI-ART-RDKA"]},"level3all":["DI-ART-RDKA"]},"review":"pr","rtype":["clu"],"sorti":"tools and techniques ways to engage telling making and enacting","src":["arkc"],"src-code":["DI-ART-RDKA"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84999071449","version":"Other Version"},"id":"S01-000.00-128753","identifier":[{"id":"84999071449","type":"scopus"}],"ids":["arkc-f6ebd2dd-7a22-4f3a-8429-d52410c4b1fe"],"keyword":["No"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-0D56F7724EA24F7A07BA7C299D6681D2"],"org":[{"affno":"1","key":"royal danish academy architecture design conservation","l2":"DI-ART","l2n":"Artistic Higher Education Institutions","l3":"DI-ART-RDKA","l3nn":"Royal Danish Academy - Architecture, Design, Conservation","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Royal Danish Academy - Architecture, Design, Conservation","namevar":["The Royal Danish Academy of Fine Arts, Schools of Architecture, Design and Conservation, School of Design","The Royal Danish Academy of Fine Arts, Schools of Architecture, Design and Conservation, School of Design, Danish Centre for Design Research, DKDS"],"nora_code":"DI-ART-RDKA","used":1},{"affno":"2","country":"us","key":"ohio state university","loc":["United States","America, North","OECD"],"name":"Ohio State University","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Eva","key":"brandtpau","last":"Brandt","locid":"4186dd98-15a8-4d67-a630-5d08