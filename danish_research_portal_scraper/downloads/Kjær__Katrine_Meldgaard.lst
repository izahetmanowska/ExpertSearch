e Coster","name":"de Coster, Marjan","rank":5,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Ana Paula","key":"lafairepau","last":"Lafaire","name":"Lafaire, Ana Paula","rank":6,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Margot","key":"leclairpau","last":"Leclair","name":"Leclair, Margot","rank":7,"rolecode":"pau"},{"affno":"7","corresponding":null,"first":"Allison","key":"pullenpau","last":"Pullen","name":"Pullen, Allison","rank":8,"rolecode":"pau"},{"affno":"8","corresponding":null,"first":"Anne","key":"theunissenpau","last":"Theunissen","name":"Theunissen, Anne","rank":9,"rolecode":"pau"},{"affno":"9","corresponding":null,"first":"Alistair","key":"thomsonpau","last":"Thomson","name":"Thomson, Alistair","rank":10,"rolecode":"pau"},{"affno":"10","corresponding":null,"first":"Maryse","key":"tremblaypau","last":"Tremblay","name":"Tremblay, Maryse","rank":11,"rolecode":"pau"},{"affno":"11","corresponding":null,"first":"Camilla","key":"quentalpau","last":"Quental","name":"Quental, Camilla","rank":12,"rolecode":"pau"}],"pub":{"doi":"10.1111/gwao.12964","issn":["09686673","14680432"],"issn_org":["09686673"],"issue":"4","journal":"Gender, Work and Organization","pages":"1429-1449","publisher":"Wiley-Blackwell","status":"p","title":"Gender, Work and Organization","volume":"30"},"review":"Peer Reviewed","scoID":["2-s2.0-85148626026"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-a10f30c4-479e-48a8-84e7-62881270a1d6"],"src":["ITU IT University of Copenhagen"],"title":"Feeling clumsy and curious. A collective reflection on using poetry as an unconventional method (at a conventional conference)","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-730184","year":"2023","yearsub":"2023"}
{"abstract":"This paper focuses on the experiences of self-identified fat women employees. Combining the works of Karen Barad and Sara Ahmed, we offer a feminist new materialist analysis of the production of difference in organizations related to size as an entanglement of bodies, discourses, organizational materials and affect. We show how our participants predominantly became shameful and a ‘bad fit’ within their jobs through the intra-action of their large bodies with obesity discourse and organizational materials such as chairs and workwear. Yet we also illustrate how some material-discursive entanglements offered situations where shame was circumvented, instead producing our participants as acceptable within their organizational context. Our research contributes to discussions on embodied normativities in organizations by taking these issues beyond the discursive realm and highlighting the importance of materiality and affect in ‘fitting in’ at work. We offer new theoretical pathways to explore differentiating practices by looking at shame as part of collective and affective histories of marginalization.","author_count":3,"contributors":["van Amsterdan, Noortje","van Eck, Dide","Kjær, Katrine Meldgaard"],"cuid":["S01-000.00-381844"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Netherlands"],"glorg":["All Global Affiliations","Radboud University Nijmegen","Utrecht University"],"keyword":["Affect","Difference","Feminist new materialism","Gender","Karen Barad","Sara Ahmed","Shame","fat embodiment"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"on not fitting in fat embodiment affect and organizational materials as differentiating agents","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1177/01708406221074162","version":"Published Version"},"id":"S01-000.00-381844","identifier":[{"id":"85126317708","type":"scopus"}],"ids":["itu-26076e5f-3301-4d86-a7a3-1c1c7500a812"],"keyword":["Karen Barad","Sara Ahmed","affect","difference","fat embodiment","feminist new materialism","gender","shame"],"lang":"Danish","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-50492B356EB411865F0A9887D1AC808D"],"oa_link":[{"access":"oa","type":"rem","url":"https://www.researchgate.net/profile/Noortje-Van-Amsterdam/publication/358347625_On_not_fitting_in_Fat_embodiment_affect_and_organizational_materials_as_differentiating_agents/links/61fce6fc4393577abe0d8c8e/On-Not-Fitting-In-Fat-embodiment-affect-and-organizational-materials-as-differentiating-agents.pdf","version":"Authors Final Version"},{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/101336642/Amsterdametal2022fatembodimentaffectmateriality.pdf","version":"Authors Final Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1177/01708406221074162","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"nl","key":"utrecht university","loc":["Netherlands","Europe, EU","OECD"],"name":"Utrecht University","used":1},{"affno":"2","country":"nl","key":"radboud university nijmegen","loc":["Netherlands","Europe, EU","OECD"],"name":"Radboud University Nijmegen","used":1},{"affno":"3","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","IT University of Copenhagen, Technologies in Practice, Technologies in Practice"],"nora_code":"DI-U-ITU","used"