itet, Faculty of Theology, Centre for African Studies - Technical area, Centre for African Studies"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"us","key":"data society","loc":["United States","America, North","OECD"],"name":"Data & Society","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Baki","key":"cakicipau","last":"Cakici","locid":"b614ac6f-eefa-44a3-8b9a-092b88d86d37","name":"Cakici, Baki","orcid":"0000-0002-1039-8177","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Alena","key":"thielpau","last":"Thiel","locid":"f240d002-893f-45bd-b9ad-6a6ddc015e40","name":"Thiel, Alena","orcid":"0000-0002-1092-1140","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Ranjit","key":"singhpau","last":"Singh","name":"Singh, Ranjit","rank":3,"rolecode":"pau"},{"affno":"","first":"Jessamy","key":"perriampedh","last":"Perriam","name":"Perriam, Jessamy","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Katrine","key":"meldgaardkjærpedh","last":"Meldgaard Kjær","name":"Meldgaard Kjær, Katrine","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1515/9783110787641-006","eisbn":["9783110787641"],"isbn":["9783110787603"],"issn":["27475689"],"pages":"93-108","publisher":"De Gruyter","series":"De Gruyter Contemporary Social Sciences","status":"p","subtitle":"Intersections, Implications and Interventions","title":"Digitalization in Practice:","volume":"14"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["itu-ded23bad-9c91-466a-a899-f0a890a9bfc0","ku-5c187140-c48b-4d10-a630-36adda8a2b75"],"src":["ITU IT University of Copenhagen","KU University of Copenhagen"],"title":"The politics of seamlessness: : a rights claims perspective on digital identification technologies","type":"Book Chapter","url