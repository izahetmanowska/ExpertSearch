:"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Arts, Danish School of Education, Danish School of Education - Educational Sociology, Emdrup","Aarhus University, Arts, Danish School of Education, Danish School of Education - Research Programme in Learning for Care, Sustainability and Health"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Katrine Meldgaard","key":"kjærpau","last":"Kjær","name":"Kjær, Katrine Meldgaard","rank":1,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"country":"dk","first":"Jonatan","key":"leerpau","last":"Leer","locid":"11a6fffa-6ac2-40bd-a9dd-45fa1f92f0e5","name":"Leer, Jonatan","orcid":"0000-0002-9068-8835","rank":2,"rolecode":"pau"}],"pub":{"publisher":"Syddansk Universitetsforlag","status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["aau-9429447a-26d5-48eb-96b2-ee724a37dc3d","au-bc61eba5-5a3d-4bf5-8b36-585864cc4539"],"src":["AAU Aalborg University","AU Aarhus University"],"title":"Food (temanummer af Kvinder, Køn og Forskning)","type":"Book","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-007177","year":"2015","yearsub":"2015"}
{"abstract":"In this article, we examine the ways in which the encountering of 'other' food cultures is played out in the two travelogue cooking shows Gordon's Great Escape and Jamie's Italian Escape. We investigate how the two protagonist chefs Jamie Oliver and Gordon Ramsay imagine, meet and evaluate the ‘other’ food cultures in these programs, paying special attention to how the encounter with the local Indian and Italian is imagined to be a gateway to an authentic and/or primitive experience. Our main argument is that despite Jamie and Gordon's ‘noble’ intentions and their ‘enlightened’ cosmopolitan approach to meeting the other (culinary culture), ultimately, their respective culinary adventures work to re-affirm a social hierarchy in their favor.","author_count":2,"contributors":["Leer, Jonatan","Kjær, Katrine Meldgaard"],"cuid":["S01-000.00-252883"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Authenticity","Food culture","Kultur","Køn","Othering","Seksualitet","Television"],"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"strange culinary encounters stranger fetichism in jamie s italian escape and gordon s great escape","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.au.dk/ws/files/112402196/Strange_culinary_encounters_stranger_fetichism_in_Jamie_s_Italian_escape_and_Gordon_s_great_escape_Postprint_2015.pdf","version":"Authors Final Version"},"id":"S01-000.00-252883","identifier":[{"id":"84943569875","type":"scopus"}],"ids":["au-d8603d46-e1e0-45b2-85b7-ddd8e5286638"],"keyword":["Authenticity","Kultur","Køn","Seksualitet","food culture","othering","television"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Global-Local-3-5-6D4522E5B470F186BE932C0D91964472"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.au.dk/ws/files/112402196/Strange_culinary_encounters_stranger_fetichism_in_Jamie_s_Italian_escape_and_Gordon_s_great_escape_Postprint_2015.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Humanities (HUM)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Arts, Danish School of Education, Danish School of Education - Research Programme in Learning for Care, Sustainability and Health"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jonatan","key":"leerpau","last":"Leer","locid":"c7fc0291-1c3e-44da-9910-3fe130094d25","name":"Leer, Jonatan","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Katrine Meldgaard","key":"kjærpau","last":"Kjær","name":"Kjær, Katrine Meldgaard","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.2752/175174415x14180391604648","issn":["15528014","17517443"],"issn_org":["15528014"],"issue":"2","journal":"Food, Culture & Society: An International Journal of Multidisciplinary Research","pages":"309-327","publisher":"Taylor and Francis Ltd.","status":"p","title":"Food, Culture & Society: An International Journal of Multidisciplinary Research","volume":"15"},"review":"Peer Reviewed","scoID":["2-s2.0-84943569875"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-d8603d46-e1e0-45b2-85b7-ddd8e5286638"],"src":["AU Aarhus University"],"title":"Strange culinary encounters: : stranger fetichism in \"Jamie's Italian escape\" and \"Gordon's great escape\"","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-252883","year":"2015","yearsub":"2015"}
{"abstract":"In this article, we examine the ways in which the encountering of “other” food cultures is played out in the two travelogue cooking shows Gordon’s Great Escape and Jamie’s Italian Escape. We investigate how the two protagonist chefs, Jamie Oliver and Gordon Ramsay, imagine, meet and evaluate the “other” food cultures in these programs, paying special attention to how the encounter with the local Indian and Italian is imagined to be a gateway to an authentic and/or primitive experience. Our main argument is that despite Jamie and Gordon’s “noble” intentions and their “enlightened” cosmopolitan approach to meeting the other (culinary culture), ultimately, their respective culinary adventures work to reaffirm a social hierarchy in their favor.","author_count":2,"contributors":["Leer, Jonatan","Kjær, Katrine Meldgaard"],"cuid":["S01-000.00-576001"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Authenticity","Cultural encounter","Food television","Jamie Oliver"],"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"strange culinary encounters stranger fetishism in jamie s italian escape and gordon s great escape","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.2752/175174415X14180391604648","version":"Other Version"},"id":"S01-000.00-576001","identifier":[{"id":"84943569875","type":"scopus"}],"ids":["sdu-09d36fef-b031-4ddf-a3f9-9dc52144ed51"],"keyword":["Authenticity","Cultural encounter","Food television","Gordon Ramsay","Jamie Oliver"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Global-Local-3-5-6D4522E5B470F186BE932C0D91964472"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.2752/175174415X14180391604648","version":"Other Version"}],"oai":{"class":"Realised","mra":["Humanities (HUM)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Humanities, Department for the Study of Culture","SDU, Faculty of Humanities, Department of Culture and Language, Cultural Studies"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jonatan","key":"leerpau","last":"Leer","name":"Leer, Jonatan","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Katrine Meldgaard","key":"kjærpau","last":"Kjær","locid":"de12158d-82f2-461a-af08-b9227d1cefef","name":"Kjær, Katrine Meldgaard","orcid":"0000-0001-7994-5186","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.2752/175174415x14180391604648","issn":["15289796"],"issue":"2","journal":"Food, Culture and Society","pages":"309-327","status":"p","title":"Food, Culture and Society","volume":"18"},"review":"Peer Reviewed","scoID":["2-s2.0-84943569875"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-09d36fef-b031-4ddf-a3f9-9dc52144ed51"],"src":["SDU University of Southern Denmark"],"title":"Strange Culinary Encounters : Stranger Fetishism in Jamie's Italian Escape and Gordon's Great Escape","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-576001","year":"2015","yearsub":"2015"}
{"abstract":"Food, Gender and Media – the Trinity of Bad Taste: Since she began working in the field in the mid-1980s, associate professor in media studies at Aarhus University Karen Klitgaard Povlsen has been one of most important scholars in the field of cultural food studies in Denmark. She is particularly interested in food in relation to gender and media, and has published widely on the subject. In this interview, she provides a Danish perspective on the study of food and gender, including a brief history of the area and her thoughts on its current status and potentials. Povlsen argues that while gender studies do not enjoy the same prominence today as they did in the 1970s and 1980s, food studies has gained terrain and offers new ways of doing innovative, intersectional analyses of identity and everyday life in contemporary mediatized societies.","author_count":2,"contributors":["Kjær, Katrine Meldgaard","Leer, Jonatan"],"cuid":["S02-095.83-026172"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"food gender and media the trinity of bad taste a conversation with karen klitgaard povlsen","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/129081563/Food_Gender_and_Media._The_Trinity_of_Bad_Taste.pdf","version":"Published Version"},"id":"S02-095.83-026172","ids":["au-b99c0984-9a8e-49ee-84b8-a6d16ac42371","sdu-9e594f3c-8344-488f-9925-e7a8d83dc474"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Local-1-2-08E5DB5120E4CEA5743FDE0CDD49BD54"],"oa_link":[{"access":"oa","type":"lo