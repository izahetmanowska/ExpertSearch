es","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-e1f5737f-6ae7-47d8-9cb1-7992f06c6628"],"src":["ITU IT University of Copenhagen"],"title":"Køn i forskning: \"Det handler om at finde sig en støttende mand\"","type":"Newspaper Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384595","year":"2017"}
{"abstract":"This article presents a critical reading of American Grown, a cookbook/how-to gardening book published by Michelle Obama in 2012. The article argues that while American Grown may at first glance seem like a coffee table-style book about the 2010 planting of the White House kitchen garden, it should in fact be read as a piece of public health communication and a gastrogovernmental text born out of social panic over the contemporary obesity epidemic. Using insights from cultural food studies and critical obesity studies, the article presents the concept of gastrogovernmentality as an analytical tool to argue that the kitchen garden in American Grown acts as a public-personal space of social regulation, where certain types of social identities and behaviors are promoted as the “solution” to the obesity epidemic.","author_count":1,"contributors":["Kjær, Katrine Meldgaard"],"cuid":["S01-000.00-601964"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"1 contributor","cluster_size":1,"corresponding_author":["Kjær, Katrine Meldgaard"],"keyword":["Gardening","Michelle Obama","Obesity"],"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"planting these plants is special because they have been shared with us by the white house american grown s kitchen garden as a gastrogovernmental space","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85028543589","version":"Other Version"},"id":"S01-000.00-601964","identifier":[{"id":"85028543589","type":"scopus"}],"ids":["sdu-647504c3-1bbf-430d-950d-05cd77d3ab9e"],"keyword":["American Grown","Let's Move!","Michelle Obama","gardening","obesity"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Global-Local-2-4-2A6521B681829687275941D0DBF0FCA8"],"oai":{"class":"Blocked","mra":["Humanities (HUM)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Humanities, Department for the Study of Culture","SDU, Faculty of Humanities, Department of Culture and Language, Cultural Studies"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Katrine Meldgaard","key":"kjærpau","last":"Kjær","locid":"de12158d-82f2-461a-af08-b9227d1cefef","name":"Kjær, Katrine Meldgaard","orcid":"0000-0001-7994-5186","rank":1,"rolecode":"pau"}],"pub":{"doi":"10.1080/07409710.2017.1343066","issn":["07409710","15423484"],"issn_org":["07409710"],"issue":"3","journal":"Food and Foodways","pages":"215-227","publisher":"Taylor & Francis","status":"p","title":"Food and Foodways","volume":"25"},"review":"Peer Reviewed","scoID":["2-s2.0-85028543589"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-647504c3-1bbf-430d-950d-05cd77d3ab9e"],"src":["SDU University of Southern Denmark"],"title":"“Planting these plants is special because they have been shared with us by the White House” : American Grown's kitchen garden as a gastrogovernmental space","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-601964","year":"2017","yearsub":"2017"}
{"abstract":"Gammeldags forestillinger om kvinder og mænd lever i bedste velgående på de danske universiteter. Kvindelige forskerspirer bliver mødt med krav, som ikke gælder mandlige. Der er behov for at tænke en moderne familiepolitik og en aktiv ligestillingspolitik ind i forskningsverdenen.","author_count":3,"contributors":["Riis, Helle Bach","Mortensen, Maria","Meldgaard Kjær, Katrine"],"cuid":["S01-000.00-570638"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Forskning","Ulighed"],"level":"pop","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unknown external organisation"],"U":["DI-U-ALL","DI-U-RUC"]},"level3all":["DI-U-RUC"]},"review":"und","rtype":["clu"],"sorti":"vil du gerne være forsker så gift dig med en støttende mand","src":["ruc"],"src-code":["DI-U-RUC"],"type":"dna","type-grp":["all","pub"]},"id":"S01-000.00-570638","ids":["ruc-da2c46ff-498f-44e2-bc5b-a51f282a14eb"],"keyword":["forskning","ulighed"],"lang":"Danish","level":"Popular","mra":["Humanities"],"noi":["Local-1-1-FCF75CFDD9B53EA4B9F1C8340800D8E6"],"org":[{"affno":"1","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of Communication and Arts","Roskilde University, Department of Communication and Arts, Intercultural studies"],"nora_code":"DI-U-RUC","used":1},{"affno":"2","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unknown external organisation"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","country":"dk","first":"Helle Bach","key":"riispau","last":"Riis","locid":"174b26aa-3872-4f3b-ba1e-97455dffe89d","name":"Riis, Helle Bach","orcid":"0009-0009-1313-7704","rank":1,"rolecode":"pau"},{"affno":"2","first":"Maria","key":"mortensenpau","last":"Mortensen","name":"Mortensen, Maria","rank":2,"rolecode":"pau"},{"affno":"2","first":"Katrine","key":"meldgaardkjærpau","last":"Meldgaard Kjær","name":"Meldgaard Kjær, Katrine","rank":3,"rolecode":"pau"}],"pub":{"issn":["09071814"],"newspaper":"Politiken","pages":"3","status":"p","title":"Politiken"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Roskilde University","Universities"],"PST":["Published"]},"sid":["ruc-da2c46ff-498f-44e2-bc5b-a51f282a14eb"],"src":["RUC Roskilde University"],"title":"Vil du gerne være forsker? 'Så gift dig med en støttende mand'","type":"Newspaper Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-570638","year":"2017","yearsub":"2017"}
{"abstract":"This chapter explores how Michelle Obama has presented her political activity within the realm of food and nutrition to the American public. It focuses on how this activity has been sold by constant domestication of both Michelle Obama herself as well as her political motives and motivations; a feat achieved primarily by adhering to certain conventions of gender and gendered rhetoric. The chapter seeks to expand on the scholarly attention to the intersection of First Ladyship, political food activism, gender and race by asking questions about how Michelle Obama as a First Lady herself negotiates this intersection and what implications this might have. It also focuses on how food and nutrition can against the odds be a legitimate political arena for an African-American First Lady when strategically interwoven with appropriate gender performances. Indeed, it is clear that Michelle’s food activism that provided her with an arena for continuous self-definition as a First Lady, a mother and an American citizen.","author_count":3,"contributors":["Kjær, Katrine Meldgaard"],"cuid":["S01-000.00-611059"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"just a happy housewife michelle obama food activism and african american womanhood","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85028830998","version":"Other Version"},"id":"S01-000.00-611059","identifier":[{"id":"85028830998","type":"scopus"}],"ids":["sdu-8435b497-6beb-40ea-9e24-6874701b2e29"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Global-Local-2-2-D9BBC3E360C4ADCBA0AF0687E5530161"],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Humanities, Department for the Study of Culture","SDU, Faculty of Humanities, Department of Culture and Language, Cultural Studies"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Katrine Meldgaard","key":"kjærpau","last":"Kjær","locid":"de12158d-82f2-461a-af08-b9227d1cefef","name":"Kjær, Katrine Meldgaard","orcid":"0000-0001-7994-5186","rank":1,"rolecode":"pau"},{"affno":"","first":"Jonatan","key":"leerpedh","last":"Leer","name":"Leer, Jonatan","rank":2,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Karen","key":"klitgaardpovlsenpedh","last":"Klitgaard Povlsen","name":"Klitgaard Povlsen, Karen","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["9781472439680"],"pages":"62-77","publisher":"Routledge","series":"Critical Food Studies","status":"p","subtitle":"Practices, Distinctions and Heterotopias","title":"Food and Media"},"review":"Peer Reviewed","scoID":["2-s2.0-85028830998"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-8435b497-6beb-40ea-9e24-6874701b2e29"],"src":["SDU University of Southern Denmark"],"title":"Just A Happy Housewife? Michelle Obama, Food Activism and (African-)American Womanhood","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-611059","year":"2016","yearsub":"2016"}
