"orcid":"0000-0001-7994-5186","rank":2,"rolecode":"pau"}],"pub":{"issn":["09076182","22456937"],"issn_org":["09076182"],"issue":"3-4","journal":"Kvinder, Køn & Forskning","pages":"15-18","publisher":"Københavns Universitet","status":"p","title":"Kvinder, Køn & Forskning","volume":"24"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["au-b99c0984-9a8e-49ee-84b8-a6d16ac42371","sdu-9e594f3c-8344-488f-9925-e7a8d83dc474"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"Food, Gender and Media. The Trinity of Bad Taste : A Conversation with Karen Klitgaard Povlsen","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-095.83-026172","year":"2015","yearsub":"2015"}
{"abstract":"Food studies and the study of food and gender have been particularly strong scholarly currents in the US. Here, anthropologist Carole Counihan was one of the first scholars to work with the food-gender intersection. Over the past four decades, she has continued to work with the area in an array of different contexts. In this interview, Counihan describes how she has worked with the gendering of food culture. Along the way, she also offers her perspectives on working in changing academic environments and shares her suggestions for future areas of research.","author_count":2,"contributors":["Kjær, Katrine Meldgaard","Leer, Jonatan"],"cuid":["S02-095.83-022283"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"more than add women and stir a conversation with carole counihan","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/129083302/More_than_add_Women_and_Stir.pdf","version":"Published Version"},"id":"S02-095.83-022283","ids":["au-83c53b30-f800-4826-aa52-dc4741396426","sdu-3f3689eb-486b-4f2c-a48f-0ff1d04b62bc"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Local-1-2-311B8C108964F62E073CA89AF1C99AAB"],"oa_link":[{"access":"oa","type":"rem","url":"https://tidsskrift.dk/KKF/article/download/97058/145755","version":"Published Version"},{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/129083302/More_than_add_Women_and_Stir.pdf","version":"Published Version"}],"oai":{"class":"Unused","mra":["Humanities (HUM)"],"yearPub":"2015","yearSub":"2015"},