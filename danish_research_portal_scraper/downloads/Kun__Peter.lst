"name":"Zehzad, Payam","rank":67,"rolecode":"pau"},{"affno":"","first":"Hans Christof","key":"zellerpau","last":"Zeller","name":"Zeller, Hans Christof","rank":68,"rolecode":"pau"},{"affno":"44","first":"Vadim V.","key":"zolotuhinpau","last":"Zolotuhin","name":"Zolotuhin, Vadim V.","rank":69,"rolecode":"pau"},{"affno":"45","first":"Ole","key":"karsholtpau","last":"Karsholt","locid":"86e50d0a-734c-4188-a9c5-36d6f08bbec8","name":"Karsholt, Ole","rank":70,"rolecode":"pau"}],"pub":{"doi":"10.18476/2023.997558.7","issn":["26282380"],"issue":"Sp1","journal":"Integrative Systematics: Stuttgart Contributions to Natural History","pages":"121-459","status":"p","title":"Integrative Systematics: Stuttgart Contributions to Natural History","title_org":"Integrative Systematics","volume":"6"},"review":"Peer Reviewed","scoID":["2-s2.0-85158837669"],"search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-b819c7d9-309f-4a88-abc7-fc247d22e0ed"],"src":["KU University of Copenhagen"],"title":"Catalogue of the lepidoptera of Iran","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-732209","year":"2023","yearsub":"2023"}
{"abstract":"Objective: To test the reliability and validity of the Chinese version of the colostomy impact score (CIS) among patients with a permanent colostomy in China. Methods: A total of 218 patients completed the survey either in the clinic or remotely and mailed their responses. Reliability was estimated based on test-retest reliability. Validity was evaluated based on content validity, construct validity, and discriminative validity. The sensitivity and specificity of the score were analysed. The area under the curve was analysed by drawing the receiver-operating characteristic (ROC) curve; the optimal cutoff point was calculated to assess the impact of a stoma on domestic patients. Results: The test-retest reliability of the CIS was 0.967. The content validity was 0.98, and the construct and discriminative validities were good; sensitivity, specificity, and area under the ROC curve were 100, 48.53, and 0.806%, respectively. The optimal cutoff point for the Chinese version of the Colostomy Impact Score was 11.5. Conclusions: The Chinese version of the CIS indicated good reliability and validity, making it suitable for the evaluation of the impact of a permanent colostomy.","author_count":6,"contributors":["Wang, Jing","Zhong, Chang Kun","Kristensen, Helle Ø","Christensen, Peter","Liu, Jin","Pang, Dong"],"cuid":["S01-000.00-221105"],"filters":{"added":"2022-09","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East"],"corresponding_author":["Pang, Dong"],"country":["China"],"glorg":["All Global Affiliations","Peking University"],"keyword":["Reliability","Validity"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"validation of the chinese version of the colostomy impact score in rectal cancer patients with permanent colostomy","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85125506785","version":"Other Version"},"id":"S01-000.00-221105","identifier":[{"id":"35090085","type":"pmid"},{"id":"85125506785","type":"scopus"}],"ids":["au-a10d43d2-a885-48c9-ac1f-881a0efa4086"],"keyword":["colostomy impact score","permanent colostomy","reliability","validity"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-30211C0BCCC451199CA9931F5DF8894A"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"cn","key":"peking university","loc":["China","Asia, East"],"name":"Peking University","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Department of Surgical Gastroenterology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jing","key":"wangpau","last":"Wang","name":"Wang, Jing","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Chang Kun","key":"zhongpau","last":"Zhong","name":"Zhong, Chang Kun","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Helle","key":"kristensenpau","last":"Kristensen","locid":"1366b79d-7602-4566-ad30-b558b17da9a5","name":"Kristensen, Helle Ø","name_org":"Kristensen, Helle","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Peter","key":"christensenpau","last":"Christensen","locid":"456d99d5-ee96-4333-afef-d1596a62cf74","name":"Christensen, Peter","orcid":"0000-0002-6611-3935","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jin","key":"liupau","last":"Liu","name":"Liu, Jin","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Dong","key":"pangpau","last":"Pang","name":"Pang, Dong","rank":6,"rolecode":"pau"}],"pmid":["35090085"],"pub":{"doi":"10.1111/codi.16068","issn":["14628910","14631318"],"issn_org":["14628910"],"issue":"6","journal":"Colorectal Disease","pages":"773-781","publisher":"John Wiley & Sons Inc.","status":"p","title":"Colorectal Disease","volume":"24"},"review":"Peer Reviewed","scoID":["2-s2.0-85125506785"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-a10d43d2-a885-48c9-ac1f-881a0efa4086"],"src":["AU Aarhus University"],"title":"Validation of the Chinese version of the colostomy impact score in rectal cancer patients with permanent colostomy","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-221105","year":"2022","yearsub":"2022"}
{"abstract":"Mood inference with mobile sensing data has been studied in ubicomp literature over the last decade. This inference enables context-aware and personalized user experiences in general mobile apps and valuable feedback and interventions in mobile health apps. However, even though model generalization issues have been highlighted in many studies, the focus has always been on improving the accuracies of models using different sensing modalities and machine learning techniques, with datasets collected in homogeneous populations. In contrast, less attention has been given to studying the performance of mood inference models to assess whether models generalize to new countries. In this study, we collected a mobile sensing dataset with 329K self-reports from 678 participants in eight countries (China, Denmark, India, Italy, Mexico, Mongolia, Paraguay, UK) to assess the effect of geographical diversity on mood inference models. We define and evaluate country-specific (trained and tested within a country), continent-specific (trained and tested within a continent), country-agnostic (tested on a country not seen on training data), and multi-country (trained and tested with multiple countries) approaches trained on sensor data for two mood inference tasks with population-level (non-personalized) and hybrid (partially personalized) models. We show that partially personalized country-specific models perform the best yielding area under the receiver operating characteristic curve (AUROC) scores of the range 0.78-0.98 for two-class (negative vs. positive valence) and 0.76-0.94 for three-class (negative vs. neutral vs. positive valence) inference. Further, with the country-agnostic approach, we show that models do not perform well compared to country-specific settings, even when models are partially personalized. We also show that continent-specific models outperform multi-country models in the case of Europe. Overall, we uncover generalization issues of mood inference models to new countries and how the geographical similarity of countries might impact mood inference.","author_count":27,"contributors":["Meegahapola, Lakmal","Droz, William","Kun, Peter","Götzen, Amalia De","Nutakki, Chaitanya","Diwakar, Shyam","Ruiz-Correa, Salvador","Song, Donglei","Xu, Hao","Bidoglia, Miriam","Gaskell, George","Chagnaa, Altangerel","Ganbold, Amarsanaa","Zundui, Tsolmon","Caprini, Carlo","Miorandi, Daniele","Hume, Alethia","Zarza, Jose Luis","Cernuzzi, Luca","Bison, Ivano","Rodas Britez, Marcelo","Busso, Matteo","Chenu-Abente, Ronald","Günel, Can","Giunchiglia, Fausto","Schelenz, Laura","Gatica-Perez, Daniel"],"cuid":["S02-092.11-011460"],"filters":{"added":"2022-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["America, Central","America, South","Asia, Central","Asia, East","Asia, South","Europe, EU","Europe, Non-EU","OECD"],"corresponding_author":["Meegahapola, Lakmal"],"country":["China","Germany","India","Italy","Mexico","Mongolia","Paraguay","Switzerland","United Kingdom"],"glorg":["All Global Affiliations","Amrita Vishwa Vidyapeetham","Center for Research and Telecommunication Experimentation for Networked Communities","Eberhard Karls University of Tübingen","Ecole Polytechnique Fédérale de Lausanne","FONDATION DE L'INSTITUT DE RECHERCHE IDIAP","IDIAP Research Institute","Instituto Potosino de Investigacion Cientifica y Tecnologica","Instituto Potosino de Investigación Científica y Tecnológica","Jilin University","National University of Mongolia","Swiss Federal Institute of Technology Lausanne","The London School of Economics and Political Science","U-Hopper","Universidad Católica Nuestra Señora de la Asunción","University of Trento","University of Tübingen"],"keyword":["Affect","Context Aware Applications","Domain Shift","Generalization","Geographical Diversity","Machine Learning Generalization","Mobile Sensing Data","Mood","Mood Inference","Mood tracking","Passive sensing","Personalization","Smartphone sensing","Valence","distributional shift"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-AAU","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"generalization and personalization of mobile sensing based mood inference models an analysis of college students in eight countries","src":["aau","itu"],"src-code":["DI-U-AAU","DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://arxiv.org/pdf/2211.03009.pdf","version":"Pre-print"},"id":"S02-092.11-011460","identifier":[{"id":"85146436429","type":"scopus"}],"ids":["aau-efe9df49-f0ec-4b65-abe6-4a5481d6dd15","itu-79bb42de-6b4a-45c3-907d-a26f0bd2e576"],"keyword":["Context-Aware Applications","Geographical Diversity","Machine Learning Generalization","Mobile Sensing Data","affect","distributional shift","domain shift","generalization","mood","mood inference","mood tracking","passive sensing","personalization","smartphone sensing","valence"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-9FC6CB6752951549A9B4F446F67EF117"],"oa_link":[{"access":"oa","type":"rem","url":"https://arxiv.org/pdf/2211.03009.pdf","version":"Pre-print"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"ch","key":"idiap research institute","loc":["Switzerland","Europe, Non-EU","OECD"],"name":"IDIAP Research Institute","used":1},{"affno":"2","country":"ch","key":"fondation de l institut de recherche idiap","loc":["Switzerland","Europe, Non-EU","OECD"],"name":"FONDATION DE L'INSTITUT DE RECHERCHE IDIAP","used":1},{"affno":"3","country":"ch","key":"ecole polytechnique fédérale de lausanne","loc":["Switzerland","Europe, Non-EU","OECD"],"name":"Ecole Polytechnique Fédérale de Lausanne","used":1},{"affno":"4","key":"aau aalborg unive