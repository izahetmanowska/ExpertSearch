","rank":420,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Roman","key":"zagorskyromanpau","last":"Zagorsky","name":"Zagorsky, Roman","rank":421,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Sandor","key":"zoletniksandorpau","last":"Zoletnik","name":"Zoletnik, Sandor","rank":422,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Chijin","key":"xiaochijinpau","last":"Xiao","name":"Xiao, Chijin","rank":423,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"B.","key":"madsenbpau","last":"Madsen","locid":"240b6b8f-eb88-4547-8752-d9471e4bca4d","name":"Madsen, B.","orcid":"0000-0001-5716-467X","rank":424,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"M.","key":"salewskimirkopau","last":"Salewski","locid":"38100e3a-6385-47d3-aa2d-6fc5608a8649","name":"Salewski, Mirko","name_org":"Salewski, M.","orcid":"0000-0002-3699-679X","rank":425,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Eugenio","key":"schustereugeniopau","last":"Schuster","name":"Schuster, Eugenio","rank":426,"rolecode":"pau"}],"pub":{"doi":"10.1088/1741-4326/ad4270","issn":["00295515","10185577"],"issn_org":["00295515"],"issue":"11","journal":"Nuclear Fusion","paperid":"112013","publisher":"IOP Publishing","status":"p","title":"Nuclear Fusion","volume":"64"},"review":"Peer Reviewed","scoID":["2-s2.0-85202803876"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-0451b63b-fa9a-4237-8fad-d63338a10129"],"src":["DTU Technical University of Denmark"],"title":"Overview of recent experimental results on the EAST Tokamak","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-774915","year":"2024","yearsub":"2024"}
{"abstract":"Models leveraging both visual and textual data such as Contrastive Language-Image Pre-training (CLIP), are the backbone of many recent advances in artificial intelligence. In this work, we show that despite their versatility, such models are vulnerable to what we refer to as fooling master images. Fooling master images are capable of maximizing the confidence score of a CLIP model for a significant number of widely varying prompts, while being either unrecognizable or unrelated to the attacked prompts for humans. We demonstrate how fooling master images can be mined using stochastic gradient descent, projected gradient descent, or gradient-free optimisation. Contrary to many common adversarial attacks, the gradient-free optimisation approach allows us to mine fooling examples even when the weights of the model are not accessible. We investigate the properties of the mined fooling master images, and find that images trained on a small number of image captions potentially generalize to a much larger number of semantically related captions. Finally, we evaluate possible mitigation strategies and find that vulnerability to fooling master examples appears to be closely related to a modality gap in contrastive pre-trained multi-modal networks.","author_count":5,"contributors":["Freiberger, Matthias","Kun, Peter","Igel, Christian","Løvlie, Anders Sundnes","Risi, Sebastian"],"cuid":["S01-000.00-799221"],"filters":{"added":"2025-04","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-KU"]},"level3all":["DI-U-ITU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"fooling contrastive language image pre trained models with clipmasterprints","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://curis.ku.dk/ws/files/445732914/Fooling_Contrastive.pdf","version":"Published Version"},"id":"S01-000.00-799221","identifier":[{"id":"85219537520","type":"scopus"}],"ids":["ku-32b0a564-5425-44f1-8c65-0e2a4d0f4230"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-53D3BE5C256BFF74DA1453D5EE87C02D"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://curis.ku.dk/ws/files/445732914/Fooling_Contrastive.pdf","version":"Published Version"},{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"https://openreview.net/forum?id=ZFZnvGXXMm","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Pioneer AI (P1AI)"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","first":"Matthias","key":"freibergerpau","last":"Freiberger","locid":"58e199e0-71a9-4f89-a2b1-97346c7d29e8","name":"Freiberger, Matthias","rank":1,"rolecode":"pau"},{"affno":"2","first":"Peter","key":"kunpau","last":"Kun","name":"Kun, Peter","rank":2,"rolecode":"pau"},{"affno":"1","first":"Christian","key":"igelpau","last":"Igel","locid":"4ecc5e2e-7589-4f9b-9f79-d5dd99f56311","name":"Igel, Christian","orcid":"0000-0003-2868-0856","rank":3,"rolecode":"pau"},{"affno":"2","first":"Anders Sundnes","key":"løvliepau","last":"Løvlie","name":"Løvlie, Anders Sundnes","rank":4,"rolecode":"pau"},{"affno":"2","first":"Sebastian","key":"risipau","last":"Risi","name":"Risi, Sebastian","rank":5,"rolecode":"pau"}],"pub":{"issn":["28358856"],"issue":"4","journal":"Transactions on Machine Learning Research","status":"p","title":"Transactions on Machine Learning Research","volume":"2024"},"review":"Peer Reviewed","scoID":["2-s2.0-85219537520"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-32b0a564-5425-44f1-8c65-0e2a4d0f4230"],"src":["KU University of Copenhagen"],"title":"Fooling Contrastive Language-Image Pre-Trained Models with CLIPMasterPrints.","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-799221","year":"2024","yearsub":"2024"}
{"abstract":"Smartphones enable understanding human behavior with activity recognition to support people's daily lives. Prior studies focused on using inertial sensors to detect simple activities (sitting, walking, running, etc.) and were mostly conducted in homogeneous populations within a country. However, people are more sedentary in the post-pandemic world with the prevalence of remote/hybrid work/study settings, making detecting simple activities less meaningful for context-aware applications. Hence, the understanding of (i) how multimodal smartphone sensors and machine learning models could be used to detect complex daily activities that can better inform about people's daily lives, and (ii) how models generalize to unseen countries, is limited. We analyzed in-the-wild smartphone data and ∼216K self-reports from 637 college students in five countries (Italy, Mongolia, UK, Denmark, Paraguay). Then, we defined a 12-class complex daily activity recognition task and evaluated the performance with different approaches. We found that even though the generic multi-country approach provided an AUROC of 0.70, the country-specific approach performed better with AUROC scores in [0.79-0.89]. We believe that research along the lines of diversity awareness is fundamental for advancing human behavior understanding through smartphones and machine learning, for more real-world utility across countries.","author_count":22,"contributors":["Assi, Karim","Meegahapola, Lakmal","Droz, William","Kun, Peter","Götzen, Amalia De","Bidoglia, Miriam","Stares, Sally","Gaskell, George","Chagnaa, Altangerel","Ganbold, Amarsanaa","Zundui, Tsolmon","Caprini, Carlo","Miorandi, Daniele","Zarza, Jose Luis","Hume, Alethia","Cernuzzi, Luca","Bison, Ivano","Rodas Britez, Marcelo","Busso, Matteo","Acosta, Ronald Chenu Abente","Giunchiglia, Fausto","Gatica-Perez, Daniel"],"cuid":["S01-000.00-068700"],"event":{"end":"2023-04-28","place":"Hamburg, de","start":"2023-04-23","title":"2023 ACM CHI Conference on Human Factors in Computing Systems, CHI 23","year":"2023"},"filters":{"added":"2023-04","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, South","Asia, Central","Europe, EU","Europe, Non-EU","OECD"],"country":["Italy","Mongolia","Paraguay","Switzerland","United Kingdom"],"glorg":["All Global Affiliations","IDIAP Research Institute","National University of Mongolia","Swiss Federal Institute of Technology Lausanne","The London School of Economics and Political Science","U-Hopper","Universidad Católica Nuestra Señora de la Asunción","University of Trento"],"keyword":["Activity recognition","Context awareness","Domain Shift","Model generalization","Passive sensing","Smartphone sensing","distributional shift"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"complex daily activities country level diversity and smartphone sensing a study in denmark italy mongolia paraguay and uk","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://arxiv.org/pdf/2302.08591.pdf","version":"Pre-print"},"id":"S01-000.00-068700","identifier":[{"id":"85160011386","type":"scopus"}],"ids":["aau-406b6725-e046-48b2-ba67-aa3ca30fcbcc"],"keyword":["activity recognition","behavior recognition","complex activities of daily living","context-awareness","distributional shift","diversity-awareness","domain shift","model generalization","passive sensing","smartphone sensing"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-56C62A494FAB101F13F778E865562A45"],"oa_link":[{"access":"oa","type":"rem","url":"https://arxiv.org/pdf/2302.08591.pdf","version":"Pre-print"}],"org":[{"affno":"1","country":"ch","key":"swiss federal institute of technology lausanne","loc":["Switzerland","Europe, Non-EU","OECD"],"name":"Swiss Federal Institute of Technology Lausanne","used":1},{"affno":"2","country":"ch","key":"idiap research institute","loc":["Switzerland","Europe, Non-EU","OECD"],"name":"IDIAP Research Institute","used":1},{"affno":"3","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Technical Faculty of IT and Design","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology, Section for Media Technology - Campus Copenhagen","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology, Service Systems Design"],"nora_code":"DI-U-AAU","used":1},{"affno":"4","country":"gb","key":"the london school of economics and political science","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"The London School of Economics and Political Science","used":1},{"affno":"5","country":"mn","key":"national university of mongolia","loc":["Mongolia","Asia, Central"],"name":"National University of Mongolia","used":1},{"affno":"6","country":"it","key":"u hopper","loc":["Italy","Europe, EU","OECD"],"name":"U-Hopper","used":1},{"affno":"7","country":"py","key":"universidad católica nuestra señora de la asunción","loc":["Paraguay","America, South"],"name":"Universidad Católica Nuestra Señora de la Asunción","used":1},{"affno":"8","country":"it","key":"university of trento","loc":["Italy","Europe, EU","OECD"],"name":"University of Trento","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Karim","key":"assipau","last":"Assi","name":"Assi, Karim","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lakmal","ke