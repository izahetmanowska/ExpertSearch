o":"1","corresponding":null,"first":"Vera","key":"vanderburgpau","last":"van der Burg","name":"van der Burg, Vera","rank":13,"rolecode":"pau"}],"pub":{"doi":"10.1145/3656156.3658398","eisbn":["9798400706325"],"pages":"396-400","place":"Copenhagen, Denmark","publisher":"Association for Computing Machinery (ACM)","status":"p","title":"DIS 2024 - Proceedings of the 2024 ACM Designing Interactive Systems Conference"},"review":"Peer Reviewed","scoID":["2-s2.0-85198903016"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["aau-2401a2f0-09d2-4f14-ab3f-9d8f4710e95c","itu-9e885c49-7cff-4d78-b330-271757e69dc6"],"src":["AAU Aalborg University","ITU IT University of Copenhagen"],"title":"Death of the Design Researcher? Creating Knowledge Resources for Designers Using Generative AI","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-088.22-803632","year":"2024","yearsub":"2024"}
{"abstract":"This Research through Design paper explores how object detection may be applied to a large digital art museum collection to facilitate new ways of encountering and experiencing art. We present the design and evaluation of an interactive application called SMKExplore, which allows users to explore a museum’s digital collection of paintings by browsing through objects detected in the images, as a novel form of open-ended exploration. We provide three contributions. First, we show how an object detection pipeline can be integrated into a design process for visual exploration. Second, we present the design and development of an app that enables exploration of an art museum’s collection. Third, we offer reflections on future possibilities for museums and HCI researchers to incorporate object detection techniques into the digitalization of museums.","author_count":7,"contributors":["Meyer, Louie Søs","Engel Aaen, Johanne","Tranberg, Anitamalina Regitse","Kun, Peter","Freiberger, Matthias","Risi, Sebastian","Løvlie, Anders Sundnes"],"cuid":["S01-000.00-776388"],"filters":{"added":"2025-01","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Art","Computer vision","Experience Design","Exploratory search","Object detection"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"algorithmic ways of seeing using object detection to facilitate art exploration","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"doi","url":"https://doi.org/10.1145/3613904.3642157","version":"Published Version"},"id":"S01-000.00-776388","identifier":[{"id":"85194821101","type":"scopus"}],"ids":["itu-36e89c8e-4de8-41b5-bd2b-cb15b82c34c9"],"keyword":["Art","Computer Vision","Experience Design","Exploratory Search","Object Detection"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-999A595D22DDB832C9D963ECCFE52A4D"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"doi","url":"https://doi.org/10.1145/3613904.3642157","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Human-Computer Interaction and Design, Procedural eXpression Lab"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Louie Søs","key":"meyerpau","last":"Meyer","locid":"b55a7155-5e64-4230-b7da-94f7872e9742","name":"Meyer, Louie Søs","orcid":"0009-0008-7490-3049","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Johanne","key":"engelaaenpau","last":"Engel Aaen","name":"Engel Aaen, Johanne","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Anitamalina Regitse","key":"tranbergpau","last":"Tranberg","name":"Tranberg, Anitamalina Regitse","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Peter","key":"kunpau","last":"Kun","locid":"f30d35c6-4320-476f-8506-481764e6009e","name":"Kun, Peter","orcid":"0000-0003-0778-7662","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Matthias","key":"freibergerpau","last":"Freiberger","name":"Freiberger, Matthias","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sebastian","key":"risipau","last":"Risi","locid":"a420ffb3-2ca6-4925-a25f-baaa5228fc15","name":"Risi, Sebastian","orcid":"0000-0003-3607-8400","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders Sundnes","key":"løvliepau","last":"Løvlie","locid":"22ec9269-2fff-4dbf-a9c7-5037559a15ee","name":"Løvlie, Anders Sundnes","orcid":"0000-0003-0484-4668","rank":7,"rolecode":"pau"}],"pub":{"doi":"10.1145/3613904.3642157","pages":"1-18","series":"ACM Annual Conference on Human Factors in Computing Systems","status":"p","title":"Algorithmic Ways of Seeing: Using Object Detection to Facilitate Art Exploration"},"review":"Peer Reviewed","scoID":["2-s2.0-85194821101"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-36e89c8e-4de8-41b5-bd2b-cb15b82c34c9"],"src":["ITU IT University of Copenhagen"],"title":"Algorithmic Ways of Seeing: Using Object Detection to Facilitate Art Exploration","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-776388","year":"2024","yearsub":"2024"}
{"abstract":"BACKGROUND: The caesarean section (CS) rate has increased worldwide and there is an increasing public and scientific interest in the potential long-term health consequences for the offspring. CS is related to persistent aberrant microbiota colonization in the offspring, which may negatively interfere with sex hormone homeostasis and thus potentially affect the reproductive health. It remains unknown whether adult sons' semen quality is affected by CS. We hypothesize that CS is associated with lower semen quality. METHODS: This study was based on the Fetal Programming of Semen Quality cohort (FEPOS, enrolled from 2017 to 2019) nested within the Danish National Birth Cohort (DNBC, enrolled from 1996 to 2002). A total of 5697 adult sons of mothers from the DNBC were invited to the FEPOS cohort, and 1044 young men participated in this study. Information on mode of delivery was extracted from the Danish Medical Birth Registry, and included vaginal delivery, elective CS before labor, emergency CS during labor and unspecified CS. The young men provided a semen sample for analysis of semen volume, sperm concentration, motility and morphology. Negative binomial regression models were applied to examine the association between CS and semen characteristics with estimation of relative differences in percentages with 95% confidence intervals (CIs). RESULTS: Among included sons, 132 (13%) were born by CS. We found a slightly lower non-progressive sperm motility (reflecting higher progressive sperm motility) among sons born by CS compared to sons born by vaginal delivery [relative difference (95% CI): - 7.5% (- 14.1% to - 0.4%)]. No differences were observed for other sperm characteristics. When CS was further classified into elective CS, emergency CS and unspecified CS in a sensitivity analysis, no significant differences in non-progressive motility were observed among sons born by any of the three types of CS compared to sons born vaginally. CONCLUSIONS: This large population-based cohort study found no significant evidence for an adverse effect on semen quality in adult sons born by CS.","author_count":10,"contributors":["Huang, Kun","Gaml-Sørensen, Anne","Brix, Nis","Ernst, Andreas","Arendt, Linn Håkonsen","Bonde, Jens Peter Ellekilde","Hougaard, Karin Sørig","Toft, Gunnar","Tøttenborg, Sandra Søgaard","Ramlau-Hansen, Cecilia Høst"],"cuid":["S03-100.00-768036"],"filters":{"added":"2024-05","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":3,"continent":["Asia, East"],"corresponding_author":["Huang, Kun"],"country":["China"],"glorg":["All Global Affiliations","Anhui Medical University","Anhui Provincial Key Laboratory of Environment and Population Health Across the Life Course, China.","MOE Key Laboratory of Population Health Across Life Cycle, China.","NHC Key Laboratory of Study On Abnormal Gametes and Reproductive Tract, China."],"keyword":["Adult","Caesarean section","Cesarean Section adverse effects","Cohort Studies","Delivery","Denmark","Female","Fertility","Humans","Male","Obstetric","Pregnancy","Semen","Semen Analysis","Sperm Motility"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-OT","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-WORK"],"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-STENO"],"OT":["Department of Public Health, Centre for Health and Society, University of Copenhagen, Copenhagen, Denmark."],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-GV-WORK","DI-HO-CAP","DI-HO-CDR","DI-HO-STENO","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"birth by caesarean section and semen quality in adulthood a danish population based cohort study","src":["au","ku","nfa"],"src-code":["DI-GV-WORK","DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1186/s12978-024-01761-w","version":"Published Version"},"id":"S03-100.00-76