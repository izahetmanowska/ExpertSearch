TU","used":1},{"affno":"3","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Clinical Physiology and Nuclear Medicine (Odense)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Sven Gjedde","key":"sommerpau","last":"Sommer","locid":"5a7250cb-60fd-421f-9a94-93093aefeebf","name":"Sommer, Sven Gjedde","orcid":"0000-0002-2673-0162","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Annette","key":"bruhnpau","last":"Bruhn","locid":"15559017-3036-4e04-968e-338a24d800ce","name":"Bruhn, Annette","orcid":"0000-0002-7940-1338","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Sune Tjalfe","key":"thomsenpau","last":"Thomsen","name":"Thomsen, Sune Tjalfe","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Peter Daugbjerg","key":"jensenpau","last":"Jensen","name":"Jensen, Peter Daugbjerg","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Xavier","key":"frettépau","last":"Fretté","locid":"ed6f1267-24bd-4ede-bda4-3a05a18270da","name":"Fretté, Xavier","orcid":"0000-0002-4841-7011","rank":5,"rolecode":"pau"},{"affno":"","first":"Sven Gjedde","key":"sommerpedh","last":"Sommer","name":"Sommer, Sven Gjedde","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Morten Lykkegaard","key":"christensenpedh","last":"Christensen","name":"Christensen, Morten Lykkegaard","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Morten","key":"lykkegaardchristensenpedh","last":"Lykkegaard Christensen","name":"Lykkegaard Christensen, Morten","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Birgir","key":"norddahlpedh","last":"Norddahl","name":"Norddahl, Birgir","rank":8,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Morten","key":"ambyejensenpedh","last":"Ambye-Jensen","name":"Ambye-Jensen, Morten","rank":9,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Maria Cinta","key":"rodaserratpedh","last":"Roda-Serrat","name":"Roda-Serrat, Maria Cinta","rank":10,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1017/9781108950831.003","eisbn":["9781108950831"],"isbn":["9781108844345"],"pages":"8-81","publisher":"Cambridge University Press","status":"p","subtitle":"A Comprehensive Guide to Sustainable Resources in the Non-Fossil Era","title":"Bioprocesses"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["au-21680458-22ac-4d8f-a754-3135b29903b5","sdu-7fb91f41-c4c0-4f89-b46d-47bdc4ae2bcd"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"Biomass","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-089.79-793171","year":"2025","yearsub":"2025"}
{"abstract":"Background Patients with the genetic disorder Niemann-Pick type C2 disease (NP-C2) suffer from lysosomal accumulation of cholesterol causing both systemic and severe neurological symptoms. In a murine NP-C2 model, otherwise successful intravenous Niemann-Pick C2 protein (NPC2) replacement therapy fails to alleviate progressive neurodegeneration as infused NPC2 is unable to cross the blood-brain barrier (BBB). Genetic modification of brain endothelial cells (BECs) is thought to enable secretion of recombinant proteins thereby overcoming the restrictions of the BBB. We hypothesized that BBB-directed gene therapy using the AAV-BR1-NPC2 vector would transduce both BECs and neurons in a mouse model of NP-C2 (Npc2-/-). Methods Six weeks old Npc2-/- mice were intravenously injected with the AAV-BR1-NPC2 vector. Post-mortem analyses included gene expression analyses, determination of NPC2 transduction in the CNS, and co-detection of cholesterol with NPC2 in neurons. Results The vector exerted tropism for BECs and neurons resulting in a widespread NPC2 distribution in the brain with a concomitant reduction of cholesterol in adjacent neurons, presumably not transduced by the vector. Conclusion The data suggests cross-correcting gene therapy to the brain via delivery of NPC2 from BECs and neurons.","author_count":10,"contributors":["Rasmussen, Charlotte Laurfelt Munch","Heegaard, Christian Würtz","Thomsen, Maj Schneider","Hede, Eva","Laczek, Bartosz","Körbelin, Jakob","Thomsen, Louiza Bohn","Schwaninger, Markus","Moos, Torben","Burkhart, Annette"],"cuid":["S02-100.00-792808"],"filters":{"added":"2024-08","altsrc":["No Matches Found"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","OECD"],"corresponding_author":["Burkhart, Annette","Moos, Torben"],"country":["Germany"],"glorg":["All Global Affiliations","University Medical Center Hamburg-Eppendorf","University of Lübeck"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AAU","DI-U-AU"]},"review":"und","rtype":["clu"],"sorti":"endothelial and neuronal engagement by aav br000000000001 alleviates neurological symptoms and cholesterol deposition in a mouse model of niemann pick type c000000000002","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dpr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1101/2024.04.15.589486","version":"Published Version"},"id":"S02-100.00-792808","ids":["aau-2a47b004-d383-4a0c-9757-3722f28ceded","au-c793dc65-70b4-4a0c-8017-8fa7d2e462f1"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-4-233AF877A61094D78063840838635C61"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1101/2024.04.15.589486","version":"Published Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Neurobiology Research and Drug Delivery"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Molecular Biology and Genetics, Department of Molecular Biology and Genetics - Cellular Health, Intervention, and Nutrition"],"nora_code":"DI-U-AU","used":1},{"affno":"3","country":"de","key":"university medical center hamburg eppendorf","loc":["Germany","Europe, EU","OECD"],"name":"University Medical Center Hamburg-Eppendorf","used":1},{"affno":"4","country":"de","key":"university of lübeck","loc":["Germany","Europe, EU","OECD"],"name":"University of Lübeck","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Charlotte Laurfelt Munch","key":"rasmussencharlottelaurfeltmunchpau","last":"Rasmussen","locid":"608faa0d-42e3-46c7-bbeb-95118471e801","name":"Rasmussen, Charlotte Laurfelt Munch","orcid":"0000-0001-6535-3729","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Christian","key":"heegaardchristianwürtzpau","last":"Würtz Heegaard","locid":"f7804b8e-023c-4aab-8102-0a1d95b20760","name":"Heegaard, Christian Würtz","name_org":"Würtz Heegaard, Christian","orcid":"0000-0002-7989-2624","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Maj Schneider","key":"thomsenmajschneiderpau","last":"Thomsen","locid":"500ff43a-765e-4d61-9bbd-f228196ed49d","name":"Thomsen, Maj Schneider","orcid":"0000-0002-8385-7039","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Eva","key":"hedeevapau","last":"Hede","locid":"31fc1c6e-3bbd-4494-9b40-f66d601bed36","name":"Hede, Eva","orcid":"0000-0002-6072-4970","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Bartosz","key":"laczekbartoszpau","last":"Laczek","locid":"f7fe37c1-531e-45bc-8e1b-044993b493f3","name":"Laczek, Bartosz","orcid":"0000-0002-5209-9562","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jakob","key":"körbelinjakobpau","last":"Körbelin","name":"Körbelin, Jakob","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Louiza Bohn","key":"thomsenlouizabohnpau","last":"Thomsen","locid":"c4698d51-553a-4391-90b0-5379982b935f","name":"Thomsen, Louiza Bohn","orcid":"0000-0002-3144-7150","rank":7,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Markus","key":"schwaningermarkuspau","last":"Schwaninger","name":"Schwaninger, Markus","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Torben","key":"moostorbenpau","last":"Moos","locid":"e51cbd29-97d2-42d8-bbca-11f026378a2f","name":"Moos, Torben","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Annette","key":"burkhartannettepau","last":"Burkhart","locid":"7b6bd909-a011-463c-9e09-3623fee043b3","name":"Burkhart, Annette","orcid":"0000-0003-2086-4693","rank":10,"rolecode":"pau"}],"pub":{"doi":"10.1101/2024.04.15.589486","pages":"10","publisher":"bioRxiv","status":"p"},"review":"Undetermined","search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-2a47b004-d383-4a0c-9757-3722f28ceded","au-c793dc65-70b4-4a0c-8017-8fa7d2e462f1"],"src":["AAU Aalborg University","AU Aarhus University"],"title":"Endothelial and neuronal engagement by AAV-BR1 alleviates neurological symptoms and cholesterol deposition in a mouse model of Niemann-Pick type C2","type":"Preprint","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-792808","year":"2024","yearsub":"2024"}
{"abstract":"When newly diagnosed with inflammatory arthritis (IA), acquiring self-management skills is beneficial, to enhance quality of life. The personal beliefs and mental representations patients hold about their illness, known as illness perception, significantly influence the development of these skills. Recognizing characteristics that affect illness perception is key to identifying patients requiring additional support for the development of self-management skills. This study aimed at identifying the sociodemographic and clinical characteristics associated with a negative illness perception. This cross-sectional study was based on survey data from patients diagnosed for ≤ 2 years. The Brief Illness Perception Questionnaire (B-IPQ) was used to measure illness perception. After psychometric testing, we divided the B-IPQ into two domains: (1) a control domain and (2) a consequence domain. We performed logistic regression analyses with multiple imputations. A total of 1,360 patients (61% females) were included. Among them, 64%, 20%, and 16% were diagnosed with rheumatoid arthritis, psoriatic arthritis (PsA) and axial spondyloarthritis (axSpA), respectively. Younger patients with lower socioeconomic status, a diagnosis of PsA or axSpA, high disease activity (OR 3.026, CI 2.208;4.147), severe physical disability (OR 4.147. CI 2.883;6.007), severe pain (OR 3.034, CI 1.991;4.622), and severe fatigue (OR 2.612, CI 1.942;3.513) were significantly more likely to report having a negative illness perception. Younger patients with a higher symptom burden, increased disease activity, lower socioeconomic status, and a diagnosis of PsA or axSpA may require additional attention and support in rheumatology clinical practice to aid in the development of their self-management skills.","author_count":8,"contributors":["Lindgren, Luise Holberg","de Thurah, Annette","Thomsen, Tanja","Hetland, Merete Lund","Aadahl, Mette","Vestergaard, Sofie Bech","Kristensen, Sara Danshøj","Esbensen, Bente Appel"],"cuid":["S02-100.00-741836"],"filters":{"added":"2024-08","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Lindgren, Luise Holberg"],"keyword":["Arthritis","Cross Sectional Studies","Illness perception","Patient Reported Outcome Measures","Self management","Surveys and Questionnaires"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"sociodemographic and clinical variables associated with negative illness perception in patients newly diagnosed with rheumatoid arthritis axial spondyloarthritis or psoriatic arthritis a survey based cross sectional study","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1007/s00296-024-05553-0","version":"Published Version"},"id":"S02-100.00-741836","identifier":[{"id":"85189349874","type":"scopus"},{"id":"38563971","type":"pmid"},{"id":"PMC11108915","type":"pmcid"},{"id":"001195756300002","type":"wos"}],"ids":["au-5a567116-5954-4d6d-8928-33bd36f390bb","ku-e4f7cdda-e190-49fd-a79e-43d90333bf4c"],"keyword":["Arthritis","Cross-sectional studies","Illness perception","Patient reported outcome measures","Self-management","Surveys and questionnaires"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-9E96B2D6CA51532B286AED8B645C6E48"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/392583798/s00296_024_05553_0.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1007/s00296-024-05553-0","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["National Hospital of Denmark"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Section for Rheumatology"],"nora_code":"DI-U-AU","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Internal Medicine: Rheumatology"],"nora_code":"DI-U-KU","used":1},{"affno":"4","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Luise Holberg","key":"lindgrenpau","last":"Lindgren","name":"Lindgren, Luise Holberg","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Annette","key":"dethurahpau","last":"de Thurah","locid":"6429fc0a-b979-4ddb-ac99-3214574a17af","name":"de Thurah, Annette","orcid":"0000-0003-0103-4328","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Tanja","key":"thomsenpau","last":"Thomsen","name":"Thomsen, Tanja","rank":3,"rolecode":"pau"},{"affno":"1 3","first":"Merete Lund","key":"hetlandpau","last":"Hetland","locid":"3407b4a7-174d-43db-bae6-74e7f035a81f","name":"Hetland, Merete Lund","rank":4,"rolecode":"pau"},{"affno":"1 3","first":"Mette","key":"aadahlpau","last":"Aadahl","locid":"019b268b-8dff-4a10-91f6-07730c29d39b","name":"Aadahl, Mette","orcid":"0000-0001-5904-9747","rank":5,"rolecode":"pau"},{"affno":"2 4","corresponding":null,"country":"dk","first":"Sofie Bech","key":"vestergaardpau","last":"Vestergaard","locid":"9ba82f1d-db93-470f-92cc-99c49ffa76ba","name":"Vestergaard, Sofie Bech","orcid":"0009-0000-0456-0230","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sara Danshøj","key":"kristensenpau","last":"Kristensen","name":"Kristensen, Sara Danshøj","rank":7,"rolecode":"pau"},{"affno":"1 3","first":"Bente Appel","key":"esbensenpau","last":"Esbensen","locid":"36196dc3-ccaa-4877-aab9-b3ebbc3869b1","name":"Esbensen, Bente Appel","rank":8,"rolecode":"pau"}],"pmid":["38563971"],"pub":{"doi":"10.1007/s00296-024-05553-0","issn":["01728172","1437160X"],"issn_org":["01728172"],"issue":"6","journal":"Rheumatology International","pages":"1119-1131","publisher":"Springer Science and Business Media Deutschland GmbH","status":"p","title":"Rheumatology International","volume":"44"},"review":"Peer Reviewed","scoID":["2-s2.0-85189349874"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-5a567116-5954-4d6d-8928-33bd36f390bb","ku-e4f7cdda-e190-49fd-a79e-43d90333bf4c"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Sociodemographic and clinical variables associated with negative illness perception in patients newly diagnosed with rheumatoid arthritis, axial spondyloarthritis, or psoriatic arthritis—a survey based cross-sectional study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-741836","year":"2024","yearsub":"2024"}
{"abstract":"Objective: An estimated 41,000 lives are lost to suicide each year in World Health Organization Eastern Mediterranean Region Office (WHO EMRO) countries. The objective of this study was to conduct a situation analysis for suicide and self-harm in the WHO EMRO region. Methods: Data on suicide were obtained from the WHO Global Health Estimates for the years 2000–2019. Information on risk groups efforts to prevent self-harm and suicide in the EMRO region were retrieved through scientific studies, grey literature, and public websites. Results: During 2000–2019, the age-standardized suicide rate was 6.7 per 100,000 inhabitants, albeit there are concerns regarding data quality. Self-harm and suicide remain criminal acts in more than half of the countries. Few countries have a national plan for prevention of suicide. Toxic agents, such as pesticides and black henna, are easily available and frequently used for suicide in some areas, as are firearms and self-immolation. Successful prevention measures include means restriction and psychosocial interventions after self-harm. Conclusion: Many WHO EMRO countries remain underserved in terms of mental health care. Decriminalization of suicide and means restriction might be further promoted. Online-based tools for mental health literacy and psychosocial therapy are other options to explore.","author_count":13,"contributors":["Erlangsen, Annette","Khan, Murad","Su, Wen","Alateeq, Khawlah","Charfi, Fatma","Madsen, Trine","Qin, Ping","Morthorst, Britt Reuter","Thomsen, Morten","Malik, Aiysha","Bandara, Piumee","Fleischmann, Alexandra","Saeed, Khalid"],"cuid":["S01-000.00-754293"],"filters":{"added":"2024-09","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Africa","America, North","Asia, Middle East","Asia, South","Europe, Non-EU","Nordic","OECD","Oceania"],"country":["Australia","Norway","Pakistan","Saudi Arabia","Switzerland","Tunisia","United Kingdom","United States"],"glorg":["Aga Khan University","All Global Affiliations","Australian National University","Johns Hopkins University","King Saud University","University of Bristol","University of Oslo","University of Tunis El Manar","World Health Organization"],"keyword":["Eastern Mediterranean Region","Suicide","Suicide attempt"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"OT":["Social Network, Copenhagen"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"situation analysis of suicide and self harm in the who eastern mediterranean region","src":["ku"],"src-code":["DI-U-KU"],"type":"djr","type-grp":["all","pub"]},"id":"S01-000.00-754293","identifier":[{"id":"37837375","type":"pmid"},{"id":"85174192106","type":"scopus"}],"ids":["ku-3234399e-1f44-460c-b11d-2383f881b6a2"],"keyword":["Eastern Mediterranean Region","suicide","suicide attempt"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-2-B38E5BF41F12D63E6218E6FD66FD17B7"],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Mental Health Services Glostrup"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","country":"us","key":"johns hopkins university","loc":["United States","America, North","OECD"],"name":"Johns Hopkins University","used":1},{"affno":"3","country":"au","key":"australian national university","loc":["Australia","Oceania","OECD"],"name":"Australian National University","used":1},{"affno":"4","country":"pk","key":"aga khan university","loc":["Pakistan","Asia, South"],"name":"Aga Khan University","used":1},{"affno":"5","country":"sa","key":"king saud university","loc":["Saudi Arabia","As