pau"},{"affno":"","corresponding":null,"first":"Fredrik","key":"folkepau","last":"Folke","name":"Folke, Fredrik","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Christian Tobias","key":"torppedersenpau","last":"Torp-Pedersen","name":"Torp-Pedersen, Christian Tobias","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Annette Kjær","key":"ersbøllpau","last":"Ersbøll","locid":"ba343517-a6c5-47c1-a8ba-4cbe00b7409c","name":"Ersbøll, Annette Kjær","orcid":"0000-0002-9407-3387","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Tine","key":"tjørnhøjthomsenpau","last":"Tjørnhøj-Thomsen","locid":"bc043d50-4a2b-41c1-a085-da4a674866f3","name":"Tjørnhøj-Thomsen, Tine","orcid":"0000-0003-3621-6682","rank":6,"rolecode":"pau"}],"pub":{"pages":"67","place":"København","publisher":"Statens Institut for Folkesundhed, Det Sundhedsvidenskabelige Fakultet, Syddansk Universitet","status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-534885db-424e-4c50-987d-d173844c4981"],"src":["SDU University of Southern Denmark"],"title":"Førstehjælpsundervisning i folkeskolen","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-597110","year":"2014","yearsub":"2014"}
{"abstract":"The mechanism by which iron is transported across the blood-brain barrier (BBB) remains controversial, and in this study we aimed to further clarify mechanisms by which iron is transported into the brain. We analyzed and compared the mRNA and protein expression of a variety of proteins involved in the transport of iron (transferrin receptor, divalent metal transporter I (DMT1), steap 2, steap 3, ceruloplasmin, hephaestin and ferroportin) in both primary rat brain capillary endothelial cells (BCEC) and immortalized rat brain capillary endothelial cell line (RBE4) grown in co-culture with defined polarity. The mRNA expression of the iron-related molecules was also investigated in isolated brain capillaries from iron deficiency, iron reversible and normal rats. We also performed iron transport studies to analyze the routes by which iron is transported through the brain capillary endothelial cells: i) We studied the transport of holo-transferrin that could indicate transcytotic transport of iron through the BBB, and ii) we studied the influence of iron export from brain endothelial cells in the presence of hepcidin known to inhibit the functioning of ferroportin, the rationale being that an influence of hepcidin on iron efflux would indicate that ferroportin plays a role for iron efflux of ferrous non-transferrin bound iron at the BBB. Collectively, our data indicate that both routes are significant for transport of iron through the BBB initiated by receptor-mediated uptake of holo-transferrin at the luminal side of brain capillaries and cellular entry in endosomes followed by: i) Transcytosis of holo-transferrin containing iron, and ii) Stepwise transport of iron through the endothelial cells from the endosomes via ferric reduction by Steap 2 and 3, transport of ferrous iron through the endosomal membrane to the cytosol mediated by DMT1, transport of ferrous iron through the abluminal endothelial cell membrane by ferroportin, and oxidation by the ferrooxidases ceruloplasmin and hephaestin. The two mechanisms for transport of iron at the BBB both explain how iron can enter the brain extracellular space on its non-toxic ferric form to become accessible for iron uptake by neurons and glia.","author_count":3,"contributors":["Burkhart, Annette","Thomsen, Louiza Bohn","Moos, Torben"],"cuid":["S01-000.00-109103"],"event":{"end":"2014-06-20","place":"New London, NH, us","start":"2014-06-15","title":"Barriers of the CNS -","year":"2014"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"iron uptake and transport at the blood brain barrier","src":["aau"],"src-code":["DI-U-AAU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-109103","ids":["aau-cb887b05-534e-4851-a5d4-92a0f0bece50"],"lang":"Danish","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-0D758D0B57396EE1B2261E385B3B7266"],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Biomedicine Group","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Laboratory of Neurobiology"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Annette Burkhart","key":"larsenpau","last":"Larsen","locid":"7b6bd909-a011-463c-9e09-3623fee043b3","name":"Burkhart, Annette","name_org":"Larsen, Annette Burkhart","orcid":"0000-0003-2086-4693","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Louiza Bohn","key":"thomsenpau","last":"Thomsen","locid":"c4698d51-553a-4391-90b0-5379982b935f","name":"Thomsen, Louiza Bohn","orcid":"0000-0002-3144-7150","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Torben","key":"moospau","last":"Moos","locid":"e51cbd29-97d2-42d8-bbca-11f026378a2f","name":"Moos, Torben","rank":3,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-cb887b05-534e-4851-a5d4-92a0f0bece50"],"src":["AAU Aalborg University"],"title":"Iron uptake and transport at the blood-brain barrier","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-109103","year":"2014","yearsub":"2014"}
{"abstract":"BACKGROUND: Knowledge on psychiatric emergencies in children and adolescents is limited. The Psychiatric Emergency Departments (PED) in Copenhagen enable the acute examination of children and adolescents 24 h a day, 7 days a week. However, very little is known about who presents to the PED, and the reason for their visit. AIM: To describe the prevalence and characteristics of presentations in PED and treatment provided. METHODS: A retrospective population based study comprising data of more than 4000 visitors presenting to PED from 2001-2010. In 2003 and 2006, two randomly chosen years, a more thorough analysis was performed, based on the individual emergency charts. Inter-rater reliability was high. RESULTS: Visits increased nearly threefold during the period. Symptom score for 2003 and 2006 revealed that more than one third of the visitors had suicidal ideation. Depressive and anxiety symptoms together with suicidal ideation rose significantly (P < 0.001). Psychoses and suicidal attempts remained unchanged. In one third of the visits, the discharge diagnosis was anxiety and stress-related disorders, followed by personality, behavioural and emotional disorders. Between 15% and 20% of the visits resulted in admission and more than 50% in referral for outpatient follow-up. CONCLUSIONS: The number of presenting psychiatric emergencies has increased over the last 10 years. Comparing symptoms from 2003 and 2006 showed a significant rise in their severity. This study highlights the need for 24-h access for acute evaluation by physicians skilled in child and adolescent psychiatry, and raises concern that the severity could increase.","author_count":5,"contributors":["Taastrøm, Annette","Klahn, Julie","Staal, Nina","Thomsen, Per Hove","Johansen, Anders"],"cuid":["S01-000.00-274974"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Adolescent","Child","Children and adolescents","Denmark","Emergencies","Emergency Service Hospital","Emergency services psychiatric","Female","Health Care Surveys","Health Services Needs and Demand","Hospitalization","Humans","Male","Mental Disorders","Patient Acceptance of Health Care","Prevalence","Referral and Consultation","Reproducibility of Results","Retrospective Studies","Suicidal Ideation","Suicidal behaviour","Suicide Attempted"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"children and adolescents in the psychiatric emergency department a 000000000010 year survey in copenhagen county","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.3109/08039488.2013.846410","version":"Other Version"},"id":"S01-000.00-274974","identifier":[{"id":"84904439823","type":"scopus"},{"id":"24161251","type":"pmid"}],"ids":["au-ff373a17-93eb-419a-96a8-f4700666e70d"],"keyword":["Adolescent","Child","Children and adolescents","Denmark","Emergencies","Emergency Service, Hospital","Emergency Services, Psychiatric","Female","Health Care Surveys","Health Services Needs and Demand","Hospitalization","Humans","Male","Mental Disorders","Patient Acceptance of Health Care","Prevalence","Psychiatric emergencies","Referral and Consultation","Reproducibility of Results","Retrospective Studies","Suicidal Ideation","Suicide, Attempted","social difficulties","suicidal behaviour"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-7971FEAAFB0AC36F40266B77BA05C498"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.3109/08039488.2013.846410","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"miscellaneous","l2