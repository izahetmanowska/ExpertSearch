{"abstract":"Following publication of the original article [1], the authors reported that one of the authors' names is spelled incorrectly. In this Correction the incorrect and correct author name are shown. The original publication of this article has been corrected.","author_count":7,"contributors":["Jørgensen, Mads Gustaf","Toyserkani, Navid Mohamadpour","Hyldig, Nana","Chakera, Annette Hougaard","Hölmich, Lisbet Rosenkrantz","Thomsen, Jørn Bo","Sørensen, Jens Ahm"],"cuid":["S01-000.00-634884"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"correction to prevention of seroma following inguinal lymph node dissection with prophylactic incisional negative pressure wound therapy seroma trial study protocol for a randomized controlled trial","src":["sdu"],"src-code":["DI-U-SDU"],"type":"djc","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85055073998","version":"Other Version"},"id":"S01-000.00-634884","identifier":[{"id":"30340647","type":"pmid"},{"id":"PMC6194745","type":"pmcid"},{"id":"85055073998","type":"scopus"}],"ids":["sdu-d73a87cd-adb9-4d2f-91ee-f8669d43dd48"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-96332C36520D9664DA0631F5D9EDA0E1"],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Plastic S