{"author_count":8,"contributors":["Nikolaisen, Lars","Dahl, Jonas","Bech, Karin Svane","Bruhn, Annette","Rasmussen, Michael Bo","Thomsen, Anne Belinda","Nielsen, Henrik Bangsø","Sander, Bo"],"cuid":["S01-000.00-153814"],"event":{"end":"2010-12-17","place":"Lyon, fr","start":"2010-12-17","title":"18<sup>th</sup> European Biomass Conference &amp; Exhibition","year":"2010"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GTS","DI-OT","DI-U"],"level3":{"GTS":["DI-GTS-ALL","DI-GTS-DTCI"],"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU","DI-U-DTU"]},"level3all":["DI-GTS-DTCI","DI-U-AU","DI-U-DTU"]},"review":"nr","rtype":["clu"],"sorti":"energy production from sea lettuce em ulva lactuca em","src":["au"],"src-code":["DI-U-AU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-153814","ids":["au-2ac803b0-7d6e-11df-8c1a-000ea68e967b"],"keyword":["Ulva lactuca biomass bioenergy"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-ECB6F68178B4DECB2DFABA5F001ADC8A"],"org":[{"affno":"1","country":"dk","key":"danish technological institute","l2":"DI-GTS","l2n":"GTS Institutes","l3":"DI-GTS-DTCI","l3nn":"Danish Technological Institute","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Danish Technological Institute","namevar":["Danish Technological Institute"],"nora_code":"DI-GTS-DTCI","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Ecoscience, Department of Ecoscience - Applied Marine Ecology and Modelling"],"nora_code":"DI-U-AU","used":1},{"affno":"3","country":"dk","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark (DTU)"],"nora_code":"DI-U-DTU","used":1},{"affno":"4","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Lars","key":"nikolaisenpau","last":"Nikolaisen","name":"Nikolaisen, Lars","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jonas","key":"dahlpau","last":"Dahl","name":"Dahl, Jonas","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Karin Svane","key":"bechpau","last":"Bech","name":"Bech, Karin Svane","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Annette","key":"bruhnpau","last":"Bruhn","locid":"15559017-3036-4e04-968e-338a24d800ce","name":"Bruhn, Annette","orcid":"0000-0002-7940-1338","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Michael Bo","key":"rasmussenpau","last":"Rasmussen","locid":"425beba8-a341-4661-bcb1-c84ce6249568","name":"Rasmussen, Michael Bo","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Anne Belinda","key":"thomsenpau","last":"Thomsen","name":"Thomsen, Anne Belinda","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Henrik Bangsø","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Henrik Bangsø","rank":7,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Bo","key":"sanderpau","last":"Sander","name":"Sander, Bo","rank":8,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All GTS Institutes","All Miscellaneous","All