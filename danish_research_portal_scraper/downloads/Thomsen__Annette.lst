au","last":"Thomsen","locid":"6c1e4246-728c-46eb-9c96-dfd48e4de8bc","name":"Thomsen, Thordis","name_org":"Thomsen, T.","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"A.","key":"dethurahpau","last":"de Thurah","locid":"6429fc0a-b979-4ddb-ac99-3214574a17af","name":"de Thurah, Annette","name_org":"de Thurah, A.","orcid":"0000-0003-0103-4328","rank":3,"rolecode":"pau"},{"affno":"1","first":"M.","key":"aadahlpau","last":"Aadahl","locid":"019b268b-8dff-4a10-91f6-07730c29d39b","name":"Aadahl, Mette","name_org":"Aadahl, M.","orcid":"0000-0001-5904-9747","rank":4,"rolecode":"pau"},{"affno":"1","first":"M. L.","key":"hetlandpau","last":"Hetland","locid":"3407b4a7-174d-43db-bae6-74e7f035a81f","name":"Hetland, Merete Lund","name_org":"Hetland, M. L.","rank":5,"rolecode":"pau"},{"affno":"4","first":"S. D.","key":"kristensenpau","last":"Kristensen","name":"Kristensen, S. D.","rank":6,"rolecode":"pau"},{"affno":"1","first":"B. A.","key":"esbensenpau","last":"Esbensen","locid":"36196dc3-ccaa-4877-aab9-b3ebbc3869b1","name":"Esbensen, Bente Appel","name_org":"Esbensen, B. A.","rank":7,"rolecode":"pau"}],"pmid":["36750937"],"pub":{"doi":"10.1186/s12913-022-09007-w","issn":["14726963"],"issue":"1","journal":"BMC Health Services Research","paperid":"123","publisher":"BioMed Central","status":"p","title":"BMC Health Services Research","volume":"23"},"review":"Peer Reviewed","scoID":["2-s2.0-85147594719"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region Zealand","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-7b994988-b285-40cd-a9f9-d80ec543724b","ku-e6c023c6-7f83-4dd9-b3ff-1a6c06372c4e"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Newly diagnosed with inflammatory arthritis (NISMA)–development of a complex self-management intervention","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-021679","year":"2023","yearsub":"2023"}
{"abstract":"The study builds on an extensive literature review, a survey, and in-depth interviews to investigate the potential of 10 microalgae and macroalgae production systems in contributing to animal feed requirements in the EU. It summarizes the current state of knowledge in terms of biomass, nutritional yields, costs and greenhouse gas (GHG) emissions. The report also compares production systems against land-based crops (e.g. soya) with similar nutritional properties. Finally, it assesses the EU potential for algae production that could be supported by current CO2 point-source emissions and that could contribute to (today and in the future) animal’s feed requirements. Overall, as algae production is an area where production and Research & Development are evolving in parallel, there is significant variability in values estimated for the criteria investigated. Follow-up research is required in particular on: additional macro- and microalgae species, as well as additional land-based production systems; postharvest processing to support upscaling of biomass production in a sustainable manner and to remove unwanted minerals; and improvement of nutritional value (e.g. digestibility and assimilation) of cultivable algae for animals.","author_count":13,"contributors":["van Duinen, Rianne","Rivière, Cloé","Strosser, Pierre","Dijkstra, Jan Wilco","Rios, Sergio","Luzzi, Stefania","Bruhn, Annette","Nielsen, Mette Olaf","Göke, Cordula","Samarasinghe, Milani Bhagya","Chassé, Elisabeth","Nielsen, Cecilie Heide","Thomsen, Marianne"],"cuid":["S02-097.44-704163"],"filters":{"added":"2023-09","altsrc":["No Matches Found"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","OECD"],"country":["France","Netherlands"],"glorg":["ACTeon environment (Biz)","All Global Affiliations","Netherlands Organization for Applied Scientific Research (TNO)","TNO, Zeist"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"algae and climate final report","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"doi","url":"https://doi.org/10.2926/208135","version":"Published Version"},"id":"S02-097.44-704163","ids":["au-6d8f8981-e507-4df8-baa5-8c71451deab1","ku-ebbef884-e2e6-4d13-87b2-cb4586283a4b"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-3-4-A6F559556A8BD88673022B44E5D132DE"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"doi","url":"https://doi.org/10.2926/208135","version":"Published Version"},{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/361593788/algae_and_climate_HZ0523190ENN_Final_report.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"fr","key":"acteon environment","loc":["France","Europe, EU","OECD"],"name":"ACTeon environment (Biz)","used":1},{"affno":"2","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1},{"affno":"3","country":"nl","key":"tno zeist","loc":["Netherlands","Europe, EU","OECD"],"name":"TNO, Zeist","used":1},{"affno":"4","country":"nl","key":"netherlands organization for applied scientific research","loc":["Netherlands","Europe, EU","OECD"],"name":"Netherlands Organization for Applied Scientific Research (TNO)","used":1},{"affno":"5","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical S