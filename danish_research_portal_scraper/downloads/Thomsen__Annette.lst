{"author_count":5,"contributors":["Fjerbæk, Annette","Westerdahl, Elisabeth","Andreasen, Jan Jesper","Thomsen, Lars Pilegaard","Brocki, Barbara C."],"cuid":["S01-000.00-064466"],"event":{"end":"2019-09-06","place":"Stockholm, se","start":"2019-09-04","title":"SATS/ Swedish Thoracic Meeting 2019","year":"2019"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"country":["Sweden"],"glorg":["All Global Affiliations","Uppsala University","Örebro University"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"sitting position increases pulmonary function early after cardiac surgery compared to supine position","src":["aau"],"src-code":["DI-U-AAU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-064466","ids":["aau-31d13404-bc63-4d29-a5d7-3b8abe78761d"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-4322BC45C01F396E37BBEFD1437ABC03"],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Physiotherapy and Occupational Therapy","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Hoved-Orto"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"se","key":"örebro university","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Örebro University","used":1},{"affno":"3","country":"se","key":"uppsala university","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Uppsala University","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Annette","key":"fjerbækpau","last":"Fjerbæk","locid":"7619bdb6-c9d3-4e77-99f6-cee5500e3901","name":"Fjerbæk, Annette","rank":1,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Elisabeth","key":"westerdahlpau","last":"Westerdahl","name":"Westerdahl, Elisabeth","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jan Jesper","key":"andreasenpau","last":"Andreasen","locid":"64f82f01-dc7b-4ed4-873a-940774d8921e","name":"Andreasen, Jan Jesper","orcid":"0000-0002-2382-3734","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars Pilegaard","key":"thomsenpau","last":"Thomsen","locid":"ab7fb14a-9937-4e1d-b345-d7086429cb55","name":"Thomsen, Lars Pilegaard","orcid":"0000-0003-0061-5833","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Barbara C.","key":"brockipau","last":"Brocki","locid":"ec127331-af99-478d-95fd-0e55c9ed5b84","name":"Brocki, Barbara C.","orcid":"0000-0001-7085-6507","rank":5,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-31d13404-bc63-4d29-a5d7-3b8abe78761d"],"src":["AAU Aalborg University"],"title":"Sitting position increases pulmonary function early after cardiac surgery compared to supine position","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-064466","year":"2019","yearsub":"2019"}
{"abstract":"In Europe, the mean incidence of urinary tract infections in intensive care units is 1.1 per 1000 patient-days. Of these cases, catheter-associated urinary tract infections (CAUTI) account for 98%. In total, CAUTI in hospitals is estimated to give additional health-care costs of £1-2.5 billion in the United Kingdom alone. This is in sharp contrast to the low cost of urinary catheters and emphasizes the need for innovative products that reduce the incidence rate of CAUTI. Ureteral stents and other urinary-tract devices suffer similar problems. Antimicrobial strategies are being developed, however, the evaluation of their efficacy is very challenging. This review aims to provide considerations and recommendations covering all relevant aspects of antimicrobial material testing, including surface characterization, biocompatibility, cytotoxicity, in vitro and in vivo tests, microbial strain selection, and hydrodynamic conditions, all in the perspective of complying to the complex pathology of device-associated urinary tract infection. The recommendations should be on the basis of standard assays to be developed which would enable comparisons of results obtained in different research labs both in industry and in academia, as well as provide industry and academia with tools to assess the antimicrobial properties for urinary tract devices in a reliable way.","author_count":19,"contributors":["Ramstedt, Madeleine","Ribeiro, Isabel A. C.","Bujdakova, Helena","Mergulhão, Filipe J. M.","Jordao, Luisa","Thomsen, Peter","Alm, Martin","Burmølle, Mette","Vladkova, Todorka","Can, Fusun","Reches, Meital","Riool, Martijn","Barros, Alexandre","Reis, Rui L","Meaurio, Emilio","Kikhney, Judith","Moter, Annette","Zaat, Sebastian A J","Sjollema, Jelmer"],"cuid":["S01-000.00-403319"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-PR-OTH","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"evaluating efficacy of antimicrobial and antifouling materials for urinary tract medical devices challenges and recommendations","src":["ku"],"src-code":["DI-U-KU"],"type":"djr","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1002/mabi.201800384","version":"Published Version"},"id":"S01-000.00-403319","identifier":[{"id":"30884146","type":"pmid"},{"id":"85065484534","type":"scopus"}],"ids":["ku-10b2f694-ccae-46c5-b66a-5ae55066dd51"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-FF88C01644044EA4B240CB3CDA38A498"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/249078232/Evaluating_Efficacy_of_Antimicrobial_and_Antifouling_Materials_for_Urinary_Tract_Medical_Devices_Challenges_and_Recommendations_version_of_record_.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1002/mabi.201800384","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["BioModics ApS (Biz)"],"nora_code":"DI-PR-OTH","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Biology, Microbiology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Madeleine","key":"ramstedtpau","last":"Ramstedt","name":"Ramstedt, Madeleine","rank":1,"rolecode":"pau"},{"affno":"","first":"Isabel A. C.","key":"ribeiropau","last":"Ribeiro","name":"Ribeiro, Isabel A. C.","rank":2,"rolecode":"pau"},{"affno":"","first":"Helena","key":"bujdakovapau","last":"Bujdakova","name":"Bujdakova, Helena","rank":3,"rolecode":"pau"},{"affno":"","first":"Filipe J. M.","key":"mergulhãopau","last":"Mergulhão","name":"Mergulhão, Filipe J. M.","rank":4,"rolecode":"pau"},{"affno":"","first":"Luisa","key":"jordaopau","last":"Jordao","name":"Jordao, Luisa","rank":5,"rolecode":"pau"},{"affno":"1","first":"Peter","key":"thomsenpau","last":"Thomsen","name":"Thomsen, Peter","rank":6,"rolecode":"pau"},{"affno":"1","first":"Martin","key":"almpau","last":"Alm","name":"Alm, Martin","rank":7,"rolecode":"pau"},{"affno":"2","first":"Mette","key":"burmøllepau","last":"Burmølle","locid":"e92fefa3-0fd7-4802-aea8-99d008792b34","name":"Burmølle, Mette","orcid":"0000-0003-1870-632X","rank":8,"rolecode":"pau"},{"affno":"","first":"Todorka","key":"vladkovapau","last":"Vladkova","name":"Vladkova, Todorka","rank":9,"rolecode":"pau"},{"affno":"","first":"Fusun","key":"canpau","last":"Can","name":"Can, Fusun","rank":10,"rolecode":"pau"},{"affno":"","first":"Meital","key":"rechespau","last":"Reches","name":"Reches, Meital","rank":11,"rolecode":"pau"},{"affno":"","first":"Martijn","key":"rioolpau","last":"Riool","name":"Riool, Martijn","rank":12,"rolecode":"pau"},{"affno":"","first":"Alexandre","key":"barrospau","last":"Barros","name":"Barros, Alexandre","rank":13,"rolecode":"pau"},{"affno":"","first":"Rui L","key":"reispau","last":"Reis","name":"Reis, Rui L","rank":14,"rolecode":"pau"},{"affno":"","first":"Emilio","key":"meauriopau","last":"Meaurio","name":"Meaurio, Emilio","rank":15,"rolecode":"pau"},{"affno":"","first":"Judith","key":"kikhneypau","last":"Kikhney","name":"Kikhney, Judith","rank":16,"rolecode":"pau"},{"affno":"","first":"An