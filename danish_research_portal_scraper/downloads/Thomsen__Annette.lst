","namevar":["Technical University of Denmark, National Institute of Aquatic Resources","Technical University of Denmark, National Institute of Aquatic Resources, Danish Shellfish Centre"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Annette","key":"bruhnpau","last":"Bruhn","locid":"15559017-3036-4e04-968e-338a24d800ce","name":"Bruhn, Annette","orcid":"0000-0002-7940-1338","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Teis","key":"boderskovpau","last":"Boderskov","locid":"c63d7c51-d48b-4a3f-a126-3b71bd450fc6","name":"Boderskov, Teis","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Mette Møller","key":"nielsenpau","last":"Nielsen","locid":"d058d67b-7f23-4437-9f10-11078a0c3ef2","name":"Nielsen, Mette Møller","orcid":"0000-0002-7198-062X","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Michael Bo","key":"rasmussenpau","last":"Rasmussen","locid":"425beba8-a341-4661-bcb1-c84ce6249568","name":"Rasmussen, Michael Bo","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Marianne","key":"thomsenpau","last":"Thomsen","locid":"92402c50-d634-4163-a3fa-198f30c806c5","name":"Thomsen, Marianne","rank":5,"rolecode":"pau"},{"affno":"","first":"Annette","key":"bruhnpedh","last":"Bruhn","name":"Bruhn, Annette","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"eisbn":["9788771564754"],"issue":"368","pages":"35-54","publisher":"Aarhus Universitet, DCE - Nationalt Center for Miljø og Energi ©","publisher_org":"Aarhus Universitet, DCE – Nationalt Center for Miljø og Energi ©","series":"Videnskabelig rapport fra DCE - Nationalt Center for Miljø og Energi","status":"p","title":"Marine Virkemidler: Beskrivelse af virkemidlernes effekter og status for vidensgrundlag"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["au-25bd2290-cd6b-4038-a834-5b95abebd8a9","dtu-77c8e53b-8fcc-4d3b-b753-9a11adf23911"],"src":["AU Aarhus University","DTU Technical University of Denmark"],"title":"Dyrkning af sukkertang","type":"Report Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.29-015336","year":"2020","yearsub":"2020"}
{"abstract":"BACKGROUND: The effects of social marginalization and health are well-documented, revealing a complex association between health perceptions and health behavior. This is especially evident among socially marginalized men. OBJECTIVE: This study aims to explore health perceptions and health behaviors influencing overall health among socially marginalized men who seem to not benefit from existing municipal health care in a large Danish municipality. These men have varying health challenges and engage in risky health behaviors, such as alcohol drinking, tobacco smoking, and lack of physical activity. DESIGN AND SAMPLE: This was an ethnographic study including 200 hr of participant observations and 25 interviews with socially marginalized men aged 45-65. RESULTS: Health was perceived as related to the ability to participate in daily life activities, such as getting around effortlessly and the ability to work. Alcohol drinking appeared to be part of a complex approach in managing everyday life, including various personal physical and mental health challenges and admission to social networks. CONCLUSION: Overall, the results provide important insight into how health perceptions and health behaviors are embedded in the men's everyday lives. This knowledge may be used by public health nurses and other health professionals in providing and developing health services.","author_count":4,"contributors":["Pedersen, Annette","Haslund-Thomsen, Helle Lønstrup","Curtis, Tine","Grønkjær, Mette"],"cuid":["S02-094.12-005321"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Alcohol and other drugs","Ethnography","Ethnography Relational coordination Teamwork Communication Relationship Interdisciplinary Perioperative nursing Patient safety","Health Behavior","Health behaviors","Health perceptions","MEN","Social marginalization","health nutrition and quality of life"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U","DI-UC"],"level3":{"OT":["Aalborg Municipality"],"U":["DI-U-AAU","DI-U-ALL"],"UC":["DI-UC-ALL","DI-UC-UCN"]},"level3all":["DI-U-AAU","DI-UC-UCN"]},"review":"pr","rtype":["clu"],"sorti":"health is not all about salads an ethnographic study on health perceptions and health behavior among socially marginalized danish men","src":["aau","ucn"],"src-code":["DI-U-AAU","DI-UC-UCN"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85084231754&partnerID=8YFLogxK","version":"Other Version"},"id":"S02-094.12-005321","identifier":[{"id":"85084231754","type":"scopus"},{"id":"32342571","type":"pmid"}],"ids":["aau-6db1b256-442b-4e0e-8609-d6aed739eb45","ucn-41485a4b-3b9d-4c60-a9d9-016ec2ed65b2"],"keyword":["Ethnography, Relational coordination, Teamwork, Communication, Relationship, Interdisciplinary, Perioperative nursing, Patient safety","Health Behavior","alcohol and other drugs","ethnography","health behaviors","health perceptions","health, nutrition and quality of life","men","social marginalization"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-7EF527C6C8D9B0E4F3A390165055896B"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"dk","key":"ucn university college of northern denmark","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-UCN","l3nl":"University College of Northern Denmark","l3nn":"UCN University College of Northern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"UCN University College of Northern Denmark","namevar":["University College of Northern Denmark"],"nora_code":"DI-UC-UCN","used":1},{"affno":"3","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Aalborg Municipality"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Annette","key":"pedersenpau","last":"Pedersen","locid":"20e7ece3-a0ad-4f51-b8f8-c4ff1989a272","name":"Pedersen, Annette","orcid":"0000-0002-7267-2856","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Helle","key":"haslundthomsenpau","last":"Haslund-Thomsen","locid":"7c65e556-5085-4d87-b1f3-e611d15eb594","name":"Haslund-Thomsen, Helle Lønstrup","name_org":"Haslund-Thomsen, Helle","orcid":"0000-0002-5260-9155","rank":2,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"first":"Tine","key":"curtispau","last":"Curtis","locid":"360a65e7-1be8-4fb5-a513-6d21a834ba50","name":"Curtis, Tine","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mette","key":"grønkjaerpau","last":"Grønkjaer","locid":"574b63eb-8aff-43ac-b907-12a665ace204","name":"Grønkjær, Mette","name_org":"Grønkjaer, Mette","orcid":"0000-0003-1558-7062","rank":4,"rolecode":"pau"}],"pmid":["32342571"],"pub":{"doi":"10.1111/phn.12737","issn":["07371209","15251446"],"issn_org":["07371209"],"issue":"4","journal":"Public Health Nursing","pages":"487-493","publisher":"Wiley-Blackwell","status":"p","title":"Public Health Nursing","volume":"37"},"review":"Peer Reviewed","scoID":["2-s2.0-85084231754"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","All University Colleges","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","DI-UC","DI-