University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Oncology (Odense)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Kristoffer B.","key":"kristensenpau","last":"Kristensen","locid":"1a00bd47-d4f5-4dad-9bc3-2e1c31b37a22","name":"Kristensen, Kristoffer B.","rank":1,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Ida Marie Nedergaard","key":"thomsenpau","last":"Thomsen","name":"Thomsen, Ida Marie Nedergaard","rank":2,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Tobias","key":"bergpau","last":"Berg","name":"Berg, Tobias","rank":3,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Annette R.","key":"kodahlpau","last":"Kodahl","locid":"6b592e49-adaa-425e-abb2-ba751338c319","name":"Kodahl, Annette Raskov","name_org":"Kodahl, Annette R.","orcid":"0000-0003-0515-9144","rank":4,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Anders Bonde","key":"jensenpau","last":"Jensen","locid":"bc1410f2-b563-4741-8f04-b019a2562102","name":"Jensen, Anders Bonde","rank":5,"rolecode":"pau"}],"pmid":["33837869"],"pub":{"doi":"10.1007/s10549-021-06215-6","issn":["01676806","15737217"],"issn_org":["01676806"],"issue":"3","journal":"Breast Cancer Research and Treatment","pages":"799-809","publisher":"Springer","status":"p","title":"Breast Cancer Research and Treatment","volume":"188"},"review":"Peer Reviewed","scoID":["2-s2.0-85104234659"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-0164b09a-6bd1-4631-a210-2690c5b476d0","sdu-a7ee2617-7c0c-465f-be4a-27740189b07a"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"Dose modifications of ribociclib and endocrine therapy for treatment of ER+ HER2− metastatic breast cancer","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-012685","year":"2021","yearsub":"2021"}
{"abstract":"The international literature shows that primary care is well placed to address mental health problems in young people, but that primary care professionals experience a range of challenges in this regard. In Denmark, young adults who have complex psychosocial problems, and who are not in education or work, cause political and academic concern. They are also in regular contact with their general practitioners, the Danish municipalities and psychiatric services. However, little is known about general practitioners' perspectives on caring for this vulnerable group of patients. In this article, we investigate how general practitioners' care work is shaped by the bureaucratic management of care in a complex infrastructure network comprising the general practitioners, psychiatry, the municipalities and the young adults. The analysis is based on interviews and focus groups with general practitioners, psychiatric nurses and social workers. We employ Tronto's concept of care and the concept of boundary work as a theoretical framework. We argue that general practitioners strive to provide care, but they are challenged by the following: contested diagnostic interpretations and the bureaucratic significance of diagnoses for the provision of care from psychiatry and the municipalities, systemic issues with handling intertwined social and mental health problems, and the young adults' difficulties with accessing and receiving available care.","author_count":4,"contributors":["Andersen, Julie Høgsgaard","Tjørnhøj-Thomsen, Tine","Reventlow, Susanne","Davidsen, Annette Sofie"],"cuid":["S02-100.00-047360"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"corresponding_author":["Andersen, Julie Høgsgaard"],"keyword":["General Practitioners","Mental health","Primary care","Psychosocial problems","Young adults"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"challenging care work general practitioners perspectives on caring for young adults with complex psychosocial problems","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85073933613","version":"Other Version"},"id":"S02-100.00-047360","identifier":[{"id":"31495235","type":"pmid"},{"id":"000485369000001","type":"wos"},{"id":"85073933613","type":"scopus"}],"ids":["ku-f32a8292-cec0-435c-ad78-0bd90187f6e9","sdu-d48c07be-72b2-4186-8737-91cb1920ef05"],"keyword":["general practitioners","mental health","primary care","psychosocial problems","young adults"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-1ABDD7E54355737FDCAFA01CAB151079"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, External Centres, Forskningsenheden for Almen Praksis"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, National Institute of Public Health, Department of Health and Social Context"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","first":"Julie Hogsgaard","key":"andersenpau","last":"Andersen","locid":"5027e5a4-ff0d-4aba-bec9-06d27c79e0e9","name":"Andersen, Julie Høgsgaard","name_org":"Andersen, Julie Hogsgaard","orcid":"0000-0001-5685-5399","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Tine","key":"tjørnhøjthomsenpau","last":"Tjørnhøj-Thomsen","locid":"bc043d50-4a2b-41c1-a085-da4a674866f3","name":"Tjørnhøj-Thomsen, Tine","orcid":"0000-0003-3621-6682","rank":2,"rolecode":"pau"},{"affno":"1","first":"Susanne","key":"reventlowpau","last":"Reventlow","locid":"8b7d6185-d9ad-4f0e-9b8f-cd49a30374ef","name":"Reventlow, Susanne","orcid":"0000-0002-4990-142X","rank":3,"rolecode":"pau"},{"affno":"1","first":"Annette Sofie","key":"davidsenpau","last":"Davidsen","locid":"912ed585-921f-465e-83d4-a06e52697aed","name":"Davidsen, Annette Sofie","orcid":"0000-0002-5434-0997","rank":4,"rolecode":"pau"}],"pmid":["31495235"],"pub":{"doi":"10.1177/1363459319874100","issn":["13634593","14617196"],"issn_org":["13634593"],"issue":"2","journal":"Health","pages":"214-230","publisher":"SAGE Publications","status":"p","title":"Health","volume":"25"},"review":"Peer Reviewed","scoID":["2-s2.0-85073933613"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-f32a8292-cec0-435c-ad78-0bd90187f6e9","sdu-d48c07be-72b2-4186-8737-91cb1920ef05"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Challenging care work : General practitioners' perspectives on caring for young adults with complex psychosocial problems","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-047360","year":"2021","yearsub":"2021"}
{"abstract":"Macroinvertebrate communities are crucial for biodiversity monitoring and assessment of ecological status in stream ecosystems. However, traditional monitoring approaches require intensive sampling and rely on invasive morphological identifications that are time‐consuming and dependent on taxonomic expertise. Importantly, sampling is often only carried out once in a year, namely during late winter–spring, where most indicator taxa have larval stages in the streams. Hence, species with divergent phenology might not be detected. Here, we use environmental DNA (eDNA) metabarcoding of filtered water samples collected in both spring and autumn from five streams in Denmark to address seasonal turnover in community composition of stream macroinvertebrates. We find that eDNA read data from the same stream sampling site clearly show different communities in spring and autumn, respectively. For three of the five streams, season even appears to be a more important factor than sampling site for explaining the variation in community composition. Finally, we compare eDNA data with a near‐decadal dataset of taxon occurrences in the same five streams based on kick sampling conducted through a national monitoring program. This comparison reveals an overlap in species composition, but also that the two approaches provide complementary rather than identical insights into community composition. Our study demonstrates that aquatic eDNA metabarcoding is useful for species detection across highly diverse taxa and for identifying seasonal patterns in community composition of freshwater macroinvertebrates. Thus, our results have important implications for both fundamental research in aquatic ecology and for applied biomonitoring.","author_count":7,"contributors":["Jensen, Mads Reinholdt","Sigsgaard, Eva Egelyng","Agersnap, Sune","Rasmussen, Jes Jessen","Baattrup-Pedersen, Annette","Wiberg-Larsen, Peter","Thomsen, Philip Francis"],"cuid":["S01-000.00-263226"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Jensen, Mads Reinholdt","Thomsen, Philip Francis"],"country":["Norway"],"glorg":["All Global Affiliations","Norwegian Institute for Water Research"],"keyword":["Arthropods","Community structure","Genetic monitoring","Metabarcoding","Seasonality","environmental DNA"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"seasonal turnover in community composition of stream associated macroinvertebrates inferred from freshwater environmental dna metabarcoding","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1002/edn3.193","version":"Published Version"},"id":"S01-000.00-263226","identifier":[{"id":"85110032303","type":"scopus"}],"ids":["au-ea94bff8-dafc-4dd7-a12d-1ae9f6ae74d1"],"keyword":["arthropods","community structure","environmental DNA","genetic monitoring","metabarcoding","seasonality"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-DC9760736FB60B861C4675FBC0FA3497"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1002/edn3.193","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Biology, Department of Biology - Genetics, Ecology and Evolution"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"no","key":"norwegian institute for water research","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"Norwegian Institute for Water Research","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Mads Reinholdt","key":"jensenpau","last":"Jensen","locid":"edafc120-cec0-41cd-b556-c4726954065e","name":"Jensen, Mads Reinholdt","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Eva Egelyng","key":"sigsgaardpau","last":"Sigsgaard","locid":"9cb234ea-9c14-4681-8360-e34e0ab26cbd","name":"Sigsgaard, Eva Egelyng","orcid":"0000-0002-9396-1550","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sune","key":"agersnappau","last":"Agersnap","locid":"db56d01f-95ca-4736-b772-be1407a9a058","name":"Agersnap, Sune","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jes Jessen","key":"rasmussenpau","last":"Rasmussen","name":"Rasmussen, Jes Jessen","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Annette","key":"baattruppedersenpau","last":"Baattrup-Pedersen","locid":"e4f5886d-70a8-4174-a224-b21d0dfc8689","name":"Baattrup-Pedersen, Annette","orcid":"0000-0002-3118-344X","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Peter","key":"wiberglarsenpau","last":"Wiberg-Larsen","locid":"71daa3aa-f70d-4a8f-b202-a881d8e0d12c","name":"Wiberg-Larsen, Peter","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Philip Francis","key":"thomsenpau","last":"Thomsen","locid":"42e3d0c2-8389-45cd-aa6f-82004d696ccb","name":"Thomsen, Philip Francis","rank":7,"rolecode":"pau"}],"pub":{"doi":"10.1002/edn3.193","issn":["26374943"],"issue":"4","journal":"Environmental DNA","pages":"861-876","publisher":"John Wiley & Sons Inc.","status":"p","title":"Environmental DNA","volume":"3"},"review":"Peer Reviewed","scoID":["2-s2.0-85110032303"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-ea94bff8-dafc-4dd7-a12d-1ae9f6ae74d1"],"src":["AU Aarhus University"],"title":"Seasonal turnover in community composition of stream‐associated macroinvertebrates inferred from freshwater environmental DNA metabarcoding","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-263226","year":"2021","yearsub":"2021"}
{"abstract":"A Danish strain of the green microalgae Scenedesmus sp. was isolated, identified and characterized with respect to productivity under outdoor cultivation conditions at northern latitudes. The algae were cultivated outdoors in Denmark in closed tubular photobioreactors using only sunlight, simple inorganic nutrients and under ambient temperatures. The biomass composition was evaluated in terms of protein content and quality. The average volumetric and areal biomass productivity obtained for the Scenedesmus sp. isolate during outdoor cultivation was 0.083 g dry matter L−1 and 6.40 g dm m−2 day−1, respectively. Thus, productivities are comparable to data reported in the literature under similar conditions. A strain-specific nitrogen to protein conversion factor of 5.5 was determined for the Scenedesmus sp. strain enabling more accurate protein estimations from simple nitrogen determination methods like Kjeldahl analysis in the future. The protein content was determined to be 52.4% of dried biomass for this Scenedesmus strain. The sum of essential amino acids was 42% which is high compared to other microalgae. The results are compared and discussed in comparison to other microalgae and soybean as a common plant protein source.","author_count":6,"contributors":["Olsen, Malene Fog Lihme","Pedersen, Jakob Skov","Thomsen, Sune Tjalfe","Martens, Helle Juel","Petersen, Annette","Jensen, Poul Erik"],"cuid":["S01-000.00-492991"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Faculty of Science"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GTS","DI-U"],"level3":{"GTS":["DI-GTS-ALL","DI-GTS-DTCI"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-GTS-DTCI","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"outdoor cultivation of a novel isolate of the microalgae i scenedesmus sp i and the evaluation of its potential as a novel protein crop","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/279649844/Outdoor_cultivation_of_a_novel_isolate_of_the_microalgae_Scenedesmus_sp._and_the_evaluation_of_its_potential_as_a_novel_protein_crop_accepted_version_.pdf","version":"Authors Final Version"},"id":"S01-000.00-492991","identifier":[{"id":"85114869509","type":"scopus"},{"id":"34427928","type":"pmid"}],"ids":["ku-a6b597ea-b6d9-4091-ab58-f7fd6abacd98"],"keyword":["Faculty of Science"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-D1B2AE4A85FA17F4680C9711BF52D357"],"oa_link":[{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/279649844/Outdoor_cultivation_of_a_novel_isolate_of_the_microalgae_Scenedesmus_sp._and_the_evaluation_of_its_potential_as_a_novel_protein_crop_accepted_version_.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"dk","key":"danish technological institute","l2":"DI-GTS","l2n":"GTS Institutes","l3":"DI-GTS-DTCI","l3nn":"Danish Technological Institute","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Danish Technological Institute","namevar":["Technological Institute"],"nora_code":"DI-GTS-DTCI","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Food Science, Ingredient and Dairy Technology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Malene Fog Lihme","key":"olsenpau","last":"Olsen","name":"Olsen, Malene Fog Lihme","rank":1,"rolecode":"pau"},{"affno":"1","first":"Jakob Skov","key":"pedersenpau","last":"Pedersen","name":"Pedersen, Jakob Skov","rank":2,"rolecode":"pau"},{"affno":"","first":"Sune Tjalfe","key":"thomsenpau","last":"Thomsen","locid":"409a6b0a-26cb-47b9-a1b4-f9b5900f8813","name":"Thomsen, Sune Tjalfe","orcid":"0000-0001-8908-9977","rank":3,"rolecode":"pau"},{"affno":"","first":"Helle J.","key":"martenspau","last":"Martens","locid":"cd7f808e-0b4a-4423-9846-d3a81d0fad26","name":"Martens, Helle Juel","name_org":"Martens, Helle J.","orcid":"0000-0002-3011-4557","rank":4,"rolecode":"pau"},{"affno":"1","first":"Annette","key":"petersenpau","last":"Petersen","name":"Petersen, Annette","rank":5,"rolecode":"pau"},{"affno":"2","first":"Poul Erik","key":"jensenpau","last":"Jensen","locid":"cb8fdf4a-6052-43b4-b731-384346885e4d","name":"Jensen, Poul Erik","orcid":"0000-0001-6524-7723","rank":6,"rolecode":"pau"}],"pmid":["34427928"],"pub":{"doi":"10.1111/ppl.13532","issn":["00319317","13993054"],"issn_org":["13993054"],"issue":"2","journal":"Physiologia Plantarum","pages":"483-494","status":"p","title":"Physiologia Plantarum","volume":"173"},"review":"Peer Reviewed","scoID":["2-s2.0-85114869509"],"search":{"DAF":["All Danish Affiliations","All GTS Institutes","All Universities","DI-ALL","DI-GTS","DI-GTS-ALL","DI-U","DI-U-ALL","GTS Institutes","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-a6b597ea-b6d9-4091-ab58-f7fd6abacd98"],"src":["KU University of Copenhagen"],"title":"Outdoor cultivation of a novel isolate of the microalgae <i>Scenedesmus sp.</i> and the evaluation of its potential as a novel protein crop","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-492991","year":"2021","yearsub":"2021"}
{"abstract":"Word retrieval and lexical organization were explored in 16 Danish children with slight to severe hearing loss (HL), 11 children with developmental language disorder (DLD), and 25 typically developing (TD) children in the age range of 7 to 12 years. There is a special focus on children with HL with and without language difficulties compared with children with DLD. Word retrieval and lexical organization are assessed with a Semantic Verbal Fluency Task. Background assessment of language comprehension is assessed with Test for Reception of Grammar–Version 2 (TROG-2) and nonverbal IQ is assessed with Block Design from the Wechsler Intelligence Scale for Children–Fourth Edition (WISC-IV). Main findings show that children with HL without language difficulties did not show any significant word retrieval or lexical organization difficulties compared with TD children. However, there was a resemblance between children with DLD and children with HL with language difficulties in word retrieval and lexical organization.","author_count":2,"contributors":["Esbensen, Annette","Thomsen, Pia"],"cuid":["S01-000.00-597346"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Esbensen, Annette"],"keyword":["Children","Developmental language disorder","Hearing loss"],"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-PR-OTH","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"word retrieval and lexical organization in children with hearing loss and developmental language disorder","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85087089432","version":"Other Version"},"id":"S01-000.00-597346","identifier":[{"id":"85087089432","type":"scopus"}],"ids":["sdu-541ccfb5-2523-49d7-995a-b03d9f0309c0"],"keyword":["children","developmental language disorder","hearing loss","lexical organization","word retrieval"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Global-Local-2-4-BB6B8D498A13688FA5CEF0DA3449154A"],"oai":{"class":"Unused","mra":["Humanities (HUM)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Humanities, Department of Language and Communication"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["Huset Pia Thomsen Aps"],"nora_code":"DI-PR-OTH","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Annette","key":"esbensenpau","last":"Esbensen","locid":"07db5344-e3b2-4204-b923-304805c7ce19","name":"Esbensen, Annette","orcid":"0000-0002-4472-4487","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Pia","key":"thomsenpau","last":"Thomsen","name":"Thomsen, Pia","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1177/1525740120932531","issn":["15257401","15384837"],"issn_org":["15257401"],"issue":"4","journal":"Communication Disorders Quarterly","pages":"238-248","publisher":"SAGE Publications","status":"p","title":"Communication Disorders Quarterly","volume":"42"},"review":"Peer Reviewed","scoID":["2-s2.0-85087089432"],"search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Other Companies","Private Research","Universities","University of Southern Denmark","huset pia thomsen aps"],"PST":["Published"]},"sid":["sdu-541ccfb5-2523-49d7-995a-b03d9f0309c0"],"src":["SDU University of Southern Denmark"],"title":"Word retrieval and lexical organization in children with hearing loss and developmental language disorder","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-597346","year":"2021","yearsub":"2021"}
{"abstract":"Purpose: The aim of this study was to describe changes in pulmonary function from the supine to the sitting position following cardiac surgery. Methods: In a descriptive before–after design, we used the Beacon Caresystem for measurement of alveolar ventilation (V A). The Spiropalm 6MWT was used to measure tidal volume (Vt), inspiratory capacity (IC) and peripheral oxygen saturation (SpO 2). Assessments were performed 2–3 days post-operatively with patients in the supine position and again with patients sitting in a chair. Results: Fifteen patients were included. Compared to the supine position, sitting in a chair significantly improved V A by 20% (p <.000); Vt by 25% (p =.015); IC by 21% (p =.036) and SpO 2 by 0.9% (p =.018). Conclusion: Lung function including alveolar ventilation was improved in the sitting compared to the supine position and was accompanied by improved oxygenation after uncomplicated, elective cardiac surgery. Further research is warranted to describe the impact of changes in positions in patients who do not follow a standardised clinical pathway.","author_count":5,"contributors":["Fjerbæk, Annette","Westerdahl, Elisabeth","Andreasen, Jan Jesper","Thomsen, Lars Pilegaard","Brocki, Barbara C."],"cuid":["S01-000.00-076212"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Cardiac surgery","Early mobilisation","Physiotherapy","Posture","Pulmonary function"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"change of position from a supine to a sitting position increases pulmonary function early after cardiac surgery","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85066982389&partnerID=8YFLogxK","version":"Other Version"},"id":"S01-000.00-076212","identifier":[{"id":"85066982389","type":"scopus"}],"ids":["aau-5a2d52a3-578a-4fe6-a771-e8c927e27819"],"keyword":["Pulmonary function","alveolar ventilation","cardiac surgery","early mobilisation","physiotherapy","posture"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-C5CBC1F8BBE84921885989B7FD2A3E7D"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Physiotherapy and Occupational Therapy","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Hoved-Orto"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Annette","key":"fjerbaekpau","last":"Fjerbaek","locid":"7619bdb6-c9d3-4e77-99f6-cee5500e3901","name":"Fjerbæk, Annette","name_org":"Fjerbaek, Annette","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Elisabeth","key":"westerdahlpau","last":"Westerdahl","name":"Westerdahl, Elisabeth","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jan J","key":"andreasenpau","last":"Andreasen","locid":"64f82f01-dc7b-4ed4-873a-940774d8921e","name":"Andreasen, Jan Jesper","name_org":"Andreasen, Jan J","orcid":"0000-0002-2382-3734","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars P.","key":"thomsenpau","last":"Thomsen","locid":"ab7fb14a-9937-4e1d-b345-d7086429cb55","name":"Thomsen, Lars Pilegaard","name_org":"Thomsen, Lars P.","orcid":"0000-000