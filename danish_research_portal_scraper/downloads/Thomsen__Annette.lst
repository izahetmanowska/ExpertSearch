-KU","used":1},{"affno":"5","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["Pharmacosmos AS"],"nora_code":"DI-PR-OTH","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Annette","key":"burkhartpau","last":"Burkhart","locid":"7b6bd909-a011-463c-9e09-3623fee043b3","name":"Burkhart, Annette","orcid":"0000-0003-2086-4693","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Kasper Bendix","key":"johnsenpau","last":"Johnsen","locid":"9708610d-3b17-4250-bc1e-6bd2c994c9ba","name":"Johnsen, Kasper Bendix","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Tina","key":"skjørringepau","last":"Skjørringe","locid":"75e49845-8065-4dea-b009-24a75d84e69f","name":"Skjørringe, Tina","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Asbjørn Haaning","key":"nielsenpau","last":"Nielsen","locid":"a8195f06-236e-45dc-a27c-e2125fceb03e","name":"Nielsen, Asbjørn Haaning","orcid":"0000-0003-4464-8549","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lisa Juul","key":"routhepau","last":"Routhe","locid":"ee04ff5c-7d9d-4c64-983b-5b1260adea02","name":"Routhe, Lisa Juul","orcid":"0000-0003-3658-5859","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Sandra","key":"hertzpau","last":"Hertz","locid":"5d45b96c-6488-4725-a9f6-fef9e345b894","name":"Hertz, Sandra","rank":6,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Lisbeth Birk","key":"møllerpau","last":"Møller","name":"Møller, Lisbeth Birk","rank":7,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Lars Lykke","key":"thomsenpau","last":"Thomsen","name":"Thomsen, Lars Lykke","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Torben","key":"moospau","last":"Moos","locid":"e51cbd29-97d2-42d8-bbca-11f026378a2f","name":"Moos, Torben","rank":9,"rolecode":"pau"}],"pmid":["39408231"],"pub":{"doi":"10.3390/nu16193264","issn":["20726643"],"issue":"19","journal":"Nutrients","paperid":"3264","publisher":"MDPI AG","publisher_org":"M D P I AG","status":"p","title":"Nutrients","volume":"16"},"review":"Peer Reviewed","scoID":["2-s2.0-85206514543"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Private Research","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Hospitals","Other Companies","Private Research","Technical University of Denmark","Universities","University of Copenhagen","pharmacosmos as"],"PST":["Published"]},"sid":["aau-046553d6-91d5-4672-81c0-c9a3c3c028a8","dtu-1cc3aea0-e142-4574-be9e-7664e6924ef4"],"src":["AAU Aalborg University","DTU Technical University of Denmark"],"title":"Normalization of Fetal Cerebral and Hepatic Iron by Parental Iron Therapy to Pregnant Rats with Systemic Iron Deficiency without Anemia","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-784746","year":"2024","yearsub":"2024"}
{"abstract":"The prevalence of hyperthyroidism and hypothyroidism and associated risk factors are unknown in liver transplant recipients. We aimed to determine the prevalence of hyperthyroidism and hypothyroidism and associated risk factors in liver transplant recipients and to compare it with controls from the general population. As part of the Danish Comorbidity in Liver Transplant Recipients (DACOLT) Study, all Danish liver transplant recipients over the age of 20 were invited for measurements of concentrations of thyrotropin and thyroid hormones. The prevalence of hyperthyroidism and hypothyroidism was compared to age- and sex-matched controls from the Copenhagen General Population Study. Using logistic regression adjusted for age, sex, smoking, and body-mass index, we investigated potential risk factors. We recruited 489 liver transplant recipients and 1808 controls. Among liver transplant recipients, 14 (2.9%) had hyperthyroidism compared with 21 (1.2%) of controls (adjusted odds ratio [aOR] 2.24, 95% confidence interval [CI] 1.05–4.75, P = 0.04), while 42 (5.7%) had hypothyroidism compared with 139 (7.7%) of controls (aOR 0.68, 95% CI 0.43–1.08, P = 0.10). Female sex, and autoimmune hepatitis and primary sclerosing cholangitis as causes of transplantation were associated with hyperthyroidism after adjustments. Age, female sex, and autoimmune liver diseases as cause of transplantation were associated with hypothyroidism after adjustments. DACOLT is registered in ClinicalTrials.gov (NCT04777032).","author_count":16,"contributors":["Suarez-Zdunek, Moises Alberto","Arentoft, Nicoline Stender","Krohn, Paul Suno","Lauridsen, Emilie Høegholm Ernst","Afzal, Shoaib","Høgh, Julie","Thomsen, Magda Teresa","Knudsen, Andreas Dehlbæk","Nordestgaard, Børge G","Hillingsø, Jens","Villadsen, Gerda Elisabeth","Holland-Fischer, Peter","Rasmussen, Allan","Fialla, Anette Dam","Feldt-Rasmussen, Ulla","Nielsen, Susanne Dam"],"cuid":["S04-100.00-734992"],"filters":{"added":"2024-05",