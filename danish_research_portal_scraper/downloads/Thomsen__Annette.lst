{"author_count":5,"contributors":["Bruhn, Annette","Thomsen, Marianne","Wegeberg, Susse","Gylling, Morten","Hermansen, John Erik"],"cuid":["S01-000.00-208779"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["T0 2018"],"level":"com","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"nr","rtype":["clu"],"sorti":"blå biomasse","src":["au"],"src-code":["DI-U-AU"],"type":"doo","type-grp":["all","pub"]},"id":"S01-000.00-208779","ids":["au-8b4506b7-4326-4b79-b556-be556059ad06"],"keyword":["T0-2018"],"lang":"Danish","level":"Commissioned","mra":["Science/Technology"],"noi":["Local-1-1-1127ED8EEB17D02F4CB98D18520B8EE0"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Ecoscience, Department of Ecoscience - Marine Ecology"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Annette","key":"bruhnpau","last":"Bruhn","locid":"15559017-3036-4e04-968e-338a24d800ce","name":"Bruhn, Annette","orcid":"0000-0002-7940-1338","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Marianne","key":"thomsenpau","last":"Thomsen","locid":"92402c50-d634-4163-a3fa-198f30c806c5","name":"Thomsen, Marianne","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Susse","key":"wegebergpau","last":"Wegeberg","locid":"05370847-e1d3-4253-b818-046251260ff5","name":"Wegeberg, Susse","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Morten","key":"gyllingped","last":"Gylling","name":"Gylling, Morten","rank":4,"role":"Editor","rolecode":"ped"},{"affno":"1","corresponding":null,"first":"John Erik","key":"hermansenped","last":"Hermansen","locid":"2bf577ac-b06f-42f8-8937-b365c171c066","name":"Hermansen, John Erik","rank":5,"role":"Editor","rolecode":"ped"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-8b4506b7-4326-4b79-b556-be556059ad06"],"src":["AU Aarhus University"],"title":"Blå biomasse","type":"Other-Unknown","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-208779","year":"2018","yearsub":"2018"}
{"abstract":"BACKGROUND: Radical inguinal lymphadenectomy (ILND) for metastatic melanoma is associated with a high complication rate. Seroma is often the first postoperative complication, followed by prolonged wound healing sometimes requiring reoperation, infection, multiple outpatient visits and re-hospitalization. Prevention of seroma may, therefore, lead to a reduction in many of the other complications. METHODS/DESIGN: The primary aim of this randomized study is to investigate whether fewer patients require treatment for seroma by immediate prophylactic application of incisional, Negative-pressure Wound Therapy (iNPWT) following ILND, compared to standard postoperative treatment. The secondary outcomes include surgical-site infection, dehiscence, hematoma, length of hospitalization, quality of life, safety, long-term assessment of lymphedema and non-inferiority oncological outcome. Data will be registered prospectively at check-ups after 7 and 14 days, 1 and 3 months and 2 years after inguinal lymphadenectomy using case report forms and questionnaires and stored in a secure online database. DISCUSSION: To our knowledge, this trial is the first randomized study evaluating negative-pressure wound therapy as a prophylactic intervention for complications following melanoma-related ILND. The results from this trial will hopefully determine the efficacy and safety of prophylactic iNPWT treatment in prevention of the clinical relevant short- and long-term postoperative complications following ILND and may provide an evidence base for the an improved postoperative regimen. TRIAL REGISTRATION: ClinicalTrials.gov, ID: NCT03433937 . Prospectively registered on 15 February 2018.","author_count":8,"contributors":["Gustaf Jørgensen, Mads","Toyserkani, Navid Mohamadpour","Hyldig, Nana","Chakera, Annette H.","Hölmich, Lisbet Rosenkrantz","Thomsen, Jørn Bo","Sørensen, Jens Ahm"],"cuid":["S02-097.94-041216"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Sørensen, Jens Ahm"],"keyword":["Clinical Protocols","Denmark","Humans","Lymph Node Excision adverse effects","Lymph node dissection","Lymphatic Metastasis","Lymphedema","Melanoma","Melanoma secondary","Negative Pressure Wound Therapy","Negative Pressure Wound Therapy adverse effects","Prevention","Prospective Studies","Research Design","Seroma","Seroma diagnosis","Skin Neoplasms pathology","Surgical site infection","Time Factors","Treatment Outcome"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-ZEA"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-ZEA","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"prevention of seroma following inguinal lymph node dissection with prophylactic incisional negative pressure wound therapy seroma trial study protocol for a randomized controlled trial","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s13063-018-2757-6","version":"Published Version"},"id":"S02-097.94-041216","identifier":[{"id":"PMC6094459","type":"pmcid"},{"id":"85051719220","type":"scopus"},{"id":"30111378","type":"pmid"}],"ids":["ku-2e8f9b25-fa9d-403a-b568-7e00506a28ec","sdu-c6e54014-fda2-4539-a4a7-31550c5ff903"],"keyword":["Clinical Protocols","Denmark","Humans","Lymph Node Excision/adverse effects","Lymph node dissection","Lymphatic Metastasis","Lymphedema","Melanoma","Melanoma/secondary","Negative-Pressure Wound Therapy/adverse effects","Negative-pressure wound therapy","Prevention","Prospective Studies","Research Design","Seroma","Seroma/diagnosis","Skin Neoplasms/pathology","Surgical-site infection","Time Factors","Treatment Outcome"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["