"Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Kattegatcentret"],"nora_code":"DI-OT","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Food Science, Design and Consumer Behavior"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Marie","key":"maarpau","last":"Maar","locid":"82a27bc5-38c0-4f2b-808e-b451f47d5adc","name":"Maar, Marie","orcid":"0000-0001-8594-2993","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Andreas Michael","key":"holbachpau","last":"Holbach","locid":"e861bdea-068c-47a9-9dfd-30d68afdec9e","name":"Holbach, Andreas Michael","orcid":"0000-0002-7665-9341","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Teis","key":"boderskovpau","last":"Boderskov","locid":"c63d7c51-d48b-4a3f-a126-3b71bd450fc6","name":"Boderskov, Teis","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lone Thybo","key":"mouritsenpau","last":"Mouritsen","name":"Mouritsen, Lone Thybo","rank":4,"rolecode":"pau"},{"affno":"3","first":"Marianne","key":"thomsenpau","last":"Thomsen","locid":"a829b47d-f5d2-404d-b768-ec12fbb3b661","name":"Thomsen, Marianne","orcid":"0000-0003-2453-5141","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Annette","key":"bruhnpau","last":"Bruhn","locid":"15559017-3036-4e04-968e-338a24d800ce","name":"Bruhn, Annette","orcid":"0000-0002-7940-1338","rank":6,"rolecode":"pau"}],"pub":{"issn":["09087761"],"issue":"2","journal":"Vand & Jord","pages":"52-55","status":"p","title":"Vand & Jord","volume":"31"},"review":"Undetermined","search":{"DAF":["Aarhus University","All Danish Affiliations","All Misc