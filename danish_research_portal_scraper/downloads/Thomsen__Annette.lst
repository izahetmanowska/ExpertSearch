aa-4d2a-b67a-6856816e1e5c","name":"Fossing, Henrik","orcid":"0000-0001-5193-176X","rank":32,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Birte","key":"boeltbirtepau","last":"Boelt","locid":"f856feb6-10e1-4936-a4e5-0ccee7073cc5","name":"Boelt, Birte","orcid":"0000-0003-4277-0196","rank":33,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"René","key":"gislumrenépau","last":"Gislum","locid":"cad294b9-9707-4ac9-9596-aaae83673a95","name":"Gislum, René","rank":34,"rolecode":"pau"}],"pub":{"isbn":["9788793176447"],"issn":["22451684"],"pages":"327","place":"DCA - Blichers Allé 20, 8830 Tjele","publisher":"DCA - Nationalt Center for Fødevarer og Jordbrug","repno":"DCA rapport","series":"DCA rapport","status":"p","volume":"052"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-4bc77c06-0589-411c-b54c-af6408a7ed92"],"src":["AU Aarhus University"],"title":"Virkemidler til realisering af 2. generations vandplaner og målrettet arealregulering","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-737037","year":"2014","yearsub":"2014"}
{"abstract":"BACKGROUND: Ruptured abdominal aortic aneurysm (rAAA) is associated with high mortality. Research suggests that statins may reduce abdominal aortic aneurysm (AAA) growth and improve rAAA outcomes. However, the clinical impact of statins remains uncertain in relation to both the risk and prognosis of rAAA. METHODS: This nationwide, population-based, combined case-control and follow-up study included all patients (aged at least 50 years) with a first-time hospital admission for rAAA and 1:1 matched AAA controls without rupture in Denmark from 1996 to 2008. Individual-level data on preadmission drug use, co-morbidities, socioeconomic markers, healthcare contacts and death were obtained from Danish nationwide registries. RESULTS: The study included 3584 cases and 3584 matched controls. Current statin use was registered for 418 patients with rAAA (11.7 per cent) and 539 AAA controls (15.0 per cent), corresponding to an age- and sex-matched odds ratio (OR) of 0.70 (95 per cent confidence interval (c.i.) 0.60 to 0.81) for rAAA in current statin users versus never users. The decreased risk of rAAA remained after adjustment for potential confounding factors (adjusted OR 0.73, 0.61 to 0.86). The overall 30-day mortality rate from time of hospital admission among patients with rAAA was 46.1 per cent in current statin users compared with 59.3 per cent in never users (adjusted mortality rate ratio (MRR) 0.80, 95 per cent c.i. 0.68 to 0.95). Patients who had formerly used statins did not have reduced mortality (adjusted MRR 0.98, 0.78 to 1.22). CONCLUSION: Statin use was associated with a reduced risk of rAAA and lower case fatality following rAAA. These results support current guidelines that recommend statin therapy in patients diagnosed with AAA.","author_count":6,"contributors":["Wemmelund, Holger","Høgh, Annette","Hundborg, Heidi Holmager","Thomsen, Reimar Wernich","Johnsen, Søren Paaske","Lindholt, Jes S."],"cuid":["S02-100.00-029179"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Aged","Aortic Aneurysm Abdominal","Aortic Rupture","Case Control Studies","Denmark","Female","Follow Up Studies","Health Behavior","Hospitalization","Humans","Hydroxymethylglutaryl CoA Reductase Inhibitors","Male","Middle Aged","Socioeconomic Factors"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR"],"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-HO-CDR","DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"statin use and rupture of abdominal aortic aneurysm","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1002/bjs.9517","version":"Other Version"},"id":"S02-100.00-029179","identifier":[{"id":"24849021","type":"pmid"},{"id":"84902281913","type":"scopus"}],"ids":["au-e3eb57a4-11fe-4739-8ad4-6eaf43b5ef86","sdu-4cecb13e-673b-44bc-bce6-29c4de0954ba"],"keyword":["Aged","Aortic Aneurysm, Abdominal","Aortic Rupture","Case-Control Studies","Denmark","Female","Follow-Up Studies","Health Behavior","Hospitalization","Humans","Hydroxymethylglutaryl-CoA Reductase Inhibitors","Male","Middle Aged","Socioeconomic Factors"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-E473A44350E10F4133B0B168569B5116"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1002/bjs.9517","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Clinical Epidemiology"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital (AUH)"],"nora_code":"DI-HO-CDR","used":1},{"affno":"3","country":"dk","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["University of Southern Denmark (SDU)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1 2","corresponding":null,"country":"dk","first":"H","key":"wemmelundpau","last":"Wemmelund","locid":"cb5ce986-d98a-4d46-9719-6da0669bf49c","name":"Wemmelund, Holger","name_org":"Wemmelund, H","orcid":"0000-0002-5478-4889","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"A","key":"høghpau","last":"Høgh","locid":"78c4f7b4-e4f6-454b-8984-f1cdc83e4a82","name":"Høgh, Annette","name_org":"Høgh, A","orcid":"0000-0001-7525-9007","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"H H","key":"hundborgpau","last":"Hundborg","locid":"32e91f0a-23ba-4d70-9192-6c66268ed690","name":"Hundborg, Heidi Holmager","name_org":"Hundborg, H H","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"R W","key":"thomsenpau","last":"Thomsen","locid":"36e7af2c-e02f-48d4-b124-0f1bd95b1748","name":"Thomsen, Reimar Wernich","name_org":"Thomsen, R W","orcid":"0000-0001-9135-3474","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"S P","key":"johnsenpau","last":"Johnsen","locid":"4664f7a0-39e7-4f46-9121-1c3999eb3d09","name":"Johnsen, Søren Paaske","name_org":"Johnsen, S P","rank":5,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"first":"J S","key":"lindholtpau","last":"Lindholt","locid":"8c04d12e-9a82-4ded-8763-b9e82e31afd8","name":"Lindholt, Jes S.","name_org":"Lindholt, J S","orcid":"0000-0001-9536-4488","rank":6,"rolecode":"pau"}],"pmid":["24849021"],"pub":{"doi":"10.1002/bjs.9517","issn":["00071323","13557688"],"issn_org":["00071323"],"issue":"8","journal":"British Journal of Surgery","pages":"966-975","publisher":"Oxford University Press","status":"p","title":"British Journal of Surgery","volume":"101"},"review":"Peer Reviewed","scoID":["2-s2.0-84902281913"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["au-e3eb57a4-11fe-4739-8ad4-6eaf43b5ef86","sdu-4cecb13e-673b-44bc-bce6-29c4de0954ba"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"Statin use and rupture of abdominal aortic aneurysm","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-029179","year":"2014","yearsub":"2014"}
{"abstract":"Central nervous system diseases are becoming more prevalent. Unfortunately, the treatment of CNS diseases is often rendered complicated by the inability of many drugs of therapeutic relevance to cross the blood-brain barrier (BBB). In order to enhance drug delivery to the brain, different approaches have been developed. Gene therapy could be a promising and novel approach to overcome the restricting properties of the BBB to polypeptides and proteins. Gene therapy is based on the delivery of genetic material into brain capillary endothelial cells (BCECs), which, theoretically, will result in expression and secretion of the recombinant protein from the BCECs and into the brain, thus turning BCECs into small recombinant protein factories. In this study, the possibility of using BCECs as small factories for recombinant protein production was investigated. To mimic the in-vivo situation as closely as possible, an in-vitro BBB model was established by isolating primary BCECs, pericytes, and astrocytes from rats. The model was subsequently characterized by immunostaining, RT-qPCR, and measurements of trans-endothelial electrical resistance (TEER). Previous studies have stated that efficient gene transfection is positively correlated with cell division, with dividing cells being more sensitive to gene transfection. Therefore, by using this model, the transfection efficiency of the rat endothelium was investigated in an immature state and mature state of the BBB. During the transfection period, measurements of TEER were performed to study variations in BBB tightness. The transfection efficiency was investigated using RT-qPCR and immunostaining.","author_count":4,"contributors":["Burkhart, Annette","Thomsen, Louiza Bohn","Lichota, Jacek","Moos, Torben"],"cuid":["S01-000.00-054895"],"event":{"end":"2013-09-15","place":"Sümeg, hu","start":"2013-09-11","title":"16th international symposium on signalling at the blood brain barriers","year":"2013"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"transfection of rat brain endothelium in a primary culture model of the blood brain barrier at different states of barrier maturity","src":["aau"],"src-code":["DI-U-AAU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-054895","ids":["aau-1096654c-44d7-4efd-9859-65d1d2ad5af4"],"lang":"Danish","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-FB42DA99DBAA52127C1E585C98F99287"],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Biomedicine Group","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Laboratory of Neurobiology"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Annette Burkhart","key":"larsenpau","last":"Larsen","locid":"7b6bd909-a011-463c-9e09-3623fee043b3","name":"Burkhart, Annette","name_org":"Larsen, Annette Burkhart","orcid":"0000-0003-2086-4693","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Louiza Bohn","key":"thomsenpau","last":"Thomsen","locid":"c4698d51-553a-4391-90b0-5379982b935f","name":"Thomsen, Louiza Bohn","orcid":"0000-0002-3144-7150","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jacek","key":"lichotapau","last":"Lichota","locid":"56885af4-f202-4e65-9e09-8262504b7313","name":"Lichota, Jacek","orcid":"0000-0002-9943-5201","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Torben","key":"moospau","last":"Moos","locid":"e51cbd29-97d2-42d8-bbca-11f026378a2f","name":"Moos, Torben","rank":4,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-1096654c-44d7-4efd-9859-65d1d2ad5af4"],"src":["AAU Aalborg University"],"title":"Transfection of rat brain endothelium in a primary culture model of the blood-brain barrier at different states of barrier maturity","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-054895","year":"2013","yearsub":"2013"}
{"abstract":"The cross-bleaching behaviour of automated Risø TL/OSL (DA-12, DA-15, DA-20) luminescence readers is investigated. By design, up to 24 or 48 aliquots can be stored on a carousel in a single measurement chamber. Due to this construction, irradiation or illumination on one sample may affect the adjacent position resulting in systematic errors. Previously reported for blue LEDs, such cross-talk (cross-bleaching/illumination) has never been quantified explicitly for the infrared (IR) LEDs, although they are intensively used in IRSL measurements of e.g. feldspar and polymineral samples. In IRSL measurements of feldspar or polymineral samples it is important to keep the time constant between the (midpoint of the) irradiation and the subsequent read out to avoid the malign effects of anomalous fading in laboratory constructed dose response curves. This may be achieved by running all measurements for equivalent dose estimation on a single sample before moving to a subsequent sample (e.g. by using the “run 1 at a time” option in the Risø sequence editor). However, if the measurement sequence is not designed carefully, then using this option may result in a significant depletion of the natural signal on subsequent samples. Here we investigate the size of this reduction due to cross-bleaching from the IR diodes and quantify the cross-bleaching for 10 different Risø TL/OSL readers produced between 1994 and 2011. We find that cross-bleaching from the IR diodes is worse than from the blue diodes. Using the “run 1 at the time” option can result in significant dose underestimation (1) if the sequence is not split into different sets, or (2) if samples are not placed on every 2nd position. In addition, a newly designed flange for the optical unit of the TL/OSL reader is presented which appears to reduce cross-bleaching significantly.","author_count":6,"contributors":["Kreutzer, Sebastian","Hülle, Daniela","Thomsen, Kristina Jørkov","Hilgers, Alexandra","Kadereit, Annette","Fuchs, Markus"],"cuid":["S01-000.00-331412"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","Heidelberg University ","Justus Liebig University Giessen","University of Cologne"],"keyword":["Feldspar","IRSL","Instrumentation","Polymineral"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"quantification of cross bleaching during infrared ir light stimulation","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-331412","ids":["dtu-5a3c8f87-7b89-4718-9afb-ac92418c2dad"],"keyword":["Cross-bleaching","Feldspar","IRSL","Instrumentation","Luminescence-reader design","Polymineral"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-8CF4F9537716E6F692D48477D49AAB54"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","country":"de","key":"justus liebig university giessen","loc":["Germany","Europe, EU","OECD"],"name":"Justus Liebig University Giessen","used":1},{"affno":"2","country":"de","key":"university of cologne","loc":["Germany","Europe, EU","OECD"],"name":"University of Cologne","used":1},{"affno":"3","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Center for Nuclear Technologies","Technical University of Denmark, Center for Nuclear Technologies, Radiation Physics"],"nora_code":"DI-U-DTU","used":1},{"affno":"4","country":"de","key":"heidelberg university","loc":["Germany","Europe, EU","OECD"],"name":"Heidelberg University ","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Sebastian","key":"kreutzerpau","last":"Kreutzer","name":"Kreutzer, Sebastian","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Daniela","key":"hüllepau","last":"Hülle","name":"Hülle, Daniela","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Kristina Jørkov","key":"thomsenpau","last":"Thomsen","locid":"02bc836d-e72c-4e54-8f3f-c024da5b6838","name":"Thomsen, Kristina Jørkov","orcid":"0000-0002-4883-1220","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Alexandra","key":"hilgerspau","last":"Hilgers","name":"Hilgers, Alexandra","rank":4,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Annette","key":"kadereitpau","last":"Kadereit","name":"Kadereit, Annette","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Markus","key":"fuchspau","last":"Fuchs","name":"Fuchs, Markus","rank":6,"rolecode":"pau"}],"pub":{"issn":["07351348"],"issue":"1","journal":"Ancient TL","pages":"1-10","status":"p","title":"Ancient TL","title_org":"Ancient T L","volume":"31"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-5a3c8f87-7b89-4718-9afb-ac92418c2dad"],"src":["DTU Technical University of Denmark"],"title":"Quantification of cross-bleaching during infrared (IR) light stimulation","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-331412","year":"2013","yearsub":"2013"}
{"abstract":"Algal biomass has been identifi ed as a promising substrate for energy production. Several lab scale experiments have been performed on diff erent species of both macroalgae and microalgae. The high content of carbohydrates makes both macroalgae and microalgae appealing feedstock for bioethanol and biogas production. Unfortunately, so far no industrial scale plant has been set up. This is a demonstration that there are still constraints to be overcome. This study will tackle the fi rst obstacle for the development of this technology: the feedstock supply to a potential biorefi nery. This study evaluates diffi culties and constraints in the macroalgae and microalgae growth process though the utilization of the Life Cycle Assessment and an economic evaluation. In particular a case study of Saccharina latissima cultivation site in Limfjorden (Denmark) and a microalgae cultivation site in Finland will be compared and presented. Minimum feedstock requirement for a biorefi nery, minimum selling price and infl uence of transport of the raw material, provide useful information for system design.","author_count":7,"contributors":["Seghetta, Michele","Manninen, Kaisa","Spilling, Kristian","Hasler, Berit","Bruhn, Annette","Carstensen, Jacob","Thomsen, Marianne"],"cuid":["S01-000.00-250725"],"event":{"end":"2013-10-04","place":"Århus, dk","start":"2013-10-02","title":"SCIENCE FOR THE ENVIRONMENT","year":"2013"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"country":["Finland"],"glorg":["All Global Affiliations","Finnish Environment Institute"],"keyword":["Algae","Cultivation","Eco efficiency","Efficiency","LCA","Methane","Sustainability","resource flows"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"nr","rtype":["clu"],"sorti":"circular resource flows from algae production","src":["au"],"src-code":["DI-U-AU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://dce-conference.au.dk/fileadmin/dce-conference.au.dk/Abstract_Book_Final.pdf","version":"Other Version"},"id":"S01-000.00-250725","ids":["au-d49a6d85-6e5e-4b5b-ab76-54229ad0855b"],"keyword":["LCA","algae","bioresource","cultivation","eco-efficiency","efficiency","methane","resource flows","sustainability"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-CACDEA1B52EBDCC55A57048ED4F73B20"],"oa_link":[{"access":"oa","type":"rem","url":"http://dce-conference.au.dk/uploads/media/7.1_Seghetta_04.pdf","version":"Other Version"},{"access":"oa","type":"rem","url":"http://dce-conference.au.dk/fileadmin/dce-conference.au.dk/Abstract_Book_Final.pdf","version":"Other Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Environmental Science, Department of Environmental Science - Emission modeling & environmental geography"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"fi","key":"finnish environment institute","loc":["Finland","Europe, EU","Nordic","OECD"],"name":"Finnish Environment Institute","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Michele","key":"seghettapau","last":"Seghetta","locid":"28d76a35-221b-425c-a1fa-4ecfe1d37930","name":"Seghetta, Michele","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Kaisa","key":"manninenpau","last":"Manninen","name":"Manninen, Kaisa","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Kristian","key":"spillingpau","last":"Spilling","name":"Spilling, Kristian","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Berit","key":"haslerpau","last":"Hasler","locid":"63d231d4-5285-481a-abec-99c2aff93b73","name":"Hasler, Berit","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Annette","key":"bruhnpau","last":"Bruhn","locid":"15559017-3036-4e04-968e-338a24d800ce","name":"Bruhn, Annette","orcid":"0000-0002-7940-1338","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jacob","key":"carstensenpau","last":"Carstensen","locid":"611ee405-9001-48c4-9868-6035748d7fa3","name":"Carstensen, Jacob","orcid":"0000-0003-0016-6118","rank":6,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Marianne","key":"thomsenpau","last":"Thomsen","locid":"92402c50-d634-4163-a3fa-198f30c806c5","name":"Thomsen, Marianne","rank":7,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-d49a6d85-6e5e-4b5b-ab76-54229ad0855b"],"src":["AU Aarhus University"],"title":"Circular resource flows from algae production","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-250725","year":"2013","yearsub":"2013"}
{"abstract":"β-Blockers are widely used to prevent cardiac arrhythmias and to treat hypertension by inhibiting β-adrenergic receptors (βARs) and thus decreasing contractility and heart rate. βARs initiate phosphorylation-dependent signaling cascades, but only a small number of the target proteins are known. We used quantitative in vivo phosphoproteomics to identify 670 site-specific phosphorylation changes in murine hearts in response to acute treatment with specific βAR agonists. The residues adjacent to the regulated phosphorylation sites exhibited a sequence-specific preference (R-X-X-pS/T), and integrative analysis of sequence motifs and interaction networks suggested that the kinases AMPK (adenosine 5'-monophosphate-activated protein kinase), Akt, and mTOR (mammalian target of rapamycin) mediate βAR signaling, in addition to the well-established pathways mediated by PKA (cyclic adenosine monophosphate-dependent protein kinase) and CaMKII (calcium/calmodulin-dependent protein kinase type II). We found specific regulation of phosphorylation sites on six ion channels and transporters that mediate increased ion fluxes at higher heart rates, and we showed that phosphorylation of one of these, Ser(92) of the potassium channel KV7.1, increased current amplitude. Our data set represents a quantitative analysis of phosphorylated proteins regulated in vivo upon stimulation of seven-transmembrane receptors, and our findings reveal previously unknown phosphorylation sites that regulate myocardial contractility, suggesting new potential targets for the treatment of heart disease and hypertension.","author_count":10,"contributors":["Lundby, Alicia","Andersen, Martin Nybo","Steffensen, Annette Buur","Horn, Heiko","Kelstrup, Christian D","Francavilla, Chiara","Jensen, Lars Juhl","Schmitt, Nicole","Thomsen, Morten B.","Olsen, Jesper V."],"cuid":["S01-000.00-492575"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"in vivo phosphoproteomics analysis reveals the cardiac targets of β adrenergic receptor signaling","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1126/scisignal.2003506","version":"Other Version"},"id":"S01-000.00-492575","identifier":[{"id":"84878953405","type":"scopus"},{"id":"23737553","type":"pmid"}],"ids":["ku-a5fa0aab-b9cf-48a6-961d-be38293f57c1"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-F51C08DC76B3729ED5E6DFB0EE212079"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1126/scisignal.2003506","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Novo Nordisk Foundation Center for Protein Research, Proteomics Program"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Alicia","key":"lundbypau","last":"Lundby","locid":"6273cf1f-1ae6-4abd-ab98-68d9299e0632","name":"Lundby, Alicia","orcid":"0000-0002-1612-6041","rank":1,"rolecode":"pau"},{"affno":"1","first":"Martin N","key":"andersenpau","last":"Andersen","locid":"f64687ce-410d-477f-8dad-6e80d6a1be48","name":"Andersen, Martin Nybo","name_org":"Andersen, Martin N","rank":2,"rolecode":"pau"},{"affno":"1","first":"Annette B","key":"steffensenpau","last":"Steffensen","locid":"a844e039-1c02-49c5-96af-10090530fff7","name":"Steffensen, Annette Buur","name_org":"Steffensen, Annette B","rank":3,"rolecode":"pau"},{"affno":"1","first":"Heiko","key":"hornpau","last":"Horn","locid":"2bbd0285-ef70-4df2-981a-5c3e0d0d2f92","name":"Horn, Heiko","rank":4,"rolecode":"pau"},{"affno":"1","first":"Christian D","key":"kelstruppau","last":"Kelstrup","locid":"e7c7a8d5-601f-4618-b879-401f673271a8","name":"Kelstrup, Christian D","orcid":"0000-0003-4647-1425","rank":5,"rolecode":"pau"},{"affno":"1","first":"Chiara","key":"francavillapau","last":"Francavilla","locid":"31feee02-46dc-4cc7-a6ef-f4d99d154891","name":"Francavilla, Chiara","rank":6,"rolecode":"pau"},{"affno":"1","first":"Lars J","key":"jensenpau","last":"Jensen","locid":"cae227d4-1222-4c3a-a7b0-34ad91d42e5a","name":"Jensen, Lars Juhl","name_org":"Jensen, Lars J","orcid":"0000-0001-7885-715X","rank":7,"rolecode":"pau"},{"affno":"1","first":"Nicole","key":"schmittpau","last":"Schmitt","locid":"942c887c-32b0-4e89-812f-a11edf2505a5","name":"Schmitt, Nicole","orcid":"0000-0001-9482-9749","rank":8,"rolecode":"pau"},{"affno":"1","first":"Morten B","key":"thomsenpau","last":"Thomsen","locid":"de1e0c60-60e1-46cb-b71c-32232c6ba6ed","name":"Thomsen, Morten B.","name_org":"Thomsen, Morten B","orcid":"0000-0002-2469-6458","rank":9,"rolecode":"pau"},{"affno":"1","first":"Jesper V","key":"olsenpau","last":"Olsen","locid":"16f5cd56-244f-4fe8-bebd-13ee7bd17822","name":"Olsen, Jesper V.","name_org":"Olsen, Jesper V","orcid":"0000-0002-4747-4938","rank":10,"rolecode":"pau"}],"pmid":["23737553"],"pub":{"doi":"10.1126/scisignal.2003506","issn":["19379145","19450877"],"issn_org":["19450877"],"issue":"278","journal":"Science Signaling","status":"p","title":"Science Signaling","volume":"6"},"review":"Peer Reviewed","scoID":["2-s2.0-84878953405"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-a5fa0aab-b9cf-48a6-961d-be38293f57c1"],"src":["KU University of Copenhagen"],"title":"In Vivo Phosphoproteomics Analysis Reveals the Cardiac Targets of β-Adrenergic Receptor Signaling","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-492575","year":"2013","yearsub":"2013"}
{"abstract":"BACKGROUND: Some studies indicate that a large part of the beneficial effect of physical activity on mortality is confined to a threshold effect of participation. METHODS: Self-reported physical activity was investigated in relation to all-cause mortality in the Danish Diet, Cancer and Health cohort, including 29,129 women and 26,576 men aged 50-64 years at baseline 1993-1997. Using Cox proportional hazards models we investigated the associations between mortality rate and leisure time physical activity by exploring 1) participation (yes/no) in each type of activity; 2) a simple dose-response relationship with hours spent on each activity, supplemented with indicators of participation in each activity; and 3) inflexion or nonmonotonic dose-response relationships using linear splines. RESULTS: A total of 2696 women and 4044 men died through March 2010. We found lower mortality with participation in sports (for women, mortality rate ratio = 0.75, 95% confidence interval = 0.69-0.81; for men, 0.78, 0.73-0.84), cycling (for women, 0.77, 0.71-0.84; for men, 0.90, 0.84-0.96), or gardening (for women, 0.84, 0.78-0.91; for men, 0.73, 0.68-0.79) and in men participating in do-it-yourself activity (0.77, 0.71-0.84). A weak adverse dose response was seen for walking and gardening, but the association was small (1-2% increase in mortality per additional hour). We found no signs of inflexion or nonmonotonic effects of additional hours spent on each activity. CONCLUSION: Mortality was lower with participation in specific leisure time physical activities, but not with more time spent on those activities. This could suggest that avoiding a sedative lifestyle is more important than a high volume of activity. Nonparticipation in these types of physical activity may be considered as risk factors.","author_count":6,"contributors":["Føns Johnsen, Nina","Ekblond, Annette","Thomsen, Birthe Lykke","Overvad, Kim","Tjønneland, Anne"],"cuid":["S03-093.45-000208"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":3,"keyword":["Denmark","Female","Follow Up Studies","Humans","Leisure Activities","Male","Middle Aged","Mortality","Motor Activity","Proportional Hazards Models","Risk Factors","Sedentary Lifestyle","Self Report","Time Factors"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-NP","DI-U"],"level3":{"NP":["DI-NP-ALL","DI-NP-CAN"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-NP-CAN","DI-U-AAU","DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"leisure time physical activity and mortality","src":["aau","au","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1097/EDE.0b013e31829e3dda","version":"Other Version"},"id":"S03-093.45-000208","identifier":[{"id":"23867814","type":"pmid"},{"id":"84881544519","type":"scopus"},{"id":"WOS:000323107600013","type":"wos"}],"ids":["aau-0413b268-d062-46e9-a711-d9f9d5e6a6b9","au-e2706757-1a17-4760-909c-b6fb6dc9d7d0","sdu-94efab80-f0bd-4b18-a978-47a87f783452"],"keyword":["Denmark","Female","Follow-Up Studies","Humans","Leisure Activities","Male","Middle Aged","Mortality","Motor Activity","Proportional Hazards Models","Risk Factors","Sedentary Lifestyle","Self Report","Time Factors"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-BE2F6068C91DF0E247A3737B4D6F3A11"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1097/EDE.0b013e31829e3dda","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, National Institute of Public Health, Research Programme on Health and Morbidity in Denmark"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"dcrc danish cancer society research center","l2":"DI-NP","l2n":"Non-Profit Organisations","l3":"DI-NP-CAN","l3nn":"DCRC Danish Cancer Society Research Center","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DCRC Danish Cancer Society Research Center","namevar":["Danish Cancer Society"],"nora_code":"DI-NP-CAN","used":1},{"affno":"3","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Hjertemedicin (Kardiologi) [Klinik Hjerte-Lunge]","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Hjerte-Lunge"],"nora_code":"DI-U-AAU","used":1},{"affno":"4","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Public Health, Department of Public Health - Department of Epidemiology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Nina Føns","key":"johnsenpau","last":"Johnsen","locid":"0b7449a8-77b3-4ecd-85ac-01bdd6ff095a","name":"Johnsen, Nina Føns","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Nina","key":"fønsjohnsenpau","last":"Føns Johnsen","name":"Føns Johnsen, Nina","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Annette","key":"ekblondpau","last":"Ekblond","name":"Ekblond, Annette","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Birthe Lykke","key":"thomsenpau","last":"Thomsen","name":"Thomsen, Birthe Lykke","rank":3,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Kim","key":"overvadpau","last":"Overvad","locid":"7ca4bfca-d3a3-484e-8ee5-d7cb6ad7314b","name":"Overvad, Kim","orcid":"0000-0001-6429-7921","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Anne","key":"tjønnelandpau","last":"Tjønneland","name":"Tjønneland, Anne","rank":5,"rolecode":"pau"}],"pmid":["23867814"],"pub":{"doi":"10.1097/ede.0b013e31829e3dda","issn":["10443983","15315487"],"issn_org":["10443983"],"issue":"5","journal":"Epidemiology","pages":"717-725","publisher":"Lippincott Williams and Wilkins Ltd.","status":"p","title":"Epidemiology","volume":"24"},"review":"Peer Reviewed","scoID":["2-s2.0-84881544519"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Non-Profit Organisations","All Universities","DI-ALL","DI-NP","DI-NP-ALL","DI-U","DI-U-ALL","Non-Profit Organisations","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-0413b268-d062-46e9-a711-d9f9d5e6a6b9","au-e2706757-1a17-4760-909c-b6fb6dc9d7d0","sdu-94efab80-f0bd-4b18-a978-47a87f783452"],"src":["AAU Aalborg University","AU Aarhus University","SDU University of Southern Denmark"],"title":"Leisure Time Physical Activity and Mortality","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-093.45-000208","year":"2013","yearsub":"2013"}
{"abstract":"In vitro blood-brain barrier (BBB) models based on primary brain capillary endothelial cells (BCECs) in monoculture or in co-culture with primary astrocytes and pericytes are often applied for studying physiology of the BBB. Primary BCECs retain many morphological and biochemical properties similar to in vivo such as efflux transporters, tight junction proteins, and high transendothelial electric resistance (TEER). Primary BCECs are isolated from a variety of mammals such as rats, mice, cattle and pigs. Often bovine and porcine BCECs are cultured in monoculture or in co-culture with rat astrocytes obtained from neonatal rats which have been shown to strengthen the barrier properties of the BCECs. In this study, brain endothelial cells (PBECs), astrocytes and pericytes are isolated from pig brains donated by the local abattoir. The brains are from 6 month old domestic pigs. The availability and high yield of cells per isolation makes the pigs a favourable source for BCECs, astrocytes and pericytes. The aim of this study was to determine which type of culture method would result in the most optimal porcine in vitro BBB model. The effect of co-culture of PBECs with rat astrocytes and/or pericytes was compared with co-culture of PBECs with porcine astrocytes and/or pericytes. These results were also compared to results obtained from monoculture of PBECs. The effect of both contact and non-contact co-culture with porcine or rat astrocytes and pericytes was investigated. The different culture methods were evaluated on the basis of TEER measurements, PCR and immunocytochemical staining of BCEC specific proteins.","author_count":3,"contributors":["Thomsen, Louiza Bohn","Burkhart, Annette","Moos, Torben"],"cuid":["S01-000.00-062709"],"event":{"end":"2013-09-15","place":"Sümeg, hu","start":"2013-09-11","title":"16th international symposium on signaling at the blood brain barriers","year":"2013"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"characterisation of an in vitro blood brain barrier model based on primary porcine capillary endothelial cells in monoculture or co culture with primary rat or porcine astrocytes and pericytes","src":["aau"],"src-code":["DI-U-AAU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-062709","ids":["aau-2bb62887-0d77-4f1e-b569-032c992c4775"],"lang":"Danish","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-E4D622EEB0D4778E02D3B78109F0C014"],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Biomedicine Group","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Laboratory of Neurobiology"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Louiza Bohn","key":"thomsenpau","last":"Thomsen","locid":"c4698d51-553a-4391-90b0-5379982b935f","name":"Thomsen, Louiza Bohn","orcid":"0000-0002-3144-7150","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Annette Burkhart","key":"larsenpau","last":"Larsen","locid":"7b6bd909-a011-463c-9e09-3623fee043b3","name":"Burkhart, Annette","name_org":"Larsen, Annette Burkhart","orcid":"0000-0003-2086-4693","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Torben","key":"moospau","last":"Moos","locid":"e51cbd29-97d2-42d8-bbca-11f026378a2f","name":"Moos, Torben","rank":3,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-2bb62887-0d77-4f1e-b569-032c992c4775"],"src":["AAU Aalborg University"],"title":"Characterisation of an in vitro blood-brain barrier model based on primary porcine capillary endothelial cells in monoculture or co-culture with primary rat or porcine astrocytes and pericytes.","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-062709","year":"2013","yearsub":"2013"}
{"author_count":3,"contributors":["Eilenberg, Jørgen","Thomsen, Lene","Jensen, Annette Bruun"],"cuid":["S01-000.00-475768"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"a third way for entomophthoralean fungi to survive the winter slow disease transmission between individuals of the hibernating host","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.3390/insects4030392","version":"Other Version"},"id":"S01-000.00-475768","identifier":[{"id":"PMC4553471","type":"pmcid"},{"id":"84881219815","type":"scopus"},{"id":"26462426","type":"pmid"}],"ids":["ku-89a72c86-e504-4d22-be1d-cb9b91230162"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-2CF22C883BB0C25C814BB77BCCDF343F"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.3390/insects4030392","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Plant and Environmental Sciences, Section for Organismal Biology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Jørgen","key":"eilenbergpau","last":"Eilenberg","locid":"74c6d5f6-8992-486f-88af-4039c68e6d43","name":"Eilenberg, Jørgen","orcid":"0000-0002-9273-5252","rank":1,"rolecode":"pau"},{"affno":"1","first":"Lene","key":"thomsenpau","last":"Thomsen","name":"Thomsen, Lene","rank":2,"rolecode":"pau"},{"affno":"1","first":"Annette Bruun","key":"jensenpau","last":"Jensen","locid":"90debd3e-8e04-4f72-a4eb-05d4905b158a","name":"Jensen, Annette Bruun","orcid":"0000-0002-2044-2274","rank":3,"rolecode":"pau"}],"pmid":["26462426"],"pub":{"doi":"10.3390/insects4030392","issn":["20754450"],"issue":"3","journal":"Insects","pages":"392-403","status":"p","title":"Insects","volume":"4"},"review":"Peer Reviewed","scoID":["2-s2.0-84881219815"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-89a72c86-e504-4d22-be1d-cb9b91230162"],"src":["KU University of Copenhagen"],"title":"A third way for entomophthoralean fungi to survive the winter : slow disease transmission between individuals of the hibernating host","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-475768","year":"2013","yearsub":"2013"}
{"abstract":"A new Danish macroalgae project (Acronym MAB3) financed by the Danish Strategic Research Council presents an integrated macroalgae biorefinery concept. It was started from march 2012 and will continue for the next 4 years (2012-2016). Initial studies on the first harvested materials of wild Laminaria digtata (harvested during the summer 2012 from Limfjorden in Denmark), including cultivation, pretreatment and bioethanol set-up and trials will be presented in this presentation. The macroalgae substrates were screw-pressed to dewater and the algae biomass were fractionated before storage by ensiling (with lactic acid bacteria) or simple drying. Pretreatment was carried out using wet-milling and enzymatic hydrolysis in accordance with 1G bioethanol technology from corn. Different commercial enzyme mixtures for fully or partly hydrolysis of algae sugar polymers into monomers were tested and conversion of the differently pretreated macroalgae biomass into ethanol by fermentation were compared. The protein contents and nutrient salts in residues from ethanol fermentation trials were characterized for potential fish feed. A first-step scenario for sustainability and feasibility assessment will be presented for this innovative process of biorefining of value-added algae proteins derived directly through fermentation processes of algae sugars to bioenergy carriers.","author_count":15,"contributors":["Hou, Xiaoru","Bjerre, Anne-Belinda","Hansen, Jonas Høeg","Bruhn, Annette","Saake, Bodo","Meyer, Anne","Manns, Dirk","Rasmussen, Michael Bo","Nielsen, Mette Møller","Petersen, Jens Kjerulf","Tørring, Ditte","Daugbjerg, Peter","Seghetta, Michele","Bastianoni, Simone","Thomsen, Marianne"],"cuid":["S01-000.00-130041"],"event":{"end":"2013-09-25","place":"Hangzhou, cn","start":"2013-09-23","title":"BIT's 2nd Annual International Congress of Algae-2013","year":"2013"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Germany","Italy"],"glorg":["All Global Affiliations","University of Hamburg","University of Siena"],"keyword":["Biorefinery","Green production","Macroalgae","Sustainability assessment"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU","DI-U-DTU"]},"level3all":["DI-U-AU","DI-U-DTU"]},"review":"nr","rtype":["clu"],"sorti":"the macroalgae biorefinery for production of bioethanol and fish feed from the two brown algae laminaria digitata and saccharina latissima","src":["au"],"src-code":["DI-U-AU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://www.bitcongress.com/aica2013/program.asp#","version":"Other Version"},"id":"S01-000.00-130041","ids":["au-015dff20-06b4-4040-a0e4-7777a7e0fc88"],"keyword":["Macroalgae","Sustainability assessment","biorefinery","green production"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-DE529204574A96C132D04C1D0DAC6EF0"],"oa_link":[{"access":"oa","type":"rem","url":"http://www.bitcongress.com/aica2013/program.asp#","version":"Other Version"}],"org":[{"affno":"1","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Ecoscience, Department of Ecoscience - Marine Ecology"],"nora_code":"DI-U-AU","used":1},{"affno":"3","country":"de","key":"university of hamburg","loc":["Germany","Europe, EU","OEC