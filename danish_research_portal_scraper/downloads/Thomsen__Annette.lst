rcid":"0000-0001-6693-3039","rank":17,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Janna","key":"nissenjannapau","last":"Nissen","name":"Nissen, Janna","rank":18,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Marianne","key":"boelskiftemariannepau","last":"Boelskifte","locid":"392cb296-505c-4252-a326-0d629b81f3e4","name":"Boelskifte, Marianne","rank":19,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Sofie Theresa","key":"thomsensofietheresapau","last":"Thomsen","locid":"4a510544-528d-4125-8789-13d7591b6970","name":"Thomsen, Sofie Theresa","orcid":"0000-0002-1885-5598","rank":20,"rolecode":"pau"}],"pub":{"pages":"26","place":"Kgs. Lyngby","publisher":"Technical University of Denmark","status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-d00a3c7c-286d-466e-b652-b972b9efb5df"],"src":["DTU Technical University of Denmark"],"title":"Metrix - Risk-benefit assessment of foods","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-366702","year":"2020","yearsub":"2020"}
{"abstract":"Purpose: To describe the development process of an existential support program and to explore participants' evaluation of supportive/unsupportive processes of change. Method: A five-day existential support program called “Energy for life” was designed including three main elements: 1. existential group counseling, 2. art therapy and 3. interaction with nature and aesthetic surroundings. The program was implemented at two different study sites. Focus group interviews were conducted to evaluate the program. Results: 40 subjects were recruited (20 for each one of the two study sites) and 36 completed the study (31 women, five men) in the age range from 31 to 76 years and living with cancer across all stages and types. The program resulted in supportive processes of “existential sharing”. The existential group counseling included a sharing process which led to an increased awareness and acceptance of one's existential situation and a preparation for the next steps in one's life. Art therapy offered a respite from the illness or the opportunity to express and share difficult thoughts and feelings connected to the illness experience. The interaction with nature/surroundings induced feelings of calmness and peace, increasing self-worth and spiritual belonging. Unsupportive processes of change related to the organization of the existential counseling groups, feelings of discomfort with creative engagement and feelings of distress provoked by a hospital environment. Conclusion: Through “Energy for life” existential concerns and distress were shared, contained and transformed. Knowledge has been gained about how an existential support program can be designed that explicitly focuses on alleviating patients' existential distress.","author_count":10,"contributors":["Assing Hvidt, Elisabeth","Hvidt, Niels Christian","Graven, Vibeke","la Cour, Karen","Rottmann, Nina","Thomsen, Karsten Flemming","Linqvist, Ole","Rasmussen, Annette","Skaarup, Helle","Roessler, Kirsten Kaya"],"cuid":["S01-000.00-622739"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Cancer","Existential well being","Program","Qualitative evaluation","Rehabilitation","Residential","Spirituality"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["M22 Art and Creativity. LV-Malu Iela 22, 3301, Kuldiga, Latvia"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"an existential support program for people with cancer development and qualitative evaluation","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/170020078/YEJON_D_20_00053R2_presubmission.pdf","version":"Authors Final Version"},"id":"S01-000.00-622739","identifier":[{"id":"32446197","type":"pmid"},{"id":"85084759086","type":"scopus"}],"ids":["sdu-acf424de-2290-4899-965e-0f3c5531e8d5"],"keyword":["Cancer","Existential distress","Existential support","Existential well-being","Program","Qualitative evaluation","Rehabilitation","Residential","Spirituality"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-1FC91282D1293B23F1C65D15AD3B209A"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/170020078/YEJON_D_20_00053R2_presubmission.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Humanities, Department for the Study of Culture","SDU, The Faculty of Health Sciences, Department of Public Health, Research Unit of General Pratice"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["M22 Art and Creativity. LV-Malu Iela 22, 3301, Kuldiga, Latvia"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Elisabeth","key":"assinghvidtpau","last":"Assing Hvidt","locid":"8c678f9e-b6bc-401c-b9ca-561b04c3ec2b","name":"Assing Hvidt, Elisabeth","orcid":"0000-0003-3762-8478","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Niels Christian","key":"hvidtpau","last":"Hvidt","locid":"13b593c4-9280-4cef-aafc-8b3cd6b7c659","name":"Hvidt, Niels Christian","orcid":"0000-0002-6311-9784","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Vibeke","key":"gravenpau","last":"Graven","locid":"657c694a-bf81-4bed-ba76-01a90d936a65","name":"Graven, Vibeke","orcid":"0000-0001-6111-6902","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Karen","key":"lacourpau","last":"la Cour","locid":"b938d806-88f5-44f4-a5a5-84031b5643db","name":"la Cour, Karen","orcid":"0000-0001-7126-0318","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Nina","key":"rottmannpau","last":"Rottmann","locid":"16e7c8cc-cee3-43aa-8651-e2a1414f2426","name":"Rottmann, Nina","orcid":"0000-0002-7262-6788","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Karsten Flemming","key":"thomsenpau","last":"Thomsen","locid":"d3c3f2ad-4cb9-4273-831f-483568ec6093","name":"Thomsen, Karsten Flemming","orcid":"0000-0002-9151-209X","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ole","key":"linqvistpau","last":"Linqvist","name":"Linqvist, Ole","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Annette","key":"rasmussenpau","last":"Rasmussen","locid":"48538b36-1eae-43a8-9543-c5096f99bfe0","name":"Rasmussen, Annette","orcid":"0000-0001-5740-2340","rank":8,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Helle","key":"skaaruppau","last":"Skaarup","name":"Skaarup, Helle","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kirsten Kaya","key":"roesslerpau","last":"Roessler","locid":"6606b4c4-c646-40d9-8d60-f60542beac95","name":"Roessler, Kirsten Kaya","orcid":"0000-0001-6605-7999","rank":10,"rolecode":"pau"}],"pmid":["32446197"],"pub":{"doi":"10.1016/j.ejon.2020.101768","issn":["14623889","15322122"],"issn_org":["14623889"],"journal":"European Journal of Oncology Nursing","paperid":"101768","publisher":"Churchill Livingstone","status":"p","title":"European Journal of Oncology Nursing","volume":"46"},"review":"Peer Reviewed","scoID":["2-s2.0-85084759086"],"search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-acf424de-2290-4899-965e-0f3c5531e8d5"],"src":["SDU University of Southern Denmark"],"title":"An existential support program for people with cancer : Development and qualitative evaluation","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-622739","year":"2020","yearsub":"2020"}
{"abstract":"An increasing number of young adults in Denmark experience difficulties in completing their education and holding down a job. Many of these young adults have psychosocial problems and common mental disorders. To retain public income support they must attend education and work-directed activities, known as 'activation programmes'. Based on ethnographic fieldwork, this study presents an analysis of how one such programme unfolds in practice and how the participants engaged with the activities and negotiated the underlying rationales. We argue that the activities involved in the programme constitute 'biographical techniques' that entail a configuration of the participants as being responsible for their own biographies and having the capability to solve their problems themselves. The participants challenged this configuration of subjectivity by recounting complex or immediate problems that could not be solved through biographical techniques and by refusing to deal with their life stories as a way of configuring their futures. Biographical techniques limited the possibilities for grappling with the complexity of the participants' problems. We conclude that the participants are therefore subjected to biographical coercion because forms of subjectivity other than biographical subjectivity are disregarded.","author_count":4,"contributors":["Andersen, Julie Høgsgaard","Tjørnhøj-Thomsen, Tine","Reventlow, Susanne","Davidsen, Annette Sofie"],"cuid":["S02-100.00-042159"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Common mental disorders","Denmark","Psychosocial problems","Young adults"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"initiating change negotiations of subjectivity in a danish activation programme for young adults with psychosocial problems and common mental disorders","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85070975219","version":"Other Version"},"id":"S02-100.00-042159","identifier":[{"id":"85070975219","type":"scopus"},{"id":"30955121","type":"pmid"}],"ids":["ku-4ac5c54c-6d55-494f-ac05-050578dc3a95","sdu-47fff8e9-8b0f-462f-94ad-9be29c353985"],"keyword":["Biographical subjectivity","Common mental disorders","Denmark","Psychosocial problems","Young adults"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-58A0BB6FB4F8368602858AB1D8AC7D7D"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, External Centres, Forskningsenheden for Almen Praksis"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, National Institute of Public Health, Department of Health and Social Context"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","first":"Julie Høgsgaard","key":"andersenpau","last":"Andersen","locid":"5027e5a4-ff0d-4aba-bec9-06d27c79e0e9","name":"Andersen, Julie Høgsgaard","orcid":"0000-0001-5685-5399","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Tine","key":"tjørnhøjthomsenpau","last":"Tjørnhøj-Thom