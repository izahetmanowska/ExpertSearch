n, Katrine H","rank":35,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lone K.","key":"petersenlonekjeldpau","last":"Petersen","locid":"000a791a-6685-4ef0-b286-f342dd3ad555","name":"Petersen, Lone Kjeld","name_org":"Petersen, Lone K.","orcid":"0000-0002-1424-6170","rank":36,"rolecode":"pau"},{"affno":"","first":"Lone K","key":"petersenlonekpau","last":"Petersen","name":"Petersen, Lone K","rank":36,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jan S.","key":"jørgensenjanstenerpau","last":"Jørgensen","locid":"4e1adaff-d975-48d8-95b5-73bc6d115a5e","name":"Jørgensen, Jan Stener","name_org":"Jørgensen, Jan S.","orcid":"0000-0001-5222-2535","rank":37,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jan S.","key":"jørgensenjanspau","last":"Jørgensen","name":"Jørgensen, Jan S.","rank":37,"rolecode":"pau"},{"affno":"1","first":"Lone","key":"krebslonepau","last":"Krebs","locid":"bc118d29-5caa-4a68-b229-16ca0cf1b7cb","name":"Krebs, Lone","orcid":"0000-0001-5433-4776","rank":38,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Mette","key":"bliddalmettepau","last":"Bliddal","locid":"55d0344b-452b-4921-b715-eafb3f19f50e","name":"Bliddal, Mette","orcid":"0000-0002-7637-3730","rank":39,"rolecode":"pau"}],"pmid":["36695168"],"pub":{"doi":"10.1111/aogs.14512","issn":["00016349"],"issue":"3","journal":"Acta Obstetricia et Gynecologica Scandinavica","pages":"282-293","publisher":"Wiley-Blackwell","status":"p","title":"Acta Obstetricia et Gynecologica Scandinavica","volume":"102"},"review":"Peer Reviewed","scoID":["2-s2.0-85147209957"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","North Denmark Region","Other Hospitals","Other Research","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark","copenhagen university hospital - holbæk"],"PST":["Published"]},"sid":["aau-6c9c083b-5b4b-4ec2-bb9b-5e4161e13fe3","au-5391f463-165d-49c5-b1a7-0bab916304f5","ku-bf132abb-2742-40dc-a776-1796d60b5c84","sdu-683e56f2-a406-45e2-8b60-beac9ce32919"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Risk factors for and pregnancy outcomes after SARS-CoV-2 in pregnancy according to disease severity : A nationwide cohort study with validation of the SARS-CoV-2 diagnosis","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-088.01-005271","year":"2023","yearsub":"2023"}
{"abstract":"The treatment of implant-associated bacterial infections and biofilms is an urgent medical need and a grand challenge because biofilms protect bacteria from the immune system and harbor antibiotic-tolerant persister cells. This need is addressed herein through an engineering of antibody-drug conjugates (ADCs) that contain an anti-neoplastic drug mitomycin C, which is also a potent antimicrobial against biofilms. The ADCs designed herein release the conjugated drug without cell entry, via a novel mechanism of drug release which likely involves an interaction of ADC with the thiols on the bacterial cell surface. ADCs targeted toward bacteria are superior by the afforded antimicrobial effects compared to the non-specific counterpart, in suspension and within biofilms, in vitro, and in an implant-associated murine osteomyelitis model in vivo. The results are important in developing ADC for a new area of application with a significant translational potential, and in addressing an urgent medical need of designing a treatment of bacterial biofilms.","author_count":15,"contributors":["Tvilum, Anne Selch","Johansen, Mikkel Illemann","Glud, Lærke Nøhr","Ivarsen, Diana Malskær","Khamas, Amanda Batoul","Carmali, Sheiliza","Mhatre, Snehit","Søgaard, Ane Bretschneider","Faddy, Emma","de Vor, Lisanne","H. M. Rooijakkers, Suzan","Østergaard, Lars Jørgen","Jørgensen, Nis Pedersen","Meyer, Rikke Louise","Zelikin, Alexander N."],"cuid":["S01-000.00-675985"],"filters":{"added":"2023-08","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"corresponding_author":["Jørgensen, Nis Pedersen","Meyer, Rikke Louise","Zelikin, Alexander N."],"country":["Netherlands"],"glorg":["All Global Affiliations","UMC Utrecht Cancer Center"],"keyword":["Animals","Anti Infective Agents","Antibody drug conjugates","Antimicrobials","Bacteria","Biofilms","Drug Liberation","Drug targeting","Immunoconjugates","Mice"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"antibody drug conjugates to treat bacterial biofilms via targeting and extracellular drug release","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1002/advs.202301340","version":"Published Version"},"id":"S01-000.00-675985","identifier":[{"id":"85161231398","type":"scopus"},{"id":"37290045","type":"pmid"},{"id":"PMC10427384","type":"pmcid"}],"ids":["au-f4effb5f-6ebb-4824-bab0-b9a925f62858"],"keyword":["Animals","Anti-Infective Agents","Bacteria","Drug Liberation","Immunoconjugates","Mice","antibody-drug-conjugates","antimicrobials","biofilms","drug targeting"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-0EB3BCB42DD0A7CBEF6246C51679038F"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1002/advs.202301340","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Chemistry"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"nl","key":"umc utrecht cancer center","loc":["Netherlands","Europe, EU","OECD"],"name":"UMC Utrecht Cancer Center","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Anne Selch","key":"tvilumpau","last":"Tvilum","locid":"907e120b-b202-400b-9301-ea5292d08c49","name":"Tvilum, Anne Selch","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mikkel Illemann","key":"johansenpau","last":"Johansen","locid":"521aaf8b-4d7a-4672-82c4-2c79a297b02a","name":"Johansen, Mikkel Illemann","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lærke Nøhr","key":"gludpau","last":"Glud","locid":"04cb1c1e-165f-466a-a75d-2ceaacc8bbcc","name":"Glud, Lærke Nøhr","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Diana Malskær","key":"ivarsenpau","last":"Ivarsen","locid":"4d466e36-20f4-4cae-ac0f-c7c3fefca5ee","name":"Ivarsen, Diana Malskær","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Amanda Batoul","key":"khamaspau","last":"Khamas","locid":"2543fe5d-ede4-44e0-8a06-17ad5ce8fc37","name":"Khamas, Amanda Batoul","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sheiliza","key":"carmalipau","last":"Carmali","locid":"00d4386a-d9ff-441e-baa0-a1e01bce9af7","name":"Carmali, Sheiliza","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Snehit Satish","key":"mhatrepau","last":"Mhatre","locid":"e7d4cdf5-fc7a-4899-b4f5-46b1ef1cdac8","name":"Mhatre, Snehit","name_org":"Mhatre, Snehit Satish","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ane Bretschneider","key":"søgaardpau","last":"Søgaard","locid":"bbafdcac-3ed6-4500-9aa7-f505f9a0048a","name":"Søgaard, Ane Bretschneider","orcid":"0000-0002-9603-8913","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Emma","key":"faddypau","last":"Faddy","locid":"bb70676b-e875-42c1-86bd-040b8731c4cc","name":"Faddy, Emma","rank":9,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lisanne","key":"devorpau","last":"de Vor","name":"de Vor, Lisanne","rank":10,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Suzan","key":"hmrooijakkerspau","last":"H. M. Rooijakkers","name":"H. M. Rooijakkers, Suzan","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars Jørgen","key":"østergaardpau","last":"Østergaard","locid":"fb8358a6-187a-4d5f-8187-06051ed74173","name":"Østergaard, Lars Jørgen","orcid":"0000-0003-2459-0511","rank":12,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Nis Pedersen","key":"jørgensenpau","last":"Jørgensen","locid":"ac385492-f707-4053-bc6e-965ba8f60360","name":"Jørgensen, Nis Pedersen","rank":13,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rikke Louise","key":"meyerpau","last":"Meyer","locid":"f1caa4f6-bc6e-459a-a976-8843c7ea7ff3","name":"Meyer, Rikke Louise","orcid":"0000-0002-6485-5134","rank":14,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Alexander","key":"zelikinpau","last":"Zelikin","locid":"0554974f-a5c6-4817-9b94-19e0bdc178e2","name":"Zelikin, Alexander N.","name_org":"Zelikin, Alexander","orcid":"0000-0002-9864-321X","rank":15,"rolecode":"pau"}],"pmid":["37290045"],"pub":{"doi":"10.1002/advs.202301340","issn":["21983844"],"issue":"23","journal":"Advanced Science","paperid":"2301340","publisher":"John Wiley & Sons Inc.","status":"p","title":"Advanced Science","volume":"10"},"review":"Peer Reviewed","scoID":["2-s2.0-85161231398"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-f4effb5f-6ebb-4824-bab0-b9a925f62858"],"src":["AU Aarhus University"],"title":"Antibody-Drug Conjugates to Treat Bacterial Biofilms via Targeting and Extracellular Drug Release","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-675985","year":"2023","yearsub":"2023"}
{"abstract":"Objectives We developed a rat model of prosthetic vascular graft infection to assess, whether the fibrinolytic tissue plasminogen activator (tPA) could increase the efficacy of antibiotic therapy. Materials and methods Rats were implanted a polyethylene graft in the common carotid artery, pre-inoculated with approx. 6 log10 colony forming units (CFU) of methicillin resistant Staphylococcus aureus. Ten days after surgery, rats were randomized to either: 0.9% NaCl (n = 8), vancomycin (n = 8), vancomycin + tPA (n = 8), vancomycin + rifampicin (n = 18) or vancomycin + rifampicin + tPA (n = 18). Treatment duration was seven days. Approximately 36 hours after the end of treatment, the rats were euthanized, and grafts and organs were harvested for CFU enumeration. Results All animals in the control group had significantly higher CFU at the time of euthanization compared to bacterial load found on the grafts prior to inoculation (6.45 vs. 4.36 mean log10 CFU/mL, p = 0.0011), and both the procedure and infection were well tolerated. Vancomycin and rifampicin treatment were superior to monotherapy with vancomycin, as it lead to a marked decrease in median bacterial load on the grafts (3.50 vs. 6.56 log10 CFU/mL, p = 0.0016). The addition of tPA to vancomycin and rifampicin combination treatment did not show a further decrease in bacterial load (4.078 vs. 3.50 log10 CFU/mL, p = 0.26). The cure rate was 16% in the vancomycin + rifampicin group vs. 37.5% cure rate in the vancomycin + rifampicin + tPA group. Whilst interesting, this trend was not significant at our sample size (p = 0.24). Conclusion We developed the first functional model of an arterial prosthetic vascular graft infection in rats. Antibiotic combination therapy with vancomycin and rifampicin was superior to vancomycin monotherapy, and the addition of tPA did not significantly reduce bacterial load, nor significantly increase cure rate.","author_count":11,"contributors":["Johansen, Mikkel Illemann","Rahbek, Søren Jensen","Jensen-Fangel, Søren","Minero, Gabriel Antonio Salvador","Jensen, Louise Kruse","Larsen, Ole Halfdan","Erikstrup, Lise Tornvig","Seefeldt, Anders Marthinsen","Østergaard, Lars Jørgen","Meyer, Rikke Louise","Jørgensen, Nis Pedersen"],"cuid":["S02-086.35-692018"],"filters":{"added":"2023-09","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corresponding_author":["Johansen, Mikkel Illemann"],"keyword":["Animals","Anti Bacterial Agents pharmacology","Methicillin Resistant Staphylococcus aureus","Prosthesis Related Infections drug therapy","Rats","Rifampin pharmacology","Staphylococcal Infections drug therapy","Tissue Plasminogen Activator therapeutic use","Vancomycin pharmacology"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-HO-CDR","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"fibrinolytic and antibiotic treatment of prosthetic vascular graft infections in a novel rat model","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1371/journal.pone.0287671","version":"Published Version"},"id":"S02-086.35-692018","identifier":[{"id":"PMC10353806","type":"pmcid"},{"id":"37463137","type":"pmid"},{"id":"85165518219","type":"scopus"}],"ids":["au-846ae713-5cb9-440d-b500-5937f21f6aac","ku-dfae0e6b-8980-4b23-a732-41966a2cddb3"],"keyword":["Animals","Anti-Bacterial Agents/pharmacology","Methicillin-Resistant Staphylococcus aureus","Prosthesis-Related Infections/drug therapy","Rats","Rifampin/pharmacology","Staphylococcal Infections/drug therapy","Tissue Plasminogen Activator/therapeutic use","Vancomycin/pharmacology"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-55AE48D2A83EE4BACC94DBF54E443F5C"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1371/journal.pone.0287671","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/365822199/journal.pone.0287671.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Infectious Diseases","Aarhus University, Natural Sciences, Interdisciplinary Nanoscience Center"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Veterinary and Animal Sciences, Pathobiological Sciences"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1 2","corresponding":null,"country":"dk","first":"Mikkel Illemann","key":"johansenpau","last":"Johansen","locid":"521aaf8b-4d7a-4672-82c4-2c79a297b02a","name":"Johansen, Mikkel Illemann","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Søren Jensen","key":"rahbekpau","last":"Rahbek","locid":"fda9fd05-4798-4ec6-b8a9-53df61853087","name":"Rahbek, Søren Jensen","rank":2,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Søren","key":"jensenfangelpau","last":"Jensen-Fangel","locid":"9822ac67-91e2-4c70-be62-1d560c6e4ba6","name":"Jensen-Fangel, Søren","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Gabriel Antonio","key":"mineropau","last":"Minero","locid":"cc436bce-1546-4216-bb08-ae06ac0300d2","name":"Minero, Gabriel Antonio Salvador","name_org":"Minero, Gabriel Antonio","rank":4,"rolecode":"pau"},{"affno":"3","first":"Louise Kruse","key":"jensenpau","last":"Jensen","locid":"1edba00c-b457-4660-85a3-24c07c4919f6","name":"Jensen, Louise Kruse","rank":5,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Ole Halfdan","key":"larsenpau","last":"Larsen","locid":"f280dbc7-1019-42be-badb-da94300ffabd","name":"Larsen, Ole Halfdan","orcid":"0000-0001-5213-7349","rank":6,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Lise Tornvig","key":"erikstruppau","last":"Erikstrup","locid":"5313d67d-7d72-4a11-b998-2c0a51ec9612","name":"Erikstrup, Lise Tornvig","rank":7,"rolecode":"pau"},{"affno":"2","first":"Anders Marthinsen","key":"seefeldtpau","last":"Seefeldt","name":"Seefeldt, Anders Marthinsen","rank":8,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Lars Jørgen","key":"østergaardpau","last":"Østergaard","locid":"fb8358a6-187a-4d5f-8187-06051ed74173","name":"Østergaard, Lars Jørgen","orcid":"0000-0003-2459-0511","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rikke Louise","key":"meyerpau","last":"Meyer","locid":"f1caa4f6-bc6e-459a-a976-8843c7ea7ff3","name":"Meyer, Rikke Louise","orcid":"0000-0002-6485-5134","rank":10,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Nis Pedersen","key":"jørgensenpau","last":"Jørgensen","locid":"ac385492-f707-4053-bc6e-965ba8f60360","name":"Jørgensen, Nis Pedersen","rank":11,"rolecode":"pau"}],"pmid":["37463137"],"pub":{"doi":"10.1371/journal.pone.0287671","issn":["19326203"],"issue":"7","journal":"PLOS ONE","paperid":"e0287671","publisher":"Public Library of Science","status":"p","title":"PLOS ONE","volume":"18"},"review":"Peer Reviewed","scoID":["2-s2.0-85165518219"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-846ae713-5cb9-440d-b500-5937f21f6aac","ku-dfae0e6b-8980-4b23-a732-41966a2cddb3"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Fibrinolytic and antibiotic treatment of prosthetic vascular graft infections in a novel rat model","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-086.35-692018","year":"2023","yearsub":"2023"}
{"abstract":"Background: Diet-induced weight loss is associated with a decline in lean body mass, as mediated by an impaired response of muscle protein synthesis (MPS). The dose-response of MPS to ingested protein, with or without resistance exercise, is well characterized during energy balance but limited data exist under conditions of energy restriction in clinical populations. Objective: To determine the dose-response of MPS to ingested whey protein following short-term diet-induced energy restriction in overweight, postmenopausal, women at rest and postexercise. Design: Forty middle-aged (58.6±0.4 y), overweight (BMI: 28.6±0.4), postmenopausal women were randomly assigned to 1 of 4 groups: Three groups underwent 5 d of energy restriction (∼800 kcal/d). On day 6, participants performed a unilateral leg resistance exercise bout before ingesting either a bolus of 15g (ERW15, n = 10), 35g (ERW35, n = 10) or 60g (ERW60, n = 10) of whey protein. The fourth group (n = 10) ingested a 35g whey protein bolus after 5 d of an energy balanced diet (EBW35, n = 10). Myofibrillar fractional synthetic rate (FSR) was calculated under basal, fed (FED) and postexercise (FED-EX) conditions by combining an L-[ring-13C6] phenylalanine tracer infusion with the collection of bilateral muscle biopsies. Results: Myofibrillar FSR was greater in ERW35 (0.043±0.003%/h, P = 0.013) and ERW60 (0.042±0.003%/h, P = 0.026) than ERW15 (0.032 ± 0.003%/h), with no differences between ERW35 and ERW60 (P = 1.000). Myofibrillar FSR was greater in FED (0.044 ± 0.003%/h, P < 0.001) and FED-EX (0.048 ± 0.003%/h, P < 0.001) than BASAL (0.027 ± 0.003%/h), but no differences were detected between FED and FED-EX (P = 0.732) conditions. No differences in myofibrillar FSR were observed between EBW35 (0.042 ± 0.003%/h) and ERW35 (0.043 ± 0.003%/h, P = 0.744). Conclusion: A 35 g dose of whey protein, ingested with or without resistance exercise, is sufficient to stimulate a maximal acute response of MPS following short-term energy restriction in overweight, postmenopausal women, and thus may provide a per serving protein recommendation to mitigate muscle loss during a weight loss program. Trial registry: clinicaltrials.gov (ID: NCT03326284).","author_count":12,"contributors":["Larsen, Mads Sørensen","Witard, Oliver C.","Holm, Lars","Scaife, Paula","Hansen, Rikke","Smith, Kenneth","Tipton, Kevin D.","Mose, Maike","Bengtsen, Mads Bisgaard","Lauritsen, Katrine Meyer","Mikkelsen, Ulla R.","Hansen, Mette"],"cuid":["S02-100.00-755765"],"filters":{"added":"2024-02","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["Europe, Non-EU","OECD"],"corresponding_author":["Hansen, Mette"],"country":["United Kingdom"],"glorg":["All Global Affiliations","Durham University","King's College London","University of Birmingham","University of Durham","University of Nottingham"],"keyword":["Females","Middle Aged","Muscle protein synthesis","Obesity","Weight loss"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-ARLA"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-PR-ARLA","DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"dose response of myofibrillar protein synthesis to ingested whey protein during energy restriction in overweight postmenopausal women a randomized controlled trial","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.1016/j.tjnut.2023.08.011","version":"Published Version"},"id":"S02-100.00-755765","identifier":[{"id":"37598750","type":"pmid"},{"id":"85173221839","type":"scopus"}],"ids":["aau-1114c6b7-7ea1-4024-9381-649652f6f644","au-35646c48-a69b-4db9-a7f6-0996d38ad18b"],"keyword":["females","middle-aged","muscle protein synthesis","obesity","weight loss"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-FDEC25404DA4D2A9006CE61270DF641D"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.1016/j.tjnut.2023.08.011","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/742796820/1-s2.0-S0022316623725352-main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.au.dk/ws/files/384332134/1-s2.0-S0022316623725352-main.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Public Health"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"arla foods","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-ARLA","l3nl":"Arla Foods","l3nn":"Arla Foods","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Arla Foods","namevar":["Arla Foods"],"nora_code":"DI-PR-ARLA","used":1},{"affno":"3","country":"gb","key":"king s college london","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"King's College London","used":1},{"affno":"4","country":"gb","key":"university of birmingham","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Birmingham","used":1},{"affno":"5","country":"gb","key":"university of nottingham","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Nottingham","used":1},{"affno":"6","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine"],"nora_cod