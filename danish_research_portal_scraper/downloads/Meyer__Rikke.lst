{"author_count":5,"contributors":["Jørgensen, Nis Pedersen","Fuursted, Kurt","Dam, Karen","Meyer, Rikke Louise","Petersen, Eskild"],"cuid":["S01-000.00-264902"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"biofilm formation by staphylococcus aureus on orthopaedic implants in a novel murine infection model","src":["au"],"src-code":["DI-U-AU"],"type":"dco","type-grp":["all","pub"]},"id":"S01-000.00-264902","ids":["au-ed8db55f-e6f3-4bfb-b1a3-8be009c035e8"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-23E748EA770258EAD3A290C84C3B7EF0"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Clinical Microbiology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Nis Pedersen","key":"jørgensenpau","last":"Jørgensen","locid":"ac385492-f707-4053-bc6e-965ba8f60360","name":"Jørgensen, Nis Pedersen","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kurt","key":"fuurstedpau","last":"Fuursted","locid":"4480caa1-e763-4685-b132-f26a60bedce8","name":"Fuursted, Kurt","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Karen","key":"dampau","last":"Dam","locid":"cefd7459-2da6-4098-965a-4fc17b2130b6","name":"Dam, Karen","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rikke Louise","key":"meyerpau","last":"Meyer","locid":"f1caa4f6-bc6e-459a-a976-8843c7ea7ff3","name":"Meyer,