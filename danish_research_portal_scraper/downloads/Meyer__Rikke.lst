issn_org":["03051846"],"issue":"6","journal":"Neuropathology and Applied Neurobiology","paperid":"e13016","publisher":"Wiley","status":"p","title":"Neuropathology and Applied Neurobiology","volume":"50"},"review":"Peer Reviewed","scoID":["2-s2.0-85209898435"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-85d9de0e-77cd-48ba-8065-c0c8d1292378","sdu-d19cd11e-4d19-4f49-80f3-c9500ae3dc66"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Microglia induce an interferon-stimulated gene expression profile in glioblastoma and increase glioblastoma resistance to temozolomide","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-769010","year":"2024","yearsub":"2024"}
{"abstract":"Introduction: The dental biofilm matrix is an important determinant of virulence for caries development and comprises a variety of extracellular polymeric substances that contribute to biofilm stability. Enzymes that break down matrix components may be a promising approach to caries control, and in light of the compositional complexity of the dental biofilm matrix, treatment with multiple enzymes may enhance the reduction of biofilm formation compared to single enzyme therapy. The present study investigated the effect of the three matrix-degrading enzymes mutanase, beta-glucanase, and DNase, applied separately or in combinations, on biofilm prevention and removal in a saliva-derived in vitro-grown model. Methods: Biofilms were treated during growth to assess biofilm prevention or after 24 h of growth to assess biofilm removal by the enzymes. Biofilms were quantified by crystal violet staining and impedance-based real-time cell analysis, and the biofilm structure was visualized by confocal microscopy and staining of extracellular DNA (eDNA) and polysaccharides. Results: The in vitro model was dominated by Streptococcus spp., as determined by 16S rRNA gene amplicon sequencing. All tested enzymes and combinations had a significant effect on biofilm prevention, with reductions of >90% for mutanase and all combinations including mutanase. Combined application of DNase and beta-glucanase resulted in an additive effect (81.0% ± 1.3% SD vs. 36.9% ± 21.9% SD and 48.2% ± 14.9% SD). For biofilm removal, significant reductions of up to 73.2% ± 5.5% SD were achieved for combinations including mutanase, whereas treatment with DNase had no effect. Glucans, but not eDNA decreased in abundance upon treatment with all three enzymes. Conclusion: Multi-enzyme treatment is a promising approach to dental biofilm control that needs to be validated in more diverse biofilms.","author_count":6,"contributors":["Rikvold, Pernille","Hansen Skov, Lea Benedicte","Meyer, Rikke Louise","Rose Jorgensen, Mette","Tiwari, Manish K","Schlafer, Sebastian"],"cuid":["S01-000.00-709029"],"filters":{"added":"2024-02","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Rikvold, Pernille","Schlafer, Sebastian"],"keyword":["Biofilms","Confocal laser scanning microscopy","Dental caries","Dental plaque","Enzymes","Glycoside Hydrolases","Humans","Illumina sequencing","RNA Ribosomal 16S","Saliva"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-NOSI"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-PR-NOSI","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"the effect of enzymatic treatment with mutanase beta glucanase and dnase on a saliva derived biofilm model","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1159/000535980","version":"Published Version"},"id":"S01-000.00-709029","identifier":[{"id":"PMC10997270","type":"pmcid"},{"id":"38154453","type":"pmid"},{"id":"85190176347","type":"scopus"}],"ids":["au-b647402f-95e8-4e2c-93fb-8f700d66dfbf"],"keyword":["Biofilms","Confocal laser scanning microscopy","Dental Caries","Dental plaque","Deoxyribonucleases/pharmacology","Enzymes","Extracellular polymeric substance matrix","Glycoside Hydrolases","Humans","Illumina sequencing","RNA, Ribosomal, 16S","Saliva"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-B952DCC775B586BC6715CEB17B9A3CDA"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1159/000535980","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Dentistry and Oral Health, Department of Dentistry and Oral Health - Section for Oral Ecology"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"novonesis","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-NOSI","l3nn":"Novonesis","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Novonesis","namevar":["Novozymes A/S"],"nora_code":"DI-PR-NOSI","used":1}],"person":[{"affno":"1 2","corresponding":null,"country":"dk","first":"Pernille Dukanovic","key":"rikvoldpau","last":"Rikvold","locid":"d5ef43bc-479a-4d2b-916a-7028a4618e80","name":"Rikvold, Pernille","name_org":"Rikvold, Pernille Dukanovic","orcid":"0000-0002-2431-6937","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lea Benedicte","key":"hansenskovpau","last":"Hansen Skov","name":"Hansen Skov, Lea Benedicte","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rikke","key":"louisemeyerpau","last":"Louise Meyer","locid":"f1caa4f6-bc6e-459a-a976-8843c7ea7ff3","name":"Meyer, Rikke Louise","name_org":"Louise Meyer, Rikke","orcid":"0000-0002-6485-5134","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Mette","key":"rosejorgensenpau","last":"Rose Jorgensen","name":"Rose Jorgensen, Mette","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Manish K","key":"tiwaripau","last":"Tiwari","name":"Tiwari, Manish K","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Sebastian","key":"schlaferpau","last":"Schlafer","locid":"bcd4e1fe-3a80-4288-8b5f-d105f6f53982","name":"Schlafer, Sebastian","orcid":"0000-0003-2463-1926","rank":6,"rolecode":"pau"}],"pmid":["38154453"],"pub":{"doi":"10.1159/000535980","issn":["00086568","1421976X"],"issn_org":["00086568"],"issue":"2","journal":"Caries Research","pages":"72-80","publisher":"S. Karger AG","status":"p","title":"Caries Research","volume":"58"},"review":"Peer Reviewed","scoID":["2-s2.0-85190176347"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Private Research","Universities"],"PST":["Published"]},"sid":["au-b647402f-95e8-4e2c-93fb-8f700d66dfbf"],"src":["AU Aarhus University"],"title":"The effect of enzymatic treatment with mutanase, beta-glucanase and DNase on a saliva-derived biofilm model","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-709029","year":"2024","yearsub":"2024"}
{"abstract":"Multidrug efflux pumps excrete a range of small molecules from bacterial cells. In this study, we show that bacterial efflux pumps have affinity for a range of SYTO™ dyes that are commonly used to label bacteria. Efflux pump activity will there lead to false negative results from bacterial staining and SYTO™ dyes should be used with caution on live samples.","author_count":4,"contributors":["Minero, Gabriel Antonio Salvador","Larsen, Peter Bundgaard","Hoppe, Marie Eline","Meyer, Rikke Louise"],"cuid":["S01-000.00-737724"],"filters":{"added":"2024-08","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Meyer, Rikke Louise"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"bacterial efflux pumps excrete syto dyes and lead to false negative staining results","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85187382125","version":"Other Version"},"id":"S01-000.00-737724","identifier":[{"id":"85187382125","type":"scopus"},{"id":"38445898","type":"pmid"}],"ids":["au-cc11dbe8-bb4e-4091-aeaa-901716bb0113"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-C0E243703787B75189E22A70BD49AA09"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Interdisciplinary Nanoscience Center"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Gabriel Antonio Salvador","key":"mineropau","last":"Minero","locid":"cc436bce-1546-4216-bb08-ae06ac0300d2","name":"Minero, Gabriel Antonio Salvador","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Peter Bundgaard","key":"larsenpau","last":"Larsen","locid":"37af3372-e8d1-4fe1-8c7a-2ade25006565","name":"Larsen, Peter Bundgaard","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Marie Eline","key":"hoppepau","last":"Hoppe","name":"Hoppe, Marie Eline","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rikke Louise","key":"meyerpau","last":"Meyer","locid":"f1caa4f6-bc6e-459a-a976-8843c7ea7ff3","name":"Meyer, Rikke Louise","orcid":"0000-0002-6485-5134","rank":4,"rolecode":"pau"}],"pmid":["38445898"],"pub":{"doi":"10.1039/d3an02112b","issn":["00032654","13645528"],"issn_org":["00032654"],"issue":"8","journal":"Analyst","pages":"2232-2235","publisher":"Royal Society of Chemistry","status":"p","title":"Analyst","volume":"149"},"review":"Peer Reviewed","scoID":["2-s2.0-85187382125"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-cc11dbe8-bb4e-4091-aeaa-901716bb0113"],"src":["AU Aarhus University"],"title":"Bacterial efflux pumps excrete SYTO™ dyes and lead to false-negative staining results","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-737724","year":"2024","yearsub":"2024"}
{"author_count":5,"contributors":["Kraglund, Rikke Andersen"],"cuid":["S01-000.00-130563"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"but it hurts like i killed someone character assassinations and karl ove knausgaard s my struggle","src":["au"],"src-code":["DI-U-AU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3726/b21221","version":"Published Version"},"id":"S01-000.00-130563","ids":["au-02500460-e7ca-4484-9a0e-3d11a8290199"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Global-Local-6-6-3EE10999B0931AD53B1AF5B1CA616E26"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3726/b21221","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Arts, School of Communication and Culture, School of Communication and Culture - Scandinavian Studies"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Rikke Andersen","key":"kraglundpau","last":"Kraglund","locid":"86aff6ed-5cb3-42c8-9c01-814893bae56a","name":"Kraglund, Rikke Andersen","orcid":"0009-0005-5710-1966","rank":1,"rolecode":"pau"},{"affno":"","first":"Samuli","key":"björninenpedh","last":"Björninen","name":"Björninen, Samuli","rank":2,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Pernille","key":"meyerpedh","last":"Meyer","name":"Meyer, Pernille","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Maria","key":"mäkeläpedh","last":"Mäkelä","name":"Mäkelä, Maria","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Henrik","key":"zetterbergnielsenpedh","last":"Zetterberg-Nielsen","name":"Zetterberg-Nielsen, Henrik","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.3726/b21221","eisbn":["9783631894750","9783631894767"],"isbn":["9783631851739"],"issn":["09354093"],"pages":"183-209","place":"Berlin","publisher":"Peter Lang","series":"Literary and Cultural Studies, Theory and the (New) Media","status":"p","title":"Dangers of Narrative and Fictionality"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-02500460-e7ca-4484-9a0e-3d11a8290199"],"src":["AU Aarhus University"],"title":"‘But It Hurts Like I Killed Someone.’ : Character Assassinations and Karl Ove Knausgaard’s My Struggle","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-130563","year":"2024","yearsub":"2024"}
{"abstract":"The problem of antibiotic resistance has raised serious concerns globally and hence the development of new materials which can combat these drug-resistant strains has gained a great deal of attention. Herein, we report the use of a biocompatible material, chitosan, as a scaffold to graft saccharides which can specifically target Pseudomonas aeruginosa. We realized this by synthesizing N-functionalized chitosan conjugates by coupling chitosan to fucose and galactose moieties which intercept Pseudomonas aeruginosa lectins and target the bacterial biofilms. A series of six conjugates containing similar proportions of cationic and sugar moieties were synthesized by direct modification of the chitosan backbone using a method that is highly efficient and reproducible. The conjugates showed a bactericidal effect against both Gram positive and Gram negative bacterial strains. An investigation into the antibiofilm activity of the conjugates revealed the optimum combination of the type and positioning of the functionalities that were highly effective in eradicating Pseudomonas aeruginosa biofilms. 2D and 3D imaging of the conjugate-treated biofilms using confocal laser scanning microscopy (CLSM) allowed us to determine that the conjugates not only acted on the surface but also dispersed into deep layers of the biofilm. Interaction between the conjugates and individual bacterial cells in the biofilm was further confirmed by fluorescence labelling of the conjugates and imaging by CLSM.","author_count":6,"contributors":["Sahariah, Priyanka","Papi, Francesco","Merz, Koi L.","Sigurjonsson, Olafur E.","Meyer, Rikke Louise","Nativi, Cristina"],"cuid":["S01-000.00-788123"],"filters":{"added":"2025-02","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Sahariah, Priyanka"],"country":["Iceland","Italy"],"glorg":["All Global Affiliations","Landspitali University Hospital","University of Florence","University of Iceland"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"chitosan saccharide conjugates for eradication of pseudomonas aeruginosa biofilms","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1039/D3LP00263B","version":"Published Version"},"id":"S01-000.00-788123","identifier":[{"id":"86000785387","type":"scopus"}],"ids":["au-f01b571a-d4a4-474c-88bf-3b3f2418daa1"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-3C43C5B630BDED854FFC1F1421E41A69"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1039/D3LP00263B","version":"Published Version"}],"org":[{"affno":"1","country":"is","key":"university of iceland","loc":["Iceland","Europe, Non-EU","Nordic","OECD"],"name":"University of Iceland","used":1},{"affno":"2","country":"it","key":"university of florence","loc":["Italy","Europe, EU","OECD"],"name":"University of Florence","used":1},{"affno":"3","country":"is","key":"landspitali university hospital","loc":["Iceland","Europe, Non-EU","Nordic","OECD"],"name":"Landspitali University Hospital","used":1},{"affno":"4","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Biology","Aarhus University, Natural Sciences, Interdisciplinary Nanoscience Center"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Priyanka","key":"sahariahpau","last":"Sahariah","name":"Sahariah, Priyanka","rank":1,"rolecode":"pau"},{"affno":"2","correspondin