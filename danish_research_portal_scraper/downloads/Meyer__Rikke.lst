 Kristian Olsen","key":"alstrupaagekristianolsenpau","last":"Alstrup","locid":"fa66f5b8-0468-4e85-b570-969776c5ebde","name":"Alstrup, Aage Kristian Olsen","orcid":"0000-0002-0084-9122","rank":10,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Aage K O","key":"alstrupaagekopau","last":"Alstrup","name":"Alstrup, Aage K O","rank":10,"rolecode":"pau"}],"pmid":["29790580"],"pub":{"doi":"10.1002/jlcr.3640","issn":["03624803","10991344"],"issn_org":["03624803"],"issue":"10","journal":"Journal of Labelled Compounds and Radiopharmaceuticals","pages":"780-795","publisher":"John Wiley and Sons Ltd","status":"p","title":"Journal of Labelled Compounds and Radiopharmaceuticals","volume":"61"},"review":"Peer Reviewed","scoID":["2-s2.0-85051436957"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All GTS Institutes","All Universities","DI-ALL","DI-GTS","DI-GTS-ALL","DI-U","DI-U-ALL","GTS Institutes","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["aau-5d669dcb-b479-4b93-8242-4dd94c51dd4a","au-b54d1ae6-a607-47be-9ee5-38b1e38f8767","ku-70c2a034-7c10-49ee-bf42-8630f5a908d5"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen"],"title":"Preclinical evaluation of potential infection-imaging probe [<sup>68</sup>Ga]Ga-DOTA-K-A9 in sterile and infectious inflammation","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-099.96-004537","year":"2018","yearsub":"2018"}
{"author_count":4,"contributors":["Dreier, Cindy","Zelikin, Alexander N.","Kjems, Jørgen","Meyer, Rikke Louise"],"cuid":["S01-000.00-132057"],"event":{"end":"2018-09-28","place":"Rom, it","start":"2018-09-26","title":"ICONAN2018","year":"2018"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"development of an iron oxide nanoparticle drug delivery system against staphylococcus aureus biofilm infections","src":["au"],"src-code":["DI-U-AU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://www.premc.org/doc/ICONAN2018/ICONAN2018_Book_Of_Abstracts.pdf","version":"Published Version"},"id":"S01-000.00-132057","ids":["au-04cd94a7-c25e-4ccc-884c-010100109eab"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-12C2A93FF0E10A1352C6F38BB157E91E"],"oa_link":[{"access":"oa","type":"rem","url":"https://www.premc.org/doc/ICONAN2018/ICONAN2018_Book_Of_Abstracts.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Interdisciplinary Nanoscience Center, Interdisciplinary Nanoscience Center - INANO-Bioscience, iNANO-huset"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Cindy","key":"dreierpau","last":"Dreier","locid":"5177aea4-a419-4fdf-8d72-3e6e3a11e11b","name":"Dreier, Cindy","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Alexander N.","key":"zelikinpau","last":"Zelikin","locid":"0554974f-a5c6-4817-9b94-19e0bdc178e2","name":"Zelikin, Alexander N.","orcid":"0000-0002-9864-321X","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jørgen","key":"kjemspau","last":"Kjems","locid":"f5915d75-aca3-437a-9a9d-f4fdfef7accd","name":"Kjems, Jørgen","orcid":"0000-0003-4128-9317","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rikke Louise","key":"meyerpau","last":"Meyer","locid":"f1caa4f6-bc6e-459a-a976-8843c7ea7ff3","name":"Meyer, Rikke Louise","orcid":"0000-0002-6485-5134","rank":4,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-04cd94a7-c25e-4ccc-884c-010100109eab"],"src":["AU Aarhus University"],"title":"Development of an iron oxide nanoparticle drug delivery system against Staphylococcus aureus biofilm infections","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-132057","year":"2018","yearsub":"2018"}
{"abstract":"Bacterial biofilms are a common cause of the persistence of chronic wounds, and continue to be an unsolved problem in infection microbiology due to their tolerance to antibiotics. Silver nanoparticles (Ag-NPs) have attracted attention as an alternative to antibiotics for treatment of wound infections, but their use is challenged by limited tissue penetration and high cytotoxicity. The aim of this study was to show that combination of Ag nanoparticles with Fe 3O 4 to produce Ag/Fe 3O 4 nanocomposites (NCs) can overcome these problems, as they penetrate and eradicate biofilms when applying a magnetic field. Ag/Fe 3O 4-NCs were synthesized using starch as a stabilizer and linker between Ag and Fe 3O 4 NPs, resulting in agglomerations of 20 nm Ag-NPs and 5 nm Fe 3O 4 NPs. The antibacterial activity was evaluated against an in vitro chronic wound biofilm model, and cytotoxicity was evaluated on human fibroblasts. Increasing the amount of starch during synthesis led to formation of NCs with increased antibacterial activity. In comparison to Ag-NPs, the NCs showed lower Ag + release, less ROS production, were less cytotoxic, but nevertheless, their antimicrobial efficacy was higher. Furthermore, their efficiency against biofilm could be enhanced by applying a magnetic field, which ensured penetration of the entire biofilm. In conclusion, Ag/Fe 3O 4-NCs display important advantages over Ag-NPs as a potential avenue for development of novel therapeutic strategies for treatment of chronic wound infections.","author_count":3,"contributors":["Ghaseminezhad, Seyedeh Masumeh","Shojaosadati, Seyed Abbas","Meyer, Rikke Louise"],"cuid":["S01-000.00-149109"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Asia, Middle East"],"corresponding_author":["Shojaosadati, Seyed Abbas"],"country":["Iran"],"glorg":["All Global Affiliations","Tarbiat Modarres University"],"keyword":["Antibiofilm activity","Antimicrobial activity","Cytotoxicity","Fabrication","Hybrid nanoparticles","Iron oxide","Particle Size","Silver nanoparticles","Starch"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"ag fe sub 000000000003 sub o sub 000000000004 sub nanocomposites penetrate and eradicate i s aureus i biofilm in an i in vitro i chronic wound model","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85039768054","version":"Other Version"},"id":"S01-000.00-149109","identifier":[{"id":"000427217300023","type":"wos"},{"id":"29301116","type":"pmid"},{"id":"85039768054","type":"scopus"}],"ids":["au-2279d8c4-ad9f-4e42-858c-e72d7f7f8dd5"],"keyword":["ANTIBACTERIAL ACTIVITIES","ANTIBIOFILM ACTIVITY","ANTIMICROBIAL ACTIVITY","Ag/Fe3O4 nanocomposites","CYTOTOXICITY","FABRICATION","HYBRID NANOPARTICLES","IRON-OXIDE","PARTICLE-SIZE","SILVER NANOPARTICLES","STATIC MAGNETIC-FIELDS","Starch","Wound biofilm"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-D95705F867E675973EC5D943A88A388E"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","country":"ir","key":"tarbiat modarres university","loc":["Iran","Asia, Middle East"],"name":"Tarbiat Modarres University","used":1},{"affno":"2","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University (AU)","Aarhus University, Natural Sciences, Interdisciplinary Nanoscience Center, Interdisciplinary Nanoscience Center - INANO-Bioscience, iNANO-huset","Aarhus University, Technical Sciences, Department of Ecoscience"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Seyedeh Masumeh","key":"ghaseminezhadpau","last":"Ghaseminezhad","name":"Ghaseminezhad, Seyedeh Masumeh","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Seyed Abbas","key":"shojaosadatipau","last":"Shojaosadati","name":"Shojaosadati, Seyed Abbas","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Rikke Louise","key":"meyerpau","last":"Meyer","locid":"f1caa4f6-bc6e-459a-a976-8843c7ea7ff3","name":"Meyer, Rikke Louise","orcid":"0000-0002-6485-5134","rank":3,"rolecode":"pau"}],"pmid":["29301116"],"pub":{"doi":"10.1016/j.colsurfb.2017.12.035","issn":["09277765","18734367"],"issn_org":["09277765"],"journal":"Colloids and Surfaces B: Biointerfaces","pages":"192-200","publisher":"Elsevier BV","publisher_org":"Elsevier B.V.","status":"p","title":"Colloids and Surfaces B: Biointerfaces","volume":"163"},"review":"Peer Reviewed","scoID":["2-s2.0-85039768054"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-2279d8c4-ad9f-4e42-858c-e72d7f7f8dd5"],"src":["AU Aarhus University"],"title":"Ag/Fe<sub>3</sub>O<sub>4</sub> nanocomposites penetrate and eradicate <i>S.aureus</i> biofilm in an <i>in vitro</i> chronic wound model","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-149109","year":"2018","yearsub":"2018"}
{"abstract":"Bacterial biofilms tolerate extreme levels of antibiotics. Treatment of biofilm infections therefore requires the development of new or modified antimicrobials that can penetrate biofilms and are effective against dormant persistent cells. One such new approach uses the biodegradable biopolymer chitosan and its derivatives as antimicrobials. In this study, we performed synthetic modification of chitosan to selectively introduce different cationic and hydrophobic moieties at varying ratios on chitosan. This improved its aqueous solubility and antimicrobial activity toward bacterial biofilms. Initial evaluation of the chitosan derivatives showed increased activity toward planktonic Staphylococcus aureus. The effect of the quaternary ammoniumyl chitosan derivatives against Staphylococcus aureus biofilms was more variable. The most effective derivatives contained hydrophobic groups, and their efficacy against biofilms depended on the ratio and length of the alkyl chains. Three-dimensional imaging of biofilms confirmed the accessibility and antimicrobial effect of chitosan derivatives with alkyl chains in the full depth of the biofilms.","author_count":3,"contributors":["Sahariah, Priyanka","Masson, Mar","Meyer, Rikke Louise"],"cuid":["S01-000.00-226057"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Sahariah, Priyanka"],"country":["Iceland"],"glorg":["All Global Affiliations","University of Iceland"],"keyword":["Aid","Antibacterial activity","Bacterial biofilms","Inhibition","Nanoparticles"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"quaternary ammoniumyl chitosan derivatives for eradication of staphylococcus aureus biofilms","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85050773719","version":"Other Version"},"id":"S01-000.00-226057","identifier":[{"id":"85050773719","type":"scopus"},{"id":"30044610","type":"pmid"},{"id":"000444527300006","type":"wos"}],"ids":["au-a98c7b75-c031-4e8e-a9f8-3875f4e94200"],"keyword":["AID","ANTIBACTERIAL ACTIVITY","BACTERIAL BIOFILMS","INHIBITION","NANOPARTICLES"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-F733877E2995F0618E44EFDE547BB53B"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","country":"is","key":"university of iceland","loc":["Iceland","Europe, Non-EU","Nordic","OECD"],"name":"University of Iceland","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Interdisciplinary Nanoscience Center, Interdisciplinary Nanoscience Center - INANO-Bioscience, iNANO-huset","Aarhus University, Technical Sciences, Department of Ecoscience"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Priyanka","key":"sahariahpau","last":"Sahariah","name":"Sahariah, Priyanka","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mar","key":"massonpau","last":"Masson","name":"Masson, Mar","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Rikke Louise","key":"meyerpau","last":"Meyer","locid":"f1caa4f6-bc6e-459a-a976-8843c7ea7ff3","name":"Meyer, Rikke Louise","orcid":"0000-0002-6485-5134","rank":3,"rolecode":"pau"}],"pmid":["30044610"],"pub":{"doi":"10.1021/acs.biomac.8b00718","issn":["15257797","15264602"],"issn_org":["15257797"],"issue":"9","journal":"Biomacromolecules","pages":"3649-3658","publisher":"American Chemical Society","status":"p","title":"Biomacromolecules","volume":"19"},"review":"Peer Reviewed","scoID":["2-s2.0-85050773719"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-a98c7b75-c031-4e8e-a9f8-3875f4e94200"],"src":["AU Aarhus University"],"title":"Quaternary Ammoniumyl Chitosan Derivatives for Eradication of Staphylococcus aureus Biofilms","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-226057","year":"2018","yearsub":"2018"}
{"abstract":"Polymyxin B is a polycationic antibiotic used as the last line treatment against antibiotic-resistant Gram negative bacteria. However, application of polymyxin B is limited because of its toxicity effects. Herein, we used bare and surface modified mesoporous silica nanoparticles (MSNs) with an average diameter of 72.29 ± 8.17 nm as adsorbent for polymyxin B to improve its therapeutic properties. The polymyxin B adsorption onto MSN surfaces was explained as a function of pH, type of buffer and surface charge of nanoparticles, according to the ζ-potential of silica nanoparticles and adsorption kinetics results. The highest value of the adsorption capacity (about 401 ± 15.38 mg polymyxin B/ g silica nanoparticles) was obtained for the bare nanoparticles in Tris buffer, pH 9. Release profiles of polymyxin B showed a sustained release pattern, fitting Power law and Hill models. The antibiotic molecules-loaded nanoparticles showed enhanced antibacterial activity compared to free antibiotic against different Gram negative bacteria. Biocompatibility evaluation results revealed that loading of polymyxin B onto MSNs can decrease the cytotoxicity effects of the drug by reducing ROS generation. Our results suggest that formulation of drugs by adsorption onto MSNs may offer a way forward to overcome the adverse effects of some antibiotics such as polymyxin B without compromising their antimicrobial properties.","author_count":4,"contributors":["Gounani, Zahra","Asadollahi, Mohammad A.","Meyer, Rikke Louise","Arpanaei, Ayyoob"],"cuid":["S01-000.00-275325"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Asia, Middle East"],"corresponding_author":["Asadollahi, Mohammad A."],"country":["Iran"],"glorg":["All Global Affiliations","University of Isfahan"],"keyword":["Adsorption","Antibiotic","Antibiotics","Controlled drug delivery","Drug delivery","Functionalization","Inhibition","Mechanisms","Mesoporous silica nanoparticles","Peptide adsorption","Polymyxin B","Release","SIZE","Surface"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"loading of polymyxin b onto anionic mesoporous silica nanoparticles retains antibacterial activity and enhances biocompatibility","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85039150281","version":"Other Version"},"id":"S01-000.00-275325","identifier":[{"id":"85039150281","type":"scopus"},{"id":"29278732","type":"pmid"},{"id":"000424263700017","type":"wos"}],"ids":["au-ffd5eb32-d954-4dc3-9c2e-8745b849272d"],"keyword":["ALPHA-SYNUCLEIN FIBRILLATION","ANTIBIOTICS","Adsorption","Antibiotic","CONTROLLED DRUG-DELIVERY","Drug delivery","FUNCTIONALIZATION","INHIBITION","MECHANISMS","Mesoporous silica nanoparticles","PEPTIDE ADSORPTION","Polymyxin B","RELEASE","SIZE","SURFACE"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-7F4CAD019F04BB12C45EE7B58190377E"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","country":"ir","key":"university of isfahan","loc":["Iran","Asia, Middle East"],"name":"University of Isfahan","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Biology, Department of Biology - Microbiology","Aarhus University, Natural Sciences, Interdisciplinary Nanoscience Center, Interdisciplinary Nanoscience Center - INANO-Bioscience, iNANO-huset"],"nora_code":"DI-U-AU","used":1},{"affno":"3","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Zahra","key":"gounanipau","last":"Gounani","name":"Gounani, Zahra","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mohammad A.","key":"asadollahipau","last":"Asadollahi","name":"Asadollahi, Mohammad A.","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Rikke L.","key":"meyerpau","last":"Meyer","locid":"f1caa4f6-bc6e-459a-a976-8843c7ea7ff3","name":"Meyer, Rikke Louise","name_org":"Meyer, Rikke L.","orcid":"0000-0002-6485-5134","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Ayyoob","key":"arpanaeipau","last":"Arpanaei","name":"Arpanaei, Ayyoob","rank":4,"rolecode":"pau"}],"pmid":["29278732"],"pub":{"doi":"10.1016/j.ijpharm.2017.12.039","issn":["03785173","18733476"],"issn_org":["03785173"],"issue":"1-2","journal":"International Journal of Pharmaceutics","pages":"148-161","publisher":"Elsevier BV","publisher_org":"Elsevier B.V.","status":"p","title":"International Journal of Pharmaceutics","volume":"537"},"review":"Peer Reviewed","scoID":["2-s2.0-85039150281"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-ffd5eb32-d954-4dc3-9c2e-8745b849272d"],"src":["AU Aarhus University"],"title":"Loading of polymyxin B onto anionic mesoporous silica nanoparticles retains antibacterial activity and enhances biocompatibility","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-275325","year":"2018","yearsub":"2018"}
{"abstract":"Members of the candidate phylum Acetothermia are globally distributed and detected in various habitats. However, little is known about their physiology and ecological importance. In this study, an operational taxonomic unit belonging to Acetothermia was detected at high abundance in four full-scale anaerobic digesters by 16S rRNA gene amplicon sequencing. The first closed genome from this phylum was obtained by differential coverage binning of metagenomes and scaffolding with long nanopore reads. Genome annotation and metabolic reconstruction suggested an anaerobic chemoheterotrophic lifestyle in which the bacterium obtains energy and carbon via fermentation of peptides, amino acids, and simple sugars to acetate, formate, and hydrogen. The morphology was unusual and composed of a central rod-shaped cell with bipolar prosthecae as revealed by fluorescence in situ hybridization combined with confocal laser scanning microscopy, Raman microspectroscopy, and atomic force microscopy. We hypothesize that these prosthecae allow for increased nutrient uptake by greatly expanding the cell surface area, providing a competitive advantage under nutrient-limited conditions.","author_count":10,"contributors":["Hao, Liping","McIlroy, Simon Jon","Kirkegaard, Rasmus Hansen","Karst, Søren Michael","Warnakulasuriya, Eustace Yrosh Fernando","Aslan, Hüsnü","Meyer, Rikke Louise","Albertsen, Mads","Nielsen, Per Halkjær","Dueholm, Morten Simonsen"],"cuid":["S02-098.50-009939"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Nielsen, Per Halkjær"],"keyword":["Bacteria","GENUS"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"novel prosthecate bacteria from the candidate phylum acetothermia","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41396-018-0187-9","version":"Published Version"},"funding_acknowledgement":["Acknowledgements This study was supported by Innovation Fund Denmark (NomiGas, grant 1305-00018B), MiDAS, Obelske Family Foundation, Villum Foundation, and Aalborg University. The AFM equipment and its application by Hüsnü Aslan were partially funded by the Carlsberg Foundation. We thank Kirsten Nørgaard and Lisbet Adrian for providing samples and physico-chemical data from the plants, and Maria Chuvochina, Aharon Oren, and Philip Hugenholtz for their assistance with the taxonomic proposals and naming etymology. The LABGeM (CEA/IG/Genoscope & CNRS UMR8030) and the France Génomique National infrastructure (funded as part of Investissement d’avenir program managed by Agence Nationale pour la Recherche, contract ANR-10-INBS-09) are acknowledged for support within the MicroScope annotation platform."],"id":"S02-098.50-009939","identifier":[{"id":"PMC6092417","type":"pmcid"},{"id":"85048159110","type":"scopus"},{"id":"29884828","type":"pmid"}],"ids":["aau-cf34d12b-a693-4161-a8fb-61b3afa46802","au-f7d4ca69-e3da-45af-bd2e-bdb8314eab63"],"keyword":["Genus","bacteria"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-DD92B9C36943818F76870E9E9E46E3B6"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.au.dk/ws/files/141592043/s41396_018_0187_9.pdf","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/294252789/s41396_018_0187_9.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41396-018-0187-9","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience, Section for Bioscience and Engineering"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Interdisciplinary Nanoscience Center, Interdisciplinary Nanoscience Center - INANO-Bioscience, iNANO-huset"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Liping","key":"haopau","last":"Hao","locid":"6c51d5ec-6477-4465-b266-40665aaaf50a","name":"Hao, Liping","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Simon Jon","key":"mcilroypau","last":"McIlroy","locid":"9309e11f-d9f7-4ef8-9bfe-182dd6435712","name":"McIlroy, Simon Jon","orcid":"0000-0003-3749-8730","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rasmus Hansen","key":"kirkegaardpau","last":"Kirkegaard","locid":"d5c8fdb2-a72d-47fa-b22a-5647cef23c40","name":"Kirkegaard, Rasmus Hansen","orcid":"0000-0003-3349-3617","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren Michael","key":"karstpau","last":"Karst","locid":"73f48fd9-cb58-4023-ab8a-b4f734cf7bcb","name":"Karst, Søren Michael","orcid":"0000-0002-0233-160X","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Warnakulasuriya Eustace Yrosh","key":"fernandopau","last":"Fernando","locid":"c22a861f-697d-46d2-ba5e-7820ab34d3e0","name":"Warnakulasuriya, Eustace Yrosh Fernando","name_org":"Fernando, Warnakulasuriya Eustace Yrosh","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Hüsnü","key":"aslanpau","last":"Aslan","locid":"05e8885e-db36-4f96-8ecf-5263c578def8","name":"Aslan, Hüsnü","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Rikke Louise","key":"meyerpau","last":"Meyer","locid":"f1caa4f6-bc6e-459a-a976-8843c7ea7ff3","name":"Meyer, Rikke Louise","orcid":"0000-0002-6485-5134","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mads","key":"albertsenpau","last":"Albertsen","locid":"6c728ec9-5a0d-40c7-b3f3-1741c6e01ccc","name":"Albertsen, Mads","orcid":"0000-0002-6151-190X","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Per Halkjær","key":"nielsenpau","last":"Nielsen","locid":"8321dd0d-5e0c-4334-81a7-ece0b4b66f4c","name":"Nielsen, Per Halkjær","orcid":"0000-0002-6402-1877","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Morten Simonsen","key":"dueholmpau","last":"Dueholm","locid":"0824b5d0-8995-42b9-9df4-6e9996430c39","name":"Dueholm, Morten Simonsen","orcid":"0000-0003-4135-2670","rank":10,"rolecode":"pau"}],"pmid":["29884828"],"pub":{"doi":"10.1038/s41396-018-0187-9","issn":["17517362","17517370"],"issn_org":["17517362"],"issue":"9","journal":"ISME Journal","pages":"2225-2237","publisher":"Oxford University Press","status":"p","title":"ISME Journal","volume":"12"},"review":"Peer Reviewed","scoID":["2-s2.0-85048159110"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["aau-cf34d12b-a693-4161-a8fb-61b3afa46802","au-f7d4ca69-e3da-45af-bd2e-bdb8314eab63"],"src":["AAU Aalborg University","AU Aarhus University"],"title":"Novel prosthecate bacteria from the candidate phylum Acetothermia","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-098.50-009939","year":"2018","yearsub":"2018"}
{"abstract":"Amyloids are typically associated with neurodegenerative diseases, but recent research demonstrates that several bacteria utilize functional amyloid fibrils to fortify the biofilm extracellular matrix and thereby resist antibiotic treatments. In Pseudomonas aeruginosa, these fibrils are composed predominantly of FapC, a protein with high sequence conservation among the genera. Previous studies established FapC as the major amyloid subunit, but its mechanism of fibril formation in P. aeruginosa remained largely unexplored. Here, we examine the FapC sequence in greater detail through a combination of bioinformatics and protein engineering, and we identify specific motifs that are implicated in amyloid formation. Sequence regions of high evolutionary conservation tend to coincide with regions of high amyloid propensity, and mutation of amyloidogenic motifs to a designed, non-amyloidogenic motif suppresses fibril formation in a pH-dependent manner. We establish the particular significance of the third repeat motif in promoting fibril formation and also demonstrate emergence of soluble oligomer species early in the aggregation pathway. The insights reported here expand our understanding of the mechanism of amyloid polymerization in P. aeruginosa, laying the foundation for development of new amyloid inhibitors to combat recalcitrant biofilm infections.","author_count":9,"contributors":["Bleem, Alissa","Christiansen, Gunna","Madsen, Daniel Jhaf","Maric, Hans","Strømgaard, Kristian","Bryers, James D","Daggett, Valerie","Meyer, Rikke Louise","Otzen, Daniel E"],"cuid":["S02-100.00-030697"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","University of Washington"],"keyword":["Bacterial amyloid","Extracellular matrix","Protein aggregation","peptide microarray","protein sequence analysis"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"protein engineering reveals mechanisms of functional amyloid formation in i pseudomonas aeruginosa i biofilms","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC6178955/pdf/nihms-991003.pdf","version":"Pre-print"},"id":"S02-100.00-030697","identifier":[{"id":"29964047","type":"pmid"},{"id":"PMC6178955","type":"pmcid"},{"id":"85049497406","type":"scopus"}],"ids":["au-fab62c4f-cce6-481d-bd23-1c938f99dbe1","ku-92bc4241-cf22-494e-9e77-78bc9b6cd3f9"],"keyword":["bacterial amyloid","extracellular matrix","peptide microarray","protein aggregation","protein sequence analysis"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-816469AE9D35940CCB4F5E3F68CB3BA9"],"oa_link":[{"access":"oa","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC6178955/pdf/nihms-991003.pdf","version":"Pre-print"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","country":"us","key":"university of washington","loc":["United States","America, North","OECD"],"name":"University of Washington","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Biomedicine, Department of Biomedicine - Medical Microbiology and Immunology","Aarhus University, Health, Department of Biomedicine, Department of Biomedicine - Research and Education, Bartholin Building"],"nora_code":"DI-U-AU","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Drug Design and Pharmacology, Medicinal Chemistry Research"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Alissa","key":"bleempau","last":"Bleem","name":"Bleem, Alissa","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Gunna","key":"christiansenpau","last":"Christiansen","locid":"64bd6216-e754-4f79-b494-6da91e9e0207","name":"Christiansen, Gunna","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Daniel J","key":"madsenpau","last":"Madsen","locid":"4bfd282d-4a39-4e4f-b3de-9c5eea4f8b98","name":"Madsen, Daniel Jhaf","name_org":"Madsen, Daniel J","rank":3,"rolecode":"pau"},{"affno":"3","first":"Hans","key":"maricpau","last":"Maric","locid":"00d57fbd-f601-4802-92bf-3b0a7d2687fa","name":"Maric, Hans-Michael","name_org":"Maric, Hans","rank":4,"rolecode":"pau"},{"affno":"3","first":"Kristian","key":"strømgaardpau","last":"Strømgaard","locid":"78f1a438-9c1e-4795-bf55-b266b5d2cde4","name":"Strømgaard, Kristian","orcid":"0000-0003-2206-4737","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"James D","key":"bryerspau","last":"Bryers","name":"Bryers, James D","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Valerie","key":"daggettpau","last":"Daggett","name":"Daggett, Valerie","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Rikke L","key":"meyerpau","last":"Meyer","locid":"f1caa4f6-bc6e-459a-a976-8843c7ea7ff3","name":"Meyer, Rikke Louise","name_org":"Meyer, Rikke L","orcid":"0000-0002-6485-5134","rank":8,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Daniel E","key":"otzenpau","last":"Otzen","locid":"0ec06c22-1f74-4dd2-a894-af30b6565766","name":"Otzen, Daniel E","rank":9,"rolecode":"pau"}],"pmid":["29964047"],"pub":{"doi":"10.1016/j.jmb.2018.06.043","issn":["00222836","10898638"],"issn_org":["00222836"],"issue":"20","journal":"Journal of Molecular Biology","pages":"3751-3763","publisher":"Academic Press","status":"p","title":"Journal of Molecular Biology","volume":"430"},"review":"Peer Reviewed","scoID":["2-s2.0-85049497406"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-fab62c4f-cce6-481d-bd23-1c938f99dbe1","ku-92bc4241-cf22-494e-9e77-78bc9b6cd3f9"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Protein Engineering Reveals Mechanisms of Functional Amyloid Formation in <i>Pseudomonas aeruginosa</i> Biofilms","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-030697","year":"2018","yearsub":"2018"}
{"abstract":"Crystal violet staining is commonly used for quantification of biofilm formation, although it is highly toxic. Here we test safranin as a non-toxic replacement. Safranin staining provided similar results as crystal violet, but with higher reproducibility. We therefore recommend safranin staining for biofilm biomass quantification.","author_count":3,"contributors":["Andersen, Pernille Ommen","Zobek, Natalia","Meyer, Rikke Louise"],"cuid":["S01-000.00-135685"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Meyer, Rikke Louise"],"keyword":["Crystal violet","DNA","Safranin"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"quantification of biofilm biomass by staining non toxic safranin can replace the popular crystal violet","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85027420799","version":"Other Version"},"id":"S01-000.00-135685","identifier":[{"id":"85027420799","type":"scopus"},{"id":"000411779300016","type":"wos"},{"id":"28802722","type":"pmid"}],"ids":["au-0b3764bd-dcf7-4e7c-a295-e1483cad40fc"],"keyword":["Biofilm quantification","CV assay","Crystal violet","DNA","Safranin"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-03A47736479944BFEE14641834581713"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Interdisciplinary Nanoscience Center, Interdisciplinary Nanoscience Center - INANO-Bioscience, iNANO-huset"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Pernille","key":"ommenpau","last":"Ommen","locid":"58da0d0a-5fe3-4f73-a179-046c37fc0b70","name":"Andersen, Pernille Ommen","name_org":"Ommen, Pernille","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Natalia","key":"zobekpau","last":"Zobek","locid":"65d932aa-b4c6-4154-9d14-50d583d324e2","name":"Zobek, Natalia","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rikke Louise","key":"meyerpau","last":"Meyer","locid":"f1caa4f6-bc6e-459a-a976-8843c7ea7ff3","name":"Meyer, Rikke Louise","orcid":"0000-0002-6485-5134","rank":3,"rolecode":"pau"}],"pmid":["28802722"],"pub":{"doi":"10.1016/j.mimet.2017.08.003","issn":["01677012","18728359"],"issn_org":["01677012"],"journal":"Journal of Microbiological Methods","pages":"87-89","publisher":"Elsevier BV","publisher_org":"Elsevier B.V.","status":"p","title":"Journal of Microbiological Methods","volume":"141"},"review":"Peer Reviewed","scoID":["2-s2.0-85027420799"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-0b3764bd-dcf7-4e7c-a295-e1483cad40fc"],"src":["AU Aarhus University"],"title":"Quantification of biofilm biomass by staining : Non-toxic safranin can replace the popular crystal violet","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-135685","year":"2017","yearsub":"2017"}
{"abstract":"The bovine milk protein osteopontin (OPN) may be an efficient means to prevent bacterial adhesion to dental tissues and control biofilm formation. This study sought to determine to what extent OPN impacts adhesion forces and surface attachment of different bacterial strains involved in dental caries or medical device-related infections. It further investigated if OPN's effect on adhesion is caused by blocking the accessibility of glycoconjugates on bacterial surfaces. Bacterial adhesion was determined in a shear-controlled flow cell system in the presence of different concentrations of OPN, and interaction forces of single bacteria were quantified using single-cell force spectroscopy before and after OPN exposure. Moreover, the study investigated OPN's effect on the accessibility of cell surface glycoconjugates through fluorescence lectin-binding analysis. OPN strongly affected bacterial adhesion in a dose-dependent manner for all investigated species (Actinomyces naeslundii, Actinomyces viscosus, Lactobacillus paracasei subsp. paracasei, Staphylococcus epidermidis, Streptococcus mitis, and Streptococcus oralis). Likewise, adhesion forces decreased after OPN treatment. No effect of OPN on the lectin-accessibility to glycoconjugates was found. OPN reduces the adhesion and adhesion force/energy of a variety of bacteria and has a potential therapeutic use for biofilm control. OPN acts upon bacterial adhesion without blocking cell surface glycoconjugates.","author_count":6,"contributors":["Kristensen, Mathilde Frost","Zeng, Guanghong","Neu, T R","Meyer, Rikke Louise","Bælum, Vibeke","Schlafer, Sebastian"],"cuid":["S01-000.00-191381"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","Helmholtz Association of German Research Centres"],"keyword":["Journal Article"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"osteopontin adsorption to gram positive cells reduces adhesion forces and attachment to surfaces under flow","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1080/20002297.2017.1379826","version":"Published Version"},"id":"S01-000.00-191381","identifier":[{"id":"29081915","type":"pmid"},{"id":"85068048331","type":"scopus"},{"id":"PMC5646589","type":"pmcid"}],"ids":["au-6ccca2ba-c465-4bd7-8347-f5f5363a8385"],"keyword":["Journal Article"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-B99AA13D217AA2A2F292A9103A4E288B"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1080/20002297.2017.1379826","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Dentistry and Oral Health, Department of Dentistry and Oral Health - Dentistry","Aarhus University, Health, Department of Dentistry and Oral Health, Department of Dentistry and Oral Health - Section for Oral Ecology and Caries Control"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"de","key":"helmholtz association of german research centres","loc":["Germany","Europe, EU","OECD"],"name":"Helmholtz Association of German Research Centres","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"M F","key":"kristensenpau","last":"Kristensen","locid":"3db74fb4-c382-451d-bd24-abea0bc2092c","name":"Kristensen, Mathilde Frost","name_org":"Kristensen, M F","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"G","key":"zengpau","last":"Zeng","locid":"41d64164-8293-4f51-b1b8-96ac2ccc6db5","name":"Zeng, Guanghong","name_org":"Zeng, G","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"T R","key":"neupau","last":"Neu","name":"Neu, T R","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"R L","key":"meyerpau","last":"Meyer","locid":"f1caa4f6-bc6e-459a-a976-8843c7ea7ff3","name":"Meyer, Rikke Louise","name_org":"Meyer, R L","orcid":"0000-0002-6485-5134","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"V","key":"baelumpau","last":"Baelum","locid":"fa28bbda-971e-4463-be61-3dcc358973b2","name":"Bælum, Vibeke","name_org":"Baelum, V","orcid":"0000-0002-2195-8053","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"S","key":"schlaferpau","last":"Schlafer","locid":"bcd4e1fe-3a80-4288-8b5f-d105f6f53982","name":"Schlafer, Sebastian","name_org":"Schlafer, S","orcid":"0000-0003-2463-1926","rank":6,"rolecode":"pau"}],"pmid":["29081915"],"pub":{"doi":"10.1080/20002297.2017.1379826","issn":["20002297"],"issue":"1","journal":"Journal of Oral Microbiology","paperid":"1379826","publisher":"Taylor and Francis Ltd.","status":"p","title":"Journal of Oral Microbiology","volume":"9"},"review":"Peer Reviewed","scoID":["2-s2.0-85068048331"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-6ccca2ba-c465-4bd7-8347-f5f5363a8385"],"src":["AU Aarhus University"],"title":"Osteopontin adsorption to Gram-positive cells reduces adhesion forces and attachment to surfaces under flow","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-191381","year":"2017","yearsub":"2017"}
{"abstract":"Representatives of the genus Bacillus are common milk contaminants that cause spoilage and flavor alterations of dairy products. Bacillus sp. FMQ74 was isolated from raw milk on a Danish dairy farm. To elucidate the genomic basis of this strain’s survival in the dairy industry, a high-quality draft genome was produced.","author_count":5,"contributors":["Okshevsky, Mira Ursula","Regina, Viduthalai R.","Marshall, Ian P.G.","Schreiber, Lars","Meyer, Rikke Louise"],"cuid":["S01-000.00-214706"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"draft genome sequence of bacillus sp fmq000000000074 a dairy contaminating isolate from raw milk","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1128/genomeA.01512-16","version":"Published Version"},"id":"S01-000.00-214706","identifier":[{"id":"85011903719","type":"scopus"},{"id":"28126940","type":"pmid"},{"id":"PMC5270699","type":"pmcid"}],"ids":["au-95d15521-bd85-477d-aff9-e605026342a7"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-E6BAB59D05686145D4F4A485B36A677B"],"oa_link":[{"access":"oa","license":"CC BY","type":"rem","url":"http://genomea.asm.org/content/5/4/e01512-16.full.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1128/genomeA.01512-16","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.au.dk/ws/files/133374577/e01512_16.full.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Interdisciplinary Nanoscience Center, Interdisciplinary Nanoscience Center - INANO-Bioscience, iNANO-huset"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Mira Ursula","key":"okshevskypau","last":"Okshevsky","locid":"70b6699e-a3fc-49e2-9052-08c02dfa5bae","name":"Okshevsky, Mira Ursula","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Viduthalai R.","key":"reginapau","last":"Regina","locid":"fa8a7634-7c35-4495-9bf4-78035ae9c80e","name":"Regina, Viduthalai R.","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ian","key":"marshallpau","last":"Marshall","locid":"25504f0f-4132-4611-8697-0019cedc5d5d","name":"Marshall, Ian P.G.","name_org":"Marshall, Ian","orcid":"0000-0001-9264-4687","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lars","key":"schreiberpau","last":"Schreiber","locid":"2460b94a-19ef-4377-9199-6da80017584e","name":"Schreiber, Lars","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rikke Louise","key":"meyerpau","last":"Meyer","locid":"f1caa4f6-bc6e-459a-a976-8843c7ea7ff3","name":"Meyer, Rikke Louise","orcid":"0000-0002-6485-5134","rank":5,"rolecode":"pau"}],"pmid":["28126940"],"pub":{"doi":"10.1128/genomea.01512-16","issn":["21698287"],"issue":"4","journal":"Genome Announcements","paperid":"e01512-16","publisher":"American Society for Microbiology","status":"p","title":"Genome Announcements","volume":"5"},"review":"Peer Reviewed","scoID":["2-s2.0-85011903719"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-95d15521-bd85-477d-aff9-e605026342a7"],"src":["AU Aarhus University"],"title":"Draft Genome Sequence of Bacillus sp. FMQ74, a Dairy-contaminating Isolate from Raw Milk","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-214706","year":"2017","yearsub":"2017"}
{"abstract":"Implant-associated infections caused by bacterial biofilms are difficult to treat. Surgical intervention is often necessary to cure the patient, as the antibiotic recalcitrance of biofilms renders them untreatable with conventional antibiotics. Intermittent hyperbaric oxygen treatment (HBOT) has been proposed as an adjuvant to conventional antibiotic treatment and it has been speculated that combining HBOT with antibiotics could improve treatment outcomes for biofilm infections. In this study we addressed whether HBOT could improve treatment outcomes of daptomycin and rifampicin combination therapy. The effect of HBOT on the treatment outcomes of daptomycin and rifampicin against implant-associated osteomyelitis was quantified in a murine model. In total, 80 mice were randomized into two groups receiving antibiotics, either alone or in combination with daily intermittent HBOT (304 kPa for 60 min) following injection of antibiotics. Treatment was initiated 11 days after animals were infected with Staphylococcus aureus and treatment duration was 14 days. We found that HBOT did not improve the cure rate and did not reduce the bacterial load on the implant surface or in the surrounding tissue. Cure rates of daptomycin + rifampicin were 40% in infected tibias and 75% for implants while cure rates for HBOT-daptomycin + rifampicin were 50% and 85%, respectively, which were not significantly higher (Fisher's exact test). While it is encouraging that the combination of daptomycin and rifampicin is very effective, our study demonstrates that this efficacy cannot be improved by adjuvant HBOT.","author_count":7,"contributors":["Jørgensen, Nis Pedersen","Hansen, Kasper","Andreasen, Caroline Marie","Pedersen, Michael","Fuursted, Kurt","Meyer, Rikke Louise","Petersen, Eskild"],"cuid":["S01-000.00-267996"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Journal Article"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CDR"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-GV-SSI","DI-HO-CDR","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"hyperbaric oxygen therapy is ineffective as an adjuvant to daptomycin with rifampicin treatment in a murine model of staphylococcus aureus in implant associated osteomyelitis","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85042506948","version":"Other Version"},"id":"S01-000.00-267996","identifier":[{"id":"PMC5488092","type":"pmcid"},{"id":"28441320","type":"pmid"},{"id":"85042506948","type":"scopus"}],"ids":["au-f3164d33-e478-43d4-b374-812cd1d9ef1e"],"keyword":["Journal Article"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-A858E011D9053ED1CC34BEB8536EFF01"],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Infectious Diseases"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital (AUH)"],"nora_code":"DI-HO-CDR","used":1},{"affno":"3","country":"dk","key":"ssi statens serum institut","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-SSI","l3nn":"SSI Statens Serum Institut","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SSI Statens Serum Institut","namevar":["Statens Serum Institut"],"nora_code":"DI-GV-SSI","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Nis Pedersen","key":"jørgensenpau","last":"Jørgensen","locid":"ac385492-f707-4053-bc6e-965ba8f60360","name":"Jørgensen, Nis Pedersen","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Kasper","key":"hansenpau","last":"Hansen","name":"Hansen, Kasper","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Caroline Marie","key":"andreasenpau","last":"Andreasen","name":"Andreasen, Caroline Marie","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Michael","key":"pedersenpau","last":"Pedersen","name":"Pedersen, Michael","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Kurt","key":"fuurstedpau","last":"Fuursted","name":"Fuursted, Kurt","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rikke L","key":"meyerpau","last":"Meyer","locid":"f1caa4f6-bc6e-459a-a976-8843c7ea7ff3","name":"Meyer, Rikke Louise","name_org":"Meyer, Rikke L","orcid":"0000-0002-6485-5134","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Eskild","key":"petersenpau","last":"Petersen","name":"Petersen, Eskild","rank":7,"rolecode":"pau"}],"pmid":["28441320"],"pub":{"doi":"10.3390/microorganisms5020021","issn":["20762607"],"issue":"2","journal":"Microorganisms","publisher":"MDPI AG","publisher_org":"M D P I AG","status":"p","title":"Microorganisms","volume":"5"},"review":"Peer Reviewed","scoID":["2-s2.0-85042506948"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Governmental Institutions","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Universities"],"PST":["Published"]},"sid":["au-f3164d33-e478-43d4-b374-812cd1d9ef1e"],"src":["AU Aarhus University"],"title":"Hyperbaric Oxygen Therapy is Ineffective as an Adjuvant to Daptomycin with Rifampicin Treatment in a Murine Model of Staphylococcus aureus in Implant-Associated Osteomyelitis","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-267996","year":"2017","yearsub":"2017"}
{"abstract":"In vitro biofilm models are the basis for most studies of biofilm biology because they enable high-throughput analyses without the expenditure of animals. But how do we ensure that what we learn from in vitro studies is relevant in vivo? Biofilms grown in standard laboratory media do not interact with host factors and are thus profoundly different from in vivo biofilms. We therefore need in vitro models that are as in vivo-like as possible. We investigated how the addition of divalent cations and human plasma to brain heart infusion broth affected biofilm formation by Staphylococcus aureus and Staphylococcus epidermidis. We quantified the biofilm biomass and mechanical properties, imaged the 3D structure, and quantified antibiotic penetration and susceptibility. We also determined how the choice of plasma stabilizer affected biofilm growth and viability. Human plasma stimulated biofilm formation > 100 fold in different S. aureus strains, and increasing the calcium and magnesium concentration to physiological levels further doubled biofilm formation for MRSA. When grown in plasma, S. aureus biofilms consisted of fibrinogen-coated cell clusters interspersed in a matrix of fibrin fibers. This was in stark contrast to the homogenous biofilms formed in the laboratory media. While vancomycin susceptibility was similar for all biofilms, daptomycin more effectively eradicated biofilms grown in plasma. S. epidermidis biofilms were also strongly affected by human plasma. Strains that did not produce polysaccharides could not form biofilms in the absence of plasma, while in the presence of plasma, the structure of polysaccharide-producers and non-producers were indistinguishable. Extracellular polysaccharides may thus be of little consequence to S. epidermidis biofilms in vivo. Access to host factors is critical for the biofilm phenotype of both coagulase-positive and -negative staphylococci, and we urge that biofilms are routinely studied under in vivo-like conditions.","author_count":1,"contributors":["Meyer, Rikke Louise"],"cuid":["S01-000.00-273376"],"event":{"end":"2017-09-22","place":"Amsterdam, nl","start":"2017-09-19","title":"Eurobiofilms 2017","year":"2017"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"how can in vitro models best reflect in vivo staphylococcus biofilms","src":["au"],"src-code":["DI-U-AU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-273376","ids":["au-fc7ec0a7-397f-4f08-b260-5a8bd387904f"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-1F0D6000DEBD90264971AF1191CAD85E"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Interdisciplinary Nanoscience Center, Interdisciplinary Nanoscience Center - INANO-Bioscience, iNANO-huset"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Rikke Louise","key":"meyerpau","last":"Meyer","locid":"f1caa4f6-bc6e-459a-a976-8843c7ea7ff3","name":"Meyer, Rikke Louise","orcid":"0000-0002-6485-5134","rank":1,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-fc7ec0a7-397f-4f08-b260-5a8bd387904f"],"src":["AU Aarhus University"],"title":"How can in vitro models best reflect in vivo Staphylococcus biofilms?","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-273376","year":"2017","yearsub":"2017"}
{"abstract":"Biofilms are widespread in nature and constitute an important strategy implemented by microorganisms to survive in sometimes harsh environmental conditions. They can be beneficial or have a negative impact particularly when formed in industrial settings or on medical devices. As such, research into the formation and elimination of biofilms is important for many disciplines. Several new methodologies have been recently developed for, or adapted to, biofilm studies that have contributed to deeper knowledge on biofilm physiology, structure and composition. In this review, traditional and cutting-edge methods to study biofilm biomass, viability, structure, composition and physiology are addressed. Moreover, as there is a lack of consensus among the diversity of techniques used to grow and study biofilms. This review intends to remedy this, by giving a critical perspective, highlighting the advantages and limitations of several methods. Accordingly, this review aims at helping scientists in finding the most appropriate and up-to-date methods to study their biofilms.","author_count":21,"contributors":["Azeredo, Joana","Azevedo, Nuno F","Briandet, Romain","Cerca, Nuno","Coenye, Tom","Costa, Ana Rita","Desvaux, Mickaël","Di Bonaventura, Giovanni","Hébraud, Michel","Jaglic, Zoran","Kačániová, Miroslava","Knøchel, Susanne","Lourenço, Anália","Mergulhão, Filipe","Meyer, Rikke Louise","Nychas, George","Simões, Manuel","Tresse, Odile","Sternberg, Claus"],"cuid":["S03-095.14-014275"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"continent":["Europe, EU","OECD"],"country":["Belgium","Czechia","France","Greece","Italy","Portugal","Slovakia","Spain"],"glorg":["Agricultural University of Athens","All Global Affiliations","Czech Academy of Agricultural Sciences","Gabriele d'Annunzio University","Ghent University","INRAE","Slovak University of Agriculture in Nitra","University of Minho","University of Porto","University of Vigo","Université Paris-Saclay"],"keyword":["Biofilm data analysis","Biofilm formation","Biofilm formation devices","Biofilm measurement","Biofilm omics"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-DTU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"critical review on biofilm methods","src":["au","dtu","ku"],"src-code":["DI-U-AU","DI-U-DTU","DI-U-KU"],"type":"djr","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1080/1040841X.2016.1208146","version":"Published Version"},"id":"S03-095.14-014275","identifier":[{"id":"27868469","type":"pmid"},{"id":"85014963888","type":"scopus"}],"ids":["au-17700b93-2a6f-487f-8f61-5b37185785c9","dtu-76e6cdb3-2c33-4e1a-9f4a-f4376f662101","ku-35fca351-752a-481a-8859-4f1ccda58bfb"],"keyword":["Biofilm formation","biofilm data analysis","biofilm formation devices","biofilm measurement","biofilm omics"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-6-63B990A6F45B344B62884FD0B26C8306"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1080/1040841X.2016.1208146","version":"Published Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/132794526/Critical_review_on_biofilm_methods.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/170213611/Critical_review_on_biofilm_methods.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2016"},"org":[{"affno":"1","country":"pt","key":"university of minho","loc":["Portugal","Europe, EU","OECD"],"name":"University of Minho","used":1},{"affno":"2","country":"pt","key":"university of porto","loc":["Portugal","Europe, EU",