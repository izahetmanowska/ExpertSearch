":"pau"},{"affno":"1","corresponding":null,"first":"Guanghong","key":"zengpau","last":"Zeng","locid":"41d64164-8293-4f51-b1b8-96ac2ccc6db5","name":"Zeng, Guanghong","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Kasper","key":"ambypau","last":"Amby","name":"Amby, Kasper","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Nis Pedersen","key":"jørgensenpau","last":"Jørgensen","locid":"ac385492-f707-4053-bc6e-965ba8f60360","name":"Jørgensen, Nis Pedersen","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rikke Louise","key":"meyerpau","last":"Meyer","locid":"f1caa4f6-bc6e-459a-a976-8843c7ea7ff3","name":"Meyer, Rikke Louise","orcid":"0000-0002-6485-5134","rank":6,"rolecode":"pau"}],"pub":{"issn":["01677012","18728359"],"issn_org":["01677012"],"journal":"Journal of Microbiological Methods","publisher":"Elsevier BV","publisher_org":"Elsevier B.V.","status":"s","title":"Journal of Microbiological Methods"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Submitted"]},"sid":["au-634f5d55-2f39-4bc8-96d9-c89647f48bd8"],"src":["AU Aarhus University"],"title":"Should standard <i>in vitro</i> models of <i>Staphylococcus aureus</i> biofilms include host plasma?","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-186044","year":"2020","yearsub":"2020"}
{"abstract":"Staphylococcus aureus is a human pathogen that can cause chronic and recurrent infections and is recalcitrant to antibiotic chemotherapy. This trait is partly attributed to its ability to form persister cells, which are subpopulations of cells that are tolerant to lethal concentrations of antibiotics. Recently, we showed that the phenol-soluble modulins (PSMs) expressed by S. aureus reduce persister cell formation. PSMs are a versatile group of toxins that, in addition to toxicity, form amyloid-like fibrils thought to support biofilm structures. Here, we examined individual or combined synthetic PSMα peptides and their equivalent amyloid-like fibrils on ciprofloxacin-selected S. aureus persister cells. We found that PSMα2 and the mixture of all four alpha peptides consistently were able to reduce persister frequency in all growth phases, and this activity was specifically linked to the presence of the soluble peptide as no effect was seen with fibrillated peptides. Persister reduction was particularly striking in a mutant that, due to mutations in the Krebs cycle, has enhanced ability to form persisters with PSMα4 and the combination of peptides being most effective. In biofilms, only the combination of peptides displayed persister reducing activity. Collectively, we report the individual contributions of PSMα peptides to persister cell reduction and that the combination of peptides generally was most effective. Strikingly, the fibrillated peptides lost activity and thus, if formed in bacterial cultures, they will be inactive against persister cells. Further studies will be needed to address the biological role of phenol-soluble modulins in reducing persister cells.","author_count":7,"contributors":["Baldry, Mara","Bojer, Martin S","Najarzadeh, Zahra","Vestergaard, Martin","Meyer, Rikke Louise","Otzen, Daniel E","Ingmer, Hanne"],"cuid":["S02-097.78-023153"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Agr","Biofilm","Fibrils","Persister cells","Phenol soluble modulins","Staphylococcus aureus"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"phenol soluble modulins modulate persister cell formation in i staphylococcus aureus i","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/fmicb.2020.573253","version":"Published Version"},"id":"S02-097.78-023153","identifier":[{"id":"33240231","type":"pmid"},{"id":"85096445611","type":"scopus"},{"id":"PMC7680730","type":"pmcid"}],"ids":["au-8fd35108-006e-488c-94e0-f751f050ac74","ku-8c50580f-01ce-4575-b617-c7078aa526c9"],"keyword":["PSM","Staphylococcus aureus","accessory gene regulator","agr","biofilm","fibrils","persister cells","phenol-soluble modulins"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-5BB69409EEFE15516C61CC80AEAB7DBC"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/252408803/fmicb_11_573253.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/fmicb.2020.573253","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Veterinary and Animal Sciences, Food Safety and Zoonoses"],"nora_code":"DI-U-K