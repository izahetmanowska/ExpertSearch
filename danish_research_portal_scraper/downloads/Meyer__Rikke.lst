-U-ALL","Private Research","Universities"],"PST":["Published"]},"sid":["au-277497fa-efab-4789-984c-0a0c22ae91e3"],"src":["AU Aarhus University"],"title":"A randomized controlled trial on the effect of multiple-enzyme treatment on dental plaque formation","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-824679","year":"2025","yearsub":"2025"}
{"abstract":"Staphylococcus epidermidis is the leading cause of implant-associated infections, where it forms biofilms that are highly effective at evading the immune system. Here we investigate to what extent the biofilm extracellular matrix components extracellular DNA (eDNA) and polysaccharide intercellular adhesin (PIA) protect S. epidermidis from phagocytosis by polymorphonuclear neutrophils (PMN). We visualised phagocytosis using time-lapse confocal laser scanning microscopy of PMN interacting with planktonic S. epidermidis and 24 h old biofilms formed by the wildtype strain or mutant strains lacking either eDNA or PIA. We also compared phagocytosis of 24 h vs. 6 h old biofilms. PMN easily moved around and phagocytised S. epidermidis that were adhered to a surface from a planktonic culture. In contrast, PMN quickly became immobilised when interacting with biofilms. Very few PMN were able to phagocytise young (6 h) and mature (24 h) biofilms, suggesting that the accumulation of matrix components quickly provides a protective effect. Biofilms lacking either eDNA or PIA were much less dense, and many more PMN were able to phagocytise bacteria in these biofilms. Our findings suggest that both eDNA and PIA contribute to the ability of S. epidermidis biofilms to resist phagocytosis.","author_count":4,"contributors":["Evans, Dominique Catherine","Mitkin, Alexander Alexandrovich","Rohde, Holger","Meyer, Rikke Louise"],"cuid":["S01-000.00-806171"],"filters":{"added":"2025-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"corresponding_author":["Meyer, Rikke Louise"],"country":["Germany"],"glorg":["All Global Affiliations","University of Hamburg"],"keyword":["Confocal microscopy","Extracellular matrix","Immune evasion"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"extracellular dna and polysaccharide intercellular adhesin protect staphylococcus epidermidis biofilms from phagocytosis by polymorphonuclear neutrophils","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.micres.2025.128176","version":"Published Version"},"id":"S01-000.00-806171","identifier":[{"id":"105002495656","type":"scopus"}],"ids":["au-33d18d0f-8861-437d-8abb-c3edbfb9f9c0"],"keyword":["Confocal microscopy","Extracellular matrix","Immune evasion"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-9ABF61744E2F1AA344CC7C7934B49146"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.micres.2025.128176","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Interdisciplinary Nanoscience Center, Interdisciplinary Nanoscience Center - INANO-Bioscience, iNANO-huset"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"de","key":"university of hamburg","loc":["Germany","Europe, EU","OECD"],"name":"University of Hamburg","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Dominique C.S.","key":"evanspau","last":"Evans","locid":"acb7dcc9-ffb2-44f4-8fb3-d4425be5f731","name":"Evans, Dominique Catherine","name_org":"Evans, Dominique C.S.","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Alexander A.","key":"mitkinpau","last":"Mitkin","locid":"e8d98ae8-db91-4fb5-a72f-87ba7fcced6d","name":"Mitkin, Alexander Alexandrovich","name_org":"Mitkin, Alexander A.","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Holger","key":"rohdepau","last":"Rohde","name":"Rohde, Holger","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rikke L.","key":"meyerpau","last":"Meyer","locid":"f1caa4f6-bc6e-459a-a976-8843c7ea7ff3","name":"Meyer, Rikke Louise","name_org":"Meyer, Rikke L.","orcid":"0000-0002-6485-5134","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.micres.2025.128176","issn":["09445013","16180623"],"issn_org":["09445013"],"journal":"Microbiological Research","paperid":"128176","publisher":"Elsevier GmbH","status":"p","title":"Microbiological Research","volume":"297"},"review":"Peer Reviewed","scoID":["2-s2.0-105002495656"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-33d18d0f-8861-437d-8abb-c3edbfb9f9c0"],"src":["AU Aarhus University"],"title":"Extracellular DNA and polysaccharide intercellular adhesin protect Staphylococcus epidermidis biofilms from phagocytosis by polymorphonuclear neutrophils","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-806171","year":"2025","yearsub":"2025"}
{"abstract":"Dental biofilms are heterogeneous structures with localized pH variations, possibly due to compositional differences in the extracellular polymeric matrix (EPS). Extracellular DNA (eDNA), a negatively charged important EPS component, may interact with positively charged protons, thereby retaining the acids within the biofilm and locally lowering the pH. The aims of this study were to develop a method for correlative imaging of biofilm pH and eDNA, and to investigate how biofilm age (2 or 4 days) and sucrose supplementation during growth (0%, 0.1%, or 4%) affect pH, eDNA volumes and the microbial composition of biofilms grown from salivary inocula. We successfully developed a combination of confocal-microscopy-based pH ratiometry and eDNA mapping using a fluorescent cell impermeable nucleic acid stain. The microbial biofilm composition was analysed by 16S rRNA sequencing. The effects of sucrose and age on biofilm pH and eDNA were estimated using linear regression with cluster-bootstrapped standard errors. Statistical analyses were performed in R v.4.4.1. Sucrose supplementation had a significant effect on biofilm pH, which was lowest in biofilms grown in the presence of 4% sucrose (p < 0.001), and on the microbial composition of the biofilms. 4% sucrose biofilms showed an increased abundance of Streptococcus salivarius and lactobacilli, while 0% and 0.1% sucrose biofilms were dominated by Streptococcus mitis/oralis and proteolytic species. Importantly, eDNA volumes in the biofilms increased with sucrose concentration, peaking in 4-day-old biofilms grown with 4% sucrose (p ≤ 0.01). Local biofilm pH was negatively correlated with the abundance of eDNA, which may suggest that eDNA contributes to localized areas of low pH by retaining protons. Alternatively, sucrose supplementation may drive both biofilm acidification and the secretion of eDNA. The interplay between eDNA and biofilm pH warrants further study.","author_count":5,"contributors":["Kristensen, Mathilde Frost","Schlafer, Sebastian","Meyer, Rikke Louise","Lund, Marie Braad","Evans, Dominique Catherine"],"cuid":["S01-000.00-815208"],"event":{"end":"2025-07-05","place":"Leeds, _","start":"2025-07-02","title":"International Congress of the Organisation for Caries Research (ORCA)","year":"2025"},"filters":{"added":"2025-08","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"correlative imaging of ph and extracellular dna in dental biofilms","src":["au"],"src-code":["DI-U-AU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-815208","ids":["au-0ec41a66-d53c-4936-af68-8efd9099654b"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-CC6089FA0F6758CCB0EA95F3AD5D01BE"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Dentistry and Oral Health, Department of Dentistry and Oral Health - Section for Oral Ecology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Mathilde Frost","key":"kristensenpau","last":"Kristensen","locid":"3db74fb4-c382-451d-bd24-abea0bc2092c","name":"Kristensen, Mathilde Frost","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Sebastian","key":"schlaferpau","last":"Schlafer","locid":"bcd4e1fe-3a80-4288-8b5f-d105f6f53982","name":"Schlafer, Sebastian","orcid":"0000-0003-2463-1926","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rikke Louise","key":"meyerpau","last":"Meyer","locid":"f1caa4f6-bc6e-459a-a976-8843c7ea7ff3","name":"Meyer, Rikke Louise","orcid":"0000-0002-6485-5134","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Marie Braad","key":"lundpau","last":"Lund","locid":"ccca6a51-5b47-45b6-969c-b0c5ea95100c","name":"Lund, Marie Braad","orcid":"0000-0003-1543-1009","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Dominique Catherine","key":"evanspau","last":"Evans","locid":"acb7dcc9-ffb2-44f4-8fb3-d4425be5f731","name":"Evans, Dominique Catherine","rank":5,"rolecode":"pau"}],"pub":{"issn":["00086568","1421976X"],"issn_org":["00086568"],"journal":"Caries Research","publisher":"S. Karger AG","status":"p","title":"Caries Research"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-0ec41a66-d53c-4936-af68-8efd9099654b"],"src":["AU Aarhus University"],"title":"Correlative imaging of pH and extracellular DNA in dental biofilms","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-815208","year":"2025","yearsub":"2025"}
{"abstract":"Arginine is a caries-preventive agent that contributes to biofilm pH homeostasis by promoting the growth and activity of alkali-generating bacteria. Recent in vitro studies suggest that arginine also decreases the biofilm matrix production, but this mechanism has not yet been clinically investigated. This randomized, placebo-controlled, triple-blind in situ trial investigated arginine's effect on the microbial composition, matrix architecture and pH of biofilms from caries-active patients (N=10). Biofilms were grown on intraoral splints for four days, during which sucrose (5 min) and subsequent arginine/placebo (ARG/NoARG) treatment (30 min) were applied 3x/day (split-mouth design). After growth, the pH response of paired ARG and NoARG biofilms to a sucrose challenge (4% w/v) was monitored by pH ratiometry. Differences in microbial composition and matrix architecture were investigated by 16S rRNA gene sequencing and fluorescence-lectin-binding-analysis, respectively. Linear mixed-effects models/Wilcoxon signed-rank tests were used for statistical analyses. Arginine significantly mitigated biofilm pH drops after 10 min (ARG: 6.05, 95%CI: 5.77-6.34; NoARG: 5.87, 95%CI: 5.58-6.15; P=0.014) and 35 min (ARG: 5.84, 95%CI: 5.56-6.13; NoARG: 5.68, 95%CI: 5.40-5.97; P=0.037) of sucrose challenge. The abundance of Streptococcus mitis/oralis, which typically exhibit low arginolytic activity, was significantly decreased in ARG biofilms (19.6%±15.2%SD vs. 25.0%±12.9%SD; P<0.05). In contrast, the abundance of streptococci with high arginolytic potential (Streptococcus gordonii, Streptococcus parasanguinis) was increased, but differences were not significant. Arginine significantly reduced the production of fucose-containing matrix carbohydrates (relative to microbial volume) across all biofilm layers (ARG: 0.61, 95%CI: 0.23-0.99; NoARG: 0.88, 95%CI: 0.49-1.26; P=0.009), and of galactose-containing carbohydrates at the biofilm base (ARG: 0.36, 95%CI: 0.18-0.54; NoARG: 0.59, 95%CI: 0.41-0.77; P<0.001). In summary, arginine modulates the virulence of biofilms from caries-active patients through multiple mechanisms, including a reduction in carbohydrate matrix components.","author_count":7,"contributors":["Chokyu Del Rey, Yumi","Rikvold, Pernille","Lund, Marie Braad","Raittio, Eero","Schramm, Andreas","Meyer, Rikke Louise","Schlafer, Sebastian"],"cuid":["S01-000.00-816829"],"event":{"end":"2025-07-05","place":"Leeds, gb","start":"2025-07-01","title":"ORCA: 72nd Congress of the European Organization for Caries Research","year":"2025"},"filters":{"added":"2025-08","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"arginine mitigates ph drops and modulates the composition and architecture of biofilms from caries active patients","src":["au"],"src-code":["DI-U-AU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-816829","ids":["au-e2ada8c9-a55e-4a29-979a-60a3f4bd9d7c"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-907BB6E91EE688CA5E25FF3634DD38CC"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Dentistry and Oral Health"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Yumi","key":"chokyudelreypau","last":"Chokyu Del Rey","locid":"22d33fad-da2e-4a05-8e4a-d39df9284c88","name":"Chokyu Del Rey, Yumi","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Pernille","key":"rikvoldpau","last":"Rikvold","locid":"d5ef43bc-479a-4d2b-916a-7028a4618e80","name":"Rikvold, Pernille","orcid":"0000-0002-2431-6937","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Marie Braad","key":"lundpau","last":"Lund","locid":"ccca6a51-5b47-45b6-969c-b0c5ea95100c","name":"Lund, Marie Braad","orcid":"0000-0003-1543-1009","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Eero","key":"raittiopau","last":"Raittio","locid":"c08351bf-55fc-4082-9e6e-cd59c6a6b513","name":"Raittio, Eero","orcid":"0000-0002-9258-9355","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Andreas","key":"schrammpau","last":"Schramm","locid":"25080de3-b60e-46b4-a606-d99f1ec089e5","name":"Schramm, Andreas","orcid":"0000-0002-7614-9616","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rikke Louise","key":"meyerpau","last":"Meyer","locid":"f1caa4f6-bc6e-459a-a976-8843c7ea7ff3","name":"Meyer, Rikke Louise","orcid":"0000-0002-6485-5134","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Sebastian","key":"schlaferpau","last":"Schlafer","locid":"bcd4e1fe-3a80-4288-8b5f-d105f6f53982","name":"Schlafer, Sebastian","orcid":"0000-0003-2463-1926","rank":7,"rolecode":"pau"}],"pub":{"status":"i"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["In Press"]},"sid":["au-e2ada8c9-a55e-4a29-979a-60a3f4bd9d7c"],"src":["AU Aarhus University"],"title":"Arginine mitigates pH drops and modulates the composition and architecture of biofilms from caries-active patients","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-816829","year":"2025","yearsub":"2025"}
{"abstract":"INTRODUCTION: Coaggregation may reduce the abundance of bacteria in physiological fluids, such as saliva, as aggregated bacteria are cleared more easily than planktonic cells. This study aimed to identify Lactobacillus strains that coaggregate with oral pathogens with the perspective of using this approach to improve oral health. MATERIAL AND METHODS: Coaggregation of 719 postbiotic Lactobacillus strains with target pathogens Fusobacterium nucleatum, Porphyromonas gingivalis, and Prevotella intermedia was quantified by absorbance. Coaggregation efficacy of selected strains with clinical isolates and in the presence of other salivary bacteria was determined by flow cytometry. Brightfield and confocal microscopy were applied to characterize the size and structure of coaggregates. Pangenome analysis was used to identify genomic regions potentially involved in the coaggregation activity. RESULTS: Two strains, Lacticaseibacillus rhamnosus 1B06 and Lacticaseibacillus paracasei 8A12, coaggregated efficiently with all three target pathogens and clinical isolates of the same species even in the presence of other salivary bacteria. The coaggregation capability of the selected Lactobacillus strains was unique and could not be reproduced with other genetically similar lactic acid bacteria of the same species. CONCLUSION: Lactobacillus strains capable of coaggregating oral pathogens were identified as promising candidates for the development of new postbiotic ingredients for oral hygiene products.","author_count":9,"contributors":["Golletz, Patrick","Jensen, Sissel Damsbo","Collignon, Madeline","Hall, Charles","Khamas, Amanda Batoul","Møllebjerg, Andreas","Schlafer, Sebastian","Meyer, Rikke Louise","Tykwinska, Karolina"],"cuid":["S01-000.00-815192"],"filters":{"added":"2025-08","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","Europe, EU","OECD"],"corresponding_author":["Meyer, Rikke Louise","Tykwinska, Karolina"],"country":["Germany","United States"],"glorg":["All Global Affiliations","Novonesis North America Inc - US","Novozymes GmbH - Germany"],"keyword":["Fusobacterium nucleatum","Gingivitis","Halitosis","Lactobacillus","Oral health","Postbiotic","Screening"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"coaggregation of oral pathogens by postbiotic lactobacilli","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1080/20002297.2025.2508483","version":"Published Version"},"id":"S01-000.00-815192","identifier":[{"id":"105006889662","type":"scopus"},{"id":"PMC12123943","type":"pmcid"},{"id":"40453788","type":"pmid"}],"ids":["au-0c6a3334-a50c-4efe-8fb4-933d178ab0e3"],"keyword":["Fusobacterium nucleatum","Porhyromonas gingivalis","Postbiotic","gingivitis","halitosis","lactobacillus","malodor","oral health","screening"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-F883F2647154497A58D6024636FABA76"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1080/20002297.2025.2508483","version":"Published Version"}],"org":[{"affno":"1","country":"de","key":"novozymes gmbh germany","loc":["Germany","Europe, EU","OECD"],"name":"Novozymes GmbH - Germany","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Interdisciplinary Nanoscience Center"],"nora_code":"DI-U-AU","used":1},{"affno":"3","country":"us","key":"novonesis north america inc us","loc":["United States","America, North","OECD"],"name":"Novonesis North America Inc - US","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Patrick","key":"golletzpau","last":"Golletz","name":"Golletz, Patrick","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Sissel Damsbo","key":"jensenpau","last":"Jensen","locid":"c74537e4-4d39-4c57-bb4c-1afba5c1b494","name":"Jensen, Sissel Damsbo","orcid":"0009-0002-7619-5388","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Madeline","key":"collignonpau","last":"Collignon","name":"Collignon, Madeline","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Charles","key":"hallpau","last":"Hall","name":"Hall, Charles","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Amanda Batoul","key":"khamaspau","last":"Khamas","locid":"2543fe5d-ede4-44e0-8a06-17ad5ce8fc37","name":"Khamas, Amanda Batoul","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Andreas","key":"møllebjergpau","last":"Møllebjerg","locid":"4176d27b-9e84-42e2-9357-cd93796c3046","name":"Møllebjerg, Andreas","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Sebastian","key":"schlaferpau","last":"Schlafer","locid":"bcd4e1fe-3a80-4288-8b5f-d105f6f53982","name":"Schlafer, Sebastian","orcid":"0000-0003-2463-1926","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Rikke Louise","key":"meyerpau","last":"Meyer","locid":"f1caa4f6-bc6e-459a-a976-8843c7ea7ff3","name":"Meyer, Rikke Louise","orcid":"0000-0002-6485-5134","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Karolina","key":"tykwinskapau","last":"Tykwinska","name":"Tykwinska, Karolina","rank":9,"rolecode":"pau"}],"pmid":["40453788"],"pub":{"doi":"10.1080/20002297.2025.2508483","issn":["20002297"],"issue":"1","journal":"Journal of Oral Microbiology","paperid":"2508483","publisher":"Taylor and Francis Ltd.","status":"p","title":"Journal of Oral Microbiology","volume":"17"},"review":"Peer Reviewed","scoID":["2-s2.0-105006889662"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-0c6a3334-a50c-4efe-8fb4-933d178ab0e3"],"src":["AU Aarhus University"],"title":"Coaggregation of oral pathogens by postbiotic lactobacilli","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-815192","year":"2025","yearsub":"2025"}
{"abstract":"Background and aim: Non-biocidal matrix-degrading enzymes may reduce dental biofilm formation and thereby contribute to caries control without negatively impacting the microbial homeostasis in the mouth. This randomized controlled trial (RCT) studied the effect of treatment with lozenges containing the three matrix-degrading enzymes mutanase, beta-glucanase and DNase on microbial plaque composition in healthy adults. Methods: The RCT was a triple-blind prospective study with a 14-day intervention period, three parallel arms (Placebo, Active 1 and Active 2) and random allocation (80 participants). Enzyme activity in the Active 2 group was threefold higher than in the Active 1 group. Participants refrained from self-performed oral hygiene throughout the intervention period, after which pooled approximal plaque samples were collected. The microbial plaque composition was determined by 16S rRNA gene sequencing. Additionally, the amount of red autofluorescent plaque was determined planimetrically after 1, 7 and 14 days of intervention. Results were analyzed using a two-way analysis of variance model. Results: Plaque samples harbored a diverse microbial community with high relative abundances of Streptococcus (12.43±7.31 SD), Leptotrichia (9.54%±5.87SD) and Actinomyces spp. (8.66%±5.05SD). A nonsignificant trend towards lower species richness, and hence delayed biofilm formation, was observed in both Active groups. Enzyme treatment resulted in significantly lower amounts of red fluorescent plaque compared to placebo for the Active 2 group after 7 days of intervention (1.22%±1.31SD vs. 3.03%±3.29SD; p=0.02). For Active 1 (all time points) and Active 2 (day 1 and 14), enzyme treatment resulted in nonsignificant reductions. When data for all time points were pooled, significant reductions were observed for both Active 1 (p=0.03) and 2 (p=0.03). Conclusion: Multiple-enzyme treatment may delay de novo plaque formation in healthy individuals and thereby contribute to biofilm control.","author_count":9,"contributors":["Schlafer, Sebastian","K. Johnsen, Karina","Chokyu Del Rey, Yumi","Meyer, Rikke Louise","Skov Hansen, Lea Benedikte","Knap, Inge","Holz, Caterina","Jørgensen, Mette Rose","Rikvold, Pernille"],"cuid":["S01-000.00-815568"],"event":{"end":"2025-07-05","place":"Leeds, gb","start":"2025-07-01","title":"ORCA: 72nd Congress of the European Organization for Caries Research","year":"2025"},"filters":{"added":"2025-08","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Rikvold, Pernille","Schlafer, Sebastian"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-NOSI"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-PR-NOSI","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"a randomized controlled trial on the effect of multiple enzyme treatment on the microbial plaque composition","src":["au"],"src-code":["DI-U-AU"],"type":"dco","type-grp":["all","pub"]},"id":"S01-000.00-815568","ids":["au-3f0c5410-b974-4ca0-ad01-ffd0ca22295e"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-57199DBDABF0F5C82B38ABAA197E33AC"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Dentistry and Oral Health, Department of Dentistry and Oral Health - Section for Oral Ecology"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"novonesis","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-NOSI","l3nn":"Novonesis","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Novonesis","namevar":["Novonesis A/S"],"nora_code":"DI-PR-NOSI","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Sebastian","key":"schlaferpau","last":"Schlafer","locid":"bcd4e1fe-3a80-4288-8b5f-d105f6f53982","name":"Schlafer, Sebastian","orcid":"0000-0003-2463-1926","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Karina","key":"kjohnsenpau","last":"K. Johnsen","locid":"e6eea993-e93e-40a1-91a9-00475b587f63","name":"K. Johnsen, Karina","orcid":"0000-0002-9764-8481","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Yumi","key":"chokyudelreypau","last":"Chokyu Del Rey","locid":"22d33fad-da2e-4a05-8e4a-d39df9284c88","name":"Chokyu Del Rey, Yumi","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rikke Louise","key":"meyerpau","last":"Meyer","locid":"f1caa4f6-bc6e-459a-a976-8843c7ea7ff3","name":"Meyer, Rikke Louise","orcid":"0000-0002-6485-5134","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lea Benedikte","key":"skovhansenpau","last":"Skov Hansen","name":"Skov Hansen, Lea Benedikte","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Inge","key":"knappau","last":"Knap","name":"Knap, Inge","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Caterina","key":"holzpau","last":"Holz","name":"Holz, Caterina","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Mette Rose","key":"jørgensenpau","last":"Jørgensen","name":"Jørgensen, Mette Rose","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Pernille","key":"rikvoldpau","last":"Rikvold","locid":"d5ef43bc-479a-4d2b-916a-7028a4618e80","name":"Rikvold, Pernille","orcid":"0000-0002-2431-6937","rank":9,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Private Research","Universities"],"PST":["Published"]},"sid":["au-3f0c5410-b974-4ca0-ad01-ffd0ca22295e"],"src":["AU Aarhus University"],"title":"A randomized controlled trial on the effect of multiple-enzyme treatment on the microbial plaque composition","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-815568","year":"2025","yearsub":"2025"}
{"abstract":"Background and aim: Non-biocidal matrix-degrading enzymes may reduce dental biofilm formation and thereby contribute to caries control without negatively impacting the microbial homeostasis in the mouth. This randomized controlled trial (RCT) studied the effect of treatment with lozenges containing the three matrix-degrading enzymes mutanase, beta-glucanase and DNase on microbial plaque composition in healthy adults. Methods: The RCT was a triple-blind prospective study with a 14-day intervention period, three parallel arms (Placebo, Active 1 and Active 2) and random allocation (80 participants). Enzyme activity in the Active 2 group was threefold higher than in the Active 1 group. Participants refrained from self-performed oral hygiene throughout the intervention period, after which pooled approximal plaque samples were collected. The microbial plaque composition was determined by 16S rRNA gene sequencing. Additionally, the amount of red autofluorescent plaque was determined planimetrically after 1, 7 and 14 days of intervention. Results were analyzed using a two-way analysis of variance model. Results: Plaque samples harbored a diverse microbial community with high relative abundances of Streptococcus (12.43±7.31 SD), Leptotrichia (9.54%±5.87SD) and Actinomyces spp. (8.66%±5.05SD). A nonsignificant trend towards lower species richness, and hence delayed biofilm formation, was observed in both Active groups. Enzyme treatment resulted in significantly lower amounts of red fluorescent plaque compared to placebo for the Active 2 group after 7 days of intervention (1.22%±1.31SD vs. 3.03%±3.29SD; p=0.02). For Active 1 (all time points) and Active 2 (day 1 and 14), enzyme treatment resulted in nonsignificant reductions. When data for all time points were pooled, significant reductions were observed for both Active 1 (p=0.03) and 2 (p=0.03). Conclusion: Multiple-enzyme treatment may delay de novo plaque formation in healthy individuals and thereby contribute to biofilm control.","author_count":9,"contributors":["Schlafer, Sebastian","K. Johnsen, Karina","Chokyu Del Rey, Yumi","Meyer, Rikke Louise","Skov Hansen, Lea Benedikte","Knap, Inge","Holz, Caterina","Jørgensen, Mette Rose","Rikvold, Pernille"],"cuid":["S01-000.00-816478"],"filters":{"added":"2025-08","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-NOSI"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-PR-NOSI","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"a randomized controlled trial on the effect of multiple enzyme treatment on the microbial plaque composition","src":["au"],"src-code":["DI-U-AU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-816478","ids":["au-b4e77683-2654-4390-8bc8-4210bdc8da83"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-10C8CC83D45BDE04988498014479EA59"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Dentistry and Oral Health, Department of Dentistry and Oral Health - Section for Oral Ecology"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"novonesis","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-NOSI","l3nn":"Novonesis","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Novonesis","namevar":["Novonesis A/S"],"nora_code":"DI-PR-NOSI","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Sebastian","key":"schlaferpau","last":"Schlafer","locid":"bcd4e1fe-3a80-4288-8b5f-d105f6f53982","name":"Schlafer, Sebastian","orcid":"0000-0003-2463-1926","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Karina","key":"kjohnsenpau","last":"K. Johnsen","locid":"e6eea993-e93e-40a1-91a9-00475b587f63","name":"K. Johnsen, Karina","orcid":"0000-0002-9764-8481","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Yumi","key":"chokyudelreypau","last":"Chokyu Del Rey","locid":"22d33fad-da2e-4a05-8e4a-d39df9284c88","name":"Chokyu Del Rey, Yumi","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rikke Louise","key":"meyerpau","last":"Meyer","locid":"f1caa4f6-bc6e-459a-a976-8843c7ea7ff3","name":"Meyer, Rikke Louise","orcid":"0000-0002-6485-5134","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lea Benedikte","key":"skovhansenpau","last":"Skov Hansen","name":"Skov Hansen, Lea Benedikte","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Inge","key":"knappau","last":"Knap","name":"Knap, Inge","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Caterina","key":"holzpau","last":"Holz","name":"Holz, Caterina","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Mette Rose","key":"jørgensenpau","last":"Jørgensen","name":"Jørgensen, Mette Rose","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Pernille","key":"rikvoldpau","last":"Rikvold","locid":"d5ef43bc-479a-4d2b-916a-7028a4618e80","name":"Rikvold, Pernille","orcid":"0000-0002-2431-6937","rank":9,"rolecode":"pau"}],"pub":{"issn":["00086568","1421976X"],"issn_org":["00086568"],"journal":"Caries Research","publisher":"S. Karger AG","status":"p","title":"Caries Research","volume":"59"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Private Research","Universities"],"PST":["Published"]},"sid":["au-b4e77683-2654-4390-8bc8-4210bdc8da83"],"src":["AU Aarhus University"],"title":"A randomized controlled trial on the effect of multiple-enzyme treatment on the microbial plaque composition","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-816478","year":"2025","yearsub":"2025"}
{"abstract":"Many bacteria form biofilms to protect themselves from predators or stressful environmental conditions. In the biofilm, bacteria are embedded in a protective extracellular matrix composed of polysaccharides, proteins and extracellular DNA (eDNA). eDNA most often is released from lysed bacteria or host mammalian cells, and it is the only matrix component most biofilms appear to have in common. However, little is known about the form DNA takes in the extracellular space, and how different non-canonical DNA structures such as Z-DNA or G-quadruplexes might contribute to its function in the biofilm. The aim of this study was to determine if non-canonical DNA structures form in eDNA-rich staphylococcal biofilms, and if these structures protect the biofilm from degradation by nucleases. We grew Staphylococcus epidermidis biofilms in laboratory media supplemented with hemin and NaCl to stabilize secondary DNA structures and visualized their location by immunolabelling and fluorescence microscopy. We furthermore visualized the macroscopic biofilm structure by optical coherence tomography. We developed assays to quantify degradation of Z-DNA and G-quadruplex DNA oligos by different nucleases, and subsequently investigated how these enzymes affected eDNA in the biofilms. Z-DNA and G-quadruplex DNA were abundant in the biofilm matrix, and were often present in a web-like structures. In vitro, the structures did not form in the absence of NaCl or mechanical shaking during biofilm growth, or in bacterial strains deficient in eDNA or exopolysaccharide production. We thus infer that eDNA and polysaccharides interact, leading to non-canonical DNA structures under mechanical stress when stabilized by salt. We also confirmed that G-quadruplex DNA and Z-DNA was present in biofilms from infected implants in a murine implant-associated osteomyelitis model. Mammalian DNase I lacked activity against Z-DNA and G-quadruplex DNA, while Micrococcal nuclease could degrade G-quadruplex DNA and S1 Aspergillus nuclease could degrade Z-DNA. Micrococcal nuclease, which originates from Staphylococcus aureus, may thus be key for dispersal of biofilm in staphylococci. In addition to its structural role, we show for the first time that the eDNA in biofilms forms a DNAzyme with peroxidase-like activity in the presence of hemin. While peroxidases are part of host defenses against pathogens, we now show that biofilms can possess intrinsic peroxidase activity in the extracellular matrix.","author_count":8,"contributors":["Minero, Gabriel Antonio Salvador","Møllebjerg, Andreas","Thiesen, Celine","Johansen, Mikkel Illemann","Jørgensen, Nis Pedersen","Birkedal, Victoria","Otzen, Daniel E","Meyer, Rikke Louise"],"cuid":["S01-000.00-717359"],"filters":{"added":"2024-03","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Meyer, Rikke Louise"],"keyword":["Animals","Biofilms","DNA","Deoxyribonuclease I metabolism","G Quadruplexes","Hemin","Mammals genetics","Mice","Peroxidase metabolism","Polysaccharides","Sodium Chloride","Staphylococcus genetics"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"extracellular g quadruplexes and z dna protect biofilms from dnase i and g quadruplexes form a dnazyme with peroxidase activity","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1093/nar/gkae034","version":"Published Version"},"id":"S01-000.00-717359","identifier":[{"id":"PMC10939358","type":"pmcid"},{"id":"38296834","type":"pmid"},{"id":"85186411369","type":"scopus"}],"ids":["au-2e05dc3a-ae94-4aec-920a-9ee888ae65c0"],"keyword":["Animals","Biofilms","DNA","DNA, Bacterial/metabolism","DNA, Catalytic/metabolism","DNA, Z-Form","Deoxyribonuclease I/metabolism","G-Quadruplexes","Hemin","Mammals/genetics","Mice","Micrococcal Nuclease/genetics","Peroxidase/metabolism","Polysaccharides","Sodium Chloride","Staphylococcus/genetics"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-B6F1568C9BBFD45E6FD1C98AB28791E1"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1093/nar/gkae034","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Interdisciplinary Nanoscience Center"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Gabriel Antonio Salvador","key":"mineropau","last":"Minero","locid":"cc436bce-1546-4216-bb08-ae06ac0300d2","name":"Minero, Gabriel Antonio Salvador","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andreas","key":"møllebjergpau","last":"Møllebjerg","locid":"4176d27b-9e84-42e2-9357-cd93796c3046","name":"Møllebjerg, Andreas","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Celine","key":"thiesenpau","last":"Thiesen","locid":"ba360b81-a1d4-4374-894b-56741549aba6","name":"Thiesen, Celine","orcid":"0009-0006-2236-9521","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mikkel Illemann","key":"johansenpau","last":"Johansen","locid":"521aaf8b-4d7a-4672-82c4-2c79a297b02a","name":"Johansen, Mikkel Illemann","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Nis Pedersen","key":"jørgensenpau","last":"Jørgensen","locid":"ac385492-f707-4053-bc6e-965ba8f60360","name":"Jørgensen, Nis Pedersen","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Victoria","key":"birkedalpau","last":"Birkedal","locid":"7055d6e9-f1c4-4ecf-84b7-8d579b2bb667","name":"Birkedal, Victoria","orcid":"0000-0002-1360-8870","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Daniel Erik","key":"otzenpau","last":"Otzen","locid":"0ec06c22-1f74-4dd2-a894-af30b6565766","name":"Otzen, Daniel E","name_org":"Otzen, Daniel Erik","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rikke Louise","key":"meyerpau","last":"Meyer","locid":"f1caa4f6-bc6e-459a-a976-8843c7ea7ff3","name":"Meyer, Rikke Louise","orcid":"0000-0002-6485-5134","rank":8,"rolecode":"pau"}],"pmid":["38296834"],"pub":{"doi":"10.1093/nar/gkae034","issn":["03051048","13624962"],"issn_org":["03051048"],"issue":"4","journal":"Nucleic Acids Research","pages":"1575-1590","publisher":"Oxford University Press","status":"p","title":"Nucleic Acids Research","volume":"52"},"review":"Peer Reviewed","scoID":["2-s2.0-85186411369"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-2e05dc3a-ae94-4aec-920a-9ee888ae65c0"],"src":["AU Aarhus University"],"title":"Extracellular G-quadruplexes and Z-DNA protect biofilms from DNase I, and G-quadruplexes form a DNAzyme with peroxidase activity","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-717359","year":"2024","yearsub":"2024"}
{"abstract":"Staphylococcus aureus is a major cause of prosthetic vascular graft or endograft infections (VGEIs) and the optimal choice of antibiotics is unclear. We investigated various antibiotic choices as either monotherapy or combination therapy with rifampicin against MRSA in vitro and in vivo. Fosfomycin, daptomycin and vancomycin alone or in combination with rifampicin was used against MRSA USA300 FPR3757. Each antibiotic was tested for synergism or antagonism with rifampicin in vitro, and all antibiotic regimens were tested against actively growing bacteria in media and non-growing bacteria in buffer, both as planktonic cells and in biofilms. A rat model of VGEI was used to quantify the therapeutic efficacy of antibiotics in vivo by measuring bacterial load on grafts and in spleen, liver and kidneys. In vitro, rifampicin combinations did not reveal any synergism or antagonism in relation to growth inhibition. However, quantification of bactericidal activity revealed a strong antagonistic effect, both on biofilms and planktonic cells. This effect was only observed when treating active bacteria, as all antibiotics had little or no effect on inactive cells. Only daptomycin showed some biocidal activity against inactive cells. In vivo evaluation of therapy against VGEI contrasted the in vitro results. Rifampicin significantly increased the efficacy of both daptomycin and vancomycin. The combination of daptomycin and rifampicin was by far the most effective, curing 8 of 13 infected animals. Our study demonstrates that daptomycin in combination with rifampicin shows promising potential against VGEI caused by MRSA. Furthermore, we show how in vitro evaluation of antibiotic combinations in laboratory media does not predict their therapeutic effect against VGEI in vivo, presumably due to a difference in the metabolic state of the bacteria.","author_count":8,"contributors":["Johansen, Mikkel Illemann","Petersen, Maiken Engelbrecht","Faddy, Emma","Seefeldt, Anders Marthinsen","Mitkin, Alexander Alexandrovich","Østergaard, Lars Jørgen","Meyer, Rikke Louise","Jørgensen, Nis Pedersen"],"cuid":["S01-000.00-728436"],"filters":{"added":"2024-05","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Jørgensen, Nis Pedersen","Meyer, Rikke Louise"],"keyword":["Biofilm","Infections","MRSA","Persister cells","Prosthesis","Rat model","Rifampicin","Staphylococcus aureus"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"efficacy of rifampicin combination therapy against mrsa prosthetic vascular graft infections in a rat model","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1016/j.bioflm.2024.100189","version":"Published Version"},"funding_acknowledgement":["This work was supported by the Novo Nordisk Foundation (Grant no. Project No. NNF19OC0058357 ) and The Hede Nielsen Family Foundation . This work was supported by the Novo Nordisk Foundation (Grant no. Project No. NNF19OC0058357) and The Hede Nielsen Family Foundation.The authors declare the following financial interests/personal relationships which may be considered as potential competing interests: Rikke Louise Meyer reports financial support was provided by Novo Nordisk Foundation. Lars Østergaard reports financial support was provided by Novo Nordisk Foundation. Nis Pedersen Jørgensen reports financial support was provided by The Hede Nielsen Family Foundation. The corresponding author Rikke Louise Meyer is an editor for Biofilms. If there are other authors, they declare that they have no known competing financial interests or personal relationships that could have appeared to influence the work reported in this paper."],"id":"S01-000.00-728436","identifier":[{"id":"38481761","type":"pmid"},{"id":"85186691764","type":"scopus"},{"id":"PMC10933452","type":"pmcid"}],"ids":["au-c609ada9-3af6-4ee0-b9d7-ac6b002aeacf"],"keyword":["Biofilm","Infections","MRSA","Persister cells","Prosthesis","Rat model","Rifampicin","Staphylococcus aureus","VGEI","Vascular graft or endograft infections"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-276FE2E049776B9202803B4BE8621C17"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1016/j.bioflm.2024.100189","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Infectious Diseases"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Mikkel Illemann","key":"johansenpau","last":"Johansen","locid":"521aaf8b-4d7a-4672-82c4-2c79a297b02a","name":"Johansen, Mikkel Illemann","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Maiken Engelbrecht","key":"petersenpau","last":"Petersen","locid":"99c8dbe5-12c1-4b7b-bc1d-a2985885e525","name":"Petersen, Maiken Engelbrecht","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Emma","key":"faddypau","last":"Faddy","locid":"bb70676b-e875-42c1-86bd-040b8731c4cc","name":"Faddy, Emma","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Anders Marthinsen","key":"seefeldtpau","last":"Seefeldt","name":"Seefeldt, Anders Marthinsen","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Alexander Alexandrovich","key":"mitkinpau","last":"Mitkin","locid":"e8d98ae8-db91-4fb5-a72f-87ba7fcced6d","name":"Mitkin, Alexander Alexandrovich","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars","key":"østergaardpau","last":"Østergaard","locid":"fb8358a6-187a-4d5f-8187-06051ed74173","name":"Østergaard, Lars Jørgen","name_org":"Østergaard, Lars","orcid":"0000-0003-2459-0511","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rikke Louise","key":"meyerpau","last":"Meyer","locid":"f1caa4f6-bc6e-459a-a976-8843c7ea7ff3","name":"Meyer, Rikke Louise","orcid":"0000-0002-6485-5134","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Nis Pedersen","key":"jørgensenpau","last":"Jørgensen","locid":"ac385492-f707-4053-bc6e-965ba8f60360","name":"Jørgensen, Nis Pedersen","rank":8,"rolecode":"pau"}],"pmid":["38481761"],"pub":{"doi":"10.1016/j.bioflm.2024.100189","issn":["25902075"],"journal":"Biofilm","paperid":"100189","publisher":"Elsevier BV","status":"p","title":"Biofilm","volume":"7"},"review":"Peer Reviewed","scoID":["2-s2.0-85186691764"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-c609ada9-3af6-4ee0-b9d7-ac6b002aeacf"],"src":["AU Aarhus University"],"title":"Efficacy of rifampicin combination therapy against MRSA prosthetic vascular graft infections in a rat model","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-728436","year":"2024","yearsub":"2024"}
{"abstract":"Objectives: To evaluate the effect of daily use of a multiple-enzyme lozenge on de novo plaque formation, on gingivitis development, and on the oral microbiome composition. Methods: This trial with two parallel arms included 24 healthy adults allocated to the Active (n = 12) or Placebo (n = 12) group. Subjects consumed one lozenge three times daily for seven days, and no oral hygiene procedures were allowed. Differences in de novo plaque accumulation between a baseline period, and one and seven days of intervention were assessed by the Turesky-modification of the Quigley-and-Hein-Plaque-Index (TM-QHPI). The development of gingivitis after seven days of intervention was assessed by the Gingival Index (GI). Plaque and saliva samples were collected at baseline and after seven days of intervention, and evaluated by 16S rRNA gene sequencing. Results: All subjects completed the study, and no adverse events were reported. After one day, the average TM-QHPI was significantly lower in the Active than in the Placebo group, as compared to baseline (p = 0.012). After 7 days, average TM-QHPI values did not differ significantly between groups (p = 0.37). GI values did not increase during the intervention period, with no difference between groups (p = 0.62). Bacterial richness increased in both plaque and saliva samples over a seven-day oral hygiene-free period, with a statistically significant difference for the saliva samples (p = 0.0495) between groups. Conclusions: A multiple-enzymes lozenge decreased the build-up of de novo plaque after one day and slowed down the process of species increment in saliva. The lozenge may be an adjunct to regular mechanical plaque removal. Clinical significance: Dental plaque is the main cause of caries, gingivitis, and periodontitis. The search for therapeutic adjuncts to mechanical plaque removal that have no harmful effects on the oral microbiome is important. Treatment with multiple plaque-matrix degrading enzymes is a promising non-biocidal approach to plaque control.","author_count":6,"contributors":["Schlafer, Sebastian","K. Johnsen, Karina","Kjærbølling, Inge","Schramm, Andreas","Meyer, Rikke Louise","Jørgensen, Mette Rose"],"cuid":["S01-000.00-744147"],"filters":{"added":"2024-08","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Schlafer, Sebastian"],"keyword":["Beta glucanase","Dental plaque","Dental plaque index","Mutanase","Oral Hygiene"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-NOSI"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-PR-NOSI","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"the efficacy and safety of an enzyme containing lozenge for dental biofilm control a randomized controlled pilot trial","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.jdent.2024.105107","version":"Published Version"},"id":"S01-000.00-744147","identifier":[{"id":"38830531","type":"pmid"},{"id":"85195647797","type":"scopus"}],"ids":["au-45008183-2787-42df-9cec-8bb95eabd939"],"keyword":["Beta-glucanase","Dental plaque","Dental plaque index","Desoxyribonuclease","Mutanase","Oral hygiene"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-06DB1B4BE8E25A3653FCD196D8AC9B20"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.jdent.2024.105107","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Dentistry and Oral Health, Department of Dentistry and Oral Health - Section for Oral Ecology"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"novonesis","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-NOSI","l3nn":"Novonesis","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Novonesis","namevar":["Novozymes A/S"],"nora_code":"DI-PR-NOSI","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Sebastian","key":"schlaferpau","last":"Schlafer","locid":"bcd4e1fe-3a80-4288-8b5f-d105f6f53982","name":"Schlafer, Sebastian","orcid":"0000-0003-2463-1926","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Karina K.","key":"johnsenpau","last":"Johnsen","locid":"e6eea993-e93e-40a1-91a9-00475b587f63","name":"K. Johnsen, Karina","name_org":"Johnsen, Karina K.","orcid":"0000-0002-9764-8481","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Inge","key":"kjærbøllingpau","last":"Kjærbølling","name":"Kjærbølling, Inge","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Andreas","key":"schrammpau","last":"Schramm","locid":"25080de3-b60e-46b4-a606-d99f1ec089e5","name":"Schramm, Andreas","orcid":"0000-0002-7614-9616","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rikke L.","key":"meyerpau","last":"Meyer","locid":"f1caa4f6-bc6e-459a-a976-8843c7ea7ff3","name":"Meyer, Rikke Louise","name_org":"Meyer, Rikke L.","orcid":"0000-0002-6485-5134","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Mette Rose","key":"jørgensenpau","last":"Jørgensen","name":"Jørgensen, Mette Rose","rank":6,"rolecode":"pau"}],"pmid":["38830531"],"pub":{"doi":"10.1016/j.jdent.2024.105107","issn":["03005712","1879176X"],"issn_org":["03005712"],"journal":"Journal of Dentistry","paperid":"105107","publisher":"Elsevier Ltd","status":"p","title":"Journal of Dentistry","volume":"147"},"review":"Peer Reviewed","scoID":["2-s2.0-85195647797"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Private Research","Universities"],"PST":["Published"]},"sid":["au-45008183-2787-42df-9cec-8bb95eabd939"],"src":["AU Aarhus University"],"title":"The efficacy and safety of an enzyme-containing lozenge for dental biofilm control : a randomized controlled pilot trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-744147","year":"2024","yearsub":"2024"}
{"abstract":"Background: Correlative structural and chemical imaging of biofilms allows for the combined analysis of microbial identity and metabolism at the microscale. Here, we developed pH-FISH, a method that combines pH ratiometry with fluorescence in situ hybridization (FISH) in structurally intact biofilms for the coupled investigation of microbial acid metabolism and biofilm composition. Careful biofilm handling and modified sample preparation procedures for FISH allowed preservation of the three-dimensional biofilm structure throughout all processing and imaging steps. We then employed pH-FISH to investigate the relationship between local biofilm pH and the distribution of acid-producing (streptococci) and acid-consuming (Veillonella spp.) bacteria in dental biofilms from healthy subjects and caries-active patients. Results: The relative abundance of streptococci correlated with low biofilm pH at the field-of-view level, while the opposite trend was observed for Veillonella spp. These results suggest that clusters of streptococci contribute to the formation of acidic pockets inside dental biofilms, whereas Veillonella spp. may have a protective role against biofilm acidification. Conclusions: pH-FISH combines microscale mapping of biofilm pH in real time with structural imaging of the local microbial architecture, and is a powerful method to explore the interplay between biofilm composition and metabolism in complex biological systems.","author_count":7,"contributors":["Chokyu Del Rey, Yumi","Kitzinger, Katharina","Lund, Marie Braad","Schramm, Andreas","Meyer, Rikke Louise","Wagner, Michael","Schlafer, Sebastian"],"cuid":["S02-100.00-792899"],"filters":{"added":"2025-02","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","OECD"],"corresponding_author":["Chokyu Del Rey, Yumi","Del Rey, Yumi Chokyu","Schlafer, Sebastian"],"country":["Austria"],"glorg":["All Global Affiliations","University of Vienna"],"keyword":["Biofilms","Confocal laser scanning microscopy","Dental biofilms","Fluorescence in situ hybridization","Microenvironments","pH ratiometry"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"ph fish coupled microscale analysis of microbial identity and acid base metabolism in complex biofilm samples","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND 4.0","type":"doi","url":"https://doi.org/10.1186/s40168-024-01977-9","version":"Published Version"},"id":"S02-100.00-792899","identifier":[{"id":"PMC11662800","type":"pmcid"},{"id":"85212786384","type":"scopus"},{"id":"39707459","type":"pmid"}],"ids":["aau-6828bee1-c5e1-45c8-ad50-44aee1a54412","au-022fbb1a-01e9-40bf-b99f-b373989e4b7b"],"keyword":["Biofilms","Confocal laser scanning microscopy","Dental biofilms","Fluorescence in situ hybridization","Microenvironments","pH ratiometry"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-3B0DB78D61543DEE71F6CD6987871990"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND 4.0","type":"doi","url":"https://doi.org/10.1186/s40168-024-01977-9","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/767313045/s40168-024-01977-9.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Dentistry and Oral Health, Department of Dentistry and Oral Health - Section for Oral Ecology"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"at","key":"university of vienna","loc":["Austria","Europe, EU","OECD"],"name":"University of Vienna","used":1},{"affno":"3","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience, Center for Microbial Communities","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience, Section of Environmental Microbiology"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Yumi Chokyu","key":"delreypau","last":"Del Rey","locid":"22d33fad-da2e-4a05-8e4a-d39df9284c88","name":"Chokyu Del Rey, Yumi","name_org":"Del Rey, Yumi Chokyu","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Katharina","key":"kitzingerpau","last":"Kitzinger","name":"Kitzinger, Katharina","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Marie Braad","key":"lundpau","last":"Lund","locid":"ccca6a51-5b47-45b6-969c-b0c5ea95100c","name":"Lund, Marie Braad","orcid":"0000-0003-1543-1009","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Andreas","key":"schrammpau","last":"Schramm","locid":"25080de3-b60e-46b4-a606-d99f1ec089e5","name":"Schramm, Andreas","orcid":"0000-0002-7614-9616","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rikke Louise","key":"meyerpau","last":"Meyer","locid":"f1caa4f6-bc6e-459a-a976-8843c7ea7ff3","name":"Meyer, Rikke Louise","orcid":"0000-0002-6485-5134","rank":5,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Michael","key":"wagnerpau","last":"Wagner","locid":"6d340334-6137-4749-8a94-1fc3240cfa00","name":"Wagner, Michael","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Sebastian","key":"schlaferpau","last":"Schlafer","locid":"bcd4e1fe-3a80-4288-8b5f-d105f6f53982","name":"Schlafer, Sebastian","orcid":"0000-0003-2463-1926","rank":7,"rolecode":"pau"}],"pmid":["39707459"],"pub":{"doi":"10.1186/s40168-024-01977-9","issn":["20492618"],"issue":"1","journal":"Microbiome","paperid":"266","publisher":"BioMed Central","status":"p","title":"Microbiome","volume":"12"},"review":"Peer Reviewed","scoID":["2-s2.0-85212786384"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-6828bee1-c5e1-45c8-ad50-44aee1a54412","au-022fbb1a-01e9-40bf-b99f-b373989e4b7b"],"src":["AAU Aalborg University","AU Aarhus University"],"title":"pH-FISH - coupled microscale analysis of microbial identity and acid–base metabolism in complex biofilm samples","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-792899","year":"2024","yearsub":"2024"}
{"abstract":"Bacterial biofilms have a complex and heterogeneous three-dimensional architecture that is characterized by chemically and structurally distinct microenvironments. Confocal microscopy-based pH ratiometry and fluorescence lectin-binding analysis (FLBA) are well-established methods to characterize pH developments and the carbohydrate matrix architecture of biofilms at the microscale. Here, we developed a combined analysis, pH-FLBA, to concomitantly map biofilm pH and the distribution of matrix carbohydrates in bacterial biofilms while preserving the biofilm microarchitecture. As a proof of principle, the relationship between pH and the presence of galactose- and fucose-containing matrix components was investigated in dental biofilms grown with and without sucrose. The pH response to a sucrose challenge was monitored in different areas at the biofilm base using the ratiometric pH-sensitive dye C-SNARF-4. Thereafter, the fucose- and galactose-specific fluorescently labeled lectins Aleuria aurantia lectin (AAL) and Morus nigra agglutinin G (MNA-G) were used to visualize carbohydrate matrix components in the same biofilm areas and their immediate surroundings. Sucrose during growth significantly decreased biofilm pH ( P < 0.05) and increased the amounts of both MNA-G- and AAL-targeted matrix carbohydrates ( P < 0.05). Moreover, it modulated the biofilm composition towards a less diverse community dominated by streptococci, as determined by 16S rRNA gene sequencing. Altogether, these results suggest that the production of galactose- and fucose-containing matrix carbohydrates is related to streptococcal metabolism and, thereby, pH profiles in dental biofilms. In conclusion, pH-FLBA using lectins with different carbohydrate specificities is a useful method to investigate the association between biofilm pH and the complex carbohydrate architecture of bacterial biofilms.IMPORTANCEBiofilm pH is a key regulating factor in several biological and biochemical processes in environmental, industrial, and medical biofilms. At the microscale, microbial biofilms are characterized by steep pH gradients and an extracellular matrix rich in carbohydrate components with diffusion-modifying properties that contribute to bacterial acid-base metabolism. Here, we propose a combined analysis of pH ratiometry and fluorescence lectin-binding analysis, pH-FLBA, to concomitantly investigate the matrix architecture and pH developments in microbial biofilms, using complex saliva-derived biofilms as an example. Spatiotemporal changes in biofilm pH are monitored non-invasively over time by pH ratiometry, while FLBA with lectins of different carbohydrate specificities allows mapping the distribution of multiple relevant matrix components in the same biofilm areas. As the biofilm structure is preserved, pH-FLBA can be used to investigate the in situ relationship between the biofilm matrix architecture and biofilm pH in complex multispecies biofilms.","author_count":5,"contributors":["Chokyu Del Rey, Yumi","Schramm, Andreas","Meyer, Rikke Louise","Lund, Marie Braad","Schlafer, Sebastian"],"cuid":["S01-000.00-717668"],"filters":{"added":"2024-03","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Chokyu Del Rey, Yumi","Schlafer, Sebastian"],"keyword":["Bacteria metabolism","Biofilm matrix","Biofilms","Carbohydrates","Confocal microscopy","Dental biofilms","Fucose metabolism","Galactose metabolism","Hydrogen Ion Concentration","Lectins metabolism","Microscopy Confocal methods","RNA Ribosomal 16S metabolism","Streptococcus metabolism","Sucrose metabolism","fluorescence lectin binding analysis","pH ratiometry"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"combined ph ratiometry and fluorescence lectin binding analysis ph flba for microscopy based analyses of biofilm ph and matrix carbohydrates","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85185701606","version":"Other Version"},"id":"S01-000.00-717668","identifier":[{"id":"38265212","type":"pmid"},{"id":"85185701606","type":"scopus"},{"id":"PMC10880593","type":"pmcid"}],"ids":["au-75956075-f9ad-4309-96f4-5b9e72d714eb"],"keyword":["Bacteria/metabolism","Biofilms","Carbohydrates","Fucose/metabolism","Galactose/metabolism","Hexoses/metabolism","Hydrogen-Ion Concentration","Lectins/metabolism","Microscopy, Confocal/methods","RNA, Ribosomal, 16S/metabolism","Streptococcus/metabolism","Sucrose/metabolism","biofilm matrix","confocal microscopy","dental biofilms","fluorescence lectin-binding analysis","pH ratiometry"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-29649210AA44C701C16328D3643FDE90"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Dentistry and Oral Health","Aarhus University, Health, Department of Dentistry and Oral Health, Department of Dentistry and Oral Health - Section for Oral Ecology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Yumi C","key":"delreypau","last":"Del Rey","locid":"22d33fad-da2e-4a05-8e4a-d39df9284c88","name":"Chokyu Del Rey, Yumi","name_org":"Del Rey, Yumi C","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Andreas","key":"schrammpau","last":"Schramm","locid":"25080de3-b60e-46b4-a606-d99f1ec089e5","name":"Schramm, Andreas","orcid":"0000-0002-7614-9616","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rikke","key":"lmeyerpau","last":"L Meyer","locid":"f1caa4f6-bc6e-459a-a976-8843c7ea7ff3","name":"Meyer, Rikke Louise","name_org":"L Meyer, Rikke","orcid":"0000-0002-6485-5134","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Marie Braad","key":"lundpau","last":"Lund","locid":"ccca6a51-5b47-45b6-969c-b0c5ea95100c","name":"Lund, Marie Braad","orcid":"0000-0003-1543-1009","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Sebastian","key":"schlaferpau","last":"Schlafer","locid":"bcd4e1fe-3a80-4288-8b5f-d105f6f53982","name":"Schlafer, Sebastian","orcid":"0000-0003-2463-1926","rank":5,"rolecode":"pau"}],"pmid":["38265212"],"pub":{"doi":"10.1128/aem.02007-23","issn":["00992240","10985336"],"issn_org":["00992240"],"issue":"2","journal":"Applied and Environmental Microbiology","paperid":"e0200723","publisher":"American Society for Microbiology","status":"p","title":"Applied and Environmental Microbiology","volume":"90"},"review":"Peer Reviewed","scoID":["2-s2.0-85185701606"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-75956075-f9ad-4309-96f4-5b9e72d714eb"],"src":["AU Aarhus University"],"title":"Combined pH ratiometry and fluorescence lectin-binding analysis (pH-FLBA) for microscopy-based analyses of biofilm pH and matrix carbohydrates","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-717668","year":"2024","yearsub":"2024"}
{"abstract":"Introduction. Persister cells are transiently non-growing antibiotic-tolerant bacteria that cause infection relapse, and there is no effective antibiotic therapy to tackle these infections.Gap statement. High-throughput assays in drug discovery are biased towards detecting drugs that inhibit bacterial growth rather than killing non-growing bacteria. A new and simple assay to discover such drugs is needed.Aim. This study aims to develop a simple and high-throughput assay to identify compounds with antimicrobial activity against persister cells and use it to identify molecular motifs with such activity.Methodology. We quantified Staphylococcus aureus persister cells by enumeration of colony forming units after 24 h ciprofloxacin treatment. We first quantified how the cell concentration, antibiotic concentration, growth phase and presence/absence of nutrients during antibiotic exposure affected the fraction of persister cells in a population. After optimizing these parameters, we screened the antimicrobial activity of compound fragments to identify molecular structures that have activity against persister cells.Results. Exponential- and stationary-phase cultures transferred to nutrient-rich media displayed a bi-phasic time-kill curve and contained 0.001-0.07% persister cells. A short rifampicin treatment resulted in 100% persister cells for 7 h, after which cells resumed activity and became susceptible. Stationary-phase cultures displayed a low but constant death rate but ultimately resulted in similarly low survival rates as the exponential-phase cultures after 24 h ciprofloxacin treatment. The persister phenotype was only maintained in most of the population for 24 h if cells were transferred to a carbon-free minimal medium before exposure to ciprofloxacin. Keeping cells starved enabled the generation of high concentrations of S. aureus cells that tolerate 50× MIC ciprofloxacin, and we used this protocol for rapid screening for biocidal antibiotics. We identified seven compounds from four structural clusters with activity against antibiotic-tolerant S. aureus. Two compounds were moderately cytotoxic, and the rest were highly cytotoxic.Conclusion. Transferring a stationary-phase culture to a carbon-free minimal medium for antimicrobial testing is a simple strategy for high-throughput screening for new antibiotics that kill persister cells. We identified molecule fragments with such activity, but further screening is needed to identify motifs with lower general cytotoxicity.","author_count":8,"contributors":["Petersen, Maiken Engelbrecht","Hansen, Liva Kjær","Mitkin, Alexander Alexandrovich","Kelly, Nicholas M.","Wood, Thomas Keith","Jørgensen, Nis Pedersen","Østergaard, Lars Jørgen","Meyer, Rikke Louise"],"cuid":["S01-000.00-752784"],"filters":{"added":"2024-09","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","OECD"],"corresponding_author":["Meyer, Rikke Louise"],"country":["United States"],"glorg":["All Global Affiliations","Pennsylvania State University"],"keyword":["Drug development","Persister cells","Staphylococcus aureus"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-PR-OTH","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"a high throughput assay identifies molecules with antimicrobial activity against persister cells","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1099/jmm.0.001856","version":"Published Version"},"id":"S01-000.00-752784","identifier":[{"id":"PMC11316564","type":"pmcid"},{"id":"38995832","type":"pmid"},{"id":"85198570761","type":"scopus"}],"ids":["au-41a1fd89-75c7-4eb4-afb9-3b9c78d9f62b"],"keyword":["Staphylococcus aureus","drug development","persister cells"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-A6FFA801CBD892126B1EA2B89DCAA646"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1099/jmm.0.001856","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Interdisciplinary Nanoscience Center"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["Pincer Biotech ApS"],"nora_code":"DI-PR-OTH","used":1},{"affno":"3","country":"us","key":"pennsylvania state university","loc":["United States","America, North","OECD"],"name":"Pennsylvania State University","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Maiken Engelbrecht","key":"petersenpau","last":"Petersen","locid":"99c8dbe5-12c1-4b7b-bc1d-a2985885e525","name":"Petersen, Maiken Engelbrecht","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Liva Kjær","key":"hansenpau","last":"Hansen","locid":"653924b2-77cf-4c6c-b9d3-9f1bd34da92f","name":"Hansen, Liva Kjær","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Alexander Alexandrovich","key":"mitkinpau","last":"Mitkin","locid":"e8d98ae8-db91-4fb5-a72f-87ba7fcced6d","name":"Mitkin, Alexander Alexandrovich","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Nicholas M.","key":"kellypau","last":"Kelly","name":"Kelly, Nicholas M.","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Thomas Keith","key":"woodpau","last":"Wood","name":"Wood, Thomas Keith","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Nis Pedersen","key":"jørgensenpau","last":"Jørgensen","locid":"ac385492-f707-4053-bc6e-965ba8f60360","name":"Jørgensen, Nis Pedersen","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars Jørgen","key":"østergaardpau","last":"Østergaard","locid":"fb8358a6-187a-4d5f-8187-06051ed74173","name":"Østergaard, Lars Jørgen","orcid":"0000-0003-2459-0511","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rikke Louise","key":"meyerpau","last":"Meyer","locid":"f1caa4f6-bc6e-459a-a976-8843c7ea7ff3","name":"Meyer, Rikke Louise","orcid":"0000-0002-6485-5134","rank":8,"rolecode":"pau"}],"pmid":["38995832"],"pub":{"doi":"10.1099/jmm.0.001856","issn":["00222615","14735644"],"issn_org":["00222615"],"issue":"7","journal":"Journal of Medical Microbiology","paperid":"001856","publisher":"Microbiology Society","status":"p","title":"Journal of Medical Microbiology","volume":"73"},"review":"Peer Reviewed","scoID":["2-s2.0-85198570761"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Other Companies","Private Research","Universities","pincer biotech aps"],"PST":["Published"]},"sid":["au-41a1fd89-75c7-4eb4-afb9-3b9c78d9f62b"],"src":["AU Aarhus University"],"title":"A high-throughput assay identifies molecules with antimicrobial activity against persister cells","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-752784","year":"2024","yearsub":"2024"}
{"abstract":"The escalating scarcity of clean freshwater, a crucial global economic asset, demands advancements in water purification technologies. Reverse osmosis (RO) stands out as an effective method for removing contaminants, yet biofouling of RO membranes poses a significant challenge, lowering the operational and energy efficiency. Through DNA sequencing, we identified a small set of abundant core bacterial species common to the biofilm in the three RO modules treating tap water. The core species are closely related to heterotrophic taxa from soil and groundwater systems and are likely important for the RO membrane biofouling. The community compositions of the RO-biofilms were system-specific. Within a given RO module, the biofilm community composition was uniform across the various sections of the membrane module. We established a method to efficiently extract live cells from the membranes and determined their salinity tolerance. Growth was mainly aerobic and was only inhibited at salinities above 3 to 5 %, i.e. exceeding those that can be reached in the specific RO modules. The species composition of the growing community changed discretely with the salinity level, indicating that salinity fluctuations may have an important role in shaping RO biofilm communities. Our findings highlight a complex interplay between microbial communities, salinity, and growth conditions in RO modules.","author_count":4,"contributors":["Poulsen, Jan Struckmann","Koren, Klaus","Meyer, Rikke Louise","Kjeldsen, Kasper Urup"],"cuid":["S01-000.00-757659"],"filters":{"added":"2024-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Poulsen, Jan Struckmann"],"keyword":["Bacteria","Biofilm","Community","Membrane biofouling","Reverse osmosis","Salinity"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"biofilms on ro membranes treating tap water harbour diverse bacteria with opposing salinity optima","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.desal.2024.118106","version":"Published Version"},"id":"S01-000.00-757659","identifier":[{"id":"85203815597","type":"scopus"}],"ids":["au-15e06791-a9ec-4035-98c0-9a800dd3eb83"],"keyword":["Biofilm","Community","Membrane biofouling","Reverse osmosis","Salinity","bacteria"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-21664D987E60F9FC266392D113B78A9C"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.desal.2024.118106","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Biology, Department of Biology - Microbiology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jan Struckmann","key":"poulsenpau","last":"Poulsen","locid":"44656daf-d14b-407e-8ad1-3957eb017ab1","name":"Poulsen, Jan Struckmann","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Klaus","key":"korenpau","last":"Koren","locid":"1fd89d19-7694-48cf-b225-283077d71623","name":"Koren, Klaus","orcid":"0000-0002-7537-3114","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rikke Louise","key":"meyerpau","last":"Meyer","locid":"f1caa4f6-bc6e-459a-a976-8843c7ea7ff3","name":"Meyer, Rikke Louise","orcid":"0000-0002-6485-5134","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kasper Urup","key":"kjeldsenpau","last":"Kjeldsen","locid":"70f809ce-0110-40e4-ad60-77e80799c7e9","name":"Kjeldsen, Kasper Urup","orcid":"0000-0002-7805-5605","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.desal.2024.118106","issn":["00119164","18734464"],"issn_org":["00119164"],"journal":"Desalination","paperid":"118106","publisher":"Elsevier BV","publisher_org":"Elsevier B.V.","status":"p","title":"Desalination","volume":"592"},"review":"Peer Reviewed","scoID":["2-s2.0-85203815597"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-15e06791-a9ec-4035-98c0-9a800dd3eb83"],"src":["AU Aarhus University"],"title":"Biofilms on RO membranes treating tap water harbour diverse bacteria with opposing salinity optima","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-757659","year":"2024","yearsub":"2024"}
{"abstract":"Bacteria in the oral cavity are responsible for the development of dental diseases such as caries and periodontitis, but it is becoming increasingly clear that the oral microbiome also benefits human health. Many oral care products on the market are antimicrobial, killing a large part of the oral microbiome but without removing the disease-causing biofilm. Instead, non-biocidal matrix-degrading enzymes may be used to selectively remove biofilm without harming the overall microbiome. The challenge of using enzymes to degrade biofilms is to match the narrow specificity of enzymes with the large structural diversity of extracellular polymeric substances that hold the biofilm together. In this study, we therefore perform a large-scale screening of single and multi-enzyme formulations to identify combinations of enzymes that most effectively remove dental biofilm. We tested >400 different treatment modalities using 44 different enzymes in combinations with up to six enzymes in each formulation, on in vitro biofilms inoculated with human saliva. Mutanase was the only enzyme capable of removing biofilm on its own. Multi-enzyme formulations removed up to 69 % of the biofilm volume, and the most effective formulations all contained mutanase. We shortlisted 10 enzyme formulations to investigate their efficacy against biofilms formed on glass slabs on dental splints worn by 9 different test subjects. Three of the ten formulations removed more than 50 % of the biofilm volume. If optimal enzyme concentration and exposure time can be reached in vivo, these enzyme combinations have potential to be used in novel non-biocidal oral care products for dental biofilm control.","author_count":9,"contributors":["Nielsen, Signe Maria","Johnsen, Karina Kambourakis","Hansen, Lea Benedicte Skov","Rikvold, Pernille","Møllebjerg, Andreas","Palmén, Lorena Gonzalez","Durhuus, Thomas","Schlafer, Sebastian","Meyer, Rikke Louise"],"cuid":["S01-000.00-762957"],"filters":{"added":"2024-11","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Meyer, Rikke Louise","Schlafer, Sebastian"],"keyword":["Confocal microscopy","Dental biofilm","Dextranase","Enzyme treatment","Glucanase","Mutanase"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-NOSI"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-PR-NOSI","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"large scale screening identifies enzyme combinations that remove in situ grown oral biofilm","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.bioflm.2024.100229","version":"Published Version"},"id":"S01-000.00-762957","identifier":[{"id":"39830521","type":"pmid"},{"id":"85205806769","type":"scopus"},{"id":"PMC11740801","type":"pmcid"}],"ids":["au-3fd9755e-0273-4ccb-9af7-0ea62daa1461"],"keyword":["Confocal microscopy","Dental biofilm","Dextranase","Enzyme treatment","Glucanase","Mutanase"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-7C1A78AF99D3FCA85FB68035FC3656BD"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.bioflm.2024.100229","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"novonesis","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-NOSI","l3nn":"Novonesis","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Novonesis","namevar":["Novonesis A/S"],"nora_code":"DI-PR-NOSI","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Dentistry and Oral Health, Department of Dentistry and Oral Health - Section for Oral Ecology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Signe Maria","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Signe Maria","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Karina Kambourakis","key":"johnsenpau","last":"Johnsen","name":"Johnsen, Karina Kambourakis","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lea Benedicte Skov","key":"hansenpau","last":"Hansen","name":"Hansen, Lea Benedicte Skov","rank":3,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Pernille Dukanovic","key":"rikvoldpau","last":"Rikvold","locid":"d5ef43bc-479a-4d2b-916a-7028a4618e80","name":"Rikvold, Pernille","name_org":"Rikvold, Pernille Dukanovic","orcid":"0000-0002-2431-6937","rank":4,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Andreas","key":"møllebjergpau","last":"Møllebjerg","locid":"4176d27b-9e84-42e2-9357-cd93796c3046","name":"Møllebjerg, Andreas","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lorena Gonzalez","key":"palménpau","last":"Palmén","name":"Palmén, Lorena Gonzalez","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Thomas","key":"durhuuspau","last":"Durhuus","name":"Durhuus, Thomas","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Sebastian","key":"schlaferpau","last":"Schlafer","locid":"bcd4e1fe-3a80-4288-8b5f-d105f6f53982","name":"Schlafer, Sebastian","orcid":"0000-0003-2463-1926","rank":8,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Rikke Louise","key":"meyerpau","last":"Meyer","locid":"f1caa4f6-bc6e-459a-a976-8843c7ea7ff3","name":"Meyer, Rikke Louise","orcid":"0000-0002-6485-5134","rank":9,"rolecode":"pau"}],"pmid":["39830521"],"pub":{"doi":"10.1016/j.bioflm.2024.100229","issn":["25902075"],"journal":"Biofilm","paperid":"100229","publisher":"Elsevier BV","status":"p","title":"Biofilm","volume":"8"},"review":"Peer Reviewed","scoID":["2-s2.0-85205806769"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Private Research","Universities"],"PST":["Published"]},"sid":["au-3fd9755e-0273-4ccb-9af7-0ea62daa1461"],"src":["AU Aarhus University"],"title":"Large-scale screening identifies enzyme combinations that remove in situ grown oral biofilm","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-762957","year":"2024","yearsub":"2024"}
{"abstract":"Objectives: To design an educational intervention on sexual dysfunction for patients suffering from schizophrenia and diabetes based on patients' and other relevant stakeholders' preferences, and to offer transparency into the basic decision-making process behind a final design. Methods: We conducted a three-part investigation to explore theory, preferences, and feasibility based on literature searches and interviews with patients, healthcare professionals, heads of Assertive Community Treatment Centres and experts. Based on a content analysis of this material, a draft of the intervention was developed. The draft was quality-checked by involvement of stakeholder representatives and refined to its final design. Results: The intervention evolved into having two components: One intervention for patients and one for healthcare professionals. In patient education, meeting peers and predictability were important factors. For healthcare professionals, daily clinical activities were prioritised. Conclusions: We present a framework for an educational intervention about sexual dysfunction, schizophrenia and diabetes targeting both patients and healthcare professionals. Innovation: The transparency of the design process underlying the interventions allows for reproduction and eases further refinement, extension, and adjustment if implemented in other contexts.","author_count":7,"contributors":["Meyer, Rikke","Kotnis, Sita R.","Fog-Petersen, Cecilie M.Ø.","Tarnow, Lise","Giraldi, Annamaria","Jürgens, Gesche","Jacobsen, Charlotte B."],"cuid":["S02-100.00-756197"],"filters":{"added":"2024-08","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Meyer, Rikke"],"keyword":["Complex interventions","Diabetes","Patient education","Patient involvement","Qualitative methods","Schizophrenia","Sexual dysfunction"],"level":"sci","mra":["hum","med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U","DI-UC"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-STENO","DI-HO-ZEA"],"OT":["Steno Diabetes Centre, Gentofte, Denmark."],"U":["DI-U-ALL","DI-U-KU"],"UC":["DI-UC-ALL","DI-UC-KP"]},"level3all":["DI-HO-CAP","DI-HO-STENO","DI-HO-ZEA","DI-U-KU","DI-UC-KP"]},"review":"pr","rtype":["clu"],"sorti":"steps to construct educational interventions on sexual dysfunction for healthcare professionals and patients experiences from the secret research study group","src":["kp","ku"],"src-code":["DI-U-KU","DI-UC-KP"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.pecinn.2024.100310","version":"Published Version"},"funding_acknowledgement":["This work was supported by a research grant from Steno Diabetes Centre Sjaelland and the regional research fund of Region Zealand , Denmark (Den Regionale Forskningsfond, Region Sj\\u00E6lland ). A special thanks to all participating patients, HCPs and heads of ACCs, who contributed with their lived experiences and preferences for educational interventions. Thanks to Steno Diabetes Center Sjaelland and Region Zealand Health Scientific Research Foundation who provided research grants for the study."],"id":"S02-100.00-756197","identifier":[{"id":"39035236","type":"pmid"},{"id":"85196852857","type":"scopus"},{"id":"PMC11259809","type":"pmcid"}],"ids":["kp-581de6b3-d92f-4b5b-bbdf-6a59919f21d2","ku-7e0fcc7b-c957-4063-9c99-11964a3d7ff8"],"keyword":["Complex interventions","Diabetes","Patient education","Patient involvement","Qualitative methods","Schizophrenia","Sexual dysfunction","brugerinddragelse, co-design, komplekse interventioner"],"lang":"English","level":"Scientific","mra":["Humanities","Medical Science"],"noi":["Global-Local-2-5-10C9671696704F38F9B12B2CD8EF6C0D"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/396940386/1_s2.0_S277262822400058X_main.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.pecinn.2024.100310","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"region zealand","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-ZEA","l3nl":"Region Zealand","l3nn":"Region Zealand","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region Zealand","namevar":["Copenhagen University Hospital – Psychiatry Region Zealand","Zealand University Hospital - Roskilde"],"nora_code":"DI-HO-ZEA","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Steno Diabetes Centre, Gentofte, Denmark."],"nora_code":"DI-OT","used":1},{"affno":"4","country":"dk","key":"steno diabetes centers","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-STENO","l3nn":"Steno Diabetes Centers","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Steno Diabetes Centers","namevar":["Steno Diabetes Center Copenhagen"],"nora_code":"DI-HO-STENO","used":1},{"affno":"5","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Psychiatry"],"nora_code":"DI-U-KU","used":1},{"affno":"6","key":"kp university college copenhagen","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-KP","l3nl":"KP","l3nn":"KP University College Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KP University College Copenhagen","namevar":["Københavns Professionshøjskole, Rektors område, Fakultet for pædagogiske og samfundsfaglige uddannelser-Dekan, Socialrådgiveruddannelsen Forskning og Udvikling","Socialt Arbejde - Institut for Socialrådgiveruddannelse"],"nora_code":"DI-UC-KP","used":1}],"person":[{"affno":"1 2","first":"Rikke","key":"meyerpau","last":"Meyer","name":"Meyer, Rikke","rank":1,"rolecode":"pau"},{"affno":"1 2","first":"Sita R.","key":"kotnispau","last":"Kotnis","name":"Kotnis, Sita R.","rank":2,"rolecode":"pau"},{"affno":"1","first":"Cecilie M.Ø.","key":"fogpetersenpau","last":"Fog-Petersen","name":"Fog-Petersen, Cecilie M.Ø.","rank":3,"rolecode":"pau"},{"affno":"3 4","first":"Lise","key":"tarnowpau","last":"Tarnow","name":"Tarnow, Lise","rank":4,"rolecode":"pau"},{"affno":"5 2","first":"Annamaria","key":"giraldipau","last":"Giraldi","locid":"562f6342-fc0a-4953-83d4-7650af69afac","name":"Giraldi, Annamaria","orcid":"0000-0002-0033-8517","rank":5,"rolecode":"pau"},{"affno":"1 5","first":"Gesche","key":"jürgenspau","last":"Jürgens","locid":"d17dd3dc-8ce8-46d7-8c8b-0f54963a92bc","name":"Jürgens, Gesche","rank":6,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Charlotte B.","key":"jacobsenpau","last":"Jacobsen","locid":"40d26cc5-117b-41d6-bb2b-3944e60bae72","name":"Jacobsen, Charlotte Bredahl","name_org":"Jacobsen, Charlotte B.","orcid":"0000-0003-4184-3752","rank":7,"rolecode":"pau"}],"pmid":["39035236"],"pub":{"doi":"10.1016/j.pecinn.2024.100310","issn":["27726282"],"journal":"PEC Innovation","paperid":"100310","publisher":"Elsevier BV","publisher_org":"Elsevier B.V.","status":"p","title":"PEC Innovation","volume":"5"},"review":"Peer Reviewed","scoID":["2-s2.0-85196852857"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","All University Colleges","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","Hospitals","KP","Miscellaneous","Other Research","Region Zealand","Universities","University Colleges","University of Copenhagen"],"PST":["Published"]},"sid":["kp-581de6b3-d92f-4b5b-bbdf-6a59919f21d2","ku-7e0fcc7b-c957-4063-9c99-11964a3d7ff8"],"src":["KP University College Copenhagen","KU University of Copenhagen"],"title":"Steps to construct educational interventions on sexual dysfunction for healthcare professionals and patients. Experiences from the SECRET research study-group","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-756197","year":"2024","yearsub":"2024"}
{"abstract":"Aims: Glioblastoma is the most malignant primary brain tumour. Even with standard treatment comprising surgery followed by radiation and concomitant temozolomide (TMZ) chemotherapy, glioblastoma remains incurable. Almost all patients with glioblastoma relapse owing to various intrinsic and extrinsic resistance mechanisms of the tumour cells. Glioblastomas are densely infiltrated with tumour-associated microglia and macrophages (TAMs). These immune cells affect the tumour cells in experimental studies and are associated with poor patient survival in clinical studies. The aim of the study was to investigate the impact of microglia on glioblastoma chemo-resistance. Methods: We co-cultured patient-derived glioblastoma spheroids with microglia at different TMZ concentrations and analysed cell death. In addition, we used RNA sequencing to explore differentially expressed genes after co-culture. Immunostaining was used for validation. Results: Co-culture experiments showed that microglia significantly increased TMZ resistance in glioblastoma cells. RNA sequencing revealed upregulation of a clear interferon-stimulated gene (ISG) expression signature in the glioblastoma cells after co-culture with microglia, including genes such as IFI6, IFI27, BST2, MX1 and STAT1. This ISG expression signature is linked to STAT1 signalling, which was confirmed by immunostaining. The ISG expression profile observed in glioblastoma cells with enhanced TMZ resistance corresponded to the interferon-related DNA damage resistance signature (IRDS) described in different solid cancers. Conclusions: Here, we show that the IRDS signature, linked to chemo-resistance in other cancers, can be induced in glioblastoma by microglia. ISG genes and the microglia inducing the ISG expression could be promising novel therapeutic targets in glioblastoma.","author_count":9,"contributors":["Sørensen, Mia Dahl","Olsen, Rikke Frydendahl Sick","Burton, Mark","Kavan, Stephanie","Petterson, Stine Asferg","Thomassen, Mads","Kruse, Torben Arvid","Meyer, Morten","Kristensen, Bjarne Winther"],"cuid":["S02-100.00-769010"],"filters":{"added":"2025-01","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Sørensen, Mia Dahl"],"keyword":["Glioblastoma","Interferon","Microglia","Stat","chemo resistance"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-SDR","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"microglia induce an interferon stimulated gene expression profile in glioblastoma and increase glioblastoma resistance to temozolomide","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1111/nan.13016","version":"Published Version"},"id":"S02-100.00-769010","identifier":[{"id":"PMC11618491","type":"pmcid"},{"id":"39558550","type":"pmid"},{"id":"85209898435","type":"scopus"}],"ids":["ku-85d9de0e-77cd-48ba-8065-c0c8d1292378","sdu-d19cd11e-4d19-4f49-80f3-c9500ae3dc66"],"keyword":["STAT","chemo-resistance","glioblastoma","interferon","microglia"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-D60F5F36769DA092DF680BD686C812F0"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/278289006/Neuropathology_Appl_Neurobio_-_2024_-_S_rensen_-_Microglia_induce_an_interferon_stimulated_gene_expression_profile_in.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://curis.ku.dk/ws/files/413623338/Neuropathology_Appl_Neurobio_2024_S_rensen_Microglia_induce_an_interferon_stimulated_gene_expression_profile_in.pdf","version":"Published Version"},{"access":"oa","lic