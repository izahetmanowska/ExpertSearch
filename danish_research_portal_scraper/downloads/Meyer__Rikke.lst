 Jesper","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Line","key":"hansenpau","last":"Hansen","locid":"729ea402-8050-4923-a2a1-2bfeb5a6fd63","name":"Hansen, Line","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jørgen","key":"kjemspau","last":"Kjems","locid":"f5915d75-aca3-437a-9a9d-f4fdfef7accd","name":"Kjems, Jørgen","orcid":"0000-0003-4128-9317","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rikke Louise","key":"meyerpau","last":"Meyer","locid":"f1caa4f6-bc6e-459a-a976-8843c7ea7ff3","name":"Meyer, Rikke Louise","orcid":"0000-0002-6485-5134","rank":6,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-c08b80d4-f4fc-4332-ad06-db741e92b0ac"],"src":["AU Aarhus University"],"title":"A targeting ligand for drug delivery to Staphylococcus aureus biofilms","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-239204","year":"2016","yearsub":"2016"}
{"abstract":"Epigallocatechin-3-gallate (EGCG) is the major polyphenol in green tea. It has antimicrobial properties and disrupts the ordered structure of amyloid fibrils involved in human disease. The antimicrobial effect of EGCG against the opportunistic pathogen Pseudomonas aeruginosa has been shown to involve disruption of quorum sensing (QS). Functional amyloid fibrils in P. aeruginosa (Fap) are able to bind and retain quorum-sensing molecules, suggesting that EGCG interferes with QS through structural remodeling of amyloid fibrils. Here we show that EGCG inhibits the ability of Fap to form fibrils; instead, EGCG stabilizes protein oligomers. Existing fibrils are remodeled by EGCG into non-amyloid aggregates. This fibril remodeling increases the binding of pyocyanin, demonstrating a mechanism by which EGCG can affect the QS function of functional amyloid. EGCG reduced the amyloid-specific fluorescent thioflavin T signal in P. aeruginosa biofilms at concentrations known to exert an antimicrobial effect. Nanoindentation studies showed that EGCG reduced the stiffness of biofilm containing Fap fibrils but not in biofilm with little Fap. In a combination treatment with EGCG and tobramycin, EGCG had a moderate effect on the minimum bactericidal eradication concentration against wild-type P. aeruginosa biofilms, whereas EGCG had a more pronounced effect when Fap was overexpressed. Our results provide a direct molecular explanation for the ability of EGCG to disrupt P. aeruginosa QS and modify its biofilm and strengthens the case forEGCGas a candidate in multidrug treatment of persistent biofilm infections.","author_count":12,"contributors":["Stenvang, Marcel R.","Dueholm, Morten Simonsen","Vad, Brian S","Seviour, Thomas","Zeng, Guanghong","Geifman-Shochat, Susana","Søndergaard, Mads Toft","Christiansen, Gunna","Meyer, Rikke Louise","Kjelleberg, Staffan","Nielsen, Per Halkjær","Otzen, Daniel E."],"cuid":["S02-084.94-001084"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["Asia, East","Asia, South","OECD","Oceania"],"corresponding_author":["Otzen, Daniel E."],"country":["Australia","China","Singapore"],"glorg":["All Global Affiliations","Nanyang Technological University","Singapore Centre of Environmental Life Sciences Engineering (SCELSE) Nanyang Technological University","Sino-Danish Center for Education and Research","Sino-Danish Centre for Education and Research","University of New South Wales"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"epigallocatechin gallate remodels overexpressed functional amyloids in pseudomonas aeruginosa and increases biofilm susceptibility to antibiotic treatment","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC5159513/pdf/zbc26540.pdf","version":"Published Version"},"id":"S02-084.94-001084","identifier":[{"id":"85006247399","type":"scopus"},{"id":"PMC5159513","type":"pmcid"},{"id":"WOS:000391568200026","type":"wos"},{"id":"27784787","type":"pmid"}],"ids":["aau-14f7ce8a-44b9-4626-a38c-628da2dfb7c6","au-f40f96a8-3d02-459b-b1a8-c4375c526e7d"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-67505C7D5A4BD7E9D433D3ADF26D91EB"],"oa_link":[{"access":"oa","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC5159513/pdf/zbc26540.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Molecular Biology and Genetics","Aarhus University, Natural Sciences, Interdisciplinary Nanoscience Center, Interdisciplinary Nanoscience Center - INANO-Kemi, iNANO-huset"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"cn","key":"sino danish centre for education and research","loc":["China","Asia, East"],"name":"Sino-Danish Centre for Education and Research","used":1},{"affno":"3","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (ENG)","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience, Center for Microbial Communities","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience, Section of Biotechnology"],"nora_code":"DI-U-AAU","used":1},{"affno":"4","country":"sg","key":"singapore centre of environmental life sciences engineering nanyang technological university","loc":["Singapore","Asia, South"],"name":"Singapore Centre of Environmental Life Sciences Engineering (SCELSE) Nanyang Technological University","used":1},{"affno":"5","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1},{"affno":"6","country":"sg","key":"nanyang technological university","loc":["Singapore","Asia, South"],"name":"Nanyang Technological University","used":1},{"affno":"7","country":"au","key":"university of new south wales","loc":["Australia","Oceania","OECD"],"name":"University of New South Wales","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Marcel","key":"stenvangpau","last":"Stenvang","locid":"47bd92dc-cf83-4671-88ae-9f31b130c644","name":"Stenvang, Marcel","rank":1,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Morten S.","key":"dueholmpau","last":"Dueholm","locid":"0824b5d0-8995-42b9-9df4-6e9996430c39","name":"Dueholm, Morten Simonsen","name_org":"Dueholm, Morten S.","orcid":"0000-0003-4135-2670","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Brian S","key":"vadpau","last":"Vad","locid":"1b8ed031-e42f-4935-8151-34489d20687b","name":"Vad, Brian S","rank":3,"rolecode":"pau"},{"affno":"4 5","corresponding":null,"first":"Thomas","key":"seviourpau","last":"Seviour","name":"Seviour, Thomas","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Guanghong","key":"zengpau","last":"Zeng","locid":"41d64164-8293-4f51-b1b8-96ac2ccc6db5","name":"Zeng, Guanghong","rank":5,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Susana","key":"geifmanshochatpau","last":"Geifman-Shochat","name":"Geifman-Shochat, Susana","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Mads T.","key":"søndergaardpau","last":"Søndergaard","locid":"1febcb26-0ee5-44f3-a552-5ec579cc8727","name":"Søndergaard, Mads Toft","name_org":"Søndergaard, Mads T.","orcid":"0000-0001-6779-5109","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Gunna","key":"christiansenpau","last":"Christiansen","locid":"64bd6216-e754-4f79-b494-6da91e9e0207","name":"Christiansen, Gunna","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rikke Louise","key":"meyerpau","last":"Meyer","locid":"f1caa4f6-bc6e-459a-a976-8843c7ea7ff3","name":"Meyer, Rikke Louise","orcid":"0000-0002-6485-5134","rank":9,"rolecode":"pau"},{"affno":"5 7","corresponding":null,"first":"Staffan","key":"kjellebergpau","last":"Kjelleberg","name":"Kjelleberg, Staffan","rank":10,"rolecode":"pau"},{"affno":"3 6","corresponding":null,"country":"dk","first":"Per Halkjær","key":"nielsenpau","last":"Nielsen","locid":"8321dd0d-5e0c-4334-81a7-ece0b4b66f4c","name":"Nielsen, Per Halkjær","orcid":"0000-0002-6402-1877","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Daniel E","key":"otzenpau","last":"Otzen","name":"Otzen, Daniel E","rank":11,"rolecode":"pau"}],"pmid":["27784787"],"pub":{"doi":"10.1074/jbc.m116.739953","issn":["00219258","10678816"],"issn_org":["00219258"],"issue":"51","journal":"The Journal of Biological Chemistry","pages":"26540-26553","publisher":"American Society for Biochemistry and Molecular Biology","status":"p","title":"The Journal of Biological Chemistry","volume":"291"},"review":"Peer Reviewed","scoID":["2-s2.0-85006247399"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["aau-14f7ce8a-44b9-4626-a38c-628da2dfb7c6","au-f40f96a8-3d02-459b-b1a8-c4375c526e7d"],"src":["AAU Aalborg University","AU Aarhus University"],"title":"Epigallocatechin Gallate Remodels overexpressed Functional Amyloids in Pseudomonas aeruginosa and Increases Biofilm Susceptibility to Antibiotic Treatment","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-084.94-001084","year":"2016","yearsub":"2016"}
{"abstract":"Biofilms formed by Staphylococcus aureus is a serious complication to the use of medical implants. A central part of the pathogenesis relies on S. aureus’ ability to adhere to host extracellular matrix proteins, which adsorb to medical implants and stimulate biofilm formation. Being coagulase positive, S. aureus furthermore induces formation of fibrin fibers from fibrinogen in the blood. Consequently, we hypothesized that fibrin is a key component of the extracellular matrix of S. aureus biofilms under in vivo conditions, and that the recalcitrance of biofilm infections can be overcome by combining antibiotic treatment with a fibrinolytic drug. We quantified S. aureus USA300 biofilms grown on peg-lids in brain heart infusion (BHI) broth with 0%–50% human plasma. Young (2 h) and mature (24 h) biofilms were then treated with streptokinase to determine if this lead to dispersal. Then, the minimal biofilm eradication concentration (MBEC) of 24 h old biofilms was measured for vancomycin and daptomycin alone or in combination with 10 µg/mL rifampicin in the presence or absence of streptokinase in the antibiotic treatment step. Finally, biofilms were visualized by confocal laser scanning microscopy. Addition of human plasma stimulated biofilm formation in BHI in a dose-dependent manner, and biofilms could be partially dispersed by streptokinase. The biofilms could be eradicated with physiologically relevant concentrations of streptokinase in combination with rifampicin and vancomycin or daptomycin, which are commonly used antibiotics for treatment of S. aureus infections. Fibronolytic drugs have been used to treat thromboembolic events for decades, and our findings suggest that their use against biofilm infections has the potential to improve the efficacy of antibiotics in treatment of S. aureus biofilm infections.","author_count":7,"contributors":["Jørgensen, Nis Pedersen","Zobek, Natalia","Dreier, Cindy","Haaber, Jakob","Ingmer, Hanne","Larsen, Ole Halfdan","Meyer, Rikke Louise"],"cuid":["S02-100.00-018419"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"streptokinase treatment reverses biofilm associated antibiotic resistance in staphylococcus aureus","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/microorganisms4030036","version":"Published Version"},"id":"S02-100.00-018419","identifier":[{"id":"27681928","type":"pmid"},{"id":"85040548210","type":"scopus"},{"id":"PMC5039596","type":"pmcid"}],"ids":["au-4ee63dc9-c5a2-4580-8471-81ec264c4b1e","ku-97526c62-d4f3-48ea-9777-c6e9d4d863d5"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-B05CA1EC1A561C4EC8EAA2810A60F023"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/166158716/microorganisms_04_00036_1_.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/microorganisms4030036","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Infectious Diseases"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Veterinary and Animal Sciences, Food Safety and Zoonoses"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Nis Pedersen","key":"jørgensenpau","last":"Jørgensen","locid":"ac385492-f707-4053-bc6e-965ba8f60360","name":"Jørgensen, Nis Pedersen","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Natalia","key":"zobekpau","last":"Zobek","locid":"65d932aa-b4c6-4154-9d14-50d583d324e2","name":"Zobek, Natalia","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Cindy","key":"dreierpau","last":"Dreier","locid":"5177aea4-a419-4fdf-8d72-3e6e3a11e11b","name":"Dreier, Cindy","rank":3,"rolecode":"pau"},{"affno":"2","first":"Jakob Krause","key":"haaberpau","last":"Haaber","locid":"8003db93-f327-4cbc-ac20-8065a0eb45f5","name":"Haaber, Jakob Krause","rank":4,"rolecode":"pau"},{"affno":"2","first":"Hanne","key":"ingmerpau","last":"Ingmer","locid":"abe2cd31-84e7-4f06-81a3-33e08bf93b8f","name":"Ingmer, Hanne","orcid":"0000-0002-8350-5631","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ole Halfdan","key":"larsenpau","last":"Larsen","locid":"f280dbc7-1019-42be-badb-da94300ffabd","name":"Larsen, Ole Halfdan","orcid":"0000-0001-5213-7349","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rikke Louise","key":"meyerpau","last":"Meyer","locid":"f1caa4f6-bc6e-459a-a976-8843c7ea7ff3","name":"Meyer, Rikke Louise","orcid":"0000-0002-6485-5134","rank":7,"rolecode":"pau"}],"pmid":["27681928"],"pub":{"doi":"10.3390/microorganisms4030036","issn":["20762607"],"issue":"3","journal":"Microorganisms","paperid":"36","status":"p","title":"Microorganisms","volume":"4"},"review":"Peer Reviewed","scoID":["2-s2.0-85040548210"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-4ee63dc9-c5a2-4580-8471-81ec264c4b1e","ku-97526c62-d4f3-48ea-9777-c6e9d4d863d5"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Streptokinase Treatment Reverses Biofilm-Associated Antibiotic Resistance in Staphylococcus aureus","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-018419","year":"2016","yearsub":"2016"}
{"abstract":"The oxidation of organic micro-pollutants by biogenic manganese oxide nanoparticles (BioMnOx) has been studied with respect to possible implementation of BioMnOx in wastewater treatment. For this it would be prerequisite that microbial Mn2+ oxidation and BioMnOx-driven pollutant removal can occur in situ, i.e. in the same reactor as the removal. Here we present the in situ reactivity of BioMnOx produced by Pseudomonas putida towards a range of micro-pollutants at environmentally relevant concentrations (10 mu g L-1). We found that in situ formed BioMnOx completely removed the steroid hormones estrone and 17-alpha ethinylestradiol, while only 26% removal of diclofenac was achieved. Ibuprofen, tebuconazole, carbamazepine, carbendazim, and terbutryn were not removed under in situ conditions. (C) 2014 Elsevier Ltd. All rights reserved.","author_count":3,"contributors":["Furgal, Karolina Monika","Meyer, Rikke Louise","Bester, Kai"],"cuid":["S01-000.00-203201"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Bester, Kai"],"keyword":["Advanced treatment","Biogenic manganese oxides","Degradation","Diclofenac","Emerging contaminants","Environment","Identification","Kinetics","Oxidation","Ozonation","Personal care products","Wastewater"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"removing selected steroid hormones biocides and pharmaceuticals from water by means of biogenic manganese oxide nanoparticles in situ at ppb levels","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84955336368","version":"Other Version"},"id":"S01-000.00-203201","identifier":[{"id":"84955336368","type":"scopus"},{"id":"25532770","type":"pmid"},{"id":"000357235400042","type":"wos"}],"ids":["au-813758b7-52ca-4e62-a3ab-c5483fa30a9c"],"keyword":["ACTIVATED CARBON FILTRATION","Advanced treatment","Biogenic manganese oxides","DEGRADATION","DICLOFENAC","ENVIRONMENT","Emerging contaminants","IDENTIFICATION","KINETICS","MN(II)","OXIDATIVE TRANSFORMATION","OZONATION","Oxidation","PERSONAL CARE PRODUCTS","Wastewater"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-1EC31CCB9C08EB5949925D39D0FE971C"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Interdisciplinary Nanoscience Center, Interdisciplinary Nanoscience Center - INANO-Kemi, iNANO-huset","Aarhus University, Technical Sciences, Department of Environmental Science, Department of Environmental Science - Environmental chemistry & toxicology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Karolina M.","key":"furgalpau","last":"Furgal","locid":"173cb0e7-bd7e-4557-8227-2c8e29b6c8bc","name":"Furgal, Karolina Monika","name_org":"Furgal, Karolina M.","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rikke L.","key":"meyerpau","last":"Meyer","locid":"f1caa4f6-bc6e-459a-a976-8843c7ea7ff3","name":"Meyer, Rikke Louise","name_org":"Meyer, Rikke L.","orcid":"0000-0002-6485-5134","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kai","key":"besterpau","last":"Bester","locid":"717de4ea-58cb-4536-be2b-41ab8238cf15","name":"Bester, Kai","orcid":"0000-0001-6348-416X","rank":3,"rolecode":"pau"}],"pmid":["25532770"],"pub":{"doi":"10.1016/j.chemosphere.2014.11.059","issn":["00456535","18791298"],"issn_org":["00456535"],"journal":"Chemosphere","pages":"321-326","publisher":"Elsevier Ltd","status":"p","title":"Chemosphere","volume":"136"},"review":"Peer Reviewed","scoID":["2-s2.0-84955336368"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-813758b7-52ca-4e62-a3ab-c5483fa30a9c"],"src":["AU Aarhus University"],"title":"Removing selected steroid hormones, biocides and pharmaceuticals from water by means of biogenic manganese oxide nanoparticles in situ at ppb levels","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-203201","year":"2015","yearsub":"2015"}
{"abstract":"Polymer brushes of poly(ethylene glycol) have long been considered the gold standard for antifouling surfaces that resist adsorption of biomolecules and attachment of microorganisms. However, despite displaying excellent resistance to protein adsorption, the polymer brush coatings cannot entirely avoid colonization by bacteria. Here we investigate and identify which non-proteinaceous bacterial adhesins challenge the antifouling properties of polymer brush coatings and how these challenges might be overcome. We quantified biofilm formation on a well-known polymer brush coating of poly(L-lysine)graft-poly(ethylene glycol) (PLL-g-PEG) on titanium. The coating successfully resisted colonization by Staphylococcus aureus and Pseudomonas aeruginosa, but not Staphylococcus epidermidis. This colonization pattern was also reflected on the adhesion forces measured on single bacterial cells. The biofilm produced from S. epidermidis on PLL-g-PEG were found to be rich in polysaccharides and extracellular DNA, and quantification of DNA, polysaccharides and proteins on PLL-g-PEG surfaces revealed that although the coating almost fully resisted protein adsorption, polysaccharides could adsorb, and exposure to DNA led to desorption of the polymer from the titanium surface. We hypothesized that this problem could be overcome by increasing the polymer brush density to better resist the penetration of DNA and polysaccharides into the polymer layer. Indeed, high density PLL-g-PEG brushes prepared by the recently discovered temperature-induced polyelectrolyte (TIP) grafting method resisted the interaction with DNA and polysaccharides, and therefore also the colonization by S. epidermidis. The TIP grafting is a simple improvement of PLL-g-PEG brush formation, and our results suggest that it provides an important advancement to the bacterial resistance by polymer brush coatings. Statement of Significance The antifouling properties of poly(ethylene glycol) brush coatings against protein adsorption are well documented, but it is not well understood why these coatings do not perform as well against bacterial colonization when tested against a wide range of species and over periods of days. Here we investigated bacterial colonization on poly(L-lysine)-graft-poly(ethylene glycol) (PLL-g-PEG) grafted on Ti, and revealed that bacteria relying mostly on polysaccharides and extracellular DNA for adhesion and biofilm formation could successfully colonize PLL-g-PEG coated surfaces. The coatings could not resist adsorption of polysaccharides, and DNA could even desorb the coatings from the Ti surface. Fortunately, the shortcomings of conventional PLL-g-PEG could be overcome by increasing the graft density, using the recently discovered and very simple grafting method, 'temperature-induced polyelectrolyte (TIP) grafting'. Our study highlights that it is of utmost importance to develop coatings which resist adsoprtion of non-proteinaceous bacterial adhesins such as polysaccharides and DNA, and we demonstrated that TIP grafted high density PLL-g-PEG coatings are promising materials to achieve diverse bacterial resistance. (C) 2015 Acta Materialia Inc. Published by Elsevier Ltd. All rights reserved.","author_count":3,"contributors":["Zeng, Guanghong","Ogaki, Ryosuke","Meyer, Rikke Louise"],"cuid":["S01-000.00-135542"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Ogaki, Ryosuke"],"keyword":["AFM","Bacterial Adhesion","Biofilm","Biofilm formation","Extracellular DNA","Intercellular adhesion","PLL g PEG","Poly ethylene glycol","Polyethylene oxide","Polymer brush","Pseudomonas aeruginosa","Self assembled monolayers","Staphylococcus epidermidis","Surface interactions"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"non proteinaceous bacterial adhesins challenge the antifouling properties of polymer brush coatings","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84940453267","version":"Other Version"},"id":"S01-000.00-135542","identifier":[{"id":"26093067","type":"pmid"},{"id":"84940453267","type":"scopus"},{"id":"000360867700007","type":"wos"}],"ids":["au-0af95f56-53f6-4ea5-90df-9dd994b5ff2a"],"keyword":["AFM","BIOFILM FORMATION","Bacterial adhesion","Biofilm","EXTRACELLULAR DNA","INTERCELLULAR-ADHESION","PLL-g-PEG","POLY(ETHYLENE GLYCOL)","POLYETHYLENE OXIDE","PSEUDOMONAS-AERUGINOSA","Polymer brush","SELF-ASSEMBLED MONOLAYERS","STAPHYLOCOCCUS-EPIDERMIDIS","SURFACE INTERACTIONS","ZWITTERIONIC MATERIALS"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-7053DB8E295C7B5EA2FD268F3A7C3A31"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Interdisciplinary Nanoscience Center, Interdisciplinary Nanoscience Center - INANO-Bioscience, iNANO-huset"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Guanghong","key":"zengpau","last":"Zeng","locid":"41d64164-8293-4f51-b1b8-96ac2ccc6db5","name":"Zeng, Guanghong","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ryosuke","key":"ogakipau","last":"Ogaki","locid":"3ee7810d-e08c-49e2-988e-20c5f9b98a85","name":"Ogaki, Ryosuke","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rikke L.","key":"meyerpau","last":"Meyer","locid":"f1caa4f6-bc6e-459a-a976-8843c7ea7ff3","name":"Meyer