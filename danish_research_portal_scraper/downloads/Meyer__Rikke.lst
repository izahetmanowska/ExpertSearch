6e-459a-a976-8843c7ea7ff3","name":"Meyer, Rikke Louise","orcid":"0000-0002-6485-5134","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Sebastian","key":"schlaferpau","last":"Schlafer","locid":"bcd4e1fe-3a80-4288-8b5f-d105f6f53982","name":"Schlafer, Sebastian","orcid":"0000-0003-2463-1926","rank":4,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-a4554b30-214a-4f5c-90aa-c3059d549165"],"src":["AU Aarhus University"],"title":"Multiple-enzyme treatment reduces biofilm formation in a highly acidogenic in vitro model","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-688080","year":"2023","yearsub":"2023"}
{"abstract":"Polyether ionophores are complex natural products known to transport various cations across biological membranes. While several members of this family are used in agriculture (e.g., as anti-coccidiostats) and have potent antibacterial activity, they are not currently being pursued as antibiotics for human use. Polyether ionophores are typically grouped as having similar functions, despite the fact that they significantly differ in structure; for this reason, how their structure and activity are related remains unclear. To determine whether certain members of the family constitute particularly interesting springboards for in-depth investigations and future synthetic optimization, we conducted a systematic comparative study of eight different polyether ionophores for their potential as antibiotics. This includes clinical isolates from bloodstream infections and studies of the compounds' effects on bacterial biofilms and persister cells. We uncover distinct differences within the compound class and identify the compounds lasalocid, calcimycin, and nanchangmycin as having particularly interesting activity profiles for further development. IMPORTANCE Polyether ionophores are complex natural products used in agriculture as anti-coccidiostats in poultry and as growth promoters in cattle, although their precise mechanism is not understood. They are widely regarded as antimicrobials against Gram-positive bacteria and protozoa, but fear of toxicity has so far prevented their use in humans. We show that ionophores generally have very different effects on Staphylococcus aureus, both in standard assays and in more complex systems such as bacterial biofilms and persister cell populations. This will allow us to focus on the most interesting compounds for future in-depth investigations and synthetic optimizations.","author_count":9,"contributors":["Wollesen, Malene","Mikkelsen, Kasper","Tvilum, Marie","Vestergaard, Martin","Wang, Mikala","Meyer, Rikke Louise","Ingmer, Hanne","Poulsen, Thomas","Tørring, Thomas"],"cuid":["S02-100.00-692015"],"filters":{"added":"2023-07","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Animals","Anti Bacterial Agents therapeutic use","Anti Infective Agents pharmacology","Antibiotics","Antimicrobial resistance","Biofilm","Biofilms","Cattle","Gram Positive Bacteria","Humans","Ionophore","Ionophores pharmacology","Microbial Sensitivity Tests","Natural antimicrobial products","Persister cells","Staphylococcus aureus"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-HO-CDR","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"polyether ionophore antibiotics target drug resistant clinical isolates persister cells and biofilms","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1128/spectrum.00625-23","version":"Published Version"},"id":"S02-100.00-692015","identifier":[{"id":"85172320093","type":"scopus"},{"id":"37289074","type":"pmid"},{"id":"PMC10433871","type":"pmcid"}],"ids":["au-8241a10e-5778-4631-abdd-509176b0f370","ku-688b867f-e2a3-4fa3-9bf5-016db5c181af"],"keyword":["Animals","Anti-Bacterial Agents/therapeutic use","Anti-Infective Agents/pharmacology","Biofilms","Cattle","Gram-Positive Bacteria","Humans","Ionophores/pharmacology","Microbial Sensitivity Tests","Staphylococcus aureus","antibiotics","antimicrobial resistance","biofilm","ionophore","natural antimicrobial products","persister cells"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-7A0F51E4F8DAF2BFB3A80CF3C27F3689"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1128/spectrum.00625-23","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/367730675/wollesen_et_al_2023_polyether_ionophore_antibiotics_target_drug_resistant_clinical_isolates_persister_cells_and_biofilms.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Chemistry"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Veterinary and Animal Sciences, Food Safety and Zoonoses"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Malene","key":"wollesenpau","last":"Wollesen","locid":"07e0c7b4-a3f4-4c7d-be07-ecdf5ad1a948","name":"Wollesen, Malene","rank":1,"rolecode":"pau"},{"affno":"2","first":"Kasper","key":"mikkelsenpau","last":"Mikkelsen","locid":"be574932-0122-4546-8d9c-199a570b8674","name":"Mikkelsen, Kasper","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Marie Selch","key":"tvilumpau","last":"Tvilum","locid":"608dd1e1-544e-43c4-9b4e-d1c1a2f9b12f","name":"Tvilum, Marie","name_org":"Tvilum, Marie Selch","rank":3,"rolecode":"pau"},{"affno":"2","first":"Martin","key":"vestergaardpau","last":"Vestergaard","locid":"0d6ed4a6-2995-46f9-9402-9e1ce154e032","name":"Vestergaard, Martin","orcid":"0000-0002-3840-3193","rank":4,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"first":"Mikala","key":"wangpau","last":"Wang","locid":"7f0a4d8a-4a88-4382-84c3-58e5151bb8cf","name":"Wang, Mikala","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rikke L","key":"meyerpau","last":"Meyer","locid":"f1caa4f6-bc6e-459a-a976-8843c7ea7ff3","name":"Meyer, Rikke Louise","name_org":"Meyer, Rikke L","orcid":"0000-0002-6485-5134","rank":6,"rolecode":"pau"},{"affno":"2","first":"Hanne","key":"ingmerpau","last":"Ingmer","locid":"abe2cd31-84e7-4f06-81a3-33e08bf93b8f","name":"Ingmer, Hanne","orcid":"0000-0002-8350-5631","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Thomas","key":"poulsenpau","last":"Poulsen","locid":"9a15ee93-bb6a-4e1f-bb03-aac8b87ecf90","name":"Poulsen, Thomas","orcid":"0000-0002-0763-9996","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Thomas","key":"tørringpau","last":"Tørring","locid":"b03df36b-0252-4e5a-aeee-7113f77cad12","name":"Tørring, Thomas","orcid":"0000-0001-5257-2121","rank":9,"rolecode":"pau"}],"pmid":["37289074"],"pub":{"doi":"10.1128/spectrum.00625-23","issn":["21650497"],"issue":"4","journal":"Microbiology Spectrum","paperid":"e0062523","publisher":"American Society for Microbiology","status":"p","title":"Microbiology Spectrum","volume":"11"},"review":"Peer Reviewed","scoID":["2-s2.0-85172320093"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-8241a10e-5778-4631-abdd-509176b0f370","ku-688b867f-e2a3-4fa3-9bf5-016db5c181af"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Polyether Ionophore Antibiotics Target Drug-Resistant Clinical Isolates, Persister Cells, and Biofilms","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-692015","year":"2023","yearsub":"2023"}
{"abstract":"Introduction: We identified risk factors and outcomes associated with SARS-CoV-2 infection in pregnancy in a universally tested population according to disease severity and validated information on SARS-CoV-2 during pregnancy in national health registers in Denmark. Material and methods: Cohort study using data from national registers and medical records including all pregnancies between March 1, 2020 and February 28, 2021. We compared women with a validated positive SARS-CoV-2 test during pregnancy with non-infected pregnant women. Risk factors and pregnancy outcomes were assessed by Poisson and Cox regression models and stratified according to disease severity defined by hospital admission status and admission reason (COVID-19 symptoms or other). Using medical record data on actual period of pregnancy, we calculated predictive values of the SARS-CoV-2 diagnosis in pregnancy in the registers. Results: SARS-CoV-2 infection was detected in 1819 (1.6%) of 111 185 pregnancies. Asthma was associated with infection (relative risk [RR] 1.63, 95% confidence interval [CI] 1.28–2.07). Risk factors for severe COVID-19 disease requiring hospital admission were high body mass index (median ratio 1.06, 95% CI 1.04–1.09), asthma (RR 7.47, 95% CI 3.51–15.90) and gestational age at the time of infection (gestational age 28–36 vs < 22: RR 3.53, 95% CI 1.75–7.10). SARS-CoV-2-infected women more frequently had hypertensive disorders in pregnancy (adjusted hazard ratio [aHR] 1.31, 95% CI 1.04–1.64), early pregnancy loss (aHR 1.37, 95% CI 1.00–1.88), preterm delivery before gestational age 28 (aHR 2.31, 95% CI 1.01–5.26), iatrogenically preterm delivery before gestational age 37 (aHR 1.49, 95% CI 1.01–2.19) and small-for-gestational age children (aHR 1.28, 95% CI 1.05–1.54). The associations were stronger among women admitted to hospital for any reason. The validity of the SARS-CoV-2 diagnosis in relation to pregnancy in the registers compared with medical records showed a negative predictive value of 99.9 (95% CI 99.9–100.0) and a positive predictive value of 82.1 (95% CI 80.4–83.7). Conclusions: Women infected with SARS-CoV-2 during pregnancy were at increased risk of hypertensive disorders in pregnancy, early pregnancy loss, preterm delivery and having children small for gestational age. The validity of Danish national registers was acceptable for identification of SARS-CoV-2 infection during pregnancy.","author_count":50,"contributors":["Aabakke, Anna J. M.","Petersen, Tanja G.","Wøjdemann, Karen","Ibsen, Mette H.","Jonsdottir, Fjola","Rønneberg, Elisabeth","Andersen, Charlotte S.","Hammer, Anne","Clausen, Tine D.","Milbak, Julie","Burmester, Lars","Zethner, Rikke","Lindved, Birgitte","Thorsen-Meyer, Annette","Khalil, Mohammed R.","Henriksen, Birgitte","Jønsson, Lisbeth","Andersen, Lise L. T.","Karlsen, Kamilla K.","Pedersen, Monica L.","Hedermann, Gitte","Vestgaard, Marianne","Thisted, Dorthe","Fallesen, Agnethe N.","Johansson, Josephine N.","Møller, Ditte C.","Dubietyte, Greta","Andersson, Charlotte Brix","Farlie, Richard","Skaarup Knudsen, Ane-Kersti","Hansen, Lea","Hvidman, Lone","Sørensen, Anne","Rathcke, Sidsel L.","Rubin, Katrine H.","Petersen, Lone K.","Jørgensen, Jan S.","Krebs, Lone","Bliddal, Mette"],"cuid":["S04-088.01-005271"],"filters":{"added":"2023-04","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"corresponding_author":["Aabakke, Anna J. M."],"keyword":["Abortion Spontaneous","Adult","Asthma","COVID 19 Testing","COVID 19 diagnosis","Child","Cohort Studies","Covid 19","Female","Humans","Hypertension Pregnancy Induced","Infant Newborn","Patient Acuity","Pregnancy","Pregnancy Complications","Pregnancy Complications Infectious diagnosis","Pregnancy Outcome","Pregnancy Outcome epidemiology","Premature Birth epidemiology","Prospective Studies","Risk Factors","SARS CoV 2","Severe acute respiratory syndrome coronavirus 2","Validation study","obstetric delivery"],"level":"sc