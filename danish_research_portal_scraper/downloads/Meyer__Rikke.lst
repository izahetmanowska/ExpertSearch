iversities"],"PST":["Published"]},"sid":["au-63f70006-fa95-482c-b2c4-ab1f84f87449"],"src":["AU Aarhus University"],"title":"Ultra-dense poly(ethylene glycol) coating reduce Staphylococcus epidermis biofilm formation on titanium implants and increase antibiotic susceptibility","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-186412","year":"2016","yearsub":"2016"}
{"abstract":"Achromobacter species have attracted attention as emerging pathogens in cystic fibrosis. The clinical significance of Achromobacter infection is not yet fully elucidated; however, their intrinsic resistance to antimicrobials and ability to form biofilms renders them capable of establishing long-term chronic infections. Still, many aspects of Achromobacter biofilm formation remain uncharacterized. In this study, we characterized biofilm formation in clinical isolates of Achromobacter and investigated the effect of challenging the biofilm with antimicrobials and/or enzymes targeting the extracellular matrix. In vitro biofilm growth and subsequent visualization by confocal microscopy revealed distinctly different biofilm morphotypes: a surface-attached biofilm morphotype of small aggregates and an unattached biofilm morphotype of large suspended aggregates. Aggregates consistent with our in vitro findings were visualized in sputum samples from cystic fibrosis patients using an Achromobacter specific peptide nucleic acid fluorescence in situ hybridization (PNA-FISH) probe, confirming the presence of Achromobacter biofilms in the CF lung. High antibiotic tolerance was associated with the biofilm phenotype, and biocidal antibiotic concentrations were up to 1000 fold higher than for planktonic cultures. Treatment with DNase or subtilisin partially dispersed the biofilm and reduced the tolerance to specific antimicrobials, paving the way for further research into using dispersal mechanisms to improve treatment strategies.","author_count":4,"contributors":["Nielsen, Signe Maria","Nørskov-Lauritsen, Niels","Bjarnsholt, Thomas","Meyer, Rikke Louise"],"cuid":["S02-100.00-027458"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Journal Article"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-HO-CDR","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"achromobacter species isolated from cystic fibrosis patients reveal distinctly different biofilm morphotypes","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/microorganisms4030033","version":"Published Version"},"id":"S02-100.00-027458","identifier":[{"id":"27681927","type":"pmid"},{"id":"PMC5039593","type":"pmcid"},{"id":"85020026682","type":"scopus"}],"ids":["au-cc04246e-282c-4a4d-a1f2-495d33f48366","ku-45dab7de-ff71-423e-93a0-d6bcc755cca2"],"keyword":["Journal Article"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-015A30306F35F55E1CAB2E832BB9B291"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/180820365/microorganisms_04_00033.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/microorganisms4030033","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)","Science / Technology (SCI)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Clinical Microbiology"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Immunology and Microbiology, Department of Immunology and Microbiology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Signe M","key":"nielsenpau","last":"Nielsen","locid":"d1316f0c-0b76-4efe-8f69-89122076619c","name":"Nielsen, Signe Maria","name_org":"Nielsen, Signe M","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Niels","key":"nørskovlauritsenpau","last":"Nørskov-Lauritsen","locid":"89068fb2-6301-49b0-be19-410589959dcd","name":"Nørskov-Lauritsen, Niels","rank":2,"rolecode":"pau"},{"affno":"3","first":"Thomas","key":"bjarnsholtpau","last":"Bjarnsholt","locid":"cb3ccb7d-0415-40e5-9bba-c9bc26b6316d","name":"Bjarnsholt, Thomas","orcid":"0000-0002-8003-7414","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rikke L","key":"meyerpau","last":"Meyer","locid":"f1caa4f6-bc6e-459a-a976-8843c7ea7ff3","name":"Meyer, Rikke Louise","name_org":"Meyer, Rikke L","orcid":"0000-0002-6485-5134","rank":4,"rolecode":"pau"}],"pmid":["27681927"],"pub":{"doi":"10.3390/microorganisms4030033","issn":["20762607"],"issue":"3","journal":"Microorganisms","publisher":"MDPI AG","publisher_org":"M D P I AG","status":"p","title":"Microorganisms","volume":"4"},"review":"Peer Reviewed","scoID":["2-s2.0-85020026682"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-cc04246e-282c-4a4d-a1f2-495d33f48366","ku-45dab7de-ff71-423e-93a0-d6bcc755cca2"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Achromobacter Species Isolated from Cystic Fibrosis Patients Reveal Distinctly Different Biofilm Morphotypes","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-027458","year":"2016","yearsub":2017}
{"abstract":"Ny forskning fra Aalborg Universitet viser lovende potentialer for brugen af termiske kameraer i undersøgelse knyttet til trafik og bevægelse. De varmesensitive kameraer har flere fordele. For det første er man ude over problemstillingen med personidentifikation og dermed overvågning i offentlige rum. For det andet er metoden interessant, da ny forskning inden for Computer Vision-området giver mulighed for at registrere det, kameraet ”ser” som kvantitative data, der efterfølgende kan repræsenteres som bevægelseslinjer på kort eller såkaldte ”heat maps”, der viser intensiteter. Metoderne med termiske kameraer i trafikplanlægning giver dermed nye muligheder for valide datasæt, der omfatter fodgængere såvel som biler. I denne artikel diskuteres dette med udgangspunkt i et forskningsprojekt med termisk kameraovervågning i universitetets bygning på havnefronten i Aalborg.","author_count":10,"contributors":["Jensen, Ole B.","Moeslund, Thomas B.","Gade, Rikke","Jørgensen, Anders","Lassen, Claus","Frølund, Morten","Lange, Ida Sofie Gøtzsche","Murzea, Diana L.","Meyer, Mark A.","Andersen, Nadja Tønder"],"cuid":["S01-000.00-106916"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Mobilitet","Termiske kameraer","Tracking","Trafikplanlægning"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"termiske kameraer i fremtidens trafikplanlægning","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://asp.vejtid.dk/Artikler/2016/05/8417.pdf","version":"Published Version"},"id":"S01-000.00-106916","ids":["aau-c3f40208-060f-4ecc-95ce-66090d975286"],"keyword":["Mobilitet","Termiske kameraer","Tracking","Trafikplanlægning"],"lang":"Danish","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-5F2BC4CB36A8BE748E2D1EE37607AD7D"],"oa_link":[{"access":"oa","type":"rem","url":"http://asp.vejtid.dk/Artikler/2016/05/8417.pdf","version":"Published Version"}],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (TECH)","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology, Centre for Mobility and Urban Studies","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology, Mobility and Tracking Technologies","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology, Urban Design","Aalborg University, The Technical Faculty of IT and Design, Department of Sustainability and Planning, Danish Centre for Spatial Planning"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Ole B.","key":"jensenpau","last":"Jensen","locid":"ac94dbec-c800-4674-8891-af368f9ce432","name":"Jensen, Ole B.","orcid":"0000-0002-6804-5008","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Thomas B.","key":"moeslundpau","last":"Moeslund","locid":"fcec4162-4096-4260-af44-3fc685d0334b","name":"Moeslund, Thomas B.","orcid":"0000-0001-7584-5209","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rikke","key":"gadepau","last":"Gade","locid":"2d73afeb-1b09-436d-9116-8693c62b7c67","name":"Gade, Rikke","orcid":