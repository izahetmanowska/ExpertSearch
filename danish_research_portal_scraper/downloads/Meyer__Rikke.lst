ngelpau","last":"Jensen-Fangel","name":"Jensen-Fangel, Søren","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Ryosuke","key":"ogakipau","last":"Ogaki","name":"Ogaki, Ryosuke","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Guanghong","key":"zengpau","last":"Zeng","name":"Zeng, Guanghong","rank":6,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Mikkel","key":"johansenpau","last":"Johansen","name":"Johansen, Mikkel","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mikala","key":"wangpau","last":"Wang","locid":"7f0a4d8a-4a88-4382-84c3-58e5151bb8cf","name":"Wang, Mikala","rank":8,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Holger","key":"rhodepau","last":"Rhode","name":"Rhode, Holger","rank":9,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Rikke","key":"meyerpau","last":"Meyer","name":"Meyer, Rikke","rank":10,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-2c0bf491-a6e1-4a7c-b713-88c53238da11"],"src":["AU Aarhus University"],"title":"Antibiotic susceptibility of biofilms is enhanced by ulta-dense PLL-g-PEG coating of medical implants","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-154522","year":"2018","yearsub":"2018"}
{"abstract":"The development of bacteria-specific infection radiotracers is of considerable interest to improve diagnostic accuracy and enabling therapy monitoring. The aim of this study was to determine if the previously reported radiolabelled 1,4,7,10-tetraazacyclododecane-N,N′,N″,N‴-tetraacetic acid (DOTA) conjugated peptide [ 68Ga]Ga-DOTA-K-A9 could detect a staphylococcal infection in vivo and distinguish it from aseptic inflammation. An optimized [ 68Ga]Ga-DOTA-K-A9 synthesis omitting the use of acetone was developed, yielding 93 ± 0.9% radiochemical purity. The in vivo infection binding specificity of [ 68Ga]Ga-DOTA-K-A9 was evaluated by micro positron emission tomography/magnetic resonance imaging of 15 mice with either subcutaneous Staphylococcus aureus infection or turpentine-induced inflammation and compared with 2-deoxy-2-[ 18F]fluoro-D-glucose ([ 18F]FDG). The scans showed that [ 68Ga]Ga-DOTA-K-A9 accumulated in all the infected mice at injected doses ≥3.6 MBq. However, the tracer was not found to be selective towards infection, since the [ 68Ga]Ga-DOTA-K-A9 also accumulated in mice with inflammation. In a concurrent in vitro binding evaluation performed with a 5-carboxytetramethylrhodamine (TAMRA) fluorescence analogue of the peptide, TAMRA-K-A9, the microscopy results suggested that TAMRA-K-A9 bound to an intracellular epitope and therefore preferentially targeted dead bacteria. Thus, the [ 68Ga]Ga-DOTA-K-A9 uptake observed in vivo is presumably a combination of local hyperemia, vascular leakiness and/or binding to an epitope present in dead bacteria.","author_count":14,"contributors":["Nielsen, Karin Michaelsen","Jørgensen, Nis P","Kyneb, Majbritt H","Borghammer, Per","Meyer, Rikke L","Thomsen, Trine Rolighed","Bender, Dirk","Jensen, Svend Borup","Nielsen, Ole L","Alstrup, Aage K O"],"cuid":["S03-099.96-004537"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"keyword":["Bacterial infection","Fluorescence","Ga Ga DOTA K A9","Gallium 68","PET","S aureus","murine models"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GTS","DI-U"],"level3":{"GTS":["DI-GTS-ALL","DI-GTS-DTCI"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-GTS-DTCI","DI-U-AAU","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"preclinical evaluation of potential infection imaging probe sup 000000000068 sup ga ga dota k a000000000009 in sterile and infectious inflammation","src":["aau","au","ku"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/293586415/Preclinical_evaluation_of_potential_infection_imaging_probe_68Ga_Ga_DOTA_K_A9_in_sterile_and_infectious_inflammation.pdf","version":"Authors Final Version"},"id":"S03-099.96-004537","identifier":[{"id":"85051436957","type":"scopus"},{"id":"29790580","type":"pmid"}],"ids":["aau-5d669dcb-b479-4b93-8242-4dd94c51dd4a","au-b54d1ae6-a607-47be-9ee5-38b1e38f8767","ku-70c2a034-7c10-49ee-bf42-8630f5a908d5"],"keyword":["PET","S aureus","[ Ga]Ga-DOTA-K-A9","bacterial infection","fluorescence","gallium-68","murine models"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-D26F94D1CB58D1355C4255F3D2643275"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/293586415/Preclinical_evaluation_of_potential_infection_imaging_probe_68Ga_Ga_DOTA_K_A9_in_sterile_and_infectious_inflammation.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of 