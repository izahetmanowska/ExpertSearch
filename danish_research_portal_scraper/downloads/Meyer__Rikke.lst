":"pau"},{"affno":"9 5","corresponding":null,"first":"Jóhanna E","key":"torfadóttirpau","last":"Torfadóttir","name":"Torfadóttir, Jóhanna E","rank":11,"rolecode":"pau"},{"affno":"9","corresponding":null,"first":"Birna","key":"thórisdóttirpau","last":"Thórisdóttir","name":"Thórisdóttir, Birna","rank":12,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christel J. E.","key":"lambergallardtpau","last":"Lamberg-Allardt","name":"Lamberg-Allardt, Christel J. E.","rank":13,"rolecode":"pau"}],"pmid":["31916497"],"pub":{"doi":"10.1177/1403494819896878","issn":["14034948","16511905"],"issn_org":["14034948"],"issue":"6","journal":"Scandinavian Journal of Public Health","pages":"616-627","publisher":"SAGE Publications Ltd","status":"p","title":"Scandinavian Journal of Public Health","volume":"49"},"review":"Peer Reviewed","scoID":["2-s2.0-85077685212"],"search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-501c4e3a-c51c-4b0e-be2d-990e69de5b0e","ku-1e9e5927-7135-4637-b183-f6b961cf2d14"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Vitamin D status and current policies to achieve adequate vitamin D intake in the Nordic countries","type":"Journal Review","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-084.55-034385","year":"2021","yearsub":"2021"}
{"abstract":"Biofilm models are important tools to study the impact of bacterial metabolism and the effect of therapeutic measures on the caries process. Laboratory models consisting of few bacterial species are useful for high-throughput testing, but in-situ models reflect the complexity of the oral environment much better. The increased complexity typically results in a large variation in the amount of biofilm produced, not only between individuals but also between biofilms collected from the same person. Here, we designed a lower-jaw-splint with 3D-printed silicon inserts that protect the biofilm samples during growth and provide a standardized recession for each individual biofilm sample. We hypothesized that a standardized splint geometry reduces variation between replicate biofilm samples from the same individual and increases the amount of biofilm produced, compared to an in-situ-model without standardized geometry. The splints consisted of a 3D-printed metallic arch and two acrylic vestibular extensions. The extensions contained 3D-printed silicon inserts for biofilm carriers (4x4x1.5 mm). Each individual carrier was surrounded by silicon walls, recessed by 1.5 mm and kept in place by an undercut. 48-h biofilms were collected in 6-tuplicate (2 technical, 3 biological replicates) from five healthy participants, both with standardized splints and with ‘traditional’ splints where the carriers were fixed with sticky wax. The biovolume was determined by confocal microscopy. The coefficient of intra-individual variation was high for both systems, but slightly lower for the standardized splints (69 vs. 80). The average amount of biofilm was slightly lower on the standardized splints (124599 µm3±70284 SD vs. 163616 µm3±135033 SD), with no statistically significant difference (p=0.33, 2-sample t-test). The use of silicon inserts eased the handling of the biofilm samples.","author_count":5,"contributors":["Schlafer, Sebastian","Møllebjerg, Andreas","K. Johnsen, Karina","Nielsen, Signe Maria","Meyer, Rikke Louise"],"cuid":["S01-000.00-175484"],"event":{"end":"2020-07-11","place":"Online","start":"2020-07-09","title":"ORCA: 67th Congress of the European Organization for Caries Research","year":"2020"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"design of a new intraoral splint with 000000000003d printed inserts for dental biofilm collection","src":["au"],"src-code":["DI-U-AU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-175484","ids":["au-50eb4975-6769-4c09-a17b-8f03e1ac118b"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-198AA800AA285BAC2717A07CBFB3F983"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Dentistry and Oral Health, Department of Dentistry and Oral Health - Section for Oral Ecology and Caries Control"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Sebastian","key":"schlaferpau","last":"Schlafer","locid":"bcd4e1fe-3a80-4288-8b5f-d105f6f53982","name":"Schlafer, Sebastian","orcid":"0000-0003-2463-1926","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Andreas","key":"møllebjergpau","last":"Møllebjerg","locid":"4176d27b-9e84-42e2-9357-cd93796c3046","name":"Møllebjerg, Andreas","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Karina","key":"kambourakisjohnsenpau","last":"Kambourakis Johnsen","locid":"e6eea993-e93e-40a1-91a9-00475b587f63","name":"K. Johnsen, Karina","name_org":"Kambourakis Johnsen, Karina","orcid":"0000-0002-9764-8481","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Signe Maria","key":"nielsenpau","last":"Nielsen","locid":"d1316f0c-0b76-4efe-8f69-89122076619c","name":"Nielsen, Signe Maria","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rikke Louise","key":"meyerpau","last":"Meyer","locid":"f1caa4f6-bc6e-459a-a976-8843c7ea7ff3","name":"Meyer, Rikke Louise","orcid":"0000-0002-6485-5134","rank":5,"rolecode":"pau"}],"pub":{"issn":["00086568","1421976X"],"issn_org":["00086568"],"journal":"Caries Research","publisher":"S. Karger AG","status":"p","title":"Caries Research"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-50eb4975-6769-4c09-a17b-8f03e1ac118b"],"src":["AU Aarhus University"],"title":"Design of a new intraoral splint with 3D-printed inserts for dental biofilm collection","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-175484","year":"2020","yearsub":"2020"}
{"abstract":"The risk of foodborne diseases has increased over the last years. We have developed a simple, portable, and label-free optical sensor via aptamer recognition of Staphylococcus aureus at nanostructured plasmonic elements. The developed aptamers conjugated to a localized surface plasmon resonance (LSPR) sensing device were applied in both pure culture and artificially contaminated milk samples enabling a limit of detection of 10 3 CFU/mL for S. aureus in milk. There was no need for a pre-enrichment step, and the total analysis time decreased from 30 min to 120 s. Finite-difference time-domain was used to simulate the experimentally measured optical responses for a range of different sensor designs (100 and 200 nm disks), addressing the role of the near field and intrinsic refractive index sensitivity. A comparison of the aptamer to antibody-based recognition approaches showed that the thickness of the sensing layer was critical with a significantly larger response for the thinner aptamer layer. Comparison of differently sized metal nanostructures showed a significantly higher sensitivity for 200 nm diameter compared to 100 nm diameter disk structures resulting from both increases in bulk refractive index sensitivity and the extent to which the local field extends out from the metal surface. These findings confirmed that the developed gold nanodisk-based LSPR sensing chips could facilitate sensitive detection of S. aureus in food samples.","author_count":4,"contributors":["Khateb, Heba","Klös, Gunnar","Meyer, Rikke Louise","Sutherland, Duncan S"],"cuid":["S01-000.00-195599"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Detection","Food monitoring","Optical biosensors","Staphylococcus aureus"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"development of a label free lspr apta sensor for staphylococcus aureus detection","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85085842524","version":"Other Version"},"id":"S01-000.00-195599","identifier":[{"id":"85085842524","type":"scopus"}],"ids":["au-741b1dfc-bb24-4d9e-9096-9945cc9ec8c6"],"keyword":["CCP evaluation","LSPR apta-sensor","Staphylococcus aureus","detection","food monitoring","optical biosensors","plasmonic biosensor"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-1AB7F161442BD233C6D62795037BD787"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Interdisciplinary Nanoscience Center, Interdisciplinary Nanoscience Center - INANO-Fysik, iNANO-huset","Aarhus University, Natural Sciences, Interdisciplinary Nanoscience Center, Interdisciplinary Nanoscience Center - INANO-MBG, iNANO-huset"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Heba","key":"khatebpau","last":"Khateb","locid":"d98c6ee8-14ca-4dd9-afbb-71f6f71bed40","name":"Khateb, Heba","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Gunnar","key":"klöspau","last":"Klös","locid":"9830da81-d071-4e8d-9883-ce54870692f5","name":"Klös, Gunnar","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rikke Louise","key":"meyerpau","last":"Meyer","locid":"f1caa4f6-bc6e-459a-a976-8843c7ea7ff3","name":"Meyer, Rikke Louise","orcid":"0000-0002-6485-5134","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Duncan S","key":"sutherlandpau","last":"Sutherland","locid":"5c5c563f-ca05-4219-b60d-8a3d6303ff2f","name":"Sutherland, Duncan S","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1021/acsabm.0c00110","issn":["25766422"],"issue":"5","journal":"ACS Applied Bio Materials","pages":"3066-3077","publisher":"ACS Publications","status":"p","title":"ACS Applied Bio Materials","volume":"3"},"review":"Peer Reviewed","scoID":["2-s2.0-85085842524"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-741b1dfc-bb24-4d9e-9096-9945cc9ec8c6"],"src":["AU Aarhus University"],"title":"Development of a label-free LSPR-Apta sensor for Staphylococcus aureus detection","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-195599","year":"2020","yearsub":"2020"}
{"abstract":"Abstract: In this study, we used electrospun polycaprolactone (PCL) or a mixture of PCL and gelatin (Gel) in a mixed acidic solvent to develop antimicrobial electrospun nanofibers. Carboxyl-modified mesoporous silica nanoparticles (CMSNs) or CMSNs loaded with antibiotic drugs polymyxin B and vancomycin (CMSNs/ABs) were mixed with the electrospinning solution in concentrations of 1%, 2.5% and 5%. The nanofibers diameter measured between 122 and138 nm. Higher concentrations of gelatin or CMSNs increased hydrophilicity and degradability of the nanofibers. CMSNs enhanced nanofibers mechanical strength. PCL/Gel nanofibers incorporated with CMSNs/ABs (2.5% and 5%) showed high antibacterial efficiency against Pseudomonas aeruginosa and Staphylococcus aureus. Also bacterial cell adhesion decreased when 2.5% and 5% of CMSNs/ABs were incorporated in PCL/Gel mats. MTT and hemolysis assays indicated excellent biocompatibility of all types of electrospun nanofibers. This study confirms that a proper mixture of PCL, gelatin and CMSNs loaded with two antibiotics could offer antimicrobial activities with high biocompatibility and biodegradability properties. Graphic abstract: [Figure not available: see fulltext.].","author_count":6,"contributors":["Gounani, Zahra","Pourianejad, Sajedeh","Asadollahi, Mohammad Ali","Meyer, Rikke Louise","Rosenholm, Jessica M.","Arpanaei, Ayyoob"],"cuid":["S01-000.00-258807"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","Asia, Middle East","Europe, EU","Nordic","OECD"],"corresponding_author":["Arpanaei, Ayyoob"],"country":["Finland","Iran","United States"],"glorg":["All Global Affiliations","National Institute for Genetic Engineering and Biotechnology Iran","University of Isfahan","University of North Carolina","Åbo Akademi University"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"polycaprolactone gelatin nanofibers incorporated with dual antibiotic loaded carboxyl modified silica nanoparticles","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85091240439","version":"Other Version"},"id":"S01-000.00-258807","identifier":[{"id":"85091240439","type":"scopus"}],"ids":["au-e2d5d3b2-8b21-40b6-819d-d5ee4eebe604"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-17B5797DA57FF5000790B3C55D825F38"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Interdisciplinary Nanoscience Center, Interdisciplinary Nanoscience Center - INANO-Bioscience, iNANO-huset"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"ir","key":"national institute for genetic engineering and biotechnology iran","loc":["Iran","Asia, Middle East"],"name":"National Institute for Genetic Engineering and Biotechnology Iran","used":1},{"affno":"3","country":"ir","key":"university of isfahan","loc":["Iran","Asia, Middle East"],"name":"University of Isfahan","used":1},{"affno":"4","country":"fi","key":"åbo akademi university","loc":["Finland","Europe, EU","Nordic","OECD"],"name":"Åbo Akademi University","used":1},{"affno":"5","country":"us","key":"university of north carolina","loc":["United States","America, North","OECD"],"name":"University of North Carolina","used":1}],"person":[{"affno":"1 2 3 4","corresponding":null,"first":"Zahra","key":"gounanipau","last":"Gounani","locid":"b1f6af35-04d3-4ac3-954e-6c19fb039ec