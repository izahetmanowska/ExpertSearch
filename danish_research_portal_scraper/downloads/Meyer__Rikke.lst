rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Michel","key":"hébraudpau","last":"Hébraud","name":"Hébraud, Michel","rank":9,"rolecode":"pau"},{"affno":"7","corresponding":null,"first":"Zoran","key":"jaglicpau","last":"Jaglic","name":"Jaglic, Zoran","rank":10,"rolecode":"pau"},{"affno":"8","corresponding":null,"first":"Miroslava","key":"kačániovápau","last":"Kačániová","name":"Kačániová, Miroslava","rank":11,"rolecode":"pau"},{"affno":"9","first":"Susanne","key":"knøchelpau","last":"Knøchel","locid":"41a18653-7b8f-4399-b814-e7782826d4a6","name":"Knøchel, Susanne","orcid":"0000-0003-3777-7123","rank":12,"rolecode":"pau"},{"affno":"10","corresponding":null,"first":"Anália","key":"lourençopau","last":"Lourenço","name":"Lourenço, Anália","rank":13,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Filipe","key":"mergulhãopau","last":"Mergulhão","name":"Mergulhão, Filipe","rank":14,"rolecode":"pau"},{"affno":"11","corresponding":null,"country":"dk","first":"Rikke Louise","key":"meyerpau","last":"Meyer","locid":"f1caa4f6-bc6e-459a-a976-8843c7ea7ff3","name":"Meyer, Rikke Louise","orcid":"0000-0002-6485-5134","rank":15,"rolecode":"pau"},{"affno":"12","corresponding":null,"first":"George","key":"nychaspau","last":"Nychas","name":"Nychas, George","rank":16,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Manuel","key":"simõespau","last":"Simões","name":"Simões, Manuel","rank":17,"rolecode":"pau"},{"affno":"13","corresponding":null,"country":"dk","first":"Claus","key":"sternbergpau","last":"Sternberg","locid":"1a361d9b-bd73-4de8-80d9-df1a209d5898","name":"Sternberg, Claus","orcid":"0000-0002-2572-0288","rank":18,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Odile","key":"tressepau","last":"Tresse","name":"Tresse, Odile","rank":18,"rolecode":"pau"}],"pmid":["27868469"],"pub":{"doi":"10.1080/1040841x.2016.1208146","issn":["1040841X","15497828"],"issn_org":["1040841X"],"issue":"3","journal":"Critical Reviews in Microbiology","pages":"313-351","publisher":"Taylor and Francis Ltd.","status":"p","title":"Critical Reviews in Microbiology","volume":"43"},"review":"Peer Reviewed","scoID":["2-s2.0-85014963888"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-17700b93-2a6f-487f-8f61-5b37185785c9","dtu-76e6cdb3-2c33-4e1a-9f4a-f4376f662101","ku-35fca351-752a-481a-8859-4f1ccda58bfb"],"src":["AU Aarhus University","DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Critical review on biofilm methods","type":"Journal Review","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-095.14-014275","year":"2017","yearsub":"2016"}
{"abstract":"Extracellular DNA (eDNA) is a major matrix component of many bacterial biofilms. While the presence of eDNA and its role in biofilm stability have been demonstrated for several laboratory biofilms of oral bacteria, there is no data available on the presence and function of eDNA in in vivo grown dental biofilms. This study aimed to determine whether eDNA was part of the matrix in biofilms grown in situ in the absence of sucrose and whether treatment with DNase dispersed biofilms grown for 2.5, 5, 7.5, 16.5, or 24 h. Three hundred biofilms from 10 study participants were collected and treated with either DNase or heat-inactivated DNase for 1 h. The bacterial biovolume was determined with digital image analysis. Staining with TOTO®-1 allowed visualization of eDNA both on bacterial cell surfaces and, with a cloud-like appearance, in the intercellular space. DNase treatment strongly reduced the amount of biofilm in very early stages of growth (up to 7.5 h), but the treatment effect decreased with increasing biofilm age. This study proves the involvement of eDNA in dental biofilm formation and its importance for biofilm stability in the earliest stages. Further research is required to uncover the interplay of eDNA and other matrix components and to explore the therapeutic potential of DNase treatment for biofilm control.","author_count":4,"contributors":["Schlafer, Sebastian","Meyer, Rikke Louise","Dige, Irene","Regina, Viduthalai R."],"cuid":["S01-000.00-139330"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Biofilms","Confocal laser scanning microscopy","Extracellular DNA","Image analysis"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"extracellular dna contributes to dental biofilm stability","src":["au"],"src-code":["