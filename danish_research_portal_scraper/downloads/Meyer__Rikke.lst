locid":"70b6699e-a3fc-49e2-9052-08c02dfa5bae","name":"Okshevsky, Mira Ursula","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rikke Louise","key":"meyerpau","last":"Meyer","locid":"f1caa4f6-bc6e-459a-a976-8843c7ea7ff3","name":"Meyer, Rikke Louise","orcid":"0000-0002-6485-5134","rank":2,"rolecode":"pau"}],"pmid":["25017901"],"pub":{"doi":"10.1016/j.mimet.2014.07.010","issn":["01677012","18728359"],"issn_org":["01677012"],"journal":"Journal of Microbiological Methods","pages":"102-104","publisher":"Elsevier BV","publisher_org":"Elsevier B.V.","status":"p","title":"Journal of Microbiological Methods","volume":"105"},"review":"Peer Reviewed","scoID":["2-s2.0-84929513457"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-4a679bb6-9af8-4748-9594-86027265aba9"],"src":["AU Aarhus University"],"title":"Evaluation of flourescent stains for visualizing extracellular DNA in biofilms","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-171728","year":"2014","yearsub":"2014"}
{"abstract":"Epsilon-poly-L-lysine (ε-PL) is a natural antimicrobial cationic peptide which is generally regarded as safe (GRAS) as a food preservative. Although its antimicrobial activity is well documented, its mechanism of action is only vaguely described. The aim of this study was to clarify ε-PL's mechanism of action using Escherichia coli and Listeria innocua as model organisms. We examined ε-PL's effect on cell morphology and membrane integrity, and used an array of E. coli deletion mutants to study how specific outer membrane components affected the action of ε-PL. We furthermore studied its interaction with lipid bilayers using membrane models. In vitro cell studies indicated that divalent cations and the Hep I and II phosphate groups in the lipopolysaccharide-layer of E. coli are critical for ε-PL's binding efficiency. ε-PL removed the lipopolysaccharide-layer and affected cell morphology of E. coli, while L. innocua underwent minor morphological changes. Propidium iodide staining showed that ε-PL permeabilized the cytoplasmic membrane in both species, indicating the membrane as the site of attack. We compared the interaction with neutral or negatively charged membrane systems and showed that the interaction with ε-PL relied on negative charges on the membrane. Suspended membrane vesicles were disrupted by ε-PL, and a detergent-like disruption of E. coli membrane was confirmed by AFM imaging of supported lipid bilayers. We hypothesize that ε-PL destabilizes membranes in a carpet-like mechanism by interacting with negatively charged phospholipid head groups, which displace divalent cations and enforce a negative curvature folding on membranes that leads to formation of vesicles/micelles.","author_count":6,"contributors":["Hyldgaard, Morten","Mygind, Tina","Vad, Brian S","Stenvang, Marcel","Otzen, Daniel E","Meyer, Rikke Louise"],"cuid":["S01-000.00-187908"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-PR","DI-U"],"level3":{"OT":["Unspecified organisation"],"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-PR-OTH","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"the antimicrobial mechanism of action of epsilon poly l lysine","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1128/AEM.02204-14","version":"Other Version"},"id":"S01-000.00-187908","identifier":[{"id":"PMC4249222","type":"pmcid"},{"id":"84917679658","type":"scopus"},{"id":"25304506","type":"pmid"}],"ids":["au-6691e6b5-f4df-4f44-98bb-1b8f6327c057"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-605292C04DF2BC8B7BFC2E3DEE052F35"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1128/AEM.02204-14","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Interdisciplinary Nanoscience Center"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1},{"affno":"3","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["Dupont ApS (Nutrition & Health) - Denmark"],"nora_co