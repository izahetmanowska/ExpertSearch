5b587f63","name":"K. Johnsen, Karina","orcid":"0000-0002-9764-8481","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Mette-Rose","key":"jørgensenpau","last":"Jørgensen","name":"Jørgensen, Mette-Rose","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Inge","key":"kjærbøllingpau","last":"Kjærbølling","name":"Kjærbølling, Inge","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Andreas","key":"schrammpau","last":"Schramm","locid":"25080de3-b60e-46b4-a606-d99f1ec089e5","name":"Schramm, Andreas","orcid":"0000-0002-7614-9616","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rikke Louise","key":"meyerpau","last":"Meyer","locid":"f1caa4f6-bc6e-459a-a976-8843c7ea7ff3","name":"Meyer, Rikke Louise","orcid":"0000-0002-6485-5134","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1159/000534630","issn":["00086568","1421976X"],"issn_org":["00086568"],"issue":"3","journal":"Caries Research","pages":"445-445","paperid":"158","publisher":"S. Karger AG","status":"p","title":"Caries Research","volume":"57"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Private Research","Universities"],"PST":["Published"]},"sid":["au-71a4711b-1dad-4a89-b828-23d65742b765"],"src":["AU Aarhus University"],"title":"The effect of an enzyme-containing lozenge on dental biofilm accumulation : A clinical pilot study","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-717654","year":"2023","yearsub":"2023"}
{"abstract":"Staphylococcus aureus is a major human pathogen that utilises many surface-associated and secreted proteins to form biofilms and cause disease. However, our understanding of these processes is limited by challenges of using fluorescent protein reporters in their native environment, because they must be exported and fold correctly to become fluorescent. Here, we demonstrate the feasibility of using the monomeric superfolder GFP (msfGFP) exported from S. aureus. By fusing msfGFP to signal peptides for the Secretory (Sec) and Twin Arginine Translocation (Tat) pathways, the two major secretion pathways in S. aureus, we quantified msfGFP fluorescence in bacterial cultures and cell-free supernatant from the cultures. When fused to a Tat signal peptide, we detected msfGFP fluorescence inside but not outside bacterial cells, indicating a failure to export msfGFP. However, when fused to a Sec signal peptide, msfGFP fluorescence was present outside cells, indicating successful export of the msfGFP in the unfolded state, followed by extracellular folding and maturation to the photoactive state. We applied this strategy to study coagulase (Coa), a secreted protein and a major contributor to the formation of a fibrin network in S. aureus biofilms that protects bacteria from the host immune system and increases attachment to host surfaces. We confirmed that a genomically integrated C-terminal fusion of Coa to msfGFP does not impair the activity of Coa or its localisation within the biofilm matrix. Our findings demonstrate that msfGFP is a good candidate fluorescent reporter to consider when studying proteins secreted by the Sec pathway in S. aureus.","author_count":10,"contributors":["Evans, Dominique C S","Khamas, Amanda B","Marcussen, Lisbeth","Severin Rasmussen, Kristian","Klitgaard, Janne Kudsk","Kallipolitis, Birgitte H.","Nielsen, Janni","Otzen, Daniel E","Leake, Mark C","Meyer, Rikke L"],"cuid":["S02-094.44-686080"],"filters":{"added":"2023-08","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, Non-EU","OECD"],"corresponding_author":["Leake, Mark C.","Meyer, Rikke L","Meyer, Rikke Louise"],"country":["United Kingdom"],"glorg":["All Global Affiliations","University of York"],"keyword":["Biofilms","Coagulase","Fusion Protein","Gram Positive Bacteria","Monomeric superfolder GFP"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"gfp fusions of sec routed extracellular proteins in staphylococcus aureus reveal surface associated coagulase in biofilms","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.15698/mic2023.07.800","version":"Published Version"},"id":"S02-094.44-686080","identifier":[{"id":"37395997","type":"pmid"},{"id":"PMC10311078","type":"pmcid"},{"id":"85166420166","type":"scopus"}],"ids":["au-efdfe5a1-3c1f-4b17-8ada-7ff8ad44e166","sdu-b8a8881d-ab9f-475c-91ab-934261fbc533"],"keyword":["Gram positive bacteria","biofilms","coagulase","fusion protein","monomeric superfolder GFP"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-77A882AFF08220615B010135F1C84EC2"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.15698/mic2023.07.800","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/234872712/Open_Access_Version.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Na