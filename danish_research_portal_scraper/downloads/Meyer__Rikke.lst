89122076619c","name":"Nielsen, Signe Maria","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Pernille Ommen","key":"andersenpau","last":"Andersen","locid":"58da0d0a-5fe3-4f73-a179-046c37fc0b70","name":"Andersen, Pernille Ommen","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Line","key":"hansenpau","last":"Hansen","locid":"729ea402-8050-4923-a2a1-2bfeb5a6fd63","name":"Hansen, Line","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Hieu","key":"vuquangpau","last":"Vu-Quang","locid":"db401c9a-70b3-4233-afcf-702859b17d38","name":"Vu-Quang, Hieu","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jørgen","key":"kjemspau","last":"Kjems","locid":"f5915d75-aca3-437a-9a9d-f4fdfef7accd","name":"Kjems, Jørgen","orcid":"0000-0003-4128-9317","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Alexander N.","key":"zelikinpau","last":"Zelikin","locid":"0554974f-a5c6-4817-9b94-19e0bdc178e2","name":"Zelikin, Alexander N.","orcid":"0000-0002-9864-321X","rank":8,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-d710cec8-95de-4ba2-8aaa-8df38625c30a"],"src":["AU Aarhus University"],"title":"Delivering antibiotics locally to biofilms by targeted drug delivery and prodrug therapy","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-252135","year":"2019","yearsub":"2019"}
{"abstract":"The integration of virtual reality (VR) in education, particularly for collaborative activities and feedback, is recently trending with the continuous development of technologies. So, this paper reports a pilot study as part of an ongoing E-learning project to address the questions: 1. how can tertiary education design courses adopt VR systems in student projects in collaboration with external organizations, and 2. what are the perceptions of the students and external organization regarding the use of VR systems for cross-discipline and cross-location collaborative prototyping? The process of VR use for the learning activities are grouped into four categories: 1) introduction of basic features of VR tools (two hours), 2) self-learning/experiencing the tools — HTC Vive headsets with Masterpiece VR, SculptrVR, Google Blocks, and Sketchbox (15-20 hours), 3) co-creating design objects by adopting the selected VR tools — ScuptrVR and Google Blocks (two to four hours), and 4) presentation and get feedback in live VR space — Sketchbox with import models (2X30 min). The students responded that, for the collaborated project with a company based in another city, the VR setup is a great tool for demonstrating 3D models of the designed objects. It shows the detailed view of a product or a concept, it creates useful space for creativity, and it saves time. On the contrary, the technology is still in the early phase for the modelling purpose, still too cartoonish, lacks functions for engineering design, and gives a dizzy feeling. This study involved collocated student teams of engineers and future study should include students of different study programs and campuses working for the same client as part their respective courses.","author_count":5,"contributors":["Yu, Fei","Khalid, Md. Saifuddin"],"cuid":["S01-000.00-606279"],"event":{"acronym":"ECEL","end":"2019-11-08","place":"Copenhagen, dk","start":"2019-11-07","title":"18th European Conference on e-Learning (ECEL19)","year":"2019"},"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Yu, Fei"],"keyword":["Blended learning","Collaborative learning","Prototyping","Virtual reality"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"cross location and cross disciplinary collaborative prototyping using virtual reality in higher education","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85077510875","version":"Other Version"},"id":"S01-000.00-606279","identifier":[{"id":"85077510875","type":"scopus"}],"ids":["sdu-73935115-17cd-41e7-97cd-c8ceb5f381f4"],"keyword":["Blended learning","Collaborative learning","Designs for movement","Prototyping","Virtual reality"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-2B2EEAAF7B442712F9AD35695AD5A484"],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Engineering, Department of Technology and Innovation, SDU Technology Entrepreneurship and Innovation","SDU, The Faculty of Engineering, Mads Clausen Institute (MCI)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Fei","key":"yupau","last":"Yu","locid":"f3aab233-b261-4b48-9df9-59eecafe0316","name":"Yu, Fei","orcid":"0000-0002-2622-1755","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Md. Saifuddin","key":"khalidpau","last":"Khalid","locid":"0a1727f0-3c92-4643-af05-59f04f7de290","name":"Khalid, Md. Saifuddin","rank":2,"rolecode":"pau"},{"affno":"","first":"Rikke","key":"orngreenpedh","last":"Orngreen","name":"Orngreen, Rikke","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Mie","key":"buhlpedh","last":"Buhl","name":"Buhl, Mie","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Bente","key":"meyerpedh","last":"Meyer","name":"Meyer, Bente","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.34190/eel.19.140","isbn":["9781912764426"],"pages":"609-617","publisher":"Academic Conferences and Publishing International","status":"p","title":"Proceedings of the 18th European Conference on e-Learning, ECEL 2019"},"review":"Peer Reviewed","scoID":["2-s2.0-85077510875"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-73935115-17cd-41e7-97cd-c8ceb5f381f4"],"src":["SDU University of Southern Denmark"],"title":"Cross-location and Cross-disciplinary Collaborative Prototyping Using Virtual Reality in Higher Education","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-606279","year":"2019","yearsub":"2019"}
