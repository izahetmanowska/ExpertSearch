Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Charlotte Bredahl","key":"jacobsenpau","last":"Jacobsen","locid":"40d26cc5-117b-41d6-bb2b-3944e60bae72","name":"Jacobsen, Charlotte Bredahl","orcid":"0000-0003-4184-3752","rank":1,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Rikke","key":"meyerpau","last":"Meyer","name":"Meyer, Rikke","rank":2,"rolecode":"pau"},{"affno":"","first":"Kim","key":"jørgensenpedh","last":"Jørgensen","name":"Jørgensen, Kim","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"edition":"6","isbn":["9788712073932"],"pages":"231-248","publisher":"Gad","status":"p","title":"Kommunikation for sundhedsprofessionelle"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Hospitals","All University Colleges","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-UC","DI-UC-ALL","Hospitals","KP","Region Zealand","University Colleges"],"PST":["Published"]},"sid":["kp-6fa86a0f-4aa9-47ba-a2a6-805d573fedab"],"src":["KP University College Copenhagen"],"title":"Fælles beslutningstagning: Når patient og sundhedsprofessionel sammen vælger en behandling","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-818325","year":"2025","yearsub":"2025"}
{"abstract":"Background and aim: Matrix-degrading enzymes are a promising approach to plaque control that destabilizes the biofilm and facilitates removal without disrupting oral microbial homeostasis. This triple-blind randomized controlled trial aimed to investigate the treatment effect of a lozenge containing mutanase, beta-glucanase and DNase in two different concentrations on de novo plaque formation in healthy individuals. Methods: The study was approved by the Ethical Committee of Region Midtjylland (1-10-72-259-21). Subjects were randomly allocated to either Placebo (n=27), Active 1 (n=27) or Active 2 (n=26; threefold enzyme activity). Plaque formation in the absence of self-performed oral hygiene was assessed after 1, 7 and 14 days of intervention using the Turesky modification of the Quigley and Hein plaque index (TM-QHPI) and the planimetric plaque index (PPI). The PPI was determined by semi-automated planimetry on fluorescence images of disclosed plaque acquired using an intraoral camera. Treatment effects were analyzed using a two-way analysis of variance model. Results: Significantly lower plaque formation was observed after 7 days of intervention for the Active 1 group compared to Placebo (TM-QHPI: 3.65 ±0.61 SD vs. 4.02 ±0.62 SD, p=0.012; PPI: 48.52% ±16.33% SD vs. 57.05% ±15.65% SD, p=0.020). For Active 2 (all time points) and Active 1 (day 1 and 14), enzyme treatment resulted in nonsignificant reductions. When data for all time points were pooled, significant reductions were observed for Active 1 (p=0.005), but not Active 2 (p=0.10). Conclusion: Multiple-enzyme treatment may be a promising supplement to mechanical plaque removal. Acknowledgement of funding: The study was supported by Novozymes A/S and the Innovation Fund Denmark (grant number 9065-00244B).","author_count":8,"contributors":["Rikvold, Pernille","K. Johnsen, Karina","Chokyu Del Rey, Yumi","Knap, Inge","Holz, Caterina","Meyer, Rikke Louise","Jørgensen, Mette Rose","Schlafer, Sebastian"],"cuid":["S01-000.00-824679"],"filters":{"added":"2025-10","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Enzyme treatment","Plaque","Randomized controlled trial RCT"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-NOSI"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-PR-NOSI","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"a randomized controlled trial on the effect of multiple enzyme treatment on dental plaque formation","src":["au"],"src-code":["DI-U-AU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/105013817737","version":"Other Version"},"funding_acknowledgement":["The study was supported by Novozymes A/S and the Innovation Fund Denmark (grant number 9065-00244B)."],"id":"S01-000.00-824679","identifier":[{"id":"105013817737","type":"scopus"},{"id":"40414196","type":"pmid"}],"ids":["au-277497fa-efab-4789-984c-0a0c22ae91e3"],"keyword":["Enzyme treatment","Plaque","randomized controlled trial (RCT)"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-4F1FB054CA8FB0291A301463F981AE88"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Dentistry and Oral Health, Department of Dentistry and Oral Health - Section for Oral Ecology"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"novonesis","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-NOSI","l3nn":"Novonesis","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Novonesis","namevar":["Novonesis A/S"],"nora_code":"DI-PR-NOSI","used":1}],"person":[{"affno":"1 2","corresponding":null,"country":"dk","first":