gineering and Science, Department of Chemistry and Bioscience, Section of Biotechnology"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Liping","key":"haopau","last":"Hao","locid":"6c51d5ec-6477-4465-b266-40665aaaf50a","name":"Hao, Liping","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Simon Jon","key":"mcilroypau","last":"McIlroy","locid":"9309e11f-d9f7-4ef8-9bfe-182dd6435712","name":"McIlroy, Simon Jon","orcid":"0000-0003-3749-8730","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rasmus Hansen","key":"kirkegaardpau","last":"Kirkegaard","locid":"d5c8fdb2-a72d-47fa-b22a-5647cef23c40","name":"Kirkegaard, Rasmus Hansen","orcid":"0000-0003-3349-3617","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren Michael","key":"karstpau","last":"Karst","locid":"73f48fd9-cb58-4023-ab8a-b4f734cf7bcb","name":"Karst, Søren Michael","orcid":"0000-0002-0233-160X","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Eustace Yrosh Fernando","key":"warnakulasuriyapau","last":"Warnakulasuriya","locid":"c22a861f-697d-46d2-ba5e-7820ab34d3e0","name":"Warnakulasuriya, Eustace Yrosh Fernando","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Hüsnü","key":"aslanpau","last":"Aslan","name":"Aslan, Hüsnü","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Rikke Louise","key":"meyerpau","last":"Meyer","name":"Meyer, Rikke Louise","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mads","key":"albertsenpau","last":"Albertsen","locid":"6c728ec9-5a0d-40c7-b3f3-1741c6e01ccc","name":"Albertsen, Mads","orcid":"0000-0002-6151-190X","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Per Halkjær","key":"nielsenpau","last":"Nielsen","locid":"8321dd0d-5e0c-4334-81a7-ece0b4b66f4c","name":"Nielsen, Per Halkjær","orcid":"0000-0002-6402-1877","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Morten Simonsen","key":"dueholmpau","last":"Dueholm","locid":"0824b5d0-8995-42b9-9df4-6e9996430c39","name":"Dueholm, Morten Simonsen","orcid":"0000-0003-4135-2670","rank":10,"rolecode":"pau"}],"pub":{"doi":"10.1101/207811","issn":["26928205"],"journal":"bioRxiv","paperid":"207811","publisher":"Cold Spring Harbor Laboratory Press","status":"p","title":"bioRxiv"},"review":"No Review","search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-d3d9b2eb-fb94-42c2-aabc-58c42f378881"],"src":["AAU Aalborg University"],"title":"Novel prosthecate bacteria from the candidate phylum Acetothermia revealed by culture-independent genomics and advanced microscopy","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-111561","year":"2017","yearsub":"2017"}
{"abstract":"Bacteria of genus Achromobacter are emerging pathogens in cystic fibrosis (CF) capable of biofilm formation and development of antimicrobial resistance. Evolutionary adaptions in the transition from primary to chronic infection were assessed by transcriptomic analysis of successive isolates of Achromobacter xylosoxidans from a single CF patient. Several efflux pump systems targeting antimicrobial agents were upregulated during the course of the disease, whereas all genes related to motility were downregulated. Genes annotated to subsystems of sulfur metabolism, protein metabolism and potassium metabolism exhibited the strongest upregulation. K+ channel genes were hyperexpressed, and a putative sulfite oxidase was more than 1500 times upregulated. The transcriptome patterns indicated a pivotal role of sulfur metabolism and electrical signalling in Achromobacter biofilms during late stage CF lung disease.","author_count":3,"contributors":["Nielsen, Signe Maria","Meyer, Rikke L","Nørskov-Lauritsen, Niels"],"cuid":["S01-000.00-134528"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Journal Article"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"differences in gene expression profiles between early and late isolates in monospecies achromobacter biofilm","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85019968518","version":"Other Version"},"id":"S01-000.00-134528","identifier":[{"id":"28534862","type":"pmid"},{"id":"PMC5488654","type":"pmcid"},{"id":"85019968518","type":"scopus"}],"ids":["au-092ddc74-c3c6-4966-865a-5a7135293ff4"],"keyword":["Journal Article"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-CD69F86DC660ECDCFCC273A6F0749C6B"],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University (AU)","Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Clinical Microbiology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Signe M","key":"nielsenpau","last":"Nielsen","locid":"d1316f0c-0b76-4efe-8f69-89122076619c","name":"Nielsen, Signe Maria","name_org":"Nielsen, Signe M","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rikke L","key":"meyerpau","last":"Meyer","name":"Meyer, Rikke L","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Niels","key":"nørskovlauritsenpau","last":"Nørskov-Lauritsen","locid":"89068fb2-6301-49b0-be19-410589959dcd","name":"Nørskov-Lauritsen, Niels","rank":3,"rolecode":"pau"}],"pmid":["28534862"],"pub":{"doi":"10.3390/pathogens6020020","issn":["20760817"],"issue":"2","journal":"Pathogens","paperid":"20","publisher":"MDPI AG","status":"p","title":"Pathogens","volume":"6"},"review":"Peer Reviewed","scoID":["2-s2.0-85019968518"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-092ddc74-c3c6-4966-865a-5a7135293ff4"],"src":["AU Aarhus University"],"title":"Differences in Gene Expression Profiles between Early and Late Isolates in Monospecies Achromobacter Biofilm","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-134528","year":"2017","yearsub":"2017"}
{"abstract":"Food-related biofilms can cause food-borne illnesses and spoilage, both of which are problems on a global level. Essential oils are compounds derived from plant material that have a potential to be used in natural food preservation in the future since they are natural antimicrobials. Bacterial biofilms are particularly resilient towards biocides, and preservatives that effectively eradicate biofilms are therefore needed. In this study, we test the antibacterial properties of emulsion-encapsulated and unencapsulated isoeugenol against biofilms of Lis. monocytogenes, S. aureus, P. fluorescens and Leu. mesenteroides in tryptic soy broth and carrot juice. We show that emulsion encapsulation enhances the antimicrobial properties of isoeugenol against biofilms in media but not in carrot juice. Some of the isoeugenol emulsions were coated with chitosan, and treatment of biofilms with these emulsions disrupted the biofilm structure. Furthermore, we show that addition of the surfactant Tween 80, which is commonly used to disperse oils in food, hampers the antibacterial properties of isoeugenol. This finding highlights that common food additives, such as surfactants, may have an adverse effect on the antibacterial activity of preservatives. Isoeugenol is a promising candidate as a future food preservative because it works almost equally well against planktonic bacteria and biofilms. Emulsion encapsulation has potential benefits for the efficacy of isoeugenol, but the effect of encapsulation depends on the properties of food matrix in which isoeugenol is to be applied.","author_count":7,"contributors":["Nielsen, Christina Krogsgård","Kjems, Jørgen","Mygind, Tina","Snabe, Torben","Schwarz, Karin","Serfert, Yvonne","Meyer, Rikke Louise"],"cuid":["S01-000.00-135718"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","Kiel University"],"keyword":["Biofilms","Emulsion","Essential oil","Food preservation","Isoeugenol","Spray drying"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-PR-OTH","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"antimicrobial effect of emulsion encapsulated isoeugenol against biofilms of food pathogens and spoilage bacteria","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84995376506","version":"Other Version"},"id":"S01-000.00-135718","identifier":[{"id":"84995376506","type":"scopus"},{"id":"27851985","type":"pmid"}],"ids":["au-0b41fe4c-8df5-4721-a6ec-d89bfa356a89"],"keyword":["Biofilms","Emulsion","Essential oil","Food preservation","Isoeugenol","Spray-drying"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-FF389BD5C6932138B2B922B932CC0A6F"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Interdisciplinary Nanoscience Center, Interdisciplinary Nanoscience Center - INANO-MBG, iNANO-huset"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["Dupont ApS (Nutrition & Health) - Denmark"],"nora_code":"DI-PR-OTH","used":1},{"affno":"3","country":"de","key":"kiel university","loc":["Germany","Europe, EU","OECD"],"name":"Kiel University","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Christina Krogsgård","key":"nielsenpau","last":"Nielsen","locid":"e7e6ebef-9f08-46d3-9065-2facd5e8a570","name":"Nielsen, Christina Krogsgård","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jørgen","key":"kjemspau","last":"Kjems","locid":"f5915d75-aca3-437a-9a9d-f4fdfef7accd","name":"Kjems, Jørgen","orcid":"0000-0003-4128-9317","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Tina","key":"mygindpau","last":"Mygind","name":"Mygind, Tina","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Torben","key":"snabepau","last":"Snabe","name":"Snabe, Torben","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Karin","key":"schwarzpau","last":"Schwarz","name":"Schwarz, Karin","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Yvonne","key":"serfertpau","last":"Serfert","name":"Serfert, Yvonne","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rikke Louise","key":"meyerpau","last":"Meyer","locid":"f1caa4f6-bc6e-459a-a976-8843c7ea7ff3","name":"Meyer, Rikke Louise","orcid":"0000-0002-6485-5134","rank":7,"rolecode":"pau"}],"pmid":["27851985"],"pub":{"doi":"10.1016/j.ijfoodmicro.2016.11.002","issn":["01681605","18793460"],"issn_org":["01681605"],"journal":"International Journal of Food Microbiology","pages":"7-12","publisher":"Elsevier BV","publisher_org":"Elsevier B.V.","status":"p","title":"International Journal of Food Microbiology","volume":"242"},"review":"Peer Reviewed","scoID":["2-s2.0-84995376506"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Other Companies","Private Research","Universities","dupont aps (nutrition & health) - denmark"],"PST":["Published"]},"sid":["au-0b41fe4c-8df5-4721-a6ec-d89bfa356a89"],"src":["AU Aarhus University"],"title":"Antimicrobial effect of emulsion-encapsulated isoeugenol against biofilms of food pathogens and spoilage bacteria","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-135718","year":"2017","yearsub":"2017"}
{"abstract":"The extracellular matrix is an integral part of microbial biofilms and an important field of research. Confocal laser scanning microscopy is a valuable tool for the study of biofilms, and in particular of the biofilm matrix, as it allows real-time visualization of fully hydrated, living specimens. Confocal microscopes are held by many research groups, and a number of methods for qualitative and quantitative imaging of the matrix have emerged in recent years. This review provides an overview and a critical discussion of techniques used to visualize different matrix compounds, to determine the concentration of solutes and the diffusive properties of the biofilm matrix.","author_count":2,"contributors":["Schlafer, Sebastian","Meyer, Rikke Louise"],"cuid":["S01-000.00-248062"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"confocal microscopy imaging of the biofilm matrix","src":["au"],"src-code":["DI-U-AU"],"type":"djr","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84963904032","version":"Other Version"},"id":"S01-000.00-248062","identifier":[{"id":"84963904032","type":"scopus"},{"id":"26979645","type":"pmid"}],"ids":["au-cfce6ca2-c52b-467d-a962-804af78d6dfe"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-5D2A05C73A03A002568203881B61ABFC"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Dentistry and Oral Health, Department of Dentistry and Oral Health - Section for Oral Ecology and Caries Control"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Sebastian","key":"schlaferpau","last":"Schlafer","locid":"bcd4e1fe-3a80-4288-8b5f-d105f6f53982","name":"Schlafer, Sebastian","orcid":"0000-0003-2463-1926","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rikke L","key":"meyerpau","last":"Meyer","locid":"f1caa4f6-bc6e-459a-a976-8843c7ea7ff3","name":"Meyer, Rikke Louise","name_org":"Meyer, Rikke L","orcid":"0000-0002-6485-5134","rank":2,"rolecode":"pau"}],"pmid":["26979645"],"pub":{"doi":"10.1016/j.mimet.2016.03.002","issn":["01677012","18728359"],"issn_org":["01677012"],"journal":"Journal of Microbiological Methods","pages":"50-59","publisher":"Elsevier BV","publisher_org":"Elsevier B.V.","status":"p","title":"Journal of Microbiological Methods","volume":"138"},"review":"Peer Reviewed","scoID":["2-s2.0-84963904032"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-cfce6ca2-c52b-467d-a962-804af78d6dfe"],"src":["AU Aarhus University"],"title":"Confocal microscopy imaging of the biofilm matrix","type":"Journal Review","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-248062","year":"2017","yearsub":"2017"}
{"abstract":"The bovine milk protein osteopontin (OPN) has been shown to reduce the adhesion of oral bacteria to saliva-coated surfaces, which reduces biofilm formation and may contribute to caries control. We now quantified the effect of OPN (Lacprodan OPN-10) treatment on the adhesion force of Lactobacillus paracasei subsp. paracasei and Actinomyces naeslundii using atomic force microscopy based single cell force spectroscopy (AFM-SCFS). Furthermore, we performed a fluorescent lectin binding analysis (FLBA) to investigate if OPN treatment resulted in the selective blocking of specific cell surfaces glycoconjugates of L. paracasei, A. naeslundii and Streptococcus mitis. For AFM-SCFS, saliva-coated tipless AFM cantilevers were approached on single cells. The cantilevers were then retracted and adhesion was quantified from the recorded force curves. Adhesion on the same cells (n=10) was compared before and after OPN treatment. Adhesion energy was found to be reduced by 94% for L. paracasei and 61% for A. naeslundii (p<0.05). For FLBA, the binding of 75 FITC-labelled lectins to the three bacteria was screened. Lectins BanLec, ConA, VGA and WGA bound well to A. naeslundii, lectins ABA and HPA to L. paracasei, and lectins VGA and WGA to S. mitis. Immobilized bacteria were incubated with these lectins in the presence and absence of OPN. For each combination, 12 confocal images were acquired with fixed microscope settings, and average fluorescence intensities were determined. Experiments were performed in triplicate and analyzed with two-sample t-tests. No statistically significant differences were observed between OPN-treated and OPN-free cells (p>0.05). OPN strongly reduces the adhesion force of oral bacteria to saliva-coated surfaces, but the effect cannot be ascribed to the selective blocking of cell surface glycoconjugates.","author_count":5,"contributors":["Kristensen, Mathilde Frost","Zeng, Guanghong","Neu, Thomas R.","Meyer, Rikke Louise","Schlafer, Sebastian"],"cuid":["S01-000.00-220426"],"event":{"end":"2017-07-08","place":"Oslo, no","start":"2017-07-05","title":"ORCA: 64th Congress of the European Organization for Caries Research","year":"2017"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","Helmholtz Association of German Research Centres"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"osteopontin reduces the adhesion force of dental bacteria without blocking bacterial cell surface glycoconjugates","src":["au"],"src-code":["DI-U-AU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.karger.com/Article/Pdf/471777","version":"Other Version"},"id":"S01-000.00-220426","identifier":[{"id":"28564647","type":"pmid"},{"id":"85020231520","type":"scopus"}],"ids":["au-9fe1c7fe-3947-48d6-911b-654ffb781066"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-3-3-BD56D6548CD2B102A16E31EE39357A2D"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Dentistry and Oral Health, Department of Dentistry and Oral Health - Dentistry","Aarhus University, Health, Department of Dentistry and Oral Health, Department of Dentistry and Oral Health - Section for Oral Ecology and Caries Control"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"de","key":"helmholtz association of german research centres","loc":["Germany","Europe, EU","OECD"],"name":"Helmholtz Association of German Research Centres","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Mathilde Frost","key":"kristensenpau","last":"Kristensen","locid":"3db74fb4-c382-451d-bd24-abea0bc2092c","name":"Kristensen, Mathilde Frost","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Guanghong","key":"zengpau","last":"Zeng","locid":"41d64164-8293-4f51-b1b8-96ac2ccc6db5","name":"Zeng, Guanghong","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Thomas R.","key":"neupau","last":"Neu","name":"Neu, Thomas R.","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rikke Louise","key":"meyerpau","last":"Meyer","locid":"f1caa4f6-bc6e-459a-a976-8843c7ea7ff3","name":"Meyer, Rikke Louise","orcid":"0000-0002-6485-5134","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Sebastian","key":"schlaferpau","last":"Schlafer","locid":"bcd4e1fe-3a80-4288-8b5f-d105f6f53982","name":"Schlafer, Sebastian","orcid":"0000-0003-2463-1926","rank":5,"rolecode":"pau"}],"pmid":["28564647"],"pub":{"doi":"10.1159/000471777","issn":["00086568","1421976X"],"issn_org":["00086568"],"journal":"Caries Research","pages":"299-299","paperid":"19","publisher":"S. Karger AG","status":"p","title":"Caries Research","volume":"51"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-9fe1c7fe-3947-48d6-911b-654ffb781066"],"src":["AU Aarhus University"],"title":"Osteopontin Reduces the Adhesion Force of Dental Bacteria Without Blocking Bacterial Cell Surface Glycoconjugates","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-220426","year":"2017","yearsub":"2017"}
{"abstract":"Human extracellular matrix (hECM) proteins aids the initial attachment and initiation of an infection, by specific binding to bacterial cell surface proteins. However, the importance of hECM proteins in structure, integrity and antibiotic resilience of a biofilm is unknown. This study aims to determine how specific hECM proteins affect S. aureus USA300 JE2 biofilms. Biofilms were grown in the presence of synovial fluid from rheumatoid arteritis patients to mimic in vivo conditions, where bacteria incorporate hECM proteins into the biofilm matrix. Difference in biofilm structure, with and without addition of hECM to growth media, was visualized by confocal laser scanning microscopy. Two enzymatic degradation experiments were used to study biofilm matrix composition and importance of hECM proteins: enzymatic removal of specific hECM proteins from growth media, before biofilm formation, and enzymatic treatment of 24-hour-old biofilms. hECM addition changed the overall biofilm structure, with larger dispersion of cells within the biofilm matrix. Fibrin, elastin, and collagen were important in forming and maintaining the biofilm structure. Their absence, from growth media, reduced biofilm formation 5-fold, indicating that they are important for biofilm initiation. Their enzymatic degradation, in an established biofilm, caused dispersal, showing that these proteins are critical for structural integrity. A combination of antibiotics with hECM degrading enzymes did not improve the treatment outcome. We conclude that while hECM proteins are an integral part of the biofilm matrix, we find no evidence that these matrix components are directly responsible for the biofilm’s unique antibiotic resilience. The hECM proteins are however highly important in determining biofilm structure and initiation. When utilizing in vitro biofilm models, we therefore recommend addition of hECM proteins to standard growth media, in order to mimic biofilm properties and structure seen in vivo.","author_count":5,"contributors":["Dreier, Cindy","Nielsen, Astrid","Jørgensen, Nis Pedersen","Kragstrup, Tue Wenzel","Meyer, Rikke Louise"],"cuid":["S01-000.00-230904"],"event":{"end":"2017-09-22","place":"Amsterdam, nl","start":"2017-09-19","title":"Eurobiofilms 2017","year":"2017"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"host proteins determine mrsa biofilm structure and integrity","src":["au"],"src-code":["DI-U-AU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.au.dk/ws/files/118852376/Eurobiofilms2017_Abstract_book.pdf","version":"Published Version"},"id":"S01-000.00-230904","ids":["au-b1fe3020-f630-4b52-8acf-e776ae3dcf04"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-1F7AB68AFF166821C7FCFCF286BCBE05"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.au.dk/ws/files/118852376/Eurobiofilms2017_Abstract_book.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Interdisciplinary Nanoscience Center, Interdisciplinary Nanoscience Center - INANO-Bioscience, iNANO-huset"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Cindy","key":"dreierpau","last":"Dreier","locid":"5177aea4-a419-4fdf-8d72-3e6e3a11e11b","name":"Dreier, Cindy","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Astrid","key":"nielsenpau","last":"Nielsen","locid":"78dd4ac2-ba2c-44de-b1da-aa106b6f51cb","name":"Nielsen, Astrid","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Nis Pedersen","key":"jørgensenpau","last":"Jørgensen","locid":"ac385492-f707-4053-bc6e-965ba8f60360","name":"Jørgensen, Nis Pedersen","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Tue Wenzel","key":"kragstruppau","last":"Kragstrup","locid":"e1e2fde6-99ce-4d01-b3d4-5c8160d80136","name":"Kragstrup, Tue Wenzel","orcid":"0000-0002-6439-397X","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rikke Louise","key":"meyerpau","last":"Meyer","locid":"f1caa4f6-bc6e-459a-a976-8843c7ea7ff3","name":"Meyer, Rikke Louise","orcid":"0000-0002-6485-5134","rank":5,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-b1fe3020-f630-4b52-8acf-e776ae3dcf04"],"src":["AU Aarhus University"],"title":"Host Proteins Determine MRSA Biofilm Structure and Integrity","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-230904","year":"2017","yearsub":"2017"}
{"abstract":"Staphylococcus aureus is intrinsically resistant to polymyxins (polymyxin B and colistin), an important class of cationic antimicrobial peptides used in treatment of Gram-negative bacterial infections. To understand the mechanisms underlying intrinsic polymyxin resistance in S. aureus, we screened the Nebraska Transposon Mutant Library established in S. aureus strain JE2 for increased susceptibility to polymyxin B. Nineteen mutants displayed at least 2-fold reductions in MIC, while the greatest reductions (8-fold) were observed for mutants with inactivation of either graS, graR, vraF, or vraG or the subunits of the ATP synthase (atpA, atpB, atpG, or atpH), which during respiration is the main source of energy. Inactivation of atpA also conferred hypersusceptibility to colistin and the aminoglycoside gentamicin, whereas susceptibilities to nisin, gallidermin, bacitracin, vancomycin, ciprofloxacin, li-nezolid, daptomycin, and oxacillin were unchanged. ATP synthase activity is known to be inhibited by oligomycin A, and the presence of this compound increased polymyxin B-mediated killing of S. aureus. Our results demonstrate that the ATP synthase contributes to intrinsic resistance of S. aureus towards polymyxins and that inhibition of the ATP synthase sensitizes S. aureus to this group of compounds. These findings show that by modulation of bacterial metabolism, new classes of antibiotics may show efficacy against pathogens towards which they were previously considered inapplicable. In light of the need for new treatment options for infections with serious pathogens like S. aureus, this approach may pave the way for novel applications of existing antibiotics. IMPORTANCE Bacterial pathogens that cause disease in humans remain a serious threat to public health, and antibiotics are still our primary weapon in treating bacterial diseases. The ability to eradicate bacterial infections is critically challenged by development of resistance to all clinically available antibiotics. Polymyxins constitute an important class of antibiotics for treatment of infections caused by Gram-negative pathogens, whereas Gram-positive bacteria remain largely insusceptible towards this class of antibiotics. Here we performed a whole-genome screen among nonessential genes for polymyxin intrinsic resistance determinants in Staphylococcus aureus. We found that the ATP synthase is important for polymyxin susceptibility and that inhibition of the ATP synthase sensitizes S. aureus towards polymyxins. Our study provides novel insights into the mechanisms that limit polymyxin activity against S. aureus and provides valuable targets for inhibitors to potentially enable the use of polymyxins against S. aureus and other Gram-positive pathogens.","author_count":8,"contributors":["Vestergaard, Martin","Nøhr-Meldgaard, Katrine","Bojer, Martin Saxtorph","Nielsen, Christina Krogsgård","Meyer, Rikke Louise","Slavetinsky, Christoph","Peschel, Andreas","Ingmer, Hanne"],"cuid":["S02-088.00-019263"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","University of Tübingen"],"keyword":["Journal Article"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"inhibition of the atp synthase eliminates the intrinsic resistance of staphylococcus aureus towards polymyxins","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1128/mBio.01114-17","version":"Published Version"},"id":"S02-088.00-019263","identifier":[{"id":"PMC5587909","type":"pmcid"},{"id":"85033374201","type":"scopus"},{"id":"28874470","type":"pmid"}],"ids":["au-5ac7ccbf-6cf5-4ceb-9d5e-59e454361206","ku-66aed389-fd57-48df-9c24-4858f358bd2e"],"keyword":["Journal Article"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-9A2357DEFB33BE60D7FC989E54CDEC6F"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/185684495/mBio_2017_Vestergaard_.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.au.dk/ws/files/119656185/mBio_2017_Vestergaard_.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1128/mBio.01114-17","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Veterinary and Animal Sciences, Food Safety and Zoonoses"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Interdisciplinary Nanoscience Center, Interdisciplinary Nanoscience Center - INANO-MBG, iNANO-huset"],"nora_code":"DI-U-AU","used":1},{"affno":"3","country":"de","key":"university of tübingen","loc":["Germany","Europe, EU","OECD"],"name":"University of Tübingen","used":1}],"person":[{"affno":"1","first":"Martin","key":"vestergaardpau","last":"Vestergaard","locid":"0d6ed4a6-2995-46f9-9402-9e1ce154e032","name":"Vestergaard, Martin","orcid":"0000-0002-3840-3193","rank":1,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Katrine","key":"nøhrmeldgaardpau","last":"Nøhr-Meldgaard","locid":"fca66f1f-5d94-43e1-b791-7ae791d85ca7","name":"Nøhr-Meldgaard, Katrine","orcid":"0000-0003-3749-6882","rank":2,"rolecode":"pau"},{"affno":"1","first":"Martin Saxtorph","key":"bojerpau","last":"Bojer","locid":"5d203ea9-52d5-4a30-b0c3-dcb7cb46f854","name":"Bojer, Martin Saxtorph","orcid":"0000-0002-8488-9593","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Christina","key":"krogsgårdnielsenpau","last":"Krogsgård Nielsen","locid":"e7e6ebef-9f08-46d3-9065-2facd5e8a570","name":"Nielsen, Christina Krogsgård","name_org":"Krogsgård Nielsen, Christina","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Rikke Louise","key":"meyerpau","last":"Meyer","locid":"f1caa4f6-bc6e-459a-a976-8843c7ea7ff3","name":"Meyer, Rikke Louise","orcid":"0000-0002-6485-5134","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Christoph","key":"slavetinskypau","last":"Slavetinsky","name":"Slavetinsky, Christoph","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Andreas","key":"peschelpau","last":"Peschel","name":"Peschel, Andreas","rank":7,"rolecode":"pau"},{"affno":"1","first":"Hanne","key":"ingmerpau","last":"Ingmer","locid":"abe2cd31-84e7-4f06-81a3-33e08bf93b8f","name":"Ingmer, Hanne","orcid":"0000-0002-8350-5631","rank":8,"rolecode":"pau"}],"pmid":["28874470"],"pub":{"doi":"10.1128/mbio.01114-17","issn":["21507511","21612129"],"issn_org":["21507511"],"issue":"5","journal":"mBio","paperid":"e01114-17","publisher":"American Society for Microbiology","status":"p","title":"mBio","title_org":"mBio (Online)","volume":"8"},"review":"Peer Reviewed","scoID":["2-s2.0-85033374201"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-5ac7ccbf-6cf5-4ceb-9d5e-59e454361206","ku-66aed389-fd57-48df-9c24-4858f358bd2e"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Inhibition of the ATP Synthase Eliminates the Intrinsic Resistance of Staphylococcus aureus towards Polymyxins","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-088.00-019263","year":"2017","yearsub":"2017"}
{"abstract":"Tween 80 is a widely used non-ionic emulsifier that is added to cosmetics, pharmaceuticals, and foods. Because of its widespread use we need to understand how it affects bacteria on our skin, in our gut, and in food products. The aim of this study is to investigate how Tween 80 affects the growth and antimicrobial susceptibility of Staphylococcus aureus, Listeria monocytogenes, and Pseudomonas fluorescens, which are common causes of spoilage and foodborne illnesses. Addition of 0.1% Tween 80 to laboratory growth media increased the growth rate of planktonic S. aureus batch cultures, and it also increased the total biomass when S. aureus was grown as biofilms. In contrast, Tween 80 had no effect on batch cultures of L. monocytogenes, it slowed the growth rate of P fluorescens, and it led to formation of less biofilm by both L. monocytogenes and P fluorescens. Furthermore, Tween 80 lowered the antibacterial efficacy of two hydrophobic antimicrobials: rifampicin and the essential oil isoeugenol. Our findings underline the importance of documenting indirect effects of emulsifiers when studying the efficacy of hydrophobic antimicrobials that are dispersed in solution by emulsification, or when antimicrobials are applied in food matrixes that include emulsifiers. Furthermore, the species-specific effects on microbial growth suggests that Tween 80 in cosmetics and food products could affect the composition of skin and gut microbiota, and the effect of emulsifiers on the human microbiome should therefore be explored to uncover potential health effects.","author_count":5,"contributors":["Nielsen, Christina Krogsgård","Kjems, Jørgen","Mygind, Tina","Snabe, Torben","Meyer, Rikke Louise"],"cuid":["S01-000.00-133065"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Meyer, Rikke Louise"],"keyword":["Biofilm","Degradation","Emulsifier","Fatty acids","IMPACT","Inhibition","Isoeugenol","Lactobacillus acidophilus","Staphylococcus aureus","Tween 80","polysorbate 80"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-PR-OTH","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"effects of tween 000000000080 on growth and biofilm formation in laboratory media","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/fmicb.2016.01878","version":"Published Version"},"id":"S01-000.00-133065","identifier":[{"id":"27920774","type":"pmid"},{"id":"000388762900001","type":"wos"},{"id":"85006711860","type":"scopus"},{"id":"PMC5118432","type":"pmcid"}],"ids":["au-0689e2d5-ab36-4be6-82a6-5574d13fc567"],"keyword":["DEGRADATION","ELECTRIC-FIELD FREQUENCY","FATTY-ACIDS","IMPACT","INHIBITION","LACTOBACILLUS-ACIDOPHILUS","POLYSORBATE-80","STAPHYLOCOCCUS-AUREUS","Tween 80","biofilm","emulsifier","isoeugenol"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-1B042D61C7F50197FB6B91F7D57CBE45"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/fmicb.2016.01878","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Interdisciplinary Nanoscience Center"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["Dupont ApS (Nutrition & Health) - Denmark"],"nora_code":"DI-PR-OTH","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Christina K.","key":"nielsenpau","last":"Nielsen","locid":"e7e6ebef-9f08-46d3-9065-2facd5e8a570","name":"Nielsen, Christina Krogsgård","name_org":"Nielsen, Christina K.","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jørgen","key":"kjemspau","last":"Kjems","locid":"f5915d75-aca3-437a-9a9d-f4fdfef7accd","name":"Kjems, Jørgen","orcid":"0000-0003-4128-9317","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Tina","key":"mygindpau","last":"Mygind","name":"Mygind, Tina","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Torben","key":"snabepau","last":"Snabe","name":"Snabe, Torben","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rikke L.","key":"meyerpau","last":"Meyer","locid":"f1caa4f6-bc6e-459a-a976-8843c7ea7ff3","name":"Meyer, Rikke Louise","name_org":"Meyer, Rikke L.","orcid":"0000-0002-6485-5134","rank":5,"rolecode":"pau"}],"pmid":["27920774"],"pub":{"doi":"10.3389/fmicb.2016.01878","issn":["1664302X"],"issue":"NOV","journal":"Frontiers in Microbiology","paperid":"1878","publisher":"Frontiers Media SA","status":"p","title":"Frontiers in Microbiology","volume":"7"},"review":"Peer Reviewed","scoID":["2-s2.0-85006711860"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Other Companies","Private Research","Universities","dupont aps (nutrition & health) - denmark"],"PST":["Published"]},"sid":["au-0689e2d5-ab36-4be6-82a6-5574d13fc567"],"src":["AU Aarhus University"],"title":"Effects of Tween 80 on Growth and Biofilm Formation in Laboratory Media","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-133065","year":"2016","yearsub":"2016"}
{"abstract":"The extracellular matrix of dental biofilms plays an important role during caries development. It increases the mechanical stability of the biofilm, it prevents desiccation, it serves as a reservoir for nutrients and it contributes to the long-term preservation of acidic microenvironments. Research on the biofilm matrix in the field of dentistry has focused mainly on the synthesis, structure and function of extracellular polysaccharides. In recent years, studies conducted on biofilms from other habitats have shown that the presence of extracellular DNA contributes to biofilm formation and stability, and that the enzymatic removal of extracellular DNA might be used as a therapeutic approach to biofilm diseases. Here, we investigate the effect of treatment with DNase I (100 Kunitz) on in vivo grown young dental biofilms. A total of 300 biofilm samples were grown on glass slabs placed on acrylic splints for 2.5, 5, 7.5, 16.5 and 24 h and subsequently treated with DNase I or heat-inactivated DNase I for 1 h. Biovolumes were quantified by confocal microscopy and digital analysis of 16200 images. All samples taken together, DNase-treatment led to a strong reduction of the biofilm biovolume compared to negative control treatment, as determined by two-sample t-tests (p < 0.05). The effect decreased with biofilm age, with 94.2 %, 85.0 %, 52.0 %, 46.6 % and 15.8 % reduction for 2.5, 5, 7.5, 16.5 and 24 h biofilms, respectively. The treatment effect was independent from the intra-oral location of the biofilm. The present results make a strong case for an increased research focus on extracellular DNA in dental biofilms and might pave the way for new, non-bactericidal therapeutic approaches to caries control based on DNase treatment.","author_count":4,"contributors":["Schlafer, Sebastian","Meyer, Rikke Louise","Dige, Irene","Regina, Viduthalai R."],"cuid":["S01-000.00-171119"],"event":{"end":"2016-07-09","place":"Athen, gr","start":"2016-07-06","title":"ORCA - 63rd Annual Congress of the European Organisation for Caries Research","year":"2016"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"extracellular dna contributes to dental biofilm formation an ex vivo study","src":["au"],"src-code":["DI-U-AU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-171119","ids":["au-495470d3-a261-44ba-8dfb-43ede1f78a16"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-4CD463274E637C2165B606FA2F9723B1"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Dentistry and Oral Health, Department of Dentistry and Oral Health - Section for Oral Ecology and Caries Control","Aarhus University, Natural Sciences, Department of Biology, Department of Biology - Microbiology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Sebastian","key":"schlaferpau","last":"Schlafer","locid":"bcd4e1fe-3a80-4288-8b5f-d105f6f53982","name":"Schlafer, Sebastian","orcid":"0000-0003-2463-1926","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rikke Louise","key":"meyerpau","last":"Meyer","locid":"f1caa4f6-bc6e-459a-a976-8843c7ea7ff3","name":"Meyer, Rikke Louise","orcid":"0000-0002-6485-5134","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Irene","key":"digepau","last":"Dige","locid":"60ddcec1-40c8-4832-8305-e8c8989f4278","name":"Dige, Irene","orcid":"0000-0003-0095-179X","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Viduthalai R.","key":"reginapau","last":"Regina","locid":"fa8a7634-7c35-4495-9bf4-78035ae9c80e","name":"Regina, Viduthalai R.","rank":4,"rolecode":"pau"}],"pub":{"issn":["00086568","1421976X"],"issn_org":["00086568"],"journal":"Caries Research","pages":"182","paperid":"3","publisher":"S. Karger AG","status":"p","title":"Caries Research","volume":"50"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-495470d3-a261-44ba-8dfb-43ede1f78a16"],"src":["AU Aarhus University"],"title":"Extracellular DNA contributes to dental biofilm formation: An ex vivo study","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-171119","year":"2016","yearsub":"2016"}
