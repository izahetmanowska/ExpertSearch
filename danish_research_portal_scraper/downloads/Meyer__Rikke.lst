katrinemeyerpau","last":"Lauritsen","locid":"f4285b6b-d77f-4bfe-83f7-7b695160699f","name":"Lauritsen, Katrine Meyer","name_org":"Lauritsen, Katrine M.","rank":10,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ulla R.","key":"mikkelsenullarpau","last":"Mikkelsen","name":"Mikkelsen, Ulla R.","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mette","key":"hansenmettepau","last":"Hansen","locid":"35b198ca-caef-48de-8570-21c9fbab1f8f","name":"Hansen, Mette","orcid":"0000-0002-9383-8202","rank":12,"rolecode":"pau"}],"pmid":["37598750"],"pub":{"doi":"10.1016/j.tjnut.2023.08.011","issn":["00223166","15416100"],"issn_org":["00223166"],"issue":"11","journal":"Journal of Nutrition","pages":"3173-3184","publisher":"Elsevier BV","publisher_org":"Elsevier B.V.","status":"p","title":"Journal of Nutrition","volume":"153"},"review":"Peer Reviewed","scoID":["2-s2.0-85173221839"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Private Research","All Universities","Arla Foods","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Private Research","Universities"],"PST":["Published"]},"sid":["aau-1114c6b7-7ea1-4024-9381-649652f6f644","au-35646c48-a69b-4db9-a7f6-0996d38ad18b"],"src":["AAU Aalborg University","AU Aarhus University"],"title":"Dose-Response of Myofibrillar Protein Synthesis To Ingested Whey Protein During Energy Restriction in Overweight Postmenopausal Women : A Randomized, Controlled Trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-755765","year":"2023","yearsub":"2023"}
{"abstract":"Introduction: The antibacterial activity of graphene oxide (GO) has been widely explored and tested against various pathogenic bacterial strains. Although antimicrobial activity of GO against planktonic bacterial cells was demonstrated, its bacteriostatic and bactericidal effect alone is not sufficient to damage sedentary and well protected bacterial cells inside biofilms. Thus, to be utilized as an effective antibacterial agent, it is necessary to improve the antibacterial activity of GO either by integration with other nanomaterials or by attachment of antimicrobial agents. In this study, antimicrobial peptide polymyxin B (PMB) was adsorbed onto the surface of pristine GO and GO functionalized with triethylene glycol. Methods: The antibacterial effects of the resulting materials were examined by evaluating minimum inhibitory concentration, minimum bactericidal concentration, time kill assay, live/dead viability staining and scanning electron microscopy. Results and discussion: PMB adsorption significantly enhanced the bacteriostatic and bactericidal activity of GO against both planktonic cells and bacterial cells in biofilms. Furthermore, the coatings of PMB-adsorbed GO applied to catheter tubes strongly mitigated biofilm formation, by preventing bacterial adhesion and killing the bacterial cells that managed to attach. The presented results suggest that antibacterial peptide absorption can significantly enhance the antibacterial activity of GO and the resulting material can be effectively used not only against planktonic bacteria but also against infectious biofilms.","author_count":9,"contributors":["Pandit, Santosh","Jacquemin, Lucas","Zhang, Jian","Gao, Zhengfeng","Nishina, Yuta","Meyer, Rikke Louise","Mijakovic, Ivan","Bianco, Alberto","Pang, Chengfang"],"cuid":["S02-100.00-785217"],"filters":{"added":"2023-09","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Asia, East","Europe, EU","Nordic","OECD"],"corresponding_author":["Bianco, Alberto","Pang, Chengfang"],"country":["France","Japan","Sweden"],"glorg":["All Global Affiliations","Chalmers University of Technology","Okayama University","Université de Strasbourg"],"keyword":["Adhesion","Antibiotics","Antimicrobial peptide","Bacteria","Biofilm","Carbon materials"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-DTU"]},"level3all":["DI-U-AU","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"polymyxin b complexation enhances the antimicrobial potential of graphene oxide","src":["au","dtu"],"src-code":["DI-U-AU","DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.3389/fcimb.2023.1209563","version":"Published Version"},"funding_acknowledgement":["This research was funded by VILLUM FONDEN Foundation (Grant No. 0028340) and Novo Nordisk Foundation (NNF21OC0072082) grants to CP, Vetenskapsrådet (2020-04096) to SP, NordForsk (Project No. 105121), and Novo Nordisk Foundation (NNF20CC0035580) grants to IM. The authors gratefully acknowledge the financial support from the EU Graphene Flagship project (no. 881603) and from the Interdisciplinary Thematic Institute SysChem via the IdEx Unistra (ANR-10-IDEX-0002) within the program Investissement d’Avenir. This work was partly supported by the Centre National de la Recherche Scientifique (CNRS) through the International Research Project MULTIDIM between I2CT Unit and Okayama University, the International Center for Frontier Research in Chemistry (icFRC), and JST CREST (JPMJCR20H3). Acknowledgments"],"id":"S02-100.00-785217","identifier":[{"id":"85164270919","type":"scopus"},{"id":"PMC10321305","type":"pmcid"},{"id":"37415828","type":"pmid"}],"ids":["au-da8ceee5-1e33-4e9f-92ee-3a7d01bc92ea","dtu-da9fc75b-dcaa-4f08-b1d5-1dc00182f7f1"],"keyword":["Adhesion","Antibiotics","Antimicrobial peptide","Bacteria","Biofilm","Carbon materials"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-D6808FE6FC155C75DEF1873E2B487FF3"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/330453374/fcimb_13_1209563.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.3389/fcimb.2023.1209563","version":"Published Version"}],"org":[{"affno":"1","country":"se","key":"chalmers university of technology","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Chalmers University of Technology","used":1},{"affno":"2","country":"fr","key":"université de strasbourg","loc":["France","Europe, EU","OECD"],"name":"Université de Strasbourg","used":1},{"affno":"3","country":"jp","key":"okayama university","loc":["Japan","Asia, East","OECD"],"name":"Okayama University","used":1},{"affno":"4","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Biology","Aarhus University, Natural Sciences, Interdisciplinary Nanoscience Center"],"nora_code":"DI-U-AU","used":1},{"affno":"5","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Novo Nordisk Foundation Center for Biosustainability","Technical University of Denmark, Novo Nordisk Foundation Center for Biosustainability, Bacterial Signal Transduction"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Santosh","key":"panditpau","last":"Pandit","name":"Pandit, Santosh","rank":1,"rolecode":"pau"},{"affno":"2","corresponding