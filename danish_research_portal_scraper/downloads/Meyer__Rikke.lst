I-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-4971955d-c101-47ef-bbce-83649002814c"],"src":["AU Aarhus University"],"title":"Filamentous bacteria transport electrons over centimetre distances","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-171191","year":"2012","yearsub":"2012"}
{"abstract":"Bacterial biofilms are a persistent source of contamination, and much effort invested in developing antifouling surfaces or coatings. A bottle-neck in developing such coatings is often the time-consuming task of screening and evaluating a large number of surface materials. An automated high-throughput assay is therefore needed. In this study, we present a promising technique, Laser Scanning Cytometry (LSC), for automated quantification of bacteria on surfaces. The method was evaluated by quantifying young Staphylococcus xylosus biofilms on glass surfaces using LSC and comparing the results to cell counts obtained by fluorescence microscopy. As an example of application, we quantified bacterial adhesion to seven different sol-gel based coatings on stainless steel. The surface structure and hydrophobicity of the coatings was analyzed using atomic force microscopy and water contact angle measurements. Among the coatings tested, a significant reduction in adhesion of S. xylosus was only observed for one coating, which also had a unique surface micro-structure. LSC was particularly sensitive for quantification at low cell densities, and the adhered bacteria could be quantified both as cell number and as area coverage. The method proved to be an excellent alternative to microscopy for fast and reproducible quantification of microbial colonization on abiotic surfaces.","author_count":5,"contributors":["Regina, Viduthalai R.","Poulsen, Morten","Søhoel, Helmer","Bischoff, Claus","Meyer, Rikke Louise"],"cuid":["S01-000.00-214853"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GTS","DI-U"],"level3":{"GTS":["DI-GTS-ALL","DI-GTS-DTCI"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-GTS-DTCI","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"quantification of bacteria on abiotic surfaces by laser scanning cytometry an automated approach to screen the antifouling properties of new surface coatings","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1177/2211068212450013","version":"Other Version"},"id":"S01-000.00-214853","identifier":[{"id":"84868231137","type":"scopus"},{"id":"22713755","type":"pmid"}],"ids":["au-96189993-ff03-42e1-9181-8e1da91a4ab4"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-C2A1FE526AB58C4FCFB2FE71FE738B57"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1177/2211068212450013","version":"Other Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Interdisciplinary Nanoscience Center"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"danish technological institute","l2":"DI-GTS","l2n":"GTS Institutes","l3":"DI-GTS-DTCI","l3nn":"Danish Technological Institute","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Danish Technological Institute","namevar":["Danish Technological Institute"],"nora_code":"DI-GTS-DTCI","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Viduthalai R.","key":"reginapau","last":"Regina","locid":"fa8a7634-7c35-4495-9bf4-78035ae9c80e","name":"Regina, Viduthalai R.","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Morten","key":"poulsenpau","last":"Poulsen","locid":"21048423-8eb3-4ff0-9a24-9f445f95426b","name":"Poulsen, Morten","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Helmer","key":"søhoelpau","last":"Søhoel","name":"Søhoel, Helmer","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Claus","key":"bischoffpau","last":"Bischoff","name":"Bischoff, Claus","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rikke Louise","key":"meyerpau","last":"Meyer","locid":"f1caa4f6-bc6e-459a-a976-8843c7ea7ff3","name":"Meyer, Rikke Louise","orcid":"0000-0002-6485-5134","rank":5,"rolecode":"pau"}],"pmid":["22713755"],"pub":{"doi":"10.1177/2211068212450013","issn":["15402452","24726303"],"issn_org":["24726303"],"issue":"4","journal":"SLAS TECHNOLOGY: Translating Life Sciences Innovation","pages":"293-301","publisher":"Elsevier BV","status":"p","title":"SLAS TECHNOLOGY: Translating Life Sciences Innovation","volume":"17"},"review":"Peer Reviewed","scoID":["2-s2.0-84868231137"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All GTS Institutes","All Universities","DI-ALL","DI-GTS","DI-GTS-ALL","DI-U","DI-U-ALL","GTS Institutes","Universities"],"PST":["Published"]},"sid":["au-96189993-ff03-42e1-9181-8e1da91a4ab4"],"src":["AU Aarhus University"],"title":"Quantification of bacteria on abiotic surfaces by laser scanning cytometry: An automated approach to screen the antifouling properties of new surface coatings","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-214853","year":"2012","yearsub":"2012"}
{"abstract":"Bimetallic nanoparticles are considered the next generation of nanocatalysts with increased stability and catalytic activity. Bio-supported synthesis of monometallic nanoparticles has been proposed as an environmentally friendly alternative to the conventional chemical and physical protocols. In this study we synthesize bimetallic bio-supported Pd-Au nanoparticles for the first time using microorganisms as support material. The synthesis involved two steps: (1) Formation of monometallic bio-supported Pd(0) and Au(0) nanoparticles on the surface of Cupriavidus necator cells, and (2) formation of bimetallic bio-supported nanoparticles by reduction of either Au(III) or Pd(II) on to the nanoparticles prepared in step one. Bio-supported monometallic Pd(0) or Au(0) nanoparticles were formed on the surface of C. necator by reduction of Pd(II) or Au(III) with formate. Addition of Au(III) or Pd(II) to the bio-supported particles resulted in increased particle size. UV-Vis spectrophotometry and HR-TEM analyses indicated that the previously monometallic nanoparticles had become fully or partially covered by Au(0) or Pd(0), respectively. Furthermore, Energy Dispersive Spectrometry (EDS) and Fast Fourier Transformation (FFT) analyses confirmed that the nanoparticles indeed were bimetallic. The bimetallic nanoparticles did not have a core-shell structure, but were superior to monometallic particles at reducing p-nitrophenol to p-aminophenol. Hence, formation of microbially supported nanoparticles may be a cheap and environmentally friendly approach for production of bimetallic nanocatalysts.","author_count":6,"contributors":["Hosseinkhani, Baharak","Søbjerg, Lina Sveidal","Rotaru, Amelia-Elena","Emtiazi, Giti","Skrydstrup, Troels","Meyer, Rikke Louise"],"cuid":["S02-100.00-021251"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Asia, Middle East"],"country":["Iran"],"glorg":["All Global Affiliations","University of Isfahan"],"keyword":["Aminophenols","Cupriavidus necator","Gold","Kinetics","Metal nanoparticles","Nanocomposites","Nitrophenols","Oxidation Reduction","Palladium","Spectrum Analysis"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"microbially supported synthesis of catalytically active bimetallic pd au nanoparticles","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1002/bit.23293","version":"Other Version"},"id":"S02-100.00-021251","identifier":[{"id":"81455154474","type":"scopus"},{"id":"21830201","type":"pmid"}],"ids":["au-753ad612-9699-4392-9940-467f6ea3cc88","sdu-0e47c72e-3467-46f6-bbdd-9fdaa2046d92"],"keyword":["Aminophenols","Cupriavidus necator","Gold","Kinetics","Metal Nanoparticles","Nanocomposites","Nitrophenols","Oxidation-Reduction","Palladium","Spectrum Analysis"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-70C0D0C6AF7DCEA9F2306342A01D41F7"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1002/bit.23293","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2012","yearSub":"2013"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Interdisciplinary Nanoscience Center"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Science, Department of Biology"],"nora_code":"DI-U-SDU","used":1},{"affno":"3","country":"ir","key":"university of isfahan","loc":["Iran","Asia, Middle East"],"name":"University of Isfahan","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Baharak","key":"hosseinkhanipau","last":"Hosseinkhani","locid":"34d1ecc7-0b87-4a48-90e7-2b3eedbb6d9a","name":"Hosseinkhani, Baharak","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lina Sveidal","key":"søbjergpau","last":"Søbjerg","locid":"f5126108-b1f3-4c63-846c-9905490a36d0","name":"Søbjerg, Lina Sveidal","rank":2,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Amelia-Elena","key":"rotarupau","last":"Rotaru","locid":"f008713c-a10c-4e05-ab3e-0ceda78ab1eb","name":"Rotaru, Amelia-Elena","orcid":"0000-0003-2415-8585","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Giti","key":"emtiazipau","last":"Emtiazi","name":"Emtiazi, Giti","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Troels","key":"skrydstruppau","last":"Skrydstrup","locid":"67f8ccf9-98a3-4760-a864-1d012fffc489","name":"Skrydstrup, Troels","orcid":"0000-0001-8090-5050","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rikke Louise","key":"meyerpau","last":"Meyer","locid":"f1caa4f6-bc6e-459a-a976-8843c7ea7ff3","name":"Meyer, Rikke Louise","orcid":"0000-0002-6485-5134","rank":6,"rolecode":"pau"}],"pmid":["21830201"],"pub":{"doi":"10.1002/bit.23293","issn":["00063592","10970290"],"issn_org":["00063592"],"issue":"1","journal":"Biotechnology and Bioengineering","pages":"45-52","publisher":"Wiley-VCH Verlag","status":"p","title":"Biotechnology and Bioengineering","title_org":"Biotechnology and Bioengineering (Print)","volume":"109"},"review":"Peer Reviewed","scoID":["2-s2.0-81455154474"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["au-753ad612-9699-4392-9940-467f6ea3cc88","sdu-0e47c72e-3467-46f6-bbdd-9fdaa2046d92"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"Microbially supported synthesis of catalytically active bimetallic Pd-Au nanoparticles","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-021251","year":"2012","yearsub":2013}
{"abstract":"The use of microorganisms as support for reduction of dissolved Pd(II) to immobilized Pd(0) nanoparticles is an environmentally friendly approach for Pd recovery from waste. To better understand and engineer Pd(0) nanoparticle synthesis, one has to consider the mechanisms by which Pd(II) is reduced on microbial surfaces. Escherichia coli, Shewanella oneidensis, and Pseudomonas putida were used as model organisms in order to elucidate the role of microbial cells in Pd(II) reduction under acidic conditions. Pd(II) was reduced by formate under acidic conditions, and the process occurred substantially faster in the presence of cells as compared to cell-free controls. We found no difference between native (untreated) and autoclaved cells, and could demonstrate that even a non-enzymatic protein (bovine serum albumin) stimulated Pd(II) reduction as efficiently as bacterial cells. Amine groups readily interact with Pd(II), and to specifically test their role in surface-assisted Pd(II) reduction by formate, we replaced bacterial cells with polystyrene microparticles functionalized with amine or carboxyl groups. Amine-functionalized microparticles had the same effect on Pd(II) reduction as bacterial cells, and the effect could be hampered if the amine groups were blocked by acetylation. The interaction with amine groups was confirmed by infrared spectroscopy on whole cells and amine-functionalized microparticles. In conclusion, bio-supported Pd(II) reduction on microbial surfaces is possibly mediated by a non-enzymatic mechanism. We therefore suggest the use of amine-rich biomaterials rather than intact cells for Pd bio-recovery from waste.","author_count":5,"contributors":["Rotaru, Amelia-Elena","Jiang, Wei","Finster, Kai","Skrydstrup, Troels","Meyer, Rikke Louise"],"cuid":["S02-100.00-028857"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"continent":["America, North","OECD"],"country":