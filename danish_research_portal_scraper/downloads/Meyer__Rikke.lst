me":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Biology, Department of Biology - Microbiology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Ugo","key":"marzocchipau","last":"Marzocchi","locid":"29341b14-1004-489c-9d94-978bbdb9a01b","name":"Marzocchi, Ugo","orcid":"0000-0002-4746-9944","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Daniela","key":"trojanpau","last":"Trojan","locid":"51dd75d7-a29c-4132-953a-2901503ddc41","name":"Trojan, Daniela","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Steffen","key":"larsenpau","last":"Larsen","locid":"6841247e-dbcd-4275-b71d-1e3cba216939","name":"Larsen, Steffen","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rikke Louise","key":"meyerpau","last":"Meyer","locid":"f1caa4f6-bc6e-459a-a976-8843c7ea7ff3","name":"Meyer, Rikke Louise","orcid":"0000-0002-6485-5134","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Niels Peter","key":"revsbechpau","last":"Revsbech","locid":"cc1826f5-6d53-45c6-8db8-34976d744f28","name":"Revsbech, Niels Peter","orcid":"0000-0002-2193-262X","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Andreas","key":"schrammpau","last":"Schramm","locid":"25080de3-b60e-46b4-a606-d99f1ec089e5","name":"Schramm, Andreas","orcid":"0000-0002-7614-9616","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars Peter","key":"nielsenpau","last":"Nielsen","locid":"7b1f70e1-663b-4a12-b10c-a12dfc320c81","name":"Nielsen, Lars Peter","orcid":"0000-0002-7269-4860","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Nils","key":"risgaardpetersenpau","last":"Risgaard-Petersen","locid":"f722845a-947c-4408-bedc-7a338f234420","name":"Risgaard-Petersen, Nils","rank":8,"rolecode":"pau"}],"pmid":["24577351"],"pub":{"doi":"10.1038/ismej.2014.