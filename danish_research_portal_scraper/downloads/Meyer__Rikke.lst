paperid":"573253","publisher":"Frontiers Media SA","status":"p","title":"Frontiers in Microbiology","volume":"11"},"review":"Peer Reviewed","scoID":["2-s2.0-85096445611"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-8fd35108-006e-488c-94e0-f751f050ac74","ku-8c50580f-01ce-4575-b617-c7078aa526c9"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Phenol-Soluble Modulins Modulate Persister Cell Formation in <i>Staphylococcus aureus</i>","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-097.78-023153","year":"2020","yearsub":"2020"}
