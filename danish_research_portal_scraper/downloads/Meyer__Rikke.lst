borg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine, Center for Sexology Research"],"nora_code":"DI-U-AAU","used":1},{"affno":"3","country":"dk","key":"region zealand","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-ZEA","l3nl":"Region Zealand","l3nn":"Region Zealand","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region Zealand","namevar":["Zealand University hospital"],"nora_code":"DI-HO-ZEA","used":1},{"affno":"4","country":"it","key":"university of rome tor vergata","loc":["Italy","Europe, EU","OECD"],"name":"University of Rome Tor Vergata","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Nana Ernst","key":"toldampau","last":"Toldam","name":"Toldam, Nana Ernst","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Christian","key":"graugaardpau","last":"Graugaard","locid":"aa1d91d1-7ea1-474c-8eba-cf917ab2d232","name":"Graugaard, Christian","orcid":"0000-0003-0217-3637","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Rikke","key":"meyerpau","last":"Meyer","name":"Meyer, Rikke","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Louise","key":"thomsenpau","last":"Thomsen","locid":"94875b11-4278-4df3-b78c-9e9e0cc63315","name":"Thomsen, Louise","orcid":"0000-0002-1653-7633","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Sabine","key":"dreierpau","last":"Dreier","locid":"813b8c44-4518-4eda-b145-514046704c60","name":"Dreier, Sabine","orcid":"0000-0002-4111-7155","rank":5,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Emmanuele A.","key":"janninipau","last":"Jannini","name":"Jannini, Emmanuele A.","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Annamaria","key":"giraldipau","last":"Giraldi","name":"Giraldi, Annamaria","rank":7,"rolecode":"pau"}],"pub