"},{"affno":"1","corresponding":null,"country":"dk","first":"Rikke Louise","key":"meyerpau","last":"Meyer","locid":"f1caa4f6-bc6e-459a-a976-8843c7ea7ff3","name":"Meyer, Rikke Louise","orcid":"0000-0002-6485-5134","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Frederik","key":"dagnæshansenpau","last":"Dagnæs-Hansen","locid":"a8bfdfa1-6563-4519-a5a2-6a0732d549c7","name":"Dagnæs-Hansen, Frederik","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Kurt","key":"fuurstedpau","last":"Fuursted","name":"Fuursted, Kurt","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jørgen Eskild","key":"petersenpau","last":"Petersen","locid":"91c7ce03-d7e1-4557-91ca-bbd19ac0b7fe","name":"Petersen, Eskild","name_org":"Petersen, Jørgen Eskild","rank":5,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Governmental Institutions","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-U","DI-U-ALL","Governmental Institutions","Universities"],"PST":["Published"]},"sid":["au-fc319811-e5cf-4bb7-a747-73a475986b7f"],"src":["AU Aarhus University"],"title":"MBEC measurements more accurately predicts treatment outcome than MIC in Murine Model of Implant Associated Osteomyelitis","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-273204","year":"2014","yearsub":"2014"}
{"abstract":"The ability of bacteria to bind different compounds and to adhere to biotic and abiotic surfaces provides them with a range of advantages, such as colonization of various tissues, internalisation, avoidance of an immune response and survival and persistence in the environment. A variety of bacterial surface structures are involved in this process and these promote bacterial adhesion in a more or less specific manner. In this review, we will focus on those surface adhesins and exopolymers in selected foodborne pathogens that are involved mainly in primary adhesion. Their role in biofilm development will also be considered when appropriate. Both the clinical impact and implications for food safety of such adhesion will be discussed.","author_count":13,"contributors":["Jaglic, Zoran","Desvaux, Mickaël","Weiss, Agnes","Nesse, Live L.","Meyer, Rikke Louise","Demnerova, Katerina","Schmidt, Herbert","Giaouris, Efstathios","Sipailiene, Ausra","Teixeira, Pilar","Kačániová, Miroslava","Riedel, Christian U.","Knøchel, Susanne"],"cuid":["S02-100.00-018400"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Jaglic, Zoran"],"country":["Czechia","France","Germany","Greece","Lithuania","Norway","Portugal","Slovakia"],"glorg":["All Global Affiliations","Czech Academy of Sciences","Department of Biochemistry and Microbiology, Prague","INRAE","Kaunas University of Technology","L'Institut Agro Rennes-Angers","National Veterinary Institute Norway","Norwegian Veterinary Institute","SUA","Ulm University","University of Hohenheim","University of Minho","University of the Aegean"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"revie