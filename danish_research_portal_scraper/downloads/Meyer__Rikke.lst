Louise","orcid":"0000-0002-6485-5134","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Sebastian","key":"schlaferpau","last":"Schlafer","locid":"bcd4e1fe-3a80-4288-8b5f-d105f6f53982","name":"Schlafer, Sebastian","orcid":"0000-0003-2463-1926","rank":9,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.bioflm.2025.100298","issn":["25902075"],"journal":"Biofilm","paperid":"100298","publisher":"Elsevier BV","status":"p","title":"Biofilm","volume":"10"},"review":"Peer Reviewed","scoID":["2-s2.0-105009006048"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Private Research","Universities"],"PST":["Published"]},"sid":["au-8b309cee-5347-4c04-b601-a74d3f119f7b"],"src":["AU Aarhus University"],"title":"The effect of multiple-enzyme treatment on in situ oral biofilm formation in healthy participants","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-816161","year":"2025","yearsub":"2025"}
