34-7c35-4495-9bf4-78035ae9c80e","name":"Regina, Viduthalai R.","rank":4,"rolecode":"pau"}],"pmid":["28728145"],"pub":{"doi":"10.1159/000477447","issn":["00086568","1421976X"],"issn_org":["00086568"],"issue":"4","journal":"Caries Research","pages":"436-442","publisher":"S. Karger AG","status":"p","title":"Caries Research","volume":"51"},"review":"Peer Reviewed","scoID":["2-s2.0-85025481519"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-11544a52-7824-4bb7-a481-10fc3460fc9d"],"src":["AU Aarhus University"],"title":"Extracellular DNA Contributes to Dental Biofilm Stability","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-139330","year":"2017","yearsub":"2017"}
{"author_count":5,"contributors":["Andersen, Pernille Ommen","Hansen, Line","Vu-Quang, Hieu","Kjems, Jørgen","Meyer, Rikke Louise"],"cuid":["S01-000.00-179883"],"event":{"end":"2017-09-22","place":"Amsterdam, nl","start":"2017-09-19","title":"Eurobiofilms 2017","year":"2017"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"a targeting agent for drug delivery to staphylococcus aureus biofilms","src":["au"],"src-code":["DI-U-AU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-179883","ids":["au-589e6e65-c901-428c-87be-cccf5dbeefe7"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-E67FD8C1429F5D3C4A2ACEC97728907D"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Interdisciplinary Nanoscience Center, Interdisciplinary Nanoscience Center - INANO-Bioscience, iNANO-huset"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Pernille Ommen","key":"andersenpau","last":"Andersen","locid":"58da0d0a-5fe3-4f73-a179-046c37fc0b70","name":"Andersen, Pernille Ommen","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Line","key":"hansenpau","last":"Hansen","locid":"729ea402-8050-4923-a2a1-2bfeb5a6fd63","name":"Hansen, Line","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hieu","key":"vuquangpau","last":"Vu Quang","locid":"db401c9a-70b3-4233-afcf-702859b17d38","name":"Vu-Quang, Hieu","name_org":"Vu Quang, Hieu","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jørgen","key":"kjemspau","last":"Kjems","locid":"f5915d75-aca3-437a-9a9d-f4fdfef7accd","name":"Kjems, Jørgen","orcid":"0000-0003-4128-9317","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rikke Louise","key":"meyerpau","last":"Meyer","locid":"f1caa4f6-bc6e-459a-a976-8843c7ea7ff3","name":"Meyer, Rikke Louise","orcid":"0000-0002-6485-5134","rank":5,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-589e6e65-c901-428c-87be-cccf5dbeefe7"],"src":["AU Aarhus University"],"title":"A Targeting Agent For Drug Delivery To Staphylococcus Aureus Biofilms","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-179883","year":"2017","yearsub":"2017"}
{"abstract":"Biofilm formation by bacteria that colonize biomedical implants cause infections that cannot be eradicated by antibiotic therapy. Bacteria in biofilms are tolerant to every antibiotic known today, and this tolerance is partly due to their low metabolic activity, the occurrence of persister cells, and to the protective properties of the biofilm matrix. Strategies for combatting these troublesome infections often fall in to one of two categories: Biomaterial development aimed at preventing biofilm formation, or development of novel drug formulations that more effectively reach their target and kill the bacteria in biofilms. Innovative biomaterials may at best delay biofilm formation and an important question in this context is to understand how the material can contribute to more successful antibiotic treatment by not providing the cues that trigger the onset of antibiotic tolerance in the attached bacteria. This is an aspect we are currently studying in the development of anti-adhesive polymer coatings. While novel biomaterials may lower the risk of acute infections shortly after surgery, it is unlikely that such infections can be prevented indefinitely. It is therefore also important to work towards developing treatments that more effectively tackle biofilm infections. We have explored how the combination of antibiotic therapy with matrix-targeting enzymes can enhance the efficacy of antibiotics. The matrix composition is highly variable among different bacterial species, and this strategy will not produce a one-fits-all solution. However, for Staphylococcus aureus biofilms, we have found a promising lead in targeting the matrix with fibrinolytic drugs, and we are now moving on to test our treatment strategy in vivo.","author_count":1,"contributors":["Meyer, Rikke Louise"],"cuid":["S01-000.00-207880"],"event":{"end":"2017-04-18","place":"Hafjell, Norway","start":"2017-04-15","title":"Scandinavian Society for Biomaterials 2017","year":"2017"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"strategies for prevention and treatment of staphylococcal biofilms","src":["au"],"src-code":["DI-U-AU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-207880","ids":["au-89acb321-67a1-4945-be9a-c2f5921cabfa"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-BEDB9D43576FBAD4CBC3A1C2C1748536"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Interdisciplinary Nanoscience Center, Interdisciplinary Nanoscience Center - INANO-Bioscience, iNANO-huset"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Rikke Louise","key":"meyerpau","last":"Meyer","locid":"f1caa4f6-bc6e-459a-a976-8843c7ea7ff3","name":"Meyer, Rikke Louise","orcid":"0000-0002-6485-5134","rank":1,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-89acb321-67a1-4945-be9a-c2f5921cabfa"],"src":["AU Aarhus University"],"title":"Strategies for prevention and treatment of staphylococcal biofilms","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-207880","year":"2017","yearsub":"2017"}
{"abstract":"Classic drug development strategies have failed to meet the urgent clinical needs in treating infections with Gram-negative bacteria. Repurposing drugs can lead to timely availability of new antibiotics, accelerated by existing safety profiles. Glatiramer acetate (GA) is a widely used and safe formulation for treatment of multiple sclerosis. It contains a large diversity of essentially isomeric polypeptides with the cationic and amphiphilic character of many antimicrobial peptides (AMP). Here, we report that GA is antibacterial, targeting Gram-negative organisms with higher activity towards Pseudomonas aeruginosa than the naturally-occurring AMP LL-37 in human plasma. As judged from flow cytometric assays, bacterial killing by GA occurred within minutes. Laboratory strains of Escherichia coli and P. aeruginosa were killed by a process of condensing intracellular contents. Efficient killing by GA was also demonstrated in Acinetobacter baumannii clinical isolates and approximately 50% of clinical isolates of P. aeruginosa from chronic airway infection in CF patients. By contrast, the Gram-positive Staphylococcus aureus cells appeared to be protected from GA by an increased formation of nm-scale particulates. Our data identify GA as an attractive drug repurposing candidate to treat infections with Gram-negative bacteria.","author_count":19,"contributors":["Christiansen, Stig Hill","Murphy, Ronan A.","Juul-Madsen, Kristian","Fredborg, Marlene","Hvam, Michael Lykke","Axelgaard, Esben","Skovdal, Sandra Maria","Meyer, Rikke Louise","Sørensen, Uffe B Skov","Moeller, Arne","Nyengaard, Jens Randel","Nørskov-Lauritsen, Niels","Wang, Mikala","Gadjeva, Mihaela","Howard, Ken","Davies, Jane C.","Petersen, Eskild","Vorup-Jensen, Thomas"],"cuid":["S02-096.00-024437"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["America, North","Asia, Middle East","Europe, EU","Europe, Non-EU","OECD"],"corresponding_author":["Vorup-Jensen, Thomas"],"country":["Germany","Oman","United Kingdom","United States"],"glorg":["All Global Affiliations","Brigham and Women's Hospital","Harvard Medical School","Harvard University","Imperial College London","Max Planck Institute of Biophysics","Max Planck Institute of Biophysics, Frankfurt","Royal Brompton & Harefield NHS Trust","Royal Brompton and Harefield NHS Foundation Trust","The Royal Hospital, Muscat"],"keyword":["Anti Bacterial Agents pharmacology","Antibiotics","Atomic force microscopy","CELLS","Drug Resistance Bacterial genetics","Escherichia coli drug effects","Glatiramer Acetate pharmacology","Gram Negative Bacteria drug effects","Humans","Immunologic Factors pharmacology","Infections","Methicillin Resistant Staphylococcus aureus drug effects","Microbial Sensitivity Tests","Molecules","Multiple sclerosis","Peptides","Pseudomonas aeruginosa drug effects","Resistance","Staphylococcal Infections drug therapy","Staphylococcus aureus","TARGET"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR"],"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-HO-CDR","DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"the immunomodulatory drug glatiramer acetate is also an effective antimicrobial agent that kills gram negative bacteria","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41598-017-15969-3","version":"Published Version"},"id":"S02-096.00-024437","identifier":[{"id":"000415266100002","type":"wos"},{"id":"PMC5688084","type":"pmcid"},{"id":"85034417799","type":"scopus"},{"id":"29142299","type":"pmid"}],"ids":["au-a0d3e505-53a5-4a41-8160-0904cffb8608","sdu-f12ffb68-67ee-40ec-9ee2-21a8724ac083"],"keyword":["ANTIBIOTICS","ATOMIC-FO