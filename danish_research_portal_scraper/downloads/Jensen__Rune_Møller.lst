{"author_count":9,"contributors":["Lloret, Noemie Denise Carmen","Frederiksen, Rune Schøneberg","Møller, Thor C","Rieben, Nathalie Ines","Upadhyay, Shivendra","De Vico, Luca","Jensen, Jan Halborg","Nygård, Jesper","Martinez, Karen Laurence"],"cuid":["S01-000.00-451217"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"effects of buffer composition and dilution on nanowire field effect biosensors","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1088/0957-4484/24/3/035501","version":"Other Version"},"id":"S01-000.00-451217","identifier":[{"id":"84871550991","type":"scopus"},{"id":"23263553","type":"pmid"}],"ids":["ku-608f1a63-0015-4cc7-85e7-7b10b9f1ba81"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-5A0CACA25142DE0531813D29E9070A38"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1088/0957-4484/24/3/035501","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Chemistry, Department of Chemistry"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Noemie Denise Carmen","key":"lloretpau","last":"Lloret","locid":"1ab11d86-afc7-415a-9c2b-bff27d851dfb","name":"Lloret, Noemie Denise Carmen","rank":1,"rolecode":"pau"},{"affno":"1","first":"Rune Schøneberg","key":"frederiksenpau","last":"Frederiksen","locid":"c2e52b5e-fa2d-435e-b181-11cf2e08cfe0","name":"Frederiksen, Rune Schøneberg","rank":2,"rolecode":"pau"},{"affno":"1","first":"Thor Christian","key":"møllerpau","last":"Møller","locid":"a5c17ae8-7750-4518-8890-3d431ed4a046","name":"Møller, Thor C","name_org":"Møller, Thor Christian","orcid":"0000-0002-2256-577X","rank":3,"rolecode":"pau"},{"affno":"1","first":"Nathalie Ines","key":"riebenpau","last":"Rieben","locid":"528ee3c4-5aa2-48f8-9ab5-d49bdc99b179","name":"Rieben, Nathalie Ines","rank":4,"rolecode":"pau"},{"affno":"1","first":"Shivendra","key":"upadhyaypau","last":"Upadhyay","locid":"b6c23bb8-a45c-405f-abaa-29162fa1e896","name":"Upadhyay, Shivendra","rank":5,"rolecode":"pau"},{"affno":"1","first":"Luca","key":"devicopau","last":"De Vico","locid":"19f390a7-3d98-408c-8733-3e7ef92d1cb1","name":"De Vico, Luca","orcid":"0000-0002-2821-5711","rank":6,"rolecode":"pau"},{"affno":"1","first":"Jan Halborg","key":"jensenpau","last":"Jensen","locid":"d09bd8f4-7c74-4b17-b615-9fd1b3fcfe3e","name":"Jensen, Jan Halborg","orcid":"0000-0002-1465-1010","rank":7,"rolecode":"pau"},{"affno":"1","first":"Jesper","key":"nygårdpau","last":"Nygård","locid":"a9f6df21-02fe-407f-8472-6e4a496f8ec0","name":"Nygård, Jesper","orcid":"0000-0002-4639-5314","rank":8,"rolecode":"pau"},{"affno":"1","first":"Karen Laurence","key":"martinezpau","last":"Martinez","locid":"59fb1529-9fde-4c2c-98cd-44a82282fa08","name":"Martinez, Karen Laurence","orcid":"0000-0003-0932-8080","rank":9,"rolecode":"pau"}],"pmid":["23263553"],"pub":{"doi":"10.1088/0957-4484/24/3/035501","issn":["09574484","13616528"],"issn_org":["09574484"],"issue":"3","journal":"Nanotechnology","paperid":"035501","status":"p","title":"Nanotechnology","volume":"24"},"review":"Peer Reviewed","scoID":["2-s2.0-84871550991"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-608f1a63-0015-4cc7-85e7-7b10b9f1ba81"],"src":["KU University of Copenhagen"],"title":"Effects of buffer composition and dilution on nanowire field-effect biosensors","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-451217","year":"2013","yearsub":"2013"}
{"abstract":"Due to the economical importance of stowage planning, there recently has been an increasing interest in developing optimization algorithms for this problem. We have developed 2-phase approach that in most cases can generate near optimal stowage plans within a few hundred seconds for large deep-sea vessels. This paper describes the constrained-based local search algorithm used in the second phase of this approach where individual containers are assigned to slots in each bay section. The algorithm can solve this problem in an average of 0.18 seconds per bay, corresponding to a 20 seconds runtime for the entire vessel. The algorithm has been validated on a benchmark suite of 133 industrial instances for which 86% of the instances were solved to optimality.","author_count":3,"contributors":["Pacino, Dario","Jensen, Rune Møller","Bebbington, Tom"],"cuid":["S01-000.00-384673"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Optimization algorithms","Stowage planning","constrained based local search","deep sea vessels","industrial benchmark instances"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"constraint based local search for container stowage slot planning","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84867443547","version":"Other Version"},"id":"S01-000.00-384673","identifier":[{"id":"84867443547","type":"scopus"}],"ids":["itu-e7469171-999c-4ee9-9643-a11f8aea0a1e"],"keyword":["constrained-based local search","deep-sea vessels","industrial benchmark instances","optimization algorithms","stowage planning"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-1E40CB5BE11DD62809AFB9F78EB5767E"],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["The Department, Software & Systems"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Dario","key":"pacinopau","last":"Pacino","name":"Pacino, Dario","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rune Møller","key":"jensenpau","last":"Jensen","locid":"4d7fda5a-3cf4-4d39-9daf-1ae192b0e0e7","name":"Jensen, Rune Møller","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Tom","key":"bebbingtonpau","last":"Bebbington","name":"Bebbington, Tom","rank":3,"rolecode":"pau"}],"pub":{"isbn":["9789881925114"],"publisher":"IAENG","status":"p","subtitle":"Proceedings of the International MultiConference of Engineers and Computer Scientists","title":"IMECS 2012","volume":"1"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-e7469171-999c-4ee9-9643-a11f8aea0a1e"],"src":["ITU IT University of Copenhagen"],"title":"Constraint-based local search for container stowage slot planning","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384673","year":"2012","yearsub":"2012"}
{"author_count":8,"contributors":["Petersen, Jens Kjerulf","Pedersen, Morten Lauge","Elbæk, Jens","Andersen, Michael Palsgaard","Hjortbak, Rune","Jensen, Hardy","Guldmann Møller, Bente","Albeck-Madsen, Bente"],"cuid":["S01-000.00-105762"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Dansk Skaldyrcenter"],"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"nr","rtype":["clu"],"sorti":"rapport forundersøgelse om oprindelse som vækstfaktor i nordjylland","src":["aau"],"src-code":["DI-U-AAU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://issuu.com/smagennordjylland/docs/rapport_-_oprindelse_som_v_kstfaktor","version":"Other Version"},"id":"S01-000.00-105762","ids":["aau-c021de7b-011f-4de6-b87f-1223333fa2e1"],"lang":"Danish","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-F1195D0998685D7F9ABD297C1AECEBA9"],"oa_link":[{"access":"oa","type":"rem","url":"http://issuu.com/smagennordjylland/docs/rapport_-_oprindelse_som_v_kstfaktor","version":"Other Version"},{"access":"oa","type":"rem","url":"http://www.smagen.dk","version":"Other Version"}],"org":[{"affno":"1","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Dansk Skaldyrcenter"],"nora_code":"DI-OT","used":1},{"affno":"2","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (ENG)","Aalborg University, The Faculty of Engineering and Science, Department of Civil Engineering","Aalborg University, The Faculty of Engineering and Science, Department of Civil Engineering, Division of Water and Soil","Aalborg University, The Faculty of Engineering and Science, Department of Civil Engineering, Physical Geography Research Group","Aalborg University, The Faculty of Engineering and Science, Department of Civil Engineering, Water and Environment Research Group","Aalborg University, The Faculty of Engineering and Science, Department of the Built Environment, Division of Civil and Environmental Engineering","Aalborg University, The Faculty of Engineering and Science, Department of the Built Environment, Division of Water and Environment"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jens Kjerulf","key":"petersenpau","last":"Petersen","name":"Petersen, Jens Kjerulf","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Morten Lauge","key":"pedersenpau","last":"Pedersen","locid":"91529311-fe31-4231-a7c4-eeaf2a4d1b6f","name":"Pedersen, Morten Lauge","orcid":"0000-0003-0662-9726","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jens","key":"elbækpau","last":"Elbæk","name":"Elbæk, Jens","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Michael Palsgaard","key":"andersenpau","last":"Andersen","name":"Andersen, Michael Palsgaard","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rune","key":"hjortbakpau","last":"Hjortbak","name":"Hjortbak, Rune","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hardy","key":"jensenpau","last":"Jensen","name":"Jensen, Hardy","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Bente","key":"guldmannmøllerpau","last":"Guldmann Møller","name":"Guldmann Møller, Bente","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Bente","key":"albeckmadsenpau","last":"Albeck-Madsen","name":"Albeck-Madsen, Bente","rank":8,"rolecode":"pau"}],"pub":{"pages":"58","publisher":"Rådet for Agroindustri","status":"p"},"review":"No Review","search":{"DAF":["Aalborg University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["aau-c021de7b-011f-4de6-b87f-1223333fa2e1"],"src":["AAU Aalborg University"],"title":"Rapport : Forundersøgelse om oprindelse som Vækstfaktor i Nordjylland","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-105762","year":"2012","yearsub":"2012"}
{"abstract":"The Liner Shipping Fleet Repositioning Problem (LSFRP) poses a large financial burden on liner shipping firms. During repositioning, vessels are moved between services in a liner shipping network. The LSFRP is characterized by chains of interacting activities, many of which have costs that are a function of their duration; for example, sailing slowly between two ports is cheaper than sailing quickly. Despite its great industrial importance, the LSFRP has received little attention in the literature. We show how the LSFRP can be solved sub-optimally using the planner POPF and optimally with a mixed-integer program (MIP) and a novel method called Temporal Optimization Planning (TOP). We evaluate the performance of each of these techniques on a dataset of real-world instances from our industrial collaborator, and show that automated planning scales to the size of problems faced by industry.","author_count":6,"contributors":["Tierney, Kevin","Jensen, Rune Møller","Kroer, Christian","Britt, Adam","Coles, Amanda","Coles, Andrew"],"cuid":["S01-000.00-381625"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","King’s College London"],"keyword":["Liner Shipping Fleet Repositioning Problem","Maritime logistics","Mixed integer programming","Operational planning","Temporal Optimization"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"automated planning for liner shipping fleet repositioning","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84866439111","version":"Other Version"},"id":"S01-000.00-381625","identifier":[{"id":"84866439111","type":"scopus"}],"ids":["itu-17beb993-f144-4bd1-9399-c2093ad4e79e"],"keyword":["Liner Shipping Fleet Repositioning Problem","Maritime Logistics","Mixed-Integer Programming","Operational Planning","Temporal Optimization"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-14DEE53B238B83FDE075378F808ADF9C"],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["The Department, Software & Systems"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"gb","key":"king s college london","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"King’s College London","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Kevin","key":"tierneykevinpau","last":"Tierney","name":"Tierney, Kevin","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rune Møller","key":"jensenrunemøllerpau","last":"Jensen","locid":"4d7fda5a-3cf4-4d39-9daf-1ae192b0e0e7","name":"Jensen, Rune Møller","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Christian","key":"kroerchristianpau","last":"Kroer","name":"Kroer, Christian","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Adam","key":"brittadampau","last":"Britt","name":"Britt, Adam","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Amanda","key":"colesamandapau","last":"Coles","name":"Coles, Amanda","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Andrew","key":"colesandrewpau","last":"Coles","name":"Coles, Andrew","rank":6,"rolecode":"pau"}],"pub":{"isbn":["ISBN 9781577355625"],"pages":"279-287","publisher":"AAAI Press","status":"p","title":"ICAPS 2012, the 22nd International Conference on Automated Planning and Scheduling"},"review":"Peer Reviewed","scoID":["2-s2.0-84866439111"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-17beb993-f144-4bd1-9399-c2093ad4e79e"],"src":["ITU IT University of Copenhagen"],"title":"Automated Planning for Liner Shipping Fleet Repositioning.","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381625","year":"2012","yearsub":"2012"}
{"abstract":"Container vessel stowage planning is a hard combinatorial optimization problem with both high economic and environmental impact. We have developed an approach that often is able to generate near-optimal plans for large container vessels within a few minutes. It decomposes the problem into a master planning phase that distributes the containers to bay sections and a slot planning phase that assigns containers of each bay section to slots. In this paper, we focus on the slot planning phase of this approach and present a constraint programming and integer programming model for stowing a set of containers in a single bay section. This so-called slot planning problem is NP-hard and often involves stowing several hundred containers. Using state-of-the-art constraint solvers and modeling techniques, however, we were able to solve 90% of 236 real instances from our industrial collaborator to optimality within one second. Thus, somewhat to our surprise, it is possible to solve most of these problems optimally within the time required for practical application.","author_count":5,"contributors":["Delgado, Alberto","Jensen, Rune Møller","Janstrup, Kira","Rose, Trine Høyer","Andersen, Kent"],"cuid":["S03-098.48-018142"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":3,"keyword":["Constraint programming","Container vessel stowage planning","Integer programming","Slot planning"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-DTU","DI-U-ITU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-DTU","DI-U-ITU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"a constraint programming model for fast optimal stowage of container vessel bays","src":["au","dtu","itu"],"src-code":["DI-U-AU","DI-U-DTU","DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.ejor.2012.01.028","version":"Other Version"},"id":"S03-098.48-018142","identifier":[{"id":"84857924033","type":"scopus"}],"ids":["au-4b3962e0-cb21-4cd4-87c1-7f9ae28330c9","dtu-ba4ab01a-4cff-4509-81f5-cc39c8bd3165","itu-fd28aea1-e66d-4d3b-a3a3-9959d3c8f39b"],"keyword":["Constraint Programming","Container vessel stowage planning","Integer Programming","Slot planning"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-6-CB0FCC2E78E979B3F724D202B10670C4"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.ejor.2012.01.028","version":"Other Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["The Department, Software & Systems"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Transport","Technical University of Denmark, Department of Transport, Traffic modelling and planning"],"nora_code":"DI-U-DTU","used":1},{"affno":"3","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"4","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Mathematics"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Alberto","key":"delgadoortegonpau","last":"Delgado-Ortegon","name":"Delgado-Ortegon, Alberto","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rune Møller","key":"jensenpau","last":"Jensen","locid":"4d7fda5a-3cf4-4d39-9daf-1ae192b0e0e7","name":"Jensen, Rune Møller","rank":2,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"country":"dk","first":"Kira","key":"janstruppau","last":"Janstrup","locid":"8e27d440-41f0-453d-b4bb-5760eef0cb5c","name":"Janstrup, Kira Hyldekær","name_org":"Janstrup, Kira","orcid":"0000-0002-0391-5981","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Trine Høyer","key":"rosepau","last":"Rose","name":"Rose, Trine Høyer","rank":4,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"Kent","key":"andersenpau","last":"Andersen","locid":"0f19103a-ce2a-4f57-a0f7-13506a2e241d","name":"Andersen, Kent","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.ejor.2012.01.028","issn":["03772217","18726860"],"issn_org":["03772217"],"issue":"1","journal":"European Journal of Operational Research","pages":"251-261","publisher":"Elsevier BV","publisher_org":"Elsevier B.V.","status":"p","title":"European Journal of Operational Research","volume":"220"},"review":"Peer Reviewed","scoID":["2-s2.0-84857924033"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-4b3962e0-cb21-4cd4-87c1-7f9ae28330c9","dtu-ba4ab01a-4cff-4509-81f5-cc39c8bd3165","itu-fd28aea1-e66d-4d3b-a3a3-9959d3c8f39b"],"src":["AU Aarhus University","DTU Technical University of Denmark","ITU IT University of Copenhagen"],"title":"A Constraint Programming Model for Fast Optimal Stowage of Container Vessel Bays","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-098.48-018142","year":"2012","yearsub":"2012"}
{"abstract":"The Liner Shipping Fleet Repositioning Problem (LSFRP) poses a large financial burden on liner shipping firms. During repositioning, vessels are moved between services in a liner shipping network. The LSFRP is characterized by chains of interacting activities, many of which have costs that are a function of their duration; for example, sailing slowly between two ports is cheaper than sailing quickly. Despite its great industrial importance, the LSFRP has received little attention in the literature. We model the LSFRP using PDDL and solve it using the planner.","author_count":4,"contributors":["Tierney, Kevin","Coles, Amanda","Coles, Andrew","Jensen, Rune Møller"],"cuid":["S01-000.00-383975"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","King’s College London"],"keyword":["Financial Burden","Liner Shipping Fleet Repositioning Problem","Liner Shipping Network","PDDL Modeling","Repositioning Activities"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"nr","rtype":["clu"],"sorti":"a pddl domain for the liner shipping fleet repositioning problem","src":["itu"],"src-code":["DI-U-ITU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/39501255/ITUTR2012152pdf.pdf","version":"Pre-print"},"id":"S01-000.00-383975","ids":["itu-b8d06be8-4f87-403c-89a0-e94ad41970b5"],"keyword":["Financial Burden","Liner Shipping Fleet Repositioning Problem","Liner Shipping Network","PDDL Modeling","Repositioning Activities"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-AA377D5E7507BF162127EB366C32ED1D"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/39501255/ITUTR2012152pdf.pdf","version":"Pre-print"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["The Department, Software & Systems"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"gb","key":"king s college london","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"King’s College London","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Kevin","key":"tierneykevinpau","last":"Tierney","name":"Tierney, Kevin","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Amanda","key":"colesamandapau","last":"Coles","name":"Coles, Amanda","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Andrew","key":"colesandrewpau","last":"Coles","name":"Coles, Andrew","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rune Møller","key":"jensenrunemøllerpau","last":"Jensen","locid":"4d7fda5a-3cf4-4d39-9daf-1ae192b0e0e7","name":"Jensen, Rune Møller","rank":4,"rolecode":"pau"}],"pub":{"issn":["16006100"],"issue":"TR-2012-152","pages":"16","place":"Copenhagen","publisher":"IT-Universitetet i København","repno":"IT University Technical Report Series, TR-2012-152","series":"IT University Technical Report Series","status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-b8d06be8-4f87-403c-89a0-e94ad41970b5"],"src":["ITU IT University of Copenhagen"],"title":"A PDDL Domain for the Liner Shipping Fleet Repositioning Problem","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383975","year":"2012","yearsub":"2013"}
{"abstract":"We solve an important problem for the liner shipping industry called the Liner Shipping Fleet Repositioning Problem (LSFRP). The LSFRP poses a large financial burden on liner shipping firms. During repositioning, vessels are moved between services in a liner shipping network. Shippers wish to reposition vessels as cheaply as possible without disrupting the cargo flows of the network. The LSFRP is characterized by chains of interacting activities with a multi-commodity flow over paths defined by the activities chosen. Despite its great industrial importance, the LSFRP has received little attention in the literature. We introduce a novel mathematical model of the LSFRP with cargo flows based on a carefully constructed graph and evaluate it on real world data from our industrial collaborator.","author_count":2,"contributors":["Tierney, Kevin","Jensen, Rune Møller"],"cuid":["S01-000.00-383980"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Industrial application","Liner Shipping Fleet Repositioning Problem LSFRP","Mathematical modeling","Multi commodity flow","Network Optimization"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"the liner shipping fleet repositioning problem with cargo flows","src":["itu"],"src-code":["DI-U-ITU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84866351393","version":"Other Version"},"id":"S01-000.00-383980","identifier":[{"id":"84866351393","type":"scopus"}],"ids":["itu-b908647f-20ef-445d-b2a6-1cd941a4f313"],"keyword":["Industrial Application","Liner Shipping Fleet Repositioning Problem (LSFRP)","Mathematical Modeling","Multi-Commodity Flow","Network Optimization"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-4F408594D1A6060CABEBAE2B567AAE68"],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["The Department, Software & Systems"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Kevin","key":"tierneypau","last":"Tierney","name":"Tierney, Kevin","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rune Møller","key":"jensenpau","last":"Jensen","locid":"4d7fda5a-3cf4-4d39-9daf-1ae192b0e0e7","name":"Jensen, Rune Møller","rank":2,"rolecode":"pau"}],"pub":{"isbn":["9783642335860"],"issn":["03029743"],"pages":"1-16","publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","title":"Computational Logistics","volume":"7555"},"review":"Peer Reviewed","scoID":["2-s2.0-84866351393"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-b908647f-20ef-445d-b2a6-1cd941a4f313"],"src":["ITU IT University of Copenhagen"],"title":"The Liner Shipping Fleet Repositioning Problem with Cargo Flows","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383980","year":"2012","yearsub":"2012"}
{"abstract":"Low cost containerized shipping requires high quality stowage plans. Scalable stowage planning optimization algorithms have been developed recently. All of these algorithms, however, produce monolithic solutions that are hard for stowage coordinators to modify, which is necessary in practice due to the application of approximate optimization models. This paper introduces an approach for modifying a stowage plan interactively without breaking its constraints. We focus on re-arranging the containers in a single bay section and use a symbolic conﬁguration technique based on binary decision diagrams to provide fast, complete, and backtrack-free decision support. Our computational results show that the approach can solve real-sized instances when breaking symmetries among similar containers","author_count":3,"contributors":["Jensen, Rune Møller","Leknes, Eilif","Bebbington, Thomas"],"cuid":["S01-000.00-382925"],"event":{"end":"2012-03-16","place":"Hong kong, cn","start":"2012-03-14","title":"The International MultiConference of Engineers and Computer Scientists","year":"2012"},"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Binary Decision Diagrams","Constraint maintenance","Container shipping","Interactive optimization","Stowage planning"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"fast interactive decision support for modifying stowage plans using binary decision diagrams","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"id":"S01-000.00-382925","identifier":[{"id":"84867480144","type":"scopus"}],"ids":["itu-6f26fd93-e380-48bb-88b9-12dc3d2af6cd"],"keyword":["Binary decision diagrams","Constraint maintenance","Container shipping","Interactive optimization","Stowage planning"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-E90330EB5BA2FD76A42162BB2AE183E1"],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","The Department, Software & Systems"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Rune Møller","key":"jensenpau","last":"Jensen","locid":"4d7fda5a-3cf4-4d39-9daf-1ae192b0e0e7","name":"Jensen, Rune Møller","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Eilif","key":"leknespau","last":"Leknes","name":"Leknes, Eilif","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Thomas","key":"bebbingtonpau","last":"Bebbington","name":"Bebbington, Thomas","rank":3,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-6f26fd93-e380-48bb-88b9-12dc3d2af6cd"],"src":["ITU IT University of Copenhagen"],"title":"Fast Interactive Decision Support for Modifying Stowage Plans Using Binary Decision Diagrams","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382925","year":"2012","yearsub":"2012"}
{"author_count":4,"contributors":["Pacino, Dario","Delgado-Ortegon, Alberto","Jensen, Rune Møller","Bebbington, Tom"],"cuid":["S01-000.00-384061"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"an accurate model for seaworthy container vessel stowage planning with ballast tanks","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://dx.doi.org/10.1007/978-3-642-33587-7_2","version":"Other Version"},"id":"S01-000.00-384061","identifier":[{"id":"84866385762","type":"scopus"}],"ids":["itu-bf35f8a9-8c4c-467d-baa9-51f1b65b66be"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-3A59979AF43E93DC030091AAACE2CFCF"],"oa_link":[{"access":"oa","type":"rem","url":"http://dx.doi.org/10.1007/978-3-642-33587-7_2","version":"Other Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["The Department, Software & Systems"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Dario","key":"pacinopau","last":"Pacino","name":"Pacino, Dario","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Alberto","key":"delgadoortegonpau","last":"Delgado-Ortegon","name":"Delgado-Ortegon, Alberto","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rune","key":"jensenpau","last":"Jensen","locid":"4d7fda5a-3cf4-4d39-9daf-1ae192b0e0e7","name":"Jensen, Rune Møller","name_org":"Jensen, Rune","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Tom","key":"bebbingtonpau","last":"Bebbington","name":"Bebbington, Tom","rank":4,"rolecode":"pau"}],"pub":{"issn":["03029743","16113349"],"issn_org":["03029743"],"journal":"Lecture Notes in Computer Science","pages":"17-32","publisher":"Springer","status":"p","title":"Lecture Notes in Computer Science","volume":"7555"},"review":"Peer Reviewed","scoID":["2-s2.0-84866385762"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-bf35f8a9-8c4c-467d-baa9-51f1b65b66be"],"src":["ITU IT University of Copenhagen"],"title":"An Accurate Model for Seaworthy Container Vessel Stowage Planning with Ballast Tanks","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384061","year":"2012","yearsub":"2012"}
{"abstract":"Nowadays a considerable part of trade goods are seaborne, with around 90% of all non-bulk cargo carried by container vessels. These vessels follow specific routes loading and unloading containers at different ports. A Stowage Plan (SP) assigns containers to load in a port to vessel slots. Good SPs save port fees, optimize use of vessel capacity, and reduce bunker consumption. Stowage Coordinators (SCs) produce these plans manually with the help of graphical tools, but high-quality SPs are hard to generate with the limited support they provide. In this abstract, we introduce AngelStow which is a commercial optimization-based decision support tool for stowing container vessels developed in collaboration between Ange Optimization and The IT University of Copenhagen. The tool assists SCs in the process of generating SPs interactively, focusing on satisfying and optimizing constraints and objectives that are tedious to deal with for humans, while letting the SCs use their expertise to deal with hard combinatorial objectives and corner cases.","author_count":3,"contributors":["Delgado-Ortegon, Alberto","Jensen, Rune Møller","Guilbert, Nicolas"],"cuid":["S01-000.00-381360"],"event":{"end":"2011-09-22","place":"Hamburg, de","start":"2011-09-19","title":"2nd International Conference on Computational Logistics","year":"2011"},"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Container Stowage","Interactive Planning Tools","Maritime Trade Logistics","Optimization based Decision Support","Stowage Plan Automation"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Ange Optimization"],"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"angelstow a commercial optimization based decision support tool for stowage planning","src":["itu"],"src-code":["DI-U-ITU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/32303601/abstract.pdf","version":"Pre-print"},"id":"S01-000.00-381360","ids":["itu-068ed494-e30d-4ab6-96de-661a65d5c6fd"],"keyword":["Container Stowage","Interactive Planning Tools","Maritime Trade Logistics","Optimization-based Decision Support","Stowage Plan Automation"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-4F368003A4B8519CB90A5A2D4779BE42"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/32303601/abstract.pdf","version":"Pre-print"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Ange Optimization"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"","corresponding":null,"first":"Alberto","key":"delgadoortegonpau","last":"Delgado-Ortegon","name":"Delgado-Ortegon, Alberto","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rune Møller","key":"jensenpau","last":"Jensen","locid":"4d7fda5a-3cf4-4d39-9daf-1ae192b0e0e7","name":"Jensen, Rune Møller","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Nicolas","key":"guilbertpau","last":"Guilbert","name":"Guilbert, Nicolas","rank":3,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["itu-068ed494-e30d-4ab6-96de-661a65d5c6fd"],"src":["ITU IT University of Copenhagen"],"title":"AngelStow: A Commercial Optimization-Based Decision Support Tool for Stowage Planning","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381360","year":"2011","yearsub":"2012"}
{"abstract":"Fleet repositioning problems pose a high financial bur- den on shipping firms, but have received little attention in the literature, despite their high importance to the shipping industry. Fleet repositioning problems are characterized by chains of interacting activities, but state-of-the-art planning and scheduling techniques do not offer cost models that are rich enough to represent essential objectives of these problems. To this end, we introduce a novel framework called Temporal Optimization Planning (TOP). TOP uses partial order planning to build optimization models associated with the different possible activity scenarios and applies branch-and-bound with tight lower bounds to find optimal solutions efficiently. We show how key aspects of fleet repositioning can be modeled using TOP and demonstrate experimentally that our approach scales to the size of problems considered by our industrial collaborators.","author_count":2,"contributors":["Tierney, Kevin","Jensen, Rune Møller"],"cuid":["S01-000.00-381658"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Branch and Bound Algorithm","Fleet Repositioning","Optimization Models","Partial Order Planning","Shipping industry"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"nr","rtype":["clu"],"sorti":"temporal optimization planning for fleet repositioning","src":["itu"],"src-code":["DI-U-ITU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/32276927/optimization_planning.pdf","version":"Pre-print"},"id":"S01-000.00-381658","ids":["itu-1a5deb8a-7e47-416d-9d88-0616980d665f"],"keyword":["Branch-and-Bound Algorithm","Fleet Repositioning","Optimization Models","Partial Order Planning","Shipping Industry"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-B0B77910E0B31172847A5A63A175F796"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/32276927/optimization_planning.pdf","version":"Pre-print"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Kevin","key":"tierneypau","last":"Tierney","name":"Tierney, Kevin","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rune Møller","key":"jensenpau","last":"Jensen","locid":"4d7fda5a-3cf4-4d39-9daf-1ae192b0e0e7","name":"Jensen, Rune Møller","rank":2,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-1a5deb8a-7e47-416d-9d88-0616980d665f"],"src":["ITU IT University of Copenhagen"],"title":"Temporal Optimization Planning for Fleet Repositioning","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381658","year":"2011","yearsub":"2011"}
{"author_count":6,"contributors":["Bardram, Jakob Eyvind","Doryab, Afsaneh","Jensen, Rune Møller","Lange, Poul","Torp, Soeren","Nielsen, Kristian"],"cuid":["S01-000.00-382044"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"phase recognition during surgical procedures using embedded and body worn sensors","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/79957941525","version":"Other Version"},"id":"S01-000.00-382044","identifier":[{"id":"79957941525","type":"scopus"}],"ids":["itu-34dc9fe4-05df-4e82-b05f-7554d002e9e5"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-492B2A549DEF6B2E2932A952B1FBBE6A"],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Jakob Eyvind","key":"bardrampau","last":"Bardram","name":"Bardram, Jakob Eyvind","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Afsaneh","key":"doryabpau","last":"Doryab","name":"Doryab, Afsaneh","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rune Møller","key":"jensenpau","last":"Jensen","locid":"4d7fda5a-3cf4-4d39-9daf-1ae192b0e0e7","name":"Jensen, Rune Møller","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Poul","key":"langepau","last":"Lange","name":"Lange, Poul","r