{"author_count":3,"contributors":["van Twiller, Jaike","Grbic, Djordje","Jensen, Rune Møller"],"cuid":["S01-000.00-798526"],"filters":{"added":"2025-04","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Container stowage planning","Deep reinforcement learning","Maritime logistics","Markov decision process"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"deep reinforcement learning for master stowage planning","src":["itu"],"src-code":["DI-U-ITU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/108728660/abstracts.pdf","version":"Authors Final Version"},"id":"S01-000.00-798526","ids":["itu-322d98a1-2942-418b-9da9-45b6752dd133"],"keyword":["Container stowage planning","Deep reinforcement learning","Maritime logistics","Markov decision process"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-D6B9792D555D40679E91177ACA0A97BB"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/108728660/abstracts.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science","IT University of Copenhagen, Data Science, Machine Learning","IT University of Copenhagen, The Maritime Hub"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jaike","key":"vantwillerpau","last":"van Twiller","locid":"fa03d816-cd99-4fea-b45b-efe7ecd3cb0a","name":"van Twiller, Jaike","orcid":"0000-0001-8390-1629","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Djordje","key":"grbicpau","last":"Grbic","locid":"c596539b-3ceb-497c-9a43-e71d6b0f65a6","name":"Grbic, Djordje","orcid":"0000-0002-4388-2539","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rune Møller","key":"jensenpau","last":"Jensen","locid":"4d7fda5a-3cf4-4d39-9daf-1ae192b0e0e7","name":"Jensen, Rune Møller","rank":3,"rolecode":"pau"}],"pub":{"edition":"9th","place":"Carmona, Spain","status":"p","subtitle":"International Workshop on Freight Transportation and Logistics","title":"ODYSSEUS 2024"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-322d98a1-2942-418b-9da9-45b6752dd133"],"src":["ITU IT University of Copenhagen"],"title":"Deep Reinforcement Learning for Master Stowage Planning","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-798526","year":"2024","yearsub":"2024"}
{"abstract":"Efficient supply chains are vital for both the worldwide economy and environmental sustainability. Container shipping plays a key role in this, known for being an eco-friendly mode of transport. Liner shipping companies are actively working to improve operational efficiency through stowage planning. Due to many combinatorial aspects, some of which are NP-hard, stowage planning is a challenging problem in its representative form. Even though stowage planning can be decomposed into master and slot planning, the subproblems remain challenging. As a result, we are searching for scalable algorithms to solve the stowage planning problem. In this work, we propose Proximal Policy optimization for master STOWage planning (PPSTOW), a deep reinforcement learning approach to address master planning with focus on global problem objectives and constraints. The experiments show the effectiveness of PPSTOW, as the framework efficiently finds near-optimal solutions for simulated problem instances with realistic vessel sizes and practical planning horizons. In the future, we aim to refine the representativeness of our approach by integrating revenue management, as well as local problem objectives and constraints.","author_count":3,"contributors":["van Twiller, Jaike","Grbic, Djordje","Jensen, Rune Møller"],"cuid":["S01-000.00-818250"],"filters":{"added":"2025-08","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Combinatorial optimization","Deep reinforcement learning","Maritime logistics","Stowage planning"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"ppstow an end to end deep reinforcement learning model for master stowage planning on container vessels","src":["itu"],"src-code":["DI-U-ITU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/109457848/Euro2024_Copenhagen_Program.pdf","version":"Published Version"},"id":"S01-000.00-818250","ids":["itu-abf6eac6-433a-479e-96d5-e136dd18bc61"],"keyword":["Combinatorial Optimization","Deep reinforcement learning","Maritime logistics","Stowage planning"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-424E4E8B90748CF39F9FC9E4A2E1B6D8"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/109457848/Euro2024_Copenhagen_Program.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Data Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jaike","key":"vantwillerpau","last":"van Twiller","locid":"fa03d816-cd99-4fea-b45b-efe7ecd3cb0a","name":"van Twiller, Jaike","orcid":"0000-0001-8390-1629","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Djordje","key":"grbicpau","last":"Grbic","locid":"c596539b-3ceb-497c-9a43-e71d6b0f65a6","name":"Grbic, Djordje","orcid":"0000-0002-4388-2539","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rune Møller","key":"jensenpau","last":"Jensen","locid":"4d7fda5a-3cf4-4d39-9daf-1ae192b0e0e7","name":"Jensen, Rune Møller","rank":3,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-abf6eac6-433a-479e-96d5-e136dd18bc61"],"src":["ITU IT University of Copenhagen"],"title":"PPSTOW: An End-to-End Deep Reinforcement Learning Model for Master Stowage Planning on Container Vessels","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-818250","year":"2024","yearsub":"2024"}
{"abstract":"The search for new biological products with a positive impact on crop performance is typically initiated by laboratory based in vitro assays. However, live plants and their associated microbes are often removed from in vitro testing assays as a way to reduce biological complexity (variation) and facilitate molecular techniques in the pursuit of uncovering mode-of-action (MoA) mechanisms. Nevertheless, when studying biological candidates intended for use in agriculture, it is essential to incorporate this complexity and validate mechanisms under conditions as close to in situ as possible in order to understand the capacities and MoA of the biologicals in the intended application environments. To address this paradox, we have developed a high-capacity early-stage plant assay that incorporates a live non-sterile plant while also enabling molecular MoA investigations, and that can be conducted in laboratories without greenhouse facilities. The high-capacity design features plants grown in 8-chamber transparent boxes to allow for multiplex imaging and increased biological replicates for greater statistical power. The transparent box design allows the visualization of shoots, roots, tagged-microbes, or visible substrates, and further non-destructive access to shoots or roots for sampling. The boxes are held in racks that hold eight plant boxes during growth in a 19 by 17 cm space, further increasing the throughput to >670 plants per m2 and easing the logistical challenges of plant assays. Furthermore, the box can support various levels of microbial complexity with the option to select the plant growth medium that meets experimental objectives, as well as using sterile or non-sterile seeds. A script-based post-imaging quantification was developed to automate image processing and allow for individual plant readings, further enabling increased statistical confidence. As proof of concept, we use the high-capacity plant system to evaluate the biocontrol potential of Pseudomonas protegens and the biostimulation potential of Pseudomonas koreensis, and are in both cases able to show statistically significant differing plant biomass between treatments under these closer-to-nature conditions. We further demonstrate that the high-capacity plant system is suitable for paired molecular investigations by performing metabolomics and qPCR DNA quantification directly from the plant box to explore in situ chemical MoA, as well as confirm the survival of the P. protegens strains to validate their role in the improved plant phenotype. In conclusion, the study presents a modular high-capacity plant assay system that enables increased throughput functional testing of microbial biocontrol and biostimulant candidates in planta. This novel assaying system saves time, reduces human error, provides quantitative and non-destructive in planta data, and can be used in laboratories without greenhouse facilities. We therefore believe it provides a potent early-stage testing option that bridges in vitro and greenhouse testing, and will expedite the discovery of superior next-generation biological products in agriculture.","author_count":13,"contributors":["Pittroff, Sabrina M.","Brems, Alexander R.","Brunshøj, Rune J.","Christiansen, Johan Vormsborg","Melgaard, Emma","Hansen, Morten Lindqvist","Corcoles, David Llorente","Funk, Jonathan","Møller, Vilhelm K.","Petersen, Søren D.","Frandsen, Rasmus John Normand","Jensen, Niels Bjerg","Jelsbak, Lars"],"cuid":["S01-000.00-747028"],"filters":{"added":"2024-08","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"corresponding_author":["Jelsbak, Lars"],"keyword":["Biocontrol","Biostimulation","DAPG","High capacity","Monocots","Pseudomonas","Wheat"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"novel rapid screening assay to incorporate complexity and increase throughput in early stage plant biological testing","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.rhisph.2024.100897","version":"Published Version"},"id":"S01-000.00-747028","identifier":[{"id":"85193535944","type":"scopus"}],"ids":["dtu-ced1e986-1afa-4cbe-8291-dbf4fce172e2"],"keyword":["Biocontrol","Biostimulation","DAPG","High-capacity","In planta screening","Monocots","Plant-microbe","Pseudomonas","Wheat"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-71C78E80F65F2EAC95A0812385211297"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.rhisph.2024.100897","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/362048063/1-s2.0-S2452219824000521-main.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Biotechnology and Biomedicine"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Sabrina M.","key":"pittroffpau","last":"Pittroff","locid":"d41945cc-509c-456d-8226-58f9794f2969","name":"Pittroff, Sabrina M.","orcid":"0000-0001-8468-5577","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Alexander R.","key":"bremspau","last":"Brems","locid":"063651fb-3542-46e7-bce6-c42e8fd737a6","name":"Brems, Alexander R.","orcid":"0009-0008-9689-8260","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rune J.","key":"brunshøjpau"