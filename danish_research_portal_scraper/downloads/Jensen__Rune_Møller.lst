","first":"Nicolai Jacob Wewer","key":"weweralbrechtsennicolaijpau","last":"Albrechtsen","locid":"0d59b767-fdca-42a0-b879-70fb0ec55651","name":"Wewer Albrechtsen, Nicolai J","name_org":"Albrechtsen, Nicolai Jacob Wewer","orcid":"0000-0003-4230-5753","rank":7,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Rune Ehrenreich","key":"kuhreruneehrenreichpau","last":"Kuhre","locid":"10f7fde3-9f77-42eb-bbaf-6d98e6938465","name":"Kuhre, Rune Ehrenreich","rank":8,"rolecode":"pau"},{"affno":"","first":"Viggo B.","key":"kristiansenviggobpau","last":"Kristiansen","name":"Kristiansen, Viggo B.","rank":9,"rolecode":"pau"},{"affno":"1","first":"Jens Frederik","key":"rehfeldjensfpau","last":"Rehfeld","locid":"eaf0b29a-7fae-4c52-947e-9324996a4830","name":"Rehfeld, Jens F.","name_org":"Rehfeld, Jens Frederik","rank":10,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Trine R","key":"clausentrinerpau","last":"Clausen","name":"Clausen, Trine R","rank":11,"rolecode":"pau"},{"affno":"1","first":"Jens J.","key":"holstjensjuulpau","last":"Holst","locid":"864b6401-9024-4773-9bdb-f4d4ca57dcad","name":"Holst, Jens Juul","name_org":"Holst, Jens J.","orcid":"0000-0001-6853-3805","rank":12,"rolecode":"pau"},{"affno":"1","first":"Sten","key":"madsbadstenpau","last":"Madsbad","locid":"1018c708-245a-4057-9263-074578042385","name":"Madsbad, Sten","rank":13,"rolecode":"pau"}],"pmid":["32068442"],"pub":{"doi":"10.1152/ajpgi.00265.2019","issn":["01931857","15221547"],"issn_org":["15221547"],"issue":"4","journal":"American Journal of Physiology: Gastrointestinal and Liver Physiology","publisher":"American Physiological Society","status":"p","title":"American Journal of Physiology: Gastrointestinal and Liver Physiology","title_org":"A J P: Gastrointestinal and Liver Physiology (Online)","volume":"318"},"review":"Peer Reviewed","scoID":["2-s2.0-85082145885"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Private Research","All Universities","DI-