":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Niels B.","key":"jensenpau","last":"Jensen","locid":"031c6601-ac95-4a90-9a39-e381a38282ba","name":"Jensen, Niels Bjerg","name_org":"Jensen, Niels B.","rank":12,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars","key":"jelsbakpau","last":"Jelsbak","locid":"0f152051-d6ff-4b86-b98f-2ce118ee9ee1","name":"Jelsbak, Lars","orcid":"0000-0002-5759-9769","rank":13,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.rhisph.2024.100897","issn":["24522198"],"journal":"Rhizosphere","paperid":"100897","publisher":"Elsevier","status":"p","title":"Rhizosphere","volume":"30"},"review":"Peer Reviewed","scoID":["2-s2.0-85193535944"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-ced1e986-1afa-4cbe-8291-dbf4fce172e2"],"src":["DTU Technical University of Denmark"],"title":"Novel rapid screening assay to incorporate complexity and increase throughput in early-stage plant biological testing","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-747028","year":"2024","yearsub":"2024"}
{"abstract":"Educational institutions are tasked with reimagining physical spaces and pedagogical methods to align with digitally supported learning environments. This study investigates the first steps of this transformation through a project on pedagogical innovations in a university setting. The research questions examined are as follows: What type of knowledge is gained from an explorative design approach to knowledge generation during educational development? How can this knowledge be presented and operationalized on an organizational level? Using a design-oriented perspective and inspiration from design-based implementation research, this study examines several activities carried out in The Classroom of the Future project. The activities were investigations of both existing classrooms and further possibilities within, for example, the use of active learning spaces, outdoor spaces, XR, and Sony Edge Analytics technologies. The research design incorporates both qualitative and quantitative methods. The analysis shows how strategic and operational considerations interrelate, and the findings emphasize the value of cross-disciplinary collaboration in distilling local design principles. These principles can inform the specific strategy and organization at the local university level and be inspirational for other educational institutions. The findings may be of particular interest to universities and educational programs that work within problem- and project-based learning paradigms.","author_count":7,"contributors":["Ørngreen, Rikke","Knudsen, Sara Paasch","Hautopp, Heidi","Jensen, Rune Hagel Skaarup"],"cuid":["S01-000.00-752031"],"event":{"end":"2023-11-07","place":"Aalborg, dk","start":"2023-11-06","title":"8th EAI International Conference on Design, Learning and Innovation, DLI 2023","year":"2023"},"filters":{"added":"2024-09","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Ørngreen, Rikke"],"keyword":["Cross disciplinary collaboration","Higher education","Organizational design principles"],"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"toward organizational design principles an explorative interdisciplinary case study investigating digitally supported learning spaces in higher education","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85200955356&partnerID=8YFLogxK","version":"Other Version"},"id":"S01-000.00-752031","identifier":[{"id":"85200955356","type":"scopus"}],"ids":["aau-1f736cc4-a62b-4087-99cd-f1a5e957c4b8"],"keyword":["cross-disciplinary collaboration","higher education","organizational design principles"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Global-Local-2-4-3E0399A2CD236B5BBF04DEB6D2A92D60"],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Social Sciences and Humanities","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Culture and Learning","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Culture and Learning, ILD-LAB – Research lab for IT and Learning Design","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Culture and Learning, L-ILD - IT and Learning Design","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Culture and Learning, Research Center for VidEO: Video in Education and the learning Organisation","Aalborg University, The Faculty of Social Sciences and Humanities, Green Societies","Aalborg University, The Faculty of Social Sciences and Humanities, MASSHINE","Aalborg University, The Technical Faculty of IT and Design, AI for the People"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Rikke","key":"ørngreenpau","last":"Ørngreen","locid":"b9c45db5-ab25-4d54-9e62-cc0bfb42ccdd","name":"Ørngreen, Rikke","orcid":"0000-0001-9042-3178","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Sara Paasch","key":"knudsenpau","last":"Knudsen","locid":"0a7b040a-9581-4247-81f5-54da88aea1bf","name":"Knudsen, Sara Paasch","orcid":"0000-0001-6866-2770","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Heidi","key":"hautopppau","last":"Hautopp","locid":"0993cb33-a065-4e3d-92e7-6a706904ccf6","name":"Hautopp, Heidi","orcid":"0000-0003-3567-7727","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rune Gram Hagel","key":"jensenpau","last":"Jensen","locid":"4597ab12-17d0-413b-ae66-f0a04e55f639","name":"Jensen, Rune Hagel Skaarup","name_org":"Jensen, Rune Gram Hagel","rank":4,"rolecode":"pau"},{"affno":"","first":"Eva","key":"brookspedh","last":"Brooks","name":"Brooks, Eva","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Anders","key":"kalsgaardmøllerpedh","last":"Kalsgaard Møller","name":"Kalsgaard Møller, Anders","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Emma","key":"edstrandpedh","last":"Edstrand","name":"Edstrand, Emma","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-031-67307-8_15","eisbn":["9783031673078"],"isbn":["9783031673061"],"issn":["18678211"],"pages":"203-228","publisher":"Springer","series":"Lecture Notes of the Institute for Computer Sciences, Social-Informatics and Telecommunications Engineering, LNICST","status":"p","subtitle":"8th EAI International Conference, DLI 2023, Aalborg, Denmark, November 6–7, 2023, Proceedings","title":"Design, Learning, and Innovation"},"review":"Peer Reviewed","scoID":["2-s2.0-85200955356"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-1f736cc4-a62b-4087-99cd-f1a5e957c4b8"],"src":["AAU Aalborg University"],"title":"Toward Organizational Design Principles : An Explorative Interdisciplinary Case Study Investigating Digitally Supported Learning Spaces in Higher Education","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-752031","year":"2024","yearsub":"2024"}
{"abstract":"Major liner shipping companies aim to solve the stowage planning problem by optimally allocating containers to vessel locations during a multi-port voyage. Due to a large variety of combinatorial aspects, a scalable algorithm to solve a representative problem is yet to be found. This paper will show that deep reinforcement learning can optimize a non-trivial master bay planning problem. Our experiments show that proximal policy optimization efficiently finds reasonable solutions, serving as preliminary evidence of the potential value of deep reinforcement learning in stowage planning. In future work, we will extend our architecture to address a full-featured master bay planning problem.","author_count":7,"contributors":["van Twiller, Jaike","Grbic, Djordje","Jensen, Rune Møller"],"cuid":["S01-000.00-695235"],"event":{"acronym":"ICCL","title":"International Conference on Computational Logistics"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Deep reinforcement learning","Liner shipping","Maritime logistics","Markov decision processes","Stowage planning"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"towards a deep reinforcement learning model of master bay stowage planning","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/108495311/978-3-031-43612-3_6.pdf","version":"Published Version"},"id":"S01-000.00-695235","identifier":[{"id":"85172314690","type":"scopus"}],"ids":["itu-3f8da0cf-0e96-4f0d-a428-2e9d50067227"],"keyword":["Deep reinforcement learning","Liner shipping","Maritime logistics","Markov decision processes","Stowage planning"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-0B86C238147910466D3061DC40DA7996"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/108495311/978-3-031-43612-3_6.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, Machine Learning"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jaike","key":"vantwillerpau","last":"van Twiller","locid":"fa03d816-cd99-4fea-b45b-efe7ecd3cb0a","name":"van Twiller, Jaike","orcid":"0000-0001-8390-1629","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Djordje","key":"grbicpau","last":"Grbic","locid":"c596539b-3ceb-497c-9a43-e71d6b0f65a6","name":"Grbic, Djordje","orcid":"0000-0002-4388-2539","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rune Møller","key":"jensenpau","last":"Jensen","locid":"4d7fda5a-3cf4-4d39-9daf-1ae192b0e0e7","name":"Jensen, Rune Møller","rank":3,"rolecode":"pau"},{"affno":"","first":"J.R.","key":"dadunapedh","last":"Daduna","name":"Daduna, J.R.","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"G.","key":"liedtkepedh","last":"Liedtke","name":"Liedtke, G.","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"X.","key":"shipedh","last":"Shi","name":"Shi, X.","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"S.","key":"voßpedh","last":"Voß","name":"Voß, S.","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-031-43612-3_6","eisbn":["9783031436123"],"isbn":["9783031436116"],"issn":["03029743"],"pages":"105-121","place":"Berlin","publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","title":"ICCL 2023: Computational Logistics","volume":"14239"},"review":"Peer Reviewed","scoID":["2-s2.0-85172314690"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-3f8da0cf-0e96-4f0d-a428-2e9d50067227"],"src":["ITU IT University of Copenhagen"],"title":"Towards a Deep Reinforcement Learning Model of Master Bay Stowage Planning","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-695235","year":"2023","yearsub":"2023"}
{"abstract":"Energy-efficient train timetabling (EETT) is essential to achieve the full potential of energy-efficient train control, which can reduce operating costs and contribute to a reduction in CO2 emissions. This article proposes a bi-objective matheuristic to address the EETT problem for a railway network. To our knowledge, this article is the first to suggest using historical data from train operation to model the actual energy consumption, reflecting the different driving behaviours. The matheuristic employs a genetic algorithm (GA) based on NSGA-II. The GA uses a warm-start method to generate the initial population based on a mixed-integer program. A greedy first-come-first-served fail-fast repair heuristic is used to ensure feasibility throughout the evolution of the population. The objectives taken into account are energy consumption and passenger travel time. The matheuristic was applied to a real-world case from a large North European train operating company. The considered network consists of 107 stations and junctions, and 18 periodic timetables for 9 train lines. Our results show that for an entire network, a reduction up to 3.3% in energy consumption and 4.64% in passenger travel time can be achieved. The results are computed in less than a minute, making the approach suitable for integration with a decision support tool.","author_count":3,"contributors":["Als, Matthias Villads Hinsch","Madsen, Mathias Bejlegaard","Jensen, Rune Møller"],"cuid":["S01-000.00-695265"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Decision support","Energy efficient train timetabling","Genetic algorithm","Matheuristic","Mixed integer programming","Multi objective optimisation"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"a data driven bi objective matheuristic for energy optimising timetables in a passenger railway network","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.jrtpm.2023.100374","version":"Published Version"},"id":"S01-000.00-695265","identifier":[{"id":"85151019939","type":"scopus"}],"ids":["itu-9320953a-a3e3-4f23-b053-233a3777beed"],"keyword":["Decision support","Energy-efficient train timetabling","Genetic algorithm","Matheuristic","Mixed-integer programming","Multi-objective optimisation"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-39E6B28740AEF1C783E6620B4E73FFAA"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.jrtpm.2023.100374","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.itu.dk/ws/files/101374767/monoEETT.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Matthias Villads Hinsch","key":"alspau","last":"Als","name":"Als, Matthias Villads Hinsch","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Mathias Bejlegaard","key":"madsenpau","last":"Madsen","name":"Madsen, Mathias Bejlegaard","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rune Møller","key":"jensenpau","last":"Jensen","locid":"4d7fda5a-3cf4-4d39-9daf-1ae192b0e0e7","name":"Jensen, Rune Møller","rank":3,"rolecode":"pau"}],"pub":{"status":"X"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Undefined"]},"sid":["itu-9320953a-a3e3-4f23-b053-233a3777beed"],"src":["ITU IT University of Copenhagen"],"title":"A data-driven bi-objective matheuristic for energy-optimising timetables in a passenger railway network","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-695265","year":"2023","yearsub":"2023"}
{"abstract":"Universiteter er ikke virksomheder. Men uden politiske ambitioner ender forskningen som en aparte finansieret gren af erhvervslivet, advarer en stribe forskere med tilknytning til Det Unge Akademi.","author_count":26,"contributors":["Autzen, Anton","Pristed, Birgitte Beck","Damgaard, Rune Busk","Kropp, Kristoffer","Hansen, Niels Christian","Laustsen-Kiel, Andreas Hougaard","Sylow, Lykke","Uusimäki, Elisa","Koksbang, Sofie Marie","Rotenberg, Eva","Li, Elizabeth","Stahl, Rune Møller","Augenstein, Isabelle","Ellersgaard, Christoph","Simonsen, Kristina Bakkær","Bjerva, Johannes","Høyland-Kroghsbo, Nina Molin","Munksgaard, Rasmus","Jønsson, Alexandra Brandt Ryborg","Pultz, Sabina","Kruse Jensen, Louise","Andersen, Peter Ebert","Bjørk, Anders Anker","Kristensen, Peter Marcus"],"cuid":["S03-090.80-704433"],"filters":{"added":"2023-11","altsrc":["No Matches Found"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"level":"pop","mra":["hum","sci","soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Det Unge Akademi"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-CBS","DI-U-DTU","DI-U-KU","DI-U-RUC","DI-U-SDU"]},"level3all":["DI-U-AAU","DI-U-AU","DI-U-CBS","DI-U-DTU","DI-U-KU","DI-U-RUC","DI-U-SDU"]},"review":"und","rtype":["clu"],"sorti":"unge forskere regeringens forskningsstrategi er som et afsnit af skærmtrolden hugo","src":["cbs","dtu","ruc"],"src-code":["DI-U-CBS","DI-U-DTU","DI-U-RUC"],"type":"dna","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"https://www.altinget.dk/forskning/artikel/unge-forskere-regeringens-forskningsstrategi-er-som-et-afsnit-af-skaermtrolden-hugo","version":"Published Version"},"id":"S03-090.80-704433","ids":["cbs-f25b5886-77e5-492f-b153-5ee2230343e0","dtu-4281dcc9-f7c1-4f75-93ee-ac06b20ecbac","ruc-204843b5-94eb-4f45-88d2-4500cd5d13bd"],"lang":"Danish","level":"Popular","mra":["Humanities","Science/Technol