ssn":["09071814"],"newspaper":"Politiken","pages":"5-6","publisher":"JP/Politikens Hus AS","publisher_org":"JP/Politikens Hus A/S","status":"p","title":"Politiken"},"review":"Undetermined","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","Roskilde University","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["cbs-5145214a-43d8-4dd8-811a-e771cc482ed1","dtu-3579b045-eb82-4749-b6dd-18f87e5cd2cb","ku-38ae7ca9-20a7-408b-9333-5f057b1a19ed","ruc-0750ad8a-5fd9-4e3c-87f3-76d17d4062ad"],"src":["CBS Copenhagen Business School","DTU Technical University of Denmark","KU University of Copenhagen","RUC Roskilde University"],"title":"Forskningsfriheden i Danmark er under pres","type":"Newspaper Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-093.39-031490","year":"2021","yearsub":"2021"}
{"abstract":"Predicting the destination of vessels in the maritime industry is a problem that has seen sustained research over the last few years fuelled by an increase in the availability of Automatic Identification System (AIS) data. The problem is inherently difficult due to the nature of the maritime domain. In this paper, we focus on a subset of the maritime industry - the oil transportation business - which complicates the problem of destination prediction further, as the oil transportation market is highly dynamic. We propose a novel model, inspired by research on destination prediction and anomaly detection, for predicting the destination port- and region of oil tankers. In particular, our approach utilises a graph abstraction for aggregation of global oil tanker traffic and feature engineering, and Recurrent Neural Network models for the final port- or region destination prediction. Our experiments show promising results with the final model obtaining an accuracy score of 41% and 87.1% on a destination port- and region basis respectively. While some related works obtain higher accuracy results - notably 97% port destination prediction accuracy - the results are not directly comparable, as no related literature found deals with the problem of predicting oil tanker destination on a global scale specifically.","author_count":4,"contributors":["Magnussen, Búgvi Benjamin","Bläser, Nikolaj","Jensen, Rune Møller","Ylänen, Kenneth"],"cuid":["S01-000.00-383082"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Automatic Identification System AIS data","Graph abstraction","Maritime destination prediction","Oil transportation","Recurrent Neural Networks RNN"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-PR-OTH","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"destination prediction of oil tankers using graph abstractions and recurrent neural networks","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/90449189/MagnussenEtAlICCL21.pdf","version":"Published Version"},"id":"S01-000.00-383082","identifier":[{"id":"85116317110","type":"scopus"}],"ids":["itu-7b7b41ca-2921-4d21-bac7-1adba5bd108f"],"keyword":["Automatic Identification System (AIS) data","Graph abstraction","Maritime destination prediction","Oil transportation","Recurrent Neural Networks (RNN)"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-F18B38B1B35687652C7D5A675106B505"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/90449189/MagnussenEtAlICCL21.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["TORM A/S"],"nora_code":"DI-PR-OTH","used":1}],"person":[{"affno":"","corresponding":null,"first":"Búgvi Benjamin","key":"magnussenpau","last":"Magnussen","name":"Magnussen, Búgvi Benjamin","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Nikolaj","key":"bläserpau","last":"Bläser","name":"Bläser, Nikolaj","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rune Møller","key":"jensenpau","last":"Jensen","locid":"4d7fda5a-3cf4-4d39-9daf-1ae192b0e0e7","name":"Jensen, Rune Møller","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Kenneth","key":"ylänenpau","last":"Ylänen","name":"Ylänen, Kenneth","rank":4,"rolecode":"pau"}],"pub":{"eisbn":["9783030876722"],"isbn":["9783030876715"],"issn":["03029743"],"pages":"51-65","publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","subtitle":"12th International Conference, ICCL 2021 Enschede, The Netherlands, September 27–29, 2021 Proceedings","title":"Computational Logistics","volume":"13004"},"review":"Peer Reviewed","scoID":["2-s2.0-85116317110"],"search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Other Companies","Private Research","Universities","torm a/s"],"PST":["Published"]},"sid":["itu-7b7b41ca-2921-4d21-bac7-1adba5bd108f"],"src":["ITU IT University of Copenhagen"],"title":"Destination Prediction of Oil Tankers Using Graph Abstractions and Recurrent Neural Networks","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383082","year":"2021","yearsub":"2021"}
