{"author_count":2,"contributors":["Ajspur, Mai Lise","Jensen, Rune Møller"],"cuid":["S01-000.00-381858"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"a decomposed fourier motzkin framework to derive capacity models of container vessels","src":["itu"],"src-code":["DI-U-ITU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-381858","ids":["itu-272fcd21-a9e2-4780-a24b-9cb189389c06"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-30AE6CD43658732A6D5C0194F5745C60"],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, Machine Learning"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Mai Lise","key":"ajspurpau","last":"Ajspur","name":"Ajspur, Mai Lise","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rune Møller","key":"jensenpau","last":"Jensen","locid":"4d7fda5a-3cf4-4d39-9daf-1ae192b0e0e7","name":"Jensen, Rune Møller","rank":2,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-272fcd21-a9e2-4780-a24b-9cb189389c06"],"src":["ITU IT University of Copenhagen"],"title":"A decomposed Fourier-Motzkin framework to derive capacity models of container vessels","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381858","year":"2018","yearsub":"2018"}
{"abstract":"Objectives. Recurrent arrhythmia after pulmonary vein isolation (PVI) by radiofrequency (RF) ablation in patients with atrial fibrillation (AFIB) remains a significant challenge. Using contact force (CF) sensing ablation catheters, we aimed to identify procedure related parameters associated with recurrence after de-novo PVI in patients with AFIB. Methods. Consecutive patients undergoing a de-novo PVI procedure (n = 120, 63% paroxysmal and 37% persistent AFIB) employing a force-sensing ablation catheter were included. A clinical control including electrocardiogram and 120 hour of Holter-recording at 12-months was performed in all patients. Recurrence was defined as any documented AFIB or atrial flutter more than 30 seconds on Holter-recording after an initial blanking period of three months. Results. Recurrence occurred in 44 patients (37%). Mean CF was lower in patients with recurrent arrhythmia (22.2 ± 9.5 vs. 28.8 ± 9.3 g, p <.001). In multi-variable analyses lower mean CF (OR 0.9 (95% CI 0.8–1.0), p =.03), and higher percentage of ablation time with a CF <10 grams (OR 1.1 (95% CI 1.0–1.1), p =.004) were both associated with recurrence in two distinct models. Dragging during ablation compared with point-by-point ablation technique was associated with recurrence in both models (OR 19.2 (95% CI 2.9–130.0), p =.002, and OR 21.7 (95% CI 2.7–176.2), p =.004). Conclusions. Low CF and dragging during ablation as compared with point-by-point ablation technique were associated with recurrent arrhythmia in patients with AFIB undergoing de-novo PVI by RF ablation.","author_count":9,"contributors":["Tofig, Bawer J.","Lukac, Peter","Borregaard, Rune","Nielsen, Jan Møller","Jensen, Henrik Kjærulf","Gerdes, Christian","Kristensen, Jens","Nielsen, Jens Cosedis","Kristiansen, Steen Buus"],"cuid":["S01-000.00-238576"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Journal Article"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"recurrence after pulmonary vein isolation is associated with low contact force","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85035775345","version":"Other Version"},"id":"S01-000.00-238576","identifier":[{"id":"85035775345","type":"scopus"},{"id":"29191055","type":"pmid"}],"ids":["au-bf79f909-7454-42d9-87be-9d42de20a28c"],"keyword":["Journal Article"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-1DE059ACEFAF53038ED87FEB10BCA91A"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Department of Cardiological Medicine B"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Bawer Jalal","key":"tofigbawerjpau","last":"Tofig","locid":"b917bc47-c2e2-4b4c-83c1-1f73da851278","name":"Tofig, Bawer J.","name_org":"Tofig, Bawer Jalal","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Peter","key":"lukacpeterpau","last":"Lukac","locid":"fd777227-f249-49d0-a043-7fb8e56d93c1","name":"Lukac, Peter","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rune","key":"borregaardrunepau","last":"Borregaard","locid":"6ccde17a-fbce-4e7a-86b5-8be2c3b63bee","name":"Borregaard, Rune","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jan Møller","key":"nielsenjanmøllerpau","last":"Nielsen","locid":"3dfc7ef1-d234-4cd0-a581-4cd316301be4","name":"Nielsen, Jan Møller","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik Kjærulf","key":"jensenhenrikkjærulfpau","last":"Jensen","locid":"5fb8d709-1b6d-4959-8f16-a4b5d78b436d","name":"Jensen, Henrik Kjærulf","orcid":"0000-0003-1802-4302","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Christian","key":"gerdeschristianpau","last":"Gerdes","locid":"43704ceb-b5ba-49ac-bff8-5e26e3b9d419","name":"Gerdes, Christian","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jens","key":"kristensenjenspau","last":"Kristensen","locid":"ede439bf-3ff5-4519-9c5b-5c2e1a1daea0","name":"Kristensen, Jens","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens Cosedis","key":"nielsenjenscosedispau","last":"Nielsen","locid":"cc1c8be7-f54a-4722-8077-aa358f9b090a","name":"Nielsen, Jens Cosedis","orcid":"0000-0001-9414-1653","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Steen Buus","key":"kristiansensteenbuuspau","last":"Kristiansen","locid":"16c49a27-c6b6-4552-9547-e967fe63bd06","name":"Kristiansen, Steen Buus","rank":9,"rolecode":"pau"}],"pmid":["29191055"],"pub":{"doi":"10.1080/14017431.2017.1405067","issn":["14017431"],"issue":"1","journal":"Scandinavian Cardiovascular Journal","pages":"28-33","publisher":"Informa Healthcare","status":"p","title":"Scandinavian Cardiovascular Journal","volume":"52"},"review":"Peer Reviewed","scoID":["2-s2.0-85035775345"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-bf79f909-7454-42d9-87be-9d42de20a28c"],"src":["AU Aarhus University"],"title":"Recurrence after pulmonary vein isolation is associated with low contact force","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-238576","year":"2018","yearsub":"2018"}
{"abstract":"BACKGROUND: Prophylaxis for gastrointestinal stress ulceration is frequently given to patients in the intensive care unit (ICU), but its risks and benefits are unclear. METHODS: In this European, multicenter, parallel-group, blinded trial, we randomly assigned adults who had been admitted to the ICU for an acute condition (i.e., an unplanned admission) and who were at risk for gastrointestinal bleeding to receive 40 mg of intravenous pantoprazole (a proton-pump inhibitor) or placebo daily during the ICU stay. The primary outcome was death by 90 days after randomization. RESULTS: A total of 3298 patients were enrolled; 1645 were randomly assigned to the pantoprazole group and 1653 to the placebo group. Data on the primary outcome were available for 3282 patients (99.5%). At 90 days, 510 patients (31.1%) in the pantoprazole group and 499 (30.4%) in the placebo group had died (relative risk, 1.02; 95% confidence interval [CI], 0.91 to 1.13; P=0.76). During the ICU stay, at least one clinically important event (a composite of clinically important gastrointestinal bleeding, pneumonia, Clostridium difficile infection, or myocardial ischemia) had occurred in 21.9% of patients assigned to pantoprazole and 22.6% of those assigned to placebo (relative risk, 0.96; 95% CI, 0.83 to 1.11). In the pantoprazole group, 2.5% of patients had clinically important gastrointestinal bleeding, as compared with 4.2% in the placebo group. The number of patients with infections or serious adverse reactions and the percentage of days alive without life support within 90 days were similar in the two groups. CONCLUSIONS: Among adult patients in the ICU who were at risk for gastrointestinal bleeding, mortality at 90 days and the number of clinically important events were similar in those assigned to pantoprazole and those assigned to placebo. (Funded by Innovation Fund Denmark and others; SUP-ICU ClinicalTrials.gov number, NCT02467621 .).","author_count":138,"contributors":["Krag, Mette","Marker, Søren","Perner, Anders","Wetterslev, Jørn","Wise, Matt P","Schefold, Joerg C","Keus, Frederik","Guttormsen, Anne B","Bendel, Stepani","Borthwick, Mark","Lange, Theis","Rasmussen, Bodil Steen","Siegemund, Martin","Bundgaard, Helle","Elkmann, Thomas","Jensen, Jacob V","Nielsen, Rune D","Liboriussen, Lisbeth","Bestle, Morten H","Elkjær, Jeanie M","Palmqvist, Dorte F","Bäcklund, Minna","Laake, Jon H","Bådstøløkken, Per M","Grönlund, Juha","Breum, Olena","Walli, Akil","Winding, Robert","Iversen, Susanne","Jarnvig, Inge-Lise","White, Jonathan O","Brand, Björn","Madsen, Martin B","Quist, Lars","Thornberg, Klaus J","Møller, Anders","Wiis, Jørgen","Granholm, Anders","Anthon, Carl T","Meyhoff, Tine S","Hjortrup, Peter B","Aagaard, Søren Rosborg","Andreasen, Jo Bønding","Ankjær Sørensen, Christina","Christensen, Pernille Haure","Hauge, Jacob","Hollinger, Alexa","Scheuzger, Jonas","Tuchscherer, Daniel","Vuilliomenet, T","Takala, J","Jakob, S. M.","Vang, M. L.","Pælestik, K. B.","Andersen, K. L. D.","van der Horst, I. C. C.","Dieperink, W.","Fjølner, J.","Kjer, C. K. W.","Sølling, C","Sølling, C. G.","Karttunen, J.","Morgan, M. P. G.","Sjøbø, B.","Engstrøm, J.","Agerholm-Larsen, B","Møller, Morten H","Rasmussen, Bodil Steen","Aagaard, Søren Rosborg","Andreasen, Jo Bønding","Ankjær Sørensen, Christina","Christensen, Pernille Haure","Hauge, Jacob","Levin, Marianne","Klemmesen Jensen, Käte","Lundberg, Lillian Skov Søndergaard"],"cuid":["S03-094.66-011540"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"51-200 contributors","class":"merged","cluster_size":3,"corpau":["SUP-ICU trial group"],"keyword":["Aged","Critical Illness mortality","Female","Gastrointestinal Hemorrhage epidemiology","Humans","Injections Intravenous","Intensive Care Units","Male","Middle Aged","Proton Pump Inhibitors adverse effects","Risk Factors","Single Blind Method","Stress Physiological","Survival Analysis"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-AAU","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"pantoprazole in patients at risk for gastrointestinal bleeding in the icu","src":["aau","au","ku"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85056307726&partnerID=8YFLogxK","version":"Other Version"},"id":"S03-094.66-011540","identifier":[{"id":"000452259200005","type":"wos"},{"id":"30354950","type":"pmid"},{"id":"85056307726","type":"scopus"}],"ids":["aau-f184ed6d-bb0e-4214-9c40-7bfbebc83ef8","au-ec537654-cf6b-4dec-a6d0-a7d8b62ef49f","ku-0119f748-7a43-445d-953f-1a51a98ef938"],"keyword":["Aged","Critical Illness/mortality","Female","Gastrointestinal Hemorrhage/epidemiology","Humans","Injections, Intravenous","Intensive Care Units","Male","Middle Aged","Pantoprazole/adverse effects","Peptic Ulcer/prevention & control","Proton Pump Inhibitors/adverse effects","Risk Factors","Single-Blind Method","Stress, Physiological","Survival Analysis"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-D165A2E607DD7F5226C7BC9196D63074"],"oai":{"class":"Blocked","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["National Hospital of Denmark"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"K