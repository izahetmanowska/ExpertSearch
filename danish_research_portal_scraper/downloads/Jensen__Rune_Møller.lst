istensenpau","last":"Christensen","locid":"ccaa5c92-7e05-4fcc-a0cd-d968e54ac51b","name":"Christensen, Jacob Højgaard","orcid":"0000-0002-9835-4522","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christian C.","key":"kjeldsenpau","last":"Kjeldsen","locid":"401b523f-a4ff-43e9-aaeb-b38bf32f0fd9","name":"Kjeldsen, Christian Christrup","name_org":"Kjeldsen, Christian C.","orcid":"0000-0001-5283-5622","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rune Müller","key":"kristensenpau","last":"Kristensen","locid":"7abd3b5a-d4f5-4357-a3e9-faae69a9cfd9","name":"Kristensen, Rune Müller","orcid":"0000-0001-5132-2462","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lenette Møller","key":"jensenpau","last":"Jensen","locid":"71c7a611-86fe-4e01-bc59-49cb489dedc6","name":"Jensen, Lenette Møller","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Elisabeth","key":"rasmussenpau","last":"Rasmussen","locid":"e69e45b4-a2ba-46ad-8b4a-02eff43bde5a","name":"Rasmussen, Elisabeth","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Cristina","key":"delavillagonzalezpau","last":"de la Villa Gonzalez","locid":"aaade40a-ed4a-4b3b-b602-b668fb83b04e","name":"de la Villa Gonzalez, Cristina","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jeppe","key":"bundsgaardpau","last":"Bundsgaard","locid":"4a1b113e-a953-4404-afd0-5ed58703e8b1","name":"Bundsgaard, Jeppe","orcid":"0000-0003-0102-0321","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Sofie Gry","key":"bindslevpau","last":"Bindslev","locid":"c83214e2-0c50-42fd-a024-539ab34e5a02","name":"Bindslev, Sofie Gry","rank":8,"rolecode":"pau"}],"pub":{"status":"X"},"review":"Undetermined","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Undefined"]},"sid":["au-3b392323-49b7-44bc-a2d8-59c31c57f42b"],"src":["AU Aarhus University"],"title":"Vi har nået bagkanten af pandemien – men hvordan er det gået med elevernes faglighed?","type":"Other-Internet Publication","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-163104","year":"2022","yearsub":"2022"}
{"abstract":"An empty slot on a container vessel can be impossible to fill due to complex seaworthiness and port requirements. This vessel capacity challenge is well known in the industry, but it is hard to address in practice. For that reason, revenue management (RM) methods in liner shipping rely on simple capacity models based on maximum volume, weight, and number of refrigerated containers. In this article, we challenge this status quo by introducing the standard capacity model (SCM). The SCM is a linear programming feasible set that includes all major capacity reducing aspects of container vessel and port operations such as naval design, stability, stress forces, lashing forces, trim, draft, restows, and quay crane work time. We apply the SCM to a state-of-the-art RM method and optimize yield over a 90 days period of Maersk’s Asia-Europe services in 2018 with 296 port calls. The model solves to optimality in less than 25 min and shows that the simple capacity model used in RM today can overestimate yield by more than 20% compared to the SCM. This is substantial in an industry, where profit margins of a few percent are the norm.","author_count":2,"contributors":["Jensen, Rune Møller","Ajspur, Mai Lise"],"cuid":["S01-000.00-382739"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Container vessel capacity","Liner shipping","Revenue management","Seaworthiness requirements","Stowage rules"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"revenue management in liner shipping addressing the vessel capacity challenge","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.martra.2022.100069","version":"Published Version"},"id":"S01-000.00-382739","identifier":[{"id":"85136693770","type":"scopus"}],"ids":["itu-623b569b-f6b0-4b7e-8016-fe096c5182cb"],"keyword":["Container vessel capacity","Liner shipping","Revenue management","Seaworthiness requirements","Stowage rules"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-D5261593245C29C437F64EA97959E101"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.martra.2022.100069","version":"Published Version"},{"access":"oa","type":"rem","url":"https://www.sciencedirect.com/science/article/pii/S2666822X22000193","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Rune Møller","key":"jensenpau","last":"Jensen","locid":"4d7fda5a-3cf4-4d39-9daf-1ae192b0e0e7","name":"Jensen, Rune Møller","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mai Lise","key":"ajspurpau","last":"Ajspur","name":"Ajspur, Mai Lise","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.martra.2022.100069","issn":["2666822X"],"journal":"Maritime Transport Research","pages":"100069","publisher":"Elsevier","status":"p","title":"Maritime Transport Research","title_org":"Maritime Transportation Research","volume":"3"},"review":"Peer Reviewed","scoID":["2-s2.0-85136693770"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-623b569b-f6b0-4b7e-8016-fe096c5182cb"],"src":["ITU IT University of Copenhagen"],"title":"Revenue management in liner shipping : Addressing the vessel capacity challenge","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382739","year":"2022","yearsub":"2022"}
{"abstract":"INTRODUCTION: Inflammatory bowel diseases (IBD), encompassing Crohn's disease and ulcerative colitis, are chronic, inflammatory diseases of the gastrointestinal tract. We have initiated a Danish population-based inception cohort study aiming to investigate the underlying mechanisms for the heterogeneous course of IBD, including need for, and response to, treatment. METHODS AND ANALYSIS: IBD Prognosis Study is a prospective, population-based inception cohort study of unselected, newly diagnosed adult, adolescent and paediatric patients with IBD within the uptake area of Hvidovre University Hospital and Herlev University Hospital, Denmark, which covers approximately 1 050 000 inhabitants (~20% of the Danish population). The diagnosis of IBD will be according to the Porto diagnostic criteria in paediatric and adolescent patients or the Copenhagen diagnostic criteria in adult patients. All patients will be followed prospectively with regular clinical examinations including ileocolonoscopies, MRI of the small intestine, validated patient-reported measures and objective examinations with intestinal ultrasound. In addition, intestinal biopsies from ileocolonoscopies, stool, rectal swabs, saliva samples, swabs of the oral cavity and blood samples will be collected systematically for the analysis of biomarkers, microbiome and genetic profiles. Environmental factors and quality of life will be assessed using questionnaires and, when available, automatic registration of purchase data. The occurrence and course of extraintestinal manifestations will be evaluated by rheumatologists, dermatologists and dentists, and assessed by MR cholangiopancreatography, MR of the spine and sacroiliac joints, ultrasonography of peripheral joints and entheses, clinical oral examination, as well as panoramic radiograph of the jaws. Fibroscans and dual-energy X-ray absorptiometry scans will be performed to monitor occurrence and course of chronic liver diseases, osteopenia and osteoporosis. ETHICS AND DISSEMINATION: This study has been approved by Ethics Committee of the Capital Region of Denmark (approval number: H-20065831). Study results will be disseminated through publication in international scientific journals and presentation at (inter)national conferences.","author_count":33,"contributors":["Attauabi, Mohamed","Madsen, Gorm Roager","Bendtsen, Flemming","Wewer, Vibeke","Wilkens, Rune","Ilvemark, Johan","Vladimirova, Nora","Jensen, Annette Bøjer","Jensen, Frank Krieger","Hansen, Sanja Bay","Siebner, Hartwig Roman","Nielsen, Yousef Jesper Wirenfeldt","Møller, Jakob M.","Thomsen, Henrik S","Thomsen, Simon Francis","Ingels, Helene Andrea Sinclair","Theede, Klaus","Boysen, Trine","Bjerrum, Jacob Tveiten","Jakobsen, Christian","Dorn-Rasmussen, Maria","Jansson, Sabine","Yao, Yiqiu","Burian, Ewa A.","Møller, Frederik Trier","Fana, Viktoria","Wiell, Charlotte","Terslev, Lene","Østergaard, Mikkel","Bertl, Kristina","Stavropoulos, Andreas","Seidelin, Jakob Benedict","Burisch, Johan"],"cuid":["S01-000.00-540719"],"filters":{"added":"2022-08","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"country":["Sweden"],"glorg":["All Global Affiliations","Malmö University"],"keyword":["Adolescent","Adult","Child","Cohort Studies","Colitis Ulcerative therapy","Humans","Inflammatory Bowel Diseases diagnosis","Microbiota","Prognosis","Prospective Studies","Quality of Life"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"influence of genetics immunity and the microbiome on the prognosis of inflammatory bowel disease ibd prognosis study the protocol for a copenhagen ibd inception cohort study","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1136/bmjopen-2021-055779","version":"Published Version"},"id":"S01-000.00-540719","identifier":[{"id":"35760545","type":"pmid"},{"id":"PMC9237907","type":"pmcid"},{"id":"85132957319","type":"scopus"}],"ids":["ku-f6b8bac5-b506-4970-8021-8d470d7de221"],"keyword":["Adolescent","Adult","Child","Cohort Studies","Colitis, Ulcerative/therapy","Humans","Inflammatory Bowel Diseases/diagnosis","Microbiota","Prognosis","Prospective Studies","Quality of Life"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-79CF09CDBAFA92C19C4271A757C897E4"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://curis.ku.dk/ws/files/316407693/e055779.full.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1136/bmjopen-2021-055779","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Amager and Hvidovre"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Internal Medicine: Gastroenterology and Hepatology"],"nora_code":"