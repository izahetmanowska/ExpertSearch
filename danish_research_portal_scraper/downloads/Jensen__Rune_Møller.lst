org":["14602350"],"issue":"8","journal":"Human Reproduction","pages":"2309-2320","publisher":"Oxford University Press","status":"p","title":"Human Reproduction","volume":"36"},"review":"Peer Reviewed","scoID":["2-s2.0-85112126899"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-cc4cf1ad-fa99-4197-aa64-19167ea81544"],"src":["SDU University of Southern Denmark"],"title":"Impaired fecundity as a marker of health and survival : a Danish twin cohort study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-631732","year":"2021","yearsub":"2021"}
