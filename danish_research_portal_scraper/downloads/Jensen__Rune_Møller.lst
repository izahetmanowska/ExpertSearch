ianskovsøndergaardoth","last":"Lundberg","locid":"efa78851-464f-4fde-969e-866a0c56bb6f","name":"Lundberg, Lillian Skov Søndergaard","rank":76,"role":"Other","rolecode":"oth"}],"pmid":["30354950"],"pub":{"doi":"10.1056/nejmoa1714919","issn":["00284793","15334406"],"issn_org":["00284793"],"issue":"23","journal":"The New England Journal of Medicine","pages":"2199-2208","status":"p","title":"The New England Journal of Medicine","title_org":"New England Journal of Medicine","volume":"379"},"review":"Peer Reviewed","scoID":["2-s2.0-85056307726"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["aau-f184ed6d-bb0e-4214-9c40-7bfbebc83ef8","au-ec537654-cf6b-4dec-a6d0-a7d8b62ef49f","ku-0119f748-7a43-445d-953f-1a51a98ef938"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen"],"title":"Pantoprazole in Patients at Risk for Gastrointestinal Bleeding in the ICU","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-094.66-011540","year":"2018","yearsub":"2018"}
{"abstract":"It is well-known that laboratory testing of pervious concrete's freeze-thaw performance is too harsh and does not agree well with field observations. The most commonly used laboratory freeze-thaw test method for pervious concrete is similar to that used for conventional concrete even though the void structure of the two materials is completely different. In the present study, a new freeze-thaw test method for pervious concrete is suggested and tested on one baseline mix, with three different contents of entrained air. The evaluation of freeze-thaw damage on pervious concrete beams was evaluated from the decrease in mass and from operational modal analysis which provides an accurate determination of the change in natural frequencies with freeze-thaw exposure. Operational modal analysis was also used to determine the Young's modulus, shear modulus, and Poisson's ratio of the pervious concrete mix.","author_count":5,"contributors":["Lund, Mia Schou Møller","Hansen, Kurt Kielsgaard","Brincker, Rune","Jensen, Anders Hedegaard","Amador, Sandro"],"cuid":["S01-000.00-323531"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Lund, Mia Schou Møller"],"keyword":["Freeze thaw durability","Operational modal analysis","Pervious concrete","Poisson s ratio","Shear modulus","Young s modulus"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"evaluation of freeze thaw durability of pervious concrete by use of operational modal analysis","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85041476578","version":"Other Version"},"id":"S01-000.00-323531","identifier":[{"id":"85041476578","type":"scopus"}],"ids":["dtu-3fb0d0fd-fba3-4263-adae-6b5b09e2ab32"],"keyword":["Freeze-thaw durability","Operational modal analysis","Pervious concrete","Poisson's ratio","Shear modulus","Young's modulus"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-1F2AAEE0DD7E676803E21E78CC65FB4A"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Civil Engineering","Technical University of Denmark, Department of Civil Engineering, Section for Building Design"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"M.S.M.","key":"lundpau","last":"Lund","locid":"644622d2-be6f-467f-b3de-fd92f1f23010","name":"Lund, Mia Schou Møller","name_org":"Lund, M.S.M.","orcid":"0000-0002-6503-7264","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"K. K.","key":"hansenpau","last":"Hansen","locid":"fab88e2e-5455-4f43-bc74-1b664f7a9481","name":"Hansen, Kurt Kielsgaard","name_org":"Hansen, K. K.","orcid":"0000-0002-2985-1867","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"R.","key":"brinckerpau","last":"Brincker","locid":"4952b7a4-7ae3-4089-9145-fdf0023b883e","name":"Brincker, Rune","name_org":"Brincker, R.","orcid":"0000-0002-5344-1649","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"A. H.","key":"jensenpau","last":"Jensen","locid":"ea4add33-41f1-4fff-8afc-2ca3283a603c","name":"Jensen, Anders Hedegaard","name_org":"Jensen, A. H.","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"S. D.R.","key":"amadorpau","last":"Amador","locid":"3e53da0b-d147-43c5-8eea-c9214bae8d48","name":"Amador, Sandro","name_org":"Amador, S. D.R.","orcid":"0000-0003-3045-2916","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.cemconres.2018.01.021","issn":["00088846"],"journal":"Cement and Concrete Research","pages":"57-64","publisher":"Elsevier","status":"p","title":"Cement and Concrete Research","volume":"106"},"review":"Peer Reviewed","scoID":["2-s2.0-85041476578"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-3fb0d0fd-fba3-4263-adae-6b5b09e2ab32"],"src":["DTU Technical University of Denmark"],"title":"Evaluation of freeze-thaw durability of pervious concrete by use of operational modal analysis","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-323531","year":"2018","yearsub":"2018"}
{"abstract":"Background and objectives: Most telemedicine solutions are proprietary and disease specific which cause a heterogeneous and silo-oriented system landscape with limited interoperability. Solving the interoperability problem would require a strong focus on data integration and standardization in telemedicine infrastructures. Our objective was to suggest a future-proof architecture, that consisted of small loose-coupled modules to allow flexible integration with new and existing services, and the use of international standards to allow high re-usability of modules, and interoperability in the health IT landscape. Methods: We identified core features of our future-proof architecture as the following (1) To provide extended functionality the system should be designed as a core with modules. Database handling and implementation of security protocols are modules, to improve flexibility compared to other frameworks. (2) To ensure loosely coupled modules the system should implement an inversion of control mechanism. (3) A focus on ease of implementation requires the system should use HL7 FHIR (Fast Interoperable Health Resources) as the primary standard because it is based on web-technologies. Results: We evaluated the feasibility of our architecture by developing an open source implementation of the system called ORDS. ORDS is written in TypeScript, and makes use of the Express Framework and HL7 FHIR DSTU2. The code is distributed on GitHub. All modules have been tested unit wise, but end-to-end testing awaits our first clinical example implementations. Conclusions: Our study showed that highly adaptable and yet interoperable core frameworks for telemedicine can be designed and implemented. Future work includes implementation of a clinical use case and evaluation.","author_count":6,"contributors":["Gøeg, Kirstine Rosenbeck","Rasmussen, Rune Kongsgaard","Jensen, Lasse","Wollesen, Christian Møller","Larsen, Søren","Pape-Haugaard, Louise"],"cuid":["S01-000.00-065631"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["HL7 FHIR","IT architecture","Open source","Standardization","Telemedicine"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"a future proof architecture for telemedicine using loose coupled modules and hl000000000007 fhir","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85053430605&partnerID=8YFLogxK","version":"Other Version"},"id":"S01-000.00-065631","identifier":[{"id":"85053430605","type":"scopus"}],"ids":["aau-35a83156-204a-496d-ae11-7d0e035689be"],"keyword":["HL7 FHIR","IT-architecture","Open source","Standardization","Telemedicine"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-CB469CE8408F79DE375F5E1AEF6FCF25"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Medical Informatics Group (CT)","Aalborg University, The Technical Faculty of IT and Design, Department of Sustainability and Planning, Danish Centre for Health Informatics"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Kirstine Rosenbeck","key":"gøegpau","last":"Gøeg","locid":"002f8e15-e2aa-4ee3-8fbd-980278df7bf3","name":"Gøeg, Kirstine Rosenbeck","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rune Kongsgaard","key":"rasmussenpau","last":"Rasmussen","locid":"cbd89d5b-af4c-4ee3-8d46-32647f5afcf9","name":"Rasmussen, Rune Kongsgaard","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lasse","key":"jensenpau","last":"Jensen","locid":"69e3933f-7087-4629-84f8-3d01e0b424db","name":"Jensen, Lasse","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Christian Møller","key":"wollesenpau","last":"Wollesen","locid":"94aecd96-d01a-42ef-84b2-92db6d7d3990","name":"Wollesen, Christian Møller","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren","key":"larsenpau","last":"Larsen","locid":"6cea9a2f-0843-4d84-bb7f-3d4897f7599f","name":"Larsen, Søren","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Louise","key":"papehaugaardpau","last":"Pape-Haugaard","locid":"6ac3d995-b8ba-4b19-a7db-31dc16323e3c","name":"Pape-Haugaard, Louise","orcid":"0000-0002-1655-8792","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.cmpb.2018.03.010","issn":["01692607","18727565"],"issn_org":["01692607"],"journal":"Computer Methods and Programs in Biomedicine","pages":"95-101","publisher":"Elsevier","status":"p","title":"Computer Methods and Programs in Biomedicine","volume":"160"},"review":"Peer Reviewed","scoID":["2-s2.0-85053430605"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-35a83156-204a-496d-ae11-7d0e035689be"],"src":["AAU Aalborg University"],"title":"A future-proof architecture for telemedicine using loose-coupled modules and HL7 FHIR","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-065631","year":"2018","yearsub":"2018"}
{"abstract":"Container liner shipping is about matching spare capacity to cargo in need of transport. This can be realized using cargo flow networks, where edges are associated with vessel capacity. It is hard, though, to calculate free capacity of container vessels unless full-blown non-linear stowage optimization models are applied. This may cause such flow network optimization to be intractable. To address this challenge, we introduce the Standard Capacity Model (SCM). SCMs are succinct linear capacity models derived from vessel data that can be integrated in higher order optimization models as mentioned above. In this paper, we introduce the hydrostatic core of the SCM. Our results show that it can predict key parameters like draft, trim, and stress forces accurately and thus can model capacity reductions due to these factors.","author_count":5,"contributors":["Jensen, Rune Møller","Ajspur, Mai Lise"],"cuid":["S01-000.00-384193"],"event":{"acronym":"ICCL","title":"International Conference on Computational Logistics"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Container vessel capacity","Linear modelling","Stowage planning"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"the standard capacity model towards a polyhedron representation of container vessel capacity","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/978-3-030-00898-7_11","version":"Published Version"},"id":"S01-000.00-384193","identifier":[{"id":"85057287178","type":"scopus"}],"ids":["itu-c73ef480-0ea2-44d2-84e1-49b73b3532d4"],"keyword":["container vessel capacity","linear modelling","stowage planning"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-0EB382DEE2B662BCD2499E05FC19BC8F"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1007/978-3-030-00898-7_11","version":"Published Version"},{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/84074156/iccl18.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Rune Møller","key":"jensenpau","last":"Jensen","locid":"4d7fda5a-3cf4-4d39-9daf-1ae192b0e0e7","name":"Jensen, Rune Møller","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mai Lise","key":"ajspurpau","last":"Ajspur","name":"Ajspur, Mai Lise","rank":2,"rolecode":"pau"},{"affno":"","first":"Raffael","key":"cerullipedh","last":"Cerulli","name":"Cerulli, Raffael","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Andrea","key":"raiconipedh","last":"Raiconi","name":"Raiconi, Andrea","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Stefan","key":"vosspedh","last":"Voss","name":"Voss, Stefan","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-030-00898-7_11","eisbn":["9783030008987"],"isbn":["9783030008970"],"issn":["03029743"],"pages":"175-190","publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","subtitle":"9th International conference, ICCL 2018","title":"Computational Logistics"},"review":"Peer Reviewed","scoID":["2-s2.0-85057287178"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL"