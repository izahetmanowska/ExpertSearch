OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1},{"affno":"4","country":"dk","key":"arla foods","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-ARLA","l3nl":"Arla Foods","l3nn":"Arla Foods","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Arla Foods","namevar":["Arla Foods"],"nora_code":"DI-PR-ARLA","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Nanna Stengaard","key":"villumsennannastengaardpau","last":"Villumsen","locid":"45a4023b-95a1-44a9-9923-86230284ddee","name":"Villumsen, Nanna Stengaard","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hanne Bak","key":"jensenhannebakpau","last":"Jensen","locid":"5f327f18-8e64-4c4a-852a-b87a8800e6d1","name":"Jensen, Hanne Bak","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Thao Thi Thu","key":"lethaothithupau","last":"Le","locid":"f114fe35-c2f1-437d-b00b-8beded4747a9","name":"Le, Thao Thi Thu","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Hanne Søndergård","key":"møllerhannesøndergårdpau","last":"Møller","locid":"ee4bfcda-2bdc-4dd6-90cc-3c3d00e2dbad","name":"Møller, Hanne Søndergård","rank":4,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"country":"dk","first":"Rune Thorbjørn","key":"nordvangrunethorbjørnpau","last":"Nordvang","locid":"4a650e7d-8b75-469f-8e5e-cbc32ccf3e19","name":"Nordvang, Rune Thorbjørn","rank":5,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Line","key":"ravnnielsenlinepau","last":"Ravn Nielsen","name":"Ravn Nielsen, Line","rank":6,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Line Ravn","key":"nielsenlineravnpau","last":"Nielsen","name":"Nielsen, Line Ravn","rank":6,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Søren","key":"bangnielsensørenpau","last":"Bang Nielsen","name":"Bang Nielsen, Søren","rank":7,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Søren Bang","key":"nielsensørenbangpau","last":"Nielsen","name":"Nielsen, Søren Bang","rank":7,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"John","key":"sørensenjohnpau","last":"Sørensen","name":"Sørensen, John","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Marianne","key":"hammershøjmariannepau","last":"Hammershøj","locid":"483a27e1-b030-4e4b-8441-76424c064fed","name":"Hammershøj, Marianne","orcid":"0000-0001-9297-6526","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lotte Bach","key":"larsenlottebachpau","last":"Larsen","locid":"204d7240-6828-4ee0-8ef5-77a4a2ac92d4","name":"Larsen, Lotte Bach","orcid":"0000-0001-9674-0107","rank":10,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.idairyj.2015.05.003","issn":["09586946","18790143"],"issn_org":["09586946"],"journal":"International Dairy Journal","pages":"8-15","publisher":"Elsevier BV","publisher_org":"Elsevier B.V.","status":"p","title":"International Dairy Journal","volume":"49"},"review":"Peer Reviewed","scoID":["2-s2.0-84930937631"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Private Research","All Universities","Arla Foods","DI-ALL","DI-OT","DI-OT-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Private Research","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["au-262af938-565c-4e96-b702-ff52098e35dd","dtu-35b86b04-1fd3-4c55-b7d6-c4d4e1ee85ed"],"src":["AU Aarhus University","DTU Technical University of Denmark"],"title":"Self-assembly of Caseinomacropeptide as a Potential Key Mechanism in the Formation of Visible Storage Induced Aggregates in Acidic Whey Protein Isolate Dispersions","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-096.70-015371","year":"2015","yearsub":"2015"}
{"abstract":"We solve a central problem in the liner shipping industry called the liner shipping fleet repositioning problem (LSFRP). The LSFRP poses a large financial burden on liner shipping firms. During repositioning, vessels are moved between routes in a liner shipping network. Liner carriers wish to reposition vessels as cheaply as possible without disrupting cargo flows. The LSFRP is characterized by chains of interacting activities with a multicommodity flow over paths defined by the activities chosen. Despite its industrial importance, the LSFRP has received little attention in the literature. We introduce a novel mathematical model and a simulated annealing algorithm for the LSFRP with cargo flows that makes use of a carefully constructed graph; we evaluate these approaches using real-world data from our industrial collaborator. Additionally, we compare the performance of our approach against an actual repositioning scenario, one of many undertaken by our industrial collaborator in 2011. Our simulated annealing algorithm is able to increase the profit from $18.1 to $31.8 million using only a few minutes of CPU time. This shows that our algorithm could be used in a decision support system to solve the LSFRP.","author_count":5,"contributors":["Tierney, Kevin","Askelsdottir, Björg","Jensen, Rune Møller","Pisinger, David"],"cuid":["S02-096.74-034527"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Fleet Repositioning","Liner shipping","Maritime optimization"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-ITU"]},"level3all":["DI-U-DTU","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"solving the liner shipping fleet repositioning problem with cargo flows","src":["dtu","itu"],"src-code":["DI-U-DTU","DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/130086407/lsfrpwcf_ts.pdf","version":"Authors Final Version"},"id":"S02-096.74-034527","identifier":[{"id":"84939183824","type":"scopus"}],"ids":["dtu-55f79644-28c2-491a-bfdb-851752118416","itu-b38adccb-87bb-4c23-b448-b7612c77fc84"],"keyword":["Fleet repositioning","Liner shipping","Maritime optimization"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-4E933C4D114EB89A8A1385D116C219CD"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1287/trsc.2013.0515","version":"Other Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/130086407/lsfrpwcf_ts.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","country":"dk","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","The Department, Software & Systems"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Kevin","key":"tierneypau","last":"Tierney","name":"Tierney, Kevin","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Björg","key":"askelsdottirpau","last":"Askelsdottir","name":"Askelsdottir, Björg","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Björg","key":"áskelsdóttirpau","