e":"Rosenkilde, Mette M.","orcid":"0000-0001-9600-3254","rank":24,"rolecode":"pau"},{"affno":"1","first":"Bolette","key":"hartmannbolettepau","last":"Hartmann","locid":"eb04fc6b-068a-4d5b-a106-1b7be3f7e12b","name":"Hartmann, Bolette","orcid":"0000-0001-8509-2036","rank":25,"rolecode":"pau"},{"affno":"1","first":"Bo","key":"feldtrasmussenbopau","last":"Feldt-Rasmussen","locid":"cdd06e7b-83c5-4118-8808-eb4591586aac","name":"Feldt-Rasmussen, Bo","rank":26,"rolecode":"pau"},{"affno":"1","first":"Matthias","key":"mannmatthiaspau","last":"Mann","locid":"f463f571-68c5-44fb-bff1-bb9d748fcda8","name":"Mann, Matthias","orcid":"0000-0003-1292-4799","rank":27,"rolecode":"pau"},{"affno":"1","first":"Sten","key":"madsbadstenpau","last":"Madsbad","locid":"1018c708-245a-4057-9263-074578042385","name":"Madsbad, Sten","rank":28,"rolecode":"pau"},{"affno":"1","first":"Jens J.","key":"holstjensjuulpau","last":"Holst","locid":"864b6401-9024-4773-9bdb-f4d4ca57dcad","name":"Holst, Jens Juul","name_org":"Holst, Jens J.","orcid":"0000-0001-6853-3805","rank":29,"rolecode":"pau"}],"pmid":["29117552"],"pub":{"doi":"10.1016/j.celrep.2017.10.034","issn":["22111247"],"issue":"6","journal":"Cell Reports","pages":"1452-1460","publisher":"Cell Press","status":"p","title":"Cell Reports","volume":"21"},"review":"Peer Reviewed","scoID":["2-s2.0-85034087701"],"sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-7b511021-3b07-43b6-9570-15b792cf700d","ku-5de0f9aa-7d95-4884-a486-1ef985f758da"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Circulating Glucagon 1-61 Regulates Blood Glucose by Increasing Insulin Secretion and Hepatic Glucose Production","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-096.32-035421","year":"2017","yearsub":"2017"}
{"abstract":"A distance constrained secondary structural model of the approximate to 10 kb RNA genome of the HIV-1 has been predicted but higher-order structures, involving long distance interactions, are currently unknown. We present the first global RNA secondary structure model for the HIV-1 genome, which integrates both comparative structure analysis and information from experimental data in a full-length prediction without distance constraints. Besides recovering known structural elements, we predict several novel structural elements that are conserved in HIV-1 evolution. Our results also indicate that the structure of the HIV-1 genome is highly variable in most regions, with a limited number of stable and conserved RNA secondary structures. Most interesting, a set of long distance interactions form a core organizing structure (COS) that organize the genome into three major structural domains. Despite overlapping protein-coding regions the COS is supported by a particular high frequency of compensatory base changes, suggesting functional importance for this element. This new structural element potentially organizes the whole genome into three major domains protruding from a conserved core structure with potential roles in replication and evolution for the virus.","author_count":7,"contributors":["Sükösd, Zsuzsanna","Andersen, Ebbe Sloth","Seemann, Stefan E.","Jensen, Mads Hartmann","Hansen, Mathias Brygger","Gorodkin, Jan","Kjems, Jørgen"],"cuid":["S02-096.93-014071"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Circularization","Context free grammars","Dimerization","Evolutionary","GENE","IMMUNODEFICIENCY VIRUS TYPE 1","REGION","Shape"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"full length rna structure prediction of the hiv 000000000001 genome reveals a conserved core domain","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/160856109/Full_length_RNA_structure_prediction_of_the_HIV_1_genome_reveals_a_conserved_core_domain.pdf","version":"Published Version"},"id":"S02-096.93-014071","identifier":[{"id":"PMC4666355","type":"pmcid"},{"id":"84956804878","type":"scopus"},{"id":"000366410900018","type":"wos"},{"id":"26476446","type":"pmid"}],"ids":["au-1482fe53-da4d-4195-b148-9987cc6fbd66","ku-01be223a-6b03-41ad-a7b5-f08039f0662f"],"keyword":["CIRCULARIZATION","CONSENSUS STRUCTURE PREDICTION","CONTEXT-FREE GRAMMARS","DIMERIZATION","EVOLUTIONARY","GENE","IMMUNODEFICIENCY-VIRUS TYPE-1","REGION","SECONDARY STRUCTURE PREDICTION","SHAPE"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-25CBDF9D09531A403F54F68CC1337263"],"oa_link":[{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/160856109/Full_length_RNA_structure_prediction_of_the_HIV_1_genome_reveals_a_conserved_core_domain.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Molecular Biology and Genetics, Department of Molecular Biology and Genetics - Bioinformatics Research Centre (BiRC)"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Veterinary Clinical Sciences, Animal Genetics, Bioinformatics and Breeding","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Veterinary Clinical Sciences, IKVH Animal Genetics, Bioinformatics, and breeding"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Zsuzsanna","key":"sukosdpau","last":"Sukosd","locid":"8900319d-3ff5-46e3-a04c-5d18847ca0ca","name":"Sükösd, Zsuzsanna","name_org":"Sukosd, Zsuzsanna","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ebbe S.","key":"andersenpau","last":"Andersen","locid":"c0741b1d-b5c7-46c6-9ee6-3590316882e8","name":"Andersen, Ebbe Sloth","name_org":"Andersen, Ebbe S.","orcid":"0000-0002-6236-8164","rank":2,"rolecode":"pau"},{"affno":"2","first":"Ernst Stefan","key":"seemannpau","last":"Seemann","locid":"6ad82c4a-9a7c-4587-8da7-d3733adba17a","name":"Seemann, Ernst Stefan","orcid":"0000-0002-2359-4927","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mads","key":"jensenpau","last":"Jensen","locid":"a74ffd56-1975-4c95-ae1c-1ad329090c47","name":"Jensen, Mads Hartmann","name_org":"Jensen, Mads","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mathias Brygger","key":"hansenpau","last":"Hansen","locid":"22792c8c-de6a-444c-b3d6-79e697cbf6ef","name":"Hansen, Mathias Brygger","rank":5,"rolecode":"pau"},{"affno":"2","first":"Jan","key":"gorodkinpau","last":"Gorodkin","locid":"b88e3a4e-706d-448d-8df2-9a159d1d2e86","name":"Gorodkin, Jan","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jørgen","key":"kjemspau","last":"Kjems","locid":"f5915d75-aca3-437a-9a9d-f4fdfef7accd","name":"Kjems, Jørgen","orcid":"0000-0003-4128-9317","rank":7,"rolecode":"pau"}],"pmid":["26476446"],"pub":{"doi":"10.1093/nar/gkv1039","issn":["03051048","13624962"],"issn_org":["03051048"],"issue":"21","journal":"Nucleic Acids Research","pages":"10168-10179","publisher":"Oxford University Press","status":"p","title":"Nucleic Acids Research","volume":"43"},"review":"Peer Reviewed","scoID":["2-s2.0-84956804878"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-1482fe53-da4d-4195-b148-9987cc6fbd66","ku-01be223a-6b03-41ad-a7b5-f08039f0662f"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Full-length RNA structure prediction of the HIV-1 genome reveals a conserved core domain","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-096.93-014071","year":"2015","yearsub":"2015"}
{"abstract":"Recently, the roles of osteocytes in bone maintenance have gained increasing attention. Osteocytes reside in lacunae that are interconnected by canaliculi resulting in a vast cellular network within the mineralized bone matrix. As the structure of the lacuno-canalicular network is highly connected to osteocyte function, osteocyte lacunar properties such as volume, shape, orientation, and density are now frequently reported in studies investigating osteocyte activity. Despite this increasing interest in lacunar morphometrics, many studies show a large spread in such values, suggesting a large inter-species but also inter-site variation in lacunar properties. Here, osteocyte lacunae in rat cortical bone have been studied using synchrotron radiation micro computed tomography (SR μCT) and backscattered electron (BE) microscopy. Quantitative lacunar geometric characteristics are reported based on the synchrotron radiation data, differentiating between circumferential lamellar bone and a central, more disordered bone type. From these studies, no significant differences were found in lacunar volumes between lamellar and central bone, whereas significant differences in lacunar orientation, shape and density values were observed. The 3D nature of the SR μCT data sets furthermore revealed that lacunae in central bone, which appear to be poorly aligned in transverse 2D cross sections, are in fact highly aligned along the bone long axis. These results demonstrate the importance of using 3D methods to investigate anisotropic biological materials such as bone and that the appropriate choice of subregions for high resolution imaging is not trivial.","author_count":9,"contributors":["Bach-Gansmo, Fiona Linnea","Weaver, James C.","Jensen, Mads Hartmann","Leemreize, Hanna","Mader, Kevin Scott","Stampanoni, Marco","Brüel, Annemarie","Thomsen, Jesper Skovhus","Birkedal, Henrik"],"cuid":["S01-000.00-176770"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","Europe, Non-EU","OECD"],"corresponding_author":["Birkedal, Henrik"],"country":["Switzerland","United States"],"glorg":["All Global Affiliations","Harvard University","Paul Scherrer Institute"],"keyword":["Backscattered electron imaging","Microcomputed tomography","Osteocyte lacunae","Osteocytes"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"osteocyte lacunar properties in rat cortical bone differences between lamellar and central bone","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.jsb.2015.05.005","version":"Other Version"},"id":"S01-000.00-176770","identifier":[{"id":"84937631980","type":"scopus"},{"id":"26023043","type":"pmid"}],"ids":["au-5332f7ff-0897-452e-87fb-ec1718f6683d"],"keyword":["Backscattered electron imaging","Endochondral bone","Lamellar bone","Microcomputed tomography","Osteocyte lacunae","Osteocytes"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-6C53A9235FCD4ADCFF650A06526B3043"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.jsb.2015.05.005","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Chemistry","Aarhus University, Natural Sciences, Interdisciplinary Nanoscience Center"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"us","key":"harvard university","loc":["United States","America, North","OECD"],"name":"Harvard University","used":1},{"affno":"3","country":"ch","key":"paul scherrer institute","loc":["Switzerland","Europe, Non-EU","OECD"],"name":"Paul Scherrer Institute","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Fiona Linnea","key":"bachgansmopau","last":"Bach-Gansmo","locid":"e284bfd4-4f43-499e-99cc-6d7f2c1a449f","name":"Bach-Gansmo, Fiona Linnea","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"James C.","key":"weaverpau","last":"Weaver","name":"Weaver, James C.","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mads Hartmann","key":"jensenpau","last":"Jensen","locid":"a74ffd56-1975-4c95-ae1c-1ad329090c47","name":"Jensen, Mads Hartmann","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hanna","key":"leemreizepau","last":"Leemreize","locid":"95baff90-cdd9-45e8-960a-d2c24a907dfe","name":"Leemreize, Hanna","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Kevin Scott","key":"maderpau","last":"Mader","name":"Mader, Kevin Scott","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Marco","key":"stampanonipau","last":"Stampanoni","name":"Stampanoni, Marco","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Annemarie","key":"brüelpau","last":"Brüel","locid":"aba2a94b-2aea-46c0-bdde-8b821e0f9d3f","name":"Brüel, Annemarie","orcid":"0000-0003-4833-0888","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Skovhus","key":"thomsenpau","last":"Thomsen","locid":"924ef2ac-827c-4260-9cd7-fbe300bbafeb","name":"Thomsen, Jesper Skovhus","orcid":"0000-0001-9386-6679","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik","key":"birkedalpau","last":"Birkedal","locid":"e5418e07-b317-4ecc-a9df-8bdedaa32f5b","name":"Birkedal, Henrik","orcid":"0000-0002-4201-2179","rank":9,"rolecode":"pau"}],"pmid":["26023043"],"pub":{"doi":"10.101