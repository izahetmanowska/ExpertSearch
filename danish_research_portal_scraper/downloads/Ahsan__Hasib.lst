{"author_count":2,"contributors":["Christensen, Lars Rune","Ahsan, Hasib"],"cuid":["S01-000.00-384192"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"the sensing and numeration of mental health in a refugee camp","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://dl.eusset.eu/handle/20.500.12015/4192","version":"Published Version"},"id":"S01-000.00-384192","ids":["itu-c72f9e4c-ff1c-4709-b9cc-1b372a88ad78"],"lang":"Danish","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-2BFFCD5B693F02DAC55B601C20B8CA9F"],"oa_link":[{"access":"oa","type":"rem","url":"https://dl.eusset.eu/handle/20.500.12015/4192","version":"Published Version"}],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","IT University of Copenhagen, Digital Business Innovation, Information Systems and Digital Innovation","IT University of Copenhagen, Technologies in Practice, Technologies in Practice"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Lars Rune","key":"christensenpau","last":"Christensen","locid":"92f6c3f3-0ad2-40fc-b278-69170f87567d","name":"Christensen, Lars Rune","orcid":"0000-0001-7204-465X","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hasib","key":"ahsanpau","last":"Ahsan","locid":"0bdda5a8-