pau","last":"Nielsen","locid":"cc1c8be7-f54a-4722-8077-aa358f9b090a","name":"Nielsen, Jens Cosedis","orcid":"0000-0001-9414-1653","rank":11,"rolecode":"pau"},{"affno":"2","first":"Ida","key":"gustafssonidapau","last":"Gustafsson","name":"Gustafsson, Ida","rank":12,"rolecode":"pau"},{"affno":"1 6","corresponding":null,"country":"dk","first":"Henrik","key":"wiggershenrikpau","last":"Wiggers","locid":"aef6a13e-8c07-474c-a4f6-bc35236a6eda","name":"Wiggers, Henrik","rank":13,"rolecode":"pau"}],"pmid":["32292074"],"pub":{"doi":"10.1080/14017431.2020.1751873","issn":["14017431"],"issue":"5","journal":"Scandinavian Cardiovascular Journal","pages":"294-299","publisher":"Informa Healthcare","status":"p","title":"Scandinavian Cardiovascular Journal","volume":"54"},"review":"Peer Reviewed","scoID":["2-s2.0-85083499216"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-f02afeaa-62ac-4557-8faf-f485fffac813","ku-e47532ea-6618-4b20-9eff-f1b47b9b186b","sdu-d7d1a893-b4ba-45a1-a2d2-7154abce17b5"],"src":["AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Heart rate increases in liraglutide treated chronic heart failure patients : association with clinical parameters and adverse events. Liraglutide increases heart rate only in chronic heart failure patients with sinus rhythm and independently of beta-blocker dose","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-100.00-030065","year":"2020","yearsub":"2020"}
{"abstract":"BACKGROUND: The glucagon-like peptide-1 analog liraglutide increases heart rate and may be associated with more cardiac events in chronic heart failure (CHF) patients. We studied whether this could be ascribed to effects on myocardial glucose uptake (MGU), myocardial blood flow (MBF) and MBF reserve (MFR). METHODS AND RESULTS: CHF patients with left ventricular ejection fraction ≤45% and without type 2 diabetes were randomized to liraglutide (N = 18) 1.8 mg once daily or placebo (N = 18) for 24 weeks in a double-blinded design. Changes in MGU during an oral glucose tolerance test (OGTT) and changes in MBF and MFR from baseline to follow-up were measured quantitatively by (18)F-FDG and (15)O-H2O positron emission tomography. Compared with placebo, liraglutide reduced weight (P = 0.03), HbA1c (P = 0.03) and the 2-hour glucose value during the OGTT (P = 0.004). Despite this, changes in MGU (P = 0.98), MBF (P = 0.76) and MFR (P = 0.89) from baseline to follow-up did not differ between groups. Furthermore, there was no association between the level of insulin resistance at baseline and changes in MGU in patients treated with liraglutide. CONCLUSION: Liraglutide did not affect MGU, MBF, or MFR in non-diabetic CHF patients. Any potential increase in cardiac events in these patients seems not to involve changes in MGU, MBF, or MFR. TRIAL REGISTRATION: Trial registry: http://www.ClinicalTrials.org . Identifier: NCT01472640. Url: https://clinicaltrials.gov/ct2/show/NCT01472640?term=NCT01472640&rank=1.","author_count":13,"contributors":["Nielsen, Bent Roni Ranghøj","Jorsal, Anders","Iversen, Peter","Tolbod, Lars Poulsen","Bouchelouche, Kirsten","Sørensen, Jens","Harms, Hendrik Johannes","Flyvbjerg, Allan","Tarnow, Lise","Kistorp, Caroline","Gustafsson, Ida","Bøtker, Hans Erik","Wiggers, Henrik"],"cuid":["S02-094.10-014670"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"keyword":["Journal Article"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"effect of liraglutide on myocardial glucose uptake and blood flow in stable chronic heart failure patients a double blind randomized placebo controlled live sub study","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85026772137","version":"Other Version"},"id":"S02-094.10-014670","identifier":[{"id":"85026772137","type":"scopus"},{"id":"28770459","type":"pmid"}],"ids":["au-1c775a8a-1864-4be4-86c8-c4c10eade9c6","ku-bd0c85ae-2cf1-4def-be5c-318dbca06366"],"keyword":["Journal Article"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-5C910CF1F505DB81AE4CD90FAA88B4E0"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2018"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Department of Cardiological Medicine B"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Internal Medicine: Endocrinology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Roni","key":"nielsenpau","last":"Nielsen","locid":"896f4a21-d29c-4ad9-b0ef-4e7f8616c234","name":"Nielsen, Bent Roni Ranghøj","name_org":"Nielsen, Roni","orcid":"0000-0001-9228-3869","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders","key":"jorsalpau","last":"Jorsal","locid":"16e0eff8-d885-41bc-afb7-89c374f7c0c9","name":"Jorsal, Anders","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Peter","key":"iversenpau","last":"Iversen","locid":"652caf77-ea4a-47a4-b9bf-98a5ec21d9dc","name":"Iversen, Peter","orcid":"0000-0003-2455-5142","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars Poulsen","key":"tolbodpau","last":"Tolbod","locid":"a1e56507-eb80-4f94-9470-df90dcecbc62","name":"Tolbod, Lars Poulsen","orcid":"0000-0002-8105-7046","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kirsten","key":"bouchelouchepau","last":"Bouchelouche","locid":"f253980f-a953-448a-bdfb-2a0fcfe82101","name":"Bouchelouche, Kirsten","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens","key":"sørensenpau","last":"Sørensen","locid":"cab278f0-6db5-48a8-8764-b7da319d7818","name":"Sørensen, Jens","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hendrik Johannes","key":"harmspau","last":"Harms","name":"Harms, Hendrik Johannes","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Allan","key":"flyvbjergpau","last":"Flyvbjerg","name":"Flyvbjerg, Allan","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lise","key":"tarnowpau","last":"Tarnow","locid":"6b6dbace-aade-4f49-a8d0-dc2002ee9119","name":"Tarnow, Lise","rank":9,"rolecode":"pau"},{"affno":"2","first":"Caroline","key":"kistorppau","last":"Kistorp","locid":"42328645-d772-4f53-9f70-438ff40291b9","name":"Kistorp, Caroline","orcid":"0000-0002-3019-6775","rank":10,"rolecode":"pau"},{"affno":"","first":"Ida","key":"gustafssonpau","last":"Gustafsson","name":"Gustafsson, Ida","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Hans Erik","key":"bøtkerpau","last":"Bøtker","locid":"09b03c00-11a8-4f72-800f-181f26155750","name":"Bøtker, Hans Erik","orcid":"0000-0001-6358-8962","rank":12,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik","key":"wiggerspau","last":"Wiggers","locid":"aef6a13e-8c07-474c-a4f6-bc35236a6eda","name":"Wiggers, Henrik","rank":13,"rolecode":"pau"}],"pmid":["28770459"],"pub":{"doi":"10.1007/s12350-017-1000-2","issn":["10713581","15326551"],"issn_org":["10713581"],"issue":"2","journal":"Journal of Nuclear Cardiology","pages":"585-597","publisher":"American Society of Nuclear Cardiology","status":"p","title":"Journal of Nuclear Cardiology","volume":"26"},"review":"Peer Reviewed","scoID":["2-s2.0-85026772137"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-1c775a8a-1864-4be4-86c8-c4c10eade9c6","ku-bd0c85ae-2cf1-4def-be5c-318dbca06366"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Effect of liraglutide on myocardial glucose uptake and blood flow in stable chronic heart failure patients : A double-blind, randomized, placebo-controlled LIVE sub-study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-094.10-014670","year":"2019","yearsub":2019}
{"abstract":"This paper gives an overview of good and bad practice for understanding and curbing cost overrun in large capital investment projects, with a critique of Love and Ahiaga-Dagbui (2018) as point of departure. Good practice entails: (a) Consistent definition and measurement of overrun; in contrast to mixing inconsistent baselines, price levels, etc. (b) Data collection that includes all valid and reliable data; as opposed to including idiosyncratically sampled data, data with removed outliers, non-valid data from consultancies, etc. (c) Recognition that cost overrun is systemically fat-tailed; in contrast to understanding overrun in terms of error and randomness. (d) Acknowledgment that the root cause of cost overrun is behavioral bias; in contrast to explanations in terms of scope changes, complexity, etc. (e) De-biasing cost estimates with reference class forecasting or similar methods based in behavioral science; as opposed to conventional methods of estimation, with their century-long track record of inaccuracy and systemic bias. Bad practice is characterized by violating at least one of these five points. Love and Ahiaga-Dagbui violate all five. In so doing, they produce an exceptionally useful and comprehensive catalog of the many pitfalls that exist, and must be avoided, for properly understanding and curbing cost overrun.","author_count":14,"contributors":["Flyvbjerg, Bent","Ansar, Atif","Budzier, Alexander","Buhl, Søren","Cantarelli, Chantal","Garbuio, Massimo","Glenting, Carsten","Holm, Mette Skamris","Lovallo, Dan","Lunn, Daniel","Molin, Eric","Rønnest, Arne","Stewart, Allison","van Wee, Bert"],"cuid":["S01-000.00-116793"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","OECD","Oceania"],"corresponding_author":["Flyvbjerg, Bent"],"country":["Australia","Netherlands","United Kingdom"],"glorg":["All Global Affiliations","Delft University of Technology","Department of Zoology","Infrastructure Victoria","University of Oxford","University of Sheffield","University of Sydney"],"keyword":["Agency","Behavioral Science","Cost forecasting","Cost overrun","Deception","Delusion","Moral hazard","Optimism bias","Reference class forecasting","Strategic Misrepresentation"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-PR","DI-U"],"level3":{"OT":["Aalborg Municipality"],"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-PR-OTH","DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"five things you should know about cost overrun","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85053110939&partnerID=8YFLogxK","version":"Other Version"},"id":"S01-000.00-116793","identifier":[{"id":"85053110939","type":"scopus"}],"ids":["aau-e597f69f-4f60-4b5f-bb0f-b5ed4731f293"],"keyword":["Agency","Behavioral science","Cost forecasting","Cost overrun","Cost underestimation","De-biasing","Deception","Delusion","Moral hazard","Optimism bias","Reference class forecasting","Root causes of cost overrun","Strategic misrepresentation"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-334CF74B0A8681305918E70590FC0B78"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","country":"gb","key":"university of oxford","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Oxford","used":1},{"affno":"2","country":"gb","key":"department of zoology","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Department of Zoology","used":1},{"affno":"3","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OEC