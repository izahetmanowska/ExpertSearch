81"],"issue":"1","journal":"Journal of Nuclear Cardiology","pages":"169-176","publisher":"American Society of Nuclear Cardiology","status":"p","title":"Journal of Nuclear Cardiology","volume":"25"},"review":"Peer Reviewed","scoID":["2-s2.0-84980027683"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-696812c4-b4c3-4c3c-ab17-7958e1aa107c"],"src":["AU Aarhus University"],"title":"Heart failure patients with prediabetes and newly diagnosed diabetes display abnormalities in myocardial metabolism","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-189515","year":"2018","yearsub":"2018"}
