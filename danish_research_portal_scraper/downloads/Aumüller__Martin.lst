l,"first":"Rasmus","key":"paghpau","last":"Pagh","name":"Pagh, Rasmus","rank":3,"rolecode":"pau"}],"pub":{"pages":"3108-3137","status":"p","subtitle":"International Conference on Artificial Intelligence and Statistics","title":"AISTATS 2022","volume":"151"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-f4f6c1a0-35f6-41d1-861c-90d500bf3f38"],"src":["ITU IT University of Copenhagen"],"title":"DEANN: Speeding up Kernel-Density Estimation using Approximate Nearest Neighbor Search","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384873","year":"2022","yearsub":"2022"}
{"abstract":"Representing a sparse histogram, or more generally a sparse vector, is a fundamental task in differential privacy. An ideal solution would use space close to information-theoretical lower bounds, have an error distribution that depends optimally on the desired privacy level, and allow fast random access to entries in the vector. However, existing approaches have only achieved two of these three goals. In this paper we introduce the Approximate Laplace Projection (ALP) mechanism for approximating k-sparse vectors. This mechanism is shown to simultaneously have information-theoretically optimal space (up to constant factors), fast access to vector entries, and error of the same magnitude as the Laplace-mechanism applied to dense vectors. A key new technique is a unary representation of small integers, which we show to be robust against \"randomized response'' noise. This representation is combined with hashing, in the spirit of Bloom filters, to obtain a space-efficient, differentially private representation. Our theoretical performance bounds are complemented by simulations which show that the constant factors on the main performance parameters are quite small, suggesting practicality of the technique.","author_count":3,"contributors":["Aumüller, Martin","Lebeda, Christian Janos","Pagh, Rasmus"],"cuid":["S02-087.63-038382"],"event":{"acronym":"CCS","end":"2021-11-19","place":"Virtual, Online, kr","start":"2021-11-15","title":"27th ACM Annual Conference on Computer and Communication Security, CCS 2021","year":"2021"},"filters":{"added":"2022-06","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Algorithms","Approximate Laplace Projection","Bloom Filters","Differential Privacy","Sparse Vectors","Unary Representation"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-KU"]},"level3all":["DI-U-ITU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"differentially private sparse vectors with low error optimal space and fast access","src":["itu","ku"],"src-code":["DI-U-ITU","DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1145/3460120.3484735","version":"Published Version"},"id":"S02-087.63-038382","identifier":[{"id":"85119327742","type":"scopus"}],"ids":["itu-cbf5feb8-e86a-4b7b-888c-c6f0d762edbb","ku-669a0de8-980e-4a28-b15f-7c6a65135b77"],"keyword":["Approximate Laplace Projection","Bloom Filters","Sparse Vectors","Unary Representation","algorithms","differential privacy","sparse vector"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-89557A369413BF391122E5137235E346"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86422208/2106.10068.pdf","version":"Authors Final Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1145/3460120.3484735","version":"Published Version"},{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/321172634/Differentially_Private_Sparse_Vectors_with_Low_Error_Optimal_Space_and_Fast_Access.pdf","version":"Pre-print"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Theoretical Computer Science, Algorithms"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Algorithms and Complexity"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Martin","key":"aumüllerpau","last":"Aumüller","locid":"5f52759c-418a-41b7-bbdb-050492677284","name":"Aumüller, Martin","orcid":"0000-0002-7212-6476","rank":1,"rolecode":"pau"},{"affno":"2 1","first":"Rasmus","key":"paghpau","last":"Pagh","locid":"044bf2b8-4ea6-4c2e-984c-88a0267151c7","name":"Pagh, Rasmus","orcid":"0000-0002-1516-9306","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christian Janos","key":"lebedapau","last":"Lebeda","locid":"a0e31b8c-3d9c-4b68-834d-d4c06914b69f","name":"Lebeda, Christian Janos","orcid":"0000-0001-9517-8466","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1145/3460120.3484735","eisbn":["9781450384544"],"issn":["15437221"],"pages":"1223-1236","publisher":"Association for Computing Machinery","series":"Proceedings of the ACM Conference on Computer and Communications Security","status":"p","title":"CCS 2021 - Proceedings of the 2021 ACM SIGSAC Conference on Computer and Communications Security"},"review":"Peer Reviewed","scoID":["2-s2.0-85119327742"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["itu-cbf5feb8-e86a-4b7b-888c-c6f0d762edbb","ku-669a0de8-980e-4a28-b15f-7c6a65135b77"],"src":["ITU IT University of Copenhagen","KU University of Copenhagen"],"title":"Differentially Private Sparse Vectors with Low Error, Optimal Space, and Fast Access","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-087.63-038382","year":"2021","yearsub":"2021"}
{"abstract":"This paper reconsiders common benchmarking approaches to nearest neighbor search. It is shown that the concepts of local intrinsic dimensionality (LID), local relative contrast (RC), and query expansion allow to choose query sets of a wide range of difficulty for real-world datasets. Moreover, the effect of the distribution of these dimensionality measures on the running time performance of implementations is empirically studied. To this end, different visualization concepts are introduced that allow to get a more fine-grained overview of the inner workings of nearest neighbor search principles. Interactive visualizations are available on the companion website.1 The paper closes with remarks about the diversity of datasets commonly used for nearest neighbor search benchmarking. It is shown that such real-world datasets are not diverse: results on a single dataset predict results on all other datasets well.","author_count":2,"contributors":["Aumüller, Martin","Ceccarello, Matteo"],"cuid":["S01-000.00-383258"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Italy"],"glorg":["All Global Affiliations","Libera Università di Bolzano"],"keyword":["Benchmarking","Nearest neighbor search"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"the role of local dimensionality measures in benchmarking nearest neighbor search","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.is.2021.101807","version":"Published Version"},"id":"S01-000.00-383258","identifier":[{"id":"85110346528","type":"scopus"}],"ids":["itu-87cad4c0-0cbb-463e-a1ec-56af0f1092e3"],"keyword":["Benchmarking","Nearest neighbor search"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-906F92F7D0594C2856F700A5063E38E1"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://pure.itu.dk/ws/files/86422343/1.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.is.2021.101807","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Theoretical Computer Science, Algorithms"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"it","key":"libera università di bolzano","loc":["Italy","Europe, EU","OECD"],"name":"Libera Università di Bolzano","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Martin","key":"aumüllerpau","last":"Aumüller","locid":"5f52759c-418a-41b7-bbdb-050492677284","name":"Aumüller, Martin","orcid":"0000-0002-7212-6476","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Matteo","key":"ceccarellopau","last":"Ceccarello","name":"Ceccarello, Matteo","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.is.2021.101807","issn":["03064379","18736076"],"issn_org":["03064379"],"journal":"Information Systems","publisher":"Elsevier","status":"p","title":"Information Systems"},"review":"Peer Reviewed","scoID":["2-s2.0-85110346528"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-87cad4c0-0cbb-463e-a1ec-56af0f1092e3"],"src":["ITU IT University of Copenhagen"],"title":"The role of local dimensionality measures in benchmarking nearest neighbor search","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383258","year":"2021","yearsub":"2021"}
{"abstract":"Similarity search is a fundamental algorithmic primitive, widely used in many computer science disciplines. Given a set of points S and a radius parameter r > 0, the rnear neighbor (r-NN) problem asks for a data structure that, given any query point q, returns a point p within distance at most r from q. In this paper, we study the r-NN problem in the light of individual fairness and providing equal opportunities: all points that are within distance r from the query should have the same probability to be returned. In the low-dimensional case, this problem was first studied by Hu, Qiao, and Tao (PODS 2014). Locality sensitive hashing (LSH), the theoretically strongest approach to similarity search in high dimensions, does not provide such a fairness guarantee.","author_count":5,"contributors":["Aumuller, Martin","Har-Peled, Sariel","Mahabadi, Sepideh","Pagh, Rasmus","Silvestri, Francesco"],"cuid":["S02-085.41-038385"],"filters":{"added":"2022-06","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"continent":["America, North","Asia, East","Europe, EU","OECD"],"country":["Italy","Japan","United States"],"glorg":["All Global Affiliations","Toyota Technological Institute","Toyota Technological Institute at Chicago","University of Illinois","University of Illinois at Urbana-Champaign","University of Padova","University of Padua"],"keyword":["Equal opportunity","Individual fairness","Locality sensitive hashing","Similarity search","r Near Neighbor"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-KU"]},"level3all":["DI-U-ITU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"fair near neighbor search via sampling","src":["itu","ku"],"src-code":["DI-U-ITU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Andet","type":"doi","url":"https://doi.org/10.1145/3471485.3471496","version":"Published Version"},"id":"S02-085.41-038385","identifier":[{"id":"85108234781","type":"scopus"}],"ids":["itu-d16af727-dfd3-4bec-a349-9bf16a4a9a65","ku-c7dcd8c9-6369-4756-8eb3-b777838d1527"],"keyword":["Equal opportunity","Individual fairness","Locality sensitive hashing","Similarity search","r-near neighbor"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-5FD3C8F74469137A2A74191920EF5C7B"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86407904/SIGMOD_research_highlight.pdf","version":"Authors Final Version"},{"access":"oa","license":"Andet","type":"doi","url":"https://doi.org/10.1145/3471485.3471496","version":"Published Version"},{"access":"oa","license":"Andet","type":"loc","url":"https://curis.ku.dk/ws/files/300923555/Fair_near_neighbor_search_via_samplin.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Theoretical Computer Science, Algorithms"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"us","key":"university of illinois at urbana champaign","loc":["United States","America, North","OECD"],"name":"University of Illinois at Urbana-Champaign","used":1},{"affno":"3","country":"us","key":"university of illinois","loc":["United States","America, North","OECD"],"name":"University of Illinois","used":1},{"affno":"4","country":"jp","key":"toyota technological institute","loc":["Japan","Asia, East","OECD"],"name":"Toyota Technological Institute","used":1},{"affno":"5","country":"us","key":"toyota technological institute at chicago","loc":["United States","America, North","OECD"],"name":"Toyota Technological Institute at Chicago","used":1},{"affno":"6","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Algorithms and Complexity"],"nora_code":"DI-U-KU","used":1},{"affno":"7","country":"it","key":"university of padua","loc":["Italy","Europe, EU","OECD"],"name":"University of Padua","used":1},{"affno":"8","country":"it","key":"university of padova","loc":["Italy","Europe, EU","OECD"],"name":"University of Padova","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Martin","key":"aumüllerpau","last":"Aumüller","locid":"5f52759c-418a-41b7-bbdb-050492677284","name":"Aumüller, Martin","orcid":"0000-0002-7212-6476","rank":1,"rolecode":"pau"},{"affno":"2 3","first":"Sariel","key":"harpeledpau","last":"Har-Peled","name":"Har-Peled, Sariel","rank":2,"rolecode":"pau"},{"affno":"4 5","first":"Sepideh","key":"mahabadipau","last":"Mahabadi","name":"Mahabadi, Sepideh","rank":3,"rolecode":"pau"},{"affno":"6 1","first":"Rasmus","key":"paghpau","last":"Pagh","locid":"044bf2b8-4ea6-4c2e-984c-88a0267151c7","name":"Pagh, Rasmus","orcid":"0000-0002-1516-9306","rank":4,"rolecode":"pau"},{"affno":"7 8","first":"Francesco","key":"silvestripau","last":"Silvestri","name":"Silvestri, Francesco","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1145/3471485.3471496","issn":["01635808","19435835"],"issn_org":["01635808"],"issue":"01","journal":"SIGMOD Record","publisher":"Association for Computing Machinery","status":"p","title":"SIGMOD Record","title_org":"S I G M O D Record","volume":"50"},"review":"Peer Reviewed","scoID":["2-s2.0-85108234781"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenh