University of Copenhagen","namevar":["IT University of Copenhagen"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Shin'ichi","key":"satohped","last":"Satoh","name":"Satoh, Shin'ichi","rank":1,"role":"Editor","rolecode":"ped"},{"affno":"2","corresponding":null,"first":"Lucia","key":"vadicamoped","last":"Vadicamo","name":"Vadicamo, Lucia","rank":2,"role":"Editor","rolecode":"ped"},{"affno":"3","corresponding":null,"country":"dk","first":"Arthur","key":"zimekped","last":"Zimek","locid":"1b1fe883-647f-453c-8b8f-0ffe4fad5019","name":"Zimek, Arthur","orcid":"0000-0001-7713-4208","rank":3,"role":"Editor","rolecode":"ped"},{"affno":"2","corresponding":null,"first":"Fabio","key":"carraraped","last":"Carrara","name":"Carrara, Fabio","rank":4,"role":"Editor","rolecode":"ped"},{"affno":"4","corresponding":null,"first":"Ilaria","key":"bartoliniped","last":"Bartolini","name":"Bartolini, Ilaria","rank":5,"role":"Editor","rolecode":"ped"},{"affno":"5","corresponding":null,"first":"Martin","key":"aumüllerped","last":"Aumüller","name":"Aumüller, Martin","rank":6,"role":"Editor","rolecode":"ped"},{"affno":"5","corresponding":null,"first":"Björn Þór","key":"jónssonped","last":"Jónsson","name":"Jónsson, Björn Þór","rank":7,"role":"Editor","rolecode":"ped"},{"affno":"5","corresponding":null,"first":"Rasmus","key":"paghped","last":"Pagh","name":"Pagh, Rasmus","rank":8,"role":"Editor","rolecode":"ped"}],"pub":{"doi":"10.1007/978-3-030-60936-8","eisbn":["9783030609368"],"isbn":["9783030609351"],"issn":["03029743"],"pages":"414","publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-28277f89-1cdc-43c4-9be4-7a68998e5400"],"src":["SDU University of Southern Denmark"],"title":"Similarity Search and Applications : 13th International Conference, SISAP 2020, Copenhagen, Denmark, September 30 – October 2, 2020, Proceedings","type":"Book","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-584728","year":"2020","yearsub":"2020"}
{"abstract":"Locality-sensitive hashing (LSH), introduced by Indyk and Motwani in STOC ’98, has been an extremely influential framework for nearest neighbor search in high-dimensional data sets. While theoretical work has focused on the approximate nearest neighbor problem, in practice LSH data structures with suitably chosen parameters are used to solve the exact nearest neighbor problem (with some error probability). Sublinear query time is often possible in practice even for exact nearest neighbor search, intuitively because the nearest neighbor tends to be significantly closer than other data points. However, theory offers little advice on how to choose LSH parameters outside of pre-specified worst-case settings. We introduce the technique of confirmation sampling for solving the exact nearest neighbor problem using LSH. First, we give a general reduction that transforms a sequence of data structures that each find the nearest neighbor with a small, unknown probability, into a data structure that returns the nearest neighbor with probability $$1-\\delta $$, using as few queries as possible. Second, we present a new query algorithm for the LSH Forest data structure with L trees that is able to return the exact nearest neighbor of a query point within the same time bound as an LSH Forest of $$\\varOmega (L)$$ trees with internal parameters specifically tuned to the query and data.","author_count":11,"contributors":["Christiani, Tobias Lybecker","Pagh, Rasmus","Thorup, Mikkel"],"cuid":["S02-081.06-038251"],"event":{"acronym":"SISAP","end":"2020-10-02","place":"Copenhagen, dk","start":"2020-09-30","title":"13th International Conference on Similarity Search and Applications, SISAP 2020","year":"2020"},"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"keyword":["Confirmation sampling","High dimensional data","Locality sensitive hashing","Nearest neighbor search","Query algorithm"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-KU"]},"level3all":["DI-U-ITU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"confirmation sampling for exact nearest neighbor search","src":["itu","ku"],"src-code":["DI-U-ITU","DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85666641/1812.02603.pdf","version":"Authors Final Version"},"id":"S02-081.06-038251","identifier":[{"id":"85093858448","type":"scopus"}],"ids":["itu-02c5c2d1-847a-4c6b-b9aa-900c0e785a3f","ku-ff4f862b-676d-45ed-8b3f-3bae1dea76a1"],"keyword":["Confirmation sampling","High-dimensional data","Locality-sensitive hashing","Nearest neighbor search","Query algorithm"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-CBEE088A2385C5E7290AB4F2264766B5"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/287066279/1812.02603.pdf","version":"Pre-print"},{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85666641/1812.02603.pdf","version":"Authors Final Version"},{"access":"oa","license":"https://arxiv.org/licenses/nonexclusive-distrib/1.0/license.html","type":"rem","url":"https://arxiv.org/pdf/1812.02603.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Tobias Lybecker","key":"christianipau","last":"Christiani","name":"Christiani, Tobias Lybecker","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Rasmus","key":"paghpau","last":"Pagh","name":"Pagh, Rasmus","rank":2,"rolecode":"pau"},{"affno":"2","first":"Mikkel","key":"thoruppau","last":"Thorup","locid":"9a753f32-9b71-4058-8b1e-a94b71903f10","name":"Thorup, Mikkel","orcid":"0000-0001-5237-1709","rank":3,"rolecode":"pau"},{"affno":"","first":"Shin’ichi","key":"satohpedh","last":"Satoh","name":"Satoh, Shin’ichi","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Lucia","key":"vadicamopedh","last":"Vadicamo","name":"Vadicamo, Lucia","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Fabio","key":"carrarapedh","last":"Carrara","name":"Carrara, Fabio","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Arthur","key":"zimekpedh","last":"Zimek","name":"Zimek, Arthur","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Ilaria","key":"bartolinipedh","last":"Bartolini","name":"Bartolini, Ilaria","rank":8,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Martin","key":"aumüllerpedh","last":"Aumüller","name":"Aumüller, Martin","rank":9,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Bjorn Por","key":"jonssonpedh","last":"Jonsson","name":"Jonsson, Bjorn Por","rank":10,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Rasmus","key":"paghpedh","last":"Pagh","name":"Pagh, Rasmus","rank":11,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1