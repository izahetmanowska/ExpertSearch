nmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["University of Southern Denmark"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Camilla Birch","key":"okkelspau","last":"Okkels","locid":"38e643e8-bd72-40e3-ba25-b031e957b7fb","name":"Okkels, Camilla Birch","orcid":"0009-0005-1904-4024","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Martin","key":"aumüllerpau","last":"Aumüller","locid":"5f52759c-418a-41b7-bbdb-050492677284","name":"Aumüller, Martin","orcid":"0000-0002-7212-6476","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Viktor Bello","key":"thomsenpau","last":"Thomsen","name":"Thomsen, Viktor Bello","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Arthur","key":"zimekpau","last":"Zimek","name":"Zimek, Arthur","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.48786/edbt.2025.56","pages":"694-706","status":"p","title":"EDBT 2025"},"review":"Peer Reviewed","scoID":["2-s2.0-105007939070"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["itu-b3b9f051-e1a3-41a7-b7fd-8e14288a7656"],"src":["ITU IT University of Copenhagen"],"title":"High-dimensional density-based clustering using locality-sensitive hashing","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-798553","year":"2025","yearsub":"2025"}
{"abstract":"The SISAP 2024 Indexing Challenge invited replicable and competitive approximate similarity search solutions for datasets of up to 100 million real-valued vectors. Participants are evaluated on the search performance of their implementations under quality constraints. Using a subset of the deep features of a neural network model provided by the LAION-5B dataset, the challenge posed three tasks, each with its unique focus: Task 1, Unrestricted indexing: Conduct a classical approximate nearest neighbors search, ensuring an average recall of at least 0.8 for 30-NN queries. Task 2, Memory-constrained indexing with reranking: Conduct nearest neighbors search in a low-memory setting where the dataset collection is only accessible on disk, ensuring the same quality as in Task 1. Task 3, Memory-constrained indexing without reranking: Conduct nearest neighbor search in a setting where the dataset cannot be accessed at search stage, ensuring an average recall of at least 0.4 for 30-NN queries. The present paper describes the details of the challenge, the evaluation system that was developed with it, and gives an overview of the submitted solutions.","author_count":3,"contributors":["Tellez, Eric S.","Aumüller, Martin","Mic, Vladimir"],"cuid":["S01-000.00-798522"],"filters":{"added":"2025-04","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, Central","OECD"],"country":["Mexico"],"glorg":["All Global Affiliations","INFOTEC"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-ITU"]},"level3all":["DI-U-AU","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"overview of the sisap 000000002024 indexing challenge","src":["itu"],"src-code":["DI-U-ITU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/108573625/Overview_of_the_SISAP_2024_Implementation_Challenge.pdf","version":"Other Version"},"id":"S01-000.00-798522","identifier":[{"id":"105002727082","type":"scopus"}],"ids":["itu-1091c646-46e6-4c75-8ede-d8da7b09ddc7"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-3-5-D64E3EC25B794B12D6949CE118BC2C34"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/108573625/Overview_of_the_SISAP_2024_Implementation_Challenge.pdf","version":"Other Version"}],"org":[{"affno":"1","country":"mx","key":"infotec","loc":["Mexico","America, Central","OECD"],"name":"INFOTEC","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Theoretical Computer Science","IT University of Copenhagen, Theoretical Computer Science, Algorithms"],"nora_code":"DI-U-ITU","used":1},{"affno":"3","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Eric S.","key":"tellezpau","last":"Tellez","name":"Tellez, Eric S.","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Martin","key":"aumüllerpau","last":"Aumüller","locid":"5f52759c-418a-41b7-bbdb-050492677284","name":"Aumüller, Martin","orcid":"0000-0002-7212-6476","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Vladimir","key":"micpau","last":"Mic","name":"Mic, Vladimir","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1007/978-3-031-75823-2_21","status":"p","title":"Similarity Search and Applications: SISAP 2024"},"review":"Peer Reviewed","scoID":["2-s2.0-105002727082"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-1091c646-46e6-4c75-8ede-d8da7b09ddc7"],"src":["ITU IT University of Copenhagen"],"title":"Overview of the SISAP 2024 Indexing Challenge","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-798522","year":"2025","yearsub":"2025"}
{"abstract":"Locality Sensitive Filters are known for offering a quasi-linear space data structure with rigorous guarantees for the Approximate Near Neighbor search (ANN) problem. Building on Locality Sensitive Filters, we derive a simple data structure for the Approximate Near Neighbor Counting (ANNC) problem under differential privacy (DP). Moreover, we provide a simple analysis leveraging a connection with concomitant statistics and extreme value theory. Our approach produces a simple data structure with a tunable parameter that regulates a trade-off between space-time and utility. Through this trade-off, our data structure achieves the same performance as the recent findings of Andoni et al. (NeurIPS 2023) while offering better utility at the cost of higher space and query time. In addition, we provide a more efficient algorithm under pure ε-DP and elucidate the connection between ANN and differentially private ANNC. As a side result, the paper provides a more compact description and analysis of Locality Sensitive Filters for Fair Near Neighbor Search, improving a previous result in Aumüller et al. (TODS 2022).","author_count":3,"contributors":["Aumüller, Martin","Boninsegna, Fabrizio","Silvestri, Francesco"],"cuid":["S01-000.00-818257"],"filters":{"added":"2025-08","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Italy"],"glorg":["All Global Affiliations","University of Padova"],"keyword":["Differential Privacy"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"differentially private high dimensional approximate range counting revisited","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.4230/LIPIcs.FORC.2025.15","version":"Published Version"},"id":"S01-000.00-818257","identifier":[{"id":"105007984765","type":"scopus"}],"ids":["itu-fa1f9509-fddd-4c92-b623-61ae0817429f"],"keyword":["Approximate Range Counting","Concominant Statistics","Differential Privacy","Locality Sensitive Filters"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-8AF205F3086525DAA64A2FA22FA474B0"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.4230/LIPIcs.FORC.2025.15","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Theoretical Computer Science","IT University of Copenhagen, Theoretical Computer Science, Algorithms"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"it","key":"university of padova","loc":["Italy","Europe, EU","OECD"],"name":"University of Padova","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Martin","key":"aumüllerpau","last":"Aumüller","locid":"5f52759c-418a-41b7-bbdb-050492677284","name":"Aumüller, Martin","orcid":"0000-0002-7212-6476","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Fabrizio","key":"boninsegnapau","last":"Boninsegna","name":"Boninsegna, Fabrizio","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Francesco","key":"silvestripau","last":"Silvestri","name":"Silvestri, Francesco","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.4230/lipics.forc.2025.15","status":"p","title":"FORC"},"review":"Peer Reviewed","scoID":["2-s2.0-105007984765"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-fa1f9509-fddd-4c92-b623-61ae0817429f"],"src":["ITU IT University of Copenhagen"],"title":"Differentially Private High-Dimensional Approximate Range Counting, Revisited.","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-818257","year":"2025","yearsub":"2025"}
{"abstract":"The SISAP 2024 Indexing Challenge invited replicable and competitive approximate similarity search solutions for datasets of up to 100 million real-valued vectors. Participants are evaluated on the search performance of their implementations under quality constraints. Using a subset of the deep features of a neural network model provided by the LAION-5B dataset, the challenge posed three tasks, each with its unique focus:Task 1, Unrestricted indexing: Conduct a classical approximate nearest neighbors search, ensuring an average recall of at least 0.8 for 30-NN queries.Task 2, Memory-constrained indexing with reranking: Conduct nearest neighbors search in a low-memory setting where the dataset collection is only accessible on disk, ensuring the same quality as in Task 1.Task 3, Memory-constrained indexing without reranking: Conduct nearest neighbor search in a setting where the dataset cannot be accessed at search stage, ensuring an average recall of at least 0.4 for 30-NN queries. Task 1, Unrestricted indexing: Conduct a classical approximate nearest neighbors search, ensuring an average recall of at least 0.8 for 30-NN queries. Task 2, Memory-constrained indexing with reranking: Conduct nearest neighbors search in a low-memory setting where the dataset collection is only accessible on disk, ensuring the same quality as in Task 1. Task 3, Memory-constrained indexing without reranking: Conduct nearest neighbor search in a setting where the dataset cannot be accessed at search stage, ensuring an average recall of at least 0.4 for 30-NN queries. The present paper describes the details of the challenge, the evaluation system that was developed with it, and gives an overview of the submitted solutions.","author_count":8,"contributors":["S. Tellez, Eric","Aumüller, Martin","Mic, Vladimir"],"cuid":["S01-000.00-787875"],"filters":{"added":"2025-02","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, Central","OECD"],"corresponding_author":["S. Tellez, Eric"],"country":["Mexico"],"glorg":["All Global Affiliations","Infotec"],"keyword":["Approximate Nearest Neighbor Search"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-ITU"]},"level3all":["DI-U-AU","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"overview of the sisap 000000002024 indexing challenge","src":["au"],"src-code":["DI-U-AU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/105002727082","version":"Other Version"},"id":"S01-000.00-787875","identifier":[{"id":"105002727082","type":"scopus"}],"ids":["au-c49b9bb3-4ce1-49a5-89e9-4fdd9cb684cb"],"keyword":["Approximate nearest neighbor search","Experimental comparison of search methods","Indexing and searching pipelines"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-3-5-D64E3EC25B794B12D6949CE118BC2C34"],"org":[{"affno":"1","country":"mx","key":"infotec","loc":["Mexico","America, Central","OECD"],"name":"Infotec","used":1},{"affno":"2","country":"dk","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen"],"nora_code":"DI-U-ITU","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Computer Science"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Eric","key":"stellezpau","last":"S. Tellez","name":"S. Tellez, Eric","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Martin","key":"aumüllerpau","last":"Aumüller","name":"Aumüller, Martin","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Vladimir","key":"micpau","last":"Mic","locid":"660ec3b7-b3d3-449c-ab93-875008c412c7","name":"Mic, Vladimir","orcid":"0000-0002-8813-303X","rank":3,"rolecode":"pau"},{"affno":"","first":"Edgar","key":"chávezpedh","last":"Chávez","name":"Chávez, Edgar","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Benjamin","key":"kimiapedh","last":"Kimia","name":"Kimia, Benjamin","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Jakub","key":"lokočpedh","last":"Lokoč","name":"Lokoč, Jakub","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Marco","key":"patellapedh","last":"Patella","name":"Patella, Marco","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Jan","key":"sedmidubskypedh","last":"Sedmidubsky","name":"Sedmidubsky, Jan","rank":8,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-031-75823-2_21","eisbn":["9783031758232"],"isbn":["9783031758225"],"issn":["03029743"],"pages":"255-265","place":"Cham","publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","title":"Similarity Search and Applications - 17th International Conference, SISAP 2024, Proceedings"},"review":"Peer Reviewed","scoID":["2-s2.0-105002727082"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["au-c49b9bb3-4ce1-49a5-89e9-4fdd9cb684cb"],"src":["AU Aarhus University"],"title":"Overview of the SISAP 2024 Indexing Challenge","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-787875","year":"2025","yearsub":"2025"}
{"abstract":"Approximate nearest neighbor search in high-dimensional metric spaces is crucial in modern data science pipelines. Efficient search algorithms often rely on partitioning the metric space. To find the approximate nearest neighbors of a query point, a candidate set is constructed based on the points that belong to the same part in the partition, and the closest points among these candidates are identified via a bruteforce search. Hyvönen et al. (JMLR, 2024) argue that viewing this problem as a multi-class labeling problem suggests that this traditional method is not optimal. Instead, they propose a “natural classifier” search strategy that incorporates the true labels of the candidate points, demonstrating faster searches and smaller candidate sets for the same accuracy for tree-based space partitioning methods. This paper explores the natural classifier and other search strategies for partitioning based on locality-sensitive hashing. We propose a new strategy that offers more precise control over the balance between performance and quality. Our analysis highlights the trade-offs between these methods, providing insights into optimizing search efficiency in various contexts","author_count":2,"contributors":["Johnsen, Malte Helin","Aumüller, Martin"],"cuid":["S01-000.00-798520"],"filters":{"added":"2025-04","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Approximate Nearest Neighbor Search","Locality sensitive hashing","Search strategies","Similarity search"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"an empirical evaluation of search strategies for locality sensitive hashing lookup voting and natural classifier search","src":["itu"],"src-code":["DI-U-ITU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/108573253/LSH_with_Natural_Classifier.pdf","version":"Other Version"},"id":"S01-000.00-798520","identifier":[{"id":"105002716007","type":"scopus"}],"ids":["itu-057ee5a3-84cf-458e-aed2-9089b9444df3"],"keyword":["Approximate Nearest Neighbor Search","Locality-Sensitive Hashing","Search Strategies","Similarity Search"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-5A4C780EF96CF4CA502B3BE148BEDDAB"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/108573253/LSH_with_Natural_Classifier.pdf","version":"Other Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Theoretical Computer Science","IT University of Copenhagen, Theoretical Computer Science, Algorithms"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Malte Helin","key":"johnsenpau","last":"Johnsen","name":"Johnsen, Malte Helin","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Martin","key":"aumüllerpau","last":"Aumüller","locid":"5f52759c-418a-41b7-bbdb-050492677284","name":"Aumüller, Martin","orcid":"0000-0002-7212-6476","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1007/978-3-031-75823-2_13","status":"p","title":"Similarity Search and Applications, SISAP 2024"},"review":"Peer Reviewed","scoID":["2-s2.0-105002716007"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-057ee5a3-84cf-458e-aed2-9089b9444df3"],"src":["ITU IT University of Copenhagen"],"title":"An Empirical Evaluation of Search Strategies for Locality-Sensitive Hashing: Lookup, Voting, and Natural Classifier Search","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-798520","year":"2024","yearsub":"2024"}
{"abstract":"Differentially private mean estimation is an important building block in privacy-preserving algorithms for data analysis and machine learning. Though the trade-off between privacy and utility is well understood in the worst case, many datasets exhibit structure that could potentially be exploited to yield better algorithms. In this paper we present Private Limit Adapted Noise (plan), a family of differentially private algorithms for mean estimation in the setting where inputs are independently sampled from a distribution D over R, with coordinate-wise standard deviations ∈ R. Similar to mean estimation under Mahalanobis distance, plan tailors the shape of the noise to the shape of the data, but unlike previous algorithms the privacy budget is spent non-uniformly over the coordinates. Under a concentration assumption on D, we show how to exploit skew in the vector , obtaining a (zero-concentrated) differentially private mean estimate with ℓ2 error proportional to ∥ ∥1. Previous work has either not taken into account, or measured error in Mahalanobis distance — in both cases resulting in ℓ2 error proportional to √ ∥ ∥2, which can be up to a factor √ larger. To verify the effectiveness of plan, we empirically evaluate accuracy on both synthetic and real-world data.","author_count":4,"contributors":["Aumüller, Martin","Lebeda, Christian Janos","Nelson, Boel","Pagh, Rasmus"],"cuid":["S01-000.00-798541"],"filters":{"added":"2025-04","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Differential Privacy"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"plan variance aware private mean estimation","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.56553/popets-2024-0095","version":"Published Version"},"id":"S01-000.00-798541","ids":["itu-7b976781-3778-4e70-89ab-008192d63047"],"keyword":["differential privacy","mean estimation"],"lang":"Undetermined","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-65B6267151BFA586CCEE1BCBAD8E0BBD"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.56553/popets-2024-0095","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Theoretical Computer Science, Algorithms"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Martin","key":"aumüllerpau","last":"Aumüller","locid":"5f52759c-418a-41b7-bbdb-050492677284","name":"Aumüller, Martin","orcid":"0000-0002-7212-6476","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christian Janos","key":"lebedapau","last":"Lebeda","locid":"a0e31b8c-3d9c-4b68-834d-d4c06914b69f","name":"Lebeda, Christian Janos","orcid":"0000-0001-9517-8466","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Boel","key":"nelsonpau","last":"Nelson","name":"Nelson, Boel","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rasmus","key":"paghpau","last":"Pagh","name":"Pagh, Rasmus","rank":4,"rolecode":"pau"}],"pub":{},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"]},"sid":["itu-7b976781-3778-4e70-89ab-008192d63047"],"src":["ITU IT University of Copenhagen"],"title":"PLAN: Variance-Aware Private Mean Estimation.","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-798541","year":"2024","yearsub":"2024"}
{"abstract":"Efficient and reliable methods for distinguishing outliers in data remain crucial for data analysis. Although supervised methods based on neural networks have gained recent traction, unsupervised methods such as the kNN outlier method and local outlier factor (LOF) remain state-of-the-art solutions according to different standardized benchmarks. Unfortunately, exact outlier detection through nearest neighbor search queries provides a scalability bottleneck for the high-dimensional, big datasets that are routinely analyzed in data science applications. This paper explores benefits and limitations of using approximate nearest neighbor search via Hierarchical Navigable Small World graphs (HNSW) to overcome this scalability barrier. We evaluate direct implementations that compute the kNN and LOF score from approximate neighborhoods and show the robustness of the outlier detection even in settings where the approximation is far away from the exact neighborhoods. Furthermore, we design white-box methods that compute the outlier scores directly from the underlying graph. These methods show much more variability in the quality of the outlier scores and open new ground for the development of task-aware tools based on approximate nearest neighbor search techniques","author_count":8,"contributors":["Okkels, Camilla Birch","Aumüller, Martin","Zimek, Arthur"],"cuid":["S02-083.74-793598"],"filters":{"added":"2025-04","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Okkels, Camilla Birch"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-SDU"]},"level3all":["DI-U-ITU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"on the design of scalable outlier detection methods using approximate nearest neighbor graphs","src":["itu","sdu"],"src-code":["DI-U-ITU","DI-U-SDU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/108573565/Graph_based_Outlier_Detection.pdf","version":"Other Version"},"id":"S02-083.74-793598","identifier":[{"id":"105002727269","type":"scopus"}],"ids":["itu-3b876059-2a3e-439e-82f0-5f04088f9662","sdu-f911b5f0-e464-4d21-9323-83920abc7857"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-8C368F2365A7536FB88424D95B5670D7"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/108573565/Graph_based_Outlier_Detection.pdf","version":"Other Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Theoretical Computer Science","IT University of Copenhagen, Theoretical Computer Science, Algorithms"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Science, Department of Mathematics and Computer Science","SDU, Faculty of Science, Department of Mathematics and Computer Science, Data Science"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Camilla Birch","key":"okkelspau","last":"Okkels","locid":"38e643e8-bd72-40e3-ba25-b031e957b7fb","name":"Okkels, Camilla Birch","orcid":"0009-0005-1904-4024","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Martin","key":"aumüllerpau","last":"Aumüller","locid":"5f52759c-418a-41b7-bbdb-050492677284","name":"Aumüller, Martin","orcid":"0000-0002-7212-6476","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Arthur","key":"zimekpau","last":"Zimek","locid":"1b1fe883-647f-453c-8b8f-0ffe4fad5019","name":"Zimek, Arthur","orcid":"0000-0001-7713-4208","rank":3,"rolecode":"pau"},{"affno":"","first":"Edgar","key":"chávezpedh","last":"Chávez","name":"Chávez, Edgar","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Benjamin","key":"kimiapedh","last":"Kimia","name":"Kimia, Benjamin","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Jakub","key":"lokočpedh","last":"Lokoč","name":"Lokoč, Jakub","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Marco","key":"patellapedh","last":"Patella","name":"Patella, Marco","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Jan","key":"sedmidubskypedh","last":"Sedmidubsky","name":"Sedmidubsky, Jan","rank":8,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-031-75823-2_14","eisbn":["9783031758232"],"isbn":["9783031758225"],"issn":["03029743"],"pages":"170-184","publisher":"Springer Nature","series":"Lecture Notes in Computer Science","status":"p","title":"Similarity Search and Applications"},"review":"Peer Reviewed","scoID":["2-s2.0-105002727269"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["itu-3b876059-2a3e-439e-82f0-5f04088f9662","sdu-f911b5f0-e464-4d21-9323-83920abc7857"],"src":["ITU IT University of Copenhagen","SDU University of Southern Denmark"],"title":"On the Design of Scalable Outlier Detection Methods Using Approximate Nearest Neighbor Graphs","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-083.74-793598","year":"2024","yearsub":"2024"}
{"abstract":"Differentially private mean estimation is an important building block in privacy-preserving algorithms for data analysis and machine learning. Though the trade-off between privacy and utility is well understood in the worst case, many datasets exhibit structure that could potentially be exploited to yield better algorithms. In this paper we present Private Limit Adopted Noise (PLAN), a family of differentially private algorithms for mean estimation in the setting where inputs are independently sampled from a distribution D over R^d, with coordinate-wise standard deviations σ in R^d. Similar to mean estimation under Mahalanobis distance, PLAN tailors the shape of the noise to the shape of the data, but unlike previous algorithms the privacy budget is spent non-uniformly over the coordinates. Under a concentration assumption on D, we show how to exploit skew in the vector σ, obtaining a (zero-concentrated) differentially private mean estimate with l_2 error proportional to ||σ||_1. Previous work has either not taken σ into account, or measured error in Mahalanobis distance --- in both cases resulting in l_2 error proportional to sqrt{d}||σ||_2, which can be up to a factor sqrt{d} larger. To verify the effectiveness of PLAN, we empirically evaluate accuracy on both synthetic and real-world data.","author_count":4,"contributors":["Aumüller, Martin","Janos Lebeda, Christian","Nelson, Boel","Pagh, Rasmus"],"cuid":["S02-084.50-804062"],"filters":{"added":"2025-01","altsrc":["No Matches Found"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-ITU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-ITU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"plan variance aware private mean estimation","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.56553/popets-2024-0095","version":"Published Version"},"id":"S02-084.50-804062","ids":["au-5dcee70c-6c2b-4a1c-9892-1be525fd38b6","ku-1dd78e13-6e2c-4544-a1a9-45db5c7f96a4"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-25091D71CFEAA80C05377B1512808CBC"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/444215932/PLAN.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.56553/popets-2024-0095","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen"],"nora_code":"DI-U-ITU","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Computer Science"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1 2","country":"dk","first":"Martin","key":"aumüllerpau","last":"Aumüller","locid":"d2298a1a-0cd6-4983-a20b-5e403cb3f4a0","name":"Aumüller, Martin","rank":1,"rolecode":"pau"},{"affno":"1","first":"Christian Janos","key":"lebedapau","last":"Lebeda","locid":"02191451-b5dd-4a08-84fd-89cc7486605f","name":"Lebeda, Christian Janos","rank":2,"rolecode":"pau"},{"affno":"3 1","corresponding":null,"country":"dk","first":"Boel","key":"nelsonpau","last":"Nelson","locid":"c957e472-2174-4120-a881-9340382eb04b","name":"Nelson, Boel","orcid":"0000-0002-9746-4885","rank":3,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Rasmus","key":"paghpau","last":"Pagh","locid":"2b0f2ee4-24e0-4e0c-892e-2fa988f87110","name":"Pagh, Rasmus","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.56553/popets-2024-0095","issn":["22990984"],"issue":"3","journal":"Proceedings on Privacy Enhancing Technologies","pages":"606-625","status":"p","title":"Proceedings on Privacy Enhancing Technologies","volume":"2024"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-5dcee70c-6c2b-4a1c-9892-1be525fd38b6","ku-1dd78e13-6e2c-4544-a1a9-45db5c7f96a4"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"PLAN: Variance-Aware Private Mean Estimation","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-084.50-804062","year":"2024","yearsub":"2024"}
{"abstract":"The 2023 Big ANN Challenge, held at NeurIPS 2023, focused on advancing the state-of-the-art in indexing data structures and search algorithms for practical variants of Approximate Nearest Neighbor (ANN) search that reflect the growing complexity and diversity of workloads. Unlike prior challenges that emphasized scaling up classical ANN search [21], this competition addressed filtered search, out-of-distribution data, sparse and streaming variants of ANNS. Participants developed and submitted innovative solutions that were evaluated on new standard datasets with constrained computational resources. The results showcased significant improvements in search accuracy and efficiency over industry-standard baselines, with notable contributions from both academic and industrial teams. This paper summarizes the competition tracks, datasets, evaluation metrics, and the innovative approaches of the top-performing submissions, providing insights into the current advancements and future directions in the field of approximate nearest neighbor search.","author_count":23,"contributors":["Simhadri, Harsha Vardhan","Aumüller, Martin","Ingber, Amir","Douze, Matthijs","Williams, George","Manohar, Magdalen Dobson","Baranchuk, Dmitry","Liberty, Edo","Liu, Frank","Landrum, Benjamin","Karjikar, Mazin","Dhulipala, Laxman","Chen, Meng","Chen, Yue","Ma, Rui","Zhang, Kai","Cai, Yuzheng","Shi, Jiayang","Chen, Yizhuo","Zheng, Weiguo","Wang, Zihao","Yin, Jie","Huang, Ben"],"cuid":["S01-000.00-798572"],"filters":{"added":"2025-04","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Asia, East","Europe, Non-EU","OECD"],"country":["China","Russia","United States"],"glorg":["All Global Affiliations","Baidu","Carnegie Mellon University","Fudan University","Meta AI","Microsoft","Shanghai Jiao Tong University","University of Maryland","Yandex","Zilliz"],"keyword":["Approximate Nearest Neighbor Search"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Pinecone"],"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"nr","rtype":["clu"],"sorti":"results of the big ann neurips 000000000023 competition","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.48550/arXiv.2409.17424","version":"Pre-print"},"id":"S01-000.00-798572","ids":["itu-fb9f45a4-6538-4123-99c6-98062f2be629"],"keyword":["Approximate Nearest Neighbor Search","Filtered Search","Indexing Data Structures","Out-of-Distribution Data","Search Algorithms"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-AB7F2C28184E88F953E3012550068982"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.48550/arXiv.2409.17424","version":"Pre-print"}],"org":[{"affno":"1","country":"us","key":"microsoft","loc":["United States","America, North","OECD"],"name":"Microsoft","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Theoretical Computer Science, Algorithms"],"nora_code":"DI-U-ITU","used":1},{"affno":"3","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Pinecone"],"nora_code":"DI-OT","used":1},{"affno":"4","country":"us","key":"meta ai","loc":["United States","America, North","OECD"],"name":"Meta AI","used":1},{"affno":"5","country":"us","key":"carnegie mellon university","loc":["United States","America, North","OECD"],"name":"Carnegie Mellon 