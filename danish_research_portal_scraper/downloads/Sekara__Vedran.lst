l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Niels Bohr Institute, Biocomplexity"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Andrea","key":"cuttonepau","last":"Cuttone","name":"Cuttone, Andrea","rank":1,"rolecode":"pau"},{"affno":"1","first":"Per","key":"baekgaardpau","last":"Baekgaard","name":"Baekgaard, Per","rank":2,"rolecode":"pau"},{"affno":"","first":"Vedran","key":"sekarapau","last":"Sekara","name":"Sekara, Vedran","rank":3,"rolecode":"pau"},{"affno":"","first":"Hakan","key":"jonssonpau","last":"Jonsson","name":"Jonsson, Hakan","rank":4,"rolecode":"pau"},{"affno":"1","first":"Jakob Eg","key":"larsenpau","last":"Larsen","name":"Larsen, Jakob Eg","rank":5,"rolecode":"pau"},{"affno":"1 2","first":"Sune","key":"lehmannpau","last":"Lehmann","locid":"a5480168-96ea-448f-bb1f-5382a8436068","name":"Lehmann, Sune","rank":6,"rolecode":"pau"}],"pmid":["28076375"],"pub":{"doi":"10.1371/journal.pone.0169901","issn":["19326203"],"issue":"1","journal":"PLOS ONE","paperid":"e0669901","status":"p","title":"PLOS ONE","volume":"12"},"review":"Peer Reviewed","scoID":["2-s2.0-85009138446"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-cd1994a4-d416-4377-8132-75a335dd758b"],"src":["KU University of Copenhagen"],"title":"SensibleSleep : A Bayesian Model for Learning Sleep Patterns from Smartphone Events","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-515941","year":"2017","yearsub":"2017"}
{"abstract":"Social systems are in a constant state of flux, with dynamics spanning from minute-by-minute changes to patterns present on the timescale of years. Accurate models of social dynamics are important for understanding the spreading of influence or diseases, formation of friendships, and the productivity of teams. Although there has been much progress on understanding complex networks over the past decade, little is known about the regularities governing the microdynamics of social networks. Here, we explore the dynamic social network of a densely-connected population of ∼1,000 individuals and their interactions in the network of real-world person-to-person proximity measured via Bluetooth, as well as their telecommunication networks, online social media contacts, geolocation, and demographic data. These high-resolution data allow us to observe social groups directly, rendering community detection unnecessary. Starting from 5-min time slices, we uncover dynamic social structures expressed on multiple timescales. On the hourly timescale, we find that gatherings are fluid, with members coming and going, but organized via a stable core of individuals. Each core represents a social context. Cores exhibit a pattern of recurring meetings across weeks and months, each with varying degrees of regularity. Taken together, these findings provide a powerful simplification of the social network, where cores represent fundamental structures expressed with strong temporal and spatial regularity. Using this framework, we explore the complex interplay between social and geospatial behavior, documenting how the formation of cores is preceded by coordination behavior in the communication networks and demonstrating that social behavior can be predicted with high precision.","author_count":4,"contributors":["Sekara, Vedran","Stopczynski, Arkadiusz","Lehmann, Sune"],"cuid":["S02-089.36-037165"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","Massachusetts Institute of Technology"],"keyword":["Complex networks","Computational social science","Human dynamics","Human mobility","Social systems"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"fundamental structures of dynamic social networks","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/125818250/PNAS_2016_Sekara_9977_82.pdf","version":"Published Version"},"id":"S02-089.36-037165","identifier":[{"id":"PMC5018769","type":"pmcid"},{"id":"27555584","type":"pmid"},{"id":"84986275763","type":"scopus"}],"ids":["dtu-caca80a6-9c8a-4f26-844c-815fada77be4","ku-673db417-0e4c-4f8a-9f26-9d5d555450aa"],"keyword":["Complex networks","Computational social science","Human dynamics","Human mobility","Social systems"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-6625AE75A42C0354E7A7B00954895C25"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/125818250/PNAS_2016_Sekara_9977_82.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Applied Mathematics and Computer Science","Technical University of Denmark, Department of Applied Mathematics and Computer Science, Cognitive Systems"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"us","key":"massachusetts institute of technology","loc":["United States","America, North","OECD"],"name":"Massachusetts Institute of Technology","used":1},{"affno":"3","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Vedran","key":"sekarapau","last":"Sekara","locid":"2a6bd001-485b-4d3e-8210-d3ce9420c177","name":"Sekara, Vedran","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Arkadiusz","key":"stopczynskipau","last":"Stopczynski","locid":"b2214f8e-9ae9-49f3-811d-2bb2e3f5487f","name":"Stopczynski, Arkadiusz","rank":2,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"country":"dk","first":"Sune Lehmann","key":"jørgensenpau","last":"Jørgensen","locid":"9049a0bd-7e6f-4f06-80f6-88ac447289e7","name":"Lehmann, Sune","name_org":"Jørgensen, Sune Lehmann","orcid":"0000-0001-6099-2345","rank":3,"rolecode":"pau"},{"affno":"3","first":"Sune","key":"lehmannpau","last":"Lehmann","locid":"a5480168-96ea-448f-bb1f-5382a8436068","name":"Lehmann, Sune","rank":3,"rolecode":"pau"}],"pmid":["27555584"],"pub":{"doi":"10.1073/pnas.1602803113","issn":["00278424","10916490"],"issn_org":["00278424"],"issue":"36","journal":"Proceedings of the National Academy of Sciences of the United States of America","pages":"9977-9982","publisher":"National Academy of Sciences","status":"p","title":"Proceedings of the National Academy of Sciences of the United States of America","volume":"113"},"review":"Peer Reviewed","scoID":["2-s2.0-84986275763"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-AL