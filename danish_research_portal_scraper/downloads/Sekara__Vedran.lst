n, Jakob Eg","orcid":"0000-0002-7461-9901","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Sune Lehmann","key":"jørgensenpau","last":"Jørgensen","locid":"9049a0bd-7e6f-4f06-80f6-88ac447289e7","name":"Lehmann, Sune","name_org":"Jørgensen, Sune Lehmann","orcid":"0000-0001-6099-2345","rank":6,"rolecode":"pau"}],"pmid":["28076375"],"pub":{"doi":"10.1371/journal.pone.0169901","issn":["19326203"],"issue":"1","journal":"PLOS ONE","pages":"1-20","paperid":"e0169901","publisher":"Public Library of Science","status":"p","title":"PLOS ONE","title_org":"P L o S One","volume":"12"},"review":"Peer Reviewed","scoID":["2-s2.0-85009138446"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-16f479e5-9f14-4924-95b8-f100b0edb127"],"src":["DTU Technical University of Denmark"],"title":"SensibleSleep: A Bayesian Model for Learning Sleep Patterns from Smartphone Events","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-311488","year":"2017","yearsub":"2017"}
