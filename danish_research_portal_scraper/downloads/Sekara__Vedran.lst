"name":"Luengo-Oroz, Miguel","rank":7,"rolecode":"pau"},{"affno":"9","corresponding":null,"first":"Rebeca Moreno","key":"jiménezpau","last":"Jiménez","name":"Jiménez, Rebeca Moreno","rank":8,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Manuel","key":"garciaherranzpau","last":"Garcia-Herranz","name":"Garcia-Herranz, Manuel","rank":9,"rolecode":"pau"}],"pub":{"doi":"10.1142/s0219525924400022","issn":["02195259","17936802"],"issn_org":["02195259"],"issue":"3","journal":"Advances in Complex Systems","status":"p","title":"Advances in Complex Systems","volume":"27"},"review":"Peer Reviewed","scoID":["2-s2.0-85193075304"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-e32fdac1-5bee-4104-84e2-dea582cd097a"],"src":["ITU IT University of Copenhagen"],"title":"The Opportunities, Limitations, and Challenges in Using Machine Learning Technologies for Humanitarian Work and Development","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-754088","year":"2024","yearsub":"2024"}
{"abstract":"In recent years, Danish child protective services have experienced increasing pressure, prompting the adoption of a decision-support algorithm to aid caseworkers in identifying children at heightened risk of maltreatment, named Decision Support. Despite its critical role, this algorithm has not undergone formal evaluation. Through a freedom of information request, we were able to partially access the algorithm and conduct an audit. We find that the algorithm has significant methodological flaws, suffers from information leakage, relies on inappropriate proxy values for maltreatment assessment, generates inconsistent risk scores, and exhibits age-based discrimination. Given these serious issues, we strongly advise against the use of this kind of algorithms in local government, municipal, and child protection settings, and we call for rigorous evaluation of such tools before implementation and for continual monitoring post-deployment by listing a series of specific recommendations.","author_count":3,"contributors":["Hansen, Therese Moreau","Sinatra, Roberta","Sekara, Vedran"],"cuid":["S02-089.68-804393"],"event":{"end":"2024-06-06","place":"Rio de Janeiro, br","start":"2024-06-03","title":"6th ACM Conference on Fairness, Accountability, and Transparency (ACM FAccT)","year":"2024"},"filters":{"added":"2024-09","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Algorithmic audit","Algorithmic decision making","Algorithmic discrimination","Technological fairness"],"level":"sci","mra":["sci","soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-KU"]},"level3all":["DI-U-ITU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"failing our youngest on the biases pitfalls and risks in a decision support algorithm used for child protection","src":["itu","ku"],"src-code":["DI-U-ITU","DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://dl.acm.org/doi/pdf/10.1145/3630106.3658906","version":"Published Version"},"id":"S02-089.68-804393","identifier":[{"id":"001253359300021","type":"wos"},{"id":"85196637869","type":"scopus"}],"ids":["itu-64a51310-bbb8-4cf4-8ca1-b9697f8426e7","ku-cec9c397-f29c-4627-9362-93ba74e9ea4d"],"keyword":["Algorithmic audit","Algorithmic decision making","Algorithmic discrimination","Technological fairness"],"lang":"English","level":"Scientific","mra":["Science/Technology","Social Science"],"noi":["Global-Local-2-5-DF5FB5A3B7E76B0C59F3D88F5EF61E1F"],"oa_link":[{"access":"oa","type":"rem","url":"https://dl.acm.org/doi/pdf/10.1145/3630106.3658906","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, NEtwoRks, Data, and Society"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Therese Moreau","key":"hansenpau","last":"Hansen","name":"Hansen, Therese Moreau","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Roberta","key":"sinatrapau","last":"Sinatra","locid":"418f030f-2b26-4c74-a77b-c0c87d13f56d","name":"Sinatra, Roberta","orcid":"0000-0002-7558-1028","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Vedran","key":"sekarapau","last":"Sekara","locid":"db64c222-0674-4eab-9f09-7f9ea1c483e3","name":"Sekara, Vedran","orcid":"0000-0003-4490-3757","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1145/3630106.3658906","eisbn":["9798400704505"],"pages":"290-300","publisher":"Assoc Computing Machinery","status":"p","title":"Proceedings Of The 2024 Acm Conference On Fairness, Accountability, And Transparency, Acm Facct 2024"},"review":"Peer Reviewed","scoID":["2-s2.0-85196637869"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["itu-64a51310-bbb8-4cf4-8ca1-b9697f8426e7","ku-cec9c397-f29c-4627-9362-93ba74e9ea4d"],"src":["ITU IT University of Copenhagen","KU University of Copenhagen"],"title":"Failing Our Youngest: On the Biases, Pitfalls, and Risks in a Decision Support Algorithm Used for Child Protection","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-089.68-804393","year":"2024","yearsub":"2024"}
{"abstract":"This CPH Tech Policy Brief is based on a working paper by Vedran Sekara, Therese Moreau Hansen and Roberta Sinatra. The brief provides a small introduction to algorithmic fairness and an example of auditing fairness in an algorithm which was aimed at identifying and assessing children at risk from abuse.","author_count":3,"contributors":["Sekara, Vedran","Thorsen, Tess Sophie Skadegård","Sinatra, Roberta"],"cuid":["S01-000.00-718900"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Algorithmic fairness","Artificial intelligence","Machine learning"],"level":"pop","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Danish Pioneer Centre for AI"],"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"und","rtype":["clu"],"sorti":"algorithmic fairness learnings from a case that used ai for decision support","src":["itu"],"src-code":["DI-U-ITU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://marycenter.ku.dk/netvaerk/cph-tech-policy-committee/cph-tech-policy-brief-6/CPH_TECH_POLICY_BRIEF_no._6.pdf","version":"Published Version"},"id":"S01-000.00-718900","ids":["itu-a0a6e2fb-fce4-46da-bc3f-7c0f11eae058"],"keyword":["Algorithmic Fairness","Artificial Intelligence","Machine Learning"],"lang":"English","level":"Popular","mra":["Science/Technology"],"noi":["Local-1-1-4515E88101983D86E40A43D547F9B7D7"],"oa_link":[{"access":"oa","type":"rem","url":"https://marycenter.ku.dk/netvaerk/cph-tech-policy-committee/cph-tech-policy-brief-6/CPH_TECH_POLICY_BRIEF_no._6.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, NEtwoRks, Data, and Society"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Danish Pioneer Centre for AI"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Vedran","key":"sekarapau","last":"Sekara","locid":"db64c222-0674-4eab-9f09-7f9ea1c483e3","name":"Sekara, Vedran","orcid":"0000-0003-4490-3757","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Tess Sophie Skadegård","key":"thorsenpau","last":"Thorsen","name":"Thorsen, Tess Sophie Skadegård","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Roberta","key":"sinatrapau","last":"Sinatra","locid":"418f030f-2b26-4c74-a77b-c0c87d13f56d","name":"Sinatra, Roberta","orcid":"0000-0002-7558-1028","rank":3,"rolecode":"pau"}],"pub":{"pages":"5","status":"p","volume":"CPH Tech Policy Brief"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["itu-a0a6e2fb-fce4-46da-bc3f-7c0f11eae058"],"src":["ITU IT University of Copenhagen"],"title":"Algorithmic Fairness: Learnings From a Case That Used AI For Decision Support","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-718900","year":"2023","yearsub":"2023"}
{"abstract":"Socioeconomic segregation patterns in networks usually evolve gradually, yet they can change abruptly in response to external shocks. The recent COVID-19 pandemic and the subsequent government policies induced several interruptions in societies, potentially disadvantaging the socioeconomically most vulnerable groups. Using large-scale digital behavioral observations as a natural laboratory, here we analyze how lockdown interventions lead to the reorganization of socioeconomic segregation patterns simultaneously in communication and mobility networks in Sierra Leone. We find that while segregation in mobility clearly increased during lockdown, the social communication network reorganized into a less segregated configuration as compared to reference periods. Moreover, due to differences in adaption capacities, the effects of lockdown policies varied across socioeconomic groups, leading to different or even opposite segregation patterns between the lower and higher socioeconomic classes. Such secondary effects of interventions need to be considered for better and more equitable policies.","author_count":4,"contributors":["Napoli, Ludovico","Sekara, Vedran","Garcia-Herranz, Manuel","Karsai, Marton"],"cuid":["S01-000.00-712510"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","Europe, EU","OECD"],"country":["Hungary","United States"],"glorg":["Alfréd Rényi Institute of Mathematics","All Global Affiliations","Central European University","UNICEF"],"keyword":["Covid 19","Mobile phone data","Mobility","Social networks","socioeconomic segregation"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"socioeconomic reorganization of communication and mobility networks in response to external shocks","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1073/pnas.2305285120","version":"Published Version"},"id":"S01-000.00-712510","identifier":[{"id":"85179885852","type":"scopus"}],"ids":["itu-392d6c37-9381-4622-a0dd-878a39865cb6"],"keyword":["COVID-19","mobile phone data","mobility","social networks","socioeconomic segregation"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-BDFC0761E871FADB4782FE2FF875F4CE"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://pure.itu.dk/ws/files/108495531/napoli-et-al-2023-socioeconomic-reorganization-of-communication-and-mobility-networks-in-response-to-external-shocks.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"rem","url":"https://www.pnas.org/doi/reader/10.1073/pnas.2305285120","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1073/pnas.2305285120","version":"Published Version"}],"org":[{"affno":"1","country":"hu","key":"central european university","loc":["Hungary","Europe, EU","OECD"],"name":"Central European University","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, NEtwoRks, Data, and Society"],"nora_code":"DI-U-ITU","used":1},{"affno":"3","country":"us","key":"unicef","loc":["United States","America, North","OECD"],"name":"UNICEF","used":1},{"affno":"4","country":"hu","key":"alfréd rényi institute of mathematics","loc":["Hungary","Europe, EU","OECD"],"name":"Alfréd Rényi Institute of Mathematics","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Ludovico","key":"napolipau","last":"Napoli","name":"Napoli, Ludovico","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Vedran","key":"sekarapau","last":"Sekara","locid":"db64c222-0674-4eab-9f09-7f9ea1c483e3","name":"Sekara, Vedran","orcid":"0000-0003-4490-3757","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Manuel","key":"garciaherranzpau","last":"Garcia-Herranz","name":"Garcia-Herranz, Manuel","rank":3,"rolecode":"pau"},{"affno":"1 4","corresponding":null,"first":"Marton","key":"karsaipau","last":"Karsai","name":"Karsai, Marton","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1073/pnas.2305285120","issn":["00278424","10916490"],"issn_org":["00278424"],"journal":"Proceedings of the National Academy of Sciences of the United States of America","publisher":"The National Academy of Sciences of the United States of America","status":"p","title":"Proceedings of the National Academy of Sciences of the United States of America"},"review":"Peer Reviewed","scoID":["2-s2.0-85179885852"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-392d6c37-9381-4622-a0dd-878a39865cb6"],"src":["ITU IT University of Copenhagen"],"title":"Socioeconomic reorganization of communication and mobility networks in response to external shocks","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-712510","year":"2023","yearsub":"2023"}
{"abstract":"We provide a brief review of human mobility science and present three key areas where we expect to see substantial advancements. We start from the mind and discuss the need to better understand how spatial cognition shapes mobility patterns. We then move to societies and argue the importance of better understanding new forms of transportation. We conclude by discussing how algorithms shape mobility behavior and provide useful tools for modelers. Finally, we discuss how progress on these research directions may help us address some of the challenges our society faces today.","author_count":4,"contributors":["Pappalardo, Luca","Manley, Ed","Sekara, Vedran","Alessandretti, Laura"],"cuid":["S02-091.43-704510"],"filters":{"added":"2023-09","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","Europe, Non-EU","OECD"],"corresponding_author":["Alessandretti, Laura"],"country":["Italy","United Kingdom"],"glorg":["All Global Affiliations","National Research Council of Italy","University of Leeds"],"keyword":["Computational social science","Human mobility","mobility science"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-ITU"]},"level3all":["DI-U-DTU","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"future directions in human mobility science","src":["dtu","itu"],"src-code":["DI-U-DTU","DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/376358710/2408.00702v1.pdf","version":"Authors Final Version"},"funding_acknowledgement":["L.P. thanks G. Cornacchia and G. Mauro for their valuable suggestions and D. Fadda for his precious support in visualizations. L.P. has been supported by EU projects: (1) H2020 HumaneAI-net G.A. 952026; (2) H2020 SoBigData++ G.A. #871042; (3) NextGenerationEU - National Recovery and Resilience Plan (Piano Nazionale di Ripresa e Resilienza, PNRR), project ‘SoBigData.it - Strengthening the Italian RI for Social Mining and Big Data Analytics’, prot. IR0000013, avviso n. 3264 on 28/12/2021. V.S. is supported by Digital Research Center Denmark (DIREC) grant P25—Understanding Biases and Diversity of Big Data used for Mobility Analysis. E.M. is supported by UK Research and Innovation (UKRI) through the Consumer Data Research Centre (ES/L011891/1) and Responsible Automation for Inclusive Mobility (ES/T012587/1) projects. L.P. thanks G. Cornacchia and G. Mauro for their valuable suggestions and D. Fadda for his precious support in visualizations. L.P. has been supported by EU projects: (1) H2020 HumaneAI-net G.A. 952026; (2) H2020 SoBigData++ G.A. #871042; (3) NextGenerationEU - National Recovery and Resilience Plan (Piano Nazionale di Ripresa e Resilienza, PNRR), project ‘SoBigData.it - Strengthening the Italian RI for Social Mining and Big Data Analytics’, prot. IR0000013, avviso n. 3264 on 28/12/2021. V.S. is supported by Digital Research Center Denmark (DIREC) grant P25—Understanding Biases and Diversity of Big Data used for Mobility Analysis. E.M. is supported by UK Research and Innovation (UKRI) through the Consumer Data Research Centre (ES/L011891/1) and Responsible Automation for Inclusive Mobility (ES/T012587/1) projects."],"id":"S02-091.43-704510","identifier":[{"id":"38177737","type":"pmid"},{"id":"85164106448","type":"scopus"}],"ids":["dtu-ff0db01c-ef35-44a3-80c9-c99da009262e","itu-6f4bd1d7-c4d5-4052-bbfa-935b303a39e5"],"keyword":["computational social science","human mobility","mobility science"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-0BEE4A30F1087B04F4E30F25109CFD70"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/376358710/2408.00702v1.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","country":"it","key":"national research council of italy","loc":["Italy","Europe, EU","OECD"],"name":"National Research Council of Italy","used":1},{"affno":"2","country":"gb","key":"university of leeds","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Leeds","used":1},{"affno":"3","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, NEtwoRks, Data, and Society"],"nora_code":"DI-U-ITU","used":1},{"affno":"4","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Applied Mathematics and Computer Science","Technical University of Denmark, Department of Applied Mathematics and Computer Science, Cognitive Systems"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Luca","key":"pappalardopau","last":"Pappalardo","name":"Pappalardo, Luca","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ed","key":"manleypau","last":"Manley","name":"Manley, Ed","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Vedran","key":"sekarapau","last":"Sekara","locid":"db64c222-0674-4eab-9f09-7f9ea1c483e3","name":"Sekara, Vedran","orcid":"0000-0003-4490-3757","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"Laura","key":"alessandrettipau","last":"Alessandretti","locid":"0e9909a3-464d-4dbe-8e3a-05327a3bc245","name":"Alessandretti, Laura","orcid":"0000-0001-6003-1165","rank":4,"rolecode":"pau"}],"pmid":["38177737"],"pub":{"doi":"10.1038/s43588-023-00469-4","is