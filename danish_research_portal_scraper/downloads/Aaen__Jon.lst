itical Science"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Makiko","key":"moritapau","last":"Morita","name":"Morita, Makiko","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Nobu","key":"ishiguropau","last":"Ishiguro","name":"Ishiguro, Nobu","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Jon","key":"aaenpau","last":"Aaen","locid":"3d81e322-04e5-4232-9352-9314d1576728","name":"Aaen, Jon","orcid":"0000-0003-2176-4678","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Jeppe","key":"nielsenpau","last":"Nielsen","locid":"31d251b9-30db-4478-8e0c-c49badda7112","name":"Agger Nielsen, Jeppe","name_org":"Nielsen, Jeppe","orcid":"0000-0002-8675-326X","rank":4,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-872940d4-aa18-4e44-bc0a-97fd4cc07760"],"src":["AAU Aalborg University"],"title":"‘The Nursing Home of the Future’ : Transformation from Showroom of Technology to Homey Environment","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-089402","year":"2018","yearsub":"2018"}
{"abstract":"Big Data byder sig til som en af tidens mest hypede teknologiske innovationer, udråbt til at rumme kimen til nye, værdifulde operationelle indsigter for private virksomheder og offentlige organisationer. Mens de optimistiske udmeldinger er mange, er forskningen i Big Data i den offentlige sektor indtil videre begrænset. Denne artikel belyser, hvordan den offentlige sundhedssektor kan genanvende og udnytte en stadig større mængde data under hensyntagen til offentlige værdier. Artiklen bygger på et casestudie af anvendelsen af store mængder sundhedsdata i Dansk AlmenMedicinsk Database (DAMD). Analysen viser, at (gen)brug af data i nye sammenhænge er en flerspektret afvejning mellem ikke alene økonomiske rationaler og kvalitetshensyn, men også kontrol over personfølsomme data og etiske implikationer for borgeren. I DAMD-casen benyttes data på den ene side ”i den gode sags tjeneste” til kvalitetsudvikling i almen lægepraksis, ny forskning og kommerciel produktudvikling i medicinalindustrien. På den anden side truer anvendelsen af sundhedsdata det fortrolige rum mellem læge og patient samt beskyttelsen af individets selvbestemmelse over fortrolige sundhedsoplysninger. Afslutningsvis diskuterer artiklen, hvorvidt nedlæggelsen af DAMD i 2014 kan tolkes som et billede på lidt for ivrige forandringsagenter, der søgte at udnytte nye teknologiske muligheder uden at tage tilstrækkelig højde for tilpasning af organisatoriske, juridiske og etiske aspekter.","author_count":2,"contributors":["Aaen, Jon","Agger Nielsen, Jeppe"],"cuid":["S02-100.00-011874"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Big data","Sundhedssektoren"],"level":"sci","mra":["soc"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"big data kvantitative data med kvalitative forandringer","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"id":"S02-100.00-011874","ids":["aau-f8b95fcc-ad2f-4c2d-98d8-1356d313a0f0","au-eaaa5b42-c183-448a-9fb4-bbd0b969b990"],"keyword":["Sundhedssektoren","big data"],"lang":"Danish","level":"Scientific","mra":["Social Science"],"noi":["Local-1-2-343091DA90522F9954625732BDD3CA93"],"oai":{"class":"Blocked","mra":["Social Science (SOC)"],"yearPub":"2016","yearSub":2016},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Social Sciences","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Politics and Society, Centre for Information Systems Management","Aalborg University, The Faculty of Social Sciences, Department of Political Science"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus BSS, Department of Management"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jon","key":"aaenpau","last":"Aaen","locid":"3d81e322-04e5-4232-9352-9314d1576728","name":"Aaen, Jon","orcid":"0000-0003-2176-4678","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jeppe Agger","key":"nielsenpau","last":"Nielsen","locid":"0541e013-7c06-44ab-b4fe-14600fb491a7","name":"Nielsen, Jeppe Agger","rank":2,"rolecode":"pau"}],"pub":{"issn":["09008322"],"issue":"1","journal":"Samfundslederskab i Skandinavien","pages":"13-34","publisher":"DenOffentlige","status":"p","title":"Samfundslederskab i Skandinavien","volume":"32"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-f8b95fcc-ad2f-4c2d-98d8-1356d313a0f0","au-eaaa5b42-c183-448a-9fb4-bbd0b969b990"],"src":["AAU Aalborg University","AU Aarhus University"],"title":"Big Data : Kvantitative data med kvalitative forandringer?","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-011874","year":"2016","yearsub":2017}
