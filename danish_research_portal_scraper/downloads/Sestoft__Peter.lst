ence, Niels Bohr Institute, Condensed Matter Physics"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"us","key":"university of california at santa barbara","loc":["United States","America, North","OECD"],"name":"University of California at Santa Barbara","used":1}],"person":[{"affno":"1","first":"S.","key":"vaitiekenaspau","last":"Vaitiekenas","locid":"05335f6d-400f-4186-92ce-7e54bf48b36e","name":"Vaitiekenas, S.","orcid":"0000-0002-5007-461X","rank":1,"rolecode":"pau"},{"affno":"1","first":"A. M.","key":"whiticarpau","last":"Whiticar","locid":"79e8a61c-f898-4077-bd78-af3e72031cc3","name":"Whiticar, Alexander M.","name_org":"Whiticar, A. M.","orcid":"0000-0002-3807-5660","rank":2,"rolecode":"pau"},{"affno":"1","first":"M. -T.","key":"dengpau","last":"Deng","locid":"994acb5e-b03c-495c-a08d-54b815216189","name":"Deng, Mingtang","name_org":"Deng, M. -T.","orcid":"0000-0003-2809-6158","rank":3,"rolecode":"pau"},{"affno":"1","first":"F.","key":"krizekpau","last":"Krizek","locid":"c3168095-e92d-4b82-8731-5f87a6d8218e","name":"Krizek, Filip","name_org":"Krizek, F.","rank":4,"rolecode":"pau"},{"affno":"1","first":"J. E.","key":"sestoftpau","last":"Sestoft","locid":"6e7062ff-7bc7-408b-a64c-8bad75f45594","name":"Sestoft, Joachim E.","name_org":"Sestoft, J. E.","orcid":"0000-0002-1623-3373","rank":5,"rolecode":"pau"},{"affno":"2","first":"C. J.","key":"palmstrompau","last":"Palmstrom","name":"Palmstrom, C. J.","rank":6,"rolecode":"pau"},{"affno":"","first":"S.","key":"martisanchezpau","last":"Marti-Sanchez","name":"Marti-Sanchez, S.","rank":7,"rolecode":"pau"},{"affno":"","first":"J.","key":"arbiolpau","last":"Arbiol","name":"Arbiol, J.","rank":8,"rolecode":"pau"},{"affno":"1","first":"P.","key":"krogstruppau","last":"Krogstrup","locid":"5aeca018-9a09-4ef1-aa81-aaa6dd734af0","name":"Krogstrup, Peter","name_org":"Krogstrup, P.","orcid":"0000-0002-1930-8553","rank":9,"rolecode":"pau"},{"affno":"1","first":"L.","key":"casparispau","last":"Casparis","locid":"9856d9ad-f626-4cf4-8f69-a1a623a2a40a","name":"Casparis, L.","orcid":"0000-0001-8618-8902","rank":10,"rolecode":"pau"},{"affno":"1","first":"C. M.","key":"marcuspau","last":"Marcus","locid":"847588e2-ab7e-4698-911c-103e1e919489","name":"Marcus, Charles M.","name_org":"Marcus, C. M.","orcid":"0000-0003-2420-4692","rank":11,"rolecode":"pau"}],"pmid":["30339420"],"pub":{"doi":"10.1103/physrevlett.121.147701","issn":["00319007","10797114"],"issn_org":["00319007"],"issue":"14","journal":"Physical Review Letters","paperid":"147701","status":"p","title":"Physical Review Letters","volume":"121"},"review":"Peer Reviewed","scoID":["2-s2.0-85054503638"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-67569436-86fd-4e28-8826-00218c54fae1"],"src":["KU University of Copenhagen"],"title":"Selective-Area-Grown Semiconductor-Superconductor Hybrids : A Basis for Topological Networks","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-455135","year":"2018","yearsub":"2018"}
{"abstract":"The combination of strong spin-orbit coupling, large g factors, and the coupling to a superconductor can be used to create a topologically protected state in a semiconductor nanowire. Here we report on growth and characterization of hybrid epitaxial InAsSb/Al nanowires, with varying composition and crystal structure. We find the strongest spin-orbit interaction at intermediate compositions in zinc-blende InAs1-xSbx nanowires, exceeding that of both InAs and InSb materials, confirming recent theoretical studies. We show that the epitaxial InAsSb/Al interface allows for a hard induced superconducting gap and 2e transport in Coulomb charging experiments, similarly to experiments on InAs/Al and InSb/Al materials, and find measurements consistent with topological phase transitions at low magnetic fields due to large effective g factors. Finally we present a method to grow pure wurtzite InAsSb nanowires which are predicted to exhibit even stronger spin-orbit coupling than the zinc-blende structure.","author_count":14,"contributors":["Sestoft, Joachim E.","Kanne, Thomas","Gejl, Aske Nørskov","von Soosten, Merlin","Yodh, Jeremy S.","Sherman, Daniel","Tarasinski, Brian","Wimmer, Michael","Johnson, Erik","Deng, Mingtang","Nygard, Jesper","Jespersen, Thomas Sand","Marcus, Charles M.","Krogstrup, Peter"],"cuid":["S02-100.00-036954"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","OECD"],"corresponding_author":["Krogstrup, Peter"],"country":["Netherlands"],"glorg":["All Global Affiliations","Delft University of Technology"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"engineering hybrid epitaxial inassb al nanowires for stronger topological protection","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1103/PhysRevMaterials.2.044202","version":"Published Version"},"id":"S02-100.00-036954","identifier":[{"id":"000429780300001","type":"wos"},{"id":"85046838290","type":"scopus"}],"ids":["dtu-c07a254b-3f3b-46b3-a887-bc32f89b1f67","ku-c9af0865-7c8e-4538-a7b3-2a58591f09b5"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-6BB30043B3703E5F5CC87D2DE46E9968"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/149386209/Untitled_3.pdf","version":"Published Version"},{"access":"oa","license":"https://arxiv.org/licenses/nonexclusive-distrib/1.0/license.html","type":"rem","url":"https://arxiv.org/pdf/1711.06864.pdf","version":"Pre-print"},{"access":"oa","type":"doi","url":"https://doi.org/10.1103/PhysRevMaterials.2.044202","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Niels Bohr Institute, Condensed Matter Physics"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Micro- and Nanotechnology","Technical University of Denmark, Department of Micro- and Nanotechnology, Nanocarbon"],"nora_code":"DI-U-DTU","used":1},{"affno":"3","country":"nl","key":"delft university of te