cid":"a9f6df21-02fe-407f-8472-6e4a496f8ec0","name":"Nygård, Jesper","name_org":"Nygard, Jesper","orcid":"0000-0002-4639-5314","rank":11,"rolecode":"pau"},{"affno":"1","first":"Thomas Sand","key":"jespersenpau","last":"Jespersen","locid":"65fc2107-0d74-41f9-96cb-4ee1b8677f2e","name":"Jespersen, Thomas Sand","orcid":"0000-0002-7879-976X","rank":12,"rolecode":"pau"},{"affno":"1","first":"Charles M.","key":"marcuspau","last":"Marcus","locid":"847588e2-ab7e-4698-911c-103e1e919489","name":"Marcus, Charles M.","orcid":"0000-0003-2420-4692","rank":13,"rolecode":"pau"},{"affno":"1","first":"Peter","key":"krogstruppau","last":"Krogstrup","locid":"5aeca018-9a09-4ef1-aa81-aaa6dd734af0","name":"Krogstrup, Peter","orcid":"0000-0002-1930-8553","rank":14,"rolecode":"pau"}],"pub":{"doi":"10.1103/physrevmaterials.2.044202","issn":["24759953","24760455"],"issn_org":["24759953"],"issue":"4","journal":"Physical Review Materials","paperid":"044202","publisher":"American Physical Society","status":"p","title":"Physical Review Materials","volume":"2"},"review":"Peer Reviewed","scoID":["2-s2.0-85046838290"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-c07a254b-3f3b-46b3-a887-bc32f89b1f67","ku-c9af0865-7c8e-4538-a7b3-2a58591f09b5"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Engineering hybrid epitaxial InAsSb/Al nanowires for stronger topological protection","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-036954","year":"2018","yearsub":"2018"}
{"abstract":"The specification of a programming language is a special case of the specification of software in general. This paper discusses the relation between semantics and implementation, or specification and program, using two very different languages for illustration. First, we consider small fragments of a specification of preliminary Ada, and show that what was considered a specification in VDM in 1980 now looks much like an implementation in a functional language. Also, we discuss how a formal specification may be valuable even though seen from a purely formal point of view it is flawed. Second, we consider the simple language of spreadsheet formulas and give a complete specification. We show that nondeterminism in the specification may reflect run-time nondeterminism, but also underspecification, that is, implementation-time design choices. Although specification nondeterminism may appear at different binding-times there is no conventional way to distinguish these. We also consider a cost semantics and find that the specification may need to contain some “artificial” nondeterminism for underspecification.","author_count":3,"contributors":["Sestoft, Peter"],"cuid":["S01-000.00-381740"],"event":{"acronym":"ISoLA","title":"International Symposium on Leveraging Applications of Formal Methods, Verification and Validation"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Formal specification","Functional languages","Nondeterminism","Programming language specification","Semantics and implementation"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"programming language specification and implementation","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83565752/sestoft_isola2018_20180917.pdf","version":"Authors Final Version"},"id":"S01-000.00-381740","identifier":[{"id":"85056468448","type":"scopus"}],"ids":["itu-1fe22cdf-8f08-45f0-816d-671da37ed604"],"keyword":["Formal specification","Functional languages","Nondeterminism","Programming language specification","Semantics and implementation"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-486C8F8500B9A78AF0B8D8A4D7F113F1"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83565752/sestoft_isola2018_20180917.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Peter","key":"sestoftpau","last":"Sestoft","locid":"0ee7ba1e-3108-4db3-a908-97977980d032","name":"Sestoft, Peter","orcid":"0000-0002-5843-6021","rank":1,"rolecode":"pau"},{"affno":"","first":"Tiziana","key":"margariapedh","last":"Margaria","name":"Margaria, Tiziana","rank":2,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Bernhard","key":"steffenpedh","last":"Steffen","name":"Steffen, Bernhard","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-030-03418-4_11","eisbn":["9783030034184"],"isbn":["9783030034177"],"issn":["03029743"],"pages":"162-183","publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","subtitle":"8th International Symposium, ISoLA 2018 Limassol, Cyprus, November 5–9, 2018 Proceedings, Part I","title":"Leveraging Applications of Formal Methods, Verification and Validation. Modeling."},"review":"Peer Reviewed","scoID":["2-s2.0-85056468448"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-1fe22cdf-8f08-45f0-816d-671da37ed604"],"src":["ITU IT University of Copenhagen"],"title":"Programming language specification and implementation","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381740","year":"2018","yearsub":"2018"}
{"abstract":"This technical report gives a list of US patents and patent applications related to spreadsheet implementation technology. It is intended as a companion to the monograph Spreadsheet Implementation Technology (Peter Sestoft, MIT Press 2014), and substantially extends and updates an appendix from A Spreadsheet Core Implementation in C# (Peter Sestoft, IT University Technical Report ITU-TR-2006-91, 2006).","author_count":3,"contributors":["Borum, Holger Stadel","Kirkbro, Malthe Ettrup","Sestoft, Peter"],"cuid":["S01-000.00-382733"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["C Spreadsheet Core","Patent Applications","Spreadsheet Implementation","Technical Report","US Patents"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"nr","rtype":["clu"],"sorti":"spreadsheet patents","src":["itu"],"src-code":["DI-U-ITU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83071316/ITU_TR_2018_200.pdf","version":"Published Version"},"id":"S01-000.00-382733","ids":["itu-61d4254d-4b0e-4361-9e47-48db8b60cdb8"],"keyword":["C# Spreadsheet Core","Patent Applications","Spreadsheet Implementation","Technical Report","US Patents"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-8B5EF047C4F4C1573BFC44364C426776"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83071316/ITU_TR_2018_200.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Holger Stadel","key":"borumpau","last":"Borum","name":"Borum, Holger Stadel","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Malthe Ettrup","key":"kirkbropau","last":"Kirkbro","name":"Kirkbro, Malthe Ettrup","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Peter","key":"sestoftpau","last":"Sestoft","locid":"0ee7ba1e-3108-4db3-a908-97977980d032","name":"Sestoft, Peter","orcid":"0000-0002-5843-6021","rank":3,"rolecode":"pau"}],"pub":{"isbn":["9788779493667"],"issn":["16006100"],"issue":"TR-2018-200","pages":"62","place":"Copenhagen, Denmark","publisher":"IT University of Copenhagen","repno":"IT University Technical Report Series, TR-2018-200","series":"IT University Technical Report Series","status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-61d4254d-4b0e-4361-9e47-48db8b60cdb8"],"src":["ITU IT University of Copenhagen"],"title":"Spreadsheet Patents","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382733","year":"2018","yearsub":"2018"}
{"abstract":"We give a simple but precise operational semantics for the evaluation of extended spreadsheet formulas, with array formulas, sheet-defined functions and closures, as found in the Funcalc spreadsheet platform. We build on this to give a simple cost semantics for evaluation of a spread- sheet formula and for full and minimal recalculation of a spreadsheet. Following the ideas presented by Schmidt we provide a big step trace-based abstract interpretation for the cost semantics. We then present a set of functions which can be used to calculate the cost of executing an evaluation of a spreadsheet expression following Gomez et al., inspired by Rosendahl. These functions are related to the above operational semantics, cost semantics and abstract interpretation.The above semantic presentations all form the formal foundations for various cost calculations implemented in the Funcalc spreadsheet platform.","author_count":5,"contributors":["Bock, Alexander Asp","Bøgholm, Thomas","Sestoft, Peter","Thomsen, Bent","Thomsen, Lone Leth"],"cuid":["S02-093.17-004772"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Costs","Semantics","Spreadsheets"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-AAU","DI-U-ITU"]},"review":"nr","rtype":["clu"],"sorti":"concrete and abstract cost semantics for spreadsheets","src":["aau","itu"],"src-code":["DI-U-AAU","DI-U-ITU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/302792485/ITU_TR_2018_203_1_.pdf","version":"Published Version"},"id":"S02-093.17-004772","ids":["aau-620483cb-894d-45e3-b814-563df6d2bccd","itu-e4c9cc75-7237-4a48-a25d-1aa64eead024"],"keyword":["Spreadsheets","costs","semantics"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-2-C9FB8F2EB51426E99383F5F00DAFAB14"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/302792485/ITU_TR_2018_203_1_.pdf","version":"Published Version"},{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/84061527/ITU_TR_2018_203.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Technical Faculty of IT and Design","Aalborg University, The Technical Faculty of IT and Design, Department of Computer Science","Aalborg University, The Technical Faculty of IT and Design, Department of Computer Science, Database, Programming and Web Technologies"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Alexander","key":"bockalexanderpau","last":"Bock","name":"Bock, Alexander","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Thomas","key":"bøgholmthomaspau","last":"Bøgholm","locid":"0a4826c4-54e1-49f2-8ec7-7c95d1770346","name":"Bøgholm, Thomas","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Peter","key":"sestoftpeterpau","last":"Sestoft","locid":"0ee7ba1e-3108-4db3-a908-97977980d032","name":"Sestoft, Peter","orcid":"0000-0002-5843-6021","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Bent","key":"thomsenbentpau","last":"Thomsen","locid":"e47d25c8-df5c-453f-bcd7-0921f9915911","name":"Thomsen, Bent","orcid":"0000-0002-5853-7973","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Lone Leth","key":"thomsenlonelethpau","last":"Thomsen","locid":"49d94462-bea3-48f8-9a78-bb69e87acdc9","name":"Thomsen, Lone Leth","orcid":"0000-0003-1035-5975","rank":5,"rolecode":"pau"}],"pub":{"issn":["16006100"],"issue":"TR-2018-203","pages":"63","publisher":"IT-Universitetet i København","repno":"IT University Technical Report Series, TR-2018-203","series":"IT University Technical Report Series","status":"p"},"review":"No Review","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["aau-620483cb-894d-45e3-b814-563df6d2bccd","itu-e4c9cc75-7237-4a48-a25d-1aa64eead024"],"src":["AAU Aalborg University","ITU IT University of Copenhagen"],"title":"Concrete and Abstract Cost Semantics for Spreadsheets","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-093.17-004772","year":"2018","yearsub":"2018"}
{"abstract":"Spreadsheets are used heavily in industry and academia. Often, spreadsheet models are developed for years and their complexity grows vastly beyond what the paradigm was originally conceived for. Such complexity often comes at the cost of recalculation performance. However, spreadsheet models usually have some high-level structure that can be used to improve performance by performing independent computation in parallel. In this paper, we devise rules for rewriting high-level spreadsheet structure in the form of so-called cell arrays into higher-order functional programs that can be easily parallelized on multicore processors. We implement our rule set for the experimental Funcalc spreadsheet engine which already implements parallelizable higher-order array functions as well as user-defined higher-order functions. Benchmarks show that our rewriting approach improves recalculation performance for spreadsheets that are dominated by cell arrays.","author_count":3,"contributors":["Biermann, Florian","Dou, Wensheng","Sestoft, Peter"],"cuid":["S01-000.00-381726"],"event":{"acronym":"PADL","title":"International Symposium on Practical Aspects of Declarative Languages"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Asia, East"],"country":["China"],"glorg":["All Global Affiliations","Chinese Academy of Sciences"],"keyword":["Arrays","Functional programming","Parallelism","Performance","Spreadsheets","expression rewriting"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"rewriting high level spreadsheet structures into higher order functional programs","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-ND","type":"loc","url":"https://pure.itu.dk/ws/files/82454108/rewriting_spreadsheet_structures.pdf","version":"Authors Final Version"},"id":"S01-000.00-381726","identifier":[{"id":"85041123991","type":"scopus"}],"ids":["itu-1ed6e30c-a29d-4600-a62d-af00b7fd9374"],"keyword":["arrays","expression rewriting","functional programming","parallelism","performance","spreadsheets"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-26C7F191D9D850FB0356010824068E63"],"oa_link":[{"access":"oa","license":"CC BY-ND","type":"loc","url":"https://pure.itu.dk/ws/files/82454108/rewriting_spreadsheet_structures.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"cn","key":"chinese academy of sciences","loc":["China","Asia, East"],"name":"Chinese Academy of Sciences","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Florian","key":"biermannpau","last":"Biermann","name":"Biermann, Florian","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Wensheng","key":"doupau","last":"Dou","name":"Dou, Wensheng","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Peter","key":"sestoftpau","last":"Sestoft","locid":"0ee7ba1e-3108-4db3-a908-97977980d032","name":"Sestoft, Peter","orcid":"0000-0002-5843-6021","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1007/978-3-319-73305-0_2","eisbn":["9783319733050"],"isbn":["9783319733043"],"issn":["03029743"],"pages":"20-35","publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","subtitle":"PADL 2018: Practical Aspects of Declarative Languages","title":"International Symposium on Practical Aspects of Declarative Languages"},"review":"Peer Reviewed","scoID":["2-s2.0-85041123991"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-1ed6e30c-a29d-4600-a62d-af00b7fd9374"],"src":["ITU IT University of Copenhagen"],"title":"Rewriting High-Level Spreadsheet Structures into Higher-Order Functional Programs","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381726","year":"2017","yearsub":"2017"}
{"abstract":"We describe the quad rope data structure, a representation of immutable two-dimensional arrays that avoids many of the performance pitfalls of plain C-style two-dimensional arrays. Our motivation is that, for end-user development in high-level declarative programming languages, it is impractical to let users choose between different array-like data structures. Instead, one should use the same, somewhat performance-robust, representation for every programming task. Quad ropes roughly retain array efficiency, as long as programmers express their programs using high-level constructs. Moreover, they allow for fast concatenation and dynamic task-based parallelism and are well suited to represent sparse arrays. We describe their operational semantics and evaluate the performance of individual functions on quad ropes as well as declarative algorithms that use our quad rope implementation.","author_count":2,"contributors":["Biermann, Florian","Sestoft, Peter"],"cuid":["S01-000.00-381657"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Dynamic Parallelism","High Level Declarative Programming","Immutable Arrays","Quad Rope Data Structure","Sparse Arrays"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"quad ropes immutable declarative arrays with parallelizable operations","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82083562/array17_quad_ropes_camera_ready.pdf","version":"Authors Final Version"},"id":"S01-000.00-381657","identifier":[{"id":"85029683745","type":"scopus"}],"ids":["itu-1a4cd550-8cd0-4609-8702-4341fd0f48a2"],"keyword":["Dynamic Parallelism","High-Level Declarative Programming","Immutable Arrays","Quad Rope Data Structure","Sparse Arrays"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-3B4193B8D75718CA2EB719E5D32132E2"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82083562/array17_quad_ropes_camera_ready.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Florian","key":"biermannpau","last":"Biermann","name":"Biermann, Florian","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Peter","key":"sestoftpau","last":"Sestoft","locid":"0ee7ba1e-3108-4db3-a908-97977980d032","name":"Sestoft, Peter","orcid":"0000-0002-5843-6021","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1145/3091966.3091971","isbn":["9781450350693"],"pages":"1-8","publisher":"Association for Computing Machinery","status":"p","subtitle":"ARRAY 2017","title":"Proceedings of the 4th ACM SIGPLAN International Workshop on Libraries, Languages, and Compilers for Array Programming"},"review":"Peer Reviewed","scoID":["2-s2.0-85029683745"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-1a4cd550-8cd0-4609-8702-4341fd0f48a2"],"src":["ITU IT University of Copenhagen"],"title":"Quad Ropes: Immutable, Declarative Arrays with Parallelizable Operations","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381657","year":"2017","yearsub":"2017"}
