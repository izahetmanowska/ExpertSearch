ersity College"],"PST":["Published"]},"sid":["aau-46ef91fe-6ee3-4f6b-9602-33dddb022517","ku-037aede2-d059-4dac-828a-7b3130a776c9"],"src":["AAU Aalborg University","KU University of Copenhagen"],"title":"18 markante uddannelsesstemmer: Utålmodig reformiver er ineffektiv uddannelsespolitik","type":"Newspaper Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-096.70-751545","year":"2023","yearsub":"2023"}
{"abstract":"We give a simple operational cost semantics for evaluation of spreadsheet formulas and for full and minimal recalculation. We also present a semantics which caters for computing with unknown data values. This may be used to give an approximation of the cost when input data is not yet provided. This semantics is a rudimentary big-step trace-based abstract interpretation based upon the cost semantics. Together, the semantic presentations form the formal foundations for various cost calculations implemented in the Funcalc spreadsheet platform. This can be used in cost estimation tools, e.g. to estimate which formulas in a spreadsheet are the most expensive, or to schedule parallel recalculation of a spreadsheet. In future work, further analyzes and verification tools can be built upon the formal semantics to reduce the large number of errors that commonly occur in spreadsheets.","author_count":5,"contributors":["Bock, Alexander Asp","Bøgholm, Thomas","Sestoft, Peter","Thomsen, Bent","Thomsen, Lone Leth"],"cuid":["S02-086.49-003069"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"corresponding_author":["Sestoft, Peter"],"keyword":["Abstract semantics","Cost semantics","Funcalc","Recalculation","Sheet defined functions","Spreadsheets"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-AAU","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"on the cost semantics for spreadsheets with sheet defined functions","src":["aau","itu"],"src-code":["DI-U-AAU","DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.cola.2022.101103","version":"Published Version"},"funding_acknowledgement":["Supported by the Independent Research Fund Denmark (grant number DFF-FTP-4005-00141), Popular Parallel Programming (P3) 2015?2019.Supported by IT-vest (grant number AAU-2018-59).Supported by Innovation Fund Denmark (grant number 7076-00029B), Projection of Balances and Benefits in Life Insurance (ProBaBLI) 2018?2022."],"id":"S02-086.49-003069","identifier":[{"id":"85125838788","type":"scopus"}],"ids":["aau-3e845ceb-321f-4ba0-948a-98a267aba924","itu-cb6446a2-6ae5-4683-9d34-18779f6bd96c"],"keyword":["Abstract semantics","Cost semantics","Funcalc","Recalculation","Sheet-defined functions","Spreadsheets"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-04E1167347889733A36A0EF99B891731"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.cola.2022.101103","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.itu.dk/ws/files/92261161/1_s2.0_S2590118422000120_main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/467511720/1_s2.0_S2590118422000120_main.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Technical Faculty of IT and Design","Aalborg University, The Technical Faculty of IT and Design, Department of Computer Science","Aalborg University, The Technical Faculty of IT and Design, Department of Computer Science, Distributed, Embedded and Intelligent Systems"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Alexander Asp","key":"bockalexanderasppau","last":"Bock","name":"Bock, Alexander Asp","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Thomas","key":"bøgholmthomaspau","last":"Bøgholm","locid":"0a4826c4-54e1-49f2-8ec7-7c95d1770346","name":"Bøgholm, Thomas","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Peter","key":"sestoftpeterpau","last":"Sestoft","locid":"0ee7ba1e-3108-4db3-a908-97977980d032","name":"Sestoft, Peter","orcid":"0000-0002-5843-6021","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Bent","key":"thomsenbentpau","last":"Thomsen","locid":"e47d25c8-df5c-453f-bcd7-0921f9915911","name":"Thomsen, Bent","orcid":"0000-0002-5853-7973","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lone Leth","key":"thomsenlonelethpau","last":"Thomsen","locid":"49d94462-bea3-48f8-9a78-bb69e87acdc9","name":"Thomsen, Lone Leth","orcid":"0000-0003-1035-5975","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.cola.2022.101103","issn":["14778424"],"journal":"Computer Languages, Systems and Structures","paperid":"101103","publisher":"Elsevier","status":"p","title":"Computer Languages, Systems and Structures","title_org":"Journal of Computer Languages","volume":"69"},"review":"Peer Reviewed","scoID":["2-s2.0-85125838788"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["aau-3e845ceb-321f-4ba0-948a-98a267aba924","itu-cb6446a2-6ae5-4683-9d34-18779f6bd96c"],"src":["AAU Aalborg University","ITU IT University of Copenhagen"],"title":"On the cost semantics for spreadsheets with sheet-defined functions","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-086.49-003069","year":"2022","yearsub":2023}
{"abstract":"Domain-specific languages (DSLs) have emerged as a plausible way for non-programming experts to efficiently express their domain knowledge. Recent DSL research has taken a technical perspective on how and why to create DSLs, resulting in a wealth of innovative tools, frameworks and technical approaches. Less attention has been paid to the design process. Namely, how can it ensure that the created DSL realises the expected benefits? This paper seeks to answer this question when designing DSLs for highly specialised domains subject to resource constraints, an evolving application domain, and scarce user participation. We propose an iteration of alternating activities in a human-centred design method that seeks to minimise the need for expensive implementation and user involvement. The method moves from a low-validity exploration of highly diverse language designs towards a higher-validity exploration of more homogeneous designs. We give an in-depth case study of designing an actuarial DSL called MAL, or Management Action Language, which allows actuaries to model so-called future management actions in asset/liability projections in life insurance and pension companies. The proposed human-centred design method was synthesised from this case study, where we found it useful for iteratively identifying and removing usability problems during the design.","author_count":3,"contributors":["Borum, Holger Stadel","Niss, Henning","Sestoft, Peter"],"cuid":["S01-000.00-383096"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Actuarial DSL","Domain specific languages","Human centred design","Iterative design","Usability evaluation"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"on designing applied dsls for non programming experts in evolving domains","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86356098/main.pdf","version":"Authors Final Version"},"id":"S01-000.00-383096","identifier":[{"id":"85118868490","type":"scopus"}],"ids":["itu-7c8f479f-a141-401f-8013-f064f58cf7c6"],"keyword":["Actuarial DSL","Domain-specific languages","Human-centred design","Iterative design","Usability evaluation"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-4-8-D513EA10EAB04C349196E4478FB0BEAA"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86356098/main.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Software Engineering, Software Quality Research"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Holger Stadel","key":"borumpau","last":"Borum","name":"Borum, Holger Stadel","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Henning","key":"nisspau","last":"Niss","name":"Niss, Henning","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Peter","key":"sestoftpau","last":"Sestoft","locid":"0ee7ba1e-3108-4db3-a908-97977980d032","name":"Sestoft, Peter","orcid":"0000-0002-5843-6021","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1145/3486603.3486776","eisbn":["9781665434959"],"pages":"227-238","publisher":"IEEE","status":"p","title":"Proceedings of 24th International Conference on Model-Driven Engineering Languages and Systems, MODELS 2021"},"review":"Peer Reviewed","scoID":["2-s2.0-85118868490","2-s2.0-85118868545"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-7c8f479f-a141-401f-8013-f064f58cf7c6"],"src":["ITU IT University of Copenhagen"],"title":"On Designing Applied DSLs for Non-programming Experts in Evolving Domains","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383096","year":"2021","yearsub":"2021"}
{"abstract":"Domain-specific languages seek to provide domain guarantees that eliminate many errors allowed by general-purpose languages. Still, a domain-specific language requires additional quality assurance measures to ensure that specifications behave as intended by the users. However, some domains may have specific quality assurance measures (e.g., proofs, experiments, or case studies) with little tradition of using quality assurance measures customary to software engineering. We investigate the possibility of accommodating such domains by conducting a workshop with 11 prospective users of a domain-specific language named MAL for the pension industry. The workshop emphasised the need for supporting actuaries with new analytical tools for quality assurance and resulted in three designs: quantity monitors let users identify outlier behaviour, fragment debugging lets users debug with limited evaluative power, and debugging spreadsheets let users visualise, analyse, and remodel concrete calculations with an established domain tool. Based on our experiences, we hypothesise that co-design workshops are a viable approach for DSLs in a similar situation.","author_count":3,"contributors":["Borum, Holger Stadel","Seidl, Christoph","Sestoft, Peter"],"cuid":["S01-000.00-383903"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Actuarial Analysis Tools","Co Design Workshops","Domain specific languages","Pension Industry","Quality assurance"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"co designing dsl quality assurance measures for and with non programming experts","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86333743/holger_splash_dsm21.pdf","version":"Pre-print"},"id":"S01-000.00-383903","ids":["itu-b5037a03-dbae-4391-9177-8b8f6278b1c5"],"keyword":["Actuarial Analysis Tools","Co-Design Workshops","Domain-Specific Languages","Pension Industry","Quality Assurance"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-4-8-D513EA10EAB04C349196E4478FB0BEAA"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86333743/holger_splash_dsm21.pdf","version":"Pre-print"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Software Engineering, Software Quality Research"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Holger Stadel","key":"borumpau","last":"Borum","name":"Borum, Holger Stadel","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christoph","key":"seidlpau","last":"Seidl","locid":"fda8c630-1b0a-4910-ae2a-602850616275","name":"Seidl, Christoph","orcid":"0000-0003-4539-8297","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Peter","key":"sestoftpau","last":"Sestoft","locid":"0ee7ba1e-3108-4db3-a908-97977980d032","name":"Sestoft, Peter","orcid":"0000-0002-5843-6021","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1145/3486603.3486776","eisbn":["9781450391061"],"pages":"31-40","publisher":"Association for Computing Machinery","status":"p","title":"DSM 2021: Proceedings of the 18th ACM SIGPLAN International Workshop on Domain-Specific Modeling"},"review":"Peer Reviewed","scoID":["2-s2.0-85118868490","2-s2.0-85118868545"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-b5037a03-dbae-4391-9177-8b8f6278b1c5"],"src":["ITU IT University of Copenhagen"],"title":"Co-designing DSL quality assurance measures for and with non-programming experts","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383903","year":"2021","yearsub":"2021"}
{"abstract":"We give an operational semantics for the evaluation of spreadsheets, including sheet-defined and built-in numeric functions in the Funcalc spreadsheet platform. The semantics allows for different implementations and we discuss sheet-defined functions implemented using both interpretation and run-time code generation. The semantics specifies the expected result of a computation, also considering non-deterministic functions, independently of an evaluation mechanism. It can be extended to include the cost of formula evaluation for a cost analysis e.g. for use in parallelization of computations. An interesting future direction is to investigate experimentally how close our semantics is to that of major spreadsheet implementations.","author_count":5,"contributors":["Bock, Alexander Asp","Bøgholm, Thomas","Sestoft, Peter","Thomsen, Bent","Thomsen, Lone Leth"],"cuid":["S02-091.43-006236"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Funcalc","Recalculation","Semantics","Sheet defined function","Spreadsheet"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-AAU","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"on the semantics for spreadsheets with sheet defined functions","src":["aau","itu"],"src-code":["DI-U-AAU","DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.cola.2020.100960","version":"Published Version"},"id":"S02-091.43-006236","identifier":[{"id":"85082764102","type":"scopus"}],"ids":["aau-80e6b5d3-c39b-4ca5-8876-e1526daf9caf","itu-e132b2f0-45ce-42c4-bfa6-74d5b042a637"],"keyword":["Funcalc","Recalculation","Semantics","Sheet-defined function","Spreadsheet"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-CC87969E7D7AC2CAABCE29355CDA954E"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/386907252/1_s2.0_S2590118420300204_main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.cola.2020.100960","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://pure.itu.dk/ws/files/85284728/1_s2.0_S2590118420300204_main.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Technical Faculty of IT and Design","Aalborg University, The Technical Faculty of IT and Design, Department of Computer Science","Aalborg University, The Technical Faculty of IT and Design, Department of Computer Science, Database, Programming and Web Technologies"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Alexander Asp","key":"bockalexanderasppau","last":"Bock","name":"Bock, Alexander Asp","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Thomas","key":"bøgholmthomaspau","last":"Bøgholm","locid":"0a4826c4-54e1-49f2-8ec7-7c95d1770346","name":"Bøgholm, Thomas","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Peter","key":"sestoftpeterpau","last":"Sestoft","locid":"0ee7ba1e-3108-4db3-a908-97977980d032","name":"Sestoft, Peter","orcid":"0000-0002-5843-6021","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Bent","key":"thomsenbentpau","last":"Thomsen","locid":"e47d25c8-df5c-453f-bcd7-0921f9915911","name":"Thomsen, Bent","orcid":"0000-0002-5853-7973","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Lone Leth","key":"thomsenlonelethpau","last":"Thomsen","locid":"49d94462-bea3-48f8-9a78-bb69e87acdc9","name":"Thomsen, Lone Leth","orcid":"0000-0003-1035-5975","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.cola.2020.100960","issn":["25901184"],"journal":"Journal of Computer Languages","paperid":"100960","publisher":"Elsevier","status":"p","title":"Journal of Computer Languages","volume":"57"},"review":"Peer Reviewed","scoID":["2-s2.0-85082764102"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["aau-80e6b5d3-c39b-4ca5-8876-e1526daf9caf","itu-e132b2f0-45ce-42c4-bfa6-74d5b042a637"],"src":["AAU Aalborg University","ITU IT University of Copenhagen"],"title":"On the Semantics for Spreadsheets with Sheet Defined Functions","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-091.43-006236","year":"2020","yearsub":"2020"}
{"abstract":"Gate-tunable junctions are key elements in quantum devices based on hybrid semiconductor-superconductor materials. They serve multiple purposes ranging from tunnel spectroscopy probes to voltage-controlled qubit operations in gatemon and topological qubits. Common to all is that junction transparency plays a critical role. In this study, we grow single-crystalline InAs, InSb, and InAs1-xSbx semiconductor nanowires with epitaxial Al, Sn, and Pb superconductors and in situ shadowed junctions in a single-step molecular beam epitaxy process. We investigate correlations between fabrication parameters, junction morphologies, and electronic transport properties of the junctions and show that the examined in situ shadowed junctions are of significantly higher quality than the etched junctions. By varying the edge sharpness of the shadow junctions, we show that the sharpest edges yield the highest junction transparency for all three examined semiconductors. Further, critical supercurrent measurements reveal an extraordinarily high ICRN, close to the KO-2 limit. This study demonstrates a promising engineering path toward reliable gate-tunable superconducting qubits.","author_count":17,"contributors":["Khan, Sabbir A.","Lampadaris, Charalampos","Cui, Ajuan","Stampfer, Lukas","Liu, Yu","Pauka, Sebastian J.","Cachaza, Martin Espineira","Fiordaliso, Elisabetta M.","Kang, Jung-Hyun","Korneychuk, Svetlana","Mutas, Timo","Sestoft, Joachim E.","Krizek, Filip","Tanta, Rawa","Cassidy, Maja C.","Jespersen, Thomas Sand","Krogstrup, Peter"],"cuid":["S01-000.00-517883"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","OECD","Oceania"],"country":["Australia","Netherlands"],"glorg":["All Global Affiliations","Delft Univ Technol, Delft University of Technology, Kavli Inst Nanosci","University of Sydney"],"keyword":["Ballistic transport","Majorana bound states","Quantum computing","Topological materials"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"highly transparent gatable superconducting shadow junctions","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/256168005/acsnano.0c02979.pdf","version":"Published Version"},"id":"S01-000.00-517883","identifier":[{"id":"000595533800014","type":"wos"},{"id":"85096883934","type":"scopus"},{"id":"32396328","type":"pmid"}],"ids":["ku-d04cbf15-d89e-4248-a57e-b9249937a85b"],"keyword":["Majorana bound states","ballistic transport","quantum computing","semiconductor-superconductor nanowires","shadow junctions","topological materials"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-33155062066C1642EBD0B843BFEDC2E3"],"oa_link":[{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/256168005/acsnano.0c02979.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Niels Bohr Institute, Condensed Matter Physics"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark"],"nora_code":"DI-U-DTU",