{"author_count":1,"contributors":["Sestoft, Peter"],"cuid":["S01-000.00-383236"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"spreadsheet implementation technology basics and extensions","src":["itu"],"src-code":["DI-U-ITU"],"type":"db","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://mitpress.mit.edu/books/spreadsheet-implementation-technology","version":"Other Version"},"id":"S01-000.00-383236","ids":["itu-85d90f35-e80c-497d-ac2c-6e4822977fd4"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-DA712EE21A9F1052880D1A6219774B5D"],"oa_link":[{"access":"oa","type":"rem","url":"http://mitpress.mit.edu/books/spreadsheet-implementation-technology","version":"Other Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","The Department, Software & Systems"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Peter","key":"sestoftpau","last":"Sestoft","locid":"0ee7ba1e-3108-4db3-a908-97977980d032","name":"Sestoft, Peter","orcid":"0000-0002-5843-6021","rank":1,"rolecode":"pau"}],"pub":{"isbn":["9780262526647"],"publisher":"MIT Press","status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-85d90f35-e80c-497d-ac2c-6e4822977fd4"],"src":["ITU IT University of Copenhagen"],"title":