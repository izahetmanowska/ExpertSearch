Closas, Montserrat","rank":88,"rolecode":"pau"}],"pmid":["32620889"],"pub":{"doi":"10.1038/s41467-020-16483-3","issn":["20411723"],"issue":"1","journal":"Nature Communications","paperid":"3353","publisher":"Nature Research","status":"p","title":"Nature Communications","volume":"11"},"review":"Peer Reviewed","scoID":["2-s2.0-85087397990"],"sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-2d9d76ce-e6ba-4063-b7e3-59a37ef8eb91"],"src":["DTU Technical University of Denmark"],"title":"Assessment of polygenic architecture and risk prediction based on common variants across fourteen cancers","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-318141","year":"2020","yearsub":"2020"}
{"abstract":"This workshop aims to bring together Research through Design (RtD) practitioners in the DIS community, giving them a space to present, debate, and discuss issues emerging from their work. In particular, our goal is to catalyze a focused conversation on contexts and specific situations of research through design, discussing the ins-and-outs of working in a specific context and with particular issues of consequence. Building on the success of prior RtD and design research workshops at HCI conferences, this workshop will focus on how RtD artifacts operate in these contexts, with the goal of connecting diverse artefacts with broader methods in HCI and Design.","author_count":7,"contributors":["Jenkins, Tom","Odom, William","Pierce, James","Andersen, Kristina","Boucher, Andy","Chatting, David","Gaver, William"],"cuid":["S01-000.00-384560"],"event":{"acronym":"DIS","title":"ACM Conference on Designing Interactive Systems"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","Europe, EU","Europe, Non-EU","OECD"],"country":["Canada","Netherlands","United Kingdom","United States"],"glorg":["All Global Affiliations","California College of the Arts","Eindhoven University of Technology","Goldsmiths, University of London","Simon Fraser University"],"keyword":["Context","ISSUES","Research through Design","practice based design"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"rtd in situ discussing the domains and impact of design research","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85550909/DIS20_RtD_Workshop_Abstract_CR.pdf","version":"Other Version"},"id":"S01-000.00-384560","identifier":[{"id":"85090152462","type":"scopus"}],"ids":["itu-dfedc8ee-9cab-4297-ac94-f37aa792bb95"],"keyword":["Research through design","context","issues","practice-based design"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-E075F6328B35800662992E00E2F953F9"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85550909/DIS20_RtD_Workshop_Abstract_CR.pdf","version":"Other Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Digital Welfare","IT University of Copenhagen, Digital Design","IT University of Copenhagen, Human-Computer Interaction and Design, IxD Lab"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"ca","key":"simon fraser university","loc":["Canada","America, North","OECD"],"name":"Simon Fraser University","used":1},{"affno":"3","country":"us","key":"california college of the arts","loc":["United States","America, North","OECD"],"name":"California College of the Arts","used":1},{"affno":"4","country":"nl","key":"eindhoven university of technology","loc":["Netherlands","Europe, EU","OECD"],"name":"Eindhoven University of Technology","used":1},{"affno":"5","country":"gb","key":"goldsmiths university of london","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Goldsmiths, University of London","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Tom","key":"jenkinspau","last":"Jenkins","locid":"3ad26d6b-4619-4a9f-a1b6-8424aab1dd52","name":"Jenkins, Tom","orcid":"0000-0001-6135-410X","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"William","key":"odompau","last":"Odom","name":"Odom, William","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"James","key":"piercepau","last":"Pierc