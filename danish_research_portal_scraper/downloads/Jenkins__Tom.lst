"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-a8d3f4a1-9c48-4e63-9891-d09e6ea07413"],"src":["ITU IT University of Copenhagen"],"title":"Gut-Tracking as Cultivation","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383724","year":"2020","yearsub":"2020"}
{"abstract":"This workshop provides a venue within CHI for research through design (RtD) practitioners to present their work and discuss how, with whom, and why it is used. Building on the success of prior RtD and design research workshops at CHI, this workshop will focus on how RtD artifacts are used, with the goal of connecting diverse works with broader methodologies in HCI and Design.","author_count":10,"contributors":["Andersen, Kristina","Chatting, David","Boucher, Andy","Jenkins, Tom","Desjardins, Audrey","Devendorf, Laura","Gaver, William","Odom, William","Pierce, James","Vallgårda, Anna"],"cuid":["S01-000.00-384113"],"event":{"acronym":"CHI","title":"ACM Conference on Human Factors in Computing Systems"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","Europe, EU","Europe, Non-EU","OECD"],"country":["Canada","Netherlands","United Kingdom","United States"],"glorg":["All Global Affiliations","California College of the Arts","Eindhoven University of Technology","Georgia Institute of Technology","Goldsmiths, University of London","Simon Fraser University","University of Colorado","University of Washington"],"keyword":["Design Things","Material","Objects","Research through Design","physical rhetoric","practice based design"],"level":"pop","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"und","rtype":["clu"],"sorti":"doing things with research through design with what with whom and towards what ends","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/84686599/Doing_things_with_RtD.pdf","version":"Authors Final Version"},"id":"S01-000.00-384113","identifier":[{"id":"85067286852","type":"scopus"}],"ids":["itu-c2be36d5-9209-4bd7-8cce-da7b916a5088"],"keyword":["Research through design","design things","material","objects","physical rhetoric","practice-based design"],"lang":"English","level":"Popular","mra":["Science/Technology"],"noi":["Global-Local-2-4-0577416EC2B3D05901D52A882848E154"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/84686599/Doing_things_with_RtD.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","country":"nl","key":"eindhoven university of technology","loc":["Netherlands","Europe, EU","OECD"],"name":"Eindhoven University of Technology","used":1},{"affno":"2","country":"gb","key":"goldsmiths university of london","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Goldsmiths, University of London","used":1},{"affno":"3","country":"us","key":"georgia institute of technology","loc":["United States","America, North","OECD"],"name":"Georgia Institute of Technology","used":1},{"affno":"4","country":"us","key":"university of washington","loc":["United States","America, North","OECD"],"name":"University of Washington","used":1},{"affno":"5","country":"us","key":"university of colorado","loc":["United States","America, North","OECD"],"name":"University of Colorado","used":1},{"affno":"6","country":"ca","key":"simon fraser university","loc":["Canada","America, North","OECD"],"name":"Simon Fraser University","used":1},{"affno":"7","country":"us","key":"california college of the arts","loc":["United States","America, North","OECD"],"name":"California College of the Arts","used":1},{"affno":"8","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Human-Computer Interaction and Design, IxD Lab"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Kristina","ke