affno":"1","corresponding":null,"country":"dk","first":"Esperanza","key":"riveradetorreesperanzapau","last":"Rivera-de-Torre","locid":"4a68de17-d450-4d8b-a045-51aa2f0ca701","name":"Rivera-de-Torre, Esperanza","orcid":"0000-0002-0272-6150","rank":23,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"J. Preben","key":"morthjensprebenpau","last":"Morth","locid":"5c6aef5e-424e-4d99-8a1f-ba28b86e759b","name":"Morth, Jens Preben","name_org":"Morth, J. Preben","orcid":"0000-0003-4077-0192","rank":24,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Andreas H.","key":"laustsenandreashpau","last":"Laustsen","locid":"0e4bb465-c620-461f-9970-29bad328cf8a","name":"Laustsen, Andreas H.","orcid":"0000-0001-6918-5574","rank":25,"rolecode":"pau"}],"pmid":["40936197"],"pub":{"doi":"10.1080/19420862.2025.2553624","issn":["19420862","19420870"],"issn_org":["19420862"],"issue":"1","journal":"mAbs","paperid":"2553624","publisher":"CRC Press/Balkema","status":"p","title":"mAbs","volume":"17"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-2be656d7-888b-4cb4-8a87-091ee025ee43"],"src":["DTU Technical University of Denmark"],"title":"Rational design of antibodies with pH-dependent antigen-binding properties using structural insights from broadly neutralizing antibodies against α-neurotoxins","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-827450","year":"2025","yearsub":"2025"}
{"abstract":"This pictorial describes the process of developing an interaction technique for directly engaging with the hidden layers of a generative AI model for image synthesis. First, we give some background to generative AI in HCI, arguing that current interaction techniques prevent us from directly interacting with the material of AI, foreclosing its use in design. Drawing on inspiration from the Computer Science field of feature visualization, we investigate the materiality of our prototype, a GAN model trained to generate fashion imagery, and show how Hidden Layer Interaction offers an alternative to standard prompting. In doing so, we illustrate how this change in approach leads to new forms of interaction with the internal semantics of generative AI, and demonstrate how one might use Hidden Layer Interaction to engage with AI as a material in design.","author_count":2,"contributors":["Grabe, Imke","Jenkins, Tom"],"cuid":["S01-000.00-828183"],"filters":{"added":"2025-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Generative AI","Interaction design","Interpretability"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"hidden layer interaction a technique to explore the material of generative ai","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"rem","url":"https://dl.acm.org/doi/10.1145/3715336.3735437","version":"Published Version"},"id":"S01-000.00-828183","ids":["itu-df8263bf-a937-44fa-856e-3264d504a602"],"keyword":["Generative AI","Interaction Design","Interpretability"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-E7CD68A8A28D673A0EC344CE5D259845"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"rem","url":"https://dl.acm.org/doi/10.1145/3715336.3735437","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Human-Computer Interaction and Design","IT University of Copenhagen, Human-Computer Interaction and Design, IxD Lab"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Imke","key":"grabepau","last":"Grabe","locid":"7c852728-c562-4df0-84c1-4488dde7c360","name":"Grabe, Imke","orcid":"0000-0002-5122-6769","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Tom","key":"jenkinspau","last":"Jenkins","locid":"3ad26d6b-4619-4a9f-a1b6-8424aab1dd52","name":"Jenkins, Tom","orcid":"0000-0001-6135-410X","rank":2,"rolecode":"pau"}],"pub":{"eisbn":["9798400714856/2025/07"],"isbn":["9798400714856/2025/07"],"pages":"1913-1927","publisher":"Association for Computing Machinery","status":"p","title":"ACM DIS '25: Proceedings of the 2025 ACM Designing Interactive Systems Conference"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-df8263bf-a937-44fa-856e-3264d504a602"],"src":["ITU IT University of Copenhagen"],"title":"Hidden Layer Interaction: A Technique to Explore the Material of Generative AI","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-828183","year":"2025","yearsub":"2025"}
{"abstract":"This paper presents three scenario-based speculations accompanied by material explorations of soft IoT for smart homes based on humidity data. Cycle Lines tracks and displays weekly patterns of humidity levels shown as colored lines in a woven display, Relationscape, a real-time tracker and knitted display of humidity showing the relation between two different households, and Eco-collective, embroidery IoT that changes color depending on the humidity levels of different objects in the household. Based on first-person engagements with humidity sensors placed in the authors’ homes, they imagine new types of soft IoT devices that sense and display relations to humidity data, suggesting a role for mundane,craft-based IoT for smart homes. They express the relational nature of humidity and how it is tied to well-being in the home, among household members and other human and more-than-human inhabitants, as well as the environmental conditions inside and outside of the home. The soft, craft-based approach to imagining futures of IoT for smart homes has feminist commitments and invites for further problematizing domestic labor practices and craft activism in the domestic context.","author_count":3,"contributors":["Jenkins, Tom","Tsaknaki, Vasiliki","Jørgensen, Stina Marie Hasse"],"cuid":["S01-000.00-828145"],"event":{"acronym":"Nordes","title":"Nordic Design Research Conference"},"filters":{"added":"2025-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Craft","Scenarios","Smart home"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-KU"]},"level3all":["DI-U-ITU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"imagining a soft and relational smart home","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://pure.itu.dk/ws/files/112678447/Imagining_a_Soft_and_Relational_Smart_Home.pdf","version":"Published Version"},"id":"S01-000.00-828145","ids":["itu-36f98c62-1269-42c1-bc20-0df2bc889ef5"],"keyword":["Craft","Humidity data","Scenarios","Smart Home","Soft IoT"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-335DF05C2942634B94B1A3D4D15AF7B5"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://pure.itu.dk/ws/files/112678447/Imagining_a_Soft_and_Relational_Smart_Home.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Climate IT","IT University of Copenhagen, Center for Digital Welfare","IT University of Copenhagen, Human-Computer Interaction and Design","IT University of Copenhagen, Human-Computer Interaction and Design, IxD Lab"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Tom","key":"jenkinspau","last":"Jenkins","locid":"3ad26d6b-4619-4a9f-a1b6-8424aab1dd52","name":"Jenkins, Tom","orcid":"0000-0001-6135-410X","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Vasiliki","key":"tsaknakipau","last":"Tsaknaki","locid":"805cae2a-3462-4130-88de-cc7d94aec0a5","name":"Tsaknaki, Vasiliki","orcid":"0000-0003-2235-6078","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Stina Marie Hasse","key":"jørgensenpau","last":"Jørgensen","name":"Jørgensen, Stina Marie Hasse","rank":3,"rolecode":"pau"}],"pub":{"publisher":"Design Research Society","status":"p","title":"Nordic Design Research Conference"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["itu-36f98c62-1269-42c1-bc20-0df2bc889ef5"],"src":["ITU IT University of Copenhagen"],"title":"Imagining a Soft and Relational Smart Home","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-828145","year":"2025","yearsub":"2025"}
{"abstract":"This paper explores how participatory design methods can engage future farmers in imagining sustainable agricultural futures in Denmark. Denmark's agricultural sector faces a \"crisis of imagination\" where dominant paradigms in farming are hard to challenge. Building on Ingold's notion of the landscape as a relational, temporal space for dwelling, we propose a conceptualization of the landscape game that enables farming students to articulate their visions of future farming. The design game creates opportunities for participants to situate their imagined farms within broader social, environmental, and technical contexts while exploring how these might evolve over time. This approach aims to generate new agricultural imaginaries that move beyond current techno-solutionist or radical transformation narratives, while supporting an underrepresented political public in developing their own perspective on contested agricultural futures that are both speculative and grounded in lived experience.","author_count":2,"contributors":["Padalak, Martin Abildgaard","Jenkins, Tom"],"cuid":["S01-000.00-828153"],"event":{"acronym":"Nordes","title":"Nordic Design Research Conference"},"filters":{"added":"2025-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Agriculture","Design Games","Farming","Futuring","Landscape"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"re imagining the landscape of future farming","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.21606/nordes.2025.26","version":"Published Version"},"id":"S01-000.00-828153","ids":["itu-5905bdb8-26cc-4b0e-a5f8-d436c0243fb9"],"keyword":["Agriculture","Design games","Farming","Futuring","Landscape"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-47CDD481D8D9CB08F892C1277BB571EC"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.21606/nordes.2025.26","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://pure.itu.dk/ws/files/112678574/Re-Imagining_the_Landscape_of_Future_Farming.pdf","version":"Other Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Climate IT","IT University of Copenhagen, Human-Computer Interaction and Design","IT University of Copenhagen, Human-Computer Interaction and Design, IxD Lab"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Martin Abildgaard","key":"padalakpau","last":"Padalak","locid":"17ebd58d-ffad-4a6f-923d-a0118d0056b0","name":"Padalak, Martin Abildgaard","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Tom","key":"jenkinspau","last":"Jenkins","locid":"3ad26d6b-4619-4a9f-a1b6-8424aab1dd52","name":"Jenkins, Tom","orcid":"0000-0001-6135-410X","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.21606/nordes.2025.26","publisher":"Design Research Society","status":"p","title":"Nordic Design Conference"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-5905bdb8-26cc-4b0e-a5f8-d436c0243fb9"],"src":["ITU IT University of Copenhagen"],"title":"Re-Imagining the Landscape of Future Farming","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-828153","year":"2025","yearsub":"2025"}
{"abstract":"This workshop focuses on the temporal dimensions of Research through Design (RtD) in Human-Computer Interaction. Building on the success of previous objects of design workshops at CHI, it explores how time impacts the creation, evolution, and deployment of design artifacts. Participants will discuss long-term and uncon- ventional deployments, addressing methodological, ethical, and organizational challenges. Through hands-on, studio-style critique and collaborative sessions, the workshop aims to generate insights into how temporal aspects of design contribute to knowledge pro- duction. The event will also initiate long-term design deployments, with findings to be reported at a follow-up workshop in 2026, mark- ing the 10th anniversary of this series.","author_count":11,"contributors":["Berger, Arne","Hildebrandt, Stephan","Kurze, Albrecht","Odom, William","Jenkins, Tom","Pierce, James","Chatting, David","Oogjes, Doenja","Nabil, Sara","Boucher, Andy","Gaver, William"],"cuid":["S01-000.00-828159"],"event":{"acronym":"CHI","end":"2015-04-23","place":"Seoul, kr","start":"2015-04-18","title":"CHI 2015: Crossings","year":"2015"},"filters":{"added":"2025-10","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Europe, EU","Europe, Non-EU","OECD"],"country":["Canada","Germany","Netherlands","United Kingdom","United States"],"glorg":["All Global Affiliations","Anhalt University of Applied Sciences","Chemnitz University of Technology","Eindhoven University of Technology","Newcastle University","Northumbria University","Queen’s University","Simon Fraser University","University of Washington"],"keyword":["Context","Design Things","ISSUES","Material","Objects","Research through Design","practice based design"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["cl