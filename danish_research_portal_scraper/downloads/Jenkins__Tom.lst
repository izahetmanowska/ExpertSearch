{"abstract":"This one-day workshop will explore fabulations in design research. Bringing together design researchers and practitioners in hands-on exploration and critical dialogue, we will explore emerging practices and potentials of using fabulations in futures-oriented and exploratory practice-based design research. Drawing on fabulations’ relations with feminist technoscience and more-than-human concerns, we seek to understand if and how the practice of fabulating can contribute to designing vibrant worlds that can flourish in new ways.","author_count":9,"contributors":["Jenkins, Tom","Juul Søndergaard, Marie Louise","Sanches, Pedro","Tsaknaki, Vasiliki","Campo Woytuk, Nadia","Howell, Noura","Helms, Karey","Boer, Laurens","Tucker, Jason"],"cuid":["S01-000.00-718887"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","Europe, EU","Europe, Non-EU","Nordic","OECD"],"country":["Norway","Sweden","United States"],"glorg":["AHO The Oslo School of Architecture and Design, Norway","All Global Affiliations","Georgia Institute of Technology","KTH Royal Institute of Technology","Malmö University","Umeå University"],"keyword":["Design research","Fabulations","Feminist Technoscience","More than Human Concerns","Practice Based Research"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"fabulating futures for flourishing and vibrant worlds","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-SA","type":"loc","url":"https://pure.itu.dk/ws/files/100699342/177_submission.pdf","version":"Authors Final Version"},"id":"S01-000.00-718887","ids":["itu-8c307203-7f4e-4edc-8514-f3cf70b8c2cd"],"keyword":["Design Research","Fabulations","Feminist Technoscience","More-than-Human Concerns","Practice-based Research"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-BF7D4A13C4B1615C441B35456274B19B"],"oa_link":[{"access":"oa","license":"CC BY-SA","type":"loc","url":"https://pure.itu.dk/ws/files/100699342/177_submission.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Climate IT","IT University of Copenhagen, Center for Digital Welfare","IT University of Copenhagen, Digital Design","IT University of Copenhagen, Digital Design, Design Research Section","IT University of Copenhagen, Human-Computer Interaction and Design, Interaction Design Research Group","IT University of Copenhagen, Human-Computer Interaction and Design, IxD Lab"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"no","key":"aho the oslo school of architecture and design norway","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"AHO The Oslo School of Architecture and Design, Norway","used":1},{"affno":"3","country":"se","key":"umeå university","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Umeå University","used":1},{"affno":"4","country":"se","key":"kth royal institute of technology","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"KTH Royal Institute of Technology","used":1},{"affno":"5","country":"us","key":"georgia institute of technology","loc":["United States","America, North","OECD"],"name":"Georgia Institute of Technology","used":1},{"affno":"6","country":"se","key":"malmö university","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Malmö University","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Tom","key":"jenkinspau","last":"Jenkins","locid":"3ad26d6b-4619-4a9f-a1b6-84