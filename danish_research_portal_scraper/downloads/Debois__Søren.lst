"affno":"","first":"Barbara","key":"weberpedh","last":"Weber","name":"Weber, Barbara","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-030-94343-1_28","isbn":["9783030943424"],"issn":["18651348"],"pages":"362-374","publisher":"Springer","series":"Lecture Notes in Business Information Processing","status":"p","subtitle":"BPM 2021 International Workshops Rome, Italy, September 6–10, 2021 Revised Selected Papers","title":"Business Process Management Workshops - BPM 2021 International Workshops, Revised Selected Papers"},"review":"Peer Reviewed","scoID":["2-s2.0-85124662656"],"search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Other Companies","Private Research","Universities","University of Copenhagen","dcr solutions a/s"],"PST":["Published"]},"sid":["ku-826bc9eb-f60b-474b-abbe-92533edea43b"],"src":["KU University of Copenhagen"],"title":"Decision Modelling in Timed Dynamic Condition Response Graphs with Data","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-471470","year":"2022","yearsub":"2022"}
{"abstract":"Contemporary process discovery methods take as inputs only positive examples of process executions, and so they are one-class classification algorithms. However, we have found negative examples to also be available in industry, hence we propose to treat process discovery as a binary classification problem. This approach opens the door to many well-established methods and metrics from machine learning, in particular to improve the distinction between what should and should not be allowed by the output model. Concretely, we (1) present a formalisation of process discovery as a binary classification problem; (2) provide cases with negative examples from industry, including real-life logs; (3) propose the Rejection Miner binary classification procedure, applicable to any process notation that has a suitable syntactic composition operator; and (4) apply this miner to the real world logs obtained from our industry partner, showing increased output model quality in terms of accuracy and model size.","author_count":7,"contributors":["Slaats, Tijs","Debois, Søren","Back, Christoffer Olling"],"cuid":["S01-000.00-428867"],"event":{"acronym":"BPM","end":"2021-09-10","place":"Rome, it","start":"2021-09-06","title":"19th International Conference on Business Process Management, BPM 2021","year":"2021"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Binary classification","Labelled event logs","Negative examples","Process mining"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-ITU","DI-U-KU"]},"level3all":["DI-PR-OTH","DI-U-ITU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"weighing the pros and cons process discovery with negative examples","src":["ku"],"src-code":["DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"id":"S01-000.00-428867","identifier":[{"id":"85115196600","type":"scopus"}],"ids":["ku-3b5c696a-9950-4dca-970c-20b46ce16551"],"keyword":["Binary classification","Labelled event logs","Negative examples","Process mining"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-097963594A4461E73D6856D8D76648A1"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Software, Data, People & Society"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen"],"nora_code":"DI-U-ITU","used":1},{"affno":"3","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["DCR Solutions A/S"],"nora_code":"DI-PR-OTH","used":1}],"person":[{"affno":"1","first":"Tijs","key":"slaatspau","last":"Slaats","locid":"85f00008-e9c6-439c-aae5-e5bd725f2099","name":"Slaats, Tijs","orcid":"0000-0001-6244-6970","rank":1,"rolecode":"pau"},{"affno":"2 3","first":"Søren","key":"deboispau","last":"Debois","name":"Debois, Søren","rank":2,"rolecode":"pau"},{"affno":"1","first":"Christoffer Olling","key":"backpau","last":"Back","locid":"0ce144c3-eaf9-43e2-8f2b-03d6e4212b6a","name":"Back, Christoffer Olling","orcid":"0000-0001-7998-7167","rank":3,"rolecode":"pau"},{"affn