h Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-19e78cfa-5a4f-4427-9694-e5c8e0fd4f20"],"src":["KU University of Copenhagen"],"title":"Distributed and Adversarial Resistant Workflow Execution on the Algorand Blockchain","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-747551","year":"2023","yearsub":"2023"}
{"abstract":"In this paper, we report the results of an exploratory study into the efficacy of noise filtering in improving the accuracy of declarative process mining. We apply the double-granularity mixed-dependency filtering algorithm as introduced by [9], to the DisCoveR declarative miner [1], and parameter optimise it to only perform coarse-grained filtering. However, while noise filtering appears promising on the surface, one might worry that the outlier behaviour allowed by declarative models may be wrongly classified as noise and removed. To test the efficacy of noise filtering from both perspectives, we applied DisCoveR with noise filtering to two data sets: the process log collection used in the PDC2020 process discovery contest, emulating “real-world” scenarios; and a synthetic set of logs known to exhibit (non-noise) outlier behaviour. We find that on the contest data sets, noise filtering significantly increases accuracy (on average 23% points), obtaining exploratory evidence that noise filtering may improve declarative miner performance; on the synthetic logs we showcase examples where noise is filtered, while outlier behaviour remains untouched.","author_count":6,"contributors":["Christfort, Axel Kjeld Fjelrad","Debois, Søren","Slaats, Tijs"],"cuid":["S01-000.00-541514"],"event":{"end":"2022-09-16","place":"Münster, de","start":"2022-09-11","title":"Workshops on AI4BPM, BP-Meet-IoT, BPI, BPM and RD, BPMS2, BPO, DEC2H, and NLP4BPM 2022, co-located with the 20th International Conference on Business Process Management, BPM 2022","year":"2022"},"filters":{"added":"2023-05","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["DCR Graphs","Declarative process models","Noise filtering","Process discovery"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-ITU","DI-U-KU"]},"level3all":["DI-PR-OTH","DI-U-ITU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"improving declarative process mining with a priori noise filtering","src":["ku"],"src-code":["DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://curis.ku.dk/ws/files/410854203/Improving_declarative_process_mining_with_a.pdf","version":"Pre-print"},"id":"S01-000.00-541514","identifier":[{"id":"85151064083","type":"scopus"}],"ids":["ku-f8091cd0-0257-495c-afd9-f0f9d9d757a4"],"keyword":["DCR Graphs","Declarative process models","Noise filtering","Process discovery"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-FB5453671F77AB86DC482F6628247DF7"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://curis.ku.dk/ws/files/410854203/Improving_declarative_process_mining_with_a.pdf","version":"Pre-print"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Software, Data, People & Society"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen"],"nora_code":"DI-U-ITU","used":1},{"affno":"3","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["DCR Solutions A/S"],"nora_code":"DI-PR-OTH","used":1}],"person":[{"affno":"1","first":"Axel Kjeld Fjelrad","key":"christfortpau","last":"Christfort","locid":"93296adf-650b-45c5-99fe-13923420b0f5","name":"Christfort, Axel Kjeld Fjelrad","rank":1,"rolecode":"pau"},{"affno":"2 3","first":"Søren","key":"deboispau","last":"Debois","name":"Debois, Søren","rank":2,"rolecode":"pau"},{"affno":"1","first":"Tijs","key":"slaatspau","last":"Slaats","locid":"85f00008-e9c6-439c-aae5-e5bd725f2099","name":"Slaats, Tijs","orcid":"0000-0001-6244-6970","rank":3,"rolecode":"pau"},{"affno":"","first":"Cristina","key":"cabanillaspedh","last":"Cabanillas","name":"Cabanillas, Cristina","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Niels Frederik","key":"garmannjohnsenpedh","last":"Garmann-Johnsen","name":"Garmann-Johnsen, Niels Frederik","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Agnes","key":"koschmiderpedh","last":"Koschmider","name":"Koschmider, Agnes","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-031-25383-6_21","isbn":["9783031253829"],"issn":["18651348"],"pages":"286-297","publisher":"Springer","series":"Lecture Notes in Business Information Processing","status":"p","title":"Business Process Management Workshops - BPM 2022 International Workshops, Revised Selected Papers"},"review":"Peer Reviewed","scoID":["2-s2.0-85151064083"],"search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Other Companies","Private Research","Universities","University of Copenhagen","dcr solutions a/s"],"PST":["Published"]},"sid":["ku-f8091cd0-0257-495c-afd9-f0f9d9d757a4"],"src":["KU University of Copenhagen"],"title":"Improving Declarative Process Mining with a Priori Noise Filtering","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-541514","year":"2023","yearsub":"2023"}
{"abstract":"We present a game-theoretic approach to analyzing the incentive structure in formal models of inter-organizational businesses processes. In such processes, the choices of each participants influence the outcome of others. A potential participant may be torn between the prospect of a highly preferable outcome on the one hand (e.g., a bonus on timely delivery), and the possibility that another player may make a choice (e.g., reallocation of the fast trucks) which renders that outcome impossible to achieve. We propose (a) an analysis which given the preferences of participants determines if the collaboration is at all meaningful; (b) an algorithm for modifying the incentive structure of such a process using both fines and outcome re-distribution to increase the benefit for all participants; and (c) a practical way of computing this algorithm while concealing the preferences of the collaborators for each other using secure multi-party computation.","author_count":5,"contributors":["Haagensen, Frederik","Debois, Søren"],"cuid":["S01-000.00-818232"],"filters":{"added":"2025-08","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Game theory","Incentive design","Mechanism design","Secure Multi party Computation"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"incentive alignment through secure computations","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85138778674","version":"Other Version"},"id":"S01-000.00-818232","identifier":[{"id":"85138778674","type":"scopus"}],"ids":["itu-0931c2fc-e8d3-48d1-af65-e7433aca2b38"],"keyword":["game theory","incentive design","inter-organizational processes","mechanism design","secure multi-party computation"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-32EF0DFF021C264F17D02A216EDF0A52"],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Theoretical Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Frederik","key":"haagensenpau","last":"Haagensen","locid":"672280b6-17c9-4191-9b00-8f1322fc1d90","name":"Haagensen, Frederik","orcid":"0000-0002-4161-4442","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren","key":"deboispau","last":"Debois","name":"Debois, Søren","rank":2,"rolecode":"pau"},{"affno":"","first":"Claudio Di Ciccio","key":"remcopedh","last":"Remco","name":"Remco, Claudio Di Ciccio","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Dijkman","key":"adeladelríoortegapedh","last":"Adela del Río Ortega","name":"Adela del Río Ortega, Dijkman","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Stefanie","key":"rinderlemapedh","last":"Rinderle-Ma","name":"Rinderle-Ma, Stefanie","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-031-16103-2_23","edition":"1","eisbn":["9783031161032"],"isbn":["9783031161025"],"issn":["03029743"],"pages":"343-360","publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","subtitle":"20th International Conference, BPM 2022, Münster, Germany, September 11–16, 2022, Proceedings","title":"Business Process Management","volume":"20"},"review":"Peer Reviewed","scoID":["2-s2.0-85138778674"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-0931c2fc-e8d3-48d1-af65-e7433aca2b38"],"src":["ITU IT University of Copenhagen"],"title":"Incentive Alignment Through Secure Computations","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-818232","year":"2022","yearsub":"2022"}
{"abstract":"We provide a practical translation from the Dynamic Condition Response (DCR) process modelling language to the Transaction Execution Approval Language (TEAL) used by the Algorand blockchain. Compared to earlier implementations of business process notations on blockchains, particularly Ethereum, the present implementation is four orders of magnitude cheaper. This translation has the following immediate ramifications: (1) It allows decentralised execution of DCR-specified business processes in the absence of expensive intermediaries (lawyers, brokers) or counterparty risk. (2) It provides a possibly helpful high-level language for implementing business processes on Algorand. (3) It demonstrates that despite the strict limitations on Algorand smart contracts, they are powerful enough to encode models of a modern process notation.","author_count":5,"contributors":["Xu, Yibin","Slaats, Tijs","Düdder, Boris","Debois, Søren","Wu, Haiqin"],"cuid":["S01-000.00-535167"],"filters":{"added":"2022-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["Switzerland"],"glorg":["All Global Affiliations","Unknown external organisation"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-KU"]},"level3all":["DI-U-ITU","DI-U-KU"]},"review":"nr","rtype":["clu"],"sorti":"distributed and adversarial resistant workflow execution on the algorand blockchain","src":["ku"],"src-code":["DI-U-KU"],"type":"dw","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.48550/ARXIV.2211.08695","version":"Published Version"},"id":"S01-000.00-535167","ids":["ku-ed710238-f819-40ac-8d4a-3fc058e5035b"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-6710D0233A5755EAF9CF56115271AE6F"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"h