sson","name":"Johansson, Björn","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"issn":["16130073"],"publisher":"CEUR-WS.org","series":"CEUR Workshop Proceedings","status":"p","subtitle":"pre-BIR Forum, BIR Workshops and Doctoral Consortium 2017","title":"BIR-WS 2017"},"review":"Peer Reviewed","scoID":["2-s2.0-85029151827"],"search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Other Companies","Private Research","Universities","University of Copenhagen","exformatics a/s (biz)"],"PST":["Published"]},"sid":["ku-f2d1916d-b859-448b-88bf-a42479ea0a09"],"src":["KU University of Copenhagen"],"title":"Managing complexity in process digitalisation with dynamic condition response graphs","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-538354","year":"2017","yearsub":"2017"}
{"abstract":"Digitalisation of work and business processes with the aim to provide more efficient services at a higher and consistent quality is high on the agendas in many countries. In Denmark the push for digitalisation is witnessed by the national strategy for digitalisation published every four years. Sadly, it is also witnessed by a number of expensive failed digitalisation projects. In this paper we point to two key problems in state-of-the art BPM technologies: 1) the use of rigid flow diagrams as the “source code” of process digitalisation is not suitable for managing the complexity of knowledge workflows and regulations and 2) insufficient support for continuous and agile end-user mapping and adaptation of processes. We report on research in progress on how the Dynamic Condition Response (DCR) Graph technology and collaborative process repository DCRGraphs.net could support agile and collaborative, bottom-up digitalisation of business and workflow processes.","author_count":4,"contributors":["Hildebrandt, Thomas","Debois, Søren","Slaats, Tijs","Marquard, Morten"],"cuid":["S01-000.00-381929"],"event":{"end":"2017-08-28","place":"Copenhagen, dk","start":"2017-08-28","title":"2nd Workshop on Managed Complexity","year":"2017"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Agile Process Adaptation","Business Process Management BPM","DCR Graph technology","Digitalisation","Workflow Management"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-KU"]},"level3all":["DI-U-ITU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"managing complexity in process digitalisation with dynamic condition response graphs","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC0","type":"loc","url":"https://pure.itu.dk/ws/files/83025285/paper16.pdf"