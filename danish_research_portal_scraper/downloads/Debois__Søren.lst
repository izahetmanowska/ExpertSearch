a","name":"Back, Christoffer Olling","orcid":"0000-0001-7998-7167","rank":1,"rolecode":"pau"},{"affno":"","first":"Søren","key":"deboispau","last":"Debois","name":"Debois, Søren","rank":2,"rolecode":"pau"},{"affno":"1","first":"Tijs","key":"slaatspau","last":"Slaats","locid":"85f00008-e9c6-439c-aae5-e5bd725f2099","name":"Slaats, Tijs","orcid":"0000-0001-6244-6970","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1007/978-3-030-01391-2_24","eisbn":["9783030013912"],"isbn":["9783030013905"],"issn":["03029743"],"pages":"191-198","publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","subtitle":"ER 2018 Workshops Emp-ER, MoBiD, MREBA, QMMQ, SCME Xi’an, China, October 22–25, 2018 Proceedings","title":"Advances in Conceptual Modelling"},"review":"Peer Reviewed","scoID":["2-s2.0-85055432741"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-84dc6d9d-e7cf-4514-bd7f-fab094c05766"],"src":["KU University of Copenhagen"],"title":"Towards an Empirical Evaluation of Imperative and Declarative Process Mining","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-472960","year":"2018","yearsub":"2018"}
{"abstract":"We study distributed declarative workflow execution in an adversarial setting. In this setting, parties to an agreed-upon workflow do not trust each other to follow that workflow, or suspect the other party might misrepresent proceedings at a later time. We demonstrate how distributed declarative workflow execution can be implemented as smart contracts, guaranteeing (I) enforcement of workflow semantics, and (II) an incontrovertible record of workflow execution history. Crucially, we achieve both properties without relying on a trusted third party. The implementation itself is based on the Ethereum blockchain, inheriting the security properties (I) and (II) from the guarantees afforded by that chain. A recurring challenge for both the implementation and the analysis is the cost of operations on Ethereum: This cost must be minimised for honest parties, and an attacker should not be able to inflict extra cost on others.","author_count":6,"contributors":["Madsen, Mads Frederik","Gaub, Mikkel","Høgnason, Tróndur","Kirkbro, Malthe Ettrup","Slaats, Tijs","Debois, Søren"],"cuid":["S02-081.82-038309"],"event":{"end":"2018-03-09","place":"Los Angeles, us","start":"2018-03-09","title":"2018 Symposium on Foundations and Applications of Blockchain","year":"2018"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Blockchain Security","Declarative Workflow","Distributed systems","Ethereum","Smart contracts"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-KU"]},"level3all":["DI-U-ITU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"collaboration among adversaries distributed workflow execution on a blockchain","src":["itu","ku"],"src-code":["DI-U-ITU","DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/194806456/fab18_submission_06.pdf","version":"Published Version"},"id":"S02-081.82-038309","ids":["itu-5ef1087c-d104-4eb9-838b-1a0c195b3bde","ku-2c3073b0-405d-4495-a8b1-da03849524b2"],"keyword":["Blockchain Security","Declarative Workflow","Distributed Systems","Ethereum","Smart Contracts"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-2-CEB73230D2BE1C90EC80F9AE7A5E0FE4"],"oa_link":[{"access":"oa","license":"CC BY","type":"rem","url":"https://scfab.github.io/2018/assets/papers/fab18_submission_06.pdf","version":"Other Version"},{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/194806456/fab18_submission_06.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Department of Computer Science","Københavns Universitet, Faculty of Science, Department of Computer Science, Human-Centered Computing Section"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Mads Frederik","key":"madsenpau","last":"Madsen","name":"Madsen, Mads Frederik","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Mikkel","key":"gaubpau","last":"Gaub","name":"Gaub, Mikkel","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Malthe Ettrup","key":"kirkbropau","last":"Kirkbro","name":"Kirkbro, Malthe Ettrup","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Tróndur","key":"høgnasonpau","last":"Høgnason","name":"Høgnason, Tróndur","rank":4,"rolecode":"pau"},{"affno":"2","first":"Tijs","key":"slaatspau","last":"Slaats","locid":"85f00008-e9c6-439c-aae5-e5bd725f2099","name":"Slaats, Tijs","orcid":"0000-0001-6244-6970","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren","key":"deboispau","last":"Debois","name":"Debois, Søren","rank":6,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["itu-5ef1087c-d104-4eb9-838b-1a0c195b3bde","ku-2c3073b0-405d-4495-a8b1-da03849524b2"],"src":["ITU IT University of Copenhagen","KU University of Copenhagen"],"title":"Collaboration among Adversaries : Distributed Workflow Execution on a Blockchain","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-081.82-038309","year":"2018","yearsub":"2018"}
{"abstract":"Process mining algorithms can be partitioned by the type of model that they output: imperative miners output flow-diagrams showing all possible paths through a process, whereas declarative miners output constraints showing the rules governing a process. For processes with great variability, the latter approach tends to provide better results, because using an imperative miner would lead to so-called “spaghetti models” which attempt to show all possible paths and are impossible to read. However, studies have shown that one size does not fit all: many processes contain both structured and unstructured parts and therefore do not fit strictly in one category or the other. This has led to the recent introduction of hybrid miners, which aim to combine flow- and constraint-based models to provide the best possible representation of a log. In this paper we focus on a core question underlying the development of hybrid miners: given a log, can we determine a priori whether the log is best suited for imperative or declarative mining? We propose using the concept of entropy, commonly used in information theory. We consider different measures for entropy that could be applied and show through experimentation on both synthetic and real-life logs that these entropy measures do indeed give insights into the complexity of the log and can act as an indicator of which mining paradigm should be used.","author_count":3,"contributors":["Back, Christoffer Olling","Debois, Søren","Slaats, Tijs"],"cuid":["S01-000.00-382091"],"event":{"acronym":"BPM","title":"International Conference on Business Process Management"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Declarative Miner","Entropy Analysis","Hybrid Miner","Imperative Miner","Process mining"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-KU"]},"level3all":["DI-U-ITU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"towards an entropy based analysis of log variability","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82476919/main.pdf","version":"Authors Final Version"},"id":"S01-000.00-382091","identifier":[{"id":"85041716336","type":"scopus"}],"ids":["itu-378bb997-96cb-4be8-938b-3deb9eacb4cd"],"keyword":["Declarative Miner","Entropy Analysis","Hybrid Miner","Imperative Miner","Process Mining"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-3-5-4A7658B8C053CF09D97A0D17B022CCA6"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82476919/main.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Christoffer Olling","key":"backpau","last":"Back","name":"Back, Christoffer Olling","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren","key":"deboispau","last":"Debois","name":"Debois, Søren","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Tijs","key":"slaatspau","last":"Slaats","name":"Slaats, Tijs","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1007/978-3-319-74030-0_4","eisbn":["9783319740300"],"isbn":["9783319740294"],"issn":["18651348"],"pages":"53-70","publisher":"Springer","series":"Lecture Notes in Business Information Processing","status":"p","subtitle":"BPM 2017: Business Process Management Workshops","title":"International Conference on Business Process Management"},"review":"Peer Reviewed","scoID":["2-s2.0-85041716336"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["itu-378bb997-96cb-4be8-938b-3deb9eacb4cd"],"src":["ITU IT University of Copenhagen"],"title":"Towards an Entropy-based Analysis of Log Variability","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382091","year":"2018","yearsub":"2018"}
{"abstract":"Enterprise computing applications generally consists of several inter-related business processes linked together via shared data objects and events. We address the open challenge of providing formal modelling and implementation techniques for such enterprise computing applications, introducing the declarative, data-centric and event-driven process language RESEDA for REactive SEmi-structured DAta. The language is inspired by the computational model of spreadsheets and recent advances in declarative business process modelling notations. The key idea is to associate either input events or reactive computation events to the individual elements of semi-structured data and declare reactive behaviour as explicit reaction rules and constraints between these events. Moreover, RESEDA comes with a formal operational semantics given as rewrite rules supporting both formal analysis and persistent execution of the application as sequences of rewrites of the data. The data, along with the set of constraints, thereby at the same time constitutes the specification of the data, its behaviour and the run-time execution component. This key contribution of the paper is to introduce the RESEDA language, its formal execution semantics and give a sufficient condition for liveness of programs. We also establish Turing-equivalence of the language independently of the choice of underlying data expressions and exemplify the use of RESEDA by a running example of an online store. A prototype implementation of RESEDA and the examples of the paper are available on-line at http://dcr.tools/reseda.","author_count":5,"contributors":["Costa Seco, Joao","Debois, Soren","Hildebrandt, Thomas T.","Slaats, Tijs"],"cuid":["S02-093.42-038320"],"event":{"acronym":"EDOC","end":"2018-10-19","place":"Stockholm, se","start":"2018-10-16","title":"22nd IEEE International Enterprise Distributed Object Computing Conference, EDOC 2018","year":"2018"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Data Centric Systems","Declarative Process Modelling","Enterprise Computing","Event Driven Architecture","Formal Operational Semantics"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-KU"]},"level3all":["DI-U-ITU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"reseda declaring live event driven computations as reactive semi structured data","src":["itu","ku"],"src-code":["DI-U-ITU","DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83725104/preprint_reseda.pdf","version":"Authors Final Version"},"id":"S02-093.42-038320","identifier":[{"id":"85059070899","type":"scopus"}],"ids":["itu-70171fa5-b057-411e-a63c-46185ecc9c90","ku-9dc7884b-f9a4-4a45-8af1-9810c8789435"],"keyword":["Data-Centric Systems","Declarative Process Modelling","Enterprise Computing","Event-Driven Architecture","Formal Operational Semantics","declarative, event-driven computations, semi structured data, liveness, enterprise applications, business processes"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-344C0267D2F4817CC7C62DE4D3D4BC93"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83725104/preprint_reseda.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["The Department, Theoretical Computer Science"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Human-Centered Computing Section","Københavns Universitet, Faculty of Science, Department of Computer Science, Software, Data, People & Society"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"João Costa","key":"secopau","last":"Seco","name":"Seco, João Costa","rank":1,"rolecode":"pau"},{"affno":"","first":"Joao","key":"costasecopau","last":"Costa Seco","name":"Costa Seco, Joao","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren","key":"deboispau","last":"Debois","name":"Debois, Søren","rank":2,"rolecode":"pau"},{"affno":"2","first":"Thomas","key":"hildebrandtpau","last":"Hildebrandt","locid":"c1d69914-5f7a-4f0b-8ffb-766693004328","name":"Hildebrandt, Thomas T.","name_org":"Hildebrandt, Thomas","orcid":"0000-0002-7435-5563","rank":3,"rolecode":"pau"},{"affno":"2","first":"Tijs","key":"slaatspau","last":"Slaats","locid":"85f00008-e9c6-439c-aae5-e5bd725f2099","name":"Slaats, Tijs","orcid":"0000-0001-6244-6970","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1109/edoc.2018.00020","eisbn":["9781538641392"],"isbn":["9781538641408"],"pages":"75-84","publisher":"IEEE","status":"p","title":"2018 IEEE 22nd International Enterprise Distributed Object Computing Conference (EDOC)"},"review":"Peer Reviewed","scoID":["2-s2.0-85059070899"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["itu-70171fa5-b057-411e-a63c-46185ecc9c90","ku-9dc7884b-f9a4-4a45-8af1-9810c8789435"],"src":["ITU IT University of Copenhagen","KU University of Copenhagen"],"title":"RESEDA: Declaring Live Event-Driven Computations as REactive SEmi-Structured DAta","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-093.42-038320","year":"2018","yearsub":"2018"}
{"abstract":"The adoption of formal models by process specialists has faced two challenges: First, it requires process specialists to get training in formal modeling. Second, the resulting specifications bear little resemblance wrt. the original descriptions. We introduce a tool that supports translations between natural language descriptions and declarative process models. The resulting models are given in a graphical formalism, DCR Graphs. Traceability is at the core of the tool: Later changes in the process model due to, e.g., ambiguity resolution are traced back into the text. This allows users to either correct and complete their descriptions, or to derive models more refined than the text. In this paper, we describe the mechanics of the tool and provide examples of its use. Finally, we report on experiences using the tool in a Danish Municipal government.","author_count":9,"contributors":["Strømsted, Rasmus","López-Acosta, Hugo-Andrés","Debois, Søren","Marquard, Morten"],"cuid":["S01-000.00-381799"],"event":{"acronym":"BPM","title":"International Conference on Business Process Management"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["DCR","Declarative Process Model","Dynamic Condition Response","FORMS","process execution"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["DCR Solutions"],"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"dynamic evaluation forms using declarative modeling","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.itu.dk/ws/files/83665601/BPM_2018_paper_34.pdf","version":"Published Version"},"id":"S01-000.00-381799","identifier":[{"id":"85053626872","type":"scopus"}],"ids":["itu-239bb72a-04b3-45fa-aa9a-44f42969e58a"],"keyword":["DCR","Dynamic Condition Response","declarative process model","forms","process execution"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-8288AF14BE32D09B5E6D18B9816C6A45"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.itu.dk/ws/files/83665601/BPM_2018_paper_34.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"rem","url":"http://ceur-ws.org/Vol-2196/BPM_2018_paper_34.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Theoretical Computer Science, Programming Logic and Semantics"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["DCR Solutions"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"","corresponding":null,"first":"Rasmus","key":"strømstedpau","last":"Strømsted","name":"Strømsted, Rasmus","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hugo-Andrés","key":"lópezacostapau","last":"López-Acosta","name":"López-Acosta, Hugo-Andrés","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren","key":"deboispau","last":"Debois","name":"Debois, Søren","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Morten","key":"marquardpau","last":"Marquard","name":"Marquard, Morten","rank":4,"rolecode":"pau"},{"affno":"","first":"Barbara","key":"weberpedh","last":"Weber","name":"We