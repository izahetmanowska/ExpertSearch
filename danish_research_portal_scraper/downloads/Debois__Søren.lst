r Computing Machinery","status":"p","title":"Proceedings of International Conference on Software and Systems Process"},"review":"Peer Reviewed","scoID":["2-s2.0-85092529434"],"search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Private Research","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Miscellaneous","Other Companies","Other Research","Private Research","Technical University of Denmark","Universities","University of Copenhagen","dcr solutions a/s"],"PST":["Published"]},"sid":["dtu-cbaff1f9-829a-401c-88d1-79d34ba67628","ku-a11fcd9c-9dcc-4916-a4a7-2e012140fa90"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"EcoKnow: Engineering Effective, Co-created and Compliant Adaptive Case Management Systems for Knowledge Workers","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-082.74-037184","year":"2020","yearsub":"2020"}
{"abstract":"Legal compliance is an important part of certifying the correct behaviour of a business process. To be compliant, organizations might hard-wire regulations into processes, limiting the discretion that workers have when choosing what activities should be executed in a case. Worse, hard-wired compliant processes are difficult to change when laws change, and this occurs very often. This paper proposes a model-driven approach to process compliance and combines a) reference models from laws, and b) business process models. Both reference and process models are expressed in a declarative process language, The Dynamic Condition Response (DCR) graphs. They are subject to testing and verification, allowing law practitioners to check consistency against the intent of the law. Compliance checking is a combination of alignments between events in laws and events in a process model. In this way, a reference model can be used to check different process variants. Moreover, changes in the reference model due to law changes do not necessarily invalidate existing processes, allowing their reuse and adaptation. We exemplify the framework via the alignment of laws and business rules and a real contract change management process, Finally, we show how compliance checking for declarative processes is decidable, and provide a polynomial time approximation that contrasts NP complexity algorithms used in compliance checking for imperative business processes. All-together, this paper presents technical and methodological steps that are being used by legal practitioners in municipal governments in their efforts towards digitalization of work practices in the public sector.","author_count":6,"contributors":["López-Acosta, Hugo-Andrés","Debois, Søren","Slaats, Tijs","Hildebrandt, Thomas T."],"cuid":["S01-000.00-485503"],"event":{"acronym":"FASE","end":"2020-04-30","place":"Dublin, ie","start":"2020-04-25","title":"23rd International Conference on Fundamental Approaches to Software Engineering, FASE 2020, held as part of the European Joint Conferences on Theory and Practice of Software, ETAPS 2020","year":"2020"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Compliance Checking","Dynamic Condition Response DCR Graphs","Process calculi","Refinement"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-KU"]},"level3all":["DI-U-ITU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"business process compliance using reference models of law","src":["ku"],"src-code":["DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1007/978-3-030-45234-6_19","version":"Published Version"},"id":"S01-000.00-485503","identifier":[{"id":"85084269255","type":"scopus"}],"ids":["ku-9a013104-132b-48bc-98a9-b6f866987885"],"keyword":["Compliance Checking","Dynamic Condition Response (DCR) graphs","Formal Models of Law","Process Calculi","Refinement"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-508146DC8664A7C10174398645103B26"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1007/978-3-030-45234-6_19","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/250607265/OA_Fundamental_Approaches.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Software, Data, People & Society"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","first":"Hugo A.","key":"lópezpau","last":"López","locid":"bb8c3de5-1755-46c4-a356-13eb16301a39","name":"López-Acosta, Hugo-Andrés","name_org":"López, Hugo A.","orcid":"0000-0001-5162-7936","rank":1,"rolecode":"pau"},{"affno":"2","first":"Søren","key":"deboispau","last":"Debois","name":"Debois, Søren","rank":2,"rolecode":"pau"},{"affno":"1","first":"Tijs","key":"slaatspau","last":"Slaats","locid":"85f00008-e9c6-439c-aae5-e5bd725f2099","name":"Slaats, Tijs","orcid":"0000-0001-6244-6970","rank":3,"rolecode":"pau"},{"affno":"1","first":"Thomas T.","key":"hildebrandtpau","last":"Hildebrandt","locid":"c1d69914-5f7a-4f0b-8ffb-766693004328","name":"Hildebrandt, Thomas T.","orcid":"0000-0002-7435-5563","rank":4,"rolecode":"pau"},{"affno":"","first":"Heike","key":"wehrheimpedh","last":"Wehrheim","name":"Wehrheim, Heike","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Jordi","key":"cabotpedh","last":"Cabot","name":"Cabot, Jordi","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-030-45234-6_19","eisbn":["9783030452346"],"issn":["03029743"],"pages":"378-399","publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","subtitle":"23rd International Conference, FASE 2020, Held as Part of the European Joint Conferences on Theory and Practice of Software, ETAPS 2020, Dublin, Ireland, April 25–30, 2020, Proceedings","title":"Fundamental Approaches to Software Engineering"},"review":"Peer Reviewed","scoID":["2-s2.0-85084269255"],"search":{"DAF":["All Danish Affiliation