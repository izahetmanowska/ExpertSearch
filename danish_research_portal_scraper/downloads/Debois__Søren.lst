:"2","country":"gb","key":"imperial college london","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Imperial College London","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Søren","key":"deboispau","last":"Debois","name":"Debois, Søren","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Thomas","key":"hildebrandtpau","last":"Hildebrandt","name":"Hildebrandt, Thomas","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Tijs","key":"slaatspau","last":"Slaats","name":"Slaats, Tijs","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Nobuko","key":"yoshidapau","last":"Yoshida","name":"Yoshida, Nobuko","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1007/978-3-662-43613-4_1","issn":["03029743","16113349"],"issn_org":["03029743"],"journal":"Lecture Notes in Computer Science","pages":"1-16","publisher":"Springer","status":"p","title":"Lecture Notes in Computer Science","volume":"8461"},"review":"Peer Reviewed","scoID":["2-s2.0-84902588526"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-f4f164b8-6878-4ccf-b5ee-5f512c0c4829"],"src":["ITU IT University of Copenhagen"],"title":"Type Checking Liveness for Collaborative Processes with Bounded and Unbounded Recursion","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384872","year":"2014","yearsub":"2014"}
{"abstract":"We present a new declarative model with composition and hierarchical definition of processes, featuring (a) incremental refinement, (b) adaptation of processes, and (c) dynamic creation of sub-processes. The approach is motivated and exemplified by a recent case management solution delivered by our industry partner Exformatics A/S. The approach is achieved by extending the Dynamic Condition Response (DCR) graph model with interfaces and composition along those interfaces. Both refinement and sub-processes are then constructed in terms of that composition. Sub-processes take the form of hierarchical (complex) events, which dynamically instantiate sub-processes. The extensions are realised and supported by a prototype simulation tool.","author_count":4,"contributors":["Debois, Søren","Hildebrandt, Thomas","Slaats, Tijs","Marquard, Morten"],"cuid":["S01-000.00-381979"],"event":{"acronym":"EDOC","title":"IEEE International Enterprise Distributed Object Computing Conference"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["DCR graph extension","composition and hierarchy","declarative model","dynamic sub process creation","process refinement"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Exformatics"],"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"a case for declarative process modelling agile development of a grant application system","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1109/EDOCW.2014.27","version":"Other Version"},"id":"S01-000.00-381979","identifier":[{"id":"84919772805","type":"scopus"}],"ids":["itu-305cc2ee-9ba8-4b79-b2ee-63432a62e09f"],"keyword":["DCR graph extension","composition and hierarchy","declarative model","dynamic sub-process creation","process refinement"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-BCC59BF2CC0BE5E48EE253BE48A5A611"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1109/EDOCW.2014.27","version":"Other Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","The Department, Theoretical Computer Science"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Exformatics"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Søren","key":"deboispau","last":"Debois","name":"Debois, Søren","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Thomas","key":"hildebrandtpau","last":"Hildebrandt","name":"Hildebrandt, Thomas","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Tijs","key":"slaatspau","last":"Slaats","name":"Slaats, Tijs","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Morten","key":"marquardpau","last":"Marquard","name":"Marquard, Morten","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1109/edocw.2014.27","eisbn":["9781479954704"],"pages":"126-133","publisher":"IEEE","status":"p","title":"Enterprise Distributed Object Computing Conference Workshops and Demonstrations (EDOCW), 2014 IEEE 18th International"},"review":"Peer Reviewed","scoID":["2-s2.0-84919772805"],"search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Miscellaneous","Other Rese