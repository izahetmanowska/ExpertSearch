:"wangcancanpau","last":"Wang","locid":"605b59ab-91b4-4f8e-bb12-df68ce0491c5","name":"Wang, Cancan","orcid":"0000-0002-9065-6884","rank":2,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"first":"Chunrong","key":"liuchunrongpau","last":"Liu","name":"Liu, Chunrong","rank":3,"rolecode":"pau"}],"pub":{"pages":"131-164","publisher":"FuDan University Press","status":"p","title":"丹麦创新与绿色发展蓝皮书"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-a6471db4-b125-41fb-b48d-d4bd9754f3bd"],"src":["ITU IT University of Copenhagen"],"title":"绿色王国 : 生态创新的丹麦样本","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383695","year":"2021","yearsub":"2021"}
{"abstract":"As increasingly diverse stakeholders engage in technology-mediated knowledge sharing, the establishment of appropriate forms of governance becomes a challenge. Existing research highlights that successful governance is a result of congruence between different stakeholders’ views and uses of technology, but the way suitable governance can emerge in the presence of incongruent or ambiguous framings of technology is still unclear. In this article, we present a case study of a collaboration between government, industry and university stakeholders, where the social media platform WeChat is used for knowledge sharing. Using the theoretical lens of the technological frames of reference (TFR), we investigate how views and uses of technology among different stakeholders shape the emergence of governance arrangements. We find that patterns of congruence and incongruence in the stakeholders’ framings of technology for knowledge sharing lead to emergent adaptive governance practices, which are characterized by selective participation, role and capability identification, and ad-hoc decision-making.","author_count":3,"contributors":["Wang, Cancan","Medaglia, Rony","Jensen, Tina Blegind"],"cuid":["S02-096.08-032242"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Adaptive governance","Inter organizational collaboration","Knowledge sharing","Social media","Technological frames of reference"],"level":"sci","mra":["sci","soc"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS","DI-U-ITU"]},"level3all":["DI-U-CBS","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"when ambiguity rules the emergence of adaptive governance from in congruent frames of knowledge sharing technology","src":["cbs","itu"],"src-code":["DI-U-CBS","DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://research-api.cbs.dk/ws/files/66868183/rony_medaglia_et_al_when_ambiguity_rules_acceptedmanuscript.pdf","version":"Authors Final Version"},"id":"S02-096.08-032242","identifier":[{"id":"85089755954","type":"scopus"},{"id":"000562337800001","type":"wos"}],"ids":["cbs-f6b2989c-8fac-438a-989f-7b67d25b4326","itu-3ba2f2bd-e4c8-40fe-a68a-0e40f77c5254"],"keyword":["Adaptive governance","Inter-organizational collaboration","Knowledge sharing","Social media","Technological frames of reference"],"lang":"English","level":"Scientific","mra":["Science/Technology","Social Science"],"noi":["Global-Local-2-5-20FC7229BF46062870C140A83A7CC5F6"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85310592/ISF_E_Print.pdf","version":"Authors Final Version"},{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://research-api.cbs.dk/ws/files/66868183/rony_medaglia_et_al_when_ambiguity_rules_acceptedmanuscript.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Social Science (SOC)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","IT University of Copenhagen, Center for Digital Welfare"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of Digitalization"],"nora_code":"DI-U-CBS","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Cancan","key":"wangpau","last":"Wang","locid":"605b