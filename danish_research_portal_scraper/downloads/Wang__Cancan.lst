coID":["2-s2.0-85173731134"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Hospitals","All Miscellaneous","All Private Research","All Universities","Capital Region of Denmark","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Miscellaneous","Novo Nordisk","Other Research","Private Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-92ad54d5-a2ad-408d-9ef1-3575296c0de7"],"src":["KU University of Copenhagen"],"title":"European and multi-ancestry genome-wide association meta-analysis of atopic dermatitis highlights importance of systemic immune regulation","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-702024","year":"2023","yearsub":"2023"}
{"abstract":"The accelerating development of open data infrastructure across the world brings economic and social promises but increasing complexities in coordinating large-scale open data ecosystem that involves citizens, communities, poli cy makers, institutions, and private actors. Following the formation of an open data ecosystem in Shanghai longitudinally (2015-2020), this paper delineates how adaptive governance is effective in addressing the initial void of data governance in the ecosystem, and the competing logics of data as a social resource over time. The case study highlights that adaptive governance in open data ecosystem undergoes continuous experimentations of governance form, which is largely shaped by the different views of data as a resource. Foregrounding the digital dimension of governance, this study also brings attention to the role of sociotechnical arrangements in shaping the form of adaptive governance by unfolding how actors in the ecosystem strategically use daily communication technologies as an experimental field for governance form.","author_count":1,"contributors":["Wang, Cancan"],"cuid":["S01-000.00-381735"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"keyword":["Adaptive governance","Data governance","Governance form","Governance via knowledge sharing technology","Open data"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"adaptive governance in open data ecosystem experiences and new insights","src":["itu"],"src-code":["DI-U-ITU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/96576734/Ch10_Wang_REV_CW_Final.pdf","version":"Pre-print"},"id":"S01-000.00-381735","ids":["itu-1f92fc2f-dd2a-4110-88c8-f49ae7f87c57"],"keyword":["Adaptive governance","Data governance","Governance form","Governance via knowledge sharing technology","Open data"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-470E1B0C05BA6FA0FA7159AE8542B93B"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/96576734/Ch10_Wang_REV_CW_Final.pdf","version":"Pre-print"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","IT University of Copenhagen, Center for Digital Welfare","IT University of Copenhagen, Digital Business Innovation, Information Systems and Digital Innovation"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Cancan","key":"wangpau","last":"Wang","locid":"605b59ab-91b4-4f8e-bb12-df68ce0491c5","name":"Wang, Cancan","orcid":"0000-0002-9065-6884","rank":1,"rolecode":"pau"}],"pub":{"doi":"10.4337/9781800888241.00021","eisbn":["9781800888241"],"isbn":["9781800888234"],"pages":"158-175","publisher":"Edward Elgar Publishing","status":"p","title":"Handbook of Adaptive Governance"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-1f92fc2f-dd2a-4110-88c8-f49ae7f87c57"],"src":["ITU IT University of Copenhagen"],"title":"Adaptive Governance in Open Data Ecosystem : Experiences and New Insights","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381735","year":"2023","yearsub":"2023"}
{"abstract":"Environmental, social, and governance (ESG) performance evaluation criteria have become increasingly important for Fintech as tools to assess a company’s ability to generate environmental and societal value. On the one hand, Fintech is well-positioned to take advantage of ESG in their business models. The application of digital technology to financial services generates a significant amount of financial data that can be both shared with and analysed by governments and investors to inform the development of ESG guidelines. On the other hand, Fintech businesses are also under compliance pressure to integrate ESG in their own financial reporting and operations, as well as to adapt to new performance assessment criteria. ESG becomes even more important as customers and investors in Fintech businesses pay increasing attention to ESG performance, and talent and founders focus more and more on being sustainability-conscious and impact-driven. This report provides an overview of the current ESG reporting status of Fintech businesses in Denmark and the European Union (EU). We focus on startups as they tend to be disproportionately burdened by compliance and investment pressure due to their limited resources. Our goal is to take a first step towards developing a collective ESG reporting model for Fintech startups that enhances their competitive advantage despite a volatile economic and regulatory environment. This report presents the current state of ESG reporting in the Danish Fintech sector as informed by wider international discussions within the sector. In it, we map out the five forces that shape the Fintech ESG landscape: 1) policy and regulatory authorities; 2) capital providers; 3) clients and customers; 4) talent; and 5) knowledge communities. We focus on ESG reporting needs, practices, and challenges from different stakeholders’ perspectives. Building on these insights, we suggest a collective approach to ESG reporting in Fintech that is adaptive to the dynamic nature of developments in both ESG and Fintech. The findings and insights are based on a series of interviews with various practitioners in the Fintech ESG sector conducted from February to August 2022 alongside an analysis of relevant documents. The document analysis includes both existing ESG regulations and venture specific ESG frameworks.","author_count":4,"contributors":["Wang, Cancan","Jiang, Qiuyu","Dittrich, Yvonne","Østerlund, Carsten Svarrer"],"cuid":["S01-000.00-683626"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","Syracuse University"],"keyword":["Digital financial services","ESG compliance","ESG performance evaluation","Fintech","Sustainability in startups"],"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-ITU"]},"level3all":["DI-U-AU","DI-U-ITU"]},"review":"und","rtype":["clu"],"sorti":"esg in fintech an overview","src":["itu"],"src-code":["DI-U-ITU"],"type":"doi","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/101319385/TR-2023-209.pdf","version":"Published Version"},"id":"S01-000.00-683626","ids":["itu-fc28080e-72d7-47e7-9a4a-715527905639"],"keyword":["Digital financial services","ESG compliance","ESG performance evaluation","Fintech","Sustainability in startups"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-ED9F9872DF4700D4F26FBC44201C0CDF"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/101319385/TR-2023-209.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","IT University of Copenhagen, Digitalization, Democracy, and Governance, REFLACT"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University"],"nora_code":"DI-U-AU","used":1},{"affno":"3","country":"us","key":"syracuse university","loc":["United States","America, North","OECD"],"name":"Syracuse University","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Cancan","key":"wangpau","last":"Wang","locid":"605b59ab-91b4-4f8e-bb12-df68ce0491c5","name":"Wang, Cancan","orcid":"0000-0002-9065-6884","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Qiuyu","key":"jiangpau","last":"Jiang","name":"Jiang, Qiuyu","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Yvonne","key":"dittrichpau","last":"Dittrich","locid":"f2136570-f73c-446f-9fb0-6d9e461e2124","name":"Dittrich, Yvonne","orcid":"0000-0003-4757-3394","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Carsten Svarrer","key":"østerlundpau","last":"Østerlund","name":"Østerlund, Carsten Svarrer","rank":4,"rolecode":"pau"}],"pub":{"publisher":"IT University of Copenhagen","status":"p"},"review":"Undetermined","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-fc28080e-72d7-47e7-9a4a-715527905639"],"src":["ITU IT University of Copenhagen"],"title":"ESG in Fintech: An Overview","type":"Other-Internet Publication","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-683626","year":"2023","yearsub":"2023"}
{"abstract":"This study sets out to understand the governance consequences of the ’agile transformation’ of the Danish state. The agile transformation builds on a set of values and routines from software engineering that advocates for change in the project management of digital public service provision. An ‘agile’ public sector promises to deliver not just more thoroughly digitalized public services, but also better digitalization by enhancing the speed, flexibility and innovative capabilities of IT project management in the public sector agencies tasked with building new IT systems. However, such an agile transformation is not easily accomplished, and its implications for the welfare state remain unclear. In this chapter, we problematize the Danish state’s attempted agile transformation from four perspectives: governance, sourcing, citizenship, and legacy and maintenance. From a governance perspective, the high velocity of day-to-day decisions built into the agile framework can lead to a decoupling between decision-making and accountability in public service delivery. But when agile approaches replace bureaucratic procedures originally put in place to ensure the accountability and legality of governmental operations, what are the consequences? Further, as the distribution of knowledge between the state and private consultancies has become increasingly interlaced through agile-based public-private collaborations, the state has attempted a shift from outsourcing to insourcing (‘hjemtagning’) of IT development. At the same time, the state’s collaboration with private actors has perhaps never been more intense, and it remains unclear how the much-needed IT expertise of the private sector interplays with the state’s growing ambitions of building new systems in-house. As regards citizenship and citizens’ trust in the state, the trial-and-error-based agile approach to service delivery may put a strain on the relationship between citizens and the welfare state by introducing “unfinished” minimal viable products (MVP) in the place of the fully operational IT systems citizens have learned to expect. Moreover, agile-based public services are often built upon an established base of legacy technology, which also impacts agile temporalities. Maintenance of pre-agile components cannot be easily contained in a sprint-based formula. And what happens after agile-based public services go beyond beta, or even face retirement? Does the responsibility for forming the strategy for the entire life-span of a product lie with the state or the vendor, and how can this responsibility be shared?","author_count":4,"contributors":["Papazu, Irina","Wang, Cancan","Perriam, Jessamy","Marttila, Sanna-Maria"],"cuid":["S01-000.00-382477"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Agile transformation","Citizenship Trust","Governance of IT","Legacy Systems Maintenance","Public private collaboration"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"nr","rtype":["clu"],"sorti":"outsourcing response ability the agile transformation of the danish public sector","src":["itu"],"src-code":["DI-U-ITU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-382477","ids":["itu-50c37dad-469b-472d-9502-743b84168544"],"keyword":["Agile Transformation","Citizenship Trust","Governance of IT","Legacy Systems Maintenance","Public-Private Collaboration"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-9DC78AFE17C082427B34F702ADA7329A"],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","IT University of Copenhagen, Center for Digital Welfare","IT University of Copenhagen, Technologies in Practice, Technologies in Practice"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Irina","key":"papazupau","last":"Papazu","locid":"6ec63914-1f4e-4708-8830-1b054c2ee03a","name":"Papazu, Irina","orcid":"0000-0002-4178-3676","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Cancan","key":"wangpau","last":"Wang","locid":"605b59ab-91b4-4f8e-bb12-df68ce0491c5","name":"Wang, Cancan","orcid":"0000-0002-9065-6884","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jessamy","key":"perriampau","last":"Perriam","locid":"4ca57c3b-1d1f-4ecf-87b0-fe690510c887","name":"Perriam, Jessamy","orcid":"0000-0002-6362-8634","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sanna-Maria","key":"marttilapau","last":"Marttila","locid":"528393a3-e784-47a8-85be-c81d44c393bd","name":"Marttila, Sanna-Maria","orcid":"0000-0003-3793-5021","rank":4,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-50c37dad-469b-472d-9502-743b84168544"],"src":["ITU IT University of Copenhagen"],"title":"Outsourcing response-ability : The agile transformation of the Danish public sector","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382477","year":"2022","yearsub":"2022"}
{"abstract":"n this paper, we explore the troubles and potentials at stake in the developmentsand deploymentsof lively technologies like Twitter bots, and how they challenge traditional ideas of ethical responsibility. We suggest that there is a tendency for bot ethics to revolve around the desire to differentiate between bot and human, which does not address what we understand to be the cultural anxieties at stake in the blurring boundaries between human and technology. Here we take some tentative steps towards rethinking and reimagining bot-human relationships through a feminist ethics of responsibility as response by taking as our starting point our own experience with bot creation, the Twitter bot “Hello30762308.”The bot was designed to respond with a “hello”to other Twitter users’ #hello, but quickly went in directions not intended by its creators.","author_count":2,"contributors":["Henriksen, Line","Wang, Cancan"],"cuid":["S01-000.00-384524"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Digital technology","Ethics","Responsibility","Social bots","Twitter"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"hello twitter bot towards a bot ethics of response and responsibility","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.28968/cftt.v8i1.36203","version":"Published Version"},"id":"S01-000.00-384524","ids":["itu-ddc10d48-b0c7-4274-8345-27b201b06f73"],"keyword":["Digital technology","Ethics","Responsibility","Social bots","Twitter"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-69DAE4ABB88A094C5D92195A21BCB1E8"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86693796/document.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.28968/cftt.v8i1.36203","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Line","key":"henriksenpau","last":"Henriksen","name":"Henriksen, Line","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Cancan","key":"wangpau","last":"Wang","locid":"605b59ab-91b4-4f8e-bb12-df68ce0491c5","name":"Wang, Cancan","orcid":"0000-0002-9065-6884","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.28968/cftt.v8i1.36203","issn":["23803312"],"journal":"Catalyst: Feminism, Theory, Technoscience","status":"p","title":"Catalyst: Feminism, Theory, Technoscience"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-ddc10d48-b0c7-4274-8345-27b201b06f73"],"src":["ITU IT University of Copenhagen"],"title":"Hello, Twitter Bot! : Towards a Bot Ethics of Response and Responsibility","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384524","year":"2022","yearsub":"2022"}
{"abstract":"Environmental, social, and corporate governance (ESG) reporting has become an important instrument for the sustainable transition of the next generation of business-startup. Nonetheless, poor ESG data quality impedes effective reporting, especially in domains such as Fintech where top-down ESG metrics may overlook pertinent material issues. This action research study applies a design probe in the form of the notion of an ESG data commons to explore possible strategies to improve ESG data quality in Fintech startup. By reporting on the initial results of an ongoing study of a Danish Fintech startup cluster, we develop a practice-based approach that highlights the changing processes, teleoaffective structures, and sociomaterial dynamics of ESG data commons. We contribute to information systems (IS) research in two areas. First, we contribute to the call for a data-driven approach to ESG reporting. Second, the study extends the IS design literature by applying data commons as a design probe.","author_count":4,"contributors":["Wang, Cancan","Østerlund, Carsten","Jiang, Qiuyu","Dittrich, Yvonne"],"cuid":["S01-000.00-382240"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","Syracuse University"],"keyword":["Action research","Data Commons","ESG","Fintech","Practice theory","Startup"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"becoming sustainable together esg data commons for fintech startups","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/90464219/Becoming_Sustainable_Together_Revision_Final.pdf","version":"Authors Final Version"},"id":"S01-000.00-382240","ids":["itu-41ae3a75-fc4e-4140-9d41-cabaa9c4b267"],"keyword":["Action Research","Data Commons","ESG","Fintech","Practice Theory","Startup"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-8D0706EBD5725B0F41CF95864461A5B8"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/90464219/Becoming_Sustainable_Together_Revision_Final.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","IT University of Copenhagen, Center for Digital Welfare","IT University of Copenhagen, Digitalization, Democracy, and Governance, REFLACT"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"us","key":"syracuse university","loc":["United States","America, North","OECD"],"name":"Syracuse University","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Cancan","key":"wangpau","last":"Wang","locid":"605b59ab-91b4-4f8e-bb12-df68ce0491c5","name":"Wang, Cancan","orcid":"0000-0002-9065-6884","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Carsten","key":"østerlundpau","last":"Østerlund","name":"Østerlund, Carsten","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Qiuyu","key":"jiangpau","last":"Jiang","locid":"0284519c-3320-48a2-8b0d-b4ae9351a403","name":"Jiang, Qiuyu","orcid":"0000-0002-6888-897X","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Yvonne","key":"dittrichpau","last":"Dittrich","locid":"f2136570-f73c-446f-9fb0-6d9e461e2124","name":"Dittrich, Yvonne","orcid":"0000-0003-4757-3394","rank":4,"rolecode":"pau"}],"pub":{"issn":["00000033"],"journal":"Proceedings / International Conference on Information Systems","status":"p","title":"Proceedings / International Conference on Information Systems","title_org":"Proceedings / International Conference on Information Systems (ICIS)"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-41ae3a75-fc4e-4140-9d41-cabaa9c4b267"],"src":["ITU IT University of Copenhagen"],"title":"Becoming Sustainable Together : ESG Data Commons for Fintech Startups","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382240","year":"2022","yearsub":"2022"}
{"abstract":"This study investigates the dissemination of the open government data concept as processes of change occurring in a globalized world. We use the concept of model travelling from global studies to unfold how open government data as an idea travels across places, especially how the idea in one place is related to changes in other places. We pay attention to the specific ways actors are engaged in the travelling of digital “ideas.” Empirically, we follow the travelling of the open government data concept between the UK and China, since 2009. Our finding provides a different picture on how social changes are ordered around open government data, which is different from the modernist or diffusionist view that believes social changes are concerted efforts driven by rational choice and diffuse from a fixated cultural centre to its peripheries. Rather, social changes around technology movements emerge haphazardly among networks of expert enthusiasts committed to the change process by their attraction to the fun and affective atmospheres around these movements. Their centres and peripheries of changes configure organically as the dynamics in the networks of actors evolve; and the directions of change can be multiple and simultaneous.","author_count":2,"contributors":["Wang, Cancan","Perriam, Jessamy"],"cuid":["S01-000.00-384026"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["China","Digitalization","Open government data","Social change","UK","expert enthusiasm"],"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"murder maps transport apps and soup how expert enthusiasts move open government data initiatives between the uk and china","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.12759/hsr.47.2022.28","version":"Published Version"},"id":"S01-000.00-384026","identifier":[{"id":"85143758340","type":"scopus"}],"ids":["itu-bcbeff41-3770-43ce-91c4-9b7f78ad8db2"],"keyword":["China","Open government data","UK","digitalization","expert enthusiasm","social change"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-3-1AB75C72747A9E5E945DEE97C77D46B5"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.12759/hsr.47.2022.28","version":"Published Version"},{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/91130631/04_Wang_Perriam_Murder_Maps_Transport_Apps_and_Soup_V3.pdf","version":"Other Version"}],"oai":{"class":"Realised","mra":["Social Science (SOC)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digitalization, Democracy, and Governance, REFLACT"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Cancan","key":"wangpau","last":"Wang","locid":"605b59ab-91b4-4f8e-bb12-df68ce0491c5","name":"Wang, Cancan","orcid":"0000-0002-9065-6884","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jessamy","key":"perriampau","last":"Perriam","locid":"4ca57c3b-1d1f-4ecf-87b0-fe690510c887","name":"Perriam, Jessamy","orcid":"0000-0002-6362-8634","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.12759/hsr.47.2022.28","issn":["01726404","09366784"],"issn_org":["01726404"],"issue":"3","journal":"Historical Social Research","pages":"111-141","status":"p","title":"Historical Social Research","volume":"47"},"review":"Peer Reviewed","scoID":["2-s2.0-85143758340"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-bcbeff41-3770-43ce-91c4-9b7f78ad8db2"],"src":["ITU IT University of Copenhagen"],"title":"Murder Maps, Transport Apps, and Soup: How Expert Enthusiasts Move Open Government Data Initiatives between the UK and China","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384026","year":"2022","yearsub":"2022"}
