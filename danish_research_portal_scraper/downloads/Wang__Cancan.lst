I-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-321f010f-12ed-4b42-8813-8680d5e53162"],"src":["ITU IT University of Copenhagen"],"title":"创新国度 : 丹麦的国家治理体系","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382000","year":"2021","yearsub":"2021"}
{"abstract":"Pomegranate (Punica granatum L.) is one of the most important fruit trees in semi-arid land. Previous studies were primarily focused on soil microbial community composition under different pomegranate plantation managements. However, soil microbial community composition under long-term pomegranate plantation has rarely been studied. We investigated pomegranate plantation along with an age sequence (i.e., 1, 3, 5, and 10 years after pomegranate plantation; abbreviated by P1, P3, P5, P10, respectively) in the Middle Yellow River floodplain. Our objectives were to address (1) variations of soil physicochemical properties and (2) changes in soil microbial community composition and the influential factors. The results demonstrated that the soil water content of pomegranate plantation decreased with the increase of pomegranate plantation stand age. Specifically, dissolved organic carbon, ammonium, and available phosphorus increased significantly with stand age both at 0–10-and 10–20-cm soil depths. The P10 had the highest microbial phospholipid fatty acid (PLFA) profiles, including fungi, bacteria, Gram-positive bacteria, Gram-negative bacteria, and arbuscular mycorrhizal fungi. The ratio of fungal PLFAs to bacterial PLFAs increased and the ratio of Gram-positive to Gram-negative bacterial PLFAs decreased along the pomegranate plantation stand age. Dissolved organic carbon was the most important influential factor among the studied variables, which explained 42.2% variation of soil microbial community. In summary, the long-term plantation of pomegranate elevated soil microbial biomass and altered microbial community composition.","author_count":10,"contributors":["Wang, Shilin","Yan, Xinyu","Wang, Dong","Siddique, Imran Ahammad","Chen, Ji","Xu, Qi","Zhao, Cancan","Yang, Leyun","Miao, Yuan","Han, Shijie"],"cuid":["S01-000.00-162655"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East","Asia, South"],"corresponding_author":["Miao, Yuan"],"country":["Bangladesh","China"],"glorg":["All Global Affiliations","Bangladesh Agricultural University","Henan University","Henan University of Science and Technology"],"keyword":["Available phosphorus","Bacteria","Dissolved organic carbon","Fungi","Yellow River"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"soil microbial community based on plfa profiles in an age sequence of pomegranate plantation in the middle yellow river floodplain","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.3390/d13090408","version":"Published Version"},"id":"S01-000.00-162655","identifier":[{"id":"85114226305","type":"scopus"}],"ids":["au-3a6b10b3-3aba-423a-9609-c62f9ea64cb0"],"keyword":["Available phosphorus","Bacteria","Dissolved organic carbon","Fungi","Plant stand age","Pomegranate plantation","Yellow River"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-F7F2D8ED6C43D9A35A42D9CDC5D4922D"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.3390/d13090408","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"cn","key":"henan university","loc":["China","Asia, East"],"name":"Henan University","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Agroecology, Department of Agroecology - Climate and Water"],"nora_code":"DI-U-AU","used":1},{"affno":"3","country":"bd","key":"bangladesh agricultural university","loc":["Bangladesh","Asia, South"],"name":"Bangladesh Agricultural University","used":1},{"affno":"4","country":"cn","key":"henan university of science and technology","loc":["China","Asia, East"],"name":"Henan University of Science and Technology","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Shilin","key":"wangshilinpau","last":"Wang","name":"Wang, Shilin","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Xinyu","key":"yanxinyupau","last":"Yan","name":"Yan, Xinyu","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Dong","key":"wangdongpau","last":"Wang","name":"Wang, Dong","rank":3,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"country":"dk","first":"Imran Ahammad","key":"siddiqueimranahammadpau","last":"Siddique","locid":"40c4a877-1bc7-4267-8212-97893fca5dcb","name":"Siddique, Imran Ahammad","orcid":"0000-0002-0908-9529","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ji","key":"chenjipau","last":"Chen","locid":"05f23b9e-16c0-478d-840b-18a8d914c393","name":"Chen, Ji","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Qi","key":"xuqipau","last":"Xu","name":"Xu, Qi","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Cancan","key":"zhaocancanpau","last":"Zhao","name":"Zhao, Cancan","rank":7,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Leyun","key":"yangleyunpau","last":"Yang","name":"Yang, Leyun","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Yuan","key":"miaoyuanpau","last":"Miao","name":"Miao, Yuan","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Shijie","key":"hanshijiepau","last":"Han","name":"Han, Shijie","rank":10,"rolecode":"pau"}],"pub":{"doi":"10.3390/d13090408","issn":["14242818"],"issue":"9","journal":"Diversity","paperid":"408","publisher":"Multidisciplinary Digital Publishing Institute (MDPI)","status":"p","title":"Diversity","volume":"13"},"review":"Peer Reviewed","scoID":["2-s2.0-85114226305"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-3a6b10b3-3aba-423a-9609-c62f9ea64cb0"],"src":["AU Aarhus University"],"title":"Soil microbial community based on plfa profiles in an age sequence of pomegranate plantation in the middle yellow river floodplain","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-162655","year":"2021","yearsub":"2021"}
