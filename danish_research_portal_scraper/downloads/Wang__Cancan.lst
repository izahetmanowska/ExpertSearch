nk":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sisse","key":"finkenpau","last":"Finken","locid":"70f3c85a-9cd2-40b4-bed9-5e2a75609421","name":"Finken, Sisse","orcid":"0000-0001-7792-7216","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lars Rune","key":"christensenpau","last":"Christensen","locid":"92f6c3f3-0ad2-40fc-b278-69170f87567d","name":"Christensen, Lars Rune","orcid":"0000-0001-7204-465X","rank":3,"rolecode":"pau"},{"affno":"","first":"Cancan","key":"wangpedh","last":"Wang","name":"Wang, Cancan","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Laura","key":"junckerjensenpedh","last":"Juncker-Jensen","name":"Juncker-Jensen, Laura","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["9788794538039"],"pages":"1-6","place":"Copenhagen","status":"p","title":"Action Research Booklet"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-2ab20077-2a53-426b-9dff-cec39fa5e540"],"src":["ITU IT University of Copenhagen"],"title":"Future Workshops and Researcher as Experts : Action Research in a Public-Private Research Project","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-789544","year":"2024","yearsub":"2024"}
{"abstract":"When you engage in action-oriented research and practice Participatory Design (PD), you carry with you a concern – an ecological concern you could say – for both humans, other-than-humans, and technologies. That is, more specifically, when you practice PD you work closely with the ones who are going to use – or are going to be affected by – the new information technology imagined and/or designed. Along with this ecological concern, you step into empirical sites with an awareness that technology is not value neutral, but rather is designed with and from different preferences, politics, and values (Markussen, 1996; Haraway, 1988). Having such awareness also means that questions concerning who designs, for whom, how, and with whom, come to matter (Finken et al., 2018). This further means that elements such as involvement, influence, responsibility, and power are essential for such a design approach to ecologies of humans, other-than-humans, and technologies.","author_count":3,"contributors":["Finken, Sisse"],"cuid":["S01-000.00-789553"],"filters":{"added":"2025-02","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"pop","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"und","rtype":["clu"],"sorti":"on humans other than humans and technologies positions knowledges and the art of paying attention","src":["itu"],"src-code":["DI-U-ITU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://pure.itu.dk/admin/files/105344102/The_Action_Research_Booklet_by_REFLACT.pdf","version":"Published Version"},"id":"S01-000.00-789553","ids":["itu-6388be6b-5d6d-49b2-920f-636773545df8"],"lang":"English","level":"Popular","mra":["Science/Technology"],"noi":["Local-1-1-49F7383BADDFC350BB08CEC9A97238D7"],"oa_link":[{"access":"oa","type":"rem","url":"https://pure.itu.dk/admin/files/105344102/The_Action_Research_Booklet_by_REFLACT.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","IT University of Copenhagen, Digitalization, Democracy, and Governance","IT University of Copenhagen, Digitalization, Democracy, and Governance, REFLACT","IT University of Copenhagen, Technologies in Practice, Technologies in Practice","IT University of Copenhagen, The Maritime Hub"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Sisse","key":"finkenpau","last":"Finken","locid":"70f3c85a-9cd2-40b4-bed9-5e2a75609421","name":"Finken, Sisse","orcid":"0000-0001-7792-7216","rank":1,"rolecode":"pau"},{"affno":"","first":"Cancan","key":"wangpedh","last":"Wang","name":"Wang, Cancan","rank":2,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Laura","key":"junckerjensenpedh","last":"Juncker-Jensen","name":"Juncker-Jensen, Laura","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"edition":"1","isbn":["9788794538039"],"place":"Copenhagen","status":"p","subtitle":"By REFLACT","title":"Action Research Booklet","volume":"1"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-6388be6b-5d6d-49b2-920f-636773545df8"],"src":["ITU IT University of Copenhagen"],"title":"On Humans, Other-Than-Humans, and Technologies: Positions, Knowledges, and the Art of Paying Attention.","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-789553","year":"2024","yearsub":"2024"}
