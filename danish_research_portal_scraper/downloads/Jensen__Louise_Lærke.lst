ode":"pau"},{"affno":"2","corresponding":null,"first":"The AmbuFlex","key":"teampau","last":"Team","name":"Team, The AmbuFlex","rank":20,"rolecode":"pau"}],"pmid":["36639598"],"pub":{"doi":"10.1007/s11136-022-03322-9","issn":["09629343"],"issue":"4","journal":"Quality of Life Research","pages":"1053-1067","publisher":"Springer","status":"p","title":"Quality of Life Research","volume":"32"},"review":"Peer Reviewed","scoID":["2-s2.0-85146283230"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Non-Profit Organisations","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-NP","DI-NP-ALL","DI-U","DI-U-ALL","Hospitals","Non-Profit Organisations","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["aau-07951fa2-17fb-48b1-8f18-360420294c75","au-d36b36bc-8554-44e7-a712-cdbdd6b7924f","ku-b946b32c-a799-4644-9c4a-37211f620b19"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen"],"title":"Patient-reported outcome (PRO) measurements in chronic and malignant diseases : ten years' experience with PRO-algorithm-based patient-clinician interaction (telePRO) in AmbuFlex","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-099.42-685568","year":"2023","yearsub":"2023"}
{"abstract":"Background: The prognosis of patients with atypical fibroxanthoma (AFX) and pleomorphic dermal sarcoma (PDS) remains uncertain and no standardized follow-up programs have been established. Objective: To recommend a standardized follow-up program of patients with AFX and PDS based on nationwide long-term estimates of local recurrence and metastasis. Methods: All patients with AFX and PDS in Denmark between 2002 and 2022 were included. Danish National Registries were used to estimate the risks of local recurrence and metastasis for AFX and PDS. Results: The 5-year risk of local recurrence was 10% for AFX and 17% for PDS. The 5-year risk of metastasis was 0.8% for AFX and 16% for PDS. PDS metastasized within 3 years in >90% of the patients with the lungs as the primary metastasis site (50%). Invasion beyond the subcutis, perineural/intravascular infiltration, and increasing age significantly increased the risk of PDS relapse. Limitations: Risk of misclassification and lack of detailed surgical information. Conclusion: The follow-up of patients with AFX can be limited to clinical visits for 4 years. Patients with PDS should be followed with clinical visits and PET/CT twice a year for the first 3 years and once a year for a minimum of 1 year.","author_count":13,"contributors":["Ørholt, Mathias","Abebe, Kiya","Rasmussen, Louise E.","Aaberg, Frederik L.","Lindskov, Lærke J.","Schmidt, Grethe","Wagenblast, Anne Lene","Petersen, Michael Mørk","Loya, Anand C.","Daugaard, Søren","Herly, Mikkel","Jensen, David Hebbelstrup","Vester-Glowinski, Peter"],"cuid":["S01-000.00-702052"],"filters":{"added":"2023-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Local recurrence","Metastasis","Pleomorphic dermal sarcoma","Prognosis","Relapse","Risk Factors","atypical fibroxanthoma"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"atypical fibroxanthoma and pleomorphic dermal sarcoma local recurrence and metastasis in a nationwide population based cohort of 000000001118 patients","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.jaad.2023.08.050","version":"Published Version"},"id":"S01-000.00-702052","identifier":[{"id":"37634740","type":"pmid"},{"id":"85171275135","type":"scopus"}],"ids":["ku-9833f92a-f512-421c-ac6d-f4a9ced4284d"],"keyword":["atypical fibroxanthoma","local recurrence","metastasis","pleomorphic dermal sarcoma","prognosis","relapse","risk factors"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-0042C60EF22F9532BC6BE057F30791AE"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/373513206/1_s2.0_S0190962223026282_main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.jaad.2023.08.050","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Orthopaedic Surgery"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Mathias","key":"ørholtpau","last":"Ørholt","name":"Ørholt, Mathias","rank":1,"rolecode":"pau"},{"affno":"1","first":"Kiya","key":"abebepau","last":"Abebe","name":"Abebe, Kiya","rank":2,"rolecode":"pau"},{"affno":"1","first":"Louise E.","key":"rasmussenpau","last":"Rasmussen","name":"Rasmussen, Louise E.","rank":3,"rolecode":"pau"},{"affno":"1","first":"Frederik L.","key":"aabergpau","last":"Aaberg","name":"Aaberg, Frederik L.","rank":4,"rolecode":"pau"},{"affno":"1","first":"Lærke J.","key":"lindskovpau","last":"Lindskov","name":"Lindskov, Lærke J.","rank":5,"rolecode":"pau"},{"affno":"1","first":"Grethe","key":"schmidtpau","last":"Schmidt","name":"Schmidt, Grethe","rank":6,"rolecode":"pau"},{"affno":"1","first":"Anne Lene","key":"wagenblastpau","last":"Wagenblast","name":"Wagenblast, Anne Lene","rank":7,"rolecode":"pau"},{"affno":"2","first":"Michael M.","key":"petersenpau","last":"Petersen","locid":"9eb5f936-2e76-4f2f-917e-a3b50f56f0e6","name":"Petersen, Michael Mørk","name_org":"Petersen, Michael M.","rank":8,"rolecode":"pau"},{"affno":"2","first":"Anand C.","key":"loyapau","last":"Loya","locid":"c836bba4-5b59-419f-b000-c3e6b7ad5986","name":"Loya, Anand C.","rank":9,"rolecode":"pau"},{"affno":"1","first":"Søren","key":"daugaardpau","last":"Daugaard","name":"Daugaard, Søren","rank":10,"rolecode":"pau"},{"affno":"1 2","first":"Mikkel","key":"herlypau","last":"Herly","locid":"f26c7e74-766e-4e94-8e61-33bbed28575f","name":"Herly, Mikkel","orcid":"0000-0002-5866-1173","rank":11,"rolecode":"pau"},{"affno":"1","first":"David Hebbelstrup","key":"jensenpau","last":"Jensen","name":"Jensen, David Hebbelstrup","rank":12,"rolecode":"pau"},{"affno":"2","first":"Peter","key":"vesterglowinskipau","last":"Vester-Glowinski","locid":"ff170014-afd2-40eb-892a-9bb0a75d1365","name":"Vester-Glowinski, Peter","rank":13,"rolecode":"pau"}],"pmid":["37634740"],"pub":{"doi":"10.1016/j.jaad.2023.08.050","issn":["01909622","10976787"],"issn_org":["01909622"],"issue":"6","journal":"Journal of the American Academy of Dermatology","pages":"1177-1184","status":"p","title":"Journal of the American Academy of Dermatology","volume":"89"},"review":"Peer Reviewed","scoID":["2-s2.0-85171275135"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-9833f92a-f512-421c-ac6d-f4a9ced4284d"],"src":["KU University of Copenhagen"],"title":"Atypical fibroxanthoma and pleomorphic dermal sarcoma : Local recurrence and metastasis in a nationwide population-based cohort of 1118 patients","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-702052","year":"2023","yearsub":"2023"}
{"abstract":"Background: Spermatogenesis depends on stimulation by follicle-stimulating hormone (FSH) which binds to FSH receptors (FSHR) on testicular Sertoli cells. Three FSH-related single-nucleotide polymorphisms (SNPs), FSHB -211G>T (rs10835638), FSHR -29G>A (rs1394205) and FSHR 2039A>G (rs6166) affect FSH action, and have been suggested to affect testicular function, but the evidence is uncertain. Objective: To describe the associations between the three SNPs and testicular function in a large and well-characterised cohort of men from the general population. Materials and methods: A cross-sectional study of 2020 Danish men unselected regarding testicular function. Outcome variables were semen parameters, reproductive hormones and testis size. Genotyping was done by competitive allele-specific quantitative PCR. Differences in genotype frequencies were tested by chi-square test and associations between genotypes and outcomes were assessed by multivariate linear regressions. Results: The SNPs affected serum FSH; carriers of the variant affecting FSH secretion (FSHB -211G>T) had lower FSH levels while carriers of variants affecting receptor expression (FSHR -29G>A) and receptor sensitivity (FSHR 2039A>G) had higher FSH levels. Carriers of FSHB -211G>T had lower calculated free testosterone/LH ratio. Although both FSHB -211G>T and FSHR 2039A>G were associated with smaller testis size, no clear association was detected in relation to any semen parameters, except a lower total number of morphologically normal spermatozoa in the heterozygous carriers of the FSHB -211G>T. Discussion and Conclusion: The studied polymorphisms have only minor modulating influence on testis size and function in healthy men. We detected subtle effects of the three SNPs on FSH levels, but also effects of FSHB -211G>T on calculated free testosterone/LH ratio, compatible with altered Leydig cell function. Thus, the role of these FSH-related polymorphisms is complex and modest in men with normal testicular function, but the possible importance of FSH polymorphisms in men with impaired testicular function should be evaluated in future studies in more detail.","author_count":16,"contributors":["Bang, Anne Kirstine","Almstrup, Kristian","Nordkap, Loa","Priskorn, Lærke","Petersen, Jørgen Holm","Blomberg Jensen, Martin","Krause, Marianna","Holmboe, Stine Agergaard","Egeberg Palme, Dorte Louise","Winge, Sofia Boeg","Joensen, Ulla Nordström","Olesen, Inge Ahlmann","Hvidman, Helene Westring","Juul, Anders","Rajpert-De Meyts, Ewa","Jørgensen, Niels"],"cuid":["S01-000.00-396979"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["FSH","FSHB","FSHR","Male infertility","Testicular function"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"i fshb i and i fshr i gene variants exert mild modulatory effect on reproductive hormone levels and testis size but not on semen quality a study of 000000002020 men from the general danish population","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-396979","identifier":[{"id":"33236519","type":"pmid"},{"id":"85097249670","type":"scopus"}],"ids":["ku-05e4a5f8-bad6-4b1c-bc09-e6ae84b96b74"],"keyword":["FSH","FSHB","FSHR","male infertility","testicular function"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-1BC5BA97AC1FDB162A0B71511CF20657"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Public Health, Section of Biostatistics"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Anne Kirstine","key":"bangpau","last":"Bang","name":"Bang, Anne Kirstine","rank":1,"rolecode":"pau"},{"affno":"1","first":"Kristian","key":"almstruppau","last":"Almstrup","name":"Almstrup, Kristian","rank":2,"rolecode":"pau"},{"affno":"1","first":"Loa","key":"nordkappau","last":"Nordkap","name":"Nordkap, Loa","rank":3,"rolecode":"pau"},{"affno":"1","first":"Lærke","key":"priskornpau","last":"Priskorn","name":"Priskorn, Lærke","rank":4,"rolecode":"pau"},{"affno":"2","first":"Jørgen Holm","key":"petersenpau","last":"Petersen","locid":"33c1c5b2-2e1e-4259-b4d7-04657a2bdb9b","name":"Petersen, Jørgen Holm","orcid":"0000-0003-3979-7443","rank":5,"rolecode":"pau"},{"affno":"1","first":"Martin","key":"blombergjensenpau","last":"Blomberg Jensen","name":"Blomberg Jensen, Martin","rank":6,"rolecode":"pau"},{"affno":"1","first":"Marianna","key":"krausepau","last":"Krause","name":"Krause, Marianna","rank":7,"rolecode":"pau"},{"affno":"1","first":"Stine Agergaard","key":"holmboepau","last":"Holmboe","name":"Holmboe, Stine Agergaard","rank":8,"rolecode":"pau"},{"affno":"1","first":"Dorte Louise","key":"egebergpalmepau","last":"Egeberg Palme","name":"Egeberg Palme, Dorte Louise","rank":9,"rolecode":"pau"},{"affno":"1","first":"Sofia Boeg","key":"wingepau","last":"Winge","name":"Winge, Sofia Boeg","rank":10,"rolecode":"pau"},{"affno":"2","first":"Ulla Nordström","key":"joensenpau","last":"Joensen","locid":"8df5abc2-4b6f-462e-b702-5079bdf76876","name":"Joensen, Ulla Nordström","orcid":"0000-0001-5400-4531","rank":11,"rolecode":"pau"},{"affno":"1","first":"Inge Ahlmann","key":"olesenpau","last":"Olesen","name":"Olesen, Inge Ahlmann","rank":12,"rolecode":"pau"},{"affno":"1","first":"Helene Westring","key":"hvidmanpau","last":"Hvidman","name":"Hvidman, Helene Westring","rank":13,"rolecode":"pau"},{"affno":"2","first":"Anders","key":"juulpau","last":"Juul","locid":"f9b11983-c7c8-4111-b119-4de471572898","name":"Juul, Anders","orcid":"0000-0002-0534-4350","rank":14,"rolecode":"pau"},{"affno":"1","first":"Ewa","key":"rajpertdemeytspau","last":"Rajpert-De Meyts","name":"Rajpert-De Meyts, Ewa","rank":15,"rolecode":"pau"},{"affno":"1","first":"Niels","key":"jørgensenpau","last":"Jørgensen","name":"Jørgensen, Niels","rank":16,"rolecode":"pau"}],"pmid":["33236519"],"pub":{"doi":"10.1111/andr.12949","issn":["20472919","20472927"],"issn_org":["20472919"],"issue":"2","journal":"Andrology","pages":"618-631","status":"p","title":"Andrology","volume":"9"},"review":"Peer Reviewed","scoID":["2-s2.0-85097249670"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-05e4a5f8-bad6-4b1c-bc09-e6ae84b96b74"],"src":["KU University of Copenhagen"],"title":"<i>FSHB</i> and <i>FSHR</i> gene variants exert mild modulatory effect on reproductive hormone levels and testis size but not on semen quality : A study of 2020 men from the general Danish population","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-396979","year":"2021","yearsub":"2021"}
{"abstract":"Objective: To investigate whether obstetric and perinatal outcomes in pregnancies differ after different frozen embryo transfer (FET) protocols. Design: Register-based cohort study. Setting: Not applicable. Patient(s): All singleton deliveries after assisted reproductive technology in Denmark from 2006 to 2014. Data consisted of 1,136 deliveries after frozen in vitro fertilization. Frozen embryo transfer cycles were grouped by type of FET protocol: programmed FET (n = 357); modified natural cycle FET (n = 611); and true natural cycle FET (n = 168). Intervention(s): None. Main Outcome Measure(s): Obstetric outcomes (hypertensive disorders in pregnancy, preterm prelabor rupture of membranes, placenta previa, placental abruption, induction of labor, postpartum hemorrhage, and cesarean section) and perinatal outcomes (post-term birth, preterm birth, birth weight, small for gestational age, large for gestational age). Result(s): The risk of hypertensive disorders in pregnancy, postpartum hemorrhage, and cesarean section was significantly higher after programmed FET compared with natural cycle FET (modified natural cycle FET and true natural cycle FET). A higher risk of birth weight > 4,500 g was observed in the programmed FET group compared with natural cycle FET. Conclusion(s): This study shows that obstetric and perinatal outcomes are adversely affected in programmed FET cycles. Hence, when possible, an endometrial preparation with the creation of a corpus luteum should be considered. Properly sized randomized controlled trials of FET in programmed cycle versus natural cycle including perinatal outcomes are warranted in the future. Clinical Trial Registration Number: ISRCTN11780826.","author_count":7,"contributors":["Asserhøj, Louise Laub","Spangmose, Anne Lærke","Aaris Henningsen, Anna Karina","Clausen, Tine Dalsgaard","Ziebe, Søren","Jensen, Rikke Beck","Pinborg, Anja"],"cuid":["S01-000.00-479359"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Natural cycle","Obstetric outcome","Perinatal outcome","Programmed cycle"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"adverse obstetric and perinatal outcomes in 000000000001 000000000136 singleton pregnancies conceived after programmed frozen embryo transfer fet compared with natural cycle fet","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-479359","identifier":[{"id":"33461756","type":"pmid"},{"id":"85099562209","type":"scopus"}],"ids":["ku-8fc4a2d5-ee3b-492b-ac04-975b54016825"],"keyword":["Frozen embryo transfer (FET)","natural cycle","obstetric outcome","perinatal outcome","programmed cycle"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-B5F23A1BA99330E2F9DB4FC7A072E542"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Obstetrics and Gynaecology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Louise Laub","key":"asserhøjpau","last":"Asserhøj","name":"Asserhøj, Louise Laub","rank":1,"rolecode":"pau"},{"affno":"","first":"Anne Lærke","key":"spangmosepau","last":"Spangmose","name":"Spangmose, Anne Lærke","rank":2,"rolecode":"pau"},{"affno":"","first":"Anna Karina","key":"aarishenningsenpau","last":"Aaris Henningsen","name":"Aaris Henningsen, Anna Karina","rank":3,"rolecode":"pau"},{"affno":"1","first":"Tine Dalsgaard","key":"clausenpau","last":"Clausen","locid":"047e6356-0a01-48a6-9a2e-fa550c06183e","name":"Clausen, Tine Dalsgaard","rank":4,"rolecode":"pau"},{"affno":"","first":"Søren","key":"ziebepau","last":"Ziebe","name":"Ziebe, Søren","rank":5,"rolecode":"pau"},{"affno":"","first":"Rikke Beck","key":"jensenpau","last":"Jensen","name":"Jensen, Rikke Beck","rank":6,"rolecode":"pau"},{"affno":"1","first":"Anja","key":"pinborgpau","last":"Pinborg","locid":"28eb0e05-b8d4-4063-9350-54ae5d522ed4","name":"Pinborg, Anja","rank":7,"rolecode":"pau"}],"pmid":["33461756"],"pub":{"doi":"10.1016/j.fertnstert.2020.10.039","issn":["00150282","15462501"],"issn_org":["00150282"],"issue":"4","journal":"Fertility and Sterility","pages":"947-956","status":"p","title":"Fertility and Sterility","volume":"115"},"review":"Peer Reviewed","scoID":["2-s2.0-85099562209"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-8fc4a2d5-ee3b-492b-ac04-975b54016825"],"src":["KU University of Copenhagen"],"title":"Adverse obstetric and perinatal outcomes in 1,136 singleton pregnancies conceived after programmed frozen embryo transfer (FET) compared with natural cycle FET","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-479359","year":"2021","yearsub":"2021"}
{"abstract":"Rapporten er et katalog over virkemidler, som kan målrettes til de områder, hvor både risikoen for fosfortab er stor, og hvor vandmiljøet er fosforfølsomt. Virkemidlerne kan anvendes i en målrettet fosforindsats i de kommende vandområdeplaner 2021- 2027. Kataloget indeholder samtidig forslag til afværgeforanstaltninger mod fosfortab i den nationale vådområdeindsats.","author_count":25,"contributors":["Andersen, Hans Estrup","Rubæk, Gitte Holton","Hasler, Berit","Jacobsen, Brian H.","Martinsen, Louise","Heckrath, Goswin Johann","Olsen, Preben","Munkholm, Lars Juhl","Hoffmann, Carl Christian","Zak, Dominik Henrik","Kronvang, Brian","van't Veen, Sofie Gyritia Madsen","Strandberg, Beate","Bruus, Marianne","Lærke, Poul Erik","Gundersen, Per","Kudsk, Per","Jørgensen, Lise Nistrup","Hutchings, Nicholas John","Egemose, Sara","Reitzel, Kasper","Jensen, Henning S.","Søndergaard, Martin","Friis Pedersen, Michael"],"cuid":["S02-092.00-767259"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"virkemidler til reduktion af fosforbelastningen af vandmiljøet","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://dce.au.dk/udgivelser/vr/nr-351-400/abstracts/nr-379-virkemidler-til-reduktion-af-fosforbelastningen-af-vandmiljoeet/","version":"Published Version"},"id":"S02-092.00-767259","ids":["au-17a26f9f-dd03-4855-b70f-dfbfa3617d6c","sdu-b84cb070-01c6-479f-b8fd-c6976827a6b4"],"lang":"Danish","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-2-996121C02D27231AF2E6AA95B55275CB"],"oa_link":[{"access":"oa