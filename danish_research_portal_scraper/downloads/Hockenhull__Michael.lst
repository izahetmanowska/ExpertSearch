d":"5041f387-908f-4845-9f79-3a6dbd527f4b","name":"Hockenhull, Michael","orcid":"0000-0002-2670-2102","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"James","key":"maguirepau","last":"Maguire","locid":"2efbc294-1ce4-4148-a403-93fe6450d879","name":"Maguire, James","orcid":"0000-0001-5081-1811","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Felipe Silva","key":"figueiredopau","last":"Figueiredo","locid":"c3ca425d-f0d9-493b-9012-7dee3b9e2dfb","name":"Figueiredo, Felipe Silva","rank":3,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-db0469d9-68d8-46f4-98b0-f6664e4eec63"],"src":["ITU IT University of Copenhagen"],"title":"RESET - A climate magazine by the IT University of Copenhagen : Living well with technology in the climate emergency?","type":"Other-Internet Publication","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-776451","year":"2024","yearsub":"2024"}
{"abstract":"Digital methods, taken up in the collection and analysis of data, raise concerns around extraction, representation, care, consent, and participation familiar to feminist methodologies. At a feminist STS lab, specialising in digital methods, we convened some workshops to support research design in ongoing projects situated in the Lab’s community, with the aim to articulate feminist principles for digital methods. These projects, working with methods including digital ethnography, database implementation, and machine learning design raise feminist questions around centring care in data collection and participation, navigating hesitancies around extracting data from vulnerable subjects, and working through representational politics of data. These workshops, rather than congealing a set of feminist principles, generated a proliferation of disconcertments and troubles. We offer workshopping troubles as a way to navigate and theorise tensions in designing digital methods research. We account for how these workshops served as a method to elicit troubles, surfacing them for further analysis, and helped us shift from binding dichotomies to troubles that open ongoing inquiry. We reflect on how digital methods return us to troubles that, while well understood in feminist approaches to data, require articulation in practice and research design.","author_count":7,"contributors":["Perriam, Jessamy","Cohn, Marisa","Hockenhull, Michael","Tatjana Reime, Lara","Landa, Luis","Kjær, Katrine Meldgaard","Friis, Henriette"],"cuid":["S01-000.00-730171"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Disconcertment","Ethnography","Feminist digital methods","Research Design","Science and Technology Studies","workshopping"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"workshopping troubles towards feminist digital methods","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1080/08164649.2024.2321576","version":"Published Version"},"id":"S01-000.00-730171","identifier":[{"id":"85186618045","type":"scopus"}],"ids":["itu-63137823-9862-4f33-a0d3-440a4269c108"],"keyword":["Feminist digital methods","disconcertment","ethnography","research design","science and technology studies","workshopping"],"lang":"Danish","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-70A0FC14E3B5B57117B14FBB1F3E6C98"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1080/08164649.2024.2321576","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","IT University of Copenhagen, Center for Digital Welfare","IT University of Copenhagen, Technologies in Practice, Technologies in Practice"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jessamy","key":"perriampau","last":"Perriam","locid":"4ca57c3b-1d1f-4ecf-87b0-fe690510c887","name":"Perriam, Jessamy","orcid":"0000-0002-6362-8634","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Marisa","key":"cohnpau","last":"Cohn","locid":"e9d14210-bc71-4824-b7cf-fd1448d022ab","name":"Cohn, Marisa","orcid":"0000-0002-3912-2166","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Michael","key":"hockenhullpau","last":"Hockenhull","locid":"5041f387-908f-4845-9f79-3a6dbd527f4b","name":"Hockenhull, Michael","orcid":"0000-0002-2670-2102","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country