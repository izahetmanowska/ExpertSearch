EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["ITU IT University of Copenhagen"],"nora_code":"DI-U-ITU"}],"person":[{"affno":"1","first":"Alena","key":"thielpau","last":"Thiel","locid":"8eaf409f-f6a1-439e-a8e1-c7c1da0c88da","name":"Thiel, Alena","orcid":"0000-0002-1092-1140","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Karsten","key":"giesepau","last":"Giese","name":"Giese, Karsten","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Laurence","key":"marfaingpau","last":"Marfaing","name":"Marfaing, Laurence","rank":3,"rolecode":"pau"}],"pub":{"pages":"7-29","place":"Paris","publisher":"Karthala","status":"p","title":"Entrepreneurs africains et chinois: Les impacts sociaux d’une rencontre particulière"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","ITU IT University of Copenhagen","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["itu-53631750-584f-4895-be19-3ffb76ffcde8","ku-a7736763-3a35-4edc-96ec-13f68206a7f5"],"src":["ITU IT University of Copenhagen","KU University of Copenhagen"],"title":"Introduction: Du rejet des autres à leur implication dans les dynamiques de changement social","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-822868","year":"2015","yearsub":"2015"}
{"abstract":"This qualitative study analyzes Chinese-Ghanaian employment in trade as an example of South-South cross-cultural labor relations. Based on ethnographic fieldwork, employment practices and labor conflicts are discussed with regard to psychological contract and equity. The analysis is guided by a process model of psychological contract that has been adjusted and extended in consideration of the dimensions of foreignness and cross-cultural communication. After briefly introducing the situation in Ghana we elaborate that under conditions of foreignness, employment relations are conflict prone because of contradictory equity expectations of employers and employees. We discuss how Ghanaian employees perceiving their psychological contract as violated attempt to restore equity by means of voice, silence, retreat or destruction and often fail due to lack of mutual cultural understanding between employers and employees. We conclude that exit in contrast to expectations is a viable option for employers rather than employees, but most employment relations, though defective, are perpetuated.","author_count":2,"contributors":["Thiel, Alena","Giese, Karsten"],"cuid":["S02-083.70-822867"],"filters":{"added":"2023-02","altsrc":["No Matches Found"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","German Institute of Global and Area Studies"],"keyword":["China","Ghana","Trade","cross cultural labor relations","psychological contract"],"level":"sci","mra":["hum","sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-KU"]},"level3all":["DI-U-ITU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"the silent majority the psychological contract in chinese ghanaian labor relations","src":["itu","ku"],"src-code":["DI-U-ITU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84929288244","version":"Other Version"},"id":"S02-083.70-822867","identifier":[{"id":"84929288244","type":"scopus"}],"ids":["itu-0b3c4713-eb3c-49cb-a4a7-6a301d8127ba","ku-f215bc98-0ad7-4037-8fa8-4824c7fc0750"],"keyword":["China","Ghana","cross-cultural labor relations","psychological contract","trade"],"lang":"English","level":"Scientific","mra":["Humanities","Science/Technology"],"noi":["Local-1-2-9115F1888B7A083AE6FE774DCBC622F6"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Theology, Centre for African Studies - Technical area, Centre for African Studies"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"de","key":"german institute of global and area studies","loc":["Germany","Europe, EU","OECD"],"name":"German Institute of Global and Area Studies","used":1},{"affno":3,"key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"ITU IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["ITU IT University of Copenhagen"],"nora_code":"DI-U-ITU"}],"person":[{"affno":"1","first":"Alena","key":"thielpau","last":"Thiel","locid":"8eaf409f-f6a1-439e-a8e1-c7c1da0c88da","name":"Thiel, Alena","orcid":"0000-0002-1092-1140","rank":1,"rolecode":"pau"},{"affno":"2","first":"Karsten","key":"giesepau","last":"Giese","name":"Giese, Karsten","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1080/09585192.2014.971844","issn":["09585192","14664399"],"issue":"14","journal":"International Journal of Human Resource Management","pages":"1807-1826","publisher":"Taylor & Francis","status":"p","title":"International Journal of Human Resource Management","volume":"26"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","ITU IT University of Copenhagen","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["itu-0b3c4713-eb3c-49cb-a4a7-6a301d8127ba","ku-f215bc98-0ad7-4037-8fa8-4824c7fc0750"],"src":["ITU IT University of Copenhagen","KU University of Copenhagen"],"title":"The silent majority: The psychological contract in Chinese-Ghanaian labor relations","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-083.70-822867","year":"2015","yearsub":"2015"}
{"abstract":"Migrating from northern Ghana to the coastal capital Accra in search of work, female head porters (‘kayayei’) find themselves in social structures and spatial orders that are imbued with various relations of seniority and power that constrain newcomers' entrepreneurial options. Yet, with the recent arrival of Chinese entrepreneurs in the social arena of Accra's marketplace, these power relations and gate-keeping mechanisms have begun to change. In this article, we analyse how female head porters perceive and appropriate the opportunities that arise as a result of the Chinese being seen by both they themselves and others as outsiders to Ghanaian society. By unintentionally enabling head-load carriers to extend their actual and symbolic claims to spatial realms that they were previously excluded from, the Chinese traders are facilitating head porters' expanded role within the social construction of place and space in Ghana's main urban market centre. They are therefore altering the patterns of everyday interactions between these head-load carriers and their environment.","author_count":2,"contributors":["Giese, Karsten","Thiel, Alena"],"cuid":["S02-090.32-686171"],"filters":{"added":"2022-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","German Institute of Global and Area Studies"],"keyword":["China Africa relations","Gender","Place","head porters","spatial orders"],"level":"sci","mra":["hum","sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-KU"]},"level3all":["DI-U-ITU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"chinese factor in the space place and agency of female head porters in urban ghana","src":["itu","ku"],"src-code":["DI-U-ITU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=84926109457&partnerID=8YFLogxK","version":"Other Version"},"id":"S02-090.32-686171","identifier":[{"id":"84926109457","type":"scopus"}],"ids":["itu-59f16be1-e8e6-4a85-aff4-9bf969d3a583","ku-84d39cb6-4eaa-4b4c-bbab-d9e7df130d43"],"keyword":["China–Africa relations","gender","head porters","head porters (‘kayayei’)","place","spatial orders"],"lang":"English","level":"Scientific","mra":["Humanities","Science/Technology"],"noi":["Local-1-2-ADCF0837ABE1E30950DC52381B8E9F90"],"org":[{"affno":"1","country":"de","key":"german institute of global and area studies","loc":["Germany","Europe, EU","OECD"],"name":"German Institute of Global and Area Studies","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Theology, Centre for African Studies - Technical area, Centre for African Studies"],"nora_code":"DI-U-KU","used":1},{"affno":3,"key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"ITU IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["ITU IT University of Copenhagen"],"nora_code":"DI-U-ITU"}],"person":[{"affno":"1","first":"Karsten","key":"giesepau","last":"Giese","name":"Giese, Karsten","rank":1,"rolecode":"pau"},{"affno":"2","first":"Alena","key":"thielpau","last":"Thiel","locid":"8eaf409f-f6a1-439e-a8e1-c7c1da0c88da","name":"Thiel, Alena","orcid":"0000-0002-1092-1140","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1080/14649365.2014.998266","issn":["14649365","14701197"],"issn_org":["14649365"],"issue":"4","journal":"Social & Cultural Geography","pages":"444-464","status":"p","title":"Social & Cultural Geography","title_org":"Social and Cultural Geography","volume":"16"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","ITU IT University of Copenhagen","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["itu-59f16be1-e8e6-4a85-aff4-9bf969d3a583","ku-84d39cb6-4eaa-4b4c-bbab-d9e7df130d43"],"src":["ITU IT University of Copenhagen","KU University of Copenhagen"],"title":"Chinese factor in the space, place and agency of female head porters in urban Ghana","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-090.32-686171","year":"2015","yearsub":"2015"}
{"abstract":"Independent Chinese entrepreneurs pursuing economic activities as diverse as restaurants, medical services and, most importantly, general trade are increasingly flocking to Africa in search of business opportunities. This article deconstructs the anti-Chinese attitudes prevalent among Senegalese and Ghanaian business people working in the trade sector. Critically, triangulated data suggest that Chinese commodities, which are said to create unfair competition for local entrepreneurs, come to the African continent through diverse import channels, not least local businesses themselves. Thus their presence is not exclusively due to the in-country activities of Chinese migrant entrepreneurs, as is commonly alleged in the daily discourses of Senegalese and Ghanaian market traders. More fundamental processes of socioeconomic change, however, are subjecting traders in Ghana and Senegal to decreasing profit margins and increasing economic competition. Fuelled by broader general myths, understood as a way of conceptualising an abstract topic in chains of cultural referents (O’Sullivan et al. 1994), about the Chinese presence in Africa, we argue that rumours alleging that Chinese traders encroach on the two countries’ urban marketplaces are creative means of sense-making for locals operating in a rapidly changing economic environment.","author_count":2,"contributors":["Thiel, Alena","Marfaing, Laurence"],"cuid":["S02-085.77-698154"],"filters":{"added":"2023-02","altsrc":["No Matches Found"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Chinese in Africa","Ghana","Senegal","rumours"],"level":"sci","mra":["hum","sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-KU"]},"level3all":["DI-U-ITU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"demystifying chinese business strength in urban senegal and ghana structural change and the performativity of rumours","src":["itu","ku"],"src-code":["DI-U-ITU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1080/00083968.2014.935642","version":"Published Version"},"id":"S02-085.77-698154","identifier":[{"id":"84938089653","type":"scopus"}],"ids":["itu-0658a59a-4d14-46f5-957a-745accadab90","ku-319c214f-5255-418c-b9c8-0f723c4ae355"],"keyword":["Chinese in Africa","Ghana","Senegal","rumours"],"lang":"English","level":"Scientific","mra":["Humanities","Science/Technology"],"noi":["Local-1-2-9279F53A74FC851072657E24A732F1A0"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1080/00083968.2014.935642","version":"Published Version"},{"access":"oa","type":"rem","url":"https://www.researchgate.net/profile/Laurence-Marfaing/publication/274890422_Demystifying_Chinese_Business_Strength_in_Urban_Senegal_and_Ghana_Structural_Change_and_the_Performativity_of_Rumours/links/5576beb808aeb6d8c01b0996/Demystifying-Chinese-Business-Strength-in-Urban-Senegal-and-Ghana-Structural-Change-and-the-Performativity-of-Rumours.pdf?_tp=eyJjb250ZXh0Ijp7ImZpcnN0UGFnZSI6InB1YmxpY2F0aW9uIiwicGFnZSI6InB1YmxpY2F0aW9uIn19","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Theology, Centre for African Studies - Technical area, Centre for African Studies"],"nora_code":"DI-U-KU","used":1},{"affno":2,"key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"ITU IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["ITU IT University of Copenhagen"],"nora_code":"DI-U-ITU"}],"person":[{"affno":"1","first":"Alena","key":"thielpau","last":"Thiel","locid":"8eaf409f-f6a1-439e-a8e1-c7c1da0c88da","name":"Thiel, Alena","orcid":"0000-0002-1092-1140","rank":1,"rolecode":"pau"},{"affno":"","first":"Laurence","key":"marfaingpau","last":"Marfaing","name":"Marfaing, Laurence","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1080/00083968.2014.935642","issn":["00083968","19233051"],"issue":"3","journal":"Canadian Journal of African Studies","pages":"405-423","publisher":"Taylor & Francis","status":"p","title":"Canadian Journal of African Studies","volume":"47"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","ITU IT University of Copenhagen","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["itu-0658a59a-4d14-46f5-957a-745accadab90","ku-319c214f-5255-418c-b9c8-0f723c4ae355"],"src":["ITU IT University of Copenhagen","KU University of Copenhagen"],"title":"Demystifying Chinese business strength in urban Senegal and Ghana: structural change and the performativity of rumours","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-085.77-698154","year":"2014","yearsub":"2014"}
{"abstract":"Based on a two-sided ethnographic study in Accra, this paper analyses Chinese–Ghanaian employment relations from the perspectives of psychological contract, cross-cultural equity expectations and foreignness. Reaching beyond racially framed allegations of each other that are informed partly by politicized media discourses, structural analysis shows that mutually contradictory, culturally grounded expectations regarding their employment relationship are central to the understanding of conflict between Chinese employers and Ghanaian employees. Central to the frictions of mutual equity expectations is the feeling of existential vulnerability that – although particular for each group – is shared by both Chinese migrant employers taking high financial risks in an unfamiliar and potentially hostile environment and their local employees recruited almost exclusively from economically marginalized groups.","author_count":2,"contributors":["Thiel, Alena","Giese, Karsten"],"cuid":["S02-083.33-686176"],"filters":{"added":"2023-02","altsrc":["No Matches Found"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","German Institute of Global and Area Studies"],"keyword":["China","Equity","Ghana","Labour relations","Trade","psychological contract"],"level":"sci","mra":["hum","sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-KU"]},"level3all":["DI-U-ITU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"the vulnerable other distorted equity in chinese ghanaian employment relations","src":["itu","ku"],"src-code":["DI-U-ITU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1080/01419870.2012.681676","version":"Published Version"},"id":"S02-083.33-686176","identifier":[{"id":"84901007781","type":"scopus"}],"ids":["itu-c16d68f0-2a4d-4058-a869-20578d4c5d1a","ku-fd78fad5-8fe4-4d6b-a334-45f49639fce9"],"keyword":["China","Ghana","equity","labour relations","psychological contract","trade"],"lang":"English","level":"Scientific","mra":["Humanities","Science/Technology"],"noi":["Local-1-2-38B9AE501F1ECA42E2E51A7C593FED09"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1080/01419870.2012.681676","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Theology, Centre for African Studies - Technical area, Centre for African Studies"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"de","key":"german institute of global and area studies","loc":["Germany","Europe, EU","OECD"],"name":"German Institute of Global and Area Studies","used":1},{"affno":3,"key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"ITU IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["ITU IT University of Copenhagen"],"nora_code":"DI-U-ITU"}],"person":[{"affno":"1","first":"Alena","key":"thielpau","last":"Thiel","locid":"8eaf409f-f6a1-439e-a8e1-c7c1da0c88da","name":"Thiel, Alena","orcid":"0000-0002-1092-1140","rank":1,"rolecode":"pau"},{"affno":"2","first":"Karsten","key":"giesepau","last":"Giese","name":"Giese, Karsten","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1080/01419870.2012.681676","issn":["01419870","14664356"],"issue":"6","journal":"Ethnic and Racial Studies","pages":"1101-1120","publisher":"Taylor & Francis","status":"p","title":"Ethnic and Racial Studies","volume":"37"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","ITU IT University of Copenhagen","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["itu-c16d68f0-2a4d-4058-a869-20578d4c5d1a","ku-fd78fad5-8fe4-4d6b-a334-45f49639fce9"],"src":["ITU IT University of Copenhagen","KU University of Copenhagen"],"title":"The vulnerable other: Distorted equity in Chinese‐Ghanaian employment relations","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-083.33-686176","year":2014,"yearsub":2014}
{"author_count":2,"contributors":["Thiel, Alena","Marfaing, Laurence"],"cuid":["S01-000.00-530875"],"filters":{"added":"2023-02","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"the impact of chinese business on market entry in ghana and senegal","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://dx.doi.org/10.1353/afr.2013.0050","version":"Other Version"},"id":"S01-000.00-530875","identifier":[{"id":"84897017007","type":"scopus"}],"ids":["ku-e6280f74-2b38-4c46-bf14-e33c344b9390"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-5BBA7EDC8D4C261FAF0B5EDCFAE5270F"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Theology, Centre for African Studies - Technical area, Centre for African Studies"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Alena","key":"thielpau","last":"Thiel","locid":"8eaf409f-f6a1-439e-a8e1-c7c1da0c88da","name":"Thiel, Alena","orcid":"0000-0002-1092-1140","rank":1,"rolecode":"pau"},{"affno":"","first":"Laurence","key":"marfaingpau","last":"Marfaing","name":"Marfaing, Laurence","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1353/afr.2013.0050","issn":["00019720","17500184"],"issn_org":["00019720"],"journal":"Africa","status":"p","title":"Africa"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-e6280f74-2b38-4c46-bf14-e33c344b9390"],"src":["KU University of Copenhagen"],"title":"The Impact of Chinese Business on Market Entry in Ghana and Senegal","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-530875","year":"2013","yearsub":"2013"}
{"author_count":2,"contributors":["Thiel, Alena","Marfaing, Laurence"],"cuid":["S02-086.36-686175"],"filters":{"added":"2023-02","altsrc":["No Matches Found"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","German Institute of Global and Area Studies"],"level":"sci","mra":["hum","sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-KU"]},"level3all":["DI-U-ITU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"petits commerçants chinois en afrique et saturation des marchés ouest africains déconstruction d une rumeur dakar accra","src":["itu","ku"],"src-code":["DI-U-ITU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.3917/migra.149.0137","version":"Published Version"},"id":"S02-086.36-686175","ids":["itu-9b5b6de1-655c-4732-b041-f01239ae0f8f","ku-d6f7effd-c58e-4b29-924c-f0dee70a8522"],"lang":"French","level":"Scientific","mra":["Humanities","Science/Technology"],"noi":["Local-1-2-D85299B51FB19C3038CC96D840E749E4"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.3917/migra.149.0137","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Theology, Centre for African Studies - Technical area, Centre for African Studies"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"de","key":"german institute of global and area studies","loc":["Germany","Europe, EU","OECD"],"name":"German Institute of Global and Area Studies","used":1},{"affno":3,"key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"ITU IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["ITU IT University of Copenhagen"],"nora_code":"DI-U-ITU"}],"person":[{"affno":"1","first":"Alena","key":"thielpau","last":"Thiel","locid":"8eaf409f-f6a1-439e-a8e1-c7c1da0c88da","name":"Thiel, Alena","orcid":"0000-0002-1092-1140","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Laurence","key":"marfaingpau","last":"Marfaing","name":"Marfaing, Laurence","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.3917/migra.149.0137","issn":["25519808"],"issue":"149","journal":"Migrations sociétés","pages":"137-158","status":"p","title":"Migrations sociétés","volume":"25"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","ITU IT University of Copenhagen","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["itu-9b5b6de1-655c-4732-b041-f01239ae0f8f","ku-d6f7effd-c58e-4b29-924c-f0dee70a8522"],"src":["ITU IT University of Copenhagen","KU University of Copenhagen"],"title":"Petits commerçants chinois en Afrique et saturation des marchés ouest-africains : Déconstruction d’une rumeur (Dakar-Accra)","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-086.36-686175","year":"2013","yearsub":"2013"}
{"abstract":"In this article we analyse the currently observable changes in the norms and orders that regulate market entry in the Ghanaian and Senegalese trade sectors. We portray the three distinct ways in which – facilitated by the presence of independent Chinese migrants – previously excluded actors are now able to enter the market, without needing to rely on the networks that typically mediate access to start-up capital needs – such as selling space, marketing skills and, not least, capital stock. Creatively appropriating the new situation, these previously excluded actors have thus found in the Chinese presence a means of bypassing restrictive economic, social and religious networks. In-depth ethnographic fieldwork in 2011 and 2012 has revealed that while aspiring traders from Ghana and Senegal applaud the newly opened pathways to gainful economic activity, more established local merchants in the urban centres of both countries feel and express, in contrast, a discontent with the growing Chinese presence – as they see their role as gatekeepers of the market order being increasingly undermined.","author_count":2,"contributors":["Thiel, Alena","Marfaing, Laurence"],"cuid":["S01-000.00-828181"],"filters":{"added":"2023-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","German Institute of Global and Area Studies"],"keyword":["Chinese migrants","Economic Networks","Ghana Trade Sector","Market entry","Senegal Trade Sector"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"the impact of chinese business on market entry in ghana and senegal","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1017/S0001972013000491","version":"Published Version"},"id":"S01-000.00-828181","identifier":[{"id":"84897017007","type":"scopus"}],"ids":["itu-db92d274-b32d-4698-aa22-f0cc64f81b81"],"keyword":["Chinese Migrants","Economic Networks","Ghana Trade Sector","Market Entry","Senegal Trade Sector"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-4CBA4720049AD2C5D562EC8768E360E7"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1017/S0001972013000491","version":"Published Version"}],"org":[{"affno":"1","country":"de","key":"german institute of global and area studies","loc":["Germany","Europe, EU","OECD"],"name":"German Institute of Global and Area Studies","used":1},{"affno":2,"key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"ITU IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["ITU IT University of Copenhagen"],"nora_code":"DI-U-ITU"}],"person":[{"affno":"","corresponding":null,"first":"Alena","key":"thielpau","last":"Thiel","locid":"f240d002-893f-45bd-b9ad-6a6ddc015e40","name":"Thiel, Alena","orcid":"0000-0002-1092-1140","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Laurence","key":"marfaingpau","last":"Marfaing","name":"Marfaing, Laurence","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1017/s0001972013000491","issn":["00019720","17500184"],"issue":"4","journal":"Africa - Journal of the International African Institute","pages":"646-669","publisher":"Cambridge University Press","status":"p","title":"Africa - Journal of the International African Institute","title_org":"Africa: Journal of the International African Institute","volume":"83"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","ITU IT University of Copenhagen"],"PST":["Published"]},"sid":["itu-db92d274-b32d-4698-aa22-f0cc64f81b81"],"src":["ITU IT University of Copenhagen"],"title":"The Impact of Chinese Business on Market Entry in Ghana and Senegal.","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-828181","year":"2013","yearsub":"2013"}
