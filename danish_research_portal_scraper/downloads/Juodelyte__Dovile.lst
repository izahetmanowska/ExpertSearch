672-9acb465f15c0","name":"Cheplygina, Veronika","orcid":"0000-0003-0176-9324","rank":29,"rolecode":"pau"}],"pub":{"doi":"10.1145/3715275.3732035","eisbn":["9798400714825"],"isbn":["9798400714825"],"pages":"511-531","place":"New York","publisher":"Association for Computing Machinery","status":"p","title":"FAccT '25: Proceedings of the 2025 ACM Conference on Fairness, Accountability, and Transparency"},"review":"Peer Reviewed","scoID":["2-s2.0-105010824939"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Private Research","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Hospitals","IT University of Copenhagen","Miscellaneous","Other Companies","Other Research","Private Research","Technical University of Denmark","Universities","University of Copenhagen","University of Southern Denmark","cerebriu a/s"],"PST":["Published"]},"sid":["dtu-17300733-27d0-4a80-9463-bb7804f00f5b","itu-fa7d9628-df39-4c9c-a3cb-12c4d097b590","ku-c7de5a91-821f-4f98-9538-a2ede6e17660"],"src":["DTU Technical University of Denmark","ITU IT University of Copenhagen","KU University of Copenhagen"],"title":"In the Picture : Medical Imaging Datasets, Artifacts, and their Living Review","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-088.78-822814","year":"2025","yearsub":"2025"}
{"abstract":"Datasets play a critical role in medical imaging research, yet issues such as label quality, shortcuts, and metadata are often overlooked. This lack of attention may harm the generalizability of algorithms and, consequently, negatively impact patient outcomes. While existing medical imaging literature reviews mostly focus on machine learning (ML) methods, with only a few focusing on datasets for specific applications, these reviews remain static -- they are published once and not updated thereafter. This fails to account for emerging evidence, such as biases, shortcuts, and additional annotations that other researchers may contribute after the dataset is published. We refer to these newly discovered findings of datasets as research artifacts. To address this gap, we propose a living review that continuously tracks public datasets and their associated research artifacts across multiple medical imaging applications. Our approach includes a framework for the living review to monitor data documentation artifacts, and an SQL database to visualize the citation relationships between research artifact and dataset. Lastly, we discuss key considerations for creating medical imaging datasets, review best practices for data annotation, discuss the significance of shortcuts and demographic diversity, and emphasize the importance of managing datasets throughout their entire lifecycle. Our demo is publicly available at this http URL.","author_count":29,"contributors":["Jiménez-Sánchez, Amelia","Avlona, Natalia Rozalia","Boer, Sarah de","Campello, Víctor M.","Feragen, Aasa","Ferrante, Enzo","Ganz, Melanie","Gichoya, Judy Wawira","González, Camila","Groefsema, Steff","Hering, Alessa","Hulman, Adam","Joskowicz, Leo","Juodelyte, Dovile","Kandemir, Melih","Kooi, Thijs","Lérida, Jorge del Pozo","Li, Livie Yumeng","Pacheco, Andre","Rädsch, Tim","Reyes, Mauricio","Sourget, Théo","Ginneken, Bram van","Wen, David","Weng, Nina","Xu, Jack Junchi","Zajac, Hubert Dariusz","Zuluaga, Maria A.","Cheplygina, Veronika"],"cuid":["S01-000.00-799232"],"filters":{"added":"2025-04","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","America, South","Asia, East","Asia, Middle East","Europe, EU","Europe, Non-EU","OECD"],"country":["Argentina","Brazil","France","Germany","Israel","Netherlands","South Korea","Spain","Switzerland","United Kingdom","United States"],"glorg":["All Global Affiliations","EURECOM","Emory University","Hebrew University of Jerusalem","Heidelberg University ","Lunit, Inc.","Radboud University Nijmegen","Stanford University","Universidad de Buenos Aires","Universidade Federal do Espírito Santo","University of Barcelona","University of Bern","University of Groningen","University of Oxford"],"keyword":["cs AI","cs CV","eess IV"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-STENO"],"U":["DI-U-ALL","DI-U-AU","DI-U-DTU","DI-U-ITU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-STENO","DI-U-AU","DI-U-DTU","DI-U-ITU","DI-U-KU","DI-U-SDU"]},"review":"und","rtype":["clu"],"sorti":"in the picture medical imaging datasets artifacts and their living review","src":["ku"],"src-code":["DI-U-KU"],"type":"dw","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-SA","type":"doi","url":"https://doi.org/10.48550/arXiv.2501.1072","version":"Published Version"},"id":"S01-000.00-799232","ids":["ku-34ae77df-0e2d-4fa6-8f92-0e59375ceb5e"],"keyword":["cs.AI","cs.CV","eess.IV"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-5CCD82EA77EEC105FA58E8774B9A24DF"],"oa_link":[{"access":"oa","license":"CC BY-NC-SA","type":"doi","url":"https://doi.org/10.48550/arXiv.2501.1072","version":"Published Version"},{"access":"oa","license":"CC BY-NC-SA","type":"loc","url":"https://curis.ku.dk/ws/files/427187240/250