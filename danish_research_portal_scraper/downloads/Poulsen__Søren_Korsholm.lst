0002-7761-5156","rank":47,"rolecode":"pau"},{"affno":"16","corresponding":null,"country":"dk","first":"A.","key":"valentiniapau","last":"Valentini","locid":"145b39e0-1b84-4d4d-8143-28930649856a","name":"Valentini, A.","rank":48,"rolecode":"pau"},{"affno":"16","corresponding":null,"country":"dk","first":"T.","key":"verdiertpau","last":"Verdier","locid":"b03e7c15-4650-45b0-b64e-03ceabe0c7ff","name":"Verdier, T.","rank":49,"rolecode":"pau"},{"affno":"16","corresponding":null,"country":"dk","first":"M.","key":"wiesenbergermpau","last":"Wiesenberger","locid":"8c5c1c55-1300-4a61-8eb1-1e0a49eabe9e","name":"Wiesenberger, M.","orcid":"0000-0002-5921-0163","rank":50,"rolecode":"pau"}],"pub":{"doi":"10.1088/1741-4326/ad2be4","issn":["00295515","10185577"],"issn_org":["00295515"],"issue":"11","journal":"Nuclear Fusion","paperid":"112019","publisher":"IOP Publishing","status":"p","title":"Nuclear Fusion","volume":"64"},"review":"Peer Reviewed","scoID":["2-s2.0-85202295883"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-841665ba-3e49-4f90-bc6b-5448f1d5b4de"],"src":["DTU Technical University of Denmark"],"title":"Overview of the EUROfusion Tokamak Exploitation programme in support of ITER and DEMO","type":"Journal Review","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-789113","year":"2024","yearsub":"2024"}
{"abstract":"The measurement of the energy spectra and densities of α-particles and other fast ions are part of the ITER measurement requirements, highlighting the importance of energy-resolved energetic-particle measurements for the mission of ITER. However, it has been found in recent years that the velocity-space interrogation regions of the foreseen energetic-particle diagnostics do not allow these measurements directly. We will demonstrate this for γ-ray spectroscopy (GRS), collective Thomson scattering (CTS), neutron emission spectroscopy and fast-ion Dα spectroscopy by invoking energy and momentum conservation in each case, highlighting analogies and differences between the different diagnostic velocity-space sensitivities. Nevertheless, energy spectra and densities can be inferred by velocity-space tomography which we demonstrate using measurements at JET and ASDEX Upgrade. The measured energy spectra agree well with corresponding simulations. At ITER, α-particle energy spectra and densities can be inferred for energies larger than 1.7 MeV by velocity-space tomography based on GRS and CTS. Further, assuming isotropy of the α-particles in velocity space, their energy spectra and densities can be inferred by 1D inversion of spectral single-detector measurements down to about 300 keV by CTS. The α-particle density can also be found by fitting a model to the CTS measurements assuming the α-particle distribution to be an isotropic slowing-down distribution.","author_count":15,"contributors":["Salewski, Mirko","Nocente, M.","Madsen, B.","Abramovic, I.","Gorini, G.","Jacobsen, A. S.","Kiptily, V.","Korsholm, Søren Bang","Moseev, Dmitry","Nielsen, Stefan Kragh","Poulsen, Andreas Feldt Lomholt","Rasmussen, Jesper","Tardocchi, M.","Geiger, B.","Eriksson, J."],"cuid":["S01-000.00-368255"],"event":{"end":"2018-10-05","place":"Rome, it","start":"2018-10-03","title":"5th International Conference Frontiers in Diagnostcs Technologies","year":"2018"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","Nordic","OECD"],"corpau":["ASDEX Upgrade Team","EUROfusion MST1 Team"],"corresponding_author":["Salewski, Mirko"],"country":["Germany","Italy","Netherlands","Sweden","United Kingdom"],"glorg":["All Global Affiliations","Eindhoven University of Technology","Max Planck Institute for Plasma Physics","National Research Council of Italy","United Kingdom Atomic Energy Authority","University of Milan - Bicocca","Uppsala University"],"keyword":["Nuclear instruments and methods for hot plasma diagnostics"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"diagnostic of fast ion energy spectra and densities in magnetized plasmas","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/196393678/salewski2019jinst.pdf","version":"Authors Final Version"},"id":"S01-000.00-368255","identifier":[{"id":"85069593661","type":"scopus"}],"ids":["dtu-d537f6f3-3b9a-49f6-a037-06359623c282"],"keyword":["Computed Radiography (CR)","Computerized Tomography (TG)","Nuclear instruments and methods for hot plasma diagnostics"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-5BF2E5344130897D7CFA2BAB9B227FCD"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/196393678/salewski2019jinst.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Physics"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"it","key":"university of milan bicocca","loc":["Italy","Europe, EU","OECD"],"name":"University of Milan - Bicocca","used":1},{"affno":"3","country":"nl","key":"eindhoven university of technology","loc":["Netherlands","Europe, EU","OECD"],"name":"Eindhoven University of Technology","used":1},{"affno":"4","country":"gb","key":"united kingdom atomic energy authority","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"United Kingdom Atomic Energy Authority","used":1},{"affno":"5","country":"de","key":"max planck institute for plasma physics","loc":["Germany","Europe, EU","OECD"],"name":"Max Planck Institute for Plasma Physics","used":1},{"affno":"6","country":"it","key":"national research council of italy","loc":["Italy","Europe, EU","OECD"],"name":"National Research Council of Italy","used":1},{"affno":"7","country":"se","key":"uppsala university","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Uppsala University","used":1},{"affno":8,"key":"asdex upgrade team","name":"ASDEX Upgrade Team","role":"oau"},{"affno":9,"key":"eurofusion mst1 team","name":"EUROfusion MST1 Team","role":"oau"}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Mirko","key":"salewskipau","last":"Salewski","locid":"38100e3a-6385-47d3-aa2d-6fc5608a8649","name":"Salewski, Mirko","orcid":"0000-0002-3699-679X","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"M.","key":"nocentepau","last":"Nocente","name":"Nocente, M.","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Birgitte","key":"madsenpau","last":"Madsen","locid":"240b6b8f-eb88-4547-8752-d9471e4bca4d","name":"Madsen, B.","name_org":"Madsen, Birgitte","orcid":"0000-0001-5716-467X","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"I.","key":"abra