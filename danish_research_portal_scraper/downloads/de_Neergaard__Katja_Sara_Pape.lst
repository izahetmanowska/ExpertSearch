CD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen, Faculty of Theology"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"dk","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Nicholas Thomas","key":"leepau","last":"Lee","locid":"f3163feb-5344-473c-aa07-5f570bb7edaa","name":"Lee, Nicholas Thomas","orcid":"0000-0002-2725-4890","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Anne-Milla Wichmann","key":"kristensenpau","last":"Kristensen","name":"Kristensen, Anne-Milla Wichmann","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Katja Sara Pape","key":"deneergaardpau","last":"de Neergaard","name":"de Neergaard, Katja Sara Pape","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Katrine Rønsig","key":"larsenpau","last":"Larsen","name":"Larsen, Katrine Rønsig","rank":4,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Artistic Higher Education Institutions","All Danish Affiliations","All Universities","Artistic Higher Education Institutions","DI-ALL","DI-ART","DI-ART-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["arkc-7748b90b-0ec0-42f8-947a-b0bc43e39129","arkc-9444ee3e-175d-4b20-a0fa-ac7250a830bc"],"src":["Royal Danish Academy - Architecture, Design, Conservation"],"title":"STAY HOME 2022 : If These Walls Could Speak Exhibit","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-093.94-012418","year":"2022","yearsub":"2022"}
{"abstract":"What does lockdown sound like? ‘If These Walls Could Speak’ explores the multifaceted experiences of the home during the Corona pandemic through a spatial and auditory installation. Visitors are invited to take a seat in the installation and listen to the walls. Three consecutive soundscapes, which explore three aspects of being at home during the pandemic, are echoed through the whispering wall. The soundscapes are made of fragments from an archive of audio recordings from the first lockdown documenting individuals’ experiences. The installation encourages reflections on the messy, composite, and nuanced experiences of the home during the pandemic, to call for considerations on future domestic practices. The installation is developed by the STAY HOME research project, in which architects, theologians, historians as well as science and technology scholars collaborate to investigate the home during the pandemic.","author_count":4,"contributors":["Lee, Nicholas Thomas","Kristensen, Anne-Milla Wichmann","de Neergaard, Katja Sara Pape","Larsen, Katrine Rønsig"],"cuid":["S01-000.00-128780"],"event":{"end":"2023-03-23","place":"København, dk","start":"2022-09-15","title":"Behavior/Welfare","year":"2022"},"filters":{"added":"2023-02","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-ART","DI-U"],"level3":{"ART":["DI-ART-ALL","DI-ART-RDKA"],"U":["DI-U-ALL","DI-U-ITU","DI-U-KU"]},"level3all":["DI-ART-RDKA","DI-U-ITU","DI-U-KU"]},"review":"nr","rtype":["clu"],"sorti":"if these walls could speak","src":["arkc"],"src-code":["DI-ART-RDKA"],"type":"dnt","type-grp":["all","pub"]},"id":"S01-000.00-128780","ids":["arkc-fa0a07fc-807f-4558-b885-0544343ddfc6"],"keyword":["Yes"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-FE84A799EEF8E9BCB2E10D2B9A5BF078"],"org":[{"affno":"1","key":"royal danish academy