ospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, The Department of Cardiovascular Surgery","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Allan Vestergaard","key":"danielsenpau","last":"Danielsen","locid":"62558cbd-9413-448b-bd5b-3b5757700912","name":"Danielsen, Allan Vestergaard","orcid":"0000-0002-3025-7873","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jan Jesper","key":"andreasenpau","last":"Andreasen","locid":"64f82f01-dc7b-4ed4-873a-940774d8921e","name":"Andreasen, Jan Jesper","orcid":"0000-0002-2382-3734","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Birthe","key":"dinesenpau","last":"Dinesen","locid":"22de2dad-03e3-4bc9-8d55-94736e7d5941","name":"Dinesen, Birthe","orcid":"0000-0001-5893-9676","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"John","key":"hansenpau","last":"Hansen","locid":"ae89da32-d0ea-4a39-8295-a7cc351013f6","name":"Hansen, John","orcid":"0000-0003-4989-8117","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kristian Kjær-Staal","key":"petersenpau","last":"Petersen","locid":"03b38a92-c53c-4b31-a786-05e4893a3e14","name":"Petersen, Kristian Kjær","name_org":"Petersen, Kristian Kjær-Staal","orcid":"0000-0003-4506-000X","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Carsten","key":"simonsenpau","last":"Simonsen","locid":"3dd5ccae-c8de-43a9-bbaf-37118d8cc1f5","name":"Simonsen, Carsten","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lars","key":"arendtnielsenpau","last":"Arendt-Nielsen","locid":"1794f9ec-22f1-47af-96c1-88c23c3b06a2","name":"Arendt-Nielsen, Lars","orcid":"0000-0003-0892-1579","rank":7,"rolecode":"pau"}],"pmid":["38683178"],"pub":{"doi":"10.1515/sjpain-2024-0021","issn":["18778860","18778879"],"issn_org":["18778860"],"issue":"1","journal":"Scandinavian Journal of Pain","publisher":"De Gruyter Mouton","status":"p","title":"Scandinavian Journal of Pain","volume":"24"},"review":"Peer Reviewed","scoID":["2-s2.0-85191695003"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-aa6a36ae-ac32-48db-838a-0cb5c2aa84a1"],"src":["AAU Aalborg University"],"title":"Corrigendum to \"Chronic post-thoracotomy pain after lung cancer surgery : a prospective study of preoperative risk factors\"","type":"Journal Comment","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-736236","year":"2024","yearsub":"2024"}
{"abstract":"Background: Inguinal hernia repair is a frequently performed surgical procedure, with laparoscopic repair emerging as the preferred approach due to its lower complication rate and faster recovery compared to open repair. Mesh-based tension-free repair is the gold standard for both methods. In recent years, robotic hernia repair has been introduced as an alternative to laparoscopic repair, offering advantages such as decreased postoperative pain and improved ergonomics. This study aims to compare the short- and long-term outcomes, including the surgical stress response, postoperative complications, quality of life, and sexual function, between robotic-assisted transabdominal preperitoneal (rTAPP) and laparoscopic TAPP inguinal hernia repairs. Methods: This randomized controlled trial will involve 150 patients from the Surgical Department of the University Hospital of Southern Denmark, randomized to undergo either rTAPP or laparoscopic TAPP. Surgical stress will be quantified by measuring C-reactive protein (CRP) and cytokine levels. Secondary outcomes include complication rates, quality of life, sexual function, and operative times. Data analysis will adhere to the intention-to-treat principle and will be conducted once all patient data are collected, with outcomes assessed at various postoperative intervals. Discussion: This study holds significance in evaluating the potential advantages of robotic-assisted surgery in the context of inguinal hernia repairs. It is hypothesized that rTAPP will result in a lower surgical stress response and potentially lower the risk of postoperative complications compared to conventional laparoscopic TAPP. The implications of this research could influence future surgical practices and guidelines, with a focus on patient recovery and healthcare costs. The findings of this study will contribute to the ongoing discourse surrounding the utilization of robotic systems in surgery, potentially advocating for their broader implementation if the benefits are substantiated. Trial registration: ClinicalTrials.gov NCT05839587. Retrospectively registered on 28 February 2023.","author_count":9,"contributors":["Valorenzos, Alexandros Valsamidis","Nielsen, Kristian Als","Kaiser, Karsten","Helligsø, Per","Ellebæk, Mark Bremholm","Dorfelt, Allan","Petersen, Sofie Ronja","Pedersen, Andreas Kristian","Nielsen, Michael Festersen"],"cuid":["S01-000.00-760952"],"filters":{"added":"2024-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Valorenzos, Alexandros Valsamidis"],"keyword":["C Reactive Protein analysis","Cytokines blood","Denmark","Hernia","Hernia Inguinal surgery","Herniorrhaphy methods","Humans","Inflammation","Inguinal","Laparoscopy adverse effects","Male","Postoperative Complications etiology","Prospective Studies","Quality of Life","Randomized Controlled Trials as Topic","Robotic Surgical Procedures","Robotic Surgical Procedures adverse effects","Time Factors","Treatment Outcome"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"short term outcomes and inflammatory stress response following laparoscopy or robotic assisted transabdominal preperitoneal inguinal hernia repair tapp study protocol for a prospective randomized trial rolais","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s13063-024-08361-w","version":"Published Version"},"id":"S01-000.00-760952","identifier":[{"id":"85200833231","type":"scopus"},{"id":"39118135","type":"pmid"},{"id":"PMC11308711","type":"pmcid"}],"ids":["sdu-56fedbe5-1d16-40f7-9219-94007e0e4b53"],"keyword":["Anatomical","C-Reactive Protein/analysis","Cytokines/blood","Denmark","Hernia","Hernia, Inguinal/surgery","Herniorrhaphy/methods","Humans","Inflammation","Inguinal","Laparoscopy/adverse effects","Male","Pathological conditions","Postoperative Complications/etiology","Prospective Studies","Quality of Life","Randomized Controlled Trials as Topic","Robotic Surgical Procedures/adverse effects","Robotic surgical procedures","Time Factors","Treatment Outcome"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-6380C36E91F6674281B577666340B417"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/268949795/s13063-024-08361-w.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s13063-024-08361-w","version":"Published Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Regional Health Research","SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS - Hospital Sønderjylland","SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS - Hospital Sønderjylland, Research Unit of Surgery (Aabenraa)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Alexandros Valsamidis","key":"valorenzosalexandrosvalsamidispau","last":"Valorenzos","locid":"b5de0d16-416c-4477-8aa7-68d3bb6c56f8","name":"Valorenzos, Alexandros Valsamidis","orcid":"0000-0002-0249-3406","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kristian Als","key":"nielsenkristianalspau","last":"Nielsen","locid":"cca6d806-ac35-46c7-aa9b-960ec6b87f0f","name":"Nielsen, Kristian Als","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Karsten","key":"kaiserkarstenpau","last":"Kaiser",