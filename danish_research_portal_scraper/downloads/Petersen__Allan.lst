ors område"],"nora_code":"DI-UC-KP","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Steen","key":"christiansenpau","last":"Christiansen","name":"Christiansen, Steen","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Carsten","key":"längerichpau","last":"Längerich","name":"Längerich, Carsten","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Stefan Bille","key":"hermannpau","last":"Hermann","locid":"7e41e78c-f10d-4daf-87b6-2bc29375bae6","name":"Hermann, Stefan","name_org":"Hermann, Stefan Bille","orcid":"0000-0001-9024-4401","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jeppe Rosengård","key":"poulsenpau","last":"Poulsen","name":"Poulsen, Jeppe Rosengård","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Kim Allan","key":"petersenpau","last":"Petersen","locid":"e02b3b0e-b487-4be1-a4ae-d3dd7ddc8516","name":"Petersen, Kim Allan","rank":5,"rolecode":"pau"}],"pub":{"issn":["16022572"],"newspaper":"Information","status":"p","title":"Information"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Miscellaneous","All University Colleges","DI-ALL","DI-OT","DI-OT-ALL","DI-UC","DI-UC-ALL","KP","Miscellaneous","Other Research","University Colleges"],"PST":["Published"]},"sid":["kp-8180f061-616e-4439-8b5f-e4d8f75c2c63"],"src":["KP University College Copenhagen"],"title":"Rekrutteringskrisen kræver samarbejde og sammenhold","type":"Newspaper Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-677387","year":"2023","yearsub":"2023"}
{"abstract":"This chapter provides a look at the impact of manager ego in business planning and business innovation through the lens of a cognitive and linguistic scheme. The author examines how value creation is directly at risk due to poor leadership because of a managerial ego-need. The author also outlines the hazard areas causing cognitive dissonance due to an inflated ego, and the link to the statistics of failed business modelling and business innovation. The chapter will furthermore look at disruption technologies in business innovation in the scope of a linguistic scheme, relating to the managers ego need, and the detrimental impact to value creation, especially in a disruptive business environment.","author_count":3,"contributors":["Larsson, Allan Folke"],"cuid":["S01-000.00-691508"],"filters":{"added":"2023-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-UC"],"level3":{"UC":["DI-UC-ALL","DI-UC-UCL"]},"level3all":["DI-UC-UCL"]},"review":"pr","rtype":["clu"],"sorti":"why your ego will destroy your business plan the sad truth about business model innovation and planning","src":["ucl"],"src-code":["DI-UC-UCL"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.igi-global.com/newsroom/archive/key-factors-business-model-innovation/5822","version":"Other Version"},"id":"S01-000.00-691508","identifier":[{"id":"85151744367","type":"scopus"}],"ids":["ucl-cfa5178f-f45f-4c5d-83cd-08fcb587e58b"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Global-Local-2-4-126E63E1D01C28A88BAF43E788D5C56E"],"org":[{"affno":"1","key":"ucl university college","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-UCL","l3nl":"UCL University College","l3nn":"UCL University College","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"UCL University College","namevar":["UCL Erhvervsakademi og Professionshøjskole, Direktion, Kompetence- og Organisationsudvikling, Ledelse og Organisation"],"nora_code":"DI-UC-UCL","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Allan Folke","key":"larssonpau","last":"Larsson","locid":"32ab5614-62ca-4e75-b48b-4c61f6a58466","name":"Larsson, Allan Folke","rank":1,"rolecode":"pau"},{"affno":"","first":"Erik Stavnsager","key":"rasmussenpedh","last":"Rasmussen","name":"Rasmussen, Erik Stavnsager","rank":2,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Nikolaj Hannesbo","key":"petersenpedh","last":"Petersen","name":"Petersen, Nikolaj Hannesbo","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["9781668448953"],"pages":"346-352","publisher":"IGI global","status":"p","title":"Handbook of Research on Business Model Innovation Through Disruption and Digitalization"},"review":"Peer Reviewed","scoID":["2-s2.0-85151744367"],"search":{"DAF":["All Danish Affiliations","All University Colleges","DI-ALL","DI-UC","DI-UC-ALL","UCL University College","University Colleges"],"PST":["Published"]},"sid":["ucl-cfa5178f-f45f-4c5d-83cd-08fcb587e58b"],"src":["UCL University College"],"title":"Why Your Ego Will Destroy Your Business Plan: The Sad Truth About Business Model Innovation and Planning","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-691508","year":"2023","yearsub":"2023"}
