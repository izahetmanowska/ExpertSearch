-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Orthopaedic Surgery","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Hoved-Orto","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"cn","key":"university of chinese academy of sciences","loc":["China","Asia, East"],"name":"University of Chinese Academy of Sciences","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Sten","key":"rasmussenpau","last":"Rasmussen","locid":"05d1d595-13be-4295-8ad1-8d29206859c8","name":"Rasmussen, Sten","orcid":"0000-0002-8664-352X","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kristian Kjær-Staal","key":"petersenpau","last":"Petersen","locid":"03b38a92-c53c-4b31-a786-05e4893a3e14","name":"Petersen, Kristian Kjær","name_org":"Petersen, Kristian Kjær-Staal","orcid":"0000-0003-4506-000X","rank":2,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Christopher","key":"aboopau","last":"Aboo","locid":"231dbe9b-9dd3-46c5-86e0-311cda7a37f5","name":"Aboo, Christopher","orcid":"0000-0001-7295-7459","rank":3,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Jacob Skallerup","key":"andersenpau","last":"Andersen","locid":"08c304cd-7865-4f96-9a93-64b48d329321","name":"Andersen, Jacob Skallerup","orcid":"0000-0002-9519-7146","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Emilie","key":"skjoldemosepau","last":"Skjoldemose","locid":"f5a367cb-6a55-4dc4-832e-dd18abea4b5a","name":"Skjoldemose, Emilie","rank":5,"rolecode":"pau"},{"affno":