country":"dk","first":"Allan Schrøder","key":"pedersenpau","last":"Pedersen","locid":"9d94f06f-c5ea-40dd-a915-f7b0f7a68664","name":"Pedersen, Allan Schrøder","orcid":"0000-0003-3709-3194","rank":2,"rolecode":"pau"},{"affno":"","first":"Hans","key":"hvidtfeldtlarsenpedh","last":"Hvidtfeldt Larsen","name":"Hvidtfeldt Larsen, Hans","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Leif","key":"sønderbergpetersenpedh","last":"Sønderberg Petersen","name":"Sønderberg Petersen, Leif","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["9788755039681"],"pages":"18-23","publisher":"Technical University of Denmark","status":"p","subtitle":"Energy storage options for future sustainable energy systems","title":"DTU International Energy Report 2013"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-3e0a3865-dde1-47ec-b86c-02303f837821"],"src":["DTU Technical University of Denmark"],"title":"Energy storage initiatives and strategies","type":"Report Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-323048","year":"2013","yearsub":"2013"}
{"abstract":"Passengers using public transport systems often experience waiting times when transferring between two scheduled services. In this paper we propose a planning approach that seeks to obtain a favourable trade-off between the two contrasting objectives, passenger service and operating cost, by modifying the timetable. The planning approach is referred to as the simultaneous vehicle scheduling and passenger service problem (SVSPSP). The SVSPSP is modelled as an integer programming problem and solved using a large neighborhood search metaheuristic. The proposed framework is tested on data inspired by the express-bus network in the Greater Copenhagen area. The results are encouraging and indicate a potential decrease of passenger transfer waiting times in the network of up to 20%, with the vehicle scheduling costs remaining mostly unaffected.","author_count":5,"contributors":["Petersen, Hanne Løhmann","Larsen, Allan","Madsen, Oli B.G.","Petersen, Bjørn","Røpke, Stefan"],"cuid":["S01-000.00-374534"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Timetabling","Vehicle scheduling"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"the simultaneous vehicle scheduling and passenger service problem","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1287/trsc.1120.0429","version":"Other Version"},"id":"S01-000.00-374534","identifier":[{"id":"84890047147","type":"scopus"}],"ids":["dtu-e9ceb092-7580-4d2d-82fe-46091f1f4132"],"keyword":["Timetabling","large neighborhood search heuristics","vehicle scheduling"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-01F2E283B6DE36CC228E25AFDB7ABA05"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1287/trsc.1120.0429","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Transport","Technical University of Denmark, Department of Transport, Transport optimisation and technique"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Hanne Løhmann","key":"petersenhanneløhmannpau","last":"Petersen","locid":"02e0db26-d08e-4919-a69a-0925e5447720","name":"Petersen, Hanne Løhmann","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Allan","key":"larsenallanpau","last":"Larsen","locid":"f830d213-0db6-43ef-969f-af088d969a4d","name":"Larsen, Allan","orcid":"0000-0002-6647-6832","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Oli B.G.","key":"madsenolibgpau","last":"Madsen","locid":"46a87425-9976-4e61-abec-ff750681e792","name":"Madsen, Oli B.G.","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Bjørn","key":"petersenbjørnpau","last":"Petersen","locid":"606a5e84-33e0-40e0-904f-d12fefaf0819","name":"Petersen, Bjørn","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Stefan","key":"røpkestefanpau","last":"Røpke","locid":"5eeca4c2-19cc-4106-b26e-0d3bc4b9eb4b","name":"Røpke, Stefan","orcid":"0000-0002-6799-9934","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1287/trsc.1120.0429","issn":["00411655","15265447"],"issn_org":["00411655"],"issue":"4","journal":"Transportation Science","pages":"603-616","publisher":"INFORMS Institute for Operations Research and the Management Sciences"