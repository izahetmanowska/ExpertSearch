fno":"1","corresponding":null,"first":"Danjal Hofgaard","key":"hestoypau","last":"Hestoy","locid":"3ef3edcf-7a86-4fc6-87e4-9fd9a7621018","name":"Hestoy, Danjal Hofgaard","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Dan Dupont","key":"hougaardpau","last":"Hougaard","locid":"dc4e3a4e-a143-46a3-a701-224291091564","name":"Hougaard, Dan Dupont","orcid":"0000-0002-4164-1758","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Allan Thomas","key":"højlandpau","last":"Højland","locid":"115e8cf1-489c-4a6b-93c5-11d69d2e0d51","name":"Højland, Allan Thomas","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Michael","key":"gaihedepau","last":"Gaihede","locid":"37de5883-dfe9-4a90-beb2-ffd947c92f6d","name":"Gaihede, Michael","orcid":"0000-0001-6998-2506","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Michael Bjørn","key":"petersenpau","last":"Petersen","locid":"8512b77d-bdf2-4889-bda3-d399e6867e28","name":"Petersen, Michael Bjørn","orcid":"0000-0003-0316-8207","rank":5,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-f6775f60-50bc-4b26-91a1-cae54b331499"],"src":["AAU Aalborg University"],"title":"Audiological and vestibular pathologies in subjects harbouring the mtDNA mutation A3243G","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-121669","year":"2017","yearsub":"2017"}
{"abstract":"AIMS: In vitro studies have demonstrated that formation of reactive oxygen species (ROS) contributes to the effect of bactericidal antibiotics. The formation of ROS is not restricted to bacteria, but also occurs in mammalian cells. Oxidative stress is linked to several diseases. This study investigates whether antibiotic drugs induce oxidative stress in healthy humans as a possible mechanism for adverse reactions to the antibiotic drugs. METHODS: This study contains information from two randomised, controlled trials. Participants underwent one-week treatment with clarithromycin, trimethoprim, phenoxymethylpenicillin (penicillin V), or placebo. Oxidative modifications were measured as 24-hour urinary excretion of 8-oxo-7,8-dihydro-2'-deoxyguanosine (8-oxodG), 8-oxo-7,8-dihydroguanosine (8-oxoGuo), and plasma levels of malondialdehyde (MDA) before and after treatment as a measurement of DNA oxidation, RNA oxidation, and lipid peroxidation, respectively. RESULTS: Clarithromycin significantly increased urinary excretion of 8-oxodG by 22.0 % (95% CI: 3.6-40.4 %) and 8-oxoGuo by 14.9 % (95% CI: 3.7-26.1 %), which could be a possible mechanism to some of its adverse reactions. Further, we demonstrated that trimethoprim significantly lowered urinary excretion of 8-oxodG by 21.7 % (95% CI: 5.8-37.6 %), but did not influence urinary excretion of 8-oxoGuo. Penicillin V did not influence urinary excretion of 8-oxodG or 8-oxoGuo. None of the antibiotic drugs influenced plasma levels of MDA. CONCLUSION: Clarithromycin significantly increases oxidative nucleic acid modifications. Increased oxidative modifications might explain some of clarithromycin's known adverse reactions. Trimethoprim significantly lowers DNA oxidation but not RNA oxidation. Penicillin V had no effect on oxidative nucleic acid modifications.","author_count":15,"contributors":["Larsen, Emil List","Cejvanovic, Vanja","Kjaer, Laura Kofoed","Pedersen, Morten Thorup","Popik, Sara Daugaard","Hansen, Lina Kallehave","Andersen, Jon Traerup","Jimenez-Solem, Espen","Broedbaek, Kasper","Petersen, Morten","Weimann, Allan","Henriksen, Trine Brink","Lykkesfeldt, Jens","Torp-Pedersen, Christian","Poulsen, Henrik Enghusen"],"cuid":["S02-097.25-008444"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"keyword":["8 Oxo 7","8 dihydro 2 deoxyguanosine","8 dihydroguanosine","Antibiotics","DNA oxidation","Oxidative stress","RNA oxidation"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Department of Clinical Pharmacology, Bispebjerg Frederiksberg Hospital, University of Copenhagen, Copenhagen, Denmark."],"U":["DI-U-AAU","DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-AAU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"clarithromycin trimethoprim and penicillin and oxidative nucleic acid modifications in humans randomised controlled trials","src":["aau","ku"],"src-code":["DI-U-AAU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S02-097.25-008444","identifier":[{"id":"85016207441","type":"scopus"},{"id":"28185274","type":"pmid"},{"id":"PMC5510073","type":"pmcid"},{"id":"000405545300006","type":"wos"}],"ids":["aau-af3b16bb-514c-428e-b38e-d2995113f576","ku-a5fee9a9-9db7-41f7-af01-013697b6dd21"],"keyword":["8-dihydro-2-deoxyguanosine","8-dihydroguanosine","8-oxo-7","DNA oxidation","RNA oxidation","antibiotics","oxidative stress"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-2F43DA5BC93667A1869693570B37CECA"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Department of Clinical Pharmacology, Bispebjerg Frederiksberg Hospital, University of Copenhagen, Copenhagen, Denmark."],"nora_code":"DI-OT","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"3","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Public Health and Epidemiology"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Emil List","key":"larsenpau","last":"Larsen","name":"Larsen, Emil List","rank":1,"rolecode":"pau"},{"affno":"2","first":"Vanja","key":"cejvanovicpau","last":"Cejvanovic","locid":"6f76a562-9452-432b-9e1e-3907f1cf81fa","name":"Cejvanovic, Vanja","rank":2,"rolecode":"pau"},{"affno":"","first":"Laura Kofoed","key":"kjærpau","last":"Kjær","name":"Kjær, Laura Kofoed","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Morten Thorup","key":"pedersenpau","last":"Pedersen","name":"Pedersen, Morten Thorup","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sara Daugaard","key":"popikpau","last":"Popik","name":"Popik, Sara Daugaard","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lina Kallehave","key":"hansenpau","last":"Hansen","name":"Hansen, Lina Kallehave","rank":6,"rolecode":"pau"},{"affno":"2","first":"Jon Thor Trærup","key":"andersenpau","last":"Andersen","locid":"2fe4a9af-2462-4bba-8df4-2a518ea59342","name":"Andersen, Jon Trærup","name_org":"Andersen, Jon Thor Trærup","rank":7,"rolecode":"pau"},{"affno":"2","first":"Espen Victor Jimenez","key":"solempau","last":"Solem","locid":"683c5d73-a774-4aba-978d-da52ea4a866c","name":"Jimenez-Solem, Espen","name_org":"Solem, Espen Victor Jimenez","orcid":"0000-0002-3777-147X","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kasper","key":"broedbaekpau","last":"Broedbaek","name":"Broedbaek, Kasper","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Morten","key":"petersenpau","last":"Petersen","name":"Petersen, Morten","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Allan","key":"weimannpau","last":"Weimann","name":"Weimann, Allan","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Trine Brink","key":"henriksenpau","last":"Henriksen","name":"Henriksen, Trine Brink","rank":12,"rolecode":"pau"},{"affno":"2 1","first":"Jens","key":"lykkesfeldtpau","last":"Lykkesfeldt","locid":"6e71ebed-c114-42ab-9ae9-6333f14bf8ad","name":"Lykkesfeldt, Jens","orcid":"0000-0002-6514-8407","rank":13,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Christian","key":"torppedersenpau","last":"Torp-Pedersen","locid":"5417d806-0578-4505-b3fe-68ae0359913e","name":"Torp-Pedersen, Christian","rank":14,"rolecode":"pau"},{"affno":"2","first":"Henrik Enghusen","key":"poulsenpau","last":"Poulsen","locid":"8fb54acd-3a26-48f0-9111-b8e5535a0431","name":"Poulsen, Henrik Enghusen","rank":15,"rolecode":"pau"}],"pmid":["28185274"],"pub":{"doi":"10.1111/bcp.13261","issn":["02643774","03065251"],"issn_org":["03065251"],"issue":"8","journal":"British Journal of Clinical Pharmacology","pages":"1643-1653","publisher":"Wiley-Blackwell","status":"p","title":"British Journal of Clinical Pharmacology","volume":"83"},"review":"Peer Reviewed","scoID":["2-s2.0-85016207441"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["aau-af3b16bb-514c-428e-b38e-d2995113f576","ku-a5fee9a9-9db7-41f7-af01-013697b6dd21"],"src":["AAU Aalborg University","KU University of Copenhagen"],"title":"Clarithromycin, trimethoprim, and penicillin and oxidative nucleic acid modifications in humans : randomised, controlled trials","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-097.25-008444","year":"2017","yearsub":"2017"}
{"abstract":"In connection with the publication of a clinical practice guideline on the management of low back pain (LBP) in general practice in Denmark, a cluster randomised controlled trial was conducted. In this trial, a multifaceted guideline implementation strategy to improve general practitioners' treatment of patients with LBP was compared with a usual implementation strategy. The aim was to determine whether the multifaceted strategy was cost effective, as compared with the usual implementation strategy. The economic evaluation was conducted as a cost-utility analysis where cost collected from a societal perspective and quality-adjusted life years were used as outcome measures. The analysis was conducted as a within-trial analysis with a 12-month time horizon consistent with the follow-up period of the clinical trial. To adjust for a priori selected covariates, generalised linear models with a gamma family were used to estimate incremental costs and quality-adjusted life years. Furthermore, both deterministic and probabilistic sensitivity analyses were conducted. Results showed that costs associated with primary health care were higher, whereas secondary health care costs were lower for the intervention group when compared with the control group. When adjusting for covariates, the intervention was less costly, and there was no significant difference in effect between the 2 groups. Sensitivity analyses showed that results were sensitive to uncertainty. In conclusion, the multifaceted implementation strategy was cost saving when compared with the usual strategy for implementing LBP clinical practice guidelines in general practice. Furthermore, there was no significant difference in effect, and the estimate was sensitive to uncertainty.","author_count":5,"contributors":["Jensen, Cathrine Elgaard","Riis, Allan","Petersen, Karin Dam","Jensen, Martin Bach","Pedersen, Kjeld Møller"],"cuid":["S02-099.48-010470"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"corresponding_author":["Jensen, Cathrine Elgaard"],"keyword":["Clinical practice guideline","Cost utility analysis","Economic evaluation","Implementation","Low back pain"],"level":"sci","mra":["soc"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-AAU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"economic evaluation of an implementation strategy for the management of low back pain in general practice","src":["aau","sdu"],"src-code":["DI-U-AAU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85021309181","version":"Other Version"},"id":"S02-099.48-010470","identifier":[{"id":"000402430600016","type":"wos"},{"id":"28114182","type":"pmid"},{"id":"85021309181","type":"scopus"}],"ids":["aau-db914971-7beb-410a-a2c1-a6c406d3b6c3","sdu-6d8bdc53-0c35-4992-ab02-8f480f6d1378"],"keyword":["Clinical practice guideline","Cost-utility analysis","Economic evaluation","Implementation","Low back pain"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-5-E3A9300300C3BF3D5CE9D2205440290A"],"oai":{"class":"Unused","mra":["Social Science (SOC)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Social Sciences","Aalborg University, The Faculty of Social Sciences, Department of Business and Management","Aalborg University, The Faculty of Social Sciences, Department of Business and Management, Danish Center for Healthcare Improvements (Business)"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","key":"sdu university of souther