r":["Københavns Universitet, Faculty of Life Sciences, Department of Human Nutrition, Prevention and Treatment of Obesity and Appetite and Energy Metabolism"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","first":"Søren S.","key":"lundpau","last":"Lund","name":"Lund, Søren S.","rank":1,"rolecode":"pau"},{"affno":"2","first":"Martin","key":"petersenpau","last":"Petersen","locid":"c7a49d09-c62b-403d-b0a5-6b5abcb3975e","name":"Petersen, Martin","rank":2,"rolecode":"pau"},{"affno":"1","first":"Merete","key":"frandsenpau","last":"Frandsen","name":"Frandsen, Merete","rank":3,"rolecode":"pau"},{"affno":"1","first":"Ulla M.","key":"smidtpau","last":"Smidt","name":"Smidt, Ulla M.","rank":4,"rolecode":"pau"},{"affno":"3","first":"Hans-Henrik","key":"parvingpau","last":"Parving","name":"Parving, Hans-Henrik","rank":5,"rolecode":"pau"},{"affno":"1","first":"Allan A.","key":"vaagpau","last":"Vaag","name":"Vaag, Allan A.","rank":6,"rolecode":"pau"},{"affno":"1","first":"Tonny","key":"jensenpau","last":"Jensen","name":"Jensen, Tonny","rank":7,"rolecode":"pau"}],"pmid":["20947697"],"pub":{"doi":"10.1373/clinchem.2009.133868","issn":["00099147","15308561"],"issn_org":["00099147"],"issue":"2","journal":"Clinical Chemistry","pages":"298-308","status":"p","title":"Clinical Chemistry","volume":"57"},"review":"Peer Reviewed","scoID":["2-s2.0-79551562610"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-ae4843a0-c7f2-41cf-a182-cf429b6e08b5"],"src":["KU University of Copenhagen"],"title":"Agreement between fasting and postprandial LDL cholesterol measured with 3 methods in patients with type 2 diabetes mellitus","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-497539","year":"2011","yearsub":"2011"}
{"abstract":"OBJECTIVE We tested whether long-term treatment with the angiotensin II receptor antagonist irbesartan reduces nucleic acid oxidation in patients with type 2 diabetes and microalbuminuria. RESEARCH DESIGN AND METHODS The Irbesartan in Patients With Type 2 Diabetes and Microalbuminuria (IRMA 2) study was a 2-year multicenter randomized double-blind trial comparing irbesartan (150 and 300 mg once daily) with placebo. We studied a subgroup of 50 patients where urine samples were available for analysis of albumin and the oxidatively modified guanine nucleosides 8-oxo-7,8-dihydro-2'-deoxyguanosine (8-oxodG) and 8-oxo-7,8-dihydroguanosine (8-oxoGuo). RESULTS During the 2-year trial, no significant differences in 8-oxodG and 8-oxoGuo excretions between placebo and irbesartan treatment were seen. 8-oxodG and albumin excretion decreased with time (P = 0.0004 and P <0.0001, respectively), whereas treatment-related differences were shown for albumin excretion (P = 0.0008) only, as previously reported. Important secondary findings were significant associations between changes in 8-oxodG excretion and changes in albumin excretion and glycated hemoglobin (HbA(1c)). During the study period, 8-oxodG excretion decreased by 3 and 26% in smokers and nonsmokers, respectively (P = 0.015), and urinary albumin excretion decreased 22% in smokers and 58% in nonsmokers (P = 0.011). CONCLUSIONS Irbesartan treatment was not significantly more effective than placebo in reducing nucleic acid oxidation. The results indicate that DNA oxidation in diabetes patients is reduced by various components in the treatment of diabetes where glycemic control seems to be important and addition of angiotensin II receptor antagonists does not lead to any substantial additional reduction. Furthermore, the reductions in DNA oxidation and albumin excretion seem to be counteracted by smoking.","author_count":11,"contributors":["Broedbaek, Kasper","Henriksen, Trine","Weimann, Allan","Petersen, Morten","Andersen, Jon Trærup","Afzal, Shoaib","Jimenez-Solem, Espen","Persson, Frederik","Parving, Hans-Henrik","Rossing, Peter","Poulsen, Henrik Enghusen"],"cuid":["S01-000.00-526264"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"long term effects of irbesartan treatment and smoking on nucleic acid oxidation in patients with type 000000000002 diabetes and microalbuminuria an irbesartan in patients with type 000000000002 diabetes and microalbuminuria irma 000000000002 substudy","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.2337/dc10-2214","version":"Published Version"},"id":"S01-000.00-526264","identifier":[{"id":"21454798","type":"pmid"},{"id":"000290419200025","type":"wos"},{"id":"79956149600","type":"scopus"},{"id":"PMC3114487","type":"pmcid"}],"ids":["ku-de5ad49c-809f-463f-b536-42cdf9bfd048"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-255B93526E403B9BE39450D28EF75FB4"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.2337/dc10-2214","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/208961639/1192.full.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Section of Diagnostic Sciences"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Bispebjerg and Frederiksberg"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"","first":"Kasper","key":"broedbaekpau","last":"Broedbaek","name":"Broedbaek, Kasper","rank":1,"rolecode":"pau"},{"affno":"","first":"Trine","key":"henriksenpau","last":"Henriksen","name":"Henriksen, Trine","rank":2,"rolecode":"pau"},{"affno":"","first":"Allan","key":"weimannpau","last":"Weimann","name":"Weimann, Allan","rank":3,"rolecode":"pau"},{"affno":"","first":"Morten","key":"petersenpau","last":"Petersen","name":"Petersen, Morten","rank":4,"rolecode":"pau"},{"affno":"1","first":"Jon T","key":"andersenpau","last":"Andersen","locid":"2fe4a9af-2462-4bba-8df4-2a518ea59342","name":"Andersen, Jon Trærup","name_org":"Andersen, Jon T","rank":5,"rolecode":"pau"},{"affno":"2","first":"Shoaib","key":"afzalpau","last":"Afzal","name":"Afzal, Shoaib","rank":6,"rolecode":"pau"},{"affno":"2","first":"Espen","key":"jimenezsolempau","last":"Jimenez-Solem","name":"Jimenez-Solem, Espen","rank":7,"rolecode":"pau"},{"affno":"","first":"Frederik","key":"perssonpau","last":"Persson","name":"Persson, Frederik","rank":8,"rolecode":"pau"},{"affno":"","first":"Hans-Henrik","key":"parvingpau","last":"Parving","name":"Parving, Hans-Henrik","rank":9,"rolecode":"pau"},{"affno":"","first":"Peter","key":"rossingpau","last":"Rossing","name":"Rossing, Peter","rank":10,"rolecode":"pau"},{"affno":"1","first":"Henrik E","key":"poulsenpau","last":"Poulsen","locid":"8fb54acd-3a26-48f0-9111-b8e5535a0431","name":"Poulsen, Henrik Enghusen","name_org":"Poulsen, Henrik E","rank":11,"rolecode":"pau"}],"pmid":["21454798"],"pub":{"doi":"10.2337/dc10-2214","issn":["01495992"],"issue":"5","journal":"Diabetes Care","pages":"1192-1198","status":"p","title":"Diabetes Care","volume":"34"},"review":"Peer Reviewed","scoID":["2-s2.0-79956149600"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-de5ad49c-809f-463f-b536-42cdf9bfd048"],"src":["KU University of Copenhagen"],"title":"Long-Term Effects of Irbesartan Treatment and Smoking on Nucleic Acid Oxidation in Patients With Type 2 Diabetes and Microalbuminuria : An Irbesartan in Patients With Type 2 Diabetes and Microalbuminuria (IRMA 2) substudy","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-526264","year":"2011","yearsub":"2011"}
{"abstract":"Background: Little is known about characteristics of patients receiving allergen-specific immunotherapy. Identifying obstacles to appropriate treatment according to guidelines may facilitate the development of strategies aiming at improved treatment of patients with allergic respiratory diseases. The objective of this study was to investigate differences in disease severity, demographic and socioeconomic status between allergic rhinitis patients receiving allergen-specific immunotherapy and allergic rhinitis patients not receiving allergen-specific immunotherapy. Methods: A total of 366 patients were studied of whom 210 were going to receive subcutaneously administrated immunotherapy (SIT) against grass pollen and/or house dust mite allergy. The severity of rhino-conjunctivitis (hay fever) and/or asthma was classified according to international guidelines. The questionnaires included an EQ-5D visual analogue scale instrument and some socio-economic questions. Results: Severity of disease, young age, high level of education as well as greater perceived impairment of health-related quality of life due to allergic symptoms were significantly associated with use of SIT. Somewhat unexpectedly, household income was not associated with use of SIT. Conclusion: Use of SIT was associated with both disease severity measures and educational level, but not income level. These results suggest social inequality as reflected by lower use of SIT among patients with lower educational level may represent an obstacle to treatment with SIT.","author_count":6,"contributors":["Petersen, Karin Dam","Kronborg, Christian","Gyrd-Hansen, Dorte","Dahl, Ronald","Larsen, Jørgen Nedergaard","Lindeberg, Allan"],"cuid":["S01-000.00-601402"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Asthma","Demand","Hay fever","Quality of Life"],"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR"],"OT":["ALD-Abellé, Denmark"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"characteristics of patients receiving allergy vaccination to which extent do socio economic factors play a role","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1093/eurpub/ckq063","version":"Other Version"},"id":"S01-000.00-601402","identifier":[{"id":"79957477707","type":"scopus"},{"id":"20484343","type":"pmid"},{"id":"PMC3098894","type":"pmcid"}],"ids":["sdu-6292a190-64b1-11df-9ac3-000ea68e967b"],"keyword":["Demand","asthma","hay fever","immunological desentization","quality of life"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-3-3-827C2A78F5A9A7A37FEFF7E18B904D92"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1093/eurpub/ckq063","version":"Other Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Business and Social Sciences, Department of Economics, Econometrics and Management Science","SDU, The Faculty of Business and Social Sciences, Department of Economics, FAIRCARE"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1},{"affno":"3","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["ALD-Abellé, Denmark"],"nora_code":"DI-OT","used":1},{"affno":"4","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Glostrup Hospital"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"","corresponding":null,"first":"Karin Dam","key":"petersenpau","last":"Petersen","locid":"e464bbcf-494c-4e24-bdd3-f47b493bcb15","name":"Petersen, Karin Dam","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Christian","key":"kronborgpau","last":"Kronborg","locid":"e1c847eb-046f-4ba6-9f7b-a0d15cd29c40","name":"Kronborg, Christian","orcid":"0000-0001-9627-1419","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Dorte","key":"gyrdhansenpau","last":"Gyrd-Hansen","locid":"0f3f050d-38e8-41c1-b319-76583715073f","name":"Gyrd-Hansen, Dorte","orcid":"0000-0003-1137-2304","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ronald","key":"dahlpau","last":"Dahl","name":"Dahl, Ronald","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jørgen Nedergaard","key":"larsenpau","last":"Larsen","name":"Larsen, Jørgen Nedergaard","rank":5,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Allan","key":"lindebergpau","last":"Lindeberg","name":"Lindeberg, Allan","rank":6,"rolecode":"pau"}],"pmid":["20484343"],"pub":{"doi":"10.1093/eurpub/ckq063","issn":["11011262","1464360X"],"issn_org":["11011262"],"issue":"3","journal":"European Journal of Public Health","pages":"323-328","publisher":"Oxford University Press","status":"p","title":"European Journal of Public Health","volume":"21"},"review":"Peer Reviewed","scoID":["2-s2.0-79957477707"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-6292a190-64b1-11df-9ac3-000ea68e967b"],"src":["SDU University of Southern Denmark"],"title":"Characteristics of patients receiving allergy vaccination: to which extent do socio-economic factors play a role?","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-601402","year":"2011","yearsub":"2010"}
{"abstract":"OBJECTIVE: We analyzed data from a cohort of 1,381 newly diagnosed type 2 diabetic patients to test the hypothesis that urinary markers of nucleic acid oxidation are independent predictors of mortality. RESEARCH DESIGN AND METHODS: We examined the relationship between urinary excretion of markers of DNA oxidation (8-oxo-7,8-dihydro-2'-deoxyguanosine [8-oxodG]) and RNA oxidation (8-oxo-7,8-dihydroguanosine [8-oxoGuo]) and long-term mortality using Cox proportional hazards regression. RESULTS: After multivariate adjustment, the hazard ratios for all-cause and diabetes-related mortality of patients with 8-oxoGuo levels in the highest quartile compared with those in the lowest quartile were 1.44 (1.12-1.85) and 1.54 (1.13-2.10), respectively. Conversely, no significant associations between 8-oxodG and mortality were found in the adjusted analyses. CONCLUSIONS: Urinary excretion of the RNA oxidation marker 8-oxoGuo measured shortly after diagnosis of type 2 diabetes predicts long-term mortality independently of conventional risk factors. This finding suggests that 8-oxoGuo could serve as a new clinical biomarker in diabetes","author_count":23,"contributors":["Broedbaek, Kasper","Siersma, Volkert","Henriksen, T.","Weimann, A.","Petersen, M.","Andersen, J.T.","Jimenez-Solem, E.","Stovgaard, E.S.","Hansen, L.J.","Henriksen, J.E.","Bonnema, Steen Joop","Olivarius, Niels de Fine","Poulsen, H.E."],"cuid":["S02-080.63-666999"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"keyword":["Denmark","Diabetes","Diagnosis","Methods","Mortality","Patient","Patients","Pharmacology","Research","Research Design","Risk","Risk Factors","Support","semrap 2011 3"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"urinary markers of nucleic acid oxidation and long term mortality of newly diagnosed type 000000000002 diabetic patients","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.2337/dc11-1620","version":"Published Version"},"id":"S02-080.63-666999","identifier":[{"id":"84858132328","type":"scopus"},{"id":"21994431","type":"pmid"},{"id":"PMC3220837","type":"pmcid"}],"ids":["ku-ff72b098-b53c-44b9-9172-18cab97e16a3","sdu-45b7c114-a088-47b5-aa17-7752db21ed93"],"keyword":["Denmark","Mortality","PATIENT","Patients","RISK-FACTORS","Research","Research Design","Risk","Support","diabetes","diagnosis","methods","pharmacology","semrap-2011-3"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-C26E3BE37DEBB43DC9E8E375545F9E7F"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.2337/dc11-1620","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, External Centres, Forskningsenheden for Almen Praksis"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Endocrinology (Odense)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","first":"K.","key":"broedbaekkasperpau","last":"Broedbaek","locid":"fd11f672-8791-466e-b4da-418fb8a1db93","name":"Broedbaek, Kasper","name_org":"Broedbaek, K.","rank":1,"rolecode":