ccb","name":"Tommerup, Niels","rank":24,"rolecode":"pau"},{"affno":"1","first":"Iben","key":"bacheibenpau","last":"Bache","locid":"bb160617-68f4-4c3a-aac6-4788391d391e","name":"Bache, Iben","orcid":"0000-0001-7562-8546","rank":25,"rolecode":"pau"}],"pmid":["29805044"],"pub":{"doi":"10.1016/j.ajhg.2018.04.005","issn":["00029297","15376605"],"issn_org":["00029297"],"issue":"6","journal":"American Journal of Human Genetics","pages":"1090-1103","publisher":"Cell Press","status":"p","title":"American Journal of Human Genetics","volume":"102"},"review":"Peer Reviewed","scoID":["2-s2.0-85047187634"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Governmental Institutions","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Miscellaneous","Other Research","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-3ac989e6-79b4-422c-ae3c-b9533476dd29","ku-8b6c5140-7aea-4a66-9eb1-1d604d045a2d","sdu-08ecac69-fde9-4139-b901-1aa493ad4c1d"],"src":["AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Risks and Recommendations in Prenatally Detected De Novo Balanced Chromosomal Rearrangements from Assessment of Long-Term Outcomes","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-100.00-016972","year":"2018","yearsub":"2018"}
{"abstract":"The deoxydehydration (DODH) reaction remains one of the most efficient methods of reducing the oxygen content of biomass while keeping important functionality in place. This reaction is traditionally catalysed by high-valent oxo-rhenium species. Recent research into heterogeneous rhenium-based catalysts for DODH demonstrates their ability to rival and in some cases surpass their homogeneous counterparts. Furthermore, catalysts based on the metals molybdenum and vanadium show great potential as inexpensive alternatives to rhenium catalysts. In this Minireview, we detail the recent developments within the field of DODH with particular emphasis on discoveries outside the realms of rhenium.","author_count":2,"contributors":["Petersen, Allan Robertson","Fristrup, Peter"],"cuid":["S01-000.00-310218"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Biomass","Deoxydehydration","Polyols","Sustainable chemistry"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"new motifs in deoxydehydration beyond the realms of rhenium","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85020536794","version":"Other Version"},"id":"S01-000.00-310218","identifier":[{"id":"28423204","type":"pmid"},{"id":"85020536794","type":"scopus"}],"ids":["dtu-12b9abfa-1214-473f-88b4-fd5642d9f657"],"keyword":["Biomass","Deoxydehydration","Polyols","Sustainable chemistry"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-63671027193FCC29CFD458FABA40789C"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"dtu technical university of denmark",