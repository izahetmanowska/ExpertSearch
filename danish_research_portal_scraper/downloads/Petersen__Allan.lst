sin&s=LOI:S01-000.00-358334","year":"2018","yearsub":"2018"}
{"author_count":3,"contributors":["Petersen, Allan Christian","Sølling, Theis Ivan","Waters, Max D.j."],"cuid":["S01-000.00-405803"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"symmetry induced kinetic isotope effects in the dissociation dynamics of chcl sub 000000000003 sub and chcl sub 000000000004 sub","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-405803","identifier":[{"id":"85051123867","type":"scopus"}],"ids":["ku-14bafc31-b603-4c8a-ba48-b496de24930f"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-CB997309114D8358F74DCF4F39B6B57C"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Chemistry"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","country":"dk","first":"Allan Christian","key":"petersenpau","last":"Petersen","locid":"0fb5fb3f-47e3-45bd-9131-77c78e17ad9b","name":"Petersen, Allan Christian","rank":1,"rolecode":"pau"},{"affno":"1","first":"Theis I.","key":"søllingpau","last":"Sølling","locid":"5db24645-70db-461f-a061-dd6612993ec8","name":"Sølling, Theis Ivan","name_org":"Sølling, Theis I.","orcid":"0000-0003-1710-9072","rank":2,"rolecode":"pau"},{"affno":"","first":"Max D.j.","key":"waterspau","last":"Waters","name":"Waters, Max D.j.","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.chemphys.2018.07.051","issn":["03010104","18734421"],"issn_org":["03010104"],"journal":"Chemical Physics","pages":"375-380","status":"p","title":"Chemical Physics","volume":"515"},"review":"Peer Reviewed","scoID":["2-s2.0-85051123867"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-14bafc31-b603-4c8a-ba48-b496de24930f"],"src":["KU University of Copenhagen"],"title":"Symmetry-induced kinetic isotope effects in the dissociation dynamics of CHCl<sub>3</sub>+ and CHCl<sub>4</sub>−","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-405803","year":"2018","yearsub":"2018"}
{"abstract":"Combined myocardial flow reserve (MFR) by PET and CT coronary angiography (CTA) is a promising tool for assessment of coronary artery disease. Prior analyses of MFR/CTA has been performed as side-by-side interpretation, not as volume rendered, full hybrid analysis, with fused MFR/CTA. We aimed to: (i) establish a method for full hybrid analysis of MFR/CTA, (ii) validate the inter- and intra-observer reproducibility of MFR values, and (iii) determine the diagnostic value of side-by-side versus full hybrid MFR/CTA with 15-O-water PET. Forty-four outpatients scheduled for invasive coronary angiography (ICA) were enrolled prospectively. All underwent rest/stress 15-O-water PET/CTA with ICA as reference. Within two observers of different experience, the Pearson r at global and territorial level exceeded 0.953 for rest, stress, and MFR values, as determined by Carimas software. Within and between observers, the mean differences between rest, stress, and MFR values were close to zero and the confidence intervals for 95% limits of agreement were narrow. The diagnostic performance of full hybrid PET/CTA did not outperform the side-by-side approach, but performed better than MFR without CTA at vessel level: specificity 93% (95% confidence limits: 89-97%) versus 76% (64-88%), p = 0.0004; positive predictive value 71% (55-86%) versus 51% (37-65%), p = 0.0001; accuracy 90% (84-95%) versus 77% (69-84%), p = 0.0009. MFR showed high reproducibility within and between observers of different experience. The full hybrid model was not superior to side-by-side interpretation of MFR/CTA, but proved better than MFR alone at vessel level with regard to specificity, positive predictive value, and accuracy.","author_count":11,"contributors":["Thomassen, Anders","Braad, Poul-Erik","Pedersen, Kasper Tholstrup","Petersen, Henrik","Johansen, Allan","Diederichsen, Axel Cosmus Pyndt","Mickley, Hans","Jensen, Lisette Okkels","Knuuti, Juhani","Gerke, Oke","Høilund-Carlsen, Poul Flemming"],"cuid":["S01-000.00-578472"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"country":["Finland"],"glorg":["All Global Affiliations","Turku PET Centre"],"keyword":["Adult","Aged","Aged 80 and over","CT angiography","Computed Tomography Angiography methods","Coronary Angiography methods","Coronary Artery Disease diagnostic imaging","Coronary Circulation","Coronary Vessels diagnostic imaging","Diagnostic value","Female","Flow reserve","Humans","Male","Middle Aged","Multidetector Computed Tomography methods","Myocardial Perfusion Imaging methods","Observer Variation","Oxygen Radioisotopes administration dosage","Positron Emission Tomography Computed Tomography methods","Predictive Value of Tests","Prospective Studies","Reproducibility","Reproducibility of Results"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"000000000015 o water myocardial flow reserve pet and ct angiography by full hybrid pet ct as a potential alternative to invasive angiography","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85051127315","version":"Other Version"},"id":"S01-000.00-578472","identifier":[{"id":"85051127315","type":"scopus"},{"id":"30066164","type":"pmid"}],"ids":["sdu-1280c249-a91d-4565-9782-22ba37241da3"],"keyword":["Adult","Aged","Aged, 80 and over","CT angiography","Computed Tomography Angiography/methods","Coronary Angiography/methods","Coronary Artery Disease/diagnostic imaging","Coronary Circulation","Coronary Vessels/diagnostic imaging","Diagnostic value","Female","Flow reserve","Humans","Male","Middle Aged","Multidetector Computed Tomography/methods","Myocardial Perfusion Imaging/methods","Observer Variation","Oxygen Radioisotopes/administration & dosage","PET 15-O-water","Positron Emission Tomography Computed Tomography/methods","Predictive Value of Tests","Prospective Studies","Reproducibility","Reproducibility of Results"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-0075E70437DC1617FC10AF8F7D7FD826"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Clinical Physiology and Nuclear Medicine (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"fi","key":"turku pet centre","loc":["Finland","Europe, EU","Nordic","OECD"],"name":"Turku PET Centre","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Anders","key":"thomassenpau","last":"Thomassen","locid":"1c7f11fb-cf64-4085-909d-b78f183b9364","name":"Thomassen, Anders","orcid":"0000-0001-9839-1158","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Poul-Erik","key":"braadpau","last":"Braad","locid":"7df4b5a6-a971-420c-b424-ccc861b7f5ff","name":"Braad, Poul-Erik","orcid":"0000-0003-4906-5422","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kasper T","key":"pedersenpau","last":"Pedersen","locid":"04c4ccff-2886-49e8-b92e-bed28e6aa666","name":"Pedersen, Kasper Tholstrup","name_org":"Pedersen, Kasper T","orcid":"0000-0002-2036-7526","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Henrik","key":"petersenpau","last":"Petersen","locid":"ea635371-4294-4379-9655-3da538fecf13","name":"Petersen, Henrik","orcid":"0000-0002-1118-1500","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Allan","key":"johansenpau","last":"Johansen","locid":"dc7a1a61-b703-48ec-bd87-c92b55784133","name":"Johansen, Allan","orcid":"0000-0002-3622-057X","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Axel C P","key":"diederichsenpau","last":"Diederichsen","locid":"d84be6bc-52bf-4710-9f66-0209cfab4f54","name":"Diederichsen, Axel Cosmus Pyndt","name_org":"Diederichsen, Axel C P","orcid":"0000-0002-1285-4826","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hans","key":"mickleypau","last":"Mickley","locid":"f6789f9a-e23b-4ab8-bd7d-a3c168107cdb","name":"Mickley, Hans","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lisette O","key":"jensenpau","last":"Jensen","locid":"b78c452e-5a69-41fe-ba49-0096c84d1d4d","name":"Jensen, Lisette Okkels","name_org":"Jensen, Lisette O","orcid":"0000-0002-4838-2429","rank":8,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Juhani","key":"knuutipau","last":"Knuuti","name":"Knuuti, Juhani","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Oke","key":"gerkepau","last":"Gerke","locid":"596baeb1-6754-4d53-948f-30470dd1d976","name":"Gerke, Oke","orcid":"0000-0001-6335-3303","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Poul F","key":"høilundcarlsenpau","last":"Høilund-Carlsen","locid":"a1ff65cf-cdaa-4192-bef3-a915cfe6cceb","name":"Høilund-Carlsen, Poul Flemming","name_org":"Høilund-Carlsen, Poul F","orcid":"0000-0001-7420-2367","rank":11,"rolecode":"pau"}],"pmid":["30066164"],"pub":{"doi":"10.1007/s10554-018-1420-3","issn":["15695794","18758312"],"issn_org":["15695794"],"issue":"12","journal":"The International Journal of Cardiovascular Imaging","pages":"2011-2022","publisher":"Springer Science+Business Media","status":"p","title":"The International Journal of Cardiovascular Imaging","volume":"34"},"review":"Peer Reviewed","scoID":["2-s2.0-85051127315"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-1280c249-a91d-4565-9782-22ba37241da3"],"src":["SDU University of Southern Denmark"],"title":"15-O-water myocardial flow reserve PET and CT angiography by full hybrid PET/CT as a potential alternative to invasive angiography","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-578472","year":"2018","yearsub":"2018"}
{"abstract":"TARP syndrome (talipes equinovarus, atrial septal defect, Robin sequence, and persistence of the left superior vena cava) is a rare X-linked syndrome often resulting in pre- or post-natal lethality in affected males. In 2010, RBM10 was identified as the disease-causing gene, and we describe the first adult patient with TARP syndrome at age 28 years, hereby expanding the phenotypic spectrum. Our patient had Robin sequence, atrial septal defect, intellectual disability, scoliosis, and other findings previously associated with TARP syndrome. In addition, he had a prominent nose and nasal bridge, esotropia, displacement of lacrimal points in the cranial direction, small teeth, and chin dimple, which are the findings that have not previously been associated with TARP syndrome. Our patient was found to carry a hemizygous c.273_283delinsA RBM10 mutation in exon 4, an exon skipped in three of five protein-coding transcripts, suggesting a possible explanation for our patient surviving to adulthood. Direct sequencing of maternal DNA indicated possible mosaicism, which was confirmed by massive parallel sequencing. One of two sisters were heterozygous for the mutation. Therefore, we recommend sisters of patients with TARP syndrome be carrier tested before family planning regardless of carrier testing results of the mother. Based on our patient and previously reported patients, we suggest TARP syndrome be considered as a possible diagnosis in males with severe or profound intellectual disability combined with septal heart defect, and Robin sequence, micrognathia, or cleft palate.","author_count":7,"contributors":["Højland, Allan Thomas","Lolas, Ihab Bishara Yousef","Okkels, Henrik","Lautrup, Charlotte Kvist","Diness, Birgitte R","Petersen, Michael Bjørn","Nielsen, Irene Kibæk"],"cuid":["S02-100.00-001976"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Clubfoot","Intellectual disability","RBM10","RNA Binding Proteins","Scoliosis","TARP syndrome"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-AAU","DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-AAU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"first reported adult patient with tarp syndrome a case report","src":["aau","ku"],"src-code":["DI-U-AAU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1002/ajmg.a.40638","version":"Published Version"},"id":"S02-100.00-001976","identifier":[{"id":"000454612700058","type":"wos"},{"id":"85056836740","type":"scopus"},{"id":"30462380","type":"pmid"},{"id":"PMC6587983","type":"pmcid"}],"ids":["aau-2756091a-7f13-4a73-97e0-efe6967e6d76","ku-79c4d752-42c9-4653-a300-c2a23095c745"],"keyword":["Pierre Robin syndrome","RBM10","RNA-binding proteins","TARP syndrome","clubfoot","heart septal defects, congenital","intellectual disability","mental retardation, X-linked","scoliosis"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-CC58F43A587B2779A7FD17FA0C2D348F"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1002/ajmg.a.40638","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/293655858/H_jland_et_al_2018_American_Journal_of_Medical_Genetics_Part_A.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/218651833/ajmg.a.40638.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe