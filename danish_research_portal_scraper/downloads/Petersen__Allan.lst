-1b38838c7346","name":"Stensballe, Allan","orcid":"0000-0002-9888-1955","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Henrik","key":"vorumpau","last":"Vorum","locid":"60554352-1557-4c7b-905d-e4b7c7f8c94a","name":"Vorum, Henrik","orcid":"0000-0002-7600-0731","rank":5,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Steen Hvitfeldt","key":"poulsenpau","last":"Poulsen","locid":"ec1d0fd4-f6ae-4071-907f-1448dfe832fe","name":"Poulsen, Steen Hvitfeldt","orcid":"0000-0002-9586-835X","rank":6,"rolecode":"pau"},{"affno":"4 5","corresponding":null,"first":"Lars Melholt","key":"rasmussenpau","last":"Rasmussen","locid":"bf5d4e3b-cb51-4e61-a6d1-e22445213324","name":"Rasmussen, Lars Melholt","orcid":"0000-0001-5795-4794","rank":7,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Eskild","key":"petersenpau","last":"Petersen","locid":"91c7ce03-d7e1-4557-91ca-bbd19ac0b7fe","name":"Petersen, Eskild","rank":8,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"first":"Bent","key":"honorépau","last":"Honoré","locid":"75b9e761-1039-463f-92dc-c6ed4f760738","name":"Honoré, Bent","orcid":"0000-0002-3459-7429","rank":9,"rolecode":"pau"}],"pmid":["32087365"],"pub":{"doi":"10.1016/j.ijid.2020.02.026","issn":["12019712","18783511"],"issn_org":["12019712"],"journal":"International Journal of Infectious Diseases","pages":"73-81","publisher":"Elsevier BV","publisher_org":"Elsevier B.V.","status":"p","title":"International Journal of Infectious Diseases","volume":"96"},"review":"Peer Reviewed","scoID":["2-s2.0-85084346204"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-070eca17-af1b-4200-b339-42bd974ba351","au-c1ccb2ea-142a-4b67-b5ec-c315a1770b60","sdu-e80c3ed1-7f83-49d8-b308-c71d36fe3771"],"src":["AAU Aalborg University","AU Aarhus University","SDU University of Southern Denmark"],"title":"Towards identification of novel putative biomarkers for infective endocarditis by serum proteomic analysis","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-100.00-000365","year":"2020","yearsub":"2020"}
{"abstract":"Background: Important insights on, for example, prevalence, disease progression, and treatment of allergic rhinitis can be obtained from large-scale database studies if researchers are able to identify allergic individuals. We aimed to assess the validity of 13 different algorithms based on Danish nationwide prescription and/or hospital data to identify adults with allergic rhinitis. Methods: Our primary gold standard of allergic rhinitis was a positive serum specific IgE (≥0.35) and self-reported nasal symptoms retrieved from two general health examination studies conducted in Danish adults (18-69 years) during 2006 to 2008 (n = 3416) and 2012 to 2015 (n = 7237). The secondary gold standard of allergic rhinitis was self-reported physician diagnosis. We calculated sensitivity, specificity, positive predictive value (PPV), negative predictive value, and corresponding 95% confidence intervals (95% CI) for each register-based algorithm in the two time periods. Results: Sensitivity (≤0.40) was low for all algorithms irrespective of definition of allergic rhinitis (gold standard) or time period. The highest PPVs were obtained for algorithms requiring both antihistamines and intranasal corticosteroids; yielding a PPV of 0.69 (0.62-0.75) and a corresponding sensitivity of 0.10 (0.09-0.12) for the primary gold standard of allergic rhinitis in 2012 to 2015. Conclusion: Algorithms based on both antihistamines and intranasal corticosteroids yielded the highest PPVs. However, the PPVs were still moderate and came at the expense of low sensitivity when applying the strict primary gold standard (sIgE and nasal symptom).","author_count":5,"contributors":["Leth-Møller, Katja Biering","Skaaby, Tea","Madsen, Flemming","Petersen, Janne","Linneberg, Allan"],"cuid":["S01-000.00-537141"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Allergic rhinitis","Pharmacoepidemiology","Real world evidence","Sensitivity","Validation"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-PR","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"PR":["DI-PR-ALK","DI-PR-ALL"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-PR-ALK","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"can we identify allergic rhinitis from administrative data a validation study","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-537141","identifier":[{"id":"32964608","type":"pmid"},{"id":"85091321076","type":"scopus"}],"ids":["ku-f0d7b6ad-06a3-4894-a9ec-52e32aac9aee"],"keyword":["allergic rhinitis","pharmacoepidemiology","prescription algorithms","real world evidence","sensitivity","validation"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-9C5B7559F0C61F4D16B259608A07DC06"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Bispebjerg and Frederiksberg"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","country":"dk","key":"alk abello","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-ALK","l3nl":"ALK-Abello A/S","l3nn":"ALK-Abello","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ALK-Abello","namevar":["ALK-Abello AS"],"nora_code":"DI-PR-ALK","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Public Health, Section of Biostatistics"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1 2","first":"Katja Biering","key":"lethmøllerpau","last":"Leth-Møller","name":"Leth-Møller, Katja Biering","rank":1,"rolecode":"pau"},{"affno":"1","first":"Tea","key":"skaabypau","last":"Skaaby","name":"Skaaby, Tea","rank":2,"rolecode":"pau"},{"affno":"","first":"Flemming","key":"madsenpau","last":"Madsen","name":"Madsen, Flemming","rank":3,"rolecode":"pau"},{"affno":"3","first":"Janne","key":"petersenpau","last":"Petersen","locid":"1cb72724-54f8-4ca1-a201-bfa4a354a129","name":"Petersen, Janne","rank":4,"rolecode":"pau"},{"affno":"3","first":"Allan","key":"linnebergpau","last":"Linneberg","locid":"09da8aa6-fd95-4ace-a2f1-19f38d7d3f9e","name":"Linneberg, Allan","orcid":"0000-0002-0994-0184","rank":5,"rolecode":"pau"}],"pmid":["32964608"],"pub":{"doi":"10.1002/pds.5120","issn":["10538569","10991557"],"issn_org":["10538569"],"issue":"11","journal":"Pharmacoepidemiology and Drug Safety","pages":"1423-1431","status":"p","title":"Pharmacoepidemiology and Drug Safety","volume":"29"},"review":"Peer Reviewed","scoID":["2-s2.0-85091321076"],"search":{"DAF":["ALK-Abello A/S","All Danish Affiliations","All Hospitals","All Private Research","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Hospitals","Private Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-f0d7b6ad-06a3-4894-a9ec-52e32aac9aee"],"src":["KU University of Copenhagen"],"title":"Can we identify allergic rhinitis from administrative data : A validation study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-537141","year":"2020","yearsub":"2020"}
{"author_count":10,"contributors":["Petersen, Mads","Pedersen, Inge Bülow","Knudsen, Nils","Andersen, Stig","Jørgensen, Torben","Perrild, Hans","Ovesen, Lars","Rasmussen, Lone Banke","Thuesen, Betina Heinsbæk","Carlé, Allan"],"cuid":["S01-000.00-107230"],"event":{"end":"2019-09-10","place":"Budapest, hu","start":"2019-09-07","title":"42nd Annual Meeting of the European Thyroid Association","year":"2019"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-AAU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"iodine fortification dramatically changes the spectrum in both thyrotoxicosis and hypothyroidism subtypes","src":["aau"],"src-code":["DI-U-AAU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-107230","ids":["aau-c51a7e81-c1e1-4f4b-b5be-613ea9ff6ab1"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-BBB4B4981B88A0572DC934A83A43F3C7"],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Medicin og Akut","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, The Department of Endocrinology"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Mads","key":"petersenpau","last":"Petersen","locid":"6780e583-94a8-431e-a84b-1ee1e6c50464","name":"Petersen, Mads","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Inge Bülow","key":"pedersenpau","last":"Pedersen","locid":"0b17bcdf-70d8-459d-a188-1d38f12a4664","name":"Pedersen, Inge Bülow","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Nils","key":"knudsenpau","last":"Knudsen","name":"Knudsen, Nils","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Stig","key":"andersenpau","last":"Andersen","locid":"61af62ab-d105-4f02-bbea-e6d8146a3e66","name":"Andersen, Stig","orcid":"0000-0003-3632-5213","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Torben","key":"jørgensenpau","last":"Jørgensen","name":"Jørgensen, Torben","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Hans","key":"perrildpau","last":"Perrild","name":"Perrild, Hans","rank":6,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Lars","key":"ovesenpau","last":"Ovesen","name":"Ovesen, Lars","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lone Banke","key":"rasmussenpau","last":"Rasmussen","name":"Rasmussen, Lone Banke","rank":8,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Betina Heinsbæk","key":"thuesenpau","last":"Thuesen","name":"Thuesen, Betina Heinsbæk","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Allan","key":"carlépau","last":"Carlé","locid":"302be08f-b6cb-46ad-9253-645a50ba4072","name":"Carlé, Allan","rank":10,"rolecode":"pau"}],"pub":{"doi":"10.1159/000501012","issn":["22350640","22350802"],"issn_org":["22350640"],"issue":"Suppl. 1","journal":"European Thyroid Journal","pages":"25","paperid":"OP-10-60","publisher":"BioScientifica Ltd.","status":"p","title":"European Thyroid Journal","volume":"8"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["aau-c51a7e81-c1e1-4f4b-b5be-613ea9ff6ab1"],"src":["AAU Aalborg University"],"title":"Iodine Fortification Dramatically Changes the Spectrum in Both Thyrotoxicosis and Hypothyroidism Subtypes","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-107230","year":"2019","yearsub":"2019"}
{"abstract":"Objective: To investigate the impact of mandatory iodine fortification (IF) on the incidence of nosological subtypes of overt thyrotoxicosis and hypothyroidism. Design: We identified and scrutinized all possible new cases of overt thyrotoxicosis and hypothyroidism in an open cohort in Northern Jutland (n = 309 434; 1 January 1997) during the years 2014-2016. Individual medical history was evaluated to verify and detail the incidence of overt thyroid dysfunction and for classification into nosological subtypes. A number of cases were excluded during final verification due to spontaneous normalization of thyroid function, as they had no medical history suggesting a known condition, which could transiently affect thyroid function (subacute/silent thyroiditis, PPTD and iatrogenic thyroid dysfunction). An identical survey was conducted in 1997-2000 prior to mandatory IF of salt (13 µg/g) that was in effect from year 2001. Results: The standardized incidence rate (SIR) of verified overt thyrotoxicosis decreased markedly from 97.5/100 000/year in 1997-2000 to 48.8 in 2014-2016 (SIRR: 0.50 [95% CI: 0.45-0.56]). This was due to a distinct decrease in the SIR of multinodular toxic goitre (SIRR: 0.18 [0.15-0.23]), solitary toxic adenoma (SIRR: 0.26 [0.16-0.43]) and to a lesser degree Graves’ disease (SIRR: 0.67 [0.56-0.79]). SIR for overt hypothyroidism was unaltered by 2014-2016 (SIRR: 1.03 [0.87-1.22]). However, age distribution shifted with more young and fewer elderly cases of verified overt hypothyroidism. Conclusion: Mandatory IF caused a substantial reduction in SIR of verified overt thyrotoxicosis (especially of nodular origin) while avoiding an increase in SIR of verified overt hypothyroidism.","author_count":13,"contributors":["Petersen, Mads","Pedersen, Inge Bülow","Knudsen, Nils","Andersen, Stig","Jørgensen, Torben","Perrild, Hans","Ovesen, Lars","Banke Rasmussen, Lone","Thuesen, Betina H","Carlé, Allan"],"cuid":["S02-095.27-006964"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"keyword":["Epidemiology","Hyperthyroidism","Hypothyroidism","Incidence","Iodine","Myxoedema","Thyrotoxicosis"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-AAU","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"changes in subtypes of overt thyrotoxicosis and hypothyroidism following iodine fortification","src":["aau","ku"],"src-code":["DI-U-AAU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/309513792/Changes_in_subtypes_of_overt_thyrotoxicosis_and_hypothyroidism_following_iodine_fortification.pdf","version":"Authors Final Version"},"id":"S02-095.27-006964","identifier":[{"id":"000489347100008","type":"wos"},{"id":"85072211364","type":"scopus"},{"id":"31400012","type":"pmid"}],"ids":["aau-8fa2becb-038a-4d65-8fcb-ce2c0871c343","ku-de676e17-b174-4504-a80a-6d558a2ced3d"],"keyword":["epidemiology","hyperthyroidism","hypothyroidism","incidence","iodine","myxoedema","thyrotoxicosis"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-3227D5D6931AA5AF05BC79AB4318E13B"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/309513792/Changes_in_subtypes_of_overt_thyrotoxicosis_and_hypothyroidism_following_iodine_fortification.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicin