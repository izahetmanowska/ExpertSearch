rch Unit for General Practice in Aalborg"],"nora_code":"DI-OT","used":1},{"affno":"3","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1 2","corresponding":null,"country":"dk","first":"Allan","key":"riisallanpau","last":"Riis","locid":"dd013e16-1de8-4499-aab3-cf50e4361e58","name":"Riis, Allan","orcid":"0000-0002-7009-3025","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Cathrine Elgaard","key":"jensencathrineelgaardpau","last":"Jensen","locid":"078e71ca-9113-46d8-907c-9ec548aa6792","name":"Jensen, Cathrine Elgaard","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Flemming","key":"broflemmingpau","last":"Bro","name":"Bro, Flemming","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Helle Terkildsen","key":"maindalhelleterkildsenpau","last":"Maindal","name":"Maindal, Helle Terkildsen","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Karin Dam","key":"petersenkarindampau","last":"Petersen","locid":"2e36a0d6-1251-4e37-a8f6-8f0a16c9875e","name":"Petersen, Karin Dam","orcid":"0000-0002-6491-1757","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mette Dahl","key":"bendtsenmettedahlpau","last":"Bendtsen","locid":"d622c88e-658d-4b77-b3fd-2a506540431e","name":"Bendtsen, Mette Dahl","orcid":"0000-0003-2403-3520","rank":6,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Martin Bach","key":"jensenmartinbachpau","last":"Jensen","locid":"929fc31a-f5b6-45b8-b3ed-29bd2c4b4bf7","name":"Jensen, Martin Bach","orcid":"0000-0003-2162-7390","rank":7,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["aau-fc6144cd-d49c-49f5-9de4-ecc1286d8094"],"src":["AAU Aalborg University"],"title":"Effectiveness and cost-effectiveness of a multifaceted strategy for implementing low back pain guidelines in general practice : Low back pain guideline implementation in general practice: a cluster randomised controlled trial","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-123335","year":"2016","yearsub":"2016"}
{"abstract":"We report reference ranges based on LC-MS/MS for testosterone (T), free testosterone (FT) and its precursors, i.e. 17-hydroxyprogesterone (17-OHP), dehydroepiandrosterone (DHEA), DHEA-sulfate (DHEAS) and androstenedione (Adione), in relation to different health markers and lifestyle factors. The study was based on 304 healthy men aged 30-61 years participating in a population-based cross-sectional study (Health2008). Examination program consisted of a clinical examination, completion of a self-administered questionnaire and blood sampling. Steroid metabolites were measured by a validated and sensitive LC-MS/MS method. Older age-groups were significantly associated with decreased concentrations of DHEA, DHEAS, Adione, and FT, while no significant associations with age were shown for 17-OHP or T. Participants with BMI≥30 kg/m(2) had lower age-related steroid metabolite z-scores compared to participants with BMI<30 kg/m(2), i.e. 17-OHP: -0.51 vs. 0.08 (p<0.001); DHEA: -0.27 vs. 0.09 (p=0.014); Adione: -0.29 vs. 0.09 (p=0.012); T: -0.99 vs. 0.14 (p<0.001); and FT -0.55 vs. 0.05 (p<0.001), respectively. In conclusion, this large study on serum steroid metabolites and concomitant assessment of health markers in healthy men provides age-related reference ranges, and furthermore evaluates the impact of lifestyle factors and metabolic syndrome on androgen metabolite levels.","author_count":9,"contributors":["Jensen, L.S.","Johannsen, T H","Holmboe, Stine Agergaard","Søeborg, T","Petersen, Jørgen Holm","Andersson, AM","Aadahl, Mette","Linneberg, Allan","Juul, Anders"],"cuid":["S01-000.00-417155"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Journal Article","Research Support Non U S Gov t"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"reference ranges of 000000000017 hydroxyprogesterone dhea dheas androstenedione total and free testosterone determined by turboflow lc ms ms and associations to health markers in 000000000304 men","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-417155","identifier":[{"id":"26765096","type":"pmid"},{"id":"84953431586","type":"scopus"}],"ids":["ku-27a18a0a-0118-44b2-b96d-21d4862709dd"],"keyword":["Journal Article","Research Support, Non-U.S. Gov't"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-C705535C489A176226765292D4329FAA"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"L.S.","key":"jensenpau","last":"Jensen","name":"Jensen, L.S.","rank":1,"rolecode":"pau"},{"affno":"","first":"T H","key":"johannsenpau","last":"Johannsen","name":"Johannsen, T H","rank":2,"rolecode":"pau"},{"affno":"1","first":"Stine Agergaard","key":"holmboepau","last":"Holmboe","locid":"bb197976-3ff6-46e3-9322-b5812e9cd727","name":"Holmboe, Stine Agergaard","rank":3,"rolecode":"pau"},{"affno":"","first":"T","key":"søeborgpau","last":"Søeborg","name":"Søeborg, T","rank":4,"rolecode":"pau"},{"affno":"1","first":"Jørgen Holm","key":"petersenpau","last":"Petersen","locid":"33c1c5b2-2e1e-4259-b4d7-04657a2bdb9b","name":"Petersen, Jørgen Holm","orcid":"0000-0003-3979-7443","rank":5,"rolecode":"pau"},{"affno":"","first":"AM","key":"anderssonpau","last":"Andersson","name":"Andersson, AM","rank":6,"rolecode":"pau"},{"affno":"1","first":"Mette","key":"aadahlpau","last":"Aadahl","locid":"019b268b-8dff-4a10-91f6-07730c29d39b","name":"Aadahl, Mette","orcid":"0000-0001-5904-9747","rank":7,"rolecode":"pau"},{"affno":"1","first":"Allan René","key":"linnebergpau","last":"Linneberg","locid":"09da8aa6-fd95-4ace-a2f1-19f38d7d3f9e","name":"Linneberg, Allan","name_org":"Linneberg, Allan René","orcid":"0000-0002-0994-0184","rank":8,"rolecode":"pau"},{"affno":"1","first":"Anders","key":"juulpau","last":"Juul","locid":"f9b11983-c7c8-4111-b119-4de471572898","name":"Juul, Anders","orcid":"0000-0002-0534-4350","rank":9,"rolecode":"pau"}],"pmid":["26765096"],"pub":{"doi":"10.1016/j.cca.2015.12.042","issn":["00098981","18733492"],"issn_org":["00098981"],"journal":"Clinica Chimica Acta","pages":"82-88","status":"p","title":"Clinica Chimica Acta","volume":"454"},"review":"Peer Reviewed","scoID":["2-s2.0-84953431586"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-27a18a0a-0118-44b2-b96d-21d4862709dd"],"src":["KU University of Copenhagen"],"title":"Reference ranges of 17-hydroxyprogesterone, DHEA, DHEAS, androstenedione, total and free testosterone determined by TurboFlow-LC-MS/MS and associations to health markers in 304 men","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-417155","year":"2016","yearsub":"2016"}
