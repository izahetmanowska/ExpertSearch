-HO","l2n":"Hospitals","l3":"DI-HO-NDR","l3nl":"North Denmark Region","l3nn":"North Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"North Denmark Region","namevar":["Research Unit for General Practice in the North Denmark region"],"nora_code":"DI-HO-NDR","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Cathrine Elgaard","key":"jensencathrineelgaardpau","last":"Jensen","locid":"078e71ca-9113-46d8-907c-9ec548aa6792","name":"Jensen, Cathrine Elgaard","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Allan","key":"riisallanpau","last":"Riis","locid":"dd013e16-1de8-4499-aab3-cf50e4361e58","name":"Riis, Allan","orcid":"0000-0002-7009-3025","rank":2,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Martin Bach","key":"jensenmartinbachpau","last":"Jensen","locid":"929fc31a-f5b6-45b8-b3ed-29bd2c4b4bf7","name":"Jensen, Martin Bach","orcid":"0000-0003-2162-7390","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Karin Dam","key":"petersenkarindampau","last":"Petersen","locid":"2e36a0d6-1251-4e37-a8f6-8f0a16c9875e","name":"Petersen, Karin Dam","orcid":"0000-0002-6491-1757","rank":4,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Universities"],"PST":["Published"]},"sid":["aau-bb759127-55f1-4a4c-839b-c859b4b9d897"],"src":["AAU Aalborg University"],"title":"Cost-effectiveness of implementing clinical guidelines on management of low back pain : A cluster randomised trial","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-104426","year":"2014","yearsub":"2014"}
{"abstract":"The aim was to investigate the performance of (18)F-fluorodeoxyglucose PET/CT to rule out malignancy in patients with confirmed vocal cord palsy (VCP). Between January 2011 and June 2013, we retrospectively included consecutive patients referred to PET/CT with paresis or paralysis of one or both vocal cords. PET/CT results were compared to clinical workup and histopathology. The study comprised 65 patients (32 females) with a mean age of 66±12 years (range 37-89). Eleven patients (17%) had antecedent cancer. Twenty-seven (42%) were diagnosed with cancer during follow-up. The palsy was right-sided in 24 patients, left-sided in 37, and bilateral in 4. Median follow-up was 7 months (interquartile range 4-11 months). Patients without cancer were followed for at least three months. PET/CT suggested a malignancy in 35 patients (27 true positives, 8 false positives) and showed none in 30 (30 true negatives, 0 false negatives). Thus, the sensitivity, specificity, positive and negative predictive values, and accuracy were (95% confidence intervals in parenthesis): 100% (88%-100%), 79% (64%-89%), 77% (61%-88%), 100% (89%-100%), and 88% (78%-94%), respectively. Sixteen patients had palliative treatment, while 11 were treated with curative intent, emphasising the severity of VCP and the need for a rapid and accurate diagnostic work-up. In this retrospective survey, biopsy proven malignancy (whether newly diagnosed or relapsed) was the cause of VCP in almost half of patients (42%). PET/CT had a high sensitivity (100%) with a relatively high false positive rate, but was excellent in ruling out malignancy (negative predictive value 100%).","author_count":12,"contributors":["Thomassen, Anders","Nielsen, Anne Lerberg","Lauridsen, Jeppe Killerich","Blomberg, Björn Alexander","Hess, Søren","Petersen, Henrik","Johansen, Allan","Asmussen, Jon Thor","Sørensen, Jesper Roed","Johansen, Jørgen","Godballe, Christian","Høilund-Carlsen, Poul Flemming"],"cuid":["S01-000.00-624959"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-SDR","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"fdg pet ct can rule out malignancy in patients with vocal cord palsy","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-624959","identifier":[{"id":"24753985","type":"pmid"}],"ids":["sdu-b4b2f3cc-d317-4e8e-bd97-dce57ead914f"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-9F4FE3933E7F473CCA5DAF662904499F"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Clinical Physiology and Nuclear Medicine (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Odense University Hospital"],"nora_code":"DI-HO-SDR","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Anders","key":"thomassenanderspau","last":"Thomassen","locid":"1c7f11fb-cf64-4085-909d-b78f183b9364","name":"Thomassen, Anders","orcid":"0000-0001-9839-1158","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anne Lerberg","key":"nielsenannelerb