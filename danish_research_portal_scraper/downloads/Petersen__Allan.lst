 University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Clinical Genetics","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Diagnostik","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Helena Gásdal","key":"karstensenpau","last":"Karstensen","name":"Karstensen, Helena Gásdal","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Nanna Dahl","key":"rendtorffpau","last":"Rendtorff","name":"Rendtorff, Nanna Dahl","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lone Sandbjerg","key":"hindbækpau","last":"Hindbæk","name":"Hindbæk, Lone Sandbjerg","rank":3,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Roberto","key":"colombopau","last":"Colombo","name":"Colombo, Roberto","rank":4,"rolecode":"pau"},{"affno":"4","first":"Amelie","key":"steinpau","last":"Stein","locid":"883406ce-8afb-4747-a574-9c46516128db","name":"Stein, Amelie","orcid":"0000-0002-5862-1681","rank":5,"rolecode":"pau"},{"affno":"5 6","corresponding":null,"country":"dk","first":"Niels Holtum","key":"birkebækpau","last":"Birkebæk","locid":"ab06c1a0-31ae-4cdb-b66d-2ccaebfff4ed","name":"Birkebæk, Niels","name_org":"Birkebæk, Niels Holtum","rank":6,"rolecode":"pau"},{"affno":"4","first":"Rasmus","key":"hartmannpetersenpau","last":"Hartmann-Petersen","locid":"fea900ee-b167-45e9-af2c-00038ff06862","name":"Hartmann-Petersen, Rasmus","orcid":"0000-0002-4155-7791","rank":7,"rolecode":"pau"},{"affno":"4","first":"Kresten","key":"lindorfflarsenpau","last":"Lindorff-Larsen","locid":"be20a4d8-92c4-44b9-9dfb-b6ad6471a58c","name":"Lindorff-Larsen, Kresten","orcid":"0000-0002-4750-6039","rank":8,"rolecode":"pau"},{"affno":"7","corresponding":null,"country":"dk","first":"Allan Thomas","key":"højlandpau","last":"Højland","locid":"115e8cf1-489c-4a6b-93c5-11d69d2e0d51","name":"Højland, Allan Thomas","rank":9,"rolecode":"pau"},{"affno":"7","corresponding":null,"first":"Michael Bjørn","key":"petersenpau","last":"Petersen","locid":"8512b77d-bdf2-4889-bda3-d399e6867e28","name":"Petersen, Michael Bjørn","orcid":"0000-0003-0316-8207","rank":10,"rolecode":"pau"},{"affno":"4 1","first":"Lisbeth","key":"tranebjærgpau","last":"Tranebjærg","locid":"e305b187-66cd-4744-a2d5-fcad370dabd4","name":"Tranebjærg, Lisbeth","rank":11,"rolecode":"pau"}],"pmid":["31449985"],"pub":{"doi":"10.1016/j.ejmg.2019.103733","issn":["17697212","18780849"],"issn_org":["17697212"],"issue":"3","journal":"European Journal of Medical Genetics","pages":"103733","paperid":"103733","publisher":"Elsevier Masson","status":"p","title":"European Journal of Medical Genetics","volume":"63"},"review":"Peer Reviewed","scoID":["2-s2.0-85071657131"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["aau-e1499dbc-6be0-489a-b911-f4f142c6f99f","au-d8d7efbb-5f7a-48c9-a281-2a1e3bf2cf5a","ku-6e7a75bc-355f-4ff1-bf2f-e0d2a5e39eb3"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen"],"title":"Novel HARS2 missense variants identified in individuals with sensorineural hearing impairment and Perrault syndrome","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-100.00-010757","year":"2020","yearsub":"2020"}
{"abstract":"Background: The peptide hormone insulin-like factor 3 (INSL3) is a marker for Leydig cell function and the clinical use of serum INSL3 measurements has been suggested by several groups. Aim: (1) To establish a reference range for liquid chromatography-tandem mass spectrometry (LC-MS/MS) of serum INSL3 in healthy boys and men; and (2) to compare the associations of serum INSL3 and testosterone (T) to pubertal stage, lifestyle factors, diurnal variation, body composition, and human chorionic gonadotropin (hCG) stimulation. Results: In a reference range based on LC-MS/MS analysis of serum from 1073 boys and men, INSL3 increased from levels close to the detection limit (0.03 mu g/L) in prepubertal boys to a maximum mean level of 1.3 mu g/L (95% CI, 0.9-2.7) in young men (19-40 years of age) and decreased slightly in older men (0.1 mu g/L per decade). Serum T, but not INSL3, was associated with body mass index or body fat percentage and with alcohol consumption. Smoking was positively associated with serum T, but negatively associated with INSL3. There were significant diurnal variations in both INSL3 and T in men (P <0.001), but serum INSL3 varied substantially less, compared with serum T (+/- 11% vs +/- 26%). Mean serum INSL3 increased after hCG stimulation, but less than T (+ 17% vs +/- 53%), In both healthy men and in patients suspected of testicular failure, baseline serum INSL3 was more closely associated to the hCG-induced increase in serum T than baseline T itself. Conclusion: Measurement of serum INSL3 by LC-MS/MS has promise as a marker of testicular disorders.","author_count":13,"contributors":["Albrethsen, Jakob","Johannsen, Trine Holm","Jørgensen, Niels","Frederiksen, Hanne","Sennels, Henriette P.","Jorgensen, Henrik Loevendahl","Fahrenkrug, Jan","Petersen, Jørgen Holm","Linneberg, Allan","Nordkap, Loa","Bang, Anne Kirstine","Andersson, Anna-Maria","Juul, Anders"],"cuid":["S01-000.00-402090"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Age","Associations","Decline","Diurnal variation","Hormone","INSL3","LC MS MS","Leydig cell","Life style factors","MEN","Testosterone","normal range"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"evaluation of serum insulin like factor 000000000003 quantification by lc ms ms as a biomarker of leydig cell function","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-402090","identifier":[{"id":"85086105000","type":"scopus"},{"id":"000553452200047","type":"wos"},{"id":"32211773","type":"pmid"}],"ids":["ku-0e8f7c17-da02-4322-a4e7-6619e6fa7f9a"],"keyword":["AGE","ASSOCIATIONS","DECLINE","HEALTHY BOYS","HORMONE","INSL3","LC-MS/MS","LIFE-STYLE FACTORS","Leydig cell","MEN","diurnal variation","normal range","testosterone"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-10128762D77C60A688F866ED27494EBB"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Clinical Bi