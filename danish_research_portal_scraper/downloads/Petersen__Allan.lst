arla Michelle","rank":1,"rolecode":"pau"},{"affno":"1","first":"Mikael Agerlin","key":"petersenpau","last":"Petersen","locid":"9f4065a7-ea41-4357-b2ca-73903fd418c0","name":"Petersen, Mikael Agerlin","orcid":"0000-0002-4106-7696","rank":2,"rolecode":"pau"},{"affno":"1","first":"Allan Knud","key":"roepstorffpau","last":"Roepstorff","locid":"086303f2-0ce6-4201-81e4-1bb595ae520a","name":"Roepstorff, Allan Knud","rank":3,"rolecode":"pau"},{"affno":"1","first":"Leif","key":"pollpau","last":"Poll","locid":"f5af144f-ed67-4fe1-8344-11fdc45f2745","name":"Poll, Leif","rank":4,"rolecode":"pau"},{"affno":"","first":"Thomas","key":"hofmannpedh","last":"Hofmann","name":"Hofmann, Thomas","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Wolfgang","key":"meyerhofpedh","last":"Meyerhof","name":"Meyerhof, Wolfgang","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Peter","key":"schieberlepedh","last":"Schieberle","name":"Schieberle, Peter","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["9783938896389"],"pages":"305-309","publisher":"Deutche Forschungsanstalt für Lebensmittelchemie","status":"p","subtitle":"proceedings of the 9<sup>th</sup> Wartburg Symposium","title":"Advantages and challenges in flavor chemistry and biology"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-3309cfc4-6a3e-43cb-adfc-77bfe9170bc7"],"src":["KU University of Copenhagen"],"title":"Influence of packaging and storage time on aroma compounds of minimally processed lettuce","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-423809","year":"2011","yearsub":"2011"}
{"abstract":"This study applied a case-control approach to investigate the association between low-grade inflammation, defined by high values within the normal range of C-reactive protein (CRP) and interleukin-6 (IL-6), and urinary markers of nucleic acid oxidation. No differences in excretion of urinary markers of nucleic acid oxidation between cases and controls were found and multivariable linear regression analysis showed no association between urinary markers of nucleic acid oxidation and inflammatory markers. Post-hoc multivariable linear regression analysis showed significant associations between nucleic acid oxidation and various iron status markers and especially a close relationship between nucleic acid oxidation and ferritin. This study shows no association between low-grade inflammation and urinary markers of nucleic acid oxidation in a population of elderly Italian people. The results suggest that low-grade inflammation only has a negligible impact on whole body nucleic acid oxidation, whereas iron status seems to be of great importance.","author_count":10,"contributors":["Broedbaek, Kasper","Siersma, Volkert Dirk","Andersen, Jon Trærup","Petersen, Morten","Afzal, Shoaib","Hjelvang, Brian","Weimann, Allan","Semba, Richard D","Ferrucci, Luigi","Poulsen, Henrik Enghusen"],"cuid":["S01-000.00-412604"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["8 Hydroxy 2 Deoxyguanosine","8 Oxo 7 8 dihydro 2 deoxyguanosine","8 oxo 7 8 dihydroguanosine","8 oxoGuo","8 oxodG","C Reactive Protein","Cancer","Coronary heart disease","DNA damage","DNA oxidation","HELICOBACTER PYLORI INFECTION","Inflammation","Iron","MEN","Stress","Women"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"the association between low grade inflammation iron status and nucleic acid oxidation in the elderly","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-412604","identifier":[{"id":"21275071","type":"pmid"},{"id":"79952426412","type":"scopus"},{"id":"000288217400004","type":"wos"}],"ids":["ku-2028eb49-6a50-41cf-b805-d89b237b3da9"],"keyword":["8-hydroxy-2 '-deoxyguanosine","8-oxo-7,8-dihydro-2 '-deoxyguanosine","8-oxo-7,8-dihydroguanosine","8-oxoGuo","8-oxodG","BODY IRON","C-REACTIVE PROTEIN","CANCER","CORONARY-HEART-DISEASE","DNA oxidation","DNA-DAMAGE","HEALTHY PEOPLE","HELICOBACTER-PYLORI INFECTION","MEN","STRESS","WOMEN","inflammation","iron"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-517BED09933A455787D936FC036096C4"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Section of Diagnostic Sciences"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"","first":"Kasper","key":"broedbaekpau","last":"Broedbaek","name":"Broedbaek, Kasper","rank":1,"rolecode":"pau"},{"affno":"","first":"Volkert Dirk","key":"siersmapau","last":"Siersma","name":"Siersma, Volkert Dirk","rank":2,"rolecode":"pau"},{"affno":"1","first":"Jon T","key":"andersenpau","last":"Andersen","locid":"2fe4a9af-2462-4bba-8df4-2a518ea59342","name":"Andersen,