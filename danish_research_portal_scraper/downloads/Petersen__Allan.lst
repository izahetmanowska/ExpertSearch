0002-2392-9803","rank":18,"rolecode":"pau"},{"affno":"1 11","corresponding":null,"first":"Janus C.","key":"jakobsenpau","last":"Jakobsen","locid":"06691aa2-020b-4869-a6d9-56ac223008cc","name":"Jakobsen, Janus Christian","name_org":"Jakobsen, Janus C.","orcid":"0000-0002-3642-2120","rank":19,"rolecode":"pau"},{"affno":"1 11","corresponding":null,"first":"Christian","key":"gluudpau","last":"Gluud","locid":"9a304637-8b8a-4eb6-88a4-2108c618ce38","name":"Gluud, Christian","orcid":"0000-0002-8861-0799","rank":20,"rolecode":"pau"}],"pmid":["35061702"],"pub":{"doi":"10.1371/journal.pone.0260733","issn":["19326203"],"issue":"1","journal":"PLOS ONE","paperid":"e0260733","publisher":"Public Library of Science","status":"p","title":"PLOS ONE","volume":"17"},"review":"Peer Reviewed","scoID":["2-s2.0-85123307523"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region Zealand","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-43f62411-0049-4ce5-a18b-02d5f55ffb75","sdu-08e194e7-6ce6-4690-8c94-b4ebf8f08349"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Vaccines to prevent COVID-19 : A living systematic review with Trial Sequential Analysis and network meta-analysis of randomized clinical trials","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-085.96-041936","year":"2022","yearsub":"2022"}
{"abstract":"Mistletoes (Viscum) and close relatives are unique among flowering plants in having a drastically altered electron transport chain. Lack of complex I genes has previously been reported for the mitochondrial genome, and here we report an almost complete absence of nuclear-encoded complex I genes in the transcriptome of Viscum album. Compared to Arabidopsis with approximately 40 nuclear complex I genes, we recover only transcripts of two dual-function genes: gamma carbonic anhydrase and L-galactono-1,4-lactone dehydrogenase. The complement of genes belonging to complexes II-V of the oxidative phosphorylation pathway appears to be in accordance with other vascular plants. Additionally, transcripts encoding alternative NAD(P)H dehydrogenases and alternative oxidase were found. Despite sequence divergence, structural modeling suggests that the encoded proteins are structurally conserved. Complex I loss is a special feature in Viscum species and relatives, as all other parasitic flowering plants investigated to date seem to have a complete OXPHOS system. Hence, Viscum offers a unique system for specifically investigating molecular consequences of complex I absence, such as the role of complex I subunits involved in secondary functions.","author_count":9,"contributors":["Petersen, Gitte","Shyama Prasad Rao, R","Anderson, Benjamin","Zervas, Athanasios","Seberg, Ole","Rasmusson, Allan G","Møller, Ian Max"],"cuid":["S02-094.41-019818"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Asia, South","Europe, EU","Nordic","OECD"],"corresponding_author":["Petersen, Gitte"],"country":["India","Sweden"],"glorg":["All Global Affiliations","Lund University","Stockholm University","Yenepoya University"],"keyword":["Complex I","Gene expression","Structural modeling"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"genes from oxidative phosphorylation complexes ii v and two dual function subunits of complex i are transcribed in i viscum album i despite absence of the entire mitochondrial holo complex i","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.mito.2021.10.006","version":"Published Version"},"id":"S02-094.41-019818","identifier":[{"id":"000717843300001","type":"wos"},{"id":"34740863","type":"pmid"},{"id":"85118538061","type":"scopus"}],"ids":["au-62a2a234-1c4e-4835-84c2-eb18ae96b035","ku-d47aed1c-aff0-4fcc-bc29-648dd1db04d3"],"keyword":["Complex I","Gamma carbonic anhydrase","Gene expression","Mitochondrial processing protease","Mitochondrial respiratory complexes","Oxidative phosphorylation proteins","Structural modeling","Viscum album"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-0583C1842CF0E60AA86C75A835B15A20"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.au.dk/ws/files/333394069/1_s2.0_S156772492100146X_main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/286627774/Genes_from_oxidative_phosphorylation_complexes_II_V_and_two_dual_function_subunits_of_complex_I_are_transcribed_in_Viscum_album_despite_absence_of_the_entire_mitochondrial_holo_complex_I.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.mito.2021.10.006","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"se","key":"stockholm university","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Stockholm University","used":1},{"affno":"2","country":"in",