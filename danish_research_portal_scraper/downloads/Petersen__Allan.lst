","key":"dalpau","last":"Dal","locid":"2e86cdf8-de5b-4bcf-b705-d5ac5f184cf2","name":"Dal, Jakob","name_org":"Dal, J","orcid":"0000-0002-0610-7867","rank":7,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"A","key":"højgaardpau","last":"Højgaard","locid":"b29eeeec-d1b1-4971-afd7-a63fdadaa241","name":"Højgaard, Astrid Ditte","name_org":"Højgaard, A","orcid":"0000-0002-8866-8181","rank":8,"rolecode":"pau"},{"affno":"1 3 2","corresponding":null,"country":"dk","first":"M","key":"winterdahlpau","last":"Winterdahl","locid":"d71237b0-810c-4582-9898-ca5503b724ad","name":"Winterdahl, Michael","name_org":"Winterdahl, M","orcid":"0000-0002-8790-7574","rank":9,"rolecode":"pau"}],"pmid":["40468835"],"pub":{"doi":"10.1017/neu.2025.10018","issn":["09242708","16015215"],"issn_org":["09242708"],"journal":"Acta Neuropsychiatrica","paperid":"e68","publisher":"Cambridge University Press","status":"p","title":"Acta Neuropsychiatrica","volume":"37"},"review":"Peer Reviewed","scoID":["2-s2.0-105007513485"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Universities"],"PST":["Published"]},"sid":["aau-c95a472a-acd4-464b-9de1-227d0707637e","au-eb5f7b59-11af-4c3a-8e3b-1d948373ccbb"],"src":["AAU Aalborg University","AU Aarhus University"],"title":"Gender-Affirming Hormone Therapy, Quality of Life, and the Role of Oestradiol and Testosterone in Transgender Individuals","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-813459","year":"2025","yearsub":"2025"}
{"abstract":"Background: Minimal invasive inguinal hernia repair is conducted using among others the laparoscopic transabdominal preperitoneal (TAPP) procedure or the extended totally extraperitoneal (eTEP) approach. Robotic-assisted TAPP (R-TAPP) has recently been introduced as an alternative to laparoscopic TAPP and TEP, and a growing number of robotic-assisted procedures are performed worldwide. The present study was conducted to determine the risk of chronic pain and recurrence associated with the two methods. Methods: Three hundred ninety-five patients were retrospectively included in the study and underwent either laparoscopic TAPP (n = 177) or R-TAPP (n = 218). Data on patient demographics, hernia characteristics, and postoperative outcomes were retrieved from medical records. Kaplan-Meier curves and Cox proportional hazards regression were used to assess hernia recurrence. Logistic regression was used to analyze secondary outcomes such as inpatient status, hematoma, and chronic pain. Results: The Kaplan-Meier curves indicated a consistently higher cumulative incidence of recurrence in the TAPP group compared to the R-TAPP. Consistent with this finding, the Cox regression showed a higher risk of recurrence in patients undergoing TAPP, with a hazard ratio (HR) of 3.489 (95% CI: 1.232 to 9.880, p = 0.019). The E-value for this HR was 6.44, suggesting robustness to unmeasured confounding. There was no difference in the rates of chronic pain between the groups (OR: 1.233, 95% CI: 0.430 to 3.533, p = 0.696). A logistic regression analysis for other postoperative complications revealed no significant differences. Conclusion: This study provides evidence that robotic-assisted TAPP is associated with a lower risk of recurrence than laparoscopic TAPP.","author_count":10,"contributors":["Valorenzos, Alexandros Valsamidis","Nielsen, Kristian Als","Inan, Ihsan","Pedersen, Andreas Kristian","Petersen, Sofie Ronja","Ellebæk, Mark Bremholm","Alnabhan, Ayat Allah","Helligsø, Per","Dorfelt, Allan","Nielsen, Michael Festersen"],"cuid":["S01-000.00-792316"],"filters":{"added":"2025-02","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"corresponding_author":["Nielsen, Michael Festersen"],"country":["Switzerland"],"glorg":["All Global Affiliations","Clinique Generale-Beaulieu"],"keyword":["Inguinal hernia repair","Recurrence","Risk Factors","Robotic surgery","TAPP"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"reduced risk of recurrence following robotic assisted tapp for inguinal hernia repair compared to laparoscopic tapp a cohort study of 000000000395 cases","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85210362848","version":"Other Version"},"id":"S01-000.00-792316","identifier":[{"id":"85210362848","type":"scopus"},{"id":"39601913","type":"pmid"}],"ids":["sdu-ff4bc272-9d07-4459-9f52-d546c9fbe85b"],"keyword":["Inguinal hernia repair","Recurrence","Risk factors","Robotic surgery","TAPP"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-FE9477C88ECCA13A9E583D668A461C1B"],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Regional Health Research","SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS - Hospital Sønderjylland, Research Unit of Surgery (Aabenraa)"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"ch","key":"clinique generale beaulieu","loc":["Switzerland","Europe, Non-EU","OECD"],"name":"Clinique Generale-Beaulieu","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Alexandros","key":"valorenzosalexandrosvalsamidispau","last":"Valorenzos","locid":"b5de0d16-416c-4477-8aa7-68d3bb6c56f8","name":"Valorenzos, Alexandros Valsamidis","name_org":"Valorenzos, Alexandros","orcid":"0000-0002-0249-3406","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kristian Als","key":"nielsenkristianalspau","last":"Nielsen","locid":"cca6d806-ac35-46c7-aa9b-960ec6b87f0f","name":"Nielsen, Kristian Als","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ihsan","key":"inanihsanpau","last":"Inan","name":"Inan, Ihsan","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andreas Kristian","key":"pedersenandreaskristianpau","last":"Pedersen","locid":"2aa75881-8923-493b-8ea0-9528b7334796","name":"Pedersen, Andreas Kristian","orcid":"0000-0001-5406-1675","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sofie Ronja","key":"petersensofieronjapau","last":"Petersen","locid":"aa8496e0-896f-439c-9cf5-164e3cf3d609","name":"Petersen, Sofie Ronja","orcid":"0000-0001-6177-8930","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mark Bremholm","key":"ellebækmarkbremholmpau","last":"Ellebaek","locid":"80a5416e-11fe-4eb8-97de-0d1b3e412452","name":"Ellebæk, Mark Bremholm","name_org":"Ellebaek, Mark Bremholm","orcid":"0000-0001-6550-7505","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ayat Allah","key":"alnabhanayatallahpau","last":"Alnabhan","locid":"4080ab5a-2676-47ea-ae9e-5f2d50c98f28","name":"Alnabhan, Ayat Allah","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Per","key":"helligsøperpau","last":"Helligsø","locid":"e845578c-463c-46ba-a18d-7a02eb2963ae","name":"Helligsø, Per","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Allan","key":"dorfeltallanpau","last":"Dorfelt","locid":"a347e745-ee00-460c-a934-43606a778d1e","name":"Dorfelt, Allan","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Michael Festersen","key":"nielsenmichaelfestersenpau","last":"Nielsen","locid":"ddcc06a3-6a69-406a-a5b2-13bf125b9776","name":"Nielsen, Michael Festersen","orcid":"0000-0003-0948-1202","rank":10,"rolecode":"pau"}],"pmid":["39601913"],"pub":{"doi":"10.1007/s10029-024-03226-2","issn":["12489204","12654906"],"issn_org":["12654906"],"issue":"1","journal":"Hernia","paperid":"33","publisher":"Springer","status":"p","title":"Hernia","volume":"29"},"review":"Peer Reviewed","scoID":["2-s2.0-85210362848"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-ff4bc272-9d07-4459-9f52-d546c9fbe85b"],"src":["SDU University of Southern Denmark"],"title":"Reduced risk of recurrence following robotic-assisted TAPP for inguinal hernia repair compared to laparoscopic TAPP : a cohort study of 395 cases","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-792316","year":"2025","yearsub":"2025"}
{"abstract":"Due to methodological reasons, the X-chromosome has not been featured in the major genome-wide association studies on Alzheimer’s Disease (AD). To address this and better characterize the genetic landscape of AD, we performed an in-depth X-Chromosome-Wide Association Study (XWAS) in 115,841 AD cases or AD proxy cases, including 52,214 clinically-diagnosed AD cases, and 613,671 controls. We considered three approaches to account for the different X-chromosome inactivation (XCI) states in females, i.e. random XCI, skewed XCI, and escape XCI. We did not detect any genome-wide significant signals (P ≤ 5 × 10−8) but identified seven X-chromosome-wide significant loci (P ≤ 1.6 × 10−6). The index variants were common for the Xp22.32, FRMPD4, DMD and Xq25 loci, and rare for the WNK3, PJA1, and DACH2 loci. Overall, this well-powered XWAS found no genetic risk factors for AD on the non-pseudoautosomal region of the X-chromosome, but it identified suggestive signals warranting further investigations.","author_count":50,"contributors":["Le Borgne, Julie","Gomez, Lissette","Heikkinen, Sami","Amin, Najaf","Ahmad, Shahzad","Choi, Seung Hoan","Bis, Joshua","Grenier-Boley, Benjamin","Rodriguez, Omar Garcia","Kleineidam, Luca","Young, Juan","Tripathi, Kumar Parijat","Wang, Lily","Varma, Achintya","Campos-Martin, Rafael","van der Lee, Sven","Damotte, Vincent","de Rojas, Itziar","Palmal, Sagnik","Lipton, Richard","Reiman, Eric","McKee, Ann","De Jager, Philip","Bush, William","Small, Scott","Levey, Allan","Saykin, Andrew","Foroud, Tatiana","Albert, Marilyn","Hyman, Bradley","Petersen, Ronald","Younkin, Steven","Sano, Mary","Wisniewski, Thomas","Vassar, Robert","Schneider, Julie","Henderson, Victor","Roberson, Erik","DeCarli, Charles","LaFerla, Frank","Brewer, James","Swerdlow, Russell","Van Eldik, Linda","Hamilton-Nelson, Kara","Paulson, Henry","Naj, Adam","Lopez, Oscar","Chui, Helena","Crane, Paul","Frikke-Schmidt, Ruth"],"cuid":["S01-000.00-819890"],"filters":{"added":"2025-08","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Europe, EU","Europe, Non-EU","Nordic","OECD"],"corpau":["EADB, GR@ACE, DEGESCO, EADI, GERAD, DemGene, FinnGen, ADGC, CHARGE"],"country":["Finland","France","Germany","Netherlands","Spain","United Kingdom","United States"],"glorg":["Albert Einstein College of Medicine","All Global Affiliations","Arizona Alzheimer's Consortium","Banner Health","Boston University","Brigham and Women’s Hospital","Broad Institute","Case Western Reserve University","Columbia University","Emory University","Erasmus University Rotterdam","German Center for Neurodegenerative Diseases","Harvard University","Icahn School of Medicine at Mount Sinai","Indiana University Bloomington","Instituto de Salud Carlos III","Johns Hopkins University","Massachusetts General Hospital","Mayo Clinic Jacksonville, FL","Mayo Clinic Rochester, MN","New York University","Northwestern University","Rush University","Stanford University","Translational Genomics Research Institute","UIC Barcelona","University of Alabama at Birmingham","University of Amsterdam","University of Arizona","University of Bonn","University of California at Davis","University of California at Irvine","University of California at San Diego","University of Cologne","University of Eastern Finland","University of Kansas","University of Kentucky","University of Lille","University of Miami","University of Michigan, Ann Arbor","University of Oxford","University of Pennsylvania","University of Pittsburgh","University of Southern California","University of Washington","Vrije Universiteit Amsterdam"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"x chromosome wide association study for alzheimer s disease","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41380-024-02838-5","version":"Published Version"},"id":"S01-000.00-819890","identifier":[{"id":"39633006","type":"pmid"},{"id":"PMC12092188","type":"pmcid"},{"id":"85211480840","type":"scopus"}],"ids":["ku-ac96c321-01d9-46f9-9892-d4f8450c31d5"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-833A722A55ECBF15503C48FAE4B11D50"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/452144081/s41380-024-02838-5.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41380-024-02838-5","version":"Published Version"}],"org":[{"affno":"1","country":"fr","key":"university of lille","loc":["France","Europe, EU","OECD"],"name":"University of Lille","used":1},{"affno":"2","country":"us","key":"university of miami","loc":["United States","America, North","OECD"],"name":"University of Miami","used":1},{"affno":"3","country":"fi","key":"university of eastern finland","loc":["Finland","Europe, EU","Nordic","OECD"],"name":"University of Eastern Finland","used":1},{"affno":"4","country":"gb","key":"university of oxford","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Oxford","used":1},{"affno":"5","country":"nl","key":"erasmus university rotterdam","loc":["Netherlands","Europe, EU","OECD"],"name":"Erasmus University Rotterdam","used":1},{"affno":"6","country":"us","key":"boston university","loc":["United States","America, North","OECD"],"name":"Boston University","used":1},{"affno":"7","country":"us","key":"university of washington","loc":["United States","America, North","OECD"],"name":"University of Washington","used":1},{"affno":"8","country":"de","key":"university of bonn","loc":["Germany","Europe, EU","OECD"],"name":"University of Bonn","used":1},{"affno":"9","country":"de","key":