"3b039da0-efe6-4181-901e-496d255f80e8","name":"Le, Vang","orcid":"0000-0003-2035-8619","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Henrik","key":"kraruppau","last":"Krarup","locid":"72b4ebce-12cf-4f92-bb97-c9a588b06d57","name":"Krarup, Henrik","orcid":"0000-0001-5294-2428","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Michael Bjørn","key":"petersenpau","last":"Petersen","locid":"8512b77d-bdf2-4889-bda3-d399e6867e28","name":"Petersen, Michael Bjørn","orcid":"0000-0003-0316-8207","rank":10,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-f8c49924-2ae3-41cb-87d5-78ebb88c950d","au-64441b7a-f7ce-4750-88c6-6453798c07f2"],"src":["AAU Aalborg University","AU Aarhus University"],"title":"Investigations on the Molecular Genetic Etiology of Mayer-Rokitansky-Kuster-Hauser Syndrome in two Cousins using Exome Sequencing","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-083.87-011876","year":"2013","yearsub":"2013"}
{"abstract":"Evidence-based clinical practice guidelines may improve treatment quality, but the uptake of guideline recommendations is often incomplete and slow. Recently new low back pain guidelines are being launched in Denmark. The guidelines are considered to reduce personal and public costs. The aim of this study is to evaluate whether a complex, multifaceted implementation strategy of the low back pain guidelines will reduce secondary care referral and improve patient outcomes compared to the usual simple implementation strategy.Methods/design: In a two-armed cluster randomised trial, 100 general practices (clusters) and 2,700 patients aged 18 to 65 years from the North Denmark region will be included. Practices are randomly allocated 1:1 to a simple or a complex implementation strategy. Intervention practices will receive a complex implementation strategy, including guideline facilitator visits, stratification tools, and quality reports on low back pain treatment. Primary outcome is referral to secondary care. Secondary outcomes are pain, physical function, health-related quality of life, patient satisfaction with care and treatment outcome, employment status, and sick leave. Primary and secondary outcomes pertain to the patient level. Assessments of outcomes are blinded and follow the intention-to-treat principle. Additionally, a process assessment will evaluate the degree to which the intervention elements will be delivered as planned, as well as measure changes in beliefs and behaviours among general practitioners and patients.","author_count":6,"contributors":["Riis, Allan","Jensen, Cathrine Elgaard","Bro, Flemming","Maindal, Helle Terkildsen","Petersen, Karin Dam","Jensen, Martin Bach"],"cuid":["S02-100.00-010305"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["med","soc"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-NDR"],"OT":["Institut for Folkesundhed - Forskningsenheden for Almen Praksis"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-HO-NDR","DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"enhanced implementation of low back pain guidelines in general practice study protocol of a cluster randomised controlled trial","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1186/1748-5908-8-124","version":"Other Version"},"id":"S02-100.00-010305","identifier":[{"id":"000327595500001","type":"wos"},{"id":"24139140","type":"pmid"},{"id":"84885534047","type":"scopus"},{"id":"PMC4015716","type":"pmcid"}],"ids":["aau-d7a540db-56a3-4d20-bba2-60a32c21fc90","au-d4536150-ba73-4490-9d66-22bd37e0f9f5"],"lang":"English","level":"Scientific","mra":["Medical Science","Social Science"],"noi":["Global-Local-2-5-781990544F1000D88C948B0AEAB507E4"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1186/1748-5908-8-124","version":"Other Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","country":"dk","key":"north denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-NDR","l3nl":"North Denmark Region","l3nn":"North Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"North Denmark Region","namevar":["The North Denmark Region"],"nora_code":"DI-HO-NDR","used":1},{"affno":"2","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Social Sciences","Aalborg University, The Faculty of Social Sciences, Department of Business and Management","Aalborg University, The Faculty of Social Sciences, Department of Business and Management, Danish Center for Healthcare Improvements (Business)"],"nora_code":"DI-U-AAU","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Public Health, Department of Public Health - Forskningsenheden for Almen Praksis"],"nora_code":"DI-U-AU","used":1},{"affno":"4","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Institut for Folkesundhed - Forskningsenheden for Almen Praksis"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Allan","key":"riisallanpau","last":"Riis","name":"Riis, Allan","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Cathrine Elgaard","key":"jensencathrineelgaardpau","last":"Jensen","locid":"078e71ca-9113-46d8-907c-9ec548aa6792","name":"Jensen, Cathrine Elgaard","rank":2,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"country":"dk","first":"Flemming","key":"broflemmingpau","last":"Bro","locid":"17ebdde1-74d4-4ff7-a0c8-8f1d2a0da1f8","name":"Bro, Flemming","rank":3,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"country":"dk","first":"Helle Terkildsen","key":"maindalhelleterkildsenpau","last":"Maindal","locid":"b58ee6f8-7c88-4871-8c46-7673f7d38768","name":"Maindal, Helle Terkildsen","orcid":"0000-0003-0525-7254","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Karin Dam","key":"petersenkarindampau","last":"Petersen","locid":"2e36a0d6-1251-4e37-a8f6-8f0a16c9875e","name":"Petersen, Karin Dam","orcid":"0000-0002-6491-1757","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Martin Bach","key":"jensenmartinbachpau","last":"Jensen","locid":"3785da06-c3a6-443d-8580-aeaaabfddf27","name":"Jensen, Martin Bach","rank":6,"rolecode":"pau"}],"pmid":["24139140"],"pub":{"doi":"10.1186/1748-5908-8-124","issn":["17485908"],"issue":"124","journal":"Implementation Science","paperid":"doi:10.1186/1748-5908-8-124","publisher":"BioMed Central","status":"p","title":"Implementation Science","volume":"8"},"review":"Peer Reviewed","scoID":["2-s2.0-84885534047"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","North Denmark Region","Other Research","Universities"],"PST":["Published"]},"sid":["aau-d7a540db-56a3-4d20-bba2-60a32c21fc90","au-d4536150-ba73-4490-9d66-22bd37e0f9f5"],"src":["AAU Aalborg University","AU Aarhus University"],"title":"Enhanced implementation of low back pain guidelines in general practice : Study protocol of a cluster randomised controlled trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-010305","year":"2013","yearsub":"2013"}
{"abstract":"In recent years, the need for greater security for storing personal and business data or accessing corporate networks on mobile devices has been growing rapidly, and one of the potential solutions is to employ innovative biometric authentication techniques. This article presents the development of a mobile biometric authentication system based on electroencephalogram (EEG) recordings in combination with already proven technologies such as facial detection and nearfield communication (NFC). The overall goal of this work is to fill the gap between mobile Web technologies and wireless EEG devices and to develop a new authentication technique and a feasible application. Therefore, we review the relevant literature, conduct several EEG measurement experiments, and discuss the procedure and results with experts in the EEG and digital signal processing (DSP) fields. On the basis of these results, we build and present a mobile prototype system capable of authenticating users based on the uniqueness of their brain waves. Furthermore, we implement a novel authentication process that will make the authentication system more secure. We also give suggestions for future improvements to the system.","author_count":4,"contributors":["Klonovs, Juris","Petersen, Christoffer Kjeldgaard","Olesen, Henning","Hammershøj, Allan Dyhr"],"cuid":["S01-000.00-112961"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-AAU","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"id proof on the go development of a mobile eeg based biometric authentication system","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1109/MVT.2012.2234056","version":"Other Version"},"id":"S01-000.00-112961","identifier":[{"id":"84879293497","type":"scopus"},{"id":"WOS:000318221600012","type":"wos"}],"ids":["aau-d88674c3-4040-4780-9475-636cf822f869"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-1694B381BD00A425E0FA7AB56EE07A12"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1109/MVT.2012.2234056","version":"Other Version"},{"access":"oa","type":"rem","url":"http://ieeexplore.ieee.org/search/searchresult.jsp?newsearch=true&queryText=klonovs&x=0&y=0","version":"Other Version"}],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (ENG), Department of Mechanical and Manufacturing Engineering (M-TECH)","Aalborg University, The Faculty of Engineering and Science (TECH)","Aalborg University, The Faculty of Engineering and Science, Department of Materials and Production, Robotics and Automation","Aalborg University, The Faculty of Engineering and Science, Department of Materials and Production, Robotics, Vision and Machine Intelligence"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"dk","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Department of Informatics and Mathematical Modeling"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Juris","key":"klonovspau","last":"Klonovs","locid":"92c2c39b-a852-4afa-94c1-d0103d6e73f9","name":"Klonovs, Juris","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christoffer Kjeldgaard","key":"petersenpau","last":"Petersen","locid":"b8d938f6-7597-4534-ab01-9f8fb359b5a4","name":"Petersen, Christoffer Kjeldgaard","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Henning","key":"olesenpau","last":"Olesen","locid":"d09c5e60-0c7f-4d62-b19e-070932b39ef3","name":"Olesen, Henning","orcid":"0000-0002-9331-4011","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Allan Dyhr","key":"hammershøjpau","last":"Hammershøj","name":"Hammershøj, Allan Dyhr","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1109/mvt.2012.2234056","issn":["15566072","15566080"],"issn_org":["15566072"],"issue":"1","journal":"IEEE Vehicular Technology Magazine","pages":"81-89","publisher":"IEEE (Institute of Electrical and Electronics Engineers)","status":"p","title":"IEEE Vehicular Technology Magazine","title_org":"I E E E Vehicular Technology Magazine","volume":"8"},"review":"Peer Reviewed","scoID":["2-s2.0-84879293497"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["aau-d88674c3-4040-4780-9475-636cf822f869"],"src":["AAU Aalborg University"],"title":"ID Proof on the Go : Development of a Mobile EEG-Based Biometric Authentication System","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-112961","year":"2013","yearsub":"2013"}
{"abstract":"A barrier for exploiting use of standalone solar lighting for the urban environment seem to be lack of knowledge and lack of available tools for proper dimensioning. In this work, the first part of the development of powerful dimensioning tool is described and initial measurements are presented.","author_count":14,"contributors":["Poulsen, Peter Behrensdorff","Dam-Hansen, Carsten","Thorseth, Anders","Thorsteinsson, Sune","Lindén, Johannes","Petersen, Paul Michael","Mira Albert, Maria del Carmen","Knott, Arnold","Norby, Poul","Jensen, Allan Krogh","Mogensen, Ib","Lyhne, Morten","Herbst, Silla","Bay, Anne"],"cuid":["S01-000.00-315942"],"event":{"end":"2013-10-04","place":"Paris, fr","start":"2013-09-30","title":"28th European PV Solar Energy Conference and Exhibition (EU PVSEC 2013)","year":"2013"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-PR","DI-U"],"level3":{"OT":["LyhneDesign"],"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-PR-OTH","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"simulation tool for designing off grid pv applications for the urban environments","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/60023647/5CV.7.41.pdf","version":"Other Version"},"id":"S01-000.00-315942","ids":["dtu-2653ef87-89aa-4aa0-8a05-fa2f26ddcd02"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-8D904C151B9AD3F1C8A24EC6CB95FD83"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/60023647/5CV.7.41.pdf","version":"Other Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Photonics Engineering","Technical University of Denmark, Department of Photonics Engineering, Diode Lasers and LED Systems"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["AKJ Inventions ApS"],"nora_code":"DI-PR-OTH","used":1},{"affno":"3","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["LyhneDesign"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Peter Behrensdorff","key":"poulsenpau","last":"Poulsen","locid":"9b449377-be46-41a9-a86e-a62a8dcef700","name":"Poulsen, Peter Behrensdorff","orcid":"0000-0001-7317-4472","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Carsten","key":"damhansenpau","last":"Dam-Hansen","locid":"9560dc41-73f3-41fd-aa1d-cbf953325027","name":"Dam-Hansen, Carsten","orcid":"0000-0001-7518-4025","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders","key":"thorsethpau","last":"Thorseth","locid":"0c4167f1-cc9a-41f0-8dd1-5bda544f6f4e","name":"Thorseth, Anders","orcid":"0000-0003-4344-0770","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sune","key":"thorsteinssonpau","last":"Thorsteinsson","locid":"831fbf16-0dba-4594-b98f-b52bcb84874c","name":"Thorsteinsson, Sune","orcid":"0000-0002-8942-3784","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Johannes","key":"lindénpau","last":"Lindén","locid":"b1c27c6c-2875-4eea-b222-db889d4da2b0","name":"Lindén, Johannes","orcid":"0000-0001-9023-8677","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Paul Michael","key":"petersenpau","last":"Petersen","locid":"6527577a-b638-4f24-85f1-0c36cec2d880","name":"Petersen, Paul Michael","orcid":"0000-0002-4202-4655","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Maria del Carmen","key":"miraalbertpau","last":"Mira Albert","locid":"c8c83ef6-2de7-4303-a06a-93af1b3cd2ac","name":"Mira Albert, Maria del Carmen","orcid":"0000-0002-6856-9995","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Arnold","key":"knottpau","last":"Knott","locid":"c57cedaa-860d-473e-a2b4-9682e3e95de9","name":"Knott, Arnold","orcid":"0000-0003-4384-0432","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Poul","key":"norbypau","last":"Norby","locid":"fbf8f0f9-58c6-4daf-ae51-857723a6b087","name":"Norby, Poul","orcid":"0000-0002-2590-7050","rank":9,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Allan Krogh","key":"jensenpau","last":"Jensen","name":"Jensen, Allan Krogh","rank":10,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ib","key":"mogensenpau","last":"Mogensen","name":"Mogensen, Ib","rank":11,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Morten","key":"lyhnepau","last":"Lyhne","name":"Lyhne, Morten","rank":12,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Silla","key":"herbstpau","last":"Herbst","name":"Herbst, Silla","rank":13,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Anne","key":"baypau","last":"Bay","name":"Bay, Anne","rank":14,"rolecode":"pau"}],"pub":{"status":"p","title":"Proceedings of the 28th EU PVSEC"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Private Research","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Companies","Other Research","Private Research","Technical University of Denmark","Universities","akj inventions aps","out-sider a/s"],"PST":["Published"]},"sid":["dtu-2653ef87-89aa-4aa0-8a05-fa2f26ddcd02"],"src":["DTU Technical University of Denmark"],"title":"Simulation Tool for Designing off-Grid PV Applications for the Urban Environments","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-315942","year":"2013","yearsub":"2013"}
{"abstract":"Purpose: CT angiography (CTA) can rule out significant stenoses with a very high reliability, whereas its ability to confirm significant stenoses is suboptimal. In contrast, measurements of myocardial blood flow (MBF) provide information on the haemodynamic consequences of stenoses. Therefore, a combination of the two might improve diagnostic accuracy. We conducted a head-to-head comparison of CTA, measurement of MBF by 15O-water PET, and hybrid PET/CTA for the detection of significant coronary artery stenoses. Methods: The study group comprised 44 outpatients scheduled for invasive coronary angiography (ICA) with an intermediate pretest likelihood of coronary artery disease. The patients underwent 64-slice CTA and baseline and hyperaemic PET before ICA with quantitative coronary angiography analysis. Results: On a per-patient basis, the negative predictive values (NPV; 95 % confidence intervals in parentheses) were 88 % (64 - 97 %) for CTA, 90 % (71 - 97%) for PET and 92 % (74 - 98%) for PET/CTA, and the positive predictive values (PPV) were 71 % (53 - 85%) for CTA, 87 % (68 - 95%) for PET and 100 % (84 - 100%) for PET/CTA. Similarly, on a per-vessel basis the NPVs (which were generally high) were 97 % (94 - 100%) for CTA, 95 % (90 - 99%) for PET and 97 % (95 - 100%) for PET/CTA, and the PPVs (which were lower, but higher with PET/CTA) were 53 % (39 - 66%) for CTA, 53 % (40 - 66%) for PET and 85 % (73 - 97%) for PET/CTA. In six patients, CTA analysis was hampered by the presence of severe calcifications. However, with the addition of the PET data, all six patients were correctly categorized. Conclusion: Cardiac quantitative hybrid PET/CTA imaging has better diagnostic accuracy than CTA alone and PET alone. CTA has a suboptimal PPV, suggesting that hybrid PET/CTA imaging should be used to assess the significance of coronary stenoses diagnosed by CTA.","author_count":13,"contributors":["Thomassen, Anders","Petersen, Henrik","Diederichsen, Axel Cosmus Pyndt","Mickley, Hans","Jensen, Lisette Okkels","Johansen, Allan","Gerke, Oke","Braad, Poul-Erik","Thayssen, Per","Høilund-Carlsen, Mette M","Vach, Werner","Knuuti, Juhani","Høilund-Carlsen, Poul Flemming"],"cuid":["S01-000.00-637838"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","University of Freiburg"],"keyword":["Hybrid imaging","Myocardial blood flow","O water","PET CT","Quantification"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"hybrid ct angiography and quantitative 000000000015 o water pet for assessment of coronary artery disease comparison with quantitative coronary angiography","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84888012779","version":"Other Version"},"id":"S01-000.00-637838","identifier":[{"id":"84888012779","type":"scopus"},{"id":"23982453","type":"pmid"}],"ids":["sdu-e19beb51-ae72-4183-9b61-3266286434f5"],"keyword":["Hybrid imaging","Myocardial blood flow","O-Water","PET/CT","Quantification"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-FDDD6E4E1DBB68D57A7E767BB5841C4B"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Clinical Physiology and Nuc