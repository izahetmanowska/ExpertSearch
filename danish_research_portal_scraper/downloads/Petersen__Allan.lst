e","orcid":"0000-0001-8951-6705","rank":14,"rolecode":"pau"},{"affno":"1 2","first":"Allan","key":"linnebergpau","last":"Linneberg","locid":"09da8aa6-fd95-4ace-a2f1-19f38d7d3f9e","name":"Linneberg, Allan","orcid":"0000-0002-0994-0184","rank":15,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"country":"dk","first":"Per","key":"finkpau","last":"Fink","locid":"22d646ca-5dee-456c-ae39-6c0687a18ce8","name":"Fink, Per","orcid":"0000-0003-2921-4099","rank":16,"rolecode":"pau"}],"pmid":["36245407"],"pub":{"doi":"10.1177/14034948221122886","issn":["14034948","16511905"],"issn_org":["14034948"],"issue":"7","journal":"Scandinavian Journal of Public Health","pages":"988-994","publisher":"SAGE Publications Ltd","status":"p","title":"Scandinavian Journal of Public Health","volume":"50"},"review":"Peer Reviewed","scoID":["2-s2.0-85139887611"],"sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-7a370655-0da1-4094-b99b-962ba8c01d20","dtu-96878b61-719a-4cdb-bcb5-3ddf427c16d6","ku-37704ccf-dae7-409a-b1ee-09ae171034fb"],"src":["AU Aarhus University","DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Examine the public health impacts of functional somatic disorders using the DanFunD study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-092.65-021584","year":"2022","yearsub":"2022"}
{"abstract":"We reviewed all cases of Panton-Valentine leukocidin-producing Staphylococcus aureus (PVL-SA) bacteremia in Danish children between 2016 and 2021. We found 2 fatal cases with preceding viral prodrome due to severe acute respiratory syndrome coronavirus 2 (SARS-CoV-2). Given the usual benign course of SARS-CoV-2 infection in children, awareness of possible superinfection with PVL-SA in a child with rapid deterioration is crucial to ensure adequate treatment, including antimicrobial drugs with antitoxin effect.","author_count":12,"contributors":["Nygaard, Ulrikka","Petersen, Andreas","Larsen, Anders Rhod","Rytter, Maren Johanne Heilskov","Hartling, Ulla","Kirkby, Nikolai","Hansen, Rikke Nymark","Nielsen, Allan Bybeck","Lundstrøm, Kaare","Holm, Mette","Vissing, Nadja Hawwa"],"cuid":["S04-096.96-008849"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"corresponding_author":["Nygaard, Ulrikka"],"keyword":["AUREUS","Panton Valentine leukocidin","SARS CoV 2","Staphylococcus aureus"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"fatal sars cov 000000000002 associated panton valentine leukocidin producing staphylococcal bacteremia a nationwide multicenter cohort study","src":["aau","au","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1097/INF.0000000000003476","version":"Published Version"},"id":"S04-096.96-008849","identifier":[{"id":"35093994","t