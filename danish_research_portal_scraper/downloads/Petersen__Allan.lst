Karin Dam","orcid":"0000-0002-6491-1757","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mette Dahl","key":"bendtsenmettedahlpau","last":"Bendtsen","locid":"d622c88e-658d-4b77-b3fd-2a506540431e","name":"Bendtsen, Mette Dahl","orcid":"0000-0003-2403-3520","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Martin Bach","key":"jensenmartinbachpau","last":"Jensen","locid":"929fc31a-f5b6-45b8-b3ed-29bd2c4b4bf7","name":"Jensen, Martin Bach","orcid":"0000-0003-2162-7390","rank":7,"rolecode":"pau"}],"pmid":["27769263"],"pub":{"doi":"10.1186/s13012-016-0509-0","issn":["17485908"],"issue":"1","journal":"Implementation Science","paperid":"143","publisher":"BioMed Central","status":"p","title":"Implementation Science","volume":"11"},"review":"Peer Reviewed","scoID":["2-s2.0-84992202150"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-2869ad7a-f75d-410c-846c-b5cd439bbea1","au-93e4389d-d0ba-4c4c-8fbf-e9c5e23dd63f"],"src":["AAU Aalborg University","AU Aarhus University"],"title":"A multifaceted implementation strategy versus passive implementation of low back pain guidelines in general practice : a cluster randomised controlled trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-002024","year":"2016","yearsub":"2016"}
