{"abstract":"There is limited experience with implementation of chronic obstructive pulmonary disease (COPD) rehabilitation in primary care settings. We aimed to evaluate the implementation of a COPD rehabilitation programme in a primary care setting and compare the effects with those obtained in a secondary health-care setting.","author_count":8,"contributors":["Vest, Susanne","Moll, Lill","Petersen, Marelis","Buch, Tove Fedder","Bruun, Ditte Marie","Rask, Marie","Wester, Anette","Linneberg, Allan"],"cuid":["S01-000.00-525168"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"results of an outpatient multidisciplinary copd rehabilitation programme obtained in two settings primary and secondary health care","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1111/j.1752-699X.2010.00203.x","version":"Other Version"},"id":"S01-000.00-525168","identifier":[{"id":"79952712189","type":"scopus"},{"id":"21410900","type":"pmid"}],"ids":["ku-dc83484f-e806-4615-a4ca-4b9a5ccded56"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-76A09E7E71A5401FCB1CEB524B5BAF81"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1111/j.1752-699X.2010.00203.x","version":"Other Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Graduate School of Health and Medical Sciences"],"nora_code":"DI-U-KU","used"