"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Allan","key":"bybecknielsenpau","last":"Bybeck Nielsen","name":"Bybeck Nielsen, Allan","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Anders Rhod","key":"larsenpau","last":"Larsen","name":"Larsen, Anders Rhod","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Andreas","key":"petersenpau","last":"Petersen","name":"Petersen, Andreas","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Henrik Carl","key":"schønheyderpau","last":"Schønheyder","locid":"d35b264a-6efc-467d-ac9d-e558542ef8a8","name":"Schønheyder, Henrik Carl","rank":4,"rolecode":"pau"},{"affno":"4 5","first":"Henrik","key":"westhpau","last":"Westh","locid":"5ed71556-672c-4f57-95de-3abba6b821ea","name":"Westh, Henrik","rank":5,"rolecode":"pau"},{"affno":"4","first":"Thomas","key":"benfieldpau","last":"Benfield","locid":"03fdbbba-4bc0-41aa-845b-81ba0bded9ba","name":"Benfield, Thomas","orcid":"0000-0003-0698-9385","rank":6,"rolecode":"pau"},{"affno":"4 5","first":"Ulrikka","key":"nygaardpau","last":"Nygaard","locid":"43b2e239-ddc1-4676-a8db-0a0f23906813","name":"Nygaard, Ulrikka","rank":7,"rolecode":"pau"}],"pmid":["32496412"],"pub":{"doi":"10.1097/inf.0000000000002722","issn":["08913668","10733175"],"issn_org":["08913668"],"issue":"9","journal":"Pediatric Infectious Disease Journal","status":"p","title":"Pediatric Infectious Disease Journal","title_org":"The Pediatric Infectious Disease Journal","volume":"39"},"review":"Peer Reviewed","scoID":["2-s2.0-85089618523"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Governmental Institutions","All Hospitals","All Misc