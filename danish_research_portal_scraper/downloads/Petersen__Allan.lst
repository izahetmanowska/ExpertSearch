w","key":"pedersenpau","last":"Pedersen","name":"Pedersen, Inge Bülow","rank":2,"rolecode":"pau"},{"affno":"3 4","first":"Nils","key":"knudsenpau","last":"Knudsen","locid":"1c70e34f-e0dd-4b2a-a5ba-4118fb4eb8f3","name":"Knudsen, Nils","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Stig","key":"andersenpau","last":"Andersen","locid":"61af62ab-d105-4f02-bbea-e6d8146a3e66","name":"Andersen, Stig","orcid":"0000-0003-3632-5213","rank":4,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"country":"dk","first":"Torben","key":"jørgensenpau","last":"Jørgensen","locid":"a5d9b7f4-413e-465f-a6f2-1f53e2b34186","name":"Jørgensen, Torben","rank":5,"rolecode":"pau"},{"affno":"3","first":"Torben","key":"jorgensenpau","last":"Jorgensen","locid":"368044df-7d2b-4204-9103-8c0272f1baca","name":"Jørgensen, Torben","name_org":"Jorgensen, Torben","rank":5,"rolecode":"pau"},{"affno":"3 4","first":"Hans","key":"perrildpau","last":"Perrild","locid":"1012770b-3e2e-4361-914b-15f90e6f9324","name":"Perrild, Hans","rank":6,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Lars","key":"ovesenpau","last":"Ovesen","name":"Ovesen, Lars","rank":7,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Lone","key":"bankerasmussenpau","last":"Banke Rasmussen","name":"Banke Rasmussen, Lone","rank":8,"rolecode":"pau"},{"affno":"","first":"Lone Banke","key":"rasmussenpau","last":"Rasmussen","name":"Rasmussen, Lone Banke","rank":8,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Betina H","key":"thuesenpau","last":"Thuesen","name":"Thuesen, Betina H","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Allan","key":"carlépau","last":"Carlé","locid":"302be08f-b6cb-46ad-9253-645a50ba4072","name":"Carlé, Allan","rank":10,"rolecode":"pau"}],"pmid":["31400012"],"pub":{"doi":"10.1111/cen.14072","issn":["03000664","13652265"],"issn_org":["03000664"],"issue":"5","journal":"Clinical Endocrinology","pages":"652-659","publisher":"Wiley-Blackwell","status":"p","title":"Clinical Endocrinology","volume":"91"},"review":"Peer Reviewed","scoID":["2-s2.0-85072211364"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["aau-8fa2becb-038a-4d65-8fcb-ce2c0871c343","ku-de676e17-b174-4504-a80a-6d558a2ced3d"],"src":["AAU Aalborg University","KU University of Copenhagen"],"title":"Changes in subtypes of overt thyrotoxicosis and hypothyroidism following iodine fortification","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-095.27-006964","year":"2019","yearsub":"2019"}
{"abstract":"OBJECTIVE: To monitor the impact of a cautious iodine fortification (IF) on the incidence of overt hypothyroidism in two subpopulations with different levels of preexisting iodine deficiency (ID). DESIGN: A 20-year (1997 to 2016) prospective population-based study identified all new cases of diagnosed overt biochemical hypothyroidism in two open cohorts: a western cohort with moderate ID (n = 309,434; 1 January 1997) and an eastern cohort with mild ID (n = 224,535; 1 January 1997). A diagnostic algorithm was applied to all thyroid function tests performed within the study areas, and possible new cases were verified individually. Mandatory IF of salt was initiated in mid-2000 (13 ppm). The current study is a part of the DanThyr study. RESULTS: At baseline, standardized incidence rates (SIRs) of hypothyroidism were 32.9 and 47.3/100.000/y in the cohorts with moderate and mild ID, respectively. The SIR of hypothyroidism increased significantly in both cohorts after implementing mandatory IF, with peak values of 150% in 2014 to 2016 for the moderate ID cohort and 130% in 2004 to 2005 for the mild ID cohort. Significant increases in SIR were seen among the young and middle-aged participants of both cohorts, whereas no changes were seen among the elderly participants (≥60 years). The follow-up period for the mildly iodine-deficient cohort was restricted up to and including 2008. CONCLUSION: The cautious initiation of the IF program in Denmark caused a sustained increase in hypothyroidism incidence among subjects residing in areas of moderate and mild ID but only among the young and middle-aged participants.","author_count":10,"contributors":["Petersen, Mads","Knudsen, Nils","Carlé, Allan","Andersen, Stig","Jørgensen, Torben","Perrild, Hans","Ovesen, Lars","Rasmussen, Lone Banke","Thuesen, Betina Heinsbæk","Pedersen, Inge Bülow"],"cuid":["S02-099.63-002492"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-ZEA"],"OT":["Department of Endocrinology, Bispebjerg Hospital, University of Copenhagen, 2400 Copenhagen, Denmark"],"U":["DI-U-AAU","DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-HO-ZEA","DI-U-AAU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"increased incidence rate of hypothyroidism after iodine fortification in denmark a 000000000020 year prospective population based study","src":["aau","ku"],"src-code":["DI-U-AAU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/251108598/Increased_Incidence_Rate_of_Hypothyroidism_After_Iodine_Fortification_in_Denmark_A_20_Year_Prospective_Population_Based_Study_accepted_version_.pdf","version":"Authors Final Version"},"id":"S02-099.63-002492","identifier":[{"id":"000473692100048","type":"wos"},{"id":"85062716723","type":"scopus"},{"id":"30551165","type":"pmid"}],"ids":["aau-322a2f2c-0dc3-4abb-9c78-6891b080c72a","ku-dc628837-e397-4aab-a1f7-7d0e4fbe886c"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-AA773CAE4970B3F013FC230E69939332"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/291722083/jc.2018_01993.pdf","version":"Authors Final Version"},{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/251108598/Increased_Incidence_Rate_of_Hypothyroidism_After_Iodine_Fortification_in_Denmark_A_20_Year_Prospective_Population_Based_Study_accepted_version_.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"na