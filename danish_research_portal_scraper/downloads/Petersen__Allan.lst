":[{"affno":"1","first":"Marie Louise","key":"nørredampau","last":"Nørredam","locid":"b2ded723-225a-455c-ae7b-9be191ab1b53","name":"Norredam, Marie","name_org":"Nørredam, Marie Louise","rank":1,"rolecode":"pau"},{"affno":"","first":"Olof","key":"højbjerghansenpau","last":"Højbjerg Hansen","name":"Højbjerg Hansen, Olof","rank":2,"rolecode":"pau"},{"affno":"1","first":"Jørgen Holm","key":"petersenpau","last":"Petersen","locid":"33c1c5b2-2e1e-4259-b4d7-04657a2bdb9b","name":"Petersen, Jørgen Holm","orcid":"0000-0003-3979-7443","rank":3,"rolecode":"pau"},{"affno":"","first":"Anton E.","key":"kunstpau","last":"Kunst","name":"Kunst, Anton E.","rank":4,"rolecode":"pau"},{"affno":"1","first":"Maria","key":"kristiansenpau","last":"Kristiansen","locid":"13278ef3-9d75-4663-afac-8f8ba79ba7f3","name":"Kristiansen, Maria","orcid":"0000-0003-2319-3637","rank":5,"rolecode":"pau"},{"affno":"1","first":"Allan","key":"krasnikpau","last":"Krasnik","locid":"d1a42a6c-e3d6-4d5b-803e-e80b13314d46","name":"Krasnik, Allan","orcid":"0000-0003-1612-6129","rank":6,"rolecode":"pau"},{"affno":"","first":"Charles","key":"agyemangpau","last":"Agyemang","name":"Agyemang, Charles","rank":7,"rolecode":"pau"}],"pmid":["25201902"],"pub":{"doi":"10.1093/eurpub/cku138","issn":["11011262","1464360X"],"issn_org":["11011262"],"issue":"1","journal":"European Journal of Public Health","pages":"84-89","status":"p","title":"European Journal of Public Health","volume":"25"},"review":"Peer Reviewed","scoID":["2-s2.0-84922469340"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-b2466975-d371-4858-9eac-6b80a5891685"],"src":["KU University of Copenhagen"],"title":"Remigration of migrants with severe disease : myth or reality?—a register-based cohort study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-499892","year":"2015","yearsub":"2015"}
{"abstract":"AIMS: Reporting of quantitative myocardial blood flow (MBF) is typically performed in standard coronary territories. However, coronary anatomy and myocardial vascular territories vary among individuals, and a coronary artery may erroneously be deemed stenosed or not if territorial demarcation is incorrect. So far, the diagnostic consequences of calculating individually vs. standardly assessed MBF values have not been reported. We examined whether individual reassignment of vascular territories would improve the diagnostic accuracy of MBF with regard to the detection of significant coronary artery disease (CAD). METHODS AND RESULTS: Forty-four patients with suspected CAD were included prospectively and underwent coronary CT-angiography and quantitative MBF assessment with O-15-water PET followed by invasive, quantitative coronary angiography, which served as reference. MBF was calculated in the vascular territories during adenosine stress according to a standardized 17-segment American Heart Association model and an individualized model, using CT-angiography to adjust the coronary territories to their feeding vessels. Individually defined territories deviated from standard territories in 52% of patients. However, MBF in the three coronary territories defined by standard and individualized models did not differ significantly, except in one patient, in whom the MBF of an individualized coronary territory deviated sufficiently as to change the test from a false positive to a true negative result in this particular territory. CONCLUSION: Disparity between standardized and individualized vascular territories was present in half of the patients, but had little clinical impact. Still, caution should be taken not always to rely on standard territories, as this may at times cause misinterpretation.","author_count":11,"contributors":["Thomassen, Anders","Petersen, Henrik","Johansen, Allan","Braad, Poul-Erik","Diederichsen, Axel Cosmus Pyndt","Mickley, Hans","Jensen, Lisette Okkels","Gerke, Oke","Simonsen, Jane Angel","Thayssen, Per","Høilund-Carlsen, Poul Flemming"],"cuid":["S01-000.00-599161"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"quantitative myocardial perfusion by o 000000000015 water pet individualized vs standardized vascular territories","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84989159363","version":"Other Version"},"id":"S01-000.00-599161","identifier":[{"id":"84989159363","type":"scopus"},{"id":"25944051","type":"pmid"}],"ids":["sdu-5a8b70e4-4ab4-435a-93fc-0b5e24a7dad5"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-41FFDEEBCAB8CBBDD221A3BF579A64D8"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Clinical Physiology and Nuclear Medicine (Odense)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Anders","key":"thomassenpau","last":"Thomassen","locid":"1c7f11fb-cf64-4085-909d-b78f183b9364","name":"Thomassen, Anders","orcid":"0000-0001-9839-1158","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Henrik","key":"petersenpau","last":"Petersen","locid":"ea635371-4294-4379-9655-3da538fecf13","name":"Petersen, Henrik","orcid":"0000-0002-1118-1500","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Allan","key":"johansenpau","last":"Johansen","locid":"dc7a1a61-b703-48ec-bd87-c92b55784133","name":"Johansen, Allan","orcid":"0000-0002-3622-057X","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Poul-Erik","key":"braadpau","last":"Braad","locid":"7df4b5a6-a971-420c-b424-ccc861b7f5ff","name":"Braad, Poul-Erik","orcid":"0000-0003-4906-5422","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Axel Cosmus Pyndt","key":"diederichsenpau","last":"Diederichsen","locid":"d84be6bc-52bf-4710-9f66-0209cfab4f54","name":"Diederichsen, Axel Cosmus Pyndt","orcid":"0000-0002-1285-4826","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hans","key":"mickleypau","last":"Mickley","locid":"f6789f9a-e23b-4ab8-bd7d-a3c168107cdb","name":"Mickley, Hans","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lisette Okkels","key":"jensenpau","last":"Jensen","locid":"b78c452e-5a69-41fe-ba49-0096c84d1d4d","name":"Jensen, Lisette Okkels","orcid":"0000-0002-4838-2429","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Oke","key":"gerkepau","last":"Gerke","locid":"596baeb1-6754-4d53-948f-30470dd1d976","name":"Gerke, Oke","orcid":"0000-0001-6335-3303","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jane Angel","key":"simonsenpau","last":"Simonsen","locid":"5ec614c0-1a1d-4de1-833b-f1f5f3c7536e","name":"Simonsen, Jane Angel","orcid":"0000-0002-6440-3816","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Per","key":"thayssenpau","last":"Thayssen","locid":"ac38a4d1-1115-438e-bd0a-0eac73fc3d2a","name":"Thayssen, Per","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Poul Flemming","key":"høilundcarlsenpau","last":"Høilund-Carlsen","locid":"a1ff65cf-cdaa-4192-bef3-a915cfe6cceb","name":"Høilund-Carlsen, Poul Flemming","orcid":"0000-0001-7420-2367","rank":11,"rolecode":"pau"}],"pmid":["25944051"],"pub":{"doi":"10.1093/ehjci/jev111","issn":["15252167","15322114"],"issn_org":["20472404"],"issue":"9","journal":"European Heart Journal Cardiovascular Imaging","pages":"970-976","publisher":"Oxford University Press","status":"p","title":"European Heart Journal Cardiovascular Imaging","title_org":"European Heart Journal - Cardiovascular Imaging","volume":"16"},"review":"Peer Reviewed","scoID":["2-s2.0-84989159363"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-5a8b70e4-4ab4-435a-93fc-0b5e24a7dad5"],"src":["SDU University of Southern Denmark"],"title":"Quantitative myocardial perfusion by O-15-water PET : individualized vs. standardized vascular territories","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-599161","year":"2015","yearsub":"2015"}
{"abstract":"BACKGROUND: Increasing global migration has made immigrants' health an important topic worldwide. We examined the effect of country of birth, migrant status (refugee/family-reunified) and income on coronary heart disease (CHD) incidence. DESIGN: This was a historical prospective register-based cohort study. METHODS: The study cohort consisted of immigrants above 18 years from non-Western countries who had obtained a residence permit in Denmark as a refugee (n = 29,045) or as a family-reunified immigrant (n = 28,435) from 1 January 1993-31 December 1999 and a Danish-born reference population (n = 229,918). First-time CHD incidence was identified from 1 January 1993-31 December 2007. Incidence ratios for 11 immigrant groups were estimated using Cox regression analysis. RESULTS: Immigrants from Afghanistan, Iraq, Turkey, Eastern Europe and Central Asia, South Asia, the Former Yugoslavia, and the Middle East and North Africa had significantly higher incidences of CHD (hazard ratio (HR) = 1.36; 95% confidence interval (CI): 1.05-1.75 to HR = 2.86; 95% CI: 2.01-4.08) compared with Danish-born people. Immigrants from Somalia, South and Middle America, Sub-Saharan Africa and women from East Asia and the Pacific did not differ significantly from Danish-born people, whereas immigrant men from East Asia and the Pacific had a significantly lower incidence (HR = 0.32; 95% CI: 0.17-0.62). When also including migrant status, the higher incidences were reduced. Refugee men (HR = 1.35; 95% CI: 1.11-1.65) and women (HR = 1.33; 95% CI: 1.08-1.65) had a significantly higher incidence of CHD than family-reunified immigrants. When migrant status and income were included simultaneously, the incidences decreased to an insignificant level for most immigrant groups. CONCLUSIONS: Most non-Western immigrant groups had a higher incidence of CHD than Danish-born people. The study revealed that migrant status and income are important underlying mechanisms of the effect of country of birth on CHD.","author_count":6,"contributors":["Bo, Anne","Zinckernagel, Line","Krasnik, Allan","Petersen, Jorgen H","Norredam, Marie"],"cuid":["S03-094.15-016935"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":3,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"coronary heart disease incidence among non western immigrants compared to danish born people effect of country of birth migrant status and income","src":["au","ku","sdu"],"src-code":["DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1177/2047487314551538","version":"Other Version"},"id":"S03-094.15-016935","identifier":[{"id":"25261269","type":"pmid"},{"id":"84944900131","type":"scopus"}],"ids":["au-3a5e3bd4-c3f5-453e-b51e-99d8b4f3944e","ku-1f39f7e8-31df-437b-90e3-d9fba4bea977","sdu-f9d2d5ae-dfa9-494c-856b-8252e476012e"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-C7F4285863E591CC0137DFA84675CF3C"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1177/2047487314551538","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2015","yearSub":"2014"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Public Health, Department of Public Health - Department of Health Services Research"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","