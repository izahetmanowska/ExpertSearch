of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Mads","key":"petersenpau","last":"Petersen","locid":"6780e583-94a8-431e-a84b-1ee1e6c50464","name":"Petersen, Mads","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Nils","key":"knudsenpau","last":"Knudsen","name":"Knudsen, Nils","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Allan","key":"carlépau","last":"Carlé","locid":"302be08f-b6cb-46ad-9253-645a50ba4072","name":"Carlé, Allan","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Stig","key":"andersenpau","last":"Andersen","locid":"61af62ab-d105-4f02-bbea-e6d8146a3e66","name":"Andersen, Stig","orcid":"0000-0003-3632-5213","rank":4,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Torben","key":"jørgensenpau","last":"Jørgensen","name":"Jørgensen, Torben","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Hans","key":"perrildpau","last":"Perrild","name":"Perrild, Hans","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Lars","key":"ovesenpau","last":"Ovesen","name":"Ovesen, Lars","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lone","key":"bankerasmussenpau","last":"Banke Rasmussen","name":"Banke Rasmussen, Lone","rank":8,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Betina Heinsbæk","key":"thuesenpau","last":"Thuesen","name":"Thuesen, Betina Heinsbæk","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Inge Bülow","key":"pedersenpau","last":"Pedersen","locid":"0b17bcdf-70d8-459d-a188-1d38f12a4664","name":"Pedersen, Inge Bülow","rank":10,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["aau-3daea0ec-fe6a-483a-91e9-94cb30822dc3"],"src":["AAU Aalborg University"],"title":"Flere milde, forbigående og ikke behandlingskrævende tilfælde af hypothyroidisme i Danmark efter jodberigelsen. : A retrospective population-based cohort study","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-067931","year":"2019","yearsub":"2019"}
{"abstract":"OBJECTIVES: The mitochondrial DNA (mtDNA) point mutation m.3243A>G is known to express the following two syndromes among others: Maternally inherited diabetes and deafness (MIDD) and mitochondrial encephalopathy, lactic acidosis, and stroke-like episodes (MELAS). Sensorineural hearing loss (SNHL) is the most frequent symptom in individuals harboring the m.3243A>G mutation. However, dysfunction of the vestibular organs has been scarcely examined. Therefore, the present study aimed to study the impact of the m.3243A>G mutation on the inner ear. MATERIALS and METHODS: A total of 8 subjects harboring the blood-verified m.3243A>G mutation underwent thorough audiological and vestibular examinations, including tone and speech audiometry, video head impulse test (vHIT), ocular and cervical vestibular-evoked myogenic potential (oVEMP and cVEMP), and full otoneurological examination. The subjects also answered a Dizziness Handicap Inventory (DHI) questionnaire. RESULTS: SNHL was identified in all the 8 subjects, with a mean pure-tone average-4 (PTA-4) of 59 dB. Speech discrimination score (n=7) ranged from 24% to 100% (mean 74%), and vHIT (n=42) detected pathology in nine lateral semicircular canals (SCCs), five posterior SCCs, and one anterior SCC, whereas three measurements were inconclusive. All oVEMPs (n=14 ears) were absent, nine cVEMPs were absent, and two were inconclusive. Based on the DHI scores, 6 subjects reported none to mild dizziness, 1 reported moderate, and 1 reported severe dizziness. CONCLUSION: Our study population had pathological findings from every audiological and vestibular end organs. The results indicated that the pathological findings originated from within the end organs themselves and not within the superior and inferior vestibular or cochlear nerve.","author_count":5,"contributors":["Hougaard, Dan Dupont","Hestoy, Danjal Hofgaard","Højland, Allan Thomas","Gaihede, Michael","Petersen, Michael Bjørn"],"cuid":["S01-000.00-071771"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Mitochondrial Diseases","Sensorineural hearing loss","Vestibular disease"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"audiological and vestibular findings in subjects with melas syndrome","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC 4.0","type":"doi","url":"https://doi.org/10.5152/iao.2019.5913","version":"Published Version"},"id":"S01-000.00-071771","identifier":[{"id":"31347509","type":"pmid"},{"id":"85071350716","type":"scopus"}],"ids":["aau-4afc7d9b-598e-4f28-a1a7-522432f7cb7c"],"keyword":["Inner ear disease","MELAS syndrome","Mitochondrial diseases","Sensorineural hearing loss","Vestibular disease"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-46D36A0033E756C2F5D9DD30A5122A54"],"oa_link":[{"access":"oa","license":"CC BY-NC 4.0","type":"doi","url":"https://doi.org/10.5152/iao.2019.5913","version":"Published Version"},{"access":"oa","license":"CC BY-NC 4.0","type":"rem","url":"https://www.advancedotology.org/en/audiological-and-vestibular-findings-in-subjects-with-melas-syndrome-131412","version":"Published Version"},{"access":"oa","license":"CC BY-NC 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/308984417/Hougaard_et_al_2019_Audiological_and_Vestibular_Findings_in_Subjects_with_MELAS_Syndrome.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Otorhinolaryngology, Head and Neck Surgery","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Hoved-Orto","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Dan Dupont","key":"hougaardpau","last":"Hougaard","locid":"dc4e3a4e-a143-46a3-a701-224291091564","name":"Hougaard, Dan Dupont","orcid":"0000-0002-4164-1758","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Danjal Hofgaard","key":"hestoypau","last":"Hestoy","locid":"3ef3edcf-7a86-4fc6-87e4-9fd9a7621018","name":"Hestoy, Danjal Hofgaard","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Allan Thomas","key":"højlandpau","last":"Højland","locid":"115e8cf1-489c-4a6b-93c5-11d69d2e0d51","name":"Højland, Allan Thomas","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Michael","key":"gaihedepau","last":"Gaihede","locid":"37de5883-dfe9-4a90-beb2-ffd947c92f6d","name":"Gaihede, Michael","orcid":"0000-0001-6998-2506","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Michael Bjørn","key":"petersenpau","last":"Petersen","locid":"8512b77d-bdf2-4889-bda3-d399e6867e28","name":"Petersen, Michael Bjørn","orcid":"0000-0003-0316-8207","rank":5,"rolecode":"pau"}],"pmid":["31347509"],"pub":{"doi":"10.5152/iao.2019.5913","issn":["13087649","21483817"],"issn_org":["21483817"],"issue":"2","journal":"The Journal of International Advanced Otology","pages":"296-303","status":"p","title":"The Journal of International Advanced Otology","volume":"15"},"review":"Peer Reviewed","scoID":["2-s2.0-85071350716"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-4afc7d9b-598e-4f28-a1a7-522432f7cb7c"],"src":["AAU Aalborg University"],"title":"Audiological and Vestibular Findings in Subjects with MELAS Syndrome","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-071771","year":"2019","yearsub":"2019"}
{"abstract":"Production of total polygalacturonase (PG) and endo-polygalacturonases (endo-PG) from Aspergillus aculeatus URM4953 was optimized in submerged fermentation using passion fruit peel as substrate for pectin hydrolysis in hog plum juice. The highest activities of PG (2.92 ± 0.12 U/mL) and endo-PG (6.51 ± 0.04 U/mL) were obtained at 30 °C, pH 4.56 and 130 rpm, using 3.0% substrate and 0.1% yeast extract after 96 h in 250-mL Erlenmeyer flasks. Under these optimized conditions, maximum specific growth rate of the microorganism was 0.06 h−1, saturation constant 9.9 mg/mL, yield of biomass on consumed substrate 1.44 g/g, yields of PG and endo-PG on consumed substrate 0.33 and 0.81 U/mg, and yields of PG and endo-PG on biomass 0.45 and 0.95 U/mg, respectively. Endo-PG, which is responsible for reduction of fruit juice viscosity, displayed an optimum temperature of 60 °C and two optimal pH values (5.0 and 7.0). A novel zymography method showed PG activity in correspondence to a protein band of 31.7 kDa. The enzyme mixture was used for pectin hydrolysis in hog plum juice, which occurred optimally at 40 °C, achieving a juice yield of 35.3% and reducing fruit viscosity by 96.8% within 88 min. A. aculeatus polygalacturonases have been demonstrated to have great industrial potential for pectin hydrolysis in fruit juices.","author_count":6,"contributors":["Silva, Jônatas de Carvalho","de França, Pedro Renann Lopes","de Melo, Allan Henrique Felix","Neves-Petersen, Maria Teresa","Converti, Attilio","Souza Porto, Tatiana"],"cuid":["S01-000.00-080593"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, South","Europe, EU","OECD"],"corresponding_author":["Souza Porto, Tatiana"],"country":["Brazil","Italy"],"glorg":["All Global Affiliations","Universidade Federal Rural de Pernambuco","University of Genoa"],"keyword":["Aspergillus aculeatus","Optimization","Pectin hydrolysis"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"optimized production of i aspergillus aculeatus i urm000000004953 polygalacturonases for pectin hydrolysis in hog plum i spondias mombin i l juice","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/309809476/Optimized_production_of_Aspergillus_aculeatus_URM4953_polygal_2018_Process_B.pdf","version":"Authors Final Version"},"funding_acknowledgement":["This study was financed in part by the Coordenação de Aperfeiçoamento de Pessoal de Nível Superior - Brasil (CAPES) - 88881062200/2014-01 . Jonatas Silva would also like to thank CAPES for the exchange scholarship CSF-PVE-S- ( 88887.122755/2016-00 ) and FACEPE (Foundation for Science and Technology Support of the Pernambuco State, Recife, Brazil) for the PhD scholarship ( IBPG-0514-5,07/14 ). Tatiana Porto would like to thank to CNPq (National Council for Scientific and Technological Development, Brazil – 478446/2011-0 and 471773/2013-1 )."],"id":"S01-000.00-080593","identifier":[{"id":"85059702124","type":"scopus"}],"ids":["aau-6912869d-2c46-4f62-b6d1-2a131ccb0311"],"keyword":["Aspergillus aculeatus","Hog plum juice (Spondias mombin L.)","Optimization","Pectin hydrolysis","Polygalacturonases"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-3F1131AE62F68D88C79A9A4AFB539917"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/309809476/Optimized_production_of_Aspergillus_aculeatus_URM4953_polygal_2018_Process_B.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","country":"br","key":"universidade federal rural de pernambuco","loc":["Brazil","America, South"],"name":"Universidade Federal Rural de Pernambuco","used":1},{"affno":"2","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-AAU","used":1},{"affno":"3","country":"it","key":"university of genoa","loc":["Italy","Europe, EU","OECD"],"name":"University of Genoa","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jônatas de Carvalho","key":"silvapau","last":"Silva","name":"Silva, Jônatas de Carvalho","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Pedro Renann Lopes","key":"defrançapau","last":"de França","name":"de França, Pedro Renann Lopes","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Allan Henrique Felix","key":"demelopau","last":"de Melo","name":"de Melo, Allan Henrique Felix","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Maria Teresa","key":"nevespetersenpau","last":"Neves-Petersen","locid":"8674bc10-6a35-4fba-a74d-b97f3a9bac5c","name":"Neves-Petersen, Maria Teresa","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Attilio","key":"convertipau","last":"Converti","name":"Converti, Attilio","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Tatiana","key":"souzaportopau","last":"Souza Porto","name":"Souza Porto, Tatiana","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.procbio.2018.12.014","issn":["13595113","18733298"],"issn_org":["13595113"],"journal":"Process Biochemistry","pages":"18-27","publisher":"Elsevier","status":"p","title":"Process Biochemistry","volume":"79"},"review":"Peer Reviewed","scoID":["2-s2.0-85059702124"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-6912869d-2c46-4f62-b6d1-2a131ccb0311"],"src":["AAU Aalborg University"],"title":"Optimized production of <i>Aspergillus aculeatus</i> URM4953 polygalacturonases for pectin hydrolysis in hog plum (<i>Spondias mombin</i> L.) juice","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-080593","year":"2019","yearsub":"2019"}
{"author_count":4,"contributors":["Petersen, Allan Christian","Koerstz, Mads","Mikkelsen, Kurt V.","Sølling, Theis Ivan"],"cuid":["S01-000.00-476860"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"electronic predissociation in the dichloromethane cation ch000000000002cl000000000002 electronic state 000000000002 a 000000000001","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-476860","identifier":[{"id":"000467780800013","type":"wos"},{"id":"85065579641","type":"scopus"},{"id":"30986053","type":"pmid"}],"ids":["ku-8b8d8eff-1a0a-4837-b540-4a5f83471bc2"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-A7DA91F163E5108302D597A3F0A05123"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Chemistry"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","country":"dk","first":"Allan Christian","key":"petersenpau","last":"Petersen","locid":"0fb5fb3f-47e3-45bd-9131-77c78e17ad9b","name":"Petersen, Allan Christian","rank":1,"rolecode":"pau"},{"affno":"1","first":"Mads","key":"koerstzpau","last":"Koerstz","locid":"a4e7eb96-58db-4abe-afaa-c440f477fbb2","name":"Koerstz, Mads","rank":2,"rolecode":"pau"},{"affno":"1","first":"Kurt, V","key":"mikkelsenpau","last":"Mikkelsen","locid":"bf3a0546-2072-435f-a306-d2dffbd5ef15","name":"Mikkelsen, Kurt V.","name_org":"Mikkelsen, Kurt, V","orcid":"0000-0003-4090-7697","rank":3,"rolecode":"pau"},{"affno":"1","first":"Theis, I","key":"sollingpau","last":"Solling","locid":"5db24645-70db-461f-a061-dd6612993ec8","name":"Sølling, Theis Ivan","name_org":"Solling, Theis, I","orcid":"0000-0003-1710-9072","rank":4,"rolecode":"pau"}],"pmid":["30986053"],"pub":{"doi":"10.1021/acs.jpca.9b02022","issn":["10895639","15205215"],"issn_org":["10895639"],"issue":"18","journal":"Journal of Physical Chemistry Part A: Molecules, Spectroscopy, Kinetics, Environment and General Theory","pages":"4048-4056","status":"p","title":"Journal of Physical Chemistry Part A: Molecules, Spectroscopy, Kinetics, Environment and General Theory","title_org":"Journal of Physical Chemistry A","volume":"123"},"review":"Peer Reviewed","scoID":["2-s2.0-85065579641"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-8b8d8eff-1a0a-4837-b540-4a5f83471bc2"],"src":["KU University of Copenhagen"],"title":"Electronic Predissociation in the Dichloromethane Cation CH2Cl2+ Electronic State (2)A(1)","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-476860","year":"2019","yearsub":"2019"}
{"abstract":"The aetiology of Mayer-Rokitansky-Küster-Hauser (MRKH) syndrome, characterized by uterovaginal agenesis in 46,XX women, remains poorly understood. Since familial occurrences are rare, genetic findings reported so far only apply to a minority of mainly sporadic cases and most studies have not included other family members enabling segregation analysis. Herein, we report on the investigation of a unique three-generation family of two female cousins with MRKH syndrome and unilateral renal agenesis (RA) and two deceased male relatives with RA. We performed whole-exome sequencing (WES) in eight family members leading to the identification of a novel pathogenic (CADD = 33) c.705G>T missense variant in GREB1L, a gene recently identified as a novel cause of RA. Previous reports include several cases of female fetuses with bilateral RA and uterus agenesis, which support GREB1L as an important gene in both kidney and female genital tract development. The pedigree is compatible with autosomal dominant inheritance with incomplete penetrance following a parent-origin-specific manner, which could be due to imprinting. To our knowledge, this is the first investigation of a larger MRKH syndrome pedigree using WES, and we suggest GREB1L as a novel and promising candidate gene in the aetiology of MRKH syndrome.","author_count":9,"contributors":["Herlin, Morten","Le, Vang","Højland, Allan Thomas","Ernst, Anja","Okkels, Henrik","Petersen, Astrid Christine","Petersen, Michael Bjørn","Pedersen, Inge Søkilde"],"cuid":["S02-093.18-003474"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Mayer Rokitansky Küster Hauser syndrome Müllerian aplasia renal agenesis CAKUT GREB1L genetics whole exome sequencing penetrance genomic imprinting"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"whole exome sequencing identifies a greb000000000001l variant in a three generation family with müllerian and renal agenesis a novel candidate gene in mayer rokitansky küster hauser mrkh syndrome a case report","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85072058856&partnerID=8YFLogxK","version":"Other Version"},"id":"S02-093.18-003474","identifier":[{"id":"000493096600022","type":"wos"},{"id":"31424080","type":"pmid"},{"id":"85072058856","type":"scopus"}],"ids":["aau-473231bd-cdb0-4456-aa5b-ff9979faed5a","au-0bfdb52a-b49a-4cc1-aa3a-ce26106216b1"],"keyword":["Mayer–Rokitansky–Küster–Hauser syndrome/Müllerian aplasia/renal agenesis/CAKUT/GREB1L/genetics/whole exome sequencing/penetrance/genomic imprinting"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-C31B85231258C8F0492EE5093CB15404"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Clinical Genetics","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Diagnostik"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Hea