ensenjannepau","last":"Buck Christensen","locid":"154d85f0-c6c0-49b9-89b7-60758ff379cb","name":"Buck Christensen, Janne","rank":15,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Allan","key":"johansenallanpau","last":"Johansen","locid":"dc7a1a61-b703-48ec-bd87-c92b55784133","name":"Johansen, Allan","orcid":"0000-0002-3622-057X","rank":16,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Poul Flemming","key":"høilundcarlsenpoulflemmingpau","last":"Høilund-Carlsen","locid":"a1ff65cf-cdaa-4192-bef3-a915cfe6cceb","name":"Høilund-Carlsen, Poul Flemming","orcid":"0000-0001-7420-2367","rank":17,"rolecode":"pau"}],"pmid":["26519292"],"pub":{"doi":"10.1007/s00259-015-3217-0","issn":["16197070","16197089"],"issn_org":["16197070"],"issue":"4","journal":"European Journal of Nuclear Medicine and Molecular Imaging","pages":"695-706","publisher":"Springer","status":"p","title":"European Journal of Nuclear Medicine and Molecular Imaging","volume":"43"},"review":"Peer Reviewed","scoID":["2-s2.0-84959134730"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region Zealand","Region of Southern Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-56411379-576d-4fa8-b342-cfa4f64544c2"],"src":["SDU University of Southern Denmark"],"title":"FDG PET/CT in cancer : comparison of actual use with literature-based recommendations","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-597936","year":"2016","yearsub":"2016"}
{"abstract":"This meta-analysis compared the health-related quality of life (HRQL) of patients with allergic rhinitis (AR) and/or allergic asthma (AA) caused by perennial house dust mite (HDM) versus AR and/or AA caused by seasonal pollen allergy. Following a systematic search, the identified studies used the disease-specific rhinitis quality of life questionnaire or generic instruments (SF-36 and SF-12). Summary estimates obtained by meta-analysis showed that HRQL in patients with perennial HDM allergy was significantly worse than that of patients with seasonal pollen allergy, when measured by both disease-specific and generic HRQL instruments, and was reflected by an impact on both physical and mental health. A systematic review of cost data on AR and AA in selected European countries demonstrated that the majority of the economic burden was indirectly caused by high levels of absenteeism and presenteeism; there was little or no evidence of increasing or decreasing cost trends. Increased awareness of the detrimental effects of AR and/or AA on patients' HRQL and its considerable cost burden might encourage early diagnosis and treatment, in order to minimize the disease burden and ensure beneficial and cost-effective outcomes.","author_count":7,"contributors":["Linneberg, A","Petersen, Karin Dam","Hahn-Pedersen, J","Hammerby, E","Serup-Hansen, N","Boxall, N"],"cuid":["S02-094.77-011168"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["med","soc"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-PR","DI-U"],"level3":{"OT":["Research Centre for Prevention and Health, The Capital Region of Denmark, Copenhagen, Denmark ; Department of Clinical Experimental Research, Rigshospitalet, Copenhagen, Denmark ; Department of Clinical Medicine, Faculty of Health and Medical Sciences, University of Copenhagen, Copenhagen, Denmark."],"PR":["DI-PR-ALK","DI-PR-ALL"],"U":["DI-U-AAU","DI-U-ALL","DI-U-KU"]},"level3all":["DI-PR-ALK","DI-U-AAU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"burden of allergic respiratory disease a systematic review","src":["aau","ku"],"src-code":["DI-U-AAU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s12948-016-0049-9","version":"Published Version"},"id":"S02-094.77-011168","identifier":[{"id":"PMC5041537","type":"pmcid"},{"id":"84992025567","type":"scopus"},{"id":"27708552","type":"pmid"}],"ids":["aau-e998afa8-e3ef-46a1-bcf2-02a13d2fc3cb","ku-7c37661e-f17d-406a-a126-f54b64b13e0f"],"lang":"English","level":"Scientific","mra":["Medical Science","Social Science"],"noi":["Global-Local-2-5-3F91E36076980ED6C58D4AA18710C5AC"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s12948-016-0049-9","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/266081373/document_18_.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Research Centre for Prevention and Health, The Capital Region of Denmark, Copenhagen, Denmark ; Department of Clinical Experimental Research, Rigshospitalet, Copenhagen, Denmark ; Department of Clinical Medicine, Faculty of Health and Medical Sciences, University of Copenhagen, Copenhagen, Denmark."],"nora_code":"DI-OT","used":1},{"affno":"3","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Social Sciences","Aalborg University, The Faculty of Social Sciences, Department of Business and Management"],"nora_code":"DI-U-AAU","used":1},{"affno":"4","country":"dk","key":"alk abello","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-ALK","l3nl":"ALK-Abello A/S","l3nn":"ALK-Abello","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ALK-Abello","namevar":["ALK-Abello AS"],"nora_code":"DI-PR-ALK","used":1}],"person":[{"affno":"1 2","first":"Allan René","key":"linnebergpau","last":"Linneberg","locid":"09da8aa6-fd95-4ace-a2f1-19f38d7d3f9e","name":"Linneberg, Allan","name_org":"Linneberg, Allan René","orcid":"0000-0002-0994-0184","rank":1,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Karin Dam","key":"petersenpau","last":"Petersen","locid":"2e36a0d6-1251-4e37-a8f6-8f0a16c9875e","name":"Petersen, Karin Dam","orcid":"0000-0002-6491-1757","rank":2,"rolecode":"pau"},{"affno":"","first":"K","key":"dampetersenpau","last":"Dam Petersen","name":"Dam Petersen, K","rank":2,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"J","key":"hahnpedersenpau","last":"Hahn-Pedersen","name":"Hahn-Pedersen, J","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"E","key":"hammerbypau","last":"Hammerby","name":"Hammerby, E","rank":4,"rolecode":"pau"},{"affno":"1 4","first":"N","key":"seruphansenpau","last":"Serup-Hansen","locid":"6ef4acea-a86a-48b2-b2e4-c4b1efd274d1","name":"Serup-Hansen, N","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"N","key":"boxallpau","last":"Boxall","name":"Boxall, N","rank":6,"rolecode":"pau"}],"pmid":["27708552"],"pub":{"doi":"10.1186/s12948-016-0049-9","issn":["14767961"],"journal":"Clinical and Molecular Allergy","paperid":"12","publisher":"BioMed Central","status":"p","title":"Clinical and Molecular Allergy","volume":"14"},"review":"Peer Reviewed","scoID":["2-s2.0-84992025567"],"search":{"DAF":["ALK-Abello A/S","Aalborg University","All Danish Affiliations","All Miscellaneous","All Private Research","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Private Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["aau-e998afa8-e3ef-46a1-bcf2-02a13d2fc3cb","ku-7c37661e-f17d-406a-a126-f54b64b13e0f"],"src":["AAU Aalborg University","KU University of Copenhagen"],"title":"Burden of allergic respiratory disease : a systematic review","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-094.77-011168","year":"2016","yearsub":"2016"}
{"abstract":"BACKGROUND: Guidelines are often slowly adapted into clinical practice. However, actively supporting healthcare professionals in evidence-based treatment may speed up guideline implementation. Danish low back pain (LBP) guidelines focus on primary care treatment of LBP, to reduce referrals from primary care to secondary care. The primary aim of this project was to reduce secondary care referral within 12 weeks by a multifaceted implementation strategy (MuIS). METHODS: In a cluster randomised design, 189 general practices from the North Denmark Region were invited to participate. Practices were randomised (1:1) and stratified by practice size to MuIS (28 practices) or a passive implementation strategy (PaIS; 32 practices). Included were patients with LBP aged 18 to 65 years who were able to complete questionnaires, had no serious underlying pathology, and were not pregnant. We developed a MuIS including outreach visits, quality reports, and the STarT Back Tool for subgrouping patients with LBP. Both groups were offered the usual dissemination of guidelines, guideline-concordant structuring of the medical record, and a new referral opportunity for patients with psycho-social problems. In an intention-to-treat analysis, the primary and secondary outcomes pertained to the patient, and a cost-effectiveness analysis was performed from a healthcare sector perspective. Patients and the assessment of outcomes were blinded. Practices and caregivers delivering the interventions were not blinded. RESULTS: Between January 2013 and July 2014, 60 practices were included, of which 54 practices (28 MuIS, 26 PaIS) included 1101 patients (539 MuIS, 562 PaIS). Follow-up data for the primary outcome were available on 100 % of these patients. Twenty-seven patients (5.0 %) in the MuIS group were referred to secondary care vs. 59 patients (10.5 %) in the PaIS group. The adjusted odds ratio (AOR) was 0.52 [95 % CI 0.30 to 0.90; p = 0.020]. The MuIS was cost-saving £-93.20 (£406.51 vs. £499.71 per patient) after 12 weeks. Conversely, the MuIS resulted in less satisfied patients after 52 weeks (AOR 0.50 [95 % CI 0.31 to 0.81; p = 0.004]). CONCLUSIONS: Using a MuIS changed general practice referral behaviour and was cost effective, but patients in the MuIS group were less satisfied. This study supports the application of a MuIS when implementing guidelines. TRIAL REGISTRATION: ClinicalTrials.gov, NCT01699256.","author_count":7,"contributors":["Riis, Allan","Jensen, Cathrine Elgaard","Bro, Flemming","Maindal, Helle Terkildsen","Petersen, Karin Dam","Bendtsen, Mette Dahl","Jensen, Martin Bach"],"cuid":["S02-100.00-002024"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"a multifaceted implementation strategy versus passive implementation of low back pain guidelines in general practice a cluster randomised controlled trial","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1186/s13012-016-0509-0","version":"Published Version"},"id":"S02-100.00-002024","identifier":[{"id":"27769263","type":"pmid"},{"id":"000386092300001","type":"wos"},{"id":"84992202150","type":"scopus"},{"id":"PMC5073468","type":"pmcid"}],"ids":["aau-2869ad7a-f75d-410c-846c-b5cd439bbea1","au-93e4389d-d0ba-4c4c-8fbf-e9c5e23dd63f"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-D2F5876DC147F5FBAAC8385F6286474F"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1186/s13012-016-0509-0","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"