rd","name":"Stovgaard, Elisabeth S","rank":8,"rolecode":"pau"},{"affno":"1","first":"L.J.","key":"hansenljpau","last":"Hansen","locid":"6db8b779-4612-40e8-92c5-5e6624343908","name":"Hansen, L.J.","rank":9,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Lars Jørgen","key":"hansenlarsjørgenpau","last":"Hansen","name":"Hansen, Lars Jørgen","rank":9,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Jan Erik","key":"henriksenjanerikpau","last":"Henriksen","locid":"91333aae-7e28-44fb-bc16-5615c7ee8c5b","name":"Henriksen, Jan Erik","orcid":"0000-0002-1908-7017","rank":10,"rolecode":"pau"},{"affno":"","first":"J.E.","key":"henriksenjepau","last":"Henriksen","name":"Henriksen, J.E.","rank":10,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Steen J","key":"bonnemasteenjooppau","last":"Bonnema","locid":"6a7e6a38-b12e-4b13-bfdb-0bea96f3b1e1","name":"Bonnema, Steen Joop","name_org":"Bonnema, Steen J","orcid":"0000-0002-6898-1752","rank":11,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Niels de Fine","key":"olivariusnielsdefinepau","last":"Olivarius","locid":"2cd4f383-1cfd-49e3-a200-5907962691ba","name":"Olivarius, Niels de Fine","orcid":"0000-0001-6465-3615","rank":12,"rolecode":"pau"},{"affno":"","first":"H.E.","key":"poulsenhepau","last":"Poulsen","name":"Poulsen, H.E.","rank":13,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Henrik E","key":"poulsenhenrikepau","last":"Poulsen","name":"Poulsen, Henrik E","rank":13,"rolecode":"pau"}],"pmid":["21994431"],"pub":{"doi":"10.2337/dc11-1620","issn":["01495992"],"issue":"12","journal":"Diabetes Care","pages":"2594-6","publisher":"American Diabetes Association Inc.","status":"p","title":"Diabetes Care","volume":"34"},"review":"Peer Reviewed","scoID":["2-s2.0-84858132328"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-ff72b098-b53c-44b9-9172-18cab97e16a3","sdu-45b7c114-a088-47b5-aa17-7752db21ed93"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Urinary markers of nucleic acid oxidation and long-term mortality of newly diagnosed type 2 diabetic patients","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-080.63-666999","year":"2011","yearsub":"2011"}
{"abstract":"BACKGROUND: Little is known about characteristics of patients receiving allergen-specific immunotherapy. Identifying obstacles to appropriate treatment according to guidelines may facilitate the development of strategies aiming at improved treatment of patients with allergic respiratory diseases. The objective of this study was to investigate differences in disease severity, demographic and socioeconomic status between allergic rhinitis patients receiving allergen-specific immunotherapy and allergic rhinitis patients not receiving allergen-specific immunotherapy. METHODS: A total of 366 patients were studied of whom 210 were going to receive subcutaneously administrated immunotherapy (SIT) against grass pollen and/or house dust mite allergy. The severity of rhino-conjunctivitis (hay fever) and/or asthma was classified according to international guidelines. The questionnaires included an EQ-5D visual analogue scale instrument and some socio-economic questions. RESULTS: Severity of disease, young age, high level of education as well as greater perceived impairment of health-related quality of life due to allergic symptoms were significantly associated with use of SIT. Somewhat unexpectedly, household income was not associated with use of SIT. CONCLUSION: Use of SIT was associated with both disease severity measures and educational level, but not income level. These results suggest social inequality as reflected by lower use of SIT among patients with lower educational level may represent an obstacle to treatment with SIT.","author_count":6,"contributors":["Petersen, Karin Dam","Kronborg, Christian","Gyrd-Hansen, Dorte","Dahl, Ronald","Larsen, Jørgen Nedergaard","Linneberg, Allan"],"cuid":["S01-000.00-477323"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"characteristics of patients receiving allergy vaccination to which extent do socio economic factors play a role","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1093/eurpub/ckq063","version":"Other Version"},"id":"S01-000.00-477323","identifier":[{"id":"20484343","type":"pmid"},{"id":"79957477707","type":"scopus"},{"id":"PMC3098894","type":"pmcid"}],"ids":["ku-8c45f918-9792-49ed-b70e-1aabdc445d68"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-3-3-827C2A78F5A9A7A37FEFF7E18B904D92"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1093/eurpub/ckq063","version":"Other Version"}],"org":[{"affno":1,"key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Graduate School of Health and Medical Sciences"],"nora_code":"DI-U-KU"}],"person":[{"affno":"","first":"Karin Dam","key":"petersenpau","last":"Petersen","name":"Petersen, Karin Dam","rank":1,"rolecode":"pau"},{"affno":"","first":"Christian","key":"kronborgpau","last":"Kronborg","name":"Kronborg, Christian","rank":2,"rolecode":"pau"},{"affno":"","first":"Dorte","key":"gyrdhansenpau","last":"Gyrd-Hansen","name":"Gyrd-Hansen, Dorte","rank":3,"rolecode":"pau"},{"affno":"","first":"Ronald","key":"dahlpau","last":"Dahl","name":"Dahl, Ronald","rank":4,"rolecode":"pau"},{"affno":"","first":"Jørgen Nedergaard","key":"larsenpau","last":"Larsen","name":"Larsen, Jørgen Nedergaard","rank":5,"rolecode":"pau"},{"affno":"","first":"Allan","key":"linnebergpau","last":"Linneberg","locid":"09da8aa6-fd95-4ace-a2f1-19f38d7d3f9e","name":"Linneberg, Allan","orcid":"0000-0002-0994-0184","rank":6,"rolecode":"pau"}],"pmid":["20484343"],"pub":{"doi":"10.1093/eurpub/ckq063","issn":["12107778","18031048"],"issn_org":["12107778"],"issue":"3","journal":"Central European Journal of Public Health","pages":"323","status":"p","title":"Central European Journal of Public Health","volume":"21"},"review":"Peer Reviewed","scoID":["2-s2.0-79957477707"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-8c45f918-9792-49ed-b70e-1aabdc445d68"],"src":["KU University of Copenhagen"],"title":"Characteristics of patients receiving allergy vaccination: to which extent do socio-economic factors play a role?","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-477323","year":"2011","yearsub":"2011"}
{"abstract":"PURPOSE: The aim of our study was to investigate the occurrence of fluorodeoxyglucose (FDG) avidity in draining axillary lymph nodes after vaccination against influenza (H1N1v pandemic and seasonal) and to determine the period of increased FDG uptake. METHODS: During December 2009, patients referred for (18)F-FDG positron emission tomography (PET)/CT scans (n = 293) filled in a questionnaire concerning vaccination type (seasonal and/or H1N1v), time and anatomical localization of vaccination. Only injections in deltoid regions were evaluated, thus ensuring that draining lymph nodes were axillary. If more vaccinations had been given, only the latest vaccination was evaluated in each deltoid region. RESULTS: Of all patients who underwent PET/CT scans during December 2009, 26% had been vaccinated with at least one influenza vaccination in the deltoid region. A total of 92 'draining' and 60 'reference' (i.e. contralateral, non-vaccinated) axillary lymph nodes were evaluated in 61 patients (19 of 61 patients were scanned twice). The maximal intensity in FDG uptake (SUV(max)) in draining lymph nodes was 5 g/ml body weight (BW), whereas the maximal intensity in reference lymph nodes was 1.9 g/ml BW. The SUV(max) was normalized approximately 40 days after vaccination. No significant enlargement of metabolically active draining lymph nodes could be demonstrated on CT scan. Chemotherapy or immunosuppressive drugs given within 2 weeks from vaccination did not affect SUV(max) in the axillary lymph nodes. CONCLUSION: Influenza vaccination may lead to FDG-avid draining lymph nodes beyond 1 month.","author_count":5,"contributors":["Thomassen, Anders","Nielsen, Anne Lerberg","Gerke, Oke","Johansen, Allan","Petersen, Henrik"],"cuid":["S01-000.00-615953"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"duration of 000000000018 f fdg avidity in lymph nodes after pandemic h000000000001n000000000001v and seasonal influenza vaccination","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s00259-011-1729-9","version":"Other Version"},"id":"S01-000.00-615953","identifier":[{"id":"79953677167","type":"scopus"},{"id":"21340453","type":"pmid"}],"ids":["sdu-95393efb-7182-447a-bed3-fc00e0ba6f31"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-7758DD29641B93B459BFA23E58C7E2B3"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s00259-011-1729-9","version":"Other Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Clinical Physiology and Nuclear Medicine (Odense)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Anders","key":"thomassenpau","last":"Thomassen","locid":"1c7f11fb-cf64-4085-909d-b78f183b9364","name":"Thomassen, Anders","orcid":"0000-0001-9839-1158","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anne","key":"lerbergnielsenpau","last":"Lerberg Nielsen","locid":"ba5686a6-f441-4c7a-9348-f0501da77640","name":"Nielsen, Anne Lerberg","name_org":"Lerberg Nielsen, Anne","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Oke","key":"gerkepau","last":"Gerke","locid":"596baeb1-6754-4d53-948f-30470dd1d976","name":"Gerke, Oke","orcid":"0000-0001-6335-3303","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Allan","key":"johansenpau","last":"Johansen","locid":"dc7a1a61-b703-48ec-bd87-c92b55784133","name":"Johansen, Allan","orcid":"0000-0002-3622-057X","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Henrik","key":"petersenpau","last":"Petersen","locid":"ea635371-4294-4379-9655-3da538fecf13","name":"Petersen, Henrik","orcid":"0000-0002-1118-1500","rank":5,"rolecode":"pau"}],"pmid":["21340453"],"pub":{"doi":"10.1007/s00259-011-1729-9","issn":["16197070","16197089"],"issn_org":["16197070"],"issue":"5","journal":"European Journal of Nuclear Medicine and Molecular Imaging","pages":"894-898","publisher":"Springer","status":"p","title":"European Journal of Nuclear Medicine and Molecular Imaging","volume":"38"},"review":"Peer Reviewed","scoID":["2-s2.0-79953677167"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-95393efb-7182-447a-bed3-fc00e0ba6f31"],"src":["SDU University of Southern Denmark"],"title":"Duration of (18)F-FDG avidity in lymph nodes after pandemic H1N1v and seasonal influenza vaccination","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-615953","year":"2011","yearsub":"2011"}
