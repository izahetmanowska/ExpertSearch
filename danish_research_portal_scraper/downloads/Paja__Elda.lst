ing university of technology","loc":["China","Asia, East"],"name":"Beijing University of Technology","used":1},{"affno":"11","country":"kr","key":"ajou university","loc":["South Korea","Asia, East","OECD"],"name":"Ajou University","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Meira","key":"levypau","last":"Levy","name":"Levy, Meira","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Irit","key":"hadarpau","last":"Hadar","name":"Hadar, Irit","rank":2,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Jennifer","key":"horkoffpau","last":"Horkoff","name":"Horkoff, Jennifer","rank":3,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Jane Huffman","key":"hayespau","last":"Hayes","name":"Hayes, Jane Huffman","rank":4,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Barbara","key":"paechpau","last":"Paech","name":"Paech, Barbara","rank":5,"rolecode":"pau"},{"affno":"7","corresponding":null,"first":"Alex","key":"dekhtyarpau","last":"Dekhtyar","name":"Dekhtyar, Alex","rank":6,"rolecode":"pau"},{"affno":"8","corresponding":null,"first":"Gunter","key":"mussbacherpau","last":"Mussbacher","name":"Mussbacher, Gunter","rank":7,"rolecode":"pau"},{"affno":"9","corresponding":null,"first":"Elda","key":"pajapau","last":"Paja","locid":"ce1a5350-f645-4a53-a745-fca8d4f1f030","name":"Paja, Elda","orcid":"0000-0002-8346-2467","rank":8,"rolecode":"pau"},{"affno":"10","corresponding":null,"first":"Tong","key":"lipau","last":"Li","name":"Li, Tong","rank":9,"rolecode":"pau"},{"affno":"11","corresponding":null,"first":"Seok-Won","key":"leepau","last":"Lee","name":"Lee, Seok-Won","rank":10,"rolecode":"pau"},{"affno":"7","corresponding":null,"first":"Dongfeng","key":"fangpau","last":"Fang","name":"Fang, Dongfeng","rank":11,"rolecode":"pau"}],"pub":{"doi":"10.1007/s00766-022-00386-4","issn":["09473602","1432010X"],"issn_org":["09473602"],"journal":"Requirements Engineering","pages":"1-15","publisher":"Springer","status":"p","title":"Requirements Engineering"},"review":"Peer Reviewed","scoID":["2-s2.0-85138110755"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-58c9cab9-bc3d-466e-b422-6c9a943a4882"],"src":["ITU IT University of Copenhagen"],"title":"Philanthropic conference-based requirements engineering in time of pandemic and beyond","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382587","year":"2022","yearsub":"2022"}
{"abstract":"Increased levels of digitalization in society expose companies to new security threats, requiring them to establish adequate security and privacy measures. Additionally, the presence of exogenous forces like new regulations, e.g., GDPR and the global COVID-19 pandemic, pose new challenges for companies that should preserve an adequate level of security while having to adapt to change. In this paper, we investigate such challenges through a two-phase study in companies located in Denmark---a country characterized by a high level of digitalization---focusing on software development and tech-related companies. Our results show a number of issues, most notably i) a misalignment between software developers and management when it comes to the implementation of security and privacy measures, ii) difficulties in adapting company practices in light of implementing GDPR compliance, and iii) different views on the need to adapt security measures to cope with the COVID-19 pandemic.","author_count":5,"contributors":["Dalela, Asmita","Giallorenzo, Saverio","Kulyk, Oksana","Mauro, Jacopo","Paja, Elda"],"cuid":["S01-000.00-381613"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Italy"],"glorg":["All Global Affiliations","University of Bologna"],"keyword":["Covid 19","GDPR","Organizational culture","Organizational practices","Privacy","Security"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-SDU"]},"level3all":["DI-U-ITU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"a study on security and privacy practices in danish companies","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://www.ndss-symposium.org/wp-content/uploads/usec2022_23094_paper.pdf","version":"Published Version"},"id":"S01-000.00-381613","ids":["itu-170b05e3-901f-4731-867b-fa43c299ff12"],"keyword":["COVID-19","GDPR","Organizational culture","Organizational practices","Privacy","Security"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-39C2116BAA35B6C3D89598336B17C3C3"],"oa_link":[{"access":"oa","type":"rem","url":"https://www.ndss-symposium.org/wp-content/uploads/usec2022_23094_paper.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"it","key":"university of bologna","loc":["Italy","Europe, EU","OECD"],"name":"University of Bologna","used":1},{"affno":"3","country":"dk","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["University of Southern Denmark"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Asmita","key":"dalelapau","last":"Dalela","name":"Dalela, Asmita","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Saverio","key":"giallorenzopau","last":"Giallorenzo","name":"Giallorenzo, Saverio","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Oksana","key":"kulykpau","last":"Kulyk","locid":"1dbd1112-eb47-4406-936c-6807e8845610","name":"Kulyk, Oksana","orcid":"0000-0003-4218-1658","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jacopo","key":"mauropau","last":"Mauro","name":"Mauro, Jacopo","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Elda","key":"pajapau","last":"Paja","locid":"ce1a5350-f645-4a53-a745-fca8d4f1f030","name":"Paja, Elda","orcid":"0000-0002-8346-2467","rank":5,"rolecode":"pau"}],"pub":{"eisbn":["1891562797"],"publisher":"Internet Society","publisher_org":"Internet society","status":"p","title":"Usable Security and Privacy (USEC) Symposium 2022"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["itu-170b05e3-901f-4731-867b-fa43c299ff12"],"src":["ITU IT University of Copenhagen"],"title":"A Study on Security and Privacy Practices in Danish Companies","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381613","year":"2022","yearsub":"2022"}
{"abstract":"Along with enterprise transformation, enterprise re-engineering isessential for maintaining the competitiveness of an enterprise. Enterprisere-engineering addresses (emergent) changes, re-organizing, outsourcing andre-aligning alike. Re-engineering itself has drawn traction in both academiaand business. Most scholarly work in this area is confined to model-drivenanalysis, holistic frameworks for analyzing as-is/to-be enterprise models, anda few other conceptualization techniques. The practice of process redesignunderstandably takes the stage in re-engineering. Yet algorithmic techniquesthat insightfully point out how a process might be improved for proactivelyre-engineering process-intensive enterprise architecture are missing. Datascience and business intelligence have brought a refreshingly new analysis tothis mainstream problem by studying the operational history of a businessprocess to facilitate most plausible changes. In this article, we investigateenterprise process redesign taking into account enterprise’s high-level strategyand data warehouse. More specifically, we propose an approach to reasoningabout an enterprise’s strategy together with data mining rules extractedfrom the data warehouse of the enterprise. Our redesign algorithms suggest design-time changes to be made to its business processes, primarily byeliminating redundant tasks and re-ordering inefficiently-located tasks. Weanalyze the effectiveness of candidate to-be business processes with regardto business intelligence indicators. We report our work on the enterprisearchitecture developed for a retailer of low-cost domestic flights.","author_count":4,"contributors":["Truong, Thai-Minh","Lê, Lam-Son","Paja, Elda","Giorgini, Paolo"],"cuid":["S01-000.00-382791"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Asia, South","Europe, EU","OECD"],"country":["Italy","Vietnam"],"glorg":["All Global Affiliations","Department of Information Engineering and Computer Science, University of Trento","Ho Chi Minh City University of Technology"],"keyword":["Business intelligence","BusinessProcess Management","Data mining","Digital Enterprise","Enterprise Re engineering","Goal oriented Modeling"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"a data driven goal oriented framework for process focused enterprise re engineering","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86429894/ISeBJ_submission.pdf","version":"Pre-print"},"id":"S01-000.00-382791","identifier":[{"id":"85107717684","type":"scopus"}],"ids":["itu-658f4f5c-2334-445e-97ab-57ab957c9344"],"keyword":["Business Intelligence","BusinessProcess Management","Data Mining","Digital Enterprise","Enterprise Re-engineering","Goal-oriented Modeling"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-5EC4658F05F11DDD1D932A028284E0F2"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86429894/ISeBJ_submission.pdf","version":"Pre-print"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"vn","key":"ho chi minh city university of technology","loc":["Vietnam","Asia, South"],"name":"Ho Chi Minh City University of Technology","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Information Security and Trust","IT University of Copenhagen, Computer Science","IT University of Copenhagen, Software Engineering, Software Engineering"],"nora_code":"DI-U-ITU","used":1},{"affno":"3","country":"it","key":"department of information engineering and computer science university of trento","loc":["Italy","Europe, EU","OECD"],"name":"Department of Information Engineering and Computer Science, University of Trento","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Thai-Minh","key":"truongpau","last":"Truong","name":"Truong, Thai-Minh","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lam-Son","key":"lêpau","last":"Lê","name":"Lê, Lam-Son","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Elda","key":"pajapau","last":"Paja","locid":"ce1a5350-f645-4a53-a745-fca8d4f1f030","name":"Paja, Elda","orcid":"0000-0002-8346-2467","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Paolo","key":"giorginipau","last":"Giorgini","name":"Giorgini, Paolo","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1007/s10257-021-00523-6","issn":["16179846","16179854"],"issn_org":["16179846"],"journal":"Information Systems and e-Business Management","pages":"683-747","publisher":"Springer","status":"p","title":"Information Systems and e-Business Management","volume":"19"},"review":"Peer Reviewed","scoID":["2-s2.0-85107717684"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-658f4f5c-2334-445e-97ab-57ab957c9344"],"src":["ITU IT University of Copenhagen"],"title":"A Data-Driven, Goal-Oriented Framework for Process-Focused Enterprise Re-engineering","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382791","year":"2021","yearsub":"2021"}
{"abstract":"A data ecosystem (DE) offers a keystone-player or alliance-driven infrastructure that enables the interaction of different stakeholders and the resolution of interoperability issues among shared data. However, despite years of research in data governance and management, trustability is still affected by the absence of transparent and traceable data-driven pipelines. In this work, we focus on requirements and challenges that DEs face when ensuring data transparency. Requirements are derived from the data and organizational management, as well as from broader legal and ethical considerations. We propose a novel knowledge-driven DE architecture, providing the pillars for satisfying the analyzed requirements. We illustrate the potential of our proposal in a real-world scenario. Last, we discuss and rate the potential of the proposed architecture in the fulfillmentof these requirements.","author_count":12,"contributors":["Geisler, Sandra","Vidal, Maria-Esther","Cappiello, Cinzia","Farias Lóscio, Bernadette","Gal, Avigdor","Jarke, Matthias","Lenzerini, Maurizio","Missier, Paolo","Otto, Boris","Paja, Elda","Pernici, Barbara","Rehof, Jakob"],"cuid":["S01-000.00-383885"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, South","Asia, Middle East","Europe, EU","Europe, Non-EU","OECD"],"country":["Brazil","Germany","Israel","Italy","United Kingdom"],"glorg":["All Global Affiliations","Federal University of Pernambuco","Fraunhofer FIT","Fraunhofer ISST","Newcastle University","Polytechnic University of Milan","RWTH Aachen University","Sapienza University of Rome","TIB-Leibniz Information Centre for Science and Technology","TU Dortmund University","Technion - Israel Institute of Technology"],"keyword":["Data ecosystem","Data quality","Data transparency","trustability"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"knowledge driven data ecosystems toward data transparency","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85124698785","version":"Other Version"},"id":"S01-000.00-383885","identifier":[{"id":"85124698785","type":"scopus"}],"ids":["itu-b3e8637c-1b16-429a-972f-78595753f3d2"],"keyword":["Data transparency","data ecosystem","data quality","trustability"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-0A52055AEDF4210E1DE262EB90A778E5"],"org":[{"affno":"1","country":"de","key":"rwth aachen university","loc":["Germany","Europe, EU","OECD"],"name":"RWTH Aachen University","used":1},{"affno":"2","country":"de","key":"fraunhofer fit","loc":["Germany","Europe, EU","OECD"],"name":"Fraunhofer FIT","used":1},{"affno":"3","country":"de","key":"tib leibniz information centre for science and technology","loc":["Germany","Europe, EU","OECD"],"name":"TIB-Leibniz Information Centre for Science and Technology","used":1},{"affno":"4","country":"it","key":"polytechnic university of milan","loc":["Italy","Europe, EU","OECD"],"name":"Polytechnic University of Milan","used":1},{"affno":"5","country":"br","key":"federal university of pernambuco","loc":["Brazil","America, South"],"name":"Federal University of Pernambuco","used":1},{"affno":"6","country":"il","key":"technion israel institute of technology","loc":["Israel","Asia, Middle East","OECD"],"name":"Technion - Israel Institute of Technology","used":1},{"affno":"7","country":"it","key":"sapienza university of rome","loc":["Italy","Europe, EU","OECD"],"name":"Sapienza University of Rome","used":1},{"affno":"8","country":"gb","key":"newcastle university","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Newcastle University","used":1},{"affno":"9","country":"de","key":"tu dortmund university","loc":["Germany","Europe, EU","OECD"],"name":"TU Dortmund University","used":1},{"affno":"10","country":"de","key":"fraunhofer isst","loc":["Germany","Europe, EU","OECD"],"name":"Fraunhofer ISST","used":1},{"affno":"11","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Information Security and Trust","IT University of Copenhagen, Computer Science","IT University of Copenhagen, Software Engineering, Software Engineering"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Sandra","key":"geislerpau","last":"Geisler","name":"Geisler, Sandra","rank":1,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Maria-Esther","key":"vidalpau","last":"Vidal","name":"Vidal, Maria-Esther","rank":2,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Cinzia","key":"cappiellopau","last":"Cappiello","name":"Cappiello, Cinzia","rank":3,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Bernadette","key":"fariaslósciopau","last":"Farias Lóscio","name":"Farias Lóscio, Bernadette","rank":4,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Avigdor","key":"galpau","last":"Gal","name":"Gal, Avigdor","rank":5,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Matthias","key":"jarkepau","last":"Jarke","name":"Jarke, Matthias","rank":6,"rolecode":"pau"},{"affno":"7","corresponding":null,"first":"Maurizio","key":"lenzerinipau","last":"Lenzerini","name":"Lenzerini, Maurizio","rank":7,"rolecode":"pau"},{"affno":"8","corresponding":null,"first":"Paolo","key":"missierpau","last":"Missier","name":"Missier, Paolo","rank":8,"rolecode":"pau"},{"affno":"9 10","corresponding":null,"first":"Boris","key":"ottopau","last":"Otto","name":"Otto, Boris","rank":9,"rolecode":"pau"},{"affno":"11","corresponding":null,"first":"Elda","key":"pajapau","last":"Paja","locid":"ce1a5350-f645-4a53-a745-fca8d4f1f030","name":"Paja, Elda","orcid":"0000-0002-8346-2467","rank":10,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Barbara","key":"pernicipau","last":"Pernici","name":"Pernici, Barbara","rank":11,"rolecode":"pau"},{"affno":"9 10","corresponding":null,"first":"Jakob","key":"rehofpau","last":"Rehof","name":"Rehof, Jakob","rank":12,"rolecode":"pau"}],"pub":{"doi":"10.1145/3467022","issn":["19361955","19361963"],"issn_org":["19361963"],"issue":"1","journal":"Journal of Data and Information Quality","pages":"1-12","paperid":"3","publisher":"Association for Computing Machinery","status":"p","title":"Journal of Data and Information Quality","volume":"14"},"review":"Peer Reviewed","scoID":["2-s2.0-85124698785"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-b3e8637c-1b16-429a-972f-78595753f3d2"],"src":["ITU IT University of Copenhagen"],"title":"Knowledge-Driven Data Ecosystems Toward Data Transparency","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383885","year":"2021","yearsub":"2021"}
{"abstract":"Personal data provides important business value, for example, in the personalization of services. In addition, companies are moving toward new business models, in which products and services are offered without charge to users, but in exchange for targeted advertising revenue. New privacy regulations require organizations to explicitly state their data practices in privacy policies, including which data types will be collected. By consenting to data collections described in a policy, the user acknowledges that he or she is granting the company the authorizations needed to access their data. When data practices change, a new version of the policy is released. This release can occur a few times a year, when requirements are rapidly changing for the collection and processing of personal data. Furthermore, the user may change his or her privacy consent by opting in or out of the policy. We propose a formal framework to support companies and users in their understanding of policies evolution under consent regime that supports both retroactive and non-retroactive consent and consent revocation. Preliminary results include an ontology for policy evolution, expressed in Description Logic, that can be used to formalize consent and data collection logs and then query for which data types can be legally accessed.","author_count":4,"contributors":["Robol, Marco","D. Breaux, Travis","Paja, Elda","Giorgini, Paolo"],"cuid":["S01-000.00-383049"],"event":{"acronym":"RE","title":"IEEE International Requirements Engineering Conference"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","Europe, EU","OECD"],"country":["Italy","United States"],"glorg":["All Global Affiliations","Carnegie Mellon University","Department of Information Engineering and Computer Science, University of Trento"],"keyword":["Consent","Description logics","Evolution","Formal Framework","Policies","Privacy"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"consent verification under evolving privacy policies","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/84891219/08920420.pdf","version":"Authors Final Version"},"id":"S01-000.00-383049","identifier":[{"id":"85076903260","type":"scopus"}],"ids":["itu-78b10433-258f-4351-9f8d-e01b38150151"],"keyword":["Consent","Description Logics","Evolution","Formal Framework","Policies","Privacy"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-6CB77FC584FD5ED7FC25BA6521666A2A"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/84891219/08920420.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","country":"it","key":"department of information engineering and computer science university of trento","loc":["Italy","Europe, EU","OECD"],"name":"Department of Information Engineering and Computer Science, University of Trento","used":1},{"affno":"2","country":"us","key":"carnegie mellon university","loc":["United States","America, North","OECD"],"name":"Carnegie Mellon University","used":1},{"affno":"3","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Information Security and Trust","IT University of Copenhagen, Computer Science","IT University of Copenhagen, Software Engineering, Software Engineering"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Marco","key":"robolpau","last":"Robol","name":"Robol, Marco","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Travis","key":"dbreauxpau","last":"D. Breaux","name":"D. Breaux, Travis","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Elda","key":"pajapau","last":"Paja","locid":"ce1a5350-f645-4a53-a745-fca8d4f1f030","name":"Paja, Elda","orcid":"0000-0002-8346-2467","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Paolo","key":"giorginipau","last":"Giorgini","name":"Giorgini, Paolo","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1109/re.2019.00056","eisbn":["9781728139128"],"isbn":["9781728139135"],"pages":"422-427","place":"Conf. Location: Jeju Island, Korea (South)","publisher":"IEEE","status":"p","title":"Proceedings of the IEEE 27th International Requirements Engineering Conference (RE'19)"},"review":"Peer Reviewed","scoID":["2-s2.0-85076903260"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-78b10433-258f-4351-9f8d-e01b38150151"],"src":["ITU IT University of Copenhagen"],"title":"Consent Verification Under Evolving Privacy Policies","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383049","year":"2019","yearsub":"2019"}
