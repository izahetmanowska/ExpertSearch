l,"first":"Martin","key":"robillardpau","last":"Robillard","name":"Robillard, Martin","rank":28,"rolecode":"pau"},{"affno":"19","corresponding":null,"first":"Thiago Rocha","key":"silvapau","last":"Silva","locid":"bac2db00-9e7d-4ee1-bc9f-a0fd397042ad","name":"Silva, Thiago Rocha","orcid":"0000-0001-8961-4663","rank":29,"rolecode":"pau"},{"affno":"35","corresponding":null,"first":"Klaas Jan","key":"stolpau","last":"Stol","name":"Stol, Klaas Jan","rank":30,"rolecode":"pau"},{"affno":"10 11","corresponding":null,"first":"Margaret-Anne","key":"storeypau","last":"Storey","name":"Storey, Margaret-Anne","rank":31,"rolecode":"pau"},{"affno":"36","corresponding":null,"first":"Viktoria","key":"straypau","last":"Stray","name":"Stray, Viktoria","rank":32,"rolecode":"pau"},{"affno":"28","corresponding":null,"first":"Paolo","key":"tellpau","last":"Tell","name":"Tell, Paolo","rank":33,"rolecode":"pau"},{"affno":"37","corresponding":null,"first":"Christoph","key":"treudepau","last":"Treude","name":"Treude, Christoph","rank":34,"rolecode":"pau"},{"affno":"38","corresponding":null,"first":"Bogdan","key":"vasilescupau","last":"Vasilescu","name":"Vasilescu, Bogdan","rank":35,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.jss.2024.112115","issn":["01641212","18731228"],"issn_org":["01641212"],"journal":"Journal of Systems and Software","paperid":"112115","publisher":"Elsevier","status":"p","title":"Journal of Systems and Software","volume":"216"},"review":"Peer Reviewed","scoID":["2-s2.0-85195663773"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Technical University of Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-62e23d60-2156-43e9-8cab-53446d6eb02a","dtu-5e474969-552c-4008-a55f-7896c29cfb9f","sdu-78aab865-b4bc-4e17-9005-44c9c553e260"],"src":["AAU Aalborg University","DTU Technical University of Denmark","SDU University of Southern Denmark"],"title":"Generative AI in Software Engineering Must Be Human-Centered : The Copenhagen Manifesto","type":"Journal Comment","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-100.00-792887","year":"2024","yearsub":"2024"}
{"abstract":"Denmark is one of the most digitised countries in Europe. However, according to recent reports, IT security in Danish companies has not followed along. To shed light into the challenges that companies experience with implementing IT security, we conducted interviews with four employees from four different companies, asking about their IT security and their needs to become better protected. Our results show that the companies are lacking fundamental security protection and are in need of basic security help and raising awareness of cyber threats in the organisations. Based on our findings, we discuss directions for future steps in terms of addressing these issues.","author_count":4,"contributors":["Fleron, Camilla Nadja","Jørgensen, Jonas Kofod","Kulyk, Oksana","Paja, Elda"],"cuid":["S01-000.00-712517"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Cyber Threat Awareness","Digitalisation","Fundamental Security Protection","IT Security","Security Implementation Challenges"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-AAF","DI-PR-ALL"],"U":["DI-U-ALL","DI-U-ITU","DI-U-KU"]},"level3all":["DI-PR-AAF","DI-U-ITU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"towards a basic security framework for smes results from an investigation of cybersecurity challenges in denmark","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85174678778","version":"Other Version"},"id":"S01-000.00-712517","identifier":[{"id":"85174678778","type":"scopus"}],"ids":["itu-48cc02f5-690d-4dc6-9ff1-c18d6a740d72"],"keyword":["Cyber Threat Awareness","Digitalisation","Fundamental Security Protection","IT Security","Security Implementation Challenges"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-22E9FE66463E33F06B7B251129C92DEB"],"org":[{"affno":"1","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"danish agriculture food council","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-AAF","l3nl":"Danish Agriculture & Food Council","l3nn":"Danish Agriculture & Food Council","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Danish Agriculture & Food Council","namevar":["Danish Agricultural Agency"],"nora_code":"DI-PR-AAF","used":1},{"affno":"3","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Information Security and Trust","IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Camilla Nadja","key":"fleronpau","last":"Fleron","name":"Fleron, Camilla Nadja","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jonas Kofod","key":"jørgensenpau","last":"Jørgensen","name":"Jørgensen, Jonas Kofod","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Oksana","key":"kulykpau","last":"Kulyk","locid":"1dbd1112-eb47-4406-936c-6807e8845610","name":"Kulyk, Oksana","orcid":"0000-0003-4218-1658","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Elda","key":"pajapau","last":"Paja","locid":"ce1a5350-f645-4a53-a745-fca8d4f1f030","name":"Paja, Elda","orcid":"0000-0002-8346-2467","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1109/rew57809.2023.00046","edition":"2023","pages":"230-233","place":"Los Alamitos, CA, USA","publisher":"IEEE","status":"p","title":"2023 IEEE 31st International Requirements Engineering Conference Workshops (REW)"},"review":"Peer Reviewed","scoID":["2-s2.0-85174678778"],"search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Danish Agriculture & Food Council","IT University of Copenhagen","Private Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["itu-48cc02f5-690d-4dc6-9ff1-c18d6a740d72"],"src":["ITU IT University of Copenhagen"],"title":"Towards a Basic Security Framework for SMEs : Results From an Investigation of Cybersecurity Challenges in Denmark","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-712517","year":"2023","yearsub":"2023"}
{"abstract":"Through the past two and a half years, COVID-19 has swept through the world and new technologies for mitigating spread, such as exposure notification applications and contact tracing, have been implemented in many countries. However, the uptake has differed from country to country and it has not been clear if culture, death rates or information dissemination have been a factor in their adoption rate. However, these apps introduce issues of trust and privacy protection, which can create challenges in terms of adoptions and daily use. In this paper we present the results from a cross-country survey study of potential barriers to adoption of in particular COVID-19 contact tracing apps. We found that people's existing privacy concerns are an have a reverse correlation with adoption behavior but that the geographical location, as well as other demographics, such as age and gender, do not have significant effect on either adoption of the app or privacy concerns. Instead, a better understanding of what data is collected through the apps lead to a higher level of adoption. We provide suggestions for how to approach the development and deployment of contact tracing apps and more broadly health tracking apps.","author_count":6,"contributors":["Kulyk, Oksana","Britton-Steele, Lauren","Paja, Elda","Duckert, Melanie","Barkhuus, Louise"],"cuid":["S01-000.00-382036"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","Ithaca College"],"keyword":["E health","Empirical studies in ubiquitous and mobile com puting","Health tracking applications","Human centered computing","Privacy","Security and privacy","Social aspects of security and privacy","Trust"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"you have been in close contact with a person infected with covid 000000000019 and you may have been infected understanding privacy concerns trust and adoption in mobile covid 000000000019 tracing across four countries","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/91120316/MobileCHI_corona_privacy.pdf","version":"Authors Final Version"},"id":"S01-000.00-382036","identifier":[{"id":"85141170029","type":"scopus"}],"ids":["itu-34616c01-4287-4d1d-9c17-7a55f427890f"],"keyword":[": e-Health","Empirical studies in ubiquitous and mobile com- puting","Health tracking applications","Human-centered computing","Privacy","Security and privacy","Social aspects of security and privacy","Trust"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-6A902A05C71C0C5ADCCBA378E5CEDF9B"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/91120316/MobileCHI_corona_privacy.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Information Security and Trust","IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"us","key":"ithaca college","loc":["United States","America, North","OECD"],"name":"Ithaca College","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Oksana","key":"kulykpau","last":"Kulyk","locid":"1dbd1112-eb47-4406-936c-6807e8845610","name":"Kulyk, Oksana","orcid":"0000-0003-4218-1658","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lauren","key":"brittonsteelepau","last":"Britton-Steele","name":"Britton-Steele, Lauren","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Elda","key":"pajapau","last":"Paja","locid":"ce1a5350-f645-4a53-a745-fca8d4f1f030","name":"Paja, Elda","orcid":"0000-0002-8346-2467","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Melanie Duckert","key":"schmidtpau","last":"Schmidt","locid":"a0f5a47c-1073-4c01-b62d-51b767f01d69","name":"Duckert, Melanie","name_org":"Schmidt, Melanie Duckert","orcid":"0000-0001-8079-8363","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Louise","key":"barkhuuspau","last":"Barkhuus","locid":"831421c0-027f-4a25-b795-ee2fce0c8d2a","name":"Barkhuus, Louise","orcid":"0000-0003-1306-249X","rank":5,"rolecode":"pau"},{"affno":"","first":"Jeff","key":"nicholspedh","last":"Nichols","name":"Nichols, Jeff","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1145/3546739","edition":"Issue MHCI","eisbn":["25730142"],"pages":"1-27","place":"New York","publisher":"Association for Computing Machinery","status":"p","title":"Proceedings of the ACM on Human-Computer Interaction","volume":"6"},"review":"Peer Reviewed","scoID":["2-s2.0-85141170029"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-34616c01-4287-4d1d-9c17-7a55f427890f"],"src":["ITU IT University of Copenhagen"],"title":"You have been in Close Contact with a Person Infected with COVID-19 and you may have been Infected : Understanding Privacy Concerns, Trust and Adoption in Mobile COVID-19 Tracing Across Four Countries","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382036","year":"2022","yearsub":"2022"}
{"abstract":"Advances in personalization of digital services are driven by low-cost data collection and processing, in addition to the wide variety of third-party frameworks for authentication, storage, and marketing. New privacy regulations, such as the General Data Protection Regulation (GDPR) and the California Consumer Privacy Act (CCPA), increasingly require organizations to explicitly state their data practices in privacy policies. When data practices change, a new version of the policy is released. This can occur a few times a year, when data collection or processing requirements are rapidly changing. Consent evolution raises specific challenges to ensuring GDPR compliance. We propose a formal consent framework to support organizations, data users and data subjects in their understanding of policy evolution under a consent regime that supports both the retroactive and non-retroactive granting and withdrawal of consent. The contributions include: (i) a formal framework to reason about data collection and access under multiple consent granting and revocation scenarios; (ii) a scripting language that implements the consent framework for encoding and executing different scenarios; (iii) five consent evolution use cases that illustrate how organizations would evolve their policies using this framework; and (iv) a scalability evaluation of the reasoning framework. The framework models are used to verify when user consent prevents or detects unauthorized data collection and access. The framework can be integrated into a runtime architecture to monitor policy violations as data practices evolve in real-time. The framework was evaluated using the five use cases and a simulation to measure the framework scalability. The simulation results show that the approach is computationally scalable for use in runtime consent monitoring under a standard model of data collection and access, and practice and policy evolution.","author_count":4,"contributors":["Robol, Marco","D. Breaux, Travis","Paja, Elda","Giorgini, Paolo"],"cuid":["S01-000.00-382210"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","Europe, EU","OECD"],"country":["Italy","United States"],"glorg":["All Global Affiliations","Carnegie Mellon University","Department of Information Engineering and Computer Science, University of Trento","University of Trento"],"keyword":["Analysis","Consent","Consent Revocation","Description Logic","Evolution","Formal Framework","GDPR","Logs","Privacy","Retroactivity","Verification"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"consent verification monitoring","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1145/3490754","version":"Published Version"},"id":"S01-000.00-382210","identifier":[{"id":"85152593921","type":"scopus"}],"ids":["itu-3fbda3d5-4249-4029-aea6-c6f68e5aa1c5"],"keyword":["Analysis","Consent","Consent Revocation","Description Logic","Evolution","Formal Framework","GDPR","Logs","Privacy","Retroactivity","Verification"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-6D20DEB1D57F0B44E2741B1D7A78439A"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1145/3490754","version":"Published Version"}],"org":[{"affno":"1","country":"it","key":"university of trento","loc":["Italy","Europe, EU","OECD"],"name":"University of Trento","used":1},{"affno":"2","country":"us","key":"carnegie mellon university","loc":["United States","America, North","OECD"],"name":"Carnegie Mellon University","used":1},{"affno":"3","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Information Security and Trust","IT University of Copenhagen, Computer Science","IT University of Copenhagen, Software Engineering, Software Engineering"],"nora_code":"DI-U-ITU","used":1},{"affno":"4","country":"it","key":"department of information engineering and computer science university of trento","loc":["Italy","Europe, EU","OECD"],"name":"Department of Information Engineering and Computer Science, University of Trento","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Marco","key":"robolpau","last":"Robol","name":"Robol, Marco","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Travis","key":"dbreauxpau","last":"D. Breaux","name":"D. Breaux, Travis","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Elda","key":"pajapau","last":"Paja","locid":"ce1a5350-f645-4a53-a745-fca8d4f1f030","name":"Paja, Elda","orcid":"0000-0002-8346-2467","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Paolo","key":"giorginipau","last":"Giorgini","name":"Giorgini, Paolo","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1145/3490754","issn":["1049331X","15577392"],"journal":"ACM Transactions on Software Engineering and Methodology","publisher":"Association for Computing Machinery","status":"p","title":"ACM Transactions on Software Engineering and Methodology","title_org":"ACM Transactions on Software Engineering and Methodology (TOSEM)"},"review":"Peer Reviewed","scoID":["2-s2.0-85152593921"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-3fbda3d5-4249-4029-aea6-c6f68e5aa1c5"],"src":["ITU IT University of Copenhagen"],"title":"Consent verification monitoring","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382210","year":"2022","yearsub":"2022"}
{"abstract":"As software engineering (SE) practitioners, we can help society by using our communities of experts to address a software need of a socially conscious organization. Doing so can benefit society in the locale of a SE conference and provide access to international experts for local organizations. Furthermore, established SE researchers as well as practitioners and students have the opportunity for a unique learning experience. While the SE community has already realized the importance of addressing human values and promoting social good objectives in software development, we are unaware of previous attempts to leverage SE conferences for this activity. Conferences present an opportunity to enjoy the assembly of SE practitioners, researchers, and students for the purpose of a philanthropic endeavor. Over the past four years of running a “Requirements Engineering for Social Good” event called RE Cares, co-located with the International Conference on Requirements Engineering, we worked with the stakeholders local to the conference venue. We selected stakeholders who would not necessarily have ready access to requirements engineering, software design, and development expertise otherwise, to build software targeting “good causes.” In the last two years, this event was altered to adapt to the constraints induced by COVID-19, moving to a hybrid mode and changing many of its practices accordingly. This paper summarizes and generalizes our experiences, discussing our lessons learned in the context of the pandemic and beyond and providing a framework for conducting similar social contribution in any SE conferences in general.","author_count":11,"contributors":["Levy, Meira","Hadar, Irit","Horkoff, Jennifer","Hayes, Jane Huffman","Paech, Barbara","Dekhtyar, Alex","Mussbacher, Gunter","Paja, Elda","Li, Tong","Lee, Seok-Won","Fang, Dongfeng"],"cuid":["S01-000.00-382587"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Asia, East","Asia, Middle East","Europe, EU","Nordic","OECD"],"country":["Canada","China","Germany","Israel","South Korea","Sweden","United States"],"glorg":["Ajou University","All Global Affiliations","Beijing University of Technology","California Polytechnic State University","Chalmers University of Technology","Heidelberg University ","McGill University","Shenkar College of Engineering, Design and Art","University of Gothenburg","University of Haifa","University of Kentucky"],"keyword":["Covid 19","Hybrid Events","Pandemic","Philanthropic projects","Requirements engineering","Stakeholders"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"philanthropic conference based requirements engineering in time of pandemic and beyond","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s00766-022-00386-4","version":"Published Version"},"id":"S01-000.00-382587","identifier":[{"id":"85138110755","type":"scopus"}],"ids":["itu-58c9cab9-bc3d-466e-b422-6c9a943a4882"],"keyword":["COVID-19","Hybrid Events","Pandemic","Philanthropic projects","Requirements engineering","Stakeholders"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-F4618613E330151692ED94B734F3BB88"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.itu.dk/ws/files/101336677/s00766-022-00386-4.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"rem","url":"https://journals.scholarsportal.info/details/09473602/v28i0002/213_pcreitopab.xml","version":"Published Version"},{"access":"oa","type":"rem","url":"https://link.springer.com/content/pdf/10.1007/s00766-022-00386-4.pdf?pdf=button","version":"Published Version"},{"access":"oa","t