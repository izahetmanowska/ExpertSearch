{"abstract":"The handbook provides short introductions to necessary knowledge for applicants in the two calls in October 2014 and June 2015 where they can present an idea for product development and apply for up to 10,000 Euro. Furthermore, the handbook is relevant for the next phase, where the selected approx. 50 projects elaborate detailed technical and market plans. Last, the handbook provides links to further study and information about how to get help in later phases.","author_count":3,"contributors":["Ulslev Pedersen, Rasmus","Häuser, Ivan","Balle, Kim"],"cuid":["S01-000.00-288077"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"com","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS"]},"level3all":["DI-U-CBS"]},"review":"nr","rtype":["clu"],"sorti":"finodex handbook for entrepreneurs","src":["cbs"],"src-code":["DI-U-CBS"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-SA","type":"loc","url":"https://research-api.cbs.dk/ws/files/58811157/Finodex_Handbook_For_Entrepreneurs_Oct2014.pdf","version":"Published Version"},"id":"S01-000.00-288077","ids":["cbs-855ff1b2-3380-4ed1-91c7-68e5cd7890e1"],"lang":"English","level":"Commissioned","mra":["Social Science"],"noi":["Local-1-1-9BB696F5A30B61E44470073513395B5F"],"oa_link":[{"access":"oa","license":"CC BY-SA","type":"loc","url":"https://research-api.cbs.dk/ws/files/58811157/Finodex_Handbook_For_Entrepreneurs_Oct2014.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of IT Management"],"nora_code":"DI-U-CBS","used":1}],"person":[{"affno