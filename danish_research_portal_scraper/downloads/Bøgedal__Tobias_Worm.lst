,"DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Other Companies","Private Research","Universities","seluxit a/s"],"PST":["Published"]},"sid":["aau-d260168f-d7a3-4130-891b-384d5b0cd2b1"],"src":["AAU Aalborg University"],"title":"Modelling and Analysis of DTLS : Power Consumption and Attacks","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-771125","year":"2024","yearsub":"2024"}
{"abstract":"We perform a preliminary security analysis of the initial boot stage for the OpenTitan silicon root of trust, including formalisation and verification of relevant security goals using both bounded model checking and (unbounded) model checking. We further report on a potential vulnerability in the platform and show how it can be reproduced using formal modelling and argue that co-verification would be able to detect such vulnerabilities for high assurance projects.","author_count":15,"contributors":["Møller, Bjarke Hilmer","Søndergaard, Jacob Gosch","Jensen, Kristoffer Skagbæk","Pedersen, Magnus Winkel","Bøgedal, Tobias Worm","Christensen, Anton","Poulsen, Danny Bøgsted","Larsen, Kim Guldstrand","Hansen, Rene Rydhof","Rosted Jensen, Thomas","Juvoll Madsen, Heino","Uhrenfeldt, Henrik"],"cuid":["S01-000.00-056753"],"event":{"end":"2021-11-30","place":"Virtual, Online","start":"2021-11-29","title":"26th Nordic Conference on Secure IT Systems, NordSec 2021","year":"2021"},"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Asia, East"],"corresponding_author":["Christensen, Anton"],"country":["China"],"glorg":["All Global Affiliations","Huawei Technologies Co., Ltd."],"keyword":["Formal methods","Security"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"preliminary security analysis formalisation and verification of opentitan secure boot code","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85119856071&partnerID=8YFLogxK","version":"Other Version"},"id":"S01-000.00-056753","identifier":[{"id":"85119856071","type":"scopus"}],"ids":["aau-16cec89e-036d-435c-a30e-f4b9ffcaf90e"],"keyword":["Co-verification","Formal methods","Hardware modelling","Security"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-1879149CD384A01464336C0FABD780CD"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Technical Faculty of IT and Design","Aalborg University, The Technical Faculty of IT and Design, Department of Computer Science","Aalborg University, The Technical Faculty of IT and Design, Department of Computer Science, Distributed, Embedded and Intelligent Systems"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"cn","key":"huawei technologies co ltd","loc":["China","Asia, East"],"name":"Huawei Technologies Co., Ltd.","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Bjarke Hilmer","key":"møllerpau","last":"Møller","locid":"6a92c806-249d-40d6-8bee-88fa92a6854b","name":"Møller, Bjarke Hilmer","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jacob Gosch","key":"søndergaardpau","last":"Søndergaard","locid":"8658a9ba-583d-4203-8449-5aa09982e6d1","name":"Søndergaard, Jacob Gosch","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kristoffer Skagbæk","key":"jensenpau","last":"Jensen","locid":"83bdd02b-7c9e-4550-a4ae-976ccd867c16","name":"Jensen, Kristoffer Skagbæk","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Magnus Winkel","key":"pedersenpau","last":"Pedersen","locid":"305c3f9f-96bb-4d2d-8b6a-3e1851d2f6f3","name":"Pedersen, Magnus Winkel","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Tobias Worm","key":"bøgedalpau","last":"Bøgedal","locid":"e498c997-a8d3-