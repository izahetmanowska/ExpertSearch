 Michael","rank":11,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Hans","key":"skovpetersenhanspau","last":"Skov-Petersen","name":"Skov-Petersen, Hans","rank":12,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Jens","key":"troelsenjenspau","last":"Troelsen","name":"Troelsen, Jens","rank":13,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Jasper","key":"schipperijnjasperpau","last":"Schipperijn","name":"Schipperijn, Jasper","rank":14,"rolecode":"pau"}],"pub":{"status":"X"},"review":"Undetermined","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Technical University of Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Undefined"]},"sid":["aau-71cf512c-d841-479c-92e0-d2820fda65ab"],"src":["AAU Aalborg University"],"title":"14 forskere: Videnscenter for cyklisme skal ikke høre under Vejdirektoratet","type":"Other-Internet Publication","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-083152","year":"2021","yearsub":"2021"}
{"abstract":"I en bred aftale blandt Folketingets partier er det som en del af Infrastrukturplan 2035 besluttet at afsætte en pulje på i alt tre milliarder kroner til at fremme cyklisme i perioden 2022 til 2035. På vores universiteter har vi med stor interesse modtaget nyheden om, at der blandt de konkrete initiativer er afsat midler til, at Danmark skal have et nationalt videnscenter for cykelfremme. Vi kan nu erfare, at Transportministeriet har planer om, at dette videnscenter for cykling skal placeres i Vejdirektoratet, som sandsynligvis vil gøre brug af deres \"Cykelråd\", der består af repræsentanter fra eksempelvis Cyklistforbundet og FDM, men uden repræsentanter fra universiteterne overhovedet. Vejdirektoratet har grundlæggende stor erfaring med planlægning af den overordnede vejinfrastruktur, primært i det åbne land, men ikke i lokal vej- og stiplanlægning i byerne, ligesom Vejdirektoratets sektoransvar ikke omfatter forskning. Derfor mener vi ikke, at det er oplagt at placere et videnscenter i en institution med så stor fokus på planlægning af infrastruktur med transporteffektivisering i regional/national skala som hovedmål.","author_count":14,"contributors":["Nielsen, Otto Anker","Haustein, Sonja","Janstrup, Kira Hyldekær","Jensen, Anders Fjendbo","Møller, Mette","Rich, Jeppe","Freudendal-Pedersen, Malene","Jensen, Ole B.","Lahrmann, Harry","Valderrama, Andres","Szell, Michael","Skov-Petersen, Hans","Troelsen, Jens","Schipperijn, Jasper"],"cuid":["S01-000.00-320287"],"filters":{"added":"2022-06","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"level":"pop","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-DTU","DI-U-ITU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-U-AAU","DI-U-DTU","DI-U-ITU","DI-U-KU","DI-U-SDU"]},"review":"und","rtype":["clu"],"sorti":"000000000014 forskere videnscenter for cyklisme skal ikke høre under vejdirektoratet","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://www.altinget.dk/transport/artikel/14-forskere-videnscenter-for-cyklisme-skal-vaere-uafhaengigt-og-forskningsbaseret-ikke-hoere-under-vejdirektoratet","version":"Published Version"},"id":"S01-000.00-320287","ids":["dtu-34c59a50-3539-48fe-89bf-42509aa8143f"],"lang":"Danish","level":"Popular","mra":["Science/Technology"],"noi":["Local-1-1-AACA9D17FE057211C4674A096154E89F"],"oa_link":[{"access":"oa","type":"rem","url":"https://www.altinget.dk/transport/artikel/14-forskere-videnscenter-for-cyklisme-skal-vaere-uafhaengigt-og-forskningsbaseret-ikke-hoere-under-vejdirektoratet","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Technology, Management and Economics","Technical University of Denmark, Department of Technology, Management and Economics, Transport","Technical University of Denmark, Department of Technology, Management and Economics, Transport, Network and Route Choice"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"dk","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University"],"nora_code":"DI-U-AAU","used":1},{"affno":"3","country":"dk","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT Universit