ffno":"2","corresponding":null,"first":"Anders Fjendbo","key":"jensenpau","last":"Jensen","name":"Jensen, Anders Fjendbo","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Caroline","key":"samsonpau","last":"Samson","locid":"2a2973cb-5c9f-4f26-bde2-a85b0691c69b","name":"Samson, Caroline","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Harry","key":"lahrmannpau","last":"Lahrmann","locid":"7e1bc853-b677-467c-87ae-54b08116b7e4","name":"Lahrmann, Harry","orcid":"0000-0001-6339-4586","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Hilda","key":"rømerchristensenpau","last":"Rømer Christensen","name":"Rømer Christensen, Hilda","rank":5,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Jasper","key":"schipperijnpau","last":"Schipperijn","name":"Schipperijn, Jasper","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Mads","key":"paulsenpau","last":"Paulsen","name":"Paulsen, Mads","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Malene","key":"freudendalpedersenpau","last":"Freudendal-Pedersen","locid":"fb9dfe52-c3f9-4b03-8fa6-6c514173960a","name":"Freudendal-Pedersen, Malene","orcid":"0000-0001-5140-701X","rank":8,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Michael","key":"szellpau","last":"Szell","name":"Szell, Michael","rank":9,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Michala Hvidt","key":"breengaardpau","last":"Breengaard","name":"Breengaard, Michala Hvidt","rank":10,"rolecode":"pau"}],"pub":{"issn":["09071814"],"newspaper":"Politiken","publisher":"Politikens Forlag","status":"p","title":"Politiken"},"review":"Undetermined","search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Technical University of Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-1b191886-a8f2-4a56-98c5-f8dd6f2104fc"],"src":["AAU Aalborg University"],"title":"Er Danmark en cykelnation?","type":"Newspaper Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-057985","year":"2022","yearsub":"2022"}
{"abstract":"Contemporary street design prioritizes vehicular traffic flow and assumes compliant road users. However, actual human behavior is typically neglected, especially of cyclists, leading to streets with inadequate wayfinding and protection from vehicular traffic. To improve planning, here we develop a computational method to detect cyclist trajectories from video recordings and apply it to the Dybbølsbro intersection in Copenhagen, Denmark. In one hour of footage we find hundreds of trajectories that contradict the design, explainable by the desire for straightforward, uninterrupted travel largely not provided by the intersection. This neglect and the prioritization of vehicular traffic highlight opportunities for improving Danish intersection design.","author_count":3,"contributors":["Breum, Simon Martin","Kostic, Bojan","Szell, Michael"],"cuid":["S01-000.00-384682"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Cycling","Urban data science","human centric planning","intersection design","traffic behavior"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"computational desire line analysis of cyclists on the dybbølsbro intersection in copenhagen","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-SA","type":"doi","url":"https://doi.org/10.32866/001c.56683","version":"Published Version"},"id":"S01-000.00-384682","identifier":[{"id":"85200126357","type":"scopus"}],"ids":["itu-e7cecb8b-5b07-4aa7-bfc8-b619ba725c9f"],"keyword":["cycling","human-centric planning","intersection design","traffic behavior","urban data science"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-FCF99357C20FB08A4146F8287199CE06"],"oa_link":[{"access":"oa","license":"CC BY-SA","type":"doi","url":"https://doi.org/10.32866/001c.56683","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, NEtwoRks, Data, and Society"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Simon Martin","key":"breumpau","last":"Breum","name":"Breum, Simon Martin","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Bojan","key":"kosticpau","last":"Kostic","name":"Kostic, Bojan","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Michael","key":"szellpau","last":"Szell","locid":"2ef641d0-bd79-425b-8b12-b58d74b993ae","name":"Szell, Michael","orcid":"0000-0003-3022-2483","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.32866/001c.56683","issn":["26528800"],"journal":"Transport Findings","pages":"1-10","paperid":"56683","status":"p","title":"Transport Findings"},"review":"Peer Reviewed","scoID":["2-s2.0-85200126357"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-e7cecb8b-5b07-4aa7-bfc8-b619ba725c9f"],"src":["ITU IT University of Copenhagen"],"title":"Computational Desire Line Analysis of Cyclists on the Dybbølsbro Intersection in Copenhagen","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384682","year":"2022","yearsub":"2022"}
{"abstract":"Developing safe infrastructure for micromobility like bicycles or e-scooters is an efficient pathway towards climate-friendly, sustainable, and livable cities. However, urban micromobility infrastructure is typically planned ad-hoc and at best informed by survey data. Here, we study how data of micromobility trips and crashes can shape and automatize such network planning processes. We introduce a parameter that tunes the focus between demand-based and safety-based development, and investigate systematically this tradeoff for the city of Turin. We find that a full focus on demand or safety generates different network extensions in the short term, with an optimal tradeoff in-between. In the long term, our framework improves overall network quality independent of short-term focus. Thus, we show how a data-driven process can provide urban planners with automated assistance for variable short-term scenario planning while maintaining the long-term goal of a sustainable, city-spanning micromobility network.","author_count":4,"contributors":["Folco, Pietro","Gauvin, Laetitia","Tizzoni, Michele","Szell, Michael"],"cuid":["S01-000.00-383451"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Italy"],"glorg":["All Global Affiliations","Institute for Scientific Interchange Foundation"],"keyword":["Road safety","Sustainable mobility","Urban data science","micromobility infrastructure"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"data driven micromobility network planning for demand and safety","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1177/23998083221135611","version":"Published Version"},"id":"S01-000.00-383451","identifier":[{"id":"85141025771","type":"scopus"}],"ids":["itu-9477db99-e17b-4031-a51b-f803b2f9b12a"],"keyword":["micromobility infrastructure","road safety","sustainable mobility","urban data science"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-4F5EBFFA777F21F18B7591E6DACEF38B"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1177/23998083221135611","version":"Published Version"}],"org":[{"affno":"1","country":"it","key":"institute for scientific interchange foundation","loc":["Italy","Europe, EU","OECD"],"name":"Institute for Scientific Interchange Foundation","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, NEtwoRks, Data, and Society"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Pietro","key":"folcopau","last":"Folco","name":"Folco, Pietro","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Laetitia","key":"gauvinpau","last":"Gauvin","name":"Gauvin, Laetitia","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Michele","key":"tizzonipau","last":"Tizzoni","name":"Tizzoni, Michele","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Michael","key":"szellpau","last":"Szell","locid":"2ef641d0-bd79-425b-8b12-b58d74b993ae","name":"Szell, Michael","orcid":"0000-0003-3022-2483","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1177/23998083221135611","issn":["23998083","23998091"],"issue":"0","journal":"Environment and Planning B: Urban Analytics and City Science","pages":"1-16","paperid":"0","publisher":"Sage Publishing","status":"p","title":"Environment and Planning B: Urban Analytics and City Science","volume":"0"},"review":"Peer Reviewed","scoID":["2-s2.0-85141025771"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-9477db99-e17b-4031-a51b-f803b2f9b12a"],"src":["ITU IT University of Copenhagen"],"title":"Data-driven micromobility network planning for demand and safety","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383451","year":"2022","yearsub":"2022"}
{"abstract":"Cycling is a promising solution to unsustainable urban transport systems. However, prevailing bicycle network development follows a slow and piecewise process, without taking into account the structural complexity of transportation networks. Here we explore systematically the topological limitations of urban bicycle network development. For 62 cities we study different variations of growing a synthetic bicycle network between an arbitrary set of points routed on the urban street network. We find initially decreasing returns on investment until a critical threshold, posing fundamental consequences to sustainable urban planning: cities must invest into bicycle networks with the right growth strategy, and persistently, to surpass a critical mass. We also find pronounced overlaps of synthetically grown networks in cities with well-developed existing bicycle networks, showing that our model reflects reality. Growing networks from scratch makes our approach a generally applicable starting point for sustainable urban bicycle network planning with minimal data requirements.","author_count":5,"contributors":["Szell, Michael","Mimar, Sayat","Perlman, Tyler","Ghoshal, Gourab","Sinatra, Roberta"],"cuid":["S02-100.00-673005"],"filters":{"added":"2023-07","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"continent":["America, North","Europe, EU","OECD"],"country":["Austria","Italy","United States"],"glorg":["All Global Affiliations","Complexity Science Hub Vienna","Institute for Scientific Interchange Foundation","University of Rochester"],"keyword":["Bicycle networks","Network growth strategy","Sustainable planning","Transportation infrastructure","Urban transportation"],"level":"sci","mra":["sci","soc"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-KU"]},"level3all":["DI-U-ITU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"growing urban bicycle networks","src":["itu","ku"],"src-code":["DI-U-ITU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1038/s41598-022-10783-y","version":"Published Version"},"id":"S02-100.00-673005","identifier":[{"id":"85128959593","type":"scopus"},{"id":"35474086","type":"pmid"},{"id":"PMC9039277","type":"pmcid"}],"ids":["itu-d3ed33d8-cda0-424f-9f44-c048d64586ff","ku-bb213ba6-ec98-4845-9b60-54adb769800e"],"keyword":["Bicycle networks","Network growth strategy","Sustainable planning","Transportation infrastructure","Urban transportation"],"lang":"English","level":"Scientific","mra":["Science/Technology","Social Science"],"noi":["Global-Local-2-5-4FE0AE365306E2A94A24193984AF3997"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/347002407/s41598_022_10783_y.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.itu.dk/ws/files/86710417/szell2022gub.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1038/s41598-022-10783-y","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, NEtwoRks, Data, and Society"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"us","key":"university of rochester","loc":["United States","America, North","OECD"],"name":"University of Rochester","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Social Sciences, Faculty of Social Sciences, shared expenditure, Social Data Science"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Michael","key":"szellpau","last":"Szell","locid":"2ef641d0-bd79-425b-8b12-b58d74b993ae","name":"Szell, Michael","orcid":"0000-0003-3022-2483","rank":1,"rolecode":"pau"},{"affno":"2","first":"Sayat","key":"mimarpau","last":"Mimar","name":"Mimar, Sayat","rank":2,"rolecode":"pau"},{"affno":"2","first":"Tyler","key":"perlmanpau","last":"Perlman","name":"Perlman, Tyler","rank":3,"rolecode":"pau"},{"affno":"2","first":"Gourab","key":"ghoshalpau","last":"Ghoshal","name":"Ghoshal, Gourab","rank":4,"rolecode":"pau"},{"affno":"3 1","first":"Roberta","key":"sinatrapau","last":"Sinatra","locid":"df859e44-cb2b-41f8-b85b-cfd243c37ab2","name":"Sinatra, Roberta","orcid":"0000-0002-7558-1028","rank":5,"rolecode":"pau"}],"pmid":["35474086"],"pub":{"doi":"10.1038/s41598-022-10783-y","issn":["20452322"],"issue":"6765","journal":"Scientific Reports","paperid":"6765","publisher":"Nature Publishing Group","status":"p","title":"Scientific Reports","volume":"12"},"review":"Peer Reviewed","scoID":["2-s2.0-85128959593"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["itu-d3ed33d8-cda0-424f-9f44-c048d64586ff","ku-bb213ba6-ec98-4845-9b60-54adb769800e"],"src":["ITU IT University of Copenhagen","KU University of Copenhagen"],"title":"Growing urban bicycle networks","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-673005","year":"2022","yearsub":"2022"}
{"abstract":"Multiplex networks allow us to study a variety of complex systems where nodes connect to each other in multiple ways, for example friend, family, and co-worker relations in social networks. Link prediction is the branch of network analysis allowing us to forecast the future status of a network: which new connections are the most likely to appear in the future? In multiplex link prediction we also ask: of which type? Because this last question is unanswerable with classical link prediction, here we investigate the use of graph association rules to inform multiplex link prediction. We derive such rules by identifying all frequent patterns in a network via multiplex graph mining, and then score each unobserved link's likelihood by finding the occurrences of each rule in the original network. Association rules add new abilities to multiplex link prediction: to predict new node arrivals, to consider higher order structures with four or more nodes, and to be memory efficient. In our experiments, we show that, exploiting graph association rules, we are able to achieve a prediction performance close to an ideal ensemble classifier. Further, we perform a case study on a signed multiplex network, showing how graph association rules can provide valuable insights to extend social balance theory.","author_count":2,"contributors":["Coscia, Michele","Szell, Michael"],"cuid":["S01-000.00-382528"],"event":{"acronym":"ICWSM","title":"International AAAI Conference on Web and Social Media"},"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Association rules","Graph mining","Multilayer networks","Multiplex networks"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"multiplex graph association rules for link prediction","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.48550/arXiv.2008.08351","version":"Published Version"},"id":"S01-000.00-382528","ids":["itu-5440fcc0-eca6-4560-b33b-9c2e77f0a59c"],"keyword":["association rules","graph mining","multilayer networks","multiplex networks"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-6A3AFD80FCC2A10B1CCA73660445B02B"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.48550/arXiv.2008.08351","version":"Published Version"},{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85885111/2008.08351.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, NEtwoRks, Data, and Society"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Michele","key":"cosciapau","last":"Coscia","locid":"90b501a9-4d44-460b-b193-4d7d524bb21b","name":"Coscia, Michele","orcid":"0000-0001-5984-5137","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Michael","key":"szellpau","last":"Szell","locid":"2ef641d0-bd79-425b-8b12-b58d74b993ae","name":"Szell, Michael","orcid":"0000-0003-3022-2483","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.48550/arxiv.2008.08351","isbn":["9781577358695"],"pages":"129-139","publisher":"AAAI Press","status":"p","title":"Proceedings of the Fifteenth International AAAI Conference on Web and Social Media, ICWSM 2021"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-5440fcc0-eca6-4560-b33b-9c2e77f0a59c"],"src":["ITU IT University of Copenhagen"],"title":"Multiplex Graph Association Rules for Link Prediction","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382528","year":"2021","yearsub":"2021"}
{"abstract":"Danmark skal have et nationalt videnscenter for cykelfremme. Regeringen lægger op til, at det skal høre under Vejdirektoratet, men det bør i stedet høre til på universitetet og i et tværfagligt miljø, der kan undersøge adfærd og holdninger såvel som sundhed og regional udvikling, skriver 14 forskere.","author_count":14,"contributors":["Nielsen, Otto Anker","Haustein, Sonja","Janstrup, Kira Hyldekær","Jensen, Anders Fjendbo","Møller, Mette","Rich, Jeppe","Freudendal-Pedersen, Malene","Jensen, Ole B.","Lahrmann, Harry","Valderrama Pineda, Andres Felipe","Szell, Michael","Skov-Petersen, Hans","Troelsen, Jens","Schipperijn, Jasper"],"cuid":["S01-000.00-083152"],"filters":{"added":"2022-03","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"level":"pop","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-DTU","DI-U-ITU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-U-AAU","DI-U-DTU","DI-U-ITU","DI-U-KU","DI-U-SDU"]},"review":"und","rtype":["clu"],"sorti":"000000000014 forskere videnscenter for cyklisme skal ikke høre under vejdirektoratet","src":["aau"],"src-code":["DI-U-AAU"],"type":"doi","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://www.altinget.dk/transport/artikel/14-forskere-videnscenter-for-cyklisme-skal-vaere-uafhaengigt-og-forskningsbaseret-ikke-hoere-under-vejdirektoratet","version":"Published Version"},"id":"S01-000.00-083152","ids":["aau-71cf512c-d841-479c-92e0-d2820fda65ab"],"lang":"Danish","level":"Popular","mra":["Science/Technology"],"noi":["Local-1-1-8E61ECD38512744B1768ECF58A341B25"],"oa_link":[{"access":"oa","type":"rem","url":"https://www.altinget.dk/transport/artikel/14-forskere-videnscenter-for-cyklisme-skal-vaere-uafhaengigt-og-forskningsbaseret-ikke-hoere-under-vejdirektoratet","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"dtu technical university of denmark","l2":"