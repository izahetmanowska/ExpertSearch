pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jeppe","key":"richjeppepau","last":"Rich","locid":"1e960cbc-b046-41ca-b573-17911435a4c0","name":"Rich, Jeppe","orcid":"0000-0001-5706-3836","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Malene","key":"freudendalpedersenmalenepau","last":"Freudendal-Pedersen","name":"Freudendal-Pedersen, Malene","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ole B.","key":"jensenolebpau","last":"Jensen","name":"Jensen, Ole B.","rank":8,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Harry","key":"lahrmannharrypau","last":"Lahrmann","name":"Lahrmann, Harry","rank":9,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Andres","key":"valderramaandrespau","last":"Valderrama","name":"Valderrama, Andres","rank":10,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Michael","key":"szellmichaelpau","last":"Szell","name":"Szell, Michael","rank":11,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Hans","key":"skovpetersenhanspau","last":"Skov-Petersen","name":"Skov-Petersen, Hans","rank":12,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Jens","key":"troelsenjenspau","last":"Troelsen","name":"Troelsen, Jens","rank":13,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Jasper","key":"schipperijnjasperpau","last":"Schipperijn","name":"Schipperijn, Jasper","rank":14,"rolecode":"pau"}],"pub":{"issn":["25970127"],"journal":"Altinget","status":"p","title":"Altinget","volume":"11"},"review":"Undetermined","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Technical University of Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["dtu-34c59a50-3539-48fe-89bf-42509aa8143f"],"src":["DTU Technical University of Denmark"],"title":"14 forskere: Videnscenter for cyklisme skal ikke høre under Vejdirektoratet","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-320287","year":"2021","yearsub":"2022"}
{"abstract":"Human mobility impacts many aspects of a city, from its spatial structure to its response to an epidemic. It is also ultimately key to social interactions, innovation and productivity. However, our quantitative understanding of the aggregate movements of individuals remains incomplete. Existing models—such as the gravity law or the radiation model—concentrate on the purely spatial dependence of mobility flows and do not capture the varying frequencies of recurrent visits to the same locations. Here we reveal a simple and robust scaling law that captures the temporal and spatial spectrum of population movement on the basis of large-scale mobility data from diverse cities around the globe. According to this law, the number of visitors to any location decreases as the inverse square of the product of their visiting frequency and travel distance. We further show that the spatio-temporal flows to different locations give rise to prominent spatial clusters with an area distribution that follows Zipf’s law. Finally, we build an individual mobility model based on exploration and preferential return to provide a mechanistic explanation for the discovered scaling law and the emerging spatial structure. Our findings corroborate long-standing conjectures in human geography (such as central place theory and Weber’s theory of emergent optimality) and allow for predictions of recurrent flows, providing a basis for applications in urban planning, traffic engineering and the mitigation of epidemic diseases.","author_count":10,"contributors":["Schläpfer, Markus","Dong, Lei","O'Keeffe, Kevin","Santi, Paolo","Szell, Michael","Salat, Hadrien","Anklesaria, Samuel","Vazifeh, Mohammad","Ratti, Carlo","West, Geoffrey"],"cuid":["S01-000.00-383369"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","Asia, East","Asia, South","Europe, EU","OECD"],"country":["China","France","Italy","Singapore","United States"],"glorg":["All Global Affiliations","Future Cities Laboratory","Massachusetts Institute of Technology","Orange Labs","Peking University","Santa Fe Institute","The Institute of Informatics and Telematics"],"keyword":["Geography","Statistical Physics"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"the universal visitation law of human mobility","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1038/s41586-021-03480-9","version":"Published Version"},"id":"S01-000.00-383369","identifier":[{"id":"85106885893","type":"scopus"}],"ids":["itu-8eb815b2-d91b-4dae-b132-3bfb2dcd58e6"],"keyword":["Geography","Statistical physics"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-009B4A7AE9D204AB62CB7FEBF469E53E"],"oa_link":[{"access":"oa","type":"rem","url":"http://michael.szell.net/downloads/schlapfer2021uvl.pdf","version":"Authors Final Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1038/s41586-021-03480-9","version":"Published Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"us","key":"massachusetts institute of technology","loc":["United States","America, North","OECD"],"name":"Massachusetts Institute of Technology","used":1},{"affno":"2","country":"sg","key":"future cities laboratory","loc":["Singapore","Asia, South"],"name":"Future Cities Laboratory","used":1},{"affno":"3","country":"us","key":"santa fe institute","loc":["United States","America, North","OECD"],"name":"Santa Fe Institute","used":1},{"affno":"4","country":"cn","key":"peking university","loc":["China","Asia, East"],"name":"Peking University","used":1},{"affno":"5","country":"it","key":"the institute of informatics and telematics","loc":["Italy","Europe, EU","OECD"],"name":"The Institute of Informatics and Telematics","used":1},{"affno":"6","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, NEtwoRks, Data, and Society"],"nora_code":"DI-U-ITU","used":1},{"affno":"7","country":"fr","key":"orange labs","loc":["France","Europe, EU","OECD"],"name":"Orange Labs","used":1}],"person":[{"affno":"1 2 3","corresponding":null,"first":"Markus","key":"schläpferpau","last":"Schläpfer","name":"Schläpfer, Markus","rank":1,"rolecode":"pau"},{"affno":"1 4","corresponding":null,"first":"Lei","key":"dongpau","last":"Dong","name":"Dong, Lei","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kevin","key":"okeeffepau","last":"O'Keeffe","name":"O'Keeffe, Kevin","rank":3,"rolecode":"pau"},{"affno":"1 5","corresponding":null,"first":"Paolo","key":"santipau","last":"Santi","name":"Santi, Paolo","rank":4,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Michael","key":"szellpau","last":"Szell","locid":"2ef641d0-bd79-425b-8b12-b58d74b993ae","name":"Szell, Michael","orcid":"0000-0003-3022-2483","rank":5,"rolecode":"pau"},{"affno":"2 7","corresponding":null,"first":"Hadrien","key":"salatpau","last":"Salat","name":"Salat, Hadrien","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Samuel","key":"anklesariapau","last":"Anklesaria","name":"Anklesaria, Samuel","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mohammad","key":"vazifehpau","last":"Vazifeh","name":"Vazifeh, Mohammad","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Carlo","key":"rattipau","last":"Ratti","name":"Ratti, Carlo","rank":9,"role