:"yanxifengpau","last":"Yan","name":"Yan, Xifeng","rank":25,"rolecode":"pau"},{"affno":"9","corresponding":null,"first":"Bin","key":"yangbinpau","last":"Yang","name":"Yang, Bin","rank":26,"rolecode":"pau"},{"affno":"25","corresponding":null,"first":"Dezhong","key":"yaodezhongpau","last":"Yao","name":"Yao, Dezhong","rank":27,"rolecode":"pau"},{"affno":"26","corresponding":null,"first":"Ce","key":"zhangcepau","last":"Zhang","name":"Zhang, Ce","rank":28,"rolecode":"pau"},{"affno":"27","corresponding":null,"first":"Peilin","key":"zhaopeilinpau","last":"Zhao","name":"Zhao, Peilin","rank":29,"rolecode":"pau"},{"affno":"21","corresponding":null,"first":"Rong","key":"zhurongpau","last":"Zhu","name":"Zhu, Rong","rank":30,"rolecode":"pau"}],"pub":{"issue":"4","journal":"IEEE Data Engineering Bulletin","status":"p","title":"IEEE Data Engineering Bulletin","title_org":"{IEEE} Data Engineering Bulletin","volume":"Vol. 47"},"review":"Undetermined","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-87dd3ceb-96f7-46b5-83ae-07fa8aa4e5d5"],"src":["ITU IT University of Copenhagen"],"title":"A Summary of ICDE 2022 Research Session Panels","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-718883","year":"2023","yearsub":"2023"}
{"abstract":"The rapid increase of traffic data generated by different sensing systems opens many opportunities to improve transportation services. An important opportunity is to enable stochastic routing that computes the arrival time probabilities for each suggested route instead of only the expected travel time. However, traffic datasets typically have many missing values, which prevents the construction of stochastic speeds. To address this limitation, we propose the Stochastic Spatio-Temporal Graph Convolutional Network (SST-GCN) architecture that accurately imputes missing speed distributions in a road network. SST-GCN combines Temporal Convolutional Networks and Graph Convolutional Networks into a single framework to capture both spatial and temporal correlations between road segments and time intervals. Moreover, to cope with datasets with many missing values, we propose a novel self-adaptive context-aware diffusion process that regulates the propagated information around the network, avoiding the spread of false information. We extensively evaluate the effectiveness of SST-GCN on real-world datasets, showing that it achieves from 4.6% to 50% higher accuracy than state-of-the-art baselines using three different evaluation metrics. Furthermore, multiple ablation studies confirm our design choices and scalability to large road networks.","author_count":10,"contributors":["Cuza, Carlos Enrique Muniz","Ho, Nguyen Thi Thao","Zacharatou, Eleni Tzirita","Pedersen, Torben Bach","Yang, Bin"],"cuid":["S01-000.00-099846"],"event":{"end":"2022-11-04","place":"Seattle, us","start":"2022-11-01","title":"30th ACM SIGSPATIAL International Conference on Advances in Geographic Information Systems, SIGSPATIAL GIS 2022","year":"2022"},"filters":{"added":"2023-02","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Data imputation","Graph Convolutional Networks","Spatio temporal"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-AAU","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"spatio temporal graph convolutional network for stochastic traffic speed imputation","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.1145/3557915.3560948","version":"Published Version"},"funding_acknowledgement":["This paper was supported in part by the MORE project funded by the EU Horizon 2020 program under grant agreement no. 957345."],"id":"S01-000.00-099846","identifier":[{"id":"85143611148","type":"scopus"}],"ids":["aau-ab9aafdd-c5b9-44df-9ece-edd0771070a6"],"keyword":["data imputation","graph convolutional networks","spatio-temporal"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-1AFF62050253345D1CBD51B45436BB32"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/519291301/3557915.3560948.pdf","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.1145/3557915.3560948","version":"Published Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Technical Faculty of IT and Design","Aalborg University, The Technical Faculty of IT and Design, Department of Computer Science","Aalborg University, The Technical Faculty of IT and Design, Department of Computer Science, Data Engineering, Science and Systems","Aalborg University, The Technical Faculty of IT and Design, Department of Computer Science, Database and Web Technologies"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"dk","key":"itu it university of 