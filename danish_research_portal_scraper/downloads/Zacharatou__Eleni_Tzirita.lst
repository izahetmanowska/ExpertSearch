{"author_count":8,"contributors":["Pandey, Varun","Van Renen, Alexander","Zacharatou, Eleni Tzirita","Kipf, Andreas","Sabek, Ibrahim","Ding, Jialin","Markl, Volker","Kemper, Alfons"],"cuid":["S01-000.00-798564"],"filters":{"added":"2025-04","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","Europe, EU","OECD"],"country":["Germany","United States"],"glorg":["All Global Affiliations","Amazon Web Services","German Research Center for Artificial Intelligence","Technical University of Berlin","Technical University of Munich","Technische Universität Nürnberg","University of Southern California"],"keyword":["Geospatial","Indexing","Machine learning","Spatial data"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"enhancing in memory spatial indexing with learned search","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.18420/BTW2025-14","version":"Published Version"},"id":"S01-000.00-798564","ids":["itu-dfa9cfd9-7a01-4821-b9c0-78cfcfeb1745"],"keyword":["geospatial","indexing","machine-learning","spatial data"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-D32C0A64375C8C9D1BB21B5C6630397D"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.18420/BTW2025-14","version":"Published Version"}],"org":[{"affno":"1","country":"de","key":"technical university of berlin","loc":["Germany","Europe, EU","OECD"],"name":"Technical University of Berlin","used":1},{"affno":"2","country":"de","key":"amazon web services","loc":["Germany","Europe, EU","OECD"],"name":"Amazon Web Services","used":1},{"affno":"3","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universi