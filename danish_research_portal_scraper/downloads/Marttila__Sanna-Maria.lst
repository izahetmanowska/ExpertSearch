{"author_count":3,"contributors":["Finken, Sisse","Beloff, Laura","Marttila, Sanna-Maria"],"cuid":["S01-000.00-383238"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"pop","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"und","rtype":["clu"],"sorti":"notes on smart bee ing and un natured technologies","src":["itu"],"src-code":["DI-U-ITU"],"type":"doo","type-grp":["all","pub"]},"id":"S01-000.00-383238","ids":["itu-85f7b1db-34b3-4924-ba01-9217fe49465d"],"lang":"English","level":"Popular","mra":["Science/Technology"],"noi":["Local-1-1-E0EE9EE68DC584E413EE767811B2533B"],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","IT University of Copenhagen, Technologies in Practice, Technologies in Practice"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Sisse","key":"finkenpau","last":"Finken","locid":"70f3c85a-9cd2-40b4-bed9-5e2a75609421","name":"Finken, Sisse","orcid":"0000-0001-7792-7216","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Laura","key":"beloffpau","last":"Beloff","name":"Beloff, Laura","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Sanna-Maria","key":"marttilapau","last":"Marttila","locid":"528393a3-e784-47a8-85be-c81d44c393bd","name":"Marttila, Sanna-Maria","orcid":"0000-0003-3793-5021","rank":3,"rolecode":"pau"}],"pub":{"publisher":"Participatory Design Conference (PDC)","status":"p"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT Universit