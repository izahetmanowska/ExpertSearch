ed"]},"sid":["itu-9ead329e-331d-4056-9a41-7238df054a8a"],"src":["ITU IT University of Copenhagen"],"title":"Action Research Booklet","type":"Book","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-747253","year":"2024","yearsub":"2024"}
{"abstract":"This paper reports from an ongoing research project on meaningful adoption and use of Generative Artificial Intelligence within the Communication Department of a Danish Municipality. Given its capacity to generate images, information, and text, GenAI models are positioned as being potentially transformative to cognitive tasks in knowledge work, raising concerns about skill displacement and a loss of meaning in the profession. This paper presents a set of sociotechnical principles for the introduction and integration of novel technologies, such as GenAI, while retaining meaningfulness in work. These principles were crafted by combining work design theory and extensive empirical material gathered through Action Design Research, in close collaboration with employees from the department. Centering the need for a common understanding of expectations for GenAI, the principles also point to the importance of organizational support to enable autonomous experimentation and accountability, while emphasizing transparency surrounding the decision-making process for the use of GenAI.","author_count":4,"contributors":["Fischer, Louise Harder","Nicolajsen, Hanne Westh","Marttila, Sanna-Maria","Sandbukt, Sunniva"],"cuid":["S01-000.00-759406"],"event":{"acronym":"ECIS","title":"European Conference on Information Systems"},"filters":{"added":"2024-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Action Design Research","Generative AI","Sociotechnical Principles","Work design"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"crafting meaningful generative ai enabled knowledge work","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://pure.itu.dk/ws/files/106309094/Crafting_Meaningful_Generative_AI-Enabled_Knowledge_Work.pdf","version":"Published Version"},"id":"S01-000.00-759406","ids":["itu-6aac332a-122b-4b49-a315-91b5cb88a459"],"keyword":["Action Design Research","Generative AI","Sociotechnical Principles","Work design"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-567D1CDC6155A62357BE8A87B85C5BF4"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://pure.itu.dk/ws/files/106309094/Crafting_Meaningful_Generative_AI-Enabled_Knowledge_Work.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","IT University of Copenhagen, Center for Digital Welfare","IT University of Copenhagen, Digital Business Innovation, Information Systems and Digital Innovation"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Louise Harder","key":"fischerpau","last":"Fischer","locid":"a22e85da-82e3-410d-8ef1-31407362ba19","name":"Fischer, Louise Harder","orcid":"0000-0001-7193-3797","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hanne Westh","key":"nicolajsenpau","last":"Nicolajsen","locid":"54728da8-274d-40e6-b119-23318d995721","name":"Nicolajsen, Hanne Westh","orcid":"0000-0002-0158-5034","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sanna-Maria","key":"marttilapau","last":"Marttila","locid":"528393a3-e784-47a8-85be-c81d44c393bd","name":"Marttila, Sanna-Maria","orcid":"0000-0003-3793-5021","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sunniva","key":"sandbuktpau","last":"Sandbukt","locid":"06d038a4-f659-4c53-8a6d-58e295ab603f","name":"Sandbukt, Sunniva","orcid":"0009-0002-4274-4991","rank":4,"rolecode":"pau"}],"pub":{"issn":["00000034"],"issue":"2024","journal":"Proceedings / European Conference on Information Systems","paperid":"10","status":"p","title":"Proceedings / European Conference on Information Systems","title_org":"Proceedings / European Conference on Information Systems (ECIS)"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-6aac332a-122b-4b49-a315-91b5cb88a459"],"src":["ITU IT University of Copenhagen"],"title":"Crafting Meaningful Generative AI-Enabled Knowledge Work","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-759406","year":"2024","yearsub":"2024"}
{"abstract":"In this chapter, we explore two distinct participatory research methodologies: Participatory Design and Action Research. While both approaches converge on shared participatory frameworks, principles, and values, Participatory Design integrates collaborative design elements into the research process.","author_count":4,"contributors":["Marttila, Sanna-Maria","Finken, Sisse"],"cuid":["S01-000.00-789570"],"filters":{"added":"2025-02","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"pop","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"und","rtype":["clu"],"sorti":"action research in participatory design","src":["itu"],"src-code":["DI-U-ITU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://pure.itu.dk/admin/files/105344102/The_Action_Research_Booklet_by_REFLACT.pdf","version":"Published Version"},"id":"S01-000.00-789570","ids":["itu-bb1491e8-ad02-43ae-831a-9cdee179a696"],"lang":"English","level":"Popular","mra":["Science/Technology"],"noi":["Local-1-1-2783C90EFD2A55E6CE8EF558BE07A50F"],"oa_link":[{"access":"oa","type":"rem","url":"https://pure.itu.dk/admin/files/105344102/The_Action_Research_Booklet_by_REFLACT.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","IT University of Copenhagen, Digitalization, Democracy, and Governance","IT University of Copenhagen, Digitalization, Democracy, and Governance, REFLACT"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Sanna-Maria","key":"marttilapau","last":"Marttila","locid":"528393a3-e784-47a8-85be-c81d44c393bd","name":"Marttila, Sanna-Maria","orcid":"0000-0003-3793-5021","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sisse","key":"finkenpau","last":"Finken","locid":"70f3c85a-9cd2-40b4-bed9-5e2a75609421","name":"Finken, Sisse","orcid":"0000-0001-7792-7216","rank":2,"rolecode":"pau"},{"affno":"","first":"Cancan","key":"wangpedh","last":"Wang","name":"Wang, Cancan","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Laura","key":"junckerjensenpedh","last":"Juncker-Jensen","name":"Juncker-Jensen, Laura","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"edition":"1","isbn":["9788794538039"],"place":"Copenhagen","status":"p","subtitle":"By REFLACT","title":"Action Research Booklet","volume":"1"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-bb1491e8-ad02-43ae-831a-9cdee179a696"],"src":["ITU IT University of Copenhagen"],"title":"Action Research in Participatory Design","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-789570","year":"2024","yearsub":"2024"}
{"abstract":"This paper advocates for the potential of feminist participatory practices to create conditions for inclusive and equitable futures. It addresses the need to design for transformative feminist futures and challenges normative innovation spaces. The authors reflect on their experiences organising two feminist hackathons, emphasising intersectionality, equity, and collaboration. They present 11 design principles that guided their efforts, highlighting the importance of centring local grassroots organisations. The paper discusses the potential of these design principles as tools for community engagement, nurturing collective imagination, and normalising feminist practices in collaborative spaces. It emphasises the importance of moving from embodied knowledge to embodying knowledge and integrating values and experiences into the infrastructure of innovation events. The authors acknowledge the challenges in operationalising principles, such as valuing labour and expertise, and raise questions about commitment and responsibility in inclusive, feminist events. This work contributes to the discourse on designing conditions for co-creating feminist imaginaries.","author_count":3,"contributors":["Friis, Henriette","Sánchez, Eva Duran","Marttila, Sanna-Maria"],"cuid":["S01-000.00-789574"],"filters":{"added":"2025-02","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"country":["Finland"],"glorg":["All Global Affiliations","Feminist Futures Helsinki Initiative"],"keyword":["Co creation","Community engagement","Intersectionality","Participatory Design"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"design principles for co creating feminist imaginaries","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-SA","type":"doi","url":"https://doi.org/10.21606/drs.2024.1034","version":"Published Version"},"id":"S01-000.00-789574","ids":["itu-d1cb1831-72bf-4d5a-8ba4-8b3114b45d42"],"keyword":["Co-creation","Community engagement","Feminist informatics","Intersectionality","Participatory design"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-1AC528D58C30FD845E0D204522EBF48A"],"oa_link":[{"access":"oa","license":"CC BY-SA","type":"doi","url":"https://doi.org/10.21606/drs.2024.1034","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","IT University of Copenhagen, Technologies in Practice","IT University of Copenhagen, Technologies in Practice, ETHOS Lab"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"fi","key":"feminist futures helsinki initiative","loc":["Finland","Europe, EU","Nordic","OECD"],"name":"Feminist Futures Helsinki Initiative","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Henriette","key":"friispau","last":"Friis","locid":"140f881b-1540-455b-8066-f0bc9ac6d82c","name":"Friis, Henriette","orcid":"0009-0008-1098-6674","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Eva Duran","key":"sánchezpau","last":"Sánchez","name":"Sánchez, Eva Duran","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sanna-Maria","key":"marttilapau","last":"Marttila","locid":"528393a3-e784-47a8-85be-c81d44c393bd","name":"Marttila, Sanna-Maria","orcid":"0000-0003-3793-5021","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.21606/drs.2024.1034","status":"p","title":"DRS2024: Research Papers"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-d1cb1831-72bf-4d5a-8ba4-8b3114b45d42"],"src":["ITU IT University of Copenhagen"],"title":"Design Principles For Co-creating Feminist Imaginaries","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-789574","year":"2024","yearsub":"2024"}
{"abstract":"This study sets out to understand the governance consequences of the ’agile transformation’ of the Danish state. The agile transformation builds on a set of values and routines from software engineering that advocates for change in the project management of digital public service provision. An ‘agile’ public sector promises to deliver not just more thoroughly digitalized public services, but also better digitalization by enhancing the speed, flexibility and innovative capabilities of IT project management in the public sector agencies tasked with building new IT systems. However, such an agile transformation is not easily accomplished, and its implications for the welfare state remain unclear. In this chapter, we problematize the Danish state’s attempted agile transformation from four perspectives: governance, sourcing, citizenship, and legacy and maintenance. From a governance perspective, the high velocity of day-to-day decisions built into the agile framework can lead to a decoupling between decision-making and accountability in public service delivery. But when agile approaches replace bureaucratic procedures originally put in place to ensure the accountability and legality of governmental operations, what are the consequences? Further, as the distribution of knowledge between the state and private consultancies has become increasingly interlaced through agile-based public-private collaborations, the state has attempted a shift from outsourcing to insourcing (‘hjemtagning’) of IT development. At the same time, the state’s collaboration with private actors has perhaps never been more intense, and it remains unclear how the much-needed IT expertise of the private sector interplays with the state’s growing ambitions of building new systems in-house. As regards citizenship and citizens’ trust in the state, the trial-and-error-based agile approach to service delivery may put a strain on the relationship between citizens and the welfare state by introducing “unfinished” minimal viable products (MVP) in the place of the fully operational IT systems citizens have learned to expect. Moreover, agile-based public services are often built upon an established base of legacy technology, which also impacts agile temporalities. Maintenance of pre-agile components cannot be easily contained in a sprint-based formula. And what happens after agile-based public services go beyond beta, or even face retirement? Does the responsibility for forming the strategy for the entire life-span of a product lie with the state or the vendor, and how can this responsibility be shared?","author_count":4,"contributors":["Papazu, Irina","Wang, Cancan","Perriam, Jessamy","Marttila, Sanna-Maria"],"cuid":["S01-000.00-382477"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Agile transformation","Citizenship Trust","Governance of IT","Legacy Systems Maintenance","Public private collaboration"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"nr","rtype":["clu"],"sorti":"outsourcing response ability the agile transformation of the danish public sector","src":["itu"],"src-code":["DI-U-ITU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-382477","ids":["itu-50c37dad-469b-472d-9502-743b84168544"],"keyword":["Agile Transformation","Citizenship Trust","Governance of IT","Legacy Systems Maintenance","Public-Private Collaboration"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-9DC78AFE17C082427B34F702ADA7329A"],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","IT University of Copenhagen, Center for Digital Welfare","IT University of Copenhagen, Technologies in Practice, Technologies in Practice"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Irina","key":"papazupau","last":"Papazu","locid":"6ec63914-1f4e-4708-8830-1b054c2ee03a","name":"Papazu, Irina","orcid":"0000-0002-4178-3676","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Cancan","key":"wangpau","last":"Wang","locid":"605b59ab-91b4-4f8e-bb12-df68ce0491c5","name":"Wang, Cancan","orcid":"0000-0002-9065-6884","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jessamy","key":"perriampau","last":"Perriam","locid":"4ca57c3b-1d1f-4ecf-87b0-fe690510c887","name":"Perriam, Jessamy","orcid":"0000-0002-6362-8634","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sanna-Maria","key":"marttilapau","last":"Marttila","locid":"528393a3-e784-47a8-85be-c81d44c393bd","name":"Marttila, Sanna-Maria","orcid":"0000-0003-3793-5021","rank":4,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-50c37dad-469b-472d-9502-743b84168544"],"src":["ITU IT University of Copenhagen"],"title":"Outsourcing response-ability : The agile transformation of the Danish public sector","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382477","year":"2022","yearsub":"2022"}
{"abstract":"This workshop explores and reflects upon both how relational ontologies can support design processes that target commons and commoning as outcomes, and how commons and commoning can work as speculative lenses for the understanding of relationality in Participatory Design. Here, we invite the PD community to engage with questions such as: how do we embrace and rely upon relationality when designing collectively and in a participatory manner within more-than-human ensembles? How do we become commoners and what do we nurture in common? What do we lose and what do we gain by considering commons with a keen eye on relationality? Which kind of relational qualities are essential for commoning design and designing commons? In short, “Relationality, commoning, and designing” aims to be a venue for critically supporting alternative and more sustainable futures for all (not only humans) by means of participatory designing and commoning.","author_count":8,"contributors":["Poderi, Giacomo","Marttila, Sanna-Maria","Saad-Sulonen, Joanna","Van Amstel, Frederick","Teli, Maurizio","Tonolli, Linda","D'Andrea, Vincenzo","Botero, Andrea"],"cuid":["S02-085.13-005024"],"event":{"end":"2022-09-01","place":"Newcastle upon Tyne, gb","start":"2022-08-19","title":"Participatory Design Conference 2022","year":"2022"},"filters":{"added":"2022-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["America, South","Europe, EU","Nordic","OECD"],"country":["Brazil","Colombia","Finland","Italy"],"glorg":["Aalto University","All Global Affiliations","Department of Information Engineering and Computer Science, University of Trento","Federal University of Technology - Paraná","Universidad de los Andes","Universidad de los Andes Colombia","Universidade Tecnológica Federal do Paraná","University of Trento"],"keyword":["Commoning","Commons","HCI","Participatory Design","Pluriversal design","Relational ontology","Relationality","commons design"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-AAU","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"relationality commoning and designing","src":["aau","itu"],"src-code":["DI-U-AAU","DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/87118574/Commoningdesign_PDC2022_ValidatedCameraReady_Ackn.pdf","version":"Authors Final Version"},"id":"S02-085.13-005024","identifier":[{"id":"85137165316","type":"scopus"}],"ids":["aau-67b56da1-da35-4144-bed9-9d78d184f87f","itu-c541e865-218f-43b6-a136-a32a2698459e"],"keyword":["Commons","HCI","Participatory Design","commoning","commons design","pluriversal design","relational ontology","relationality"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-FEB6AF8662FC287184BBF7FFF076C47F"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/87118574/Commoningdesign_PDC2022_ValidatedCameraReady_Ackn.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Digital Welfare","IT University of Copenhagen, Digital Design","IT University of Copenhagen, Digital Design, Digital Societies and Participation Section","IT University of Copenhagen, Digitalization, Democracy, and Governance, Welfare Technology - Policy - People - Practices"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"br","key":"universidade tecnológica federal do paraná","loc":["Brazil","America, South"],"name":"Universidade Tecnológica Federal do Paraná","used":1},{"affno":"3","country":"br"