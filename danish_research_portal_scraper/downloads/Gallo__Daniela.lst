o":"","first":"Paolo","key":"sorrentinopaolopau","last":"Sorrentino","name":"Sorrentino, Paolo","rank":145,"rolecode":"pau"},{"affno":"","first":"Mark","key":"kristiansenmarkpau","last":"Kristiansen","name":"Kristiansen, Mark","rank":146,"rolecode":"pau"},{"affno":"","first":"Huei Hsin","key":"chianghueihsinpau","last":"Chiang","name":"Chiang, Huei Hsin","rank":147,"rolecode":"pau"},{"affno":"","first":"Caroline","key":"graffcarolinepau","last":"Graff","name":"Graff, Caroline","rank":148,"rolecode":"pau"},{"affno":"","first":"Florence","key":"pasquierflorencepau","last":"Pasquier","name":"Pasquier, Florence","rank":149,"rolecode":"pau"},{"affno":"","first":"Adeline","key":"rollinadelinepau","last":"Rollin","name":"Rollin, Adeline","rank":150,"rolecode":"pau"},{"affno":"","first":"Vincent","key":"deramecourtvincentpau","last":"Deramecourt","name":"Deramecourt, Vincent","rank":151,"rolecode":"pau"},{"affno":"","first":"Florence","key":"lebertflorencepau","last":"Lebert","name":"Lebert, Florence","rank":152,"rolecode":"pau"},{"affno":"","first":"Dimitrios","key":"kapogiannisdimitriospau","last":"Kapogiannis","name":"Kapogiannis, Dimitrios","rank":153,"rolecode":"pau"},{"affno":"","first":"Luigi","key":"ferrucciluigipau","last":"Ferrucci","name":"Ferrucci, Luigi","rank":154,"rolecode":"pau"},{"affno":"","first":"Stuart","key":"pickeringbrownstuartpau","last":"Pickering-Brown","name":"Pickering-Brown, Stuart","rank":155,"rolecode":"pau"},{"affno":"","first":"Andrew B.","key":"singletonandrewbpau","last":"Singleton","name":"Singleton, Andrew B.","rank":156,"rolecode":"pau"},{"affno":"","first":"John","key":"hardyjohnpau","last":"Hardy","name":"Hardy, John","rank":157,"rolecode":"pau"},{"affno":"","first":"Parastoo","key":"momeniparastoopau","last":"Momeni","name":"Momeni, Parastoo","rank":158,"rolecode":"pau"},{"affno":"","first":"Roel A.","key":"ophoffroelapau","last":"Ophoff","name":"Ophoff, Roel A.","rank":159,"rolecode":"pau"}],"pmid":["33637304"],"pub":{"doi":"10.1016/j.biopsych.2020.12.023","issn":["00063223","18732402"],"issn_org":["00063223"],"issue":"8","journal":"Biological Psychiatry","pages":"825-835","status":"p","title":"Biological Psychiatry","volume":"89"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-8d1c3bb5-dd60-4dda-acb8-d35b4f6e895e"],"src":["KU University of Copenhagen"],"title":"Gene Expression Imputation Across Multiple Tissue Types Provides Insight Into the Genetic Architecture of Frontotemporal Dementia and Its Clinical Subtypes","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-477814","year":"2021","yearsub":"2021"}
{"abstract":"Mammalian development, adult tissue homeostasis and the avoidance of severe diseases including cancer require a properly orchestrated cell cycle, as well as error-free genome maintenance. The key cell-fate decision to replicate the genome is controlled by two major signalling pathways that act in parallel-the MYC pathway and the cyclin D-cyclin-dependent kinase (CDK)-retinoblastoma protein (RB) pathway(1,2). Both MYC and the cyclin D-CDK-RB axis are commonly deregulated in cancer, and this is associated with increased genomic instability. The autophagic tumour-suppressor protein AMBRA1 has been linked to the control of cell proliferation, but the underlying molecular mechanisms remain poorly understood. Here we show that AMBRA1 is an upstream master regulator of the transition from G1 to S phase and thereby prevents replication stress. Using a combination of cell and molecular approaches and in vivo models, we reveal that AMBRA1 regulates the abundance of D-type cyclins by mediating their degradation. Furthermore, by controlling the transition from G1 to S phase, AMBRA1 helps to maintain genomic integrity during DNA replication, which counteracts developmental abnormalities and tumour growth. Finally, we identify the CHK1 kinase as a potential therapeutic target in AMBRA1-deficient tumours. These results advance our understanding of the control of replication-phase entry and genomic integrity, and identify the AMBRA1-cyclin D pathway as a crucial cell-cycle-regulatory mechanism that is deeply interconnected with genomic stability in embryonic development and tumorigenesis.","author_count":46,"contributors":["Maiani, Emiliano","Milletti, Giacomo","Nazio, Francesca","Holdgaard, Sos Gronbaek","Bartkova, Jirina","Rizza, Salvatore","Cianfanelli, Valentina","Lorente, Mar","Simoneschi, Daniele","Di Marco, Miriam","D'Acunzo, Pasquale","Di Leo, Luca","Rasmussen, Rikke","Montagna, Costanza","Raciti, Marilena","De Stefanis, Cristiano","Gabicagogeascoa, Estibaliz","Rona, Gergely","Salvador, Nelida","Pupo, Emanuela","Merchut-Maya, Joanna Maria","Daniel, Colin J.","Carinci, Marianna","Cesarini, Valeriana","O'sullivan, Alfie","Jeong, Yeon-Tae","Bordi, Matteo","Russo, Francesco","Campello, Silvia","Gallo, Angela","Filomeni, Giuseppe","Lanzetti, Letizia","Sears, Rosalie C.","Hamerlik, Petra","Bartolazzi, Armando","Hynds, Robert E.","Pearce, David R.","Swanton, Charles","Pagano, Michele","Velasco, Guillermo","Papaleo, Elena","De Zio, Daniela","Maya-Mendoza, Apolinar","Locatelli, Franco","Bartek, Jiri","Cecconi, Francesco"],"cuid":["S01-000.00-456601"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-NP","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"NP":["DI-NP-ALL","DI-NP-CAN"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-GV-SSI","DI-NP-CAN","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"ambra000000000001 regulates cyclin d to guard s phase entry and genomic integrity","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/314956056/nihms_1776644.pdf","version":"Authors Final Version"},"id":"S01-000.00-456601","identifier":[{"id":"PMC8864551","type":"pmcid"},{"id":"85104673616","type":"scopus"},{"id":"000640159900003","type":"wos"},{"id":"33854232","type":"pmid"}],"ids":["ku-69c13cd4-1123-401d-a8b4-ec545e84e73a"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-77C45A9B22B84D4454FF294F872C068B"],"oa_link":[{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/314956056/nihms_1776644.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"dk","key":"dcrc danish cancer society research center","l2":"DI-NP","l2n":"Non